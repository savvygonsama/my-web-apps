	TextSize = 17,
	ZIndex = 21,
	Parent = toastFrame,
})
addScale(toastFrame)
local toastToken = 0
local function toast(msg: string)
	toastToken += 1
	local my = toastToken
	toastLabel.Text = msg
	toastFrame.Visible = true
	task.delay(2.6, function()
		if toastToken == my then
			toastFrame.Visible = false
		end
	end)
end


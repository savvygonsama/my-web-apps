		Parent = row,
	})
	setGradeColor(nameLabel, n)
	text({
		Position = UDim2.new(0, 20, 0, 29),
		Size = UDim2.new(0.52, -20, 0, 18),
		TextSize = 12,
		TextColor3 = C.dim,
		TextTruncate = Enum.TextTruncate.AtEnd,
		TextWrapped = false,
		Text = grade.ko .. (isBoss and "  ·  BOSS" or ""),
		Parent = row,
	})
	local powerLabel2 = text({
		Position = UDim2.new(0.52, 0, 0, 0),

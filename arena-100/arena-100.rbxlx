        <string name="Source"><![CDATA[-- GameConfig (ModuleScript, ReplicatedStorage)
-- 게임 전체 수치와 데이터. 서버와 클라이언트가 같이 읽는다.
-- 밸런스를 바꾸고 싶으면 이 파일만 고치면 된다.

local Config = {}

Config.GAME_TITLE = "ARENA 100"
Config.VERSION = "beta-1"
Config.MAX_GRADE = 100

------------------------------------------------------------------------
-- 등급 100단계
------------------------------------------------------------------------
Config.Grades = {
	{ en = "Trash", ko = "쓰레기급" },
	{ en = "Noob", ko = "초보자" },
	{ en = "Rookie", ko = "신참" },
	{ en = "Novice", ko = "초심자" },
	{ en = "Trainee", ko = "훈련생" },
	{ en = "Amateur", ko = "아마추어" },
	{ en = "Apprentice", ko = "견습생" },
	{ en = "Brawler", ko = "싸움꾼" },
	{ en = "Fighter", ko = "전투원" },
	{ en = "Scout", ko = "정찰병" },
	{ en = "Soldier", ko = "병사" },
	{ en = "Mercenary", ko = "용병" },
	{ en = "Striker", ko = "공격수" },
	{ en = "Duelist", ko = "결투가" },
	{ en = "Challenger", ko = "도전자" },
	{ en = "Warrior", ko = "전사" },
	{ en = "Gladiator", ko = "검투사" },
	{ en = "Adept", ko = "숙련자" },
	{ en = "Specialist", ko = "전문가" },
	{ en = "Veteran", ko = "베테랑" },
	{ en = "Elite", ko = "정예" },
	{ en = "Knight", ko = "기사" },
	{ en = "Berserker", ko = "광전사" },
	{ en = "Slayer", ko = "학살자" },
	{ en = "Champion", ko = "챔피언" },
	{ en = "Hero", ko = "영웅" },
	{ en = "Master", ko = "달인" },
	{ en = "Grandmaster", ko = "대가" },
	{ en = "Warlord", ko = "전쟁 군주" },
	{ en = "Conqueror", ko = "정복자" },
	{ en = "Juggernaut", ko = "압도적 파괴자" },
	{ en = "Dreadnought", ko = "두려움 모르는 강자" },
	{ en = "Executioner", ko = "처형자" },
	{ en = "Annihilator", ko = "전멸시키는 자" },
	{ en = "Overlord", ko = "최고 지배자" },
	{ en = "Behemoth", ko = "거대한 괴물" },
	{ en = "Leviathan", ko = "거대한 바다 괴물" },
	{ en = "Colossus", ko = "거상" },
	{ en = "Titan", ko = "거신" },
	{ en = "Tyrant", ko = "폭군" },
	{ en = "Dominator", ko = "지배자" },
	{ en = "Imperator", ko = "황제" },
	{ en = "Archon", ko = "통치자" },
	{ en = "Sovereign", ko = "최고 통치자" },
	{ en = "Paragon", ko = "귀감" },
	{ en = "Ascendant", ko = "상승하는 자" },
	{ en = "Exalted", ko = "격상된 존재" },
	{ en = "Invictus", ko = "정복되지 않은 자" },
	{ en = "Demigod", ko = "반신" },
	{ en = "Legendary", ko = "전설급" },
	{ en = "Mythic", ko = "신화적 존재" },
	{ en = "Immortal", ko = "불멸자" },
	{ en = "Eternal", ko = "영원한 존재" },
	{ en = "Revenant", ko = "되돌아온 자" },
	{ en = "Eidolon", ko = "환영" },
	{ en = "Eldritch", ko = "기괴한 초자연적 존재" },
	{ en = "Tenebrous", ko = "어둠에 싸인 존재" },
	{ en = "Abyssal Monarch", ko = "심연의 군주" },
	{ en = "Infernal Regent", ko = "지옥의 섭정" },
	{ en = "Void Hierarch", ko = "공허의 최고 통치자" },
	{ en = "Primordial", ko = "태초의 존재" },
	{ en = "Antediluvian", ko = "태고의 존재" },
	{ en = "Preternatural", ko = "자연을 벗어난 존재" },
	{ en = "Transmundane", ko = "현세를 초월한 자" },
	{ en = "Unfathomable", ko = "헤아릴 수 없는 존재" },
	{ en = "Inexorable", ko = "막을 수 없는 자" },
	{ en = "Immutable", ko = "변하지 않는 존재" },
	{ en = "Numinous", ko = "신비롭고 신성한 존재" },
	{ en = "Celestial", ko = "천상의 존재" },
	{ en = "Seraphic", ko = "세라핌 같은 존재" },
	{ en = "Empyrean", ko = "최고 천상의 존재" },
	{ en = "Hierophant", ko = "신성한 비밀의 해석자" },
	{ en = "Deific", ko = "신과 같은 존재" },
	{ en = "Demiurge", ko = "조물주" },
	{ en = "Apotheosis", ko = "신의 경지" },
	{ en = "Quintessence", ko = "가장 순수한 본질" },
	{ en = "Ineffable", ko = "말로 표현할 수 없는 존재" },
	{ en = "Omniscient", ko = "모든 것을 아는 자" },
	{ en = "Omnipresent", ko = "어디에나 있는 자" },
	{ en = "Omnipotent", ko = "전능한 자" },
	{ en = "Deicide", ko = "신을 죽인 자" },
	{ en = "Sempiternal", ko = "끝없이 지속되는 존재" },
	{ en = "Transcendent", ko = "초월자" },
	{ en = "Extracosmic", ko = "우주 바깥의 존재" },
	{ en = "Singularity", ko = "특이점" },
	{ en = "Cosmogenic", ko = "우주를 낳는 자" },
	{ en = "Archetypal", ko = "근원적 원형" },
	{ en = "Thearch", ko = "신적 지배자" },
	{ en = "Astral Imperator", ko = "별의 황제" },
	{ en = "Cosmic Sovereign", ko = "우주의 절대 지배자" },
	{ en = "Cosmological Apex", ko = "우주의 정점" },
	{ en = "Omnicide", ko = "모든 것을 죽인 자" },
	{ en = "Eschaton", ko = "궁극적 종말" },
	{ en = "Aeon", ko = "영겁의 존재" },
	{ en = "Infinity", ko = "무한" },
	{ en = "The Empyrean Absolutum", ko = "최고 천상의 절대 실재" },
	{ en = "The Omniversal Eschaton", ko = "모든 우주의 궁극적 종말" },
	{ en = "The Ineffable Primordial Sovereign", ko = "말로 표현할 수 없는 태초의 절대 지배자" },
	{ en = "The Transcendent Architect of Eternity", ko = "영원을 설계하는 초월자" },
	{ en = "The Omnipotent Origin Beyond Existence", ko = "존재를 넘어선 전능한 근원" },
}

------------------------------------------------------------------------
-- 구간: 색과 합성 개수가 구간마다 달라진다
------------------------------------------------------------------------
Config.Sections = {
	{ from = 1, to = 20, name = "풋내기", color = Color3.fromRGB(150, 205, 120), mergeCost = 2, scale = 1.0 },
	{ from = 21, to = 40, name = "투기장 강자", color = Color3.fromRGB(80, 165, 255), mergeCost = 3, scale = 1.15 },
	{ from = 41, to = 60, name = "지배자와 전설", color = Color3.fromRGB(190, 110, 255), mergeCost = 4, scale = 1.3 },
	{ from = 61, to = 80, name = "태초와 신성", color = Color3.fromRGB(255, 236, 180), mergeCost = 5, scale = 1.45 },
	{ from = 81, to = 93, name = "우주", color = Color3.fromRGB(90, 225, 255), mergeCost = 6, scale = 1.6 },
	{ from = 94, to = 100, name = "최종", color = Color3.fromRGB(255, 95, 150), mergeCost = 6, scale = 1.8, rainbow = true },
}

------------------------------------------------------------------------
-- 무기 5계열. dmg는 기본 공격력 배율, cooldown은 공격 간격(초)
-- mode: single = 가장 가까운 적 1명, line = 앞쪽 여러 명, around = 내 주위 전부
------------------------------------------------------------------------
-- 모든 무기는 기본 치명타 5%(1.8배). 단검만 30%(2.5배)
Config.WeaponTypes = {
	{ id = 1, name = "대검", desc = "공격력 높음, 느림", dmg = 1.6, cooldown = 0.9, range = 8, mode = "single", critChance = 0.05, critMult = 1.8 },
	{ id = 2, name = "쌍검", desc = "공격 속도 빠름", dmg = 0.55, cooldown = 0.3, range = 7, mode = "single", critChance = 0.05, critMult = 1.8 },
	{ id = 3, name = "장검", desc = "앞쪽으로 길게, 최대 3명", dmg = 1.0, cooldown = 0.6, range = 13, mode = "line", maxTargets = 3, critChance = 0.05, critMult = 1.8 },
	{ id = 4, name = "단검", desc = "치명타 30%, 2.5배", dmg = 0.5, cooldown = 0.4, range = 6, mode = "single", critChance = 0.3, critMult = 2.5 },
	{ id = 5, name = "낫", desc = "주위 한 바퀴 + 흡혈", dmg = 0.75, cooldown = 0.7, range = 10, mode = "around", lifesteal = 0.1, critChance = 0.05, critMult = 1.8 },
}

-- 100등급 다섯 계열을 하나씩 모아 합치면 나오는 최종 무기
Config.AllRounder = {
	id = 0,
	name = "올라운더",
	desc = "다섯 계열의 장점을 모두 가짐",
	dmg = 1.6,
	cooldown = 0.35,
	range = 13,
	mode = "around",
	critChance = 0.3,
	critMult = 2.5,
	lifesteal = 0.1,
}
Config.ALLROUNDER_KEY = "AR"

------------------------------------------------------------------------
-- 필살기: 무기 계열마다 하나. 때릴수록 게이지가 차고, 100이 되면 쓸 수 있다
-- mult는 공격력 배율
------------------------------------------------------------------------
Config.ULT_GAIN = 11 -- 공격 1회당 게이지 = ULT_GAIN × 공격 간격(초). 어떤 무기든 약 9초면 찬다
Config.Ultimates = {
	[1] = { name = "대지 가르기", desc = "앞으로 땅을 갈라 일직선의 적을 모두 벤다", mult = 8, length = 32, width = 6 },
	[2] = { name = "칼날 폭풍", desc = "2.5초 동안 주위를 쉴 새 없이 벤다", mult = 0.6, radius = 10, ticks = 25, interval = 0.1 },
	[3] = { name = "일섬", desc = "앞으로 순간 돌진하며 지나간 자리의 적을 모두 벤다", mult = 7, length = 26, width = 5 },
	[4] = { name = "그림자 처형", desc = "가장 강한 적 뒤로 순간이동해 치명타 5연타", mult = 1, hits = 5 },
	[5] = { name = "영혼 수확", desc = "넓은 원 안의 적을 베고 체력을 크게 회복한다", mult = 5, radius = 18, heal = 0.3 },
	[0] = { name = "천지개벽", desc = "투기장의 모든 적을 베고 체력을 회복한다", mult = 10, heal = 0.3 },
}

------------------------------------------------------------------------
-- 희귀도 5단계. 등급마다 한 칸씩 계열을 돌아가며 바뀐다
------------------------------------------------------------------------
Config.Rarities = {
	{ rank = 1, name = "일반", mult = 1.0, color = Color3.fromRGB(190, 190, 190) },
	{ rank = 2, name = "고급", mult = 1.15, color = Color3.fromRGB(90, 215, 110) },
	{ rank = 3, name = "희귀", mult = 1.3, color = Color3.fromRGB(70, 150, 255) },
	{ rank = 4, name = "영웅", mult = 1.5, color = Color3.fromRGB(185, 95, 255) },
	{ rank = 5, name = "전설", mult = 1.75, color = Color3.fromRGB(255, 170, 40) },
}

-- 등급 하나 오를 때 세기 배율. 전설 배율(1.75)보다 커야 합성이 항상 이득이다
Config.GRADE_GROWTH = 2
Config.BASE_ATK = 10
Config.BASE_HP = 100

Config.TRAIN_BONUS = 0.08 -- 훈련 1레벨당 +8%
Config.AUTO_POWER_RATIO = 1.5 -- 자동 반복: 권장 전투력의 1.5배 이상
Config.STARTER_KEY = "1_5" -- 처음 받는 무기: 1등급 낫(일반)

Config.DASH_COOLDOWN = 1.5
Config.DASH_INVULN = 0.4

------------------------------------------------------------------------
-- 함수
------------------------------------------------------------------------
function Config.getGrade(g)
	return Config.Grades[math.clamp(g, 1, Config.MAX_GRADE)]
end

function Config.getSection(g)
	for i, s in ipairs(Config.Sections) do
		if g >= s.from and g <= s.to then
			return s, i
		end
	end
	return Config.Sections[#Config.Sections], #Config.Sections
end

function Config.mergeCost(g)
	return (Config.getSection(g)).mergeCost
end

-- 1등급: 대검 전설, 쌍검 영웅, 장검 희귀, 단검 고급, 낫 일반
-- 등급이 하나 오를 때마다 한 칸씩 밀린다 (2등급은 낫이 전설)
function Config.rarityRank(g, typeId)
	if typeId == 0 then
		return 5
	end
	return 5 - ((typeId - 1 + g - 1) % 5)
end

function Config.itemKey(g, typeId)
	if typeId == 0 then
		return Config.ALLROUNDER_KEY
	end
	return string.format("%d_%d", g, typeId)
end

-- 키를 등급, 계열로 나눈다. 잘못된 키면 nil
function Config.parseKey(key)
	if type(key) ~= "string" then
		return nil
	end
	if key == Config.ALLROUNDER_KEY then
		return Config.MAX_GRADE, 0
	end
	local gs, ts = string.match(key, "^(%d+)_(%d)$")
	if not gs then
		return nil
	end
	local g, t = tonumber(gs), tonumber(ts)
	if not g or not t or g < 1 or g > Config.MAX_GRADE or t < 1 or t > 5 then
		return nil
	end
	return g, t
end

function Config.weaponType(typeId)
	if typeId == 0 then
		return Config.AllRounder
	end
	return Config.WeaponTypes[typeId]
end

local function growth(g)
	return Config.GRADE_GROWTH ^ (g - 1)
end

-- 무기 하나의 정보
function Config.weaponInfo(key)
	local g, t = Config.parseKey(key)
	if not g then
		return nil
	end
	local wt = Config.weaponType(t)
	local rarity = Config.Rarities[Config.rarityRank(g, t)]
	local grade = Config.getGrade(g)
	local name
	if t == 0 then
		name = "올라운더"
	else
		name = grade.en .. " " .. wt.name
	end
	return {
		key = key,
		grade = g,
		typeId = t,
		type = wt,
		rarity = rarity,
		gradeData = grade,
		name = name,
		atk = Config.BASE_ATK * growth(g) * rarity.mult * wt.dmg,
	}
end

-- 공격 1회 기대 배율 (치명타 포함)
function Config.critFactor(wt)
	local c = wt.critChance or 0
	local m = wt.critMult or 1
	return 1 + c * (m - 1)
end

-- 장착 무기 + 훈련 레벨로 실제 능력치 계산
function Config.playerStats(key, atkLv, hpLv)
	local info = Config.weaponInfo(key) or Config.weaponInfo(Config.STARTER_KEY)
	local wt = info.type
	local atk = info.atk * (1 + Config.TRAIN_BONUS * (atkLv or 0))
	local maxHp = Config.BASE_HP * growth(info.grade) * (1 + Config.TRAIN_BONUS * (hpLv or 0))
	local dps = atk / wt.cooldown * Config.critFactor(wt)
	local power = math.floor(dps * 4 + maxHp * 0.4)
	return {
		weapon = info,
		atk = atk,
		maxHp = maxHp,
		cooldown = wt.cooldown,
		range = wt.range,
		power = power,
	}
end

-- 그 스테이지 등급의 '일반' 무기, 훈련 0일 때의 전투력 (계열 평균)
function Config.recommendedPower(stage)
	return math.floor((Config.BASE_ATK * 1.7 * 4 + Config.BASE_HP * 0.4) * growth(stage))
end

function Config.canAutoRepeat(stage, maxStage, power)
	return stage <= maxStage and power >= Config.recommendedPower(stage) * Config.AUTO_POWER_RATIO
end

-- 스테이지 n: 적 등급도 n. 10스테이지마다 보스
function Config.stageInfo(n)
	local isBoss = (n % 10 == 0)
	local gr = growth(n)
	local count
	if isBoss then
		count = 2
	else
		count = math.min(5, 2 + math.ceil(n / 2))
	end
	local coins = math.floor(20 * 1.6 ^ (n - 1))
	if isBoss then
		coins *= 5
	end
	return {
		stage = n,
		isBoss = isBoss,
		enemyCount = count,
		-- 같은 등급 칼로 싸우면 적 하나에 3~4초, 보스는 15~25초 (일반 칼로 안 피하면 질 수 있음)
		enemyHp = 60 * gr,
		enemyDmg = 1.5 * gr,
		bossHp = 60 * gr * 5,
		bossDmg = 3 * gr,
		slamDmg = 20 * gr,
		coins = coins,
		dropCount = isBoss and 3 or 1,
		bonusDropChance = isBoss and 0 or 0.35,
	}
end

function Config.trainCost(level)
	return math.floor(50 * 1.55 ^ level)
end

local SUFFIXES = { "", "K", "M", "B", "T", "Qa", "Qi", "Sx", "Sp", "Oc", "No", "Dc", "Ud", "Dd", "Td", "Qad", "Qid" }

function Config.formatNumber(n)
	if n ~= n then
		return "0"
	end
	if n < 1000 then
		return tostring(math.floor(n))
	end
	local i = math.floor(math.log10(n) / 3)
	if i >= #SUFFIXES then
		return string.format("%.2e", n)
	end
	local v = n / 10 ^ (i * 3)
	local s
	if v >= 100 then
		s = string.format("%d", math.floor(v))
	elseif v >= 10 then
		s = string.format("%.1f", math.floor(v * 10) / 10)
	else
		s = string.format("%.2f", math.floor(v * 100) / 100)
	end
	return s .. SUFFIXES[i + 1]
end

return Config
]]></string>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="3">
      <Properties>
        <string name="Name">WeaponBuilder</string>
        <string name="Source"><![CDATA[-- WeaponBuilder (ModuleScript, ReplicatedStorage)
-- 서버는 캐릭터 손에, 클라이언트는 무기고 미리보기에 같은 모양을 만든다.
-- 무기 모양, 등급별 빛 효과, 플레이어 오라, 적 장식을 만든다.
--
-- 구간이 오를수록 화려해진다
--   1구간: 쇠 칼날
--   2구간: + 희귀도 색 보석, 휘두를 때 궤적
--   3구간: + 칼날 가운데 빛나는 홈, 은은한 빛
--   4구간: + 유리 칼날, 반짝이 파티클
--   5구간: + 우주 칼날(포스필드), 별 파티클
--   6구간: + 빛나는 칼날, 무지개 궤적과 파티클
-- 전설 희귀도는 어느 구간이든 금빛 반짝임이 더해진다

local Builder = {}

local RAINBOW = ColorSequence.new({
	ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 80, 80)),
	ColorSequenceKeypoint.new(0.2, Color3.fromRGB(255, 200, 60)),
	ColorSequenceKeypoint.new(0.4, Color3.fromRGB(90, 230, 110)),
	ColorSequenceKeypoint.new(0.6, Color3.fromRGB(70, 200, 255)),
	ColorSequenceKeypoint.new(0.8, Color3.fromRGB(150, 100, 255)),
	ColorSequenceKeypoint.new(1, Color3.fromRGB(255, 90, 200)),
})
Builder.RAINBOW = RAINBOW

local STEEL = Color3.fromRGB(205, 208, 214)
local DARK_STEEL = Color3.fromRGB(70, 72, 80)
local LEATHER = Color3.fromRGB(70, 45, 30)
local GOLD = Color3.fromRGB(225, 180, 70)
local WOOD = Color3.fromRGB(85, 58, 38)

export type Look = {
	accent: Color3, -- 희귀도 색
	section: number, -- 1~6
	rarity: number, -- 1~5
	scale: number,
}

type Ctx = {
	parent: Instance,
	hand: BasePart,
	grip: CFrame,
	scale: number,
}

-- 무기 공간: Y = 칼끝 방향, Z = 칼날 폭(세로), X = 칼 두께
local function mk(ctx: Ctx, name: string, size: Vector3, offset: CFrame, color: Color3, material: Enum.Material, shape: Enum.PartType?): Part
	local p = Instance.new("Part")
	p.Name = name
	if shape then
		p.Shape = shape
	end
	p.Size = size * ctx.scale
	p.Color = color
	p.Material = material
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.Massless = true
	p.CastShadow = false
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.CFrame = ctx.grip * CFrame.new(offset.Position * ctx.scale) * offset.Rotation
	local weld = Instance.new("WeldConstraint")
	weld.Part0 = ctx.hand
	weld.Part1 = p
	weld.Parent = p
	p.Parent = ctx.parent
	return p
end

local function at(y: number, z: number?, rx: number?): CFrame
	return CFrame.new(0, y, z or 0) * CFrame.Angles(math.rad(rx or 0), 0, 0)
end

-- 구간에 따른 칼날 재질과 색
local function bladeStyle(look: Look): (Color3, Enum.Material)
	local s = look.section
	if s >= 6 then
		return Color3.fromRGB(255, 235, 245), Enum.Material.Neon
	elseif s == 5 then
		return look.accent, Enum.Material.ForceField
	elseif s == 4 then
		return STEEL:Lerp(look.accent, 0.55), Enum.Material.Glass
	elseif s == 3 then
		return STEEL:Lerp(look.accent, 0.3), Enum.Material.Metal
	end
	return STEEL:Lerp(look.accent, 0.15), Enum.Material.Metal
end

-- 칼날 가운데 홈. 3구간부터 빛난다
local function fuller(ctx: Ctx, look: Look, thickness: number, length: number, y: number)
	if look.section >= 3 then
		mk(ctx, "Fuller", Vector3.new(thickness + 0.04, length, 0.16), at(y), look.accent, Enum.Material.Neon)
	else
		mk(ctx, "Fuller", Vector3.new(thickness + 0.02, length, 0.12), at(y), DARK_STEEL, Enum.Material.Metal)
	end
end

local function gem(ctx: Ctx, look: Look, y: number, size: number)
	if look.section >= 2 or look.rarity >= 4 then
		mk(ctx, "Gem", Vector3.new(size, size, size), at(y, 0, 45), look.accent, Enum.Material.Neon)
	end
end

-- 칼끝: 45도 돌린 네모로 뾰족하게
local function tip(ctx: Ctx, color: Color3, material: Enum.Material, thickness: number, width: number, y: number): Part
	local d = width * 0.71
	return mk(ctx, "Tip", Vector3.new(thickness, d, d), at(y, 0, 45), color, material)
end

-- 무기 모양들. 각각 궤적 시작점과 끝점이 될 파트를 돌려준다
local shapes: { [number]: (Ctx, Look) -> (BasePart, Vector3, Vector3) } = {}

-- 대검: 넓고 두꺼운 칼날, 커다란 십자 가드
shapes[1] = function(ctx, look)
	local bc, bm = bladeStyle(look)
	local guardColor = look.rarity >= 5 and GOLD or DARK_STEEL
	mk(ctx, "Grip", Vector3.new(0.36, 1.8, 0.36), at(0), LEATHER, Enum.Material.Fabric)
	mk(ctx, "Pommel", Vector3.new(0.62, 0.62, 0.62), at(-1.05), guardColor, Enum.Material.Metal, Enum.PartType.Ball)
	mk(ctx, "Guard", Vector3.new(0.5, 0.36, 2.8), at(1.05), guardColor, Enum.Material.Metal)
	mk(ctx, "GuardL", Vector3.new(0.5, 0.7, 0.36), at(1.25, 1.3), guardColor, Enum.Material.Metal)
	mk(ctx, "GuardR", Vector3.new(0.5, 0.7, 0.36), at(1.25, -1.3), guardColor, Enum.Material.Metal)
	gem(ctx, look, 1.05, 0.5)
	local blade = mk(ctx, "Blade", Vector3.new(0.26, 5.6, 1.25), at(4.03), bc, bm)
	fuller(ctx, look, 0.26, 4.4, 3.6)
	tip(ctx, bc, bm, 0.26, 1.25, 6.83)
	return blade, Vector3.new(0, -2.6, 0), Vector3.new(0, 3.1, 0)
end

-- 쌍검: 짧고 날렵한 칼날 (손마다 하나)
shapes[2] = function(ctx, look)
	local bc, bm = bladeStyle(look)
	local guardColor = look.rarity >= 5 and GOLD or DARK_STEEL
	mk(ctx, "Grip", Vector3.new(0.28, 1.0, 0.28), at(0), LEATHER, Enum.Material.Fabric)
	mk(ctx, "Guard", Vector3.new(0.36, 0.2, 1.1), at(0.6, 0, -12), guardColor, Enum.Material.Metal)
	gem(ctx, look, 0.6, 0.3)
	local blade = mk(ctx, "Blade", Vector3.new(0.16, 3.0, 0.5), at(2.2, 0.08, 4), bc, bm)
	tip(ctx, bc, bm, 0.16, 0.5, 3.75)
	if look.section >= 3 then
		mk(ctx, "Edge", Vector3.new(0.18, 2.6, 0.08), at(2.1, 0.3, 4), look.accent, Enum.Material.Neon)
	end
	return blade, Vector3.new(0, -1.4, 0), Vector3.new(0, 1.6, 0)
end

-- 장검: 아주 길고 가는 칼날, 고리 모양 가드
shapes[3] = function(ctx, look)
	local bc, bm = bladeStyle(look)
	local guardColor = look.rarity >= 5 and GOLD or DARK_STEEL
	mk(ctx, "Grip", Vector3.new(0.3, 1.7, 0.3), at(0), LEATHER, Enum.Material.Fabric)
	mk(ctx, "Pommel", Vector3.new(0.45, 0.45, 0.45), at(-0.95), guardColor, Enum.Material.Metal, Enum.PartType.Ball)
	mk(ctx, "Guard", Vector3.new(0.4, 0.26, 1.8), at(0.95), guardColor, Enum.Material.Metal)
	mk(ctx, "GuardL", Vector3.new(0.4, 0.55, 0.26), at(0.75, 0.9), guardColor, Enum.Material.Metal)
	mk(ctx, "GuardR", Vector3.new(0.4, 0.55, 0.26), at(0.75, -0.9), guardColor, Enum.Material.Metal)
	gem(ctx, look, 0.95, 0.36)
	local blade = mk(ctx, "Blade", Vector3.new(0.18, 7.0, 0.52), at(4.6), bc, bm)
	fuller(ctx, look, 0.18, 5.8, 4.2)
	tip(ctx, bc, bm, 0.18, 0.52, 8.1)
	return blade, Vector3.new(0, -3.3, 0), Vector3.new(0, 3.6, 0)
end

-- 단검: 짧은 칼날과 손가락 보호대
shapes[4] = function(ctx, look)
	local bc, bm = bladeStyle(look)
	local guardColor = look.rarity >= 5 and GOLD or DARK_STEEL
	mk(ctx, "Grip", Vector3.new(0.3, 0.9, 0.3), at(0), LEATHER, Enum.Material.Fabric)
	mk(ctx, "Guard", Vector3.new(0.4, 0.2, 0.9), at(0.55), guardColor, Enum.Material.Metal)
	mk(ctx, "Knuckle", Vector3.new(0.2, 1.1, 0.16), at(0, -0.45), guardColor, Enum.Material.Metal)
	gem(ctx, look, 0.55, 0.28)
	local blade = mk(ctx, "Blade", Vector3.new(0.15, 1.9, 0.44), at(1.6), bc, bm)
	tip(ctx, bc, bm, 0.15, 0.44, 2.55)
	if look.section >= 3 then
		mk(ctx, "Edge", Vector3.new(0.17, 1.7, 0.08), at(1.5, 0.22), look.accent, Enum.Material.Neon)
	end
	return blade, Vector3.new(0, -0.9, 0), Vector3.new(0, 1.0, 0)
end

-- 낫: 긴 자루 끝에서 아래로 휘어 내려오는 날
shapes[5] = function(ctx, look)
	local bc, bm = bladeStyle(look)
	local ringColor = look.rarity >= 5 and GOLD or DARK_STEEL
	mk(ctx, "Shaft", Vector3.new(0.3, 6.4, 0.3), at(2.6), WOOD, Enum.Material.Wood)
	for i, y in ipairs({ 0.2, 2.8, 5.4 }) do
		mk(ctx, "Band" .. i, Vector3.new(0.4, 0.22, 0.4), at(y), ringColor, Enum.Material.Metal)
	end
	gem(ctx, look, 5.85, 0.36)
	-- 날: 자루 끝(O)에서 시작해 원을 따라 아래로, 뒤로 휜다
	local oy, radius, segs, sweep = 5.8, 2.6, 5, 110
	local last: Part? = nil
	for i = 0, segs - 1 do
		local a0 = math.rad(sweep * i / segs)
		local a1 = math.rad(sweep * (i + 1) / segs)
		local y0, z0 = oy - radius + radius * math.cos(a0), -radius * math.sin(a0)
		local y1, z1 = oy - radius + radius * math.cos(a1), -radius * math.sin(a1)
		local dy, dz = y1 - y0, z1 - z0
		local len = math.sqrt(dy * dy + dz * dz) + 0.08
		local width = 0.7 - 0.45 * (i / (segs - 1))
		local angle = math.deg(math.atan2(dz, dy))
		-- 날은 바깥쪽(자루 쪽 반대)으로 폭을 준다
		local cf = CFrame.new(0, (y0 + y1) / 2, (z0 + z1) / 2) * CFrame.Angles(math.rad(angle), 0, 0) * CFrame.new(0, 0, width / 2 - 0.1)
		last = mk(ctx, "Blade" .. i, Vector3.new(0.14, len, width), cf, bc, bm)
		if look.section >= 3 then
			mk(ctx, "Edge" .. i, Vector3.new(0.16, len, 0.08), cf * CFrame.new(0, 0, width / 2), look.accent, Enum.Material.Neon)
		end
	end
	tip(ctx, bc, bm, 0.14, 0.5, oy + 0.35)
	return (last :: Part), Vector3.new(0, 0, 0), Vector3.new(0, 0, 0)
end

-- 올라운더: 거대한 백금 칼날, 날개 가드, 칼날을 감싼 빛 고리
shapes[0] = function(ctx, look)
	local bc = Color3.fromRGB(255, 248, 225)
	mk(ctx, "Grip", Vector3.new(0.38, 1.9, 0.38), at(0), Color3.fromRGB(40, 30, 60), Enum.Material.Fabric)
	mk(ctx, "Pommel", Vector3.new(0.7, 0.7, 0.7), at(-1.1), GOLD, Enum.Material.Neon, Enum.PartType.Ball)
	mk(ctx, "Guard", Vector3.new(0.55, 0.4, 3.0), at(1.1), GOLD, Enum.Material.Metal)
	mk(ctx, "WingL", Vector3.new(0.3, 2.2, 0.5), at(1.6, 1.6, 35), Color3.fromRGB(255, 240, 200), Enum.Material.Neon)
	mk(ctx, "WingR", Vector3.new(0.3, 2.2, 0.5), at(1.6, -1.6, -35), Color3.fromRGB(255, 240, 200), Enum.Material.Neon)
	mk(ctx, "Gem", Vector3.new(0.6, 0.6, 0.6), at(1.1, 0, 45), Color3.fromRGB(255, 120, 200), Enum.Material.Neon)
	local blade = mk(ctx, "Blade", Vector3.new(0.3, 6.6, 1.4), at(4.6), bc, Enum.Material.Neon)
	mk(ctx, "Core", Vector3.new(0.34, 5.6, 0.3), at(4.3), Color3.fromRGB(255, 150, 210), Enum.Material.Neon)
	tip(ctx, bc, Enum.Material.Neon, 0.3, 1.4, 7.9)
	for i = 0, 9 do
		local a = (i / 10) * math.pi * 2
		local cf = CFrame.new(math.cos(a) * 1.3, 5.2, math.sin(a) * 1.3) * CFrame.Angles(0, -a, 0)
		mk(ctx, "Halo" .. i, Vector3.new(0.2, 0.2, 0.85), cf, GOLD, Enum.Material.Neon)
	end
	return blade, Vector3.new(0, -3.1, 0), Vector3.new(0, 3.6, 0)
end

local function addTrail(blade: BasePart, a0Pos: Vector3, a1Pos: Vector3, look: Look, rainbow: boolean)
	if a0Pos == a1Pos then
		a0Pos = Vector3.new(0, -blade.Size.Y / 2, 0)
		a1Pos = Vector3.new(0, blade.Size.Y / 2, 0)
	end
	local a0 = Instance.new("Attachment")
	a0.Name = "TrailBase"
	a0.Position = a0Pos
	a0.Parent = blade
	local a1 = Instance.new("Attachment")
	a1.Name = "TrailTip"
	a1.Position = a1Pos
	a1.Parent = blade
	local trail = Instance.new("Trail")
	trail.Attachment0 = a0
	trail.Attachment1 = a1
	trail.Lifetime = look.section >= 4 and 0.28 or 0.18
	trail.MinLength = 0.05
	trail.LightEmission = look.section >= 3 and 0.8 or 0.3
	trail.FaceCamera = false
	trail.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.25),
		NumberSequenceKeypoint.new(1, 1),
	})
	trail.Color = rainbow and RAINBOW or ColorSequence.new(look.accent)
	trail.Parent = blade
end

local function addSparkles(blade: BasePart, look: Look, rainbow: boolean)
	local p = Instance.new("ParticleEmitter")
	p.Name = "BladeSparkle"
	p.Rate = look.section >= 5 and 14 or 8
	p.Lifetime = NumberRange.new(0.5, 1.0)
	p.Speed = NumberRange.new(0.3, 1.2)
	p.SpreadAngle = Vector2.new(180, 180)
	p.Size = NumberSequence.new({
		NumberSequenceKeypoint.new(0, look.section >= 5 and 0.3 or 0.2),
		NumberSequenceKeypoint.new(1, 0),
	})
	p.LightEmission = 1
	p.Color = rainbow and RAINBOW or ColorSequence.new(look.accent)
	p.Parent = blade
end

-- 무기 하나를 손에 붙인다. 손에 붙은 Model을 돌려준다
function Builder.build(parent: Instance, hand: BasePart, typeId: number, look: Look, gripOverride: CFrame?): Model
	local model = Instance.new("Model")
	model.Name = "Weapon"
	model.Parent = parent
	local grip = gripOverride or (hand.CFrame * CFrame.new(0, -hand.Size.Y / 2, 0) * CFrame.Angles(math.rad(-90), 0, 0))
	local ctx: Ctx = { parent = model, hand = hand, grip = grip, scale = look.scale }
	local shape = shapes[typeId] or shapes[1]
	local blade, a0, a1 = shape(ctx, look)
	local rainbow = look.section >= 6 or typeId == 0

	if look.section >= 2 or typeId == 0 then
		addTrail(blade, a0 * look.scale, a1 * look.scale, look, rainbow)
	end
	if look.section >= 3 or typeId == 0 then
		local light = Instance.new("PointLight")
		light.Color = rainbow and Color3.fromRGB(255, 220, 240) or look.accent
		light.Range = 6 + look.section * 1.5
		light.Brightness = 0.8 + look.section * 0.3
		light.Parent = blade
	end
	if look.section >= 4 or typeId == 0 then
		addSparkles(blade, look, rainbow)
	end
	if look.rarity >= 5 and look.section >= 2 then
		local glint = Instance.new("Sparkles")
		glint.SparkleColor = GOLD
		glint.Parent = blade
	end
	return model
end

-- 장착 무기 구간에 따라 캐릭터 주위에 오라를 붙인다
function Builder.applyAura(char: Model, section: number, color: Color3)
	local root = char:FindFirstChild("HumanoidRootPart")
	if not root then
		return
	end
	for _, child in ipairs(root:GetChildren()) do
		if child.Name == "RankAura" then
			child:Destroy()
		end
	end
	if section < 3 then
		return
	end
	local rainbow = section >= 6
	local aura = Instance.new("ParticleEmitter")
	aura.Name = "RankAura"
	aura.Rate = 4 + (section - 3) * 4
	aura.Lifetime = NumberRange.new(0.8, 1.4)
	aura.Speed = NumberRange.new(1.5, 3)
	aura.SpreadAngle = Vector2.new(25, 25)
	aura.EmissionDirection = Enum.NormalId.Top
	aura.Size = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.6 + section * 0.1),
		NumberSequenceKeypoint.new(1, 0),
	})
	aura.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.4),
		NumberSequenceKeypoint.new(1, 1),
	})
	aura.LightEmission = 0.8
	aura.Color = rainbow and RAINBOW or ColorSequence.new(color)
	aura.Parent = root
	if section >= 5 then
		local light = Instance.new("PointLight")
		light.Name = "RankAura"
		light.Color = rainbow and Color3.fromRGB(255, 200, 235) or color
		light.Range = 10
		light.Brightness = 1.2
		light.Parent = root
	end
end

-- 적 장식: 높은 구간일수록 무기와 오라, 보스는 왕관과 붉은 오라
function Builder.decorateEnemy(model: Model, grade: number, section: number, color: Color3, isBoss: boolean, scale: number)
	local hand = model:FindFirstChild("RightHand")
	if hand and hand:IsA("BasePart") and (section >= 2 or isBoss) then
		Builder.build(model, hand, (grade % 5) + 1, {
			accent = isBoss and Color3.fromRGB(255, 60, 50) or color,
			section = math.max(1, section - 1),
			rarity = isBoss and 5 or 1,
			scale = scale,
		})
	end
	local torso = model:FindFirstChild("UpperTorso") or model:FindFirstChild("HumanoidRootPart")
	if torso and (section >= 3 or isBoss) then
		local aura = Instance.new("ParticleEmitter")
		aura.Name = "EnemyAura"
		aura.Rate = isBoss and 18 or 6
		aura.Lifetime = NumberRange.new(0.6, 1.2)
		aura.Speed = NumberRange.new(1, 3)
		aura.EmissionDirection = Enum.NormalId.Top
		aura.Size = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0.8 * scale),
			NumberSequenceKeypoint.new(1, 0),
		})
		aura.Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0.5),
			NumberSequenceKeypoint.new(1, 1),
		})
		aura.LightEmission = 0.7
		aura.Color = ColorSequence.new(isBoss and Color3.fromRGB(255, 50, 40) or color)
		aura.Parent = torso
	end
	local head = model:FindFirstChild("Head")
	if isBoss and head and head:IsA("BasePart") then
		-- 왕관: 머리 위에 금빛 뿔 다섯 개
		local top = head.CFrame * CFrame.new(0, head.Size.Y / 2 + 0.1 * scale, 0)
		for i = 0, 4 do
			local a = (i / 5) * math.pi * 2
			local r = head.Size.X * 0.38
			local spike = Instance.new("Part")
			spike.Name = "Crown" .. i
			spike.Size = Vector3.new(0.22, 0.6, 0.22) * scale
			spike.Color = GOLD
			spike.Material = Enum.Material.Neon
			spike.CanCollide = false
			spike.CanQuery = false
			spike.Massless = true
			spike.CFrame = top * CFrame.new(math.cos(a) * r, 0.25 * scale, math.sin(a) * r)
			local w = Instance.new("WeldConstraint")
			w.Part0 = head
			w.Part1 = spike
			w.Parent = spike
			spike.Parent = model
		end
		local light = Instance.new("PointLight")
		light.Color = Color3.fromRGB(255, 70, 50)
		light.Range = 16
		light.Brightness = 2
		light.Parent = head
	end
end

return Builder
]]></string>
      </Properties>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="4">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Script" referent="5">
      <Properties>
        <string name="Name">ArenaServer</string>
        <token name="RunContext">0</token>
        <string name="Source"><![CDATA[-- ArenaServer (Script, ServerScriptService)
-- 전투, 필살기, 합성, 훈련, 저장을 맡는다. 맵은 WorldBuilder, 무기 모양은 WeaponBuilder가 만든다.
-- 중요한 계산은 전부 서버에서 하고, 클라이언트는 요청만 보낸다.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local DataStoreService = game:GetService("DataStoreService")
local ServerStorage = game:GetService("ServerStorage")
local Debris = game:GetService("Debris")

local Config = require(ReplicatedStorage:WaitForChild("GameConfig"))
local World = require(script:WaitForChild("WorldBuilder"))
local WeaponBuilder = require(ReplicatedStorage:WaitForChild("WeaponBuilder"))

local ARENA_ORIGIN = Vector3.new(0, 300, 1600)
local ARENA_SPACING = 320
local ARENA_RADIUS = 60
local ENEMY_SPAWN_RADIUS = 35
local SAVE_INTERVAL = 90
local DATASTORE_NAME = "Arena100_v1"
local WALK_ANIM_ID = "rbxassetid://507777826" -- 로블록스 기본 R15 걷기

------------------------------------------------------------------------
-- 통신 채널
------------------------------------------------------------------------
local remoteFolder = Instance.new("Folder")
remoteFolder.Name = "ArenaRemotes"
local Request = Instance.new("RemoteEvent")
Request.Name = "Request"
Request.Parent = remoteFolder
local Push = Instance.new("RemoteEvent")
Push.Name = "Push"
Push.Parent = remoteFolder
remoteFolder.Parent = ReplicatedStorage

local battleRoot = Instance.new("Folder")
battleRoot.Name = "ArenaBattles"
battleRoot.Parent = workspace

------------------------------------------------------------------------
-- 맵
------------------------------------------------------------------------
World.setupLighting()
local lobbySpawn: CFrame = World.buildLobby(function(player: Player)
	Push:FireClient(player, "openPage", "stage")
end)

local arenas: { [number]: World.Arena } = {}
local slotOwner: { [number]: Player } = {}

local function claimSlot(player: Player): number
	local i = 1
	while slotOwner[i] do
		i += 1
	end
	slotOwner[i] = player
	if not arenas[i] then
		arenas[i] = World.buildArena(ARENA_ORIGIN + Vector3.new((i - 1) * ARENA_SPACING, 0, 0), ARENA_RADIUS, "Arena" .. i)
	end
	return i
end

------------------------------------------------------------------------
-- 저장
------------------------------------------------------------------------
local store: DataStore? = nil
do
	local ok, ds = pcall(function()
		return DataStoreService:GetDataStore(DATASTORE_NAME)
	end)
	if ok then
		store = ds
	end
end

type Profile = {
	version: number,
	coins: number,
	atkLv: number,
	hpLv: number,
	maxStage: number,
	inv: { [string]: number },
	equipped: string,
}

local function defaultProfile(): Profile
	return {
		version = 1,
		coins = 0,
		atkLv = 0,
		hpLv = 0,
		maxStage = 0,
		inv = { [Config.STARTER_KEY] = 1 },
		equipped = Config.STARTER_KEY,
	}
end

local function bestKey(p: Profile): string
	local best, bestPower = Config.STARTER_KEY, -1
	for key in pairs(p.inv) do
		local power = Config.playerStats(key, p.atkLv, p.hpLv).power
		if power > bestPower then
			best, bestPower = key, power
		end
	end
	return best
end

local function sanitize(data: any): Profile
	local p = defaultProfile()
	if type(data) ~= "table" then
		return p
	end
	local function num(v, lo, hi)
		if type(v) ~= "number" or v ~= v then
			return lo
		end
		return math.clamp(v, lo, hi)
	end
	p.coins = num(data.coins, 0, math.huge)
	p.atkLv = math.floor(num(data.atkLv, 0, 100000))
	p.hpLv = math.floor(num(data.hpLv, 0, 100000))
	p.maxStage = math.floor(num(data.maxStage, 0, Config.MAX_GRADE))
	if type(data.inv) == "table" then
		local inv = {}
		for k, v in pairs(data.inv) do
			if Config.parseKey(k) and type(v) == "number" and v >= 1 then
				inv[k] = math.floor(v)
			end
		end
		if next(inv) then
			p.inv = inv
		end
	end
	if type(data.equipped) == "string" and p.inv[data.equipped] then
		p.equipped = data.equipped
	else
		p.equipped = bestKey(p)
	end
	return p
end

local function loadProfile(player: Player): (Profile, boolean)
	local ds = store
	if not ds then
		return defaultProfile(), false
	end
	for attempt = 1, 3 do
		local ok, result = pcall(function()
			return ds:GetAsync("p_" .. player.UserId)
		end)
		if ok then
			return sanitize(result), true
		end
		warn("[Arena] 불러오기 실패 (" .. attempt .. "/3):", result)
		task.wait(1.5 * attempt)
	end
	-- 불러오기에 실패했을 때 저장까지 하면 기존 기록을 덮어쓰므로 저장을 끈다
	return defaultProfile(), false
end

------------------------------------------------------------------------
-- 플레이어 상태
------------------------------------------------------------------------
type Enemy = {
	model: Model,
	hum: Humanoid,
	root: BasePart,
	hp: number,
	maxHp: number,
	dmg: number,
	slamDmg: number,
	isBoss: boolean,
	alive: boolean,
	busy: boolean,
	reach: number,
	bodyRadius: number,
	scale: number,
	nextAttack: number,
	nextSlam: number,
	nextMove: number,
	fill: Frame,
	walkTrack: AnimationTrack?,
	walking: boolean,
}

type Session = {
	stage: number,
	info: any,
	arena: World.Arena,
	folder: Folder,
	enemies: { Enemy },
	stats: any,
	hp: number,
	maxHp: number,
	invulnUntil: number,
	lastAttack: number,
	gauge: number,
	ulting: boolean,
	running: boolean,
}

type State = {
	slot: number?,
	session: Session?,
	auto: boolean,
	canSave: boolean,
	dirty: boolean,
	reqCount: number,
	reqWindow: number,
	lastDash: number,
}

local profiles: { [Player]: Profile } = {}
local states: { [Player]: State } = {}

local function saveProfile(player: Player)
	local st, p, ds = states[player], profiles[player], store
	if not (st and p and ds and st.canSave) then
		return
	end
	local ok, err = pcall(function()
		ds:SetAsync("p_" .. player.UserId, p)
	end)
	if ok then
		st.dirty = false
	else
		warn("[Arena] 저장 실패:", err)
	end
end

local function getRoot(player: Player): (BasePart?, Humanoid?)
	local char = player.Character
	if not char then
		return nil, nil
	end
	local root = char:FindFirstChild("HumanoidRootPart")
	local hum = char:FindFirstChildOfClass("Humanoid")
	if root and root:IsA("BasePart") and hum and hum.Health > 0 then
		return root, hum
	end
	return nil, nil
end

local function currentStats(player: Player)
	local p = profiles[player]
	return Config.playerStats(p.equipped, p.atkLv, p.hpLv)
end

local function toast(player: Player, text: string)
	Push:FireClient(player, "toast", text)
end

local function pushState(player: Player)
	local p, st = profiles[player], states[player]
	if not p or not st then
		return
	end
	Push:FireClient(player, "state", {
		coins = p.coins,
		atkLv = p.atkLv,
		hpLv = p.hpLv,
		maxStage = p.maxStage,
		inv = p.inv,
		equipped = p.equipped,
		power = currentStats(player).power,
		auto = st.auto,
		canSave = st.canSave,
	})
end

local function aliveCount(s: Session): number
	local n = 0
	for _, e in ipairs(s.enemies) do
		if e.alive then
			n += 1
		end
	end
	return n
end

local function pushBattle(player: Player)
	local st = states[player]
	local s = st and st.session
	if not s then
		Push:FireClient(player, "battle", { active = false })
		return
	end
	Push:FireClient(player, "battle", {
		active = true,
		stage = s.stage,
		boss = s.info.isBoss,
		hp = s.hp,
		maxHp = s.maxHp,
		left = aliveCount(s),
		total = #s.enemies,
		auto = st.auto,
		gauge = s.gauge,
	})
end

-- 명예의 전당: 이 서버 최고 기록 5명
local function refreshHall()
	local list = {}
	for player, p in pairs(profiles) do
		if p.maxStage > 0 then
			table.insert(list, { name = player.DisplayName, stage = p.maxStage })
		end
	end
	table.sort(list, function(a, b)
		return a.stage > b.stage
	end)
	World.setHallOfFame(list)
end

------------------------------------------------------------------------
-- 칭호, 무기, 오라
------------------------------------------------------------------------
local function updateTitle(player: Player)
	local p = profiles[player]
	if not p then
		return
	end
	local ls = player:FindFirstChild("leaderstats")
	local rankName = p.maxStage > 0 and Config.getGrade(p.maxStage).en or "-"
	if ls then
		local rankValue = ls:FindFirstChild("등급")
		local stageValue = ls:FindFirstChild("스테이지")
		if rankValue and rankValue:IsA("StringValue") then
			rankValue.Value = rankName
		end
		if stageValue and stageValue:IsA("IntValue") then
			stageValue.Value = p.maxStage
		end
	end

	local char = player.Character
	local head = char and char:FindFirstChild("Head")
	if not head then
		return
	end
	local old = head:FindFirstChild("RankTitle")
	if old then
		old:Destroy()
	end
	local gui = Instance.new("BillboardGui")
	gui.Name = "RankTitle"
	gui.Size = UDim2.new(0, 300, 0, 46)
	gui.StudsOffset = Vector3.new(0, 2.6, 0)
	gui.MaxDistance = 160
	gui.LightInfluence = 0
	local top = Instance.new("TextLabel")
	top.Size = UDim2.new(1, 0, 0.35, 0)
	top.BackgroundTransparency = 1
	top.Font = Enum.Font.GothamBold
	top.TextScaled = true
	top.TextColor3 = Color3.fromRGB(230, 220, 200)
	top.TextStrokeTransparency = 0.4
	top.Parent = gui
	local main = Instance.new("TextLabel")
	main.Position = UDim2.new(0, 0, 0.35, 0)
	main.Size = UDim2.new(1, 0, 0.65, 0)
	main.BackgroundTransparency = 1
	main.Font = Enum.Font.GothamBlack
	main.TextScaled = true
	main.TextStrokeTransparency = 0.15
	main.Parent = gui
	if p.maxStage <= 0 then
		top.Text = "도전자"
		main.Text = "NO RANK"
		main.TextColor3 = Color3.fromRGB(170, 170, 170)
	else
		local section, sectionIndex = Config.getSection(p.maxStage)
		top.Text = string.format("%d구간 · %s", sectionIndex, section.name)
		main.Text = string.format("[%d] %s", p.maxStage, rankName)
		main.TextStrokeColor3 = section.color:Lerp(Color3.new(0, 0, 0), 0.7)
		if section.rainbow then
			main.TextColor3 = Color3.new(1, 1, 1)
			local g = Instance.new("UIGradient")
			g.Color = WeaponBuilder.RAINBOW
			g.Parent = main
		else
			main.TextColor3 = section.color
		end
	end
	gui.Parent = head
end

local function attachWeapon(player: Player)
	local p = profiles[player]
	local char = player.Character
	if not p or not char then
		return
	end
	local old = char:FindFirstChild("ArenaWeapon")
	if old then
		old:Destroy()
	end
	local info = Config.weaponInfo(p.equipped)
	if not info then
		return
	end
	local right = char:FindFirstChild("RightHand") or char:FindFirstChild("Right Arm")
	local left = char:FindFirstChild("LeftHand") or char:FindFirstChild("Left Arm")
	if not (right and right:IsA("BasePart")) then
		return
	end
	local section, sectionIndex = Config.getSection(info.grade)
	if info.typeId == 0 then
		sectionIndex = 6
	end
	local look = {
		accent = info.typeId == 0 and Color3.fromRGB(255, 235, 160) or info.rarity.color,
		section = sectionIndex,
		rarity = info.rarity.rank,
		scale = 1 + (sectionIndex - 1) * 0.06,
	}
	local holder = Instance.new("Model")
	holder.Name = "ArenaWeapon"
	holder.Parent = char
	WeaponBuilder.build(holder, right, info.typeId, look)
	if info.typeId == 2 and left and left:IsA("BasePart") then
		WeaponBuilder.build(holder, left, 2, look)
	end
	WeaponBuilder.applyAura(char, sectionIndex, section.color)
end

------------------------------------------------------------------------
-- 적
------------------------------------------------------------------------
local rigTemplate: Model? = nil
local rigLoading = false

local function buildBlockRig(): Model
	local model = Instance.new("Model")
	local root = Instance.new("Part")
	root.Name = "HumanoidRootPart"
	root.Size = Vector3.new(2, 2, 1)
	root.Parent = model
	local head = Instance.new("Part")
	head.Name = "Head"
	head.Size = Vector3.new(1.4, 1.4, 1.4)
	head.CFrame = root.CFrame * CFrame.new(0, 1.7, 0)
	head.Parent = model
	local weld = Instance.new("WeldConstraint")
	weld.Part0 = root
	weld.Part1 = head
	weld.Parent = head
	local hum = Instance.new("Humanoid")
	hum.RigType = Enum.HumanoidRigType.R15
	hum.HipHeight = 1.5
	hum.Parent = model
	model.PrimaryPart = root
	return model
end

local function getRigTemplate(): Model
	while rigLoading and not rigTemplate do
		task.wait(0.1)
	end
	if rigTemplate then
		return rigTemplate
	end
	rigLoading = true
	local ok, result = pcall(function()
		local desc = Instance.new("HumanoidDescription")
		return Players:CreateHumanoidModelFromDescription(desc, Enum.HumanoidRigType.R15)
	end)
	local model: Model
	if ok and result then
		model = result
	else
		warn("[Arena] 기본 인형을 만들지 못해 블록 인형을 씁니다:", result)
		model = buildBlockRig()
	end
	model.Name = "EnemyRig"
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("BodyColors") or d:IsA("Clothing") or d:IsA("ShirtGraphic") then
			d:Destroy()
		end
	end
	model.Parent = ServerStorage
	rigTemplate = model
	rigLoading = false
	return model
end

local function makeHpBar(root: BasePart, labelText: string, color: Color3, height: number, isBoss: boolean): Frame
	local gui = Instance.new("BillboardGui")
	gui.Name = "HpBar"
	gui.Size = isBoss and UDim2.new(0, 230, 0, 46) or UDim2.new(0, 150, 0, 34)
	gui.StudsOffset = Vector3.new(0, height, 0)
	gui.AlwaysOnTop = true
	gui.MaxDistance = 130
	gui.LightInfluence = 0
	local name = Instance.new("TextLabel")
	name.Size = UDim2.new(1, 0, 0.55, 0)
	name.BackgroundTransparency = 1
	name.Font = Enum.Font.GothamBlack
	name.TextScaled = true
	name.TextColor3 = color
	name.TextStrokeTransparency = 0.2
	name.Text = labelText
	name.Parent = gui
	local back = Instance.new("Frame")
	back.Size = UDim2.new(1, 0, 0.35, 0)
	back.Position = UDim2.new(0, 0, 0.62, 0)
	back.BackgroundColor3 = Color3.fromRGB(25, 15, 15)
	back.BorderSizePixel = 0
	back.Parent = gui
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 4)
	corner.Parent = back
	local stroke = Instance.new("UIStroke")
	stroke.Color = isBoss and Color3.fromRGB(255, 200, 80) or Color3.fromRGB(0, 0, 0)
	stroke.Thickness = isBoss and 2 or 1
	stroke.Parent = back
	local fill = Instance.new("Frame")
	fill.Name = "Fill"
	fill.Size = UDim2.fromScale(1, 1)
	fill.BackgroundColor3 = Color3.fromRGB(235, 70, 60)
	fill.BorderSizePixel = 0
	fill.Parent = back
	local fillCorner = Instance.new("UICorner")
	fillCorner.CornerRadius = UDim.new(0, 4)
	fillCorner.Parent = fill
	local grad = Instance.new("UIGradient")
	grad.Color = ColorSequence.new(Color3.fromRGB(255, 120, 90), Color3.fromRGB(190, 30, 40))
	grad.Rotation = 90
	grad.Parent = fill
	gui.Parent = root
	return fill
end

local function spawnEnemy(s: Session, grade: number, isBoss: boolean, pos: Vector3, hp: number, dmg: number)
	local model = getRigTemplate():Clone()
	local hum = model:FindFirstChildOfClass("Humanoid")
	local root = model:FindFirstChild("HumanoidRootPart")
	if not hum or not root or not root:IsA("BasePart") then
		model:Destroy()
		return
	end
	local section, sectionIndex = Config.getSection(grade)
	local bodyColor = section.color:Lerp(Color3.fromRGB(40, 35, 35), 0.25)
	if isBoss then
		bodyColor = section.color:Lerp(Color3.fromRGB(110, 0, 10), 0.5)
	end
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("BasePart") and d.Name ~= "HumanoidRootPart" then
			d.Color = bodyColor
			if sectionIndex >= 5 then
				d.Material = Enum.Material.ForceField
			elseif isBoss or sectionIndex >= 4 then
				d.Material = Enum.Material.Neon
			elseif sectionIndex >= 2 then
				d.Material = Enum.Material.Metal
			else
				d.Material = Enum.Material.SmoothPlastic
			end
		end
	end
	hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
	hum.WalkSpeed = isBoss and 11 or 13
	hum.BreakJointsOnDeath = false
	hum:SetStateEnabled(Enum.HumanoidStateType.Dead, false)

	local scale = section.scale * (isBoss and 1.8 or 1)
	pcall(function()
		model:ScaleTo(scale)
	end)
	model.Name = (isBoss and "BOSS " or "") .. Config.getGrade(grade).en
	model:SetAttribute("Enemy", true)
	model:PivotTo(CFrame.lookAt(pos + Vector3.new(0, 4 * scale, 0), s.arena.center + Vector3.new(0, 4 * scale, 0)))
	WeaponBuilder.decorateEnemy(model, grade, sectionIndex, section.color, isBoss, scale)
	model.Parent = s.folder
	pcall(function()
		(root :: BasePart):SetNetworkOwner(nil)
	end)

	-- 로블록스 기본 R15 걷기 동작. 블록 인형이면 조용히 건너뛴다
	local walkTrack: AnimationTrack? = nil
	pcall(function()
		local animator = hum:FindFirstChildOfClass("Animator")
		if not animator then
			animator = Instance.new("Animator")
			animator.Parent = hum
		end
		local anim = Instance.new("Animation")
		anim.AnimationId = WALK_ANIM_ID
		local track = (animator :: Animator):LoadAnimation(anim)
		track.Looped = true
		walkTrack = track
	end)

	local label = string.format("%s[%d] %s", isBoss and "👑 BOSS " or "", grade, Config.getGrade(grade).en)
	local fill = makeHpBar(root, label, isBoss and Color3.fromRGB(255, 110, 90) or section.color, 3.2 * scale, isBoss)
	local now = os.clock()
	table.insert(s.enemies, {
		model = model,
		hum = hum,
		root = root,
		hp = hp,
		maxHp = hp,
		dmg = dmg,
		slamDmg = s.info.slamDmg,
		isBoss = isBoss,
		alive = true,
		busy = false,
		reach = 4.5 * scale,
		bodyRadius = 1.2 * scale,
		scale = scale,
		nextAttack = now + 1 + math.random(),
		nextSlam = now + 4,
		nextMove = 0,
		fill = fill,
		walkTrack = walkTrack,
		walking = false,
	})
end

local function updateWalk(e: Enemy)
	local track = e.walkTrack
	if not track then
		return
	end
	local moving = e.alive and e.root.AssemblyLinearVelocity.Magnitude > 1.5
	if moving ~= e.walking then
		e.walking = moving
		if moving then
			track:Play(0.15)
		else
			track:Stop(0.15)
		end
	end
end

local function flashEnemy(e: Enemy, color: Color3, duration: number)
	local h = Instance.new("Highlight")
	h.FillColor = color
	h.FillTransparency = 0.3
	h.OutlineTransparency = 1
	h.DepthMode = Enum.HighlightDepthMode.Occluded
	h.Parent = e.model
	Debris:AddItem(h, duration)
end

------------------------------------------------------------------------
-- 전투
------------------------------------------------------------------------
local startStage: (Player, any, boolean) -> ()
local loseBattle: (Player, State, Session) -> ()

local function endSession(player: Player, st: State)
	local s = st.session
	if not s then
		return
	end
	s.running = false
	st.session = nil
	s.folder:Destroy()
	pushBattle(player)
end

local function teleportToLobby(player: Player)
	local char = player.Character
	if char then
		local offset = Vector3.new(math.random(-8, 8), 0, math.random(-8, 8))
		char:PivotTo(lobbySpawn + offset)
	end
end

local function flat(v: Vector3): Vector3
	return Vector3.new(v.X, 0, v.Z)
end

local function flatUnit(v: Vector3): Vector3
	local f = flat(v)
	if f.Magnitude < 0.001 then
		return Vector3.new(0, 0, -1)
	end
	return f.Unit
end

local function damagePlayer(player: Player, st: State, s: Session, amount: number)
	if not s.running or os.clock() < s.invulnUntil then
		return
	end
	s.hp -= amount
	local root = getRoot(player)
	if root then
		Push:FireClient(player, "hits", {
			{ pos = root.Position + Vector3.new(0, 3, 0), text = "-" .. Config.formatNumber(amount), kind = "hurt" },
		})
	end
	if s.hp <= 0 then
		s.hp = 0
		loseBattle(player, st, s)
	else
		pushBattle(player)
	end
end

local function killEnemy(e: Enemy)
	e.alive = false
	e.model:SetAttribute("Dead", true)
	e.hum.WalkSpeed = 0
	for _, d in ipairs(e.model:GetDescendants()) do
		if d:IsA("BasePart") and d.Name ~= "HumanoidRootPart" then
			d.Transparency = 0.6
		elseif d:IsA("ParticleEmitter") then
			d.Enabled = false
		end
	end
	Debris:AddItem(e.model, 0.45)
end

-- 적 하나에게 피해. 치명타면 날려 보낸다
local function hitEnemy(s: Session, e: Enemy, dmg: number, crit: boolean, fromPos: Vector3, hits: { any })
	if not e.alive then
		return 0
	end
	e.hp -= dmg
	table.insert(hits, {
		pos = e.root.Position + Vector3.new(0, 2.5 * e.scale, 0),
		text = Config.formatNumber(dmg),
		kind = crit and "crit" or "hit",
	})
	if crit and not e.isBoss then
		local away = flatUnit(e.root.Position - fromPos)
		e.root.AssemblyLinearVelocity = away * 38 + Vector3.new(0, 22, 0)
	end
	if e.hp <= 0 then
		killEnemy(e)
	else
		e.fill.Size = UDim2.fromScale(math.clamp(e.hp / e.maxHp, 0, 1), 1)
	end
	return dmg
end

local function rollDamage(stats: any): (number, boolean)
	local wt = stats.weapon.type
	local dmg = stats.atk * (0.9 + math.random() * 0.2)
	local crit = wt.critChance ~= nil and math.random() < wt.critChance
	if crit then
		dmg *= wt.critMult
	end
	return dmg, crit
end

local function weaponColor(stats: any): Color3
	return stats.weapon.typeId == 0 and Color3.fromRGB(255, 235, 160) or stats.weapon.rarity.color
end

local function performAttack(player: Player, st: State, s: Session)
	if not s.running or s.ulting then
		return
	end
	local stats = s.stats
	local now = os.clock()
	if now - s.lastAttack < stats.cooldown - 0.03 then
		return
	end
	local root = getRoot(player)
	if not root then
		return
	end
	local wt = stats.weapon.type
	local origin = flat(root.Position)
	local look = flatUnit(root.CFrame.LookVector)

	-- 사거리 안의 적을 가까운 순으로
	local inRange = {}
	for _, e in ipairs(s.enemies) do
		if e.alive and e.root.Parent then
			local offset = flat(e.root.Position) - origin
			local dist = offset.Magnitude - e.bodyRadius
			if dist <= wt.range then
				table.insert(inRange, { e = e, dist = dist, offset = offset })
			end
		end
	end
	if #inRange == 0 then
		return
	end
	table.sort(inRange, function(a, b)
		return a.dist < b.dist
	end)

	local targets: { Enemy } = {}
	if wt.mode == "around" then
		for _, c in ipairs(inRange) do
			table.insert(targets, c.e)
		end
	elseif wt.mode == "line" then
		for _, c in ipairs(inRange) do
			local facing = c.offset.Magnitude < 4 or (c.offset.Unit:Dot(look) > 0.2)
			if facing then
				table.insert(targets, c.e)
				if #targets >= (wt.maxTargets or 3) then
					break
				end
			end
		end
		if #targets == 0 then
			table.insert(targets, inRange[1].e)
		end
	else
		table.insert(targets, inRange[1].e)
	end

	s.lastAttack = now
	local hits = {}
	local healed = 0
	local anyCrit = false
	for _, e in ipairs(targets) do
		local dmg, crit = rollDamage(stats)
		anyCrit = anyCrit or crit
		hitEnemy(s, e, dmg, crit, root.Position, hits)
		if wt.lifesteal then
			healed += dmg * wt.lifesteal
		end
	end
	if healed > 0 then
		s.hp = math.min(s.maxHp, s.hp + healed)
	end
	s.gauge = math.min(100, s.gauge + Config.ULT_GAIN * stats.cooldown)

	local _, sectionIndex = Config.getSection(stats.weapon.grade)
	Push:FireClient(player, "swing", {
		typeId = stats.weapon.typeId,
		mode = wt.mode,
		range = wt.range,
		section = stats.weapon.typeId == 0 and 6 or sectionIndex,
		color = weaponColor(stats),
		crit = anyCrit,
	})
	Push:FireClient(player, "hits", hits)
	pushBattle(player)
end

------------------------------------------------------------------------
-- 필살기
------------------------------------------------------------------------
local function aliveEnemies(s: Session): { Enemy }
	local list = {}
	for _, e in ipairs(s.enemies) do
		if e.alive and e.root.Parent then
			table.insert(list, e)
		end
	end
	return list
end

-- 선분(a→b) 근처에 있는 적
local function enemiesNearSegment(s: Session, a: Vector3, b: Vector3, width: number): { Enemy }
	local list = {}
	local ab = flat(b - a)
	local len = ab.Magnitude
	local dir = len > 0 and ab.Unit or Vector3.new(0, 0, -1)
	for _, e in ipairs(aliveEnemies(s)) do
		local off = flat(e.root.Position - a)
		local along = math.clamp(off:Dot(dir), 0, len)
		local closest = dir * along
		if (off - closest).Magnitude <= width + e.bodyRadius then
			table.insert(list, e)
		end
	end
	return list
end

local function runUltimate(player: Player, st: State, s: Session)
	local root = getRoot(player)
	local char = player.Character
	if not root or not char then
		return
	end
	local stats = s.stats
	local typeId = stats.weapon.typeId
	local ult = Config.Ultimates[typeId] or Config.Ultimates[1]
	s.gauge = 0
	s.ulting = true
	s.invulnUntil = math.max(s.invulnUntil, os.clock() + 1.0)

	local origin = root.Position
	local look = flatUnit(root.CFrame.LookVector)
	local hits = {}
	local data: { [string]: any } = {
		typeId = typeId,
		name = ult.name,
		origin = origin,
		look = look,
		color = weaponColor(stats),
	}

	local function finish(heal: number?)
		if heal and heal > 0 then
			s.hp = math.min(s.maxHp, s.hp + s.maxHp * heal)
		end
		if #hits > 0 then
			Push:FireClient(player, "hits", hits)
		end
		pushBattle(player)
	end

	if typeId == 1 then
		-- 대지 가르기: 앞으로 일직선
		local target = origin + look * ult.length
		data.length = ult.length
		Push:FireClient(player, "ult", data)
		task.wait(0.25)
		for _, e in ipairs(enemiesNearSegment(s, origin, target, ult.width)) do
			hitEnemy(s, e, stats.atk * ult.mult, true, origin, hits)
		end
		finish()
	elseif typeId == 2 then
		-- 칼날 폭풍: 2.5초 동안 주위를 계속 벤다
		data.radius = ult.radius
		data.duration = ult.ticks * ult.interval
		Push:FireClient(player, "ult", data)
		for _ = 1, ult.ticks do
			if not s.running then
				break
			end
			local r = getRoot(player)
			if not r then
				break
			end
			hits = {}
			for _, e in ipairs(aliveEnemies(s)) do
				if (flat(e.root.Position) - flat(r.Position)).Magnitude <= ult.radius + e.bodyRadius then
					local dmg, crit = rollDamage(stats)
					hitEnemy(s, e, dmg * ult.mult, crit, r.Position, hits)
				end
			end
			if #hits > 0 then
				Push:FireClient(player, "hits", hits)
			end
			pushBattle(player)
			task.wait(ult.interval)
		end
		hits = {}
		finish()
	elseif typeId == 3 then
		-- 일섬: 앞으로 순간 돌진. 투기장 밖으로는 못 나간다
		local center = s.arena.center
		local target = origin + look * ult.length
		local fromCenter = flat(target - center)
		local limit = ARENA_RADIUS - 6
		if fromCenter.Magnitude > limit then
			target = center + fromCenter.Unit * limit + Vector3.new(0, origin.Y - center.Y, 0)
		end
		data.target = target
		Push:FireClient(player, "ult", data)
		char:PivotTo(CFrame.lookAt(target, target + look))
		for _, e in ipairs(enemiesNearSegment(s, origin, target, ult.width)) do
			hitEnemy(s, e, stats.atk * ult.mult, true, origin, hits)
		end
		finish()
	elseif typeId == 4 then
		-- 그림자 처형: 체력이 가장 많은 적 뒤로 순간이동해 치명타 5연타
		local best: Enemy? = nil
		for _, e in ipairs(aliveEnemies(s)) do
			if not best or e.hp > best.hp then
				best = e
			end
		end
		if best then
			local victim = best
			local behind = victim.root.Position - flatUnit(victim.root.CFrame.LookVector) * (3 + victim.bodyRadius)
			data.target = victim.root.Position
			Push:FireClient(player, "ult", data)
			char:PivotTo(CFrame.lookAt(behind, Vector3.new(victim.root.Position.X, behind.Y, victim.root.Position.Z)))
			local wt = stats.weapon.type
			for _ = 1, ult.hits do
				if not victim.alive then
					break
				end
				hits = {}
				hitEnemy(s, victim, stats.atk * (wt.critMult or 2) * ult.mult, true, behind, hits)
				Push:FireClient(player, "hits", hits)
				task.wait(0.12)
			end
			hits = {}
		else
			Push:FireClient(player, "ult", data)
		end
		finish()
	elseif typeId == 5 then
		-- 영혼 수확: 넓은 원 + 큰 회복
		local inCircle = {}
		local victims = {}
		for _, e in ipairs(aliveEnemies(s)) do
			if (flat(e.root.Position) - flat(origin)).Magnitude <= ult.radius + e.bodyRadius then
				table.insert(inCircle, e)
				table.insert(victims, e.root.Position)
			end
		end
		data.radius = ult.radius
		data.victims = victims
		Push:FireClient(player, "ult", data)
		task.wait(0.3)
		for _, e in ipairs(inCircle) do
			hitEnemy(s, e, stats.atk * ult.mult, true, origin, hits)
		end
		finish(ult.heal)
	else
		-- 천지개벽: 투기장 전체
		data.radius = ARENA_RADIUS
		Push:FireClient(player, "ult", data)
		task.wait(0.4)
		for _, e in ipairs(aliveEnemies(s)) do
			hitEnemy(s, e, stats.atk * ult.mult, true, origin, hits)
		end
		finish(ult.heal)
	end
end

local function useUltimate(player: Player, st: State, s: Session)
	if not s.running or s.ulting or s.gauge < 100 then
		return
	end
	local ok, err = pcall(runUltimate, player, st, s)
	s.ulting = false
	if not ok then
		warn("[Arena] 필살기 오류:", err)
	end
end

------------------------------------------------------------------------
-- 적의 공격
------------------------------------------------------------------------
local function enemyStrike(player: Player, st: State, s: Session, e: Enemy)
	local now = os.clock()
	e.busy = true
	e.nextAttack = now + (e.isBoss and 1.4 or 1.6)
	e.hum:MoveTo(e.root.Position)
	flashEnemy(e, Color3.fromRGB(255, 60, 60), 0.35)
	task.delay(0.35, function()
		e.busy = false
		if not (s.running and st.session == s and e.alive) then
			return
		end
		local root = getRoot(player)
		if root and (flat(e.root.Position) - flat(root.Position)).Magnitude <= e.reach + 2 then
			damagePlayer(player, st, s, e.dmg)
		end
	end)
end

local function bossSlam(player: Player, st: State, s: Session, e: Enemy, targetPos: Vector3)
	local now = os.clock()
	e.busy = true
	e.nextSlam = now + 6
	e.hum:MoveTo(e.root.Position)
	flashEnemy(e, Color3.fromRGB(255, 140, 0), 1.3)
	local radius = 12
	local floorY = s.arena.center.Y
	local disc = World.part({
		Name = "SlamWarning",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.3, radius * 2, radius * 2),
		CFrame = CFrame.new(targetPos.X, floorY + 0.2, targetPos.Z) * CFrame.Angles(0, 0, math.rad(90)),
		Color = Color3.fromRGB(255, 40, 40),
		Material = Enum.Material.Neon,
		Transparency = 0.55,
		CanCollide = false,
		CanQuery = false,
		CanTouch = false,
		Parent = s.folder,
	})
	task.delay(1.3, function()
		disc:Destroy()
		e.busy = false
		e.nextAttack = os.clock() + 0.8
		if not (s.running and st.session == s and e.alive) then
			return
		end
		Push:FireClient(player, "slam", { pos = Vector3.new(targetPos.X, floorY, targetPos.Z), radius = radius })
		local root = getRoot(player)
		if root then
			local d = (flat(root.Position) - Vector3.new(targetPos.X, 0, targetPos.Z)).Magnitude
			if d <= radius then
				damagePlayer(player, st, s, e.slamDmg)
			end
		end
	end)
end

------------------------------------------------------------------------
-- 승패
------------------------------------------------------------------------
local function winBattle(player: Player, st: State, s: Session)
	s.running = false
	local p = profiles[player]
	local info = s.info
	local n = s.stage
	p.coins += info.coins
	local drops = {}
	local count = info.dropCount + ((math.random() < info.bonusDropChance) and 1 or 0)
	for _ = 1, count do
		local key = Config.itemKey(n, math.random(1, 5))
		p.inv[key] = (p.inv[key] or 0) + 1
		table.insert(drops, key)
	end
	local firstClear = n > p.maxStage
	if firstClear then
		p.maxStage = n
		updateTitle(player)
		refreshHall()
	end
	st.dirty = true

	local again = st.auto and Config.canAutoRepeat(n, p.maxStage, currentStats(player).power)
	if st.auto and not again then
		st.auto = false
		toast(player, "전투력이 부족해서 자동 반복을 멈췄어요")
	end
	Push:FireClient(player, "result", {
		win = true,
		stage = n,
		coins = info.coins,
		drops = drops,
		firstClear = firstClear,
		again = again,
	})
	pushState(player)

	task.delay(again and 2 or 3, function()
		if st.session ~= s then
			return
		end
		endSession(player, st)
		if again and st.auto and player.Parent then
			startStage(player, n, true)
		else
			teleportToLobby(player)
		end
	end)
end

loseBattle = function(player: Player, st: State, s: Session)
	if not s.running then
		return
	end
	s.running = false
	st.auto = false
	Push:FireClient(player, "result", { win = false, stage = s.stage })
	pushBattle(player)
	pushState(player)
	task.delay(2.5, function()
		if st.session ~= s then
			return
		end
		endSession(player, st)
		teleportToLobby(player)
	end)
end

local function battleLoop(player: Player, st: State, s: Session)
	while s.running and st.session == s do
		local root = getRoot(player)
		if not root or root.Position.Y < s.arena.center.Y - 40 then
			loseBattle(player, st, s)
			return
		end
		local now = os.clock()
		local alive = 0
		for _, e in ipairs(s.enemies) do
			if e.alive then
				if not e.root.Parent then
					e.alive = false
				else
					alive += 1
					updateWalk(e)
					if not e.busy then
						local dist = (flat(e.root.Position) - flat(root.Position)).Magnitude
						if e.isBoss and now >= e.nextSlam and dist < 45 then
							bossSlam(player, st, s, e, root.Position)
						elseif dist <= e.reach and now >= e.nextAttack then
							enemyStrike(player, st, s, e)
						elseif now >= e.nextMove then
							e.nextMove = now + 0.25
							e.hum:MoveTo(root.Position)
						end
					end
				end
			end
		end
		if alive == 0 and not s.ulting then
			winBattle(player, st, s)
			return
		end
		if st.auto and not s.ulting then
			if s.gauge >= 100 then
				task.spawn(useUltimate, player, st, s)
			else
				performAttack(player, st, s)
			end
		end
		task.wait(0.1)
	end
end

startStage = function(player: Player, stageArg: any, wantAuto: boolean)
	local st, p = states[player], profiles[player]
	if not st or not p or st.session then
		return
	end
	local n = math.floor(tonumber(stageArg) or 0)
	if n < 1 or n > Config.MAX_GRADE then
		return
	end
	if n > p.maxStage + 1 then
		toast(player, "아직 열리지 않은 스테이지예요")
		return
	end
	local root = getRoot(player)
	local char = player.Character
	if not root or not char then
		return
	end
	local stats = currentStats(player)
	if wantAuto and not Config.canAutoRepeat(n, p.maxStage, stats.power) then
		toast(player, "자동 반복은 이긴 적 있는 스테이지에서, 권장 전투력의 1.5배 이상일 때 할 수 있어요")
		wantAuto = false
	end
	st.auto = wantAuto

	local slot = st.slot
	if not slot then
		slot = claimSlot(player)
		st.slot = slot
	end
	local arena = arenas[slot :: number]
	local info = Config.stageInfo(n)
	World.themeArena(arena, Config.getSection(n).color, info.isBoss)
	local folder = Instance.new("Folder")
	folder.Name = "P_" .. player.UserId
	folder.Parent = battleRoot

	local s: Session = {
		stage = n,
		info = info,
		arena = arena,
		folder = folder,
		enemies = {},
		stats = stats,
		hp = stats.maxHp,
		maxHp = stats.maxHp,
		invulnUntil = 0,
		lastAttack = 0,
		gauge = 0,
		ulting = false,
		running = true,
	}
	st.session = s
	char:PivotTo(CFrame.new(arena.center + Vector3.new(0, 4, 0)))

	local count = info.enemyCount
	local spin = math.random() * math.pi * 2
	for i = 1, count do
		local a = spin + (i / count) * math.pi * 2
		local pos = arena.center + Vector3.new(math.cos(a), 0, math.sin(a)) * ENEMY_SPAWN_RADIUS
		spawnEnemy(s, n, false, pos, info.enemyHp, info.enemyDmg)
	end
	if info.isBoss then
		spawnEnemy(s, n, true, arena.center + Vector3.new(0, 0, -ENEMY_SPAWN_RADIUS), info.bossHp, info.bossDmg)
	end

	pushBattle(player)
	pushState(player)
	task.spawn(battleLoop, player, st, s)
end

------------------------------------------------------------------------
-- 무기 관리
------------------------------------------------------------------------
local function refreshStats(player: Player)
	local st = states[player]
	local s = st and st.session
	if s then
		local ratio = s.hp / s.maxHp
		local stats = currentStats(player)
		s.stats = stats
		s.maxHp = stats.maxHp
		s.hp = math.max(1, ratio * stats.maxHp)
		pushBattle(player)
	end
	attachWeapon(player)
	st.dirty = true
	pushState(player)
end

local function equip(player: Player, key: any)
	local p = profiles[player]
	if type(key) ~= "string" or not Config.parseKey(key) or (p.inv[key] or 0) < 1 then
		return
	end
	p.equipped = key
	refreshStats(player)
	Push:FireClient(player, "equipped", key)
end

local function mergeOnce(p: Profile, key: string): string?
	local g, t = Config.parseKey(key)
	if not g or t == 0 or g >= Config.MAX_GRADE then
		return nil
	end
	local cost = Config.mergeCost(g)
	local have = p.inv[key] or 0
	if have < cost then
		return nil
	end
	local left = have - cost
	p.inv[key] = left > 0 and left or nil
	local newKey = Config.itemKey(g + 1, t)
	p.inv[newKey] = (p.inv[newKey] or 0) + 1
	if p.equipped == key and left <= 0 then
		p.equipped = newKey
	end
	return newKey
end

local function merge(player: Player, key: any)
	local p = profiles[player]
	if type(key) ~= "string" then
		return
	end
	local g = Config.parseKey(key)
	if not g then
		return
	end
	local newKey = mergeOnce(p, key)
	if not newKey then
		toast(player, string.format("합성하려면 같은 칼이 %d개 필요해요", Config.mergeCost(g)))
		return
	end
	Push:FireClient(player, "merged", { from = key, to = newKey, count = 1 })
	refreshStats(player)
end

local function mergeAll(player: Player)
	local p = profiles[player]
	local count = 0
	local best: string? = nil
	for g = 1, Config.MAX_GRADE - 1 do
		for t = 1, 5 do
			local key = Config.itemKey(g, t)
			while true do
				local made = mergeOnce(p, key)
				if not made then
					break
				end
				count += 1
				best = made
			end
		end
	end
	if count == 0 then
		toast(player, "지금 합성할 수 있는 칼이 없어요")
		return
	end
	Push:FireClient(player, "merged", { count = count, to = best })
	refreshStats(player)
end

local function makeAllRounder(player: Player)
	local p = profiles[player]
	for t = 1, 5 do
		if (p.inv[Config.itemKey(Config.MAX_GRADE, t)] or 0) < 1 then
			toast(player, "100등급 대검·쌍검·장검·단검·낫이 하나씩 필요해요")
			return
		end
	end
	for t = 1, 5 do
		local key = Config.itemKey(Config.MAX_GRADE, t)
		local left = p.inv[key] - 1
		p.inv[key] = left > 0 and left or nil
	end
	p.inv[Config.ALLROUNDER_KEY] = (p.inv[Config.ALLROUNDER_KEY] or 0) + 1
	p.equipped = Config.ALLROUNDER_KEY
	Push:FireClient(player, "merged", { to = Config.ALLROUNDER_KEY, count = 1 })
	refreshStats(player)
end

local function train(player: Player, kind: any)
	local p = profiles[player]
	local field
	if kind == "atk" then
		field = "atkLv"
	elseif kind == "hp" then
		field = "hpLv"
	else
		return
	end
	local level = (p :: any)[field]
	local cost = Config.trainCost(level)
	if p.coins < cost then
		toast(player, "코인이 부족해요")
		return
	end
	p.coins -= cost;
	(p :: any)[field] = level + 1
	refreshStats(player)
end

local function setAuto(player: Player, st: State, on: boolean)
	local s = st.session
	if not on then
		st.auto = false
	elseif s then
		local p = profiles[player]
		local power = currentStats(player).power
		if s.stage > p.maxStage then
			toast(player, "한 번 이긴 스테이지만 자동 반복할 수 있어요")
		elseif not Config.canAutoRepeat(s.stage, p.maxStage, power) then
			toast(player, "전투력이 " .. Config.formatNumber(Config.recommendedPower(s.stage) * Config.AUTO_POWER_RATIO) .. " 이상이어야 해요")
		else
			st.auto = true
		end
	end
	pushBattle(player)
	pushState(player)
end

------------------------------------------------------------------------
-- 요청 처리
------------------------------------------------------------------------
Request.OnServerEvent:Connect(function(player: Player, action: any, arg: any, arg2: any)
	local st, p = states[player], profiles[player]
	if not st or not p or type(action) ~= "string" then
		return
	end
	local now = os.clock()
	if now - st.reqWindow > 1 then
		st.reqWindow = now
		st.reqCount = 0
	end
	st.reqCount += 1
	if st.reqCount > 40 then
		return
	end

	if action == "attack" then
		local s = st.session
		if s and s.running then
			performAttack(player, st, s)
		end
	elseif action == "ultimate" then
		local s = st.session
		if s and s.running then
			task.spawn(useUltimate, player, st, s)
		end
	elseif action == "dash" then
		local s = st.session
		if s and s.running and now - st.lastDash >= Config.DASH_COOLDOWN - 0.15 then
			st.lastDash = now
			s.invulnUntil = math.max(s.invulnUntil, now + Config.DASH_INVULN)
		end
	elseif action == "start" then
		startStage(player, arg, arg2 == true)
	elseif action == "leave" then
		if st.session then
			st.auto = false
			endSession(player, st)
			teleportToLobby(player)
			pushState(player)
		end
	elseif action == "auto" then
		setAuto(player, st, arg == true)
	elseif action == "equip" then
		equip(player, arg)
	elseif action == "equipBest" then
		equip(player, bestKey(p))
	elseif action == "merge" then
		merge(player, arg)
	elseif action == "mergeAll" then
		mergeAll(player)
	elseif action == "allrounder" then
		makeAllRounder(player)
	elseif action == "train" then
		train(player, arg)
	elseif action == "hello" then
		pushState(player)
		pushBattle(player)
		if not st.canSave then
			toast(player, "저장이 꺼져 있어요. 이번 기록은 저장되지 않아요")
		end
	end
end)

------------------------------------------------------------------------
-- 입장과 퇴장
------------------------------------------------------------------------
local function onCharacterAdded(player: Player, char: Model)
	local st = states[player]
	if st and st.session then
		st.auto = false
		endSession(player, st)
		pushState(player)
	end
	task.spawn(function()
		char:WaitForChild("Head", 10)
		char:WaitForChild("HumanoidRootPart", 10)
		task.wait(0.2)
		if player.Character ~= char then
			return
		end
		attachWeapon(player)
		updateTitle(player)
		local hum = char:FindFirstChildOfClass("Humanoid")
		if hum then
			hum.Died:Connect(function()
				local s2 = states[player]
				local s = s2 and s2.session
				if s2 and s then
					loseBattle(player, s2, s)
				end
			end)
		end
	end)
end

local function onPlayerAdded(player: Player)
	local st: State = {
		slot = nil,
		session = nil,
		auto = false,
		canSave = false,
		dirty = false,
		reqCount = 0,
		reqWindow = 0,
		lastDash = 0,
	}
	states[player] = st

	local ls = Instance.new("Folder")
	ls.Name = "leaderstats"
	local rank = Instance.new("StringValue")
	rank.Name = "등급"
	rank.Value = "-"
	rank.Parent = ls
	local stage = Instance.new("IntValue")
	stage.Name = "스테이지"
	stage.Parent = ls
	ls.Parent = player

	local profile, ok = loadProfile(player)
	if not player.Parent then
		return
	end
	profiles[player] = profile
	st.canSave = ok

	player.CharacterAdded:Connect(function(char)
		onCharacterAdded(player, char)
	end)
	if player.Character then
		onCharacterAdded(player, player.Character)
	end
	updateTitle(player)
	refreshHall()
	pushState(player)
end

local function onPlayerRemoving(player: Player)
	local st = states[player]
	if st then
		if st.session then
			endSession(player, st)
		end
		if st.slot then
			slotOwner[st.slot] = nil
		end
	end
	saveProfile(player)
	states[player] = nil
	profiles[player] = nil
	refreshHall()
end

task.spawn(function()
	World.buildStatue(getRigTemplate())
end)

Players.PlayerAdded:Connect(onPlayerAdded)
Players.PlayerRemoving:Connect(onPlayerRemoving)
for _, player in ipairs(Players:GetPlayers()) do
	task.spawn(onPlayerAdded, player)
end

-- 주기적 저장
task.spawn(function()
	while true do
		task.wait(SAVE_INTERVAL)
		for player, st in pairs(states) do
			if st.dirty then
				task.spawn(saveProfile, player)
			end
		end
	end
end)

game:BindToClose(function()
	local pending = 0
	for player in pairs(profiles) do
		pending += 1
		task.spawn(function()
			saveProfile(player)
			pending -= 1
		end)
	end
	local waited = 0
	while pending > 0 and waited < 25 do
		task.wait(0.5)
		waited += 0.5
	end
end)
]]></string>
      </Properties>
      <Item class="ModuleScript" referent="6">
        <Properties>
          <string name="Name">WorldBuilder</string>
          <string name="Source"><![CDATA[-- WorldBuilder (ModuleScript, ArenaServer 아래)
-- 조명, 로비 광장, 투기장을 만든다. 맵은 전부 코드로 짓는다.

local Lighting = game:GetService("Lighting")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage:WaitForChild("GameConfig"))
local WeaponBuilder = require(ReplicatedStorage:WaitForChild("WeaponBuilder"))

local World = {}

local MARBLE = Color3.fromRGB(236, 230, 218)
local MARBLE_DARK = Color3.fromRGB(205, 195, 180)
local GOLD = Color3.fromRGB(222, 178, 72)
local STONE = Color3.fromRGB(92, 82, 76)
local CRIMSON = Color3.fromRGB(150, 35, 40)
local FIRE = Color3.fromRGB(255, 150, 60)

local function part(props: { [string]: any }): Part
	local p = Instance.new("Part")
	p.Anchored = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	local parent = props.Parent
	for k, v in pairs(props) do
		if k ~= "Parent" then
			(p :: any)[k] = v
		end
	end
	p.Parent = parent
	return p
end
World.part = part

-- 세로로 선 원기둥 (로블록스 원기둥은 X축이 길이라 돌려서 세운다)
local function pillar(parent: Instance, center: Vector3, height: number, diameter: number, color: Color3, material: Enum.Material): Part
	return part({
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(height, diameter, diameter),
		CFrame = CFrame.new(center) * CFrame.Angles(0, 0, math.rad(90)),
		Color = color,
		Material = material,
		Parent = parent,
	})
end

local function disc(parent: Instance, center: Vector3, thickness: number, diameter: number, color: Color3, material: Enum.Material): Part
	return pillar(parent, center, thickness, diameter, color, material)
end

local function torch(parent: Instance, pos: Vector3, size: number, range: number): (Part, Fire)
	local bowl = disc(parent, pos, 0.8 * size, 2.6 * size, Color3.fromRGB(45, 40, 38), Enum.Material.Metal)
	bowl.Name = "Brazier"
	local fire = Instance.new("Fire")
	fire.Size = 5 * size
	fire.Heat = 9
	fire.Color = FIRE
	fire.SecondaryColor = Color3.fromRGB(255, 220, 120)
	fire.Parent = bowl
	local light = Instance.new("PointLight")
	light.Color = Color3.fromRGB(255, 170, 90)
	light.Range = range
	light.Brightness = 2.2
	light.Shadows = true
	light.Parent = bowl
	return bowl, fire
end

local function surfaceText(target: BasePart, face: Enum.NormalId, ppu: number): SurfaceGui
	local gui = Instance.new("SurfaceGui")
	gui.Face = face
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = ppu
	gui.LightInfluence = 0
	gui.Parent = target
	return gui
end

local function label(parent: Instance, text: string, pos: UDim2, size: UDim2, color: Color3, font: Enum.Font): TextLabel
	local l = Instance.new("TextLabel")
	l.BackgroundTransparency = 1
	l.Position = pos
	l.Size = size
	l.Font = font
	l.TextScaled = true
	l.TextColor3 = color
	l.TextStrokeTransparency = 0.4
	l.Text = text
	l.Parent = parent
	return l
end

------------------------------------------------------------------------
-- 조명: 노을빛, 네온이 번지게
------------------------------------------------------------------------
function World.setupLighting()
	pcall(function()
		Lighting.Technology = Enum.Technology.Future
	end)
	Lighting.ClockTime = 17.4
	Lighting.Brightness = 2.2
	Lighting.GlobalShadows = true
	Lighting.OutdoorAmbient = Color3.fromRGB(140, 120, 110)
	Lighting.Ambient = Color3.fromRGB(60, 50, 50)
	Lighting.EnvironmentDiffuseScale = 0.6
	Lighting.EnvironmentSpecularScale = 0.7

	local function ensure(className: string, name: string): any
		local existing = Lighting:FindFirstChild(name)
		if existing then
			return existing
		end
		local inst = Instance.new(className)
		inst.Name = name
		inst.Parent = Lighting
		return inst
	end
	local atmosphere = ensure("Atmosphere", "ArenaAtmosphere")
	atmosphere.Density = 0.3
	atmosphere.Offset = 0.15
	atmosphere.Color = Color3.fromRGB(255, 205, 170)
	atmosphere.Decay = Color3.fromRGB(120, 80, 95)
	atmosphere.Glare = 0.4
	atmosphere.Haze = 1.4

	local bloom = ensure("BloomEffect", "ArenaBloom")
	bloom.Intensity = 0.7
	bloom.Size = 28
	bloom.Threshold = 1.1

	local cc = ensure("ColorCorrectionEffect", "ArenaColor")
	cc.Saturation = 0.12
	cc.Contrast = 0.08
	cc.TintColor = Color3.fromRGB(255, 246, 236)

	local rays = ensure("SunRaysEffect", "ArenaSunRays")
	rays.Intensity = 0.06
	rays.Spread = 0.7
end

------------------------------------------------------------------------
-- 로비
------------------------------------------------------------------------
local hallRows: { TextLabel } = {}
local lobbyFolder: Folder? = nil

function World.buildLobby(onGate: (Player) -> ()): CFrame
	local folder = Instance.new("Folder")
	folder.Name = "Lobby"
	folder.Parent = workspace
	lobbyFolder = folder

	-- 바닥 (Baseplate가 없을 때만)
	if not workspace:FindFirstChild("Baseplate") then
		part({
			Name = "Baseplate",
			Size = Vector3.new(500, 2, 500),
			Position = Vector3.new(0, -1, 0),
			Color = Color3.fromRGB(86, 118, 70),
			Material = Enum.Material.Grass,
			Parent = workspace,
		})
	end

	-- 원형 대리석 광장과 금테
	disc(folder, Vector3.new(0, 0, 0), 0.6, 98, GOLD, Enum.Material.Metal)
	disc(folder, Vector3.new(0, 0.05, 0), 0.8, 94, MARBLE, Enum.Material.Marble)
	disc(folder, Vector3.new(0, 0.46, 0), 0.04, 32, CRIMSON, Enum.Material.Slate)
	disc(folder, Vector3.new(0, 0.48, 0), 0.04, 28, MARBLE_DARK, Enum.Material.Marble)
	for i = 0, 7 do
		local a = (i / 8) * math.pi * 2
		local dir = Vector3.new(math.cos(a), 0, math.sin(a))
		local mid = dir * 30 + Vector3.new(0, 0.47, 0)
		part({
			Name = "Spoke",
			Size = Vector3.new(0.6, 0.04, 28),
			CFrame = CFrame.lookAt(mid, mid + dir),
			Color = GOLD,
			Material = Enum.Material.Metal,
			Parent = folder,
		})
	end

	-- 시작 지점
	local spawn = workspace:FindFirstChildWhichIsA("SpawnLocation", true)
	if not spawn then
		local sp = Instance.new("SpawnLocation")
		sp.Name = "LobbySpawn"
		sp.Anchored = true
		sp.Size = Vector3.new(14, 1, 14)
		sp.Position = Vector3.new(0, 0.5, 0)
		sp.Neutral = true
		sp.Duration = 0
		sp.Parent = workspace
		spawn = sp
	end
	if spawn then
		spawn.Color = GOLD
		spawn.Material = Enum.Material.Marble
		local decal = spawn:FindFirstChildOfClass("Decal")
		if decal then
			decal:Destroy()
		end
	end

	-- 기둥 12개: 짝수는 횃불, 홀수는 구간 깃발
	local sectionIndex = 0
	for i = 0, 11 do
		local deg = 15 + i * 30
		local a = math.rad(deg)
		local dir = Vector3.new(math.cos(a), 0, math.sin(a))
		local base = dir * 42
		part({
			Name = "ColumnBase",
			Size = Vector3.new(4.6, 1.2, 4.6),
			Position = base + Vector3.new(0, 1.05, 0),
			Color = MARBLE_DARK,
			Material = Enum.Material.Marble,
			Parent = folder,
		})
		pillar(folder, base + Vector3.new(0, 1.65 + 9, 0), 18, 2.8, MARBLE, Enum.Material.Marble)
		part({
			Name = "ColumnCap",
			Size = Vector3.new(4.6, 1.2, 4.6),
			Position = base + Vector3.new(0, 1.65 + 18 + 0.6, 0),
			Color = GOLD,
			Material = Enum.Material.Metal,
			Parent = folder,
		})
		if i % 2 == 0 then
			torch(folder, base + Vector3.new(0, 21.33, 0), 1.2, 26)
		else
			sectionIndex += 1
			local section = Config.Sections[sectionIndex]
			if section then
				local inward = -dir
				local bannerPos = base + inward * 1.7 + Vector3.new(0, 12.5, 0)
				local banner = part({
					Name = "SectionBanner",
					Size = Vector3.new(4.2, 11, 0.2),
					CFrame = CFrame.lookAt(bannerPos, bannerPos + inward),
					Color = section.color:Lerp(Color3.new(0, 0, 0), 0.3),
					Material = Enum.Material.Fabric,
					CanCollide = false,
					Parent = folder,
				})
				part({
					Name = "BannerRod",
					Size = Vector3.new(5.2, 0.3, 0.3),
					CFrame = banner.CFrame * CFrame.new(0, 5.6, 0),
					Color = GOLD,
					Material = Enum.Material.Metal,
					Parent = folder,
				})
				local gui = surfaceText(banner, Enum.NormalId.Front, 40)
				label(gui, tostring(sectionIndex), UDim2.new(0, 0, 0.06, 0), UDim2.new(1, 0, 0.22, 0), GOLD, Enum.Font.GothamBlack)
				label(gui, section.name, UDim2.new(0.05, 0, 0.34, 0), UDim2.new(0.9, 0, 0.16, 0), Color3.new(1, 1, 1), Enum.Font.GothamBlack)
				label(
					gui,
					string.format("%d ~ %d", section.from, section.to),
					UDim2.new(0.1, 0, 0.56, 0),
					UDim2.new(0.8, 0, 0.1, 0),
					Color3.fromRGB(240, 230, 210),
					Enum.Font.GothamBold
				)
				label(
					gui,
					Config.getGrade(section.to).en,
					UDim2.new(0.05, 0, 0.74, 0),
					UDim2.new(0.9, 0, 0.12, 0),
					section.color:Lerp(Color3.new(1, 1, 1), 0.5),
					Enum.Font.GothamBold
				)
			end
		end
	end

	-- 투기장 입구 문
	local gateZ = -56
	for _, x in ipairs({ -15, 15 }) do
		part({
			Name = "GatePillar",
			Size = Vector3.new(6, 30, 6),
			Position = Vector3.new(x, 15, gateZ),
			Color = STONE,
			Material = Enum.Material.Slate,
			Parent = folder,
		})
		part({
			Name = "GatePillarTrim",
			Size = Vector3.new(6.4, 1, 6.4),
			Position = Vector3.new(x, 1, gateZ),
			Color = GOLD,
			Material = Enum.Material.Metal,
			Parent = folder,
		})
		torch(folder, Vector3.new(x, 37.7, gateZ), 1.5, 34)
	end
	local beam = part({
		Name = "GateBeam",
		Size = Vector3.new(38, 7, 7),
		Position = Vector3.new(0, 33.5, gateZ),
		Color = STONE,
		Material = Enum.Material.Slate,
		Parent = folder,
	})
	for _, y in ipairs({ 30.2, 36.8 }) do
		part({
			Name = "GateTrim",
			Size = Vector3.new(38.2, 0.5, 7.2),
			Position = Vector3.new(0, y, gateZ),
			Color = GOLD,
			Material = Enum.Material.Neon,
			Parent = folder,
		})
	end
	local signGui = surfaceText(beam, Enum.NormalId.Back, 24)
	label(signGui, Config.GAME_TITLE, UDim2.new(0, 0, 0.08, 0), UDim2.new(1, 0, 0.62, 0), Color3.fromRGB(255, 205, 80), Enum.Font.GothamBlack)
	label(signGui, "투기장 입구", UDim2.new(0, 0, 0.7, 0), UDim2.new(1, 0, 0.24, 0), Color3.fromRGB(245, 235, 215), Enum.Font.GothamBold)

	local portal = part({
		Name = "GatePortal",
		Size = Vector3.new(24, 29, 0.4),
		Position = Vector3.new(0, 15, gateZ),
		Color = Color3.fromRGB(255, 90, 50),
		Material = Enum.Material.Neon,
		Transparency = 0.7,
		CanCollide = false,
		Parent = folder,
	})
	local embers = Instance.new("ParticleEmitter")
	embers.Rate = 30
	embers.Lifetime = NumberRange.new(2, 3.5)
	embers.Speed = NumberRange.new(2, 4)
	embers.EmissionDirection = Enum.NormalId.Top
	embers.SpreadAngle = Vector2.new(20, 20)
	embers.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.35), NumberSequenceKeypoint.new(1, 0) })
	embers.LightEmission = 1
	embers.Color = ColorSequence.new(Color3.fromRGB(255, 200, 90), Color3.fromRGB(255, 80, 40))
	embers.Parent = portal
	local prompt = Instance.new("ProximityPrompt")
	prompt.ActionText = "투기장 입장"
	prompt.ObjectText = Config.GAME_TITLE
	prompt.HoldDuration = 0
	prompt.MaxActivationDistance = 20
	prompt.RequiresLineOfSight = false
	prompt.Parent = portal
	prompt.Triggered:Connect(onGate)

	-- 광장에서 문까지 붉은 융단
	part({
		Name = "Carpet",
		Size = Vector3.new(10, 0.1, 13),
		Position = Vector3.new(0, 0.5, -49.5),
		Color = CRIMSON,
		Material = Enum.Material.Fabric,
		Parent = folder,
	})

	-- 명예의 전당 게시판
	local boardPos = Vector3.new(24, 0, -16)
	local boardCf = CFrame.lookAt(boardPos + Vector3.new(0, 8, 0), Vector3.new(0, 8, 0))
	for _, x in ipairs({ -7.6, 7.6 }) do
		part({
			Name = "BoardPost",
			Size = Vector3.new(0.9, 14, 0.9),
			CFrame = boardCf * CFrame.new(x, -1, 0.2),
			Color = Color3.fromRGB(60, 42, 30),
			Material = Enum.Material.Wood,
			Parent = folder,
		})
	end
	local board = part({
		Name = "HallOfFame",
		Size = Vector3.new(15, 10, 0.6),
		CFrame = boardCf,
		Color = Color3.fromRGB(35, 26, 22),
		Material = Enum.Material.Wood,
		Parent = folder,
	})
	for _, spec in ipairs({
		{ Vector3.new(15.6, 0.4, 0.8), CFrame.new(0, 5.1, 0) },
		{ Vector3.new(15.6, 0.4, 0.8), CFrame.new(0, -5.1, 0) },
		{ Vector3.new(0.4, 10.6, 0.8), CFrame.new(7.6, 0, 0) },
		{ Vector3.new(0.4, 10.6, 0.8), CFrame.new(-7.6, 0, 0) },
	}) do
		part({
			Name = "BoardFrame",
			Size = spec[1],
			CFrame = boardCf * spec[2],
			Color = GOLD,
			Material = Enum.Material.Neon,
			Parent = folder,
		})
	end
	local hallGui = surfaceText(board, Enum.NormalId.Front, 40)
	label(hallGui, "🏆 명예의 전당", UDim2.new(0, 0, 0.03, 0), UDim2.new(1, 0, 0.17, 0), GOLD, Enum.Font.GothamBlack)
	label(hallGui, "이 서버 최고 기록", UDim2.new(0, 0, 0.2, 0), UDim2.new(1, 0, 0.07, 0), Color3.fromRGB(200, 185, 165), Enum.Font.GothamBold)
	hallRows = {}
	for i = 1, 5 do
		local row = label(
			hallGui,
			"",
			UDim2.new(0.06, 0, 0.29 + (i - 1) * 0.135, 0),
			UDim2.new(0.88, 0, 0.11, 0),
			Color3.fromRGB(240, 230, 210),
			Enum.Font.GothamBold
		)
		row.TextXAlignment = Enum.TextXAlignment.Left
		hallRows[i] = row
	end

	-- 동상 받침대 (동상은 buildStatue에서 올린다)
	local statueBase = Vector3.new(-24, 0, -16)
	part({ Name = "PedestalBase", Size = Vector3.new(10, 1.2, 10), Position = statueBase + Vector3.new(0, 1.05, 0), Color = GOLD, Material = Enum.Material.Metal, Parent = folder })
	local body = part({ Name = "Pedestal", Size = Vector3.new(8.5, 5, 8.5), Position = statueBase + Vector3.new(0, 4.15, 0), Color = MARBLE, Material = Enum.Material.Marble, Parent = folder })
	part({ Name = "PedestalTop", Size = Vector3.new(10, 0.8, 10), Position = statueBase + Vector3.new(0, 7.05, 0), Color = GOLD, Material = Enum.Material.Metal, Parent = folder })
	local plaque = surfaceText(body, Enum.NormalId.Right, 40)
	label(plaque, "CHAMPION", UDim2.new(0, 0, 0.2, 0), UDim2.new(1, 0, 0.3, 0), GOLD, Enum.Font.GothamBlack)
	label(plaque, "100등급의 끝에 선 자", UDim2.new(0, 0, 0.55, 0), UDim2.new(1, 0, 0.2, 0), Color3.fromRGB(80, 60, 40), Enum.Font.GothamBold)

	if spawn then
		return CFrame.new(spawn.Position + Vector3.new(0, 4, 0))
	end
	return CFrame.new(0, 4, 0)
end

-- 황금 검투사 동상. 인형을 못 만들면 받침대에 거대한 검만 꽂는다
function World.buildStatue(rig: Model?)
	local folder = lobbyFolder or workspace
	local basePos = Vector3.new(-24, 7.45, -16)
	local ok, err = pcall(function()
		if not rig then
			error("인형 없음")
		end
		local statue = (rig :: Model):Clone()
		statue.Name = "ChampionStatue"
		local hum = statue:FindFirstChildOfClass("Humanoid")
		if hum then
			hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
		end
		local root = statue:FindFirstChild("HumanoidRootPart")
		if not (root and root:IsA("BasePart")) then
			error("루트 없음")
		end
		statue:ScaleTo(3)
		for _, d in ipairs(statue:GetDescendants()) do
			if d:IsA("BasePart") then
				d.Anchored = (d == root)
			end
		end
		statue:PivotTo(CFrame.lookAt(basePos + Vector3.new(0, 10, 0), Vector3.new(0, basePos.Y + 10, 0)))
		statue.Parent = folder
		-- 칼 든 오른팔을 하늘로
		local upperArm = statue:FindFirstChild("RightUpperArm")
		local shoulder = upperArm and upperArm:FindFirstChild("RightShoulder")
		if shoulder and shoulder:IsA("Motor6D") then
			shoulder.C0 = shoulder.C0 * CFrame.Angles(math.rad(150), 0, 0)
		end
		task.wait(0.2)
		local bbCf, bbSize = statue:GetBoundingBox()
		local bottom = bbCf.Position.Y - bbSize.Y / 2
		statue:PivotTo(statue:GetPivot() + Vector3.new(0, basePos.Y - bottom, 0))
		for _, d in ipairs(statue:GetDescendants()) do
			if d:IsA("BasePart") then
				d.Anchored = true
				if d ~= root then
					d.Color = GOLD
					d.Material = Enum.Material.Metal
					d.Reflectance = 0.15
				end
			end
		end
		local hand = statue:FindFirstChild("RightHand")
		if hand and hand:IsA("BasePart") then
			local yaw = select(2, statue:GetPivot():ToEulerAnglesYXZ())
			local grip = CFrame.new(hand.Position) * CFrame.Angles(0, yaw, 0)
			WeaponBuilder.build(statue, hand, 0, { accent = GOLD, section = 4, rarity = 5, scale = 2.4 }, grip)
		end
	end)
	if not ok then
		warn("[Arena] 동상 대신 검을 세웁니다:", err)
		local anchor = part({
			Name = "SwordAnchor",
			Size = Vector3.new(1, 1, 1),
			Position = basePos + Vector3.new(0, 0.5, 0),
			Transparency = 1,
			CanCollide = false,
			Parent = folder,
		})
		WeaponBuilder.build(folder, anchor, 1, { accent = GOLD, section = 4, rarity = 5, scale = 3 }, CFrame.new(anchor.Position + Vector3.new(0, 4, 0)))
	end
end

function World.setHallOfFame(entries: { { name: string, stage: number } })
	for i, row in ipairs(hallRows) do
		local e = entries[i]
		if e then
			local medal = (i == 1 and "🥇") or (i == 2 and "🥈") or (i == 3 and "🥉") or ("  " .. i .. ".")
			row.Text = string.format("%s  %s  ·  [%d] %s", medal, e.name, e.stage, Config.getGrade(e.stage).en)
			row.TextColor3 = Config.getSection(e.stage).color:Lerp(Color3.new(1, 1, 1), 0.3)
		else
			row.Text = ""
		end
	end
end

------------------------------------------------------------------------
-- 투기장
------------------------------------------------------------------------
export type Arena = {
	center: Vector3,
	model: Model,
	trim: { BasePart },
	banners: { BasePart },
	fires: { Fire },
}

local CROWD_COLORS = {
	Color3.fromRGB(220, 80, 70),
	Color3.fromRGB(70, 130, 220),
	Color3.fromRGB(240, 200, 80),
	Color3.fromRGB(90, 190, 110),
	Color3.fromRGB(200, 120, 220),
	Color3.fromRGB(245, 245, 245),
}

function World.buildArena(center: Vector3, radius: number, name: string): Arena
	local model = Instance.new("Model")
	model.Name = name
	local arena: Arena = { center = center, model = model, trim = {}, banners = {}, fires = {} }

	disc(model, center - Vector3.new(0, 2, 0), 4, radius * 2, Color3.fromRGB(212, 182, 128), Enum.Material.Sand)
	local ring = disc(model, center + Vector3.new(0, 0.03, 0), 0.12, 30, Color3.fromRGB(255, 200, 80), Enum.Material.Neon)
	ring.CanCollide = false
	table.insert(arena.trim, ring)
	local inner = disc(model, center + Vector3.new(0, 0.06, 0), 0.12, 27, Color3.fromRGB(120, 50, 40), Enum.Material.Slate)
	inner.CanCollide = false

	local segments = 36
	local segWidth = 2 * radius * math.sin(math.pi / segments) + 1
	for i = 1, segments do
		local a = (i / segments) * math.pi * 2
		local dir = Vector3.new(math.cos(a), 0, math.sin(a))
		local wallPos = center + dir * radius + Vector3.new(0, 6, 0)
		local wallCf = CFrame.lookAt(wallPos, Vector3.new(center.X, wallPos.Y, center.Z))
		part({ Name = "Wall", Size = Vector3.new(segWidth, 12, 2), CFrame = wallCf, Color = STONE, Material = Enum.Material.Cobblestone, Parent = model })
		local trim = part({
			Name = "WallTrim",
			Size = Vector3.new(segWidth, 0.5, 2.3),
			CFrame = wallCf * CFrame.new(0, 6.1, 0),
			Color = Color3.fromRGB(255, 200, 80),
			Material = Enum.Material.Neon,
			Parent = model,
		})
		table.insert(arena.trim, trim)

		if i % 6 == 3 then
			local banner = part({
				Name = "Banner",
				Size = Vector3.new(4, 8, 0.2),
				CFrame = wallCf * CFrame.new(0, 1, -1.15),
				Color = CRIMSON,
				Material = Enum.Material.Fabric,
				CanCollide = false,
				Parent = model,
			})
			table.insert(arena.banners, banner)
		end
		if i % 6 == 0 then
			local _, fire = torch(model, (wallCf * CFrame.new(0, 6.75, 0)).Position, 1, 30)
			table.insert(arena.fires, fire)
		end

		for tier = 1, 3 do
			local r = radius + 2 + tier * 5
			local h = 12 + tier * 4
			local stepPos = center + dir * r + Vector3.new(0, h / 2, 0)
			part({
				Name = "Stand",
				Size = Vector3.new(2 * r * math.sin(math.pi / segments) + 1, h, 5),
				CFrame = CFrame.lookAt(stepPos, Vector3.new(center.X, stepPos.Y, center.Z)),
				Color = Color3.fromRGB(150, 135, 115),
				Material = Enum.Material.Concrete,
				Parent = model,
			})
			if (i + tier) % 2 == 0 then
				local seatPos = center + dir * r + Vector3.new(0, h + 1.2, 0)
				part({
					Name = "Crowd",
					Size = Vector3.new(1.6, 2.4, 1.2),
					CFrame = CFrame.lookAt(seatPos, Vector3.new(center.X, seatPos.Y, center.Z)),
					Color = CROWD_COLORS[(i * tier) % #CROWD_COLORS + 1],
					CanCollide = false,
					Parent = model,
				})
			end
		end
	end

	model.Parent = workspace
	return arena
end

-- 스테이지 구간 색으로 투기장을 물들인다. 보스전은 붉은 불꽃
function World.themeArena(arena: Arena, color: Color3, isBoss: boolean)
	for _, p in ipairs(arena.trim) do
		p.Color = color
	end
	for _, b in ipairs(arena.banners) do
		b.Color = isBoss and CRIMSON or color:Lerp(Color3.new(0, 0, 0), 0.35)
	end
	for _, f in ipairs(arena.fires) do
		if isBoss then
			f.Color = Color3.fromRGB(255, 40, 60)
			f.SecondaryColor = Color3.fromRGB(120, 0, 30)
		else
			f.Color = FIRE
			f.SecondaryColor = Color3.fromRGB(255, 220, 120)
		end
	end
end

return World
]]></string>
        </Properties>
      </Item>
    </Item>

local toastToken = 0
local function toast(msg: string)
	toastToken += 1
	local my = toastToken
	toastLabel.Text = msg
	toastLabel.Visible = true
	task.delay(2.6, function()
		if toastToken == my then
			toastLabel.Visible = false
		end
	end)
end


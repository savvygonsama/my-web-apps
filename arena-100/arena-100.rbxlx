	Size = UDim2.new(0, 80, 0, 80),
	Text = "💥",
	TextSize = 34,
}, C.goldDeep, C.gold)
local ultBtnStroke = ultBtn:FindFirstChildOfClass("UIStroke") :: UIStroke

-- 무기 스킬 버튼 (E, F). 재사용 대기 중에는 어두운 막이 내려온다
type SkillButton = { button: TextButton, cover: Frame, timer: TextLabel, name: TextLabel, readyAt: number, duration: number }
local skillButtons: { SkillButton } = {}
local SKILL_POS = { UDim2.new(1, -150, 1, -84), UDim2.new(1, -212, 1, 0) }
local SKILL_COLOR = { Color3.fromRGB(130, 70, 190), Color3.fromRGB(30, 140, 130) }
for slot = 1, 2 do
	local b = roundButton({
		AnchorPoint = Vector2.new(1, 1),
		Position = SKILL_POS[slot],
		Size = UDim2.new(0, 72, 0, 72),
		Text = "",
		TextSize = 30,
	}, SKILL_COLOR[slot], C.text)
	b.ClipsDescendants = true
	local cover = new("Frame", {
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.fromScale(0, 1),
		Size = UDim2.fromScale(1, 0),
		BackgroundColor3 = Color3.new(0, 0, 0),
		BackgroundTransparency = 0.35,
		BorderSizePixel = 0,
		ZIndex = 3,
		Parent = b,
	})
	local timer = text({
		Size = UDim2.fromScale(1, 1),
		TextXAlignment = Enum.TextXAlignment.Center,
		TextSize = 24,
		Font = Enum.Font.GothamBlack,
		TextStrokeTransparency = 0.2,
		ZIndex = 4,
		Parent = b,
	})
	text({
		Position = UDim2.new(0, 6, 0, 2),
		Size = UDim2.new(0, 20, 0, 18),
		TextSize = 13,
		Font = Enum.Font.GothamBlack,
		TextColor3 = C.gold,
		TextStrokeTransparency = 0.3,
		Text = Config.SKILL_KEYS[slot],
		ZIndex = 5,
		Parent = b,
	})
	-- 이름표: E는 버튼 위, F는 버튼 아래
	local pos = SKILL_POS[slot]
	local nameLabel = text({
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(1, pos.X.Offset - 36, 1, slot == 1 and pos.Y.Offset - 88 or pos.Y.Offset + 2),
		Size = UDim2.new(0, 90, 0, 16),
		TextXAlignment = Enum.TextXAlignment.Center,
		TextSize = 11,
		TextStrokeTransparency = 0.3,
		Parent = actionPad,
	})
	skillButtons[slot] = { button = b, cover = cover, timer = timer, name = nameLabel, readyAt = 0, duration = 1 }
	b.Activated:Connect(function()
		if battle.active then
			Request:FireServer("skill", slot)
		end
	end)
end

local shownSkillType = -1
local function setSkillIcons(typeId: number, tier: number?)
	local t = tier or 1
	local key = typeId * 10 + t
	if key == shownSkillType then
		return
	end
	shownSkillType = key
	local list = Config.Skills[typeId] or Config.Skills[1]
	for slot, sb in ipairs(skillButtons) do
		local sk = list[slot]
		sb.button.Text = sk.icon
		sb.name.Text = string.format("%s Lv.%d", sk.name, t)
		local stars = sb.button:FindFirstChild("Stars")
		if not stars then
			stars = text({
				Name = "Stars",
				AnchorPoint = Vector2.new(0.5, 1),
				Position = UDim2.new(0.5, 0, 1, -3),
				Size = UDim2.new(1, 0, 0, 14),
				TextXAlignment = Enum.TextXAlignment.Center,
				TextSize = 11,
				TextColor3 = C.gold,
				TextStrokeTransparency = 0.2,
				ZIndex = 5,
				Parent = sb.button,
			})
		end
		(stars :: TextLabel).Text = string.rep("★", t)
	end
end

RunService.RenderStepped:Connect(function()
	local now = os.clock()
	for _, sb in ipairs(skillButtons) do
		local rem = sb.readyAt - now
		if rem > 0 then
			sb.cover.Size = UDim2.fromScale(1, math.clamp(rem / sb.duration, 0, 1))
			sb.timer.Text = tostring(math.ceil(rem))
		elseif sb.timer.Text ~= "" then
			sb.cover.Size = UDim2.fromScale(1, 0)
			sb.timer.Text = ""
		end
	end
end)

local controlHint = text({
	AnchorPoint = Vector2.new(0.5, 1),
	Position = UDim2.new(0.5, 0, 1, -8),
	Size = UDim2.new(0, 600, 0, 20),
	TextSize = 13,
	TextColor3 = C.dim,
	TextXAlignment = Enum.TextXAlignment.Center,
	TextStrokeTransparency = 0.5,
	Text = "클릭: 공격   ·   Q / Shift: 대시   ·   E / F: 무기 스킬   ·   R: 필살기",
	Visible = false,
	Parent = gui,
})

-- 필살기 이름 배너
local showUltBanner
do
	local ultBanner = text({
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0.5, 0, 0.3, 0),
		Size = UDim2.new(0, 700, 0, 80),
		TextXAlignment = Enum.TextXAlignment.Center,
		TextSize = 60,
		Font = Enum.Font.GothamBlack,
		TextStrokeTransparency = 0,
		Visible = false,
		ZIndex = 15,
		Parent = gui,
	})
	local ultBannerScale = new("UIScale", { Parent = ultBanner })
	local ultBannerToken = 0
	function showUltBanner(name: string, color: Color3)
		ultBannerToken += 1
		local my = ultBannerToken
		ultBanner.Text = "💥 " .. name
		ultBanner.TextColor3 = lighten(color, 0.3)
		ultBanner.TextStrokeColor3 = darken(color, 0.7)
		ultBanner.TextTransparency = 0
		ultBanner.TextStrokeTransparency = 0
		ultBanner.Visible = true
		ultBannerScale.Scale = 1.8 * uiScaleValue
		TweenService:Create(ultBannerScale, TweenInfo.new(0.25, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = uiScaleValue }):Play()
		task.delay(1.0, function()
			if ultBannerToken == my then
				TweenService:Create(ultBanner, TweenInfo.new(0.3), { TextTransparency = 1, TextStrokeTransparency = 1 }):Play()
			end
		end)
	end
end

-- 큰 배너: 웨이브, 보스 등장, 전투 시작
local showBigBanner
do
	local bigBanner = text({
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0.5, 0, 0.38, 0),
		Size = UDim2.new(0, 800, 0, 90),
		TextXAlignment = Enum.TextXAlignment.Center,
		TextSize = 64,
		Font = Enum.Font.GothamBlack,
		TextStrokeTransparency = 0,
		Visible = false,
		ZIndex = 14,
		Parent = gui,
	})
	local bigSub = text({
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 1, 0),
		Size = UDim2.new(1, 0, 0, 30),
		TextXAlignment = Enum.TextXAlignment.Center,
		TextSize = 24,
		Font = Enum.Font.GothamBlack,
		TextStrokeTransparency = 0.2,
		ZIndex = 14,
		Parent = bigBanner,
	})
	local bigScale = new("UIScale", { Parent = bigBanner })
	local bigToken = 0
	function showBigBanner(title: string, sub: string, color: Color3, hold: number?)
		bigToken += 1
		local my = bigToken
		bigBanner.Text = title
		bigBanner.TextColor3 = lighten(color, 0.25)
		bigBanner.TextStrokeColor3 = darken(color, 0.75)
		bigBanner.TextTransparency = 0
		bigBanner.TextStrokeTransparency = 0
		bigSub.Text = sub
		bigSub.TextColor3 = C.text
		bigSub.TextTransparency = 0
		bigBanner.Visible = true
		bigScale.Scale = uiScaleValue * 2.2
		TweenService:Create(bigScale, TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = uiScaleValue }):Play()
		task.delay(hold or 1.3, function()
			if bigToken == my then
				local info = TweenInfo.new(0.35)
				TweenService:Create(bigBanner, info, { TextTransparency = 1, TextStrokeTransparency = 1 }):Play()
				TweenService:Create(bigSub, info, { TextTransparency = 1 }):Play()
			end
		end)
	end
end

-- 화면 가장자리 붉은 테두리: 맞을 때 번쩍, 체력이 낮으면 숨 쉬듯
local hurtFlash, lowHp
do
	local vignette = new("Frame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		ZIndex = 1,
		Parent = gui,
	})
	local vignetteEdges: { Frame } = {}
	for i, spec in ipairs({
		{ UDim2.new(0, 0, 0, 0), UDim2.new(1, 0, 0.18, 0), 90 },
		{ UDim2.new(0, 0, 0.82, 0), UDim2.new(1, 0, 0.18, 0), -90 },
		{ UDim2.new(0, 0, 0, 0), UDim2.new(0.12, 0, 1, 0), 0 },
		{ UDim2.new(0.88, 0, 0, 0), UDim2.new(0.12, 0, 1, 0), 180 },
	}) do
		local edge = new("Frame", {
			Position = spec[1],
			Size = spec[2],
			BackgroundColor3 = Color3.fromRGB(200, 0, 0),
			BorderSizePixel = 0,
			BackgroundTransparency = 1,
			Parent = vignette,
		})
		new("UIGradient", {
			Rotation = spec[3],
			Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(1, 1) }),
			Parent = edge,
		})
		vignetteEdges[i] = edge
	end
	hurtFlash = 0
	lowHp = false
	local function setVignette(alpha: number, color: Color3)
		for _, e in ipairs(vignetteEdges) do
			e.BackgroundTransparency = 1 - alpha
			e.BackgroundColor3 = color
		end
	end
	RunService.RenderStepped:Connect(function(dt)
		hurtFlash = math.max(0, hurtFlash - dt * 2.5)
		local pulse = lowHp and (0.25 + 0.2 * math.sin(os.clock() * 6)) or 0
		local a = math.max(hurtFlash, pulse)
		setVignette(math.clamp(a, 0, 0.85), Color3.fromRGB(200, 0, 0))
	end)
end

-- 콤보: 1.6초 안에 계속 때리면 숫자가 커지고 색이 바뀐다
local addCombo, combo
do
	local comboLabel = text({
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -30, 0.42, 0),
		Size = UDim2.new(0, 300, 0, 70),
		TextXAlignment = Enum.TextXAlignment.Right,
		TextSize = 54,
		Font = Enum.Font.GothamBlack,
		TextStrokeTransparency = 0,
		Visible = false,
		ZIndex = 12,
		Parent = gui,
	})
	local comboSub = text({
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, 0, 1, -8),
		Size = UDim2.new(1, 0, 0, 24),
		TextXAlignment = Enum.TextXAlignment.Right,
		TextSize = 20,
		Font = Enum.Font.GothamBlack,
		TextStrokeTransparency = 0.2,
		Text = "COMBO",
		ZIndex = 12,
		Parent = comboLabel,
	})
	local comboScale = new("UIScale", { Parent = comboLabel })
	combo = 0
	local comboAt = 0
	local COMBO_COLORS = {
		{ 0, Color3.fromRGB(255, 250, 235) },
		{ 10, Color3.fromRGB(255, 220, 90) },
		{ 25, Color3.fromRGB(255, 140, 40) },
		{ 50, Color3.fromRGB(255, 60, 60) },
		{ 100, Color3.fromRGB(200, 90, 255) },
	}
	function addCombo(n: number)
		local now = os.clock()
		if now - comboAt > 1.6 then
			combo = 0
		end
		combo += n
		comboAt = now
		local color = COMBO_COLORS[1][2]
		for _, c in ipairs(COMBO_COLORS) do
			if combo >= c[1] then
				color = c[2]
			end
		end
		comboLabel.Text = tostring(combo)
		comboLabel.TextColor3 = color
		comboLabel.TextStrokeColor3 = darken(color, 0.8)
		comboSub.TextColor3 = color
		comboLabel.Visible = combo >= 3
		comboScale.Scale = uiScaleValue * (1.35 + math.min(combo, 100) / 250)
		TweenService:Create(comboScale, TweenInfo.new(0.15, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = uiScaleValue }):Play()
	end
	RunService.Heartbeat:Connect(function()
		if comboLabel.Visible and os.clock() - comboAt > 1.6 then
			comboLabel.Visible = false
			combo = 0
		end
	end)
end

-- 등급 상승: 화면 가득 축포
local function celebrate(stage: number)
	local color = GradeStyle.get(Config.stageGrade(stage)).glow
	showBigBanner(Config.isBeyond(stage) and "BEYOND!" or "RANK UP!", string.format("[%d] %s", stage, (Config.stageName(stage))), color, 1.8)
	for i = 1, 70 do
		local piece = new("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.new(math.random(), 0, -0.05, 0),
			Size = UDim2.new(0, math.random(8, 16), 0, math.random(12, 22)),
			BackgroundColor3 = (i % 3 == 0) and C.gold or (i % 3 == 1 and color or Color3.new(1, 1, 1)),
			BorderSizePixel = 0,
			Rotation = math.random(0, 360),
			ZIndex = 13,
			Parent = gui,
		})
		local dur = 1.6 + math.random() * 1.4
		TweenService:Create(piece, TweenInfo.new(dur, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
			Position = UDim2.new(piece.Position.X.Scale + (math.random() - 0.5) * 0.3, 0, 1.1, 0),
			Rotation = piece.Rotation + math.random(-540, 540),
		}):Play()
		Debris:AddItem(piece, dur)
	end
	Effects.sound("ping", 0.8, 0.9)
	task.delay(0.15, function()
		Effects.sound("ping", 0.8, 1.2)
	end)
end

-- 결과 창
local showResult
do
	local resultFrame = new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0.5, 0, 0.42, 0),
		Size = UDim2.new(0, 440, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundColor3 = Color3.new(1, 1, 1),
		Visible = false,
		ZIndex = 10,
		Parent = gui,
	}, { corner(16), shade(C.panel2, C.bg), pad(16), new("UIListLayout", { Padding = UDim.new(0, 5), HorizontalAlignment = Enum.HorizontalAlignment.Center }) })
	local resultStroke = stroke(C.gold, 3)
	resultStroke.Parent = resultFrame
	local resultScale = addScale(resultFrame)
	local resultToken = 0

	function showResult(data: any)
		resultToken += 1
		local my = resultToken
		for _, child in ipairs(resultFrame:GetChildren()) do
			if child:IsA("TextLabel") then
				child:Destroy()
			end
		end
		local order = 0
		local function line(str: string, color: Color3?, size: number?, gradient: ColorSequence?)
			order += 1
			local l = text({
				LayoutOrder = order,
				Size = UDim2.new(1, 0, 0, 0),
				AutomaticSize = Enum.AutomaticSize.Y,
				TextXAlignment = Enum.TextXAlignment.Center,
				TextSize = size or 16,
				Font = Enum.Font.GothamBlack,
				TextStrokeTransparency = 0.4,
				TextColor3 = color or C.text,
				Text = str,
				ZIndex = 11,
				Parent = resultFrame,
			})
			if gradient then
				l.TextColor3 = Color3.new(1, 1, 1)
				new("UIGradient", { Color = gradient, Rotation = 90, Parent = l })
			end
		end
		if data.win then
			resultStroke.Color = C.gold
			line("VICTORY", nil, 46, ColorSequence.new(Color3.fromRGB(255, 240, 150), Color3.fromRGB(230, 140, 30)))
			line("+ 💰 " .. fmt(data.coins), C.gold, 20)
			if data.firstClear then
				task.delay(0.4, function()
					celebrate(data.stage)
				end)
				local en = Config.stageName(data.stage)
				line(string.format("🏅 새 등급 달성!  [%d] %s", data.stage, en), GradeStyle.textColor(Config.stageGrade(data.stage)), 19)
			end
			for _, key in ipairs(data.drops or {}) do
				local title, info = weaponTitle(key)
				line("획득  " .. title .. (info and ("  (" .. info.rarity.name .. ")") or ""), info and weaponColor(info) or C.text, 15)
			end
			if data.again then
				line("🔁 곧 다음 판이 자동으로 시작돼요", C.green, 14)
			end
			Effects.sound("ping", 0.5, 1.2)
		else
			resultStroke.Color = C.red
			line("DEFEAT", nil, 46, ColorSequence.new(Color3.fromRGB(255, 120, 110), Color3.fromRGB(140, 20, 20)))
			line("무기를 합성하거나 훈련해서 다시 도전해 보세요", C.dim, 15)
		end
		resultFrame.Visible = true
		resultScale.Scale = uiScaleValue * 0.7
		TweenService:Create(resultScale, TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = uiScaleValue }):Play()
		task.delay(data.win and 2.4 or 2.8, function()
			if resultToken == my then
				resultFrame.Visible = false
			end
		end)
	end
end

-- 합성 성공 연출
local showMerge
do
	local mergePopup = new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0.5, 0, 0.45, 0),
		Size = UDim2.new(0, 300, 0, 300),
		BackgroundColor3 = Color3.new(1, 1, 1),
		Visible = false,
		ZIndex = 30,
		Parent = gui,
	}, { corner(20), shade(C.panel2, C.bg) })
	local mergeStroke = stroke(C.gold, 3)
	mergeStroke.Parent = mergePopup
	local mergeScale = addScale(mergePopup)
	local mergeTitle = text({
		Position = UDim2.new(0, 0, 0, 10),
		Size = UDim2.new(1, 0, 0, 34),
		TextXAlignment = Enum.TextXAlignment.Center,
		TextSize = 26,
		Font = Enum.Font.GothamBlack,
		TextColor3 = C.gold,
		TextStrokeTransparency = 0.3,
		ZIndex = 31,
		Parent = mergePopup,
	})
	local mergeView = new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 50),
		Size = UDim2.new(0, 180, 0, 180),
		BackgroundTransparency = 1,
		ZIndex = 31,
		Parent = mergePopup,
	})
	local mergeName = text({
		Position = UDim2.new(0, 10, 1, -66),
		Size = UDim2.new(1, -20, 0, 30),
		TextXAlignment = Enum.TextXAlignment.Center,
		TextSize = 20,
		Font = Enum.Font.GothamBlack,
		TextStrokeTransparency = 0.4,
		ZIndex = 31,
		Parent = mergePopup,
	})
	local mergeSub = text({
		Position = UDim2.new(0, 10, 1, -36),
		Size = UDim2.new(1, -20, 0, 22),
		TextXAlignment = Enum.TextXAlignment.Center,
		TextSize = 14,
		ZIndex = 31,
		Parent = mergePopup,
	})
	local mergeToken = 0
	function showMerge(key: string, count: number)
		local title, info = weaponTitle(key)
		if not info then
			return
		end
		mergeToken += 1
		local my = mergeToken
		local wc = weaponColor(info)
		mergeTitle.Text = info.typeId == 0 and "🌈 올라운더 탄생!" or (count > 1 and string.format("🔨 %d번 합성!", count) or "🔨 합성 성공!")
		mergeName.Text = title
		setGradeColor(mergeName, info.grade)
		mergeSub.Text = info.typeId == 0 and "최종 무기" or (info.rarity.name .. "  ·  " .. info.type.desc)
		mergeSub.TextColor3 = wc
		mergeStroke.Color = wc
		for _, c in ipairs(mergeView:GetChildren()) do
			c:Destroy()
		end
		weaponViewport(mergeView, key, true)
		mergePopup.Visible = true
		mergeScale.Scale = uiScaleValue * 0.5
		TweenService:Create(mergeScale, TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = uiScaleValue }):Play()
		Effects.sound("ping", 0.6, info.rarity.rank >= 5 and 1.5 or 1.2)
		task.delay(1.8, function()
			if mergeToken == my then
				mergePopup.Visible = false
				for _, c in ipairs(mergeView:GetChildren()) do
					c:Destroy()
				end
			end
		end)
	end
end

------------------------------------------------------------------------
-- 갱신
------------------------------------------------------------------------
local function refreshTop()
	if not state then
		return
	end
	coinLabel.Text = "💰 " .. fmt(state.coins)
	powerLabel.Text = "⚔ " .. fmt(state.power)
	if state.maxStage > 0 then
		rankLabel.Text = string.format("🏅 %s", (Config.stageName(state.maxStage)))
		setStageColor(rankLabel, state.maxStage)
		rankStroke.Color = GradeStyle.get(Config.stageGrade(state.maxStage)).glow
	else
		rankLabel.Text = "🏅 NO RANK"
		rankLabel.TextColor3 = C.dim
		rankStroke.Color = C.line
	end
end

local function refreshBattle()
	local active = battle.active == true
	if not active then
		lowHp = false
	end
	hud.Visible = active
	hudButtons.Visible = active
	actionPad.Visible = active
	controlHint.Visible = active and not UserInputService.TouchEnabled
	if not active then
		return
	end
	local stageEn = Config.stageName(battle.stage)
	local section = { color = GradeStyle.get(Config.stageGrade(battle.stage)).glow }
	hudTitle.Text = string.format("%sSTAGE %d  ·  %s", battle.boss and "👑 " or (Config.isBeyond(battle.stage) and "🌌 " or ""), battle.stage, stageEn)
	setStageColor(hudTitle, battle.stage)
	hudStroke.Color = battle.boss and C.red or section.color
	local ratio = math.clamp(battle.hp / math.max(battle.maxHp, 1), 0, 1)
	hpFill.Size = UDim2.fromScale(ratio, 1)
	local hpGrad = hpFill:FindFirstChildOfClass("UIGradient")
	if hpGrad then
		if ratio > 0.5 then
			hpGrad.Color = ColorSequence.new(Color3.fromRGB(120, 230, 120), Color3.fromRGB(40, 150, 60))
		elseif ratio > 0.25 then
			hpGrad.Color = ColorSequence.new(Color3.fromRGB(255, 220, 110), Color3.fromRGB(200, 140, 30))
		else
			hpGrad.Color = ColorSequence.new(Color3.fromRGB(255, 120, 100), Color3.fromRGB(170, 30, 30))
		end
	end
	hpText.Text = string.format("❤ %s / %s", fmt(battle.hp), fmt(battle.maxHp))
	local gauge = math.clamp((battle.gauge or 0) / 100, 0, 1)
	gaugeFill.Size = UDim2.fromScale(gauge, 1)
	local ready = gauge >= 1
	gaugeText.Text = ready and "💥 필살기 준비! (R)" or string.format("필살기 %d%%", math.floor(gauge * 100))
	ultBtn.TextTransparency = ready and 0 or 0.55
	ultBtnStroke.Thickness = ready and 5 or 3
	enemyText.Text = string.format("WAVE %d / %d   ·   남은 적  %d", battle.wave or 1, battle.waveTotal or 1, battle.left)
	lowHp = ratio < 0.3
	if battle.typeId ~= nil then
		setSkillIcons(battle.typeId, battle.skillTier)
	end
	autoBtn.Text = battle.auto and "🔁 자동 ON" or "🔁 자동 OFF"
	setButtonColor(autoBtn, battle.auto and C.green or C.panel3)
end

local function refreshAll()
	refreshTop()
	if state then
		menuButtons.test.Visible = state.tester == true
		godBtn.Text = state.god and "🛡 무적 ON" or "🛡 무적 OFF"
		setButtonColor(godBtn, state.god and C.green or C.panel3)
		cdBtn.Text = state.noCooldown and "⏱ 쿨타임 없음 ON" or "⏱ 쿨타임 없음 OFF"
		setButtonColor(cdBtn, state.noCooldown and C.green or C.panel3)
	end
	if window.Visible then
		local r = refreshers[currentPage]
		if r then
			r()
		end
	end
end

-- 필살기 버튼은 준비되면 숨 쉬듯 반짝인다
RunService.RenderStepped:Connect(function()
	if battle.active and (battle.gauge or 0) >= 100 then
		local pulse = (math.sin(os.clock() * 8) + 1) / 2
		ultBtnStroke.Color = C.gold:Lerp(Color3.new(1, 1, 1), pulse)
	end
end)

------------------------------------------------------------------------
-- 조작
------------------------------------------------------------------------
local fxFolder = new("Folder", { Name = "ArenaFX", Parent = workspace })

local function getChar(): (BasePart?, Humanoid?)
	local char = player.Character
	if not char then
		return nil, nil
	end
	local root = char:FindFirstChild("HumanoidRootPart")
	local hum = char:FindFirstChildOfClass("Humanoid")
	if root and root:IsA("BasePart") and hum and hum.Health > 0 then
		return root, hum
	end
	return nil, nil
end
Effects.init(fxFolder, getChar)
KillFx.init(Effects)
Motion.setCharacter(player.Character)
player.CharacterAdded:Connect(function(char)
	task.wait(0.3)
	Motion.setCharacter(char)
end)

-- 히트스톱: 맞는 순간 내 휘두르기 동작을 아주 잠깐 멈춘다
local function hitStop(duration: number)
	Motion.hitStop(duration)
end

-- 칼이 닿는 순간: 휘두르기 동작이 내려오는 때에 맞춰 타격 연출을 보여 준다
local impactAt = 0

-- 줌 반동: 화면이 순간 앞으로 당겨졌다 돌아온다
local baseFov = 70
local fovTween: Tween? = nil
local function fovPunch(amount: number)
	local cam = workspace.CurrentCamera
	if not cam then
		return
	end
	if fovTween then
		fovTween:Cancel()
	end
	cam.FieldOfView = baseFov - amount
	local tween = TweenService:Create(cam, TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { FieldOfView = baseFov })
	fovTween = tween
	tween:Play()
end

-- 무기별 타격 무게 (불꽃 크기, 흔들림)
local HEAVY = { [1] = 1.5, [2] = 0.8, [3] = 1.1, [4] = 0.9, [5] = 1.2, [0] = 1.5 }
local lastSwingType = 1

-- 연속 처치: 1.2초 안에 잡으면 이어진다
local onKill
do
	local killLabel = text({
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0.5, 0, 0.22, 0),
		Size = UDim2.new(0, 600, 0, 60),
		TextXAlignment = Enum.TextXAlignment.Center,
		TextSize = 44,
		Font = Enum.Font.GothamBlack,
		TextStrokeTransparency = 0,
		Visible = false,
		ZIndex = 13,
		Parent = gui,
	})
	local killScale = new("UIScale", { Parent = killLabel })
	local KILL_NAMES = { [2] = "DOUBLE KILL", [3] = "TRIPLE KILL", [4] = "QUADRA KILL", [5] = "PENTA KILL" }
	local killStreak = 0
	local lastKillAt = 0
	local killToken = 0
	function onKill()
		local now = os.clock()
		if now - lastKillAt > 1.2 then
			killStreak = 0
		end
		killStreak += 1
		lastKillAt = now
		Effects.sound("ping", 0.45, 1.1 + math.min(killStreak, 8) * 0.12)
		if killStreak < 2 then
			return
		end
		killToken += 1
		local my = killToken
		killLabel.Text = KILL_NAMES[killStreak] or string.format("RAMPAGE x%d", killStreak)
		local color = killStreak >= 5 and Color3.fromRGB(255, 80, 200) or (killStreak >= 3 and Color3.fromRGB(255, 120, 40) or C.gold)
		killLabel.TextColor3 = color
		killLabel.TextStrokeColor3 = darken(color, 0.8)
		killLabel.TextTransparency = 0
		killLabel.TextStrokeTransparency = 0
		killLabel.Visible = true
		killScale.Scale = uiScaleValue * 1.8
		TweenService:Create(killScale, TweenInfo.new(0.22, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = uiScaleValue }):Play()
		Effects.shake(0.3 + killStreak * 0.08, 0.15)
		task.delay(1.1, function()
			if killToken == my then
				TweenService:Create(killLabel, TweenInfo.new(0.3), { TextTransparency = 1, TextStrokeTransparency = 1 }):Play()
			end
		end)
	end
end

local function nearestEnemy(root: BasePart): (BasePart?, number)
	local battles = workspace:FindFirstChild("ArenaBattles")
	local folder = battles and battles:FindFirstChild("P_" .. player.UserId)
	if not folder then
		return nil, math.huge
	end
	local best, bestDist = nil, math.huge
	for _, m in ipairs(folder:GetChildren()) do
		if m:IsA("Model") and m:GetAttribute("Enemy") and not m:GetAttribute("Dead") then
			local r = m:FindFirstChild("HumanoidRootPart")
			if r and r:IsA("BasePart") then
				local d = (Vector3.new(r.Position.X, 0, r.Position.Z) - Vector3.new(root.Position.X, 0, root.Position.Z)).Magnitude
				if d < bestDist then
					best, bestDist = r, d
				end
			end
		end
	end
	return best, bestDist
end

local attackHeld = false
local lastTry = 0

local function tryAttack()
	if not battle.active or not myStats then
		return
	end
	local root, hum = getChar()
	if not root or not hum then
		return
	end
	lastTry = os.clock()
	local target, dist = nearestEnemy(root)
	if target then
		local tp = target.Position
		if dist > myStats.range * 0.8 then
			hum:MoveTo(tp)
		else
			root.CFrame = CFrame.lookAt(root.Position, Vector3.new(tp.X, root.Position.Y, tp.Z))
		end
	end
	Request:FireServer("attack")
end

local lastDash = 0
local function dash()
	if not battle.active then
		return
	end
	local now = os.clock()
	if now - lastDash < Config.DASH_COOLDOWN then
		return
	end
	local root, hum = getChar()
	if not root or not hum then
		return
	end
	lastDash = now
	local dir = hum.MoveDirection
	if dir.Magnitude < 0.1 then
		dir = root.CFrame.LookVector
	end
	dir = Vector3.new(dir.X, 0, dir.Z)
	if dir.Magnitude < 0.01 then
		return
	end
	dir = dir.Unit
	local att = root:FindFirstChild("RootAttachment")
	if not att or not att:IsA("Attachment") then
		att = new("Attachment", { Name = "DashAttachment", Parent = root })
	end
	local lv = new("LinearVelocity", {
		Attachment0 = att,
		MaxForce = 1e7,
		VelocityConstraintMode = Enum.VelocityConstraintMode.Vector,
		RelativeTo = Enum.ActuatorRelativeTo.World,
		VectorVelocity = dir * 85,
		Parent = root,
	})
	Debris:AddItem(lv, 0.18)
	local char = player.Character
	if char then
		for i = 0, 2 do
			task.delay(i * 0.05, function()
				Effects.afterimage(char, Color3.fromRGB(150, 200, 255))
			end)
		end
	end
	Request:FireServer("dash")
	Motion.roll()
	Effects.burst(root.Position - Vector3.new(0, 2, 0), Color3.fromRGB(220, 230, 255), 10, 12, 0.7)
	dashBtn.TextTransparency = 0.6
	task.delay(Config.DASH_COOLDOWN, function()
		dashBtn.TextTransparency = 0
	end)
end

local function ultimate()
	if battle.active and (battle.gauge or 0) >= 100 then
		Request:FireServer("ultimate")
	end
end

attackBtn.MouseButton1Down:Connect(function()
	attackHeld = true
	tryAttack()
end)
attackBtn.MouseButton1Up:Connect(function()
	attackHeld = false
end)
attackBtn.MouseLeave:Connect(function()
	attackHeld = false
end)
dashBtn.Activated:Connect(dash)
ultBtn.Activated:Connect(ultimate)

UserInputService.InputBegan:Connect(function(input, processed)
	if processed then
		return
	end
	if input.UserInputType == Enum.UserInputType.MouseButton1 then
		attackHeld = true
		tryAttack()
	elseif input.KeyCode == Enum.KeyCode.Q or input.KeyCode == Enum.KeyCode.LeftShift then
		dash()
	elseif input.KeyCode == Enum.KeyCode.R then
		ultimate()
	elseif input.KeyCode == Enum.KeyCode.E and battle.active then
		Request:FireServer("skill", 1)
	elseif input.KeyCode == Enum.KeyCode.F and battle.active then
		Request:FireServer("skill", 2)
	end
end)
UserInputService.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 then
		attackHeld = false
	end
end)

RunService.Heartbeat:Connect(function()
	if attackHeld and battle.active and os.clock() - lastTry >= 0.12 then
		tryAttack()
	end
end)

------------------------------------------------------------------------
-- 서버 메시지
------------------------------------------------------------------------
Push.OnClientEvent:Connect(function(kind: string, data: any)
	if kind == "state" then
		state = data
		myStats = Config.profileStats(data)
		refreshAll()
	elseif kind == "battle" then
		battle = data
		if not data.active then
			attackHeld = false
		end
		Motion.setCombat(data.active and data.typeId or nil)
		refreshBattle()
	elseif kind == "hits" then
		-- 기본 공격 타격은 칼이 내려오는 순간에, 나머지(독, 아우라, 폭발)는 바로
		local function process()
			Effects.hits(data)
			local landed = 0
			local anyCrit = false
			local heavy = HEAVY[lastSwingType] or 1
			for _, h in ipairs(data) do
				if h.kind == "hurt" then
					hurtFlash = 0.55
					fovPunch(-2)
					Motion.flinch(player.Character, 0.8)
				elseif h.kind == "aura" or h.kind == "blast" then
					Effects.hitFlash(h.model, false)
					Motion.flinch(h.model, 0.6)
				elseif h.kind ~= "poison" and h.kind ~= "miss" then
					landed += 1
					anyCrit = anyCrit or h.kind == "crit"
					Effects.impact(h, heavy)
					Effects.hitFlash(h.model, h.kind == "crit")
					Motion.flinch(h.model, h.kind == "crit" and 1.3 or 0.8)
				end
			end
			if landed > 0 then
				addCombo(landed)
				hitStop(anyCrit and 0.1 or 0.045 * heavy)
				fovPunch(anyCrit and 4 or 1.2 * heavy)
				Effects.shake((anyCrit and 0.45 or 0.12) * heavy, anyCrit and 0.14 or 0.07)
				Effects.sound("lunge", anyCrit and 0.45 or 0.2, (anyCrit and 1.0 or 1.5) + math.random() * 0.2)
			end
		end
		local first = data[1]
		local wait = impactAt - os.clock()
		if first and (first.kind == "hit" or first.kind == "crit" or first.kind == "block") and wait > 0 then
			task.delay(wait, process)
		else
			process()
		end
	elseif kind == "swing" then
		lastSwingType = data.typeId or 1
		local delay = Motion.attack(data.typeId or 1, data.step or 1, data.cooldown or 0.5)
		impactAt = os.clock() + delay
		-- 3타째는 앞으로 한 걸음 내디딘다
		local root = getChar()
		if root and data.step == 3 and data.target then
			local d = Vector3.new(data.target.X - root.Position.X, 0, data.target.Z - root.Position.Z)
			if d.Magnitude > 3 then
				pushSelf(d.Unit, 26, 0.12)
			end
		end
		task.delay(delay, function()
			Effects.swing(data)
			if data.step == 3 then
				Effects.shake(0.35, 0.12)
				fovPunch(3)
			end
		end)
	elseif kind == "ult" then
		Motion.ult(data.typeId or 1)
		showUltBanner(data.name, data.color or C.gold)
		Effects.ultimate(data)
	elseif kind == "slam" then
		Effects.slam(data)
	elseif kind == "result" then
		if data.win then
			Motion.victory()
		end
		showResult(data)
	elseif kind == "toast" then
		toast(data)
	elseif kind == "openPage" then
		openPage(data, true)
	elseif kind == "equipped" then
		Effects.sound("unsheath", 0.6, 1)
	elseif kind == "skill" then
		Motion.skill(data.id)
		if data.id == "mark" then
			attachMarkRune(data.model, data.stacks, data.color)
		elseif data.id == "charge" or data.id == "phantom" then
			local root = getChar()
			if root then
				local dir = (data.target - data.origin)
				local dist = Vector3.new(dir.X, 0, dir.Z).Magnitude
				if dist > 0.5 then
					pushSelf(Vector3.new(dir.X, 0, dir.Z).Unit, dist / 0.2, 0.2)
				end
			end
			Effects.skill(data)
		else
			Effects.skill(data)
		end
	elseif kind == "cooldown" then
		local sb = skillButtons[data.slot]
		if sb then
			sb.readyAt = os.clock() + data.duration
			sb.duration = data.duration
		end
	elseif kind == "stun" then
		showStun(data.model, data.duration)
	elseif kind == "proj" then
		Effects.projectile(data)
	elseif kind == "knock" then
		pushSelf(data.dir, data.power, 0.15)
		Effects.shake(0.7, 0.2)
	elseif kind == "dust" then
		Effects.dust(data)
	elseif kind == "explode" then
		Effects.explode(data)
	elseif kind == "flame" then
		Effects.flame(data)
	elseif kind == "meteor" then
		Effects.meteor(data)
	elseif kind == "spin" then
		Effects.spinFx(data)
	elseif kind == "summon" then
		Effects.summonFx(data)
	elseif kind == "blink" then
		Effects.blink(data)
	elseif kind == "kill" then
		Effects.shatter(data.model, data.color)
		Effects.kill(data)
		if (data.fx or 0) > 0 then
			KillFx.play(data)
		end
		onKill()
	elseif kind == "auraPulse" then
		KillFx.pulse(data)
	elseif kind == "heal" then
		KillFx.heal(data)
	elseif kind == "enhanced" then
		local root = getChar()
		if root then
			Effects.flash(root.Position, C.gold, 10, 0.4)
			Effects.burst(root.Position, Color3.fromRGB(255, 150, 60), 40, 26, 0.7)
		end
		Effects.sound("ping", 0.6, 1.2)
		toast(string.format("🔥 강화 성공! +%d · %s", data.level, data.look or ""))
	elseif kind == "cosmetic" then
		local list = data.kind == "aura" and Config.Auras or Config.KillFx
		local item = list[data.tier]
		if item then
			toast(string.format("%s %s [%d] %s", data.bought and "🎉 구매!" or "✔", data.kind == "aura" and "아우라" or "킬 이펙트", data.tier, item.name))
		end
		local root = getChar()
		if root and data.kind == "kill" then
			KillFx.play({ pos = root.Position + root.CFrame.LookVector * 10, fx = data.tier, radius = Config.KillFx[data.tier].blast.radius })
		elseif root then
			Effects.flash(root.Position, C.gold, 8, 0.4)
		end
	elseif kind == "battleStart" then
		Effects.battleStart(data)
		local en, ko = Config.stageName(data.stage)
		showBigBanner(string.format("%sSTAGE %d", data.beyond and "🌌 " or "", data.stage), data.beyond and ko or en, data.color, 1.1)
		for _, sb in ipairs(skillButtons) do
			sb.readyAt = 0
		end
		combo = 0
	elseif kind == "wave" then
		if data.boss then
			-- 보스 웨이브는 따로 크게 알린다
		elseif data.index > 1 then
			showBigBanner(string.format("WAVE %d", data.index), string.format("%d / %d", data.index, data.total), C.gold, 1.0)
			Effects.sound("unsheath", 0.6, 0.8)
		end
	elseif kind == "waveClear" then
		Effects.sound("ping", 0.5, 1.0)
		local root = getChar()
		if root then
			Effects.burst(root.Position, C.green, 30, 14, 0.6)
			Effects.flash(root.Position, C.green, 8, 0.35)
		end
		toast(string.format("✨ 웨이브 %d 돌파! 체력 %d%% 회복", data.index, math.floor((data.heal or 0) * 100)))
	elseif kind == "boss" then
		showBigBanner("👑 BOSS", string.format("%s · %s", data.name, data.kind), C.red, 1.8)
		hurtFlash = 0.8
		Effects.shake(1.2, 0.6)
		Effects.sound("lunge", 1, 0.4)
	elseif kind == "forge" then
		Effects.forge(data)
	elseif kind == "trained" then
		local root = getChar()
		if root then
			Effects.burst(root.Position, data == "atk" and C.red or C.green, 30, 18, 0.6)
			Effects.flash(root.Position, data == "atk" and C.red or C.green, 7, 0.3)
		end
		Effects.sound("ping", 0.5, 1.3)
	elseif kind == "merged" then
		if data.to then
			showMerge(data.to, data.count or 1)
		else
			toast(string.format("%d번 합성했어요!", data.count or 0))
		end
	end
end)

------------------------------------------------------------------------
-- 적 머리 위 표시: 표식, 기절, 독
------------------------------------------------------------------------
function attachMarkRune(target: Model?, maxStacks: number, color: Color3)
	if not target or not target.Parent then
		return
	end
	local model = target :: Model
	local head = model:FindFirstChild("Head") or model:FindFirstChild("HumanoidRootPart")
	if not head then
		return
	end
	local old = head:FindFirstChild("MarkRune")
	if old then
		old:Destroy()
	end
	local bb = new("BillboardGui", {
		Name = "MarkRune",
		Size = UDim2.new(0, 90, 0, 90),
		StudsOffset = Vector3.new(0, 4.5, 0),
		AlwaysOnTop = true,
		LightInfluence = 0,
		Parent = head,
	})
	local rune = text({
		Size = UDim2.fromScale(1, 0.7),
		TextXAlignment = Enum.TextXAlignment.Center,
		TextSize = 46,
		Text = "🎯",
		Parent = bb,
	})
	local count = text({
		Position = UDim2.fromScale(0, 0.68),
		Size = UDim2.fromScale(1, 0.32),
		TextXAlignment = Enum.TextXAlignment.Center,
		TextSize = 18,
		Font = Enum.Font.GothamBlack,
		TextColor3 = lighten(color, 0.3),
		TextStrokeTransparency = 0,
		Text = "0 / " .. maxStacks,
		Parent = bb,
	})
	local spin = new("UIScale", { Parent = rune })
	local conn
	conn = model:GetAttributeChangedSignal("Mark"):Connect(function()
		local v = model:GetAttribute("Mark")
		if v == nil then
			conn:Disconnect()
			bb:Destroy()
			return
		end
		count.Text = string.format("%d / %d", v, maxStacks)
		spin.Scale = 1.5
		TweenService:Create(spin, TweenInfo.new(0.15), { Scale = 1 }):Play()
	end)
end

function showStun(target: Model?, duration: number)
	if not target or not target.Parent then
		return
	end
	local model = target :: Model
	local head = model:FindFirstChild("Head") or model:FindFirstChild("HumanoidRootPart")
	if not head then
		return
	end
	local bb = new("BillboardGui", {
		Size = UDim2.new(0, 80, 0, 40),
		StudsOffset = Vector3.new(0, 3.5, 0),
		AlwaysOnTop = true,
		Parent = head,
	})
	local stars = text({
		Size = UDim2.fromScale(1, 1),
		TextXAlignment = Enum.TextXAlignment.Center,
		TextSize = 30,
		Text = "💫💫",
		Parent = bb,
	})
	local start = os.clock()
	local conn
	conn = RunService.RenderStepped:Connect(function()
		if not bb.Parent or os.clock() - start > duration then
			conn:Disconnect()
			bb:Destroy()
			return
		end
		stars.Rotation = math.sin(os.clock() * 10) * 15
	end)
end

-- 내 캐릭터를 잠깐 한쪽으로 민다 (돌격, 넉백)
function pushSelf(dir: Vector3, speed: number, duration: number)
	local root = getChar()
	if not root then
		return
	end
	local att = root:FindFirstChild("RootAttachment")
	if not att or not att:IsA("Attachment") then
		att = new("Attachment", { Name = "PushAttachment", Parent = root })
	end
	local lv = new("LinearVelocity", {
		Attachment0 = att,
		MaxForce = 1e7,
		VelocityConstraintMode = Enum.VelocityConstraintMode.Vector,
		RelativeTo = Enum.ActuatorRelativeTo.World,
		VectorVelocity = dir * speed,
		Parent = root,
	})
	Debris:AddItem(lv, duration)
end

-- 독에 걸린 적은 초록 거품을 뿜는다
local function watchEnemy(model: Instance)
	if not model:IsA("Model") then
		return
	end
	-- 공격 동작: 서버가 AnimN을 올릴 때마다 팔을 들었다 내려친다
	model:GetAttributeChangedSignal("AnimN"):Connect(function()
		local kindName = model:GetAttribute("AnimKind")
		local t = model:GetAttribute("AnimT")
		Motion.enemy(model :: Model, type(kindName) == "string" and kindName or "swing", type(t) == "number" and t or 0.35)
	end)
	-- 망령: 흐려진 동안 반투명
	model:GetAttributeChangedSignal("Phase"):Connect(function()
		local on = model:GetAttribute("Phase") == true
		for _, d in ipairs(model:GetDescendants()) do
			if d:IsA("BasePart") and d.Name ~= "HumanoidRootPart" then
				d.LocalTransparencyModifier = on and 0.75 or 0
			end
		end
		if on then
			local r = model:FindFirstChild("HumanoidRootPart")
			if r and r:IsA("BasePart") then
				Effects.burst(r.Position, Color3.fromRGB(170, 220, 255), 16, 8, 0.8)
			end
		end
	end)
	model:GetAttributeChangedSignal("Poison"):Connect(function()
		local head = model:FindFirstChild("Head") or model:FindFirstChild("HumanoidRootPart")
		if not head then
			return
		end
		local old = head:FindFirstChild("PoisonFx")
		if model:GetAttribute("Poison") then
			if not old then
				new("ParticleEmitter", {
					Name = "PoisonFx",
					Rate = 14,
					Lifetime = NumberRange.new(0.6, 1),
					Speed = NumberRange.new(1, 3),
					Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.4), NumberSequenceKeypoint.new(1, 0) }),
					LightEmission = 0.8,
					Color = ColorSequence.new(Color3.fromRGB(120, 255, 90)),
					Parent = head,
				})
			end
		elseif old then
			old:Destroy()
		end
	end)
end

-- 전투 폴더 감시: 적이 생기면 감시하고, 바닥 경고가 생기면 차오르는 원을 그린다
task.spawn(function()
	local battles = workspace:WaitForChild("ArenaBattles")
	battles.DescendantAdded:Connect(function(d)
		if d.Name == "Warning" and d:IsA("BasePart") then
			task.defer(function()
				Effects.warningFill(d)
			end)
		elseif d:IsA("Model") and d.Parent and d.Parent.Parent == battles then
			watchEnemy(d)
		end
	end)
end)

------------------------------------------------------------------------
-- 로비 장식: 톱니와 전시 무기는 돌고, 등불은 둥실 떠다닌다
------------------------------------------------------------------------
do
	type Deco = { part: BasePart, base: CFrame, spin: boolean, bob: boolean }
	local decos: { [BasePart]: Deco } = {}
	local function track(inst: Instance, kind: string)
		if not inst:IsA("BasePart") then
			return
		end
		local part = inst :: BasePart
		local d = decos[part]
		if not d then
			d = { part = part, base = part.CFrame, spin = false, bob = false }
			decos[part] = d
		end
		if kind == "spin" then
			d.spin = true
		else
			d.bob = true
		end
	end
	for _, tag in ipairs({ "ArenaSpin", "ArenaBob" }) do
		local kind = tag == "ArenaSpin" and "spin" or "bob"
		for _, inst in ipairs(CollectionService:GetTagged(tag)) do
			track(inst, kind)
		end
		CollectionService:GetInstanceAddedSignal(tag):Connect(function(inst)
			track(inst, kind)
		end)
	end
	local forgeBoostUntil = 0
	RunService.RenderStepped:Connect(function()
		local t = os.clock()
		local boost = t < forgeBoostUntil and 6 or 1
		for part, d in pairs(decos) do
			if not part.Parent then
				decos[part] = nil
			else
				local cf = d.base
				if d.bob then
					local amp = part:GetAttribute("Amp") or 0.5
					local speed = part:GetAttribute("BobSpeed") or 1
					local phase = part:GetAttribute("Phase") or 0
					cf = cf + Vector3.new(0, math.sin(t * speed + phase) * amp, 0)
				end
				if d.spin then
					local speed = (part:GetAttribute("Speed") or 1) * (part.Name:sub(1, 4) == "Gear" and boost or 1)
					if part:GetAttribute("Axis") == "X" then
						cf = cf * CFrame.Angles(t * speed, 0, 0)
					else
						cf = cf * CFrame.Angles(0, t * speed, 0)
					end
				end
				part.CFrame = cf
			end
		end
	end)
	Push.OnClientEvent:Connect(function(kind: string)
		if kind == "forge" then
			forgeBoostUntil = os.clock() + 1.5
		end
	end)
end

------------------------------------------------------------------------
-- 떠다니는 장식: 무기 둘레의 구슬과 파편, 캐릭터 발밑 고리와 오라 구슬
-- 서버는 자리만 만들어 두고, 각자 화면에서 매 프레임 돌린다 (다른 플레이어 것도)
------------------------------------------------------------------------
do
	type Orbit = {
		ref: ObjectValue,
		radius: number,
		height: number,
		speed: number,
		phase: number,
		useRot: boolean,
		flat: boolean,
		tumble: number,
		bob: number,
		bobSpeed: number,
		offset: CFrame,
		axis: string,
	}
	local orbits: { [BasePart]: Orbit } = {}
	local function trackOrbit(inst: Instance)
		if not inst:IsA("BasePart") then
			return
		end
		local part = inst :: BasePart
		local ref = part:FindFirstChild("Center") or part:WaitForChild("Center", 2)
		if not (ref and ref:IsA("ObjectValue")) then
			return
		end
		orbits[part] = {
			ref = ref,
			radius = part:GetAttribute("Radius") or 0,
			height = part:GetAttribute("Height") or 0,
			speed = part:GetAttribute("Speed") or 1,
			phase = part:GetAttribute("Phase") or 0,
			useRot = part:GetAttribute("UseRotation") == true,
			flat = part:GetAttribute("Flat") == true,
			tumble = part:GetAttribute("Tumble") or 0,
			bob = part:GetAttribute("Bob") or 0,
			bobSpeed = part:GetAttribute("BobSpeed") or 2,
			offset = CFrame.identity,
			axis = part:GetAttribute("Axis") or "Y",
		}
		local op = part:GetAttribute("OffsetPos")
		local orot = part:GetAttribute("OffsetRot")
		local off = CFrame.identity
		if typeof(op) == "Vector3" then
			off = CFrame.new(op)
		end
		if typeof(orot) == "Vector3" then
			off = off * CFrame.Angles(math.rad(orot.X), math.rad(orot.Y), math.rad(orot.Z))
		end
		orbits[part].offset = off
	end
	for _, inst in ipairs(CollectionService:GetTagged("ArenaOrbit")) do
		task.spawn(trackOrbit, inst)
	end
	CollectionService:GetInstanceAddedSignal("ArenaOrbit"):Connect(function(inst)
		task.spawn(trackOrbit, inst)
	end)
	CollectionService:GetInstanceRemovedSignal("ArenaOrbit"):Connect(function(inst)
		if inst:IsA("BasePart") then
			orbits[inst :: BasePart] = nil
		end
	end)
	local FLAT = CFrame.Angles(0, 0, math.rad(90))
	RunService.RenderStepped:Connect(function()
		local t = os.clock()
		for part, o in pairs(orbits) do
			if not part.Parent then
				orbits[part] = nil
			else
				local c = o.ref.Value
				if c and c:IsA("BasePart") and c.Parent then
					local center = c :: BasePart
					local base = (o.useRot and center.CFrame or CFrame.new(center.Position)) * o.offset
					local h = o.height
					if o.bob ~= 0 then
						h += math.sin(t * o.bobSpeed + o.phase) * o.bob
					end
					local a = t * o.speed + o.phase
					local spin
					if o.axis == "Z" then
						spin = CFrame.Angles(0, 0, a)
					elseif o.axis == "X" then
						spin = CFrame.Angles(a, 0, 0)
					else
						spin = CFrame.Angles(0, a, 0)
					end
					local cf = base * CFrame.new(0, h, 0) * spin * CFrame.new(o.radius, 0, 0)
					if o.tumble ~= 0 then
						cf = cf * CFrame.Angles(t * o.tumble, t * o.tumble * 0.7, 0)
					end
					if o.flat then
						cf = cf * FLAT
					end
					part.CFrame = cf
				end
			end
		end
	end)
end

Request:FireServer("hello")
]]></string>
        </Properties>
        <Item class="ModuleScript" referent="15">
          <Properties>
            <string name="Name">Effects</string>
            <string name="Source"><![CDATA[-- Effects (ModuleScript, ArenaClient 아래)
-- 베기 궤적, 피해 숫자, 치명타, 필살기, 화면 흔들림, 효과음.
-- 전부 내 화면에만 그리는 효과라 다른 사람에게는 보이지 않는다.

local TweenService = game:GetService("TweenService")
local RunService = game:GetService("RunService")
local SoundService = game:GetService("SoundService")
local Debris = game:GetService("Debris")
local Lighting = game:GetService("Lighting")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local WeaponBuilder = require(ReplicatedStorage:WaitForChild("WeaponBuilder"))
local GradeStyle = require(ReplicatedStorage:WaitForChild("GradeStyle"))

local Effects = {}

local folder: Instance = workspace
local getChar: () -> (BasePart?, Humanoid?) = function()
	return nil, nil
end

local RAINBOW_COLORS = {
	Color3.fromRGB(255, 80, 80),
	Color3.fromRGB(255, 200, 60),
	Color3.fromRGB(90, 230, 110),
	Color3.fromRGB(70, 200, 255),
	Color3.fromRGB(150, 100, 255),
	Color3.fromRGB(255, 90, 200),
}

local SOUNDS = {
	slash = "rbxasset://sounds/swordslash.wav",
	lunge = "rbxasset://sounds/swordlunge.wav",
	unsheath = "rbxasset://sounds/unsheath.wav",
	ping = "rbxasset://sounds/electronicpingshort.wav",
}

function Effects.init(fxFolder: Instance, charGetter: () -> (BasePart?, Humanoid?))
	folder = fxFolder
	getChar = charGetter
end

function Effects.sound(name: string, volume: number?, pitch: number?)
	local id = SOUNDS[name]
	if not id then
		return
	end
	local s = Instance.new("Sound")
	s.SoundId = id
	s.Volume = volume or 0.5
	s.PlaybackSpeed = pitch or 1
	s.Parent = SoundService
	s:Play()
	Debris:AddItem(s, 3)
end

------------------------------------------------------------------------
-- 화면 흔들림: 카메라 오프셋을 잠깐 흔든다
------------------------------------------------------------------------
local shakePower = 0
local shakeUntil = 0
local shakeConn: RBXScriptConnection? = nil

function Effects.shake(power: number, duration: number)
	local now = os.clock()
	if now + duration > shakeUntil then
		shakeUntil = now + duration
	end
	shakePower = math.max(shakePower, power)
	if shakeConn then
		return
	end
	shakeConn = RunService.RenderStepped:Connect(function()
		local _, hum = getChar()
		local t = os.clock()
		if t >= shakeUntil then
			if hum then
				hum.CameraOffset = Vector3.zero
			end
			shakePower = 0
			if shakeConn then
				shakeConn:Disconnect()
				shakeConn = nil
			end
			return
		end
		if hum then
			local p = shakePower * math.clamp((shakeUntil - t) / 0.25, 0.2, 1)
			hum.CameraOffset = Vector3.new((math.random() - 0.5) * p, (math.random() - 0.5) * p, (math.random() - 0.5) * p)
		end
	end)
end

------------------------------------------------------------------------
-- 기본 도구
------------------------------------------------------------------------
local function fxPart(size: Vector3, cf: CFrame, color: Color3, transparency: number?, shape: Enum.PartType?): Part
	local p = Instance.new("Part")
	if shape then
		p.Shape = shape
	end
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	p.Material = Enum.Material.Neon
	p.Color = color
	p.Size = size
	p.CFrame = cf
	p.Transparency = transparency or 0.3
	p.Parent = folder
	return p
end

local function fade(p: Instance, time: number, goal: { [string]: any }?)
	local g = goal or {}
	g.Transparency = 1
	TweenService:Create(p, TweenInfo.new(time, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), g):Play()
	Debris:AddItem(p, time + 0.05)
end

-- 반달 모양 궤적. cf 기준 XZ 평면에서 0도는 앞(-Z), +각도는 오른쪽(+X)
local function arc(cf: CFrame, radius: number, fromDeg: number, toDeg: number, segs: number, width: number, color: Color3 | { Color3 }, life: number)
	for i = 0, segs - 1 do
		local a0 = math.rad(fromDeg + (toDeg - fromDeg) * i / segs)
		local a1 = math.rad(fromDeg + (toDeg - fromDeg) * (i + 1) / segs)
		local p0 = cf * Vector3.new(math.sin(a0) * radius, 0, -math.cos(a0) * radius)
		local p1 = cf * Vector3.new(math.sin(a1) * radius, 0, -math.cos(a1) * radius)
		local mid = (p0 + p1) / 2
		local len = (p1 - p0).Magnitude + 0.15
		local t = i / math.max(segs - 1, 1)
		local w = width * (1 - math.abs(t * 2 - 1) * 0.65)
		local c: Color3
		if typeof(color) == "table" then
			c = (color :: { Color3 })[(i % #(color :: { Color3 })) + 1]
		else
			c = color :: Color3
		end
		local up = cf.UpVector
		local seg = fxPart(Vector3.new(w, 0.12, len), CFrame.lookAt(mid, p1, up), c, 0.25)
		fade(seg, life + t * 0.05, { Size = Vector3.new(w * 0.2, 0.05, len) })
	end
end

function Effects.burst(pos: Vector3, color: Color3, count: number, speed: number?, size: number?, texture: string?)
	local anchor = fxPart(Vector3.new(0.2, 0.2, 0.2), CFrame.new(pos), color, 1)
	local pe = Instance.new("ParticleEmitter")
	pe.Rate = 0
	pe.Lifetime = NumberRange.new(0.25, 0.55)
	pe.Speed = NumberRange.new((speed or 20) * 0.5, speed or 20)
	pe.SpreadAngle = Vector2.new(180, 180)
	pe.Drag = 6
	pe.Size = NumberSequence.new({
		NumberSequenceKeypoint.new(0, size or 0.5),
		NumberSequenceKeypoint.new(1, 0),
	})
	pe.LightEmission = 1
	pe.Color = ColorSequence.new(color)
	if texture then
		pe.Texture = texture
		pe.RotSpeed = NumberRange.new(-200, 200)
		pe.Rotation = NumberRange.new(0, 360)
	end
	pe.Parent = anchor
	pe:Emit(count)
	Debris:AddItem(anchor, 1)
end

function Effects.flash(pos: Vector3, color: Color3, size: number, life: number?)
	local ball = fxPart(Vector3.new(1, 1, 1) * size * 0.3, CFrame.new(pos), color, 0.1, Enum.PartType.Ball)
	fade(ball, life or 0.25, { Size = Vector3.new(1, 1, 1) * size })
end

local function ring(pos: Vector3, color: Color3, fromD: number, toD: number, life: number, thickness: number?)
	local disc = fxPart(
		Vector3.new(thickness or 0.3, fromD, fromD),
		CFrame.new(pos) * CFrame.Angles(0, 0, math.rad(90)),
		color,
		0.3,
		Enum.PartType.Cylinder
	)
	fade(disc, life, { Size = Vector3.new(thickness or 0.3, toD, toD) })
end

------------------------------------------------------------------------
-- 피해 숫자. 치명타는 크게 튀어나오고 불꽃이 터진다
------------------------------------------------------------------------
local HIT_STYLE = {
	hit = { color = Color3.fromRGB(255, 248, 230), size = 24 },
	crit = { color = Color3.fromRGB(255, 170, 40), size = 34 },
	hurt = { color = Color3.fromRGB(255, 70, 70), size = 26 },
	block = { color = Color3.fromRGB(170, 185, 210), size = 18 },
	poison = { color = Color3.fromRGB(120, 255, 110), size = 20 },
	aura = { color = Color3.fromRGB(200, 160, 255), size = 21 },
	blast = { color = Color3.fromRGB(255, 140, 60), size = 23 },
	miss = { color = Color3.fromRGB(170, 170, 190), size = 18 },
}

function Effects.hits(list: { any })
	for _, h in ipairs(list) do
		local style = HIT_STYLE[h.kind] or HIT_STYLE.hit
		local isCrit = h.kind == "crit"
		local pos = h.pos + Vector3.new((math.random() - 0.5) * 2, 0, (math.random() - 0.5) * 2)
		local anchor = fxPart(Vector3.new(0.2, 0.2, 0.2), CFrame.new(pos), style.color, 1)
		local bb = Instance.new("BillboardGui")
		bb.Size = UDim2.new(0, 220, 0, 60)
		bb.AlwaysOnTop = true
		bb.LightInfluence = 0
		bb.Parent = anchor
		local label = Instance.new("TextLabel")
		label.Size = UDim2.fromScale(1, 1)
		label.BackgroundTransparency = 1
		label.Font = Enum.Font.GothamBlack
		label.TextSize = style.size
		label.TextColor3 = style.color
		label.TextStrokeTransparency = 0.1
		if h.kind == "block" then
			label.Text = "🛡" .. h.text
		elseif h.kind == "poison" then
			label.Text = "☠" .. h.text
		elseif h.kind == "aura" then
			label.Text = "✨" .. h.text
		elseif h.kind == "blast" then
			label.Text = "🔥" .. h.text
		else
			label.Text = isCrit and ("💥" .. h.text) or h.text
		end
		-- 맞을 때마다 작은 불꽃
		if h.kind == "hit" then
			Effects.burst(h.pos, h.color or Color3.fromRGB(255, 230, 180), 5, 14, 0.3)
		elseif h.kind == "poison" then
			Effects.burst(h.pos, Color3.fromRGB(120, 255, 110), 4, 6, 0.4)
		end
		label.Parent = bb
		if isCrit then
			label.TextColor3 = Color3.new(1, 1, 1)
			local g = Instance.new("UIGradient")
			g.Color = ColorSequence.new(Color3.fromRGB(255, 240, 120), Color3.fromRGB(255, 90, 30))
			g.Rotation = 90
			g.Parent = label
			local sc = Instance.new("UIScale")
			sc.Scale = 2.2
			sc.Parent = label
			TweenService:Create(sc, TweenInfo.new(0.25, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 }):Play()
			Effects.burst(h.pos, Color3.fromRGB(255, 190, 70), 18, 28, 0.6)
			Effects.flash(h.pos, Color3.fromRGB(255, 240, 200), 5, 0.2)
		end
		local info = TweenInfo.new(isCrit and 0.9 or 0.7, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
		TweenService:Create(anchor, info, { Position = pos + Vector3.new(0, isCrit and 4 or 3, 0) }):Play()
		TweenService:Create(label, TweenInfo.new(0.35, Enum.EasingStyle.Linear, Enum.EasingDirection.In, 0, false, isCrit and 0.55 or 0.35), {
			TextTransparency = 1,
			TextStrokeTransparency = 1,
		}):Play()
		Debris:AddItem(anchor, isCrit and 1 or 0.8)
	end
end

------------------------------------------------------------------------
-- 무기별 베기 궤적
------------------------------------------------------------------------
-- 속성별 덧붙임 연출. power(0~1)가 클수록 많고 크다
local function lightningBolt(target: Vector3, color: Color3, height: number, width: number)
	local top = target + Vector3.new((math.random() - 0.5) * 6, height, (math.random() - 0.5) * 6)
	local prev = top
	local segs = 7
	for i = 1, segs do
		local t = i / segs
		local p = top:Lerp(target, t)
		if i < segs then
			p += Vector3.new((math.random() - 0.5) * 3, 0, (math.random() - 0.5) * 3)
		end
		local mid = (prev + p) / 2
		local len = (p - prev).Magnitude
		local seg = fxPart(Vector3.new(width, width, len), CFrame.lookAt(mid, p), (i % 2 == 0) and Color3.new(1, 1, 1) or color, 0)
		fade(seg, 0.18)
		prev = p
	end
	Effects.flash(target, color, 4, 0.15)
end

local function flyingBits(origin: Vector3, color: Color3, count: number, size: Vector3, material: Enum.Material, speed: number, life: number, gravity: boolean)
	for _ = 1, count do
		local dir = Vector3.new(math.random() - 0.5, math.random() * 0.8, math.random() - 0.5).Unit
		local bit = fxPart(size, CFrame.new(origin) * CFrame.Angles(math.random() * 6, math.random() * 6, math.random() * 6), color, 0.05)
		bit.Material = material
		local goal = origin + dir * speed * life + (gravity and Vector3.new(0, -6, 0) or Vector3.zero)
		TweenService:Create(bit, TweenInfo.new(life, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
			Position = goal,
			Orientation = Vector3.new(math.random(-360, 360), math.random(-360, 360), 0),
			Transparency = 1,
			Size = size * 0.3,
		}):Play()
		Debris:AddItem(bit, life + 0.05)
	end
end

local motifFx: { [string]: (any, Vector3, CFrame, number) -> () } = {}

motifFx.flame = function(style, hit, _cf, p)
	Effects.burst(hit, style.primary, 10 + math.floor(p * 30), 18, 1 + p * 1.5, style.motif.tex)
	for i = 1, 1 + math.floor(p * 3) do
		local pos = hit + Vector3.new((math.random() - 0.5) * 4, -2, (math.random() - 0.5) * 4)
		local pillar = fxPart(Vector3.new(4 + p * 6, 1, 1), CFrame.new(pos + Vector3.new(0, 2, 0)) * CFrame.Angles(0, 0, math.rad(90)), (i % 2 == 0) and style.secondary or style.primary, 0.2, Enum.PartType.Cylinder)
		fade(pillar, 0.35, { Size = Vector3.new(8 + p * 8, 0.1, 0.1), Position = pos + Vector3.new(0, 5, 0) })
	end
end

motifFx.frost = function(style, hit, _cf, p)
	flyingBits(hit, style.glow, 5 + math.floor(p * 14), Vector3.new(0.25, 0.9, 0.25) * (1 + p), Enum.Material.Glass, 14, 0.4, false)
	ring(hit - Vector3.new(0, 2.4, 0), Color3.fromRGB(220, 245, 255), 1, 6 + p * 8, 0.35, 0.2)
end

motifFx.storm = function(style, hit, _cf, p)
	for _ = 1, 1 + math.floor(p * 3) do
		lightningBolt(hit + Vector3.new((math.random() - 0.5) * 4, -1, (math.random() - 0.5) * 4), style.primary, 18 + p * 20, 0.25 + p * 0.3)
	end
	if p > 0.3 then
		Effects.shake(0.15 + p * 0.3, 0.1)
	end
end

motifFx.nature = function(style, hit, _cf, p)
	flyingBits(hit, style.primary, 6 + math.floor(p * 14), Vector3.new(0.5, 0.06, 0.35) * (1 + p), Enum.Material.Neon, 10, 0.7, true)
	Effects.burst(hit, style.secondary, 8 + math.floor(p * 12), 8, 0.5 + p)
end

motifFx.shadow = function(style, hit, _cf, p)
	Effects.burst(hit, style.primary, 12 + math.floor(p * 20), 8, 1.5 + p * 2, style.motif.tex)
	Effects.flash(hit, style.secondary, 3 + p * 4, 0.2)
end

motifFx.holy = function(style, hit, _cf, p)
	local pillar = fxPart(Vector3.new(30, 2 + p * 3, 2 + p * 3), CFrame.new(hit + Vector3.new(0, 13, 0)) * CFrame.Angles(0, 0, math.rad(90)), Color3.new(1, 1, 1), 0.2, Enum.PartType.Cylinder)
	fade(pillar, 0.35, { Size = Vector3.new(30, 0.1, 0.1) })
	Effects.burst(hit, style.glow, 10 + math.floor(p * 20), 16, 0.6 + p)
	ring(hit - Vector3.new(0, 2.4, 0), style.glow, 2, 8 + p * 10, 0.4, 0.2)
end

motifFx.blood = function(style, hit, _cf, p)
	flyingBits(hit, style.primary, 6 + math.floor(p * 16), Vector3.new(0.3, 0.3, 0.3) * (1 + p), Enum.Material.Neon, 9, 0.5, true)
	arc(CFrame.new(hit) * CFrame.Angles(0, math.random() * 6, math.rad(70)), 2.5 + p * 2, -70, 70, 7, 0.4 + p * 0.5, style.secondary, 0.2)
end

motifFx.void = function(style, hit, _cf, p)
	local sphere = fxPart(Vector3.new(6, 6, 6) * (1 + p), CFrame.new(hit), Color3.fromRGB(10, 0, 20), 0.2, Enum.PartType.Ball)
	sphere.Material = Enum.Material.ForceField
	sphere.Color = style.secondary
	fade(sphere, 0.3, { Size = Vector3.new(0.3, 0.3, 0.3) })
	ring(hit, style.secondary, 10 + p * 10, 1, 0.3, 0.3)
	Effects.burst(hit, style.primary, 10 + math.floor(p * 16), 6, 1.2 + p, style.motif.tex)
end

motifFx.star = function(style, hit, _cf, p)
	flyingBits(hit, Color3.new(1, 1, 1), 5 + math.floor(p * 12), Vector3.new(0.35, 0.35, 0.35) * (1 + p), Enum.Material.Neon, 16, 0.35, false)
	Effects.burst(hit, style.glow, 14 + math.floor(p * 20), 22, 0.4 + p * 0.5)
end

motifFx.crystal = function(style, hit, _cf, p)
	local n = 6 + math.floor(p * 8)
	for i = 1, n do
		local a = (i / n) * math.pi * 2
		local pos = hit + Vector3.new(math.cos(a), 0, math.sin(a)) * (2 + p * 2)
		local shard = fxPart(Vector3.new(0.4, 1.6 + p * 1.5, 0.4), CFrame.new(pos) * CFrame.Angles(0, -a, math.rad(25)), (i % 2 == 0) and style.secondary or style.glow, 0.1)
		shard.Material = Enum.Material.Glass
		fade(shard, 0.4, { Position = pos + Vector3.new(math.cos(a), 0.6, math.sin(a)) * 2 })
	end
end

-- 무기별 베기 궤적. 등급마다 색, 겹 수, 굵기, 속성 연출이 다르다
function Effects.swing(data: any)
	local root = getChar()
	if not root then
		return
	end
	local g = data.grade or 1
	local style = GradeStyle.get(g)
	local p = style.power
	local colors: { Color3 } = style.rainbow and RAINBOW_COLORS or { style.glow, style.secondary, style.primary }
	local plain: Color3 = style.glow
	local w = 1 + p * 1.6
	local layers = 1 + g // 25
	local life = 0.18 + p * 0.12
	local cf = root.CFrame * CFrame.new(0, 0.4, 0)
	local look = root.CFrame.LookVector
	local t = data.typeId
	local hit = root.Position + look * math.min(data.range * 0.6, 6)

	local function layered(baseCf: CFrame, radius: number, from: number, to: number, segs: number, width: number)
		for L = 0, layers - 1 do
			local extra = CFrame.Angles(0, math.rad(L * 9), math.rad(L * 7))
			local c: Color3 | { Color3 } = colors
			if L > 0 then
				c = colors[(L % #colors) + 1]
			end
			arc(baseCf * extra, radius * (1 + L * 0.14), from, to, segs, width * (1 - L * 0.15), c, life + L * 0.05)
		end
	end

	if t == 1 then
		layered(cf * CFrame.Angles(0, 0, math.rad(90)), data.range * 0.6, -85, 85, 14, 1.5 * w)
		Effects.burst(root.Position + look * data.range * 0.6 - Vector3.new(0, 2.8, 0), Color3.fromRGB(210, 185, 140), 14, 18, 0.9)
		Effects.shake(0.25 + p * 0.3, 0.12)
		Effects.sound("slash", 0.55, 0.8)
	elseif t == 2 then
		layered(cf * CFrame.Angles(0, 0, math.rad(35)), 4.5, -70, 70, 10, 0.6 * w)
		layered(cf * CFrame.Angles(0, 0, math.rad(-35)), 4.5, 70, -70, 10, 0.6 * w)
		Effects.sound("slash", 0.35, 1.35)
	elseif t == 3 then
		local beam = fxPart(Vector3.new(0.4 * w, 0.4 * w, data.range), cf * CFrame.new(0, 0, -data.range / 2), plain, 0.05)
		fade(beam, 0.2, { Size = Vector3.new(0.05, 0.05, data.range * 1.15) })
		if g >= 30 then
			local outer = fxPart(Vector3.new(1.4 * w, 1.4 * w, data.range), cf * CFrame.new(0, 0, -data.range / 2), style.secondary, 0.55)
			fade(outer, 0.18)
		end
		layered(cf, data.range * 0.85, -22, 22, 7, 0.5 * w)
		Effects.flash(root.Position + look * data.range, plain, 2.5 * w, 0.15)
		Effects.sound("lunge", 0.4, 1.1)
	elseif t == 4 then
		layered(cf * CFrame.Angles(0, 0, math.rad(15)), 3.2, -80, 60, 8, 0.5 * w)
		layered(cf * CFrame.Angles(0, 0, math.rad(-20)), 3.6, 60, -80, 8, 0.4 * w)
		Effects.sound("slash", 0.3, 1.6)
	elseif t == 5 then
		layered(cf * CFrame.new(0, -0.6, 0), data.range * 0.85, 0, 360, 20, 1.0 * w)
		for _ = 1, 3 + math.floor(p * 6) do
			local pos = root.Position + Vector3.new((math.random() - 0.5) * 8, -1, (math.random() - 0.5) * 8)
			local wisp = fxPart(Vector3.new(0.5, 0.5, 0.5) * (1 + p), CFrame.new(pos), style.glow, 0.2, Enum.PartType.Ball)
			fade(wisp, 0.6, { Position = pos + Vector3.new(0, 4 + p * 4, 0) })
		end
		hit = root.Position
		Effects.sound("slash", 0.45, 0.65)
	else
		layered(cf * CFrame.new(0, -0.6, 0), data.range * 0.85, 0, 360, 22, 1.2 * w)
		layered(cf * CFrame.Angles(0, 0, math.rad(90)), data.range * 0.6, -85, 85, 14, 1.5 * w)
		Effects.shake(0.3, 0.1)
		Effects.sound("lunge", 0.5, 0.9)
		hit = root.Position
	end

	-- 등급의 속성 연출
	local fx = motifFx[style.motif.id]
	if fx and g >= 2 then
		fx(style, hit, cf, p)
	end
	-- 높은 등급일수록 더 얹는다
	Effects.burst(hit, plain, 4 + math.floor(p * 20), 14 + p * 14, 0.3 + p * 0.5, style.motif.tex)
	if g >= 40 then
		ring(root.Position - Vector3.new(0, 2.7, 0), style.secondary, 2, 8 + p * 16, 0.3, 0.2)
	end
	if g >= 60 then
		Effects.shake(0.1 + p * 0.15, 0.06)
	end
	if g >= 80 then
		local beam = fxPart(Vector3.new(40, 1.5 + p, 1.5 + p), CFrame.new(hit + Vector3.new(0, 18, 0)) * CFrame.Angles(0, 0, math.rad(90)), style.glow, 0.3, Enum.PartType.Cylinder)
		fade(beam, 0.3, { Size = Vector3.new(40, 0.1, 0.1) })
	end
	if data.crit then
		Effects.flash(hit, Color3.new(1, 1, 1), 6 + p * 8, 0.18)
		ring(hit, style.glow, 1, 10 + p * 12, 0.25, 0.3)
		Effects.sound("lunge", 0.6, 1.3)
		Effects.shake(0.35 + p * 0.4, 0.15)
	end
end

------------------------------------------------------------------------
-- 보스 내려찍기 착지
------------------------------------------------------------------------
function Effects.slam(data: any)
	ring(data.pos + Vector3.new(0, 0.3, 0), Color3.fromRGB(255, 90, 50), 4, data.radius * 2.3, 0.4, 0.5)
	Effects.burst(data.pos + Vector3.new(0, 1, 0), Color3.fromRGB(200, 170, 130), 30, 30, 1.2)
	local root = getChar()
	if root and (root.Position - data.pos).Magnitude < 40 then
		Effects.shake(0.9, 0.35)
	end
	Effects.sound("lunge", 0.7, 0.5)
end

------------------------------------------------------------------------
-- 필살기
------------------------------------------------------------------------
function Effects.ultimate(data: any)
	local root = getChar()
	local color: Color3 = data.color or Color3.new(1, 1, 1)
	local origin: Vector3 = data.origin
	local look: Vector3 = data.look
	local floorY = origin.Y - 2.9
	local t = data.typeId

	if t == 1 then
		-- 대지 가르기: 땅이 앞으로 쭉 갈라진다
		local n = 14
		local step = data.length / n
		for i = 1, n do
			task.delay(i * 0.018, function()
				local p = Vector3.new(origin.X, floorY, origin.Z) + look * (step * (i - 0.5))
				local crack = fxPart(Vector3.new(1.8, 0.3, step + 0.4), CFrame.lookAt(p, p + look), Color3.fromRGB(255, 120, 40), 0)
				fade(crack, 0.9, { Size = Vector3.new(0.4, 0.3, step + 0.4) })
				Effects.burst(p + Vector3.new(0, 1, 0), Color3.fromRGB(190, 160, 120), 6, 22, 1)
				local pillar = fxPart(Vector3.new(1.2, 6, 1.2), CFrame.new(p + Vector3.new(0, 3, 0)), color, 0.3)
				fade(pillar, 0.4, { Size = Vector3.new(0.2, 12, 0.2) })
			end)
		end
		task.delay(0.28, function()
			ring(Vector3.new(origin.X, floorY + 0.3, origin.Z) + look * data.length, color, 4, 26, 0.5)
		end)
		Effects.shake(1.2, 0.5)
		Effects.sound("lunge", 0.9, 0.55)
	elseif t == 2 then
		-- 칼날 폭풍: 내 주위를 칼날이 돌고 계속 베어 낸다
		local blades = {}
		for i = 1, 6 do
			blades[i] = fxPart(Vector3.new(0.4, 0.2, 4.5), CFrame.new(origin), color, 0.1)
		end
		local start = os.clock()
		local conn: RBXScriptConnection
		local lastArc = 0
		conn = RunService.Heartbeat:Connect(function()
			local r = getChar()
			local el = os.clock() - start
			if not r or el > data.duration then
				conn:Disconnect()
				for _, b in ipairs(blades) do
					fade(b, 0.2)
				end
				return
			end
			for i, b in ipairs(blades) do
				local a = el * 9 + i * (math.pi * 2 / 6)
				local p = r.Position + Vector3.new(math.cos(a) * data.radius * 0.6, 0.3 + math.sin(el * 6 + i) * 0.6, math.sin(a) * data.radius * 0.6)
				b.CFrame = CFrame.lookAt(p, p + Vector3.new(-math.sin(a), 0, math.cos(a)))
			end
			if el - lastArc > 0.15 then
				lastArc = el
				arc(r.CFrame * CFrame.Angles(0, math.random() * math.pi * 2, math.rad(math.random(-30, 30))), data.radius * 0.8, -60, 60, 8, 0.8, color, 0.15)
			end
		end)
		Effects.shake(0.25, data.duration)
		for i = 0, 4 do
			task.delay(i * 0.5, function()
				Effects.sound("slash", 0.4, 1.2 + i * 0.05)
			end)
		end
	elseif t == 3 then
		-- 일섬: 지나간 자리에 빛줄기
		local target: Vector3 = data.target
		local dist = (target - origin).Magnitude
		local mid = (origin + target) / 2
		local beam = fxPart(Vector3.new(1.2, 1.2, dist), CFrame.lookAt(mid, target), Color3.new(1, 1, 1), 0)
		fade(beam, 0.5, { Size = Vector3.new(0.1, 0.1, dist) })
		local glow = fxPart(Vector3.new(3, 3, dist), CFrame.lookAt(mid, target), color, 0.5)
		fade(glow, 0.35)
		Effects.flash(target, color, 10, 0.3)
		Effects.burst(target, color, 30, 35, 0.6)
		Effects.shake(0.8, 0.3)
		Effects.sound("lunge", 0.9, 1.0)
	elseif t == 4 then
		-- 그림자 처형: 연기 속에서 X자 베기 다섯 번
		local target: Vector3 = data.target or origin
		Effects.burst(origin, Color3.fromRGB(40, 20, 60), 30, 12, 1.6)
		for i = 0, 4 do
			task.delay(0.05 + i * 0.12, function()
				local cf = CFrame.lookAt(target + Vector3.new(0, 1, 0), target + Vector3.new(0, 1, 0) + look) * CFrame.Angles(0, math.rad(90), 0)
				local tilt = (i % 2 == 0) and 40 or -40
				arc(cf * CFrame.Angles(0, 0, math.rad(90 + tilt)), 4, -70, 70, 9, 0.9, Color3.fromRGB(190, 90, 255), 0.18)
				Effects.burst(target + Vector3.new(0, 1, 0), Color3.fromRGB(160, 60, 255), 10, 25, 0.4)
				Effects.shake(0.45, 0.1)
				Effects.sound("slash", 0.5, 1.4 + i * 0.08)
			end)
		end
	elseif t == 5 then
		-- 영혼 수확: 넓은 원이 퍼지고, 영혼이 나에게 빨려 든다
		ring(Vector3.new(origin.X, floorY + 0.4, origin.Z), Color3.fromRGB(120, 255, 190), 4, data.radius * 2, 0.5, 0.5)
		arc(CFrame.new(origin) , data.radius * 0.9, 0, 360, 24, 1.6, color, 0.35)
		for _, v in ipairs(data.victims or {}) do
			local wisp = fxPart(Vector3.new(0.8, 0.8, 0.8), CFrame.new(v), Color3.fromRGB(150, 255, 200), 0.1, Enum.PartType.Ball)
			task.delay(0.3, function()
				local r = getChar()
				local goal = r and r.Position or origin
				TweenService:Create(wisp, TweenInfo.new(0.45, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { Position = goal }):Play()
				Debris:AddItem(wisp, 0.5)
			end)
		end
		task.delay(0.75, function()
			local r = getChar()
			if r then
				Effects.burst(r.Position, Color3.fromRGB(120, 255, 160), 25, 10, 0.6)
			end
		end)
		Effects.shake(0.5, 0.3)
		Effects.sound("lunge", 0.7, 0.7)
	else
		-- 천지개벽: 하늘까지 닿는 무지개 기둥과 투기장 전체 충격파
		for i, c in ipairs(RAINBOW_COLORS) do
			task.delay(i * 0.04, function()
				local pillar = fxPart(Vector3.new(160, 10 - i, 10 - i), CFrame.new(origin + Vector3.new(0, 78, 0)) * CFrame.Angles(0, 0, math.rad(90)), c, 0.3, Enum.PartType.Cylinder)
				fade(pillar, 0.8, { Size = Vector3.new(160, 1, 1) })
			end)
		end
		task.delay(0.35, function()
			ring(Vector3.new(origin.X, floorY + 0.4, origin.Z), Color3.new(1, 1, 1), 6, (data.radius or 60) * 2, 0.6, 0.6)
		end)
		Effects.shake(1.5, 0.7)
		Effects.sound("lunge", 1, 0.45)
	end
	if root then
		Effects.flash(root.Position, color, 6, 0.3)
	end
end

------------------------------------------------------------------------
-- 움직이는 물체: 매 프레임 위치를 정해 주는 함수를 받아 일정 시간 돌린다
------------------------------------------------------------------------
local function animate(duration: number, step: (number) -> (), done: (() -> ())?)
	local start = os.clock()
	local conn: RBXScriptConnection
	conn = RunService.RenderStepped:Connect(function()
		local t = (os.clock() - start) / duration
		if t >= 1 then
			conn:Disconnect()
			step(1)
			if done then
				done()
			end
			return
		end
		step(t)
	end)
end

local function addTrail(p: BasePart, color: Color3, width: number, life: number)
	local a0 = Instance.new("Attachment")
	a0.Position = Vector3.new(0, width / 2, 0)
	a0.Parent = p
	local a1 = Instance.new("Attachment")
	a1.Position = Vector3.new(0, -width / 2, 0)
	a1.Parent = p
	local tr = Instance.new("Trail")
	tr.Attachment0 = a0
	tr.Attachment1 = a1
	tr.Lifetime = life
	tr.LightEmission = 1
	tr.Color = ColorSequence.new(color)
	tr.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.2), NumberSequenceKeypoint.new(1, 1) })
	tr.Parent = p
end

local function floorOf(pos: Vector3): Vector3
	local root = getChar()
	local y = root and (root.Position.Y - 2.9) or pos.Y
	return Vector3.new(pos.X, y, pos.Z)
end

------------------------------------------------------------------------
-- 바닥 경고: 서버가 띄운 빨간 경고 안에서 밝은 원이 차오른다 (언제 터지는지 보인다)
------------------------------------------------------------------------
function Effects.warningFill(warn: BasePart)
	local duration = warn:GetAttribute("Warn")
	if type(duration) ~= "number" or duration <= 0 then
		return
	end
	local isDisc = warn:IsA("Part") and (warn :: Part).Shape == Enum.PartType.Cylinder
	local fill = fxPart(isDisc and Vector3.new(warn.Size.X + 0.05, 0.1, 0.1) or Vector3.new(warn.Size.X, warn.Size.Y + 0.05, 0.1), warn.CFrame, Color3.fromRGB(255, 120, 60), 0.35, isDisc and Enum.PartType.Cylinder or nil)
	if isDisc then
		TweenService:Create(fill, TweenInfo.new(duration, Enum.EasingStyle.Linear), { Size = Vector3.new(warn.Size.X + 0.05, warn.Size.Y, warn.Size.Z) }):Play()
	else
		-- 길 경고는 시작점에서 끝까지 차오른다
		local length = warn.Size.Z
		local back = warn.CFrame * CFrame.new(0, 0, length / 2)
		animate(duration, function(t)
			if fill.Parent then
				fill.Size = Vector3.new(warn.Size.X, warn.Size.Y + 0.05, math.max(0.1, length * t))
				fill.CFrame = back * CFrame.new(0, 0, -length * t / 2)
			end
		end)
	end
	Debris:AddItem(fill, duration)
	-- 테두리
	if isDisc then
		ring(warn.Position + Vector3.new(0, 0.1, 0), Color3.fromRGB(255, 60, 40), warn.Size.Y, warn.Size.Y * 1.02, duration, 0.3)
	end
end

------------------------------------------------------------------------
-- 적의 공격
------------------------------------------------------------------------
function Effects.projectile(data: any)
	local color: Color3 = data.color or Color3.fromRGB(255, 120, 80)
	local from: Vector3 = data.from
	local dir: Vector3 = data.dir
	local arrow = fxPart(Vector3.new(0.25, 0.25, 2.8), CFrame.lookAt(from, from + dir), color, 0)
	addTrail(arrow, color, 0.5, 0.25)
	local head = fxPart(Vector3.new(0.6, 0.6, 0.6), arrow.CFrame * CFrame.new(0, 0, -1.4), Color3.new(1, 1, 1), 0, Enum.PartType.Ball)
	animate(data.range / data.speed, function(t)
		local p = from + dir * (data.range * t)
		arrow.CFrame = CFrame.lookAt(p, p + dir)
		head.CFrame = arrow.CFrame * CFrame.new(0, 0, -1.4)
	end, function()
		fade(arrow, 0.1)
		fade(head, 0.1)
	end)
	Effects.sound("slash", 0.25, 1.8)
end

function Effects.explode(data: any)
	local pos: Vector3 = data.pos
	local r: number = data.radius or 8
	Effects.flash(pos, Color3.fromRGB(255, 200, 80), r * 1.6, 0.35)
	Effects.flash(pos, Color3.fromRGB(255, 80, 30), r * 2.2, 0.5)
	ring(floorOf(pos) + Vector3.new(0, 0.2, 0), Color3.fromRGB(255, 120, 40), 2, r * 2.4, 0.45, 0.5)
	Effects.burst(pos, Color3.fromRGB(255, 150, 50), 40, 40, 1)
	Effects.burst(pos, Color3.fromRGB(60, 50, 50), 20, 12, 2)
	local root = getChar()
	if root and (root.Position - pos).Magnitude < 30 then
		Effects.shake(1.0, 0.35)
	end
	Effects.sound("lunge", 0.8, 0.4)
end

function Effects.flame(data: any)
	local base = floorOf(data.pos)
	local r: number = data.radius or 7
	local pillarPart = fxPart(Vector3.new(16, r * 1.4, r * 1.4), CFrame.new(base + Vector3.new(0, 8, 0)) * CFrame.Angles(0, 0, math.rad(90)), Color3.fromRGB(190, 90, 255), 0.2, Enum.PartType.Cylinder)
	fade(pillarPart, 0.6, { Size = Vector3.new(26, r * 0.3, r * 0.3) })
	ring(base + Vector3.new(0, 0.2, 0), Color3.fromRGB(220, 120, 255), r * 1.2, r * 2.6, 0.5, 0.4)
	Effects.burst(base + Vector3.new(0, 2, 0), Color3.fromRGB(230, 140, 255), 25, 25, 0.8)
	Effects.sound("lunge", 0.5, 0.8)
end

function Effects.meteor(data: any)
	local target = floorOf(data.pos)
	local start = target + Vector3.new(14, 70, -8)
	local rock = fxPart(Vector3.new(3, 3, 3), CFrame.new(start), Color3.fromRGB(255, 90, 30), 0, Enum.PartType.Ball)
	rock.Material = Enum.Material.Neon
	addTrail(rock, Color3.fromRGB(255, 140, 40), 2.5, 0.35)
	animate(0.25, function(t)
		rock.CFrame = CFrame.new(start:Lerp(target, t))
	end, function()
		fade(rock, 0.05)
		Effects.explode({ pos = target + Vector3.new(0, 1, 0), radius = data.radius or 6 })
	end)
end

function Effects.spinFx(data: any)
	local cf = CFrame.new(data.pos)
	arc(cf, data.radius * 0.9, 0, 360, 20, 2.2, Color3.fromRGB(255, 200, 70), 0.3)
	arc(cf * CFrame.new(0, 1.5, 0), data.radius * 0.7, 0, 360, 16, 1.4, Color3.fromRGB(255, 120, 40), 0.3)
	Effects.sound("slash", 0.45, 0.6)
end

function Effects.summonFx(data: any)
	local base: Vector3 = data.pos
	ring(base + Vector3.new(0, 0.2, 0), Color3.fromRGB(170, 80, 255), 1, 9, 0.7, 0.4)
	local beam = fxPart(Vector3.new(30, 4, 4), CFrame.new(base + Vector3.new(0, 15, 0)) * CFrame.Angles(0, 0, math.rad(90)), Color3.fromRGB(190, 110, 255), 0.3, Enum.PartType.Cylinder)
	fade(beam, 0.6, { Size = Vector3.new(30, 0.2, 0.2) })
	Effects.burst(base + Vector3.new(0, 1, 0), Color3.fromRGB(200, 140, 255), 18, 14, 0.6)
end

function Effects.blink(data: any)
	for _, p in ipairs({ data.from, data.to }) do
		Effects.burst(p, Color3.fromRGB(40, 20, 50), 26, 10, 1.6)
		Effects.flash(p, Color3.fromRGB(150, 50, 200), 5, 0.25)
	end
	Effects.sound("slash", 0.4, 2)
end

function Effects.dust(data: any)
	Effects.burst(floorOf(data.pos) + Vector3.new(0, 1, 0), Color3.fromRGB(200, 175, 135), 24, 22, 1.4)
	Effects.shake(0.5, 0.2)
end

-- 적이 쓰러질 때: 몸이 터지고 영혼이 하늘로, 보스는 거대한 빛기둥
function Effects.kill(data: any)
	local pos: Vector3 = data.pos
	local color: Color3 = data.color or Color3.new(1, 1, 1)
	local scale: number = data.scale or 1
	Effects.flash(pos, color, 6 * scale, 0.3)
	Effects.burst(pos, color, 22, 26, 0.7 * scale)
	Effects.burst(pos, Color3.fromRGB(255, 215, 90), 8, 12, 0.4)
	ring(floorOf(pos) + Vector3.new(0, 0.25, 0), color, 2, 10 * scale, 0.4, 0.3)
	local soul = fxPart(Vector3.new(1, 1, 1) * scale, CFrame.new(pos), color:Lerp(Color3.new(1, 1, 1), 0.5), 0.1, Enum.PartType.Ball)
	addTrail(soul, color, 0.8 * scale, 0.4)
	TweenService:Create(soul, TweenInfo.new(0.9, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { Position = pos + Vector3.new(0, 14, 0), Transparency = 1, Size = Vector3.new(0.2, 0.2, 0.2) }):Play()
	Debris:AddItem(soul, 1)
	if data.boss then
		local beam = fxPart(Vector3.new(200, 12, 12), CFrame.new(pos + Vector3.new(0, 100, 0)) * CFrame.Angles(0, 0, math.rad(90)), Color3.fromRGB(255, 230, 150), 0.1, Enum.PartType.Cylinder)
		fade(beam, 1.4, { Size = Vector3.new(200, 0.5, 0.5) })
		for i = 0, 4 do
			task.delay(i * 0.12, function()
				Effects.explode({ pos = pos + Vector3.new((math.random() - 0.5) * 8, math.random() * 4, (math.random() - 0.5) * 8), radius = 6 })
			end)
		end
		Effects.shake(1.6, 0.8)
	else
		Effects.shake(0.15, 0.08)
		Effects.sound("ping", 0.25, 1.6 + math.random() * 0.3)
	end
end

-- 대시 잔상: 내 몸 모양 그대로 빛나는 껍데기를 남긴다
function Effects.afterimage(char: Model, color: Color3)
	for _, d in ipairs(char:GetChildren()) do
		if d:IsA("BasePart") and d.Name ~= "HumanoidRootPart" and d.Transparency < 1 then
			local ghost = fxPart(d.Size, d.CFrame, color, 0.55)
			ghost.Material = Enum.Material.ForceField
			fade(ghost, 0.35)
		end
	end
end

-- 전투 시작: 내 자리에 빛기둥이 떨어진다
function Effects.battleStart(data: any)
	local base = Vector3.new(data.pos.X, data.pos.Y, data.pos.Z)
	local beam = fxPart(Vector3.new(120, 9, 9), CFrame.new(base + Vector3.new(0, 60, 0)) * CFrame.Angles(0, 0, math.rad(90)), data.color, 0.1, Enum.PartType.Cylinder)
	fade(beam, 0.8, { Size = Vector3.new(120, 0.5, 0.5) })
	ring(base + Vector3.new(0, 0.3, 0), data.color, 4, 50, 0.7, 0.4)
	Effects.burst(base + Vector3.new(0, 2, 0), data.color, 40, 40, 1)
	Effects.shake(0.6, 0.3)
	Effects.sound("lunge", 0.7, 0.6)
end

------------------------------------------------------------------------
-- 로비 합성 용광로
------------------------------------------------------------------------
function Effects.forge(data: any)
	local lobby = workspace:FindFirstChild("Lobby")
	local forge = lobby and lobby:FindFirstChild("Forge")
	if not forge then
		return
	end
	local color: Color3 = data.color or Color3.fromRGB(255, 160, 60)
	local mouth = forge:FindFirstChild("ForgeMouth")
	local anvil = forge:FindFirstChild("ForgeAnvil")
	local lava = forge:FindFirstChild("ForgeLava")
	local liquid = forge:FindFirstChild("ForgeLiquid")
	local ringPart = forge:FindFirstChild("ForgeRing")
	if mouth and mouth:IsA("BasePart") then
		Effects.flash(mouth.Position, color, 9, 0.4)
		local glow = mouth:FindFirstChild("ForgeGlow")
		if glow and glow:IsA("PointLight") then
			glow.Brightness = 12
			glow.Color = color
			TweenService:Create(glow, TweenInfo.new(1.2), { Brightness = 3, Color = Color3.fromRGB(255, 140, 50) }):Play()
		end
		local embers = mouth:FindFirstChild("Embers")
		if embers and embers:IsA("ParticleEmitter") then
			embers:Emit(50)
		end
	end
	if anvil and anvil:IsA("BasePart") then
		local top = anvil.Position + Vector3.new(0, 0.6, 0)
		Effects.burst(top, color, 40, 30, 0.5)
		Effects.burst(top, Color3.fromRGB(255, 230, 150), 25, 22, 0.3)
		local beam = fxPart(Vector3.new(30, 2.2, 2.2), CFrame.new(top + Vector3.new(0, 15, 0)) * CFrame.Angles(0, 0, math.rad(90)), color, 0.2, Enum.PartType.Cylinder)
		fade(beam, data.legendary and 1.2 or 0.6, { Size = Vector3.new(30, 0.2, 0.2) })
		if data.legendary then
			ring(top - Vector3.new(0, 2.5, 0), color, 2, 26, 0.9, 0.3)
		end
	end
	if lava and lava:IsA("BasePart") then
		Effects.burst(lava.Position + Vector3.new(0, 1, 0), Color3.fromRGB(255, 140, 40), 30, 26, 0.6)
	end
	if liquid and liquid:IsA("BasePart") then
		local old = liquid.Color
		liquid.Color = color
		TweenService:Create(liquid, TweenInfo.new(1.5), { Color = old }):Play()
	end
	if ringPart and ringPart:IsA("BasePart") then
		ringPart.Color = color
		ringPart.Transparency = 0
		TweenService:Create(ringPart, TweenInfo.new(1.2), { Transparency = 0.4, Color = Color3.fromRGB(222, 178, 72) }):Play()
	end
	local root = getChar()
	if root and anvil and anvil:IsA("BasePart") and (root.Position - anvil.Position).Magnitude < 40 then
		Effects.shake(0.3, 0.2)
		Effects.sound("lunge", 0.7, 0.7)
		Effects.sound("ping", 0.5, 1.4)
	end
end

------------------------------------------------------------------------
-- 타격감: 맞은 자리에서 내 반대쪽으로 튀는 불꽃과 베인 자국
------------------------------------------------------------------------
function Effects.impact(h: any, heavy: number)
	local pos: Vector3 = h.pos
	local from: Vector3 = h.from or pos
	local away = Vector3.new(pos.X - from.X, 0, pos.Z - from.Z)
	away = away.Magnitude > 0.01 and away.Unit or Vector3.new(0, 0, -1)
	local color: Color3 = h.color or Color3.fromRGB(255, 230, 180)
	local crit = h.kind == "crit"
	-- 방향 있는 불꽃 줄기
	local n = crit and 9 or 5
	for _ = 1, n do
		local dir = (away + Vector3.new((math.random() - 0.5) * 1.4, math.random() * 0.9, (math.random() - 0.5) * 1.4)).Unit
		local len = (crit and 2.2 or 1.3) * (0.6 + math.random() * 0.8)
		local spark = fxPart(Vector3.new(0.12, 0.12, len), CFrame.lookAt(pos, pos + dir) * CFrame.new(0, 0, -len / 2), (math.random() < 0.5) and Color3.new(1, 1, 1) or color, 0.05)
		local goal = pos + dir * (crit and 7 or 4.5) * heavy
		TweenService:Create(spark, TweenInfo.new(0.16, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
			CFrame = CFrame.lookAt(goal, goal + dir),
			Size = Vector3.new(0.04, 0.04, len * 0.3),
			Transparency = 1,
		}):Play()
		Debris:AddItem(spark, 0.18)
	end
	-- 베인 자국: X자로 번쩍
	local cam = workspace.CurrentCamera
	local face = cam and (cam.CFrame.Position - pos).Unit or -away
	local baseCf = CFrame.lookAt(pos, pos + face)
	local size = (crit and 4.2 or 2.6) * heavy
	for _, tilt in ipairs({ 40, -40 }) do
		local slash = fxPart(Vector3.new(0.18, size, 0.05), baseCf * CFrame.Angles(0, 0, math.rad(tilt + math.random(-10, 10))), crit and Color3.new(1, 1, 1) or color:Lerp(Color3.new(1, 1, 1), 0.5), 0)
		TweenService:Create(slash, TweenInfo.new(0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Size = Vector3.new(0.02, size * 1.3, 0.02), Transparency = 1 }):Play()
		Debris:AddItem(slash, 0.14)
	end
	-- 작은 충격 고리
	if crit or heavy > 1.2 then
		ring(pos, color, 0.5, (crit and 6 or 4) * heavy, 0.18, 0.15)
	end
end

-- 맞은 적이 하얗게 번쩍인다
function Effects.hitFlash(target: Instance?, crit: boolean)
	if not target or not target.Parent then
		return
	end
	local model = target :: Instance
	local h = Instance.new("Highlight")
	h.FillColor = crit and Color3.fromRGB(255, 240, 160) or Color3.new(1, 1, 1)
	h.FillTransparency = 0.15
	h.OutlineColor = Color3.new(1, 1, 1)
	h.OutlineTransparency = 0.3
	h.DepthMode = Enum.HighlightDepthMode.Occluded
	h.Parent = model
	TweenService:Create(h, TweenInfo.new(crit and 0.14 or 0.09), { FillTransparency = 1, OutlineTransparency = 1 }):Play()
	Debris:AddItem(h, crit and 0.15 or 0.1)
end

-- 처치: 적의 몸이 조각나서 사방으로 흩어진다
function Effects.shatter(target: Instance?, color: Color3)
	if not target or not target:IsA("Model") then
		return
	end
	local model = target :: Model
	local count = 0
	for _, d in ipairs(model:GetChildren()) do
		if d:IsA("BasePart") and d.Name ~= "HumanoidRootPart" and count < 16 then
			count += 1
			local center = d.Position
			d.LocalTransparencyModifier = 1
			for k = 1, 2 do
				local piece = fxPart(d.Size * (0.45 + math.random() * 0.2), d.CFrame * CFrame.new((k - 1.5) * d.Size.X * 0.3, 0, 0), d.Color, 0)
				piece.Material = d.Material
				local dir = Vector3.new(math.random() - 0.5, 0.6 + math.random() * 0.8, math.random() - 0.5).Unit
				local goal = center + dir * (6 + math.random() * 8) + Vector3.new(0, -3, 0)
				TweenService:Create(piece, TweenInfo.new(0.6, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
					Position = goal,
					Orientation = Vector3.new(math.random(-360, 360), math.random(-360, 360), math.random(-360, 360)),
					Size = piece.Size * 0.3,
					Transparency = 1,
				}):Play()
				Debris:AddItem(piece, 0.65)
			end
		end
	end
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("BasePart") then
			d.LocalTransparencyModifier = 1
		elseif d:IsA("BillboardGui") then
			d.Enabled = false
		end
	end
	local root = model:FindFirstChild("HumanoidRootPart")
	if root and root:IsA("BasePart") then
		Effects.burst(root.Position, color, 16, 20, 0.6)
	end
end

------------------------------------------------------------------------
-- 무기 스킬 연출
------------------------------------------------------------------------
local skillFx: { [string]: (any) -> () } = {}

skillFx.charge = function(data)
	local from: Vector3 = data.origin
	local to: Vector3 = data.target
	for i = 0, 6 do
		task.delay(i * 0.03, function()
			local p = from:Lerp(to, i / 6)
			Effects.burst(floorOf(p) + Vector3.new(0, 1, 0), Color3.fromRGB(210, 180, 140), 6, 16, 0.9)
		end)
	end
	local ram = fxPart(Vector3.new(6, 4, 1), CFrame.lookAt(from, to) * CFrame.new(0, 0, -2), data.color, 0.3)
	animate(0.2, function(t)
		ram.CFrame = CFrame.lookAt(from:Lerp(to, t), to) * CFrame.new(0, 0, -2)
	end, function()
		fade(ram, 0.15)
		ring(floorOf(to) + Vector3.new(0, 0.2, 0), data.color, 2, 16, 0.35, 0.4)
	end)
	Effects.shake(0.8, 0.3)
	Effects.sound("lunge", 0.8, 0.7)
end

skillFx.boomerang = function(data)
	local origin: Vector3 = data.origin
	local look: Vector3 = data.look
	local anchor = fxPart(Vector3.new(0.4, 0.4, 0.4), CFrame.new(origin), Color3.new(1, 1, 1), 1)
	local holder = Instance.new("Model")
	holder.Parent = folder
	pcall(function()
		WeaponBuilder.build(holder, anchor, 1, { grade = data.grade or 40, accent = data.color, rarity = 5, scale = 1, lite = true }, CFrame.new(origin) * CFrame.Angles(0, 0, math.rad(90)) * CFrame.new(0, -3, 0))
	end)
	local spinRing = fxPart(Vector3.new(0.2, 9, 9), CFrame.new(origin), data.color, 0.6, Enum.PartType.Cylinder)
	local far = origin + look * data.range
	animate(data.duration, function(t)
		local pos
		if t <= 0.5 then
			pos = origin:Lerp(far, t / 0.5)
		else
			local r = getChar()
			pos = far:Lerp(r and r.Position or origin, (t - 0.5) / 0.5)
		end
		local spin = CFrame.Angles(0, os.clock() * 25, 0)
		anchor.CFrame = CFrame.new(pos) * spin
		spinRing.CFrame = CFrame.new(pos) * CFrame.Angles(0, 0, math.rad(90))
	end, function()
		holder:Destroy()
		fade(anchor, 0.05)
		fade(spinRing, 0.1)
	end)
	Effects.sound("slash", 0.6, 0.7)
end

skillFx.markBoom = function(data)
	Effects.flash(data.pos, Color3.fromRGB(255, 80, 180), 10, 0.35)
	local cf = CFrame.new(data.pos)
	arc(cf * CFrame.Angles(0, 0, math.rad(55)), 5, -80, 80, 10, 1.2, Color3.fromRGB(255, 120, 200), 0.3)
	arc(cf * CFrame.Angles(0, 0, math.rad(-55)), 5, -80, 80, 10, 1.2, Color3.fromRGB(255, 120, 200), 0.3)
	ring(floorOf(data.pos) + Vector3.new(0, 0.2, 0), Color3.fromRGB(255, 100, 190), 2, 16, 0.4, 0.4)
	Effects.burst(data.pos, Color3.fromRGB(255, 120, 200), 35, 32, 0.7)
	Effects.shake(0.9, 0.3)
	Effects.sound("lunge", 0.8, 1.2)
end

local function streak(from: Vector3, to: Vector3, color: Color3, width: number, life: number)
	local mid = (from + to) / 2
	local dist = (to - from).Magnitude
	if dist < 0.1 then
		return
	end
	local p = fxPart(Vector3.new(width, width, dist), CFrame.lookAt(mid, to), color, 0.1)
	fade(p, life, { Size = Vector3.new(0.05, 0.05, dist) })
end

local function silhouettes(from: Vector3, to: Vector3, color: Color3, count: number, life: number)
	for i = 1, count do
		local p = from:Lerp(to, i / (count + 1))
		local body = fxPart(Vector3.new(4.6, 1.8, 1.8), CFrame.lookAt(p, to) * CFrame.Angles(0, 0, math.rad(90)), color, 0.5, Enum.PartType.Cylinder)
		body.Material = Enum.Material.ForceField
		fade(body, life + i * 0.03)
	end
end

skillFx.phantom = function(data)
	streak(data.origin, data.target, data.color, 1.2, 0.35)
	silhouettes(data.origin, data.target, data.color, 5, 0.6)
	Effects.sound("slash", 0.5, 1.5)
end

skillFx.phantomEcho = function(data)
	streak(data.origin, data.target, Color3.fromRGB(200, 120, 255), 1.6, 0.3)
	for i = 1, 4 do
		local p = data.origin:Lerp(data.target, i / 5)
		arc(CFrame.lookAt(p, data.target) * CFrame.Angles(0, 0, math.rad(90 + (i % 2 == 0 and 40 or -40))), 3.5, -70, 70, 8, 0.8, Color3.fromRGB(210, 140, 255), 0.18)
	end
	Effects.shake(0.4, 0.15)
	Effects.sound("slash", 0.6, 1.2)
end

skillFx.wave = function(data)
	local origin: Vector3 = data.origin
	local look: Vector3 = data.look
	local color: Color3 = data.color
	local segs = 9
	local parts = {}
	for i = 0, segs - 1 do
		local a0 = math.rad(-75 + 150 * i / segs)
		local a1 = math.rad(-75 + 150 * (i + 1) / segs)
		local r = data.width * 0.9
		local p0 = Vector3.new(math.sin(a0) * r, 0, -math.cos(a0) * r)
		local p1 = Vector3.new(math.sin(a1) * r, 0, -math.cos(a1) * r)
		local mid = (p0 + p1) / 2
		local t = i / (segs - 1)
		local w = 1.6 * (1 - math.abs(t * 2 - 1) * 0.7)
		local offset = CFrame.lookAt(mid, p1)
		local part = fxPart(Vector3.new(w, 0.3, (p1 - p0).Magnitude + 0.1), CFrame.new(origin), color, 0.05)
		table.insert(parts, { part = part, offset = offset })
	end
	local core = fxPart(Vector3.new(1, 1, 1), CFrame.new(origin), Color3.new(1, 1, 1), 0.2, Enum.PartType.Ball)
	addTrail(core, color, 4, 0.3)
	local duration = data.range / data.speed
	animate(duration, function(t)
		local d = data.range * t
		local base = CFrame.lookAt(origin + look * d, origin + look * (d + 1))
		for _, item in ipairs(parts) do
			item.part.CFrame = base * item.offset
		end
		core.CFrame = base
	end, function()
		for _, item in ipairs(parts) do
			fade(item.part, 0.15)
		end
		fade(core, 0.15)
	end)
	Effects.sound("lunge", 0.6, 1.3)
end

skillFx.parry = function(data)
	local root = getChar()
	if not root then
		return
	end
	local bubble = fxPart(Vector3.new(8, 8, 8), root.CFrame, data.color, 0.4, Enum.PartType.Ball)
	bubble.Material = Enum.Material.ForceField
	animate(data.window, function()
		local r = getChar()
		if r and bubble.Parent then
			bubble.CFrame = r.CFrame
		end
	end, function()
		fade(bubble, 0.15)
	end)
	Effects.sound("unsheath", 0.6, 1.3)
end

skillFx.parryCounter = function(data)
	Effects.flash(data.pos, Color3.new(1, 1, 1), 14, 0.3)
	ring(floorOf(data.pos) + Vector3.new(0, 0.3, 0), data.color, 3, data.radius * 2.2, 0.4, 0.5)
	arc(CFrame.new(data.pos), data.radius * 0.8, 0, 360, 22, 2, Color3.new(1, 1, 1), 0.3)
	local anchor = fxPart(Vector3.new(0.2, 0.2, 0.2), CFrame.new(data.pos + Vector3.new(0, 5, 0)), Color3.new(1, 1, 1), 1)
	local bb = Instance.new("BillboardGui")
	bb.Size = UDim2.new(0, 300, 0, 70)
	bb.AlwaysOnTop = true
	bb.Parent = anchor
	local l = Instance.new("TextLabel")
	l.Size = UDim2.fromScale(1, 1)
	l.BackgroundTransparency = 1
	l.Font = Enum.Font.GothamBlack
	l.TextScaled = true
	l.Text = "COUNTER!"
	l.TextColor3 = Color3.fromRGB(255, 240, 160)
	l.TextStrokeTransparency = 0
	l.Parent = bb
	TweenService:Create(anchor, TweenInfo.new(0.8), { Position = anchor.Position + Vector3.new(0, 3, 0) }):Play()
	TweenService:Create(l, TweenInfo.new(0.4, Enum.EasingStyle.Linear, Enum.EasingDirection.In, 0, false, 0.5), { TextTransparency = 1, TextStrokeTransparency = 1 }):Play()
	Debris:AddItem(anchor, 1)
	Effects.shake(1.0, 0.3)
	Effects.sound("lunge", 0.9, 1.5)
end

skillFx.poison = function(data)
	local char = Players.LocalPlayer.Character
	local weapon = char and char:FindFirstChild("ArenaWeapon")
	if weapon then
		for _, d in ipairs(weapon:GetDescendants()) do
			if d:IsA("BasePart") and (d.Name == "BladeCoreLine" or d.Name == "Shaft") then
				local drip = Instance.new("ParticleEmitter")
				drip.Rate = 20
				drip.Lifetime = NumberRange.new(0.4, 0.8)
				drip.Speed = NumberRange.new(0.5, 1.5)
				drip.Acceleration = Vector3.new(0, -12, 0)
				drip.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.25), NumberSequenceKeypoint.new(1, 0) })
				drip.LightEmission = 0.8
				drip.Color = ColorSequence.new(Color3.fromRGB(120, 255, 90))
				drip.Parent = d
				Debris:AddItem(drip, data.duration)
			end
		end
	end
	local root = getChar()
	if root then
		Effects.burst(root.Position, Color3.fromRGB(120, 255, 90), 25, 12, 0.6)
	end
	Effects.sound("unsheath", 0.6, 0.8)
end

skillFx.smoke = function(data)
	Effects.burst(data.pos, Color3.fromRGB(70, 65, 80), 40, 14, 3)
	Effects.burst(data.pos, Color3.fromRGB(150, 140, 160), 20, 8, 2)
	local char = Players.LocalPlayer.Character
	if char then
		for _, d in ipairs(char:GetDescendants()) do
			if d:IsA("BasePart") then
				d.LocalTransparencyModifier = 0.75
			end
		end
		task.delay(data.duration, function()
			for _, d in ipairs(char:GetDescendants()) do
				if d:IsA("BasePart") then
					d.LocalTransparencyModifier = 0
				end
			end
		end)
	end
	Effects.sound("slash", 0.4, 0.5)
end

skillFx.hook = function(data)
	local origin: Vector3 = data.origin
	for _, v in ipairs(data.victims or {}) do
		local links = {}
		local dist = (v - origin).Magnitude
		local n = math.max(3, math.floor(dist / 2))
		for i = 1, n do
			local p = origin:Lerp(v, i / n)
			local link = fxPart(Vector3.new(0.5, 0.5, 1.2), CFrame.lookAt(p, v), Color3.fromRGB(190, 190, 205), 0)
			link.Material = Enum.Material.Metal
			table.insert(links, { part = link, t = i / n })
		end
		animate(0.3, function(t)
			for _, l in ipairs(links) do
				local p = origin:Lerp(v, l.t * (1 - t))
				l.part.CFrame = CFrame.lookAt(p, v)
			end
		end, function()
			for _, l in ipairs(links) do
				fade(l.part, 0.1)
			end
		end)
		Effects.burst(v, data.color, 10, 14, 0.5)
	end
	Effects.shake(0.4, 0.15)
	Effects.sound("lunge", 0.6, 0.9)
end

skillFx.zone = function(data)
	local base = Vector3.new(data.pos.X, data.pos.Y + 0.15, data.pos.Z)
	local d = data.radius * 2
	local circle = fxPart(Vector3.new(0.15, d, d), CFrame.new(base) * CFrame.Angles(0, 0, math.rad(90)), Color3.fromRGB(80, 255, 170), 0.5, Enum.PartType.Cylinder)
	local runes = {}
	for i = 0, 7 do
		local rune = fxPart(Vector3.new(1.4, 0.2, 1.4), CFrame.new(base), Color3.fromRGB(150, 255, 200), 0.1)
		table.insert(runes, { part = rune, a = i * math.pi / 4 })
	end
	local souls = Instance.new("ParticleEmitter")
	souls.Rate = 25
	souls.Lifetime = NumberRange.new(1, 1.6)
	souls.Speed = NumberRange.new(3, 6)
	souls.EmissionDirection = Enum.NormalId.Right
	souls.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.6), NumberSequenceKeypoint.new(1, 0) })
	souls.LightEmission = 1
	souls.Color = ColorSequence.new(Color3.fromRGB(150, 255, 200))
	souls.Parent = circle
	animate(data.duration, function(t)
		local spin = os.clock() * 1.5
		for _, r in ipairs(runes) do
			local a = r.a + spin
			r.part.CFrame = CFrame.new(base + Vector3.new(math.cos(a) * data.radius * 0.85, 0.2, math.sin(a) * data.radius * 0.85)) * CFrame.Angles(0, -a, 0)
		end
		circle.Transparency = 0.45 + math.sin(t * 30) * 0.1
	end, function()
		souls.Enabled = false
		fade(circle, 0.3)
		for _, r in ipairs(runes) do
			fade(r.part, 0.3)
		end
	end)
	Effects.sound("unsheath", 0.6, 0.6)
end

skillFx.rain = function(data)
	for i, pos in ipairs(data.positions or {}) do
		task.delay((i - 1) * 0.07, function()
			local ground = floorOf(pos)
			local start = ground + Vector3.new(0, 60, 0)
			local anchor = fxPart(Vector3.new(0.3, 0.3, 0.3), CFrame.new(start), Color3.new(1, 1, 1), 1)
			local holder = Instance.new("Model")
			holder.Parent = folder
			pcall(function()
				WeaponBuilder.build(holder, anchor, 1, { grade = 100, accent = Color3.fromRGB(255, 235, 160), rarity = 5, scale = 0.8, lite = true }, CFrame.new(start) * CFrame.Angles(math.rad(180), 0, 0) * CFrame.new(0, -4, 0))
			end)
			animate(0.35, function(t)
				anchor.CFrame = CFrame.new(start:Lerp(ground + Vector3.new(0, 4, 0), t * t))
			end, function()
				Effects.flash(ground + Vector3.new(0, 1, 0), Color3.fromRGB(255, 240, 180), 6, 0.25)
				ring(ground + Vector3.new(0, 0.2, 0), Color3.fromRGB(255, 220, 120), 1, 9, 0.35, 0.3)
				Effects.burst(ground + Vector3.new(0, 1, 0), Color3.fromRGB(255, 230, 150), 12, 20, 0.5)
				Effects.shake(0.25, 0.08)
				task.delay(0.5, function()
					holder:Destroy()
					anchor:Destroy()
				end)
			end)
		end)
	end
	Effects.sound("lunge", 0.8, 0.8)
end

skillFx.timestop = function(data)
	local cc = Instance.new("ColorCorrectionEffect")
	cc.Name = "TimeStop"
	cc.Saturation = -0.9
	cc.TintColor = Color3.fromRGB(200, 225, 255)
	cc.Parent = Lighting
	task.delay(data.duration - 0.4, function()
		TweenService:Create(cc, TweenInfo.new(0.4), { Saturation = 0, TintColor = Color3.new(1, 1, 1) }):Play()
		Debris:AddItem(cc, 0.45)
	end)
	for _, m in ipairs(data.models or {}) do
		if m and m.Parent then
			local h = Instance.new("Highlight")
			h.FillColor = Color3.fromRGB(150, 220, 255)
			h.FillTransparency = 0.4
			h.OutlineColor = Color3.new(1, 1, 1)
			h.Parent = m
			Debris:AddItem(h, data.duration)
		end
	end
	local root = getChar()
	if root then
		ring(floorOf(root.Position) + Vector3.new(0, 0.3, 0), Color3.fromRGB(200, 230, 255), 4, 120, 0.8, 0.4)
		arc(CFrame.new(root.Position + Vector3.new(0, 4, 0)) * CFrame.Angles(math.rad(90), 0, 0), 6, 0, 360, 24, 0.6, Color3.fromRGB(220, 240, 255), 0.8)
	end
	Effects.shake(0.6, 0.3)
	Effects.sound("ping", 0.8, 0.5)
end

skillFx.chargeBoom = function(data)
	local base = floorOf(data.pos)
	ring(base + Vector3.new(0, 0.2, 0), data.color, 2, data.radius * 2.3, 0.35, 0.5)
	Effects.burst(base + Vector3.new(0, 1, 0), Color3.fromRGB(210, 185, 140), 30, 30, 1.3)
	Effects.flash(data.pos, data.color, data.radius, 0.2)
	for i = 0, 7 do
		local a = i * math.pi / 4
		local p = base + Vector3.new(math.cos(a), 0, math.sin(a)) * data.radius * 0.6
		local rock = fxPart(Vector3.new(1, 1.6, 1), CFrame.new(p) * CFrame.Angles(math.random(), math.random(), math.random()), Color3.fromRGB(120, 100, 85), 0)
		rock.Material = Enum.Material.Slate
		fade(rock, 0.5, { Position = p + Vector3.new(0, 3, 0) })
	end
	Effects.shake(1.0, 0.3)
	Effects.sound("lunge", 0.9, 0.5)
end

skillFx.poisonCloud = function(data)
	local base = Vector3.new(data.pos.X, data.pos.Y + 0.2, data.pos.Z)
	local d = data.radius * 2
	local cloud = fxPart(Vector3.new(d * 0.6, 4, d * 0.6), CFrame.new(base + Vector3.new(0, 2, 0)), Color3.fromRGB(110, 220, 80), 0.75, Enum.PartType.Ball)
	cloud.Material = Enum.Material.ForceField
	local gas = Instance.new("ParticleEmitter")
	gas.Texture = "rbxasset://textures/particles/smoke_main.dds"
	gas.Rate = 30
	gas.Lifetime = NumberRange.new(1, 2)
	gas.Speed = NumberRange.new(1, 3)
	gas.SpreadAngle = Vector2.new(180, 180)
	gas.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 2), NumberSequenceKeypoint.new(1, 4) })
	gas.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.5), NumberSequenceKeypoint.new(1, 1) })
	gas.Color = ColorSequence.new(Color3.fromRGB(120, 230, 80), Color3.fromRGB(60, 120, 40))
	gas.Parent = cloud
	animate(data.duration, function(t)
		cloud.Size = Vector3.new(d * (0.6 + 0.4 * math.min(t * 4, 1)), 4, d * (0.6 + 0.4 * math.min(t * 4, 1)))
	end, function()
		gas.Enabled = false
		fade(cloud, 0.5)
	end)
	Effects.sound("unsheath", 0.5, 0.5)
end

skillFx.hookSlam = function(data)
	local base = floorOf(data.pos)
	ring(base + Vector3.new(0, 0.2, 0), Color3.fromRGB(180, 180, 200), 2, 18, 0.35, 0.5)
	Effects.burst(base + Vector3.new(0, 1, 0), Color3.fromRGB(200, 175, 140), 26, 26, 1.2)
	Effects.shake(0.9, 0.25)
	Effects.sound("lunge", 0.8, 0.6)
end

function Effects.skill(data: any)
	local fn = skillFx[data.id]
	if fn then
		fn(data)
	end
end

-- 다른 연출 모듈(킬 이펙트, 아우라 파동)이 같이 쓰는 기본 도구
Effects.prim = {
	fxPart = fxPart,
	fade = fade,
	arc = arc,
	ring = ring,
	flyingBits = flyingBits,
	lightningBolt = lightningBolt,
	animate = animate,
	addTrail = addTrail,
	floorOf = floorOf,
	streak = streak,
	RAINBOW = RAINBOW_COLORS,
}

return Effects
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="16">
          <Properties>
            <string name="Name">KillFx</string>
            <string name="Source"><![CDATA[-- KillFx (ModuleScript, ArenaClient 아래)
-- 상점에서 산 킬 이펙트 30종, 아우라 파동, 사제 치유 연출.
-- 킬 이펙트는 적이 쓰러진 자리에서 터지고, 터진 범위(폭발 반경)가 바닥 고리로 보인다.
-- 단계가 높을수록 크고, 겹이 많고, 오래 남는다.

local TweenService = game:GetService("TweenService")
local Debris = game:GetService("Debris")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage:WaitForChild("GameConfig"))
local GradeStyle = require(ReplicatedStorage:WaitForChild("GradeStyle"))

local KillFx = {}

local Effects: any = nil
local P: any = nil

function KillFx.init(effects: any)
	Effects = effects
	P = effects.prim
end

local WHITE = Color3.new(1, 1, 1)
local GOLD = Color3.fromRGB(255, 205, 90)

-- 단계에 맞는 등급 디자인 (속성이 같고, 높은 단계일수록 화려한 등급)
function KillFx.styleFor(tier: number)
	if tier >= #Config.KillFx then
		return GradeStyle.get(100)
	end
	local f = Config.KillFx[tier]
	return GradeStyle.get(f.motif + ((tier - 1) // 10) * 30)
end

------------------------------------------------------------------------
-- 조립 도구
------------------------------------------------------------------------
local function tween(p: Instance, time: number, goal: { [string]: any }, style: Enum.EasingStyle?, dir: Enum.EasingDirection?)
	TweenService:Create(p, TweenInfo.new(time, style or Enum.EasingStyle.Quad, dir or Enum.EasingDirection.Out), goal):Play()
end

local function ground(pos: Vector3): Vector3
	return P.floorOf(pos) + Vector3.new(0, 0.2, 0)
end

-- 세로 빛기둥
local function pillar(pos: Vector3, color: Color3, height: number, width: number, life: number)
	local base = ground(pos)
	local beam = P.fxPart(Vector3.new(height, width, width), CFrame.new(base + Vector3.new(0, height / 2, 0)) * CFrame.Angles(0, 0, math.rad(90)), color, 0.1, Enum.PartType.Cylinder)
	P.fade(beam, life, { Size = Vector3.new(height, 0.1, 0.1) })
end

-- 바닥에서 원으로 솟는 가시
local function spikeRing(pos: Vector3, n: number, radius: number, color: Color3, height: number, material: Enum.Material, life: number)
	local base = ground(pos)
	for i = 1, n do
		local a = (i / n) * math.pi * 2
		local spot = base + Vector3.new(math.cos(a) * radius, 0, math.sin(a) * radius)
		local spike = P.fxPart(Vector3.new(0.6, 0.1, 0.6), CFrame.new(spot) * CFrame.Angles(math.rad(math.random(-15, 15)), a, math.rad(math.random(-15, 15))), color, 0.05)
		spike.Material = material
		tween(spike, 0.12, { Size = Vector3.new(0.6, height, 0.6), CFrame = spike.CFrame * CFrame.new(0, height / 2, 0) }, Enum.EasingStyle.Back)
		task.delay(0.12 + life * 0.5, function()
			P.fade(spike, life * 0.5, { Size = Vector3.new(0.1, height * 0.3, 0.1) })
		end)
	end
end

-- 속이 차오르거나 꺼지는 구
local function sphere(pos: Vector3, color: Color3, from: number, to: number, life: number, material: Enum.Material?)
	local ball = P.fxPart(Vector3.new(from, from, from), CFrame.new(pos), color, 0.15, Enum.PartType.Ball)
	if material then
		ball.Material = material
	end
	P.fade(ball, life, { Size = Vector3.new(to, to, to) })
	return ball
end

local function floorRing(pos: Vector3, color: Color3, from: number, to: number, life: number, thick: number?)
	P.ring(ground(pos), color, from, to, life, thick)
end

-- 하늘에서 떨어지는 물체 (유성, 검)
local function fall(pos: Vector3, size: Vector3, color: Color3, height: number, time: number, material: Enum.Material?, onLand: (() -> ())?)
	local target = ground(pos)
	local start = target + Vector3.new(math.random(-6, 6), height, math.random(-6, 6))
	local obj = P.fxPart(size, CFrame.lookAt(start, target), color, 0, nil)
	if material then
		obj.Material = material
	end
	P.addTrail(obj, color, math.max(size.X, 0.6), 0.3)
	P.animate(time, function(t)
		local p = start:Lerp(target, t * t)
		obj.CFrame = CFrame.lookAt(p, target + (target - start).Unit)
	end, function()
		P.fade(obj, 0.15)
		if onLand then
			onLand()
		end
	end)
end

-- 얇은 판으로 그리는 X자 베기
local function xSlash(pos: Vector3, color: Color3, size: number, life: number)
	local cam = workspace.CurrentCamera
	local face = cam and (cam.CFrame.Position - pos).Unit or Vector3.new(0, 0, 1)
	local cf = CFrame.lookAt(pos, pos + face)
	for _, tilt in ipairs({ 45, -45 }) do
		local slash = P.fxPart(Vector3.new(0.5, size * 0.1, 0.05), cf * CFrame.Angles(0, 0, math.rad(tilt)), color, 0)
		tween(slash, 0.08, { Size = Vector3.new(0.5, size, 0.05) })
		task.delay(0.1, function()
			P.fade(slash, life, { Size = Vector3.new(0.02, size * 1.2, 0.02) })
		end)
	end
end

-- 날개: 깃털이 부채처럼 펼쳐졌다 사라진다
local function wingFan(pos: Vector3, color: Color3, size: number, life: number)
	local cam = workspace.CurrentCamera
	local face = cam and Vector3.new(cam.CFrame.Position.X - pos.X, 0, cam.CFrame.Position.Z - pos.Z).Unit or Vector3.new(0, 0, 1)
	local cf = CFrame.lookAt(pos, pos + face)
	for _, side in ipairs({ 1, -1 }) do
		for f = 0, 5 do
			local len = (3.2 - f * 0.35) * size
			local feather = P.fxPart(Vector3.new(0.12, 0.2, 0.7 * size), cf * CFrame.Angles(0, 0, math.rad(side * (-75 + f * 22))), (f % 2 == 0) and color or WHITE, 0.1)
			feather.Material = Enum.Material.Glass
			tween(feather, 0.25, { Size = Vector3.new(0.12, len, 0.7 * size), CFrame = cf * CFrame.Angles(0, 0, math.rad(side * (-75 + f * 22))) * CFrame.new(0, len / 2, 0) }, Enum.EasingStyle.Back)
			task.delay(0.25 + life * 0.4, function()
				P.fade(feather, life * 0.6)
			end)
		end
	end
end

-- 나선 회오리: 고리들이 돌며 올라간다
local function tornado(pos: Vector3, color: Color3, color2: Color3, height: number, life: number)
	local base = ground(pos)
	local n = 7
	for i = 1, n do
		local d = 1.5 + i * 0.7
		local ringPart = P.fxPart(Vector3.new(0.25, d, d), CFrame.new(base) * CFrame.Angles(0, 0, math.rad(90)), (i % 2 == 0) and color or color2, 0.25, Enum.PartType.Cylinder)
		local y = height * i / n
		P.animate(life, function(t)
			ringPart.CFrame = CFrame.new(base + Vector3.new(math.cos(t * 12 + i) * 0.6, y * math.min(1, t * 2), math.sin(t * 12 + i) * 0.6)) * CFrame.Angles(0, t * 10, math.rad(90))
			ringPart.Transparency = 0.25 + 0.75 * t
		end, function()
			ringPart:Destroy()
		end)
	end
end

-- 빨려 드는 조각들
local function implode(pos: Vector3, color: Color3, n: number, radius: number, life: number)
	for _ = 1, n do
		local a = math.random() * math.pi * 2
		local start = pos + Vector3.new(math.cos(a) * radius, (math.random() - 0.3) * radius * 0.6, math.sin(a) * radius)
		local bit = P.fxPart(Vector3.new(0.3, 0.3, 0.9), CFrame.lookAt(start, pos), color, 0.1)
		tween(bit, life, { CFrame = CFrame.lookAt(pos, pos + (pos - start).Unit), Size = Vector3.new(0.05, 0.05, 0.2), Transparency = 1 }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
		Debris:AddItem(bit, life + 0.05)
	end
end

-- 해골: 공 머리 + 검은 눈구멍
local function skull(pos: Vector3, color: Color3, size: number, life: number)
	local head = P.fxPart(Vector3.new(1.4, 1.4, 1.4) * size, CFrame.new(pos), color, 0.2, Enum.PartType.Ball)
	head.Material = Enum.Material.Glass
	local cam = workspace.CurrentCamera
	local face = cam and (cam.CFrame.Position - pos).Unit or Vector3.new(0, 0, 1)
	local eyes = {}
	for _, x in ipairs({ -0.3, 0.3 }) do
		local eye = P.fxPart(Vector3.new(0.35, 0.4, 0.2) * size, CFrame.lookAt(pos, pos + face) * CFrame.new(x * size, 0.1 * size, -0.62 * size), Color3.fromRGB(10, 0, 20), 0)
		eye.Material = Enum.Material.SmoothPlastic
		table.insert(eyes, eye)
	end
	local rise = Vector3.new(0, 6 * size, 0)
	P.animate(life, function(t)
		local off = rise * t + Vector3.new(math.sin(t * 20) * 0.3, 0, 0)
		head.CFrame = CFrame.new(pos + off)
		head.Transparency = 0.2 + 0.8 * t
		for i, eye in ipairs(eyes) do
			eye.CFrame = CFrame.lookAt(pos + off, pos + off + face) * CFrame.new((i == 1 and -0.3 or 0.3) * size, 0.1 * size, -0.62 * size)
			eye.Transparency = t
		end
	end, function()
		head:Destroy()
		for _, eye in ipairs(eyes) do
			eye:Destroy()
		end
	end)
end

-- 빛줄기가 사방으로 뻗는다
local function rays(pos: Vector3, colors: { Color3 }, n: number, length: number, life: number)
	for i = 1, n do
		local a = (i / n) * math.pi * 2
		local dir = Vector3.new(math.cos(a), (math.random() - 0.3) * 0.6, math.sin(a)).Unit
		local beam = P.fxPart(Vector3.new(0.35, 0.35, length), CFrame.lookAt(pos, pos + dir) * CFrame.new(0, 0, -length / 2), colors[((i - 1) % #colors) + 1], 0.05)
		P.fade(beam, life, { Size = Vector3.new(0.05, 0.05, length * 1.4) })
	end
end

local function sound(power: number)
	Effects.sound("lunge", 0.35 + power * 0.4, 0.9 - power * 0.4)
end

------------------------------------------------------------------------
-- 30종: fx(위치, 스타일, 단계 비율 p, 반경, 데이터)
------------------------------------------------------------------------
type FxFn = (Vector3, any, number, number, any) -> ()
local FX: { [number]: FxFn } = {}

FX[1] = function(pos, st, p, _r) -- 불꽃 터짐
	Effects.burst(pos, st.primary, 30, 26, 1.2, st.motif.tex)
	sphere(pos, Color3.fromRGB(255, 160, 60), 1, 7, 0.3)
end
FX[2] = function(pos, st, p) -- 얼음 파편
	P.flyingBits(pos, st.glow, 16, Vector3.new(0.3, 1.1, 0.3), Enum.Material.Glass, 16, 0.5, true)
	floorRing(pos, Color3.fromRGB(220, 245, 255), 1, 9, 0.4, 0.2)
end
FX[3] = function(pos, st, p) -- 낙뢰
	for _ = 1, 3 do
		P.lightningBolt(pos + Vector3.new(math.random(-2, 2), 0, math.random(-2, 2)), st.primary, 30, 0.5)
	end
	floorRing(pos, st.primary, 1, 8, 0.3, 0.3)
	Effects.shake(0.4, 0.15)
end
FX[4] = function(pos, st, p) -- 꽃잎 흩날림
	P.flyingBits(pos, Color3.fromRGB(255, 160, 200), 20, Vector3.new(0.5, 0.05, 0.35), Enum.Material.Neon, 9, 1.1, true)
	P.flyingBits(pos, st.primary, 12, Vector3.new(0.5, 0.05, 0.35), Enum.Material.Neon, 7, 1, true)
end
FX[5] = function(pos, st, p) -- 그림자 흡수
	implode(pos, st.primary, 18, 7, 0.4)
	sphere(pos, Color3.fromRGB(20, 5, 30), 5, 0.2, 0.45, Enum.Material.ForceField)
end
FX[6] = function(pos, st, p) -- 빛의 기둥
	pillar(pos, WHITE, 40, 5, 0.6)
	pillar(pos, st.glow, 40, 8, 0.4)
	floorRing(pos, st.glow, 2, 12, 0.5, 0.3)
end
FX[7] = function(pos, st, p) -- 핏빛 초승달
	xSlash(pos, Color3.fromRGB(220, 20, 50), 9, 0.35)
	P.flyingBits(pos, Color3.fromRGB(200, 10, 30), 14, Vector3.new(0.3, 0.3, 0.3), Enum.Material.Neon, 10, 0.6, true)
end
FX[8] = function(pos, st, p) -- 공허 붕괴
	local ball = sphere(pos, st.secondary, 6, 0.3, 0.4, Enum.Material.ForceField)
	ball.Color = st.secondary
	implode(pos, st.glow, 14, 6, 0.35)
	task.delay(0.4, function()
		sphere(pos, st.secondary, 0.5, 8, 0.25)
	end)
end
FX[9] = function(pos, st, p) -- 별 폭죽
	for i = 0, 2 do
		task.delay(i * 0.1, function()
			local spot = pos + Vector3.new(math.random(-3, 3), 2 + i * 1.5, math.random(-3, 3))
			Effects.burst(spot, P.RAINBOW[math.random(1, #P.RAINBOW)], 30, 30, 0.6)
			Effects.flash(spot, WHITE, 3, 0.15)
		end)
	end
end
FX[10] = function(pos, st, p) -- 수정 감옥
	local n = 8
	local base = ground(pos)
	for i = 1, n do
		local a = (i / n) * math.pi * 2
		local c = P.fxPart(Vector3.new(0.8, 5, 0.8), CFrame.new(base + Vector3.new(math.cos(a) * 1.8, 2.5, math.sin(a) * 1.8)) * CFrame.Angles(math.rad(math.cos(a) * -18), 0, math.rad(math.sin(a) * 18)), (i % 2 == 0) and st.glow or st.secondary, 0.2)
		c.Material = Enum.Material.Glass
		task.delay(0.35, function()
			P.fade(c, 0.3, { Size = Vector3.new(0.1, 1, 0.1) })
		end)
	end
	task.delay(0.35, function()
		P.flyingBits(pos, st.glow, 18, Vector3.new(0.35, 0.8, 0.35), Enum.Material.Glass, 18, 0.5, true)
	end)
end
FX[11] = function(pos, st, p) -- 화산 분출
	floorRing(pos, Color3.fromRGB(255, 90, 20), 1, 10, 0.5, 0.4)
	for i = 0, 3 do
		task.delay(i * 0.07, function()
			pillar(pos + Vector3.new(math.random(-3, 3), 0, math.random(-3, 3)), (i % 2 == 0) and Color3.fromRGB(255, 120, 30) or Color3.fromRGB(255, 220, 90), 14, 2.2, 0.45)
		end)
	end
	P.flyingBits(pos, Color3.fromRGB(255, 100, 30), 14, Vector3.new(0.5, 0.5, 0.5), Enum.Material.Neon, 18, 0.8, true)
	Effects.shake(0.6, 0.2)
end
FX[12] = function(pos, st, p, r) -- 빙결 쇄도
	spikeRing(pos, 12, r * 0.6, st.glow, 4, Enum.Material.Glass, 0.6)
	spikeRing(pos, 8, r * 0.3, WHITE, 3, Enum.Material.Glass, 0.5)
end
FX[13] = function(pos, st, p, r, data) -- 뇌전 사슬: 근처 적에게 번개
	local targets = data.near or {}
	local prev = pos
	for i, t in ipairs(targets) do
		if i > 5 then
			break
		end
		task.delay(i * 0.05, function()
			P.streak(prev, t, st.primary, 0.4, 0.25)
			P.lightningBolt(t, st.primary, 14, 0.3)
		end)
		prev = t
	end
	P.lightningBolt(pos, st.primary, 26, 0.6)
	floorRing(pos, st.secondary, 1, r * 2, 0.3, 0.3)
end
FX[14] = function(pos, st, p) -- 덩굴 휘감기
	local base = ground(pos)
	for v = 1, 4 do
		local a0 = v * math.pi / 2
		for i = 1, 8 do
			local t = i / 8
			local a = a0 + t * 4
			local spot = base + Vector3.new(math.cos(a) * (2.2 - t), t * 5, math.sin(a) * (2.2 - t))
			task.delay(i * 0.03, function()
				local leaf = P.fxPart(Vector3.new(0.4, 0.4, 0.9), CFrame.lookAt(spot, base + Vector3.new(0, 6, 0)), (i % 2 == 0) and st.primary or st.secondary, 0.1)
				P.fade(leaf, 0.6)
			end)
		end
	end
	P.flyingBits(pos, st.secondary, 10, Vector3.new(0.5, 0.05, 0.35), Enum.Material.Neon, 8, 0.8, true)
end
FX[15] = function(pos, st, p) -- 망령의 비명
	skull(pos, Color3.fromRGB(200, 190, 230), 1.2, 0.9)
	Effects.burst(pos, st.primary, 25, 10, 1.5, st.motif.tex)
	Effects.sound("ping", 0.4, 0.5)
end
FX[16] = function(pos, st, p, r) -- 천벌: 빛의 검
	fall(pos, Vector3.new(0.6, 0.6, 7), GOLD, 40, 0.3, Enum.Material.Neon, function()
		pillar(pos, WHITE, 30, 3, 0.4)
		floorRing(pos, GOLD, 2, r * 2.2, 0.5, 0.4)
		Effects.shake(0.7, 0.2)
	end)
end
FX[17] = function(pos, st, p) -- 피의 분수
	for i = 1, 3 do
		task.delay(i * 0.08, function()
			P.flyingBits(pos + Vector3.new(0, 1, 0), Color3.fromRGB(200, 10, 40), 12, Vector3.new(0.35, 0.35, 0.35), Enum.Material.Neon, 14, 0.8, true)
		end)
	end
	P.arc(CFrame.new(pos) * CFrame.Angles(0, math.random() * 6, math.rad(70)), 5, -80, 80, 10, 1, Color3.fromRGB(255, 40, 70), 0.35)
end
FX[18] = function(pos, st, p, r) -- 블랙홀
	local hole = sphere(pos, Color3.fromRGB(5, 0, 10), 0.5, 6, 0.6)
	hole.Material = Enum.Material.SmoothPlastic
	for k = 1, 2 do
		floorRing(pos, (k == 1) and st.secondary or st.glow, r * 2.4, 0.5, 0.55, 0.3)
	end
	implode(pos, st.glow, 24, r, 0.55)
	task.delay(0.6, function()
		sphere(pos, st.glow, 1, r * 1.6, 0.3)
		Effects.shake(0.8, 0.25)
	end)
end
FX[19] = function(pos, st, p, r) -- 유성우
	for i = 1, 5 do
		task.delay(i * 0.07, function()
			local spot = pos + Vector3.new((math.random() * 2 - 1) * r * 0.6, 0, (math.random() * 2 - 1) * r * 0.6)
			fall(spot, Vector3.new(1.2, 1.2, 1.2), Color3.fromRGB(255, 150, 60), 35, 0.3, Enum.Material.Neon, function()
				Effects.burst(ground(spot), Color3.fromRGB(255, 180, 80), 14, 18, 0.8)
				floorRing(spot, Color3.fromRGB(255, 120, 40), 1, 6, 0.3, 0.3)
			end)
		end)
	end
end
FX[20] = function(pos, st, p, r) -- 프리즘 굴절
	rays(pos, P.RAINBOW, 12, r * 2.2, 0.45)
	local gem = P.fxPart(Vector3.new(1.5, 1.5, 1.5), CFrame.new(pos) * CFrame.Angles(math.rad(45), 0, math.rad(45)), WHITE, 0.1)
	gem.Material = Enum.Material.Glass
	P.fade(gem, 0.5, { Size = Vector3.new(3.5, 3.5, 3.5) })
end
FX[21] = function(pos, st, p, r) -- 용의 불기둥
	tornado(pos, Color3.fromRGB(255, 110, 30), Color3.fromRGB(255, 220, 90), 14, 0.8)
	pillar(pos, Color3.fromRGB(255, 140, 40), 18, 4, 0.6)
	floorRing(pos, Color3.fromRGB(255, 90, 20), 2, r * 2.2, 0.6, 0.4)
	Effects.shake(0.7, 0.25)
end
FX[22] = function(pos, st, p, r) -- 절대영도
	local block = P.fxPart(Vector3.new(4, 6, 4), CFrame.new(pos), Color3.fromRGB(190, 235, 255), 0.35)
	block.Material = Enum.Material.Ice
	task.delay(0.3, function()
		block:Destroy()
		P.flyingBits(pos, Color3.fromRGB(210, 240, 255), 26, Vector3.new(0.7, 0.7, 0.7), Enum.Material.Ice, 20, 0.6, true)
		spikeRing(pos, 14, r * 0.7, Color3.fromRGB(200, 240, 255), 5, Enum.Material.Glass, 0.6)
		floorRing(pos, WHITE, 2, r * 2.4, 0.5, 0.3)
	end)
end
FX[23] = function(pos, st, p, r) -- 천둥신의 망치
	local start = pos + Vector3.new(0, 18, 0)
	local hammer = P.fxPart(Vector3.new(3, 2, 2), CFrame.new(start), Color3.fromRGB(150, 150, 170), 0)
	hammer.Material = Enum.Material.Metal
	local handle = P.fxPart(Vector3.new(0.5, 4, 0.5), CFrame.new(start + Vector3.new(0, 3, 0)), Color3.fromRGB(110, 70, 40), 0)
	P.animate(0.22, function(t)
		local y = 18 * (1 - t * t)
		hammer.CFrame = CFrame.new(pos + Vector3.new(0, y, 0))
		handle.CFrame = CFrame.new(pos + Vector3.new(0, y + 3, 0))
	end, function()
		P.fade(hammer, 0.3)
		P.fade(handle, 0.3)
		for _ = 1, 4 do
			P.lightningBolt(pos + Vector3.new((math.random() * 2 - 1) * r * 0.5, 0, (math.random() * 2 - 1) * r * 0.5), st.primary, 24, 0.5)
		end
		floorRing(pos, st.primary, 2, r * 2.4, 0.4, 0.5)
		Effects.shake(1.1, 0.3)
	end)
end
FX[24] = function(pos, st, p) -- 불사조
	local bird = pos + Vector3.new(0, 1, 0)
	wingFan(bird, Color3.fromRGB(255, 120, 40), 1.4, 0.7)
	local body = P.fxPart(Vector3.new(1, 1, 1.8), CFrame.new(bird), Color3.fromRGB(255, 200, 80), 0, Enum.PartType.Ball)
	P.addTrail(body, Color3.fromRGB(255, 120, 40), 1.2, 0.5)
	tween(body, 0.9, { Position = bird + Vector3.new(0, 18, 0), Transparency = 1 }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
	Debris:AddItem(body, 1)
	Effects.burst(pos, Color3.fromRGB(255, 150, 50), 30, 20, 1, st.motif.tex)
end
FX[25] = function(pos, st, p, r) -- 차원 절단
	xSlash(pos, WHITE, r * 2.6, 0.4)
	xSlash(pos, st.secondary, r * 3.2, 0.5)
	sphere(pos, Color3.fromRGB(10, 0, 25), 3, 0.2, 0.4, Enum.Material.ForceField)
	Effects.shake(0.8, 0.2)
end
FX[26] = function(pos, st, p, r) -- 대천사 강림
	wingFan(pos + Vector3.new(0, 3, 0), GOLD, 1.8, 0.9)
	pillar(pos, WHITE, 50, 6, 0.7)
	floorRing(pos, GOLD, 2, r * 2.4, 0.6, 0.4)
	Effects.burst(pos, GOLD, 30, 20, 0.8)
end
FX[27] = function(pos, st, p, r) -- 혈월
	local moon = P.fxPart(Vector3.new(4, 4, 4), CFrame.new(pos + Vector3.new(0, 2, 0)), Color3.fromRGB(210, 20, 40), 0.1, Enum.PartType.Ball)
	tween(moon, 0.5, { Position = pos + Vector3.new(0, 10, 0) })
	task.delay(0.5, function()
		P.fade(moon, 0.25, { Size = Vector3.new(14, 14, 14) })
		rays(pos + Vector3.new(0, 10, 0), { Color3.fromRGB(255, 40, 60), Color3.fromRGB(120, 0, 20) }, 10, r * 2, 0.4)
		floorRing(pos, Color3.fromRGB(220, 20, 50), 2, r * 2.4, 0.4, 0.4)
		Effects.shake(0.9, 0.25)
	end)
end
FX[28] = function(pos, st, p, r) -- 사건의 지평선
	for k = 1, 3 do
		local d = r * (0.9 + k * 0.5)
		local ringPart = P.fxPart(Vector3.new(0.3, d, d), CFrame.new(pos) * CFrame.Angles(math.rad(k * 30), 0, math.rad(90)), (k % 2 == 0) and WHITE or st.secondary, 0.1, Enum.PartType.Cylinder)
		P.animate(0.7, function(t)
			ringPart.CFrame = CFrame.new(pos) * CFrame.Angles(math.rad(k * 30) + t * 6, t * 4, math.rad(90))
			local sz = d * (1 - t * 0.9)
			ringPart.Size = Vector3.new(0.3, sz, sz)
		end, function()
			ringPart:Destroy()
		end)
	end
	local core = sphere(pos, Color3.fromRGB(0, 0, 0), 4, 0.5, 0.7)
	core.Material = Enum.Material.SmoothPlastic
	implode(pos, WHITE, 30, r * 1.2, 0.6)
	task.delay(0.7, function()
		sphere(pos, WHITE, 1, r * 2, 0.3)
		Effects.shake(1.2, 0.3)
	end)
end
FX[29] = function(pos, st, p, r) -- 초신성
	Effects.flash(pos, WHITE, r * 2, 0.4)
	for k = 0, 3 do
		task.delay(k * 0.08, function()
			floorRing(pos, (k % 2 == 0) and st.glow or Color3.fromRGB(255, 220, 140), 2, r * (1.4 + k * 0.6), 0.5, 0.4)
			sphere(pos, (k % 2 == 0) and Color3.fromRGB(255, 240, 200) or st.glow, 1, r * (0.8 + k * 0.4), 0.35)
		end)
	end
	rays(pos, { WHITE, st.glow, GOLD }, 16, r * 2.5, 0.5)
	P.flyingBits(pos, GOLD, 24, Vector3.new(0.4, 0.4, 0.4), Enum.Material.Neon, 26, 0.7, false)
	Effects.shake(1.4, 0.4)
end
FX[30] = function(pos, st, p, r, data) -- 빅뱅
	local core = sphere(pos, WHITE, 6, 0.3, 0.35)
	core.Material = Enum.Material.Neon
	implode(pos, P.RAINBOW[1], 20, r * 1.5, 0.35)
	task.delay(0.35, function()
		for k, c in ipairs(P.RAINBOW) do
			task.delay(k * 0.04, function()
				floorRing(pos, c, 2, r * (1.2 + k * 0.4), 0.6, 0.4)
			end)
		end
		rays(pos, P.RAINBOW, 24, r * 3, 0.6)
		sphere(pos, WHITE, 1, r * 2.5, 0.4)
		pillar(pos, WHITE, 80, 8, 0.8)
		Effects.shake(1.8, 0.5)
		Effects.sound("lunge", 1, 0.3)
	end)
end

-- 적이 쓰러질 때. data = { pos, fx, radius, boss, near = 근처 적 위치들 }
function KillFx.play(data: any)
	local tier = data.fx or 0
	local fn = FX[tier]
	if not fn or not P then
		return
	end
	local st = KillFx.styleFor(tier)
	local p = tier / #Config.KillFx
	local r = math.max(4, data.radius or 6)
	local ok, err = pcall(fn, data.pos, st, p, r, data)
	if not ok then
		warn("[Arena] 킬 이펙트 오류:", err)
	end
	-- 폭발 범위가 바닥에 고리로 보인다
	floorRing(data.pos, st.glow, 1, r * 2, 0.35, 0.15)
	sound(p)
end

-- 아우라 파동: 내 발밑에서 아우라 색 고리가 퍼진다
function KillFx.pulse(data: any)
	if not P then
		return
	end
	local tier = data.tier or 1
	local st = (tier >= #Config.Auras) and GradeStyle.get(100) or GradeStyle.get(Config.Auras[tier].motif + ((tier - 1) // 10) * 30)
	local r = data.radius or 8
	floorRing(data.pos, st.glow, 2, r * 2, 0.45, 0.25)
	if tier >= 11 then
		floorRing(data.pos, st.secondary, 1, r * 1.6, 0.35, 0.2)
	end
	if tier >= 21 then
		for i = 1, 6 do
			local a = (i / 6) * math.pi * 2
			pillar(data.pos + Vector3.new(math.cos(a) * r * 0.7, 0, math.sin(a) * r * 0.7), st.glow, 10, 0.8, 0.35)
		end
	end
	if (data.hit or 0) > 0 then
		Effects.burst(data.pos, st.glow, 12 + tier, 14, 0.5, st.motif.tex)
	end
end

-- 사제 치유: 사제에서 치유받는 적에게 초록 빛줄기
function KillFx.heal(data: any)
	if not P then
		return
	end
	local green = Color3.fromRGB(120, 255, 150)
	for _, t in ipairs(data.targets or {}) do
		P.streak(data.from + Vector3.new(0, 3, 0), t + Vector3.new(0, 1, 0), green, 0.35, 0.4)
		Effects.burst(t, green, 10, 6, 0.6)
	end
	Effects.flash(data.from + Vector3.new(0, 3, 0), green, 4, 0.3)
end

return KillFx
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="17">
          <Properties>
            <string name="Name">Motion</string>
            <string name="Source"><![CDATA[-- Motion (ModuleScript, ArenaClient 아래)
-- 애니메이션 파일 없이 관절(Motor6D)을 매 프레임 직접 움직이는 동작.
--   내 캐릭터: 무기별 전투 자세, 무기별 3단 콤보, 구르기 회피, 스킬·필살기 자세, 맞으면 움찔, 승리 포즈
--   적: 공격 직전 팔을 들었다가 내려치기, 시전, 돌진 자세, 맞으면 뒤로 젖혀짐
-- 기본 걷기 애니메이션 위에 덧입혀서, 걸으면서 베는 것도 자연스럽다.

local RunService = game:GetService("RunService")

local Motion = {}

-- 짧은 이름 → R15 관절 이름
local JOINT_NAMES = {
	R = "Root",
	W = "Waist",
	N = "Neck",
	RS = "RightShoulder",
	RE = "RightElbow",
	RW = "RightWrist",
	LS = "LeftShoulder",
	LE = "LeftElbow",
	LW = "LeftWrist",
	RH = "RightHip",
	RK = "RightKnee",
	LH = "LeftHip",
	LK = "LeftKnee",
}
local JOINT_PARTS = {
	Root = "LowerTorso",
	Waist = "UpperTorso",
	Neck = "Head",
	RightShoulder = "RightUpperArm",
	RightElbow = "RightLowerArm",
	RightWrist = "RightHand",
	LeftShoulder = "LeftUpperArm",
	LeftElbow = "LeftLowerArm",
	LeftWrist = "LeftHand",
	RightHip = "RightUpperLeg",
	RightKnee = "RightLowerLeg",
	LeftHip = "LeftUpperLeg",
	LeftKnee = "LeftLowerLeg",
}
local KEYS = { "R", "W", "N", "RS", "RE", "RW", "LS", "LE", "LW", "RH", "RK", "LH", "LK" }

-- 자세: { 관절 = { rx, ry, rz, px, py, pz } } (도, 스터드)
type Pose = { [string]: { number } }
type Key = { t: number, pose: Pose }
type Clip = { dur: number, hit: number, keys: { Key }, hold: boolean? }

local ZERO6 = { 0, 0, 0, 0, 0, 0 }

local function get(pose: Pose, k: string): { number }
	return pose[k] or ZERO6
end

-- 부드럽게 (앞뒤로 천천히)
local function smooth(x: number): number
	return x * x * (3 - 2 * x)
end

-- 각도를 -180~180으로 (360도 회전이 끝나면 0과 같다)
local function wrap(a: number): number
	return ((a + 180) % 360) - 180
end

local function samplePose(clip: Clip, t: number, out: { [string]: { number } })
	local keys = clip.keys
	local a, b = keys[1], keys[#keys]
	for i = 1, #keys - 1 do
		if t >= keys[i].t and t <= keys[i + 1].t then
			a, b = keys[i], keys[i + 1]
			break
		end
	end
	local span = b.t - a.t
	local f = span > 0 and smooth(math.clamp((t - a.t) / span, 0, 1)) or 1
	for _, k in ipairs(KEYS) do
		local va, vb = get(a.pose, k), get(b.pose, k)
		local v = out[k]
		for c = 1, 6 do
			local x = (va[c] or 0) + ((vb[c] or 0) - (va[c] or 0)) * f
			v[c] = c <= 3 and wrap(x) or x
		end
	end
end

local function newPose(): { [string]: { number } }
	local p = {}
	for _, k in ipairs(KEYS) do
		p[k] = { 0, 0, 0, 0, 0, 0 }
	end
	return p
end

------------------------------------------------------------------------
-- 전투 자세 (무기별)
------------------------------------------------------------------------
local STANCES: { [number]: Pose } = {
	[1] = { RS = { 40, 0, 15 }, RE = { 50 }, LS = { 45, 0, -25 }, LE = { 60 }, W = { 0, -15, 0 }, R = { -4, 0, 0, 0, -0.15, 0 }, RH = { 10 }, RK = { -15 }, LH = { -5 }, LK = { -10 } },
	[2] = { RS = { 35, 0, 22 }, RE = { 40 }, LS = { 35, 0, -22 }, LE = { 40 }, R = { -6, 0, 0, 0, -0.2, 0 }, RH = { 15 }, RK = { -20 }, LH = { 10 }, LK = { -18 } },
	[3] = { RS = { 25, 0, 25 }, RE = { 35 }, LS = { 15, 0, -15 }, LE = { 20 }, W = { 0, -20, 0 }, RH = { 8 }, RK = { -10 } },
	[4] = { RS = { 20, 0, 25 }, RE = { 70 }, LS = { 40, 0, -20 }, LE = { 70 }, R = { -12, 0, 0, 0, -0.35, 0 }, RH = { 28 }, RK = { -38 }, LH = { 22 }, LK = { -32 } },
	[5] = { RS = { 60, 0, 10 }, RE = { 20 }, LS = { 50, 0, -10 }, LE = { 50 }, W = { 0, -25, 0 }, RH = { 8 }, RK = { -12 } },
}
STANCES[0] = STANCES[1]

------------------------------------------------------------------------
-- 무기별 3단 콤보
------------------------------------------------------------------------
local function clip(dur: number, hit: number, keys: { Key }): Clip
	return { dur = dur, hit = hit, keys = keys }
end
local function k(t: number, pose: Pose): Key
	return { t = t, pose = pose }
end

local GS_CHOP = clip(0.45, 0.38, {
	k(0, {}),
	k(0.22, { RS = { 170, 0, 10 }, RE = { 20 }, LS = { 160, 0, -10 }, LE = { 20 }, W = { 12, -5, 0 }, N = { 8 } }),
	k(0.38, { RS = { 25, 0, 5 }, RE = { 10 }, LS = { 30, 0, -5 }, LE = { 20 }, W = { -25, 0, 0 }, N = { -10 }, R = { -8, 0, 0, 0, -0.5, 0 }, RH = { 40 }, RK = { -50 }, LH = { -20 }, LK = { -10 } }),
	k(0.7, { RS = { 30, 0, 5 }, RE = { 15 }, LS = { 35, 0, -5 }, LE = { 25 }, W = { -18, 0, 0 }, R = { -6, 0, 0, 0, -0.4, 0 }, RH = { 30 }, RK = { -40 } }),
	k(1, {}),
})
local GS_SWEEP = clip(0.45, 0.38, {
	k(0, {}),
	k(0.2, { W = { 0, -60, 0 }, RS = { 80, 0, 80 }, RE = { 30 }, LS = { 70, 0, 30 }, LE = { 60 }, R = { 0, -15, 0 } }),
	k(0.38, { W = { 0, 55, 0 }, RS = { 85, 0, -10 }, RE = { 5 }, LS = { 70, 0, -40 }, LE = { 20 }, R = { 0, 25, 0, 0, -0.2, 0 }, RH = { 20 }, RK = { -30 } }),
	k(0.7, { W = { 0, 45, 0 }, RS = { 80, 0, -5 }, LS = { 60, 0, -30 }, R = { 0, 20, 0 } }),
	k(1, {}),
})
local GS_SPIN = clip(0.6, 0.55, {
	k(0, {}),
	k(0.18, { R = { 0, 0, 0, 0, -0.6, 0 }, RS = { 90, 0, 90 }, LS = { 70, 0, -40 }, W = { 0, -40, 0 }, RH = { 50 }, RK = { -70 }, LH = { 40 }, LK = { -60 } }),
	k(0.55, { R = { 0, 360, 0, 0, 1.1, 0 }, RS = { 90, 0, 90 }, LS = { 90, 0, -90 }, W = { 0, 20, 0 }, RH = { 30 }, LH = { -10 } }),
	k(0.75, { R = { -10, 360, 0, 0, -0.5, 0 }, RS = { 40, 0, 10 }, LS = { 40, 0, -10 }, W = { -20, 0, 0 }, RH = { 45 }, RK = { -60 } }),
	k(1, { R = { 0, 360, 0 } }),
})
local DU_RIGHT = clip(0.3, 0.42, {
	k(0, {}),
	k(0.22, { RS = { 150, 0, 50 }, RE = { 30 }, W = { 0, -25, 0 } }),
	k(0.42, { RS = { 20, 0, -30 }, RE = { 10 }, W = { 0, 30, 0 }, LS = { 40, 0, -30 }, R = { -6, 0, 0, 0, -0.2, 0 } }),
	k(1, {}),
})
local DU_LEFT = clip(0.3, 0.42, {
	k(0, {}),
	k(0.22, { LS = { 150, 0, -50 }, LE = { 30 }, W = { 0, 25, 0 } }),
	k(0.42, { LS = { 20, 0, 30 }, LE = { 10 }, W = { 0, -30, 0 }, RS = { 10, 0, 40 }, R = { -6, 0, 0, 0, -0.2, 0 } }),
	k(1, {}),
})
local DU_CROSS = clip(0.4, 0.42, {
	k(0, {}),
	k(0.22, { RS = { 165, 0, 40 }, LS = { 165, 0, -40 }, W = { 10, 0, 0 }, R = { 0, 0, 0, 0, 0.3, 0 } }),
	k(0.42, { RS = { 40, 0, -50 }, LS = { 40, 0, 50 }, W = { -20, 0, 0 }, R = { -10, 0, 0, 0, -0.45, 0 }, RH = { 40 }, RK = { -55 }, LH = { 30 }, LK = { -45 } }),
	k(0.75, { RS = { 45, 0, -40 }, LS = { 45, 0, 40 }, W = { -12, 0, 0 }, R = { -6, 0, 0, 0, -0.3, 0 } }),
	k(1, {}),
})
local LS_THRUST = clip(0.42, 0.4, {
	k(0, {}),
	k(0.22, { RS = { 70, 0, 10 }, RE = { 110 }, W = { 0, -35, 0 }, R = { 0, -10, 0 } }),
	k(0.4, { RS = { 90, 0, 0 }, RE = { 0 }, W = { -10, 25, 0 }, R = { -12, 10, 0, 0, -0.35, 0 }, RH = { 50 }, RK = { -35 }, LH = { -30 }, LK = { -10 }, LS = { 0, 0, -40 } }),
	k(0.75, { RS = { 85, 0, 0 }, RE = { 10 }, W = { -6, 15, 0 }, R = { -8, 5, 0, 0, -0.25, 0 }, RH = { 35 } }),
	k(1, {}),
})
local LS_RISE = clip(0.42, 0.4, {
	k(0, {}),
	k(0.22, { RS = { -20, 0, 30 }, RE = { 10 }, W = { 0, -20, 0 }, R = { 0, 0, 0, 0, -0.45, 0 }, RH = { 40 }, RK = { -60 } }),
	k(0.4, { RS = { 170, 0, 20 }, RE = { 10 }, W = { 15, 20, 0 }, R = { 0, 0, 0, 0, 0.35, 0 }, N = { 15 } }),
	k(0.75, { RS = { 150, 0, 20 }, W = { 8, 10, 0 } }),
	k(1, {}),
})
local LS_WIDE = clip(0.45, 0.4, {
	k(0, {}),
	k(0.2, { W = { 0, -70, 0 }, RS = { 90, 0, 90 }, RE = { 10 }, R = { 0, -20, 0 } }),
	k(0.4, { W = { 0, 70, 0 }, RS = { 90, 0, -20 }, RE = { 0 }, R = { -6, 30, 0, 0, -0.3, 0 }, RH = { 30 }, RK = { -30 } }),
	k(0.7, { W = { 0, 55, 0 }, RS = { 85, 0, -10 }, R = { 0, 25, 0 } }),
	k(1, {}),
})
local DG_STAB = clip(0.28, 0.4, {
	k(0, {}),
	k(0.2, { RS = { 50, 0, 10 }, RE = { 110 }, W = { 0, -15, 0 } }),
	k(0.4, { RS = { 95, 0, 0 }, RE = { 0 }, W = { -8, 15, 0 }, R = { -10, 0, 0, 0, -0.3, 0 } }),
	k(1, {}),
})
local DG_BACK = clip(0.3, 0.4, {
	k(0, {}),
	k(0.2, { RS = { 80, 0, -40 }, RE = { 60 }, W = { 0, 40, 0 } }),
	k(0.4, { RS = { 80, 0, 75 }, RE = { 10 }, W = { 0, -40, 0 }, R = { 0, -15, 0, 0, -0.2, 0 } }),
	k(1, {}),
})
local DG_FLIP = clip(0.5, 0.62, {
	k(0, {}),
	k(0.15, { R = { 0, 0, 0, 0, -0.6, 0 }, RH = { 60 }, RK = { -90 }, LH = { 60 }, LK = { -90 }, RS = { 150, 0, 20 } }),
	k(0.5, { R = { -300, 0, 0, 0, 1.6, 0 }, RH = { 90 }, RK = { -110 }, LH = { 90 }, LK = { -110 }, RS = { 160, 0, 10 }, LS = { 120, 0, -20 } }),
	k(0.62, { R = { -360, 0, 0, 0, -0.4, 0 }, RS = { 30, 0, 0 }, RE = { 0 }, W = { -20, 0, 0 }, RH = { 50 }, RK = { -70 } }),
	k(1, { R = { -360, 0, 0 } }),
})
local SC_REAP = clip(0.5, 0.4, {
	k(0, {}),
	k(0.22, { W = { 0, -80, 0 }, RS = { 90, 0, 60 }, LS = { 80, 0, 10 }, LE = { 30 }, R = { 0, -25, 0 } }),
	k(0.4, { W = { 0, 80, 0 }, RS = { 90, 0, -20 }, LS = { 70, 0, -50 }, R = { -6, 30, 0, 0, -0.3, 0 }, RH = { 30 }, RK = { -40 } }),
	k(0.72, { W = { 0, 60, 0 }, RS = { 85, 0, -10 }, LS = { 60, 0, -40 } }),
	k(1, {}),
})
local SC_OVER = clip(0.5, 0.4, {
	k(0, {}),
	k(0.22, { RS = { 170, 0, 10 }, LS = { 160, 0, -10 }, W = { 15, 0, 0 }, N = { 10 } }),
	k(0.4, { RS = { 40, 0, 0 }, LS = { 50, 0, 0 }, W = { -25, 0, 0 }, R = { -8, 0, 0, 0, -0.5, 0 }, RH = { 45 }, RK = { -60 }, LH = { -15 } }),
	k(0.72, { RS = { 30, 0, 20 }, LS = { 40, 0, -20 }, W = { -15, -20, 0 } }),
	k(1, {}),
})
local SC_SPIN = clip(0.6, 0.5, {
	k(0, {}),
	k(0.15, { RS = { 90, 0, 90 }, LS = { 90, 0, -90 }, R = { 0, 0, 0, 0, -0.3, 0 } }),
	k(0.75, { R = { 0, 720, 0, 0, 0.3, 0 }, RS = { 90, 0, 90 }, LS = { 90, 0, -90 }, W = { 0, 15, 0 } }),
	k(1, { R = { 0, 720, 0 } }),
})

local COMBOS: { [number]: { Clip } } = {
	[1] = { GS_CHOP, GS_SWEEP, GS_SPIN },
	[2] = { DU_RIGHT, DU_LEFT, DU_CROSS },
	[3] = { LS_THRUST, LS_RISE, LS_WIDE },
	[4] = { DG_STAB, DG_BACK, DG_FLIP },
	[5] = { SC_REAP, SC_OVER, SC_SPIN },
	[0] = { GS_CHOP, SC_SPIN, GS_SPIN },
}

-- 구르기: 앞으로 한 바퀴
local ROLL = clip(0.36, 0.5, {
	k(0, {}),
	k(0.15, { R = { -60, 0, 0, 0, -0.9, 0 }, RH = { 90 }, RK = { -110 }, LH = { 90 }, LK = { -110 }, RS = { 60 }, LS = { 60 }, N = { -20 } }),
	k(0.75, { R = { -330, 0, 0, 0, -0.9, 0 }, RH = { 100 }, RK = { -120 }, LH = { 100 }, LK = { -120 }, RS = { 70 }, LS = { 70 } }),
	k(1, { R = { -360, 0, 0 } }),
})

-- 스킬 자세 (스킬 id별)
local SKILLS: { [string]: Clip } = {
	charge = clip(0.45, 0.5, { k(0, {}), k(0.3, { R = { -22, 0, 0, 0, -0.35, 0 }, RS = { 60, 0, 30 }, LS = { 40, 0, -20 }, W = { -15, 0, 0 }, RH = { 50 }, RK = { -30 }, LH = { -30 } }), k(0.8, { R = { -18, 0, 0, 0, -0.3, 0 }, RS = { 60, 0, 30 } }), k(1, {}) }),
	boomerang = clip(0.5, 0.45, { k(0, {}), k(0.3, { RS = { 150, 0, 60 }, W = { 0, -40, 0 }, R = { 0, -15, 0 } }), k(0.45, { RS = { 80, 0, -20 }, W = { 0, 40, 0 }, R = { -8, 15, 0 } }), k(1, {}) }),
	mark = clip(0.45, 0.4, { k(0, {}), k(0.4, { RS = { 95, 0, 0 }, RE = { 0 }, W = { 0, 20, 0 }, N = { -5 } }), k(1, {}) }),
	phantom = clip(0.4, 0.5, { k(0, {}), k(0.3, { R = { -30, 0, 0, 0, -0.5, 0 }, RS = { -20, 0, 30 }, LS = { -20, 0, -30 }, RH = { 60 }, RK = { -60 } }), k(1, {}) }),
	wave = GS_CHOP,
	parry = clip(1.2, 0.2, { k(0, {}), k(0.12, { RS = { 110, 0, 60 }, RE = { 70 }, LS = { 90, 0, -30 }, LE = { 90 }, R = { 0, 0, 0, 0, -0.4, 0 }, RH = { 30 }, RK = { -45 }, LH = { 25 }, LK = { -40 } }), k(0.9, { RS = { 110, 0, 60 }, RE = { 70 }, LS = { 90, 0, -30 }, LE = { 90 }, R = { 0, 0, 0, 0, -0.4, 0 } }), k(1, {}) }),
	poison = clip(0.6, 0.5, { k(0, {}), k(0.4, { RS = { 110, 0, -30 }, RE = { 100 }, N = { -15 }, W = { 0, 15, 0 } }), k(0.8, { RS = { 100, 0, -20 }, RE = { 90 } }), k(1, {}) }),
	smoke = clip(0.5, 0.3, { k(0, {}), k(0.3, { R = { -20, 0, 0, 0, -0.9, 0 }, RH = { 80 }, RK = { -110 }, LH = { 80 }, LK = { -110 }, RS = { 60, 0, -40 }, LS = { 60, 0, 40 } }), k(1, {}) }),
	hook = clip(0.6, 0.35, { k(0, {}), k(0.2, { RS = { 150, 0, 30 }, W = { 0, -20, 0 } }), k(0.35, { RS = { 90, 0, 0 }, W = { 0, 10, 0 } }), k(0.7, { RS = { 40, 0, 40 }, W = { 10, -30, 0 }, R = { 8, 0, 0 } }), k(1, {}) }),
	zone = clip(0.7, 0.4, { k(0, {}), k(0.3, { RS = { 170, 0, 0 }, LS = { 170, 0, 0 }, N = { 15 } }), k(0.8, { RS = { 170, 0, 0 }, LS = { 170, 0, 0 }, R = { 0, 360, 0 } }), k(1, { R = { 0, 360, 0 } }) }),
	rain = clip(0.7, 0.4, { k(0, {}), k(0.35, { RS = { 170, 0, 30 }, LS = { 170, 0, -30 }, N = { 25 }, W = { 12, 0, 0 } }), k(0.8, { RS = { 165, 0, 30 }, LS = { 165, 0, -30 } }), k(1, {}) }),
	timestop = clip(0.7, 0.4, { k(0, {}), k(0.3, { LS = { 90, 0, 0 }, LE = { 0 }, RS = { 20, 0, 20 }, W = { 0, -20, 0 } }), k(0.8, { LS = { 90, 0, 0 }, LE = { 0 } }), k(1, {}) }),
}

-- 필살기 자세 (무기별)
local ULTS: { [number]: Clip } = {
	[1] = clip(0.7, 0.4, { k(0, {}), k(0.25, { R = { 0, 0, 0, 0, 1.6, 0 }, RS = { 175, 0, 10 }, LS = { 170, 0, -10 }, W = { 15, 0, 0 } }), k(0.4, { R = { -10, 0, 0, 0, -0.8, 0 }, RS = { 20, 0, 0 }, LS = { 25, 0, 0 }, W = { -30, 0, 0 }, RH = { 60 }, RK = { -80 }, LH = { -20 } }), k(0.8, { R = { -6, 0, 0, 0, -0.6, 0 }, RS = { 25 }, LS = { 30 }, W = { -20, 0, 0 } }), k(1, {}) }),
	[2] = clip(2.5, 0.1, { k(0, { RS = { 90, 0, 90 }, LS = { 90, 0, -90 } }), k(1, { R = { 0, 1800, 0 }, RS = { 90, 0, 90 }, LS = { 90, 0, -90 } }) }),
	[3] = clip(0.6, 0.3, { k(0, {}), k(0.15, { R = { -25, 0, 0, 0, -0.6, 0 }, RS = { 60, 0, 20 }, RE = { 100 }, RH = { 70 }, RK = { -60 } }), k(0.3, { R = { -15, 0, 0, 0, -0.3, 0 }, RS = { 95, 0, 0 }, RE = { 0 }, W = { -10, 30, 0 }, LS = { -30, 0, -30 } }), k(0.8, { RS = { 90, 0, -10 }, W = { 0, 40, 0 } }), k(1, {}) }),
	[4] = clip(0.8, 0.3, { k(0, {}), k(0.3, { R = { -360, 0, 0, 0, 1.4, 0 }, RS = { 160 }, LS = { 160 } }), k(0.5, { R = { -360, 0, 0, 0, -0.3, 0 }, RS = { 95, 0, 0 }, RE = { 0 } }), k(1, { R = { -360, 0, 0 } }) }),
	[5] = clip(0.9, 0.4, { k(0, {}), k(0.3, { RS = { 170, 0, 0 }, LS = { 170, 0, 0 }, R = { 0, 0, 0, 0, 1, 0 } }), k(0.8, { R = { 0, 720, 0, 0, -0.3, 0 }, RS = { 90, 0, 90 }, LS = { 90, 0, -90 } }), k(1, { R = { 0, 720, 0 } }) }),
	[0] = clip(1.0, 0.4, { k(0, {}), k(0.35, { R = { 0, 0, 0, 0, 2.2, 0 }, RS = { 178, 0, 5 }, LS = { 175, 0, -5 }, N = { 25 }, W = { 15, 0, 0 } }), k(0.5, { R = { -12, 0, 0, 0, -0.8, 0 }, RS = { 15 }, LS = { 20 }, W = { -35, 0, 0 }, RH = { 70 }, RK = { -90 } }), k(0.85, { R = { -6, 0, 0, 0, -0.5, 0 }, RS = { 25 }, W = { -20, 0, 0 } }), k(1, {}) }),
}

local VICTORY = clip(1.6, 0.3, {
	k(0, {}),
	k(0.25, { RS = { 172, 0, 20 }, RE = { 10 }, LS = { 20, 0, -60 }, LE = { 80 }, N = { 18 }, W = { 10, 0, 0 } }),
	k(0.85, { RS = { 172, 0, 20 }, RE = { 10 }, LS = { 20, 0, -60 }, LE = { 80 }, N = { 18 }, W = { 10, 0, 0 } }),
	k(1, {}),
})

-- 적 동작: 경고 시간 T 동안 들어 올렸다가 내려친다
local function enemyClip(kind: string, T: number): Clip
	local d = T + 0.45
	local w = T / d
	local s = (T + 0.12) / d
	if kind == "slam" then
		return clip(d, s, { k(0, {}), k(w, { RS = { 172, 0, 10 }, LS = { 172, 0, -10 }, W = { 15, 0, 0 }, N = { 10 }, R = { 0, 0, 0, 0, 0.3, 0 } }), k(s, { RS = { 40 }, LS = { 40 }, W = { -30, 0, 0 }, R = { -8, 0, 0, 0, -0.6, 0 }, RH = { 40 }, RK = { -60 } }), k(1, {}) })
	elseif kind == "cast" then
		return clip(d, s, { k(0, {}), k(w, { RS = { 135, 0, 40 }, LS = { 135, 0, -40 }, N = { 15 }, W = { 10, 0, 0 } }), k(s, { RS = { 90 }, LS = { 90 }, W = { -10, 0, 0 } }), k(1, {}) })
	elseif kind == "charge" then
		return clip(T + 0.6, w, { k(0, {}), k(0.4, { R = { -25, 0, 0, 0, -0.5, 0 }, RS = { -30 }, LS = { -30 }, RH = { 50 }, RK = { -50 }, W = { -10, 0, 0 } }), k(0.9, { R = { -25, 0, 0, 0, -0.5, 0 }, RS = { -30 }, LS = { -30 } }), k(1, {}) })
	elseif kind == "spin" then
		return clip(T + 1.6, w, { k(0, {}), k(0.3, { RS = { 90, 0, 90 }, LS = { 90, 0, -90 } }), k(0.9, { RS = { 90, 0, 90 }, LS = { 90, 0, -90 } }), k(1, {}) })
	elseif kind == "shoot" then
		return clip(d, s, { k(0, {}), k(w, { LS = { 90, 0, 0 }, LE = { 0 }, RS = { 90, 0, 30 }, RE = { 120 }, W = { 0, 30, 0 } }), k(s, { LS = { 90 }, RS = { 80, 0, 40 }, RE = { 20 }, W = { 0, 30, 0 } }), k(1, {}) })
	elseif kind == "combo" then
		return clip(d, s, { k(0, {}), k(w, { RS = { 150, 0, 50 }, W = { 0, -40, 0 }, R = { -10, 0, 0, 0, -0.3, 0 } }), k(1, {}) })
	end
	return clip(d, s, { k(0, {}), k(w, { RS = { 150, 0, 30 }, RE = { 30 }, W = { 5, -30, 0 } }), k(s, { RS = { 20, 0, -10 }, RE = { 10 }, W = { -15, 25, 0 } }), k(1, {}) })
end

------------------------------------------------------------------------
-- 인형 (관절 묶음)
------------------------------------------------------------------------
type Rig = {
	model: Model,
	motors: { [string]: Motor6D },
	lastSet: { [Motor6D]: CFrame },
	lastBase: { [Motor6D]: CFrame },
	action: Clip?,
	actionT: number,
	actionSpeed: number,
	flinch: number,
	flinchSide: number,
	stanceW: number,
	isPlayer: boolean,
}

local rigs: { [Model]: Rig } = {}
local playerModel: Model? = nil
local combatType: number? = nil
local freezeUntil = 0

local function getRig(model: Model, isPlayer: boolean): Rig?
	local r = rigs[model]
	if r then
		return r
	end
	local motors = {}
	local any = false
	for short, joint in pairs(JOINT_NAMES) do
		local part = model:FindFirstChild(JOINT_PARTS[joint])
		local m = part and part:FindFirstChild(joint)
		if m and m:IsA("Motor6D") then
			motors[short] = m
			any = true
		end
	end
	if not any then
		return nil
	end
	r = {
		model = model,
		motors = motors,
		lastSet = {},
		lastBase = {},
		action = nil,
		actionT = 0,
		actionSpeed = 1,
		flinch = 0,
		flinchSide = 1,
		stanceW = 0,
		isPlayer = isPlayer,
	}
	rigs[model] = r
	return r
end

local function playOn(r: Rig, c: Clip, speed: number?)
	r.action = c
	r.actionT = 0
	r.actionSpeed = speed or 1
end

local work = newPose()
local stancePose = newPose()

-- 거의 같은 자세인가 (관절 값을 읽으면 소수점 끝이 조금 달라질 수 있다)
local function near(a: CFrame, b: CFrame): boolean
	if (a.Position - b.Position).Magnitude > 1e-3 then
		return false
	end
	return a.LookVector:Dot(b.LookVector) > 0.99999 and a.UpVector:Dot(b.UpVector) > 0.99999
end

local function toCFrame(v: { number }): CFrame
	return CFrame.new(v[4], v[5], v[6]) * CFrame.Angles(math.rad(v[1]), math.rad(v[2]), math.rad(v[3]))
end

local function updateRig(r: Rig, dt: number, now: number)
	-- 동작 시간
	local frozen = r.isPlayer and now < freezeUntil
	local actionW = 0
	local c = r.action
	if c then
		if not frozen then
			r.actionT += dt * r.actionSpeed / c.dur
		end
		if r.actionT >= 1 then
			r.action = nil
			c = nil
		else
			local t = r.actionT
			-- 시작과 끝을 부드럽게 이어 붙인다
			actionW = math.min(1, t / 0.08, (1 - t) / 0.12)
			actionW = math.clamp(actionW, 0, 1)
		end
	end

	-- 전투 자세 (내 캐릭터만)
	local stance: Pose? = nil
	if r.isPlayer and combatType ~= nil then
		stance = STANCES[combatType] or STANCES[1]
		r.stanceW = math.min(1, r.stanceW + dt * 4)
	else
		r.stanceW = math.max(0, r.stanceW - dt * 4)
	end
	local moving = false
	if r.isPlayer then
		local hum = r.model:FindFirstChildOfClass("Humanoid")
		moving = hum ~= nil and hum.MoveDirection.Magnitude > 0.1
	end
	for _, key in ipairs(KEYS) do
		local sv = stancePose[key]
		local src = stance and stance[key]
		for i = 1, 6 do
			sv[i] = (src and src[i] or 0) * r.stanceW
		end
	end
	-- 달릴 때는 다리 자세를 풀고 몸을 앞으로 기울인다
	if moving then
		for _, key in ipairs({ "RH", "RK", "LH", "LK" }) do
			local sv = stancePose[key]
			for i = 1, 6 do
				sv[i] = 0
			end
		end
		stancePose.R[1] -= 10 * r.stanceW
		stancePose.R[5] = 0
		stancePose.W[2] *= 0.5
	elseif r.isPlayer and r.stanceW > 0 then
		-- 숨쉬기
		stancePose.W[1] += math.sin(now * 2.2) * 2 * r.stanceW
	end

	if c then
		samplePose(c, r.actionT, work)
	end
	local fl = r.flinch
	if fl > 0 then
		r.flinch = math.max(0, fl - dt * 5)
	end

	for short, motor in pairs(r.motors) do
		if motor.Parent then
			local sv = stancePose[short]
			local wv = work[short]
			local v1, v2, v3, v4, v5, v6 = sv[1], sv[2], sv[3], sv[4], sv[5], sv[6]
			if c and actionW > 0 then
				v1 += (wv[1] - v1) * actionW
				v2 += (wv[2] - v2) * actionW
				v3 += (wv[3] - v3) * actionW
				v4 += (wv[4] - v4) * actionW
				v5 += (wv[5] - v5) * actionW
				v6 += (wv[6] - v6) * actionW
			end
			if fl > 0 then
				-- 맞으면 상체가 뒤로 젖혀지고 고개가 흔들린다
				if short == "W" then
					v1 += 22 * fl
					v2 += 12 * fl * r.flinchSide
				elseif short == "N" then
					v1 += 18 * fl
				elseif short == "RS" or short == "LS" then
					v1 -= 15 * fl
				end
			end
			local cur = motor.Transform
			local base = cur
			local last = r.lastSet[motor]
			-- 지난 프레임에 내가 넣은 값 그대로면 애니메이션이 덮어쓰지 않은 것: 원래 값에서 다시 계산
			if last and (cur == last or near(cur, last)) then
				base = r.lastBase[motor] or cur
			end
			local out
			if v1 == 0 and v2 == 0 and v3 == 0 and v4 == 0 and v5 == 0 and v6 == 0 then
				out = base
			else
				out = base * toCFrame({ v1, v2, v3, v4, v5, v6 })
			end
			motor.Transform = out
			r.lastBase[motor] = base
			r.lastSet[motor] = out
		end
	end
end

local started = false
local warned = false
local function start()
	if started then
		return
	end
	started = true
	RunService.Stepped:Connect(function(_time, dt)
		local now = os.clock()
		local step = math.min(dt or (1 / 60), 0.1)
		for model, r in pairs(rigs) do
			if not model.Parent then
				rigs[model] = nil
			else
				local ok, err = pcall(updateRig, r, step, now)
				if not ok then
					rigs[model] = nil
					if not warned then
						warned = true
						warn("[Arena] 동작 오류:", err)
					end
				end
			end
		end
	end)
end

------------------------------------------------------------------------
-- 바깥에서 부르는 함수
------------------------------------------------------------------------
-- 내 캐릭터 지정 (캐릭터가 새로 생길 때마다)
function Motion.setCharacter(char: Model?)
	if playerModel and rigs[playerModel] then
		rigs[playerModel] = nil
	end
	playerModel = char
	if char then
		getRig(char, true)
	end
	start()
end

-- 전투 자세 켜기/끄기 (무기 계열)
function Motion.setCombat(typeId: number?)
	combatType = typeId
end

local function myRig(): Rig?
	local m = playerModel
	if not m or not m.Parent then
		return nil
	end
	return rigs[m] or getRig(m, true)
end

-- 기본 공격. 칼이 닿는 순간까지 걸리는 시간(초)을 돌려준다
function Motion.attack(typeId: number, step: number, cooldown: number): number
	local r = myRig()
	if not r then
		return 0
	end
	local list = COMBOS[typeId] or COMBOS[1]
	local c = list[math.clamp(step or 1, 1, 3)]
	local speed = math.max(1, c.dur / ((cooldown or 0.5) + 0.12))
	playOn(r, c, speed)
	return c.hit * c.dur / speed
end

function Motion.roll()
	local r = myRig()
	if r then
		playOn(r, ROLL, 1)
	end
end

function Motion.skill(id: string)
	local r = myRig()
	local c = SKILLS[id]
	if r and c then
		playOn(r, c, 1)
	end
end

function Motion.ult(typeId: number)
	local r = myRig()
	local c = ULTS[typeId] or ULTS[1]
	if r then
		playOn(r, c, 1)
	end
end

function Motion.victory()
	local r = myRig()
	if r then
		playOn(r, VICTORY, 1)
	end
end

-- 히트스톱: 내 동작을 아주 잠깐 멈춘다
function Motion.hitStop(duration: number)
	local now = os.clock()
	if now >= freezeUntil then
		freezeUntil = now + duration
	end
end

-- 맞아서 움찔 (내 캐릭터 또는 적 모델)
function Motion.flinch(model: Instance?, strength: number?, side: number?)
	if not model or not model:IsA("Model") then
		return
	end
	local r = rigs[model :: Model] or getRig(model :: Model, model == playerModel)
	if r then
		r.flinch = math.clamp(strength or 1, 0, 1.5)
		r.flinchSide = side or ((math.random() < 0.5) and -1 or 1)
		start()
	end
end

-- 적 공격 동작 (서버가 모델 속성으로 알려 준다)
function Motion.enemy(model: Model, kind: string, windup: number)
	local r = rigs[model] or getRig(model, false)
	if r then
		playOn(r, enemyClip(kind, math.max(0.05, windup)), 1)
		start()
	end
end

return Motion
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>

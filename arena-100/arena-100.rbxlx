	new("Frame", {
		Size = UDim2.new(0, 6, 1, -10),
		Position = UDim2.new(0, 5, 0, 5),
		BackgroundColor3 = section.color,
		BorderSizePixel = 0,
		Parent = row,
	}, { corner(3) })
	local grade = Config.getGrade(n)
	local nameLabel = text({
		Position = UDim2.new(0, 20, 0, 4),

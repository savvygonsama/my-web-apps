-- 아우라와 킬 이펙트: 스테이지를 깨면 열리고 코인으로 산다. 좋을수록 세진다
--   아우라: 공격력·체력 배율 + (4단계부터) 주기적으로 주위 적에게 피해를 주는 파동
--   킬 이펙트: 공격력 배율 + 적을 잡으면 그 자리가 터져 주위 적에게 피해 (연쇄 폭발)
------------------------------------------------------------------------
Config.Auras = {
	{ name = "불씨", desc = "발밑에서 불씨가 피어오른다" },
	{ name = "서리 숨결", desc = "차가운 안개와 얼음 결정" },
	{ name = "정전기", desc = "몸 주위로 작은 번개가 튄다" },
	{ name = "새싹 바람", desc = "잎사귀가 몸을 감싸 돈다" },
	{ name = "그림자 안개", desc = "검은 연기가 발밑을 덮는다" },
	{ name = "여명", desc = "등 뒤로 은은한 빛 원반" },
	{ name = "핏빛 안개", desc = "붉은 안개와 핏방울" },
	{ name = "공허 먼지", desc = "보랏빛 먼지가 빨려 든다" },
	{ name = "별가루", desc = "반짝이는 별이 쏟아진다" },
	{ name = "수정 결정", desc = "수정 조각이 몸을 두른다" },
	{ name = "화염 소용돌이", desc = "불꽃이 나선으로 감아 오른다" },
	{ name = "눈보라 장막", desc = "얼음 칼날이 회오리친다" },
	{ name = "뇌운", desc = "머리 위 먹구름에서 번개" },
	{ name = "세계수 가지", desc = "빛나는 가지가 등에서 뻗는다" },
	{ name = "밤의 망토", desc = "그림자 날개가 펄럭인다" },
	{ name = "천사의 후광", desc = "황금 후광과 빛의 날개" },
	{ name = "혈월", desc = "등 뒤에 붉은 달이 뜬다" },
	{ name = "블랙홀", desc = "발밑에서 모든 것을 삼킨다" },
	{ name = "은하수", desc = "별의 띠가 몸을 감싼다" },
	{ name = "프리즘", desc = "일곱 빛깔 결정 왕관" },
	{ name = "용의 숨결", desc = "용의 날개와 불꽃 기둥" },
	{ name = "절대영도", desc = "얼어붙은 왕관과 빙결 날개" },
	{ name = "뇌신의 분노", desc = "번개 고리와 떠다니는 뇌창" },
	{ name = "생명의 정원", desc = "꽃잎 폭풍과 세계수 날개" },
	{ name = "심연의 눈", desc = "등 뒤에서 거대한 눈이 노려본다" },
	{ name = "대천사의 날개", desc = "날개 두 쌍과 빛의 검 고리" },
	{ name = "진홍의 군주", desc = "핏빛 왕관과 검 여덟 자루" },
	{ name = "사건의 지평선", desc = "검은 고리 세 겹과 빛의 띠" },
	{ name = "초신성", desc = "몸에서 별이 폭발한다" },
	{ name = "무한의 근원", desc = "모든 빛이 모인 궁극의 아우라" },
}

Config.KillFx = {
	{ name = "불꽃 터짐", desc = "적이 불꽃으로 터진다" },
	{ name = "얼음 파편", desc = "얼어붙어 산산조각" },
	{ name = "낙뢰", desc = "하늘에서 번개가 꽂힌다" },
	{ name = "꽃잎 흩날림", desc = "꽃잎이 되어 흩어진다" },
	{ name = "그림자 흡수", desc = "그림자 속으로 빨려 든다" },
	{ name = "빛의 기둥", desc = "빛기둥이 적을 지운다" },
	{ name = "핏빛 초승달", desc = "붉은 초승달이 X자로 벤다" },
	{ name = "공허 붕괴", desc = "작은 블랙홀로 무너진다" },
	{ name = "별 폭죽", desc = "별이 사방으로 터진다" },
	{ name = "수정 감옥", desc = "수정에 갇혔다가 깨진다" },
	{ name = "화산 분출", desc = "바닥이 갈라지며 불기둥" },
	{ name = "빙결 쇄도", desc = "얼음 가시가 원으로 솟는다" },
	{ name = "뇌전 사슬", desc = "번개가 주위 적에게 튄다" },
	{ name = "덩굴 휘감기", desc = "덩굴이 감아 조인다" },
	{ name = "망령의 비명", desc = "해골 유령이 솟아오른다" },
	{ name = "천벌", desc = "하늘에서 빛의 검이 떨어진다" },
	{ name = "피의 분수", desc = "핏빛 분수와 초승달" },
	{ name = "블랙홀", desc = "주위를 빨아들이고 터진다" },
	{ name = "유성우", desc = "유성이 쏟아진다" },
	{ name = "프리즘 굴절", desc = "무지개 빛줄기가 뻗는다" },
	{ name = "용의 불기둥", desc = "나선 불기둥이 솟는다" },
	{ name = "절대영도", desc = "얼음 동상이 되어 부서진다" },
	{ name = "천둥신의 망치", desc = "거대한 망치가 내려친다" },
	{ name = "불사조", desc = "불사조가 날아오른다" },
	{ name = "차원 절단", desc = "공간이 X자로 갈라진다" },
	{ name = "대천사 강림", desc = "날개와 함께 심판의 빛" },
	{ name = "혈월", desc = "붉은 달이 떠올라 터진다" },
	{ name = "사건의 지평선", desc = "검은 고리가 모든 것을 지운다" },
	{ name = "초신성", desc = "별이 폭발하는 대폭발" },
	{ name = "빅뱅", desc = "우주가 다시 태어난다" },
}

------------------------------------------------------------------------
-- 함수
------------------------------------------------------------------------
function Config.getGrade(g)
	return Config.Grades[math.clamp(g, 1, Config.MAX_GRADE)]
end

function Config.getSection(g)
	for i, s in ipairs(Config.Sections) do
		if g >= s.from and g <= s.to then
			return s, i
		end
	end
	return Config.Sections[#Config.Sections], #Config.Sections
end

function Config.mergeCost(g)
	return (Config.getSection(g)).mergeCost
end

-- 1등급: 대검 전설, 쌍검 영웅, 장검 희귀, 단검 고급, 낫 일반
-- 등급이 하나 오를 때마다 한 칸씩 밀린다 (2등급은 낫이 전설)
function Config.rarityRank(g, typeId)
	if typeId == 0 then
		return 5
	end
	return 5 - ((typeId - 1 + g - 1) % 5)
end

function Config.itemKey(g, typeId)
	if typeId == 0 then
		return Config.ALLROUNDER_KEY
	end
	return string.format("%d_%d", g, typeId)
end

-- 키를 등급, 계열로 나눈다. 잘못된 키면 nil
function Config.parseKey(key)
	if type(key) ~= "string" then
		return nil
	end
	if key == Config.ALLROUNDER_KEY then
		return Config.MAX_GRADE, 0
	end
	local gs, ts = string.match(key, "^(%d+)_(%d)$")
	if not gs then
		return nil
	end
	local g, t = tonumber(gs), tonumber(ts)
	if not g or not t or g < 1 or g > Config.MAX_GRADE or t < 1 or t > 5 then
		return nil
	end
	return g, t
end

function Config.weaponType(typeId)
	if typeId == 0 then
		return Config.AllRounder
	end
	return Config.WeaponTypes[typeId]
end

local function growth(g)
	return Config.GRADE_GROWTH ^ (g - 1)
end

-- 무기 하나의 정보
function Config.weaponInfo(key)
	local g, t = Config.parseKey(key)
	if not g then
		return nil
	end
	local wt = Config.weaponType(t)
	local rarity = Config.Rarities[Config.rarityRank(g, t)]
	local grade = Config.getGrade(g)
	local name
	if t == 0 then
		name = "올라운더"
	else
		name = grade.en .. " " .. wt.name
	end
	return {
		key = key,
		grade = g,
		typeId = t,
		type = wt,
		rarity = rarity,
		gradeData = grade,
		name = name,
		atk = Config.BASE_ATK * growth(g) * rarity.mult * wt.dmg,
	}
end

-- 공격 1회 기대 배율 (치명타 포함)
function Config.critFactor(wt)
	local c = wt.critChance or 0
	local m = wt.critMult or 1
	return 1 + c * (m - 1)
end

------------------------------------------------------------------------
-- 스테이지: 1~100은 등급과 같고, 101~200은 초월 스테이지
------------------------------------------------------------------------
Config.BEYOND_GROWTH = 1.065 -- 초월 스테이지 하나당 강해지는 배율
Config.BEYOND_COIN_GROWTH = 1.08

-- 적의 세기 배율 (1스테이지 = 1)
function Config.stageScale(n: number): number
	if n <= Config.MAX_GRADE then
		return growth(n)
	end
	return growth(Config.MAX_GRADE) * Config.BEYOND_GROWTH ^ (n - Config.MAX_GRADE)
end

-- 한 판을 이기면 받는 코인 (보스는 5배)
function Config.stageCoins(n: number): number
	if n <= Config.MAX_GRADE then
		return math.floor(20 * 1.6 ^ (n - 1))
	end
	return math.floor(20 * 1.6 ^ (Config.MAX_GRADE - 1) * Config.BEYOND_COIN_GROWTH ^ (n - Config.MAX_GRADE))
end

-- 생김새에 쓰는 등급. 초월 스테이지는 80~100등급 디자인을 돌려 쓴다
function Config.stageGrade(n: number): number
	if n <= Config.MAX_GRADE then
		return math.max(1, n)
	end
	return 80 + ((n - Config.MAX_GRADE - 1) % 21)
end

function Config.isBeyond(n: number): boolean
	return n > Config.MAX_GRADE
end

-- 스테이지 이름 (영어, 한국어)
function Config.stageName(n: number): (string, string)
	if n <= Config.MAX_GRADE then
		local g = Config.getGrade(n)
		return g.en, g.ko
	end
	local g = Config.getGrade(Config.stageGrade(n))
	return string.format("BEYOND %d", n - Config.MAX_GRADE), string.format("초월 %d층 · %s의 그림자", n - Config.MAX_GRADE, g.ko)
end

------------------------------------------------------------------------
-- 강화, 아우라, 킬 이펙트 수치
------------------------------------------------------------------------
-- 강화 비용: 그 등급 스테이지 한 판 코인 × 0.6 × 1.45^단계
function Config.enhanceCost(grade: number, level: number): number
	return math.floor(Config.stageCoins(grade) * 0.6 * 1.45 ^ level) + 10
end

for k, a in ipairs(Config.Auras) do
	local p = k / #Config.Auras
	a.id = k
	a.motif = ((k - 1) % 10) + 1
	a.unlock = 1 + math.floor((k - 1) * 6.75)
	a.cost = Config.stageCoins(a.unlock) * 6
	a.atk = 1 + 2 * p ^ 1.5 -- 30단계: 공격력 3배
	a.hp = 1 + p ^ 1.5 -- 30단계: 체력 2배
	if k >= 4 then
		a.pulse = {
			interval = math.max(1, 3.2 - k * 0.07),
			radius = 8 + k * 0.4,
			mult = 0.3 + k * 0.05,
		}
	end
end

for k, f in ipairs(Config.KillFx) do
	local p = k / #Config.KillFx
	f.id = k
	f.motif = ((k - 1) % 10) + 1
	f.unlock = math.min(Config.MAX_STAGE, 3 + math.floor((k - 1) * 6.75))
	f.cost = Config.stageCoins(f.unlock) * 6
	f.atk = 1 + 1.5 * p ^ 1.5 -- 30단계: 공격력 2.5배
	f.blast = {
		radius = 6 + k * 0.3,
		mult = 0.5 + k * 0.1,
	}
end

-- 장착 무기 + 훈련 레벨 + 강화·아우라·킬 이펙트로 실제 능력치 계산
-- extra = { enh = 강화 단계, aura = 아우라 단계, kill = 킬 이펙트 단계 }
function Config.playerStats(key, atkLv, hpLv, extra: any?)
	local info = Config.weaponInfo(key) or Config.weaponInfo(Config.STARTER_KEY)
	local wt = info.type
	local x = extra or {}
	local enh = math.clamp(math.floor(tonumber(x.enh) or 0), 0, Config.MAX_ENHANCE)
	local aura = Config.Auras[x.aura or 0]
	local killFx = Config.KillFx[x.kill or 0]
	local atkMul = (1 + Config.ENHANCE_ATK * enh) * (aura and aura.atk or 1) * (killFx and killFx.atk or 1)
	local hpMul = (1 + Config.ENHANCE_HP * enh) * (aura and aura.hp or 1)
	local atk = info.atk * (1 + Config.TRAIN_BONUS * (atkLv or 0)) * atkMul
	local maxHp = Config.BASE_HP * growth(info.grade) * (1 + Config.TRAIN_BONUS * (hpLv or 0)) * hpMul
	local dps = atk / wt.cooldown * Config.critFactor(wt)
	local power = math.floor(dps * 4 + maxHp * 0.4)
	return {
		weapon = info,
		atk = atk,
		maxHp = maxHp,
		cooldown = wt.cooldown,
		range = wt.range,
		power = power,
		enh = enh,
		aura = aura,
		killFx = killFx,
	}
end

-- 저장 기록(또는 서버가 보낸 상태)으로 능력치 계산
function Config.profileStats(p: any, key: string?)
	local k = key or p.equipped
	local enh = (type(p.enh) == "table" and p.enh[k]) or 0
	return Config.playerStats(k, p.atkLv, p.hpLv, { enh = enh, aura = p.aura, kill = p.kill })
end

-- 그 스테이지 등급의 '일반' 무기, 훈련 0일 때의 전투력 (계열 평균)
function Config.recommendedPower(stage)
	return math.floor((Config.BASE_ATK * 1.7 * 4 + Config.BASE_HP * 0.4) * Config.stageScale(stage))
end

function Config.canAutoRepeat(stage, maxStage, power)
	return stage <= maxStage and power >= Config.recommendedPower(stage) * Config.AUTO_POWER_RATIO
end

-- 스테이지마다 같은 구성이 나오도록 고정된 난수 (Park-Miller)
local function seeded(seed: number)
	local s = (seed % 2147483646) + 1
	return function(): number
		s = (s * 16807) % 2147483647
		return s / 2147483647
	end
end

local function pickType(pool: { string }, rand: () -> number): string
	local total = 0
	for _, id in ipairs(pool) do
		total += Config.EnemyTypes[id].weight
	end
	local r = rand() * total
	for _, id in ipairs(pool) do
		r -= Config.EnemyTypes[id].weight
		if r <= 0 then
			return id
		end
	end
	return pool[#pool]
end

-- 정예가 나올 확률: 40스테이지부터 점점 늘어난다
function Config.eliteChance(n: number): number
	if n < 40 then
		return 0
	end
	return math.min(0.55, 0.08 + (n - 40) * 0.004)
end

-- 스테이지 n. 10스테이지마다 보스
-- 스테이지가 오를수록 웨이브 수, 웨이브당 적 수, 적 종류, 정예가 늘어난다
function Config.stageInfo(n)
	local isBoss = (n % 10 == 0)
	local gr = Config.stageScale(n)
	local rand = seeded(n * 7919 + 13)

	local pool = {}
	for _, id in ipairs(Config.ENEMY_ORDER) do
		if n >= Config.EnemyTypes[id].unlock then
			table.insert(pool, id)
		end
	end

	local perWave
	if n <= Config.MAX_GRADE then
		perWave = math.min(3 + math.floor(n / 8), 7)
	else
		perWave = math.min(7 + (n - Config.MAX_GRADE) // 25, 10)
	end
	local waveCount
	if isBoss then
		waveCount = n > Config.MAX_GRADE and 3 or 2
	elseif n < 8 then
		waveCount = 1
	elseif n < 35 then
		waveCount = 2
	elseif n < 120 then
		waveCount = 3
	else
		waveCount = 4
	end

	local eliteChance = Config.eliteChance(n)
	local waves = {}
	local elites = {}
	local hpWeight = 0
	for w = 1, waveCount do
		local list = {}
		local eliteList = {}
		local count = (isBoss and w == waveCount) and 2 or perWave
		for i = 1, count do
			local id = pickType(pool, rand)
			-- 새로 열린 적은 그 스테이지에 꼭 한 번 나온다
			if w == 1 and i == 1 then
				for _, nid in ipairs(Config.ENEMY_ORDER) do
					if Config.EnemyTypes[nid].unlock == n then
						id = nid
					end
				end
			end
			list[i] = id
			local weight = Config.EnemyTypes[id].hp
			if rand() < eliteChance then
				local affix = Config.EliteAffixes[math.floor(rand() * #Config.EliteAffixes) + 1]
				eliteList[i] = affix.id
				weight *= 1.5 * (affix.hp or 1)
			end
			hpWeight += weight
		end
		waves[w] = list
		elites[w] = eliteList
	end

	-- 일반 적 전체 체력 예산. 무기 등급이 같으면 한 판에 20~40초
	local budget = 300 * gr * (1 + math.min(n, Config.MAX_GRADE) / 150) * Config.ENEMY_HP_MULT
	local bossNo = math.max(1, n // 10)
	local coins = Config.stageCoins(n)
	if isBoss then
		coins *= 5
	end
	return {
		stage = n,
		grade = Config.stageGrade(n),
		beyond = n > Config.MAX_GRADE,
		isBoss = isBoss,
		waves = waves,
		elites = elites,
		unitHp = budget / hpWeight,
		-- 적이 많을수록 한 명의 공격력을 낮춰 전체 압박을 비슷하게 맞춘다
		unitDmg = 1.5 * gr * math.min(1, 5 / perWave) * Config.ENEMY_DMG_MULT,
		bossHp = 60 * gr * 5 * Config.BOSS_MULT,
		bossDmg = 3 * gr * Config.BOSS_MULT,
		slamDmg = 20 * gr * Config.BOSS_MULT,
		bossType = Config.ENEMY_ORDER[((bossNo - 1) % #Config.ENEMY_ORDER) + 1],
		bossPatterns = Config.BossPatterns[math.clamp(bossNo, 1, #Config.BossPatterns)],
		coins = coins,
		dropCount = isBoss and 3 or 1,
		bonusDropChance = isBoss and 0 or 0.35,
	}
end

function Config.trainCost(level)
	return math.floor(50 * 1.55 ^ level)
end

local SUFFIXES = { "", "K", "M", "B", "T", "Qa", "Qi", "Sx", "Sp", "Oc", "No", "Dc", "Ud", "Dd", "Td", "Qad", "Qid" }

function Config.formatNumber(n)
	if n ~= n then
		return "0"
	end
	if n < 1000 then
		return tostring(math.floor(n))
	end
	local i = math.floor(math.log10(n) / 3)
	if i >= #SUFFIXES then
		return string.format("%.2e", n)
	end
	local v = n / 10 ^ (i * 3)
	local s
	if v >= 100 then
		s = string.format("%d", math.floor(v))
	elseif v >= 10 then
		s = string.format("%.1f", math.floor(v * 10) / 10)
	else
		s = string.format("%.2f", math.floor(v * 100) / 100)
	end
	return s .. SUFFIXES[i + 1]
end

return Config
]]></string>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="4">
      <Properties>
        <string name="Name">GradeStyle</string>
        <string name="Source"><![CDATA[-- GradeStyle (ModuleScript, ReplicatedStorage)
-- 등급 1~100마다 다른 디자인을 정한다. 무기, 캐릭터 오라, 적, 칭호, UI가 모두 이걸 본다.
--
-- 1. 색: 등급마다 황금각만큼 색상을 돌려서 바로 옆 등급끼리도 확 달라 보인다.
--        등급이 오를수록 채도와 밝기가 올라간다
-- 2. 속성: 화염 → 서리 → 번개 → 생명 → 그림자 → 성광 → 선혈 → 공허 → 별빛 → 수정이 등급마다 돌아간다
-- 3. 장식: 등급이 오를 때마다 룬, 가시, 보석, 구슬, 고리, 날개, 빛줄기, 파편, 검 왕관이 하나씩 늘어난다
-- 4. 재질: 녹슨 쇠 → 쇠 → 광택 금속 → 금박 → 거울 강철 → 유리 → 수정 → 얼음 → 흑요석 → 우주 → 심연 수정 → 백금 → 근원
-- 5. 모양: 톱날(15~), 금빛 문양(30~), 갈라진 칼끝(35~), 소용돌이 가드(40~), 사슬(55~), 떠 있는 칼날 조각(75~)
-- 6. 칼날 모양 12종: 등급마다 바뀐다. 낮은 등급은 단순한 모양, 높을수록 복잡한 모양이 섞인다
--    곧은 날 · 나뭇잎 · 식칼 · 곡도 · 물결 · 언월 · 빈 틀 · 쌍날 · 갈고리 · 초승달 · 용골 · 수정

local Style = {}

local SPARKLE = "rbxasset://textures/particles/sparkles_main.dds"
local FIRE = "rbxasset://textures/particles/fire_main.dds"
local SMOKE = "rbxasset://textures/particles/smoke_main.dds"

Style.MOTIFS = {
	{ id = "flame", name = "화염", tex = FIRE, a = Color3.fromRGB(255, 110, 30), b = Color3.fromRGB(255, 220, 90), drift = Vector3.new(0, 6, 0) },
	{ id = "frost", name = "서리", tex = SPARKLE, a = Color3.fromRGB(120, 200, 255), b = Color3.fromRGB(235, 250, 255), drift = Vector3.new(0, -2, 0) },
	{ id = "storm", name = "번개", tex = SPARKLE, a = Color3.fromRGB(255, 240, 90), b = Color3.fromRGB(150, 130, 255), drift = Vector3.new(0, 0, 0) },
	{ id = "nature", name = "생명", tex = SPARKLE, a = Color3.fromRGB(80, 220, 90), b = Color3.fromRGB(210, 255, 140), drift = Vector3.new(0, 2, 0) },
	{ id = "shadow", name = "그림자", tex = SMOKE, a = Color3.fromRGB(100, 50, 150), b = Color3.fromRGB(30, 15, 45), drift = Vector3.new(0, 3, 0) },
	{ id = "holy", name = "성광", tex = SPARKLE, a = Color3.fromRGB(255, 235, 170), b = Color3.fromRGB(255, 255, 255), drift = Vector3.new(0, 5, 0) },
	{ id = "blood", name = "선혈", tex = SPARKLE, a = Color3.fromRGB(210, 20, 45), b = Color3.fromRGB(255, 100, 100), drift = Vector3.new(0, -6, 0) },
	{ id = "void", name = "공허", tex = SMOKE, a = Color3.fromRGB(70, 0, 110), b = Color3.fromRGB(190, 90, 255), drift = Vector3.new(0, 1, 0) },
	{ id = "star", name = "별빛", tex = SPARKLE, a = Color3.fromRGB(150, 175, 255), b = Color3.fromRGB(255, 255, 255), drift = Vector3.new(0, 1, 0) },
	{ id = "crystal", name = "수정", tex = SPARKLE, a = Color3.fromRGB(110, 255, 230), b = Color3.fromRGB(255, 170, 240), drift = Vector3.new(0, 2, 0) },
}

Style.RAINBOW = ColorSequence.new({
	ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 80, 80)),
	ColorSequenceKeypoint.new(0.2, Color3.fromRGB(255, 200, 60)),
	ColorSequenceKeypoint.new(0.4, Color3.fromRGB(90, 230, 110)),
	ColorSequenceKeypoint.new(0.6, Color3.fromRGB(70, 200, 255)),
	ColorSequenceKeypoint.new(0.8, Color3.fromRGB(150, 100, 255)),
	ColorSequenceKeypoint.new(1, Color3.fromRGB(255, 90, 200)),
})

-- 재질 단계: 등급이 오를수록 칼날 재질이 바뀐다
local MATERIALS = {
	{ to = 3, blade = Enum.Material.CorrodedMetal, reflect = 0, name = "녹슨 쇠" },
	{ to = 8, blade = Enum.Material.Metal, reflect = 0, name = "쇠" },
	{ to = 14, blade = Enum.Material.Metal, reflect = 0.25, name = "광택 금속" },
	{ to = 20, blade = Enum.Material.Foil, reflect = 0.15, name = "금박" },
	{ to = 27, blade = Enum.Material.Metal, reflect = 0.45, name = "거울 강철" },
	{ to = 35, blade = Enum.Material.Glass, reflect = 0.2, name = "유리" },
	{ to = 44, blade = Enum.Material.Glass, reflect = 0.4, name = "수정" },
	{ to = 54, blade = Enum.Material.Ice, reflect = 0.3, name = "얼음 결정" },
	{ to = 64, blade = Enum.Material.Metal, reflect = 0.5, name = "흑요석", dark = true },
	{ to = 74, blade = Enum.Material.ForceField, reflect = 0, name = "우주" },
	{ to = 84, blade = Enum.Material.Glass, reflect = 0.5, name = "심연 수정", dark = true },
	{ to = 93, blade = Enum.Material.Foil, reflect = 0.35, name = "백금" },
	{ to = 100, blade = Enum.Material.ForceField, reflect = 0, name = "근원" },
}

-- 칼날 모양: 등급이 오를수록 고를 수 있는 모양이 늘어난다 (이웃 등급끼리는 항상 다르다)
Style.SHAPES = {
	{ id = "straight", name = "곧은 날" },
	{ id = "leaf", name = "나뭇잎 날" },
	{ id = "cleaver", name = "식칼 날" },
	{ id = "curved", name = "곡도" },
	{ id = "flamberge", name = "물결 날" },
	{ id = "falchion", name = "언월 날" },
	{ id = "hollow", name = "빈 틀 날" },
	{ id = "twin", name = "쌍날" },
	{ id = "hook", name = "갈고리 날" },
	{ id = "crescent", name = "초승달 날" },
	{ id = "spine", name = "용골 날" },
	{ id = "crystal", name = "수정 날" },
}

local function shapeFor(g: number)
	local n = (g <= 10 and 3) or (g <= 30 and 6) or (g <= 50 and 9) or 12
	return Style.SHAPES[((g * 5) % n) + 1]
end

local cache: { [number]: any } = {}

local function hsv(h: number, s: number, v: number): Color3
	return Color3.fromHSV(h % 1, math.clamp(s, 0, 1), math.clamp(v, 0, 1))
end

function Style.get(grade: number)
	local g = math.clamp(math.floor(grade), 1, 100)
	local hit = cache[g]
	if hit then
		return hit
	end
	local p = (g - 1) / 99
	local motif = Style.MOTIFS[((g - 1) % #Style.MOTIFS) + 1]

	-- 색: 황금각(0.382)씩 색상을 돌린다
	local hue = (g * 0.381966) % 1
	local primary = hsv(hue, 0.45 + 0.5 * p, 0.78 + 0.22 * p):Lerp(motif.a, 0.35)
	if g <= 3 then
		primary = Color3.fromRGB(150, 95, 60):Lerp(motif.a, 0.15)
	end
	local secondary = motif.b:Lerp(primary, 0.3)
	local glow = primary:Lerp(Color3.new(1, 1, 1), 0.35)

	local mat = MATERIALS[#MATERIALS]
	for _, m in ipairs(MATERIALS) do
		if g <= m.to then
			mat = m
			break
		end
	end

	local s = {
		grade = g,
		power = p,
		motif = motif,
		primary = primary,
		secondary = secondary,
		glow = glow,
		rainbow = g >= 94,
		bladeMaterial = mat.blade,
		bladeDark = mat.dark == true,
		reflect = mat.reflect,
		materialName = mat.name,
		shape = shapeFor(g).id,
		shapeName = shapeFor(g).name,
		-- 크기
		scale = 1 + p * 0.55,
		lengthMul = 1 + p * 0.35,
		widthMul = 1 + p * 0.25,
		-- 장식 개수 (등급이 오를 때마다 하나씩 늘어난다)
		runes = math.min(12, (g + 4) // 5),
		spikes = math.min(8, (g + 3) // 7),
		gems = 1 + math.min(4, g // 20),
		edge = g >= 21,
		halo = g >= 30 and math.min(3, 1 + (g - 30) // 25) or 0, -- 칼날을 두른 빛 고리 수
		wings = g >= 45,
		wingSize = g >= 45 and (1 + (g - 45) / 30) or 0,
		beams = g >= 50,
		auraBlade = g >= 60,
		orbs = g >= 12 and math.min(6, 1 + (g - 12) // 14) or 0,
		shards = g >= 70 and math.min(12, 4 + (g - 70) // 3) or 0,
		crown = g >= 85,
		-- 모양 장식 (빛 대신 모양으로 멋있어진다)
		serrate = g >= 15 and math.min(10, 4 + (g - 15) // 10) or 0, -- 톱날
		engrave = g >= 30, -- 금빛 문양
		prongs = g >= 35, -- 갈라진 칼끝
		ornateGuard = g >= 40, -- 소용돌이 가드
		chains = g >= 55 and math.min(4, 2 + (g - 55) // 15) or 0, -- 늘어진 사슬
		floatBlade = g >= 75 and math.min(4, 2 + (g - 75) // 10) or 0, -- 칼끝 너머 떠 있는 칼날 조각
		-- 빛과 입자
		particleRate = 2 + g * 0.22,
		particleSize = 0.15 + p * 0.3,
		lightRange = 4 + g * 0.08,
		lightBrightness = 0.4 + p * 0.9,
		trailLife = 0.16 + p * 0.3,
		fire = motif.id == "flame" and g >= 10,
		smoke = (motif.id == "shadow" or motif.id == "void") and g >= 10,
		sparkles = motif.id == "star" or g >= 40,
		-- 캐릭터 오라
		aura = g >= 3,
		auraRate = 1.5 + g * 0.15,
		groundRing = g >= 10,
		secondRing = g >= 40,
		bodyOrbs = g >= 20 and math.min(6, 1 + (g - 20) // 12) or 0,
		bodyWings = g >= 65,
		bodyHalo = g >= 80,
		bodyLight = g >= 25,
		-- 적
		enemySpikes = math.min(6, g // 12),
		enemyAura = g >= 8,
	}
	cache[g] = s
	return s
end

-- 색 띠: 등급 고유 두 색, 94등급부터는 무지개
function Style.gradient(grade: number): ColorSequence
	local s = Style.get(grade)
	if s.rainbow then
		return Style.RAINBOW
	end
	return ColorSequence.new(s.primary:Lerp(Color3.new(1, 1, 1), 0.15), s.secondary)
end

-- 글자에 쓰기 좋게 밝힌 색
function Style.textColor(grade: number): Color3
	local s = Style.get(grade)
	local h, sat, v = s.primary:ToHSV()
	return Color3.fromHSV(h, math.min(sat, 0.85), math.max(v, 0.9))
end

return Style
]]></string>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="5">
      <Properties>
        <string name="Name">WeaponBuilder</string>
        <string name="Source"><![CDATA[-- WeaponBuilder (ModuleScript, ReplicatedStorage)
-- 서버는 캐릭터 손에, 클라이언트는 무기고 미리보기에 같은 모양을 만든다.
-- 무기 모양과 장식은 GradeStyle이 정한 등급별 디자인을 따른다. 등급이 하나만 달라도 모양이 다르다.
--
-- 빛은 은은하게, 멋은 모양으로: 톱날(15~), 금빛 문양(30~), 갈라진 칼끝(35~), 소용돌이 가드(40~),
-- 늘어진 사슬(55~), 칼끝 너머 떠 있는 칼날 조각(75~)
-- 모든 등급: 등급 고유 색, 속성 입자, 휘두를 때 궤적
-- 등급이 오를 때마다: 룬 문자 → 가시 → 보석 → 떠다니는 구슬(12~) → 빛 테두리(21~) → 빛 고리(30~)
--                   → 날개(45~) → 구슬을 잇는 빛줄기(50~) → 두 겹 칼날(60~) → 회전 파편(70~) → 검 왕관(85~)
-- 희귀도는 보석 색과 궤적 끝 색으로 보이고, 전설은 금빛 반짝임이 붙는다.
-- 칼날 모양 12종(곧은 날, 나뭇잎, 식칼, 곡도, 물결, 언월, 빈 틀, 쌍날, 갈고리, 초승달, 용골, 수정)이 등급마다 바뀐다.
-- 강화 +1~+10: 단계마다 장식이 하나씩 붙는다 (빛 날끝 → 문장 보석 → 룬 홈 → 지느러미 → 각인
--   → 등날 → 칼끝 고리 → 불꽃 등가시 → 빛의 칼집 → 황금 왕관과 번개)

local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local GradeStyle = require(ReplicatedStorage:WaitForChild("GradeStyle"))

local Builder = {}
Builder.RAINBOW = GradeStyle.RAINBOW

local DARK_STEEL = Color3.fromRGB(60, 62, 70)
local LEATHER = Color3.fromRGB(70, 45, 30)
local GOLD = Color3.fromRGB(225, 180, 70)
local WOOD = Color3.fromRGB(85, 58, 38)

export type Look = {
	grade: number, -- 1~100 (올라운더는 100)
	rarity: number, -- 1~5
	accent: Color3, -- 희귀도 색
	scale: number?,
	lite: boolean?, -- 적 무기: 떠다니는 장식은 뺀다
	enh: number?, -- 강화 단계 0~10
}

type Ctx = {
	parent: Instance,
	hand: BasePart,
	grip: CFrame,
	scale: number,
}

-- 무기 공간: Y = 칼끝 방향, Z = 칼날 폭(세로), X = 칼 두께
local function mk(ctx: Ctx, name: string, size: Vector3, offset: CFrame, color: Color3, material: Enum.Material, shape: Enum.PartType?): Part
	local p = Instance.new("Part")
	p.Name = name
	if shape then
		p.Shape = shape
	end
	p.Size = size * ctx.scale
	p.Color = color
	p.Material = material
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.Massless = true
	p.CastShadow = false
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.CFrame = ctx.grip * CFrame.new(offset.Position * ctx.scale) * offset.Rotation
	local weld = Instance.new("WeldConstraint")
	weld.Part0 = ctx.hand
	weld.Part1 = p
	weld.Parent = p
	p.Parent = ctx.parent
	return p
end

local function at(y: number, z: number?, rx: number?): CFrame
	return CFrame.new(0, y, z or 0) * CFrame.Angles(math.rad(rx or 0), 0, 0)
end

-- 클라이언트가 매 프레임 중심 주위로 돌리는 장식 (고정 파트, 무게 없음)
local function orbitPart(parent: Instance, center: BasePart, size: Vector3, color: Color3, material: Enum.Material, shape: Enum.PartType?, opts: { [string]: any }): Part
	local p = Instance.new("Part")
	p.Name = opts.name or "Orbit"
	if shape then
		p.Shape = shape
	end
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	p.Massless = true
	p.Size = size
	p.Color = color
	p.Material = material
	p.Transparency = opts.transparency or 0
	p.CFrame = center.CFrame * CFrame.new(opts.radius or 0, opts.height or 0, 0)
	local ref = Instance.new("ObjectValue")
	ref.Name = "Center"
	ref.Value = center
	ref.Parent = p
	p:SetAttribute("Radius", opts.radius or 0)
	p:SetAttribute("Height", opts.height or 0)
	p:SetAttribute("Speed", opts.speed or 1)
	p:SetAttribute("Phase", opts.phase or 0)
	p:SetAttribute("UseRotation", opts.useRotation == true)
	p:SetAttribute("Flat", opts.flat == true)
	p:SetAttribute("Tumble", opts.tumble or 0)
	if opts.bob then
		p:SetAttribute("Bob", opts.bob)
		p:SetAttribute("BobSpeed", opts.bobSpeed or 2)
	end
	if opts.offsetPos then
		p:SetAttribute("OffsetPos", opts.offsetPos)
	end
	if opts.offsetRot then
		p:SetAttribute("OffsetRot", opts.offsetRot)
	end
	if opts.axis then
		p:SetAttribute("Axis", opts.axis)
	end
	CollectionService:AddTag(p, "ArenaOrbit")
	p.Parent = parent
	return p
end
Builder.orbitPart = orbitPart

local function emitter(parent: Instance, style: any, rate: number, size: number, opts: { [string]: any }?): ParticleEmitter
	local o = opts or {}
	local pe = Instance.new("ParticleEmitter")
	pe.Name = o.name or "StyleParticles"
	pe.Texture = style.motif.tex
	pe.Rate = rate
	pe.Lifetime = o.lifetime or NumberRange.new(0.5, 1.1)
	pe.Speed = o.speed or NumberRange.new(0.4, 1.8)
	pe.SpreadAngle = Vector2.new(180, 180)
	pe.Acceleration = o.accel or style.motif.drift
	pe.RotSpeed = NumberRange.new(-120, 120)
	pe.Rotation = NumberRange.new(0, 360)
	pe.Size = NumberSequence.new({
		NumberSequenceKeypoint.new(0, size),
		NumberSequenceKeypoint.new(1, 0),
	})
	pe.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.3),
		NumberSequenceKeypoint.new(1, 1),
	})
	local dark = style.motif.id == "shadow" or style.motif.id == "void"
	pe.LightEmission = dark and 0.05 or 0.35
	pe.Color = style.rainbow and GradeStyle.RAINBOW or ColorSequence.new(style.glow, style.secondary)
	pe.Parent = parent
	return pe
end


------------------------------------------------------------------------
-- 칼날 조각: 칼날은 여러 조각을 이어 만든다. 장식은 조각을 따라 붙는다
------------------------------------------------------------------------
type Seg = { cf: CFrame, len: number, width: number, thick: number }

-- 칼날 위 t(0=손잡이 쪽, 1=칼끝) 자리의 좌표와 그 조각
local function sample(segs: { Seg }, t: number): (CFrame, Seg)
	local n = #segs
	local x = math.clamp(t, 0, 0.9999) * n
	local i = math.floor(x) + 1
	local seg = segs[i]
	local frac = x - (i - 1)
	return seg.cf * CFrame.new(0, (frac - 0.5) * seg.len, 0), seg
end

local function bladeColorOf(style: any): Color3
	if style.bladeDark then
		return Color3.fromRGB(28, 24, 34):Lerp(style.primary, 0.3)
	end
	return style.primary:Lerp(Color3.fromRGB(230, 232, 238), style.grade < 55 and 0.45 or 0.1)
end

------------------------------------------------------------------------
-- 칼날 장식 (등급)
------------------------------------------------------------------------
type DecoOpts = { shaft: boolean?, hollow: boolean? }

local function decorateBlade(ctx: Ctx, style: any, look: Look, core: BasePart, segs: { Seg }, tipCf: CFrame, o: DecoOpts)
	local onShaft = o.shaft == true
	local first = segs[1]
	local total = 0
	for _, sg in ipairs(segs) do
		total += sg.len
	end
	-- 가운데 홈과 빛 테두리
	if not onShaft and not o.hollow then
		for _, sg in ipairs(segs) do
			mk(ctx, "Fuller", Vector3.new(sg.thick + 0.03, sg.len * 0.92, math.max(0.08, sg.width * 0.16)), sg.cf, style.grade >= 21 and style.glow or DARK_STEEL, style.grade >= 21 and Enum.Material.Neon or Enum.Material.Metal)
		end
	end
	if style.edge and not onShaft then
		for _, sg in ipairs(segs) do
			for _, side in ipairs({ 1, -1 }) do
				mk(ctx, "Edge", Vector3.new(sg.thick + 0.02, sg.len, 0.07), sg.cf * CFrame.new(0, 0, side * (sg.width / 2 - 0.02)), style.secondary, Enum.Material.Foil)
			end
		end
	end
	-- 룬 문자: 칼날을 따라 빛나는 점
	local runes = math.min(style.runes, math.floor(total / 0.55))
	for i = 1, runes do
		local cf, sg = sample(segs, 0.06 + 0.86 * (i - 0.5) / runes)
		mk(ctx, "Rune", Vector3.new(sg.thick + 0.06, 0.2, 0.2), cf * CFrame.Angles(math.rad(45), 0, 0), (i % 2 == 0) and style.secondary or style.glow, Enum.Material.Neon)
	end
	-- 가시: 칼날 한쪽을 따라 바깥으로
	for i = 1, style.spikes do
		local cf, sg = sample(segs, 0.12 + 0.6 * (i - 1) / math.max(style.spikes, 1))
		local size = 0.18 + 0.03 * style.grade / 10
		mk(ctx, "Spike", Vector3.new(sg.thick * 0.9, size, size), cf * CFrame.new(0, 0, -(sg.width / 2 + size * 0.25)) * CFrame.Angles(math.rad(45), 0, 0), style.primary, Enum.Material.Metal)
	end
	-- 톱날: 양쪽 날을 따라 이빨
	local serr = onShaft and 0 or style.serrate
	for i = 1, serr do
		local cf, sg = sample(segs, 0.05 + 0.65 * (i - 1) / math.max(serr - 1, 1))
		local size = math.max(0.12, sg.width * 0.2)
		for _, side in ipairs({ 1, -1 }) do
			mk(ctx, "Serration", Vector3.new(sg.thick * 0.95, size, size), cf * CFrame.new(0, 0, side * (sg.width / 2)) * CFrame.Angles(math.rad(45), 0, 0), core.Color, core.Material)
		end
	end
	-- 금빛 문양: 칼날 양면에 V자 무늬
	if style.engrave and not onShaft and not o.hollow then
		local n = math.max(2, math.floor(total / 1.4))
		for i = 1, n do
			local cf, sg = sample(segs, 0.08 + 0.8 * (i - 0.5) / n)
			for _, face in ipairs({ 1, -1 }) do
				for _, tilt in ipairs({ 35, -35 }) do
					mk(ctx, "Engrave", Vector3.new(0.03, sg.width * 0.36, 0.06), cf * CFrame.new(face * (sg.thick / 2 + 0.01), 0, tilt > 0 and sg.width * 0.12 or -sg.width * 0.12) * CFrame.Angles(math.rad(tilt), 0, 0), GOLD:Lerp(style.secondary, 0.25), Enum.Material.Foil)
				end
			end
		end
	end
	-- 떠 있는 칼날 조각: 칼끝 너머로 간격을 두고 이어진다
	for i = 1, (onShaft and 0 or style.floatBlade) do
		local w = first.width * (0.7 - i * 0.1)
		mk(ctx, "FloatPiece", Vector3.new(first.thick, 0.5, math.max(0.15, w)), tipCf * CFrame.new(0, 0.55 + (i - 1) * 0.75, 0) * CFrame.Angles(math.rad((i % 2 == 0) and 12 or -12), 0, 0), core.Color, core.Material)
	end
	-- 두 겹 칼날: 칼날을 감싼 반투명 빛
	if style.auraBlade and not look.lite and not onShaft then
		for _, sg in ipairs(segs) do
			local outer = mk(ctx, "AuraBlade", Vector3.new(sg.thick * 2.2, sg.len * 1.04, sg.width * 1.45), sg.cf, style.secondary, Enum.Material.ForceField)
			outer.Transparency = 0.45
		end
	end
	-- 빛 고리: 칼날을 두른 고리들
	for r = 1, style.halo do
		local cf, sg = sample(segs, 0.3 + 0.25 * (r - 1))
		local radius = sg.width * 0.75 + 0.35 + r * 0.1
		for i = 0, 9 do
			local a = (i / 10) * math.pi * 2
			mk(ctx, "Halo", Vector3.new(0.14, 0.14, radius * 0.66), cf * CFrame.new(math.cos(a) * radius, 0, math.sin(a) * radius) * CFrame.Angles(0, -a, 0), (r % 2 == 1) and GOLD:Lerp(style.secondary, 0.4) or style.secondary, Enum.Material.Foil)
		end
	end
	-- 궤적
	local a0 = Instance.new("Attachment")
	a0.Name = "TrailBase"
	a0.Position = Vector3.new(0, -core.Size.Y / 2 + 0.1, 0)
	a0.Parent = core
	local a1 = Instance.new("Attachment")
	a1.Name = "TrailTip"
	a1.Position = Vector3.new(0, core.Size.Y / 2, 0)
	a1.Parent = core
	local trail = Instance.new("Trail")
	trail.Attachment0 = a0
	trail.Attachment1 = a1
	trail.Lifetime = style.trailLife * (1 + (look.enh or 0) * 0.05)
	trail.MinLength = 0.05
	trail.LightEmission = 0.45
	trail.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.3), NumberSequenceKeypoint.new(1, 1) })
	trail.Color = style.rainbow and GradeStyle.RAINBOW or ColorSequence.new(style.glow, look.accent)
	trail.Parent = core

	-- 빛과 입자
	if style.grade >= 4 then
		local light = Instance.new("PointLight")
		light.Color = style.glow
		light.Range = style.lightRange
		light.Brightness = style.lightBrightness
		light.Parent = core
	end
	emitter(core, style, look.lite and style.particleRate * 0.4 or style.particleRate, style.particleSize)
	if style.fire and not look.lite then
		local fire = Instance.new("Fire")
		fire.Size = 2 + style.grade * 0.04
		fire.Heat = 6
		fire.Color = style.primary
		fire.SecondaryColor = style.secondary
		fire.Parent = core
	end
	if style.smoke and not look.lite then
		local smoke = Instance.new("Smoke")
		smoke.Color = style.primary
		smoke.Opacity = 0.12
		smoke.RiseVelocity = 2
		smoke.Size = 1.5
		smoke.Parent = core
	end
	if style.sparkles or look.rarity >= 5 then
		local sp = Instance.new("Sparkles")
		sp.SparkleColor = look.rarity >= 5 and GOLD or style.glow
		sp.Parent = core
	end

	-- 떠다니는 구슬, 빛줄기, 파편 (클라이언트가 돌린다)
	if look.lite then
		return
	end
	local tip = Instance.new("Attachment")
	tip.Name = "BeamTip"
	tip.Position = Vector3.new(0, core.Size.Y / 2, 0)
	tip.Parent = core
	local bw = first.width
	for i = 1, style.orbs do
		local orb = orbitPart(ctx.parent, core, Vector3.new(0.45, 0.45, 0.45) * ctx.scale * (1 + style.power * 0.6), (i % 2 == 0) and style.secondary or style.glow, Enum.Material.Glass, Enum.PartType.Ball, {
			name = "Orb",
			radius = (bw * 0.8 + 0.7) * ctx.scale,
			height = (-core.Size.Y / 2) + core.Size.Y * (i / (style.orbs + 1)),
			speed = 2.2,
			phase = i * (math.pi * 2 / style.orbs),
			useRotation = true,
		})
		if style.beams then
			local att = Instance.new("Attachment")
			att.Parent = orb
			local beam = Instance.new("Beam")
			beam.Attachment0 = tip
			beam.Attachment1 = att
			beam.Width0 = 0.12
			beam.Width1 = 0.05
			beam.FaceCamera = true
			beam.LightEmission = 0.4
			beam.Segments = 8
			beam.CurveSize0 = 0.8
			beam.CurveSize1 = -0.8
			beam.Color = style.rainbow and GradeStyle.RAINBOW or ColorSequence.new(style.glow, style.secondary)
			beam.Transparency = NumberSequence.new(0.45)
			beam.Parent = orb
		end
	end
	for i = 1, style.shards do
		orbitPart(ctx.parent, core, Vector3.new(0.12, 0.45, 0.22) * ctx.scale, (i % 3 == 0) and style.secondary or style.glow, Enum.Material.Glass, nil, {
			name = "Shard",
			radius = (bw * 1.2 + 1.3) * ctx.scale,
			height = (-core.Size.Y / 2) + core.Size.Y * ((i % 6) + 1) / 7,
			speed = -3.2,
			phase = i * 0.9,
			useRotation = true,
			tumble = 4,
		})
	end
end

------------------------------------------------------------------------
-- 강화 장식: +1부터 +10까지 단계마다 하나씩 쌓인다
------------------------------------------------------------------------
local function enhanceDecor(ctx: Ctx, style: any, look: Look, core: BasePart, segs: { Seg }, tipCf: CFrame, guardY: number, guardW: number)
	local lv = math.clamp(math.floor(look.enh or 0), 0, 10)
	if lv <= 0 then
		return
	end
	local accent = look.accent
	local bright = accent:Lerp(Color3.new(1, 1, 1), 0.35)
	-- +1 빛나는 날끝
	for _, sg in ipairs(segs) do
		for _, side in ipairs({ 1, -1 }) do
			mk(ctx, "EnhEdge", Vector3.new(sg.thick * 0.6, sg.len, 0.05), sg.cf * CFrame.new(0, 0, side * (sg.width / 2 + 0.03)), bright, Enum.Material.Neon)
		end
	end
	local base = segs[1]
	-- +2 칼날 문장 보석
	if lv >= 2 then
		local cf = base.cf * CFrame.new(0, -base.len / 2 + 0.35, 0)
		mk(ctx, "EnhCrestFrame", Vector3.new(base.thick + 0.1, 0.62, 0.62), cf * CFrame.Angles(math.rad(45), 0, 0), GOLD, Enum.Material.Foil)
		mk(ctx, "EnhCrest", Vector3.new(base.thick + 0.16, 0.4, 0.4), cf * CFrame.Angles(math.rad(45), 0, 0), accent, Enum.Material.Neon)
	end
	-- +3 두 줄 룬 홈
	if lv >= 3 then
		for _, sg in ipairs(segs) do
			for _, face in ipairs({ 1, -1 }) do
				for _, z in ipairs({ 0.22, -0.22 }) do
					mk(ctx, "EnhGroove", Vector3.new(0.02, sg.len * 0.9, 0.05), sg.cf * CFrame.new(face * (sg.thick / 2 + 0.012), 0, z * sg.width), style.glow, Enum.Material.Neon)
				end
			end
		end
	end
	-- +4 가드 지느러미
	if lv >= 4 then
		for _, side in ipairs({ 1, -1 }) do
			for f = 0, 1 do
				mk(ctx, "EnhFin", Vector3.new(0.1, 0.9 - f * 0.25, 0.32), at(guardY + 0.35 + f * 0.25, side * (guardW / 2 + 0.15 + f * 0.2), side * (28 + f * 18)), core.Color, core.Material)
			end
		end
	end
	-- +5 양면 빛 각인 (화살촉 무늬)
	if lv >= 5 then
		local n = #segs
		for i = 1, n, 2 do
			local sg = segs[i]
			for _, face in ipairs({ 1, -1 }) do
				for _, tilt in ipairs({ 40, -40 }) do
					mk(ctx, "EnhMark", Vector3.new(0.025, sg.width * 0.32, 0.05), sg.cf * CFrame.new(face * (sg.thick / 2 + 0.015), 0, tilt > 0 and -sg.width * 0.1 or sg.width * 0.1) * CFrame.Angles(math.rad(tilt), 0, 0), style.secondary, Enum.Material.Neon)
				end
			end
		end
	end
	-- +6 등날: 칼날 가운데 솟은 능선
	if lv >= 6 then
		for _, sg in ipairs(segs) do
			mk(ctx, "EnhRidge", Vector3.new(sg.thick * 1.7, sg.len * 0.96, math.max(0.08, sg.width * 0.1)), sg.cf, GOLD:Lerp(style.primary, 0.35), Enum.Material.Foil)
		end
	end
	-- +7 칼끝 회전 고리 (구슬 여섯 개)
	if lv >= 7 and not look.lite then
		local tipHeight = core.Size.Y / 2 - 0.3 * ctx.scale
		for i = 1, 6 do
			orbitPart(ctx.parent, core, Vector3.new(0.22, 0.22, 0.22) * ctx.scale, (i % 2 == 0) and accent or style.glow, Enum.Material.Neon, Enum.PartType.Ball, {
				name = "EnhRing",
				radius = (base.width * 0.6 + 0.45) * ctx.scale,
				height = tipHeight,
				speed = 4,
				phase = i * math.pi / 3,
				useRotation = true,
			})
		end
	end
	-- +8 불꽃 등가시: 칼등을 따라 칼끝 쪽으로 누운 가시
	if lv >= 8 then
		for i = 1, #segs do
			local sg = segs[i]
			mk(ctx, "EnhFlame", Vector3.new(sg.thick * 0.8, 0.55, 0.22), sg.cf * CFrame.new(0, 0, -(sg.width / 2 + 0.18)) * CFrame.Angles(math.rad(-40), 0, 0), (i % 2 == 0) and style.secondary or accent, Enum.Material.Neon)
		end
	end
	-- +9 빛의 칼집
	if lv >= 9 then
		for _, sg in ipairs(segs) do
			local sheath = mk(ctx, "EnhSheath", Vector3.new(sg.thick * 2.6, sg.len * 1.02, sg.width * 1.65), sg.cf, accent, Enum.Material.ForceField)
			sheath.Transparency = 0.35
		end
		local pe = emitter(core, style, 14, 0.35, { name = "EnhStars", speed = NumberRange.new(1, 3) })
		pe.Color = ColorSequence.new(bright, Color3.new(1, 1, 1))
		pe.LightEmission = 0.8
	end
	-- +10 황금 왕관과 번개
	if lv >= 10 then
		for i = 0, 5 do
			local a = (i / 6) * math.pi * 2
			mk(ctx, "EnhCrown", Vector3.new(0.12, 0.8, 0.2), CFrame.new(math.cos(a) * 0.55, guardY + 0.45, math.sin(a) * 0.55) * CFrame.Angles(0, -a, 0) * CFrame.Angles(0, 0, math.rad(25)), GOLD, Enum.Material.Foil)
		end
		if not look.lite then
			local g0 = Instance.new("Attachment")
			g0.Name = "EnhBolt0"
			g0.Position = Vector3.new(0, -core.Size.Y / 2 + 0.2, 0)
			g0.Parent = core
			local g1 = Instance.new("Attachment")
			g1.Name = "EnhBolt1"
			g1.Position = Vector3.new(0, core.Size.Y / 2, 0)
			g1.Parent = core
			for k = 1, 2 do
				local beam = Instance.new("Beam")
				beam.Attachment0 = g0
				beam.Attachment1 = g1
				beam.Width0 = 0.14
				beam.Width1 = 0.06
				beam.Segments = 12
				beam.CurveSize0 = k == 1 and 1.4 or -1.4
				beam.CurveSize1 = k == 1 and -1.1 or 1.1
				beam.FaceCamera = true
				beam.LightEmission = 1
				beam.Color = style.rainbow and GradeStyle.RAINBOW or ColorSequence.new(Color3.new(1, 1, 1), accent)
				beam.Transparency = NumberSequence.new(0.2)
				beam.Parent = core
			end
		end
		local sp = Instance.new("Sparkles")
		sp.SparkleColor = GOLD
		sp.Parent = core
	end
end

------------------------------------------------------------------------
-- 칼날 모양 12종
------------------------------------------------------------------------
-- 모양마다 폭 배율 wm(t), 가운데 선 위치 cz(t) (칼날 폭 단위)
local PROFILES: { [string]: (number) -> (number, number) } = {
	straight = function(_t)
		return 1, 0
	end,
	leaf = function(t)
		return 0.7 + 0.65 * math.sin(math.pi * t), 0
	end,
	cleaver = function(t)
		local w = 1 + 0.9 * t
		return w, (1 - w) / 2
	end,
	curved = function(t)
		return 1 - 0.15 * t, 0.9 * t * t
	end,
	flamberge = function(t)
		return 0.8 + 0.35 * math.abs(math.sin(t * math.pi * 5)), 0.08 * math.sin(t * math.pi * 5)
	end,
	falchion = function(t)
		local w = 0.85 + 0.8 * t ^ 1.5
		return w, (w - 0.85) / 2 + 0.25 * t * t
	end,
	hollow = function(_t)
		return 1, 0
	end,
	twin = function(_t)
		return 1, 0
	end,
	hook = function(_t)
		return 0.9, 0
	end,
	crescent = function(_t)
		return 0.7, 0
	end,
	spine = function(t)
		return 1 - 0.1 * t, 0
	end,
	crystal = function(t)
		return 0.55 + 0.6 * math.abs(math.sin(t * math.pi * 4)), 0
	end,
}

-- 가운데 선을 따라 조각을 만든다. 실제로 그리지 않고 좌표만 필요하면 draw = false
local function lineSegs(ctx: Ctx, prof: (number) -> (number, number), startY: number, L: number, W: number, T: number, n: number, zShift: number, wScale: number, draw: boolean, color: Color3, material: Enum.Material, reflect: number, name: string): { Seg }
	local segs: { Seg } = {}
	for i = 0, n - 1 do
		local t0, t1 = i / n, (i + 1) / n
		local _, c0 = prof(t0)
		local _, c1 = prof(t1)
		local wm = prof((t0 + t1) / 2)
		local y0, y1 = startY + t0 * L, startY + t1 * L
		local z0, z1 = c0 * W + zShift, c1 * W + zShift
		local dy, dz = y1 - y0, z1 - z0
		local len = math.sqrt(dy * dy + dz * dz) + 0.04
		local cf = CFrame.new(0, (y0 + y1) / 2, (z0 + z1) / 2) * CFrame.Angles(math.atan2(dz, dy), 0, 0)
		local width = wm * W * wScale
		if draw then
			local p = mk(ctx, name, Vector3.new(T, len, width), cf, color, material)
			p.Reflectance = reflect
		end
		table.insert(segs, { cf = cf, len = len, width = width, thick = T })
	end
	return segs
end

-- 모양에 맞춰 칼날을 그리고 (장식용 조각들, 칼끝 좌표)를 돌려준다
local function profileBlade(ctx: Ctx, style: any, startY: number, L: number, W: number, T: number, color: Color3): ({ Seg }, CFrame, boolean)
	local shape = style.shape or "straight"
	local prof = PROFILES[shape] or PROFILES.straight
	local material = style.bladeMaterial
	local reflect = style.reflect
	local n = (shape == "flamberge" or shape == "crystal") and 14 or 8
	local hollow = false
	local segs: { Seg }
	if shape == "hollow" then
		-- 빈 틀: 양쪽 테두리 + 가로대, 가운데에 빛나는 심
		hollow = true
		segs = lineSegs(ctx, prof, startY, L, W, T, n, 0, 1, false, color, material, reflect, "Blade")
		for _, side in ipairs({ 1, -1 }) do
			lineSegs(ctx, prof, startY, L, W, T, n, side * W * 0.39, 0.22, true, color, material, reflect, "BladeRail")
		end
		for i = 2, n, 2 do
			mk(ctx, "BladeBar", Vector3.new(T * 0.9, 0.14, W * 0.8), segs[i].cf, color, material)
		end
		local coreGlow = mk(ctx, "BladeCore", Vector3.new(T * 0.4, L * 0.9, W * 0.45), CFrame.new(0, startY + L * 0.47, 0), style.glow, Enum.Material.Glass)
		coreGlow.Transparency = 0.35
	elseif shape == "twin" then
		-- 쌍날: 사이가 벌어진 두 갈래 칼날
		hollow = true
		segs = lineSegs(ctx, prof, startY, L, W, T, n, 0, 1, false, color, material, reflect, "Blade")
		for _, side in ipairs({ 1, -1 }) do
			lineSegs(ctx, prof, startY, L, W, T, n, side * W * 0.32, 0.36, true, color, material, reflect, "BladeTwin")
		end
		mk(ctx, "BladeBridge", Vector3.new(T, 0.3, W), CFrame.new(0, startY + 0.15, 0), color, material)
	else
		segs = lineSegs(ctx, prof, startY, L, W, T, n, 0, 1, true, color, material, reflect, "Blade")
	end

	-- 칼끝
	local last = segs[#segs]
	local tipCf = last.cf * CFrame.new(0, last.len / 2, 0)
	local wEnd = last.width
	local function tipPart(name: string, size: Vector3, cf: CFrame)
		local p = mk(ctx, name, size, cf, color, material)
		p.Reflectance = reflect
		return p
	end
	if shape == "cleaver" then
		tipPart("BladeTip", Vector3.new(T, 0.35, wEnd), tipCf * CFrame.Angles(math.rad(-18), 0, 0))
	elseif shape == "hook" then
		local h1 = tipCf * CFrame.new(0, 0.2, 0) * CFrame.Angles(math.rad(-55), 0, 0) * CFrame.new(0, 0.35, 0)
		tipPart("BladeTip", Vector3.new(T, 0.9, wEnd * 0.75), h1)
		tipPart("BladeHook", Vector3.new(T, 0.8, wEnd * 0.55), h1 * CFrame.new(0, 0.4, 0) * CFrame.Angles(math.rad(-80), 0, 0) * CFrame.new(0, 0.35, 0))
	elseif shape == "crescent" then
		local r = W * 1.25
		local center = tipCf * CFrame.new(0, r * 0.85, 0)
		local segsN = 9
		for i = 0, segsN - 1 do
			local f0 = math.rad(-125 + 250 * i / segsN)
			local f1 = math.rad(-125 + 250 * (i + 1) / segsN)
			local p0 = Vector3.new(0, -r * math.cos(f0), r * math.sin(f0))
			local p1 = Vector3.new(0, -r * math.cos(f1), r * math.sin(f1))
			local mid = (p0 + p1) / 2
			local d = p1 - p0
			local taper = 1 - math.abs((i + 0.5) / segsN * 2 - 1) * 0.7
			tipPart("BladeMoon", Vector3.new(T, d.Magnitude + 0.05, W * 0.55 * taper), center * CFrame.new(mid) * CFrame.Angles(math.atan2(d.Z, d.Y), 0, 0) * CFrame.new(0, 0, -W * 0.18 * taper))
		end
		tipCf = center * CFrame.new(0, r * 0.4, 0)
	elseif shape == "twin" then
		for _, side in ipairs({ 1, -1 }) do
			local ts = W * 0.36 * 0.71
			tipPart("BladeTip", Vector3.new(T, ts, ts), tipCf * CFrame.new(0, 0, side * W * 0.32) * CFrame.Angles(math.rad(45), 0, 0))
		end
	elseif shape == "crystal" then
		local ts = W * 0.75
		tipPart("BladeTip", Vector3.new(T * 1.3, ts * 1.6, ts), tipCf * CFrame.new(0, ts * 0.4, 0) * CFrame.Angles(math.rad(45), 0, 0) * CFrame.new(0, 0, 0))
		-- 옆으로 돋은 결정
		for i = 1, 4 do
			local cf = sample(segs, i / 5)
			local side = (i % 2 == 0) and 1 or -1
			tipPart("Crystal", Vector3.new(T * 1.2, 0.7, 0.28), cf * CFrame.new(0, 0, side * W * 0.45) * CFrame.Angles(math.rad(side * 40), 0, 0))
		end
	elseif style.prongs and (shape == "straight" or shape == "leaf" or shape == "spine" or shape == "flamberge" or shape == "hollow") then
		-- 갈라진 칼끝: 두 갈래로 벌어진다
		local tipSize = wEnd * 0.5
		for _, side in ipairs({ 1, -1 }) do
			tipPart("BladeTip", Vector3.new(T, tipSize * 1.6, tipSize * 0.7), tipCf * CFrame.new(0, tipSize * 0.5, side * wEnd * 0.24) * CFrame.Angles(math.rad(side * -14), 0, 0))
		end
	else
		local tipSize = wEnd * 0.71
		tipPart("BladeTip", Vector3.new(T, tipSize, tipSize), tipCf * CFrame.Angles(math.rad(45), 0, 0))
	end

	-- 용골: 칼등을 따라 척추뼈 같은 판
	if shape == "spine" then
		for i = 1, #segs do
			local sg = segs[i]
			mk(ctx, "Vertebra", Vector3.new(T * 1.6, sg.len * 0.55, 0.35), sg.cf * CFrame.new(0, 0, -(sg.width / 2 + 0.12)) * CFrame.Angles(math.rad(-25), 0, 0), color:Lerp(Color3.fromRGB(240, 230, 210), 0.4), Enum.Material.Marble)
		end
	end
	return segs, tipCf, hollow
end

------------------------------------------------------------------------
-- 가드: 보석, 날개, 검 왕관
------------------------------------------------------------------------
local function decorateGuard(ctx: Ctx, style: any, look: Look, guardY: number, guardW: number)
	local n = style.gems
	for i = 1, n do
		local z = (n == 1) and 0 or (-guardW * 0.35 + guardW * 0.7 * (i - 1) / (n - 1))
		mk(ctx, "Gem", Vector3.new(0.34, 0.34, 0.34), at(guardY, z, 45), (i == (n + 1) // 2) and look.accent or style.glow, Enum.Material.Neon)
	end
	if style.wings then
		local w = style.wingSize
		for _, side in ipairs({ 1, -1 }) do
			for f = 0, 2 do
				local len = (1.6 - f * 0.35) * w
				mk(ctx, "Wing", Vector3.new(0.12, len, 0.38 * w), at(guardY + 0.25 + f * 0.18, side * (guardW / 2 + len * 0.3), side * (35 + f * 18)), (f == 0) and GOLD:Lerp(style.glow, 0.5) or style.secondary, style.grade >= 70 and Enum.Material.Glass or Enum.Material.Foil)
			end
		end
	end
	if style.ornateGuard then
		for _, side in ipairs({ 1, -1 }) do
			for c = 0, 3 do
				local a = math.rad(c * 70)
				local r = 0.35
				local cf = CFrame.new(0, guardY + math.sin(a) * r, side * (guardW / 2 + 0.2 + math.cos(a) * r * 0.6)) * CFrame.Angles(side * a, 0, 0)
				mk(ctx, "Curl", Vector3.new(0.14, 0.32, 0.12), cf, GOLD:Lerp(style.primary, 0.3), Enum.Material.Foil)
			end
		end
	end
	if style.chains > 0 and not look.lite then
		for c = 1, style.chains do
			local z = -guardW * 0.4 + guardW * 0.8 * (c - 1) / math.max(style.chains - 1, 1)
			for l = 1, 5 do
				mk(ctx, "Chain", Vector3.new(0.08, 0.26, 0.16), CFrame.new(0, guardY - 0.15 - l * 0.24, z) * CFrame.Angles(0, (l % 2 == 0) and math.rad(90) or 0, 0), Color3.fromRGB(170, 170, 180), Enum.Material.Metal)
			end
			mk(ctx, "Tassel", Vector3.new(0.22, 0.22, 0.22), at(guardY - 1.45, z), style.primary, Enum.Material.Fabric, Enum.PartType.Ball)
		end
	end
	if style.crown and not look.lite then
		for i = 0, 7 do
			local a = (i / 8) * math.pi * 2
			mk(ctx, "CrownBlade", Vector3.new(0.1, 0.9, 0.22), CFrame.new(math.cos(a) * 0.5, guardY - 0.5, math.sin(a) * 0.5) * CFrame.Angles(0, -a, 0) * CFrame.Angles(0, 0, math.rad(-55)), GOLD:Lerp(style.glow, 0.3), Enum.Material.Foil)
		end
	end
end

------------------------------------------------------------------------
-- 계열별 모양
------------------------------------------------------------------------
type Dims = { handle: number, guardW: number, bladeW: number, bladeL: number, bladeT: number, pommel: boolean }

local DIMS: { [number]: Dims } = {
	[1] = { handle = 1.8, guardW = 2.8, bladeW = 1.25, bladeL = 5.6, bladeT = 0.26, pommel = true }, -- 대검
	[2] = { handle = 1.0, guardW = 1.1, bladeW = 0.5, bladeL = 3.0, bladeT = 0.16, pommel = false }, -- 쌍검
	[3] = { handle = 1.7, guardW = 1.8, bladeW = 0.52, bladeL = 7.0, bladeT = 0.18, pommel = true }, -- 장검
	[4] = { handle = 0.9, guardW = 0.9, bladeW = 0.44, bladeL = 1.9, bladeT = 0.15, pommel = false }, -- 단검
	[0] = { handle = 1.9, guardW = 3.0, bladeW = 1.4, bladeL = 6.6, bladeT = 0.3, pommel = true }, -- 올라운더
}

local function straightSword(ctx: Ctx, style: any, look: Look, typeId: number): BasePart
	local d = DIMS[typeId] or DIMS[1]
	local bladeL = d.bladeL * style.lengthMul
	local bladeW = d.bladeW * style.widthMul
	local guardColor = look.rarity >= 5 and GOLD or style.primary:Lerp(DARK_STEEL, 0.55)
	local handleColor = style.grade >= 50 and style.primary:Lerp(Color3.new(0, 0, 0), 0.6) or LEATHER
	mk(ctx, "Grip", Vector3.new(0.34, d.handle, 0.34), at(0), handleColor, Enum.Material.Fabric)
	for i = 1, 3 do
		mk(ctx, "Wrap", Vector3.new(0.38, 0.08, 0.38), at(-d.handle / 2 + d.handle * i / 4), guardColor, Enum.Material.Metal)
	end
	if d.pommel then
		local pommel = mk(ctx, "Pommel", Vector3.new(0.6, 0.6, 0.6), at(-d.handle / 2 - 0.2), guardColor, style.grade >= 30 and Enum.Material.Neon or Enum.Material.Metal, Enum.PartType.Ball)
		if style.grade >= 30 then
			pommel.Color = style.glow
		end
	end
	local guardY = d.handle / 2 + 0.12
	mk(ctx, "Guard", Vector3.new(0.48, 0.32, d.guardW), at(guardY), guardColor, Enum.Material.Metal)
	if typeId == 1 or typeId == 0 or typeId == 3 then
		for _, side in ipairs({ 1, -1 }) do
			mk(ctx, "GuardTip", Vector3.new(0.48, 0.6, 0.3), at(guardY + 0.18, side * d.guardW / 2), guardColor, Enum.Material.Metal)
		end
	end
	if typeId == 4 then
		mk(ctx, "Knuckle", Vector3.new(0.2, d.handle * 1.1, 0.14), at(0, -0.42), guardColor, Enum.Material.Metal)
	end
	decorateGuard(ctx, style, look, guardY, d.guardW)

	local bladeColor = bladeColorOf(style)
	local startY = guardY + 0.16
	local segs, tipCf, hollow = profileBlade(ctx, style, startY, bladeL, bladeW, d.bladeT, bladeColor)
	-- 궤적과 입자가 붙는 보이지 않는 심 (칼날 전체 길이)
	local core = mk(ctx, "BladeCoreLine", Vector3.new(0.05, bladeL, 0.05), at(startY + bladeL / 2), bladeColor, style.bladeMaterial)
	core.Transparency = 1
	if typeId == 0 then
		mk(ctx, "Core", Vector3.new(d.bladeT + 0.05, bladeL * 0.85, 0.3), at(startY + bladeL * 0.45), Color3.fromRGB(255, 150, 210), Enum.Material.Neon)
	end
	decorateBlade(ctx, style, look, core, segs, tipCf, { hollow = hollow })
	enhanceDecor(ctx, style, look, core, segs, tipCf, guardY, d.guardW)
	return core
end

-- 낫: 모양에 따라 날이 두 개, 세 개가 되거나 초승달처럼 크게 휜다
local function scytheBlade(ctx: Ctx, style: any, oy: number, radius: number, sweep: number, side: number, widthMul: number, bc: Color3, jagged: boolean, name: string): { Seg }
	local segs: { Seg } = {}
	local n = 6
	for i = 0, n - 1 do
		local a0 = math.rad(sweep * i / n)
		local a1 = math.rad(sweep * (i + 1) / n)
		local y0, z0 = oy - radius + radius * math.cos(a0), -side * radius * math.sin(a0)
		local y1, z1 = oy - radius + radius * math.cos(a1), -side * radius * math.sin(a1)
		local dy, dz = y1 - y0, z1 - z0
		local len = math.sqrt(dy * dy + dz * dz) + 0.08
		local width = (0.75 - 0.5 * (i / (n - 1))) * style.widthMul * widthMul
		local cf = CFrame.new(0, (y0 + y1) / 2, (z0 + z1) / 2) * CFrame.Angles(math.atan2(dz, dy), 0, 0) * CFrame.new(0, 0, side * (width / 2 - 0.1))
		local seg = mk(ctx, name .. i, Vector3.new(0.14, len, width), cf, bc, style.bladeMaterial)
		seg.Reflectance = style.reflect
		if style.edge then
			mk(ctx, "Edge" .. i, Vector3.new(0.16, len, 0.08), cf * CFrame.new(0, 0, side * width / 2), style.secondary, Enum.Material.Neon)
		end
		if jagged then
			mk(ctx, "Tooth" .. i, Vector3.new(0.12, 0.3, 0.3), cf * CFrame.new(0, 0, -side * width / 2) * CFrame.Angles(math.rad(45), 0, 0), bc, style.bladeMaterial)
		end
		if i % 2 == 0 and style.runes > i then
			mk(ctx, "Rune" .. i, Vector3.new(0.2, 0.18, 0.18), cf * CFrame.Angles(math.rad(45), 0, 0), style.glow, Enum.Material.Neon)
		end
		table.insert(segs, { cf = cf, len = len, width = width, thick = 0.14 })
	end
	return segs
end

local function scythe(ctx: Ctx, style: any, look: Look): BasePart
	local bc = bladeColorOf(style)
	local ringColor = look.rarity >= 5 and GOLD or style.primary:Lerp(DARK_STEEL, 0.5)
	local shaftLen = 6.4 * (1 + style.power * 0.2)
	local shaft = mk(ctx, "Shaft", Vector3.new(0.3, shaftLen, 0.3), at(shaftLen / 2 - 0.6), style.grade >= 50 and style.primary:Lerp(Color3.new(0, 0, 0), 0.55) or WOOD, Enum.Material.Wood)
	local bands = 3 + math.min(4, style.grade // 15)
	for i = 1, bands do
		mk(ctx, "Band", Vector3.new(0.4, 0.2, 0.4), at(-0.4 + (shaftLen - 0.4) * i / (bands + 1)), ringColor, Enum.Material.Metal)
	end
	local oy = shaftLen - 0.8
	decorateGuard(ctx, style, look, oy, 0.8)
	local shape = style.shape or "straight"
	local moon = shape == "crescent" or shape == "curved" or shape == "hook" or shape == "falchion"
	local jagged = shape == "flamberge" or shape == "spine" or shape == "cleaver" or shape == "crystal"
	-- 날: 자루 끝에서 원을 따라 아래로, 뒤로 휜다
	local radius = 2.6 * style.lengthMul * (moon and 1.1 or 1)
	local segs = scytheBlade(ctx, style, oy, radius, moon and 160 or 115, 1, 1, bc, jagged, "Blade")
	-- 30등급부터 반대쪽에 작은 날, 70등급부터 자루 아래쪽에 세 번째 날
	if style.grade >= 30 then
		scytheBlade(ctx, style, oy, radius * 0.6, 100, -1, 0.7, bc, jagged, "BackBlade")
	end
	if style.grade >= 70 then
		scytheBlade(ctx, style, oy - 2.2, radius * 0.45, 90, 1, 0.6, bc, false, "LowBlade")
	end
	mk(ctx, "TopSpike", Vector3.new(0.14, 0.5, 0.5) * (1 + style.power), at(oy + 0.35, 0, 45), bc, style.bladeMaterial)
	-- 장식은 자루 기준으로 붙인다 (구슬은 자루 위쪽을 돈다)
	local shaftSegs: { Seg } = { { cf = at(shaftLen / 2 - 0.6), len = shaftLen, width = 0.5, thick = 0.3 } }
	decorateBlade(ctx, style, look, shaft, shaftSegs, at(shaftLen - 0.6), { shaft = true })
	enhanceDecor(ctx, style, look, shaft, segs, segs[#segs].cf, oy, 0.8)
	return shaft
end

-- 무기 하나를 손에 붙인다. 손에 붙은 Model을 돌려준다
function Builder.build(parent: Instance, hand: BasePart, typeId: number, look: Look, gripOverride: CFrame?): Model
	local model = Instance.new("Model")
	model.Name = "Weapon"
	model.Parent = parent
	local grade = typeId == 0 and 100 or look.grade
	local style = GradeStyle.get(grade)
	local grip = gripOverride or (hand.CFrame * CFrame.new(0, -hand.Size.Y / 2, 0) * CFrame.Angles(math.rad(-90), 0, 0))
	local ctx: Ctx = { parent = model, hand = hand, grip = grip, scale = (look.scale or 1) * style.scale }
	if typeId == 5 then
		scythe(ctx, style, look)
	else
		straightSword(ctx, style, look, typeId)
	end
	return model
end

------------------------------------------------------------------------
-- 캐릭터 오라: 장착한 무기 등급마다 다르다
------------------------------------------------------------------------
function Builder.applyAura(char: Model, grade: number)
	local root = char:FindFirstChild("HumanoidRootPart")
	if not (root and root:IsA("BasePart")) then
		return
	end
	local old = char:FindFirstChild("ArenaAura")
	if old then
		old:Destroy()
	end
	for _, child in ipairs(root:GetChildren()) do
		if child.Name == "RankAura" then
			child:Destroy()
		end
	end
	local style = GradeStyle.get(grade)
	local holder = Instance.new("Model")
	holder.Name = "ArenaAura"
	holder.Parent = char

	if style.aura then
		local pe = emitter(root, style, style.auraRate, 0.5 + style.power * 0.9, {
			name = "RankAura",
			lifetime = NumberRange.new(0.8, 1.5),
			speed = NumberRange.new(1, 3),
		})
		pe.SpreadAngle = Vector2.new(40, 40)
		pe.EmissionDirection = Enum.NormalId.Top
	end
	if style.groundRing then
		orbitPart(holder, root, Vector3.new(0.12, 4.5 + style.grade * 0.05, 4.5 + style.grade * 0.05), style.glow, Enum.Material.ForceField, Enum.PartType.Cylinder, {
			name = "AuraRing",
			height = -2.85,
			speed = 0.8,
			flat = true,
			transparency = 0.3,
		})
	end
	if style.secondRing then
		orbitPart(holder, root, Vector3.new(0.1, 7 + style.grade * 0.04, 7 + style.grade * 0.04), style.secondary, Enum.Material.ForceField, Enum.PartType.Cylinder, {
			name = "AuraRing2",
			height = -2.8,
			speed = -0.6,
			flat = true,
			transparency = 0.2,
		})
	end
	for i = 1, style.bodyOrbs do
		local orb = orbitPart(holder, root, Vector3.new(0.6, 0.6, 0.6) * (1 + style.power * 0.5), (i % 2 == 0) and style.secondary or style.glow, Enum.Material.Glass, Enum.PartType.Ball, {
			name = "AuraOrb",
			radius = 3.2,
			height = 0.2 + (i % 3) * 0.6,
			speed = 1.6,
			phase = i * (math.pi * 2 / style.bodyOrbs),
		})
		local tr = Instance.new("Trail")
		local a0 = Instance.new("Attachment")
		a0.Position = Vector3.new(0, 0.25, 0)
		a0.Parent = orb
		local a1 = Instance.new("Attachment")
		a1.Position = Vector3.new(0, -0.25, 0)
		a1.Parent = orb
		tr.Attachment0 = a0
		tr.Attachment1 = a1
		tr.Lifetime = 0.35
		tr.LightEmission = 0.3
		tr.Color = style.rainbow and GradeStyle.RAINBOW or ColorSequence.new(orb.Color)
		tr.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.4), NumberSequenceKeypoint.new(1, 1) })
		tr.Parent = orb
	end
	local torso = char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso")
	if style.bodyWings and torso and torso:IsA("BasePart") then
		local size = 1 + (style.grade - 65) / 25
		local ctx: Ctx = { parent = holder, hand = torso, grip = torso.CFrame * CFrame.new(0, 0.4, torso.Size.Z / 2 + 0.25), scale = 1 }
		for _, side in ipairs({ 1, -1 }) do
			for f = 0, 3 do
				local len = (2.8 - f * 0.45) * size
				local cf = CFrame.new(side * (0.5 + len * 0.35), 0.4 - f * 0.35, f * 0.05) * CFrame.Angles(0, 0, math.rad(side * (-60 + f * 22)))
				local feather = mk(ctx, "Wing", Vector3.new(0.12, len, 0.55 * size), CFrame.new(cf.Position) * cf.Rotation * CFrame.Angles(0, math.rad(90), 0), (f % 2 == 0) and GOLD:Lerp(style.glow, 0.6) or style.secondary, style.grade >= 85 and Enum.Material.Glass or Enum.Material.Foil)
				feather.Transparency = 0.05
			end
		end
	end
	local head = char:FindFirstChild("Head")
	if style.bodyHalo and head and head:IsA("BasePart") then
		local ctx: Ctx = { parent = holder, hand = head, grip = head.CFrame * CFrame.new(0, head.Size.Y / 2 + 0.7, 0), scale = 1 }
		for i = 0, 11 do
			local a = (i / 12) * math.pi * 2
			mk(ctx, "Halo", Vector3.new(0.12, 0.12, 0.5), CFrame.new(math.cos(a) * 0.95, 0, math.sin(a) * 0.95) * CFrame.Angles(0, -a, 0), GOLD:Lerp(style.glow, 0.3), Enum.Material.Foil)
		end
	end
	if style.bodyLight then
		local light = Instance.new("PointLight")
		light.Name = "RankAura"
		light.Color = style.glow
		light.Range = 6 + style.power * 6
		light.Brightness = 0.4 + style.power * 0.6
		light.Parent = root
	end
end

return Builder
]]></string>
      </Properties>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="6">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Script" referent="7">
      <Properties>
        <string name="Name">ArenaServer</string>
        <token name="RunContext">0</token>
        <string name="Source"><![CDATA[-- ArenaServer (Script, ServerScriptService)
-- 전투, 웨이브, 스킬, 필살기, 합성, 훈련, 저장을 맡는다.
--   WorldBuilder  조명, 로비, 투기장
--   EnemyBuilder  적 7종의 생김새
--   EnemyAI       적 종류별 행동과 보스 기술
--   Skills        무기 스킬 (E, F)
-- 중요한 계산은 전부 서버에서 하고, 클라이언트는 요청만 보낸다.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local DataStoreService = game:GetService("DataStoreService")
local ServerStorage = game:GetService("ServerStorage")
local Debris = game:GetService("Debris")
local RunService = game:GetService("RunService")

local Config = require(ReplicatedStorage:WaitForChild("GameConfig"))
local WeaponBuilder = require(ReplicatedStorage:WaitForChild("WeaponBuilder"))
local GradeStyle = require(ReplicatedStorage:WaitForChild("GradeStyle"))
local AuraBuilder = require(ReplicatedStorage:WaitForChild("AuraBuilder"))
local World = require(script:WaitForChild("WorldBuilder"))
local EnemyBuilder = require(script:WaitForChild("EnemyBuilder"))
local EnemyAI = require(script:WaitForChild("EnemyAI"))
local Skills = require(script:WaitForChild("Skills"))

local ARENA_ORIGIN = Vector3.new(0, 300, 1600)
local ARENA_SPACING = 320
local ARENA_RADIUS = 60
local ENEMY_SPAWN_RADIUS = 36
local SAVE_INTERVAL = 90
local DATASTORE_NAME = "Arena100_v1"
local WALK_ANIM_ID = "rbxassetid://507777826" -- 로블록스 기본 R15 걷기

------------------------------------------------------------------------
-- 통신 채널
------------------------------------------------------------------------
local remoteFolder = Instance.new("Folder")
remoteFolder.Name = "ArenaRemotes"
local Request = Instance.new("RemoteEvent")
Request.Name = "Request"
Request.Parent = remoteFolder
local Push = Instance.new("RemoteEvent")
Push.Name = "Push"
Push.Parent = remoteFolder
remoteFolder.Parent = ReplicatedStorage

local battleRoot = Instance.new("Folder")
battleRoot.Name = "ArenaBattles"
battleRoot.Parent = workspace

------------------------------------------------------------------------
-- 맵
------------------------------------------------------------------------
World.setupLighting()
local lobbySpawn: CFrame = World.buildLobby({
	gate = function(player: Player)
		Push:FireClient(player, "openPage", "stage")
	end,
	forge = function(player: Player)
		Push:FireClient(player, "openPage", "armory")
	end,
	train = function(player: Player)
		Push:FireClient(player, "openPage", "train")
	end,
	shrine = function(player: Player)
		Push:FireClient(player, "openPage", "cosmetics")
	end,
})

local arenas: { [number]: World.Arena } = {}
local slotOwner: { [number]: Player } = {}

local function claimSlot(player: Player): number
	local i = 1
	while slotOwner[i] do
		i += 1
	end
	slotOwner[i] = player
	if not arenas[i] then
		arenas[i] = World.buildArena(ARENA_ORIGIN + Vector3.new((i - 1) * ARENA_SPACING, 0, 0), ARENA_RADIUS, "Arena" .. i)
	end
	return i
end

------------------------------------------------------------------------
-- 저장
------------------------------------------------------------------------
local store: DataStore? = nil
do
	local ok, ds = pcall(function()
		return DataStoreService:GetDataStore(DATASTORE_NAME)
	end)
	if ok then
		store = ds
	end
end

type Profile = {
	version: number,
	coins: number,
	atkLv: number,
	hpLv: number,
	maxStage: number,
	inv: { [string]: number },
	equipped: string,
	enh: { [string]: number }, -- 무기별 강화 단계
	auras: { [string]: boolean }, -- 산 아우라 (키는 단계 번호 문자열)
	kills: { [string]: boolean }, -- 산 킬 이펙트
	aura: number, -- 장착한 아우라 단계 (0 = 없음)
	kill: number, -- 장착한 킬 이펙트 단계 (0 = 없음)
}

local function defaultProfile(): Profile
	return {
		version = 1,
		coins = 0,
		atkLv = 0,
		hpLv = 0,
		maxStage = 0,
		inv = { [Config.STARTER_KEY] = 1 },
		equipped = Config.STARTER_KEY,
		enh = {},
		auras = {},
		kills = {},
		aura = 0,
		kill = 0,
	}
end

local function bestKey(p: Profile): string
	local best, bestPower = Config.STARTER_KEY, -1
	for key in pairs(p.inv) do
		local power = Config.profileStats(p, key).power
		if power > bestPower then
			best, bestPower = key, power
		end
	end
	return best
end

local function sanitize(data: any): Profile
	local p = defaultProfile()
	if type(data) ~= "table" then
		return p
	end
	local function num(v, lo, hi)
		if type(v) ~= "number" or v ~= v then
			return lo
		end
		return math.clamp(v, lo, hi)
	end
	p.coins = num(data.coins, 0, math.huge)
	p.atkLv = math.floor(num(data.atkLv, 0, 100000))
	p.hpLv = math.floor(num(data.hpLv, 0, 100000))
	p.maxStage = math.floor(num(data.maxStage, 0, Config.MAX_STAGE))
	if type(data.inv) == "table" then
		local inv = {}
		for k, v in pairs(data.inv) do
			if Config.parseKey(k) and type(v) == "number" and v >= 1 then
				inv[k] = math.floor(v)
			end
		end
		if next(inv) then
			p.inv = inv
		end
	end
	if type(data.enh) == "table" then
		for k, v in pairs(data.enh) do
			if Config.parseKey(k) and type(v) == "number" and v >= 1 then
				p.enh[k] = math.clamp(math.floor(v), 0, Config.MAX_ENHANCE)
			end
		end
	end
	local function owned(src: any, list: { any }): { [string]: boolean }
		local out = {}
		if type(src) == "table" then
			for k, v in pairs(src) do
				local n = tonumber(k)
				if v == true and n and list[n] then
					out[tostring(math.floor(n))] = true
				end
			end
		end
		return out
	end
	p.auras = owned(data.auras, Config.Auras)
	p.kills = owned(data.kills, Config.KillFx)
	local a = math.floor(num(data.aura, 0, #Config.Auras))
	p.aura = (a > 0 and p.auras[tostring(a)]) and a or 0
	local k = math.floor(num(data.kill, 0, #Config.KillFx))
	p.kill = (k > 0 and p.kills[tostring(k)]) and k or 0
	if type(data.equipped) == "string" and p.inv[data.equipped] then
		p.equipped = data.equipped
	else
		p.equipped = bestKey(p)
	end
	return p
end

-- 테스트 계정: 스튜디오에서 플레이하거나 게임 주인이 들어오면 켜진다
local function isTester(player: Player): boolean
	if not Config.TEST_MODE then
		return false
	end
	if RunService:IsStudio() then
		return true
	end
	return game.CreatorType == Enum.CreatorType.User and player.UserId == game.CreatorId
end

-- 만렙 계정: 모든 스테이지가 열려 있고, 계열마다 여러 등급 무기를 미리 넣어 둔다
local function testerProfile(): Profile
	local p = defaultProfile()
	p.coins = 1e40
	p.maxStage = Config.MAX_STAGE
	p.inv = {}
	for _, g in ipairs({ 1, 15, 30, 45, 60, 75, 90, 100 }) do
		for t = 1, 5 do
			p.inv[Config.itemKey(g, t)] = 3
		end
	end
	p.inv[Config.ALLROUNDER_KEY] = 1
	p.equipped = Config.itemKey(100, 1)
	-- 100등급과 올라운더는 +10 강화
	for t = 0, 5 do
		p.enh[Config.itemKey(100, t)] = Config.MAX_ENHANCE
	end
	for i = 1, #Config.Auras do
		p.auras[tostring(i)] = true
	end
	for i = 1, #Config.KillFx do
		p.kills[tostring(i)] = true
	end
	p.aura = #Config.Auras
	p.kill = #Config.KillFx
	return p
end

local function loadProfile(player: Player): (Profile, boolean)
	local ds = store
	if not ds then
		return defaultProfile(), false
	end
	for attempt = 1, 3 do
		local ok, result = pcall(function()
			return ds:GetAsync("p_" .. player.UserId)
		end)
		if ok then
			return sanitize(result), true
		end
		warn("[Arena] 불러오기 실패 (" .. attempt .. "/3):", result)
		task.wait(1.5 * attempt)
	end
	-- 불러오기에 실패했을 때 저장까지 하면 기존 기록을 덮어쓰므로 저장을 끈다
	return defaultProfile(), false
end

------------------------------------------------------------------------
-- 플레이어 상태
------------------------------------------------------------------------
type Enemy = {
	model: Model,
	hum: Humanoid,
	root: BasePart,
	kind: string,
	cfg: any,
	accent: Color3,
	hp: number,
	maxHp: number,
	dmg: number,
	slamDmg: number,
	isBoss: boolean,
	alive: boolean,
	busy: boolean,
	reach: number,
	bodyRadius: number,
	scale: number,
	nextAttack: number,
	nextSpecial: number,
	nextMove: number,
	stunUntil: number,
	frozenUntil: number,
	poisonUntil: number,
	poisonDmg: number,
	nextPoison: number,
	markStacks: number,
	patterns: { string },
	patternIndex: number,
	fill: Frame,
	walkTrack: AnimationTrack?,
	walking: boolean,
	baseSpeed: number,
	elite: any?,
	phaseUntil: number,
	isMini: boolean,
	animN: number?,
}

type Session = {
	stage: number,
	info: any,
	arena: World.Arena,
	folder: Folder,
	enemies: { Enemy },
	waveIndex: number,
	waveSpawning: boolean,
	stats: any,
	hp: number,
	maxHp: number,
	invulnUntil: number,
	lastAttack: number,
	gauge: number,
	ulting: boolean,
	running: boolean,
	skillReadyAt: { number },
	poisonUntil: number,
	smokeCrit: number?,
	smokeCharges: number,
	parryUntil: number,
	marks: { [Enemy]: boolean },
	skillTier: number,
	zones: { any },
	comboStep: number,
	nextPulse: number,
}

type State = {
	slot: number?,
	session: Session?,
	auto: boolean,
	canSave: boolean,
	dirty: boolean,
	reqCount: number,
	reqWindow: number,
	lastDash: number,
	tester: boolean,
	god: boolean,
	noCooldown: boolean,
}

local profiles: { [Player]: Profile } = {}
local states: { [Player]: State } = {}

local function saveProfile(player: Player)
	local st, p, ds = states[player], profiles[player], store
	if not (st and p and ds and st.canSave) then
		return
	end
	local ok, err = pcall(function()
		ds:SetAsync("p_" .. player.UserId, p)
	end)
	if ok then
		st.dirty = false
	else
		warn("[Arena] 저장 실패:", err)
	end
end

local function getRoot(player: Player): (BasePart?, Humanoid?)
	local char = player.Character
	if not char then
		return nil, nil
	end
	local root = char:FindFirstChild("HumanoidRootPart")
	local hum = char:FindFirstChildOfClass("Humanoid")
	if root and root:IsA("BasePart") and hum and hum.Health > 0 then
		return root, hum
	end
	return nil, nil
end

local function currentStats(player: Player)
	return Config.profileStats(profiles[player])
end

local function toast(player: Player, text: string)
	Push:FireClient(player, "toast", text)
end

local function pushState(player: Player)
	local p, st = profiles[player], states[player]
	if not p or not st then
		return
	end
	Push:FireClient(player, "state", {
		coins = p.coins,
		atkLv = p.atkLv,
		hpLv = p.hpLv,
		maxStage = p.maxStage,
		inv = p.inv,
		equipped = p.equipped,
		enh = p.enh,
		auras = p.auras,
		kills = p.kills,
		aura = p.aura,
		kill = p.kill,
		power = currentStats(player).power,
		auto = st.auto,
		canSave = st.canSave,
		tester = st.tester,
		god = st.god,
		noCooldown = st.noCooldown,
	})
end

local function aliveList(s: Session): { Enemy }
	local list = {}
	for _, e in ipairs(s.enemies) do
		if e.alive and e.root.Parent then
			table.insert(list, e)
		end
	end
	return list
end

local function aliveCount(s: Session): number
	local n = 0
	for _, e in ipairs(s.enemies) do
		if e.alive then
			n += 1
		end
	end
	return n
end

local function pushBattle(player: Player)
	local st = states[player]
	local s = st and st.session
	if not s then
		Push:FireClient(player, "battle", { active = false })
		return
	end
	Push:FireClient(player, "battle", {
		active = true,
		stage = s.stage,
		boss = s.info.isBoss,
		hp = s.hp,
		maxHp = s.maxHp,
		left = aliveCount(s),
		total = #s.enemies,
		wave = s.waveIndex,
		waveTotal = #s.info.waves,
		auto = st.auto,
		gauge = s.gauge,
		typeId = s.stats.weapon.typeId,
		skillTier = Config.skillTier(s.stats.weapon.grade, s.stats.weapon.typeId),
	})
end

-- 명예의 전당: 이 서버 최고 기록 5명
local function refreshHall()
	local list = {}
	for player, p in pairs(profiles) do
		if p.maxStage > 0 then
			table.insert(list, { name = player.DisplayName, stage = p.maxStage })
		end
	end
	table.sort(list, function(a, b)
		return a.stage > b.stage
	end)
	World.setHallOfFame(list)
end

------------------------------------------------------------------------
-- 칭호, 무기, 오라
------------------------------------------------------------------------
local function updateTitle(player: Player)
	local p = profiles[player]
	if not p then
		return
	end
	local ls = player:FindFirstChild("leaderstats")
	local rankName = p.maxStage > 0 and (Config.stageName(p.maxStage)) or "-"
	if ls then
		local rankValue = ls:FindFirstChild("등급")
		local stageValue = ls:FindFirstChild("스테이지")
		if rankValue and rankValue:IsA("StringValue") then
			rankValue.Value = rankName
		end
		if stageValue and stageValue:IsA("IntValue") then
			stageValue.Value = p.maxStage
		end
	end

	local char = player.Character
	local head = char and char:FindFirstChild("Head")
	if not head then
		return
	end
	for _, name in ipairs({ "RankTitle", "TitleSparkle" }) do
		local old = head:FindFirstChild(name)
		if old then
			old:Destroy()
		end
	end
	local gui = Instance.new("BillboardGui")
	gui.Name = "RankTitle"
	gui.Size = UDim2.new(0, 300, 0, 46)
	gui.StudsOffset = Vector3.new(0, 2.6, 0)
	gui.MaxDistance = 160
	gui.LightInfluence = 0
	local top = Instance.new("TextLabel")
	top.Size = UDim2.new(1, 0, 0.35, 0)
	top.BackgroundTransparency = 1
	top.Font = Enum.Font.GothamBold
	top.TextScaled = true
	top.TextColor3 = Color3.fromRGB(230, 220, 200)
	top.TextStrokeTransparency = 0.4
	top.Parent = gui
	local main = Instance.new("TextLabel")
	main.Position = UDim2.new(0, 0, 0.35, 0)
	main.Size = UDim2.new(1, 0, 0.65, 0)
	main.BackgroundTransparency = 1
	main.Font = Enum.Font.GothamBlack
	main.TextScaled = true
	main.TextStrokeTransparency = 0.15
	main.Parent = gui
	if p.maxStage <= 0 then
		top.Text = "도전자"
		main.Text = "NO RANK"
		main.TextColor3 = Color3.fromRGB(170, 170, 170)
	else
		local section, sectionIndex = Config.getSection(math.min(p.maxStage, Config.MAX_GRADE))
		local style = GradeStyle.get(Config.stageGrade(p.maxStage))
		if Config.isBeyond(p.maxStage) then
			top.Text = string.format("초월자 · %d층 돌파 · %s의 기운", p.maxStage - Config.MAX_GRADE, style.motif.name)
		else
			top.Text = string.format("%d구간 %s · %s의 기운", sectionIndex, section.name, style.motif.name)
		end
		top.TextColor3 = style.glow
		main.Text = string.format("[%d] %s", p.maxStage, rankName)
		main.TextColor3 = Color3.new(1, 1, 1)
		main.TextStrokeColor3 = style.primary:Lerp(Color3.new(0, 0, 0), 0.75)
		local g = Instance.new("UIGradient")
		g.Color = Config.isBeyond(p.maxStage) and GradeStyle.RAINBOW or GradeStyle.gradient(Config.stageGrade(p.maxStage))
		g.Parent = main
		-- 높은 등급은 칭호 주위에도 입자가 흩날린다
		if p.maxStage >= 30 then
			local glowPart = Instance.new("Attachment")
			glowPart.Name = "TitleSparkle"
			glowPart.Position = Vector3.new(0, 3.2, 0)
			glowPart.Parent = head
			local pe = Instance.new("ParticleEmitter")
			pe.Texture = style.motif.tex
			pe.Rate = 4 + math.min(p.maxStage, 150) * 0.1
			pe.Lifetime = NumberRange.new(0.6, 1.2)
			pe.Speed = NumberRange.new(0.5, 1.5)
			pe.SpreadAngle = Vector2.new(180, 30)
			pe.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.25), NumberSequenceKeypoint.new(1, 0) })
			pe.LightEmission = 1
			pe.Color = g.Color
			pe.Parent = glowPart
		end
	end
	gui.Parent = head
end

local function attachWeapon(player: Player)
	local p = profiles[player]
	local char = player.Character
	if not p or not char then
		return
	end
	local old = char:FindFirstChild("ArenaWeapon")
	if old then
		old:Destroy()
	end
	local info = Config.weaponInfo(p.equipped)
	if not info then
		return
	end
	local right = char:FindFirstChild("RightHand") or char:FindFirstChild("Right Arm")
	local left = char:FindFirstChild("LeftHand") or char:FindFirstChild("Left Arm")
	if not (right and right:IsA("BasePart")) then
		return
	end
	local grade = info.typeId == 0 and 100 or info.grade
	local look = {
		grade = grade,
		accent = info.typeId == 0 and Color3.fromRGB(255, 235, 160) or info.rarity.color,
		rarity = info.rarity.rank,
		scale = 1,
		enh = p.enh[p.equipped] or 0,
	}
	local holder = Instance.new("Model")
	holder.Name = "ArenaWeapon"
	holder.Parent = char
	WeaponBuilder.build(holder, right, info.typeId, look)
	if info.typeId == 2 and left and left:IsA("BasePart") then
		WeaponBuilder.build(holder, left, 2, look)
	end
	-- 산 아우라를 장착했으면 그걸, 아니면 무기 등급 오라
	if p.aura > 0 then
		AuraBuilder.apply(char, p.aura)
	else
		AuraBuilder.clear(char)
		WeaponBuilder.applyAura(char, grade)
	end
end

------------------------------------------------------------------------
-- 적 만들기
------------------------------------------------------------------------
local rigTemplate: Model? = nil
local rigLoading = false

local function buildBlockRig(): Model
	local model = Instance.new("Model")
	local root = Instance.new("Part")
	root.Name = "HumanoidRootPart"
	root.Size = Vector3.new(2, 2, 1)
	root.Parent = model
	local head = Instance.new("Part")
	head.Name = "Head"
	head.Size = Vector3.new(1.4, 1.4, 1.4)
	head.CFrame = root.CFrame * CFrame.new(0, 1.7, 0)
	head.Parent = model
	local weld = Instance.new("WeldConstraint")
	weld.Part0 = root
	weld.Part1 = head
	weld.Parent = head
	local hum = Instance.new("Humanoid")
	hum.RigType = Enum.HumanoidRigType.R15
	hum.HipHeight = 1.5
	hum.Parent = model
	model.PrimaryPart = root
	return model
end

local function getRigTemplate(): Model
	while rigLoading and not rigTemplate do
		task.wait(0.1)
	end
	if rigTemplate then
		return rigTemplate
	end
	rigLoading = true
	local ok, result = pcall(function()
		local desc = Instance.new("HumanoidDescription")
		return Players:CreateHumanoidModelFromDescription(desc, Enum.HumanoidRigType.R15)
	end)
	local model: Model
	if ok and result then
		model = result
	else
		warn("[Arena] 기본 인형을 만들지 못해 블록 인형을 씁니다:", result)
		model = buildBlockRig()
	end
	model.Name = "EnemyRig"
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("BodyColors") or d:IsA("Clothing") or d:IsA("ShirtGraphic") then
			d:Destroy()
		end
	end
	model.Parent = ServerStorage
	rigTemplate = model
	rigLoading = false
	return model
end

local function makeHpBar(root: BasePart, title: string, sub: string, color: Color3, height: number, isBoss: boolean): Frame
	local gui = Instance.new("BillboardGui")
	gui.Name = "HpBar"
	gui.Size = isBoss and UDim2.new(0, 240, 0, 54) or UDim2.new(0, 150, 0, 42)
	gui.StudsOffset = Vector3.new(0, height, 0)
	gui.AlwaysOnTop = true
	gui.MaxDistance = 130
	gui.LightInfluence = 0
	local tag = Instance.new("TextLabel")
	tag.Size = UDim2.new(1, 0, 0.28, 0)
	tag.BackgroundTransparency = 1
	tag.Font = Enum.Font.GothamBold
	tag.TextScaled = true
	tag.TextColor3 = Color3.fromRGB(235, 225, 210)
	tag.TextStrokeTransparency = 0.3
	tag.Text = sub
	tag.Parent = gui
	local name = Instance.new("TextLabel")
	name.Position = UDim2.new(0, 0, 0.26, 0)
	name.Size = UDim2.new(1, 0, 0.4, 0)
	name.BackgroundTransparency = 1
	name.Font = Enum.Font.GothamBlack
	name.TextScaled = true
	name.TextColor3 = color
	name.TextStrokeTransparency = 0.2
	name.Text = title
	name.Parent = gui
	local back = Instance.new("Frame")
	back.Size = UDim2.new(1, 0, 0.26, 0)
	back.Position = UDim2.new(0, 0, 0.72, 0)
	back.BackgroundColor3 = Color3.fromRGB(25, 15, 15)
	back.BorderSizePixel = 0
	back.Parent = gui
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 4)
	corner.Parent = back
	local stroke = Instance.new("UIStroke")
	stroke.Color = isBoss and Color3.fromRGB(255, 200, 80) or Color3.fromRGB(0, 0, 0)
	stroke.Thickness = isBoss and 2 or 1
	stroke.Parent = back
	local fill = Instance.new("Frame")
	fill.Name = "Fill"
	fill.Size = UDim2.fromScale(1, 1)
	fill.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
	fill.BorderSizePixel = 0
	fill.Parent = back
	local fillCorner = Instance.new("UICorner")
	fillCorner.CornerRadius = UDim.new(0, 4)
	fillCorner.Parent = fill
	local grad = Instance.new("UIGradient")
	grad.Color = ColorSequence.new(Color3.fromRGB(255, 120, 90), Color3.fromRGB(190, 30, 40))
	grad.Rotation = 90
	grad.Parent = fill
	gui.Parent = root
	return fill
end

local ELITE_BY_ID: { [string]: any } = {}
for _, a in ipairs(Config.EliteAffixes) do
	ELITE_BY_ID[a.id] = a
end

-- opts: { elite = 정예 특성 id, mini = 분열된 작은 몸, hp = 체력 직접 지정 }
local function spawnUnit(s: Session, kind: string, pos: Vector3, isBoss: boolean?, opts: any?)
	local cfg = Config.EnemyTypes[kind] or Config.EnemyTypes.grunt
	local o = opts or {}
	local elite = o.elite and ELITE_BY_ID[o.elite] or nil
	local grade = Config.stageGrade(s.stage)
	local model = getRigTemplate():Clone()
	local hum = model:FindFirstChildOfClass("Humanoid")
	local root = model:FindFirstChild("HumanoidRootPart")
	if not hum or not root or not root:IsA("BasePart") then
		model:Destroy()
		return
	end
	local style = GradeStyle.get(grade)
	hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
	local baseSpeed = (isBoss and 11 or cfg.speed) * (elite and elite.speed or 1)
	hum.WalkSpeed = baseSpeed
	hum.BreakJointsOnDeath = false
	hum:SetStateEnabled(Enum.HumanoidStateType.Dead, false)

	-- 등급이 오를수록 조금씩 커진다
	local scale = (1 + (grade - 1) * 0.006) * cfg.scale * (isBoss and 1.8 or 1) * (elite and elite.scale or 1) * (o.mini and 0.6 or 1)
	pcall(function()
		model:ScaleTo(scale)
	end)
	local stageEn = Config.stageName(s.stage)
	model.Name = (isBoss and "BOSS " or "") .. stageEn
	model:SetAttribute("Enemy", true)
	model:SetAttribute("Kind", kind)
	if isBoss then
		model:SetAttribute("Boss", true)
	end
	model:PivotTo(CFrame.lookAt(pos + Vector3.new(0, 4 * scale, 0), s.arena.center + Vector3.new(0, 4 * scale, 0)))
	EnemyBuilder.dress(model, kind, grade, isBoss == true, scale, { elite = elite and elite.id, beyond = Config.isBeyond(s.stage) })
	model.Parent = s.folder
	pcall(function()
		(root :: BasePart):SetNetworkOwner(nil)
	end)

	local walkTrack: AnimationTrack? = nil
	pcall(function()
		local animator = hum:FindFirstChildOfClass("Animator")
		if not animator then
			animator = Instance.new("Animator")
			animator.Parent = hum
		end
		local anim = Instance.new("Animation")
		anim.AnimationId = WALK_ANIM_ID
		local track = (animator :: Animator):LoadAnimation(anim)
		track.Looped = true
		walkTrack = track
	end)

	local info = s.info
	local hp = isBoss and info.bossHp or info.unitHp * cfg.hp
	if elite then
		hp *= 1.5 * (elite.hp or 1)
	end
	if o.hp then
		hp = o.hp
	end
	local dmg = (isBoss and info.bossDmg or info.unitDmg * cfg.dmg) * (elite and elite.dmg or 1) * (o.mini and 0.6 or 1)
	local title = string.format("%s[%d] %s", isBoss and "👑 " or "", s.stage, stageEn)
	local sub = isBoss and ("BOSS · " .. cfg.name) or cfg.name
	if elite then
		sub = string.format("★정예 %s · %s", elite.name, cfg.name)
	elseif o.mini then
		sub = "작은 " .. cfg.name
	end
	local barColor = isBoss and Color3.fromRGB(255, 110, 90) or (elite and Color3.fromRGB(255, 210, 90) or GradeStyle.textColor(grade))
	local fill = makeHpBar(root, title, sub, barColor, 3.4 * scale, isBoss == true)
	local now = os.clock()
	table.insert(s.enemies, {
		model = model,
		hum = hum,
		root = root,
		kind = kind,
		cfg = cfg,
		accent = style.glow,
		hp = hp,
		maxHp = hp,
		dmg = dmg,
		slamDmg = info.slamDmg,
		isBoss = isBoss == true,
		alive = true,
		busy = false,
		reach = 4.5 * scale,
		bodyRadius = 1.2 * scale,
		scale = scale,
		nextAttack = now + 1 + math.random(),
		nextSpecial = now + 2 + math.random() * 2,
		nextMove = 0,
		stunUntil = 0,
		frozenUntil = 0,
		poisonUntil = 0,
		poisonDmg = 0,
		nextPoison = 0,
		markStacks = 0,
		patterns = isBoss and info.bossPatterns or {},
		patternIndex = 1,
		fill = fill,
		walkTrack = walkTrack,
		walking = false,
		baseSpeed = baseSpeed,
		elite = elite,
		phaseUntil = 0,
		isMini = o.mini == true,
	})
end

local function updateWalk(e: Enemy, now: number)
	local track = e.walkTrack
	if not track then
		return
	end
	local moving = e.alive and now >= e.frozenUntil and e.root.AssemblyLinearVelocity.Magnitude > 1.5
	if moving ~= e.walking then
		e.walking = moving
		if moving then
			track:Play(0.15)
		else
			track:Stop(0.15)
		end
	end
	if now < e.frozenUntil then
		track:AdjustSpeed(0)
	elseif track.Speed == 0 then
		track:AdjustSpeed(1)
	end
end

local function flashEnemy(e: Enemy, color: Color3, duration: number)
	local h = Instance.new("Highlight")
	h.FillColor = color
	h.FillTransparency = 0.3
	h.OutlineTransparency = 1
	h.DepthMode = Enum.HighlightDepthMode.Occluded
	h.Parent = e.model
	Debris:AddItem(h, duration)
end

------------------------------------------------------------------------
-- 전투 기본
------------------------------------------------------------------------
local startStage: (Player, any, boolean) -> ()
local loseBattle: (Player, State, Session) -> ()

local function endSession(player: Player, st: State)
	local s = st.session
	if not s then
		return
	end
	s.running = false
	st.session = nil
	s.folder:Destroy()
	pushBattle(player)
end

local function teleportToLobby(player: Player)
	local char = player.Character
	if char then
		local offset = Vector3.new(math.random(-8, 8), 0, math.random(-8, 8))
		char:PivotTo(lobbySpawn + offset)
	end
end

local function flat(v: Vector3): Vector3
	return Vector3.new(v.X, 0, v.Z)
end

local function flatUnit(v: Vector3): Vector3
	local f = flat(v)
	if f.Magnitude < 0.001 then
		return Vector3.new(0, 0, -1)
	end
	return f.Unit
end

local function weaponColor(stats: any): Color3
	return stats.weapon.typeId == 0 and Color3.fromRGB(255, 235, 160) or stats.weapon.rarity.color
end

local hitEnemy: (Player, Session, Enemy, number, boolean, Vector3, { any }, any?) -> number
local sendHits: (Player, { any }) -> ()

-- 킬 이펙트 폭발: 쓰러진 자리가 터져 주위 적에게 피해 (그 폭발로 또 쓰러지면 연쇄)
local function killBlast(player: Player, s: Session, pos: Vector3)
	local fx = s.stats.killFx
	if not fx or not s.running then
		return
	end
	local hits = {}
	for _, other in ipairs(s.enemies) do
		if other.alive and other.root.Parent and (flat(other.root.Position) - flat(pos)).Magnitude <= fx.blast.radius + other.bodyRadius then
			hitEnemy(player, s, other, s.stats.atk * fx.blast.mult, false, pos, hits, { pierce = true, kind = "blast" })
		end
	end
	sendHits(player, hits)
end

local function killEnemy(player: Player, s: Session, e: Enemy, selfDestruct: boolean?)
	if not e.alive then
		return
	end
	e.alive = false
	e.model:SetAttribute("Dead", true)
	e.hum.WalkSpeed = 0
	s.marks[e] = nil
	local pos = e.root.Position
	if not selfDestruct then
		local fx = s.stats.killFx
		local near = {}
		if fx then
			for _, other in ipairs(s.enemies) do
				if other.alive and other.root.Parent and #near < 5 and (flat(other.root.Position) - flat(pos)).Magnitude <= fx.blast.radius * 1.5 then
					table.insert(near, other.root.Position)
				end
			end
		end
		Push:FireClient(player, "kill", {
			near = near,
			pos = pos,
			color = e.accent,
			boss = e.isBoss,
			scale = e.scale,
			model = e.model,
			fx = fx and fx.id or 0,
			radius = fx and fx.blast.radius or 0,
		})
		if fx then
			task.delay(0.12, killBlast, player, s, pos)
		end
	end
	-- 분열체: 작은 분열체 둘로 갈라진다
	if e.kind == "splitter" and not e.isMini and not selfDestruct and s.running then
		local n = e.cfg.splitCount or 2
		for i = 1, n do
			local a = (i / n) * math.pi * 2
			local spot = Vector3.new(pos.X + math.cos(a) * 3, s.arena.center.Y, pos.Z + math.sin(a) * 3)
			Push:FireClient(player, "summon", { pos = spot })
			spawnUnit(s, "splitter", spot, false, { mini = true, hp = e.maxHp * (e.cfg.splitHp or 0.35) })
		end
		pushBattle(player)
	end
	for _, d in ipairs(e.model:GetDescendants()) do
		if d:IsA("BasePart") and d.Name ~= "HumanoidRootPart" then
			d.Transparency = 0.6
		elseif d:IsA("ParticleEmitter") or d:IsA("Sparkles") or d:IsA("Fire") then
			d.Enabled = false
		end
	end
	Debris:AddItem(e.model, selfDestruct and 0.05 or 0.45)
end

-- 적 하나에게 피해. 방패병은 앞에서 오는 공격을 막고, 치명타는 적을 날려 보낸다
-- 망령이 흐려진 동안에는 피해가 들어가지 않는다
function hitEnemy(player: Player, s: Session, e: Enemy, dmg: number, crit: boolean, fromPos: Vector3, hits: { any }, opts: any?): number
	if not e.alive then
		return 0
	end
	if os.clock() < e.phaseUntil then
		table.insert(hits, { pos = e.root.Position + Vector3.new(0, 2.5 * e.scale, 0), text = "MISS", kind = "miss", model = e.model, from = fromPos })
		return 0
	end
	local kind = crit and "crit" or (opts and opts.kind or "hit")
	local reduce = e.cfg.frontReduce
	if reduce and not (opts and opts.pierce) and os.clock() >= e.stunUntil then
		local facing = flatUnit(e.root.CFrame.LookVector)
		if facing:Dot(flatUnit(fromPos - e.root.Position)) > 0.3 then
			dmg *= (1 - reduce)
			kind = "block"
		end
	end
	e.hp -= dmg
	table.insert(hits, {
		pos = e.root.Position + Vector3.new(0, 2.5 * e.scale, 0),
		text = Config.formatNumber(dmg),
		kind = kind,
		color = e.accent,
		model = e.model,
		from = fromPos,
	})
	if not e.isBoss then
		local away = flatUnit(e.root.Position - fromPos)
		local push = opts and opts.knock or 1
		if crit then
			e.root.AssemblyLinearVelocity = away * 38 * push + Vector3.new(0, 22, 0)
		elseif kind ~= "block" then
			e.root.AssemblyLinearVelocity = away * 12 * push + Vector3.new(0, 4 * push, 0)
		end
	end
	if e.hp <= 0 then
		killEnemy(player, s, e)
	else
		e.fill.Size = UDim2.fromScale(math.clamp(e.hp / e.maxHp, 0, 1), 1)
	end
	return dmg
end

function sendHits(player: Player, hits: { any })
	if #hits > 0 then
		Push:FireClient(player, "hits", hits)
	end
end

-- 모듈들이 쓰는 도구 묶음 (아래에서 채운다)
local ctx: any = nil

local function damagePlayer(player: Player, st: State, s: Session, amount: number)
	if not s.running or os.clock() < s.invulnUntil or st.god then
		return
	end
	if Skills.tryParry(ctx, player, s) then
		return
	end
	s.hp -= amount
	local root = getRoot(player)
	if root then
		Push:FireClient(player, "hits", {
			{ pos = root.Position + Vector3.new(0, 3, 0), text = "-" .. Config.formatNumber(amount), kind = "hurt" },
		})
	end
	if s.hp <= 0 then
		s.hp = 0
		loseBattle(player, st, s)
	else
		pushBattle(player)
	end
end

local function rollDamage(stats: any): (number, boolean)
	local wt = stats.weapon.type
	local dmg = stats.atk * (0.9 + math.random() * 0.2)
	local crit = wt.critChance ~= nil and math.random() < wt.critChance
	if crit then
		dmg *= wt.critMult
	end
	return dmg, crit
end

-- 경고 표시: 바닥 원, 바닥 길
local function warnDisc(s: Session, pos: Vector3, radius: number, duration: number)
	local disc = World.part({
		Name = "Warning",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.25, radius * 2, radius * 2),
		CFrame = CFrame.new(pos.X, s.arena.center.Y + 0.15, pos.Z) * CFrame.Angles(0, 0, math.rad(90)),
		Color = Color3.fromRGB(255, 40, 40),
		Material = Enum.Material.Neon,
		Transparency = 0.6,
		CanCollide = false,
		CanQuery = false,
		CanTouch = false,
		Parent = s.folder,
	})
	disc:SetAttribute("Warn", duration)
	Debris:AddItem(disc, duration)
	return disc
end

local function warnLane(s: Session, from: Vector3, dir: Vector3, length: number, width: number, duration: number)
	local mid = Vector3.new(from.X, s.arena.center.Y + 0.15, from.Z) + dir * (length / 2)
	local lane = World.part({
		Name = "Warning",
		Size = Vector3.new(width, 0.2, length),
		CFrame = CFrame.lookAt(mid, mid + dir),
		Color = Color3.fromRGB(255, 40, 40),
		Material = Enum.Material.Neon,
		Transparency = 0.6,
		CanCollide = false,
		CanQuery = false,
		CanTouch = false,
		Parent = s.folder,
	})
	lane:SetAttribute("Warn", duration)
	Debris:AddItem(lane, duration)
	return lane
end

local function nearSegment(s: Session, a: Vector3, b: Vector3, width: number): { Enemy }
	local list = {}
	local ab = flat(b - a)
	local len = ab.Magnitude
	local dir = len > 0 and ab.Unit or Vector3.new(0, 0, -1)
	for _, e in ipairs(aliveList(s)) do
		local off = flat(e.root.Position - a)
		local along = math.clamp(off:Dot(dir), 0, len)
		if (off - dir * along).Magnitude <= width + e.bodyRadius then
			table.insert(list, e)
		end
	end
	return list
end

ctx = {
	arenaRadius = ARENA_RADIUS,
	push = function(player: Player, kind: string, data: any)
		Push:FireClient(player, kind, data)
	end,
	toast = toast,
	getRoot = getRoot,
	alive = aliveList,
	aliveCount = aliveCount,
	nearSegment = nearSegment,
	hitEnemy = hitEnemy,
	sendHits = sendHits,
	killEnemy = killEnemy,
	pushBattle = pushBattle,
	flash = flashEnemy,
	warnDisc = warnDisc,
	warnLane = warnLane,
	spawnUnit = function(s: Session, kind: string, pos: Vector3)
		spawnUnit(s, kind, pos, false)
	end,
	heal = function(s: Session, amount: number)
		s.hp = math.min(s.maxHp, s.hp + amount)
	end,
	color = function(s: Session): Color3
		return weaponColor(s.stats)
	end,
	isCurrent = function(s: Session): boolean
		for _, st in pairs(states) do
			if st.session == s then
				return true
			end
		end
		return false
	end,
	damagePlayer = function(player: Player, st: State, s: Session, amount: number)
		damagePlayer(player, st, s, amount)
	end,
}

------------------------------------------------------------------------
-- 기본 공격
------------------------------------------------------------------------
local function performAttack(player: Player, st: State, s: Session)
	if not s.running or s.ulting then
		return
	end
	local stats = s.stats
	local now = os.clock()
	if now - s.lastAttack < stats.cooldown - 0.03 then
		return
	end
	local root = getRoot(player)
	if not root then
		return
	end
	local wt = stats.weapon.type
	local origin = flat(root.Position)
	local look = flatUnit(root.CFrame.LookVector)

	local inRange = {}
	for _, e in ipairs(aliveList(s)) do
		local offset = flat(e.root.Position) - origin
		local dist = offset.Magnitude - e.bodyRadius
		if dist <= wt.range then
			table.insert(inRange, { e = e, dist = dist, offset = offset })
		end
	end
	if #inRange == 0 then
		return
	end
	table.sort(inRange, function(a, b)
		return a.dist < b.dist
	end)

	local targets: { Enemy } = {}
	if wt.mode == "around" then
		for _, c in ipairs(inRange) do
			table.insert(targets, c.e)
		end
	elseif wt.mode == "line" then
		for _, c in ipairs(inRange) do
			local facing = c.offset.Magnitude < 4 or (c.offset.Unit:Dot(look) > 0.2)
			if facing then
				table.insert(targets, c.e)
				if #targets >= (wt.maxTargets or 3) then
					break
				end
			end
		end
		if #targets == 0 then
			table.insert(targets, inRange[1].e)
		end
	else
		table.insert(targets, inRange[1].e)
	end

	-- 3단 콤보: 이어서 때리면 1 → 2 → 3타. 3타는 피해 1.6배에 크게 밀쳐 낸다
	if now - s.lastAttack <= stats.cooldown + 0.7 then
		s.comboStep = (s.comboStep % 3) + 1
	else
		s.comboStep = 1
	end
	local finisher = s.comboStep == 3
	s.lastAttack = now
	local hits = {}
	local healed = 0
	local anyCrit = false
	local hitOpts = finisher and { knock = 1.8 } or nil
	for i, e in ipairs(targets) do
		local dmg, crit = rollDamage(stats)
		if finisher then
			dmg *= 1.6
		end
		if i == 1 and s.smokeCrit and s.smokeCharges > 0 then
			dmg = stats.atk * (wt.critMult or 2) * s.smokeCrit
			crit = true
			s.smokeCharges -= 1
			if s.smokeCharges <= 0 then
				s.smokeCrit = nil
			end
		end
		anyCrit = anyCrit or crit
		hitEnemy(player, s, e, dmg, crit, root.Position, hits, hitOpts)
		Skills.onBasicHit(ctx, player, s, e, hits)
		if wt.lifesteal then
			healed += dmg * wt.lifesteal
		end
	end
	if healed > 0 then
		s.hp = math.min(s.maxHp, s.hp + healed)
	end
	s.gauge = math.min(100, s.gauge + Config.ULT_GAIN * stats.cooldown)

	local _, sectionIndex = Config.getSection(stats.weapon.grade)
	Push:FireClient(player, "swing", {
		typeId = stats.weapon.typeId,
		mode = wt.mode,
		range = wt.range,
		section = stats.weapon.typeId == 0 and 6 or sectionIndex,
		grade = stats.weapon.typeId == 0 and 100 or stats.weapon.grade,
		color = weaponColor(stats),
		crit = anyCrit,
		poison = now < s.poisonUntil,
		step = s.comboStep,
		cooldown = stats.cooldown,
		enh = stats.enh,
		target = targets[1] and targets[1].root.Position or nil,
	})
	sendHits(player, hits)
	pushBattle(player)
end

------------------------------------------------------------------------
-- 필살기
------------------------------------------------------------------------
local function runUltimate(player: Player, st: State, s: Session)
	local root = getRoot(player)
	local char = player.Character
	if not root or not char then
		return
	end
	local stats = s.stats
	local typeId = stats.weapon.typeId
	local ult = Config.Ultimates[typeId] or Config.Ultimates[1]
	s.gauge = 0
	s.ulting = true
	s.invulnUntil = math.max(s.invulnUntil, os.clock() + 1.0)

	local origin = root.Position
	local look = flatUnit(root.CFrame.LookVector)
	local hits = {}
	local pierce = { pierce = true }
	local data: { [string]: any } = {
		typeId = typeId,
		name = ult.name,
		origin = origin,
		look = look,
		color = weaponColor(stats),
	}

	local function finish(heal: number?)
		if heal and heal > 0 then
			s.hp = math.min(s.maxHp, s.hp + s.maxHp * heal)
		end
		sendHits(player, hits)
		pushBattle(player)
	end

	if typeId == 1 then
		local target = origin + look * ult.length
		data.length = ult.length
		Push:FireClient(player, "ult", data)
		task.wait(0.25)
		for _, e in ipairs(nearSegment(s, origin, target, ult.width)) do
			hitEnemy(player, s, e, stats.atk * ult.mult, true, origin, hits, pierce)
		end
		finish()
	elseif typeId == 2 then
		data.radius = ult.radius
		data.duration = ult.ticks * ult.interval
		Push:FireClient(player, "ult", data)
		for _ = 1, ult.ticks do
			if not s.running then
				break
			end
			local r = getRoot(player)
			if not r then
				break
			end
			hits = {}
			for _, e in ipairs(aliveList(s)) do
				if (flat(e.root.Position) - flat(r.Position)).Magnitude <= ult.radius + e.bodyRadius then
					local dmg, crit = rollDamage(stats)
					hitEnemy(player, s, e, dmg * ult.mult, crit, r.Position, hits, pierce)
				end
			end
			sendHits(player, hits)
			pushBattle(player)
			task.wait(ult.interval)
		end
		hits = {}
		finish()
	elseif typeId == 3 then
		local center = s.arena.center
		local target = origin + look * ult.length
		local fromCenter = flat(target - center)
		local limit = ARENA_RADIUS - 6
		if fromCenter.Magnitude > limit then
			target = center + fromCenter.Unit * limit + Vector3.new(0, origin.Y - center.Y, 0)
		end
		data.target = target
		Push:FireClient(player, "ult", data)
		char:PivotTo(CFrame.lookAt(target, target + look))
		for _, e in ipairs(nearSegment(s, origin, target, ult.width)) do
			hitEnemy(player, s, e, stats.atk * ult.mult, true, origin, hits, pierce)
		end
		finish()
	elseif typeId == 4 then
		local best: Enemy? = nil
		for _, e in ipairs(aliveList(s)) do
			if not best or e.hp > best.hp then
				best = e
			end
		end
		if best then
			local victim = best
			local behind = victim.root.Position - flatUnit(victim.root.CFrame.LookVector) * (3 + victim.bodyRadius)
			data.target = victim.root.Position
			Push:FireClient(player, "ult", data)
			char:PivotTo(CFrame.lookAt(behind, Vector3.new(victim.root.Position.X, behind.Y, victim.root.Position.Z)))
			local wt = stats.weapon.type
			for _ = 1, ult.hits do
				if not victim.alive then
					break
				end
				hits = {}
				hitEnemy(player, s, victim, stats.atk * (wt.critMult or 2) * ult.mult, true, behind, hits, pierce)
				sendHits(player, hits)
				task.wait(0.12)
			end
			hits = {}
		else
			Push:FireClient(player, "ult", data)
		end
		finish()
	elseif typeId == 5 then
		local inCircle = {}
		local victims = {}
		for _, e in ipairs(aliveList(s)) do
			if (flat(e.root.Position) - flat(origin)).Magnitude <= ult.radius + e.bodyRadius then
				table.insert(inCircle, e)
				table.insert(victims, e.root.Position)
			end
		end
		data.radius = ult.radius
		data.victims = victims
		Push:FireClient(player, "ult", data)
		task.wait(0.3)
		for _, e in ipairs(inCircle) do
			hitEnemy(player, s, e, stats.atk * ult.mult, true, origin, hits, pierce)
		end
		finish(ult.heal)
	else
		data.radius = ARENA_RADIUS
		Push:FireClient(player, "ult", data)
		task.wait(0.4)
		for _, e in ipairs(aliveList(s)) do
			hitEnemy(player, s, e, stats.atk * ult.mult, true, origin, hits, pierce)
		end
		finish(ult.heal)
	end
end

local function useUltimate(player: Player, st: State, s: Session)
	if not s.running or s.ulting or s.gauge < 100 then
		return
	end
	local ok, err = pcall(runUltimate, player, st, s)
	s.ulting = false
	if not ok then
		warn("[Arena] 필살기 오류:", err)
	end
end

------------------------------------------------------------------------
-- 웨이브와 승패
------------------------------------------------------------------------
local function spawnWave(player: Player, s: Session, index: number)
	local info = s.info
	local list = info.waves[index]
	local isLast = index == #info.waves
	local count = #list
	local spin = math.random() * math.pi * 2
	local eliteList = info.elites and info.elites[index] or {}
	for i, kind in ipairs(list) do
		local a = spin + (i / count) * math.pi * 2
		local pos = s.arena.center + Vector3.new(math.cos(a), 0, math.sin(a)) * ENEMY_SPAWN_RADIUS
		Push:FireClient(player, "summon", { pos = pos, elite = eliteList[i] ~= nil })
		spawnUnit(s, kind, pos, false, { elite = eliteList[i] })
	end
	if info.isBoss and isLast then
		local pos = s.arena.center + Vector3.new(0, 0, -ENEMY_SPAWN_RADIUS)
		spawnUnit(s, info.bossType, pos, true)
		Push:FireClient(player, "boss", {
			name = (Config.stageName(s.stage)),
			kind = Config.EnemyTypes[info.bossType].name,
			pos = pos,
		})
	end
	Push:FireClient(player, "wave", { index = index, total = #info.waves, boss = info.isBoss and isLast })
	pushBattle(player)
end

local function winBattle(player: Player, st: State, s: Session)
	s.running = false
	local p = profiles[player]
	local info = s.info
	local n = s.stage
	p.coins += info.coins
	local drops = {}
	local count = info.dropCount + ((math.random() < info.bonusDropChance) and 1 or 0)
	for _ = 1, count do
		local key = Config.itemKey(math.min(n, Config.MAX_GRADE), math.random(1, 5))
		p.inv[key] = (p.inv[key] or 0) + 1
		table.insert(drops, key)
	end
	local firstClear = n > p.maxStage
	if firstClear then
		p.maxStage = n
		updateTitle(player)
		refreshHall()
	end
	st.dirty = true

	local again = st.auto and Config.canAutoRepeat(n, p.maxStage, currentStats(player).power)
	if st.auto and not again then
		st.auto = false
		toast(player, "전투력이 부족해서 자동 반복을 멈췄어요")
	end
	Push:FireClient(player, "result", {
		win = true,
		stage = n,
		coins = info.coins,
		drops = drops,
		firstClear = firstClear,
		again = again,
	})
	pushState(player)

	task.delay(again and 2 or 3, function()
		if st.session ~= s then
			return
		end
		endSession(player, st)
		if again and st.auto and player.Parent then
			startStage(player, n, true)
		else
			teleportToLobby(player)
		end
	end)
end

loseBattle = function(player: Player, st: State, s: Session)
	if not s.running then
		return
	end
	s.running = false
	st.auto = false
	Push:FireClient(player, "result", { win = false, stage = s.stage })
	pushBattle(player)
	pushState(player)
	task.delay(2.5, function()
		if st.session ~= s then
			return
		end
		endSession(player, st)
		teleportToLobby(player)
	end)
end

local function autoSkills(player: Player, st: State, s: Session, root: BasePart, now: number)
	if s.gauge >= 100 then
		task.spawn(useUltimate, player, st, s)
		return
	end
	local nearest = math.huge
	for _, e in ipairs(aliveList(s)) do
		nearest = math.min(nearest, (flat(e.root.Position) - flat(root.Position)).Magnitude)
	end
	if nearest < 16 then
		for slot = 1, 2 do
			if now >= s.skillReadyAt[slot] then
				Skills.cast(ctx, player, st, s, slot)
				return
			end
		end
	end
	performAttack(player, st, s)
end

local function battleLoop(player: Player, st: State, s: Session)
	while s.running and st.session == s do
		local root = getRoot(player)
		if not root or root.Position.Y < s.arena.center.Y - 40 then
			loseBattle(player, st, s)
			return
		end
		local now = os.clock()
		local alive = 0
		local poisonHits = {}
		for _, e in ipairs(s.enemies) do
			if e.alive then
				if not e.root.Parent then
					e.alive = false
				else
					alive += 1
					updateWalk(e, now)
					if now < e.poisonUntil and now >= e.nextPoison then
						e.nextPoison = now + 0.5
						hitEnemy(player, s, e, e.poisonDmg, false, e.root.Position, poisonHits, { pierce = true })
						poisonHits[#poisonHits].kind = "poison"
					elseif now >= e.poisonUntil and e.poisonUntil > 0 then
						e.poisonUntil = 0
						e.model:SetAttribute("Poison", nil)
					end
					if e.alive then
						EnemyAI.tick(ctx, player, st, s, e, root, now)
					end
				end
			end
		end
		sendHits(player, poisonHits)
		Skills.tickZones(ctx, player, s, now)

		-- 정예 재생
		for _, e in ipairs(s.enemies) do
			local el = e.elite
			if e.alive and el and el.regen and e.hp < e.maxHp then
				e.hp = math.min(e.maxHp, e.hp + e.maxHp * el.regen * 0.1)
				e.fill.Size = UDim2.fromScale(math.clamp(e.hp / e.maxHp, 0, 1), 1)
			end
		end

		-- 아우라 파동: 주기적으로 내 주위 적에게 피해
		local aura = s.stats.aura
		if aura and aura.pulse and now >= s.nextPulse and not s.ulting then
			s.nextPulse = now + aura.pulse.interval
			local pulseHits = {}
			local center = root.Position
			for _, e in ipairs(aliveList(s)) do
				if (flat(e.root.Position) - flat(center)).Magnitude <= aura.pulse.radius + e.bodyRadius then
					hitEnemy(player, s, e, s.stats.atk * aura.pulse.mult, false, center, pulseHits, { pierce = true, kind = "aura" })
				end
			end
			Push:FireClient(player, "auraPulse", { pos = center, radius = aura.pulse.radius, tier = aura.id, hit = #pulseHits })
			sendHits(player, pulseHits)
		end

		if alive == 0 and not s.ulting and not s.waveSpawning then
			if s.waveIndex < #s.info.waves then
				s.waveSpawning = true
				s.waveIndex += 1
				local nextWave = s.waveIndex
				task.delay(1.2, function()
					if s.running and st.session == s then
						spawnWave(player, s, nextWave)
					end
					s.waveSpawning = false
				end)
				-- 웨이브를 깨면 체력 30% 회복
				s.hp = math.min(s.maxHp, s.hp + s.maxHp * 0.3)
				Push:FireClient(player, "waveClear", { index = nextWave - 1, heal = 0.3 })
				pushBattle(player)
			else
				winBattle(player, st, s)
				return
			end
		end
		if st.auto and not s.ulting then
			autoSkills(player, st, s, root, now)
		end
		task.wait(0.1)
	end
end

startStage = function(player: Player, stageArg: any, wantAuto: boolean)
	local st, p = states[player], profiles[player]
	if not st or not p or st.session then
		return
	end
	local n = math.floor(tonumber(stageArg) or 0)
	if n < 1 or n > Config.MAX_STAGE then
		return
	end
	if n > p.maxStage + 1 then
		toast(player, "아직 열리지 않은 스테이지예요")
		return
	end
	local root = getRoot(player)
	local char = player.Character
	if not root or not char then
		return
	end
	local stats = currentStats(player)
	if wantAuto and not Config.canAutoRepeat(n, p.maxStage, stats.power) then
		toast(player, "자동 반복은 이긴 적 있는 스테이지에서, 권장 전투력의 1.5배 이상일 때 할 수 있어요")
		wantAuto = false
	end
	st.auto = wantAuto

	local slot = st.slot
	if not slot then
		slot = claimSlot(player)
		st.slot = slot
	end
	local arena = arenas[slot :: number]
	local info = Config.stageInfo(n)
	World.themeArena(arena, Config.stageGrade(n), info.isBoss, info.beyond)
	local folder = Instance.new("Folder")
	folder.Name = "P_" .. player.UserId
	folder.Parent = battleRoot

	local s: Session = {
		stage = n,
		info = info,
		arena = arena,
		folder = folder,
		enemies = {},
		waveIndex = 1,
		waveSpawning = false,
		stats = stats,
		hp = stats.maxHp,
		maxHp = stats.maxHp,
		invulnUntil = 0,
		lastAttack = 0,
		gauge = 0,
		ulting = false,
		running = true,
		skillReadyAt = { 0, 0 },
		poisonUntil = 0,
		smokeCrit = nil,
		smokeCharges = 0,
		parryUntil = 0,
		marks = {},
		skillTier = Config.skillTier(stats.weapon.grade, stats.weapon.typeId),
		zones = {},
		comboStep = 0,
		nextPulse = os.clock() + 1.5,
	}
	st.session = s
	char:PivotTo(CFrame.new(arena.center + Vector3.new(0, 4, 0)))
	Push:FireClient(player, "battleStart", { stage = n, pos = arena.center, color = GradeStyle.get(info.grade).glow, boss = info.isBoss, beyond = info.beyond })
	spawnWave(player, s, 1)
	pushState(player)
	task.spawn(battleLoop, player, st, s)
end

------------------------------------------------------------------------
-- 무기 관리
------------------------------------------------------------------------
local function refreshStats(player: Player)
	local st = states[player]
	local s = st and st.session
	if s then
		local ratio = s.hp / s.maxHp
		local stats = currentStats(player)
		s.stats = stats
		s.maxHp = stats.maxHp
		s.hp = math.max(1, ratio * stats.maxHp)
		pushBattle(player)
	end
	attachWeapon(player)
	st.dirty = true
	pushState(player)
end

local function equip(player: Player, key: any)
	local p = profiles[player]
	if type(key) ~= "string" or not Config.parseKey(key) or (p.inv[key] or 0) < 1 then
		return
	end
	p.equipped = key
	refreshStats(player)
	Push:FireClient(player, "equipped", key)
end

local function mergeOnce(p: Profile, key: string): string?
	local g, t = Config.parseKey(key)
	if not g or t == 0 or g >= Config.MAX_GRADE then
		return nil
	end
	local cost = Config.mergeCost(g)
	local have = p.inv[key] or 0
	if have < cost then
		return nil
	end
	local left = have - cost
	p.inv[key] = left > 0 and left or nil
	local newKey = Config.itemKey(g + 1, t)
	p.inv[newKey] = (p.inv[newKey] or 0) + 1
	-- 강화 단계의 절반을 물려받는다
	local inherit = (p.enh[key] or 0) // 2
	if inherit > (p.enh[newKey] or 0) then
		p.enh[newKey] = inherit
	end
	if p.equipped == key and left <= 0 then
		p.equipped = newKey
	end
	return newKey
end

-- 합성할 때마다 로비 용광로가 불을 뿜는다 (모두에게 보인다)
local function forgeFlash(key: string)
	local info = Config.weaponInfo(key)
	local color = info and (info.typeId == 0 and Color3.fromRGB(255, 235, 160) or info.rarity.color) or Color3.fromRGB(255, 160, 60)
	Push:FireAllClients("forge", { color = color, legendary = info ~= nil and info.rarity.rank >= 5 })
end

local function merge(player: Player, key: any)
	local p = profiles[player]
	if type(key) ~= "string" then
		return
	end
	local g = Config.parseKey(key)
	if not g then
		return
	end
	local newKey = mergeOnce(p, key)
	if not newKey then
		toast(player, string.format("합성하려면 같은 칼이 %d개 필요해요", Config.mergeCost(g)))
		return
	end
	Push:FireClient(player, "merged", { from = key, to = newKey, count = 1 })
	forgeFlash(newKey)
	refreshStats(player)
end

local function mergeAll(player: Player)
	local p = profiles[player]
	local count = 0
	local best: string? = nil
	for g = 1, Config.MAX_GRADE - 1 do
		for t = 1, 5 do
			local key = Config.itemKey(g, t)
			while true do
				local made = mergeOnce(p, key)
				if not made then
					break
				end
				count += 1
				best = made
			end
		end
	end
	if count == 0 then
		toast(player, "지금 합성할 수 있는 칼이 없어요")
		return
	end
	Push:FireClient(player, "merged", { count = count, to = best })
	if best then
		forgeFlash(best)
	end
	refreshStats(player)
end

local function makeAllRounder(player: Player)
	local p = profiles[player]
	for t = 1, 5 do
		if (p.inv[Config.itemKey(Config.MAX_GRADE, t)] or 0) < 1 then
			toast(player, "100등급 대검·쌍검·장검·단검·낫이 하나씩 필요해요")
			return
		end
	end
	for t = 1, 5 do
		local key = Config.itemKey(Config.MAX_GRADE, t)
		local left = p.inv[key] - 1
		p.inv[key] = left > 0 and left or nil
	end
	p.inv[Config.ALLROUNDER_KEY] = (p.inv[Config.ALLROUNDER_KEY] or 0) + 1
	p.equipped = Config.ALLROUNDER_KEY
	Push:FireClient(player, "merged", { to = Config.ALLROUNDER_KEY, count = 1 })
	forgeFlash(Config.ALLROUNDER_KEY)
	refreshStats(player)
end

local function train(player: Player, kind: any)
	local p = profiles[player]
	local field
	if kind == "atk" then
		field = "atkLv"
	elseif kind == "hp" then
		field = "hpLv"
	else
		return
	end
	local level = (p :: any)[field]
	local cost = Config.trainCost(level)
	if p.coins < cost then
		toast(player, "코인이 부족해요")
		return
	end
	p.coins -= cost;
	(p :: any)[field] = level + 1
	Push:FireClient(player, "trained", kind)
	refreshStats(player)
end

-- 강화: 장착한 무기를 한 단계 올린다
local function enhance(player: Player)
	local p = profiles[player]
	local key = p.equipped
	local g, t = Config.parseKey(key)
	if not g then
		return
	end
	local level = p.enh[key] or 0
	if level >= Config.MAX_ENHANCE then
		toast(player, "이미 최대 강화(+" .. Config.MAX_ENHANCE .. ")예요")
		return
	end
	local cost = Config.enhanceCost(t == 0 and Config.MAX_GRADE + 5 or g, level)
	if p.coins < cost then
		toast(player, "코인이 부족해요 (💰" .. Config.formatNumber(cost) .. ")")
		return
	end
	p.coins -= cost
	p.enh[key] = level + 1
	Push:FireClient(player, "enhanced", { key = key, level = level + 1, look = Config.EnhanceLooks[level + 1] })
	forgeFlash(key)
	refreshStats(player)
end

-- 아우라·킬 이펙트 사기와 장착. kind = "aura" | "kill"
local function cosmeticList(kind: string): ({ any }, string, string)
	if kind == "aura" then
		return Config.Auras, "auras", "aura"
	end
	return Config.KillFx, "kills", "kill"
end

local function buyCosmetic(player: Player, kind: any, tier: any)
	if kind ~= "aura" and kind ~= "kill" then
		return
	end
	local p = profiles[player]
	local list, ownedField, equipField = cosmeticList(kind)
	local k = math.floor(tonumber(tier) or 0)
	local item = list[k]
	if not item then
		return
	end
	local owned = (p :: any)[ownedField]
	if owned[tostring(k)] then
		(p :: any)[equipField] = k
		refreshStats(player)
		Push:FireClient(player, "cosmetic", { kind = kind, tier = k, bought = false })
		return
	end
	if p.maxStage < item.unlock then
		toast(player, string.format("%d스테이지를 깨면 열려요", item.unlock))
		return
	end
	if p.coins < item.cost then
		toast(player, "코인이 부족해요 (💰" .. Config.formatNumber(item.cost) .. ")")
		return
	end
	p.coins -= item.cost
	owned[tostring(k)] = true;
	(p :: any)[equipField] = k
	Push:FireClient(player, "cosmetic", { kind = kind, tier = k, bought = true })
	refreshStats(player)
end

local function unequipCosmetic(player: Player, kind: any)
	local p = profiles[player]
	if kind == "aura" then
		p.aura = 0
	elseif kind == "kill" then
		p.kill = 0
	else
		return
	end
	refreshStats(player)
end

local function setAuto(player: Player, st: State, on: boolean)
	local s = st.session
	if not on then
		st.auto = false
	elseif s then
		local p = profiles[player]
		local power = currentStats(player).power
		if s.stage > p.maxStage then
			toast(player, "한 번 이긴 스테이지만 자동 반복할 수 있어요")
		elseif not Config.canAutoRepeat(s.stage, p.maxStage, power) then
			toast(player, "전투력이 " .. Config.formatNumber(Config.recommendedPower(s.stage) * Config.AUTO_POWER_RATIO) .. " 이상이어야 해요")
		else
			st.auto = true
		end
	end
	pushBattle(player)
	pushState(player)
end

------------------------------------------------------------------------
-- 요청 처리
------------------------------------------------------------------------
Request.OnServerEvent:Connect(function(player: Player, action: any, arg: any, arg2: any)
	local st, p = states[player], profiles[player]
	if not st or not p or type(action) ~= "string" then
		return
	end
	local now = os.clock()
	if now - st.reqWindow > 1 then
		st.reqWindow = now
		st.reqCount = 0
	end
	st.reqCount += 1
	if st.reqCount > 40 then
		return
	end

	if action == "attack" then
		local s = st.session
		if s and s.running then
			performAttack(player, st, s)
		end
	elseif action == "skill" then
		local s = st.session
		if s and s.running and (arg == 1 or arg == 2) then
			Skills.cast(ctx, player, st, s, arg)
			pushBattle(player)
		end
	elseif action == "ultimate" then
		local s = st.session
		if s and s.running then
			task.spawn(useUltimate, player, st, s)
		end
	elseif action == "dash" then
		local s = st.session
		if s and s.running and now - st.lastDash >= Config.DASH_COOLDOWN - 0.15 then
			st.lastDash = now
			s.invulnUntil = math.max(s.invulnUntil, now + Config.DASH_INVULN)
		end
	elseif action == "start" then
		startStage(player, arg, arg2 == true)
	elseif action == "leave" then
		if st.session then
			st.auto = false
			endSession(player, st)
			teleportToLobby(player)
			pushState(player)
		end
	elseif action == "auto" then
		setAuto(player, st, arg == true)
	elseif action == "equip" then
		equip(player, arg)
	elseif action == "equipBest" then
		equip(player, bestKey(p))
	elseif action == "merge" then
		merge(player, arg)
	elseif action == "mergeAll" then
		mergeAll(player)
	elseif action == "allrounder" then
		makeAllRounder(player)
	elseif action == "train" then
		train(player, arg)
	elseif action == "enhance" then
		enhance(player)
	elseif action == "buyCosmetic" then
		buyCosmetic(player, arg, arg2)
	elseif action == "unequipCosmetic" then
		unequipCosmetic(player, arg)
	elseif action == "testEnhance" and st.tester then
		-- 장착한 무기의 강화 단계를 바로 정한다
		p.enh[p.equipped] = math.clamp(math.floor(tonumber(arg) or 0), 0, Config.MAX_ENHANCE)
		refreshStats(player)
	elseif action == "testGive" and st.tester then
		-- 원하는 등급·계열 무기를 바로 받고 장착
		local g = math.clamp(math.floor(tonumber(arg) or 1), 1, Config.MAX_GRADE)
		local t = math.clamp(math.floor(tonumber(arg2) or 1), 0, 5)
		local key = Config.itemKey(g, t)
		p.inv[key] = (p.inv[key] or 0) + 1
		equip(player, key)
		forgeFlash(key)
	elseif action == "testToggle" and st.tester then
		if arg == "god" then
			st.god = not st.god
			toast(player, st.god and "🛡 무적 켬" or "🛡 무적 끔")
		elseif arg == "cooldown" then
			st.noCooldown = not st.noCooldown
			toast(player, st.noCooldown and "⏱ 쿨타임 없음 켬" or "⏱ 쿨타임 없음 끔")
		end
		pushState(player)
	elseif action == "testGauge" and st.tester then
		local s = st.session
		if s then
			s.gauge = 100
			pushBattle(player)
		end
	elseif action == "hello" then
		pushState(player)
		pushBattle(player)
		if st.tester then
			toast(player, "🧪 테스트 계정이에요. 모든 스테이지가 열려 있고 기록은 저장하지 않아요")
		elseif not st.canSave then
			toast(player, "저장이 꺼져 있어요. 이번 기록은 저장되지 않아요")
		end
	end
end)

------------------------------------------------------------------------
-- 입장과 퇴장
------------------------------------------------------------------------
local function onCharacterAdded(player: Player, char: Model)
	local st = states[player]
	if st and st.session then
		st.auto = false
		endSession(player, st)
		pushState(player)
	end
	task.spawn(function()
		char:WaitForChild("Head", 10)
		char:WaitForChild("HumanoidRootPart", 10)
		task.wait(0.2)
		if player.Character ~= char then
			return
		end
		attachWeapon(player)
		updateTitle(player)
		local hum = char:FindFirstChildOfClass("Humanoid")
		if hum then
			hum.Died:Connect(function()
				local s2 = states[player]
				local s = s2 and s2.session
				if s2 and s then
					loseBattle(player, s2, s)
				end
			end)
		end
	end)
end

local function onPlayerAdded(player: Player)
	local st: State = {
		slot = nil,
		session = nil,
		auto = false,
		canSave = false,
		dirty = false,
		reqCount = 0,
		reqWindow = 0,
		lastDash = 0,
		tester = false,
		god = false,
		noCooldown = false,
	}
	states[player] = st

	local ls = Instance.new("Folder")
	ls.Name = "leaderstats"
	local rank = Instance.new("StringValue")
	rank.Name = "등급"
	rank.Value = "-"
	rank.Parent = ls
	local stage = Instance.new("IntValue")
	stage.Name = "스테이지"
	stage.Parent = ls
	ls.Parent = player

	local profile, ok
	if isTester(player) then
		-- 테스트 계정은 저장하지 않는다 (실제 기록을 덮어쓰지 않게)
		profile, ok = testerProfile(), false
		st.tester = true
	else
		profile, ok = loadProfile(player)
	end
	if not player.Parent then
		return
	end
	profiles[player] = profile
	st.canSave = ok

	player.CharacterAdded:Connect(function(char)
		onCharacterAdded(player, char)
	end)
	if player.Character then
		onCharacterAdded(player, player.Character)
	end
	updateTitle(player)
	refreshHall()
	pushState(player)
end

local function onPlayerRemoving(player: Player)
	local st = states[player]
	if st then
		if st.session then
			endSession(player, st)
		end
		if st.slot then
			slotOwner[st.slot] = nil
		end
	end
	saveProfile(player)
	states[player] = nil
	profiles[player] = nil
	refreshHall()
end

task.spawn(function()
	World.buildStatue(getRigTemplate())
end)

Players.PlayerAdded:Connect(onPlayerAdded)
Players.PlayerRemoving:Connect(onPlayerRemoving)
for _, player in ipairs(Players:GetPlayers()) do
	task.spawn(onPlayerAdded, player)
end

-- 주기적 저장
task.spawn(function()
	while true do
		task.wait(SAVE_INTERVAL)
		for player, st in pairs(states) do
			if st.dirty then
				task.spawn(saveProfile, player)
			end
		end
	end
end)

game:BindToClose(function()
	local pending = 0
	for player in pairs(profiles) do
		pending += 1
		task.spawn(function()
			saveProfile(player)
			pending -= 1
		end)
	end
	local waited = 0
	while pending > 0 and waited < 25 do
		task.wait(0.5)
		waited += 0.5
	end
end)
]]></string>
      </Properties>
      <Item class="ModuleScript" referent="8">
        <Properties>
          <string name="Name">EnemyAI</string>
          <string name="Source"><![CDATA[-- EnemyAI (ModuleScript, ArenaServer 아래)
-- 적 종류별 행동. 공격은 모두 바닥이나 몸에 미리 경고를 띄운 뒤 들어온다.
--   돌격병  다가와서 벤다
--   궁수    거리를 벌리고, 빨간 선으로 조준한 뒤 화살을 쏜다
--   방패병  느리지만 앞에서 오는 공격을 70% 막는다
--   돌진꾼  길게 빨간 길을 그린 뒤 그 길로 돌진한다
--   자폭병  빠르게 달려와 붙으면 1초 뒤 터진다
--   주술사  멀리서 내 발밑에 불길 원을 띄운다
--   암살자  주기적으로 내 등 뒤로 순간이동해 찌른다
--   골렘    느리고 단단하다. 주기적으로 제자리 땅을 내려쳐 주위를 터뜨린다
--   망령    주기적으로 몸이 흐려져 잠깐 공격이 통하지 않는다
--   분열체  쓰러지면 작은 분열체 둘로 갈라진다
--   사제    멀리서 주위 적들의 체력을 회복시킨다. 먼저 잡아야 한다
--   흑기사  앞 공격을 50% 막고, 빨간 길을 그린 뒤 세 번 연속 베며 파고든다
-- 보스는 내려찍기, 돌진, 회전, 운석, 부하 소환, 탄막(nova), 운석비(rain) 중 정해진 조합을 번갈아 쓴다.
-- 공격 동작은 모델 속성(SwingN, CastN)으로 알리고, 클라이언트가 팔을 휘두르는 모션을 그린다.

local EnemyAI = {}

local function flat(v: Vector3): Vector3
	return Vector3.new(v.X, 0, v.Z)
end

local function flatUnit(v: Vector3): Vector3
	local f = flat(v)
	if f.Magnitude < 0.001 then
		return Vector3.new(0, 0, -1)
	end
	return f.Unit
end

local function canAct(e: any, now: number): boolean
	return not e.busy and now >= e.stunUntil and now >= e.frozenUntil
end

local function chase(e: any, target: Vector3, now: number)
	if now >= e.nextMove then
		e.nextMove = now + 0.25
		e.hum:MoveTo(target)
	end
end

local function hold(e: any)
	e.hum:MoveTo(e.root.Position)
end

local function alive(ctx: any, s: any, e: any): boolean
	return s.running and ctx.isCurrent(s) and e.alive
end

-- 클라이언트에 공격 동작을 알린다 (휘두르기, 시전)
local function announce(e: any, kind: string, duration: number)
	e.animN = (e.animN or 0) + 1
	pcall(function()
		e.model:SetAttribute("AnimKind", kind)
		e.model:SetAttribute("AnimT", duration)
		e.model:SetAttribute("AnimN", e.animN)
	end)
end
EnemyAI.announce = announce

-- 근접 공격: 빨갛게 번쩍인 뒤 0.35초 후 벤다
local function strike(ctx: any, player: Player, st: any, s: any, e: any, windup: number?)
	local now = os.clock()
	announce(e, "swing", windup or 0.35)
	e.busy = true
	e.nextAttack = now + (e.isBoss and 1.4 or 1.6)
	hold(e)
	ctx.flash(e, Color3.fromRGB(255, 60, 60), windup or 0.35)
	task.delay(windup or 0.35, function()
		e.busy = false
		if not alive(ctx, s, e) then
			return
		end
		local root = ctx.getRoot(player)
		if root and (flat(e.root.Position) - flat(root.Position)).Magnitude <= e.reach + 2 then
			ctx.damagePlayer(player, st, s, e.dmg)
		end
	end)
end

-- 직선으로 날아가는 공격 (화살, 보스 탄). 서버가 경로를 따라 맞았는지 본다
local function projectile(ctx: any, player: Player, st: any, s: any, from: Vector3, dir: Vector3, speed: number, range: number, dmg: number, kind: string, color: Color3)
	ctx.push(player, "proj", { from = from, dir = dir, speed = speed, range = range, kind = kind, color = color })
	task.spawn(function()
		local traveled = 0
		local step = 0.05
		while traveled < range do
			task.wait(step)
			if not (s.running and ctx.isCurrent(s)) then
				return
			end
			traveled += speed * step
			local pos = from + dir * traveled
			local root = ctx.getRoot(player)
			if root and (flat(root.Position) - flat(pos)).Magnitude < 2.6 then
				ctx.damagePlayer(player, st, s, dmg)
				return
			end
		end
	end)
end

-- 돌진: 빨간 길을 그리고 그 길로 몸을 날린다
local function charge(ctx: any, player: Player, st: any, s: any, e: any, root: BasePart, width: number, dmg: number)
	local now = os.clock()
	e.busy = true
	hold(e)
	local start = e.root.Position
	local dir = flatUnit(root.Position - start)
	local length = math.min((flat(root.Position) - flat(start)).Magnitude + 10, 36)
	ctx.warnLane(s, start, dir, length, width, 0.9)
	ctx.flash(e, Color3.fromRGB(255, 150, 0), 0.9)
	announce(e, "charge", 0.9)
	task.delay(0.9, function()
		if not alive(ctx, s, e) then
			e.busy = false
			return
		end
		local hit = false
		local steps = 12
		for i = 1, steps do
			if not alive(ctx, s, e) then
				break
			end
			local p = start + dir * length * (i / steps)
			e.model:PivotTo(CFrame.lookAt(p, p + dir))
			local r = ctx.getRoot(player)
			if not hit and r and (flat(r.Position) - flat(p)).Magnitude < width * 0.6 + e.bodyRadius then
				hit = true
				ctx.damagePlayer(player, st, s, dmg)
				ctx.push(player, "knock", { dir = dir, power = 70 })
			end
			task.wait(0.035)
		end
		ctx.push(player, "dust", { pos = e.root.Position })
		e.busy = false
		e.nextAttack = os.clock() + 0.8
	end)
	e.nextSpecial = now + (e.cfg.chargeCd or 6)
end

local function groundCircle(ctx: any, player: Player, st: any, s: any, center: Vector3, radius: number, delay: number, dmg: number, fx: string)
	local floorPos = Vector3.new(center.X, s.arena.center.Y, center.Z)
	ctx.warnDisc(s, floorPos, radius, delay)
	task.delay(delay, function()
		if not (s.running and ctx.isCurrent(s)) then
			return
		end
		ctx.push(player, fx, { pos = floorPos, radius = radius })
		local r = ctx.getRoot(player)
		if r and (flat(r.Position) - flat(floorPos)).Magnitude <= radius then
			ctx.damagePlayer(player, st, s, dmg)
		end
	end)
end

------------------------------------------------------------------------
-- 종류별 행동
------------------------------------------------------------------------
local behaviors: { [string]: (any, Player, any, any, any, BasePart, number, number) -> () } = {}

behaviors.grunt = function(ctx, player, st, s, e, root, dist, now)
	if dist <= e.reach and now >= e.nextAttack then
		strike(ctx, player, st, s, e)
	else
		chase(e, root.Position, now)
	end
end

behaviors.shield = behaviors.grunt

behaviors.archer = function(ctx, player, st, s, e, root, dist, now)
	local keep = e.cfg.keep or 22
	if dist < 11 then
		chase(e, e.root.Position + flatUnit(e.root.Position - root.Position) * 12, now)
	elseif dist > keep + 8 then
		chase(e, root.Position, now)
	elseif now >= e.nextSpecial then
		e.busy = true
		e.nextSpecial = now + (e.cfg.shotCd or 2.8) * (0.8 + math.random() * 0.4)
		hold(e)
		announce(e, "shoot", 0.6)
		local from = e.root.Position + Vector3.new(0, 0.5, 0)
		local dir = flatUnit(root.Position - from)
		e.model:PivotTo(CFrame.lookAt(e.root.Position, e.root.Position + dir))
		ctx.warnLane(s, from, dir, 46, 1.4, 0.6)
		task.delay(0.6, function()
			e.busy = false
			if alive(ctx, s, e) then
				projectile(ctx, player, st, s, from, dir, 65, 46, e.dmg * 1.2, "arrow", e.accent)
			end
		end)
	else
		hold(e)
	end
end

behaviors.brute = function(ctx, player, st, s, e, root, dist, now)
	if now >= e.nextSpecial and dist > 7 and dist < 34 then
		charge(ctx, player, st, s, e, root, 5, e.dmg * 1.8)
	elseif dist <= e.reach and now >= e.nextAttack then
		strike(ctx, player, st, s, e, 0.5)
	else
		chase(e, root.Position, now)
	end
end

behaviors.bomber = function(ctx, player, st, s, e, root, dist, now)
	if dist > 5 then
		chase(e, root.Position, now)
		return
	end
	-- 붙으면 1초 뒤 폭발
	e.busy = true
	hold(e)
	local radius = 8 * e.scale
	ctx.warnDisc(s, Vector3.new(e.root.Position.X, s.arena.center.Y, e.root.Position.Z), radius, 1.0)
	for i = 0, 3 do
		task.delay(i * 0.25, function()
			if e.alive then
				ctx.flash(e, Color3.new(1, 1, 1), 0.12)
			end
		end)
	end
	task.delay(1.0, function()
		if not alive(ctx, s, e) then
			return
		end
		local pos = e.root.Position
		ctx.push(player, "explode", { pos = pos, radius = radius })
		local r = ctx.getRoot(player)
		if r and (flat(r.Position) - flat(pos)).Magnitude <= radius then
			ctx.damagePlayer(player, st, s, e.dmg)
		end
		ctx.killEnemy(player, s, e, true)
	end)
end

behaviors.shaman = function(ctx, player, st, s, e, root, dist, now)
	local keep = e.cfg.keep or 24
	if dist < 12 then
		chase(e, e.root.Position + flatUnit(e.root.Position - root.Position) * 12, now)
	elseif dist > keep + 10 then
		chase(e, root.Position, now)
	elseif now >= e.nextSpecial then
		e.busy = true
		e.nextSpecial = now + (e.cfg.castCd or 4.5) * (0.85 + math.random() * 0.3)
		hold(e)
		ctx.flash(e, e.accent, 0.6)
		announce(e, "cast", 0.6)
		groundCircle(ctx, player, st, s, root.Position, 7, 1.3, e.dmg * 1.3, "flame")
		task.delay(0.6, function()
			e.busy = false
		end)
	else
		hold(e)
	end
end

behaviors.assassin = function(ctx, player, st, s, e, root, dist, now)
	if now >= e.nextSpecial and dist > 6 then
		e.nextSpecial = now + (e.cfg.blinkCd or 5)
		local look = flatUnit(root.CFrame.LookVector)
		local behind = root.Position - look * 4
		local from = e.root.Position
		e.model:PivotTo(CFrame.lookAt(behind, Vector3.new(root.Position.X, behind.Y, root.Position.Z)))
		ctx.push(player, "blink", { from = from, to = behind })
		strike(ctx, player, st, s, e, 0.45)
	elseif dist <= e.reach and now >= e.nextAttack then
		strike(ctx, player, st, s, e, 0.3)
	else
		chase(e, root.Position, now)
	end
end

behaviors.golem = function(ctx, player, st, s, e, root, dist, now)
	if now >= e.nextSpecial and dist < 9 * e.scale then
		-- 제자리 내려치기: 몸 둘레 원
		e.busy = true
		e.nextSpecial = now + (e.cfg.poundCd or 5)
		hold(e)
		local radius = (e.cfg.poundRadius or 10) * math.max(1, e.scale / 1.6)
		local pos = Vector3.new(e.root.Position.X, s.arena.center.Y, e.root.Position.Z)
		announce(e, "slam", 1.1)
		ctx.flash(e, Color3.fromRGB(255, 160, 60), 1.1)
		ctx.warnDisc(s, pos, radius, 1.1)
		task.delay(1.1, function()
			e.busy = false
			if not alive(ctx, s, e) then
				return
			end
			ctx.push(player, "slam", { pos = pos, radius = radius })
			local r = ctx.getRoot(player)
			if r and (flat(r.Position) - flat(pos)).Magnitude <= radius then
				ctx.damagePlayer(player, st, s, e.dmg * 1.5)
			end
		end)
	elseif dist <= e.reach and now >= e.nextAttack then
		strike(ctx, player, st, s, e, 0.6)
	else
		chase(e, root.Position, now)
	end
end

behaviors.ghost = function(ctx, player, st, s, e, root, dist, now)
	if now >= e.nextSpecial then
		-- 몸이 흐려진다: 그동안 공격이 통하지 않고 빠르게 다가온다
		e.nextSpecial = now + (e.cfg.phaseCd or 4.5)
		local t = e.cfg.phaseTime or 1.6
		e.phaseUntil = now + t
		e.model:SetAttribute("Phase", true)
		e.hum.WalkSpeed = e.baseSpeed * 1.5
		task.delay(t, function()
			if e.alive then
				e.model:SetAttribute("Phase", nil)
				e.hum.WalkSpeed = e.baseSpeed
			end
		end)
	end
	if dist <= e.reach and now >= e.nextAttack then
		strike(ctx, player, st, s, e, 0.35)
	else
		chase(e, root.Position, now)
	end
end

behaviors.splitter = behaviors.grunt

behaviors.priest = function(ctx, player, st, s, e, root, dist, now)
	local keep = e.cfg.keep or 22
	if now >= e.nextSpecial then
		-- 주위 적 치유
		e.nextSpecial = now + (e.cfg.healCd or 5)
		local targets = {}
		for _, other in ipairs(ctx.alive(s)) do
			if other ~= e and other.hp < other.maxHp and (flat(other.root.Position) - flat(e.root.Position)).Magnitude <= (e.cfg.healRadius or 22) then
				other.hp = math.min(other.maxHp, other.hp + other.maxHp * (e.cfg.heal or 0.15))
				other.fill.Size = UDim2.fromScale(math.clamp(other.hp / other.maxHp, 0, 1), 1)
				table.insert(targets, other.root.Position)
			end
		end
		announce(e, "cast", 0.6)
		if #targets > 0 then
			ctx.push(player, "heal", { from = e.root.Position, targets = targets })
		end
	end
	if dist < 12 then
		chase(e, e.root.Position + flatUnit(e.root.Position - root.Position) * 12, now)
	elseif dist > keep + 10 then
		chase(e, root.Position, now)
	elseif dist <= e.reach and now >= e.nextAttack then
		strike(ctx, player, st, s, e, 0.4)
	else
		hold(e)
	end
end

behaviors.knight = function(ctx, player, st, s, e, root, dist, now)
	if now >= e.nextSpecial and dist < 16 then
		-- 빨간 길을 그린 뒤 세 번 연속 베며 파고든다
		e.busy = true
		e.nextSpecial = now + (e.cfg.comboCd or 6)
		hold(e)
		local start = e.root.Position
		local dir = flatUnit(root.Position - start)
		local length = 14
		ctx.warnLane(s, start, dir, length, 5, 0.7)
		ctx.flash(e, Color3.fromRGB(255, 60, 60), 0.7)
		announce(e, "combo", 0.7)
		task.delay(0.7, function()
			local hit = false
			for i = 1, 3 do
				if not alive(ctx, s, e) then
					break
				end
				local p = start + dir * length * (i / 3)
				e.model:PivotTo(CFrame.lookAt(p, p + dir))
				announce(e, "swing", 0.05)
				local r = ctx.getRoot(player)
				if not hit and r and (flat(r.Position) - flat(p)).Magnitude < 4.5 + e.bodyRadius then
					hit = true
					ctx.damagePlayer(player, st, s, e.dmg * 1.4)
				end
				task.wait(0.2)
			end
			e.busy = false
			e.nextAttack = os.clock() + 0.8
		end)
	elseif dist <= e.reach and now >= e.nextAttack then
		strike(ctx, player, st, s, e, 0.4)
	else
		chase(e, root.Position, now)
	end
end

------------------------------------------------------------------------
-- 보스
------------------------------------------------------------------------
local bossMoves: { [string]: (any, Player, any, any, any, BasePart) -> () } = {}

bossMoves.slam = function(ctx, player, st, s, e, root)
	e.busy = true
	hold(e)
	announce(e, "slam", 1.3)
	ctx.flash(e, Color3.fromRGB(255, 140, 0), 1.3)
	groundCircle(ctx, player, st, s, root.Position, 12, 1.3, e.slamDmg, "slam")
	task.delay(1.3, function()
		e.busy = false
		e.nextAttack = os.clock() + 0.8
	end)
end

bossMoves.charge = function(ctx, player, st, s, e, root)
	charge(ctx, player, st, s, e, root, 8, e.slamDmg * 0.8)
end

bossMoves.spin = function(ctx, player, st, s, e, _root)
	e.busy = true
	hold(e)
	local radius = 11 * (e.scale / 1.8)
	ctx.warnDisc(s, Vector3.new(e.root.Position.X, s.arena.center.Y, e.root.Position.Z), radius, 0.8)
	ctx.flash(e, Color3.fromRGB(255, 200, 60), 0.8)
	announce(e, "spin", 0.8)
	task.delay(0.8, function()
		for _ = 1, 5 do
			if not alive(ctx, s, e) then
				break
			end
			ctx.push(player, "spin", { pos = e.root.Position, radius = radius })
			local r = ctx.getRoot(player)
			if r and (flat(r.Position) - flat(e.root.Position)).Magnitude <= radius then
				ctx.damagePlayer(player, st, s, e.dmg * 1.2)
			end
			e.model:PivotTo(e.model:GetPivot() * CFrame.Angles(0, math.rad(72), 0))
			task.wait(0.3)
		end
		e.busy = false
	end)
end

bossMoves.meteor = function(ctx, player, st, s, e, root)
	e.busy = true
	hold(e)
	ctx.flash(e, Color3.fromRGB(255, 80, 30), 0.6)
	announce(e, "cast", 0.6)
	local spots = { root.Position }
	for _ = 1, 4 do
		local a = math.random() * math.pi * 2
		local d = 5 + math.random() * 10
		table.insert(spots, root.Position + Vector3.new(math.cos(a) * d, 0, math.sin(a) * d))
	end
	for i, p in ipairs(spots) do
		task.delay((i - 1) * 0.12, function()
			if s.running and ctx.isCurrent(s) then
				groundCircle(ctx, player, st, s, p, 6, 1.5, e.slamDmg * 0.6, "meteor")
			end
		end)
	end
	task.delay(0.6, function()
		e.busy = false
	end)
end

bossMoves.summon = function(ctx, player, st, s, e, _root)
	if ctx.aliveCount(s) >= 7 then
		return
	end
	e.busy = true
	hold(e)
	ctx.flash(e, Color3.fromRGB(180, 80, 255), 0.8)
	announce(e, "cast", 0.8)
	task.delay(0.8, function()
		e.busy = false
		if not alive(ctx, s, e) then
			return
		end
		for i = 1, 2 do
			local a = math.random() * math.pi * 2
			local pos = e.root.Position + Vector3.new(math.cos(a) * 8, 0, math.sin(a) * 8)
			ctx.push(player, "summon", { pos = Vector3.new(pos.X, s.arena.center.Y, pos.Z) })
			ctx.spawnUnit(s, i == 1 and "grunt" or "bomber", Vector3.new(pos.X, s.arena.center.Y, pos.Z))
		end
		ctx.pushBattle(player)
	end)
end

-- 탄막: 몸에서 사방으로 빛탄을 두 번 쏜다
bossMoves.nova = function(ctx, player, st, s, e, _root)
	e.busy = true
	hold(e)
	ctx.flash(e, Color3.fromRGB(255, 220, 90), 0.8)
	announce(e, "cast", 0.8)
	task.delay(0.8, function()
		for wave = 0, 1 do
			if not alive(ctx, s, e) then
				break
			end
			local n = 12
			for i = 0, n - 1 do
				local a = (i + wave * 0.5) / n * math.pi * 2
				local dir = Vector3.new(math.cos(a), 0, math.sin(a))
				projectile(ctx, player, st, s, e.root.Position + Vector3.new(0, 1, 0), dir, 40, 50, e.dmg * 1.3, "orb", e.accent)
			end
			task.wait(0.5)
		end
		e.busy = false
	end)
end

-- 운석비: 투기장 곳곳에 원이 떨어진다
bossMoves.rain = function(ctx, player, st, s, e, root)
	e.busy = true
	hold(e)
	ctx.flash(e, Color3.fromRGB(255, 90, 60), 0.6)
	announce(e, "cast", 0.6)
	local center = s.arena.center
	for i = 1, 10 do
		local pos
		if i <= 2 then
			pos = root.Position + Vector3.new((math.random() - 0.5) * 6, 0, (math.random() - 0.5) * 6)
		else
			local a = math.random() * math.pi * 2
			local d = math.random() * (ctx.arenaRadius - 10)
			pos = center + Vector3.new(math.cos(a) * d, 0, math.sin(a) * d)
		end
		task.delay(i * 0.08, function()
			if s.running and ctx.isCurrent(s) then
				groundCircle(ctx, player, st, s, pos, 5.5, 1.4, e.slamDmg * 0.5, "meteor")
			end
		end)
	end
	task.delay(0.8, function()
		e.busy = false
	end)
end

local function bossTick(ctx: any, player: Player, st: any, s: any, e: any, root: BasePart, dist: number, now: number)
	if now >= e.nextSpecial and dist < 55 then
		local list = e.patterns
		local move = list[e.patternIndex]
		e.patternIndex = (e.patternIndex % #list) + 1
		e.nextSpecial = now + 5
		local fn = bossMoves[move]
		if fn then
			fn(ctx, player, st, s, e, root)
			return
		end
	end
	if dist <= e.reach and now >= e.nextAttack then
		strike(ctx, player, st, s, e, 0.45)
	else
		chase(e, root.Position, now)
	end
end

function EnemyAI.tick(ctx: any, player: Player, st: any, s: any, e: any, root: BasePart, now: number)
	if not canAct(e, now) then
		if now < e.stunUntil or now < e.frozenUntil then
			hold(e)
		end
		return
	end
	local dist = (flat(e.root.Position) - flat(root.Position)).Magnitude
	if e.isBoss then
		bossTick(ctx, player, st, s, e, root, dist, now)
	else
		local fn = behaviors[e.kind] or behaviors.grunt
		fn(ctx, player, st, s, e, root, dist, now)
	end
end

return EnemyAI
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="9">
        <Properties>
          <string name="Name">EnemyBuilder</string>
          <string name="Source"><![CDATA[-- EnemyBuilder (ModuleScript, ArenaServer 아래)
-- 적 12종의 생김새. 기본 인형에 투구, 방패, 활, 지팡이, 폭탄 같은 장비를 붙인다.
-- 등급마다 몸 색, 재질, 등 가시 개수, 속성 오라가 다르다. 보스는 왕관과 망토.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local WeaponBuilder = require(ReplicatedStorage:WaitForChild("WeaponBuilder"))
local GradeStyle = require(ReplicatedStorage:WaitForChild("GradeStyle"))

local EnemyBuilder = {}

local GOLD = Color3.fromRGB(225, 180, 70)
local IRON = Color3.fromRGB(70, 72, 80)
local WOOD = Color3.fromRGB(95, 65, 40)
local LEATHER = Color3.fromRGB(80, 55, 38)

-- 종류마다 몸 색에 섞는 색, 눈 색
local TINT = {
	grunt = { tint = Color3.fromRGB(150, 120, 100), eye = Color3.fromRGB(255, 70, 50) },
	archer = { tint = Color3.fromRGB(70, 120, 70), eye = Color3.fromRGB(180, 255, 120) },
	shield = { tint = Color3.fromRGB(110, 120, 150), eye = Color3.fromRGB(120, 200, 255) },
	brute = { tint = Color3.fromRGB(140, 60, 50), eye = Color3.fromRGB(255, 140, 30) },
	bomber = { tint = Color3.fromRGB(150, 110, 60), eye = Color3.fromRGB(255, 230, 60) },
	shaman = { tint = Color3.fromRGB(100, 60, 140), eye = Color3.fromRGB(220, 120, 255) },
	assassin = { tint = Color3.fromRGB(40, 35, 50), eye = Color3.fromRGB(255, 40, 90) },
	golem = { tint = Color3.fromRGB(120, 110, 100), eye = Color3.fromRGB(255, 170, 60) },
	ghost = { tint = Color3.fromRGB(170, 200, 230), eye = Color3.fromRGB(140, 255, 255) },
	splitter = { tint = Color3.fromRGB(90, 160, 90), eye = Color3.fromRGB(230, 255, 90) },
	priest = { tint = Color3.fromRGB(230, 220, 190), eye = Color3.fromRGB(120, 255, 160) },
	knight = { tint = Color3.fromRGB(35, 35, 45), eye = Color3.fromRGB(255, 50, 50) },
}

-- 정예 특성마다 오라 색
local ELITE_COLOR = {
	swift = Color3.fromRGB(90, 220, 255),
	giant = Color3.fromRGB(255, 170, 60),
	regen = Color3.fromRGB(110, 255, 120),
	fury = Color3.fromRGB(255, 50, 60),
}

local function weld(model: Model, base: BasePart, name: string, size: Vector3, offset: CFrame, color: Color3, material: Enum.Material, shape: Enum.PartType?): Part
	local p = Instance.new("Part")
	p.Name = name
	if shape then
		p.Shape = shape
	end
	p.Size = size
	p.Color = color
	p.Material = material
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.Massless = true
	p.CastShadow = false
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.CFrame = base.CFrame * offset
	local w = Instance.new("WeldConstraint")
	w.Part0 = base
	w.Part1 = p
	w.Parent = p
	p.Parent = model
	return p
end

local function find(model: Model, name: string): BasePart?
	local p = model:FindFirstChild(name)
	if p and p:IsA("BasePart") then
		return p
	end
	return nil
end

local function particles(parent: Instance, color: Color3 | ColorSequence, rate: number, size: number, speed: number, name: string?)
	local pe = Instance.new("ParticleEmitter")
	pe.Name = name or "Aura"
	pe.Rate = rate
	pe.Lifetime = NumberRange.new(0.6, 1.2)
	pe.Speed = NumberRange.new(speed * 0.5, speed)
	pe.EmissionDirection = Enum.NormalId.Top
	pe.SpreadAngle = Vector2.new(30, 30)
	pe.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, size), NumberSequenceKeypoint.new(1, 0) })
	pe.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.4), NumberSequenceKeypoint.new(1, 1) })
	pe.LightEmission = 0.8
	pe.Color = typeof(color) == "ColorSequence" and color or ColorSequence.new(color :: Color3)
	pe.Parent = parent
	return pe
end

-- 종류별 장비
local dressers: { [string]: (Model, number, Color3, number) -> () } = {}

dressers.grunt = function(model, s, accent, grade)
	local head = find(model, "Head")
	local hand = find(model, "RightHand")
	if head then
		weld(model, head, "Helmet", Vector3.new(1.35, 0.75, 1.35) * s, CFrame.new(0, 0.3 * s, 0), IRON, Enum.Material.Metal, Enum.PartType.Ball)
		weld(model, head, "Crest", Vector3.new(0.15, 0.5, 1.1) * s, CFrame.new(0, 0.75 * s, 0), accent, grade >= 20 and Enum.Material.Neon or Enum.Material.Metal)
	end
	if hand then
		WeaponBuilder.build(model, hand, 1, { grade = grade, accent = accent, rarity = 1, scale = 0.7 * s, lite = true })
	end
end

dressers.archer = function(model, s, accent, grade)
	local head = find(model, "Head")
	local left = find(model, "LeftHand")
	local torso = find(model, "UpperTorso")
	if head then
		weld(model, head, "Hood", Vector3.new(1.45, 1.45, 1.45) * s, CFrame.new(0, 0.12 * s, 0.12 * s), Color3.fromRGB(45, 70, 45), Enum.Material.Fabric, Enum.PartType.Ball)
	end
	if left then
		-- 활: 세로로 휜 다섯 조각 + 빛나는 시위
		local radius, segs = 1.6 * s, 5
		for i = 0, segs - 1 do
			local a0 = math.rad(-60 + 120 * i / segs)
			local a1 = math.rad(-60 + 120 * (i + 1) / segs)
			local y0, z0 = math.sin(a0) * radius, -math.cos(a0) * radius + radius - 0.6 * s
			local y1, z1 = math.sin(a1) * radius, -math.cos(a1) * radius + radius - 0.6 * s
			local len = math.sqrt((y1 - y0) ^ 2 + (z1 - z0) ^ 2) + 0.05
			local ang = math.atan2(z1 - z0, y1 - y0)
			weld(model, left, "Bow" .. i, Vector3.new(0.18 * s, len, 0.22 * s), CFrame.new(0, (y0 + y1) / 2, (z0 + z1) / 2) * CFrame.Angles(ang, 0, 0), WOOD, Enum.Material.Wood)
		end
		weld(model, left, "BowString", Vector3.new(0.05, radius * 1.7, 0.05), CFrame.new(0, 0, 0.15 * s), accent, Enum.Material.Neon)
	end
	if torso then
		weld(model, torso, "Quiver", Vector3.new(1.6 * s, 0.55 * s, 0.55 * s), CFrame.new(0.3 * s, 0.2 * s, 0.55 * s) * CFrame.Angles(0, 0, math.rad(70)), LEATHER, Enum.Material.Fabric, Enum.PartType.Cylinder)
		for i = 1, 3 do
			weld(model, torso, "Arrow" .. i, Vector3.new(0.08, 0.6, 0.08) * s, CFrame.new((-0.05 + i * 0.12) * s, 1.05 * s, 0.55 * s), accent, Enum.Material.Neon)
		end
	end
end

dressers.shield = function(model, s, accent, grade)
	local head = find(model, "Head")
	local arm = find(model, "LeftLowerArm")
	local hand = find(model, "RightHand")
	if head then
		weld(model, head, "Helm", Vector3.new(1.3, 1.25, 1.3) * s, CFrame.new(0, 0.1 * s, 0), Color3.fromRGB(150, 155, 170), Enum.Material.Metal)
		weld(model, head, "Visor", Vector3.new(1.0, 0.12, 0.1) * s, CFrame.new(0, 0.05 * s, -0.66 * s), accent, Enum.Material.Neon)
		weld(model, head, "Plume", Vector3.new(0.2, 0.9, 1.2) * s, CFrame.new(0, 0.95 * s, 0.1 * s), accent, grade >= 10 and Enum.Material.Neon or Enum.Material.Fabric)
	end
	if arm then
		local shieldPart = weld(model, arm, "Shield", Vector3.new(2.4, 3.2, 0.3) * s, CFrame.new(-0.2 * s, -0.2 * s, -0.75 * s), Color3.fromRGB(120, 125, 140), Enum.Material.Metal)
		weld(model, shieldPart, "ShieldRim", Vector3.new(2.6, 3.4, 0.2) * s, CFrame.new(0, 0, 0.08 * s), GOLD, Enum.Material.Metal)
		weld(model, shieldPart, "ShieldEmblem", Vector3.new(0.12, 1.2, 1.2) * s, CFrame.new(0, 0.2 * s, -0.18 * s) * CFrame.Angles(0, math.rad(90), 0), accent, Enum.Material.Neon, Enum.PartType.Cylinder)
	end
	if hand then
		WeaponBuilder.build(model, hand, 3, { grade = grade, accent = accent, rarity = 1, scale = 0.6 * s, lite = true })
	end
end

dressers.brute = function(model, s, accent, grade)
	local head = find(model, "Head")
	local hand = find(model, "RightHand")
	for _, side in ipairs({ "Left", "Right" }) do
		local arm = find(model, side .. "UpperArm")
		if arm then
			weld(model, arm, side .. "Pad", Vector3.new(1.4, 1.1, 1.4) * s, CFrame.new(0, 0.45 * s, 0), IRON, Enum.Material.Metal, Enum.PartType.Ball)
			weld(model, arm, side .. "Spike", Vector3.new(0.25, 0.7, 0.25) * s, CFrame.new(0, 1.1 * s, 0), accent, Enum.Material.Neon)
		end
	end
	if head then
		for _, x in ipairs({ -1, 1 }) do
			weld(model, head, "Horn", Vector3.new(0.3, 1.1, 0.3) * s, CFrame.new(0.5 * x * s, 0.6 * s, -0.1 * s) * CFrame.Angles(0, 0, math.rad(-30 * x)), Color3.fromRGB(235, 225, 200), Enum.Material.SmoothPlastic)
		end
	end
	if hand then
		-- 거대한 몽둥이
		weld(model, hand, "ClubHandle", Vector3.new(0.4, 2.6, 0.4) * s, CFrame.new(0, -0.3 * s, -1.0 * s) * CFrame.Angles(math.rad(-90), 0, 0), WOOD, Enum.Material.Wood)
		local headPart = weld(model, hand, "ClubHead", Vector3.new(1.2, 1.2, 1.2) * s, CFrame.new(0, -0.3 * s, -2.6 * s), IRON, Enum.Material.Metal, Enum.PartType.Ball)
		for i = 0, 3 do
			local a = i * math.pi / 2
			weld(model, headPart, "ClubSpike" .. i, Vector3.new(0.2, 0.6, 0.2) * s, CFrame.Angles(a, 0, 0) * CFrame.new(0, 0.7 * s, 0), accent, grade >= 20 and Enum.Material.Neon or Enum.Material.Metal)
		end
	end
end

dressers.bomber = function(model, s, accent, _grade)
	local head = find(model, "Head")
	local torso = find(model, "UpperTorso")
	if head then
		for _, x in ipairs({ -1, 1 }) do
			weld(model, head, "Goggle", Vector3.new(0.12, 0.35, 0.35) * s, CFrame.new(0.2 * x * s, 0.1 * s, -0.62 * s) * CFrame.Angles(0, math.rad(90), 0), Color3.fromRGB(255, 220, 60), Enum.Material.Neon, Enum.PartType.Cylinder)
		end
	end
	if torso then
		local barrel = weld(model, torso, "Barrel", Vector3.new(1.6, 1.2, 1.2) * s, CFrame.new(0, 0.1 * s, 0.85 * s) * CFrame.Angles(0, 0, math.rad(90)), Color3.fromRGB(110, 70, 40), Enum.Material.Wood, Enum.PartType.Cylinder)
		for _, y in ipairs({ -0.5, 0.5 }) do
			weld(model, barrel, "Band", Vector3.new(0.15, 1.3, 1.3) * s, CFrame.new(y * s, 0, 0), IRON, Enum.Material.Metal, Enum.PartType.Cylinder)
		end
		local fuse = weld(model, torso, "Fuse", Vector3.new(0.12, 0.6, 0.12) * s, CFrame.new(0, 1.0 * s, 0.85 * s), Color3.fromRGB(255, 80, 40), Enum.Material.Neon)
		local spark = Instance.new("Sparkles")
		spark.SparkleColor = Color3.fromRGB(255, 160, 60)
		spark.Parent = fuse
		local light = Instance.new("PointLight")
		light.Color = Color3.fromRGB(255, 120, 40)
		light.Range = 8
		light.Brightness = 2
		light.Parent = fuse
	end
	local _ = accent
end

dressers.shaman = function(model, s, accent, grade)
	local head = find(model, "Head")
	local lower = find(model, "LowerTorso")
	local hand = find(model, "RightHand")
	if head then
		weld(model, head, "Hat", Vector3.new(0.9, 1.6, 0.9) * s, CFrame.new(0, 1.05 * s, 0.1 * s) * CFrame.Angles(math.rad(-12), 0, 0), Color3.fromRGB(70, 40, 100), Enum.Material.Fabric)
		weld(model, head, "HatBrim", Vector3.new(0.1, 1.9, 1.9) * s, CFrame.new(0, 0.42 * s, 0) * CFrame.Angles(0, 0, math.rad(90)), Color3.fromRGB(60, 35, 90), Enum.Material.Fabric, Enum.PartType.Cylinder)
	end
	if lower then
		weld(model, lower, "Robe", Vector3.new(2.2, 1.9, 1.9) * s, CFrame.new(0, -0.9 * s, 0) * CFrame.Angles(0, 0, math.rad(90)), Color3.fromRGB(80, 45, 115), Enum.Material.Fabric, Enum.PartType.Cylinder)
	end
	if hand then
		weld(model, hand, "Staff", Vector3.new(0.25, 5, 0.25) * s, CFrame.new(0, 1.2 * s, 0), WOOD, Enum.Material.Wood)
		local orb = weld(model, hand, "Orb", Vector3.new(0.9, 0.9, 0.9) * s, CFrame.new(0, 3.9 * s, 0), accent, Enum.Material.Neon, Enum.PartType.Ball)
		local light = Instance.new("PointLight")
		light.Color = accent
		light.Range = 10
		light.Brightness = 2
		light.Parent = orb
		particles(orb, accent, 10, 0.4 * s, 2, "OrbGlow")
	end
	local _ = grade
end

dressers.assassin = function(model, s, accent, grade)
	local head = find(model, "Head")
	local torso = find(model, "UpperTorso")
	if head then
		weld(model, head, "Hood", Vector3.new(1.4, 1.4, 1.4) * s, CFrame.new(0, 0.1 * s, 0.1 * s), Color3.fromRGB(25, 22, 30), Enum.Material.Fabric, Enum.PartType.Ball)
		weld(model, head, "Mask", Vector3.new(1.1, 0.45, 0.1) * s, CFrame.new(0, -0.2 * s, -0.62 * s), Color3.fromRGB(20, 20, 24), Enum.Material.SmoothPlastic)
	end
	if torso then
		weld(model, torso, "Scarf", Vector3.new(0.5, 2.2, 0.1) * s, CFrame.new(0.3 * s, -0.2 * s, 0.6 * s) * CFrame.Angles(math.rad(20), 0, 0), Color3.fromRGB(200, 30, 60), Enum.Material.Fabric)
		particles(torso, Color3.fromRGB(60, 30, 80), 6, 0.9 * s, 1, "Shadow")
	end
	for _, side in ipairs({ "RightHand", "LeftHand" }) do
		local hand = find(model, side)
		if hand then
			WeaponBuilder.build(model, hand, 4, { grade = grade, accent = accent, rarity = 1, scale = 0.9 * s, lite = true })
		end
	end
end

dressers.golem = function(model, s, accent, grade)
	local ROCK = Color3.fromRGB(105, 98, 90)
	for _, name in ipairs({ "UpperTorso", "LeftUpperArm", "RightUpperArm", "LeftLowerArm", "RightLowerArm" }) do
		local part = find(model, name)
		if part then
			for i = 1, 2 do
				weld(model, part, "Rock", Vector3.new(0.9, 0.7, 0.8) * s, CFrame.new((i - 1.5) * 0.5 * s, 0.2 * s * i, -0.3 * s) * CFrame.Angles(math.rad(i * 30), math.rad(i * 50), 0), ROCK, Enum.Material.Slate)
			end
			weld(model, part, "Crack", Vector3.new(0.1, part.Size.Y * 0.8, 0.12), CFrame.new(0, 0, -part.Size.Z / 2 - 0.02), accent, Enum.Material.Neon)
		end
	end
	local head = find(model, "Head")
	if head then
		weld(model, head, "Brow", Vector3.new(1.5, 0.45, 0.6) * s, CFrame.new(0, 0.35 * s, -0.35 * s), ROCK, Enum.Material.Slate)
	end
	for _, side in ipairs({ "LeftHand", "RightHand" }) do
		local hand = find(model, side)
		if hand then
			weld(model, hand, "Fist", Vector3.new(1.3, 1.3, 1.3) * s, CFrame.new(0, -0.3 * s, 0), ROCK, Enum.Material.Slate, Enum.PartType.Ball)
		end
	end
	local upper = find(model, "UpperTorso")
	if upper then
		particles(upper, Color3.fromRGB(180, 160, 130), 4, 0.8 * s, 1, "Dust")
	end
	local _ = grade
end

dressers.ghost = function(model, s, accent, grade)
	local head = find(model, "Head")
	local lower = find(model, "LowerTorso")
	if head then
		weld(model, head, "Shroud", Vector3.new(1.5, 1.6, 1.5) * s, CFrame.new(0, 0.15 * s, 0.1 * s), Color3.fromRGB(200, 220, 240), Enum.Material.Glass, Enum.PartType.Ball).Transparency = 0.35
	end
	if lower then
		local tail = weld(model, lower, "Tail", Vector3.new(2.2, 2.6, 1.6) * s, CFrame.new(0, -1.3 * s, 0.1 * s), Color3.fromRGB(190, 215, 240), Enum.Material.Glass)
		tail.Transparency = 0.45
		particles(tail, accent, 10, 0.7 * s, 1.5, "Wisp")
	end
	for _, d in ipairs(model:GetChildren()) do
		if d:IsA("BasePart") and d.Name ~= "HumanoidRootPart" then
			d.Transparency = math.max(d.Transparency, 0.25)
		end
	end
	local hand = find(model, "RightHand")
	if hand then
		WeaponBuilder.build(model, hand, 5, { grade = grade, accent = accent, rarity = 1, scale = 0.6 * s, lite = true })
	end
end

dressers.splitter = function(model, s, accent, _grade)
	local SLIME = Color3.fromRGB(90, 200, 100)
	for _, name in ipairs({ "UpperTorso", "Head", "LowerTorso" }) do
		local part = find(model, name)
		if part then
			local blob = weld(model, part, "Blob", part.Size * 1.25, CFrame.new(), SLIME, Enum.Material.Glass, Enum.PartType.Ball)
			blob.Transparency = 0.4
		end
	end
	local upper = find(model, "UpperTorso")
	if upper then
		weld(model, upper, "Core", Vector3.new(0.7, 0.7, 0.7) * s, CFrame.new(0, 0.1 * s, 0), accent, Enum.Material.Neon, Enum.PartType.Ball)
		particles(upper, SLIME, 6, 0.4 * s, 1, "Drip").Acceleration = Vector3.new(0, -8, 0)
	end
end

dressers.priest = function(model, s, accent, _grade)
	local head = find(model, "Head")
	local lower = find(model, "LowerTorso")
	local hand = find(model, "RightHand")
	local WHITE = Color3.fromRGB(240, 235, 220)
	if head then
		weld(model, head, "Mitre", Vector3.new(0.9, 1.4, 0.6) * s, CFrame.new(0, 0.95 * s, 0), WHITE, Enum.Material.Fabric)
		weld(model, head, "MitreBand", Vector3.new(0.95, 0.15, 0.65) * s, CFrame.new(0, 0.55 * s, 0), GOLD, Enum.Material.Foil)
		for i = 0, 7 do
			local a = (i / 8) * math.pi * 2
			weld(model, head, "PriestHalo", Vector3.new(0.12, 0.12, 0.45) * s, CFrame.new(math.cos(a) * 0.8 * s, 1.9 * s, math.sin(a) * 0.8 * s) * CFrame.Angles(0, -a, 0), GOLD, Enum.Material.Neon)
		end
	end
	if lower then
		weld(model, lower, "Robe", Vector3.new(2.2, 2.0, 2.0) * s, CFrame.new(0, -0.95 * s, 0) * CFrame.Angles(0, 0, math.rad(90)), WHITE, Enum.Material.Fabric, Enum.PartType.Cylinder)
	end
	if hand then
		weld(model, hand, "Staff", Vector3.new(0.22, 5, 0.22) * s, CFrame.new(0, 1.2 * s, 0), GOLD, Enum.Material.Foil)
		weld(model, hand, "CrossH", Vector3.new(1.2, 0.22, 0.22) * s, CFrame.new(0, 3.3 * s, 0), GOLD, Enum.Material.Foil)
		local orb = weld(model, hand, "HolyOrb", Vector3.new(0.8, 0.8, 0.8) * s, CFrame.new(0, 3.9 * s, 0), Color3.fromRGB(140, 255, 170), Enum.Material.Neon, Enum.PartType.Ball)
		particles(orb, Color3.fromRGB(140, 255, 170), 10, 0.4 * s, 2, "HolyGlow")
	end
	local _ = accent
end

dressers.knight = function(model, s, accent, grade)
	local head = find(model, "Head")
	local upper = find(model, "UpperTorso")
	local arm = find(model, "LeftLowerArm")
	local hand = find(model, "RightHand")
	local BLACK = Color3.fromRGB(30, 30, 38)
	if head then
		weld(model, head, "Helm", Vector3.new(1.35, 1.35, 1.35) * s, CFrame.new(0, 0.1 * s, 0), BLACK, Enum.Material.Metal)
		weld(model, head, "Slit", Vector3.new(1.0, 0.1, 0.08) * s, CFrame.new(0, 0.1 * s, -0.69 * s), accent, Enum.Material.Neon)
		for _, x in ipairs({ -1, 1 }) do
			weld(model, head, "HelmHorn", Vector3.new(0.22, 1.0, 0.22) * s, CFrame.new(0.55 * x * s, 0.75 * s, 0) * CFrame.Angles(0, 0, math.rad(-35 * x)), BLACK, Enum.Material.Metal)
		end
	end
	if upper then
		for _, x in ipairs({ -1, 1 }) do
			weld(model, upper, "Pauldron", Vector3.new(1.3, 0.6, 1.3) * s, CFrame.new(1.1 * x * s, 0.7 * s, 0), BLACK, Enum.Material.Metal)
		end
		weld(model, upper, "Cape", Vector3.new(upper.Size.X * 1.1, 3 * s, 0.1), CFrame.new(0, -0.8 * s, upper.Size.Z / 2 + 0.1) * CFrame.Angles(math.rad(8), 0, 0), Color3.fromRGB(90, 15, 25), Enum.Material.Fabric)
	end
	if arm then
		local sh = weld(model, arm, "Shield", Vector3.new(2.0, 2.8, 0.3) * s, CFrame.new(-0.2 * s, -0.2 * s, -0.75 * s), BLACK, Enum.Material.Metal)
		weld(model, sh, "ShieldMark", Vector3.new(0.2, 1.4, 0.1) * s, CFrame.new(0, 0, -0.18 * s), accent, Enum.Material.Neon)
	end
	if hand then
		WeaponBuilder.build(model, hand, 1, { grade = grade, accent = accent, rarity = 3, scale = 0.75 * s, lite = true })
	end
end

-- 몸 재질과 색: 등급마다 다르다
local function bodyMaterial(grade: number): Enum.Material
	if grade < 10 then
		return Enum.Material.SmoothPlastic
	elseif grade < 30 then
		return Enum.Material.Metal
	elseif grade < 50 then
		return Enum.Material.Foil
	elseif grade < 65 then
		return Enum.Material.Glass
	elseif grade < 80 then
		return Enum.Material.Neon
	elseif grade < 94 then
		return Enum.Material.ForceField
	end
	return Enum.Material.Neon
end

local function paintBody(model: Model, kind: string, style: any, isBoss: boolean)
	local t = TINT[kind] or TINT.grunt
	local body = t.tint:Lerp(style.primary, 0.55)
	if isBoss then
		body = body:Lerp(Color3.fromRGB(120, 10, 20), 0.3)
	end
	local mat = bodyMaterial(style.grade)
	for _, d in ipairs(model:GetChildren()) do
		if d:IsA("BasePart") and d.Name ~= "HumanoidRootPart" then
			d.Color = body
			d.Material = mat
			if d.Name == "LeftHand" or d.Name == "RightHand" or d.Name == "LeftFoot" or d.Name == "RightFoot" then
				d.Color = style.secondary:Lerp(body, 0.4)
			end
		end
	end
end

-- opts: { elite = 정예 특성 id, beyond = 초월 스테이지 }
function EnemyBuilder.dress(model: Model, kind: string, grade: number, isBoss: boolean, scale: number, opts: any?)
	local style = GradeStyle.get(grade)
	paintBody(model, kind, style, isBoss)
	local t = TINT[kind] or TINT.grunt
	local accent = isBoss and Color3.fromRGB(255, 70, 50) or style.glow

	-- 빛나는 두 눈
	local head = find(model, "Head")
	if head then
		for _, x in ipairs({ -1, 1 }) do
			weld(model, head, "Eye", Vector3.new(0.2, 0.09, 0.06) * scale, CFrame.new(0.2 * x * scale, 0.08 * scale, -head.Size.Z / 2 - 0.01), grade >= 40 and Color3.new(1, 1, 1) or t.eye:Lerp(style.glow, 0.4), Enum.Material.Neon)
		end
	end

	local dresser = dressers[kind] or dressers.grunt
	pcall(dresser, model, scale, accent, grade)

	-- 등 가시: 등급이 오를수록 늘어난다
	local upper = find(model, "UpperTorso")
	if upper then
		for i = 1, style.enemySpikes do
			local y = upper.Size.Y * (0.35 - (i - 1) * 0.16)
			local size = (0.25 + style.power * 0.35) * scale
			weld(model, upper, "BackSpike", Vector3.new(size, size * 2.2, size), CFrame.new(0, y, upper.Size.Z / 2 + size * 0.6) * CFrame.Angles(math.rad(-35), 0, 0), grade >= 30 and style.secondary or style.primary, grade >= 30 and Enum.Material.Neon or Enum.Material.Metal)
		end
	end

	-- 속성 오라
	local torso = upper or find(model, "HumanoidRootPart")
	if torso and (style.enemyAura or isBoss) then
		local color: Color3 | ColorSequence = isBoss and Color3.fromRGB(255, 50, 40) or ColorSequence.new(style.glow, style.secondary)
		if style.rainbow then
			color = GradeStyle.RAINBOW
		end
		local pe = particles(torso, color, isBoss and 20 or 3 + grade * 0.15, (0.5 + style.power * 0.8) * scale, 2.5)
		pe.Texture = style.motif.tex
		pe.Acceleration = style.motif.drift
		if style.motif.id == "shadow" or style.motif.id == "void" then
			pe.LightEmission = 0.1
		end
	end
	if grade >= 25 and head then
		local light = Instance.new("PointLight")
		light.Color = style.glow
		light.Range = 6 + style.power * 8
		light.Brightness = 0.8 + style.power
		light.Parent = head
	end

	if isBoss then
		if head then
			local top = CFrame.new(0, head.Size.Y / 2 + 0.25 * scale, 0)
			weld(model, head, "CrownBand", Vector3.new(0.3, head.Size.X * 1.05, head.Size.X * 1.05), top * CFrame.Angles(0, 0, math.rad(90)), GOLD, Enum.Material.Metal, Enum.PartType.Cylinder)
			for i = 0, 4 do
				local a = (i / 5) * math.pi * 2
				local r = head.Size.X * 0.42
				weld(model, head, "Crown" .. i, Vector3.new(0.22, 0.6, 0.22) * scale, top * CFrame.new(math.cos(a) * r, 0.4 * scale, math.sin(a) * r), GOLD, Enum.Material.Neon)
			end
			local light = Instance.new("PointLight")
			light.Color = Color3.fromRGB(255, 70, 50)
			light.Range = 18
			light.Brightness = 2.2
			light.Parent = head
		end
		if upper then
			weld(model, upper, "Cape", Vector3.new(upper.Size.X * 1.2, 3.2 * scale, 0.1), CFrame.new(0, -0.9 * scale, upper.Size.Z / 2 + 0.1) * CFrame.Angles(math.rad(8), 0, 0), style.primary:Lerp(Color3.fromRGB(140, 15, 25), 0.6), Enum.Material.Fabric)
		end
	end
	local o = opts or {}
	-- 초월 스테이지: 검은 뿔 왕관과 무지개 기운
	if o.beyond and head then
		for _, x in ipairs({ -1, 1 }) do
			weld(model, head, "BeyondHorn", Vector3.new(0.25, 1.3, 0.25) * scale, CFrame.new(0.45 * x * scale, 0.9 * scale, 0.1 * scale) * CFrame.Angles(math.rad(-20), 0, math.rad(-25 * x)), Color3.fromRGB(20, 15, 30), Enum.Material.Metal)
		end
		local pe = particles(head, GradeStyle.RAINBOW, 6, 0.5 * scale, 2, "BeyondAura")
		pe.LightEmission = 1
	end
	-- 정예: 특성 색 오라와 발밑 고리
	local eliteColor = o.elite and ELITE_COLOR[o.elite]
	if eliteColor then
		local base = find(model, "HumanoidRootPart")
		if base then
			local ring = weld(model, base, "EliteRing", Vector3.new(0.15, 5 * scale, 5 * scale), CFrame.new(0, -2.8 * scale, 0) * CFrame.Angles(0, 0, math.rad(90)), eliteColor, Enum.Material.Neon, Enum.PartType.Cylinder)
			ring.Transparency = 0.5
			local pe = particles(base, eliteColor, 14, 0.7 * scale, 3, "EliteAura")
			pe.SpreadAngle = Vector2.new(60, 60)
		end
		if head then
			local light = Instance.new("PointLight")
			light.Color = eliteColor
			light.Range = 10
			light.Brightness = 1.5
			light.Parent = head
		end
	end
end

return EnemyBuilder
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="10">
        <Properties>
          <string name="Name">Skills</string>
          <string name="Source"><![CDATA[-- Skills (ModuleScript, ArenaServer 아래)
-- 무기 계열마다 두 개씩 있는 스킬(E, F). 피해 계산은 서버, 연출은 클라이언트가 한다.
-- 무기 등급 20마다 스킬이 한 단계씩 강해진다 (Lv.1~5). 단계마다 피해 +15%, 그리고
--   대검 투척 1 → 2 → 3자루, 검기 1 → 3 → 5갈래, 표식 1 → 2 → 3명, 잔상 1 → 2 → 3번,
--   파쇄 돌격은 Lv.3부터 끝에서 충격파, 반격은 Lv.5에 사방으로 검기, 맹독은 Lv.5에 독안개,
--   연막은 치명타 1 → 2 → 3회, 사슬은 Lv.3부터 내려찍기, 망자의 원은 단계마다 넓고 길어진다.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage:WaitForChild("GameConfig"))

local Skills = {}

local function flat(v: Vector3): Vector3
	return Vector3.new(v.X, 0, v.Z)
end

local function flatUnit(v: Vector3): Vector3
	local f = flat(v)
	if f.Magnitude < 0.001 then
		return Vector3.new(0, 0, -1)
	end
	return f.Unit
end

local function rotateY(v: Vector3, deg: number): Vector3
	return (CFrame.Angles(0, math.rad(deg), 0) * v)
end

-- 투기장 밖으로 나가지 않게 끝점을 줄인다
local function clampToArena(ctx: any, s: any, origin: Vector3, target: Vector3): Vector3
	local center = s.arena.center
	local fromCenter = flat(target - center)
	local limit = ctx.arenaRadius - 6
	if fromCenter.Magnitude > limit then
		return center + fromCenter.Unit * limit + Vector3.new(0, origin.Y - center.Y, 0)
	end
	return target
end

local function stun(ctx: any, player: Player, e: any, duration: number)
	if e.isBoss then
		duration *= 0.4
	end
	e.stunUntil = math.max(e.stunUntil, os.clock() + duration)
	ctx.push(player, "stun", { model = e.model, duration = duration })
end

local function knock(e: any, dir: Vector3, power: number)
	if e.isBoss or not e.alive then
		return
	end
	e.root.AssemblyLinearVelocity = dir * power + Vector3.new(0, power * 0.5, 0)
end

-- 단계 반영 피해
local function dmg(s: any, mult: number): number
	return s.stats.atk * mult * (1 + 0.15 * (s.skillTier - 1))
end

local function base(ctx: any, s: any, id: string): { [string]: any }
	return { id = id, color = ctx.color(s), grade = s.stats.weapon.grade, tier = s.skillTier }
end

-- 직선으로 날아가며 꿰뚫는 투사체 (검기)
local function flyingWave(ctx: any, player: Player, s: any, origin: Vector3, look: Vector3, range: number, speed: number, width: number, mult: number)
	local data = base(ctx, s, "wave")
	data.origin = origin
	data.look = look
	data.range = range
	data.speed = speed
	data.width = width
	ctx.push(player, "skill", data)
	task.spawn(function()
		local seen = {}
		local traveled = 0
		local step = 0.04
		while traveled < range do
			task.wait(step)
			if not (s.running and ctx.isCurrent(s)) then
				return
			end
			traveled += speed * step
			local pos = origin + look * traveled
			local hits = {}
			for _, e in ipairs(ctx.alive(s)) do
				if not seen[e] and (flat(e.root.Position) - flat(pos)).Magnitude <= width + e.bodyRadius then
					seen[e] = true
					ctx.hitEnemy(player, s, e, dmg(s, mult), false, pos, hits, { pierce = true })
				end
			end
			ctx.sendHits(player, hits)
		end
	end)
end

local casters: { [string]: (any, Player, any, any, any, BasePart, Vector3, Vector3) -> () } = {}

-- 대검 · 파쇄 돌격
casters.charge = function(ctx, player, _st, s, sk, _root, origin, look)
	local target = clampToArena(ctx, s, origin, origin + look * (sk.length + (s.skillTier - 1) * 2))
	local data = base(ctx, s, "charge")
	data.origin = origin
	data.target = target
	data.look = look
	ctx.push(player, "skill", data)
	local hits = {}
	for _, e in ipairs(ctx.nearSegment(s, origin, target, sk.width)) do
		ctx.hitEnemy(player, s, e, dmg(s, sk.mult), false, origin, hits)
		local side = look:Cross(Vector3.yAxis)
		if side:Dot(flat(e.root.Position - origin)) < 0 then
			side = -side
		end
		knock(e, side, 35)
		stun(ctx, player, e, sk.stun)
	end
	ctx.sendHits(player, hits)
	if s.skillTier >= 3 then
		-- 끝에서 충격파
		task.delay(0.22, function()
			if not (s.running and ctx.isCurrent(s)) then
				return
			end
			local radius = s.skillTier >= 5 and 11 or 7
			local boom = base(ctx, s, "chargeBoom")
			boom.pos = target
			boom.radius = radius
			ctx.push(player, "skill", boom)
			local h2 = {}
			for _, e in ipairs(ctx.alive(s)) do
				if (flat(e.root.Position) - flat(target)).Magnitude <= radius + e.bodyRadius then
					ctx.hitEnemy(player, s, e, dmg(s, sk.mult * 0.8), true, target, h2)
					knock(e, flatUnit(e.root.Position - target), 40)
				end
			end
			ctx.sendHits(player, h2)
		end)
	end
end

-- 대검 · 대검 투척 (갔다가 돌아온다). Lv.3 두 자루, Lv.5 세 자루
casters.boomerang = function(ctx, player, _st, s, sk, _root, origin, look)
	local duration = 1.0
	local angles = { 0 }
	if s.skillTier >= 5 then
		angles = { -20, 0, 20 }
	elseif s.skillTier >= 3 then
		angles = { -14, 14 }
	end
	for _, ang in ipairs(angles) do
		local dir = rotateY(look, ang)
		local data = base(ctx, s, "boomerang")
		data.origin = origin
		data.look = dir
		data.range = sk.range
		data.duration = duration
		ctx.push(player, "skill", data)
		task.spawn(function()
			local hitOut, hitBack = {}, {}
			local steps = 20
			local far = clampToArena(ctx, s, origin, origin + dir * sk.range)
			for i = 1, steps do
				task.wait(duration / steps)
				if not (s.running and ctx.isCurrent(s)) then
					return
				end
				local t = i / steps
				local pos
				local seen
				if t <= 0.5 then
					pos = origin:Lerp(far, t / 0.5)
					seen = hitOut
				else
					local r = ctx.getRoot(player)
					local home = r and r.Position or origin
					pos = far:Lerp(home, (t - 0.5) / 0.5)
					seen = hitBack
				end
				local hits = {}
				for _, e in ipairs(ctx.alive(s)) do
					if not seen[e] and (flat(e.root.Position) - flat(pos)).Magnitude <= sk.width + e.bodyRadius then
						seen[e] = true
						ctx.hitEnemy(player, s, e, dmg(s, sk.mult), false, pos, hits)
					end
				end
				ctx.sendHits(player, hits)
			end
		end)
	end
end

-- 쌍검 · 표식 연격. Lv.3 두 명, Lv.5 세 명
casters.mark = function(ctx, player, _st, s, sk, root, _origin, _look)
	local list = {}
	for _, e in ipairs(ctx.alive(s)) do
		local d = (flat(e.root.Position) - flat(root.Position)).Magnitude
		if d < 28 then
			table.insert(list, { e = e, d = d })
		end
	end
	if #list == 0 then
		ctx.toast(player, "가까이에 표식을 남길 적이 없어요")
		s.skillReadyAt[1] = 0
		return
	end
	table.sort(list, function(a, b)
		return a.d < b.d
	end)
	local count = s.skillTier >= 5 and 3 or (s.skillTier >= 3 and 2 or 1)
	for i = 1, math.min(count, #list) do
		local e = list[i].e
		s.marks[e] = true
		e.markStacks = 0
		e.model:SetAttribute("Mark", 0)
		local data = base(ctx, s, "mark")
		data.model = e.model
		data.stacks = sk.stacks
		ctx.push(player, "skill", data)
	end
end

-- 일반 공격이 맞을 때: 표식 폭발, 독 묻히기
function Skills.onBasicHit(ctx: any, player: Player, s: any, e: any, hits: { any })
	local now = os.clock()
	local skills = Config.Skills[s.stats.weapon.typeId]
	if s.marks[e] and e.alive then
		local sk = skills and skills[1]
		if sk and sk.id == "mark" then
			e.markStacks += 1
			e.model:SetAttribute("Mark", e.markStacks)
			if e.markStacks >= sk.stacks then
				s.marks[e] = nil
				e.model:SetAttribute("Mark", nil)
				local pos = e.root.Position
				local data = base(ctx, s, "markBoom")
				data.pos = pos
				ctx.push(player, "skill", data)
				ctx.hitEnemy(player, s, e, dmg(s, sk.mult), true, pos, hits)
				for _, other in ipairs(ctx.alive(s)) do
					if other ~= e and (flat(other.root.Position) - flat(pos)).Magnitude <= 8 + s.skillTier then
						ctx.hitEnemy(player, s, other, dmg(s, sk.splash), false, pos, hits)
					end
				end
			end
		end
	end
	if now < s.poisonUntil and e.alive then
		local sk = skills and skills[1]
		if sk and sk.id == "poison" then
			e.poisonUntil = now + sk.dotTime
			e.poisonDmg = dmg(s, sk.dotMult * (1 + 0.25 * (s.skillTier - 1)))
			e.model:SetAttribute("Poison", true)
		end
	end
end

-- 쌍검 · 잔상 돌파. Lv.3 잔상 두 번, Lv.5 세 번
casters.phantom = function(ctx, player, _st, s, sk, _root, origin, look)
	local target = clampToArena(ctx, s, origin, origin + look * sk.length)
	local data = base(ctx, s, "phantom")
	data.origin = origin
	data.target = target
	data.look = look
	ctx.push(player, "skill", data)
	local hits = {}
	for _, e in ipairs(ctx.nearSegment(s, origin, target, sk.width)) do
		ctx.hitEnemy(player, s, e, dmg(s, sk.mult), false, origin, hits)
	end
	ctx.sendHits(player, hits)
	local echoes = s.skillTier >= 5 and 3 or (s.skillTier >= 3 and 2 or 1)
	for k = 1, echoes do
		task.delay(0.45 * k, function()
			if not (s.running and ctx.isCurrent(s)) then
				return
			end
			local echo = base(ctx, s, "phantomEcho")
			echo.origin = origin
			echo.target = target
			echo.index = k
			ctx.push(player, "skill", echo)
			local h = {}
			for _, e in ipairs(ctx.nearSegment(s, origin, target, sk.width)) do
				ctx.hitEnemy(player, s, e, dmg(s, sk.mult), true, origin, h)
			end
			ctx.sendHits(player, h)
		end)
	end
end

-- 장검 · 검기 발사. Lv.3 세 갈래, Lv.5 다섯 갈래
casters.wave = function(ctx, player, _st, s, sk, _root, origin, look)
	local angles = { 0 }
	if s.skillTier >= 5 then
		angles = { -24, -12, 0, 12, 24 }
	elseif s.skillTier >= 3 then
		angles = { -15, 0, 15 }
	end
	for _, ang in ipairs(angles) do
		flyingWave(ctx, player, s, origin, rotateY(look, ang), sk.range, sk.speed, sk.width, sk.mult)
	end
end

-- 장검 · 반격 자세 (막는 건 damagePlayer에서 처리)
casters.parry = function(ctx, player, _st, s, sk, _root, _origin, _look)
	s.parryUntil = os.clock() + sk.window
	local data = base(ctx, s, "parry")
	data.window = sk.window
	ctx.push(player, "skill", data)
end

-- 막기에 성공했을 때 반격. 단계마다 넓어지고, Lv.5는 사방으로 검기
function Skills.tryParry(ctx: any, player: Player, s: any): boolean
	if os.clock() >= s.parryUntil then
		return false
	end
	s.parryUntil = 0
	local sk = Config.Skills[3][2]
	local root = ctx.getRoot(player)
	local pos = root and root.Position or s.arena.center
	local radius = sk.radius + (s.skillTier - 1) * 2
	s.invulnUntil = math.max(s.invulnUntil, os.clock() + 0.6)
	local data = base(ctx, s, "parryCounter")
	data.pos = pos
	data.radius = radius
	ctx.push(player, "skill", data)
	local hits = {}
	for _, e in ipairs(ctx.alive(s)) do
		if (flat(e.root.Position) - flat(pos)).Magnitude <= radius + e.bodyRadius then
			ctx.hitEnemy(player, s, e, dmg(s, sk.mult), true, pos, hits, { pierce = true })
			stun(ctx, player, e, 1 + 0.25 * s.skillTier)
		end
	end
	ctx.sendHits(player, hits)
	if s.skillTier >= 5 then
		for i = 0, 7 do
			flyingWave(ctx, player, s, pos, rotateY(Vector3.new(0, 0, -1), i * 45), 30, 60, 4, 2)
		end
	end
	return true
end

-- 단계 반영 지속 피해 장판 (독안개, 망자의 원)
local function addZone(ctx: any, player: Player, s: any, pos: Vector3, radius: number, duration: number, mult: number, heal: number, kind: string)
	local floorPos = Vector3.new(pos.X, s.arena.center.Y, pos.Z)
	table.insert(s.zones, { pos = floorPos, radius = radius, untilT = os.clock() + duration, nextTick = 0, mult = mult, heal = heal })
	local data = base(ctx, s, kind)
	data.pos = floorPos
	data.radius = radius
	data.duration = duration
	ctx.push(player, "skill", data)
end

-- 단검 · 맹독 칼날. Lv.3 지속 +3초, Lv.5 가까운 적 자리에 독안개
casters.poison = function(ctx, player, _st, s, sk, root, _origin, _look)
	local duration = sk.duration + (s.skillTier >= 3 and 3 or 0)
	s.poisonUntil = os.clock() + duration
	local data = base(ctx, s, "poison")
	data.duration = duration
	ctx.push(player, "skill", data)
	if s.skillTier >= 5 then
		local best, bestD = nil, 30
		for _, e in ipairs(ctx.alive(s)) do
			local d = (flat(e.root.Position) - flat(root.Position)).Magnitude
			if d < bestD then
				best, bestD = e, d
			end
		end
		if best then
			addZone(ctx, player, s, best.root.Position, 9, 4, sk.dotMult * 2, 0, "poisonCloud")
		end
	end
end

-- 단검 · 연막 순보. 치명타 횟수 Lv.1 1회, Lv.3 2회, Lv.5 3회
casters.smoke = function(ctx, player, _st, s, sk, root, _origin, _look)
	s.invulnUntil = math.max(s.invulnUntil, os.clock() + sk.invuln)
	s.smokeCrit = sk.mult
	s.smokeCharges = s.skillTier >= 5 and 3 or (s.skillTier >= 3 and 2 or 1)
	local data = base(ctx, s, "smoke")
	data.pos = root.Position
	data.duration = sk.invuln
	ctx.push(player, "skill", data)
end

-- 낫 · 사슬 낚아채기. 단계마다 멀리, Lv.3부터 끌어온 뒤 내려찍기, Lv.5는 보스도 끌어온다
casters.hook = function(ctx, player, _st, s, sk, _root, origin, look)
	local victims = {}
	local pulled = {}
	local hits = {}
	local idx = 0
	local range = sk.range + (s.skillTier - 1) * 4
	for _, e in ipairs(ctx.alive(s)) do
		local off = flat(e.root.Position - origin)
		if off.Magnitude <= range and off.Magnitude > 0.1 and off.Unit:Dot(look) >= sk.cone then
			idx += 1
			table.insert(victims, e.root.Position)
			if not e.isBoss or s.skillTier >= 5 then
				local side = look:Cross(Vector3.yAxis) * ((idx % 2 == 0) and 1 or -1) * (idx // 2) * 2
				local dest = origin + look * 4 + side
				e.model:PivotTo(CFrame.lookAt(Vector3.new(dest.X, e.root.Position.Y, dest.Z), Vector3.new(origin.X, e.root.Position.Y, origin.Z)))
			end
			ctx.hitEnemy(player, s, e, dmg(s, sk.mult), false, origin, hits)
			stun(ctx, player, e, sk.stun)
			table.insert(pulled, e)
		end
	end
	local data = base(ctx, s, "hook")
	data.origin = origin
	data.victims = victims
	ctx.push(player, "skill", data)
	ctx.sendHits(player, hits)
	if s.skillTier >= 3 and #pulled > 0 then
		task.delay(0.35, function()
			if not (s.running and ctx.isCurrent(s)) then
				return
			end
			local slamPos = origin + look * 4
			local slam = base(ctx, s, "hookSlam")
			slam.pos = slamPos
			ctx.push(player, "skill", slam)
			local h = {}
			for _, e in ipairs(pulled) do
				ctx.hitEnemy(player, s, e, dmg(s, sk.mult * 1.5), true, origin, h)
			end
			ctx.sendHits(player, h)
		end)
	end
end

-- 낫 · 망자의 원. 단계마다 넓고 길어진다
casters.zone = function(ctx, player, _st, s, sk, _root, origin, _look)
	addZone(ctx, player, s, origin, sk.radius + (s.skillTier - 1) * 1.5, sk.duration + (s.skillTier - 1) * 0.5, sk.tickMult, sk.heal, "zone")
end

function Skills.tickZones(ctx: any, player: Player, s: any, now: number)
	for i = #s.zones, 1, -1 do
		local z = s.zones[i]
		if now >= z.untilT then
			table.remove(s.zones, i)
		elseif now >= z.nextTick then
			z.nextTick = now + 0.5
			local hits = {}
			for _, e in ipairs(ctx.alive(s)) do
				if (flat(e.root.Position) - flat(z.pos)).Magnitude <= z.radius + e.bodyRadius then
					ctx.hitEnemy(player, s, e, dmg(s, z.mult), false, z.pos, hits)
				end
			end
			if z.heal > 0 then
				ctx.heal(s, s.maxHp * z.heal)
			end
			ctx.sendHits(player, hits)
			ctx.pushBattle(player)
		end
	end
end

-- 올라운더 · 만검 강림 (Lv.5: 검 20자루)
casters.rain = function(ctx, player, _st, s, sk, _root, _origin, _look)
	local list = ctx.alive(s)
	if #list == 0 then
		s.skillReadyAt[1] = 0
		return
	end
	local count = sk.count + (s.skillTier >= 5 and 8 or 0)
	local targets = {}
	for i = 1, count do
		table.insert(targets, list[((i - 1) % #list) + 1])
	end
	local positions = {}
	for _, e in ipairs(targets) do
		table.insert(positions, e.root.Position + Vector3.new((math.random() - 0.5) * 2, 0, (math.random() - 0.5) * 2))
	end
	local data = base(ctx, s, "rain")
	data.positions = positions
	ctx.push(player, "skill", data)
	for i, e in ipairs(targets) do
		task.delay(0.35 + (i - 1) * 0.07, function()
			if s.running and ctx.isCurrent(s) and e.alive then
				local hits = {}
				ctx.hitEnemy(player, s, e, dmg(s, sk.mult), true, positions[i], hits, { pierce = true })
				ctx.sendHits(player, hits)
			end
		end)
	end
end

-- 올라운더 · 시공 정지
casters.timestop = function(ctx, player, _st, s, sk, _root, _origin, _look)
	local untilT = os.clock() + sk.duration
	local models = {}
	for _, e in ipairs(ctx.alive(s)) do
		e.frozenUntil = untilT
		table.insert(models, e.model)
	end
	local data = base(ctx, s, "timestop")
	data.duration = sk.duration
	data.models = models
	ctx.push(player, "skill", data)
end

-- slot: 1(E) 또는 2(F)
function Skills.cast(ctx: any, player: Player, st: any, s: any, slot: number): boolean
	if not s.running or s.ulting then
		return false
	end
	local typeId = s.stats.weapon.typeId
	local list = Config.Skills[typeId]
	local sk = list and list[slot]
	if not sk then
		return false
	end
	local now = os.clock()
	if now < s.skillReadyAt[slot] then
		return false
	end
	local root = ctx.getRoot(player)
	if not root then
		return false
	end
	local fn = casters[sk.id]
	if not fn then
		return false
	end
	s.skillTier = Config.skillTier(s.stats.weapon.grade, typeId)
	local cd = st.noCooldown and 0.3 or sk.cd
	s.skillReadyAt[slot] = now + cd
	local origin = root.Position
	local look = flatUnit(root.CFrame.LookVector)
	local ok, err = pcall(fn, ctx, player, st, s, sk, root, origin, look)
	if not ok then
		warn("[Arena] 스킬 오류:", sk.id, err)
	end
	-- 대상이 없어 대기 시간을 되돌린 경우는 알리지 않는다
	if s.skillReadyAt[slot] > now then
		ctx.push(player, "cooldown", { slot = slot, duration = cd, tier = s.skillTier })
		return true
	end
	return false
end

return Skills
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="11">
        <Properties>
          <string name="Name">WorldBuilder</string>
          <string name="Source"><![CDATA[-- WorldBuilder (ModuleScript, ArenaServer 아래)
-- 조명, 로비 광장, 투기장을 만든다. 맵은 전부 코드로 짓는다.

local Lighting = game:GetService("Lighting")
local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage:WaitForChild("GameConfig"))
local WeaponBuilder = require(ReplicatedStorage:WaitForChild("WeaponBuilder"))
local GradeStyle = require(ReplicatedStorage:WaitForChild("GradeStyle"))

local World = {}

local MARBLE = Color3.fromRGB(236, 230, 218)
local MARBLE_DARK = Color3.fromRGB(205, 195, 180)
local GOLD = Color3.fromRGB(222, 178, 72)
local STONE = Color3.fromRGB(92, 82, 76)
local CRIMSON = Color3.fromRGB(150, 35, 40)
local FIRE = Color3.fromRGB(255, 150, 60)
local WOOD_COLOR = Color3.fromRGB(95, 65, 40)

local function part(props: { [string]: any }): Part
	local p = Instance.new("Part")
	p.Anchored = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	local parent = props.Parent
	for k, v in pairs(props) do
		if k ~= "Parent" then
			(p :: any)[k] = v
		end
	end
	p.Parent = parent
	return p
end
World.part = part

-- 세로로 선 원기둥 (로블록스 원기둥은 X축이 길이라 돌려서 세운다)
local function pillar(parent: Instance, center: Vector3, height: number, diameter: number, color: Color3, material: Enum.Material): Part
	return part({
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(height, diameter, diameter),
		CFrame = CFrame.new(center) * CFrame.Angles(0, 0, math.rad(90)),
		Color = color,
		Material = material,
		Parent = parent,
	})
end

local function disc(parent: Instance, center: Vector3, thickness: number, diameter: number, color: Color3, material: Enum.Material): Part
	return pillar(parent, center, thickness, diameter, color, material)
end

local function torch(parent: Instance, pos: Vector3, size: number, range: number): (Part, Fire)
	local bowl = disc(parent, pos, 0.8 * size, 2.6 * size, Color3.fromRGB(45, 40, 38), Enum.Material.Metal)
	bowl.Name = "Brazier"
	local fire = Instance.new("Fire")
	fire.Size = 5 * size
	fire.Heat = 9
	fire.Color = FIRE
	fire.SecondaryColor = Color3.fromRGB(255, 220, 120)
	fire.Parent = bowl
	local light = Instance.new("PointLight")
	light.Color = Color3.fromRGB(255, 170, 90)
	light.Range = range
	light.Brightness = 2.2
	light.Shadows = true
	light.Parent = bowl
	return bowl, fire
end

local function surfaceText(target: BasePart, face: Enum.NormalId, ppu: number): SurfaceGui
	local gui = Instance.new("SurfaceGui")
	gui.Face = face
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = ppu
	gui.LightInfluence = 0
	gui.Parent = target
	return gui
end

local function label(parent: Instance, text: string, pos: UDim2, size: UDim2, color: Color3, font: Enum.Font): TextLabel
	local l = Instance.new("TextLabel")
	l.BackgroundTransparency = 1
	l.Position = pos
	l.Size = size
	l.Font = font
	l.TextScaled = true
	l.TextColor3 = color
	l.TextStrokeTransparency = 0.4
	l.Text = text
	l.Parent = parent
	return l
end

------------------------------------------------------------------------
-- 조명: 노을빛, 네온이 번지게
------------------------------------------------------------------------
function World.setupLighting()
	pcall(function()
		Lighting.Technology = Enum.Technology.Future
	end)
	Lighting.ClockTime = 17.4
	Lighting.Brightness = 2.2
	Lighting.GlobalShadows = true
	Lighting.OutdoorAmbient = Color3.fromRGB(140, 120, 110)
	Lighting.Ambient = Color3.fromRGB(60, 50, 50)
	Lighting.EnvironmentDiffuseScale = 0.6
	Lighting.EnvironmentSpecularScale = 0.7

	local function ensure(className: string, name: string): any
		local existing = Lighting:FindFirstChild(name)
		if existing then
			return existing
		end
		local inst = Instance.new(className)
		inst.Name = name
		inst.Parent = Lighting
		return inst
	end
	local atmosphere = ensure("Atmosphere", "ArenaAtmosphere")
	atmosphere.Density = 0.3
	atmosphere.Offset = 0.15
	atmosphere.Color = Color3.fromRGB(255, 205, 170)
	atmosphere.Decay = Color3.fromRGB(120, 80, 95)
	atmosphere.Glare = 0.4
	atmosphere.Haze = 1.4

	local bloom = ensure("BloomEffect", "ArenaBloom")
	bloom.Intensity = 0.45
	bloom.Size = 24
	bloom.Threshold = 1.3

	local cc = ensure("ColorCorrectionEffect", "ArenaColor")
	cc.Saturation = 0.12
	cc.Contrast = 0.08
	cc.TintColor = Color3.fromRGB(255, 246, 236)

	local rays = ensure("SunRaysEffect", "ArenaSunRays")
	rays.Intensity = 0.06
	rays.Spread = 0.7
end

------------------------------------------------------------------------
-- 로비
------------------------------------------------------------------------
local hallRows: { TextLabel } = {}
local lobbyFolder: Folder? = nil

-- 클라이언트가 돌리고 흔드는 장식 (각자 화면에서 부드럽게 움직인다)
local function tagSpin(p: BasePart, axis: string, speed: number)
	p:SetAttribute("Axis", axis)
	p:SetAttribute("Speed", speed)
	CollectionService:AddTag(p, "ArenaSpin")
end

local function tagBob(p: BasePart, amp: number, speed: number)
	p:SetAttribute("Amp", amp)
	p:SetAttribute("BobSpeed", speed)
	p:SetAttribute("Phase", math.random() * math.pi * 2)
	CollectionService:AddTag(p, "ArenaBob")
end

local function prompt(parent: Instance, action: string, object: string, onUse: (Player) -> ())
	local pp = Instance.new("ProximityPrompt")
	pp.ActionText = action
	pp.ObjectText = object
	pp.HoldDuration = 0
	pp.MaxActivationDistance = 14
	pp.RequiresLineOfSight = false
	pp.Parent = parent
	pp.Triggered:Connect(onUse)
end

-- 톱니바퀴: 가운데 원판(고정) + 둘레 톱니(용접). 원판을 돌리면 톱니도 같이 돈다
local function gear(parent: Instance, cf: CFrame, diameter: number, color: Color3, speed: number, name: string)
	local center = part({
		Name = name,
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.7, diameter, diameter),
		CFrame = cf,
		Color = color,
		Material = Enum.Material.Metal,
		Parent = parent,
	})
	part({
		Name = name .. "Hub",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.9, diameter * 0.3, diameter * 0.3),
		CFrame = cf,
		Color = GOLD,
		Material = Enum.Material.Metal,
		Anchored = false,
		Massless = true,
		CanCollide = false,
		Parent = parent,
	})
	local teeth = 12
	for i = 0, teeth - 1 do
		local a = (i / teeth) * math.pi * 2
		local r = diameter / 2 + 0.3
		local tooth = part({
			Name = name .. "Tooth",
			Size = Vector3.new(0.7, 0.7, 0.9),
			CFrame = cf * CFrame.Angles(a, 0, 0) * CFrame.new(0, r, 0),
			Color = color,
			Material = Enum.Material.Metal,
			Anchored = false,
			Massless = true,
			CanCollide = false,
			Parent = parent,
		})
		local w = Instance.new("WeldConstraint")
		w.Part0 = center
		w.Part1 = tooth
		w.Parent = tooth
	end
	for _, child in ipairs(parent:GetChildren()) do
		if child.Name == name .. "Hub" and child:IsA("BasePart") and not child:FindFirstChildOfClass("WeldConstraint") then
			local w = Instance.new("WeldConstraint")
			w.Part0 = center
			w.Part1 = child
			w.Parent = child
		end
	end
	tagSpin(center, "X", speed)
	return center
end

-- 합성 용광로: 불을 뿜는 화로, 돌아가는 톱니, 빛나는 약물 탱크, 모루
local function buildForge(lobby: Instance, onUse: (Player) -> ())
	local model = Instance.new("Model")
	model.Name = "Forge"
	model.Parent = lobby
	local base = Vector3.new(28, 0, 12)
	local cf = CFrame.lookAt(base, Vector3.new(0, 0, 0))
	local IRON = Color3.fromRGB(58, 52, 52)
	local COPPER = Color3.fromRGB(190, 110, 60)

	part({ Name = "Platform", Size = Vector3.new(20, 1, 17), CFrame = cf * CFrame.new(0, 0.5, 0), Color = Color3.fromRGB(60, 55, 52), Material = Enum.Material.Slate, Parent = model })
	part({ Name = "PlatformTrim", Size = Vector3.new(20.4, 0.3, 17.4), CFrame = cf * CFrame.new(0, 0.9, 0), Color = GOLD, Material = Enum.Material.Metal, Parent = model })

	-- 화로 몸통
	pillar(model, (cf * CFrame.new(0, 6, 2.5)).Position, 10, 9, IRON, Enum.Material.Metal)
	for _, y in ipairs({ 2.6, 9.2 }) do
		pillar(model, (cf * CFrame.new(0, y, 2.5)).Position, 0.6, 9.5, GOLD, Enum.Material.Metal)
	end
	local lava = disc(model, (cf * CFrame.new(0, 11.05, 2.5)).Position, 0.2, 7.4, Color3.fromRGB(255, 120, 30), Enum.Material.Neon)
	lava.Name = "ForgeLava"
	local lavaFire = Instance.new("Fire")
	lavaFire.Size = 7
	lavaFire.Heat = 12
	lavaFire.Color = Color3.fromRGB(255, 120, 30)
	lavaFire.SecondaryColor = Color3.fromRGB(255, 220, 90)
	lavaFire.Parent = lava

	-- 화구: 앞쪽으로 붉게 열린 입
	local mouth = part({
		Name = "ForgeMouth",
		Size = Vector3.new(4.4, 3.4, 0.6),
		CFrame = cf * CFrame.new(0, 4.2, -2.1),
		Color = Color3.fromRGB(255, 110, 25),
		Material = Enum.Material.Neon,
		Parent = model,
	})
	part({ Name = "MouthFrame", Size = Vector3.new(5.4, 0.5, 0.8), CFrame = cf * CFrame.new(0, 6.1, -2.1), Color = GOLD, Material = Enum.Material.Metal, Parent = model })
	local glow = Instance.new("PointLight")
	glow.Name = "ForgeGlow"
	glow.Color = Color3.fromRGB(255, 140, 50)
	glow.Range = 26
	glow.Brightness = 3
	glow.Shadows = true
	glow.Parent = mouth
	local embers = Instance.new("ParticleEmitter")
	embers.Name = "Embers"
	embers.Rate = 14
	embers.Lifetime = NumberRange.new(1, 2)
	embers.Speed = NumberRange.new(3, 6)
	embers.EmissionDirection = Enum.NormalId.Front
	embers.SpreadAngle = Vector2.new(35, 35)
	embers.Acceleration = Vector3.new(0, 4, 0)
	embers.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.3), NumberSequenceKeypoint.new(1, 0) })
	embers.LightEmission = 1
	embers.Color = ColorSequence.new(Color3.fromRGB(255, 220, 100), Color3.fromRGB(255, 80, 30))
	embers.Parent = mouth

	-- 굴뚝과 연기
	pillar(model, (cf * CFrame.new(2.2, 14.5, 4)).Position, 7, 2.4, IRON, Enum.Material.Metal)
	local chimneyTop = pillar(model, (cf * CFrame.new(2.2, 18.1, 4)).Position, 0.4, 2.9, GOLD, Enum.Material.Metal)
	local smoke = Instance.new("Smoke")
	smoke.Color = Color3.fromRGB(90, 80, 80)
	smoke.Opacity = 0.15
	smoke.RiseVelocity = 6
	smoke.Size = 3
	smoke.Parent = chimneyTop

	-- 톱니바퀴 둘
	gear(model, cf * CFrame.new(5.6, 6.2, 2.5), 6, Color3.fromRGB(150, 120, 70), 0.9, "GearBig")
	gear(model, cf * CFrame.new(5.6, 10.6, -0.6), 3.6, COPPER, -1.6, "GearSmall")

	-- 빛나는 약물 탱크와 관
	local tankPos = (cf * CFrame.new(-6.4, 4.6, 2)).Position
	local liquid = pillar(model, tankPos - Vector3.new(0, 0.6, 0), 5.4, 2.8, Color3.fromRGB(170, 90, 255), Enum.Material.Neon)
	liquid.Name = "ForgeLiquid"
	local glass = pillar(model, tankPos, 7.2, 3.4, Color3.fromRGB(200, 230, 255), Enum.Material.Glass)
	glass.Transparency = 0.55
	glass.Name = "ForgeTank"
	pillar(model, tankPos + Vector3.new(0, 3.8, 0), 0.5, 3.8, GOLD, Enum.Material.Metal)
	pillar(model, tankPos - Vector3.new(0, 3.8, 0), 0.5, 3.8, GOLD, Enum.Material.Metal)
	local bubbles = Instance.new("ParticleEmitter")
	bubbles.Rate = 6
	bubbles.Lifetime = NumberRange.new(1.2, 2)
	bubbles.Speed = NumberRange.new(1.5, 2.5)
	bubbles.EmissionDirection = Enum.NormalId.Top
	bubbles.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.25), NumberSequenceKeypoint.new(1, 0.1) })
	bubbles.LightEmission = 0.8
	bubbles.Color = ColorSequence.new(Color3.fromRGB(230, 200, 255))
	bubbles.Parent = liquid
	local tankLight = Instance.new("PointLight")
	tankLight.Color = Color3.fromRGB(170, 90, 255)
	tankLight.Range = 12
	tankLight.Brightness = 1.5
	tankLight.Parent = liquid
	part({
		Name = "Pipe",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(3.4, 0.8, 0.8),
		CFrame = cf * CFrame.new(-3.4, 7.6, 2),
		Color = COPPER,
		Material = Enum.Material.Metal,
		Parent = model,
	})

	-- 모루와 바닥 마법진
	local anvilPos = cf * CFrame.new(0, 0, -6.2)
	part({ Name = "AnvilBase", Size = Vector3.new(1.6, 1.8, 1.6), CFrame = anvilPos * CFrame.new(0, 1.9, 0), Color = IRON, Material = Enum.Material.Metal, Parent = model })
	local anvil = part({ Name = "ForgeAnvil", Size = Vector3.new(3.8, 0.9, 1.7), CFrame = anvilPos * CFrame.new(0, 3.2, 0), Color = Color3.fromRGB(75, 75, 82), Material = Enum.Material.Metal, Parent = model })
	part({ Name = "AnvilHorn", Size = Vector3.new(1.2, 0.5, 0.5), CFrame = anvilPos * CFrame.new(2.4, 3.35, 0), Color = Color3.fromRGB(75, 75, 82), Material = Enum.Material.Metal, Parent = model })
	local ring = disc(model, (anvilPos * CFrame.new(0, 1.05, 0)).Position, 0.06, 7, GOLD, Enum.Material.Neon)
	ring.Name = "ForgeRing"
	ring.Transparency = 0.4
	ring.CanCollide = false
	prompt(anvil, "합성하기", "합성 용광로", onUse)

	-- 간판
	local sign = part({ Name = "ForgeSign", Size = Vector3.new(9, 1.8, 0.3), CFrame = cf * CFrame.new(0, 8.2, -2.4), Color = Color3.fromRGB(45, 30, 22), Material = Enum.Material.Wood, Parent = model })
	local gui = surfaceText(sign, Enum.NormalId.Front, 40)
	label(gui, "🔨 합성 용광로", UDim2.fromScale(0, 0.05), UDim2.fromScale(1, 0.9), Color3.fromRGB(255, 200, 90), Enum.Font.GothamBlack)
end

-- 무기 전시대: 등급이 다른 무기 10자루가 받침대 위에서 떠서 돈다. 속성이 모두 다르게 골랐다
local function buildShowcase(lobby: Instance)
	local model = Instance.new("Model")
	model.Name = "Showcase"
	model.Parent = lobby
	local types = { 1, 2, 3, 4, 5, 1, 2, 3, 4, 0 }
	local grades = { 8, 19, 27, 36, 45, 53, 64, 72, 81, 100 }
	for i = 1, 10 do
		local grade = grades[i]
		local style = GradeStyle.get(grade)
		local a = math.rad(48 + (i - 1) * 9.33)
		local pos = Vector3.new(math.cos(a) * 33, 0, math.sin(a) * 33)
		local face = CFrame.lookAt(pos, Vector3.new(0, 0, 0))
		pillar(model, pos + Vector3.new(0, 0.8, 0), 0.7, 3.6, GOLD, Enum.Material.Metal)
		local column = part({ Name = "ShowColumn", Size = Vector3.new(2.4, 3.4, 2.4), CFrame = face * CFrame.new(0, 2.85, 0), Color = MARBLE, Material = Enum.Material.Marble, Parent = model })
		local top = disc(model, pos + Vector3.new(0, 4.62, 0), 0.15, 2.8, style.glow, Enum.Material.Neon)
		local light = Instance.new("PointLight")
		light.Color = style.glow
		light.Range = 8 + i
		light.Brightness = 1 + i * 0.15
		light.Parent = top
		local sparkle = Instance.new("ParticleEmitter")
		sparkle.Texture = style.motif.tex
		sparkle.Rate = 3 + i * 1.5
		sparkle.Lifetime = NumberRange.new(1, 2)
		sparkle.Speed = NumberRange.new(1, 2.5)
		sparkle.EmissionDirection = Enum.NormalId.Right
		sparkle.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.2 + i * 0.03), NumberSequenceKeypoint.new(1, 0) })
		sparkle.LightEmission = 1
		sparkle.Color = GradeStyle.gradient(grade)
		sparkle.Parent = top

		local anchor = part({
			Name = "ShowAnchor",
			Size = Vector3.new(0.4, 0.4, 0.4),
			CFrame = CFrame.new(pos + Vector3.new(0, 6.6, 0)),
			Transparency = 1,
			CanCollide = false,
			Parent = model,
		})
		WeaponBuilder.build(model, anchor, types[i], {
			grade = grade,
			accent = Color3.fromRGB(255, 170, 40),
			rarity = 5,
			scale = 0.7,
		}, CFrame.new(anchor.Position - Vector3.new(0, 2.6, 0)))
		tagSpin(anchor, "Y", 0.7)
		tagBob(anchor, 0.35, 1.4)

		local gui = surfaceText(column, Enum.NormalId.Front, 50)
		label(gui, string.format("%d등급", grade), UDim2.fromScale(0, 0.06), UDim2.fromScale(1, 0.28), GradeStyle.textColor(grade), Enum.Font.GothamBlack)
		label(gui, Config.getGrade(grade).en, UDim2.fromScale(0.04, 0.4), UDim2.fromScale(0.92, 0.22), Color3.fromRGB(70, 55, 40), Enum.Font.GothamBold)
		label(gui, style.motif.name .. " · " .. style.materialName, UDim2.fromScale(0.04, 0.68), UDim2.fromScale(0.92, 0.18), Color3.fromRGB(110, 95, 80), Enum.Font.GothamBold)
	end
end

-- 훈련장: 허수아비 세 개와 무기 걸이
local function buildTrainingYard(lobby: Instance, onUse: (Player) -> ())
	local model = Instance.new("Model")
	model.Name = "TrainingYard"
	model.Parent = lobby
	local center = Vector3.new(-28, 0, 12)
	local cf = CFrame.lookAt(center, Vector3.new(0, 0, 0))
	disc(model, center + Vector3.new(0, 0.48, 0), 0.1, 18, Color3.fromRGB(205, 175, 120), Enum.Material.Sand)
	disc(model, center + Vector3.new(0, 0.46, 0), 0.1, 19, Color3.fromRGB(120, 85, 50), Enum.Material.Wood)
	local STRAW = Color3.fromRGB(214, 180, 105)
	local mainDummy: BasePart? = nil
	for i, x in ipairs({ -5, 0, 5 }) do
		local d = cf * CFrame.new(x, 0, (i == 2) and -1.5 or 0)
		pillar(model, (d * CFrame.new(0, 3.3, 0)).Position, 6, 0.6, WOOD_COLOR, Enum.Material.Wood)
		local body = part({ Name = "DummyBody", Size = Vector3.new(2.2, 2.6, 1.3), CFrame = d * CFrame.new(0, 4.3, 0), Color = STRAW, Material = Enum.Material.Fabric, Parent = model })
		part({ Name = "DummyHead", Shape = Enum.PartType.Ball, Size = Vector3.new(1.7, 1.7, 1.7), CFrame = d * CFrame.new(0, 6.4, 0), Color = STRAW, Material = Enum.Material.Fabric, Parent = model })
		part({ Name = "DummyArms", Size = Vector3.new(4.4, 0.5, 0.5), CFrame = d * CFrame.new(0, 5, 0), Color = WOOD_COLOR, Material = Enum.Material.Wood, Parent = model })
		part({
			Name = "DummyTarget",
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(0.1, 1.2, 1.2),
			CFrame = d * CFrame.new(0, 4.5, -0.7) * CFrame.Angles(0, math.rad(90), 0),
			Color = Color3.fromRGB(220, 50, 40),
			Material = Enum.Material.Neon,
			Parent = model,
		})
		for _, y in ipairs({ 3.5, 5.1 }) do
			part({ Name = "Rope", Size = Vector3.new(2.3, 0.15, 1.4), CFrame = d * CFrame.new(0, y, 0), Color = Color3.fromRGB(120, 85, 50), Material = Enum.Material.Fabric, Parent = model })
		end
		if i == 2 then
			mainDummy = body
		end
	end
	-- 무기 걸이
	local rack = cf * CFrame.new(0, 0, 6.5)
	for _, x in ipairs({ -3.5, 3.5 }) do
		part({ Name = "RackPost", Size = Vector3.new(0.5, 4, 0.5), CFrame = rack * CFrame.new(x, 2.5, 0), Color = WOOD_COLOR, Material = Enum.Material.Wood, Parent = model })
	end
	local bar = part({ Name = "RackBar", Size = Vector3.new(7.6, 0.4, 0.4), CFrame = rack * CFrame.new(0, 4.3, 0), Color = WOOD_COLOR, Material = Enum.Material.Wood, Parent = model })
	for i, t in ipairs({ 1, 3, 5 }) do
		local holder = part({
			Name = "RackHook",
			Size = Vector3.new(0.3, 0.3, 0.3),
			CFrame = rack * CFrame.new(-2.4 + (i - 1) * 2.4, 4.3, -0.4),
			Transparency = 1,
			CanCollide = false,
			Parent = model,
		})
		WeaponBuilder.build(model, holder, t, { grade = 1 + i * 2, accent = Color3.fromRGB(190, 190, 190), rarity = 1, scale = 0.6, lite = true }, holder.CFrame * CFrame.Angles(math.rad(180), 0, 0))
	end
	local _ = bar
	local sign = part({ Name = "TrainSign", Size = Vector3.new(7, 1.6, 0.3), CFrame = cf * CFrame.new(0, 8.6, 1), Color = Color3.fromRGB(45, 30, 22), Material = Enum.Material.Wood, Parent = model })
	part({ Name = "SignPost", Size = Vector3.new(0.4, 8.4, 0.4), CFrame = cf * CFrame.new(0, 4.2, 1.3), Color = WOOD_COLOR, Material = Enum.Material.Wood, Parent = model })
	local gui = surfaceText(sign, Enum.NormalId.Front, 40)
	label(gui, "💪 훈련장", UDim2.fromScale(0, 0.05), UDim2.fromScale(1, 0.9), Color3.fromRGB(255, 220, 140), Enum.Font.GothamBlack)
	if mainDummy then
		prompt(mainDummy, "훈련하기", "훈련장", onUse)
	end
end

-- 반딧불과 떠다니는 등불
local function buildAmbient(lobby: Instance)
	local area = part({
		Name = "Fireflies",
		Size = Vector3.new(90, 8, 90),
		Position = Vector3.new(0, 7, 0),
		Transparency = 1,
		CanCollide = false,
		CanQuery = false,
		CanTouch = false,
		Parent = lobby,
	})
	local flies = Instance.new("ParticleEmitter")
	flies.Rate = 22
	flies.Lifetime = NumberRange.new(4, 7)
	flies.Speed = NumberRange.new(0.2, 0.8)
	flies.SpreadAngle = Vector2.new(180, 180)
	flies.Size = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0),
		NumberSequenceKeypoint.new(0.2, 0.22),
		NumberSequenceKeypoint.new(0.8, 0.22),
		NumberSequenceKeypoint.new(1, 0),
	})
	flies.LightEmission = 1
	flies.Color = ColorSequence.new(Color3.fromRGB(255, 225, 140))
	flies.Parent = area

	for i = 1, 10 do
		local a = (i / 10) * math.pi * 2 + 0.3
		local r = 22 + (i % 3) * 6
		local lantern = part({
			Name = "Lantern",
			Size = Vector3.new(1.3, 1.7, 1.3),
			Position = Vector3.new(math.cos(a) * r, 15 + (i % 4) * 2, math.sin(a) * r),
			Color = Color3.fromRGB(255, 190, 110),
			Material = Enum.Material.Neon,
			CanCollide = false,
			Parent = lobby,
		})
		local cap = part({
			Name = "LanternCap",
			Size = Vector3.new(1.6, 0.3, 1.6),
			CFrame = lantern.CFrame * CFrame.new(0, 1, 0),
			Color = Color3.fromRGB(120, 40, 35),
			Material = Enum.Material.Fabric,
			Anchored = false,
			Massless = true,
			CanCollide = false,
			Parent = lobby,
		})
		local w = Instance.new("WeldConstraint")
		w.Part0 = lantern
		w.Part1 = cap
		w.Parent = cap
		local light = Instance.new("PointLight")
		light.Color = Color3.fromRGB(255, 180, 100)
		light.Range = 12
		light.Brightness = 1.2
		light.Parent = lantern
		tagBob(lantern, 0.8, 0.6 + (i % 3) * 0.2)
	end
end

-- 아우라 제단: 떠 있는 수정 둘레를 고리 세 겹이 돌고, 아우라·킬 이펙트 상점을 연다
local function buildShrine(lobby: Instance, onUse: (Player) -> ())
	local model = Instance.new("Model")
	model.Name = "AuraShrine"
	model.Parent = lobby
	local center = Vector3.new(0, 0, 17)
	disc(model, center + Vector3.new(0, 0.5, 0), 0.4, 9, GOLD, Enum.Material.Metal)
	disc(model, center + Vector3.new(0, 0.75, 0), 0.4, 7.6, Color3.fromRGB(40, 30, 60), Enum.Material.Slate)
	local rune = disc(model, center + Vector3.new(0, 0.97, 0), 0.05, 6.4, Color3.fromRGB(170, 110, 255), Enum.Material.Neon)
	rune.CanCollide = false
	for i = 0, 5 do
		local a = (i / 6) * math.pi * 2
		local pos = center + Vector3.new(math.cos(a) * 4.1, 0, math.sin(a) * 4.1)
		pillar(model, pos + Vector3.new(0, 2.2, 0), 3.4, 0.7, MARBLE, Enum.Material.Marble)
		local orb = part({
			Name = "ShrineOrb",
			Shape = Enum.PartType.Ball,
			Size = Vector3.new(0.9, 0.9, 0.9),
			Position = pos + Vector3.new(0, 4.4, 0),
			Color = Color3.fromHSV(i / 6, 0.6, 1),
			Material = Enum.Material.Neon,
			CanCollide = false,
			Parent = model,
		})
		tagBob(orb, 0.3, 1.6)
	end
	local crystal = part({
		Name = "ShrineCrystal",
		Size = Vector3.new(1.8, 3.6, 1.8),
		CFrame = CFrame.new(center + Vector3.new(0, 5.2, 0)) * CFrame.Angles(0, 0, math.rad(45)) * CFrame.Angles(math.rad(45), 0, 0),
		Color = Color3.fromRGB(190, 140, 255),
		Material = Enum.Material.Glass,
		Transparency = 0.15,
		CanCollide = false,
		Parent = model,
	})
	tagSpin(crystal, "Y", 0.8)
	tagBob(crystal, 0.5, 1.2)
	local light = Instance.new("PointLight")
	light.Color = Color3.fromRGB(190, 140, 255)
	light.Range = 18
	light.Brightness = 2
	light.Parent = crystal
	local pe = Instance.new("ParticleEmitter")
	pe.Rate = 18
	pe.Lifetime = NumberRange.new(1.5, 2.5)
	pe.Speed = NumberRange.new(1, 3)
	pe.SpreadAngle = Vector2.new(180, 180)
	pe.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.3), NumberSequenceKeypoint.new(1, 0) })
	pe.LightEmission = 1
	pe.Color = GradeStyle.RAINBOW
	pe.Parent = crystal
	for r = 1, 3 do
		local ringPart = part({
			Name = "ShrineRing",
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(0.12, 3 + r * 1.3, 3 + r * 1.3),
			CFrame = CFrame.new(center + Vector3.new(0, 5.2, 0)) * CFrame.Angles(math.rad(r * 50), 0, math.rad(90)),
			Color = (r % 2 == 0) and GOLD or Color3.fromRGB(170, 110, 255),
			Material = Enum.Material.ForceField,
			CanCollide = false,
			Parent = model,
		})
		tagSpin(ringPart, r == 2 and "X" or "Y", 0.6 + r * 0.3)
	end
	local sign = part({ Name = "ShrineSign", Size = Vector3.new(6, 1.3, 0.3), CFrame = CFrame.lookAt(center + Vector3.new(0, 1.9, -4.9), center + Vector3.new(0, 1.9, -20)), Color = Color3.fromRGB(40, 30, 60), Material = Enum.Material.Slate, Parent = model })
	local gui = surfaceText(sign, Enum.NormalId.Front, 40)
	label(gui, "✨ 아우라 제단", UDim2.fromScale(0, 0.05), UDim2.fromScale(1, 0.9), Color3.fromRGB(220, 190, 255), Enum.Font.GothamBlack)
	prompt(rune, "치장 상점", "아우라 · 킬 이펙트", onUse)
end

function World.buildLobby(handlers: { [string]: (Player) -> () }): CFrame
	local folder = Instance.new("Folder")
	folder.Name = "Lobby"
	folder.Parent = workspace
	lobbyFolder = folder

	-- 바닥 (Baseplate가 없을 때만)
	if not workspace:FindFirstChild("Baseplate") then
		part({
			Name = "Baseplate",
			Size = Vector3.new(500, 2, 500),
			Position = Vector3.new(0, -1, 0),
			Color = Color3.fromRGB(86, 118, 70),
			Material = Enum.Material.Grass,
			Parent = workspace,
		})
	end

	-- 원형 대리석 광장과 금테
	disc(folder, Vector3.new(0, 0, 0), 0.6, 98, GOLD, Enum.Material.Metal)
	disc(folder, Vector3.new(0, 0.05, 0), 0.8, 94, MARBLE, Enum.Material.Marble)
	disc(folder, Vector3.new(0, 0.46, 0), 0.04, 32, CRIMSON, Enum.Material.Slate)
	disc(folder, Vector3.new(0, 0.48, 0), 0.04, 28, MARBLE_DARK, Enum.Material.Marble)
	for i = 0, 7 do
		local a = (i / 8) * math.pi * 2
		local dir = Vector3.new(math.cos(a), 0, math.sin(a))
		local mid = dir * 30 + Vector3.new(0, 0.47, 0)
		part({
			Name = "Spoke",
			Size = Vector3.new(0.6, 0.04, 28),
			CFrame = CFrame.lookAt(mid, mid + dir),
			Color = GOLD,
			Material = Enum.Material.Metal,
			Parent = folder,
		})
	end

	-- 시작 지점
	local spawn = workspace:FindFirstChildWhichIsA("SpawnLocation", true)
	if not spawn then
		local sp = Instance.new("SpawnLocation")
		sp.Name = "LobbySpawn"
		sp.Anchored = true
		sp.Size = Vector3.new(14, 1, 14)
		sp.Position = Vector3.new(0, 0.5, 0)
		sp.Neutral = true
		sp.Duration = 0
		sp.Parent = workspace
		spawn = sp
	end
	if spawn then
		spawn.Color = GOLD
		spawn.Material = Enum.Material.Marble
		local decal = spawn:FindFirstChildOfClass("Decal")
		if decal then
			decal:Destroy()
		end
	end

	-- 기둥 12개: 짝수는 횃불, 홀수는 구간 깃발
	local sectionIndex = 0
	for i = 0, 11 do
		local deg = 15 + i * 30
		local a = math.rad(deg)
		local dir = Vector3.new(math.cos(a), 0, math.sin(a))
		local base = dir * 42
		part({
			Name = "ColumnBase",
			Size = Vector3.new(4.6, 1.2, 4.6),
			Position = base + Vector3.new(0, 1.05, 0),
			Color = MARBLE_DARK,
			Material = Enum.Material.Marble,
			Parent = folder,
		})
		pillar(folder, base + Vector3.new(0, 1.65 + 9, 0), 18, 2.8, MARBLE, Enum.Material.Marble)
		part({
			Name = "ColumnCap",
			Size = Vector3.new(4.6, 1.2, 4.6),
			Position = base + Vector3.new(0, 1.65 + 18 + 0.6, 0),
			Color = GOLD,
			Material = Enum.Material.Metal,
			Parent = folder,
		})
		if i % 2 == 0 then
			torch(folder, base + Vector3.new(0, 21.33, 0), 1.2, 26)
		else
			sectionIndex += 1
			local section = Config.Sections[sectionIndex]
			if section then
				local inward = -dir
				local bannerPos = base + inward * 1.7 + Vector3.new(0, 12.5, 0)
				local banner = part({
					Name = "SectionBanner",
					Size = Vector3.new(4.2, 11, 0.2),
					CFrame = CFrame.lookAt(bannerPos, bannerPos + inward),
					Color = section.color:Lerp(Color3.new(0, 0, 0), 0.3),
					Material = Enum.Material.Fabric,
					CanCollide = false,
					Parent = folder,
				})
				part({
					Name = "BannerRod",
					Size = Vector3.new(5.2, 0.3, 0.3),
					CFrame = banner.CFrame * CFrame.new(0, 5.6, 0),
					Color = GOLD,
					Material = Enum.Material.Metal,
					Parent = folder,
				})
				local gui = surfaceText(banner, Enum.NormalId.Front, 40)
				label(gui, tostring(sectionIndex), UDim2.new(0, 0, 0.06, 0), UDim2.new(1, 0, 0.22, 0), GOLD, Enum.Font.GothamBlack)
				label(gui, section.name, UDim2.new(0.05, 0, 0.34, 0), UDim2.new(0.9, 0, 0.16, 0), Color3.new(1, 1, 1), Enum.Font.GothamBlack)
				label(
					gui,
					string.format("%d ~ %d", section.from, section.to),
					UDim2.new(0.1, 0, 0.56, 0),
					UDim2.new(0.8, 0, 0.1, 0),
					Color3.fromRGB(240, 230, 210),
					Enum.Font.GothamBold
				)
				label(
					gui,
					Config.getGrade(section.to).en,
					UDim2.new(0.05, 0, 0.74, 0),
					UDim2.new(0.9, 0, 0.12, 0),
					section.color:Lerp(Color3.new(1, 1, 1), 0.5),
					Enum.Font.GothamBold
				)
			end
		end
	end

	-- 투기장 입구 문
	local gateZ = -56
	for _, x in ipairs({ -15, 15 }) do
		part({
			Name = "GatePillar",
			Size = Vector3.new(6, 30, 6),
			Position = Vector3.new(x, 15, gateZ),
			Color = STONE,
			Material = Enum.Material.Slate,
			Parent = folder,
		})
		part({
			Name = "GatePillarTrim",
			Size = Vector3.new(6.4, 1, 6.4),
			Position = Vector3.new(x, 1, gateZ),
			Color = GOLD,
			Material = Enum.Material.Metal,
			Parent = folder,
		})
		torch(folder, Vector3.new(x, 37.7, gateZ), 1.5, 34)
	end
	local beam = part({
		Name = "GateBeam",
		Size = Vector3.new(38, 7, 7),
		Position = Vector3.new(0, 33.5, gateZ),
		Color = STONE,
		Material = Enum.Material.Slate,
		Parent = folder,
	})
	for _, y in ipairs({ 30.2, 36.8 }) do
		part({
			Name = "GateTrim",
			Size = Vector3.new(38.2, 0.5, 7.2),
			Position = Vector3.new(0, y, gateZ),
			Color = GOLD,
			Material = Enum.Material.Neon,
			Parent = folder,
		})
	end
	local signGui = surfaceText(beam, Enum.NormalId.Back, 24)
	label(signGui, Config.GAME_TITLE, UDim2.new(0, 0, 0.08, 0), UDim2.new(1, 0, 0.62, 0), Color3.fromRGB(255, 205, 80), Enum.Font.GothamBlack)
	label(signGui, "투기장 입구", UDim2.new(0, 0, 0.7, 0), UDim2.new(1, 0, 0.24, 0), Color3.fromRGB(245, 235, 215), Enum.Font.GothamBold)

	local portal = part({
		Name = "GatePortal",
		Size = Vector3.new(24, 29, 0.4),
		Position = Vector3.new(0, 15, gateZ),
		Color = Color3.fromRGB(255, 90, 50),
		Material = Enum.Material.Neon,
		Transparency = 0.7,
		CanCollide = false,
		Parent = folder,
	})
	local embers = Instance.new("ParticleEmitter")
	embers.Rate = 30
	embers.Lifetime = NumberRange.new(2, 3.5)
	embers.Speed = NumberRange.new(2, 4)
	embers.EmissionDirection = Enum.NormalId.Top
	embers.SpreadAngle = Vector2.new(20, 20)
	embers.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.35), NumberSequenceKeypoint.new(1, 0) })
	embers.LightEmission = 1
	embers.Color = ColorSequence.new(Color3.fromRGB(255, 200, 90), Color3.fromRGB(255, 80, 40))
	embers.Parent = portal
	local gatePrompt = Instance.new("ProximityPrompt")
	gatePrompt.ActionText = "투기장 입장"
	gatePrompt.ObjectText = Config.GAME_TITLE
	gatePrompt.HoldDuration = 0
	gatePrompt.MaxActivationDistance = 20
	gatePrompt.RequiresLineOfSight = false
	gatePrompt.Parent = portal
	gatePrompt.Triggered:Connect(handlers.gate)

	-- 광장에서 문까지 붉은 융단
	part({
		Name = "Carpet",
		Size = Vector3.new(10, 0.1, 13),
		Position = Vector3.new(0, 0.5, -49.5),
		Color = CRIMSON,
		Material = Enum.Material.Fabric,
		Parent = folder,
	})

	-- 명예의 전당 게시판
	local boardPos = Vector3.new(24, 0, -16)
	local boardCf = CFrame.lookAt(boardPos + Vector3.new(0, 8, 0), Vector3.new(0, 8, 0))
	for _, x in ipairs({ -7.6, 7.6 }) do
		part({
			Name = "BoardPost",
			Size = Vector3.new(0.9, 14, 0.9),
			CFrame = boardCf * CFrame.new(x, -1, 0.2),
			Color = Color3.fromRGB(60, 42, 30),
			Material = Enum.Material.Wood,
			Parent = folder,
		})
	end
	local board = part({
		Name = "HallOfFame",
		Size = Vector3.new(15, 10, 0.6),
		CFrame = boardCf,
		Color = Color3.fromRGB(35, 26, 22),
		Material = Enum.Material.Wood,
		Parent = folder,
	})
	for _, spec in ipairs({
		{ Vector3.new(15.6, 0.4, 0.8), CFrame.new(0, 5.1, 0) },
		{ Vector3.new(15.6, 0.4, 0.8), CFrame.new(0, -5.1, 0) },
		{ Vector3.new(0.4, 10.6, 0.8), CFrame.new(7.6, 0, 0) },
		{ Vector3.new(0.4, 10.6, 0.8), CFrame.new(-7.6, 0, 0) },
	}) do
		part({
			Name = "BoardFrame",
			Size = spec[1],
			CFrame = boardCf * spec[2],
			Color = GOLD,
			Material = Enum.Material.Neon,
			Parent = folder,
		})
	end
	local hallGui = surfaceText(board, Enum.NormalId.Front, 40)
	label(hallGui, "🏆 명예의 전당", UDim2.new(0, 0, 0.03, 0), UDim2.new(1, 0, 0.17, 0), GOLD, Enum.Font.GothamBlack)
	label(hallGui, "이 서버 최고 기록", UDim2.new(0, 0, 0.2, 0), UDim2.new(1, 0, 0.07, 0), Color3.fromRGB(200, 185, 165), Enum.Font.GothamBold)
	hallRows = {}
	for i = 1, 5 do
		local row = label(
			hallGui,
			"",
			UDim2.new(0.06, 0, 0.29 + (i - 1) * 0.135, 0),
			UDim2.new(0.88, 0, 0.11, 0),
			Color3.fromRGB(240, 230, 210),
			Enum.Font.GothamBold
		)
		row.TextXAlignment = Enum.TextXAlignment.Left
		hallRows[i] = row
	end

	-- 동상 받침대 (동상은 buildStatue에서 올린다)
	local statueBase = Vector3.new(-24, 0, -16)
	part({ Name = "PedestalBase", Size = Vector3.new(10, 1.2, 10), Position = statueBase + Vector3.new(0, 1.05, 0), Color = GOLD, Material = Enum.Material.Metal, Parent = folder })
	local body = part({ Name = "Pedestal", Size = Vector3.new(8.5, 5, 8.5), Position = statueBase + Vector3.new(0, 4.15, 0), Color = MARBLE, Material = Enum.Material.Marble, Parent = folder })
	part({ Name = "PedestalTop", Size = Vector3.new(10, 0.8, 10), Position = statueBase + Vector3.new(0, 7.05, 0), Color = GOLD, Material = Enum.Material.Metal, Parent = folder })
	local plaque = surfaceText(body, Enum.NormalId.Right, 40)
	label(plaque, "CHAMPION", UDim2.new(0, 0, 0.2, 0), UDim2.new(1, 0, 0.3, 0), GOLD, Enum.Font.GothamBlack)
	label(plaque, "100등급의 끝에 선 자", UDim2.new(0, 0, 0.55, 0), UDim2.new(1, 0, 0.2, 0), Color3.fromRGB(80, 60, 40), Enum.Font.GothamBold)

	buildForge(folder, handlers.forge)
	buildShowcase(folder)
	buildTrainingYard(folder, handlers.train)
	buildShrine(folder, handlers.shrine)
	buildAmbient(folder)

	if spawn then
		return CFrame.new(spawn.Position + Vector3.new(0, 4, 0))
	end
	return CFrame.new(0, 4, 0)
end

-- 황금 검투사 동상. 인형을 못 만들면 받침대에 거대한 검만 꽂는다
function World.buildStatue(rig: Model?)
	local folder = lobbyFolder or workspace
	local basePos = Vector3.new(-24, 7.45, -16)
	local ok, err = pcall(function()
		if not rig then
			error("인형 없음")
		end
		local statue = (rig :: Model):Clone()
		statue.Name = "ChampionStatue"
		local hum = statue:FindFirstChildOfClass("Humanoid")
		if hum then
			hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
		end
		local root = statue:FindFirstChild("HumanoidRootPart")
		if not (root and root:IsA("BasePart")) then
			error("루트 없음")
		end
		statue:ScaleTo(3)
		for _, d in ipairs(statue:GetDescendants()) do
			if d:IsA("BasePart") then
				d.Anchored = (d == root)
			end
		end
		statue:PivotTo(CFrame.lookAt(basePos + Vector3.new(0, 10, 0), Vector3.new(0, basePos.Y + 10, 0)))
		statue.Parent = folder
		-- 칼 든 오른팔을 하늘로
		local upperArm = statue:FindFirstChild("RightUpperArm")
		local shoulder = upperArm and upperArm:FindFirstChild("RightShoulder")
		if shoulder and shoulder:IsA("Motor6D") then
			shoulder.C0 = shoulder.C0 * CFrame.Angles(math.rad(150), 0, 0)
		end
		task.wait(0.2)
		local bbCf, bbSize = statue:GetBoundingBox()
		local bottom = bbCf.Position.Y - bbSize.Y / 2
		statue:PivotTo(statue:GetPivot() + Vector3.new(0, basePos.Y - bottom, 0))
		for _, d in ipairs(statue:GetDescendants()) do
			if d:IsA("BasePart") then
				d.Anchored = true
				if d ~= root then
					d.Color = GOLD
					d.Material = Enum.Material.Metal
					d.Reflectance = 0.15
				end
			end
		end
		local hand = statue:FindFirstChild("RightHand")
		if hand and hand:IsA("BasePart") then
			local yaw = select(2, statue:GetPivot():ToEulerAnglesYXZ())
			local grip = CFrame.new(hand.Position) * CFrame.Angles(0, yaw, 0)
			WeaponBuilder.build(statue, hand, 0, { grade = 100, accent = GOLD, rarity = 5, scale = 1.6 }, grip)
		end
	end)
	if not ok then
		warn("[Arena] 동상 대신 검을 세웁니다:", err)
		local anchor = part({
			Name = "SwordAnchor",
			Size = Vector3.new(1, 1, 1),
			Position = basePos + Vector3.new(0, 0.5, 0),
			Transparency = 1,
			CanCollide = false,
			Parent = folder,
		})
		WeaponBuilder.build(folder, anchor, 1, { grade = 100, accent = GOLD, rarity = 5, scale = 2 }, CFrame.new(anchor.Position + Vector3.new(0, 4, 0)))
	end
end

function World.setHallOfFame(entries: { { name: string, stage: number } })
	for i, row in ipairs(hallRows) do
		local e = entries[i]
		if e then
			local medal = (i == 1 and "🥇") or (i == 2 and "🥈") or (i == 3 and "🥉") or ("  " .. i .. ".")
			row.Text = string.format("%s  %s  ·  [%d] %s", medal, e.name, e.stage, (Config.stageName(e.stage)))
			row.TextColor3 = Config.getSection(math.min(e.stage, Config.MAX_GRADE)).color:Lerp(Color3.new(1, 1, 1), 0.3)
		else
			row.Text = ""
		end
	end
end

------------------------------------------------------------------------
-- 투기장
------------------------------------------------------------------------
export type Arena = {
	center: Vector3,
	model: Model,
	trim: { BasePart },
	banners: { BasePart },
	fires: { Fire },
	ambient: ParticleEmitter?,
}

local CROWD_COLORS = {
	Color3.fromRGB(220, 80, 70),
	Color3.fromRGB(70, 130, 220),
	Color3.fromRGB(240, 200, 80),
	Color3.fromRGB(90, 190, 110),
	Color3.fromRGB(200, 120, 220),
	Color3.fromRGB(245, 245, 245),
}

function World.buildArena(center: Vector3, radius: number, name: string): Arena
	local model = Instance.new("Model")
	model.Name = name
	local arena: Arena = { center = center, model = model, trim = {}, banners = {}, fires = {}, ambient = nil }
	-- 투기장 하늘에 흩날리는 속성 입자 (스테이지마다 바뀐다)
	local sky = part({
		Name = "ArenaAmbient",
		Size = Vector3.new(radius * 2, 12, radius * 2),
		Position = center + Vector3.new(0, 14, 0),
		Transparency = 1,
		CanCollide = false,
		CanQuery = false,
		CanTouch = false,
		Parent = model,
	})
	local ambient = Instance.new("ParticleEmitter")
	ambient.Rate = 40
	ambient.Lifetime = NumberRange.new(3, 6)
	ambient.Speed = NumberRange.new(0.5, 2)
	ambient.SpreadAngle = Vector2.new(180, 180)
	ambient.Size = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0),
		NumberSequenceKeypoint.new(0.2, 0.5),
		NumberSequenceKeypoint.new(1, 0),
	})
	ambient.LightEmission = 1
	ambient.Parent = sky
	arena.ambient = ambient

	disc(model, center - Vector3.new(0, 2, 0), 4, radius * 2, Color3.fromRGB(212, 182, 128), Enum.Material.Sand)
	local ring = disc(model, center + Vector3.new(0, 0.03, 0), 0.12, 30, Color3.fromRGB(255, 200, 80), Enum.Material.Neon)
	ring.CanCollide = false
	table.insert(arena.trim, ring)
	local inner = disc(model, center + Vector3.new(0, 0.06, 0), 0.12, 27, Color3.fromRGB(120, 50, 40), Enum.Material.Slate)
	inner.CanCollide = false

	local segments = 36
	local segWidth = 2 * radius * math.sin(math.pi / segments) + 1
	for i = 1, segments do
		local a = (i / segments) * math.pi * 2
		local dir = Vector3.new(math.cos(a), 0, math.sin(a))
		local wallPos = center + dir * radius + Vector3.new(0, 6, 0)
		local wallCf = CFrame.lookAt(wallPos, Vector3.new(center.X, wallPos.Y, center.Z))
		part({ Name = "Wall", Size = Vector3.new(segWidth, 12, 2), CFrame = wallCf, Color = STONE, Material = Enum.Material.Cobblestone, Parent = model })
		local trim = part({
			Name = "WallTrim",
			Size = Vector3.new(segWidth, 0.5, 2.3),
			CFrame = wallCf * CFrame.new(0, 6.1, 0),
			Color = Color3.fromRGB(255, 200, 80),
			Material = Enum.Material.Neon,
			Parent = model,
		})
		table.insert(arena.trim, trim)

		if i % 6 == 3 then
			local banner = part({
				Name = "Banner",
				Size = Vector3.new(4, 8, 0.2),
				CFrame = wallCf * CFrame.new(0, 1, -1.15),
				Color = CRIMSON,
				Material = Enum.Material.Fabric,
				CanCollide = false,
				Parent = model,
			})
			table.insert(arena.banners, banner)
		end
		if i % 6 == 0 then
			local _, fire = torch(model, (wallCf * CFrame.new(0, 6.75, 0)).Position, 1, 30)
			table.insert(arena.fires, fire)
		end

		for tier = 1, 3 do
			local r = radius + 2 + tier * 5
			local h = 12 + tier * 4
			local stepPos = center + dir * r + Vector3.new(0, h / 2, 0)
			part({
				Name = "Stand",
				Size = Vector3.new(2 * r * math.sin(math.pi / segments) + 1, h, 5),
				CFrame = CFrame.lookAt(stepPos, Vector3.new(center.X, stepPos.Y, center.Z)),
				Color = Color3.fromRGB(150, 135, 115),
				Material = Enum.Material.Concrete,
				Parent = model,
			})
			if (i + tier) % 2 == 0 then
				local seatPos = center + dir * r + Vector3.new(0, h + 1.2, 0)
				part({
					Name = "Crowd",
					Size = Vector3.new(1.6, 2.4, 1.2),
					CFrame = CFrame.lookAt(seatPos, Vector3.new(center.X, seatPos.Y, center.Z)),
					Color = CROWD_COLORS[(i * tier) % #CROWD_COLORS + 1],
					CanCollide = false,
					Parent = model,
				})
			end
		end
	end

	model.Parent = workspace
	return arena
end

-- 스테이지 등급의 색과 속성으로 투기장을 물들인다. 보스전은 붉은 불꽃
function World.themeArena(arena: Arena, grade: number, isBoss: boolean, beyond: boolean?)
	local style = GradeStyle.get(grade)
	local color = style.glow
	for i, p in ipairs(arena.trim) do
		p.Color = (i % 2 == 0) and style.secondary or color
	end
	local ambient = arena.ambient
	if ambient then
		ambient.Texture = style.motif.tex
		ambient.Color = GradeStyle.gradient(grade)
		ambient.Acceleration = style.motif.drift * 0.4
		ambient.Rate = 25 + grade * 0.6
		ambient.LightEmission = (style.motif.id == "shadow" or style.motif.id == "void") and 0.2 or 1
	end
	for _, b in ipairs(arena.banners) do
		b.Color = isBoss and CRIMSON or color:Lerp(Color3.new(0, 0, 0), 0.35)
	end
	if beyond and ambient then
		-- 초월 스테이지: 무지개 입자가 더 많이 흩날린다
		ambient.Color = GradeStyle.RAINBOW
		ambient.Rate = 140
	end
	for _, f in ipairs(arena.fires) do
		if beyond and not isBoss then
			f.Color = Color3.fromRGB(150, 80, 255)
			f.SecondaryColor = Color3.fromRGB(60, 220, 255)
		elseif isBoss then
			f.Color = Color3.fromRGB(255, 40, 60)
			f.SecondaryColor = Color3.fromRGB(120, 0, 30)
		else
			f.Color = FIRE
			f.SecondaryColor = Color3.fromRGB(255, 220, 120)
		end
	end
end

return World
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="StarterPlayer" referent="12">
    <Properties>
      <string name="Name">StarterPlayer</string>
    </Properties>
    <Item class="StarterPlayerScripts" referent="13">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="LocalScript" referent="14">
        <Properties>
          <string name="Name">ArenaClient</string>
          <string name="Source"><![CDATA[-- ArenaClient (LocalScript, StarterPlayer > StarterPlayerScripts)
-- 화면 UI와 조작. 계산은 서버가 하고, 여기서는 보여 주고 요청만 보낸다.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local Debris = game:GetService("Debris")
local CollectionService = game:GetService("CollectionService")

local Config = require(ReplicatedStorage:WaitForChild("GameConfig"))
local WeaponBuilder = require(ReplicatedStorage:WaitForChild("WeaponBuilder"))
local GradeStyle = require(ReplicatedStorage:WaitForChild("GradeStyle"))
local AuraBuilder = require(ReplicatedStorage:WaitForChild("AuraBuilder"))
local Effects = require(script:WaitForChild("Effects"))
local Motion = require(script:WaitForChild("Motion"))
local KillFx = require(script:WaitForChild("KillFx"))
local remotes = ReplicatedStorage:WaitForChild("ArenaRemotes")
local Request = remotes:WaitForChild("Request") :: RemoteEvent
local Push = remotes:WaitForChild("Push") :: RemoteEvent

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

local state: any = nil
local myStats: any = nil
local battle: any = { active = false }

-- 아래쪽에서 정의하는 도움 함수 (서버 메시지 처리에서 쓴다)
local attachMarkRune: (Model?, number, Color3) -> ()
local showStun: (Model?, number) -> ()
local pushSelf: (Vector3, number, number) -> ()

------------------------------------------------------------------------
-- UI 도구
------------------------------------------------------------------------
local C = {
	bg = Color3.fromRGB(20, 16, 15),
	panel = Color3.fromRGB(36, 28, 25),
	panel2 = Color3.fromRGB(54, 42, 36),
	panel3 = Color3.fromRGB(74, 58, 48),
	line = Color3.fromRGB(125, 96, 64),
	gold = Color3.fromRGB(255, 198, 72),
	goldDeep = Color3.fromRGB(196, 130, 36),
	text = Color3.fromRGB(246, 238, 224),
	dim = Color3.fromRGB(178, 162, 146),
	red = Color3.fromRGB(214, 62, 54),
	green = Color3.fromRGB(76, 196, 110),
	blue = Color3.fromRGB(64, 132, 226),
}

local function new(className: string, props: { [string]: any }?, children: { Instance }?): any
	local inst = Instance.new(className)
	local parent = nil
	if props then
		for k, v in pairs(props) do
			if k == "Parent" then
				parent = v
			else
				(inst :: any)[k] = v
			end
		end
	end
	if children then
		for _, child in ipairs(children) do
			child.Parent = inst
		end
	end
	if parent then
		inst.Parent = parent
	end
	return inst
end

local function corner(radius: number?): UICorner
	return new("UICorner", { CornerRadius = UDim.new(0, radius or 8) })
end

local function stroke(color: Color3?, thickness: number?): UIStroke
	return new("UIStroke", {
		Color = color or C.line,
		Thickness = thickness or 1.5,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
	})
end

local function pad(px: number): UIPadding
	return new("UIPadding", {
		PaddingLeft = UDim.new(0, px),
		PaddingRight = UDim.new(0, px),
		PaddingTop = UDim.new(0, px),
		PaddingBottom = UDim.new(0, px),
	})
end

-- 위가 밝고 아래가 어두운 판
local function shade(top: Color3, bottom: Color3, rotation: number?): UIGradient
	return new("UIGradient", { Color = ColorSequence.new(top, bottom), Rotation = rotation or 90 })
end

local function lighten(c: Color3, t: number): Color3
	return c:Lerp(Color3.new(1, 1, 1), t)
end

local function darken(c: Color3, t: number): Color3
	return c:Lerp(Color3.new(0, 0, 0), t)
end

local function text(props: { [string]: any }): TextLabel
	local defaults = {
		BackgroundTransparency = 1,
		Font = Enum.Font.GothamBold,
		TextColor3 = C.text,
		TextSize = 16,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextWrapped = true,
	}
	for k, v in pairs(props) do
		defaults[k] = v
	end
	return new("TextLabel", defaults)
end

local function button(props: { [string]: any }, onClick: () -> ()): TextButton
	local base: Color3 = props.BackgroundColor3 or C.panel3
	local defaults = {
		BackgroundColor3 = Color3.new(1, 1, 1),
		AutoButtonColor = true,
		Font = Enum.Font.GothamBlack,
		TextColor3 = C.text,
		TextSize = 15,
		TextStrokeTransparency = 0.6,
	}
	for k, v in pairs(props) do
		if k ~= "BackgroundColor3" then
			defaults[k] = v
		end
	end
	local b = new("TextButton", defaults, {
		corner(8),
		stroke(darken(base, 0.45), 1.5),
		shade(lighten(base, 0.12), darken(base, 0.2)),
	})
	b.Activated:Connect(onClick)
	return b
end

local function setButtonColor(b: TextButton, base: Color3)
	local g = b:FindFirstChildOfClass("UIGradient")
	if g then
		g.Color = ColorSequence.new(lighten(base, 0.12), darken(base, 0.2))
	end
	local s = b:FindFirstChildOfClass("UIStroke")
	if s then
		s.Color = darken(base, 0.45)
	end
end


-- 등급마다 고유한 두 색 띠 (94등급부터 무지개)
local function setGradeColor(label: TextLabel, grade: number)
	local old = label:FindFirstChildOfClass("UIGradient")
	if old then
		old:Destroy()
	end
	label.TextColor3 = Color3.new(1, 1, 1)
	new("UIGradient", { Color = GradeStyle.gradient(grade), Parent = label })
end

-- 스테이지 이름 색: 1~100은 등급 색, 초월 스테이지는 무지개
local function setStageColor(label: TextLabel, n: number)
	if Config.isBeyond(n) then
		local old = label:FindFirstChildOfClass("UIGradient")
		if old then
			old:Destroy()
		end
		label.TextColor3 = Color3.new(1, 1, 1)
		new("UIGradient", { Color = GradeStyle.RAINBOW, Parent = label })
	else
		setGradeColor(label, n)
	end
end

local function enhOf(key: string): number
	return (state and type(state.enh) == "table" and state.enh[key]) or 0
end

local function weaponTitle(key: string): (string, any)
	local info = Config.weaponInfo(key)
	if not info then
		return "?", nil
	end
	if info.typeId == 0 then
		local lv0 = enhOf(key)
		return "올라운더" .. (lv0 > 0 and (" +" .. lv0) or ""), info
	end
	local lv = enhOf(key)
	return string.format("[%d] %s %s%s", info.grade, info.gradeData.en, info.type.name, lv > 0 and (" +" .. lv) or ""), info
end

local function weaponColor(info: any): Color3
	if info.typeId == 0 then
		return C.gold
	end
	return info.rarity.color
end

local fmt = Config.formatNumber

-- 무기 3D 미리보기
local function weaponViewport(parent: GuiObject, key: string, spin: boolean, enh: number?): ViewportFrame?
	local info = Config.weaponInfo(key)
	if not info then
		return nil
	end
	local vp = new("ViewportFrame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Ambient = Color3.fromRGB(190, 175, 165),
		LightColor = Color3.fromRGB(255, 240, 220),
		LightDirection = Vector3.new(-1, -1, -0.6),
		Parent = parent,
	})
	local world = new("Model", { Parent = vp })
	local hand = new("Part", {
		Anchored = true,
		Transparency = 1,
		Size = Vector3.new(0.5, 0.5, 0.5),
		CFrame = CFrame.new(),
		Parent = world,
	})
	world.PrimaryPart = hand
	WeaponBuilder.build(world, hand, info.typeId, {
		grade = info.typeId == 0 and 100 or info.grade,
		accent = info.typeId == 0 and Color3.fromRGB(255, 235, 160) or info.rarity.color,
		rarity = info.rarity.rank,
		scale = 1,
		enh = enh or 0,
	}, CFrame.new(0, -3, 0))
	local cam = new("Camera", { FieldOfView = 38, Parent = vp })
	vp.CurrentCamera = cam
	local bbCf, bbSize = world:GetBoundingBox()
	local dist = math.max(bbSize.X, bbSize.Y, bbSize.Z) * 1.45 + 1
	local focus = bbCf.Position
	cam.CFrame = CFrame.lookAt(focus + Vector3.new(dist * 0.25, dist * 0.1, dist), focus)
	if spin then
		local conn
		conn = RunService.RenderStepped:Connect(function()
			if not vp.Parent then
				conn:Disconnect()
				return
			end
			world:PivotTo(CFrame.Angles(0, os.clock() * 1.2, math.rad(-12)))
		end)
	else
		world:PivotTo(CFrame.Angles(0, math.rad(35), math.rad(-12)))
	end
	return vp
end


<roblox version="4">
  <Item class="Lighting" referent="0">
    <Properties>
      <string name="Name">Lighting</string>
      <Color3 name="Ambient">
        <R>0.24</R>
        <G>0.2</G>
        <B>0.2</B>
      </Color3>
      <float name="Brightness">2.2</float>
      <float name="ClockTime">17.4</float>
      <float name="EnvironmentDiffuseScale">0.6</float>
      <float name="EnvironmentSpecularScale">0.7</float>
      <bool name="GlobalShadows">true</bool>
      <Color3 name="OutdoorAmbient">
        <R>0.55</R>

	{ key = "slots2", id = 0, price = 249, icon = "🛰", name = "위성 칸 +2", desc = "위성을 2개 더 데리고 다닌다" },
	{ key = "luck", id = 0, price = 349, icon = "🍀", name = "행운 부화", desc = "캡슐에서 전설 이상이 나올 확률 2배" },
	{ key = "triple", id = 0, price = 199, icon = "🥚", name = "3개 부화", desc = "캡슐을 한 번에 3개씩 깬다" },
	{ key = "petpack", id = 0, price = 2199, icon = "🐉", name = "우주 위성 패키지", desc = "비밀 위성 3종(우주 용 ×150, 신의 눈 ×175, 시간의 고리 ×200) + 전용 스킨 '신의 눈' + 위성 칸 +1", featured = true },
}
Config.Products = {
	{ key = "boost30", id = 0, price = 49, icon = "🔥", name = "질량 2배 30분", desc = "30분 동안 질량 2배 (겹쳐 사면 시간이 늘어남)" },
	{ key = "respawn30", id = 0, price = 39, icon = "♻", name = "빠른 재생산 30분", desc = "30분 동안 물체가 2배 빨리 다시 생김" },
	{ key = "massS", id = 0, price = 25, icon = "💠", name = "질량 꾸러미 (소)", desc = "지금 갈 수 있는 가장 큰 물체 30개 값만큼 질량" },
	{ key = "massL", id = 0, price = 99, icon = "💎", name = "질량 꾸러미 (대)", desc = "지금 갈 수 있는 가장 큰 물체 120개 값만큼 질량" },
	{ key = "dm10", id = 0, price = 149, icon = "🌑", name = "암흑 물질 10개", desc = "빅뱅 상점에서 쓰는 암흑 물질" },
}
Config.PASS_BY_KEY = {}
for _, p in ipairs(Config.GamePasses) do
	Config.PASS_BY_KEY[p.key] = p
end
Config.PRODUCT_BY_KEY = {}
for _, p in ipairs(Config.Products) do
	Config.PRODUCT_BY_KEY[p.key] = p
end

------------------------------------------------------------------------
-- 별똥별: 가끔 내 근처에 떨어진다. 삼키면 60초 동안 질량과 성장 2배
------------------------------------------------------------------------
Config.STAR_INTERVAL = 35
Config.STAR_LIFETIME = 25
Config.STAR_BOOST = 60

------------------------------------------------------------------------
-- 계산
------------------------------------------------------------------------
-- 반지름 바깥으로 살짝 더 닿는 거리 (흡입력 업그레이드는 없앴다: 물체 위를 정확히 지나가야 먹는다)
function Config.pullRange(radius: number): number
	return radius * 0.08 + 1
end

-- 이동 속도. 크기가 커질수록 빨라지고, 넓은 뒤쪽 구역도 금방 건너간다
function Config.walkSpeed(radius: number, bbSpeed: number?, pass2: boolean?, upgLv: number?, extra: number?): number
	local base = math.min(320, 18 + radius * 0.35) * (1 + 0.15 * (bbSpeed or 0)) * (1 + 0.05 * (upgLv or 0))
	-- 너무 빠르면 벽을 뚫고 나갈 수 있어서 최대 450으로 묶는다
	return math.min(450, base * (pass2 and 2 or 1) * (extra or 1))
end

-- 질량 배율 전체. info = { mult, bigbang, bbMass, sats(위성 배율), vip, mass2, boost, star, skin(스킨 질량 보너스), combo(콤보 보너스) }
function Config.totalMult(info: any): number
	local m = (1 + 0.25 * (info.mult or 0)) * (1 + (info.bigbang or 0)) * (1 + 0.5 * (info.bbMass or 0))
	m *= info.sats or 1
	m *= 1 + (info.skin or 0)
	m *= 1 + (info.combo or 0)
	if info.vip then
		m *= 1.5
	end
	if info.mass2 then
		m *= 2
	end
	if info.boost then
		m *= 2
	end
	if info.star then
		m *= 2
	end
	return m
end

-- 재생 시간 배율 (작을수록 빠르다)
function Config.respawnFactor(bbRespawn: number, vip: boolean?, boost: boolean?, upgLv: number?, skin: number?): number
	local f = (1 - 0.12 * bbRespawn) * (1 - 0.04 * (upgLv or 0)) * (skin or 1)
	if vip then
		f *= 0.8
	end
	if boost then
		f *= 0.5
	end
	return math.max(0.1, f)
end

-- 콤보 보너스 (질량 배수에 더해진다)
function Config.comboBonus(combo: number, comboLv: number): number
	return math.min(combo, 100) * 0.01 * (1 + 0.25 * comboLv)
end

-- 황금 물체 확률
function Config.goldenChance(goldenLv: number, skinMult: number?): number
	return Config.GOLDEN_CHANCE * (1 + 0.25 * goldenLv) * (skinMult or 1)
end

-- 별똥별 간격 (초)
function Config.starInterval(starLv: number, skinMult: number?): number
	return Config.STAR_INTERVAL / ((1 + 0.06 * starLv) * (skinMult or 1))
end

-- 세계에 있는 구역 번호들
function Config.zonesOf(world: number): { number }
	local list = {}
	for i, z in ipairs(Config.Zones) do
		if z.world == world then
			table.insert(list, i)
		end
	end
	return list
end

-- 구역 z 시작: 세계마다 z = 0에서 시작
function Config.zoneStart(index: number): number
	local world = Config.Zones[index].world
	local z = 0
	for i = 1, index - 1 do
		if Config.Zones[i].world == world then
			z += Config.Zones[i].length
		end
	end
	return z
end

function Config.zoneCenter(index: number): Vector3
	local zone = Config.Zones[index]
	return Vector3.new(Config.Worlds[zone.world].x, 0, Config.zoneStart(index) + zone.length / 2)
end

-- 위치가 어느 세계인지
function Config.worldAt(x: number): number
	local best, bestD = 1, math.huge
	for i, w in ipairs(Config.Worlds) do
		local d = math.abs(x - w.x)
		if d < bestD then
			best, bestD = i, d
		end
	end
	return best
end

-- 위치가 어느 구역인지
function Config.zoneAt(pos: Vector3): number
	local list = Config.zonesOf(Config.worldAt(pos.X))
	local acc = 0
	for _, zi in ipairs(list) do
		acc += Config.Zones[zi].length
		if pos.Z < acc then
			return zi
		end
	end
	return list[#list]
end

------------------------------------------------------------------------
-- 서버 이벤트: 떠도는 거대 행성
-- 몇 분마다 플레이어가 많은 구역에 거대한 행성이 나타나 떠돈다. 다 같이 깎아 먹는다.
-- 피해와 보상은 로그로 계산해서, 아무리 크거나 위성 배율이 높아도 밸런스가 깨지지 않는다.
------------------------------------------------------------------------
Config.EVENT = {
	firstDelay = 90, -- 서버가 열리고 첫 행성까지 (초)
	interval = 300, -- 행성 사이 간격 (초)
	life = 150, -- 이 시간 안에 못 먹으면 날아가 버린다
	soloSeconds = 40, -- 혼자 붙어 있으면 다 먹는 데 걸리는 시간
}

-- 한 번(0.1초)에 깎는 양: 크기에 로그
function Config.eventDamage(radius: number): number
	return 1 + math.log(1 + radius, 2)
end

-- 보상. share = 내가 깎은 몫 (0~1), escaped = 놓쳤으면 true
--   질량: 지금 갈 수 있는 가장 큰 물체 × (10 + 40 × 몫) × (1 + log10(질량 배율))
--   성장: 반지름 +3% + 7% × 몫
--   암흑 물질: 몫 15% 이상이면 1개, 1등이면 1개 더
function Config.eventReward(share: number, biggest: number, totalMult: number, top: boolean, escaped: boolean?): (number, number, number)
	local f = escaped and 0.5 or 1
	local mass = biggest * (10 + 40 * share) * (1 + math.log10(math.max(1, totalMult))) * f
	local grow = (0.03 + 0.07 * share) * f
	local dm = 0
	if not escaped then
		dm = (share >= 0.15 and 1 or 0) + (top and 1 or 0)
	end
	return mass, grow, dm
end

-- 지금 갈 수 있는 구역에서 가장 질량이 큰 물체 (질량 꾸러미 계산용)
function Config.biggestMass(world: number, radius: number): number
	local reach = Config.maxZone(world, radius)
	local best = 0
	for _, o in ipairs(Config.Objects) do
		if Config.Zones[o.zone].world == world and o.zone <= reach and o.size <= math.max(radius, Config.Zones[o.zone].need) then
			best = math.max(best, o.mass * (Config.Worlds[world].massMult or 1))
		end
	end
	return best
end

-- 지금 크기로 그 세계에서 갈 수 있는 가장 먼 구역
function Config.maxZone(world: number, radius: number): number
	local list = Config.zonesOf(world)
	local best = list[1]
	for _, zi in ipairs(list) do
		if radius >= Config.Zones[zi].need then
			best = zi
		end
	end
	return best
end

local SUFFIXES = { "", "K", "M", "B", "T", "Qa", "Qi", "Sx", "Sp", "Oc", "No", "Dc", "Ud", "Dd" }

function Config.formatNumber(n: number): string
	if n ~= n then
		return "0"
	end
	if n < 1000 then
		return tostring(math.floor(n))
	end
	local i = math.floor(math.log10(n) / 3)
	if i >= #SUFFIXES then
		return string.format("%.2e", n)
	end
	local v = n / 10 ^ (i * 3)
	local s
	if v >= 100 then
		s = string.format("%d", math.floor(v))
	elseif v >= 10 then
		s = string.format("%.1f", math.floor(v * 10) / 10)
	else
		s = string.format("%.2f", math.floor(v * 100) / 100)
	end
	return s .. SUFFIXES[i + 1]
end

function Config.formatSize(r: number): string
	if r >= 100 then
		return tostring(math.floor(r))
	end
	return string.format("%.1f", r)
end

function Config.formatTime(sec: number): string
	local s = math.max(0, math.floor(sec))
	if s >= 3600 then
		return string.format("%d:%02d:%02d", s // 3600, (s % 3600) // 60, s % 60)
	end
	return string.format("%d:%02d", s // 60, s % 60)
end

return Config
]]></string>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="4">
      <Properties>
        <string name="Name">Props</string>
        <string name="Source"><![CDATA[-- Props (ModuleScript, ReplicatedStorage)
-- 블랙홀이 삼키는 물체 85종의 모양. 모두 파트를 이어 붙여 코드로 만든다.
-- 각 모양은 반지름 s(= 삼키는 데 필요한 크기)에 맞춰 커진다. 바닥 가운데가 기준점이다.
-- 자동차는 범퍼·사이드미러·휠캡, 집은 창틀·현관 계단·울타리, 빌딩은 층마다 창문 띠와 옥상 설비처럼
-- 작은 부품까지 붙여서 가까이서 봐도 그럴듯하게 만든다.

local Props = {}

type MakeFn = (string, Enum.PartType?, Vector3, CFrame, Color3, Enum.Material) -> Part
type Builder = (MakeFn, number, () -> number) -> ()

local function hsv(h: number, s: number, v: number): Color3
	return Color3.fromHSV(h % 1, s, v)
end

local BALL = Enum.PartType.Ball
local CYL = Enum.PartType.Cylinder
local BLOCK = Enum.PartType.Block

local M = Enum.Material
local C = Color3.fromRGB
local V = Vector3.new
local CF = CFrame.new

-- 세운 원기둥 (원기둥은 X축이 길이라 Z축으로 90도 돌린다)
local UP = CFrame.Angles(0, 0, math.rad(90))
-- 옆으로 누운 바퀴 (축이 X)
local AXLE = CFrame.new()

local GLASS = C(150, 200, 230)
local DARK = C(30, 30, 35)
local WHITE = C(245, 245, 245)

local builders: { [string]: Builder } = {}

-- 공통 부품: 바퀴 (타이어 + 휠캡)
local function wheel(P: MakeFn, pos: CFrame, d: number, w: number)
	P("Tire", CYL, V(w, d, d), pos * AXLE, C(25, 25, 28), M.Rubber)
	P("Hub", CYL, V(w * 1.05, d * 0.5, d * 0.5), pos * AXLE, C(200, 200, 210), M.Metal)
end

-- 공통 부품: 창문 (유리 + 창틀)
local function window(P: MakeFn, cf: CFrame, w: number, h: number, frame: Color3, lit: boolean?)
	P("Frame", BLOCK, V(w * 1.15, h * 1.15, 0.04), cf, frame, M.Wood)
	P("Glass", BLOCK, V(w, h, 0.06), cf, lit and C(255, 230, 160) or GLASS, lit and M.Neon or M.Glass)
	P("Bar", BLOCK, V(w * 0.08, h, 0.08), cf, frame, M.Wood)
end

------------------------------------------------------------------------
-- 1 공원
------------------------------------------------------------------------
builders.pebble = function(P, s, r)
	local col = C(130, 128, 125):Lerp(C(160, 150, 130), r())
	P("Stone", BALL, V(1.6, 1.0, 1.3) * s, CF(0, 0.45 * s, 0) * CFrame.Angles(0, r() * 6, 0), col, M.Slate)
	P("Stone2", BALL, V(0.8, 0.6, 0.7) * s, CF(0.6 * s, 0.25 * s, 0.3 * s), col:Lerp(C(0, 0, 0), 0.15), M.Slate)
	P("Moss", BALL, V(0.7, 0.2, 0.6) * s, CF(-0.2 * s, 0.85 * s, 0.1 * s), C(90, 140, 60), M.Grass)
end

builders.flower = function(P, s, r)
	local petal = hsv(r(), 0.6, 1)
	P("Stem", CYL, V(1.4 * s, 0.12 * s, 0.12 * s), CF(0, 0.7 * s, 0) * UP, C(70, 160, 60), M.Grass)
	for _, side in ipairs({ 1, -1 }) do
		P("Leaf", BALL, V(0.55, 0.08, 0.25) * s, CF(side * 0.22 * s, (0.45 + side * 0.1) * s, 0) * CFrame.Angles(0, 0, math.rad(side * 25)), C(80, 180, 70), M.Grass)
	end
	P("Core", BALL, V(0.35, 0.35, 0.35) * s, CF(0, 1.45 * s, 0), C(255, 210, 60), M.SmoothPlastic)
	for i = 0, 6 do
		local a = i / 7 * math.pi * 2
		P("Petal", BALL, V(0.45, 0.14, 0.28) * s, CF(math.cos(a) * 0.3 * s, 1.45 * s, math.sin(a) * 0.3 * s) * CFrame.Angles(0, -a, math.rad(10)), petal, M.SmoothPlastic)
	end
end

builders.ball = function(P, s, r)
	local stripe = (r() < 0.5) and DARK or hsv(r(), 0.7, 0.9)
	P("Ball", BALL, V(2, 2, 2) * s, CF(0, 1 * s, 0), WHITE, M.SmoothPlastic)
	for i = 0, 5 do
		local a = i / 6 * math.pi * 2
		local dir = V(math.cos(a), math.sin(a * 2) * 0.4, math.sin(a)).Unit
		local pos = V(0, s, 0) + dir * 0.97 * s
		P("Patch", CYL, V(0.06 * s, 0.6 * s, 0.6 * s), CFrame.lookAt(pos, pos + dir) * CFrame.Angles(0, math.rad(90), 0), stripe, M.SmoothPlastic)
	end
end

builders.trashcan = function(P, s, r)
	local col = (r() < 0.5) and C(60, 140, 80) or C(70, 90, 160)
	P("Can", CYL, V(2.4 * s, 1.6 * s, 1.6 * s), CF(0, 1.2 * s, 0) * UP, col, M.Metal)
	for _, y in ipairs({ 0.5, 1.2, 1.9 }) do
		P("Rib", CYL, V(0.1 * s, 1.68 * s, 1.68 * s), CF(0, y * s, 0) * UP, col:Lerp(C(0, 0, 0), 0.25), M.Metal)
	end
	P("Lid", CYL, V(0.2 * s, 1.8 * s, 1.8 * s), CF(0, 2.5 * s, 0) * UP, col:Lerp(C(0, 0, 0), 0.3), M.Metal)
	P("Handle", BLOCK, V(0.6, 0.15, 0.15) * s, CF(0, 2.7 * s, 0), C(40, 40, 40), M.Metal)
	P("Label", BLOCK, V(0.6, 0.5, 0.05) * s, CF(0, 1.3 * s, -0.8 * s), WHITE, M.SmoothPlastic)
end

builders.bench = function(P, s, _r)
	local wood = C(150, 100, 60)
	for i = 0, 2 do
		P("Slat", BLOCK, V(4.4, 0.12, 0.35) * s, CF(0, 1.0 * s, (-0.4 + i * 0.4) * s), wood:Lerp(C(0, 0, 0), i * 0.05), M.Wood)
	end
	for i = 0, 1 do
		P("Back", BLOCK, V(4.4, 0.3, 0.1) * s, CF(0, (1.5 + i * 0.45) * s, 0.65 * s) * CFrame.Angles(math.rad(-10), 0, 0), wood, M.Wood)
	end
	for _, x in ipairs({ -1.8, 1.8 }) do
		P("Leg", BLOCK, V(0.15, 1.0, 0.15) * s, CF(x * s, 0.5 * s, -0.45 * s), C(50, 50, 55), M.Metal)
		P("Leg", BLOCK, V(0.15, 1.9, 0.15) * s, CF(x * s, 0.95 * s, 0.5 * s), C(50, 50, 55), M.Metal)
		P("Arm", BLOCK, V(0.15, 0.12, 1.1) * s, CF(x * s, 1.4 * s, 0), C(50, 50, 55), M.Metal)
	end
end

builders.bush = function(P, s, r)
	local g = C(60, 140, 55):Lerp(C(90, 170, 60), r())
	for i = 0, 5 do
		local a = i / 6 * math.pi * 2
		P("Leaves", BALL, V(1.5, 1.3, 1.5) * s, CF(math.cos(a) * 0.95 * s, (0.75 + (i % 2) * 0.15) * s, math.sin(a) * 0.95 * s), g:Lerp(C(0, 0, 0), (i % 3) * 0.06), M.Grass)
	end
	P("Top", BALL, V(1.8, 1.6, 1.8) * s, CF(0, 1.4 * s, 0), g:Lerp(C(255, 255, 255), 0.1), M.Grass)
	local berry = (r() < 0.5) and C(220, 40, 60) or C(250, 250, 255)
	for i = 0, 5 do
		local a = i * 1.1
		P("Berry", BALL, V(0.28, 0.28, 0.28) * s, CF(math.cos(a) * 1.35 * s, (1.0 + (i % 3) * 0.3) * s, math.sin(a) * 1.35 * s), berry, M.SmoothPlastic)
	end
end

builders.tree = function(P, s, r)
	P("Trunk", CYL, V(2.4 * s, 0.55 * s, 0.55 * s), CF(0, 1.2 * s, 0) * UP, C(110, 75, 45), M.Wood)
	for i = 0, 2 do
		local a = i * 2.1
		P("Root", BLOCK, V(0.25, 0.25, 0.8) * s, CF(math.cos(a) * 0.35 * s, 0.12 * s, math.sin(a) * 0.35 * s) * CFrame.Angles(0, -a, 0), C(100, 68, 40), M.Wood)
	end
	P("Branch", CYL, V(0.9 * s, 0.18 * s, 0.18 * s), CF(0.35 * s, 2.0 * s, 0) * CFrame.Angles(0, 0, math.rad(50)), C(110, 75, 45), M.Wood)
	local g = C(60, 150, 60):Lerp(C(120, 180, 60), r())
	P("Crown", BALL, V(2.4, 2.2, 2.4) * s, CF(0, 3.0 * s, 0), g, M.Grass)
	P("Crown2", BALL, V(1.6, 1.5, 1.6) * s, CF(0.6 * s, 3.7 * s, 0.2 * s), g:Lerp(C(255, 255, 255), 0.1), M.Grass)
	P("Crown3", BALL, V(1.4, 1.3, 1.4) * s, CF(-0.7 * s, 3.4 * s, -0.3 * s), g:Lerp(C(0, 0, 0), 0.08), M.Grass)
	if r() < 0.5 then
		for i = 0, 3 do
			local a = i * 1.6
			P("Apple", BALL, V(0.3, 0.3, 0.3) * s, CF(math.cos(a) * 1.15 * s, (2.6 + (i % 2) * 0.5) * s, math.sin(a) * 1.15 * s), C(220, 50, 40), M.SmoothPlastic)
		end
	end
end

------------------------------------------------------------------------
-- 2 마을
------------------------------------------------------------------------
builders.mailbox = function(P, s, _r)
	P("Post", BLOCK, V(0.3, 2, 0.3) * s, CF(0, 1 * s, 0), C(90, 70, 50), M.Wood)
	P("Base", BLOCK, V(0.6, 0.15, 0.6) * s, CF(0, 0.08 * s, 0), C(70, 55, 40), M.Wood)
	P("Box", BLOCK, V(0.9, 0.8, 1.6) * s, CF(0, 2.3 * s, 0), C(200, 40, 40), M.Metal)
	P("Top", CYL, V(1.6 * s, 0.9 * s, 0.9 * s), CF(0, 2.7 * s, 0) * CFrame.Angles(0, math.rad(90), 0), C(200, 40, 40), M.Metal)
	P("Door", BLOCK, V(0.8, 0.85, 0.05) * s, CF(0, 2.4 * s, -0.82 * s), C(180, 35, 35), M.Metal)
	P("Knob", BALL, V(0.12, 0.12, 0.12) * s, CF(0, 2.5 * s, -0.86 * s), C(230, 200, 80), M.Metal)
	P("FlagPole", BLOCK, V(0.06, 0.6, 0.06) * s, CF(0.5 * s, 2.6 * s, 0.4 * s), C(60, 60, 60), M.Metal)
	P("Flag", BLOCK, V(0.06, 0.25, 0.35) * s, CF(0.5 * s, 2.8 * s, 0.25 * s), C(255, 220, 40), M.SmoothPlastic)
end

builders.bicycle = function(P, s, r)
	local col = hsv(r(), 0.7, 0.9)
	for _, z in ipairs({ -0.9, 0.9 }) do
		P("Tire", CYL, V(0.12 * s, 1.4 * s, 1.4 * s), CF(0, 0.7 * s, z * s), C(30, 30, 30), M.Rubber)
		P("Rim", CYL, V(0.13 * s, 1.1 * s, 1.1 * s), CF(0, 0.7 * s, z * s), C(200, 200, 210), M.Metal).Transparency = 0.5
		P("Hub", CYL, V(0.16 * s, 0.2 * s, 0.2 * s), CF(0, 0.7 * s, z * s), C(120, 120, 130), M.Metal)
	end
	P("Top", BLOCK, V(0.1, 0.1, 1.5) * s, CF(0, 1.25 * s, 0) * CFrame.Angles(math.rad(-5), 0, 0), col, M.Metal)
	P("Down", BLOCK, V(0.1, 0.1, 1.2) * s, CF(0, 0.95 * s, -0.2 * s) * CFrame.Angles(math.rad(35), 0, 0), col, M.Metal)
	P("SeatTube", BLOCK, V(0.1, 0.8, 0.1) * s, CF(0, 1.05 * s, 0.4 * s) * CFrame.Angles(math.rad(-15), 0, 0), col, M.Metal)
	P("Chainstay", BLOCK, V(0.08, 0.08, 0.9) * s, CF(0, 0.72 * s, 0.45 * s), col, M.Metal)
	P("Fork", BLOCK, V(0.1, 0.8, 0.1) * s, CF(0, 1.05 * s, -0.8 * s) * CFrame.Angles(math.rad(15), 0, 0), col, M.Metal)
	P("Seat", BLOCK, V(0.3, 0.1, 0.5) * s, CF(0, 1.55 * s, 0.5 * s), DARK, M.Fabric)
	P("Bar", BLOCK, V(0.9, 0.08, 0.08) * s, CF(0, 1.55 * s, -0.9 * s), C(60, 60, 60), M.Metal)
	for _, x in ipairs({ -0.45, 0.45 }) do
		P("Grip", BLOCK, V(0.2, 0.1, 0.1) * s, CF(x * s, 1.55 * s, -0.9 * s), DARK, M.Rubber)
	end
	P("Chainring", CYL, V(0.08 * s, 0.4 * s, 0.4 * s), CF(0.08 * s, 0.72 * s, 0), C(150, 150, 160), M.Metal)
	P("Basket", BLOCK, V(0.6, 0.35, 0.4) * s, CF(0, 1.35 * s, -1.15 * s), C(190, 150, 90), M.Fabric)
end

builders.lamp = function(P, s, _r)
	P("Base", CYL, V(0.4 * s, 0.8 * s, 0.8 * s), CF(0, 0.2 * s, 0) * UP, C(40, 40, 45), M.Metal)
	P("Pole", CYL, V(4.4 * s, 0.22 * s, 0.22 * s), CF(0, 2.4 * s, 0) * UP, C(50, 52, 60), M.Metal)
	for _, y in ipairs({ 1.2, 3.6 }) do
		P("Collar", CYL, V(0.15 * s, 0.32 * s, 0.32 * s), CF(0, y * s, 0) * UP, C(70, 72, 80), M.Metal)
	end
	P("Arm", BLOCK, V(0.12, 0.12, 1.0) * s, CF(0, 4.5 * s, -0.4 * s), C(50, 52, 60), M.Metal)
	P("Shade", BLOCK, V(0.7, 0.2, 0.7) * s, CF(0, 4.45 * s, -0.9 * s), C(40, 40, 45), M.Metal)
	local bulb = P("Bulb", BALL, V(0.5, 0.5, 0.5) * s, CF(0, 4.2 * s, -0.9 * s), C(255, 240, 180), M.Neon)
	local light = Instance.new("PointLight")
	light.Range = 4 * s
	light.Brightness = 1
	light.Color = C(255, 230, 170)
	light.Parent = bulb
	P("Sign", BLOCK, V(0.05, 0.4, 0.8) * s, CF(0.12 * s, 2.8 * s, 0), C(40, 120, 70), M.SmoothPlastic)
end

builders.car = function(P, s, r)
	local col = hsv(r(), 0.75, 0.95)
	P("Body", BLOCK, V(1.7, 0.6, 3.6) * s, CF(0, 0.7 * s, 0), col, M.SmoothPlastic)
	P("Hood", BLOCK, V(1.66, 0.15, 1.0) * s, CF(0, 1.02 * s, -1.25 * s) * CFrame.Angles(math.rad(-4), 0, 0), col, M.SmoothPlastic)
	P("Cabin", BLOCK, V(1.5, 0.6, 1.7) * s, CF(0, 1.3 * s, 0.25 * s), col:Lerp(WHITE, 0.12), M.SmoothPlastic)
	P("Windshield", BLOCK, V(1.4, 0.55, 0.05) * s, CF(0, 1.3 * s, -0.62 * s) * CFrame.Angles(math.rad(-25), 0, 0), GLASS, M.Glass)
	P("RearGlass", BLOCK, V(1.4, 0.5, 0.05) * s, CF(0, 1.3 * s, 1.11 * s) * CFrame.Angles(math.rad(20), 0, 0), GLASS, M.Glass)
	for _, x in ipairs({ -0.76, 0.76 }) do
		P("SideGlass", BLOCK, V(0.05, 0.4, 1.4) * s, CF(x * s, 1.35 * s, 0.25 * s), GLASS, M.Glass)
		P("Mirror", BLOCK, V(0.2, 0.15, 0.1) * s, CF(x * 1.15 * s, 1.15 * s, -0.55 * s), col, M.SmoothPlastic)
		P("Handle", BLOCK, V(0.04, 0.05, 0.2) * s, CF(x * 1.13 * s, 0.9 * s, 0.1 * s), C(200, 200, 210), M.Metal)
	end
	for _, z in ipairs({ -1.82, 1.82 }) do
		P("Bumper", BLOCK, V(1.75, 0.2, 0.15) * s, CF(0, 0.45 * s, z * s), C(70, 70, 75), M.Metal)
	end
	P("Grille", BLOCK, V(0.8, 0.25, 0.05) * s, CF(0, 0.75 * s, -1.81 * s), DARK, M.Metal)
	for _, x in ipairs({ -0.85, 0.85 }) do
		for _, z in ipairs({ -1.1, 1.1 }) do
			wheel(P, CF(x * s, 0.38 * s, z * s), 0.75 * s, 0.3 * s)
		end
	end
	for _, x in ipairs({ -0.6, 0.6 }) do
		P("HeadLamp", BLOCK, V(0.35, 0.18, 0.05) * s, CF(x * s, 0.85 * s, -1.81 * s), C(255, 250, 200), M.Neon)
		P("TailLamp", BLOCK, V(0.35, 0.15, 0.05) * s, CF(x * s, 0.85 * s, 1.81 * s), C(255, 50, 50), M.Neon)
	end
	P("Plate", BLOCK, V(0.5, 0.15, 0.05) * s, CF(0, 0.55 * s, 1.86 * s), WHITE, M.SmoothPlastic)
end

builders.bigtree = function(P, s, r)
	P("Trunk", CYL, V(2.6 * s, 0.7 * s, 0.7 * s), CF(0, 1.3 * s, 0) * UP, C(100, 70, 40), M.Wood)
	for i = 0, 3 do
		local a = i * math.pi / 2 + 0.4
		P("Root", BLOCK, V(0.3, 0.3, 1.0) * s, CF(math.cos(a) * 0.45 * s, 0.15 * s, math.sin(a) * 0.45 * s) * CFrame.Angles(0, -a, math.rad(10)), C(95, 65, 38), M.Wood)
	end
	if r() < 0.5 then
		for i = 0, 3 do
			P("Cone", BLOCK, V(2.6 - i * 0.55, 0.9, 2.6 - i * 0.55) * s, CF(0, (2.4 + i * 0.8) * s, 0) * CFrame.Angles(0, math.rad(45 * i), 0), C(40, 110, 60):Lerp(C(255, 255, 255), i * 0.04), M.Grass)
		end
		P("Snow", BLOCK, V(0.6, 0.3, 0.6) * s, CF(0, 5.4 * s, 0) * CFrame.Angles(0, math.rad(45), 0), WHITE, M.Snow)
	else
		local g = C(70, 150, 60):Lerp(C(200, 160, 60), r() * 0.4)
		P("Crown", BALL, V(2.6, 2.3, 2.6) * s, CF(0, 3.3 * s, 0), g, M.Grass)
		P("Crown2", BALL, V(1.8, 1.6, 1.8) * s, CF(-0.7 * s, 3.9 * s, 0.4 * s), g:Lerp(C(255, 255, 255), 0.08), M.Grass)
		P("Crown3", BALL, V(1.7, 1.5, 1.7) * s, CF(0.8 * s, 3.8 * s, -0.3 * s), g:Lerp(C(0, 0, 0), 0.06), M.Grass)
		P("Nest", CYL, V(0.2 * s, 0.5 * s, 0.5 * s), CF(0.4 * s, 2.5 * s, 0.4 * s) * UP, C(140, 100, 60), M.Fabric)
	end
end

builders.hut = function(P, s, r)
	local wall = C(190, 150, 100):Lerp(C(220, 200, 160), r())
	P("Floor", BLOCK, V(2.9, 0.15, 2.5) * s, CF(0, 0.08 * s, 0), C(120, 90, 60), M.WoodPlanks)
	P("Walls", BLOCK, V(2.6, 1.6, 2.2) * s, CF(0, 0.95 * s, 0), wall, M.WoodPlanks)
	for _, x in ipairs({ -1.3, 1.3 }) do
		for _, z in ipairs({ -1.1, 1.1 }) do
			P("Beam", BLOCK, V(0.15, 1.7, 0.15) * s, CF(x * s, 0.95 * s, z * s), C(100, 70, 45), M.Wood)
		end
	end
	P("RoofL", BLOCK, V(1.65, 0.15, 2.6) * s, CF(-0.62 * s, 2.1 * s, 0) * CFrame.Angles(0, 0, math.rad(35)), C(150, 60, 50), M.Slate)
	P("RoofR", BLOCK, V(1.65, 0.15, 2.6) * s, CF(0.62 * s, 2.1 * s, 0) * CFrame.Angles(0, 0, math.rad(-35)), C(150, 60, 50), M.Slate)
	P("Ridge", BLOCK, V(0.2, 0.2, 2.65) * s, CF(0, 2.55 * s, 0), C(110, 45, 40), M.Slate)
	P("Door", BLOCK, V(0.5, 0.9, 0.05) * s, CF(0, 0.6 * s, -1.11 * s), C(110, 70, 40), M.Wood)
	P("Knob", BALL, V(0.08, 0.08, 0.08) * s, CF(0.15 * s, 0.6 * s, -1.15 * s), C(220, 190, 80), M.Metal)
	window(P, CF(0.8 * s, 1.05 * s, -1.12 * s), 0.4 * s, 0.35 * s, C(110, 70, 40), true)
	window(P, CF(-0.8 * s, 1.05 * s, -1.12 * s), 0.4 * s, 0.35 * s, C(110, 70, 40), false)
	P("Chimney", BLOCK, V(0.3, 0.7, 0.3) * s, CF(0.7 * s, 2.4 * s, 0.5 * s), C(120, 110, 105), M.Brick)
	P("Step", BLOCK, V(0.7, 0.12, 0.35) * s, CF(0, 0.06 * s, -1.35 * s), C(130, 130, 125), M.Slate)
	P("Woodpile", CYL, V(0.6 * s, 0.4 * s, 0.4 * s), CF(1.5 * s, 0.2 * s, 0.6 * s) * CFrame.Angles(0, math.rad(90), 0), C(140, 100, 60), M.Wood)
end

------------------------------------------------------------------------
-- 3 도시
------------------------------------------------------------------------
builders.truck = function(P, s, r)
	local col = hsv(r(), 0.6, 0.85)
	P("Chassis", BLOCK, V(1.6, 0.3, 4.0) * s, CF(0, 0.55 * s, 0), DARK, M.Metal)
	P("Cab", BLOCK, V(1.6, 1.3, 1.2) * s, CF(0, 1.3 * s, -1.4 * s), col, M.SmoothPlastic)
	P("Windshield", BLOCK, V(1.4, 0.5, 0.05) * s, CF(0, 1.65 * s, -2.01 * s), GLASS, M.Glass)
	for _, x in ipairs({ -0.81, 0.81 }) do
		P("SideGlass", BLOCK, V(0.05, 0.45, 0.6) * s, CF(x * s, 1.65 * s, -1.4 * s), GLASS, M.Glass)
		P("Mirror", BLOCK, V(0.1, 0.35, 0.1) * s, CF(x * 1.12 * s, 1.55 * s, -1.85 * s), DARK, M.Metal)
		P("Tank", CYL, V(0.6 * s, 0.35 * s, 0.35 * s), CF(x * 0.95 * s, 0.6 * s, -0.4 * s) * CFrame.Angles(0, math.rad(90), 0), C(200, 200, 210), M.Metal)
	end
	P("Grille", BLOCK, V(1.2, 0.4, 0.05) * s, CF(0, 0.9 * s, -2.01 * s), C(170, 170, 180), M.Metal)
	P("Cargo", BLOCK, V(1.8, 1.8, 2.7) * s, CF(0, 1.6 * s, 0.65 * s), C(230, 230, 230), M.Metal)
	for i = 0, 4 do
		P("Rib", BLOCK, V(1.84, 1.82, 0.06) * s, CF(0, 1.6 * s, (-0.6 + i * 0.6) * s), C(200, 200, 205), M.Metal)
	end
	P("Logo", BLOCK, V(0.05, 0.7, 1.4) * s, CF(0.92 * s, 1.7 * s, 0.6 * s), col, M.SmoothPlastic)
	for _, x in ipairs({ -0.8, 0.8 }) do
		for _, z in ipairs({ -1.4, 0.6, 1.4 }) do
			wheel(P, CF(x * s, 0.38 * s, z * s), 0.75 * s, 0.3 * s)
		end
	end
	for _, x in ipairs({ -0.55, 0.55 }) do
		P("HeadLamp", BLOCK, V(0.25, 0.18, 0.05) * s, CF(x * s, 0.95 * s, -2.02 * s), C(255, 250, 200), M.Neon)
	end
end

builders.bus = function(P, s, r)
	local col = (r() < 0.5) and C(240, 190, 40) or C(70, 150, 220)
	P("Body", BLOCK, V(1.8, 1.6, 4.2) * s, CF(0, 1.25 * s, 0), col, M.SmoothPlastic)
	P("Stripe", BLOCK, V(1.82, 0.15, 4.22) * s, CF(0, 0.85 * s, 0), WHITE, M.SmoothPlastic)
	P("Roof", BLOCK, V(1.6, 0.12, 3.8) * s, CF(0, 2.1 * s, 0), col:Lerp(WHITE, 0.3), M.SmoothPlastic)
	for i = -3, 3 do
		for _, x in ipairs({ -0.91, 0.91 }) do
			P("Window", BLOCK, V(0.05, 0.5, 0.45) * s, CF(x * s, 1.55 * s, i * 0.52 * s), GLASS, M.Glass)
		end
	end
	P("Front", BLOCK, V(1.5, 0.7, 0.05) * s, CF(0, 1.55 * s, -2.11 * s), GLASS, M.Glass)
	P("Sign", BLOCK, V(1.2, 0.2, 0.05) * s, CF(0, 2.0 * s, -2.12 * s), C(255, 160, 40), M.Neon)
	P("Door", BLOCK, V(0.05, 1.1, 0.6) * s, CF(0.91 * s, 1.05 * s, -1.4 * s), GLASS, M.Glass)
	P("Mirror", BLOCK, V(0.1, 0.3, 0.1) * s, CF(1.0 * s, 1.6 * s, -2.1 * s), DARK, M.Metal)
	for _, x in ipairs({ -0.85, 0.85 }) do
		for _, z in ipairs({ -1.4, 1.4 }) do
			wheel(P, CF(x * s, 0.38 * s, z * s), 0.75 * s, 0.3 * s)
		end
	end
	for _, x in ipairs({ -0.6, 0.6 }) do
		P("HeadLamp", BLOCK, V(0.3, 0.18, 0.05) * s, CF(x * s, 0.7 * s, -2.11 * s), C(255, 250, 200), M.Neon)
	end
end

builders.house = function(P, s, r)
	local wall = hsv(r(), 0.25, 0.95)
	local roof = hsv(r(), 0.6, 0.6)
	local trim = WHITE
	P("Base", BLOCK, V(2.8, 0.2, 2.6) * s, CF(0, 0.1 * s, 0), C(150, 145, 140), M.Concrete)
	P("Walls", BLOCK, V(2.6, 1.8, 2.4) * s, CF(0, 1.1 * s, 0), wall, M.Plaster)
	P("RoofL", BLOCK, V(1.75, 0.18, 2.75) * s, CF(-0.65 * s, 2.35 * s, 0) * CFrame.Angles(0, 0, math.rad(38)), roof, M.Slate)
	P("RoofR", BLOCK, V(1.75, 0.18, 2.75) * s, CF(0.65 * s, 2.35 * s, 0) * CFrame.Angles(0, 0, math.rad(-38)), roof, M.Slate)
	P("Gable", BLOCK, V(1.85, 1.85, 0.1) * s, CF(0, 2.0 * s, -1.15 * s) * CFrame.Angles(0, 0, math.rad(45)), wall, M.Plaster)
	P("Door", BLOCK, V(0.5, 0.95, 0.05) * s, CF(0, 0.7 * s, -1.21 * s), C(120, 70, 40), M.Wood)
	P("Knob", BALL, V(0.08, 0.08, 0.08) * s, CF(0.15 * s, 0.7 * s, -1.25 * s), C(220, 190, 80), M.Metal)
	P("Porch", BLOCK, V(0.9, 0.08, 0.5) * s, CF(0, 1.3 * s, -1.4 * s), roof, M.Slate)
	P("Step", BLOCK, V(0.8, 0.12, 0.4) * s, CF(0, 0.2 * s, -1.4 * s), C(160, 155, 150), M.Concrete)
	for _, x in ipairs({ -0.85, 0.85 }) do
		window(P, CF(x * s, 1.25 * s, -1.22 * s), 0.5 * s, 0.45 * s, trim, x > 0)
		P("Box", BLOCK, V(0.6, 0.12, 0.15) * s, CF(x * s, 0.95 * s, -1.28 * s), C(140, 90, 50), M.Wood)
		P("Flowers", BLOCK, V(0.55, 0.1, 0.12) * s, CF(x * s, 1.05 * s, -1.28 * s), hsv(r(), 0.7, 1), M.SmoothPlastic)
	end
	P("Chimney", BLOCK, V(0.35, 0.8, 0.35) * s, CF(-0.7 * s, 2.7 * s, 0.6 * s), C(150, 80, 70), M.Brick)
	for i = -3, 3 do
		P("Fence", BLOCK, V(0.08, 0.4, 0.08) * s, CF(i * 0.4 * s, 0.2 * s, 1.5 * s), WHITE, M.Wood)
	end
	P("Rail", BLOCK, V(2.6, 0.06, 0.06) * s, CF(0, 0.3 * s, 1.5 * s), WHITE, M.Wood)
end

builders.shop = function(P, s, r)
	P("Walls", BLOCK, V(3.2, 1.8, 2.4) * s, CF(0, 0.9 * s, 0), C(235, 230, 220), M.Concrete)
	P("Glass", BLOCK, V(2.6, 1.0, 0.05) * s, CF(0, 0.8 * s, -1.21 * s), GLASS, M.Glass)
	for i = 0, 2 do
		P("Mullion", BLOCK, V(0.06, 1.0, 0.08) * s, CF((-0.65 + i * 0.65) * s, 0.8 * s, -1.22 * s), C(60, 60, 65), M.Metal)
	end
	local awn = hsv(r(), 0.7, 0.9)
	for i = 0, 5 do
		P("Awning", BLOCK, V(0.53, 0.08, 0.7) * s, CF((-1.33 + i * 0.53) * s, 1.55 * s, -1.45 * s) * CFrame.Angles(math.rad(20), 0, 0), (i % 2 == 0) and awn or WHITE, M.Fabric)
	end
	P("Sign", BLOCK, V(2.0, 0.4, 0.1) * s, CF(0, 2.0 * s, -1.2 * s), awn, M.Neon)
	P("Roof", BLOCK, V(3.3, 0.15, 2.5) * s, CF(0, 1.85 * s, 0), C(90, 90, 95), M.Concrete)
	P("AC", BLOCK, V(0.6, 0.35, 0.5) * s, CF(0.9 * s, 2.1 * s, 0.4 * s), C(200, 200, 205), M.Metal)
	for _, x in ipairs({ -1.0, 1.0 }) do
		P("Plant", BALL, V(0.4, 0.5, 0.4) * s, CF(x * 1.25 * s, 0.35 * s, -1.45 * s), C(70, 150, 60), M.Grass)
		P("Pot", CYL, V(0.3 * s, 0.3 * s, 0.3 * s), CF(x * 1.25 * s, 0.15 * s, -1.45 * s) * UP, C(170, 90, 60), M.Slate)
	end
end

builders.fountain = function(P, s, _r)
	P("Pool", CYL, V(0.5 * s, 3.6 * s, 3.6 * s), CF(0, 0.25 * s, 0) * UP, C(210, 205, 195), M.Marble)
	P("Water", CYL, V(0.1 * s, 3.2 * s, 3.2 * s), CF(0, 0.5 * s, 0) * UP, C(80, 170, 230), M.Glass).Transparency = 0.2
	P("Column", CYL, V(1.6 * s, 0.5 * s, 0.5 * s), CF(0, 1.1 * s, 0) * UP, C(220, 215, 205), M.Marble)
	P("Bowl", CYL, V(0.25 * s, 1.6 * s, 1.6 * s), CF(0, 1.9 * s, 0) * UP, C(220, 215, 205), M.Marble)
	P("Bowl2", CYL, V(0.2 * s, 0.8 * s, 0.8 * s), CF(0, 2.5 * s, 0) * UP, C(220, 215, 205), M.Marble)
	for i = 0, 7 do
		local a = i / 8 * math.pi * 2
		P("Coin", CYL, V(0.02 * s, 0.12 * s, 0.12 * s), CF(math.cos(a) * 1.1 * s, 0.56 * s, math.sin(a) * 0.9 * s) * UP, C(230, 200, 80), M.Metal)
	end
	local spray = P("Spray", BALL, V(0.6, 1.0, 0.6) * s, CF(0, 3.0 * s, 0), C(170, 220, 255), M.Glass)
	spray.Transparency = 0.4
	local pe = Instance.new("ParticleEmitter")
	pe.Rate = 20
	pe.Speed = NumberRange.new(4 * s, 6 * s)
	pe.Acceleration = V(0, -20 * s, 0)
	pe.Lifetime = NumberRange.new(0.6, 0.9)
	pe.SpreadAngle = Vector2.new(25, 25)
	pe.Size = NumberSequence.new(0.2 * s)
	pe.Color = ColorSequence.new(C(200, 235, 255))
	pe.Transparency = NumberSequence.new(0.3)
	pe.Parent = spray
end

------------------------------------------------------------------------
-- 4 대도시
------------------------------------------------------------------------
builders.building = function(P, s, r)
	local h = 3 + r() * 2
	local col = C(170, 180, 195):Lerp(hsv(r(), 0.3, 0.8), 0.4)
	P("Lobby", BLOCK, V(1.9, 0.5, 1.9) * s, CF(0, 0.25 * s, 0), C(60, 60, 70), M.Granite)
	P("Tower", BLOCK, V(1.8, h, 1.8) * s, CF(0, (h / 2 + 0.25) * s, 0), col, M.Concrete)
	local floors = math.floor(h / 0.5)
	for f = 1, floors - 1 do
		P("Glass", BLOCK, V(1.84, 0.22, 1.84) * s, CF(0, (f * 0.5 + 0.25) * s, 0), GLASS, M.Glass)
	end
	for _, x in ipairs({ -0.9, 0.9 }) do
		for _, z in ipairs({ -0.9, 0.9 }) do
			P("Pillar", BLOCK, V(0.12, h, 0.12) * s, CF(x * s, (h / 2 + 0.25) * s, z * s), col:Lerp(C(0, 0, 0), 0.2), M.Concrete)
		end
	end
	P("Roof", BLOCK, V(1.2, 0.3, 1.2) * s, CF(0, (h + 0.4) * s, 0), C(90, 90, 100), M.Metal)
	P("Tank", CYL, V(0.4 * s, 0.4 * s, 0.4 * s), CF(0.4 * s, (h + 0.75) * s, 0.4 * s) * UP, C(150, 150, 160), M.Metal)
	P("Helipad", CYL, V(0.05 * s, 0.9 * s, 0.9 * s), CF(-0.3 * s, (h + 0.57) * s, -0.3 * s) * UP, C(220, 220, 80), M.Neon)
	P("Antenna", CYL, V(0.9 * s, 0.05 * s, 0.05 * s), CF(0, (h + 1.0) * s, 0) * UP, C(200, 50, 50), M.Neon)
end

builders.tower = function(P, s, _r)
	P("Base", BLOCK, V(1.6, 1.0, 1.6) * s, CF(0, 0.5 * s, 0), C(180, 175, 170), M.Concrete)
	for _, x in ipairs({ -0.5, 0.5 }) do
		for _, z in ipairs({ -0.5, 0.5 }) do
			P("Leg", BLOCK, V(0.15, 2.5, 0.15) * s, CF(x * 0.6 * s, 2.0 * s, z * 0.6 * s) * CFrame.Angles(z * 0.15, 0, -x * 0.15), C(200, 200, 205), M.Metal)
		end
	end
	P("Shaft", CYL, V(5.5 * s, 0.6 * s, 0.6 * s), CF(0, 3.2 * s, 0) * UP, C(220, 220, 225), M.Concrete)
	P("Pod", BALL, V(1.6, 1.2, 1.6) * s, CF(0, 4.6 * s, 0), C(230, 90, 80), M.Metal)
	P("Deck", CYL, V(0.15 * s, 2.0 * s, 2.0 * s), CF(0, 4.6 * s, 0) * UP, C(140, 200, 255), M.Neon)
	P("Pod2", BALL, V(0.8, 0.6, 0.8) * s, CF(0, 5.6 * s, 0), C(230, 90, 80), M.Metal)
	P("Spire", CYL, V(1.6 * s, 0.12 * s, 0.12 * s), CF(0, 6.4 * s, 0) * UP, C(240, 240, 240), M.Metal)
	P("Tip", BALL, V(0.25, 0.25, 0.25) * s, CF(0, 7.2 * s, 0), C(255, 60, 60), M.Neon)
end

builders.stadium = function(P, s, _r)
	P("Field", CYL, V(0.2 * s, 3.0 * s, 3.0 * s), CF(0, 0.1 * s, 0) * UP, C(70, 160, 70), M.Grass)
	P("Line", BLOCK, V(0.04, 0.05, 2.4) * s, CF(0, 0.21 * s, 0), WHITE, M.SmoothPlastic)
	P("Circle", CYL, V(0.04 * s, 0.6 * s, 0.6 * s), CF(0, 0.21 * s, 0) * UP, WHITE, M.SmoothPlastic).Transparency = 0.3
	for _, z in ipairs({ -1.2, 1.2 }) do
		P("Goal", BLOCK, V(0.5, 0.25, 0.05) * s, CF(0, 0.33 * s, z * s), WHITE, M.Metal)
	end
	for i = 0, 19 do
		local a = i / 20 * math.pi * 2
		P("Stand", BLOCK, V(0.75, 1.0, 1.25) * s, CF(math.cos(a) * 1.75 * s, 0.5 * s, math.sin(a) * 1.75 * s) * CFrame.Angles(0, -a, math.rad(-12)), (i % 2 == 0) and C(230, 230, 235) or C(200, 60, 60), M.Concrete)
	end
	for i = 0, 3 do
		local a = i / 4 * math.pi * 2 + 0.4
		P("Mast", BLOCK, V(0.1, 2.4, 0.1) * s, CF(math.cos(a) * 2.1 * s, 1.2 * s, math.sin(a) * 2.1 * s), C(80, 80, 90), M.Metal)
		P("Lamp", BLOCK, V(0.5, 0.25, 0.1) * s, CF(math.cos(a) * 2.1 * s, 2.4 * s, math.sin(a) * 2.1 * s) * CFrame.Angles(0, -a, 0), C(255, 250, 220), M.Neon)
	end
	P("Screen", BLOCK, V(1.0, 0.5, 0.06) * s, CF(0, 1.4 * s, 1.9 * s), C(60, 200, 255), M.Neon)
end

builders.ferris = function(P, s, _r)
	local center = CF(0, 2.3 * s, 0)
	for _, z in ipairs({ -0.3, 0.3 }) do
		P("Leg", BLOCK, V(0.12, 2.6, 0.12) * s, CF(-0.6 * s, 1.1 * s, z * s) * CFrame.Angles(0, 0, math.rad(-20)), C(80, 80, 90), M.Metal)
		P("Leg", BLOCK, V(0.12, 2.6, 0.12) * s, CF(0.6 * s, 1.1 * s, z * s) * CFrame.Angles(0, 0, math.rad(20)), C(80, 80, 90), M.Metal)
	end
	P("Booth", BLOCK, V(0.8, 0.5, 0.5) * s, CF(0, 0.25 * s, -0.9 * s), C(220, 60, 60), M.SmoothPlastic)
	P("Axle", CYL, V(0.8 * s, 0.25 * s, 0.25 * s), center * CFrame.Angles(0, math.rad(90), 0), C(200, 200, 210), M.Metal)
	for _, z in ipairs({ -0.2, 0.2 }) do
		P("Rim", CYL, V(0.06 * s, 4.0 * s, 4.0 * s), center * CF(0, 0, z * s) * CFrame.Angles(0, math.rad(90), 0), C(240, 240, 250), M.Metal).Transparency = 0.5
	end
	for i = 0, 11 do
		local a = i / 12 * math.pi * 2
		local pos = center * CF(math.cos(a) * 1.9 * s, math.sin(a) * 1.9 * s, 0)
		P("Spoke", BLOCK, V(0.05, 1.9, 0.05) * s, center * CFrame.Angles(0, 0, a - math.pi / 2) * CF(0, 0.95 * s, 0), C(220, 220, 230), M.Metal)
		P("Cabin", BLOCK, V(0.4, 0.35, 0.45) * s, pos * CF(0, -0.25 * s, 0), Color3.fromHSV(i / 12, 0.7, 1), M.SmoothPlastic)
		P("Bulb", BALL, V(0.1, 0.1, 0.1) * s, pos, C(255, 240, 180), M.Neon)
	end
end

------------------------------------------------------------------------
-- 5 바다와 산
------------------------------------------------------------------------
builders.ship = function(P, s, r)
	P("Hull", BLOCK, V(1.4, 0.8, 3.8) * s, CF(0, 0.4 * s, 0), C(40, 50, 80), M.Metal)
	P("Waterline", BLOCK, V(1.42, 0.15, 3.82) * s, CF(0, 0.12 * s, 0), C(180, 40, 40), M.Metal)
	P("Bow", BLOCK, V(1.0, 0.8, 1.0) * s, CF(0, 0.4 * s, -2.1 * s) * CFrame.Angles(0, math.rad(45), 0), C(40, 50, 80), M.Metal)
	P("Deck", BLOCK, V(1.3, 0.1, 3.6) * s, CF(0, 0.85 * s, 0), C(180, 140, 100), M.WoodPlanks)
	P("Cabin", BLOCK, V(1.0, 0.8, 1.2) * s, CF(0, 1.3 * s, 0.8 * s), WHITE, M.SmoothPlastic)
	P("Bridge", BLOCK, V(0.9, 0.4, 0.8) * s, CF(0, 1.9 * s, 0.7 * s), WHITE, M.SmoothPlastic)
	P("BridgeGlass", BLOCK, V(0.85, 0.2, 0.05) * s, CF(0, 1.95 * s, 0.29 * s), GLASS, M.Glass)
	for i = -2, 2 do
		for _, x in ipairs({ -0.51, 0.51 }) do
			P("Porthole", CYL, V(0.04 * s, 0.15 * s, 0.15 * s), CF(x * s, 1.3 * s, (0.8 + i * 0.22) * s), GLASS, M.Glass)
		end
	end
	local col = (r() < 0.5) and C(220, 60, 50) or C(240, 200, 60)
	for i = 0, 1 do
		P("Funnel", CYL, V(0.8 * s, 0.35 * s, 0.35 * s), CF(0, 2.3 * s, (0.6 + i * 0.6) * s) * UP, col, M.Metal)
		P("FunnelTop", CYL, V(0.1 * s, 0.38 * s, 0.38 * s), CF(0, 2.7 * s, (0.6 + i * 0.6) * s) * UP, DARK, M.Metal)
	end
	P("Mast", BLOCK, V(0.08, 1.2, 0.08) * s, CF(0, 1.4 * s, -1.3 * s), C(150, 150, 160), M.Metal)
	for i = 0, 2 do
		P("Crate", BLOCK, V(0.3, 0.3, 0.3) * s, CF((-0.3 + i * 0.3) * s, 1.05 * s, -0.9 * s), hsv(i * 0.3, 0.6, 0.8), M.Wood)
	end
	P("Lifeboat", BLOCK, V(0.2, 0.15, 0.5) * s, CF(0.6 * s, 1.5 * s, 1.3 * s), C(255, 140, 40), M.SmoothPlastic)
end

builders.lighthouse = function(P, s, _r)
	P("Rock", BALL, V(2.4, 1.0, 2.4) * s, CF(0, 0.3 * s, 0), C(110, 105, 100), M.Slate)
	P("Rock2", BALL, V(1.2, 0.7, 1.0) * s, CF(1.0 * s, 0.25 * s, 0.6 * s), C(95, 90, 85), M.Slate)
	P("House", BLOCK, V(0.8, 0.6, 0.6) * s, CF(0.8 * s, 0.9 * s, 0), WHITE, M.Plaster)
	P("HouseRoof", BLOCK, V(0.9, 0.12, 0.7) * s, CF(0.8 * s, 1.25 * s, 0), C(200, 50, 50), M.Slate)
	for i = 0, 4 do
		P("Ring", CYL, V(0.9 * s, (1.1 - i * 0.12) * s, (1.1 - i * 0.12) * s), CF(0, (1.0 + i * 0.9) * s, 0) * UP, (i % 2 == 0) and WHITE or C(220, 50, 50), M.SmoothPlastic)
	end
	P("Balcony", CYL, V(0.1 * s, 1.0 * s, 1.0 * s), CF(0, 5.2 * s, 0) * UP, DARK, M.Metal)
	for i = 0, 7 do
		local a = i / 8 * math.pi * 2
		P("Railing", BLOCK, V(0.05, 0.3, 0.05) * s, CF(math.cos(a) * 0.48 * s, 5.4 * s, math.sin(a) * 0.48 * s), DARK, M.Metal)
	end
	local lamp = P("Lamp", CYL, V(0.6 * s, 0.6 * s, 0.6 * s), CF(0, 5.6 * s, 0) * UP, C(255, 240, 160), M.Neon)
	local light = Instance.new("SpotLight")
	light.Range = 3 * s
	light.Brightness = 3
	light.Face = Enum.NormalId.Front
	light.Parent = lamp
	P("Cap", BALL, V(0.8, 0.5, 0.8) * s, CF(0, 6.0 * s, 0), C(60, 60, 70), M.Metal)
	P("Vane", BLOCK, V(0.04, 0.4, 0.04) * s, CF(0, 6.4 * s, 0), DARK, M.Metal)
end

builders.island = function(P, s, r)
	P("Sea", CYL, V(0.2 * s, 4.4 * s, 4.4 * s), CF(0, 0.1 * s, 0) * UP, C(70, 170, 210), M.Glass).Transparency = 0.2
	P("Sand", CYL, V(0.6 * s, 4.0 * s, 4.0 * s), CF(0, 0.3 * s, 0) * UP, C(235, 215, 160), M.Sand)
	P("Hill", BALL, V(2.6, 1.2, 2.4) * s, CF(0.3 * s, 0.7 * s, 0), C(90, 160, 70), M.Grass)
	P("Rock", BALL, V(0.7, 0.5, 0.6) * s, CF(-1.4 * s, 0.6 * s, 0.6 * s), C(120, 115, 110), M.Slate)
	P("Hut", BLOCK, V(0.6, 0.45, 0.6) * s, CF(-0.9 * s, 0.85 * s, -0.8 * s), C(190, 150, 100), M.WoodPlanks)
	P("HutRoof", BLOCK, V(0.75, 0.1, 0.75) * s, CF(-0.9 * s, 1.15 * s, -0.8 * s) * CFrame.Angles(0, math.rad(45), 0), C(200, 170, 90), M.Fabric)
	P("Chest", BLOCK, V(0.35, 0.25, 0.25) * s, CF(1.4 * s, 0.75 * s, -0.8 * s), C(150, 100, 50), M.Wood)
	for i = 0, 2 do
		local a = i * 2.2 + r()
		local base = CF(math.cos(a) * 1.2 * s, 0.6 * s, math.sin(a) * 1.2 * s)
		P("Palm", CYL, V(1.4 * s, 0.12 * s, 0.12 * s), base * CF(0, 0.7 * s, 0) * UP * CFrame.Angles(0, 0, math.rad(8)), C(140, 100, 60), M.Wood)
		for k = 0, 5 do
			local b = k / 6 * math.pi * 2
			P("Frond", BLOCK, V(0.9, 0.05, 0.25) * s, base * CF(0, 1.45 * s, 0) * CFrame.Angles(0, b, math.rad(-25)) * CF(0.4 * s, 0, 0), C(60, 150, 60), M.Grass)
		end
		P("Coconut", BALL, V(0.15, 0.15, 0.15) * s, base * CF(0.1 * s, 1.35 * s, 0), C(110, 80, 50), M.Wood)
	end
end

builders.mountain = function(P, s, r)
	P("Grass", CYL, V(0.2 * s, 4.0 * s, 4.0 * s), CF(0, 0.1 * s, 0) * UP, C(90, 140, 70), M.Grass)
	P("Peak", BLOCK, V(3.2, 3.2, 3.2) * s, CF(0, 0.6 * s, 0) * CFrame.Angles(math.rad(45), math.rad(r() * 40), math.rad(35)), C(115, 105, 100), M.Rock)
	P("Peak2", BLOCK, V(2.2, 2.2, 2.2) * s, CF(1.1 * s, 0.4 * s, 0.6 * s) * CFrame.Angles(math.rad(40), math.rad(20), math.rad(40)), C(100, 95, 90), M.Rock)
	P("Peak3", BLOCK, V(1.8, 1.8, 1.8) * s, CF(-1.0 * s, 0.3 * s, -0.7 * s) * CFrame.Angles(math.rad(30), math.rad(50), math.rad(45)), C(105, 98, 92), M.Rock)
	P("Snow", BLOCK, V(1.1, 1.1, 1.1) * s, CF(0, 2.7 * s, 0) * CFrame.Angles(math.rad(45), 0, math.rad(35)), C(250, 250, 255), M.Snow)
	P("Snow2", BLOCK, V(0.7, 0.7, 0.7) * s, CF(1.1 * s, 1.75 * s, 0.6 * s) * CFrame.Angles(math.rad(40), math.rad(20), math.rad(40)), C(250, 250, 255), M.Snow)
	for i = 0, 5 do
		local a = i / 6 * math.pi * 2 + 0.3
		P("Pine", BLOCK, V(0.3, 0.6, 0.3) * s, CF(math.cos(a) * 1.7 * s, 0.4 * s, math.sin(a) * 1.7 * s) * CFrame.Angles(0, math.rad(45), 0), C(40, 100, 50), M.Grass)
	end
	P("Cabin", BLOCK, V(0.35, 0.25, 0.3) * s, CF(1.5 * s, 0.3 * s, -1.0 * s), C(140, 90, 50), M.WoodPlanks)
end

------------------------------------------------------------------------
-- 6 우주
------------------------------------------------------------------------
builders.satellite = function(P, s, _r)
	local y = 1.4 * s
	P("Body", BLOCK, V(0.9, 0.9, 1.2) * s, CF(0, y, 0), C(230, 200, 90), M.Foil)
	P("Band", BLOCK, V(0.95, 0.15, 1.25) * s, CF(0, y, 0), C(80, 80, 90), M.Metal)
	for _, x in ipairs({ -1, 1 }) do
		P("Panel", BLOCK, V(1.6, 0.05, 0.8) * s, CF(x * 1.3 * s, y, 0), C(40, 60, 140), M.Glass)
		for k = -2, 2 do
			P("Cell", BLOCK, V(0.03, 0.06, 0.78) * s, CF((x * 1.3 + k * 0.3) * s, y, 0), C(150, 150, 170), M.Metal)
		end
		P("Arm", BLOCK, V(0.5, 0.06, 0.06) * s, CF(x * 0.6 * s, y, 0), C(200, 200, 210), M.Metal)
	end
	P("Dish", CYL, V(0.1 * s, 0.9 * s, 0.9 * s), CF(0, y + 0.7 * s, 0) * UP, C(240, 240, 245), M.Metal)
	P("Feed", BLOCK, V(0.05, 0.4, 0.05) * s, CF(0, y + 0.9 * s, 0), C(150, 150, 160), M.Metal)
	P("Thruster", CYL, V(0.25 * s, 0.25 * s, 0.25 * s), CF(0, y - 0.6 * s, 0) * UP, DARK, M.Metal)
	P("Blink", BALL, V(0.15, 0.15, 0.15) * s, CF(0, y - 0.5 * s, -0.6 * s), C(255, 60, 60), M.Neon)
end

builders.asteroid = function(P, s, r)
	local col = C(110, 100, 95):Lerp(C(140, 110, 90), r())
	P("Rock", BALL, V(2.0, 1.6, 1.8) * s, CF(0, 1.0 * s, 0), col, M.Slate)
	for i = 0, 6 do
		local a = i / 7 * math.pi * 2
		P("Lump", BALL, V(0.9, 0.8, 0.9) * s, CF(math.cos(a) * 0.8 * s, (1.0 + math.sin(a * 1.7) * 0.45) * s, math.sin(a) * 0.7 * s), col:Lerp(C(0, 0, 0), 0.15), M.Slate)
	end
	for i = 0, 3 do
		local a = i * 1.5
		local dir = V(math.cos(a), math.sin(i), math.sin(a)).Unit
		local pos = V(0, s, 0) + dir * 0.9 * s
		P("Crater", CYL, V(0.05 * s, 0.4 * s, 0.4 * s), CFrame.lookAt(pos, pos + dir) * CFrame.Angles(0, math.rad(90), 0), C(70, 65, 60), M.Slate)
	end
	P("Ore", BLOCK, V(0.3, 0.3, 0.3) * s, CF(0.5 * s, 1.7 * s, 0.2 * s) * CFrame.Angles(0.5, 0.5, 0), C(120, 220, 255), M.Neon)
end

builders.moon = function(P, s, _r)
	P("Moon", BALL, V(2, 2, 2) * s, CF(0, 1.0 * s, 0), C(215, 215, 210), M.Slate)
	for i = 0, 9 do
		local a = i * 1.7
		local dir = V(math.cos(a), math.sin(i * 0.9) * 0.7, math.sin(a)).Unit
		local pos = V(0, 1.0 * s, 0) + dir * 0.98 * s
		local d = (0.25 + (i % 3) * 0.12) * s
		P("Crater", CYL, V(0.05 * s, d, d), CFrame.lookAt(pos, pos + dir) * CFrame.Angles(0, math.rad(90), 0), C(170, 170, 165), M.Slate)
	end
	P("Flag", BLOCK, V(0.02, 0.15, 0.25) * s, CF(0.1 * s, 2.1 * s, 0), C(220, 50, 50), M.Fabric)
	P("FlagPole", BLOCK, V(0.02, 0.3, 0.02) * s, CF(0, 2.05 * s, 0), C(200, 200, 200), M.Metal)
end

builders.planet = function(P, s, r)
	local col = hsv(r(), 0.55, 0.85)
	P("Planet", BALL, V(2, 2, 2) * s, CF(0, 1.0 * s, 0), col, M.SmoothPlastic)
	for i = 0, 3 do
		P("Band", CYL, V(0.15 * s, 2.02 * s, 2.02 * s), CF(0, (0.5 + i * 0.33) * s, 0) * UP, col:Lerp(WHITE, 0.2 + i * 0.08), M.SmoothPlastic).Transparency = 0.15
	end
	P("Storm", BALL, V(0.4, 0.25, 0.1) * s, CF(0.3 * s, 0.9 * s, -0.95 * s), col:Lerp(C(180, 60, 40), 0.6), M.SmoothPlastic)
	if r() < 0.6 then
		P("Ring", CYL, V(0.05 * s, 3.4 * s, 3.4 * s), CF(0, 1.0 * s, 0) * CFrame.Angles(math.rad(15), 0, math.rad(90)), C(230, 210, 170), M.Glass).Transparency = 0.25
		P("Ring2", CYL, V(0.04 * s, 3.0 * s, 3.0 * s), CF(0, 1.0 * s, 0) * CFrame.Angles(math.rad(15), 0, math.rad(90)), C(200, 170, 130), M.Glass).Transparency = 0.4
	end
	P("Moonlet", BALL, V(0.3, 0.3, 0.3) * s, CF(1.4 * s, 1.6 * s, 0.3 * s), C(200, 200, 200), M.Slate)
end

builders.sun = function(P, s, _r)
	local core = P("Sun", BALL, V(2, 2, 2) * s, CF(0, 1.0 * s, 0), C(255, 190, 60), M.Neon)
	P("Corona", BALL, V(2.3, 2.3, 2.3) * s, CF(0, 1.0 * s, 0), C(255, 120, 40), M.ForceField).Transparency = 0.3
	for i = 0, 5 do
		local a = i / 6 * math.pi * 2
		P("Flare", BALL, V(0.5, 0.25, 0.25) * s, CF(math.cos(a) * 1.1 * s, (1.0 + math.sin(a * 2) * 0.4) * s, math.sin(a) * 1.1 * s), C(255, 230, 120), M.Neon)
	end
	local light = Instance.new("PointLight")
	light.Range = 60
	light.Brightness = 3
	light.Color = C(255, 200, 120)
	light.Parent = core
	local pe = Instance.new("ParticleEmitter")
	pe.Rate = 20
	pe.Lifetime = NumberRange.new(1, 2)
	pe.Speed = NumberRange.new(0.1 * s, 0.2 * s)
	pe.SpreadAngle = Vector2.new(180, 180)
	pe.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.2 * s), NumberSequenceKeypoint.new(1, 0) })
	pe.LightEmission = 1
	pe.Color = ColorSequence.new(C(255, 230, 120), C(255, 100, 40))
	pe.Parent = core
end

------------------------------------------------------------------------
-- 세계 2: 과자 왕국
------------------------------------------------------------------------
local PASTEL = { C(255, 150, 190), C(150, 220, 255), C(255, 230, 130), C(180, 240, 160), C(220, 170, 255), C(255, 180, 120) }
local function pastel(r: () -> number): Color3
	return PASTEL[math.floor(r() * #PASTEL) + 1]
end

builders.gummy = function(P, s, r)
	local col = pastel(r)
	local function g(name: string, sz: Vector3, cf: CFrame)
		P(name, BALL, sz * s, cf, col, M.Glass).Transparency = 0.15
	end
	g("Body", V(1.2, 1.4, 1.0), CF(0, 0.75 * s, 0))
	g("Head", V(1.0, 0.9, 0.9), CF(0, 1.7 * s, 0))
	for _, x in ipairs({ -0.35, 0.35 }) do
		g("Ear", V(0.35, 0.35, 0.3), CF(x * s, 2.1 * s, 0))
		g("Arm", V(0.35, 0.5, 0.35), CF(x * 1.6 * s, 1.0 * s, 0))
		g("Leg", V(0.4, 0.4, 0.4), CF(x * s, 0.2 * s, 0))
	end
	P("Nose", BALL, V(0.2, 0.15, 0.15) * s, CF(0, 1.6 * s, -0.45 * s), col:Lerp(C(0, 0, 0), 0.3), M.SmoothPlastic)
end

builders.candy = function(P, s, r)
	local col = pastel(r)
	P("Candy", BALL, V(1.4, 1.0, 1.0) * s, CF(0, 0.5 * s, 0), col, M.SmoothPlastic)
	for _, x in ipairs({ -1, 1 }) do
		P("Wrap", BLOCK, V(0.5, 0.7, 0.05) * s, CF(x * 0.9 * s, 0.5 * s, 0) * CFrame.Angles(0, math.rad(90), 0), col:Lerp(WHITE, 0.4), M.Foil)
	end
	P("Stripe", BALL, V(1.42, 0.2, 1.02) * s, CF(0, 0.5 * s, 0) * CFrame.Angles(0, 0, math.rad(60)), WHITE, M.SmoothPlastic)
end

builders.lollipop = function(P, s, r)
	local col = pastel(r)
	P("Stick", CYL, V(2.0 * s, 0.12 * s, 0.12 * s), CF(0, 1.0 * s, 0) * UP, WHITE, M.SmoothPlastic)
	P("Disc", CYL, V(0.3 * s, 1.5 * s, 1.5 * s), CF(0, 2.4 * s, 0) * CFrame.Angles(0, math.rad(90), 0), col, M.SmoothPlastic)
	for i = 0, 2 do
		P("Swirl", CYL, V(0.32 * s, (1.2 - i * 0.35) * s, (1.2 - i * 0.35) * s), CF(0, 2.4 * s, 0) * CFrame.Angles(0, math.rad(90), 0), (i % 2 == 0) and WHITE or col:Lerp(C(255, 255, 255), 0.3), M.SmoothPlastic)
	end
	P("Bow", BALL, V(0.4, 0.25, 0.2) * s, CF(0, 1.55 * s, 0), C(255, 80, 120), M.Fabric)
end

builders.macaron = function(P, s, r)
	local col = pastel(r)
	P("Bottom", CYL, V(0.5 * s, 1.8 * s, 1.8 * s), CF(0, 0.25 * s, 0) * UP, col, M.SmoothPlastic)
	P("Cream", CYL, V(0.3 * s, 1.6 * s, 1.6 * s), CF(0, 0.65 * s, 0) * UP, WHITE, M.SmoothPlastic)
	P("Top", BALL, V(1.8, 0.7, 1.8) * s, CF(0, 0.95 * s, 0), col, M.SmoothPlastic)
	P("Ruffle", CYL, V(0.12 * s, 1.85 * s, 1.85 * s), CF(0, 0.52 * s, 0) * UP, col:Lerp(C(0, 0, 0), 0.1), M.Sand)
end

builders.cupcake = function(P, s, r)
	P("Cup", CYL, V(1.2 * s, 1.6 * s, 1.6 * s), CF(0, 0.6 * s, 0) * UP, C(255, 255, 255):Lerp(pastel(r), 0.5), M.Fabric)
	for i = 0, 11 do
		local a = i / 12 * math.pi * 2
		P("Pleat", BLOCK, V(0.06, 1.2, 0.1) * s, CF(math.cos(a) * 0.8 * s, 0.6 * s, math.sin(a) * 0.8 * s) * CFrame.Angles(0, -a, 0), C(240, 240, 240), M.Fabric)
	end
	local cream = pastel(r)
	P("Cream", BALL, V(1.9, 0.9, 1.9) * s, CF(0, 1.4 * s, 0), cream, M.SmoothPlastic)
	P("Cream2", BALL, V(1.3, 0.7, 1.3) * s, CF(0, 1.85 * s, 0), cream:Lerp(WHITE, 0.2), M.SmoothPlastic)
	P("Cherry", BALL, V(0.45, 0.45, 0.45) * s, CF(0, 2.35 * s, 0), C(220, 30, 50), M.SmoothPlastic)
	for i = 0, 7 do
		local a = i * 0.8
		P("Sprinkle", BLOCK, V(0.25, 0.06, 0.06) * s, CF(math.cos(a) * 0.6 * s, 1.75 * s, math.sin(a) * 0.6 * s) * CFrame.Angles(0, a, 0.3), PASTEL[(i % #PASTEL) + 1], M.Neon)
	end
end

builders.donut = function(P, s, r)
	for i = 0, 11 do
		local a = i / 12 * math.pi * 2
		P("Dough", BALL, V(1.0, 0.7, 1.0) * s, CF(math.cos(a) * 1.05 * s, 0.4 * s, math.sin(a) * 1.05 * s), C(210, 160, 100), M.SmoothPlastic)
	end
	local icing = pastel(r)
	for i = 0, 11 do
		local a = i / 12 * math.pi * 2 + 0.2
		P("Icing", BALL, V(0.95, 0.35, 0.95) * s, CF(math.cos(a) * 1.05 * s, 0.68 * s, math.sin(a) * 1.05 * s), icing, M.SmoothPlastic)
	end
	for i = 0, 9 do
		local a = i * 0.65
		P("Sprinkle", BLOCK, V(0.25, 0.06, 0.06) * s, CF(math.cos(a) * 1.05 * s, 0.86 * s, math.sin(a) * 1.05 * s) * CFrame.Angles(0, a * 2, 0), PASTEL[(i % #PASTEL) + 1], M.Neon)
	end
end

builders.cookie = function(P, s, _r)
	P("Cookie", CYL, V(0.4 * s, 2.8 * s, 2.8 * s), CF(0, 1.4 * s, 0) * CFrame.Angles(0, math.rad(90), math.rad(10)), C(210, 160, 100), M.Sand)
	for i = 0, 8 do
		local a = i * 0.9
		local rr = (0.3 + (i % 3) * 0.35) * s
		P("Chip", BALL, V(0.3, 0.3, 0.2) * s, CF(math.cos(a) * rr, 1.4 * s + math.sin(a) * rr, -0.22 * s), C(80, 50, 30), M.SmoothPlastic)
	end
	P("Stand", BLOCK, V(0.6, 0.3, 0.6) * s, CF(0, 0.15 * s, 0.2 * s), C(190, 140, 90), M.Sand)
end

builders.pudding = function(P, s, _r)
	P("Plate", CYL, V(0.15 * s, 2.6 * s, 2.6 * s), CF(0, 0.08 * s, 0) * UP, WHITE, M.SmoothPlastic)
	P("Pudding", CYL, V(1.6 * s, 1.8 * s, 1.8 * s), CF(0, 0.95 * s, 0) * UP, C(255, 220, 120), M.SmoothPlastic)
	P("Top", CYL, V(0.3 * s, 1.5 * s, 1.5 * s), CF(0, 1.85 * s, 0) * UP, C(150, 80, 30), M.SmoothPlastic)
	for i = 0, 5 do
		local a = i / 6 * math.pi * 2
		P("Drip", BALL, V(0.3, 0.5, 0.3) * s, CF(math.cos(a) * 0.85 * s, 1.55 * s, math.sin(a) * 0.85 * s), C(150, 80, 30), M.SmoothPlastic)
	end
	P("Cream", BALL, V(0.6, 0.4, 0.6) * s, CF(0, 2.1 * s, 0), WHITE, M.SmoothPlastic)
	P("Cherry", BALL, V(0.3, 0.3, 0.3) * s, CF(0, 2.35 * s, 0), C(220, 30, 50), M.SmoothPlastic)
end

builders.icecream = function(P, s, r)
	P("Cone", CYL, V(2.2 * s, 0.9 * s, 0.9 * s), CF(0, 1.1 * s, 0) * UP, C(220, 170, 100), M.Sand)
	for i = 0, 3 do
		P("Grid", CYL, V(0.06 * s, 0.95 * s, 0.95 * s), CF(0, (0.4 + i * 0.5) * s, 0) * UP, C(190, 140, 80), M.Sand)
	end
	for i = 0, 2 do
		P("Scoop", BALL, V(1.4, 1.2, 1.4) * s, CF(0, (2.6 + i * 0.95) * s, 0), pastel(r), M.SmoothPlastic)
	end
	P("Drip", BALL, V(0.3, 0.6, 0.3) * s, CF(0.55 * s, 2.3 * s, -0.3 * s), C(255, 200, 220), M.SmoothPlastic)
	P("Wafer", BLOCK, V(0.2, 0.9, 0.5) * s, CF(0.4 * s, 4.6 * s, 0) * CFrame.Angles(0, 0, math.rad(-20)), C(230, 190, 120), M.Sand)
	P("Cherry", BALL, V(0.35, 0.35, 0.35) * s, CF(-0.1 * s, 4.75 * s, 0), C(220, 30, 50), M.SmoothPlastic)
end

builders.cottontree = function(P, s, r)
	P("Stick", CYL, V(2.4 * s, 0.3 * s, 0.3 * s), CF(0, 1.2 * s, 0) * UP, C(250, 240, 230), M.SmoothPlastic)
	P("Stripe", CYL, V(2.4 * s, 0.32 * s, 0.32 * s), CF(0, 1.2 * s, 0) * UP, C(255, 120, 150), M.SmoothPlastic).Transparency = 0.5
	local col = pastel(r)
	for i = 0, 6 do
		local a = i / 7 * math.pi * 2
		P("Floss", BALL, V(1.4, 1.3, 1.4) * s, CF(math.cos(a) * 0.9 * s, (3.1 + math.sin(a * 2) * 0.3) * s, math.sin(a) * 0.9 * s), col:Lerp(WHITE, (i % 3) * 0.15), M.Fabric)
	end
	P("Top", BALL, V(1.6, 1.4, 1.6) * s, CF(0, 3.7 * s, 0), col:Lerp(WHITE, 0.2), M.Fabric)
end

builders.gingerhouse = function(P, s, r)
	local dough = C(190, 120, 70)
	P("Walls", BLOCK, V(2.6, 1.8, 2.4) * s, CF(0, 0.9 * s, 0), dough, M.Sand)
	for _, x in ipairs({ -1.3, 1.3 }) do
		P("Icing", BLOCK, V(0.1, 1.8, 2.45) * s, CF(x * s, 0.9 * s, 0), WHITE, M.SmoothPlastic)
	end
	P("RoofL", BLOCK, V(1.75, 0.25, 2.75) * s, CF(-0.65 * s, 2.15 * s, 0) * CFrame.Angles(0, 0, math.rad(38)), C(120, 70, 40), M.Sand)
	P("RoofR", BLOCK, V(1.75, 0.25, 2.75) * s, CF(0.65 * s, 2.15 * s, 0) * CFrame.Angles(0, 0, math.rad(-38)), C(120, 70, 40), M.Sand)
	for i = -3, 3 do
		P("Snow", BALL, V(0.4, 0.25, 0.4) * s, CF(0, 2.7 * s, i * 0.37 * s), WHITE, M.SmoothPlastic)
	end
	P("Door", BLOCK, V(0.6, 1.0, 0.05) * s, CF(0, 0.5 * s, -1.21 * s), C(255, 120, 150), M.SmoothPlastic)
	for _, x in ipairs({ -0.85, 0.85 }) do
		P("Window", BLOCK, V(0.5, 0.5, 0.05) * s, CF(x * s, 1.1 * s, -1.22 * s), C(255, 240, 160), M.Neon)
		P("Gum", BALL, V(0.25, 0.25, 0.25) * s, CF(x * s, 1.55 * s, -1.25 * s), pastel(r), M.SmoothPlastic)
	end
	for i = 0, 3 do
		P("CaneL", CYL, V(1.2 * s, 0.12 * s, 0.12 * s), CF((-1.1 + i * 0.73) * s, 0.6 * s, -1.4 * s) * UP, (i % 2 == 0) and C(220, 40, 60) or WHITE, M.SmoothPlastic)
	end
end

builders.candycar = function(P, s, r)
	local col = pastel(r)
	P("Body", BLOCK, V(1.7, 0.7, 3.4) * s, CF(0, 0.75 * s, 0), col, M.SmoothPlastic)
	P("Top", BALL, V(1.5, 0.9, 1.9) * s, CF(0, 1.3 * s, 0.2 * s), WHITE, M.SmoothPlastic)
	P("Cherry", BALL, V(0.4, 0.4, 0.4) * s, CF(0, 1.85 * s, 0.2 * s), C(220, 30, 50), M.SmoothPlastic)
	for _, x in ipairs({ -0.85, 0.85 }) do
		for _, z in ipairs({ -1.1, 1.1 }) do
			P("DonutWheel", CYL, V(0.3 * s, 0.8 * s, 0.8 * s), CF(x * s, 0.4 * s, z * s), C(210, 160, 100), M.SmoothPlastic)
			P("Hole", CYL, V(0.32 * s, 0.3 * s, 0.3 * s), CF(x * s, 0.4 * s, z * s), C(255, 150, 190), M.SmoothPlastic)
		end
	end
	P("Lamp", BALL, V(0.3, 0.3, 0.2) * s, CF(0.5 * s, 0.85 * s, -1.7 * s), C(255, 240, 160), M.Neon)
	P("Lamp2", BALL, V(0.3, 0.3, 0.2) * s, CF(-0.5 * s, 0.85 * s, -1.7 * s), C(255, 240, 160), M.Neon)
end

builders.cake = function(P, s, r)
	local col = pastel(r)
	P("Plate", CYL, V(0.15 * s, 3.4 * s, 3.4 * s), CF(0, 0.08 * s, 0) * UP, WHITE, M.SmoothPlastic)
	P("Layer1", CYL, V(1.0 * s, 3.0 * s, 3.0 * s), CF(0, 0.65 * s, 0) * UP, col, M.SmoothPlastic)
	P("Cream1", CYL, V(0.15 * s, 3.05 * s, 3.05 * s), CF(0, 1.15 * s, 0) * UP, WHITE, M.SmoothPlastic)
	P("Layer2", CYL, V(0.8 * s, 2.2 * s, 2.2 * s), CF(0, 1.6 * s, 0) * UP, col:Lerp(WHITE, 0.3), M.SmoothPlastic)
	for i = 0, 7 do
		local a = i / 8 * math.pi * 2
		P("Strawberry", BALL, V(0.35, 0.4, 0.35) * s, CF(math.cos(a) * 0.8 * s, 2.15 * s, math.sin(a) * 0.8 * s), C(230, 40, 60), M.SmoothPlastic)
	end
	P("Candle", CYL, V(0.5 * s, 0.12 * s, 0.12 * s), CF(0, 2.3 * s, 0) * UP, C(150, 200, 255), M.SmoothPlastic)
	P("Flame", BALL, V(0.15, 0.25, 0.15) * s, CF(0, 2.65 * s, 0), C(255, 200, 80), M.Neon)
end

builders.chocofountain = function(P, s, _r)
	local choco = C(110, 60, 30)
	P("Base", CYL, V(0.4 * s, 3.2 * s, 3.2 * s), CF(0, 0.2 * s, 0) * UP, C(230, 220, 210), M.Marble)
	P("Pool", CYL, V(0.1 * s, 2.9 * s, 2.9 * s), CF(0, 0.42 * s, 0) * UP, choco, M.SmoothPlastic)
	for i = 0, 2 do
		P("Tier", CYL, V(0.2 * s, (2.0 - i * 0.6) * s, (2.0 - i * 0.6) * s), CF(0, (1.0 + i * 0.8) * s, 0) * UP, C(230, 220, 210), M.Marble)
		P("Flow", CYL, V(0.7 * s, (1.9 - i * 0.6) * s, (1.9 - i * 0.6) * s), CF(0, (0.7 + i * 0.8) * s, 0) * UP, choco, M.SmoothPlastic).Transparency = 0.2
	end
	P("Column", CYL, V(2.6 * s, 0.3 * s, 0.3 * s), CF(0, 1.5 * s, 0) * UP, C(230, 220, 210), M.Marble)
	for i = 0, 5 do
		local a = i / 6 * math.pi * 2
		P("Marshmallow", CYL, V(0.3 * s, 0.25 * s, 0.25 * s), CF(math.cos(a) * 1.5 * s, 0.6 * s, math.sin(a) * 1.5 * s) * UP, WHITE, M.SmoothPlastic)
	end
end

builders.weddingcake = function(P, s, _r)
	for i = 0, 4 do
		local d = (3.0 - i * 0.55) * s
		P("Tier", CYL, V(0.8 * s, d, d), CF(0, (0.4 + i * 0.85) * s, 0) * UP, WHITE, M.SmoothPlastic)
		P("Ribbon", CYL, V(0.12 * s, d * 1.01, d * 1.01), CF(0, (0.15 + i * 0.85) * s, 0) * UP, C(255, 180, 200), M.SmoothPlastic)
		for k = 0, 5 do
			local a = k / 6 * math.pi * 2 + i
			P("Pearl", BALL, V(0.15, 0.15, 0.15) * s, CF(math.cos(a) * d * 0.5, (0.8 + i * 0.85) * s, math.sin(a) * d * 0.5), C(255, 240, 220), M.Pebble)
		end
	end
	P("Heart", BALL, V(0.5, 0.5, 0.2) * s, CF(0, 4.7 * s, 0), C(255, 80, 120), M.Neon)
end

builders.lollitower = function(P, s, r)
	P("Stick", CYL, V(5.0 * s, 0.25 * s, 0.25 * s), CF(0, 2.5 * s, 0) * UP, WHITE, M.SmoothPlastic)
	for i = 0, 5 do
		P("Stripe", CYL, V(0.3 * s, 0.27 * s, 0.27 * s), CF(0, (0.4 + i * 0.8) * s, 0) * UP, C(255, 80, 120), M.SmoothPlastic)
	end
	local col = pastel(r)
	P("Disc", CYL, V(0.4 * s, 2.4 * s, 2.4 * s), CF(0, 5.6 * s, 0) * CFrame.Angles(0, math.rad(90), 0), col, M.SmoothPlastic)
	for i = 0, 3 do
		P("Swirl", CYL, V(0.42 * s, (2.0 - i * 0.45) * s, (2.0 - i * 0.45) * s), CF(0, 5.6 * s, 0) * CFrame.Angles(0, math.rad(90), 0), (i % 2 == 0) and WHITE or col:Lerp(C(255, 255, 255), 0.4), M.SmoothPlastic)
	end
end

builders.jellycastle = function(P, s, r)
	local col = pastel(r)
	local function jelly(name: string, sz: Vector3, cf: CFrame, shape: Enum.PartType?)
		P(name, shape, sz * s, cf, col, M.Glass).Transparency = 0.2
	end
	jelly("Keep", V(2.2, 1.8, 2.2), CF(0, 0.9 * s, 0))
	for _, x in ipairs({ -1.2, 1.2 }) do
		for _, z in ipairs({ -1.2, 1.2 }) do
			P("Tower", CYL, V(2.6 * s, 0.7 * s, 0.7 * s), CF(x * s, 1.3 * s, z * s) * UP, col:Lerp(WHITE, 0.3), M.Glass).Transparency = 0.15
			P("Cap", BALL, V(0.8, 0.8, 0.8) * s, CF(x * s, 2.7 * s, z * s), C(255, 120, 180), M.SmoothPlastic)
		end
	end
	jelly("Top", V(1.2, 1.2, 1.2), CF(0, 2.3 * s, 0))
	P("Gate", BLOCK, V(0.6, 0.9, 0.05) * s, CF(0, 0.45 * s, -1.12 * s), C(120, 70, 40), M.Sand)
	P("Flag", BLOCK, V(0.05, 0.3, 0.45) * s, CF(0, 3.2 * s, 0.2 * s), C(255, 220, 60), M.Fabric)
	P("Pole", BLOCK, V(0.05, 0.6, 0.05) * s, CF(0, 3.0 * s, 0), WHITE, M.Metal)
end

builders.icemountain = function(P, s, r)
	P("Base", BALL, V(4, 2.2, 4) * s, CF(0, 0.5 * s, 0), C(210, 160, 100), M.Sand)
	for i = 0, 2 do
		P("Scoop", BALL, V(3.0 - i * 0.7, 2.0 - i * 0.4, 3.0 - i * 0.7) * s, CF(0, (1.4 + i * 1.0) * s, 0), pastel(r), M.SmoothPlastic)
	end
	for i = 0, 5 do
		local a = i / 6 * math.pi * 2
		P("Drip", BALL, V(0.5, 0.9, 0.5) * s, CF(math.cos(a) * 1.3 * s, 1.2 * s, math.sin(a) * 1.3 * s), C(255, 240, 250), M.SmoothPlastic)
	end
	P("Cherry", BALL, V(0.6, 0.6, 0.6) * s, CF(0, 4.0 * s, 0), C(220, 30, 50), M.SmoothPlastic)
	P("Stem", BLOCK, V(0.06, 0.5, 0.06) * s, CF(0.1 * s, 4.45 * s, 0) * CFrame.Angles(0, 0, -0.3), C(80, 140, 60), M.Grass)
end

builders.donutplanet = function(P, s, r)
	local icing = pastel(r)
	for i = 0, 15 do
		local a = i / 16 * math.pi * 2
		P("Dough", BALL, V(1.0, 0.8, 1.0) * s, CF(math.cos(a) * 1.3 * s, 1.2 * s, math.sin(a) * 1.3 * s), C(210, 160, 100), M.SmoothPlastic)
		P("Icing", BALL, V(0.95, 0.4, 0.95) * s, CF(math.cos(a) * 1.3 * s, 1.5 * s, math.sin(a) * 1.3 * s), icing, M.SmoothPlastic)
	end
	P("Moon", BALL, V(0.5, 0.5, 0.5) * s, CF(2.2 * s, 2.0 * s, 0), C(255, 240, 200), M.SmoothPlastic)
end

builders.candymoon = function(P, s, r)
	local col = pastel(r)
	P("Moon", BALL, V(2, 2, 2) * s, CF(0, 1.0 * s, 0), col, M.SmoothPlastic)
	for i = 0, 5 do
		P("Stripe", CYL, V(0.06 * s, 2.02 * s, 2.02 * s), CF(0, 1.0 * s, 0) * CFrame.Angles(i * 0.5, 0, math.rad(90)), WHITE, M.SmoothPlastic).Transparency = 0.2
	end
	for i = 0, 6 do
		local a = i * 0.9
		local dir = V(math.cos(a), math.sin(i), math.sin(a)).Unit
		P("Gem", BALL, V(0.25, 0.25, 0.25) * s, CF(V(0, s, 0) + dir * s), PASTEL[(i % #PASTEL) + 1], M.Neon)
	end
end

builders.cakestar = function(P, s, r)
	local col = pastel(r)
	P("Core", BALL, V(1.6, 1.6, 1.6) * s, CF(0, 1.0 * s, 0), col, M.SmoothPlastic)
	for i = 0, 4 do
		local a = i / 5 * math.pi * 2
		P("Point", BLOCK, V(0.6, 1.4, 0.6) * s, CF(0, 1.0 * s, 0) * CFrame.Angles(0, 0, a) * CF(0, 1.0 * s, 0) * CFrame.Angles(0, math.rad(45), 0), col:Lerp(WHITE, 0.3), M.SmoothPlastic)
	end
	P("Cream", BALL, V(1.0, 0.5, 1.0) * s, CF(0, 1.8 * s, 0), WHITE, M.SmoothPlastic)
	P("Glow", BALL, V(2.2, 2.2, 2.2) * s, CF(0, 1.0 * s, 0), C(255, 240, 180), M.ForceField).Transparency = 0.4
end

builders.candysun = function(P, s, _r)
	local core = P("Sun", BALL, V(2, 2, 2) * s, CF(0, 1.0 * s, 0), C(255, 150, 200), M.Neon)
	for i = 0, 5 do
		P("Swirl", CYL, V(0.08 * s, 2.05 * s, 2.05 * s), CF(0, 1.0 * s, 0) * CFrame.Angles(i * 0.52, i * 0.3, math.rad(90)), (i % 2 == 0) and WHITE or C(255, 230, 120), M.Neon).Transparency = 0.3
	end
	P("Corona", BALL, V(2.4, 2.4, 2.4) * s, CF(0, 1.0 * s, 0), C(255, 120, 200), M.ForceField).Transparency = 0.3
	local light = Instance.new("PointLight")
	light.Range = 60
	light.Brightness = 3
	light.Color = C(255, 180, 230)
	light.Parent = core
end

------------------------------------------------------------------------
-- 베타 3에서 더한 물체 26종
------------------------------------------------------------------------
-- 1 공원
builders.duck = function(P, s, r)
	local col = r() < 0.7 and C(255, 220, 60) or WHITE
	P("Body", BALL, V(1.2, 0.9, 1.6) * s, CF(0, 0.45 * s, 0), col, M.SmoothPlastic)
	P("Head", BALL, V(0.7, 0.7, 0.7) * s, CF(0, 1.05 * s, -0.55 * s), col, M.SmoothPlastic)
	P("Beak", BLOCK, V(0.35, 0.12, 0.35) * s, CF(0, 1.0 * s, -0.95 * s), C(255, 140, 30), M.SmoothPlastic)
	P("Tail", BALL, V(0.4, 0.4, 0.5) * s, CF(0, 0.75 * s, 0.75 * s), col, M.SmoothPlastic)
	for _, x in ipairs({ -0.17, 0.17 }) do
		P("Eye", BALL, V(0.12, 0.14, 0.08) * s, CF(x * s, 1.15 * s, -0.86 * s), DARK, M.SmoothPlastic)
		P("Wing", BALL, V(0.2, 0.5, 0.9) * s, CF(x * 3.4 * s, 0.55 * s, 0.05 * s), col:Lerp(C(200, 150, 40), 0.2), M.SmoothPlastic)
	end
end

builders.hydrant = function(P, s, _r)
	local red = C(220, 40, 40)
	P("Base", CYL, V(0.15, 1.0, 1.0) * s, CF(0, 0.08 * s, 0) * UP, red:Lerp(DARK, 0.3), M.Metal)
	P("Body", CYL, V(1.4, 0.75, 0.75) * s, CF(0, 0.85 * s, 0) * UP, red, M.Metal)
	P("Cap", BALL, V(0.8, 0.6, 0.8) * s, CF(0, 1.6 * s, 0), red, M.Metal)
	P("Nut", CYL, V(0.2, 0.25, 0.25) * s, CF(0, 1.9 * s, 0) * UP, C(230, 200, 60), M.Metal)
	for _, x in ipairs({ -1, 1 }) do
		P("Outlet", CYL, V(0.35, 0.35, 0.35) * s, CF(x * 0.5 * s, 1.0 * s, 0), red, M.Metal)
		P("OutletCap", CYL, V(0.08, 0.38, 0.38) * s, CF(x * 0.7 * s, 1.0 * s, 0), C(230, 200, 60), M.Metal)
	end
	P("Front", CYL, V(0.3, 0.42, 0.42) * s, CF(0, 0.95 * s, -0.45 * s) * CFrame.Angles(0, math.rad(90), 0), red, M.Metal)
end

builders.picnic = function(P, s, r)
	local wood = C(170, 120, 75):Lerp(C(140, 95, 60), r())
	P("Top", BLOCK, V(1.6, 0.12, 0.9) * s, CF(0, 0.75 * s, 0), wood, M.WoodPlanks)
	for _, z in ipairs({ -0.75, 0.75 }) do
		P("Seat", BLOCK, V(1.6, 0.1, 0.3) * s, CF(0, 0.42 * s, z * s), wood, M.WoodPlanks)
	end
	for _, x in ipairs({ -0.6, 0.6 }) do
		P("LegA", BLOCK, V(0.1, 0.9, 0.1) * s, CF(x * s, 0.4 * s, 0) * CFrame.Angles(math.rad(35), 0, 0), wood:Lerp(DARK, 0.2), M.Wood)
		P("LegB", BLOCK, V(0.1, 0.9, 0.1) * s, CF(x * s, 0.4 * s, 0) * CFrame.Angles(math.rad(-35), 0, 0), wood:Lerp(DARK, 0.2), M.Wood)
	end
	P("Cloth", BLOCK, V(0.9, 0.02, 0.7) * s, CF(0, 0.82 * s, 0), C(220, 60, 60), M.Fabric)
	P("Basket", BLOCK, V(0.35, 0.25, 0.25) * s, CF(0.3 * s, 0.95 * s, 0), C(190, 150, 90), M.Fabric)
	P("Apple", BALL, V(0.12, 0.12, 0.12) * s, CF(-0.2 * s, 0.89 * s, 0.1 * s), C(200, 30, 40), M.SmoothPlastic)
end

-- 2 마을
builders.doghouse = function(P, s, r)
	local col = hsv(r(), 0.5, 0.8)
	P("Box", BLOCK, V(1.3, 0.9, 1.4) * s, CF(0, 0.45 * s, 0), col, M.WoodPlanks)
	P("RoofL", BLOCK, V(0.85, 0.08, 1.6) * s, CF(-0.35 * s, 1.1 * s, 0) * CFrame.Angles(0, 0, math.rad(40)), C(170, 50, 40), M.WoodPlanks)
	P("RoofR", BLOCK, V(0.85, 0.08, 1.6) * s, CF(0.35 * s, 1.1 * s, 0) * CFrame.Angles(0, 0, math.rad(-40)), C(170, 50, 40), M.WoodPlanks)
	P("Gable", BLOCK, V(0.9, 0.9, 1.38) * s, CF(0, 0.95 * s, 0) * CFrame.Angles(0, 0, math.rad(45)), col, M.WoodPlanks)
	P("Door", CYL, V(0.04, 0.6, 0.6) * s, CF(0, 0.45 * s, -0.71 * s) * CFrame.Angles(0, math.rad(90), 0), DARK, M.SmoothPlastic)
	P("Sign", BLOCK, V(0.5, 0.15, 0.04) * s, CF(0, 0.85 * s, -0.72 * s), WHITE, M.Wood)
	P("Bowl", CYL, V(0.12, 0.35, 0.35) * s, CF(0.5 * s, 0.06 * s, -1 * s) * UP, C(60, 120, 220), M.SmoothPlastic)
	P("Bone", BLOCK, V(0.35, 0.06, 0.08) * s, CF(-0.4 * s, 0.03 * s, -0.95 * s), WHITE, M.SmoothPlastic)
end

builders.vending = function(P, s, r)
	local col = hsv(r(), 0.7, 0.85)
	P("Body", BLOCK, V(1.1, 2.0, 0.8) * s, CF(0, 1.0 * s, 0), col, M.Metal)
	P("Window", BLOCK, V(0.75, 1.1, 0.04) * s, CF(-0.1 * s, 1.3 * s, -0.41 * s), GLASS, M.Glass)
	for row = 0, 3 do
		for k = 0, 2 do
			P("Can", CYL, V(0.2, 0.12, 0.12) * s, CF((-0.35 + k * 0.25) * s, (0.9 + row * 0.27) * s, -0.3 * s) * UP, hsv(row * 0.2 + k * 0.1, 0.8, 1), M.SmoothPlastic)
		end
	end
	P("Panel", BLOCK, V(0.18, 0.6, 0.04) * s, CF(0.4 * s, 1.35 * s, -0.41 * s), DARK, M.SmoothPlastic)
	P("Slot", BLOCK, V(0.6, 0.18, 0.05) * s, CF(-0.1 * s, 0.35 * s, -0.41 * s), DARK, M.Metal)
	P("Light", BLOCK, V(1.0, 0.15, 0.05) * s, CF(0, 1.9 * s, -0.41 * s), WHITE, M.Neon)
end

builders.tent = function(P, s, r)
	local col = hsv(r(), 0.6, 0.9)
	P("SideL", BLOCK, V(0.06, 1.5, 2.2) * s, CF(-0.5 * s, 0.6 * s, 0) * CFrame.Angles(0, 0, math.rad(-35)), col, M.Fabric)
	P("SideR", BLOCK, V(0.06, 1.5, 2.2) * s, CF(0.5 * s, 0.6 * s, 0) * CFrame.Angles(0, 0, math.rad(35)), col, M.Fabric)
	P("Ridge", CYL, V(2.3, 0.08, 0.08) * s, CF(0, 1.22 * s, 0) * CFrame.Angles(0, math.rad(90), 0), C(120, 90, 60), M.Wood)
	P("Door", BLOCK, V(0.6, 0.8, 0.04) * s, CF(0, 0.4 * s, -1.08 * s), col:Lerp(DARK, 0.5), M.Fabric)
	P("Floor", BLOCK, V(1.8, 0.04, 2.3) * s, CF(0, 0.02 * s, 0), C(90, 90, 100), M.Fabric)
	P("Fire", BALL, V(0.25, 0.35, 0.25) * s, CF(0, 0.15 * s, -1.9 * s), C(255, 140, 40), M.Neon)
	for i = 0, 4 do
		local a = i * math.pi * 2 / 5
		P("Stone", BALL, V(0.15, 0.1, 0.15) * s, CF(math.cos(a) * 0.3 * s, 0.05 * s, -1.9 * s + math.sin(a) * 0.3 * s), C(120, 120, 120), M.Slate)
	end
	P("Log", CYL, V(0.9, 0.18, 0.18) * s, CF(0.9 * s, 0.09 * s, -1.6 * s), C(110, 75, 45), M.Wood)
end

-- 3 도시
builders.taxi = function(P, s, r)
	builders.car(P, s, r)
	P("TaxiSign", BLOCK, V(0.6, 0.22, 0.25) * s, CF(0, 1.72 * s, 0.25 * s), C(255, 210, 30), M.Neon)
	P("Stripe", BLOCK, V(1.72, 0.12, 2.4) * s, CF(0, 0.75 * s, 0), DARK, M.SmoothPlastic)
	for _, x in ipairs({ -0.86, 0.86 }) do
		for k = 0, 5 do
			P("Check", BLOCK, V(0.02, 0.06, 0.18) * s, CF(x * s, 0.75 * s, (-0.9 + k * 0.36) * s), WHITE, M.SmoothPlastic)
		end
	end
end

builders.firetruck = function(P, s, _r)
	local red = C(210, 30, 30)
	P("Body", BLOCK, V(1.8, 1.1, 3.6) * s, CF(0, 0.95 * s, 0.3 * s), red, M.SmoothPlastic)
	P("Cab", BLOCK, V(1.8, 1.3, 1.1) * s, CF(0, 1.05 * s, -1.85 * s), red, M.SmoothPlastic)
	P("Windshield", BLOCK, V(1.6, 0.55, 0.05) * s, CF(0, 1.35 * s, -2.41 * s), GLASS, M.Glass)
	P("Ladder", BLOCK, V(0.6, 0.12, 3.6) * s, CF(0, 1.62 * s, 0.4 * s), C(220, 220, 225), M.Metal)
	for k = 0, 8 do
		P("Rung", BLOCK, V(0.6, 0.14, 0.05) * s, CF(0, 1.64 * s, (-1.2 + k * 0.4) * s), C(180, 180, 190), M.Metal)
	end
	P("Siren", BLOCK, V(1.0, 0.15, 0.25) * s, CF(0, 1.77 * s, -1.85 * s), C(80, 140, 255), M.Neon)
	P("Stripe", BLOCK, V(1.82, 0.12, 4.6) * s, CF(0, 0.8 * s, -0.2 * s), WHITE, M.Neon)
	P("Hose", CYL, V(0.25, 0.6, 0.6) * s, CF(0.92 * s, 1.0 * s, 0.6 * s), C(230, 200, 60), M.Fabric)
	for _, x in ipairs({ -0.85, 0.85 }) do
		for _, z in ipairs({ -1.8, 0.2, 1.4 }) do
			wheel(P, CF(x * s, 0.4 * s, z * s), 0.8 * s, 0.3 * s)
		end
	end
end

builders.gasstation = function(P, s, r)
	local col = hsv(r(), 0.7, 0.9)
	P("Slab", BLOCK, V(3.2, 0.1, 2.2) * s, CF(0, 0.05 * s, 0), C(150, 150, 155), M.Concrete)
	P("Roof", BLOCK, V(3.2, 0.25, 2.2) * s, CF(0, 1.9 * s, 0), WHITE, M.SmoothPlastic)
	P("RoofBand", BLOCK, V(3.25, 0.15, 2.25) * s, CF(0, 1.75 * s, 0), col, M.Neon)
	for _, x in ipairs({ -1.2, 1.2 }) do
		P("Pillar", BLOCK, V(0.2, 1.7, 0.2) * s, CF(x * s, 0.95 * s, 0), WHITE, M.Metal)
	end
	for _, x in ipairs({ -0.6, 0.6 }) do
		P("Pump", BLOCK, V(0.35, 0.8, 0.25) * s, CF(x * s, 0.5 * s, 0), col, M.SmoothPlastic)
		P("Screen", BLOCK, V(0.25, 0.15, 0.03) * s, CF(x * s, 0.7 * s, -0.14 * s), C(120, 255, 150), M.Neon)
		P("Nozzle", BLOCK, V(0.06, 0.25, 0.06) * s, CF(x * s + 0.2 * s, 0.55 * s, 0), DARK, M.Rubber)
	end
	P("Shop", BLOCK, V(1.4, 1.2, 0.8) * s, CF(0.8 * s, 0.6 * s, 1.6 * s), C(230, 225, 210), M.Brick)
	P("ShopGlass", BLOCK, V(0.9, 0.5, 0.04) * s, CF(0.8 * s, 0.6 * s, 1.19 * s), GLASS, M.Glass)
	P("Sign", BLOCK, V(0.15, 1.6, 0.6) * s, CF(-1.5 * s, 2.6 * s, 1.0 * s), col, M.SmoothPlastic)
	P("SignPole", CYL, V(1.8, 0.12, 0.12) * s, CF(-1.5 * s, 0.9 * s, 1.0 * s) * UP, C(120, 120, 125), M.Metal)
end

-- 4 대도시
builders.helicopter = function(P, s, r)
	local col = hsv(r(), 0.6, 0.85)
	P("Body", BALL, V(1.4, 1.2, 2.0) * s, CF(0, 1.0 * s, 0), col, M.SmoothPlastic)
	P("Glass", BALL, V(1.1, 0.8, 0.9) * s, CF(0, 1.15 * s, -0.6 * s), GLASS, M.Glass)
	P("Tail", BLOCK, V(0.25, 0.25, 2.0) * s, CF(0, 1.15 * s, 1.8 * s), col, M.SmoothPlastic)
	P("TailFin", BLOCK, V(0.06, 0.6, 0.4) * s, CF(0, 1.4 * s, 2.75 * s), col, M.SmoothPlastic)
	P("TailRotor", BLOCK, V(0.04, 0.9, 0.1) * s, CF(0.15 * s, 1.3 * s, 2.75 * s), DARK, M.Metal)
	P("Mast", CYL, V(0.3, 0.12, 0.12) * s, CF(0, 1.75 * s, 0) * UP, DARK, M.Metal)
	P("Blade1", BLOCK, V(4.2, 0.05, 0.22) * s, CF(0, 1.9 * s, 0) * CFrame.Angles(0, math.rad(20), 0), DARK, M.Metal)
	P("Blade2", BLOCK, V(4.2, 0.05, 0.22) * s, CF(0, 1.9 * s, 0) * CFrame.Angles(0, math.rad(110), 0), DARK, M.Metal)
	for _, x in ipairs({ -0.55, 0.55 }) do
		P("Skid", BLOCK, V(0.08, 0.08, 2.0) * s, CF(x * s, 0.1 * s, 0), C(120, 120, 125), M.Metal)
		P("Strut", BLOCK, V(0.06, 0.4, 0.06) * s, CF(x * s, 0.3 * s, -0.4 * s), C(120, 120, 125), M.Metal)
		P("Strut2", BLOCK, V(0.06, 0.4, 0.06) * s, CF(x * s, 0.3 * s, 0.4 * s), C(120, 120, 125), M.Metal)
	end
end

builders.crane = function(P, s, _r)
	local yel = C(250, 190, 30)
	P("Base", BLOCK, V(1.2, 0.3, 1.2) * s, CF(0, 0.15 * s, 0), C(120, 120, 125), M.Concrete)
	for k = 0, 7 do
		P("Mast", BLOCK, V(0.4, 0.5, 0.4) * s, CF(0, (0.55 + k * 0.5) * s, 0), yel, M.Metal)
		P("Brace", BLOCK, V(0.05, 0.6, 0.05) * s, CF(0, (0.55 + k * 0.5) * s, -0.21 * s) * CFrame.Angles(0, 0, math.rad(40)), yel:Lerp(DARK, 0.3), M.Metal)
	end
	P("Jib", BLOCK, V(0.3, 0.3, 4.2) * s, CF(0, 4.4 * s, -0.9 * s), yel, M.Metal)
	P("Counter", BLOCK, V(0.6, 0.5, 0.6) * s, CF(0, 4.3 * s, 1.0 * s), C(140, 140, 145), M.Concrete)
	P("Cabin", BLOCK, V(0.5, 0.45, 0.5) * s, CF(0.35 * s, 4.0 * s, 0), WHITE, M.SmoothPlastic)
	P("Cable", BLOCK, V(0.03, 1.8, 0.03) * s, CF(0, 3.4 * s, -2.6 * s), DARK, M.Metal)
	P("Hook", BLOCK, V(0.2, 0.2, 0.2) * s, CF(0, 2.45 * s, -2.6 * s), C(200, 60, 40), M.Metal)
	P("Load", BLOCK, V(0.8, 0.3, 0.3) * s, CF(0, 2.2 * s, -2.6 * s), C(110, 80, 50), M.WoodPlanks)
	P("Beacon", BALL, V(0.15, 0.15, 0.15) * s, CF(0, 4.65 * s, -0.9 * s), C(255, 50, 50), M.Neon)
end

builders.airplane = function(P, s, r)
	local tail = hsv(r(), 0.7, 0.9)
	P("Body", CYL, V(4.2, 0.7, 0.7) * s, CF(0, 0.8 * s, 0) * CFrame.Angles(0, math.rad(90), 0), WHITE, M.SmoothPlastic)
	P("Nose", BALL, V(0.7, 0.7, 0.9) * s, CF(0, 0.8 * s, -2.1 * s), WHITE, M.SmoothPlastic)
	P("Cockpit", BLOCK, V(0.5, 0.15, 0.3) * s, CF(0, 1.0 * s, -2.15 * s) * CFrame.Angles(math.rad(-25), 0, 0), GLASS, M.Glass)
	P("Wing", BLOCK, V(4.0, 0.08, 0.8) * s, CF(0, 0.7 * s, 0), C(220, 222, 228), M.SmoothPlastic)
	P("TailWing", BLOCK, V(1.4, 0.06, 0.4) * s, CF(0, 0.9 * s, 1.9 * s), C(220, 222, 228), M.SmoothPlastic)
	P("Fin", BLOCK, V(0.06, 0.8, 0.6) * s, CF(0, 1.4 * s, 1.9 * s), tail, M.SmoothPlastic)
	P("Stripe", BLOCK, V(0.72, 0.1, 3.6) * s, CF(0, 0.75 * s, 0), tail, M.SmoothPlastic)
	for _, x in ipairs({ -1.0, 1.0 }) do
		P("Engine", CYL, V(0.6, 0.3, 0.3) * s, CF(x * s, 0.5 * s, -0.1 * s) * CFrame.Angles(0, math.rad(90), 0), C(170, 170, 180), M.Metal)
	end
	for k = 0, 8 do
		for _, x in ipairs({ -0.36, 0.36 }) do
			P("Window", BLOCK, V(0.02, 0.1, 0.1) * s, CF(x * s, 0.95 * s, (-1.4 + k * 0.3) * s), C(60, 80, 110), M.Glass)
		end
	end
	P("Gear", BLOCK, V(0.1, 0.4, 0.1) * s, CF(0, 0.25 * s, -1.6 * s), DARK, M.Metal)
	wheel(P, CF(0, 0.1 * s, -1.6 * s), 0.2 * s, 0.1 * s)
	for _, x in ipairs({ -0.4, 0.4 }) do
		wheel(P, CF(x * s, 0.12 * s, 0.2 * s), 0.25 * s, 0.12 * s)
	end
end

-- 5 바다와 산
builders.whale = function(P, s, _r)
	local col = C(60, 90, 140)
	P("Water", CYL, V(0.1, 4.0, 4.0) * s, CF(0, 0.05 * s, 0) * UP, C(60, 140, 210), M.Glass).Transparency = 0.3
	P("Body", BALL, V(1.6, 1.2, 3.4) * s, CF(0, 0.5 * s, 0), col, M.SmoothPlastic)
	P("Belly", BALL, V(1.3, 0.8, 3.0) * s, CF(0, 0.3 * s, -0.1 * s), C(220, 225, 235), M.SmoothPlastic)
	P("Tail", BLOCK, V(1.6, 0.08, 0.5) * s, CF(0, 0.6 * s, 2.0 * s) * CFrame.Angles(math.rad(-20), 0, 0), col, M.SmoothPlastic)
	for _, x in ipairs({ -0.75, 0.75 }) do
		P("Fin", BLOCK, V(0.6, 0.06, 0.3) * s, CF(x * s, 0.35 * s, -0.4 * s) * CFrame.Angles(0, 0, x * 0.5), col, M.SmoothPlastic)
		P("Eye", BALL, V(0.1, 0.12, 0.12) * s, CF(x * 0.72 * s, 0.55 * s, -1.2 * s), DARK, M.SmoothPlastic)
	end
	for i = 0, 3 do
		P("Spout", BALL, V(0.3, 0.4, 0.3) * s * (1 - i * 0.15), CF((i % 2 - 0.5) * 0.15 * s, (1.2 + i * 0.35) * s, -0.6 * s), C(220, 240, 255), M.Glass).Transparency = 0.2 + i * 0.15
	end
end

builders.volcano = function(P, s, r)
	local rock = C(90, 70, 60)
	P("Base", CYL, V(0.6, 3.6, 3.6) * s, CF(0, 0.3 * s, 0) * UP, rock, M.Basalt)
	P("Mid", CYL, V(0.7, 2.6, 2.6) * s, CF(0, 0.9 * s, 0) * UP, rock:Lerp(DARK, 0.1), M.Basalt)
	P("Upper", CYL, V(0.6, 1.7, 1.7) * s, CF(0, 1.5 * s, 0) * UP, rock:Lerp(DARK, 0.2), M.Basalt)
	P("Crater", CYL, V(0.1, 1.2, 1.2) * s, CF(0, 1.81 * s, 0) * UP, C(255, 110, 20), M.Neon)
	P("Glow", BALL, V(0.9, 0.5, 0.9) * s, CF(0, 1.95 * s, 0), C(255, 80, 20), M.Neon).Transparency = 0.3
	for i = 0, 4 do
		local a = i * 1.3 + r()
		P("Lava", BLOCK, V(0.15, 1.6, 0.25) * s, CF(math.cos(a) * 0.95 * s, 1.0 * s, math.sin(a) * 0.95 * s) * CFrame.Angles(0, -a, math.rad(35)), C(255, 90, 20), M.CrackedLava)
	end
	for i = 0, 3 do
		P("Smoke", BALL, V(0.7, 0.6, 0.7) * s * (1 + i * 0.25), CF(i * 0.15 * s, (2.3 + i * 0.5) * s, 0), C(90, 90, 95), M.SmoothPlastic).Transparency = 0.3 + i * 0.15
	end
end

-- 6 우주
builders.comet = function(P, s, _r)
	P("Head", BALL, V(1.4, 1.4, 1.4) * s, CF(0, 1.0 * s, 0), C(200, 230, 255), M.Ice)
	P("Core", BALL, V(1.0, 1.0, 1.0) * s, CF(0, 1.0 * s, 0), WHITE, M.Neon)
	for i = 1, 6 do
		P("Tail", BALL, V(1.3 - i * 0.15, 1.3 - i * 0.15, 1.2) * s, CF(0, (1.0 + i * 0.12) * s, i * 0.75 * s), C(140, 200, 255), M.Neon).Transparency = 0.2 + i * 0.12
	end
end

builders.spacestation = function(P, s, _r)
	P("Hub", CYL, V(0.8, 0.8, 0.8) * s, CF(0, 1.2 * s, 0) * UP, C(220, 222, 228), M.Metal)
	P("Ring", CYL, V(0.15, 3.0, 3.0) * s, CF(0, 1.2 * s, 0) * UP, C(200, 202, 210), M.Metal)
	P("RingHole", CYL, V(0.17, 2.6, 2.6) * s, CF(0, 1.2 * s, 0) * UP, C(20, 20, 30), M.SmoothPlastic)
	for i = 0, 3 do
		local a = i * math.pi / 2
		P("Spoke", BLOCK, V(0.12, 0.12, 1.3) * s, CF(0, 1.2 * s, 0) * CFrame.Angles(0, a, 0) * CF(0, 0, 0.75 * s), C(180, 180, 190), M.Metal)
		P("Light", BALL, V(0.15, 0.15, 0.15) * s, CF(math.cos(a) * 1.5 * s, 1.2 * s, math.sin(a) * 1.5 * s), C(120, 220, 255), M.Neon)
	end
	for _, x in ipairs({ -1, 1 }) do
		P("Panel", BLOCK, V(1.4, 0.04, 0.7) * s, CF(x * 2.3 * s, 1.2 * s, 0), C(40, 70, 160), M.Glass)
		P("Arm", BLOCK, V(0.8, 0.08, 0.08) * s, CF(x * 1.55 * s, 1.2 * s, 0), C(180, 180, 190), M.Metal)
	end
	P("Dock", CYL, V(1.0, 0.3, 0.3) * s, CF(0, 2.0 * s, 0) * UP, C(220, 222, 228), M.Metal)
	P("Leg", CYL, V(0.8, 0.2, 0.2) * s, CF(0, 0.4 * s, 0) * UP, C(120, 120, 130), M.Metal)
end

builders.galaxy = function(P, s, r)
	local a0 = r() * 6
	P("Core", BALL, V(0.7, 0.4, 0.7) * s, CF(0, 0.6 * s, 0), C(255, 240, 200), M.Neon)
	P("Disk", CYL, V(0.04, 2.2, 2.2) * s, CF(0, 0.55 * s, 0) * UP, C(120, 90, 200), M.Neon).Transparency = 0.6
	for arm = 0, 1 do
		for k = 1, 9 do
			local t = k / 9
			local a = a0 + arm * math.pi + t * 3.2
			local d = t * 1.1 * s
			P("Star", BALL, V(0.22, 0.12, 0.22) * s * (1.2 - t * 0.6), CF(math.cos(a) * d, 0.6 * s, math.sin(a) * d), C(200, 210, 255):Lerp(C(255, 150, 230), t), M.Neon)
		end
	end
end

-- 7 젤리 들판
builders.chocobar = function(P, s, _r)
	P("Wrapper", BLOCK, V(1.0, 0.25, 1.8) * s, CF(0, 0.13 * s, 0.35 * s), C(200, 40, 60), M.Foil)
	P("Label", BLOCK, V(0.8, 0.26, 0.5) * s, CF(0, 0.13 * s, 0.6 * s), C(255, 220, 90), M.SmoothPlastic)
	for i = 0, 2 do
		for j = 0, 1 do
			P("Piece", BLOCK, V(0.45, 0.2, 0.4) * s, CF((j - 0.5) * 0.48 * s, 0.12 * s, (-0.9 + i * 0.42) * s), C(110, 60, 35), M.SmoothPlastic)
		end
	end
end

builders.marshmallow = function(P, s, r)
	local col = r() < 0.5 and WHITE or C(255, 200, 220)
	P("Body", CYL, V(1.2, 1.2, 1.2) * s, CF(0, 0.6 * s, 0) * UP, col, M.SmoothPlastic)
	P("Top", CYL, V(0.05, 1.1, 1.1) * s, CF(0, 1.21 * s, 0) * UP, col:Lerp(C(240, 220, 200), 0.3), M.SmoothPlastic)
	P("Stick", CYL, V(1.6, 0.08, 0.08) * s, CF(0, 1.6 * s, 0) * UP, C(190, 150, 100), M.Wood)
	for _, x in ipairs({ -0.2, 0.2 }) do
		P("Eye", BALL, V(0.1, 0.12, 0.05) * s, CF(x * s, 0.75 * s, -0.6 * s), DARK, M.SmoothPlastic)
	end
	P("Smile", BLOCK, V(0.2, 0.04, 0.04) * s, CF(0, 0.55 * s, -0.6 * s), DARK, M.SmoothPlastic)
end

-- 8 과자 마을
builders.milk = function(P, s, r)
	local col = hsv(r(), 0.45, 1)
	P("Box", BLOCK, V(1.0, 1.6, 1.0) * s, CF(0, 0.8 * s, 0), WHITE, M.SmoothPlastic)
	P("Label", BLOCK, V(1.02, 0.6, 1.02) * s, CF(0, 0.75 * s, 0), col, M.SmoothPlastic)
	P("RoofA", BLOCK, V(0.72, 0.06, 1.0) * s, CF(-0.25 * s, 1.8 * s, 0) * CFrame.Angles(0, 0, math.rad(40)), WHITE, M.SmoothPlastic)
	P("RoofB", BLOCK, V(0.72, 0.06, 1.0) * s, CF(0.25 * s, 1.8 * s, 0) * CFrame.Angles(0, 0, math.rad(-40)), WHITE, M.SmoothPlastic)
	P("Cap", CYL, V(0.15, 0.25, 0.25) * s, CF(0.2 * s, 2.0 * s, -0.2 * s) * UP, col, M.SmoothPlastic)
	P("Straw", CYL, V(1.0, 0.08, 0.08) * s, CF(-0.2 * s, 2.3 * s, 0.2 * s) * UP, C(255, 120, 160), M.SmoothPlastic)
	for _, x in ipairs({ -0.2, 0.2 }) do
		P("Eye", BALL, V(0.1, 0.12, 0.05) * s, CF(x * s, 1.25 * s, -0.51 * s), DARK, M.SmoothPlastic)
	end
end

builders.waffle = function(P, s, _r)
	local col = C(225, 170, 90)
	P("Waffle", BLOCK, V(2.0, 0.3, 2.0) * s, CF(0, 0.15 * s, 0), col, M.Sand)
	for i = -2, 2 do
		P("GridX", BLOCK, V(2.0, 0.08, 0.08) * s, CF(0, 0.32 * s, i * 0.38 * s), col:Lerp(DARK, 0.15), M.Sand)
		P("GridZ", BLOCK, V(0.08, 0.08, 2.0) * s, CF(i * 0.38 * s, 0.32 * s, 0), col:Lerp(DARK, 0.15), M.Sand)
	end
	P("Butter", BLOCK, V(0.45, 0.2, 0.45) * s, CF(0, 0.42 * s, 0), C(255, 240, 150), M.SmoothPlastic)
	P("Syrup", CYL, V(0.04, 1.2, 1.2) * s, CF(0, 0.34 * s, 0) * UP, C(170, 90, 30), M.Glass).Transparency = 0.2
	P("Berry", BALL, V(0.25, 0.25, 0.25) * s, CF(0.6 * s, 0.45 * s, 0.5 * s), C(220, 30, 60), M.SmoothPlastic)
	P("Berry2", BALL, V(0.22, 0.22, 0.22) * s, CF(-0.5 * s, 0.44 * s, -0.6 * s), C(60, 60, 200), M.SmoothPlastic)
end

-- 9 케이크 도시
builders.jellybus = function(P, s, r)
	local col = pastel(r)
	P("Body", BLOCK, V(1.8, 1.4, 4.4) * s, CF(0, 1.05 * s, 0), col, M.Glass).Transparency = 0.15
	P("Inner", BLOCK, V(1.5, 1.1, 4.1) * s, CF(0, 1.05 * s, 0), col:Lerp(WHITE, 0.4), M.SmoothPlastic).Transparency = 0.3
	P("Roof", BLOCK, V(1.85, 0.15, 4.45) * s, CF(0, 1.8 * s, 0), WHITE, M.SmoothPlastic)
	for k = 0, 4 do
		for _, x in ipairs({ -0.91, 0.91 }) do
			P("Window", BLOCK, V(0.04, 0.45, 0.6) * s, CF(x * s, 1.3 * s, (-1.6 + k * 0.8) * s), C(255, 250, 230), M.Neon)
		end
	end
	for _, x in ipairs({ -0.85, 0.85 }) do
		for _, z in ipairs({ -1.5, 1.5 }) do
			P("GumWheel", CYL, V(0.3 * s, 0.8 * s, 0.8 * s), CF(x * s, 0.4 * s, z * s), C(60, 40, 30), M.SmoothPlastic)
		end
	end
	P("Sign", BLOCK, V(1.2, 0.3, 0.04) * s, CF(0, 1.6 * s, -2.22 * s), C(255, 230, 120), M.Neon)
end

builders.chocotower = function(P, s, _r)
	local choco = C(100, 55, 30)
	for k = 0, 4 do
		P("Floor", BLOCK, V(1.6 - k * 0.15, 0.75, 1.6 - k * 0.15) * s, CF(0, (0.38 + k * 0.75) * s, 0), choco:Lerp(C(160, 100, 60), (k % 2) * 0.4), M.SmoothPlastic)
		P("Cream", BLOCK, V(1.65 - k * 0.15, 0.08, 1.65 - k * 0.15) * s, CF(0, (0.76 + k * 0.75) * s, 0), WHITE, M.SmoothPlastic)
		for _, x in ipairs({ -0.3, 0.3 }) do
			P("Window", BLOCK, V(0.25, 0.3, 0.04) * s, CF(x * s, (0.4 + k * 0.75) * s, -(0.81 - k * 0.075) * s), C(255, 220, 140), M.Neon)
		end
	end
	P("Cherry", BALL, V(0.5, 0.5, 0.5) * s, CF(0, 4.05 * s, 0), C(220, 30, 50), M.SmoothPlastic)
	P("Stem", CYL, V(0.4, 0.05, 0.05) * s, CF(0, 4.4 * s, 0) * UP, C(80, 140, 50), M.SmoothPlastic)
end

-- 10 아이스크림 산맥
builders.parfait = function(P, s, r)
	P("Foot", CYL, V(0.1, 1.0, 1.0) * s, CF(0, 0.05 * s, 0) * UP, GLASS, M.Glass)
	P("Stem", CYL, V(0.8, 0.2, 0.2) * s, CF(0, 0.5 * s, 0) * UP, GLASS, M.Glass)
	for k = 0, 3 do
		P("Layer", CYL, V(0.45, 1.3 + k * 0.12, 1.3 + k * 0.12) * s, CF(0, (1.1 + k * 0.45) * s, 0) * UP, hsv(r() * 0.2 + k * 0.25, 0.4, 1), M.SmoothPlastic)
	end
	P("Glass", CYL, V(1.9, 1.8, 1.8) * s, CF(0, 1.75 * s, 0) * UP, GLASS, M.Glass).Transparency = 0.6
	P("Scoop", BALL, V(1.2, 1.0, 1.2) * s, CF(0, 2.9 * s, 0), C(255, 230, 240), M.SmoothPlastic)
	P("Wafer", BLOCK, V(0.15, 0.9, 0.35) * s, CF(0.35 * s, 3.3 * s, 0) * CFrame.Angles(0, 0, math.rad(-20)), C(230, 190, 120), M.Sand)
	P("Cherry", BALL, V(0.3, 0.3, 0.3) * s, CF(-0.1 * s, 3.45 * s, 0), C(220, 30, 50), M.SmoothPlastic)
end

builders.cottoncloud = function(P, s, r)
	local col = pastel(r)
	for i = 0, 6 do
		local a = i * 0.9
		P("Puff", BALL, V(1.2, 0.9, 1.2) * s * (0.8 + (i % 3) * 0.15), CF(math.cos(a) * 0.9 * s, (1.6 + math.sin(a * 2) * 0.2) * s, math.sin(a) * 0.6 * s), col:Lerp(WHITE, (i % 2) * 0.3), M.SmoothPlastic)
	end
	P("Center", BALL, V(1.6, 1.2, 1.4) * s, CF(0, 1.9 * s, 0), col:Lerp(WHITE, 0.2), M.SmoothPlastic)
	for i = 0, 4 do
		P("Drop", BALL, V(0.15, 0.25, 0.15) * s, CF((i - 2) * 0.4 * s, (0.6 + (i % 2) * 0.4) * s, 0), hsv(i / 5, 0.5, 1), M.Neon)
	end
end

-- 11 사탕 우주
builders.candyasteroid = function(P, s, r)
	local col = pastel(r)
	P("Rock", BALL, V(2.0, 1.6, 1.8) * s, CF(0, 0.9 * s, 0), col, M.SmoothPlastic)
	for i = 0, 7 do
		local a = i * 0.8
		P("Sprinkle", BLOCK, V(0.35, 0.1, 0.1) * s, CF(math.cos(a) * 0.95 * s, (0.9 + math.sin(a * 1.7) * 0.6) * s, math.sin(a) * 0.85 * s) * CFrame.Angles(a, a * 2, 0), hsv(i / 8, 0.6, 1), M.SmoothPlastic)
	end
	P("Bite", BALL, V(0.8, 0.8, 0.8) * s, CF(0.8 * s, 1.3 * s, -0.4 * s), col:Lerp(WHITE, 0.5), M.SmoothPlastic)
end

builders.chocoplanet = function(P, s, _r)
	P("Planet", BALL, V(2, 2, 2) * s, CF(0, 1.0 * s, 0), C(110, 60, 35), M.SmoothPlastic)
	P("Drizzle", CYL, V(0.15 * s, 2.03 * s, 2.03 * s), CF(0, 1.3 * s, 0) * UP, C(250, 240, 230), M.SmoothPlastic)
	P("Drizzle2", CYL, V(0.12 * s, 2.03 * s, 2.03 * s), CF(0, 0.75 * s, 0) * UP, C(255, 150, 190), M.SmoothPlastic)
	P("Ring", CYL, V(0.06 * s, 3.4 * s, 3.4 * s), CF(0, 1.0 * s, 0) * CFrame.Angles(math.rad(-15), 0, math.rad(90)), C(240, 200, 120), M.SmoothPlastic)
	for i = 0, 5 do
		local a = i * math.pi / 3
		P("Nut", BALL, V(0.25, 0.2, 0.25) * s, CF(math.cos(a) * 1.55 * s, (1.0 + math.sin(a) * 0.4) * s, math.sin(a) * 1.55 * s), C(200, 150, 80), M.SmoothPlastic)
	end
end

------------------------------------------------------------------------
-- 만들기
------------------------------------------------------------------------
-- 물체 하나를 만든다. base = 바닥 기준 위치와 방향, seed = 같은 자리에는 같은 색이 나오게
function Props.build(kind: string, size: number, base: CFrame, seed: number): Model
	local model = Instance.new("Model")
	model.Name = kind
	local state = (seed % 2147483646) + 1
	local function rand(): number
		state = (state * 16807) % 2147483647
		return state / 2147483647
	end
	local first: Part? = nil
	local function P(name: string, shape: Enum.PartType?, sz: Vector3, cf: CFrame, color: Color3, material: Enum.Material): Part
		local p = Instance.new("Part")
		p.Name = name
		-- 로블록스 공(Ball)은 늘 완전한 구라서, 납작하거나 길쭉한 공은 구 모양 메시로 늘린다
		local stretched = shape == BALL and (math.abs(sz.X - sz.Y) > 0.01 or math.abs(sz.Y - sz.Z) > 0.01)
		if stretched then
			local mesh = Instance.new("SpecialMesh")
			mesh.MeshType = Enum.MeshType.Sphere
			mesh.Parent = p
		elseif shape and shape ~= BLOCK then
			p.Shape = shape
		end
		p.Anchored = true
		p.CanTouch = false
		p.TopSurface = Enum.SurfaceType.Smooth
		p.BottomSurface = Enum.SurfaceType.Smooth
		p.Size = V(math.clamp(sz.X, 0.05, 2048), math.clamp(sz.Y, 0.05, 2048), math.clamp(sz.Z, 0.05, 2048))
		p.CFrame = base * cf
		p.Color = color
		p.Material = material
		p.Parent = model
		if not first then
			first = p
		end
		return p
	end
	local fn = builders[kind] or builders.pebble
	fn(P, size, rand)
	if first then
		model.PrimaryPart = first
	end
	return model
end

function Props.has(kind: string): boolean
	return builders[kind] ~= nil
end

return Props
]]></string>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="5">
      <Properties>
        <string name="Name">SatBuilder</string>
        <string name="Source"><![CDATA[-- SatBuilder (ModuleScript, ReplicatedStorage)
-- 위성(펫) 모양 18종. 블랙홀 둘레를 도는 모델과 위성 창의 미리보기에 같이 쓴다.
-- 모델 가운데가 기준점이고, s는 대략 반지름이다. 황금 위성은 금빛으로 덮고 반짝이를 붙인다.

local SatBuilder = {}

type MakeFn = (string, Enum.PartType?, Vector3, CFrame, Color3, Enum.Material) -> Part
type Builder = (MakeFn, number, Color3) -> ()

local BALL = Enum.PartType.Ball
local CYL = Enum.PartType.Cylinder
local BLOCK = Enum.PartType.Block
local M = Enum.Material
local C = Color3.fromRGB
local V = Vector3.new
local CF = CFrame.new
local ANG = CFrame.Angles
local UP = ANG(0, 0, math.rad(90))
local DARK = C(15, 10, 25)
local WHITE = C(250, 250, 250)
local GOLD = C(255, 205, 70)

local builders: { [string]: Builder } = {}

builders.rock = function(P, s, col)
	P("Body", BALL, V(2, 1.7, 1.8) * s, CF(), col, M.Slate)
	P("Bump", BALL, V(1, 0.9, 1) * s, CF(0.6 * s, 0.4 * s, 0.3 * s), col:Lerp(DARK, 0.2), M.Slate)
	P("Bump", BALL, V(0.8, 0.7, 0.8) * s, CF(-0.5 * s, -0.4 * s, -0.4 * s), col:Lerp(WHITE, 0.15), M.Slate)
	P("EyeL", BALL, V(0.32, 0.4, 0.2) * s, CF(-0.3 * s, 0.2 * s, -0.85 * s), DARK, M.SmoothPlastic)
	P("EyeR", BALL, V(0.32, 0.4, 0.2) * s, CF(0.3 * s, 0.2 * s, -0.85 * s), DARK, M.SmoothPlastic)
end

builders.moon = function(P, s, col)
	P("Body", BALL, V(2, 2, 2) * s, CF(), col, M.Slate)
	for i = 1, 5 do
		local a = i * 1.3
		local dir = Vector3.new(math.cos(a), math.sin(a * 1.7) * 0.6, math.sin(a)).Unit
		P("Crater", CYL, V(0.12, 0.5, 0.5) * s, CFrame.lookAt(dir * 0.95 * s, dir * 2 * s) * ANG(0, math.rad(90), 0), col:Lerp(DARK, 0.3), M.Slate)
	end
end

builders.comet = function(P, s, col)
	P("Head", BALL, V(1.6, 1.6, 1.6) * s, CF(), col:Lerp(WHITE, 0.5), M.Neon)
	P("Ice", BALL, V(1.2, 1.2, 1.2) * s, CF(-0.1 * s, 0.1 * s, -0.2 * s), col, M.Ice)
	for i = 1, 5 do
		local t = i / 5
		P("Tail", BALL, V(1.4 - t, 1.4 - t, 1.6) * s, CF(0, 0, (0.6 + i * 0.7) * s), col:Lerp(WHITE, t * 0.3), M.Neon).Transparency = 0.15 + t * 0.6
	end
end

builders.ufo = function(P, s, col)
	P("Disc", CYL, V(0.5, 2.8, 2.8) * s, UP, C(190, 195, 205), M.Metal)
	P("Rim", CYL, V(0.2, 3.1, 3.1) * s, UP, col, M.Neon)
	P("Dome", BALL, V(1.5, 1.2, 1.5) * s, CF(0, 0.35 * s, 0), C(170, 230, 255), M.Glass).Transparency = 0.3
	P("Alien", BALL, V(0.6, 0.7, 0.6) * s, CF(0, 0.4 * s, 0), C(120, 230, 120), M.SmoothPlastic)
	for i = 0, 5 do
		local a = i * math.pi / 3
		P("Light", BALL, V(0.3, 0.3, 0.3) * s, CF(math.cos(a) * 1.25 * s, -0.15 * s, math.sin(a) * 1.25 * s), i % 2 == 0 and C(255, 240, 120) or col, M.Neon)
	end
	P("Beam", CYL, V(1.2, 1, 1) * s, CF(0, -0.8 * s, 0) * UP, col, M.Neon).Transparency = 0.7
end

builders.hole = function(P, s, col)
	P("Void", BALL, V(1.4, 1.4, 1.4) * s, CF(), C(0, 0, 0), M.SmoothPlastic)
	P("Disk", CYL, V(0.1, 3, 3) * s, UP, col, M.Neon).Transparency = 0.35
	P("Disk2", CYL, V(0.12, 2.2, 2.2) * s, UP, col:Lerp(WHITE, 0.4), M.Neon).Transparency = 0.2
	P("Glow", BALL, V(1.7, 1.7, 1.7) * s, CF(), col, M.ForceField).Transparency = 0.3
end

builders.star = function(P, s, col)
	P("Core", BALL, V(1.3, 1.3, 1.3) * s, CF(), col:Lerp(WHITE, 0.3), M.Neon)
	for i = 0, 4 do
		local a = i * math.pi * 2 / 5
		P("Point", BLOCK, V(0.45, 1.4, 0.45) * s, ANG(0, 0, a) * CF(0, 1 * s, 0) * ANG(0, math.rad(45), 0), col, M.Neon)
	end
	P("Halo", CYL, V(0.06, 3.2, 3.2) * s, ANG(0, math.rad(90), 0), col, M.Neon).Transparency = 0.6
end

builders.ringed = function(P, s, col)
	P("Planet", BALL, V(1.8, 1.8, 1.8) * s, CF(), col, M.SmoothPlastic)
	P("Band", BALL, V(1.84, 0.4, 1.84) * s, CF(0, 0.3 * s, 0), col:Lerp(C(160, 100, 60), 0.4), M.SmoothPlastic)
	P("Ring", CYL, V(0.06, 3.6, 3.6) * s, ANG(0.35, 0, 0) * UP, col:Lerp(WHITE, 0.4), M.Neon).Transparency = 0.3
	P("Ring2", CYL, V(0.05, 3, 3) * s, ANG(0.35, 0, 0) * UP, col:Lerp(DARK, 0.2), M.SmoothPlastic).Transparency = 0.2
end

builders.robot = function(P, s, col)
	P("Body", BLOCK, V(1.4, 1.2, 1.1) * s, CF(), col, M.Metal)
	P("Head", BLOCK, V(1, 0.7, 0.9) * s, CF(0, 0.95 * s, 0), col:Lerp(WHITE, 0.2), M.Metal)
	P("Visor", BLOCK, V(0.8, 0.25, 0.1) * s, CF(0, 0.95 * s, -0.46 * s), C(80, 220, 255), M.Neon)
	P("Antenna", CYL, V(0.6, 0.08, 0.08) * s, CF(0, 1.55 * s, 0) * UP, DARK, M.Metal)
	P("Tip", BALL, V(0.22, 0.22, 0.22) * s, CF(0, 1.85 * s, 0), C(255, 80, 80), M.Neon)
	P("PanelL", BLOCK, V(1.4, 0.06, 0.7) * s, CF(-1.45 * s, 0, 0), C(40, 60, 140), M.Glass)
	P("PanelR", BLOCK, V(1.4, 0.06, 0.7) * s, CF(1.45 * s, 0, 0), C(40, 60, 140), M.Glass)
	P("Jet", CYL, V(0.4, 0.5, 0.5) * s, CF(0, -0.75 * s, 0) * UP, C(255, 150, 60), M.Neon)
end

builders.crystal = function(P, s, col)
	P("Rock", BALL, V(1.6, 1.3, 1.5) * s, CF(0, -0.3 * s, 0), C(90, 85, 100), M.Slate)
	for i = 0, 5 do
		local a = i * 1.05
		local h = 1 + (i % 3) * 0.35
		P("Shard", BLOCK, V(0.35, h, 0.35) * s, ANG(math.cos(a) * 0.6, a, math.sin(a) * 0.6) * CF(0, 0.5 * s + h * 0.4 * s, 0) * ANG(0, math.rad(45), 0), col, M.Glass).Transparency = 0.15
	end
	P("Glow", BALL, V(0.6, 0.6, 0.6) * s, CF(0, 0.3 * s, 0), col, M.Neon)
end

builders.jelly = function(P, s, col)
	P("Bell", BALL, V(2, 1.4, 2) * s, CF(0, 0.3 * s, 0), col, M.Glass).Transparency = 0.3
	P("Inner", BALL, V(1.1, 0.8, 1.1) * s, CF(0, 0.35 * s, 0), col:Lerp(WHITE, 0.4), M.Neon)
	for i = 0, 5 do
		local a = i * math.pi / 3
		local x, z = math.cos(a) * 0.6 * s, math.sin(a) * 0.6 * s
		P("Tentacle", CYL, V(1.4, 0.12, 0.12) * s, CF(x, -0.6 * s, z) * ANG(0, 0, math.rad(90)) * ANG(math.sin(a) * 0.25, 0, 0), col:Lerp(WHITE, 0.2), M.Neon).Transparency = 0.3
	end
end

builders.binary = function(P, s, col)
	P("StarA", BALL, V(1.2, 1.2, 1.2) * s, CF(-0.9 * s, 0, 0), col, M.Neon)
	P("StarB", BALL, V(0.9, 0.9, 0.9) * s, CF(0.9 * s, 0, 0), C(140, 200, 255), M.Neon)
	P("Bridge", CYL, V(1.4, 0.25, 0.25) * s, CF(), col:Lerp(C(140, 200, 255), 0.5), M.Neon).Transparency = 0.4
	P("Orbit", CYL, V(0.04, 3.4, 3.4) * s, UP, WHITE, M.Neon).Transparency = 0.6
end

builders.quasar = function(P, s, col)
	P("Core", BALL, V(1, 1, 1) * s, CF(), WHITE, M.Neon)
	P("Disk", CYL, V(0.12, 3, 3) * s, UP, col, M.Neon).Transparency = 0.25
	P("Disk2", CYL, V(0.14, 2, 2) * s, UP, col:Lerp(C(255, 120, 255), 0.5), M.Neon).Transparency = 0.15
	P("JetUp", CYL, V(3, 0.3, 0.3) * s, CF(0, 1.6 * s, 0) * UP, col:Lerp(WHITE, 0.5), M.Neon).Transparency = 0.2
	P("JetDown", CYL, V(3, 0.3, 0.3) * s, CF(0, -1.6 * s, 0) * UP, col:Lerp(WHITE, 0.5), M.Neon).Transparency = 0.2
end

builders.gummy = function(P, s, col)
	P("Body", BALL, V(1.4, 1.5, 1.1) * s, CF(0, -0.3 * s, 0), col, M.Glass).Transparency = 0.15
	P("Head", BALL, V(1.1, 1, 1) * s, CF(0, 0.75 * s, 0), col, M.Glass).Transparency = 0.15
	P("EarL", BALL, V(0.4, 0.4, 0.3) * s, CF(-0.45 * s, 1.2 * s, 0), col, M.Glass).Transparency = 0.15
	P("EarR", BALL, V(0.4, 0.4, 0.3) * s, CF(0.45 * s, 1.2 * s, 0), col, M.Glass).Transparency = 0.15
	P("ArmL", BALL, V(0.4, 0.7, 0.4) * s, CF(-0.7 * s, -0.1 * s, 0), col, M.Glass).Transparency = 0.15
	P("ArmR", BALL, V(0.4, 0.7, 0.4) * s, CF(0.7 * s, -0.1 * s, 0), col, M.Glass).Transparency = 0.15
	P("EyeL", BALL, V(0.15, 0.15, 0.1) * s, CF(-0.2 * s, 0.85 * s, -0.48 * s), DARK, M.SmoothPlastic)
	P("EyeR", BALL, V(0.15, 0.15, 0.1) * s, CF(0.2 * s, 0.85 * s, -0.48 * s), DARK, M.SmoothPlastic)
end

builders.cookie = function(P, s, col)
	P("Cookie", CYL, V(0.5, 2.4, 2.4) * s, UP, col, M.Sand)
	for i = 0, 6 do
		local a = i * 0.9
		local d = (0.3 + (i % 3) * 0.3) * s
		P("Chip", BALL, V(0.3, 0.2, 0.3) * s, CF(math.cos(a) * d, 0.25 * s, math.sin(a) * d), C(70, 40, 25), M.SmoothPlastic)
	end
end

builders.donut = function(P, s, col)
	for i = 0, 11 do
		local a = i * math.pi / 6
		P("Dough", BALL, V(0.8, 0.7, 0.8) * s, CF(math.cos(a) * 0.9 * s, 0, math.sin(a) * 0.9 * s), C(220, 170, 110), M.SmoothPlastic)
		P("Icing", BALL, V(0.78, 0.4, 0.78) * s, CF(math.cos(a) * 0.9 * s, 0.2 * s, math.sin(a) * 0.9 * s), Color3.fromHSV(i / 12, 0.5, 1), M.SmoothPlastic)
	end
end

builders.dragon = function(P, s, col)
	-- 몸통은 구슬 여러 개를 물결처럼 잇는다
	for i = 0, 7 do
		local t = i / 7
		local w = (1 - t * 0.6) * s
		P("Body", BALL, V(w, w, w) * 1.1, CF(math.sin(t * 6) * 0.4 * s, math.cos(t * 5) * 0.3 * s, t * 3 * s - 0.6 * s), col:Lerp(C(120, 20, 20), t * 0.5), M.SmoothPlastic)
	end
	P("Head", BLOCK, V(0.9, 0.7, 1.2) * s, CF(0, 0.1 * s, -1.2 * s), col, M.SmoothPlastic)
	P("Jaw", BLOCK, V(0.7, 0.25, 0.8) * s, CF(0, -0.25 * s, -1.4 * s), col:Lerp(DARK, 0.3), M.SmoothPlastic)
	P("EyeL", BALL, V(0.2, 0.2, 0.2) * s, CF(-0.35 * s, 0.3 * s, -1.6 * s), C(255, 240, 80), M.Neon)
	P("EyeR", BALL, V(0.2, 0.2, 0.2) * s, CF(0.35 * s, 0.3 * s, -1.6 * s), C(255, 240, 80), M.Neon)
	P("HornL", BLOCK, V(0.12, 0.6, 0.12) * s, CF(-0.3 * s, 0.6 * s, -0.9 * s) * ANG(-0.5, 0, 0.3), GOLD, M.Metal)
	P("HornR", BLOCK, V(0.12, 0.6, 0.12) * s, CF(0.3 * s, 0.6 * s, -0.9 * s) * ANG(-0.5, 0, -0.3), GOLD, M.Metal)
	P("WingL", BLOCK, V(1.6, 0.06, 0.9) * s, CF(-1 * s, 0.4 * s, -0.2 * s) * ANG(0, 0, 0.4), col:Lerp(C(255, 160, 60), 0.4), M.Neon).Transparency = 0.25
	P("WingR", BLOCK, V(1.6, 0.06, 0.9) * s, CF(1 * s, 0.4 * s, -0.2 * s) * ANG(0, 0, -0.4), col:Lerp(C(255, 160, 60), 0.4), M.Neon).Transparency = 0.25
	P("Flame", BALL, V(0.4, 0.4, 0.8) * s, CF(0, -0.1 * s, -2 * s), C(255, 160, 40), M.Neon).Transparency = 0.2
end

builders.eye = function(P, s, col)
	P("White", BALL, V(2, 2, 2) * s, CF(), WHITE, M.SmoothPlastic)
	P("Iris", CYL, V(0.12, 1.2, 1.2) * s, CF(0, 0, -0.96 * s) * ANG(0, math.rad(90), 0), col, M.Neon)
	P("Pupil", CYL, V(0.14, 0.55, 0.55) * s, CF(0, 0, -1 * s) * ANG(0, math.rad(90), 0), DARK, M.SmoothPlastic)
	P("Lid", BALL, V(2.1, 0.9, 2.1) * s, CF(0, 0.75 * s, 0), C(140, 40, 60), M.SmoothPlastic)
	for i = 0, 7 do
		local a = i * math.pi / 4
		P("Ray", BLOCK, V(0.15, 0.9, 0.15) * s, ANG(0, 0, a) * CF(0, 1.55 * s, 0), GOLD, M.Neon)
	end
end

builders.timering = function(P, s, col)
	for i = 0, 15 do
		local a = i * math.pi / 8
		P("Ring", BLOCK, V(0.5, 0.25, 0.25) * s, CF(math.cos(a) * 1.4 * s, math.sin(a) * 1.4 * s, 0) * ANG(0, 0, a + math.pi / 2), i % 4 == 0 and WHITE or col, M.Neon)
	end
	P("Clock", CYL, V(0.15, 1.6, 1.6) * s, ANG(0, math.rad(90), 0), C(30, 50, 60), M.Glass)
	P("HandH", BLOCK, V(0.1, 0.55, 0.06) * s, CF(0, 0.25 * s, -0.1 * s), WHITE, M.Neon)
	P("HandM", BLOCK, V(0.6, 0.08, 0.06) * s, CF(0.28 * s, 0, -0.1 * s), col, M.Neon)
	P("Sand", BALL, V(0.25, 0.25, 0.25) * s, CF(0, 0, -0.12 * s), GOLD, M.Neon)
end

-- 위성 하나를 만든다. 첫 파트가 PrimaryPart(가운데)
function SatBuilder.build(shape: string, color: Color3, size: number, gold: boolean?): Model
	local model = Instance.new("Model")
	model.Name = shape
	local first: Part? = nil
	local function P(name: string, kind: Enum.PartType?, sz: Vector3, cf: CFrame, col: Color3, mat: Enum.Material): Part
		local p = Instance.new("Part")
		p.Name = name
		-- 로블록스 공(Ball)은 늘 완전한 구라서, 납작하거나 길쭉한 공은 구 모양 메시로 늘린다
		local stretched = kind == BALL and (math.abs(sz.X - sz.Y) > 0.01 or math.abs(sz.Y - sz.Z) > 0.01)
		if stretched then
			local mesh = Instance.new("SpecialMesh")
			mesh.MeshType = Enum.MeshType.Sphere
			mesh.Parent = p
		elseif kind and kind ~= BLOCK then
			p.Shape = kind
		end
		p.Anchored = true
		p.CanCollide = false
		p.CanTouch = false
		p.CanQuery = false
		p.CastShadow = false
		p.TopSurface = Enum.SurfaceType.Smooth
		p.BottomSurface = Enum.SurfaceType.Smooth
		p.Size = V(math.clamp(sz.X, 0.05, 2048), math.clamp(sz.Y, 0.05, 2048), math.clamp(sz.Z, 0.05, 2048))
		p.CFrame = cf
		if gold and mat ~= M.Neon and col ~= DARK then
			p.Color = col:Lerp(GOLD, 0.75)
			p.Material = M.Foil
			p.Reflectance = 0.25
		else
			p.Color = col
			p.Material = mat
		end
		p.Parent = model
		if not first then
			first = p
		end
		return p
	end
	local fn = builders[shape] or builders.rock
	fn(P, size, color)
	if gold and first then
		local sparkle = Instance.new("Sparkles")
		sparkle.SparkleColor = GOLD
		sparkle.Parent = first
	end
	if first then
		model.PrimaryPart = first
	end
	return model
end

function SatBuilder.has(shape: string): boolean
	return builders[shape] ~= nil
end

return SatBuilder
]]></string>
      </Properties>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="6">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Script" referent="7">
      <Properties>
        <string name="Name">HoleServer</string>
        <token name="RunContext">0</token>
        <string name="Source"><![CDATA[-- HoleServer (Script, ServerScriptService)
-- 삼키기 판정, 먹어서 커지기, 질량, 업그레이드 9종, 빅뱅과 빅뱅 상점, 위성(펫), 스킨과 스킨 능력,
-- 황금 물체, 연속 흡수 보너스, 퀘스트, 매일 보상, 로비, 순위판, 로벅스 상점, 부스트, 별똥별, 저장.
-- 캐릭터는 사람 모양이 아니라 보이지 않는 공 하나다 (걷는 모션 없음, 죽지 않음).
-- 중요한 계산은 모두 서버가 한다.
--   World  조명, 로비, 세계 2개의 구역, 문, 물체 배치
--   Store  게임패스와 개발자 상품 결제

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerStorage = game:GetService("ServerStorage")
local DataStoreService = game:GetService("DataStoreService")
local RunService = game:GetService("RunService")

local Config = require(ReplicatedStorage:WaitForChild("Config"))
local World = require(script:WaitForChild("World"))
local Store = require(script:WaitForChild("Store"))

-- 사람 캐릭터는 만들지 않는다. 블랙홀 캐릭터는 아래 spawnHole이 직접 만든다
Players.CharacterAutoLoads = false

local DATASTORE_NAME = "BlackHole_v1"
local SAVE_INTERVAL = 90
local TICK = 0.1
local LOBBY_SPEED = 40

------------------------------------------------------------------------
-- 통신 채널
------------------------------------------------------------------------
local remoteFolder = Instance.new("Folder")
remoteFolder.Name = "HoleRemotes"
local Request = Instance.new("RemoteEvent")
Request.Name = "Request"
Request.Parent = remoteFolder
local Push = Instance.new("RemoteEvent")
Push.Name = "Push"
Push.Parent = remoteFolder
remoteFolder.Parent = ReplicatedStorage

------------------------------------------------------------------------
-- 맵
------------------------------------------------------------------------
World.setupLighting()
local _, portals = World.buildZones()
local lobby = World.buildLobby()
for _, portal in ipairs(lobby.portals) do
	table.insert(portals, portal)
end
local objects, objectFolder = World.placeObjects()
local holding = Instance.new("Folder")
holding.Name = "EatenObjects"
holding.Parent = ServerStorage

-- 구역별로 나눠 둔다 (가까운 구역만 살펴보면 된다). 처음부터 몇 개는 황금 물체
local byZone: { [number]: { World.ObjectRec } } = {}
for _, rec in ipairs(objects) do
	byZone[rec.zone] = byZone[rec.zone] or {}
	table.insert(byZone[rec.zone], rec)
	if math.random() < Config.GOLDEN_CHANCE then
		rec.golden = true
		rec.model:SetAttribute("Golden", true)
	end
end

------------------------------------------------------------------------
-- 저장
------------------------------------------------------------------------
local store: DataStore? = nil
do
	local ok, ds = pcall(function()
		return DataStoreService:GetDataStore(DATASTORE_NAME)
	end)
	if ok then
		store = ds
	end
end

type Sat = { uid: number, id: string, gold: boolean }
-- 흡수 지점: pos에서 reach 안의, 크기 limit 이하 물체를 삼킨다
type Mouth = { pos: Vector3, reach: number, limit: number }
type Quest = { kind: string, goal: number, progress: number }

type Profile = {
	mass: number,
	total: number, -- 지금까지 삼킨 질량 (빅뱅해도 남는다)
	eaten: number,
	radius: number, -- 지금 반지름 (먹어서 커진다). 세계 2에서는 세계 2 단위
	tier: number, -- 이번 판에 있는 세계 (1 → 크기 400 넘기면 2, 빅뱅하면 다시 1)
	reached2: boolean, -- 세계 2에 한 번이라도 가 봤는지 (과자 캡슐)
	up: { [string]: number }, -- 업그레이드 레벨
	bigbang: number,
	dm: number, -- 암흑 물질
	bb: { [string]: number }, -- 빅뱅 상점 레벨
	sats: { Sat },
	equipped: { number }, -- 장착한 위성 uid
	nextUid: number,
	skins: { [string]: boolean }, -- 암흑 물질로 산 스킨, 세계 2 스킨
	skin: string,
	passes: { [string]: boolean }, -- 산 게임패스 (들어올 때 다시 확인한다)
	packGiven: boolean,
	boostUntil: number, -- os.time 기준
	respawnUntil: number,
	receipts: { string },
	auto: boolean,
	hatched: number,
	quests: { Quest },
	questsDone: number,
	dailyAt: number,
	streak: number,
}

local function defaultProfile(): Profile
	local bb = {}
	for _, b in ipairs(Config.BigbangShop) do
		bb[b.id] = 0
	end
	local up = {}
	for _, u in ipairs(Config.Upgrades) do
		up[u.id] = 0
	end
	return {
		mass = 0,
		total = 0,
		eaten = 0,
		radius = Config.START_RADIUS,
		tier = 1,
		reached2 = false,
		up = up,
		bigbang = 0,
		dm = 0,
		bb = bb,
		sats = {},
		equipped = {},
		nextUid = 1,
		skins = {},
		skin = "violet",
		passes = {},
		packGiven = false,
		boostUntil = 0,
		respawnUntil = 0,
		receipts = {},
		auto = false,
		hatched = 0,
		quests = {},
		questsDone = 0,
		dailyAt = 0,
		streak = 0,
	}
end

local function sanitize(data: any): Profile
	local p = defaultProfile()
	if type(data) ~= "table" then
		return p
	end
	local function num(v: any, hi: number): number
		if type(v) ~= "number" or v ~= v then
			return 0
		end
		return math.clamp(v, 0, hi)
	end
	p.mass = num(data.mass, math.huge)
	p.total = num(data.total, math.huge)
	p.eaten = math.floor(num(data.eaten, math.huge))
	p.bigbang = math.floor(num(data.bigbang, 1000))
	local up = type(data.up) == "table" and data.up or data -- 예전 기록은 grow/pull/mult가 바깥에 있었다
	for _, u in ipairs(Config.Upgrades) do
		p.up[u.id] = math.floor(num(up[u.id], u.maxLevel))
	end
	p.dm = math.floor(num(data.dm, 1e9))
	if type(data.bb) == "table" then
		for _, b in ipairs(Config.BigbangShop) do
			p.bb[b.id] = math.floor(num(data.bb[b.id], b.maxLevel))
		end
	end
	p.tier = data.tier == 2 and 2 or 1
	p.reached2 = data.reached2 == true or p.tier == 2
	local maxR = Config.maxRadius(p.bigbang, p.up.maxsize, p.tier)
	p.radius = math.clamp(num(data.radius, maxR), Config.START_RADIUS, maxR)
	local uids = {}
	if type(data.sats) == "table" then
		for _, s in ipairs(data.sats) do
			if type(s) == "table" and type(s.id) == "string" and Config.SAT_BY_ID[s.id] and type(s.uid) == "number" and not uids[s.uid] then
				uids[s.uid] = true
				table.insert(p.sats, { uid = math.floor(s.uid), id = s.id, gold = s.gold == true })
			end
			if #p.sats >= Config.SAT_INVENTORY + 10 then
				break
			end
		end
	end
	p.nextUid = math.max(1, math.floor(num(data.nextUid, 1e12)))
	for _, s in ipairs(p.sats) do
		p.nextUid = math.max(p.nextUid, s.uid + 1)
	end
	if type(data.equipped) == "table" then
		for _, uid in ipairs(data.equipped) do
			if uids[uid] and not table.find(p.equipped, uid) then
				table.insert(p.equipped, uid)
			end
		end
	end
	if type(data.skins) == "table" then
		for id, v in pairs(data.skins) do
			if type(id) == "string" and Config.SKIN_BY_ID[id] and v == true then
				p.skins[id] = true
			end
		end
	end
	if type(data.skin) == "string" and Config.SKIN_BY_ID[data.skin] then
		p.skin = data.skin
	end
	if type(data.passes) == "table" then
		for key, v in pairs(data.passes) do
			if type(key) == "string" and Config.PASS_BY_KEY[key] and v == true then
				p.passes[key] = true
			end
		end
	end
	p.packGiven = data.packGiven == true
	p.boostUntil = num(data.boostUntil, 1e11)
	p.respawnUntil = num(data.respawnUntil, 1e11)
	if type(data.receipts) == "table" then
		for _, r in ipairs(data.receipts) do
			if type(r) == "string" then
				table.insert(p.receipts, r)
			end
		end
	end
	p.auto = data.auto == true
	p.hatched = math.floor(num(data.hatched, math.huge))
	if type(data.quests) == "table" then
		for _, q in ipairs(data.quests) do
			if type(q) == "table" and type(q.kind) == "string" and Config.QUEST_BY_KIND[q.kind] and type(q.goal) == "number" and q.goal > 0 then
				table.insert(p.quests, { kind = q.kind, goal = math.floor(q.goal), progress = math.floor(num(q.progress, q.goal)) })
			end
			if #p.quests >= 3 then
				break
			end
		end
	end
	p.questsDone = math.floor(num(data.questsDone, 1e9))
	p.dailyAt = num(data.dailyAt, 1e11)
	p.streak = math.floor(num(data.streak, 1e6))
	return p
end

local function isTester(player: Player): boolean
	if not Config.TEST_MODE then
		return false
	end
	if RunService:IsStudio() then
		return true
	end
	return game.CreatorType == Enum.CreatorType.User and player.UserId == game.CreatorId
end

type State = {
	canSave: boolean,
	dirty: boolean,
	tester: boolean,
	reqWindow: number,
	reqCount: number,
	zone: number,
	world: number,
	inLobby: boolean,
	passes: { [string]: boolean }, -- 들어올 때 확인한 게임패스
	starPos: Vector3?,
	starExpire: number,
	nextStar: number,
	starUntil: number,
	portalAt: number,
	lockToastAt: number,
	combo: number,
	lastEat: number,
	activeUntil: number, -- 액티브 스킬이 끝나는 시각 (os.clock)
	activeOn: boolean,
	activeId: string,
	cdUntil: number,
	shots: { Mouth }, -- 다음 틱에 한 번만 쓰는 흡수 지점 (빛줄기, 순간이동, 신의 시선)
	trail: { { pos: Vector3, t: number } }, -- 성운 꼬리
	sugarLevel: number,
	advanceNotified: boolean,
	unstuckAt: number?,
}

local profiles: { [Player]: Profile } = {}
local states: { [Player]: State } = {}

local function loadProfile(player: Player): (Profile, boolean)
	local ds = store
	if not ds then
		return defaultProfile(), false
	end
	for attempt = 1, 3 do
		local ok, result = pcall(function()
			return ds:GetAsync("p_" .. player.UserId)
		end)
		if ok then
			return sanitize(result), true
		end
		warn("[BlackHole] 불러오기 실패 (" .. attempt .. "/3):", result)
		task.wait(1.5 * attempt)
	end
	-- 불러오기에 실패했을 때 저장하면 기존 기록을 덮어쓰므로 저장을 끈다
	return defaultProfile(), false
end

local function saveProfile(player: Player)
	local p, st, ds = profiles[player], states[player], store
	if not (p and st and ds and st.canSave) then
		return
	end
	local ok, err = pcall(function()
		ds:SetAsync("p_" .. player.UserId, p)
	end)
	if ok then
		st.dirty = false
	else
		warn("[BlackHole] 저장 실패:", err)
	end
end

------------------------------------------------------------------------
-- 계산 도우미
------------------------------------------------------------------------
local Calc = {}
local NO_ABILITY = { kind = "passive", name = "", desc = "" }

function Calc.hasPass(player: Player, key: string): boolean
	local p, st = profiles[player], states[player]
	return (p and p.passes[key] == true) or (st and st.passes[key] == true) or false
end

function Calc.maxRadius(p: Profile): number
	return Config.maxRadius(p.bigbang, p.up.maxsize, p.tier)
end

function Calc.slots(player: Player, p: Profile): number
	local n = Config.SAT_SLOTS + (p.bb.slots or 0)
	if Calc.hasPass(player, "vip") then
		n += 1
	end
	if Calc.hasPass(player, "slots2") then
		n += 2
	end
	if Calc.hasPass(player, "petpack") then
		n += 1
	end
	return n
end

function Calc.findSat(p: Profile, uid: number): (Sat?, number)
	for i, s in ipairs(p.sats) do
		if s.uid == uid then
			return s, i
		end
	end
	return nil, 0
end

-- 지금 스킨의 고유 능력
function Calc.ability(p: Profile): any
	local skin = Config.SKIN_BY_ID[p.skin]
	return skin and skin.ability or NO_ABILITY
end

-- 장착한 위성 배율 합: 1 + Σ(배율 - 1), 신의 눈 스킨이면 +20%
function Calc.satMult(p: Profile): number
	local m = 1
	for _, uid in ipairs(p.equipped) do
		local s = Calc.findSat(p, uid)
		if s then
			m += Config.satMult(s.id, s.gold) - 1
		end
	end
	return m * (1 + (Calc.ability(p).sats or 0))
end

-- 액티브 스킬이 켜져 있는지
function Calc.active(st: State?): boolean
	return st ~= nil and st.activeOn and os.clock() < st.activeUntil
end

-- 켜져 있는 액티브 스킬 id ("" = 없음)
function Calc.activeId(st: State?): string
	if st and Calc.active(st) then
		return st.activeId
	end
	return ""
end

-- 적색 팽창: 먹을 수 있는 크기와 범위 배수
function Calc.swell(p: Profile, st: State?): number
	if Calc.activeId(st) == "swell" then
		return Calc.ability(p).swell or 1
	end
	return 1
end

-- 은하 소용돌이: 흡수 범위 배수
function Calc.vortex(p: Profile, st: State?): number
	if Calc.activeId(st) == "vortex" then
		return Calc.ability(p).vortex or 1
	end
	return 1
end

-- 슈가 러시: 연속 흡수할수록 빨라진다
function Calc.speedExtra(p: Profile, st: State?): number
	local ab = Calc.ability(p)
	if ab.sugar and st and os.clock() - st.lastEat <= Config.COMBO_WINDOW then
		return 1 + math.min(ab.sugar, st.combo * 0.01)
	end
	return 1
end

-- 스킨 능력 질량·성장 보너스
function Calc.skinBonus(p: Profile, st: State?): (number, number)
	local ab = Calc.ability(p)
	local mass, grow = ab.mass or 0, ab.grow or 0
	if ab.growSmall and p.radius < 50 then
		grow += ab.growSmall
	end
	if ab.world2 and p.tier == 2 and st and not st.inLobby then
		mass += ab.world2
	end
	return mass, grow
end

function Calc.comboBonus(p: Profile, st: State?): number
	if not st then
		return 0
	end
	local s = st :: State
	if os.clock() - s.lastEat > Config.COMBO_WINDOW then
		return 0
	end
	return Config.comboBonus(s.combo, p.up.combo)
end

function Calc.totalMult(player: Player, p: Profile): number
	local st = states[player]
	local skinMass = Calc.skinBonus(p, st)
	return Config.totalMult({
		mult = p.up.mult,
		bigbang = p.bigbang,
		bbMass = p.bb.mass,
		sats = Calc.satMult(p),
		vip = Calc.hasPass(player, "vip"),
		mass2 = Calc.hasPass(player, "mass2"),
		boost = p.boostUntil > os.time(),
		star = st ~= nil and st.starUntil > os.clock(),
		skin = skinMass,
		combo = Calc.comboBonus(p, st),
	})
end

function Calc.growMult(player: Player, p: Profile): number
	local st = states[player]
	local _, skinGrow = Calc.skinBonus(p, st)
	return Config.growMult({ grow = p.up.grow, bigbang = p.bigbang, star = st ~= nil and st.starUntil > os.clock(), skin = skinGrow })
end

function Calc.respawnFactor(player: Player, p: Profile): number
	return Config.respawnFactor(p.bb.respawn, Calc.hasPass(player, "vip"), p.respawnUntil > os.time(), p.up.respawn, Calc.ability(p).respawn)
end

function Calc.skinUnlocked(player: Player, p: Profile, skin: any): boolean
	if skin.unlock == "bigbang" then
		return p.bigbang >= skin.value
	elseif skin.unlock == "dm" or skin.unlock == "world2" then
		return p.skins[skin.id] == true
	elseif skin.unlock == "pass" then
		return Calc.hasPass(player, skin.value)
	end
	return false
end

------------------------------------------------------------------------
-- 상태 보내기와 캐릭터 꾸미기
------------------------------------------------------------------------
local function pushState(player: Player)
	local p, st = profiles[player], states[player]
	if not p or not st then
		return
	end
	local r = p.radius
	local now = os.time()
	local skins = {}
	for _, skin in ipairs(Config.Skins) do
		if Calc.skinUnlocked(player, p, skin) then
			table.insert(skins, skin.id)
		end
	end
	local passes = {}
	for _, pass in ipairs(Config.GamePasses) do
		if Calc.hasPass(player, pass.key) then
			passes[pass.key] = true
		end
	end
	local clock = os.clock()
	Push:FireClient(player, "state", {
		mass = p.mass,
		total = p.total,
		eaten = p.eaten,
		radius = r,
		maxRadius = Calc.maxRadius(p),
		up = p.up,
		bigbang = p.bigbang,
		dm = p.dm,
		bb = p.bb,
		pullRange = Config.pullRange(r * Calc.swell(p, st)) * Calc.vortex(p, st),
		tier = p.tier,
		reached2 = p.reached2,
		canAdvance = p.tier == 1 and r >= Config.WORLD2_RADIUS,
		activeId = Calc.activeId(st),
		totalMult = Calc.totalMult(player, p),
		growMult = Calc.growMult(player, p),
		satMult = Calc.satMult(p),
		sats = p.sats,
		equipped = p.equipped,
		slots = Calc.slots(player, p),
		skins = skins,
		skin = p.skin,
		passes = passes,
		boostLeft = math.max(0, p.boostUntil - now),
		respawnLeft = math.max(0, p.respawnUntil - now),
		starLeft = math.max(0, st.starUntil - clock),
		activeLeft = Calc.active(st) and math.max(0, st.activeUntil - clock) or 0,
		cdLeft = math.max(0, st.cdUntil - clock),
		auto = p.auto,
		hatched = p.hatched,
		quests = p.quests,
		questsDone = p.questsDone,
		dailyLeft = math.max(0, p.dailyAt + Config.DAILY_HOURS * 3600 - now),
		streak = p.streak,
		inLobby = st.inLobby,
		world = st.world,
		tester = st.tester,
		canSave = st.canSave,
	})
end

local function updateLeaderstats(player: Player)
	local p = profiles[player]
	local ls = player:FindFirstChild("leaderstats")
	if not p or not ls then
		return
	end
	local massValue = ls:FindFirstChild("질량")
	local sizeValue = ls:FindFirstChild("크기")
	local bbValue = ls:FindFirstChild("빅뱅")
	if massValue and massValue:IsA("StringValue") then
		massValue.Value = Config.formatNumber(p.total)
	end
	if sizeValue and sizeValue:IsA("StringValue") then
		sizeValue.Value = Config.formatSize(p.radius)
	end
	if bbValue and bbValue:IsA("IntValue") then
		bbValue.Value = p.bigbang
	end
end

-- 블랙홀 모양은 모든 화면이 직접 그린다 (크기, 스킨, 위성만 속성으로 알려 준다)
local function applyHole(player: Player)
	local p, st = profiles[player], states[player]
	local char = player.Character
	if not p or not st or not char then
		return
	end
	local r = p.radius
	local skin = Config.SKIN_BY_ID[p.skin]
	if not skin or not Calc.skinUnlocked(player, p, skin) then
		skin = Config.Skins[1]
		p.skin = skin.id
	end
	local vip = Calc.hasPass(player, "vip")
	player:SetAttribute("VIP", vip)
	char:SetAttribute("HoleR", r)
	char:SetAttribute("HoleSkin", skin.index)
	char:SetAttribute("SkillOn", Calc.active(st))
	char:SetAttribute("SkillId", Calc.activeId(st))
	char:SetAttribute("Swell", Calc.swell(p, st))
	local satList = {}
	for _, uid in ipairs(p.equipped) do
		local s = Calc.findSat(p, uid)
		if s then
			table.insert(satList, s.id .. ":" .. (s.gold and "1" or "0"))
		end
	end
	char:SetAttribute("Sats", table.concat(satList, ","))
	local hum = char:FindFirstChildOfClass("Humanoid")
	if hum then
		if st.inLobby then
			hum.WalkSpeed = LOBBY_SPEED
		else
			hum.WalkSpeed = Config.walkSpeed(r, p.bb.speed, Calc.hasPass(player, "speed2"), p.up.speed, Calc.speedExtra(p, st))
		end
	end
	local head = char:FindFirstChild("Head")
	if head and head:IsA("BasePart") then
		local tag = head:FindFirstChild("HoleTag")
		if not tag then
			local gui = Instance.new("BillboardGui")
			gui.Name = "HoleTag"
			gui.Size = UDim2.new(0, 260, 0, 50)
			gui.AlwaysOnTop = true
			gui.LightInfluence = 0
			gui.MaxDistance = 5000
			local l = Instance.new("TextLabel")
			l.Name = "Label"
			l.Size = UDim2.fromScale(1, 1)
			l.BackgroundTransparency = 1
			l.Font = Enum.Font.GothamBlack
			l.TextScaled = true
			l.TextColor3 = Color3.new(1, 1, 1)
			l.TextStrokeTransparency = 0.3
			l.Parent = gui
			gui.Parent = head
			tag = gui
		end
		local gui = tag :: BillboardGui
		local shown = st.inLobby and math.min(r, 8) or r
		gui.StudsOffset = Vector3.new(0, 4 + shown * 0.25, 0)
		local label = gui:FindFirstChild("Label")
		if label and label:IsA("TextLabel") then
			label.Text = string.format("%s%s · ⚫%s", vip and "👑 " or "", player.DisplayName, Config.formatSize(r))
			label.TextColor3 = vip and Color3.fromRGB(255, 215, 80) or skin.b
		end
	end
	updateLeaderstats(player)
end

local function toast(player: Player, text: string)
	Push:FireClient(player, "toast", text)
end

local function moveTo(player: Player, pos: Vector3)
	local char = player.Character
	if char then
		char:PivotTo(CFrame.new(pos))
	end
end

-- 세계 시작 지점
local function spawnPos(world: number): Vector3
	return Vector3.new(Config.Worlds[world].x, 5, 22)
end

------------------------------------------------------------------------
-- 퀘스트: 늘 3개. 끝내면 바로 보상을 주고 새 퀘스트를 건다
------------------------------------------------------------------------
local Quests = {}

function Quests.fill(p: Profile)
	while #p.quests < 3 do
		local active = {}
		for _, q in ipairs(p.quests) do
			active[q.kind] = true
		end
		local avail = {}
		for _, def in ipairs(Config.Quests) do
			if not active[def.kind] then
				table.insert(avail, def)
			end
		end
		if #avail == 0 then
			break
		end
		local def = avail[math.random(1, #avail)]
		local goal = math.max(1, math.floor(def.base * def.grow ^ math.min(p.questsDone, 40) + 0.5))
		table.insert(p.quests, { kind = def.kind, goal = goal, progress = 0 })
	end
end

-- 진행도 올리기. isMax면 지금 값과 비교해 더 큰 쪽 (연속 흡수처럼)
function Quests.add(player: Player, p: Profile, kind: string, amount: number, isMax: boolean?)
	if amount <= 0 then
		return
	end
	local done = false
	for i = #p.quests, 1, -1 do
		local q = p.quests[i]
		if q.kind == kind then
			if isMax then
				q.progress = math.max(q.progress, amount)
			else
				q.progress += amount
			end
			if q.progress >= q.goal then
				local def = Config.QUEST_BY_KIND[q.kind]
				local text = string.format(def.text, Config.formatNumber(q.goal))
				local reward
				if def.reward == "dm" then
					local n = 1 + p.questsDone // 6
					p.dm += n
					reward = string.format("🌑 암흑 물질 +%d", n)
				else
					local amountMass = math.max(200, Config.biggestMass(p.tier, p.radius) * 25 * Calc.totalMult(player, p))
					p.mass += amountMass
					p.total += amountMass
					reward = "💠 +" .. Config.formatNumber(amountMass)
				end
				table.remove(p.quests, i)
				p.questsDone += 1
				done = true
				Push:FireClient(player, "quest", { text = text, reward = reward })
			end
		end
	end
	if done then
		Quests.fill(p)
		pushState(player)
	end
end

------------------------------------------------------------------------
-- 삼키기
------------------------------------------------------------------------
local function respawn(rec: World.ObjectRec)
	rec.model:SetAttribute("EatenBy", nil)
	rec.model:SetAttribute("Golden", rec.golden and true or nil)
	for part, can in pairs(rec.collide) do
		part.CanCollide = can
	end
	rec.model.Parent = objectFolder
	rec.alive = true
end

-- factor = 재생 시간 배율, goldChance = 다시 생길 때 황금일 확률 (먹은 사람의 업그레이드·스킨 기준)
local function eat(player: Player, rec: World.ObjectRec, factor: number, goldChance: number)
	rec.alive = false
	rec.model:SetAttribute("EatenBy", player.UserId)
	for part in pairs(rec.collide) do
		part.CanCollide = false
	end
	-- 빨려 들어가는 모습은 화면마다 그리고, 잠시 뒤 서버에서 치운다
	task.delay(0.6, function()
		if not rec.alive then
			rec.model.Parent = holding
		end
	end)
	local wait = Config.Zones[rec.zone].respawn * (0.8 + math.random() * 0.5) * factor
	task.delay(math.max(0.7, wait), function()
		if not rec.alive then
			rec.golden = math.random() < goldChance
			respawn(rec)
		end
	end)
end

local function flatDist(a: Vector3, b: Vector3): number
	local dx, dz = a.X - b.X, a.Z - b.Z
	return math.sqrt(dx * dx + dz * dz)
end

-- 별똥별: 내 근처 같은 구역 안에 떨어뜨린다 (화면에는 그 사람에게만 보인다)
local function dropStar(player: Player, st: State, pos: Vector3, r: number)
	local zi = Config.zoneAt(pos)
	local zone = Config.Zones[zi]
	local wx = Config.Worlds[zone.world].x
	local z0 = Config.zoneStart(zi)
	local a = math.random() * math.pi * 2
	local d = r * 1.5 + 25 + math.random() * (r + 30)
	local x = math.clamp(pos.X + math.cos(a) * d, wx - zone.width / 2 + 10, wx + zone.width / 2 - 10)
	local z = math.clamp(pos.Z + math.sin(a) * d, z0 + 10, z0 + zone.length - 10)
	local spot = Vector3.new(x, 0, z)
	st.starPos = spot
	st.starExpire = os.clock() + Config.STAR_LIFETIME
	Push:FireClient(player, "star", { pos = spot, life = Config.STAR_LIFETIME })
end

local Actions = {}

-- 안전한 자리 찾기. 지금 자리가 괜찮으면 nil
function Actions.safeSpot(pos: Vector3): Vector3?
	if Config.inLobby(pos) then
		if pos.Y < -30 then
			return lobby.spawn
		end
		return nil
	end
	local zi = Config.zoneAt(pos)
	local zone = Config.Zones[zi]
	local wx = Config.Worlds[zone.world].x
	local z0 = Config.zoneStart(zi)
	local outX = math.abs(pos.X - wx) > zone.width / 2 + 5
	local list = Config.zonesOf(zone.world)
	local worldEnd = Config.zoneStart(list[#list]) + Config.Zones[list[#list]].length
	local outZ = pos.Z < -5 or pos.Z > worldEnd + 5
	-- 세계와도 로비와도 먼 곳 (아주 멀리 날아감)
	if math.abs(pos.X - wx) > 20000 then
		return lobby.spawn
	end
	if pos.Y < -30 or outX or outZ then
		local x = math.clamp(pos.X, wx - zone.width / 2 + 30, wx + zone.width / 2 - 30)
		local z = math.clamp(pos.Z, z0 + 30, z0 + zone.length - 30)
		return Vector3.new(x, 6, z)
	end
	return nil
end

-- 🆘 끼었을 때: 지금 구역 가운데 길로 옮긴다 (로비면 로비 시작 자리)
function Actions.unstuck(player: Player)
	local st = states[player]
	local char = player.Character
	local root = char and char:FindFirstChild("HumanoidRootPart")
	if not st or not root or not root:IsA("BasePart") then
		return
	end
	local now = os.clock()
	if now < (st.unstuckAt or 0) then
		return
	end
	st.unstuckAt = now + 2
	local pos = root.Position
	root.AssemblyLinearVelocity = Vector3.zero
	if Config.inLobby(pos) or math.abs(pos.X - Config.LOBBY.x) < 5000 then
		moveTo(player, lobby.spawn)
	else
		local zi = Config.zoneAt(pos)
		local zone = Config.Zones[zi]
		local z0 = Config.zoneStart(zi)
		moveTo(player, Vector3.new(Config.Worlds[zone.world].x, 6, math.clamp(pos.Z, z0 + 30, z0 + zone.length - 30)))
	end
	toast(player, "🆘 빠져나왔어요!")
end

function Actions.goLobby(player: Player)
	local st = states[player]
	moveTo(player, lobby.spawn)
	if st then
		st.portalAt = os.clock() + 3
	end
	Push:FireClient(player, "world", 0)
end

-- 세계로 가기: 이번 판에 있는 세계로만 갈 수 있다 (세계 1 → 크기 400 넘기면 세계 2)
function Actions.goWorld(player: Player, w: number, quiet: boolean?)
	local p, st = profiles[player], states[player]
	if not p or not st or not Config.Worlds[w] then
		return
	end
	if w ~= p.tier then
		local now = os.clock()
		if quiet and now < st.lockToastAt then
			return
		end
		st.lockToastAt = now + 4
		if w == 2 then
			toast(player, string.format("🔒 세계 2는 세계 1에서 크기 %d을 넘기면 넘어갈 수 있어요", Config.WORLD2_RADIUS))
		else
			toast(player, "이번 판은 세계 2에서 계속해요 (빅뱅하면 세계 1부터 다시)")
		end
		return
	end
	st.world = w
	st.portalAt = os.clock() + 3
	moveTo(player, spawnPos(w))
	Push:FireClient(player, "world", w)
end

-- 세계 1에서 크기 400을 넘기면 세계 2로 넘어간다. 크기는 40분의 1이 된다
function Actions.advance(player: Player)
	local p, st = profiles[player], states[player]
	if not p or not st then
		return
	end
	if p.tier ~= 1 then
		toast(player, "이미 세계 2에 있어요")
		return
	end
	if p.radius < Config.WORLD2_RADIUS then
		toast(player, string.format("세계 1에서 크기 %d을 넘겨야 세계 2로 넘어갈 수 있어요 (지금 ⚫%s)", Config.WORLD2_RADIUS, Config.formatSize(p.radius)))
		return
	end
	local from = p.radius
	p.tier = 2
	p.reached2 = true
	p.radius = math.max(Config.START_RADIUS, from / Config.WORLD2_SCALE)
	st.world = 2
	st.activeOn = false
	st.shots = {}
	st.trail = {}
	st.dirty = true
	st.portalAt = os.clock() + 3
	moveTo(player, spawnPos(2))
	applyHole(player)
	Push:FireClient(player, "advanced", { from = from, to = p.radius })
	pushState(player)
end

local function tickPlayer(player: Player, p: Profile, st: State)
	local char = player.Character
	local root = char and char:FindFirstChild("HumanoidRootPart")
	if not root or not root:IsA("BasePart") then
		return
	end
	local pos = root.Position
	local now = os.clock()

	-- 안전망: 떨어졌거나 맵 밖으로 나갔으면 가까운 안전한 곳으로 돌려보낸다
	local safe = Actions.safeSpot(pos)
	if safe then
		root.AssemblyLinearVelocity = Vector3.zero
		moveTo(player, safe)
		return
	end

	-- 로비 들어가고 나오기
	local inLobby = Config.inLobby(pos)
	if inLobby ~= st.inLobby then
		st.inLobby = inLobby
		applyHole(player)
		pushState(player)
	end
	-- 액티브 스킬이 끝났으면 되돌린다
	if st.activeOn and now >= st.activeUntil then
		st.activeOn = false
		st.activeId = ""
		applyHole(player)
		pushState(player)
	end

	-- 문 (로비 ↔ 세계)
	for _, portal in ipairs(portals) do
		if flatDist(portal.pos, pos) < 12 and now > st.portalAt then
			st.portalAt = now + 3
			if portal.to == 0 then
				Actions.goLobby(player)
			else
				Actions.goWorld(player, portal.to, true)
			end
		end
	end
	if inLobby then
		return
	end

	local zone = Config.zoneAt(pos)
	local world = Config.Zones[zone].world
	-- 이번 판의 세계가 아닌 곳에 있으면 (예: 빅뱅 직후) 제 세계로 보낸다
	if world ~= p.tier then
		moveTo(player, spawnPos(p.tier))
		return
	end
	st.world = world
	if zone ~= st.zone then
		st.zone = zone
		Push:FireClient(player, "zone", zone)
	end

	local r = p.radius
	local ab = Calc.ability(p)
	local size = r * Calc.swell(p, st) -- 이만큼 큰 것까지 삼킨다
	local reach = size + Config.pullRange(size)

	-- 세계 2로 넘어갈 수 있게 되면 한 번 알려 준다
	if p.tier == 1 and r >= Config.WORLD2_RADIUS and not st.advanceNotified then
		st.advanceNotified = true
		Push:FireClient(player, "advanceReady", {})
		pushState(player)
	end

	-- 별똥별
	if st.starPos then
		local spot = st.starPos :: Vector3
		if flatDist(spot, pos) <= reach + 3 then
			st.starPos = nil
			local boost = Config.STAR_BOOST * (ab.star and 1.5 or 1)
			st.starUntil = math.max(now, st.starUntil) + boost
			st.nextStar = now + Config.starInterval(p.up.star, ab.star) * (0.8 + math.random() * 0.5)
			Push:FireClient(player, "starGot", { pos = spot, left = st.starUntil - now })
			Quests.add(player, p, "star", 1)
			pushState(player)
		elseif now > st.starExpire then
			st.starPos = nil
			st.nextStar = now + Config.starInterval(p.up.star, ab.star) * 0.5
		end
	elseif now > st.nextStar then
		dropStar(player, st, pos, r)
	end

	-- 흡수 지점들: 내 블랙홀 + 스킨 능력
	local mouths: { Mouth } = { { pos = pos, reach = reach * Calc.vortex(p, st), limit = size } }
	if ab.trail then
		-- 성운 꼬리: 지나간 자리 2초
		table.insert(st.trail, { pos = pos, t = now })
		while #st.trail > 0 and now - st.trail[1].t > 2 do
			table.remove(st.trail, 1)
		end
		for i = 1, #st.trail, 3 do
			local tp = st.trail[i]
			if now - tp.t > 0.25 then
				table.insert(mouths, { pos = tp.pos, reach = r * ab.trail + 1, limit = r })
			end
		end
	end
	if Calc.activeId(st) == "prism" then
		-- 프리즘 분신 둘이 둘레를 돈다 (화면도 같은 식으로 그린다)
		for k = 0, 1 do
			local a = now * 2.2 + k * math.pi
			table.insert(mouths, { pos = pos + Vector3.new(math.cos(a), 0, math.sin(a)) * r * 2.5, reach = r * 0.7 + Config.pullRange(r), limit = r })
		end
	end
	local limitCount = 40
	if #st.shots > 0 then
		for _, m in ipairs(st.shots) do
			table.insert(mouths, m)
		end
		st.shots = {}
		limitCount = 300
	end

	local mult = Calc.totalMult(player, p)
	local worldMass = Config.Worlds[world].massMult or 1
	local gm = Calc.growMult(player, p)
	local maxR = Calc.maxRadius(p)
	local factor = Calc.respawnFactor(player, p)
	local goldChance = Config.goldenChance(p.up.golden, ab.golden)
	local goldMass = Config.GOLDEN_MASS * (ab.goldenMass or 1)
	local reachable = Config.maxZone(world, size)
	local newR = r
	local eatenList = {}
	local gained = 0
	local goldenCount, bigCount = 0, 0
	local ateSun = false
	local chainFrom: { Vector3 } = {}

	local function consume(rec: World.ObjectRec)
		local golden = rec.golden
		eat(player, rec, factor, goldChance)
		local m = rec.def.mass * worldMass * mult * (golden and goldMass or 1)
		gained += m
		newR = Config.grow(newR, rec.def.size, gm * (golden and Config.GOLDEN_GROW or 1), maxR, world)
		table.insert(eatenList, { pos = rec.pos, mass = m, size = rec.def.size, name = rec.def.name, golden = golden })
		if golden then
			goldenCount += 1
		end
		if rec.def.size >= r * 0.5 then
			bigCount += 1
		end
		if rec.def.id == "candysun" then
			ateSun = true
		end
		if ab.chain and #chainFrom < 15 then
			table.insert(chainFrom, rec.pos)
		end
	end

	local function scan(list: { Mouth })
		for zi = math.max(1, zone - 2), math.min(#Config.Zones, zone + 2) do
			if Config.Zones[zi].world == world then
				for _, rec in ipairs(byZone[zi] or {}) do
					if #eatenList >= limitCount then
						return
					end
					if rec.alive and rec.zone <= reachable then
						for _, m in ipairs(list) do
							if rec.def.size <= m.limit and flatDist(rec.pos, m.pos) <= m.reach + rec.def.size * 0.5 then
								consume(rec)
								break
							end
						end
					end
				end
			end
		end
	end
	scan(mouths)
	-- 용암 연쇄 폭발: 삼킨 자리 주변도 한 번 더
	if #chainFrom > 0 then
		local chain: { Mouth } = {}
		for _, cp in ipairs(chainFrom) do
			table.insert(chain, { pos = cp, reach = r * ab.chain, limit = size })
		end
		limitCount += 20
		scan(chain)
	end

	-- 슈가 러시 속도는 연속 흡수가 바뀔 때만 다시 맞춘다
	if ab.sugar then
		local level = math.floor((Calc.speedExtra(p, st) - 1) * 10)
		if level ~= st.sugarLevel then
			st.sugarLevel = level
			applyHole(player)
		end
	end

	if #eatenList > 0 then
		if now - st.lastEat <= Config.COMBO_WINDOW then
			st.combo += #eatenList
		else
			st.combo = #eatenList
		end
		st.lastEat = now
		p.mass += gained
		p.total += gained
		p.eaten += #eatenList
		st.dirty = true
		if newR > p.radius then
			p.radius = newR
			applyHole(player)
		end
		Push:FireClient(player, "eat", {
			list = eatenList,
			gained = gained,
			mass = p.mass,
			radius = p.radius,
			pullRange = Config.pullRange(p.radius * Calc.swell(p, st)) * Calc.vortex(p, st),
			combo = st.combo,
			comboBonus = Config.comboBonus(st.combo, p.up.combo),
			burst = limitCount > 40,
		})
		updateLeaderstats(player)
		Quests.add(player, p, "eat", #eatenList)
		Quests.add(player, p, "golden", goldenCount)
		Quests.add(player, p, "big", bigCount)
		Quests.add(player, p, "combo", st.combo, true)
		if ateSun and not p.skins.sweet then
			p.skins.sweet = true
			Push:FireClient(player, "unlock", { kind = "skin", name = Config.SKIN_BY_ID.sweet.name })
			pushState(player)
		end
	end
end

task.spawn(function()
	while true do
		task.wait(TICK)
		for player, p in pairs(profiles) do
			local st = states[player]
			if st then
				local ok, err = pcall(tickPlayer, player, p, st)
				if not ok then
					warn("[BlackHole] 삼키기 오류:", err)
				end
			end
		end
	end
end)

------------------------------------------------------------------------
-- 서버 이벤트: 떠도는 거대 행성
-- 플레이어가 가장 많은 구역에 행성이 나타나 천천히 떠돈다. 블랙홀이 행성에 닿아 있으면
-- 0.1초마다 (1 + log2(1 + 크기))만큼 깎는다. 다 깎으면 깎은 몫만큼 보상 (Config.eventReward, 로그 공식).
-- 서버는 보이지 않는 부품 하나(GiantPlanet)만 움직이고, 행성 모양은 각 화면이 그린다.
------------------------------------------------------------------------
local Event = {
	active = false,
	zone = 0,
	world = 1,
	radius = 0,
	hp = 0,
	maxHp = 1,
	ends = 0,
	pos = Vector3.zero,
	target = Vector3.zero,
	speed = 20,
	contrib = {} :: { [number]: number },
	nextAt = os.clock() + Config.EVENT.firstDelay,
}
local eventFolder = Instance.new("Folder")
eventFolder.Name = "Event"
eventFolder.Parent = workspace
local planetAnchor = Instance.new("Part")
planetAnchor.Name = "GiantPlanet"
planetAnchor.Anchored = true
planetAnchor.CanCollide = false
planetAnchor.CanQuery = false
planetAnchor.CanTouch = false
planetAnchor.Transparency = 1
planetAnchor.Size = Vector3.new(1, 1, 1)
planetAnchor.CFrame = CFrame.new(0, -500, 0)
planetAnchor:SetAttribute("Active", false)
planetAnchor.Parent = eventFolder

-- 행성이 떠도는 범위 안의 아무 곳
function Event.randomSpot(): Vector3
	local zone = Config.Zones[Event.zone]
	local wx = Config.Worlds[zone.world].x
	local z0 = Config.zoneStart(Event.zone)
	local mx = math.max(0, zone.width / 2 - Event.radius - 20)
	local mz = math.max(0, zone.length / 2 - Event.radius - 20)
	return Vector3.new(wx + (math.random() * 2 - 1) * mx, 0, z0 + zone.length / 2 + (math.random() * 2 - 1) * mz)
end

-- 지금 보이는 크기 (깎일수록 작아진다)
function Event.shown(): number
	return Event.radius * (0.4 + 0.6 * math.sqrt(math.max(0, Event.hp / Event.maxHp)))
end

function Event.start(): boolean
	-- 사람이 가장 많은 구역
	local counts: { [number]: number } = {}
	for player, st in pairs(states) do
		if profiles[player] and not st.inLobby then
			counts[st.zone] = (counts[st.zone] or 0) + 1
		end
	end
	local bestZone, bestN = 0, 0
	for z, n in pairs(counts) do
		if n > bestN then
			bestZone, bestN = z, n
		end
	end
	if bestZone == 0 then
		return false
	end
	local zone = Config.Zones[bestZone]
	local sum, n = 0, 0
	for player, st in pairs(states) do
		local p = profiles[player]
		if p and not st.inLobby and st.world == zone.world then
			sum += p.radius
			n += 1
		end
	end
	local avgR = n > 0 and sum / n or 5
	Event.active = true
	Event.zone = bestZone
	Event.world = zone.world
	Event.radius = math.clamp(avgR * 2.5, 12, math.min(1500, zone.width * 0.3))
	Event.maxHp = Config.eventDamage(avgR) * 10 * Config.EVENT.soloSeconds * math.max(1, n) ^ 0.8
	Event.hp = Event.maxHp
	Event.ends = os.clock() + Config.EVENT.life
	Event.contrib = {}
	Event.pos = Event.randomSpot()
	Event.target = Event.randomSpot()
	Event.speed = math.max(12, Event.radius * 0.2)
	planetAnchor:SetAttribute("Radius", Event.radius)
	planetAnchor:SetAttribute("HP", Event.hp)
	planetAnchor:SetAttribute("MaxHP", Event.maxHp)
	planetAnchor:SetAttribute("Ends", workspace:GetServerTimeNow() + Config.EVENT.life)
	planetAnchor:SetAttribute("Zone", bestZone)
	planetAnchor.CFrame = CFrame.new(Event.pos)
	planetAnchor:SetAttribute("Active", true)
	Push:FireAllClients("event", { kind = "start", zone = bestZone, world = zone.world, radius = Event.radius })
	return true
end

function Event.finish(escaped: boolean)
	Event.active = false
	planetAnchor:SetAttribute("Active", false)
	local total = 0
	local topId, topC = 0, -1
	for id, c in pairs(Event.contrib) do
		total += c
		if c > topC then
			topId, topC = id, c
		end
	end
	local ranked = {}
	for id, c in pairs(Event.contrib) do
		table.insert(ranked, { id = id, c = c })
	end
	table.sort(ranked, function(a, b)
		return a.c > b.c
	end)
	for rank, e in ipairs(ranked) do
		local player = Players:GetPlayerByUserId(e.id)
		local p = player and profiles[player]
		local st = player and states[player]
		if player and p and st and total > 0 then
			local share = e.c / total
			-- 놓쳤으면 깎은 만큼만 (깎은 비율 × 반)
			local done = escaped and (1 - Event.hp / Event.maxHp) or 1
			local mass, grow, dm = Config.eventReward(share, Config.biggestMass(p.tier, p.radius), Calc.totalMult(player, p), e.id == topId, escaped)
			mass *= done
			grow *= done
			p.mass += mass
			p.total += mass
			p.radius = math.min(Calc.maxRadius(p), p.radius * (1 + grow))
			p.dm += dm
			st.dirty = true
			applyHole(player)
			Push:FireClient(player, "eventReward", { rank = rank, players = #ranked, share = share, mass = mass, grow = grow, dm = dm, escaped = escaped })
			pushState(player)
		end
	end
	Push:FireAllClients("event", { kind = escaped and "escape" or "done" })
	Event.nextAt = os.clock() + Config.EVENT.interval
end

task.spawn(function()
	local dt = 0.1
	while true do
		task.wait(dt)
		local now = os.clock()
		if not Event.active then
			if now >= Event.nextAt then
				if not Event.start() then
					Event.nextAt = now + 20
				end
			end
		else
			-- 천천히 떠돈다
			local to = Event.target - Event.pos
			if to.Magnitude < Event.speed * dt * 2 then
				Event.target = Event.randomSpot()
			else
				Event.pos += to.Unit * Event.speed * dt
			end
			planetAnchor.CFrame = CFrame.new(Event.pos)
			-- 닿아 있는 블랙홀이 깎는다
			local shown = Event.shown()
			for player, p in pairs(profiles) do
				local st = states[player]
				local char = player.Character
				local root = char and char:FindFirstChild("HumanoidRootPart")
				if st and root and root:IsA("BasePart") and not st.inLobby and st.world == Event.world then
					if flatDist(root.Position, Event.pos) < shown + p.radius then
						local dmg = Config.eventDamage(p.radius)
						Event.hp -= dmg
						Event.contrib[player.UserId] = (Event.contrib[player.UserId] or 0) + dmg
					end
				end
			end
			planetAnchor:SetAttribute("HP", math.max(0, Event.hp))
			if Event.hp <= 0 then
				Event.finish(false)
			elseif now > Event.ends then
				Event.finish(true)
			end
		end
	end
end)

------------------------------------------------------------------------
-- 업그레이드, 자동 업그레이드, 빅뱅, 이동, 스킬, 매일 보상
------------------------------------------------------------------------
-- 업그레이드 하나를 살 수 있는 만큼 산다
function Actions.buyUpgrade(player: Player, id: any, many: any): number
	local p = profiles[player]
	local u = type(id) == "string" and Config.UPGRADE_BY_ID[id]
	if not u then
		return 0
	end
	local bought = 0
	local limit = many == true and 300 or 1
	while bought < limit do
		local level = p.up[u.id]
		if level >= u.maxLevel then
			break
		end
		local cost = Config.upgradeCost(u.id, level)
		if p.mass < cost then
			break
		end
		p.mass -= cost
		p.up[u.id] = level + 1
		bought += 1
	end
	if bought == 0 then
		local level = p.up[u.id]
		if level >= u.maxLevel then
			toast(player, u.name .. "은(는) 이미 최대예요")
		else
			toast(player, "질량이 부족해요 (필요 💠" .. Config.formatNumber(Config.upgradeCost(u.id, level)) .. ")")
		end
		return 0
	end
	states[player].dirty = true
	applyHole(player)
	Push:FireClient(player, "upgraded", { id = u.id, count = bought, level = p.up[u.id] })
	pushState(player)
	return bought
end

-- 자동 업그레이드: 가장 싼 것부터 계속 산다 (성장력·질량 배율을 조금 더 우선)
function Actions.autoUpgrade(player: Player, p: Profile)
	local boughtAny = false
	for _ = 1, 80 do
		local best, bestCost = nil, math.huge
		for _, u in ipairs(Config.Upgrades) do
			local level = p.up[u.id]
			if level < u.maxLevel then
				local weight = (u.id == "grow" or u.id == "mult") and 0.7 or 1
				local cost = Config.upgradeCost(u.id, level) * weight
				if cost < bestCost then
					best, bestCost = u, cost
				end
			end
		end
		if not best then
			break
		end
		local cost = Config.upgradeCost(best.id, p.up[best.id])
		if p.mass < cost then
			break
		end
		p.mass -= cost
		p.up[best.id] += 1
		boughtAny = true
	end
	if boughtAny then
		states[player].dirty = true
		applyHole(player)
		pushState(player)
	end
end

task.spawn(function()
	while true do
		task.wait(0.5)
		for player, p in pairs(profiles) do
			if p.auto then
				pcall(Actions.autoUpgrade, player, p)
			end
		end
	end
end)

function Actions.bigbang(player: Player)
	local p, st = profiles[player], states[player]
	if p.tier ~= 2 then
		toast(player, string.format("빅뱅은 세계 2에서 해요. 먼저 세계 1에서 크기 %d을 넘기고 세계 2로 넘어가세요", Config.WORLD2_RADIUS))
		return
	end
	if p.radius < Config.BIGBANG_RADIUS then
		toast(player, string.format("세계 2에서 크기 ⚫%d 이상이어야 빅뱅할 수 있어요 (지금 ⚫%s)", Config.BIGBANG_RADIUS, Config.formatSize(p.radius)))
		return
	end
	local reward = Config.darkMatterReward(p.radius, p.bigbang, p.bb.dm)
	local before = {}
	for _, skin in ipairs(Config.Skins) do
		before[skin.id] = Calc.skinUnlocked(player, p, skin)
	end
	p.bigbang += 1
	p.dm += reward
	p.mass = p.mass * 0.05 * (p.bb.keep or 0)
	if (p.bb.seed or 0) > 0 then
		p.mass += 1000 * 10 ^ p.bb.seed
	end
	p.tier = 1
	p.radius = Config.startRadius(p.bb.start or 0)
	st.activeOn = false
	st.shots = {}
	st.trail = {}
	st.advanceNotified = false
	for _, u in ipairs(Config.Upgrades) do
		p.up[u.id] = 0
	end
	st.dirty = true
	local newSkins = {}
	for _, skin in ipairs(Config.Skins) do
		if not before[skin.id] and Calc.skinUnlocked(player, p, skin) then
			table.insert(newSkins, skin.name)
			p.skin = skin.id
		end
	end
	st.world = 1
	if not st.inLobby then
		moveTo(player, spawnPos(1))
	end
	applyHole(player)
	Push:FireClient(player, "bigbang", {
		count = p.bigbang,
		dm = reward,
		skins = newSkins,
		maxRadius = Config.maxRadius(p.bigbang, p.up.maxsize, 2),
	})
	pushState(player)
end

function Actions.teleport(player: Player, zoneArg: any)
	local p, st = profiles[player], states[player]
	local zi = math.floor(tonumber(zoneArg) or 0)
	local zone = Config.Zones[zi]
	if not zone then
		return
	end
	if zone.world ~= p.tier then
		Actions.goWorld(player, zone.world)
		return
	end
	local r = p.radius
	if zi > Config.maxZone(zone.world, r) then
		toast(player, string.format("크기 %d 이상이어야 갈 수 있어요", zone.need))
		return
	end
	local z0 = Config.zoneStart(zi)
	local z = math.min(z0 + 20 + r, z0 + zone.length / 2)
	st.world = zone.world
	st.portalAt = os.clock() + 3
	moveTo(player, Vector3.new(Config.Worlds[zone.world].x, 5 + math.min(r, 50) * 0.2, z))
end

-- 스킬 (Q). dx, dz = 화면이 바라보는 쪽 (빛줄기·순간이동 방향)
function Actions.skill(player: Player, dx: any, dz: any)
	local p, st = profiles[player], states[player]
	local ab = Calc.ability(p)
	if ab.kind ~= "active" then
		toast(player, string.format("%s: 늘 켜져 있는 능력이에요 (%s)", ab.name, ab.desc))
		return
	end
	if st.inLobby then
		toast(player, "로비에서는 스킬을 쓸 수 없어요")
		return
	end
	local char = player.Character
	local root = char and char:FindFirstChild("HumanoidRootPart")
	if not root or not root:IsA("BasePart") then
		return
	end
	local now = os.clock()
	if now < st.cdUntil then
		toast(player, string.format("%s: %d초 뒤에 다시 쓸 수 있어요", ab.name, math.ceil(st.cdUntil - now)))
		return
	end
	st.cdUntil = now + ab.cd
	local pos = Vector3.new(root.Position.X, 0, root.Position.Z)
	local dir = Vector3.new(tonumber(dx) or 0, 0, tonumber(dz) or 0)
	if dir ~= dir or dir.Magnitude < 0.1 then
		local look = root.CFrame.LookVector
		dir = Vector3.new(look.X, 0, look.Z)
	end
	if dir.Magnitude < 0.01 then
		dir = Vector3.new(0, 0, 1)
	end
	dir = dir.Unit
	local r = p.radius
	local pull = Config.pullRange(r)
	local fx: { [string]: any } = { id = ab.id, from = pos, dir = dir, r = r }
	if ab.id == "beam" then
		-- 퀘이사 빔: 바라보는 쪽 길 위를 한꺼번에
		for k = 1, 12 do
			table.insert(st.shots, { pos = pos + dir * (r * ab.len * k / 12), reach = r * 1.1 + 2, limit = r })
		end
		fx.to = pos + dir * r * ab.len
	elseif ab.id == "blink" then
		-- 빙결 순간이동: 지금 구역 안에서만 (닫힌 문은 못 넘는다)
		local zi = Config.zoneAt(pos)
		local zone = Config.Zones[zi]
		local wx = Config.Worlds[zone.world].x
		local z0 = Config.zoneStart(zi)
		local target = pos + dir * r * ab.len
		local margin = math.min(30, zone.width / 4)
		target = Vector3.new(math.clamp(target.X, wx - zone.width / 2 + margin, wx + zone.width / 2 - margin), 0, math.clamp(target.Z, z0 + margin, z0 + zone.length - margin))
		for k = 0, 10 do
			table.insert(st.shots, { pos = pos:Lerp(target, k / 10), reach = r + pull, limit = r })
		end
		moveTo(player, target + Vector3.new(0, 5, 0))
		fx.to = target
	elseif ab.id == "eye" then
		-- 신의 시선: 넓게, 나보다 큰 것까지
		table.insert(st.shots, { pos = pos, reach = r * ab.eye, limit = r * ab.eyeLimit })
	elseif (ab.dur or 0) > 0 then
		st.activeOn = true
		st.activeId = ab.id
		st.activeUntil = now + ab.dur
		fx.dur = ab.dur
	end
	applyHole(player)
	-- 스킬 모습은 모든 화면에 보인다
	fx.userId = player.UserId
	Push:FireAllClients("skillFx", fx)
	Push:FireClient(player, "skill", { id = ab.id, name = ab.name, dur = ab.dur or 0, cd = ab.cd })
	pushState(player)
end

function Actions.daily(player: Player)
	local p, st = profiles[player], states[player]
	if not p or not st then
		return
	end
	local now = os.time()
	local wait = p.dailyAt + Config.DAILY_HOURS * 3600 - now
	if wait > 0 then
		toast(player, "🎁 다음 보상까지 " .. Config.formatTime(wait))
		return
	end
	p.streak = (now - p.dailyAt < 48 * 3600) and p.streak + 1 or 1
	p.dailyAt = now
	local dm = 2 + math.min(p.streak, 7)
	local mass = math.max(1000, Config.biggestMass(p.tier, math.max(p.radius, 6)) * 80 * Calc.totalMult(player, p))
	p.dm += dm
	p.mass += mass
	p.total += mass
	st.dirty = true
	Push:FireClient(player, "daily", { streak = p.streak, dm = dm, mass = mass })
	pushState(player)
end

------------------------------------------------------------------------
-- 빅뱅 상점, 스킨
------------------------------------------------------------------------
function Actions.bbShop(player: Player, id: any)
	local p = profiles[player]
	local b = type(id) == "string" and Config.BB_BY_ID[id]
	if not b then
		return
	end
	local level = p.bb[b.id] or 0
	if level >= b.maxLevel then
		toast(player, b.name .. "은(는) 이미 최대예요")
		return
	end
	local cost = Config.bigbangShopCost(b.id, level)
	if p.dm < cost then
		toast(player, string.format("암흑 물질이 부족해요 (필요 🌑%d)", cost))
		return
	end
	p.dm -= cost
	p.bb[b.id] = level + 1
	states[player].dirty = true
	applyHole(player)
	Push:FireClient(player, "bbBought", { id = b.id, level = level + 1 })
	pushState(player)
end

function Actions.skin(player: Player, id: any)
	local p, st = profiles[player], states[player]
	local skin = type(id) == "string" and Config.SKIN_BY_ID[id]
	if not skin then
		return
	end
	if not Calc.skinUnlocked(player, p, skin) then
		if skin.unlock == "dm" then
			if p.dm < skin.value then
				toast(player, string.format("암흑 물질이 부족해요 (필요 🌑%d)", skin.value))
				return
			end
			p.dm -= skin.value
			p.skins[skin.id] = true
			toast(player, "🎨 " .. skin.name .. " 스킨을 얻었어요!")
		elseif skin.unlock == "bigbang" then
			toast(player, string.format("빅뱅 %d번 하면 열려요", skin.value))
			return
		elseif skin.unlock == "world2" then
			toast(player, "세계 2의 사탕 태양을 삼키면 열려요")
			return
		else
			toast(player, "💎 상점의 " .. Config.PASS_BY_KEY[skin.value].name .. "에 들어 있는 스킨이에요")
			return
		end
	end
	if p.skin ~= skin.id then
		-- 스킨을 바꾸면 켜져 있던 액티브 스킬은 끝난다
		st.activeOn = false
		st.activeId = ""
		st.shots = {}
	end
	p.skin = skin.id
	st.dirty = true
	applyHole(player)
	pushState(player)
end

------------------------------------------------------------------------
-- 위성 (펫)
------------------------------------------------------------------------
local Sats = {}

function Sats.add(p: Profile, id: string, gold: boolean): Sat
	local s = { uid = p.nextUid, id = id, gold = gold }
	p.nextUid += 1
	table.insert(p.sats, s)
	return s
end

function Sats.unequip(p: Profile, uid: number)
	local i = table.find(p.equipped, uid)
	if i then
		table.remove(p.equipped, i)
	end
end

function Sats.remove(p: Profile, uid: number)
	Sats.unequip(p, uid)
	local _, i = Calc.findSat(p, uid)
	if i > 0 then
		table.remove(p.sats, i)
	end
end

-- 가장 센 위성들로 칸을 채운다
function Sats.equipBest(player: Player, p: Profile)
	local list = table.clone(p.sats)
	table.sort(list, function(a, b)
		return Config.satMult(a.id, a.gold) > Config.satMult(b.id, b.gold)
	end)
	p.equipped = {}
	for i = 1, math.min(#list, Calc.slots(player, p)) do
		table.insert(p.equipped, list[i].uid)
	end
end

function Sats.roll(player: Player, p: Profile, cap: any): any
	local luck = (1 + 0.15 * (p.bb.luck or 0)) * (Calc.hasPass(player, "luck") and 2 or 1)
	local total = 0
	local weights = {}
	for i, s in ipairs(cap.sats) do
		local w = s.chance * (s.rarity >= 4 and luck or 1)
		weights[i] = w
		total += w
	end
	local x = math.random() * total
	for i, s in ipairs(cap.sats) do
		x -= weights[i]
		if x <= 0 then
			return s
		end
	end
	return cap.sats[1]
end

function Sats.hatch(player: Player, capId: any, wantTriple: any)
	local p = profiles[player]
	local cap = type(capId) == "string" and Config.CAPSULE_BY_ID[capId]
	if not cap then
		return
	end
	if not states[player].inLobby then
		toast(player, "🏠 캡슐은 로비의 캡슐 기계에서 깰 수 있어요")
		return
	end
	if cap.world == 2 and not p.reached2 then
		toast(player, "🔒 " .. cap.name .. "은(는) 세계 2에 한 번 가 보면 깰 수 있어요")
		return
	end
	local count = 1
	if wantTriple == true then
		if not Calc.hasPass(player, "triple") then
			toast(player, "🥚 3개 부화는 💎 상점의 게임패스예요")
			return
		end
		count = 3
	end
	if p.mass < cap.cost * count then
		toast(player, "질량이 부족해요 (필요 💠" .. Config.formatNumber(cap.cost * count) .. ")")
		return
	end
	if #p.sats + count > Config.SAT_INVENTORY then
		toast(player, string.format("위성 가방이 가득 찼어요 (%d개). 🛰 위성 창에서 정리해 주세요", Config.SAT_INVENTORY))
		return
	end
	p.mass -= cap.cost * count
	local results = {}
	for _ = 1, count do
		local def = Sats.roll(player, p, cap)
		local s = Sats.add(p, def.id, false)
		p.hatched += 1
		-- 빈 칸이 있으면 바로 데리고 다닌다
		if #p.equipped < Calc.slots(player, p) then
			table.insert(p.equipped, s.uid)
		end
		table.insert(results, def.id)
	end
	states[player].dirty = true
	applyHole(player)
	Push:FireClient(player, "hatched", { capsule = cap.id, results = results })
	pushState(player)
end

function Sats.action(player: Player, action: string, arg: any)
	local p = profiles[player]
	if action == "satEquip" then
		local uid = tonumber(arg) or 0
		local s = Calc.findSat(p, uid)
		if not s then
			return
		end
		if table.find(p.equipped, uid) then
			Sats.unequip(p, uid)
		elseif #p.equipped >= Calc.slots(player, p) then
			toast(player, string.format("위성 칸이 가득 찼어요 (%d칸)", Calc.slots(player, p)))
			return
		else
			table.insert(p.equipped, uid)
		end
	elseif action == "satBest" then
		Sats.equipBest(player, p)
	elseif action == "satDelete" then
		local uid = tonumber(arg) or 0
		local s = Calc.findSat(p, uid)
		if not s then
			return
		end
		if Config.SAT_BY_ID[s.id].rarity >= 6 then
			toast(player, "비밀 위성은 버릴 수 없어요")
			return
		end
		Sats.remove(p, uid)
	elseif action == "satGold" then
		-- 같은 위성(황금 아닌 것) 5개를 황금 1개로
		local id = type(arg) == "string" and arg or ""
		local same = {}
		for _, s in ipairs(p.sats) do
			if s.id == id and not s.gold then
				table.insert(same, s.uid)
			end
		end
		if #same < Config.GOLD_COUNT then
			toast(player, string.format("같은 위성이 %d개 있어야 황금으로 만들 수 있어요", Config.GOLD_COUNT))
			return
		end
		local wasEquipped = false
		for i = 1, Config.GOLD_COUNT do
			if table.find(p.equipped, same[i]) then
				wasEquipped = true
			end
			Sats.remove(p, same[i])
		end
		local g = Sats.add(p, id, true)
		if wasEquipped or #p.equipped < Calc.slots(player, p) then
			table.insert(p.equipped, g.uid)
		end
		Push:FireClient(player, "gold", { id = id })
	else
		return
	end
	states[player].dirty = true
	applyHole(player)
	pushState(player)
end

------------------------------------------------------------------------
-- 로벅스 상점 연결
------------------------------------------------------------------------
local function grantPass(player: Player, key: string)
	local p, st = profiles[player], states[player]
	if not p or not st then
		return
	end
	if st.tester then
		st.passes[key] = true
	else
		p.passes[key] = true
		st.dirty = true
	end
	if key == "petpack" and not p.packGiven then
		p.packGiven = true
		for _, s in ipairs(Config.ExclusiveSats) do
			Sats.add(p, s.id, false)
		end
		Sats.equipBest(player, p)
		p.skin = "godeye"
		Push:FireClient(player, "unlock", { kind = "pack", name = Config.PASS_BY_KEY.petpack.name })
	elseif key == "vip" then
		p.skin = "vip"
	end
	applyHole(player)
	pushState(player)
end

local function grantProduct(player: Player, key: string, receiptId: string): boolean
	local p, st = profiles[player], states[player]
	if not p or not st then
		return false
	end
	local now = os.time()
	if key == "boost30" then
		p.boostUntil = math.max(now, p.boostUntil) + 1800
	elseif key == "respawn30" then
		p.respawnUntil = math.max(now, p.respawnUntil) + 1800
	elseif key == "massS" or key == "massL" then
		local n = key == "massS" and 30 or 120
		local amount = Config.biggestMass(p.tier, p.radius) * n * Calc.totalMult(player, p)
		p.mass += amount
		p.total += amount
	elseif key == "dm10" then
		p.dm += 10
	else
		return false
	end
	table.insert(p.receipts, receiptId)
	while #p.receipts > 50 do
		table.remove(p.receipts, 1)
	end
	st.dirty = true
	applyHole(player)
	pushState(player)
	return true
end

Store.init({
	isTester = function(player: Player): boolean
		local st = states[player]
		return st ~= nil and st.tester
	end,
	grantPass = grantPass,
	grantProduct = grantProduct,
	hasReceipt = function(player: Player, id: string): boolean
		local p = profiles[player]
		return p ~= nil and table.find(p.receipts, id) ~= nil
	end,
	toast = toast,
	save = function(player: Player)
		task.spawn(saveProfile, player)
	end,
})

------------------------------------------------------------------------
-- 요청 처리
------------------------------------------------------------------------
local function testAction(player: Player, p: Profile, action: string, arg: any)
	local st = states[player]
	if action == "testMass" then
		local amount = math.clamp(tonumber(arg) or 0, 0, 1e30)
		p.mass += amount
		p.total += amount
	elseif action == "testSize" then
		p.radius = math.clamp(tonumber(arg) or 0, Config.START_RADIUS, Calc.maxRadius(p))
	elseif action == "testMaxAll" then
		for _, u in ipairs(Config.Upgrades) do
			p.up[u.id] = u.maxLevel
		end
	elseif action == "testDM" then
		p.dm += 50
	elseif action == "testBigbang" then
		p.bigbang += 1
	elseif action == "testStar" then
		st.nextStar = 0
		st.starPos = nil
	elseif action == "testSkill" then
		st.cdUntil = 0
	elseif action == "testDaily" then
		p.dailyAt = 0
	elseif action == "testEvent" then
		if Event.active then
			Event.finish(true)
		end
		if not Event.start() then
			toast(player, "세계 안에 있어야 행성을 부를 수 있어요")
		end
	elseif action == "testAdvance" then
		if p.tier == 1 then
			p.radius = math.max(p.radius, Config.WORLD2_RADIUS)
		end
	elseif action == "testReset" then
		local fresh = defaultProfile()
		Quests.fill(fresh)
		profiles[player] = fresh
		st.passes = {}
	else
		return
	end
	applyHole(player)
	pushState(player)
end

Request.OnServerEvent:Connect(function(player: Player, action: any, arg: any, arg2: any)
	local p, st = profiles[player], states[player]
	if not p or not st or type(action) ~= "string" then
		return
	end
	local now = os.clock()
	if now - st.reqWindow > 1 then
		st.reqWindow = now
		st.reqCount = 0
	end
	st.reqCount += 1
	if st.reqCount > 30 then
		return
	end
	if action == "upgrade" then
		Actions.buyUpgrade(player, arg, arg2)
	elseif action == "auto" then
		p.auto = arg == true
		st.dirty = true
		toast(player, p.auto and "🤖 자동 업그레이드 켬" or "자동 업그레이드 끔")
		pushState(player)
	elseif action == "bigbang" then
		Actions.bigbang(player)
	elseif action == "teleport" then
		Actions.teleport(player, arg)
	elseif action == "world" then
		local w = math.floor(tonumber(arg) or -1)
		if w == 0 then
			Actions.goLobby(player)
		else
			Actions.goWorld(player, w)
		end
	elseif action == "skill" then
		Actions.skill(player, arg, arg2)
	elseif action == "advance" then
		Actions.advance(player)
	elseif action == "unstuck" then
		Actions.unstuck(player)
	elseif action == "bbshop" then
		Actions.bbShop(player, arg)
	elseif action == "skin" then
		Actions.skin(player, arg)
	elseif action == "hatch" then
		Sats.hatch(player, arg, arg2)
	elseif string.sub(action, 1, 3) == "sat" then
		Sats.action(player, action, arg)
	elseif action == "buyPass" then
		Store.buyPass(player, arg)
	elseif action == "buyProduct" then
		Store.buyProduct(player, arg)
	elseif action == "refresh" then
		-- 부스트 시간이 끝났을 때 화면이 배율을 다시 받아 간다
		pushState(player)
	elseif action == "hello" then
		pushState(player)
		if st.tester then
			toast(player, "🧪 테스트 계정이에요. 테스트 창에서 질량을 받을 수 있고, 기록은 저장하지 않아요")
		elseif not st.canSave then
			toast(player, "저장이 꺼져 있어요. 이번 기록은 저장되지 않아요")
		end
	elseif string.sub(action, 1, 4) == "test" and st.tester then
		testAction(player, p, action, arg)
	end
end)

------------------------------------------------------------------------
-- 로비 기계 (가까이 가서 E)
------------------------------------------------------------------------
for capId, pp in pairs(lobby.machines) do
	pp.Triggered:Connect(function(player: Player)
		Push:FireClient(player, "open", { page = "capsule", capsule = capId })
	end)
end
lobby.store.Triggered:Connect(function(player: Player)
	Push:FireClient(player, "open", { page = "store" })
end)
lobby.skins.Triggered:Connect(function(player: Player)
	Push:FireClient(player, "open", { page = "skins" })
end)
lobby.daily.Triggered:Connect(function(player: Player)
	Actions.daily(player)
end)

-- 순위판: 이 서버에서 모은 질량 순서
task.spawn(function()
	while true do
		local list = {}
		for player, p in pairs(profiles) do
			table.insert(list, { name = player.DisplayName, total = p.total, bigbang = p.bigbang })
		end
		table.sort(list, function(a, b)
			return a.total > b.total
		end)
		for k, row in ipairs(lobby.board) do
			local e = list[k]
			row.Text = e and string.format("%d. %s  💠%s  🌌%d", k, e.name, Config.formatNumber(e.total), e.bigbang) or ""
		end
		task.wait(10)
	end
end)

------------------------------------------------------------------------
-- 블랙홀 캐릭터: 보이지 않는 공 하나와 Humanoid뿐이다. 팔다리가 없어서 걷는 모션이 없고,
-- 죽지 않게 해 두었다. 혹시 사라지거나 죽으면 기다리지 않고 그 자리(또는 로비)에서 바로 다시 생긴다.
------------------------------------------------------------------------
local spawnHole: (Player, Vector3) -> ()
spawnHole = function(player: Player, pos: Vector3)
	if not player.Parent then
		return
	end
	local old = player.Character
	local model = Instance.new("Model")
	model.Name = player.Name
	local root = Instance.new("Part")
	root.Name = "HumanoidRootPart"
	root.Size = Vector3.new(2, 2, 2)
	root.Transparency = 1
	root.CastShadow = false
	root.TopSurface = Enum.SurfaceType.Smooth
	root.BottomSurface = Enum.SurfaceType.Smooth
	root.CFrame = CFrame.new(pos)
	root.Parent = model
	-- 이름표를 붙일 머리 (보이지 않음)
	local head = Instance.new("Part")
	head.Name = "Head"
	head.Size = Vector3.new(1, 1, 1)
	head.Transparency = 1
	head.CanCollide = false
	head.CanQuery = false
	head.Massless = true
	head.CastShadow = false
	head.CFrame = root.CFrame
	head.Parent = model
	local weld = Instance.new("WeldConstraint")
	weld.Part0 = root
	weld.Part1 = head
	weld.Parent = root
	local hum = Instance.new("Humanoid")
	hum.RigType = Enum.HumanoidRigType.R15
	hum.HipHeight = 1
	hum.RequiresNeck = false
	hum.BreakJointsOnDeath = false
	hum.MaxHealth = 1e9
	hum.Health = 1e9
	hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
	hum.HealthDisplayType = Enum.HumanoidHealthDisplayType.AlwaysOff
	hum.Parent = model
	model.PrimaryPart = root
	model.Parent = workspace
	player.Character = model
	pcall(function()
		root:SetNetworkOwner(player)
	end)
	if old and old ~= model then
		old:Destroy()
	end
	hum.Died:Connect(function()
		task.wait(0.1)
		if player.Character == model then
			local at = root.Position
			spawnHole(player, Vector3.new(at.X, 5, at.Z))
		end
	end)
	model.AncestryChanged:Connect(function()
		if not model.Parent and player.Character == model then
			task.defer(spawnHole, player, lobby.spawn)
		end
	end)
	applyHole(player)
end

local function onPlayerAdded(player: Player)
	-- 큰 물체가 카메라를 가리면 확 다가오지 않고 그 물체를 투명하게 한다
	player.DevCameraOcclusionMode = Enum.DevCameraOcclusionMode.Invisicam
	local st: State = {
		canSave = false,
		dirty = false,
		tester = false,
		reqWindow = 0,
		reqCount = 0,
		zone = 1,
		world = 1,
		inLobby = true,
		passes = {},
		starPos = nil,
		starExpire = 0,
		nextStar = os.clock() + 15,
		starUntil = 0,
		portalAt = 0,
		lockToastAt = 0,
		combo = 0,
		lastEat = 0,
		activeUntil = 0,
		activeOn = false,
		activeId = "",
		cdUntil = 0,
		shots = {},
		trail = {},
		sugarLevel = 0,
		advanceNotified = false,
	}
	states[player] = st
	local ls = Instance.new("Folder")
	ls.Name = "leaderstats"
	local massValue = Instance.new("StringValue")
	massValue.Name = "질량"
	massValue.Value = "0"
	massValue.Parent = ls
	local sizeValue = Instance.new("StringValue")
	sizeValue.Name = "크기"
	sizeValue.Value = Config.formatSize(Config.START_RADIUS)
	sizeValue.Parent = ls
	local bbValue = Instance.new("IntValue")
	bbValue.Name = "빅뱅"
	bbValue.Parent = ls
	ls.Parent = player

	local profile, ok
	if isTester(player) then
		profile, ok = defaultProfile(), false
		st.tester = true
	else
		profile, ok = loadProfile(player)
		st.passes = Store.ownedPasses(player)
	end
	if not player.Parent then
		return
	end
	Quests.fill(profile)
	profiles[player] = profile
	st.canSave = ok
	-- 들어오기 전에 산 우주 위성 패키지도 한 번은 챙겨 준다
	if Calc.hasPass(player, "petpack") and not profile.packGiven then
		grantPass(player, "petpack")
	end
	spawnHole(player, lobby.spawn)
	pushState(player)
	updateLeaderstats(player)
end

local function onPlayerRemoving(player: Player)
	saveProfile(player)
	profiles[player] = nil
	states[player] = nil
end

Players.PlayerAdded:Connect(onPlayerAdded)
Players.PlayerRemoving:Connect(onPlayerRemoving)
for _, player in ipairs(Players:GetPlayers()) do
	task.spawn(onPlayerAdded, player)
end

task.spawn(function()
	while true do
		task.wait(SAVE_INTERVAL)
		for player, st in pairs(states) do
			if st.dirty then
				task.spawn(saveProfile, player)
			end
		end
	end
end)

game:BindToClose(function()
	local pending = 0
	for player in pairs(profiles) do
		pending += 1
		task.spawn(function()
			saveProfile(player)
			pending -= 1
		end)
	end
	local waited = 0
	while pending > 0 and waited < 25 do
		task.wait(0.5)
		waited += 0.5
	end
end)
]]></string>
      </Properties>
      <Item class="ModuleScript" referent="8">
        <Properties>
          <string name="Name">Store</string>
          <string name="Source"><![CDATA[-- Store (ModuleScript, HoleServer 아래)
-- 로벅스 상점: 게임패스(한 번 사면 영원히)와 개발자 상품(살 때마다 효과).
-- Config.GamePasses / Config.Products의 id에 로블록스 웹사이트에서 만든 번호를 넣으면 진짜 결제가 된다.
-- 번호가 0이면 아직 만들지 않은 것: 테스트 계정은 누르면 산 것으로 처리하고, 일반 계정에는 "준비 중"을 띄운다.

local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage:WaitForChild("Config"))

local Store = {}

export type Hooks = {
	isTester: (Player) -> boolean,
	-- 게임패스를 가진 것으로 표시하고 효과를 켠다
	grantPass: (Player, string) -> (),
	-- 상품 효과를 준다. 그 사람의 기록을 아직 못 불러왔으면 false
	grantProduct: (Player, string, string) -> boolean,
	-- 이미 처리한 영수증인지
	hasReceipt: (Player, string) -> boolean,
	toast: (Player, string) -> (),
	save: (Player) -> (),
}

local hooks: Hooks? = nil
local passById: { [number]: any } = {}
local productById: { [number]: any } = {}

-- 들어올 때 가진 게임패스 확인
function Store.ownedPasses(player: Player): { [string]: boolean }
	local owned = {}
	for _, pass in ipairs(Config.GamePasses) do
		if pass.id > 0 then
			local ok, has = pcall(function()
				return MarketplaceService:UserOwnsGamePassAsync(player.UserId, pass.id)
			end)
			if ok and has then
				owned[pass.key] = true
			end
		end
	end
	return owned
end

function Store.buyPass(player: Player, key: any)
	local h = hooks
	local pass = type(key) == "string" and Config.PASS_BY_KEY[key]
	if not h or not pass then
		return
	end
	if pass.id > 0 then
		MarketplaceService:PromptGamePassPurchase(player, pass.id)
	elseif h.isTester(player) then
		h.grantPass(player, pass.key)
		h.toast(player, "🧪 테스트 구매: " .. pass.name .. " (번호가 없어서 무료로 처리했어요)")
	else
		h.toast(player, pass.name .. "은(는) 아직 준비 중이에요")
	end
end

function Store.buyProduct(player: Player, key: any)
	local h = hooks
	local product = type(key) == "string" and Config.PRODUCT_BY_KEY[key]
	if not h or not product then
		return
	end
	if product.id > 0 then
		MarketplaceService:PromptProductPurchase(player, product.id)
	elseif h.isTester(player) then
		h.grantProduct(player, product.key, "test_" .. os.clock())
		h.toast(player, "🧪 테스트 구매: " .. product.name)
	else
		h.toast(player, product.name .. "은(는) 아직 준비 중이에요")
	end
end

function Store.init(h: Hooks)
	hooks = h
	for _, pass in ipairs(Config.GamePasses) do
		if pass.id > 0 then
			passById[pass.id] = pass
		end
	end
	for _, product in ipairs(Config.Products) do
		if product.id > 0 then
			productById[product.id] = product
		end
	end

	MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(player: Player, passId: number, purchased: boolean)
		local pass = passById[passId]
		if purchased and pass then
			h.grantPass(player, pass.key)
			h.toast(player, "💎 " .. pass.name .. " 구매 완료! 고마워요")
			h.save(player)
		end
	end)

	-- 개발자 상품 영수증. 같은 영수증은 한 번만 처리한다
	MarketplaceService.ProcessReceipt = function(receipt: any)
		local product = productById[receipt.ProductId]
		local player = Players:GetPlayerByUserId(receipt.PlayerId)
		if not product then
			return Enum.ProductPurchaseDecision.NotProcessedYet
		end
		if not player then
			return Enum.ProductPurchaseDecision.NotProcessedYet
		end
		local id = tostring(receipt.PurchaseId)
		if h.hasReceipt(player, id) then
			return Enum.ProductPurchaseDecision.PurchaseGranted
		end
		local ok, granted = pcall(h.grantProduct, player, product.key, id)
		if not ok or not granted then
			return Enum.ProductPurchaseDecision.NotProcessedYet
		end
		h.toast(player, "💎 " .. product.name .. " 구매 완료! 고마워요")
		h.save(player)
		return Enum.ProductPurchaseDecision.PurchaseGranted
	end
end

return Store
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="9">
        <Properties>
          <string name="Name">World</string>
          <string name="Source"><![CDATA[-- World (ModuleScript, HoleServer 아래)
-- 조명, 로비, 세계 2개(구역 15개)의 바닥과 벽, 구역 사이 문, 로비로 가는 문, 물체 배치.
-- 세계와 로비는 x 위치로 3만 칸씩 떨어져 있어서 서로 보이지 않는다.
-- 구역은 각 세계의 시작 지점(z = 0)에서 +z 쪽으로 차례로 이어진다.
-- 로블록스 파트는 한 변이 2048을 넘지 못하므로, 넓은 바닥과 벽은 2000짜리 조각으로 나눠 깐다
-- (예전에 넓은 구역 가장자리에서 떨어지던 구멍이 이것 때문이었다).
-- 구역 문은 모두에게 막혀 있고, 크기가 충분한 사람의 화면에서만 통과된다 (캐릭터 물리는 각자 화면이 맡는다).

local Lighting = game:GetService("Lighting")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage:WaitForChild("Config"))
local Props = require(ReplicatedStorage:WaitForChild("Props"))

local World = {}

local LIMIT = Config.PART_LIMIT
local WALL = 40 -- 벽 두께

local function part(props: { [string]: any }): Part
	local p = Instance.new("Part")
	p.Anchored = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	for k, v in pairs(props) do
		if k ~= "Parent" then
			(p :: any)[k] = v
		end
	end
	-- 밟거나 부딪히지 않는 장식은 카메라도 무시하게 (카메라가 갑자기 확 다가오지 않게)
	if props.CanCollide == false and props.CanQuery == nil then
		p.CanQuery = false
	end
	p.Parent = props.Parent
	return p
end

-- 큰 직육면체를 2000짜리 조각으로 나눠 깐다 (Position + Size로 준 것만). 만든 조각을 모두 돌려준다
local function tiled(props: { [string]: any }): { Part }
	local size: Vector3 = props.Size
	local center: Vector3 = props.Position
	local nx = math.max(1, math.ceil(size.X / LIMIT))
	local ny = math.max(1, math.ceil(size.Y / LIMIT))
	local nz = math.max(1, math.ceil(size.Z / LIMIT))
	local piece = Vector3.new(size.X / nx, size.Y / ny, size.Z / nz)
	local list = {}
	for ix = 1, nx do
		for iy = 1, ny do
			for iz = 1, nz do
				local copy = table.clone(props)
				copy.Size = piece
				copy.Position = center + Vector3.new((ix - (nx + 1) / 2) * piece.X, (iy - (ny + 1) / 2) * piece.Y, (iz - (nz + 1) / 2) * piece.Z)
				table.insert(list, part(copy))
			end
		end
	end
	return list
end

local function signText(target: BasePart, face: Enum.NormalId, lines: { { any } })
	local gui = Instance.new("SurfaceGui")
	gui.Face = face
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 8
	gui.LightInfluence = 0
	gui.Parent = target
	local y = 0
	for _, line in ipairs(lines) do
		local l = Instance.new("TextLabel")
		l.BackgroundTransparency = 1
		l.Position = UDim2.fromScale(0, y)
		l.Size = UDim2.fromScale(1, line[3])
		l.Font = Enum.Font.GothamBlack
		l.TextScaled = true
		l.TextColor3 = line[2]
		l.TextStrokeTransparency = 0.3
		l.Text = line[1]
		l.Parent = gui
		y += line[3]
	end
end

local function prompt(target: BasePart, action: string, object: string, name: string): ProximityPrompt
	local pp = Instance.new("ProximityPrompt")
	pp.Name = name
	pp.ActionText = action
	pp.ObjectText = object
	pp.HoldDuration = 0
	pp.MaxActivationDistance = 22
	pp.RequiresLineOfSight = false
	pp.KeyboardKeyCode = Enum.KeyCode.E
	pp.Parent = target
	return pp
end

function World.setupLighting()
	Lighting.ClockTime = 15.5
	Lighting.Brightness = 2.2
	Lighting.Ambient = Color3.fromRGB(110, 110, 130)
	Lighting.OutdoorAmbient = Color3.fromRGB(140, 140, 160)
	Lighting.EnvironmentDiffuseScale = 0.6
	Lighting.EnvironmentSpecularScale = 0.6
	local bloom = Lighting:FindFirstChildOfClass("BloomEffect") or Instance.new("BloomEffect")
	bloom.Intensity = 0.5
	bloom.Size = 30
	bloom.Threshold = 1.2
	bloom.Parent = Lighting
	local cc = Lighting:FindFirstChildOfClass("ColorCorrectionEffect") or Instance.new("ColorCorrectionEffect")
	cc.Saturation = 0.15
	cc.Contrast = 0.08
	cc.Parent = Lighting
	local atmo = Lighting:FindFirstChildOfClass("Atmosphere") or Instance.new("Atmosphere")
	atmo.Density = 0.3
	atmo.Haze = 1.5
	atmo.Color = Color3.fromRGB(200, 210, 240)
	atmo.Decay = Color3.fromRGB(120, 110, 160)
	atmo.Parent = Lighting
end

-- 별가루 파티클 (우주 구역 하늘)
local function starDust(folder: Folder, center: Vector3, zone: any, color: Color3)
	local sky = part({ Name = "Stars", Size = Vector3.new(math.min(zone.width, LIMIT), 10, math.min(zone.length, LIMIT)), Position = center + Vector3.new(0, 300, 0), Transparency = 1, CanCollide = false, CanQuery = false, Parent = folder })
	local pe = Instance.new("ParticleEmitter")
	pe.Rate = 60
	pe.Lifetime = NumberRange.new(4, 8)
	pe.Speed = NumberRange.new(0, 1)
	pe.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(0.5, 3), NumberSequenceKeypoint.new(1, 0) })
	pe.LightEmission = 1
	pe.Color = ColorSequence.new(color, Color3.fromRGB(255, 255, 255))
	pe.Parent = sky
end

-- 구역별 바닥 꾸밈 (모두 밟히지 않는 장식)
local function decorate(folder: Folder, zone: any, center: Vector3, z0: number, wx: number)
	local name = zone.name
	if name == "도시" or name == "대도시" or name == "과자 마을" or name == "케이크 도시" then
		local candy = zone.world == 2
		local roadCol = candy and Color3.fromRGB(110, 60, 40) or Color3.fromRGB(45, 45, 50)
		local lineCol = candy and Color3.fromRGB(255, 240, 250) or Color3.fromRGB(240, 230, 120)
		tiled({ Name = "Road", Size = Vector3.new(zone.width * 0.18, 0.15, zone.length), Position = center + Vector3.new(0, 0.08, 0), Color = roadCol, Material = candy and Enum.Material.SmoothPlastic or Enum.Material.Asphalt, CanCollide = false, Parent = folder })
		for k = 0, 9 do
			part({ Name = "Line", Size = Vector3.new(2, 0.16, zone.length / 20), Position = Vector3.new(wx, 0.1, z0 + zone.length * (k + 0.5) / 10), Color = lineCol, Material = Enum.Material.Neon, CanCollide = false, Parent = folder })
		end
	elseif name == "바다와 산" or name == "초콜릿 강" then
		local col = name == "초콜릿 강" and Color3.fromRGB(90, 45, 25) or Color3.fromRGB(50, 120, 200)
		for k = 0, 7 do
			local a = k * 1.3
			local d = math.min(LIMIT, zone.width * 0.16)
			part({
				Name = "Water",
				Shape = Enum.PartType.Cylinder,
				Size = Vector3.new(0.3, d, d),
				CFrame = CFrame.new(center + Vector3.new(math.cos(a) * zone.width * 0.3, 0.12, math.sin(a) * zone.length * 0.3)) * CFrame.Angles(0, 0, math.rad(90)),
				Color = col,
				Material = Enum.Material.Glass,
				Transparency = 0.15,
				CanCollide = false,
				Parent = folder,
			})
		end
	elseif name == "젤리 들판" then
		for k = 0, 9 do
			local a = k * 0.8
			part({
				Name = "JellyPool",
				Shape = Enum.PartType.Cylinder,
				Size = Vector3.new(0.3, 30 + k * 4, 30 + k * 4),
				CFrame = CFrame.new(center + Vector3.new(math.cos(a) * zone.width * 0.33, 0.12, math.sin(a) * zone.length * 0.33)) * CFrame.Angles(0, 0, math.rad(90)),
				Color = Color3.fromHSV(k / 10, 0.45, 1),
				Material = Enum.Material.Glass,
				Transparency = 0.2,
				CanCollide = false,
				Parent = folder,
			})
		end
	elseif name == "아이스크림 산맥" then
		for k = -4, 4 do
			tiled({ Name = "Syrup", Size = Vector3.new(zone.width / 20, 0.14, zone.length), Position = center + Vector3.new(k * zone.width / 9, 0.07, 0), Color = Color3.fromHSV((k + 4) / 9, 0.35, 1), Material = Enum.Material.SmoothPlastic, CanCollide = false, Parent = folder })
		end
	elseif name == "우주" or name == "사탕 우주" or name == "은하수" or name == "디저트 은하" or name == "설탕 블랙홀" then
		local col = zone.world == 2 and Color3.fromRGB(255, 120, 220) or Color3.fromRGB(110, 80, 255)
		if name == "은하수" or name == "설탕 블랙홀" then
			col = Color3.fromRGB(80, 200, 255)
		end
		for k = -6, 6 do
			tiled({ Name = "Grid", Size = Vector3.new(3, 0.12, zone.length), Position = center + Vector3.new(k * zone.width / 13, 0.06, 0), Color = col, Material = Enum.Material.Neon, Transparency = 0.5, CanCollide = false, Parent = folder })
		end
		starDust(folder, center, zone, zone.world == 2 and Color3.fromRGB(255, 200, 240) or Color3.fromRGB(200, 210, 255))
	end
end

-- 포털 (소용돌이 고리). to = 0이면 로비, 1·2면 세계
export type Portal = { pos: Vector3, to: number }

local function buildPortal(folder: Folder, ppos: Vector3, to: number, facing: number)
	local ringCol = to == 0 and Color3.fromRGB(120, 255, 200) or (to == 2 and Color3.fromRGB(255, 120, 210) or Color3.fromRGB(140, 110, 255))
	local rot = CFrame.Angles(0, facing, 0)
	part({ Name = "PortalBase", Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.6, 24, 24), CFrame = CFrame.new(ppos + Vector3.new(0, 0.3, 0)) * CFrame.Angles(0, 0, math.rad(90)), Color = ringCol, Material = Enum.Material.Neon, Transparency = 0.35, CanCollide = false, Parent = folder })
	for k = 0, 15 do
		local a = k * math.pi / 8
		part({
			Name = "PortalRing",
			Size = Vector3.new(2.2, 2.2, 3.2),
			CFrame = CFrame.new(ppos) * rot * CFrame.new(math.cos(a) * 10, 11 + math.sin(a) * 10, 0) * CFrame.Angles(0, 0, a),
			Color = k % 2 == 0 and ringCol or Color3.fromRGB(255, 255, 255),
			Material = Enum.Material.Neon,
			CanCollide = false,
			Parent = folder,
		})
	end
	local swirl = part({ Name = "PortalSwirl", Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.4, 18, 18), CFrame = CFrame.new(ppos + Vector3.new(0, 11, 0)) * rot * CFrame.Angles(0, math.rad(90), 0), Color = ringCol, Material = Enum.Material.ForceField, Transparency = 0.1, CanCollide = false, Parent = folder })
	swirl:SetAttribute("Spin", true)
	local sign = part({ Name = "PortalSign", Size = Vector3.new(30, 9, 1), CFrame = CFrame.new(ppos + Vector3.new(0, 26, 0)) * rot, Color = Color3.fromRGB(25, 15, 40), Material = Enum.Material.Slate, CanCollide = false, Parent = folder })
	local title, lock
	if to == 0 then
		title, lock = "🏠 로비", "캡슐 뽑기 · 상점 · 매일 보상"
	else
		local target = Config.Worlds[to]
		title = string.format("🌀 세계 %d · %s", to, target.name)
		lock = to == 1 and "한 판의 시작" or string.format("세계 1에서 크기 %d 넘기면", Config.WORLD2_RADIUS)
	end
	for _, face in ipairs({ Enum.NormalId.Front, Enum.NormalId.Back }) do
		signText(sign, face, {
			{ title, Color3.fromRGB(255, 230, 255), 0.55 },
			{ lock, Color3.fromRGB(255, 220, 120), 0.45 },
		})
	end
end

World.PORTAL_OFFSET = Vector3.new(-70, 0, 34)

-- 구역 바닥, 옆 벽, 구역 사이 문, 로비로 가는 문
function World.buildZones(): ({ BasePart }, { Portal })
	local folder = Instance.new("Folder")
	folder.Name = "Zones"
	folder.Parent = workspace
	local old = workspace:FindFirstChild("Baseplate")
	if old then
		old:Destroy()
	end
	local gates: { BasePart } = {}
	local portals: { Portal } = {}
	for i, zone in ipairs(Config.Zones) do
		local wx = Config.Worlds[zone.world].x
		local z0 = Config.zoneStart(i)
		local center = Vector3.new(wx, 0, z0 + zone.length / 2)
		tiled({
			Name = "Ground" .. i,
			Size = Vector3.new(zone.width, 4, zone.length),
			Position = center - Vector3.new(0, 2, 0),
			Color = zone.ground,
			Material = zone.material,
			Parent = folder,
		})
		for _, x in ipairs({ -1, 1 }) do
			tiled({
				Name = "Edge",
				Size = Vector3.new(8, 0.2, zone.length),
				Position = center + Vector3.new(x * (zone.width / 2 - 4), 0.1, 0),
				Color = zone.ground:Lerp(Color3.new(1, 1, 1), 0.35),
				Material = Enum.Material.Concrete,
				CanCollide = false,
				Parent = folder,
			})
			-- 보이지 않는 옆 벽 (아주 빨라도 뚫고 나가지 않게 두껍게)
			tiled({
				Name = "SideWall",
				Size = Vector3.new(WALL, 1200, zone.length),
				Position = center + Vector3.new(x * (zone.width / 2 + WALL / 2), 600, 0),
				Transparency = 1,
				Parent = folder,
			})
		end
		decorate(folder, zone, center, z0, wx)

		-- 다음 구역으로 가는 문 (그 세계 마지막 구역은 끝 벽)
		local nextZone = Config.Zones[i + 1]
		local zEnd = z0 + zone.length
		if nextZone and nextZone.world == zone.world then
			local narrow = math.min(zone.width, nextZone.width)
			local wide = math.max(zone.width, nextZone.width)
			-- 넓은 쪽 구역의 남는 가장자리는 늘 막혀 있다 (여기로 나가면 바닥 없는 곳으로 떨어졌다)
			for _, x in ipairs({ -1, 1 }) do
				local w = (wide - narrow) / 2 + WALL
				tiled({ Name = "CapWall", Size = Vector3.new(w, 1200, WALL), Position = Vector3.new(wx + x * (narrow / 2 + w / 2), 600, zEnd), Transparency = 1, Parent = folder })
			end
			local height = math.min(1800, 60 + nextZone.need * 2.5)
			for _, g in ipairs(tiled({
				Name = "Gate",
				Size = Vector3.new(narrow, height, 12),
				Position = Vector3.new(wx, height / 2, zEnd),
				Color = zone.world == 2 and Color3.fromRGB(255, 110, 200) or Color3.fromRGB(150, 90, 255),
				Material = Enum.Material.ForceField,
				Transparency = 0.2,
				Parent = folder,
			})) do
				g:SetAttribute("Need", nextZone.need)
				g:SetAttribute("Zone", i + 1)
				table.insert(gates, g)
			end
			local signW = math.clamp(nextZone.need * 0.8, 60, 400)
			local board = part({
				Name = "GateSign",
				Size = Vector3.new(signW, signW * 0.36, 1),
				Position = Vector3.new(wx, 8 + signW * 0.25, zEnd - 3),
				Color = Color3.fromRGB(30, 20, 50),
				Material = Enum.Material.Slate,
				CanCollide = false,
				Parent = folder,
			})
			local num = table.find(Config.zonesOf(zone.world), i + 1) or 0
			signText(board, Enum.NormalId.Back, {
				{ string.format("%d구역 · %s", num, nextZone.name), Color3.fromRGB(230, 210, 255), 0.45 },
				{ string.format("크기 %d 이상이면 통과", nextZone.need), Color3.fromRGB(255, 220, 120), 0.45 },
			})
		else
			tiled({ Name = "EndWall", Size = Vector3.new(zone.width + WALL * 2, 1200, WALL), Position = Vector3.new(wx, 600, zEnd + WALL / 2), Transparency = 1, Parent = folder })
		end
	end

	for wi, world in ipairs(Config.Worlds) do
		local wx = world.x
		local first = Config.zonesOf(wi)[1]
		tiled({ Name = "StartWall", Size = Vector3.new(Config.Zones[first].width + WALL * 2, 1200, WALL), Position = Vector3.new(wx, 600, -WALL / 2), Transparency = 1, Parent = folder })
		part({ Name = "WorldSpawn" .. wi, Size = Vector3.new(16, 1, 16), Position = Vector3.new(wx, 0.5, 22), Color = wi == 2 and Color3.fromRGB(255, 120, 200) or Color3.fromRGB(120, 70, 220), Material = Enum.Material.Neon, Transparency = 0.3, CanCollide = false, Parent = folder })
		local title = part({ Name = "TitleSign", Size = Vector3.new(50, 14, 1), Position = Vector3.new(wx, 14, 6), Color = Color3.fromRGB(20, 12, 40), Material = Enum.Material.Slate, CanCollide = false, Parent = folder })
		signText(title, Enum.NormalId.Back, {
			{ wi == 1 and ("🌍 세계 1 · " .. world.name) or ("🍭 세계 2 · " .. world.name), wi == 1 and Color3.fromRGB(210, 170, 255) or Color3.fromRGB(255, 170, 220), 0.6 },
			{ wi == 1 and "작은 것부터 삼키고 커져라!" or "훨씬 넓고, 모든 게 달콤하고, 질량은 5배!", Color3.fromRGB(255, 255, 255), 0.4 },
		})
		local ppos = Vector3.new(wx, 0, 0) + World.PORTAL_OFFSET
		buildPortal(folder, ppos, 0, 0)
		table.insert(portals, { pos = ppos, to = 0 })
	end
	return gates, portals
end

------------------------------------------------------------------------
-- 로비: 둥근 광장. 가운데 큰 블랙홀 조각, 북쪽에 캡슐 기계 셋, 남쪽에 스킨 전시관,
-- 서쪽·동쪽에 세계 1·2로 가는 문, 상점 가판대, 매일 보상 상자, 순위판
------------------------------------------------------------------------
export type Lobby = {
	spawn: Vector3,
	portals: { Portal },
	machines: { [string]: ProximityPrompt },
	store: ProximityPrompt,
	skins: ProximityPrompt,
	daily: ProximityPrompt,
	board: { TextLabel },
}

function World.buildLobby(): Lobby
	local folder = Instance.new("Folder")
	folder.Name = "Lobby"
	folder.Parent = workspace
	local L = Vector3.new(Config.LOBBY.x, 0, Config.LOBBY.z)
	local R = Config.LOBBY.radius
	local function at(x: number, y: number, z: number): Vector3
		return L + Vector3.new(x, y, z)
	end
	-- 바닥과 무늬
	part({ Name = "LobbyFloor", Shape = Enum.PartType.Cylinder, Size = Vector3.new(6, R * 2 + 20, R * 2 + 20), CFrame = CFrame.new(at(0, -3, 0)) * CFrame.Angles(0, 0, math.rad(90)), Color = Color3.fromRGB(36, 28, 60), Material = Enum.Material.Marble, Parent = folder })
	for k, rr in ipairs({ 60, 120, R }) do
		part({ Name = "FloorRing", Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.3, rr * 2 + 4, rr * 2 + 4), CFrame = CFrame.new(at(0, 0.05 + k * 0.01, 0)) * CFrame.Angles(0, 0, math.rad(90)), Color = Color3.fromHSV(0.75 + k * 0.05, 0.6, 1), Material = Enum.Material.Neon, Transparency = 0.6, CanCollide = false, Parent = folder })
		part({ Name = "FloorInner", Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.32, rr * 2 - 2, rr * 2 - 2), CFrame = CFrame.new(at(0, 0.06 + k * 0.01, 0)) * CFrame.Angles(0, 0, math.rad(90)), Color = Color3.fromRGB(36, 28, 60), Material = Enum.Material.Marble, CanCollide = false, Parent = folder })
	end
	-- 둘레 벽 (보이지 않음) + 빛나는 기둥
	for k = 0, 35 do
		local a = k / 36 * math.pi * 2
		local pos = at(math.cos(a) * (R + 26), 100, math.sin(a) * (R + 26))
		-- X = 둘레 방향 폭 70, Z = 가운데를 향한 두께 40 (조각끼리 겹쳐서 틈이 없다)
		part({ Name = "LobbyWall", Size = Vector3.new(70, 200, 40), CFrame = CFrame.fromMatrix(pos, Vector3.new(-math.sin(a), 0, math.cos(a)), Vector3.new(0, 1, 0)), Transparency = 1, Parent = folder })
		if k % 3 == 0 then
			part({ Name = "Pillar", Shape = Enum.PartType.Cylinder, Size = Vector3.new(26, 3, 3), CFrame = CFrame.new(at(math.cos(a) * (R + 4), 13, math.sin(a) * (R + 4))) * CFrame.Angles(0, 0, math.rad(90)), Color = Color3.fromHSV(k / 36, 0.5, 1), Material = Enum.Material.Neon, CanCollide = false, Parent = folder })
		end
	end
	-- 가운데 블랙홀 조각 받침 (모양은 화면이 그린다)
	local core = part({ Name = "SkinPedestal", Shape = Enum.PartType.Cylinder, Size = Vector3.new(2, 36, 36), CFrame = CFrame.new(at(0, 1, 0)) * CFrame.Angles(0, 0, math.rad(90)), Color = Color3.fromRGB(60, 45, 100), Material = Enum.Material.Marble, CanCollide = false, Parent = folder })
	core:SetAttribute("SkinIndex", 6)
	core:SetAttribute("HoleR", 14)
	local title = part({ Name = "LobbyTitle", Size = Vector3.new(70, 16, 1), Position = at(0, 40, 0), Color = Color3.fromRGB(20, 12, 40), Material = Enum.Material.Slate, CanCollide = false, Parent = folder })
	for _, face in ipairs({ Enum.NormalId.Front, Enum.NormalId.Back }) do
		signText(title, face, {
			{ "🕳 " .. Config.GAME_TITLE .. " 로비", Color3.fromRGB(210, 170, 255), 0.6 },
			{ "← 세계 1   ·   캡슐은 북쪽   ·   세계 2 →", Color3.fromRGB(255, 255, 255), 0.4 },
		})
	end

	-- 캡슐 기계 셋 (북쪽)
	local machines = {}
	for k, cap in ipairs(Config.Capsules) do
		local x = (k - 2) * 70
		local z = 150 - math.abs(k - 2) * 20
		local base = part({ Name = "CapsuleMachine", Size = Vector3.new(16, 8, 16), Position = at(x, 4, z), Color = Color3.fromRGB(60, 50, 90), Material = Enum.Material.Metal, CanCollide = false, Parent = folder })
		part({ Name = "MachineGlass", Shape = Enum.PartType.Ball, Size = Vector3.new(16, 16, 16), Position = at(x, 15, z), Color = cap.color, Material = Enum.Material.Glass, Transparency = 0.5, CanCollide = false, Parent = folder })
		for j = 0, 5 do
			local a = j * 1.05
			part({ Name = "Capsule", Shape = Enum.PartType.Ball, Size = Vector3.new(3.2, 3.2, 3.2), Position = at(x + math.cos(a) * 3.5, 11 + (j % 2) * 3, z + math.sin(a) * 3.5), Color = Color3.fromHSV((j / 6 + k * 0.3) % 1, 0.6, 1), Material = Enum.Material.SmoothPlastic, CanCollide = false, Parent = folder })
		end
		part({ Name = "MachineTop", Shape = Enum.PartType.Cylinder, Size = Vector3.new(2, 10, 10), CFrame = CFrame.new(at(x, 23.5, z)) * CFrame.Angles(0, 0, math.rad(90)), Color = cap.color, Material = Enum.Material.Neon, CanCollide = false, Parent = folder })
		local sign = part({ Name = "MachineSign", Size = Vector3.new(24, 7, 1), CFrame = CFrame.lookAt(at(x, 31, z), at(0, 31, 0)), Color = Color3.fromRGB(20, 12, 40), Material = Enum.Material.Slate, CanCollide = false, Parent = folder })
		signText(sign, Enum.NormalId.Front, {
			{ "🥚 " .. cap.name, Color3.fromRGB(255, 255, 255), 0.55 },
			{ "💠 " .. Config.formatNumber(cap.cost) .. (cap.world == 2 and " · 세계 2" or ""), Color3.fromRGB(255, 220, 120), 0.45 },
		})
		machines[cap.id] = prompt(base, "캡슐 깨기", cap.name, "Capsule")
	end

	-- 스킨 전시관 (남쪽 둥근 줄)
	for k = 1, #Config.Skins do
		local a = math.rad(215 + (k - 1) * 10)
		local pos = at(math.cos(a) * 200, 1.5, math.sin(a) * 200)
		local ped = part({ Name = "SkinPedestal", Shape = Enum.PartType.Cylinder, Size = Vector3.new(2, 13, 13), CFrame = CFrame.new(pos) * CFrame.Angles(0, 0, math.rad(90)), Color = Color3.fromRGB(70, 55, 110), Material = Enum.Material.Marble, CanCollide = false, Parent = folder })
		ped:SetAttribute("SkinIndex", k)
		ped:SetAttribute("HoleR", 4)
		part({ Name = "PedestalRim", Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.3, 13.6, 13.6), CFrame = CFrame.new(pos + Vector3.new(0, 1.05, 0)) * CFrame.Angles(0, 0, math.rad(90)), Color = Config.Skins[k].a, Material = Enum.Material.Neon, CanCollide = false, Parent = folder })
	end
	local skinSign = part({ Name = "SkinHallSign", Size = Vector3.new(40, 10, 1), CFrame = CFrame.lookAt(at(0, 22, -175), at(0, 22, 0)), Color = Color3.fromRGB(25, 15, 40), Material = Enum.Material.Slate, CanCollide = false, Parent = folder })
	signText(skinSign, Enum.NormalId.Front, {
		{ "🎨 스킨 전시관", Color3.fromRGB(255, 200, 255), 0.6 },
		{ "스킨마다 고유 능력이 있어요", Color3.fromRGB(255, 255, 255), 0.4 },
	})
	local skinStand = part({ Name = "SkinStand", Size = Vector3.new(8, 4, 8), Position = at(0, 2, -175), Color = Color3.fromRGB(200, 90, 200), Material = Enum.Material.Neon, Transparency = 0.3, CanCollide = false, Parent = folder })

	-- 상점 가판대 (남서), 매일 보상 상자 (남동)
	local kiosk = part({ Name = "StoreKiosk", Size = Vector3.new(14, 10, 8), Position = at(-110, 5, -60), Color = Color3.fromRGB(230, 160, 40), Material = Enum.Material.SmoothPlastic, CanCollide = false, Parent = folder })
	part({ Name = "KioskRoof", Size = Vector3.new(18, 1, 12), Position = at(-110, 14, -60), Color = Color3.fromRGB(255, 220, 120), Material = Enum.Material.Neon, CanCollide = false, Parent = folder })
	local kioskSign = part({ Name = "KioskSign", Size = Vector3.new(18, 5, 1), CFrame = CFrame.lookAt(at(-110, 19, -60), at(0, 19, 0)), Color = Color3.fromRGB(20, 12, 40), Material = Enum.Material.Slate, CanCollide = false, Parent = folder })
	signText(kioskSign, Enum.NormalId.Front, { { "💎 상점", Color3.fromRGB(255, 220, 120), 1 } })
	local chest = part({ Name = "DailyChest", Size = Vector3.new(10, 7, 7), Position = at(110, 3.5, -60), Color = Color3.fromRGB(150, 90, 40), Material = Enum.Material.WoodPlanks, CanCollide = false, Parent = folder })
	part({ Name = "ChestLid", Size = Vector3.new(10.4, 2, 7.4), Position = at(110, 8, -60), Color = Color3.fromRGB(255, 200, 60), Material = Enum.Material.Foil, CanCollide = false, Parent = folder })
	part({ Name = "ChestGlow", Shape = Enum.PartType.Ball, Size = Vector3.new(4, 4, 4), Position = at(110, 11, -60), Color = Color3.fromRGB(255, 230, 120), Material = Enum.Material.Neon, Transparency = 0.3, CanCollide = false, Parent = folder })
	local chestSign = part({ Name = "ChestSign", Size = Vector3.new(18, 5, 1), CFrame = CFrame.lookAt(at(110, 17, -60), at(0, 17, 0)), Color = Color3.fromRGB(20, 12, 40), Material = Enum.Material.Slate, CanCollide = false, Parent = folder })
	signText(chestSign, Enum.NormalId.Front, { { "🎁 매일 보상", Color3.fromRGB(255, 220, 120), 1 } })

	-- 순위판 (북쪽 끝)
	local boardPart = part({ Name = "Leaderboard", Size = Vector3.new(60, 44, 2), CFrame = CFrame.lookAt(at(0, 40, 215), at(0, 40, 0)), Color = Color3.fromRGB(15, 10, 30), Material = Enum.Material.Slate, CanCollide = false, Parent = folder })
	local gui = Instance.new("SurfaceGui")
	gui.Face = Enum.NormalId.Front
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 10
	gui.LightInfluence = 0
	gui.Parent = boardPart
	local head = Instance.new("TextLabel")
	head.BackgroundTransparency = 1
	head.Size = UDim2.fromScale(1, 0.14)
	head.Font = Enum.Font.GothamBlack
	head.TextScaled = true
	head.TextColor3 = Color3.fromRGB(255, 220, 120)
	head.Text = "🏆 이 서버 순위 (모은 질량)"
	head.Parent = gui
	local rows = {}
	for k = 1, 10 do
		local l = Instance.new("TextLabel")
		l.BackgroundTransparency = 1
		l.Position = UDim2.fromScale(0.04, 0.14 + (k - 1) * 0.085)
		l.Size = UDim2.fromScale(0.92, 0.08)
		l.Font = Enum.Font.GothamBold
		l.TextScaled = true
		l.TextXAlignment = Enum.TextXAlignment.Left
		l.TextColor3 = k <= 3 and Color3.fromRGB(255, 230, 150) or Color3.fromRGB(230, 225, 255)
		l.Text = ""
		l.Parent = gui
		rows[k] = l
	end

	-- 세계로 가는 문 (서쪽 1, 동쪽 2)
	local portals = {}
	for _, info in ipairs({ { -1, 1 }, { 1, 2 } }) do
		local ppos = at(info[1] * 195, 0, 0)
		buildPortal(folder, ppos, info[2], math.rad(90))
		table.insert(portals, { pos = ppos, to = info[2] })
	end

	return {
		spawn = at(0, 5, -130),
		portals = portals,
		machines = machines,
		store = prompt(kiosk, "상점 열기", "💎 상점", "Store"),
		skins = prompt(skinStand, "스킨 보기", "🎨 스킨", "Skins"),
		daily = prompt(chest, "보상 받기", "🎁 매일 보상", "Daily"),
		board = rows,
	}
end

export type ObjectRec = {
	model: Model,
	def: any,
	zone: number,
	pos: Vector3,
	alive: boolean,
	golden: boolean,
	collide: { [BasePart]: boolean },
}

-- 물체 배치. 같은 서버에서는 늘 같은 자리
function World.placeObjects(): ({ ObjectRec }, Folder)
	local folder = Instance.new("Folder")
	folder.Name = "Objects"
	folder.Parent = workspace
	local rng = Random.new(20261015)
	local list: { ObjectRec } = {}
	for zi, zone in ipairs(Config.Zones) do
		local z0 = Config.zoneStart(zi)
		local wx = Config.Worlds[zone.world].x
		local first = Config.zonesOf(zone.world)[1] == zi
		local placed: { { pos: Vector3, r: number } } = {}
		-- 큰 것부터 자리를 잡아야 빈자리가 남는다
		local defs = {}
		for _, def in ipairs(Config.Objects) do
			if def.zone == zi then
				table.insert(defs, def)
			end
		end
		table.sort(defs, function(a, b)
			return a.size > b.size
		end)
		for _, def in ipairs(defs) do
			local count = math.max(1, math.floor(def.count * (zone.countMult or 1) + 0.5))
			for n = 1, count do
				local margin = math.min(def.size * 1.3 + 6, zone.width * 0.3)
				local pos: Vector3? = nil
				for _ = 1, 40 do
					local x = rng:NextNumber(-zone.width / 2 + margin, zone.width / 2 - margin)
					local z = rng:NextNumber(z0 + margin, z0 + zone.length - margin)
					local p = Vector3.new(wx + x, 0, z)
					local ok = true
					-- 시작 지점과 로비 문 근처는 비워 둔다
					if first then
						if (p - Vector3.new(wx, 0, 22)).Magnitude < 22 + def.size then
							ok = false
						elseif (p - (Vector3.new(wx, 0, 0) + World.PORTAL_OFFSET)).Magnitude < 18 + def.size then
							ok = false
						end
					end
					if ok then
						for _, other in ipairs(placed) do
							if (other.pos - p).Magnitude < (other.r + def.size) * 1.05 then
								ok = false
								break
							end
						end
					end
					if ok then
						pos = p
						break
					end
				end
				if pos then
					local base = CFrame.new(pos) * CFrame.Angles(0, rng:NextNumber(0, math.pi * 2), 0)
					local model = Props.build(def.model or def.id, def.size, base, zi * 100000 + n * 131 + #list)
					model.Name = def.id
					model:SetAttribute("Size", def.size)
					model:SetAttribute("Mass", def.mass)
					model:SetAttribute("Label", def.name)
					-- 물체는 모두 부딪히지 않는다. 블랙홀은 땅에 난 구멍이라 물체 밑을 지나간다
					-- (예전엔 큰 물체에 걸리거나, 다시 생긴 물체가 내 자리에 나타나 몸이 끼었다)
					local collide = {}
					for _, d in ipairs(model:GetDescendants()) do
						if d:IsA("BasePart") then
							d.CanCollide = false
							d.CanTouch = false
							d.CanQuery = false
							collide[d] = false
						end
					end
					model.Parent = folder
					table.insert(placed, { pos = pos, r = def.size })
					table.insert(list, { model = model, def = def, zone = zi, pos = pos, alive = true, golden = false, collide = collide })
				end
			end
		end
	end
	return list, folder
end

return World
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="StarterPlayer" referent="10">
    <Properties>
      <string name="Name">StarterPlayer</string>
    </Properties>
    <Item class="StarterPlayerScripts" referent="11">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="LocalScript" referent="12">
        <Properties>
          <string name="Name">HoleClient</string>
          <string name="Source"><![CDATA[-- HoleClient (LocalScript, StarterPlayer > StarterPlayerScripts)
-- 화면 UI, 카메라, 문 통과, "너무 커요" 표시. 계산은 서버가 하고 여기서는 보여 주고 요청만 보낸다.
-- 창: 💎 상점, 🥚 캡슐, 🛰 위성, 🎨 스킨, 🌌 빅뱅, 🌑 빅뱅 상점, 🗺 세계, 📜 도움말, 🧪 테스트


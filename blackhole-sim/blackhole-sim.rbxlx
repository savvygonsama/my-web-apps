------------------------------------------------------------------------
-- 캡슐 깨기 연출: 흔들리다 번쩍, 위성이 나타난다
------------------------------------------------------------------------
local playHatch
do
	local overlay = new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(0, 0, 0), BackgroundTransparency = 0.35, Visible = false, ZIndex = 50, Active = true, Parent = gui })
	local holder = new("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.new(0, 720, 0, 360), BackgroundTransparency = 1, Parent = overlay })
	scaled(holder)
	local busy = false
	function playHatch(capId: string, results: { string })
		local cap = Config.CAPSULE_BY_ID[capId]
		if not cap or busy then
			return
		end
		busy = true
		clear(holder)
		overlay.Visible = true
		-- 1) 흔들리는 캡슐
		local egg = new("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.new(0, 170, 0, 210), BackgroundColor3 = Color3.new(1, 1, 1), Parent = holder }, {
			corner(85),
			new("UIGradient", { Color = ColorSequence.new(cap.color:Lerp(Color3.new(1, 1, 1), 0.5), cap.color), Rotation = 90 }),
			new("UIStroke", { Color = Color3.new(1, 1, 1), Thickness = 4 }),
		})
		text({ Size = UDim2.fromScale(1, 1), TextSize = 60, TextXAlignment = Enum.TextXAlignment.Center, Text = "?", Font = Enum.Font.GothamBlack, Parent = egg })
		Fx.sound("whoosh", 0.4, 1.4)
		for i = 1, 8 do
			egg.Rotation = (i % 2 == 0 and 1 or -1) * (6 + i * 2)
			task.wait(0.09)
		end
		egg.Rotation = 0
		-- 2) 번쩍
		local flash = new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(1, 1, 1), ZIndex = 60, Parent = overlay })
		TweenService:Create(flash, TweenInfo.new(0.5), { BackgroundTransparency = 1 }):Play()
		egg:Destroy()
		Fx.sound("slash", 0.6, 1.2)
		-- 3) 결과
		local row = new("Frame", { Size = UDim2.new(1, 0, 0, 300), BackgroundTransparency = 1, Parent = holder }, {
			new("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, HorizontalAlignment = Enum.HorizontalAlignment.Center, Padding = UDim.new(0, 14) }),
		})
		local bestRarity = 1
		for _, id in ipairs(results) do
			local def = Config.SAT_BY_ID[id]
			if def then
				bestRarity = math.max(bestRarity, def.rarity)
				local col = rarityColor(def.rarity)
				local card = new("Frame", { Size = UDim2.new(0, 210, 0, 290), BackgroundColor3 = Color3.new(1, 1, 1), Parent = row }, { corner(16), new("UIStroke", { Color = col, Thickness = 4 }), grad(col:Lerp(C.bg, 0.4), C.bg) })
				local sc = new("UIScale", { Scale = 0.3, Parent = card })
				TweenService:Create(sc, TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 }):Play()
				satView(card, def, false, UDim2.new(1, -20, 0, 170), UDim2.new(0, 10, 0, 6))
				text({ Position = UDim2.new(0, 0, 0, 178), Size = UDim2.new(1, 0, 0, 34), TextSize = 22, Font = Enum.Font.GothamBlack, TextXAlignment = Enum.TextXAlignment.Center, Text = def.name, Parent = card })
				text({ Position = UDim2.new(0, 0, 0, 212), Size = UDim2.new(1, 0, 0, 30), TextSize = 20, Font = Enum.Font.GothamBlack, TextXAlignment = Enum.TextXAlignment.Center, TextColor3 = col, Text = Config.Rarities[def.rarity].name, Parent = card })
				text({ Position = UDim2.new(0, 0, 0, 244), Size = UDim2.new(1, 0, 0, 30), TextSize = 20, Font = Enum.Font.GothamBlack, TextXAlignment = Enum.TextXAlignment.Center, TextColor3 = C.gold, Text = "질량 ×" .. tostring(def.mult), Parent = card })
			end
		end
		if bestRarity >= 4 then
			Fx.sound("whoosh", 0.8, 0.5)
			local c = player.Character and Fx.holeCenter(player.Character)
			if c then
				Fx.pillar(c, rarityColor(bestRarity), 200, 16, 1)
			end
		end
		task.wait(0.6)
		flash:Destroy()
		local closeBtn = button({ AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 312), Size = UDim2.new(0, 200, 0, 44), Text = "좋아요!", TextSize = 20, BackgroundColor3 = C.green, Parent = holder }, function()
			overlay.Visible = false
			busy = false
		end)
		task.delay(4, function()
			if closeBtn.Parent and overlay.Visible then
				overlay.Visible = false
				busy = false
			end
		end)
	end
end

------------------------------------------------------------------------
-- 갱신
------------------------------------------------------------------------
local function boostText(): (string, boolean)
	if not state then
		return "", false
	end
	local passed = os.clock() - stateAt
	local list = {}
	local ended = false
	local function add(left: number, label: string)
		if left > 0 then
			local now = left - passed
			if now > 0 then
				table.insert(list, label .. " " .. Config.formatTime(now))
			else
				ended = true
			end
		end
	end
	add(state.starLeft, "⭐ 별똥별 2배")
	add(state.boostLeft, "🔥 질량 2배")
	add(state.respawnLeft, "♻ 빠른 재생산")
	return table.concat(list, "   "), ended
end

local function refreshAll()
	if not state then
		return
	end
	HUD.mass.Text = "💠 " .. fmt(state.mass)
	HUD.stat.Text = string.format(
		"⚫ %s   🌀 +%s   ✖ %s%s%s",
		Config.formatSize(state.radius),
		Config.formatSize(state.pullRange),
		fmt(state.totalMult),
		state.bigbang > 0 and string.format("   🌌 %d", state.bigbang) or "",
		state.dm > 0 and string.format("   🌑 %d", state.dm) or ""
	)
	autoButton.Text = state.auto and "🤖 자동 업그레이드: 켬" or "🤖 자동 업그레이드: 끔"
	autoButton.BackgroundColor3 = state.auto and C.green or C.panel2
	for _, u in ipairs(Config.Upgrades) do
		local card = cards[u.id]
		local level = state[u.id] :: number
		local maxed = level >= u.maxLevel
		card.level.Text = maxed and "MAX" or string.format("Lv.%d / %d", level, u.maxLevel)
		local nowText, nextText
		if u.id == "size" then
			nowText, nextText = Config.formatSize(Config.radius(level)), Config.formatSize(Config.radius(level + 1))
		elseif u.id == "pull" then
			local r = state.radius
			nowText, nextText = Config.formatSize(Config.pullRange(r, level, state.bb.pull)), Config.formatSize(Config.pullRange(r, level + 1, state.bb.pull))
		else
			nowText, nextText = string.format("×%.2f", 1 + 0.25 * level), string.format("×%.2f", 1 + 0.25 * (level + 1))
		end
		card.effect.Text = maxed and (u.desc .. "\n지금 " .. nowText) or string.format("%s\n%s → %s", u.desc, nowText, nextText)
		local cost = Config.upgradeCost(u.id, level)
		local can = not maxed and state.mass >= cost
		card.buy.Text = maxed and "최대" or ("💠 " .. fmt(cost))
		card.buy.BackgroundColor3 = can and C.accent or C.panel2
		card.max.BackgroundColor3 = can and C.pink or C.panel2
	end
	-- 다음 구역 진행 막대 (지금 세계 기준)
	local r = state.radius
	local nextZone = nil
	local prevNeed = 0
	for _, zi in ipairs(Config.zonesOf(currentWorld)) do
		local zone = Config.Zones[zi]
		if zone.need > r then
			nextZone = nextZone or zone
		else
			prevNeed = zone.need
		end
	end
	if nextZone then
		local ratio = math.clamp((r - prevNeed) / math.max(nextZone.need - prevNeed, 0.01), 0, 1)
		Bar.fill.Size = UDim2.fromScale(ratio, 1)
		Bar.label.Text = string.format("다음 구역 '%s'까지  ⚫ %s / %d", nextZone.name, Config.formatSize(r), nextZone.need)
	elseif state.size >= Config.BIGBANG_LEVEL then
		Bar.fill.Size = UDim2.fromScale(1, 1)
		Bar.label.Text = "🌌 빅뱅할 수 있어요! (B)"
	else
		local ratio = math.clamp(state.size / Config.BIGBANG_LEVEL, 0, 1)
		Bar.fill.Size = UDim2.fromScale(ratio, 1)
		Bar.label.Text = string.format("모든 구역이 열렸어요! 빅뱅까지 크기 Lv %d / %d", state.size, Config.BIGBANG_LEVEL)
	end
	menuButtons.test.Visible = state.tester == true
	menuButtons.bbshop.Visible = state.bigbang > 0 or state.dm > 0
	if window.Visible then
		local f = refreshers[currentPage]
		if f then
			f()
		end
	end
end

------------------------------------------------------------------------
-- 카메라와 문: 크기에 맞춰 멀리서 보고, 크기가 되는 문은 통과한다
------------------------------------------------------------------------
local function applyRadius(r: number)
	player.CameraMaxZoomDistance = math.max(60, 40 + r * 6)
	player.CameraMinZoomDistance = math.min(10 + r * 1.6, player.CameraMaxZoomDistance - 5)
	local zones = workspace:FindFirstChild("Zones")
	if not zones then
		return
	end
	for _, g in ipairs(zones:GetChildren()) do
		if g.Name == "Gate" and g:IsA("BasePart") then
			local need = g:GetAttribute("Need")
			local open = type(need) == "number" and r >= need
			g.CanCollide = not open
			if open then
				g.Color = Color3.fromRGB(90, 230, 150)
			end
			g.Transparency = open and 0.6 or 0.2
		end
	end
end

-- 세계마다 하늘 빛깔
local function applyWorld(w: number)
	currentWorld = w
	local atmo = Lighting:FindFirstChildOfClass("Atmosphere")
	if atmo then
		local col = w == 2 and Color3.fromRGB(255, 200, 235) or Color3.fromRGB(200, 210, 240)
		local decay = w == 2 and Color3.fromRGB(200, 120, 190) or Color3.fromRGB(120, 110, 160)
		TweenService:Create(atmo, TweenInfo.new(1.2), { Color = col, Decay = decay }):Play()
	end
end

------------------------------------------------------------------------
-- 너무 큰 물체: 빨간 테두리와 필요한 크기
------------------------------------------------------------------------
do
	local highlight = new("Highlight", {
		FillTransparency = 1,
		OutlineColor = Color3.fromRGB(255, 70, 90),
		OutlineTransparency = 0.1,
		DepthMode = Enum.HighlightDepthMode.Occluded,
		Enabled = false,
		Parent = workspace,
	})
	task.spawn(function()
		local objects = workspace:WaitForChild("Objects")
		while true do
			task.wait(0.25)
			local char = player.Character
			local root = char and char:FindFirstChild("HumanoidRootPart")
			if state and root and root:IsA("BasePart") then
				local r = state.radius
				local reach = r + state.pullRange + 6
				local best: Model? = nil
				local bestDist = math.huge
				local bestSize = 0
				local p = root.Position
				for _, m in ipairs(objects:GetChildren()) do
					local size = m:GetAttribute("Size")
					if type(size) == "number" and size > r and not m:GetAttribute("EatenBy") and m:IsA("Model") then
						local pivot = m:GetPivot().Position
						local d = Vector3.new(pivot.X - p.X, 0, pivot.Z - p.Z).Magnitude - size
						if d < reach and d < bestDist then
							best, bestDist, bestSize = m, d, size
						end
					end
				end
				if best then
					highlight.Adornee = best
					highlight.Enabled = true
					local label = best:GetAttribute("Label")
					Bar.hint.Text = string.format("🔒 %s: 크기 %s 필요", type(label) == "string" and label or "?", Config.formatSize(bestSize))
				else
					highlight.Enabled = false
					Bar.hint.Text = ""
				end
			end
		end
	end)
end

------------------------------------------------------------------------
-- 연속 흡수: 1.5초 안에 계속 삼키면 숫자가 커진다
------------------------------------------------------------------------
local addCombo
do
	local label = text({
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 128),
		Size = UDim2.new(0, 400, 0, 40),
		TextXAlignment = Enum.TextXAlignment.Center,
		TextSize = 30,
		Font = Enum.Font.GothamBlack,
		TextColor3 = C.pink,
		TextStrokeTransparency = 0.2,
		Visible = false,
		Parent = gui,
	})
	local sc = new("UIScale", { Parent = label })
	local combo = 0
	local last = 0
	function addCombo(n: number)
		local now = os.clock()
		if now - last > 1.5 then
			combo = 0
		end
		last = now
		combo += n
		if combo >= 5 then
			label.Visible = true
			label.Text = string.format("🌀 연속 흡수 x%d", combo)
			sc.Scale = uiScale * 1.3
			TweenService:Create(sc, TweenInfo.new(0.15, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = uiScale }):Play()
		end
	end
	RunService.Heartbeat:Connect(function()
		if label.Visible and os.clock() - last > 1.5 then
			label.Visible = false
			combo = 0
		end
	end)
end

-- 큰 글자 배너
local function banner(title: string, sub: string, color: Color3)
	local frame = new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0.5, 0, 0.32, 0),
		Size = UDim2.new(0, 700, 0, 110),
		BackgroundTransparency = 1,
		ZIndex = 15,
		Parent = gui,
	})
	local sc = new("UIScale", { Scale = uiScale * 1.5, Parent = frame })
	local t = text({ Size = UDim2.new(1, 0, 0, 64), TextXAlignment = Enum.TextXAlignment.Center, TextSize = 52, Font = Enum.Font.GothamBlack, TextColor3 = color, TextStrokeTransparency = 0, Text = title, Parent = frame })
	local s = text({ Position = UDim2.new(0, 0, 0, 66), Size = UDim2.new(1, 0, 0, 34), TextXAlignment = Enum.TextXAlignment.Center, TextSize = 24, TextStrokeTransparency = 0.3, Text = sub, Parent = frame })
	TweenService:Create(sc, TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = uiScale }):Play()
	task.delay(2, function()
		TweenService:Create(t, TweenInfo.new(0.4), { TextTransparency = 1, TextStrokeTransparency = 1 }):Play()
		TweenService:Create(s, TweenInfo.new(0.4), { TextTransparency = 1, TextStrokeTransparency = 1 }):Play()
		task.delay(0.45, function()
			frame:Destroy()
		end)
	end)
end

local function myCenter(): Vector3?
	local char = player.Character
	return char and Fx.holeCenter(char) or nil
end

------------------------------------------------------------------------
-- 서버 메시지
------------------------------------------------------------------------
local lastRadius = -1
local handlers: { [string]: (any) -> () } = {}

function handlers.state(data: any)
	local grew = state ~= nil and data.radius > lastRadius + 0.001
	state = data
	stateAt = os.clock()
	if data.radius ~= lastRadius then
		lastRadius = data.radius
		applyRadius(data.radius)
	end
	if grew then
		local c = myCenter()
		if c then
			Fx.ring(c, C.accent, data.radius * 1.5, data.radius * 3, 0.5)
		end
	end
	refreshAll()
end

function handlers.eat(data: any)
	if state then
		state.mass = data.mass
	end
	local biggest = 0
	for _, e in ipairs(data.list) do
		biggest = math.max(biggest, e.size)
		Fx.popup(e.pos + Vector3.new(0, e.size * 1.2 + 2, 0), "+" .. fmt(e.mass), Color3.fromRGB(210, 170, 255), 20 + math.min(14, e.size))
	end
	local r = state and state.radius or 3
	local ratio = biggest / r
	Fx.sound("pop", 0.25 + ratio * 0.3, 1.6 - ratio * 0.8 + math.random() * 0.1)
	if ratio > 0.7 then
		Fx.sound("whoosh", 0.4, 0.6)
		local c = myCenter()
		if c then
			Fx.burst(c + Vector3.new(0, 1, 0), C.pink, 20, r * 2, math.max(0.4, r * 0.1))
		end
	end
	addCombo(#data.list)
	refreshAll()
end

function handlers.toast(data: any)
	toast(data)
end

function handlers.upgraded(data: any)
	if data.quiet then
		return
	end
	Fx.sound("pop", 0.5, 1.9)
	local c = myCenter()
	if c and state then
		Fx.burst(c + Vector3.new(0, 1, 0), C.gold, 25, 10 + state.radius, 0.6)
	end
end

function handlers.zone(data: any)
	local zone = Config.Zones[data]
	if zone then
		if zone.world ~= currentWorld then
			applyWorld(zone.world)
		end
		local n = table.find(Config.zonesOf(zone.world), data) or data
		banner(string.format("%d · %s", n, zone.name), zone.world == 2 and "달콤한 것들이 기다려요" or "더 큰 것들이 기다려요", zone.ground:Lerp(Color3.new(1, 1, 1), 0.4))
		Fx.sound("whoosh", 0.5, 0.8)
		refreshAll()
	end
end

function handlers.world(data: any)
	local w = Config.Worlds[data]
	if w then
		applyWorld(data)
		banner(string.format("%s 세계 %d", data == 2 and "🍭" or "🌍", data), w.name, w.sky)
		Fx.sound("whoosh", 0.8, 0.5)
		refreshAll()
	end
end

function handlers.bigbang(data: any)
	local c = myCenter()
	if c then
		Fx.pillar(c, Color3.new(1, 1, 1), 400, 30, 1.2)
		for i = 0, 4 do
			task.delay(i * 0.12, function()
				Fx.ring(c, Color3.fromHSV(i / 5, 0.7, 1), 10, 200 + i * 60, 0.9)
			end)
		end
	end
	Fx.sound("whoosh", 1, 0.3)
	local sub = string.format("빅뱅 %d회 · 🌑 암흑 물질 +%d", data.count, data.dm)
	if #data.skins > 0 then
		sub ..= " · 🎨 " .. table.concat(data.skins, ", ")
	end
	banner("🌌 BIG BANG", sub, C.pink)
	if data.world2 then
		task.delay(2.6, function()
			banner("🍭 세계 2 열림!", "과자 왕국 · 🗺 세계 창이나 소용돌이 문으로 가요", Color3.fromRGB(255, 160, 220))
		end)
	end
end

function handlers.bbBought(data: any)
	local b = Config.BB_BY_ID[data.id]
	Fx.sound("pop", 0.6, 1.2)
	if b then
		toast(string.format("%s %s Lv.%d!", b.icon, b.name, data.level))
	end
end

function handlers.hatched(data: any)
	window.Visible = false
	task.spawn(playHatch, data.capsule, data.results)
end

function handlers.gold(data: any)
	local def = Config.SAT_BY_ID[data.id]
	banner("✨ 황금 위성!", def and def.name or "", C.gold)
	Fx.sound("slash", 0.7, 1.3)
end

function handlers.unlock(data: any)
	if data.kind == "skin" then
		banner("🎨 새 스킨!", data.name, C.pink)
	else
		banner("🐉 " .. data.name, "비밀 위성 3종과 전용 스킨이 들어왔어요!", C.gold)
	end
	Fx.sound("whoosh", 0.8, 0.7)
end

function handlers.star(data: any)
	Fx.star(data.pos, data.life)
	toast("☄ 별똥별이 떨어졌어요! 삼키면 질량 2배")
end

function handlers.starGot(data: any)
	Fx.starGot(data.pos)
	banner("⭐ 질량 2배!", string.format("%d초 동안", math.floor(data.left)), C.gold)
end

Push.OnClientEvent:Connect(function(kind: string, data: any)
	local f = handlers[kind]
	if f then
		f(data)
	end
end)

------------------------------------------------------------------------
-- 👑 VIP 채팅 태그
------------------------------------------------------------------------
pcall(function()
	TextChatService.OnIncomingMessage = function(message: TextChatMessage)
		local props = Instance.new("TextChatMessageProperties")
		local source = message.TextSource
		local who = source and Players:GetPlayerByUserId(source.UserId)
		if who and who:GetAttribute("VIP") then
			props.PrefixText = '<font color="#FFD750">[👑 VIP]</font> ' .. message.PrefixText
		end
		return props
	end
end)

------------------------------------------------------------------------
-- 시작
------------------------------------------------------------------------
Fx.start()
player.CharacterAdded:Connect(function()
	task.wait(0.5)
	if state then
		applyRadius(state.radius)
	end
end)
UserInputService.InputBegan:Connect(function(input, processed)
	if processed then
		return
	end
	local key = input.KeyCode
	if key == Enum.KeyCode.B then
		openPage("bigbang")
	elseif key == Enum.KeyCode.M then
		openPage("zones")
	elseif key == Enum.KeyCode.P then
		openPage("sats")
	elseif key == Enum.KeyCode.G then
		openPage("store")
	end
end)

-- 매 프레임: 부스트 시계, 미리보기 위성 돌리기, 세계 문 소용돌이
do
	local swirls: { BasePart } = {}
	task.spawn(function()
		local zones = workspace:WaitForChild("Zones")
		for _, d in ipairs(zones:GetChildren()) do
			if d:IsA("BasePart") and d:GetAttribute("Spin") then
				table.insert(swirls, d)
			end
		end
	end)
	local swirlBase: { [BasePart]: CFrame } = {}
	local lastBoost = ""
	local refreshAsked = 0
	RunService.RenderStepped:Connect(function()
		local t = os.clock()
		local bt, ended = boostText()
		if bt ~= lastBoost then
			lastBoost = bt
			HUD.boosts.Text = bt
		end
		if ended and t - refreshAsked > 3 then
			refreshAsked = t
			Request:FireServer("refresh")
		end
		if window.Visible or #spinning > 0 then
			for i = #spinning, 1, -1 do
				local s = spinning[i]
				if not s.vf.Parent then
					table.remove(spinning, i)
				elseif s.vf.Visible and s.model.PrimaryPart then
					s.model:PivotTo(CFrame.Angles(0, t * 0.9 + i, 0))
				end
			end
		end
		for _, p in ipairs(swirls) do
			local base = swirlBase[p]
			if not base then
				base = p.CFrame
				swirlBase[p] = base
			end
			p.CFrame = base * CFrame.Angles(t * 2, 0, 0)
		end
	end)
end

Request:FireServer("hello")
]]></string>
        </Properties>
        <Item class="ModuleScript" referent="12">
          <Properties>
            <string name="Name">Fx</string>
            <string name="Source"><![CDATA[-- Fx (ModuleScript, HoleClient 아래)
-- 블랙홀 모양, 빨려 들어가는 연출, 떠오르는 숫자, 효과음.
-- 블랙홀은 서버가 캐릭터에 붙인 크기(HoleR), 스킨(HoleSkin), 위성(Sats)을 보고 각자 화면에서 그린다.
--   검은 구멍 → 어두운 원반 → 빛나는 테두리 → 소용돌이 팔 세 개 → 도는 강착 원반 → 안으로 빨려 드는 빛 알갱이
--   스킨 효과: 불꽃, 얼음 조각, 은하 별빛, 사탕 가루, 황금 반짝임, 신의 눈, 무지개
--   위성은 블랙홀 둘레를 돌며 둥실거린다. 다시 생긴 물체는 뿅 하고 커지며 나타난다.

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local SoundService = game:GetService("SoundService")
local Debris = game:GetService("Debris")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage:WaitForChild("Config"))
local SatBuilder = require(ReplicatedStorage:WaitForChild("SatBuilder"))

local Fx = {}

local FLAT = CFrame.Angles(0, 0, math.rad(90))
local BLACK = Color3.new(0, 0, 0)

local folder = Instance.new("Folder")
folder.Name = "HoleFX"
folder.Parent = workspace

local function fxPart(size: Vector3, color: Color3, material: Enum.Material, shape: Enum.PartType?, transparency: number?): Part
	local p = Instance.new("Part")
	if shape then
		p.Shape = shape
	end
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	p.Size = size
	p.Color = color
	p.Material = material
	p.Transparency = transparency or 0
	p.Parent = folder
	return p
end

------------------------------------------------------------------------
-- 효과음
------------------------------------------------------------------------
local SOUNDS = {
	pop = "rbxasset://sounds/electronicpingshort.wav",
	whoosh = "rbxasset://sounds/swordlunge.wav",
	slash = "rbxasset://sounds/swordslash.wav",
}

function Fx.sound(name: string, volume: number?, pitch: number?)
	local id = SOUNDS[name]
	if not id then
		return
	end
	local s = Instance.new("Sound")
	s.SoundId = id
	s.Volume = volume or 0.4
	s.PlaybackSpeed = pitch or 1
	s.Parent = SoundService
	s:Play()
	Debris:AddItem(s, 3)
end

------------------------------------------------------------------------
-- 블랙홀 모양
------------------------------------------------------------------------
type Hole = {
	char: Model,
	radius: number,
	skin: number,
	parts: { Part },
	rim: Part,
	disk: Part,
	void: Part,
	core: Part,
	arms: { { part: Part, t: number, arm: number } },
	ring: { { part: Part, a: number, h: number } },
	motes: { { part: Part, phase: number } },
	light: PointLight,
	effect: string?,
	extras: { { part: Part, kind: string, a: number, k: number } },
	sats: { { model: Model, a: number, size: number } },
	satKey: string,
}

local holes: { [Model]: Hole } = {}

local function destroyHole(h: Hole)
	for _, p in ipairs(h.parts) do
		p:Destroy()
	end
	for _, sat in ipairs(h.sats) do
		sat.model:Destroy()
	end
end

-- 스킨 효과용 파티클 (블랙홀 위로 뿜어 올린다)
local function emitter(add: (Part) -> Part, r: number, props: { [string]: any }): ParticleEmitter
	local d = r * 2
	local box = add(fxPart(Vector3.new(d * 0.9, 0.2, d * 0.9), BLACK, Enum.Material.SmoothPlastic, nil, 1))
	box.Name = "Emitter"
	local pe = Instance.new("ParticleEmitter")
	pe.LightEmission = 1
	pe.Drag = 1
	for k, v in pairs(props) do
		(pe :: any)[k] = v
	end
	pe.Parent = box
	return pe
end

local function seq(a: number, b: number): NumberSequence
	return NumberSequence.new({ NumberSequenceKeypoint.new(0, a), NumberSequenceKeypoint.new(1, b) })
end

-- 위성 모델들 (Sats 속성: "id:금,id:금")
local function buildSats(h: Hole, attr: string)
	for _, sat in ipairs(h.sats) do
		sat.model:Destroy()
	end
	h.sats = {}
	h.satKey = attr
	local list = string.split(attr, ",")
	local size = math.clamp(h.radius * 0.16, 0.45, 40)
	for i, entry in ipairs(list) do
		local id, g = string.match(entry, "^([%w_]+):(%d)$")
		local def = id and Config.SAT_BY_ID[id]
		if def then
			local m = SatBuilder.build(def.shape, def.color, size, g == "1")
			m.Parent = folder
			table.insert(h.sats, { model = m, a = (i - 1) / #list * math.pi * 2, size = size })
		end
	end
end

local function buildHole(char: Model, r: number, skinIndex: number): Hole
	local skin = Config.Skins[skinIndex] or Config.Skins[1]
	local effect = skin.effect
	local parts: { Part } = {}
	local function add(p: Part): Part
		table.insert(parts, p)
		return p
	end
	local d = r * 2
	local rim = add(fxPart(Vector3.new(0.12, d * 1.14, d * 1.14), skin.a, Enum.Material.Neon, Enum.PartType.Cylinder, 0.15))
	local disk = add(fxPart(Vector3.new(0.14, d * 1.05, d * 1.05), skin.a:Lerp(BLACK, 0.82), Enum.Material.SmoothPlastic, Enum.PartType.Cylinder))
	local void = add(fxPart(Vector3.new(0.16, d * 0.9, d * 0.9), BLACK, Enum.Material.SmoothPlastic, Enum.PartType.Cylinder))
	local core = add(fxPart(Vector3.new(0.18, d * 0.45, d * 0.45), BLACK, Enum.Material.Neon, Enum.PartType.Cylinder))
	local light = Instance.new("PointLight")
	light.Color = skin.a
	light.Range = math.min(60, 6 + r * 1.5)
	light.Brightness = 1.5
	light.Parent = rim

	-- 소용돌이 팔: 테두리에서 가운데로 휘어 들어간다
	local arms = {}
	local segs = 9
	for arm = 0, 2 do
		for i = 0, segs - 1 do
			local t = i / (segs - 1)
			local color = skin.a:Lerp(skin.b, t)
			local width = math.max(0.15, r * 0.09 * (1 - t * 0.6))
			local p = add(fxPart(Vector3.new(width, 0.08, math.max(0.3, r * 0.28 * (1 - t * 0.5))), color, Enum.Material.Neon, nil, 0.1 + t * 0.6))
			table.insert(arms, { part = p, t = t, arm = arm })
		end
	end
	-- 강착 원반: 테두리 위를 빠르게 도는 빛 덩어리
	local ring = {}
	local n = 18
	for i = 0, n - 1 do
		local size = math.max(0.25, r * 0.08)
		local col = (i % 2 == 0) and skin.a or skin.b
		if effect == "candy" and i % 2 == 1 then
			col = Color3.new(1, 1, 1)
		end
		local p = add(fxPart(Vector3.new(size * 1.8, size * 0.6, size), col, Enum.Material.Neon, nil, 0.05))
		table.insert(ring, { part = p, a = i / n * math.pi * 2, h = (i % 3) * 0.12 })
	end
	-- 빨려 드는 빛 알갱이
	local motes = {}
	for i = 0, 11 do
		local p = add(fxPart(Vector3.new(1, 1, 1) * math.max(0.15, r * 0.05), skin.b, Enum.Material.Neon, Enum.PartType.Ball))
		table.insert(motes, { part = p, phase = i / 12 })
	end

	-- 스킨 효과
	local extras = {}
	local small = math.max(0.2, r * 0.07)
	if effect == "fire" then
		emitter(add, r, {
			Rate = 40,
			Lifetime = NumberRange.new(0.5, 1),
			Speed = NumberRange.new(2 + r * 0.6, 4 + r * 1.2),
			Size = seq(math.max(0.4, r * 0.25), 0),
			Color = ColorSequence.new(Color3.fromRGB(255, 230, 90), Color3.fromRGB(255, 60, 20)),
			Transparency = seq(0.1, 1),
			RotSpeed = NumberRange.new(-90, 90),
		})
		for i = 0, 7 do
			local p = add(fxPart(Vector3.new(small, small * 4, small), skin.b, Enum.Material.Neon, nil, 0.2))
			table.insert(extras, { part = p, kind = "flame", a = i / 8 * math.pi * 2, k = i })
		end
	elseif effect == "ice" then
		emitter(add, r, {
			Rate = 18,
			Lifetime = NumberRange.new(1.2, 2),
			Speed = NumberRange.new(0.5, 2 + r * 0.2),
			Size = seq(math.max(0.15, r * 0.06), 0),
			Color = ColorSequence.new(Color3.new(1, 1, 1), skin.a),
		})
		for i = 0, 9 do
			local p = add(fxPart(Vector3.new(small * 1.3, small * 5, small * 1.3), skin.a:Lerp(Color3.new(1, 1, 1), (i % 2) * 0.5), Enum.Material.Ice, nil, 0.1))
			table.insert(extras, { part = p, kind = "shard", a = i / 10 * math.pi * 2, k = i })
		end
	elseif effect == "galaxy" then
		emitter(add, r, {
			Rate = 30,
			Lifetime = NumberRange.new(1.5, 2.5),
			Speed = NumberRange.new(0.2, 1 + r * 0.1),
			Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(0.5, math.max(0.15, r * 0.05)), NumberSequenceKeypoint.new(1, 0) }),
			Color = ColorSequence.new(Color3.new(1, 1, 1), skin.a),
		})
		local halo = add(fxPart(Vector3.new(0.1, d * 1.5, d * 1.5), skin.a, Enum.Material.Neon, Enum.PartType.Cylinder, 0.75))
		table.insert(extras, { part = halo, kind = "halo", a = 0, k = 0 })
		for i = 0, 11 do
			local p = add(fxPart(Vector3.new(1, 1, 1) * small * 0.8, i % 3 == 0 and skin.b or Color3.new(1, 1, 1), Enum.Material.Neon, Enum.PartType.Ball))
			table.insert(extras, { part = p, kind = "orbitStar", a = i / 12 * math.pi * 2, k = i })
		end
	elseif effect == "candy" then
		for i = 0, 15 do
			local p = add(fxPart(Vector3.new(small * 2, small * 0.6, small * 0.6), Color3.fromHSV(i / 16, 0.55, 1), Enum.Material.SmoothPlastic))
			table.insert(extras, { part = p, kind = "sprinkle", a = i / 16 * math.pi * 2, k = i })
		end
	elseif effect == "gold" then
		emitter(add, r, {
			Rate = 14,
			Lifetime = NumberRange.new(0.6, 1.2),
			Speed = NumberRange.new(1, 2 + r * 0.3),
			Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(0.3, math.max(0.25, r * 0.08)), NumberSequenceKeypoint.new(1, 0) }),
			Color = ColorSequence.new(Color3.fromRGB(255, 240, 160), Color3.fromRGB(255, 190, 40)),
		})
		for i = 0, 7 do
			local p = add(fxPart(Vector3.new(small * 1.4, small * 1.4, small * 1.4), Color3.fromRGB(255, 220, 90), Enum.Material.Neon))
			table.insert(extras, { part = p, kind = "glint", a = i / 8 * math.pi * 2, k = i })
		end
	elseif effect == "eye" then
		local iris = add(fxPart(Vector3.new(0.1, d * 0.5, d * 0.5), skin.a, Enum.Material.Neon, Enum.PartType.Cylinder))
		local pupil = add(fxPart(Vector3.new(0.12, d * 0.22, d * 0.22), BLACK, Enum.Material.SmoothPlastic, Enum.PartType.Cylinder))
		local shine = add(fxPart(Vector3.new(0.13, d * 0.07, d * 0.07), Color3.new(1, 1, 1), Enum.Material.Neon, Enum.PartType.Cylinder))
		table.insert(extras, { part = iris, kind = "iris", a = 0, k = 0 })
		table.insert(extras, { part = pupil, kind = "pupil", a = 0, k = 0 })
		table.insert(extras, { part = shine, kind = "shine", a = 0, k = 0 })
		for i = 0, 9 do
			local p = add(fxPart(Vector3.new(small * 0.8, 0.1, r * 0.35), skin.b, Enum.Material.Neon, nil, 0.2))
			table.insert(extras, { part = p, kind = "ray", a = i / 10 * math.pi * 2, k = i })
		end
	end

	return {
		char = char,
		radius = r,
		skin = skinIndex,
		parts = parts,
		rim = rim,
		disk = disk,
		void = void,
		core = core,
		arms = arms,
		ring = ring,
		motes = motes,
		light = light,
		effect = effect,
		extras = extras,
		sats = {},
		satKey = "",
	}
end

-- 블랙홀이 있는 바닥 자리 (모든 구역의 바닥 높이는 0)
function Fx.holeCenter(char: Model): Vector3?
	local root = char:FindFirstChild("HumanoidRootPart")
	if not root or not root:IsA("BasePart") then
		return nil
	end
	return Vector3.new(root.Position.X, 0, root.Position.Z)
end

local function updateHole(h: Hole, t: number)
	local center = Fx.holeCenter(h.char)
	if not center then
		return
	end
	local r = h.radius
	local base = CFrame.new(center)
	h.rim.CFrame = base * CFrame.new(0, 0.04, 0) * FLAT
	h.disk.CFrame = base * CFrame.new(0, 0.06, 0) * FLAT
	h.void.CFrame = base * CFrame.new(0, 0.08, 0) * FLAT
	h.core.CFrame = base * CFrame.new(0, 0.1, 0) * FLAT
	if h.effect == "rainbow" then
		local c = Color3.fromHSV((t * 0.15) % 1, 0.8, 1)
		h.rim.Color = c
		h.light.Color = c
		for i, q in ipairs(h.ring) do
			q.part.Color = Color3.fromHSV((t * 0.15 + i / #h.ring) % 1, 0.7, 1)
		end
	elseif h.effect == "fire" then
		h.light.Brightness = 1.5 + math.sin(t * 17) * 0.4 + math.sin(t * 7) * 0.3
	end
	for _, e in ipairs(h.extras) do
		local p = e.part
		if e.kind == "flame" then
			local ang = e.a + t * 1.5
			local flick = 0.7 + math.abs(math.sin(t * 9 + e.k)) * 0.6
			p.CFrame = CFrame.new(center + Vector3.new(math.cos(ang) * r * 1.05, r * 0.15 * flick, math.sin(ang) * r * 1.05)) * CFrame.Angles(0, -ang, math.sin(t * 6 + e.k) * 0.3)
			p.Transparency = 0.1 + (1 - flick) * 0.5
		elseif e.kind == "shard" then
			local ang = e.a + t * 0.4
			p.CFrame = CFrame.new(center + Vector3.new(math.cos(ang) * r * 1.15, r * 0.12, math.sin(ang) * r * 1.15)) * CFrame.Angles(0, -ang, 0) * CFrame.Angles(0, 0, 0.5)
		elseif e.kind == "halo" then
			p.CFrame = base * CFrame.new(0, r * 0.15, 0) * CFrame.Angles(math.sin(t * 0.7) * 0.25, t * 0.3, 0) * FLAT
		elseif e.kind == "orbitStar" then
			local ang = e.a - t * 0.8
			p.CFrame = CFrame.new(center + Vector3.new(math.cos(ang) * r * 1.45, r * 0.15 + math.sin(ang * 2 + t) * r * 0.08, math.sin(ang) * r * 1.45))
			p.Transparency = 0.2 + (math.sin(t * 5 + e.k * 1.7) + 1) * 0.3
		elseif e.kind == "sprinkle" then
			local ang = e.a + t * 1.2
			local rad = r * (1.25 + math.sin(t * 2 + e.k) * 0.08)
			p.CFrame = CFrame.new(center + Vector3.new(math.cos(ang) * rad, r * 0.1 + math.sin(t * 3 + e.k) * r * 0.06, math.sin(ang) * rad)) * CFrame.Angles(t * 3 + e.k, ang, 0)
		elseif e.kind == "glint" then
			local ang = e.a + t * 0.9
			p.CFrame = CFrame.new(center + Vector3.new(math.cos(ang) * r * 1.3, r * 0.25 + math.sin(t * 2 + e.k) * r * 0.1, math.sin(ang) * r * 1.3)) * CFrame.Angles(t * 2, t * 3, math.rad(45))
			p.Transparency = (math.sin(t * 6 + e.k * 2) + 1) * 0.4
		elseif e.kind == "iris" or e.kind == "pupil" or e.kind == "shine" then
			-- 눈동자가 움직이는 쪽을 바라본다
			local root = h.char:FindFirstChild("HumanoidRootPart")
			local vel = (root and root:IsA("BasePart")) and root.AssemblyLinearVelocity or Vector3.zero
			local look = Vector3.new(vel.X, 0, vel.Z)
			local off = look.Magnitude > 1 and look.Unit * r * 0.18 or Vector3.new(math.sin(t * 0.7), 0, math.cos(t * 0.5)) * r * 0.08
			local y = e.kind == "iris" and 0.13 or (e.kind == "pupil" and 0.15 or 0.17)
			local extra = e.kind == "iris" and off * 0.5 or (e.kind == "pupil" and off or off + Vector3.new(r * 0.06, 0, -r * 0.06))
			p.CFrame = CFrame.new(center + extra + Vector3.new(0, y, 0)) * FLAT
		elseif e.kind == "ray" then
			local ang = e.a + t * 0.25
			local len = 1 + math.sin(t * 3 + e.k) * 0.2
			local pos = center + Vector3.new(math.cos(ang) * r * 1.3, 0.1, math.sin(ang) * r * 1.3)
			p.CFrame = CFrame.lookAt(pos, pos + Vector3.new(math.cos(ang), 0, math.sin(ang)))
			p.Size = Vector3.new(p.Size.X, 0.1, r * 0.35 * len)
		end
	end
	for i, sat in ipairs(h.sats) do
		local ang = sat.a + t * (0.9 - math.min(0.5, r * 0.002))
		local rad = r * 1.3 + sat.size * 2.5 + 1
		local y = r * 0.25 + sat.size * 1.5 + math.sin(t * 2.2 + i * 1.3) * sat.size * 0.5
		local pos = center + Vector3.new(math.cos(ang) * rad, y, math.sin(ang) * rad)
		sat.model:PivotTo(CFrame.lookAt(pos, pos + Vector3.new(-math.sin(ang), 0, math.cos(ang))) * CFrame.Angles(0, t * 1.5 + i, 0))
	end
	-- 테두리가 숨 쉬듯 빛난다
	h.rim.Transparency = 0.1 + (math.sin(t * 3) + 1) * 0.1
	local spin = t * 1.4
	for _, a in ipairs(h.arms) do
		local ang = spin + a.arm * (math.pi * 2 / 3) + a.t * 2.4
		local rad = r * (1.0 - a.t * 0.8)
		local pos = center + Vector3.new(math.cos(ang) * rad, 0.12, math.sin(ang) * rad)
		a.part.CFrame = CFrame.lookAt(pos, pos + Vector3.new(-math.sin(ang), 0, math.cos(ang)))
	end
	for _, q in ipairs(h.ring) do
		local ang = q.a + t * 2.6
		local rad = r * 1.08
		local pos = center + Vector3.new(math.cos(ang) * rad, 0.25 + q.h + math.sin(t * 4 + q.a * 3) * 0.08 * r, math.sin(ang) * rad)
		q.part.CFrame = CFrame.lookAt(pos, pos + Vector3.new(-math.sin(ang), 0, math.cos(ang)))
	end
	for _, m in ipairs(h.motes) do
		local k = (t * 0.6 + m.phase) % 1
		local ang = m.phase * 20 + k * 6
		local rad = r * 1.2 * (1 - k)
		m.part.CFrame = CFrame.new(center + Vector3.new(math.cos(ang) * rad, 0.3 + (1 - k) * r * 0.2, math.sin(ang) * rad))
		m.part.Transparency = k * 0.8
	end
end

local function syncHole(char: Model)
	local r = char:GetAttribute("HoleR")
	local skin = char:GetAttribute("HoleSkin")
	local h = holes[char]
	if type(r) ~= "number" or not char.Parent then
		if h then
			destroyHole(h)
			holes[char] = nil
		end
		return
	end
	local skinIndex = type(skin) == "number" and skin or 1
	local sats = char:GetAttribute("Sats")
	local satKey = type(sats) == "string" and sats or ""
	if h and h.radius == r and h.skin == skinIndex then
		if h.satKey ~= satKey then
			buildSats(h, satKey)
		end
		return
	end
	if h then
		destroyHole(h)
	end
	local nh = buildHole(char, r, skinIndex)
	holes[char] = nh
	buildSats(nh, satKey)
end

local function watchCharacter(char: Model)
	syncHole(char)
	char:GetAttributeChangedSignal("HoleR"):Connect(function()
		syncHole(char)
	end)
	char:GetAttributeChangedSignal("HoleSkin"):Connect(function()
		syncHole(char)
	end)
	char:GetAttributeChangedSignal("Sats"):Connect(function()
		syncHole(char)
	end)
	char.AncestryChanged:Connect(function()
		if not char.Parent then
			syncHole(char)
		end
	end)
end

local function watchPlayer(player: Player)
	if player.Character then
		watchCharacter(player.Character)
	end
	player.CharacterAdded:Connect(function(c)
		watchCharacter(c :: Model)
	end)
end

------------------------------------------------------------------------
-- 빨려 들어가는 연출: 모든 화면에서, 누가 삼켰든 그 블랙홀로 소용돌이치며 들어간다
------------------------------------------------------------------------
type Sucked = { part: BasePart, offset: Vector3, height: number, size: Vector3, tr: number }

local function suck(model: Model)
	local id = model:GetAttribute("EatenBy")
	if type(id) ~= "number" then
		return
	end
	local eater = Players:GetPlayerByUserId(id)
	local char = eater and eater.Character
	local center = char and Fx.holeCenter(char)
	if not center then
		return
	end
	local list: { Sucked } = {}
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("BasePart") then
			local off = d.Position - center
			table.insert(list, { part = d, offset = Vector3.new(off.X, 0, off.Z), height = off.Y, size = d.Size, tr = d.Transparency })
		elseif d:IsA("ParticleEmitter") or d:IsA("PointLight") or d:IsA("SpotLight") then
			(d :: any).Enabled = false
		end
	end
	local start = os.clock()
	local duration = 0.5
	local conn: RBXScriptConnection
	conn = RunService.RenderStepped:Connect(function()
		local t = math.min(1, (os.clock() - start) / duration)
		local c = Fx.holeCenter(char :: Model) or center
		local ease = t * t
		local spin = CFrame.Angles(0, ease * 5, 0)
		for _, s in ipairs(list) do
			local p = s.part
			if p.Parent then
				local off = spin * (s.offset * (1 - ease))
				p.CFrame = CFrame.new(c + off + Vector3.new(0, s.height * (1 - ease) - ease * 2, 0)) * CFrame.Angles(ease * 6, ease * 4, 0)
				p.Size = s.size * math.max(0.05, 1 - ease * 0.95)
				p.Transparency = s.tr + (1 - s.tr) * ease
			end
		end
		if t >= 1 then
			conn:Disconnect()
			for _, s in ipairs(list) do
				s.part.LocalTransparencyModifier = 1
			end
		end
	end)
end

-- 다시 생긴 물체: 작게 시작해서 통통 튀듯 원래 크기로
local readyAt = math.huge

local function growIn(model: Model)
	local ok = pcall(function()
		model:ScaleTo(0.05)
	end)
	if not ok then
		return
	end
	local pos = model:GetPivot().Position
	local size = model:GetAttribute("Size")
	local s = type(size) == "number" and size or 2
	Fx.burst(pos + Vector3.new(0, s * 0.5, 0), Color3.fromRGB(255, 255, 220), 10, 4 + s, math.clamp(s * 0.2, 0.3, 6))
	local start = os.clock()
	local conn: RBXScriptConnection
	conn = RunService.RenderStepped:Connect(function()
		local t = math.min(1, (os.clock() - start) / 0.45)
		if not model.Parent or model:GetAttribute("EatenBy") then
			conn:Disconnect()
			return
		end
		-- 살짝 넘쳤다가 돌아오는 곡선
		local c = 1.7
		local k = 1 + (c + 1) * (t - 1) ^ 3 + c * (t - 1) ^ 2
		pcall(function()
			model:ScaleTo(math.max(0.05, k))
		end)
		if t >= 1 then
			conn:Disconnect()
			pcall(function()
				model:ScaleTo(1)
			end)
		end
	end)
end

local function watchObject(model: Instance)
	if not model:IsA("Model") then
		return
	end
	if model:GetAttribute("EatenBy") then
		suck(model :: Model)
	elseif os.clock() > readyAt then
		growIn(model :: Model)
	end
	model:GetAttributeChangedSignal("EatenBy"):Connect(function()
		suck(model :: Model)
	end)
end

------------------------------------------------------------------------
-- 떠오르는 숫자와 터지는 빛
------------------------------------------------------------------------
function Fx.popup(pos: Vector3, text: string, color: Color3, size: number)
	local anchor = fxPart(Vector3.new(0.2, 0.2, 0.2), color, Enum.Material.Neon, nil, 1)
	anchor.CFrame = CFrame.new(pos)
	local bb = Instance.new("BillboardGui")
	bb.Size = UDim2.new(0, 220, 0, 50)
	bb.AlwaysOnTop = true
	bb.LightInfluence = 0
	bb.MaxDistance = 3000
	bb.Parent = anchor
	local l = Instance.new("TextLabel")
	l.Size = UDim2.fromScale(1, 1)
	l.BackgroundTransparency = 1
	l.Font = Enum.Font.GothamBlack
	l.TextSize = size
	l.TextColor3 = color
	l.TextStrokeTransparency = 0.2
	l.Text = text
	l.Parent = bb
	TweenService:Create(anchor, TweenInfo.new(0.9, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Position = pos + Vector3.new(0, 4, 0) }):Play()
	TweenService:Create(l, TweenInfo.new(0.4, Enum.EasingStyle.Linear, Enum.EasingDirection.In, 0, false, 0.5), { TextTransparency = 1, TextStrokeTransparency = 1 }):Play()
	Debris:AddItem(anchor, 1)
end

function Fx.burst(pos: Vector3, color: Color3, count: number, speed: number, size: number)
	local anchor = fxPart(Vector3.new(0.2, 0.2, 0.2), color, Enum.Material.Neon, nil, 1)
	anchor.CFrame = CFrame.new(pos)
	local pe = Instance.new("ParticleEmitter")
	pe.Rate = 0
	pe.Lifetime = NumberRange.new(0.3, 0.7)
	pe.Speed = NumberRange.new(speed * 0.5, speed)
	pe.SpreadAngle = Vector2.new(180, 180)
	pe.Drag = 4
	pe.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, size), NumberSequenceKeypoint.new(1, 0) })
	pe.LightEmission = 1
	pe.Color = ColorSequence.new(color)
	pe.Parent = anchor
	pe:Emit(count)
	Debris:AddItem(anchor, 1.2)
end

-- 바닥에 퍼지는 빛 고리
function Fx.ring(pos: Vector3, color: Color3, fromD: number, toD: number, life: number)
	local p = fxPart(Vector3.new(0.2, fromD, fromD), color, Enum.Material.Neon, Enum.PartType.Cylinder, 0.2)
	p.CFrame = CFrame.new(pos + Vector3.new(0, 0.2, 0)) * FLAT
	TweenService:Create(p, TweenInfo.new(life, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Size = Vector3.new(0.2, toD, toD), Transparency = 1 }):Play()
	Debris:AddItem(p, life + 0.05)
end

-- 빛기둥
function Fx.pillar(pos: Vector3, color: Color3, height: number, width: number, life: number)
	local p = fxPart(Vector3.new(height, width, width), color, Enum.Material.Neon, Enum.PartType.Cylinder, 0.1)
	p.CFrame = CFrame.new(pos + Vector3.new(0, height / 2, 0)) * FLAT
	TweenService:Create(p, TweenInfo.new(life, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Size = Vector3.new(height, 0.1, 0.1), Transparency = 1 }):Play()
	Debris:AddItem(p, life + 0.05)
end

------------------------------------------------------------------------
-- 별똥별: 하늘에서 떨어져 바닥에서 반짝인다. 삼키면 질량 2배
------------------------------------------------------------------------
local currentStar: Model? = nil

function Fx.clearStar()
	if currentStar then
		currentStar:Destroy()
		currentStar = nil
	end
end

function Fx.star(pos: Vector3, life: number)
	Fx.clearStar()
	local model = Instance.new("Model")
	model.Name = "ShootingStar"
	model.Parent = folder
	currentStar = model
	local gold = Color3.fromRGB(255, 225, 90)
	local core = fxPart(Vector3.new(3, 3, 3), gold, Enum.Material.Neon, Enum.PartType.Ball)
	core.Parent = model
	local points = {}
	for _ = 1, 5 do
		local p = fxPart(Vector3.new(1.1, 3.2, 1.1), gold:Lerp(Color3.new(1, 1, 1), 0.3), Enum.Material.Neon)
		p.Parent = model
		table.insert(points, p)
	end
	local light = Instance.new("PointLight")
	light.Color = gold
	light.Range = 30
	light.Brightness = 3
	light.Parent = core
	local beam = fxPart(Vector3.new(120, 4, 4), gold, Enum.Material.Neon, Enum.PartType.Cylinder, 0.6)
	beam.Parent = model
	local tag = Instance.new("BillboardGui")
	tag.Size = UDim2.new(0, 180, 0, 40)
	tag.StudsOffset = Vector3.new(0, 7, 0)
	tag.AlwaysOnTop = true
	tag.LightInfluence = 0
	tag.MaxDistance = 5000
	tag.Parent = core
	local l = Instance.new("TextLabel")
	l.Size = UDim2.fromScale(1, 1)
	l.BackgroundTransparency = 1
	l.Font = Enum.Font.GothamBlack
	l.TextScaled = true
	l.TextColor3 = gold
	l.TextStrokeTransparency = 0.2
	l.Text = "⭐ 질량 2배"
	l.Parent = tag
	local trail = Instance.new("ParticleEmitter")
	trail.Rate = 40
	trail.Lifetime = NumberRange.new(0.4, 0.8)
	trail.Speed = NumberRange.new(0, 2)
	trail.Size = seq(1.5, 0)
	trail.LightEmission = 1
	trail.Color = ColorSequence.new(gold, Color3.fromRGB(255, 140, 60))
	trail.Parent = core

	local from = pos + Vector3.new(-90, 220, -60)
	local start = os.clock()
	local fall = 1.1
	Fx.sound("whoosh", 0.5, 0.6)
	local landed = false
	local conn: RBXScriptConnection
	conn = RunService.RenderStepped:Connect(function()
		if currentStar ~= model or not model.Parent then
			conn:Disconnect()
			return
		end
		local age = os.clock() - start
		if age > life + fall then
			conn:Disconnect()
			Fx.clearStar()
			return
		end
		local c: Vector3
		if age < fall then
			local k = age / fall
			c = from:Lerp(pos + Vector3.new(0, 4, 0), k * k)
			beam.Transparency = 1
		else
			if not landed then
				landed = true
				Fx.ring(pos, gold, 4, 60, 0.7)
				Fx.burst(pos + Vector3.new(0, 3, 0), gold, 40, 40, 2)
				Fx.sound("pop", 0.6, 0.7)
			end
			c = pos + Vector3.new(0, 4 + math.sin(age * 3) * 0.8, 0)
			beam.Transparency = 0.55 + math.sin(age * 4) * 0.1
			beam.CFrame = CFrame.new(pos + Vector3.new(0, 60, 0)) * FLAT
		end
		core.CFrame = CFrame.new(c)
		local spin = CFrame.Angles(0, age * 2, 0)
		for i, p in ipairs(points) do
			p.CFrame = CFrame.new(c) * spin * CFrame.Angles(0, 0, (i - 1) * math.pi * 2 / 5) * CFrame.new(0, 2.2, 0)
		end
	end)
end

function Fx.starGot(pos: Vector3)
	Fx.clearStar()
	local gold = Color3.fromRGB(255, 225, 90)
	Fx.ring(pos, gold, 6, 140, 0.9)
	Fx.pillar(pos, gold, 200, 14, 0.8)
	Fx.burst(pos + Vector3.new(0, 4, 0), gold, 60, 60, 3)
	Fx.sound("slash", 0.6, 1.4)
end

------------------------------------------------------------------------
-- 시작
------------------------------------------------------------------------
function Fx.start()
	for _, player in ipairs(Players:GetPlayers()) do
		watchPlayer(player)
	end
	Players.PlayerAdded:Connect(watchPlayer)
	task.spawn(function()
		local objects = workspace:WaitForChild("Objects")
		for _, m in ipairs(objects:GetChildren()) do
			watchObject(m)
		end
		objects.ChildAdded:Connect(watchObject)
		-- 처음 물체들이 다 내려오기 전에는 뿅 연출을 하지 않는다
		task.delay(4, function()
			readyAt = os.clock()
		end)
	end)
	RunService.RenderStepped:Connect(function()
		local t = os.clock()
		for char, h in pairs(holes) do
			if not char.Parent then
				destroyHole(h)
				holes[char] = nil
			else
				updateHole(h, t)
			end
		end
	end)
end

return Fx
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
  <Item class="Workspace" referent="13">
    <Properties>
      <string name="Name">Workspace</string>
      <float name="Gravity">196.2</float>
      <bool name="NeedsPivotMigration">false</bool>
      <bool name="StreamingEnabled">false</bool>
    </Properties>
  </Item>
</roblox>
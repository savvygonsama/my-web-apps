builders.satellite = function(P, s, _r)
	local y = 1.4 * s
	P("Body", BLOCK, Vector3.new(0.9, 0.9, 1.2) * s, CFrame.new(0, y, 0), C(230, 200, 90), M.Foil)
	for _, x in ipairs({ -1, 1 }) do
		P("Panel", BLOCK, Vector3.new(1.6, 0.05, 0.8) * s, CFrame.new(x * 1.3 * s, y, 0), C(40, 60, 140), M.Glass)
		P("Arm", BLOCK, Vector3.new(0.5, 0.06, 0.06) * s, CFrame.new(x * 0.6 * s, y, 0), C(200, 200, 210), M.Metal)
	end
	P("Dish", CYL, Vector3.new(0.1 * s, 0.9 * s, 0.9 * s), CFrame.new(0, y + 0.7 * s, 0) * UP, C(240, 240, 245), M.Metal)
	P("Blink", BALL, Vector3.new(0.15, 0.15, 0.15) * s, CFrame.new(0, y - 0.5 * s, -0.6 * s), C(255, 60, 60), M.Neon)
end

builders.asteroid = function(P, s, r)
	local col = C(110, 100, 95):Lerp(C(140, 110, 90), r())
	P("Rock", BALL, Vector3.new(2.0, 1.6, 1.8) * s, CFrame.new(0, 1.0 * s, 0), col, M.Slate)
	for i = 0, 4 do
		local a = i / 5 * math.pi * 2
		P("Lump", BALL, Vector3.new(0.9, 0.8, 0.9) * s, CFrame.new(math.cos(a) * 0.8 * s, (1.0 + math.sin(a * 1.7) * 0.4) * s, math.sin(a) * 0.7 * s), col:Lerp(C(0, 0, 0), 0.15), M.Slate)
	end
	P("Crater", CYL, Vector3.new(0.05 * s, 0.6 * s, 0.6 * s), CFrame.new(0, 1.0 * s, -0.88 * s) * CFrame.Angles(0, math.rad(90), 0), C(70, 65, 60), M.Slate)
end

builders.moon = function(P, s, _r)
	P("Moon", BALL, Vector3.new(2, 2, 2) * s, CFrame.new(0, 1.0 * s, 0), C(215, 215, 210), M.Slate)
	for i = 0, 6 do
		local a = i * 1.7
		local dir = Vector3.new(math.cos(a), math.sin(i * 0.9) * 0.7, math.sin(a)).Unit
		local pos = Vector3.new(0, 1.0 * s, 0) + dir * 0.98 * s
		P("Crater", CYL, Vector3.new(0.05 * s, (0.3 + (i % 3) * 0.12) * s, (0.3 + (i % 3) * 0.12) * s), CFrame.lookAt(pos, pos + dir) * CFrame.Angles(0, math.rad(90), 0), C(170, 170, 165), M.Slate)
	end
end

builders.planet = function(P, s, r)
	local col = hsv(r(), 0.55, 0.85)
	P("Planet", BALL, Vector3.new(2, 2, 2) * s, CFrame.new(0, 1.0 * s, 0), col, M.SmoothPlastic)
	for i = 0, 2 do
		P("Band", CYL, Vector3.new(0.2 * s, 2.02 * s, 2.02 * s), CFrame.new(0, (0.6 + i * 0.4) * s, 0) * UP, col:Lerp(C(255, 255, 255), 0.25 + i * 0.1), M.SmoothPlastic).Transparency = 0.2
	end
	if r() < 0.6 then
		P("Ring", CYL, Vector3.new(0.06 * s, 3.4 * s, 3.4 * s), CFrame.new(0, 1.0 * s, 0) * CFrame.Angles(math.rad(15), 0, math.rad(90)), C(230, 210, 170), M.Glass).Transparency = 0.25
	end
end

builders.sun = function(P, s, _r)
	local core = P("Sun", BALL, Vector3.new(2, 2, 2) * s, CFrame.new(0, 1.0 * s, 0), C(255, 190, 60), M.Neon)
	P("Corona", BALL, Vector3.new(2.3, 2.3, 2.3) * s, CFrame.new(0, 1.0 * s, 0), C(255, 120, 40), M.ForceField).Transparency = 0.3
	local light = Instance.new("PointLight")
	light.Range = 60
	light.Brightness = 3
	light.Color = C(255, 200, 120)
	light.Parent = core
	local pe = Instance.new("ParticleEmitter")
	pe.Rate = 20
	pe.Lifetime = NumberRange.new(1, 2)
	pe.Speed = NumberRange.new(0.1 * s, 0.2 * s)
	pe.SpreadAngle = Vector2.new(180, 180)
	pe.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.2 * s), NumberSequenceKeypoint.new(1, 0) })
	pe.LightEmission = 1
	pe.Color = ColorSequence.new(C(255, 230, 120), C(255, 100, 40))
	pe.Parent = core
end

------------------------------------------------------------------------
-- 만들기
------------------------------------------------------------------------
-- 물체 하나를 만든다. base = 바닥 기준 위치와 방향, seed = 같은 자리에는 같은 색이 나오게
function Props.build(kind: string, size: number, base: CFrame, seed: number): Model
	local model = Instance.new("Model")
	model.Name = kind
	local state = (seed % 2147483646) + 1
	local function rand(): number
		state = (state * 16807) % 2147483647
		return state / 2147483647
	end
	local first: Part? = nil
	local function P(name: string, shape: Enum.PartType?, sz: Vector3, cf: CFrame, color: Color3, material: Enum.Material): Part
		local p = Instance.new("Part")
		p.Name = name
		if shape and shape ~= BLOCK then
			p.Shape = shape
		end
		p.Anchored = true
		p.CanTouch = false
		p.TopSurface = Enum.SurfaceType.Smooth
		p.BottomSurface = Enum.SurfaceType.Smooth
		p.Size = Vector3.new(math.max(sz.X, 0.05), math.max(sz.Y, 0.05), math.max(sz.Z, 0.05))
		p.CFrame = base * cf
		p.Color = color
		p.Material = material
		p.Parent = model
		if not first then
			first = p
		end
		return p
	end
	local fn = builders[kind] or builders.pebble
	fn(P, size, rand)
	if first then
		model.PrimaryPart = first
	end
	local _ = WEDGE
	return model
end

function Props.has(kind: string): boolean
	return builders[kind] ~= nil
end

return Props
]]></string>
      </Properties>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="4">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Script" referent="5">
      <Properties>
        <string name="Name">HoleServer</string>
        <token name="RunContext">0</token>
        <string name="Source"><![CDATA[-- HoleServer (Script, ServerScriptService)
-- 삼키기 판정, 질량, 업그레이드, 빅뱅, 저장. 중요한 계산은 모두 서버가 한다.
--   World  조명, 구역, 문, 물체 배치

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerStorage = game:GetService("ServerStorage")
local DataStoreService = game:GetService("DataStoreService")
local RunService = game:GetService("RunService")

local Config = require(ReplicatedStorage:WaitForChild("Config"))
local World = require(script:WaitForChild("World"))

local DATASTORE_NAME = "BlackHole_v1"
local SAVE_INTERVAL = 90
local TICK = 0.1

------------------------------------------------------------------------
-- 통신 채널
------------------------------------------------------------------------
local remoteFolder = Instance.new("Folder")
remoteFolder.Name = "HoleRemotes"
local Request = Instance.new("RemoteEvent")
Request.Name = "Request"
Request.Parent = remoteFolder
local Push = Instance.new("RemoteEvent")
Push.Name = "Push"
Push.Parent = remoteFolder
remoteFolder.Parent = ReplicatedStorage

------------------------------------------------------------------------
-- 맵
------------------------------------------------------------------------
World.setupLighting()
World.buildZones()
local objects, objectFolder = World.placeObjects()
local holding = Instance.new("Folder")
holding.Name = "EatenObjects"
holding.Parent = ServerStorage

-- 구역별로 나눠 둔다 (가까운 구역만 살펴보면 된다)
local byZone: { [number]: { World.ObjectRec } } = {}
for _, rec in ipairs(objects) do
	byZone[rec.zone] = byZone[rec.zone] or {}
	table.insert(byZone[rec.zone], rec)
end

------------------------------------------------------------------------
-- 저장
------------------------------------------------------------------------
local store: DataStore? = nil
do
	local ok, ds = pcall(function()
		return DataStoreService:GetDataStore(DATASTORE_NAME)
	end)
	if ok then
		store = ds
	end
end

type Profile = {
	mass: number,
	total: number, -- 지금까지 삼킨 질량 (빅뱅해도 남는다)
	eaten: number, -- 삼킨 물체 수
	size: number,
	pull: number,
	mult: number,
	bigbang: number,
}

local function defaultProfile(): Profile
	return { mass = 0, total = 0, eaten = 0, size = 0, pull = 0, mult = 0, bigbang = 0 }
end

local function sanitize(data: any): Profile
	local p = defaultProfile()
	if type(data) ~= "table" then
		return p
	end
	local function num(v: any, hi: number): number
		if type(v) ~= "number" or v ~= v then
			return 0
		end
		return math.clamp(v, 0, hi)
	end
	p.mass = num(data.mass, math.huge)
	p.total = num(data.total, math.huge)
	p.eaten = math.floor(num(data.eaten, math.huge))
	p.size = math.floor(num(data.size, Config.UPGRADE_BY_ID.size.maxLevel))
	p.pull = math.floor(num(data.pull, Config.UPGRADE_BY_ID.pull.maxLevel))
	p.mult = math.floor(num(data.mult, Config.UPGRADE_BY_ID.mult.maxLevel))
	p.bigbang = math.floor(num(data.bigbang, 1000))
	return p
end

local function isTester(player: Player): boolean
	if not Config.TEST_MODE then
		return false
	end
	if RunService:IsStudio() then
		return true
	end
	return game.CreatorType == Enum.CreatorType.User and player.UserId == game.CreatorId
end

type State = {
	canSave: boolean,
	dirty: boolean,
	tester: boolean,
	reqWindow: number,
	reqCount: number,
	zone: number,
}

local profiles: { [Player]: Profile } = {}
local states: { [Player]: State } = {}

local function loadProfile(player: Player): (Profile, boolean)
	local ds = store
	if not ds then
		return defaultProfile(), false
	end
	for attempt = 1, 3 do
		local ok, result = pcall(function()
			return ds:GetAsync("p_" .. player.UserId)
		end)
		if ok then
			return sanitize(result), true
		end
		warn("[BlackHole] 불러오기 실패 (" .. attempt .. "/3):", result)
		task.wait(1.5 * attempt)
	end
	-- 불러오기에 실패했을 때 저장하면 기존 기록을 덮어쓰므로 저장을 끈다
	return defaultProfile(), false
end

local function saveProfile(player: Player)
	local p, st, ds = profiles[player], states[player], store
	if not (p and st and ds and st.canSave) then
		return
	end
	local ok, err = pcall(function()
		ds:SetAsync("p_" .. player.UserId, p)
	end)
	if ok then
		st.dirty = false
	else
		warn("[BlackHole] 저장 실패:", err)
	end
end

------------------------------------------------------------------------
-- 상태 보내기와 캐릭터 꾸미기
------------------------------------------------------------------------
local function radiusOf(p: Profile): number
	return Config.radius(p.size)
end

local function pushState(player: Player)
	local p, st = profiles[player], states[player]
	if not p or not st then
		return
	end
	local r = radiusOf(p)
	Push:FireClient(player, "state", {
		mass = p.mass,
		total = p.total,
		eaten = p.eaten,
		size = p.size,
		pull = p.pull,
		mult = p.mult,
		bigbang = p.bigbang,
		radius = r,
		pullRange = Config.pullRange(r, p.pull),
		massMult = Config.massMult(p.mult, p.bigbang),
		tester = st.tester,
		canSave = st.canSave,
	})
end

local function updateLeaderstats(player: Player)
	local p = profiles[player]
	local ls = player:FindFirstChild("leaderstats")
	if not p or not ls then
		return
	end
	local massValue = ls:FindFirstChild("질량")
	local sizeValue = ls:FindFirstChild("크기")
	if massValue and massValue:IsA("StringValue") then
		massValue.Value = Config.formatNumber(p.total)
	end
	if sizeValue and sizeValue:IsA("StringValue") then
		sizeValue.Value = Config.formatSize(radiusOf(p))
	end
end

-- 캐릭터는 보이지 않게 하고, 블랙홀 모양은 모든 화면이 직접 그린다 (크기와 색만 속성으로 알려 준다)
local function applyHole(player: Player)
	local p = profiles[player]
	local char = player.Character
	if not p or not char then
		return
	end
	local r = radiusOf(p)
	char:SetAttribute("HoleR", r)
	char:SetAttribute("HoleSkin", math.clamp(p.bigbang + 1, 1, #Config.BIGBANG_SKINS))
	local hum = char:FindFirstChildOfClass("Humanoid")
	if hum then
		hum.WalkSpeed = Config.walkSpeed(r)
		hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
	end
	local head = char:FindFirstChild("Head")
	if head and head:IsA("BasePart") then
		local tag = head:FindFirstChild("HoleTag")
		if not tag then
			local gui = Instance.new("BillboardGui")
			gui.Name = "HoleTag"
			gui.Size = UDim2.new(0, 220, 0, 44)
			gui.AlwaysOnTop = true
			gui.LightInfluence = 0
			gui.MaxDistance = 2000
			local l = Instance.new("TextLabel")
			l.Name = "Label"
			l.Size = UDim2.fromScale(1, 1)
			l.BackgroundTransparency = 1
			l.Font = Enum.Font.GothamBlack
			l.TextScaled = true
			l.TextColor3 = Color3.new(1, 1, 1)
			l.TextStrokeTransparency = 0.3
			l.Parent = gui
			gui.Parent = head
			tag = gui
		end
		local gui = tag :: BillboardGui
		gui.StudsOffset = Vector3.new(0, 4 + r * 0.25, 0)
		local label = gui:FindFirstChild("Label")
		if label and label:IsA("TextLabel") then
			label.Text = string.format("%s · ⚫%s", player.DisplayName, Config.formatSize(r))
			label.TextColor3 = Config.skin(p.bigbang).b
		end
	end
	updateLeaderstats(player)
end

local function hideBody(char: Model)
	for _, d in ipairs(char:GetDescendants()) do
		if d:IsA("BasePart") then
			d.Transparency = 1
			d.CastShadow = false
		elseif d:IsA("Decal") then
			d.Transparency = 1
		end
	end
end

local function toast(player: Player, text: string)
	Push:FireClient(player, "toast", text)
end

------------------------------------------------------------------------
-- 삼키기
------------------------------------------------------------------------
local function respawn(rec: World.ObjectRec)
	rec.model:SetAttribute("EatenBy", nil)
	for part, can in pairs(rec.collide) do
		part.CanCollide = can
	end
	rec.model.Parent = objectFolder
	rec.alive = true
end

local function eat(player: Player, rec: World.ObjectRec)
	rec.alive = false
	rec.model:SetAttribute("EatenBy", player.UserId)
	for part in pairs(rec.collide) do
		part.CanCollide = false
	end
	-- 빨려 들어가는 모습은 화면마다 그리고, 잠시 뒤 서버에서 치운다
	task.delay(0.6, function()
		if not rec.alive then
			rec.model.Parent = holding
		end
	end)
	local wait = Config.Zones[rec.zone].respawn * (0.8 + math.random() * 0.5)
	task.delay(wait, function()
		if not rec.alive then
			respawn(rec)
		end
	end)
end

local function flatDist(a: Vector3, b: Vector3): number
	local dx, dz = a.X - b.X, a.Z - b.Z
	return math.sqrt(dx * dx + dz * dz)
end

local function tickPlayer(player: Player, p: Profile, st: State)
	local char = player.Character
	local root = char and char:FindFirstChild("HumanoidRootPart")
	if not root or not root:IsA("BasePart") then
		return
	end
	local pos = root.Position
	local r = radiusOf(p)
	local reach = r + Config.pullRange(r, p.pull)
	local zone = Config.zoneAt(pos.Z)
	if zone ~= st.zone then
		st.zone = zone
		Push:FireClient(player, "zone", zone)
	end
	local mult = Config.massMult(p.mult, p.bigbang)
	local reachable = Config.maxZone(r)
	local eatenList = {}
	local gained = 0
	for zi = math.max(1, zone - 1), math.min(#Config.Zones, zone + 1) do
		for _, rec in ipairs(byZone[zi] or {}) do
			if rec.alive and rec.zone <= reachable and rec.def.size <= r and flatDist(rec.pos, pos) <= reach + rec.def.size * 0.5 then
				eat(player, rec)
				local m = rec.def.mass * mult
				gained += m
				table.insert(eatenList, { pos = rec.pos, mass = m, size = rec.def.size, name = rec.def.name })
				if #eatenList >= 40 then
					break
				end
			end
		end
	end
	if #eatenList > 0 then
		p.mass += gained
		p.total += gained
		p.eaten += #eatenList
		st.dirty = true
		Push:FireClient(player, "eat", { list = eatenList, gained = gained, mass = p.mass })
		updateLeaderstats(player)
	end
end

task.spawn(function()
	while true do
		task.wait(TICK)
		for player, p in pairs(profiles) do
			local st = states[player]
			if st then
				local ok, err = pcall(tickPlayer, player, p, st)
				if not ok then
					warn("[BlackHole] 삼키기 오류:", err)
				end
			end
		end
	end
end)

------------------------------------------------------------------------
-- 업그레이드, 빅뱅, 이동
------------------------------------------------------------------------
local function buyUpgrade(player: Player, id: any, many: any): number
	local p = profiles[player]
	local u = type(id) == "string" and Config.UPGRADE_BY_ID[id]
	if not u then
		return 0
	end
	local bought = 0
	local limit = many == true and 200 or 1
	while bought < limit do
		local level = (p :: any)[u.id] :: number
		if level >= u.maxLevel then
			break
		end
		local cost = Config.upgradeCost(u.id, level)
		if p.mass < cost then
			break
		end
		p.mass -= cost;
		(p :: any)[u.id] = level + 1
		bought += 1
	end
	if bought == 0 then
		local level = (p :: any)[u.id] :: number
		if level >= u.maxLevel then
			toast(player, u.name .. "은(는) 이미 최대예요")
		else
			toast(player, "질량이 부족해요 (필요 💠" .. Config.formatNumber(Config.upgradeCost(u.id, level)) .. ")")
		end
		return 0
	end
	states[player].dirty = true
	applyHole(player)
	Push:FireClient(player, "upgraded", { id = u.id, count = bought, level = (p :: any)[u.id] })
	pushState(player)
	return bought
end

local function bigbang(player: Player)
	local p = profiles[player]
	if p.size < Config.BIGBANG_LEVEL then
		toast(player, string.format("크기 레벨 %d(⚫%s) 이상이어야 빅뱅할 수 있어요", Config.BIGBANG_LEVEL, Config.formatSize(Config.radius(Config.BIGBANG_LEVEL))))
		return
	end
	p.bigbang += 1
	p.mass = 0
	p.size = 0
	p.pull = 0
	p.mult = 0
	states[player].dirty = true
	local char = player.Character
	if char then
		char:PivotTo(CFrame.new(0, 4, 22))
	end
	applyHole(player)
	Push:FireClient(player, "bigbang", { count = p.bigbang, skin = Config.skin(p.bigbang).name })
	pushState(player)
end

local function teleport(player: Player, zoneArg: any)
	local p = profiles[player]
	local zi = math.floor(tonumber(zoneArg) or 0)
	if zi < 1 or zi > #Config.Zones then
		return
	end
	if zi > Config.maxZone(radiusOf(p)) then
		toast(player, string.format("크기 %d 이상이어야 갈 수 있어요", Config.Zones[zi].need))
		return
	end
	local char = player.Character
	if char then
		local z = Config.zoneStart(zi) + 20 + radiusOf(p)
		char:PivotTo(CFrame.new(0, 5, math.min(z, Config.zoneStart(zi) + Config.Zones[zi].length / 2)))
	end
end

------------------------------------------------------------------------
-- 요청 처리
------------------------------------------------------------------------
Request.OnServerEvent:Connect(function(player: Player, action: any, arg: any, arg2: any)
	local p, st = profiles[player], states[player]
	if not p or not st or type(action) ~= "string" then
		return
	end
	local now = os.clock()
	if now - st.reqWindow > 1 then
		st.reqWindow = now
		st.reqCount = 0
	end
	st.reqCount += 1
	if st.reqCount > 30 then
		return
	end
	if action == "upgrade" then
		buyUpgrade(player, arg, arg2)
	elseif action == "bigbang" then
		bigbang(player)
	elseif action == "teleport" then
		teleport(player, arg)
	elseif action == "hello" then
		pushState(player)
		if st.tester then
			toast(player, "🧪 테스트 계정이에요. 테스트 창에서 질량을 받을 수 있고, 기록은 저장하지 않아요")
		elseif not st.canSave then
			toast(player, "저장이 꺼져 있어요. 이번 기록은 저장되지 않아요")
		end
	elseif action == "testMass" and st.tester then
		local amount = math.clamp(tonumber(arg) or 0, 0, 1e30)
		p.mass += amount
		p.total += amount
		pushState(player)
		updateLeaderstats(player)
	elseif action == "testSize" and st.tester then
		p.size = math.clamp(math.floor(tonumber(arg) or 0), 0, Config.UPGRADE_BY_ID.size.maxLevel)
		applyHole(player)
		pushState(player)
	elseif action == "testMaxAll" and st.tester then
		p.size = Config.UPGRADE_BY_ID.size.maxLevel
		p.pull = Config.UPGRADE_BY_ID.pull.maxLevel
		p.mult = Config.UPGRADE_BY_ID.mult.maxLevel
		applyHole(player)
		pushState(player)
	elseif action == "testReset" and st.tester then
		local keep = p.bigbang
		profiles[player] = defaultProfile()
		profiles[player].bigbang = keep
		applyHole(player)
		pushState(player)
	end
end)

------------------------------------------------------------------------
-- 입장과 퇴장
------------------------------------------------------------------------
local function onCharacterAdded(player: Player, char: Model)
	task.spawn(function()
		char:WaitForChild("HumanoidRootPart", 10)
		task.wait(0.2)
		if player.Character ~= char then
			return
		end
		hideBody(char)
		char.DescendantAdded:Connect(function(d)
			-- 늦게 붙는 장신구도 숨긴다
			if d:IsA("BasePart") then
				d.Transparency = 1
			elseif d:IsA("Decal") then
				d.Transparency = 1
			end
		end)
		applyHole(player)
	end)
end

local function onPlayerAdded(player: Player)
	local st: State = { canSave = false, dirty = false, tester = false, reqWindow = 0, reqCount = 0, zone = 1 }
	states[player] = st
	local ls = Instance.new("Folder")
	ls.Name = "leaderstats"
	local massValue = Instance.new("StringValue")
	massValue.Name = "질량"
	massValue.Value = "0"
	massValue.Parent = ls
	local sizeValue = Instance.new("StringValue")
	sizeValue.Name = "크기"
	sizeValue.Value = Config.formatSize(Config.radius(0))
	sizeValue.Parent = ls
	ls.Parent = player

	local profile, ok
	if isTester(player) then
		profile, ok = defaultProfile(), false
		st.tester = true
	else
		profile, ok = loadProfile(player)
	end
	if not player.Parent then
		return
	end
	profiles[player] = profile
	st.canSave = ok
	player.CharacterAdded:Connect(function(char)
		onCharacterAdded(player, char)
	end)
	if player.Character then
		onCharacterAdded(player, player.Character)
	end
	pushState(player)
	updateLeaderstats(player)
end

local function onPlayerRemoving(player: Player)
	saveProfile(player)
	profiles[player] = nil
	states[player] = nil
end

Players.PlayerAdded:Connect(onPlayerAdded)
Players.PlayerRemoving:Connect(onPlayerRemoving)
for _, player in ipairs(Players:GetPlayers()) do
	task.spawn(onPlayerAdded, player)
end

task.spawn(function()
	while true do
		task.wait(SAVE_INTERVAL)
		for player, st in pairs(states) do
			if st.dirty then
				task.spawn(saveProfile, player)
			end
		end
	end
end)

game:BindToClose(function()
	local pending = 0
	for player in pairs(profiles) do
		pending += 1
		task.spawn(function()
			saveProfile(player)
			pending -= 1
		end)
	end
	local waited = 0
	while pending > 0 and waited < 25 do
		task.wait(0.5)
		waited += 0.5
	end
end)
]]></string>
      </Properties>
      <Item class="ModuleScript" referent="6">
        <Properties>
          <string name="Name">World</string>
          <string name="Source"><![CDATA[-- World (ModuleScript, HoleServer 아래)
-- 조명, 구역 6개의 바닥과 벽, 구역 사이 문, 물체 배치.
-- 구역은 시작 지점(z = 0)에서 +z 쪽으로 차례로 이어진다.
-- 문은 모두에게 막혀 있고, 크기가 충분한 사람의 화면에서만 통과된다 (캐릭터 물리는 각자 화면이 맡는다).

local Lighting = game:GetService("Lighting")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage:WaitForChild("Config"))
local Props = require(ReplicatedStorage:WaitForChild("Props"))

local World = {}

local function part(props: { [string]: any }): Part
	local p = Instance.new("Part")
	p.Anchored = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	for k, v in pairs(props) do
		if k ~= "Parent" then
			(p :: any)[k] = v
		end
	end
	p.Parent = props.Parent
	return p
end

local function signText(target: BasePart, face: Enum.NormalId, lines: { { any } })
	local gui = Instance.new("SurfaceGui")
	gui.Face = face
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 8
	gui.LightInfluence = 0
	gui.Parent = target
	local y = 0
	for _, line in ipairs(lines) do
		local l = Instance.new("TextLabel")
		l.BackgroundTransparency = 1
		l.Position = UDim2.fromScale(0, y)
		l.Size = UDim2.fromScale(1, line[3])
		l.Font = Enum.Font.GothamBlack
		l.TextScaled = true
		l.TextColor3 = line[2]
		l.TextStrokeTransparency = 0.3
		l.Text = line[1]
		l.Parent = gui
		y += line[3]
	end
end

function World.setupLighting()
	Lighting.ClockTime = 15.5
	Lighting.Brightness = 2.2
	Lighting.Ambient = Color3.fromRGB(110, 110, 130)
	Lighting.OutdoorAmbient = Color3.fromRGB(140, 140, 160)
	Lighting.EnvironmentDiffuseScale = 0.6
	Lighting.EnvironmentSpecularScale = 0.6
	local bloom = Lighting:FindFirstChildOfClass("BloomEffect") or Instance.new("BloomEffect")
	bloom.Intensity = 0.5
	bloom.Size = 30
	bloom.Threshold = 1.2
	bloom.Parent = Lighting
	local cc = Lighting:FindFirstChildOfClass("ColorCorrectionEffect") or Instance.new("ColorCorrectionEffect")
	cc.Saturation = 0.15
	cc.Contrast = 0.08
	cc.Parent = Lighting
	local atmo = Lighting:FindFirstChildOfClass("Atmosphere") or Instance.new("Atmosphere")
	atmo.Density = 0.25
	atmo.Haze = 1
	atmo.Color = Color3.fromRGB(200, 210, 240)
	atmo.Decay = Color3.fromRGB(120, 110, 160)
	atmo.Parent = Lighting
end

-- 구역 바닥, 옆 벽, 구역 사이 문
function World.buildZones(): { BasePart }
	local folder = Instance.new("Folder")
	folder.Name = "Zones"
	folder.Parent = workspace
	local old = workspace:FindFirstChild("Baseplate")
	if old then
		old:Destroy()
	end
	local gates: { BasePart } = {}
	for i, zone in ipairs(Config.Zones) do
		local z0 = Config.zoneStart(i)
		local center = Vector3.new(0, 0, z0 + zone.length / 2)
		part({
			Name = "Ground" .. i,
			Size = Vector3.new(zone.width, 4, zone.length),
			Position = center - Vector3.new(0, 2, 0),
			Color = zone.ground,
			Material = zone.material,
			Parent = folder,
		})
		-- 구역 테두리 길
		for _, x in ipairs({ -1, 1 }) do
			part({
				Name = "Edge",
				Size = Vector3.new(6, 0.2, zone.length),
				Position = center + Vector3.new(x * (zone.width / 2 - 3), 0.1, 0),
				Color = zone.ground:Lerp(Color3.new(1, 1, 1), 0.35),
				Material = Enum.Material.Concrete,
				CanCollide = false,
				Parent = folder,
			})
			-- 보이지 않는 옆 벽
			part({
				Name = "SideWall",
				Size = Vector3.new(4, 600, zone.length),
				Position = center + Vector3.new(x * (zone.width / 2 + 2), 300, 0),
				Transparency = 1,
				Parent = folder,
			})
		end
		-- 구역별 꾸밈
		if i == 3 or i == 4 then
			-- 도로: 가운데 길과 흰 선
			part({ Name = "Road", Size = Vector3.new(zone.width * 0.18, 0.15, zone.length), Position = center + Vector3.new(0, 0.08, 0), Color = Color3.fromRGB(45, 45, 50), Material = Enum.Material.Asphalt, CanCollide = false, Parent = folder })
			for k = 0, 9 do
				part({ Name = "Line", Size = Vector3.new(1.2, 0.16, zone.length / 20), Position = Vector3.new(0, 0.1, z0 + zone.length * (k + 0.5) / 10), Color = Color3.fromRGB(240, 230, 120), Material = Enum.Material.Neon, CanCollide = false, Parent = folder })
			end
		elseif i == 5 then
			-- 바다 웅덩이
			for k = 0, 5 do
				local a = k * 1.3
				part({
					Name = "Water",
					Shape = Enum.PartType.Cylinder,
					Size = Vector3.new(0.3, zone.width * 0.18, zone.width * 0.18),
					CFrame = CFrame.new(center + Vector3.new(math.cos(a) * zone.width * 0.3, 0.12, math.sin(a) * zone.length * 0.3)) * CFrame.Angles(0, 0, math.rad(90)),
					Color = Color3.fromRGB(50, 120, 200),
					Material = Enum.Material.Glass,
					Transparency = 0.15,
					CanCollide = false,
					Parent = folder,
				})
			end
		elseif i == 6 then
			-- 우주: 빛나는 격자와 별
			for k = -6, 6 do
				part({ Name = "Grid", Size = Vector3.new(1.5, 0.12, zone.length), Position = center + Vector3.new(k * zone.width / 13, 0.06, 0), Color = Color3.fromRGB(110, 80, 255), Material = Enum.Material.Neon, Transparency = 0.5, CanCollide = false, Parent = folder })
			end
			local sky = part({ Name = "Stars", Size = Vector3.new(zone.width, 10, zone.length), Position = center + Vector3.new(0, 260, 0), Transparency = 1, CanCollide = false, CanQuery = false, Parent = folder })
			local pe = Instance.new("ParticleEmitter")
			pe.Rate = 120
			pe.Lifetime = NumberRange.new(4, 8)
			pe.Speed = NumberRange.new(0, 1)
			pe.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(0.5, 2), NumberSequenceKeypoint.new(1, 0) })
			pe.LightEmission = 1
			pe.Color = ColorSequence.new(Color3.fromRGB(200, 210, 255), Color3.fromRGB(255, 220, 255))
			pe.Parent = sky
		end

		-- 다음 구역으로 가는 문 (마지막 구역은 끝 벽)
		local nextZone = Config.Zones[i + 1]
		local zEnd = z0 + zone.length
		if nextZone then
			local width = math.max(zone.width, nextZone.width)
			local height = 60 + nextZone.need * 2.5
			local gate = part({
				Name = "Gate",
				Size = Vector3.new(width, height, 3),
				Position = Vector3.new(0, height / 2, zEnd),
				Color = Color3.fromRGB(150, 90, 255),
				Material = Enum.Material.ForceField,
				Transparency = 0.2,
				Parent = folder,
			})
			gate:SetAttribute("Need", nextZone.need)
			gate:SetAttribute("Zone", i + 1)
			table.insert(gates, gate)
			-- 문 앞 안내판
			local board = part({
				Name = "GateSign",
				Size = Vector3.new(60, 22, 1),
				Position = Vector3.new(0, 26, zEnd - 3),
				Color = Color3.fromRGB(30, 20, 50),
				Material = Enum.Material.Slate,
				CanCollide = false,
				Parent = folder,
			})
			signText(board, Enum.NormalId.Back, {
				{ string.format("%d구역 · %s", i + 1, nextZone.name), Color3.fromRGB(230, 210, 255), 0.45 },
				{ string.format("크기 %d 이상이면 통과", nextZone.need), Color3.fromRGB(255, 220, 120), 0.45 },
			})
		else
			part({ Name = "EndWall", Size = Vector3.new(zone.width, 600, 4), Position = Vector3.new(0, 300, zEnd + 2), Transparency = 1, Parent = folder })
		end
	end
	-- 시작 쪽 벽
	part({ Name = "StartWall", Size = Vector3.new(Config.Zones[1].width, 600, 4), Position = Vector3.new(0, 300, -2), Transparency = 1, Parent = folder })

	-- 시작 지점
	local spawn = Instance.new("SpawnLocation")
	spawn.Name = "HoleSpawn"
	spawn.Anchored = true
	spawn.Size = Vector3.new(16, 1, 16)
	spawn.Position = Vector3.new(0, 0.5, 22)
	spawn.Neutral = true
	spawn.Duration = 0
	spawn.Color = Color3.fromRGB(120, 70, 220)
	spawn.Material = Enum.Material.Neon
	spawn.Transparency = 0.3
	spawn.CanCollide = false
	spawn.Parent = folder
	local decal = spawn:FindFirstChildOfClass("Decal")
	if decal then
		decal:Destroy()
	end
	local title = part({ Name = "TitleSign", Size = Vector3.new(50, 14, 1), Position = Vector3.new(0, 14, 6), Color = Color3.fromRGB(20, 12, 40), Material = Enum.Material.Slate, CanCollide = false, Parent = folder })
	signText(title, Enum.NormalId.Back, {
		{ "🕳 " .. Config.GAME_TITLE, Color3.fromRGB(210, 170, 255), 0.6 },
		{ "작은 것부터 삼키고 커져라!", Color3.fromRGB(255, 255, 255), 0.4 },
	})
	return gates
end

export type ObjectRec = {
	model: Model,
	def: any,
	zone: number,
	pos: Vector3,
	alive: boolean,
	collide: { [BasePart]: boolean },
}

-- 물체 배치. 같은 서버에서는 늘 같은 자리
function World.placeObjects(): ({ ObjectRec }, Folder)
	local folder = Instance.new("Folder")
	folder.Name = "Objects"
	folder.Parent = workspace
	local rng = Random.new(20261015)
	local list: { ObjectRec } = {}
	for zi, zone in ipairs(Config.Zones) do
		local z0 = Config.zoneStart(zi)
		local placed: { { pos: Vector3, r: number } } = {}
		-- 큰 것부터 자리를 잡아야 빈자리가 남는다
		local defs = {}
		for _, def in ipairs(Config.Objects) do
			if def.zone == zi then
				table.insert(defs, def)
			end
		end
		table.sort(defs, function(a, b)
			return a.size > b.size
		end)
		for _, def in ipairs(defs) do
			for n = 1, def.count do
				local margin = def.size * 1.3 + 6
				local pos: Vector3? = nil
				for _ = 1, 40 do
					local x = rng:NextNumber(-zone.width / 2 + margin, zone.width / 2 - margin)
					local z = rng:NextNumber(z0 + margin, z0 + zone.length - margin)
					local p = Vector3.new(x, 0, z)
					local ok = true
					-- 시작 지점 근처는 비워 둔다
					if zi == 1 and (p - Vector3.new(0, 0, 22)).Magnitude < 22 then
						ok = false
					end
					for _, other in ipairs(placed) do
						if (other.pos - p).Magnitude < (other.r + def.size) * 1.05 then
							ok = false
							break
						end
					end
					if ok then
						pos = p
						break
					end
				end
				if pos then
					local base = CFrame.new(pos) * CFrame.Angles(0, rng:NextNumber(0, math.pi * 2), 0)
					local model = Props.build(def.id, def.size, base, zi * 100000 + n * 131 + #list)
					model.Name = def.id
					model:SetAttribute("Size", def.size)
					model:SetAttribute("Mass", def.mass)
					model:SetAttribute("Label", def.name)
					local collide = {}
					for _, d in ipairs(model:GetDescendants()) do
						if d:IsA("BasePart") then
							-- 작은 건 걸리적거리지 않게
							d.CanCollide = def.size >= 2.5
							collide[d] = d.CanCollide
						end
					end
					model.Parent = folder
					table.insert(placed, { pos = pos, r = def.size })
					table.insert(list, { model = model, def = def, zone = zi, pos = pos, alive = true, collide = collide })
				end
			end
		end
	end
	return list, folder
end

return World
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="StarterPlayer" referent="7">
    <Properties>
      <string name="Name">StarterPlayer</string>

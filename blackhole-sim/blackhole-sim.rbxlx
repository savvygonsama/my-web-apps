			"• 이동: WASD 또는 화면 조이스틱 · 스킬: Q 또는 오른쪽 아래 둥근 버튼",
			"• 단축키: B 빅뱅 · M 세계 · P 위성 · G 상점 · K 스킨 · E 로비 기계 쓰기",
			"• 어딘가에 끼면 왼쪽 🆘 끼었어요 버튼 (또는 로블록스 메뉴의 다시 시작)",
			"",
			"<b>🏠 로비</b>",
			"• 처음엔 로비에서 시작해요. 왼쪽 메뉴 🏠 로비 버튼이나 세계 시작 지점 왼쪽 문으로 돌아와요",
			"• 북쪽 캡슐 기계에서 위성을 뽑고, 남쪽 스킨 전시관에서 스킨 12종과 능력을 구경해요",
			"• 🎁 매일 보상 상자 (연속으로 받을수록 많이), 💎 상점 가판대, 🏆 서버 순위판",
			"• 서쪽 문 → 세계 1, 동쪽 문 → 세계 2",
			"",
			"<b>커지기</b>",
			"• <b>먹을수록 커져요!</b> 내 크기에 가까운 큰 걸 삼킬수록 확 커져요 (괄호 안 숫자가 필요한 크기)",
			"• 클수록 덜 자라서, 뒤쪽 구역은 오래 놀아야 커져요. 최대 크기는 빅뱅할수록 늘어나요",
			"• 삼키면 💠질량도 쌓여요. 질량으로 오른쪽 업그레이드 9종을 사요 (내려서 더 보기)",
			"• ⚫ 성장력 · 💠 질량 배율 · 👟 이동 속도 · 📏 크기 한계 · ♻ 빠른 재생 · ☄ 별똥별 자석 · 🔥 콤보 증폭 · ✨ 황금 탐지",
			"• 흡입력은 없어요. 물체 위를 정확히 지나가야 삼켜요. 높은 레벨일수록 업그레이드가 가파르게 비싸져요",
			"• 🤖 자동 업그레이드를 켜면 알아서 사요",
			"",
			"<b>보너스</b>",
			string.format("• 🔥 연속 흡수: %.1f초 안에 계속 삼키면 한 번마다 질량 +1%% (최대 +100%%)", Config.COMBO_WINDOW),
			string.format("• ✨ 황금 물체: 가끔 금빛으로 나타나요. 질량 %d배, 성장 %.1f배", Config.GOLDEN_MASS, Config.GOLDEN_GROW),
			string.format("• ☄ 별똥별: 삼키면 %d초 동안 질량과 성장 2배", Config.STAR_BOOST),
			"• 📋 퀘스트: 늘 3개. 끝내면 바로 질량이나 🌑 암흑 물질을 받아요",
			"• 🌍 떠도는 거대 행성: 5분마다 사람이 많은 구역에 나타나요. 닿아 있으면 깎이고, 깎은 몫만큼 보상 (질량·크기·암흑 물질)",
			"",
			"<b>🎨 스킨 능력</b>",
			"• ✦ 패시브: 늘 켜져 있어요 (흡입·성장·질량·황금·별똥별 보너스)",
			"• ⚡ 액티브: Q로 써요. 카메라가 보는 쪽으로 나가요",
			"  퀘이사 빔(빛줄기) · 적색 팽창(더 큰 것도) · 빙결 순간이동 · 은하 소용돌이 · 프리즘 분신 · 신의 시선",
			"• 등급(일반→희귀→영웅→전설→신화→비밀)이 높을수록 능력이 세고 모양이 화려해요",
			"",
			"<b>🛰 위성</b>",
			"• 로비 캡슐 기계에서 위성을 뽑아요. 블랙홀 둘레를 돌며 질량 배율을 올려 줘요",
			string.format("• 같은 위성 %d개를 합치면 ✨황금 위성 (효과 %.1f배)", Config.GOLD_COUNT, Config.GOLD_POWER),
			"",
			"<b>🌌 빅뱅 (환생)</b>",
			string.format("• 한 판: 세계 1에서 크기 %d → 세계 2로 넘어가며 크기 ÷%d → 세계 2에서 크기 %d이면 빅뱅", Config.WORLD2_RADIUS, Config.WORLD2_SCALE, Config.BIGBANG_RADIUS),
			"• 빅뱅하면 세계 1부터 다시 시작하는 대신 영구 배율이 오르고 🌑암흑 물질을 받아요",
			"• 빅뱅할 때마다 최대 크기 +300, 성장 +10%",
			"• 🌑 빅뱅 상점: 시작 크기, 빠른 재생산, 질량, 속도, 흡입, 행운, 위성 칸, 질량 보존, 암흑 수확",
			"• 첫 빅뱅을 하면 🍭 세계 2가 열려요. 세계 1보다 훨씬 넓고 구역이 8개예요",
			"",
			"<b>🗺 구역</b> (색 벽은 크기가 되면 통과돼요)",
			table.concat(objLines, "\n"),
			"",
			"💾 기록은 자동으로 저장돼요",
		}, "\n"),
		Parent = scroll,
	})
end

------------------------------------------------------------------------
-- 🧪 테스트 (테스트 계정에서만)
------------------------------------------------------------------------
do
	local page = makePage("test")
	new("UIListLayout", { Padding = UDim.new(0, 8), Parent = page })
	text({ Size = UDim2.new(1, 0, 0, 44), TextSize = 15, TextColor3 = C.dim, Text = "스튜디오나 게임 주인으로 들어오면 테스트 계정이에요. 기록은 저장하지 않아요. 상점 번호가 0인 상품은 눌러서 무료로 시험할 수 있어요.", Parent = page })
	local row1 = hlist(page, 44)
	for _, amount in ipairs({ 1e3, 1e6, 1e9, 1e12, 1e15 }) do
		button({ Size = UDim2.new(0.2, -5, 1, 0), Text = "💠 +" .. fmt(amount), TextSize = 15, Parent = row1 }, function()
			Request:FireServer("testMass", amount)
		end)
	end
	local row2 = hlist(page, 44)
	for _, r in ipairs({ 1.5, 6, 14, 30, 65, 140, 350, 600, 800, 1000 }) do
		button({ Size = UDim2.new(0.1, -5, 1, 0), Text = "⚫" .. tostring(r), TextSize = 12, BackgroundColor3 = C.blue, Parent = row2 }, function()
			Request:FireServer("testSize", r)
		end)
	end
	local row3 = hlist(page, 44)
	for _, item in ipairs({
		{ "⭐ 업그레이드 최대", "testMaxAll", C.pink },
		{ "🌑 암흑 물질 +50", "testDM", Color3.fromRGB(110, 60, 180) },
		{ "🌌 빅뱅 +1", "testBigbang", Color3.fromRGB(200, 70, 150) },
		{ "🍭 세계 2 준비", "testAdvance", Color3.fromRGB(230, 90, 170) },
		{ "🌍 거대 행성", "testEvent", Color3.fromRGB(230, 150, 60) },
		{ "☄ 별똥별 지금", "testStar", Color3.fromRGB(220, 160, 40) },
	}) do
		button({ Size = UDim2.new(1 / 6, -5, 1, 0), Text = item[1], TextSize = 12, BackgroundColor3 = item[3], Parent = row3 }, function()
			Request:FireServer(item[2])
		end)
	end
	local row4 = hlist(page, 44)
	button({ Size = UDim2.new(0.33, -4, 1, 0), Text = "⚡ 스킬 대기 없애기", TextSize = 14, BackgroundColor3 = C.gold, TextColor3 = C.bg, Parent = row4 }, function()
		Request:FireServer("testSkill")
	end)
	button({ Size = UDim2.new(0.33, -4, 1, 0), Text = "🎁 매일 보상 다시", TextSize = 14, BackgroundColor3 = Color3.fromRGB(40, 170, 140), Parent = row4 }, function()
		Request:FireServer("testDaily")
	end)
	button({ Size = UDim2.new(0.33, -4, 1, 0), Text = "↺ 처음으로", TextSize = 15, BackgroundColor3 = C.red, Parent = row4 }, function()
		Request:FireServer("testReset")
	end)
end

------------------------------------------------------------------------
-- 캡슐 깨기 연출: 흔들리다 번쩍, 위성이 나타난다
------------------------------------------------------------------------
local playHatch
do
	local overlay = new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(0, 0, 0), BackgroundTransparency = 0.35, Visible = false, ZIndex = 50, Active = true, Parent = gui })
	local holder = new("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.new(0, 720, 0, 360), BackgroundTransparency = 1, Parent = overlay })
	scaled(holder)
	local busy = false
	function playHatch(capId: string, results: { string })
		local cap = Config.CAPSULE_BY_ID[capId]
		if not cap or busy then
			return
		end
		busy = true
		clear(holder)
		overlay.Visible = true
		-- 1) 흔들리는 캡슐
		local egg = new("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.new(0, 170, 0, 210), BackgroundColor3 = Color3.new(1, 1, 1), Parent = holder }, {
			corner(85),
			new("UIGradient", { Color = ColorSequence.new(cap.color:Lerp(Color3.new(1, 1, 1), 0.5), cap.color), Rotation = 90 }),
			new("UIStroke", { Color = Color3.new(1, 1, 1), Thickness = 4 }),
		})
		text({ Size = UDim2.fromScale(1, 1), TextSize = 60, TextXAlignment = Enum.TextXAlignment.Center, Text = "?", Font = Enum.Font.GothamBlack, Parent = egg })
		Fx.sound("whoosh", 0.4, 1.4)
		for i = 1, 8 do
			egg.Rotation = (i % 2 == 0 and 1 or -1) * (6 + i * 2)
			task.wait(0.09)
		end
		egg.Rotation = 0
		-- 2) 번쩍
		local flash = new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(1, 1, 1), ZIndex = 60, Parent = overlay })
		TweenService:Create(flash, TweenInfo.new(0.5), { BackgroundTransparency = 1 }):Play()
		egg:Destroy()
		Fx.sound("slash", 0.6, 1.2)
		-- 3) 결과
		local row = new("Frame", { Size = UDim2.new(1, 0, 0, 300), BackgroundTransparency = 1, Parent = holder }, {
			new("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, HorizontalAlignment = Enum.HorizontalAlignment.Center, Padding = UDim.new(0, 14) }),
		})
		local bestRarity = 1
		for _, id in ipairs(results) do
			local def = Config.SAT_BY_ID[id]
			if def then
				bestRarity = math.max(bestRarity, def.rarity)
				local col = rarityColor(def.rarity)
				local card = new("Frame", { Size = UDim2.new(0, 210, 0, 290), BackgroundColor3 = Color3.new(1, 1, 1), Parent = row }, { corner(16), new("UIStroke", { Color = col, Thickness = 4 }), grad(col:Lerp(C.bg, 0.4), C.bg) })
				local sc = new("UIScale", { Scale = 0.3, Parent = card })
				TweenService:Create(sc, TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 }):Play()
				satView(card, def, false, UDim2.new(1, -20, 0, 170), UDim2.new(0, 10, 0, 6))
				text({ Position = UDim2.new(0, 0, 0, 178), Size = UDim2.new(1, 0, 0, 34), TextSize = 22, Font = Enum.Font.GothamBlack, TextXAlignment = Enum.TextXAlignment.Center, Text = def.name, Parent = card })
				text({ Position = UDim2.new(0, 0, 0, 212), Size = UDim2.new(1, 0, 0, 30), TextSize = 20, Font = Enum.Font.GothamBlack, TextXAlignment = Enum.TextXAlignment.Center, TextColor3 = col, Text = Config.Rarities[def.rarity].name, Parent = card })
				text({ Position = UDim2.new(0, 0, 0, 244), Size = UDim2.new(1, 0, 0, 30), TextSize = 20, Font = Enum.Font.GothamBlack, TextXAlignment = Enum.TextXAlignment.Center, TextColor3 = C.gold, Text = "질량 ×" .. tostring(def.mult), Parent = card })
			end
		end
		if bestRarity >= 4 then
			Fx.sound("whoosh", 0.8, 0.5)
			local c = player.Character and Fx.holeCenter(player.Character)
			if c then
				Fx.pillar(c, rarityColor(bestRarity), 200, 16, 1)
			end
		end
		task.wait(0.6)
		flash:Destroy()
		local closeBtn = button({ AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 312), Size = UDim2.new(0, 200, 0, 44), Text = "좋아요!", TextSize = 20, BackgroundColor3 = C.green, Parent = holder }, function()
			overlay.Visible = false
			busy = false
		end)
		task.delay(4, function()
			if closeBtn.Parent and overlay.Visible then
				overlay.Visible = false
				busy = false
			end
		end)
	end
end

------------------------------------------------------------------------
-- 갱신
------------------------------------------------------------------------
local function boostText(): (string, boolean)
	if not state then
		return "", false
	end
	local passed = os.clock() - stateAt
	local list = {}
	local ended = false
	local function add(left: number, label: string)
		if left > 0 then
			local now = left - passed
			if now > 0 then
				table.insert(list, label .. " " .. Config.formatTime(now))
			else
				ended = true
			end
		end
	end
	add(state.starLeft, "⭐ 별똥별 2배")
	add(state.boostLeft, "🔥 질량 2배")
	add(state.respawnLeft, "♻ 빠른 재생산")
	return table.concat(list, "   "), ended
end

local function refreshAll()
	if not state then
		return
	end
	HUD.mass.Text = "💠 " .. fmt(state.mass)
	HUD.stat.Text = string.format(
		"%s ⚫ %s/%s   🌱 ×%s   ✖ %s%s%s",
		state.tier == 2 and "🍭" or "🌍",
		Config.formatSize(state.radius),
		Config.formatSize(state.maxRadius),
		string.format("%.2f", state.growMult or 1),
		fmt(state.totalMult),
		state.bigbang > 0 and string.format("   🌌 %d", state.bigbang) or "",
		state.dm > 0 and string.format("   🌑 %d", state.dm) or ""
	)
	autoButton.Text = state.auto and "🤖 자동 업그레이드: 켬" or "🤖 자동 업그레이드: 끔"
	autoButton.BackgroundColor3 = state.auto and C.green or C.panel2
	for _, u in ipairs(Config.Upgrades) do
		local card = cards[u.id]
		local level = state.up[u.id] or 0
		local maxed = level >= u.maxLevel
		card.level.Text = maxed and "MAX" or string.format("Lv.%d / %d", level, u.maxLevel)
		card.effect.Text = u.desc .. "\n" .. u.show(level) .. (maxed and "" or ("  →  " .. u.show(level + 1)))
		local cost = Config.upgradeCost(u.id, level)
		local can = not maxed and state.mass >= cost
		card.buy.Text = maxed and "최대" or ("💠 " .. fmt(cost))
		card.buy.BackgroundColor3 = can and C.accent or C.panel2
		card.max.BackgroundColor3 = can and C.pink or C.panel2
	end
	-- 다음 구역 진행 막대 (지금 세계 기준)
	local r = state.radius
	local nextZone = nil
	local prevNeed = 0
	for _, zi in ipairs(Config.zonesOf(currentWorld)) do
		local zone = Config.Zones[zi]
		if zone.need > r then
			nextZone = nextZone or zone
		else
			prevNeed = zone.need
		end
	end
	if state.inLobby then
		Bar.fill.Size = UDim2.fromScale(1, 1)
		Bar.label.Text = "🏠 로비 · 캡슐은 북쪽, 세계 1은 서쪽, 세계 2는 동쪽 문"
	elseif state.canAdvance then
		Bar.fill.Size = UDim2.fromScale(1, 1)
		Bar.label.Text = string.format("🍭 세계 2로 넘어갈 수 있어요! (크기 ÷%d, 위 버튼)", Config.WORLD2_SCALE)
	elseif state.tier == 1 and not nextZone then
		local ratio = math.clamp((r - prevNeed) / math.max(Config.WORLD2_RADIUS - prevNeed, 0.01), 0, 1)
		Bar.fill.Size = UDim2.fromScale(ratio, 1)
		Bar.label.Text = string.format("세계 2까지  ⚫ %s / %d", Config.formatSize(r), Config.WORLD2_RADIUS)
	elseif nextZone then
		local ratio = math.clamp((r - prevNeed) / math.max(nextZone.need - prevNeed, 0.01), 0, 1)
		Bar.fill.Size = UDim2.fromScale(ratio, 1)
		Bar.label.Text = string.format("다음 구역 '%s'까지  ⚫ %s / %d", nextZone.name, Config.formatSize(r), nextZone.need)
	elseif state.radius >= Config.BIGBANG_RADIUS then
		local ratio = math.clamp(state.radius / state.maxRadius, 0, 1)
		Bar.fill.Size = UDim2.fromScale(ratio, 1)
		Bar.label.Text = string.format("🌌 빅뱅할 수 있어요! (B)   최대 크기까지 ⚫ %s / %s", Config.formatSize(state.radius), Config.formatSize(state.maxRadius))
	else
		local ratio = math.clamp(state.radius / Config.BIGBANG_RADIUS, 0, 1)
		Bar.fill.Size = UDim2.fromScale(ratio, 1)
		Bar.label.Text = string.format("모든 구역이 열렸어요! 빅뱅까지 ⚫ %s / %d", Config.formatSize(state.radius), Config.BIGBANG_RADIUS)
	end
	advanceButton.Visible = state.canAdvance == true and not state.inLobby
	menuButtons.test.Visible = state.tester == true
	menuButtons.bbshop.Visible = state.bigbang > 0 or state.dm > 0
	if window.Visible then
		local f = refreshers[currentPage]
		if f then
			f()
		end
	end
end

------------------------------------------------------------------------
-- 카메라와 문: 크기에 맞춰 멀리서 보고, 크기가 되는 문은 통과한다
------------------------------------------------------------------------
local function applyRadius(r: number)
	-- 로비에서는 블랙홀을 작게 보여 주니 카메라도 가깝게
	local cr = (state and state.inLobby) and math.min(r, 8) or r
	player.CameraMaxZoomDistance = math.max(60, 40 + cr * 6)
	player.CameraMinZoomDistance = math.min(10 + cr * 1.6, player.CameraMaxZoomDistance - 5)
	local zones = workspace:FindFirstChild("Zones")
	if not zones then
		return
	end
	for _, g in ipairs(zones:GetChildren()) do
		if g.Name == "Gate" and g:IsA("BasePart") then
			local need = g:GetAttribute("Need")
			local open = type(need) == "number" and r >= need
			g.CanCollide = not open
			if open then
				g.Color = Color3.fromRGB(90, 230, 150)
			end
			g.Transparency = open and 0.6 or 0.2
		end
	end
end

-- 세계마다 하늘 빛깔
local function applyWorld(w: number)
	currentWorld = w
	local atmo = Lighting:FindFirstChildOfClass("Atmosphere")
	if atmo then
		local col = w == 2 and Color3.fromRGB(255, 200, 235) or Color3.fromRGB(200, 210, 240)
		local decay = w == 2 and Color3.fromRGB(200, 120, 190) or Color3.fromRGB(120, 110, 160)
		TweenService:Create(atmo, TweenInfo.new(1.2), { Color = col, Decay = decay }):Play()
	end
end

------------------------------------------------------------------------
-- 너무 큰 물체: 빨간 테두리와 필요한 크기
------------------------------------------------------------------------
do
	local highlight = new("Highlight", {
		FillTransparency = 1,
		OutlineColor = Color3.fromRGB(255, 70, 90),
		OutlineTransparency = 0.1,
		DepthMode = Enum.HighlightDepthMode.Occluded,
		Enabled = false,
		Parent = workspace,
	})
	task.spawn(function()
		local objects = workspace:WaitForChild("Objects")
		while true do
			task.wait(0.25)
			local char = player.Character
			local root = char and char:FindFirstChild("HumanoidRootPart")
			if state and root and root:IsA("BasePart") then
				local r = state.radius
				local reach = r + state.pullRange + 6
				local best: Model? = nil
				local bestDist = math.huge
				local bestSize = 0
				local p = root.Position
				for _, m in ipairs(objects:GetChildren()) do
					local size = m:GetAttribute("Size")
					if type(size) == "number" and size > r and not m:GetAttribute("EatenBy") and m:IsA("Model") then
						local pivot = m:GetPivot().Position
						local d = Vector3.new(pivot.X - p.X, 0, pivot.Z - p.Z).Magnitude - size
						if d < reach and d < bestDist then
							best, bestDist, bestSize = m, d, size
						end
					end
				end
				if best then
					highlight.Adornee = best
					highlight.Enabled = true
					local label = best:GetAttribute("Label")
					Bar.hint.Text = string.format("🔒 %s: 크기 %s 필요", type(label) == "string" and label or "?", Config.formatSize(bestSize))
				else
					highlight.Enabled = false
					Bar.hint.Text = ""
				end
			end
		end
	end)
end

------------------------------------------------------------------------
-- 연속 흡수: 1.5초 안에 계속 삼키면 숫자가 커진다
------------------------------------------------------------------------
local addCombo
do
	local label = text({
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 128),
		Size = UDim2.new(0, 400, 0, 40),
		TextXAlignment = Enum.TextXAlignment.Center,
		TextSize = 30,
		Font = Enum.Font.GothamBlack,
		TextColor3 = C.pink,
		TextStrokeTransparency = 0.2,
		Visible = false,
		Parent = gui,
	})
	local sc = new("UIScale", { Parent = label })
	local last = 0
	-- combo = 서버가 센 연속 흡수 수, bonus = 질량 보너스 비율
	function addCombo(combo: number, bonus: number)
		last = os.clock()
		if combo >= 5 then
			label.Visible = true
			label.Text = string.format("🔥 연속 흡수 x%d  (질량 +%d%%)", combo, math.floor(bonus * 100 + 0.5))
			label.TextColor3 = combo >= 50 and C.gold or (combo >= 20 and Color3.fromRGB(255, 150, 80) or C.pink)
			sc.Scale = uiScale * (1.25 + math.min(combo, 100) * 0.004)
			TweenService:Create(sc, TweenInfo.new(0.15, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = uiScale }):Play()
		end
	end
	RunService.Heartbeat:Connect(function()
		if label.Visible and os.clock() - last > Config.COMBO_WINDOW then
			label.Visible = false
		end
	end)
end

-- 타격감: 화면 번쩍임과 카메라 흔들림
local Feel = {} :: any
do
	local flash = new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(1, 1, 1), BackgroundTransparency = 1, ZIndex = 45, Active = false, Parent = gui })
	function Feel.flash(color: Color3, strength: number)
		flash.BackgroundColor3 = color
		flash.BackgroundTransparency = 1 - math.clamp(strength, 0, 0.6)
		TweenService:Create(flash, TweenInfo.new(0.25), { BackgroundTransparency = 1 }):Play()
	end
	local shakeAmp = 0
	local shaking = false
	function Feel.shake(amount: number)
		shakeAmp = math.max(shakeAmp, amount)
	end
	-- 흔들 때만 카메라를 건드린다
	RunService.RenderStepped:Connect(function(dt: number)
		if shakeAmp <= 0.01 and not shaking then
			return
		end
		local char = player.Character
		local hum = char and char:FindFirstChildOfClass("Humanoid")
		if not hum then
			return
		end
		if shakeAmp > 0.01 then
			shaking = true
			hum.CameraOffset = Vector3.new((math.random() - 0.5) * 2, (math.random() - 0.5) * 2, (math.random() - 0.5) * 2) * shakeAmp
			shakeAmp *= math.exp(-dt * 12)
		else
			shaking = false
			shakeAmp = 0
			hum.CameraOffset = Vector3.zero
		end
	end)
end

-- 스킬: 카메라가 바라보는 쪽으로
local function fireSkill()
	local cam = workspace.CurrentCamera
	local look = cam and cam.CFrame.LookVector or Vector3.new(0, 0, 1)
	Request:FireServer("skill", look.X, look.Z)
end

-- 스킬 버튼 (오른쪽 아래, Q): 액티브 능력이 있는 스킨이면 누르고, 패시브면 설명만
local Skill = {} :: any
do
	local frame = new("Frame", {
		AnchorPoint = Vector2.new(1, 1),
		Position = UDim2.new(1, -310, 1, -60),
		Size = UDim2.new(0, 120, 0, 120),
		BackgroundTransparency = 1,
		Parent = gui,
	})
	scaled(frame)
	Skill.button = button({ Size = UDim2.new(0, 100, 0, 100), Position = UDim2.new(0.5, -50, 0, 0), Text = "Q", TextSize = 30, BackgroundColor3 = C.accent, Parent = frame }, function()
		fireSkill()
	end)
	new("UICorner", { CornerRadius = UDim.new(0.5, 0), Parent = Skill.button })
	Skill.stroke = new("UIStroke", { Color = C.gold, Thickness = 3, Parent = Skill.button })
	Skill.cover = new("Frame", { AnchorPoint = Vector2.new(0, 1), Position = UDim2.new(0, 0, 1, 0), Size = UDim2.fromScale(1, 0), BackgroundColor3 = Color3.new(0, 0, 0), BackgroundTransparency = 0.45, Parent = Skill.button }, { new("UICorner", { CornerRadius = UDim.new(0.5, 0) }) })
	Skill.label = text({ AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 102), Size = UDim2.new(0, 220, 0, 20), TextSize = 14, Font = Enum.Font.GothamBlack, TextXAlignment = Enum.TextXAlignment.Center, TextStrokeTransparency = 0.3, Parent = frame })
end

-- 퀘스트 (왼쪽 위)
local questLabels: { TextLabel } = {}
do
	local box = new("Frame", { Position = UDim2.new(0, 10, 0, 10), Size = UDim2.new(0, 300, 0, 112), BackgroundColor3 = C.bg, BackgroundTransparency = 0.25, Parent = gui }, { corner(12), stroke(C.line, 1.5) })
	scaled(box)
	text({ Position = UDim2.new(0, 10, 0, 4), Size = UDim2.new(1, -20, 0, 22), TextSize = 16, Font = Enum.Font.GothamBlack, TextColor3 = C.gold, Text = "📋 퀘스트", Parent = box })
	for k = 1, 3 do
		questLabels[k] = text({ Position = UDim2.new(0, 10, 0, 4 + k * 26), Size = UDim2.new(1, -20, 0, 24), TextSize = 13, RichText = true, Parent = box })
	end
end

local function refreshQuests()
	if not state then
		return
	end
	for k = 1, 3 do
		local q = state.quests[k]
		local l = questLabels[k]
		if q then
			local def = Config.QUEST_BY_KIND[q.kind]
			local t = string.format(def.text, fmt(q.goal))
			local reward = def.reward == "dm" and "🌑" or "💠"
			l.Text = string.format('%s %s  <font color="#FFD25A">%s/%s</font>', reward, t, fmt(math.min(q.progress, q.goal)), fmt(q.goal))
		else
			l.Text = ""
		end
	end
end

local function refreshSkill()
	if not state then
		return
	end
	local skin = Config.SKIN_BY_ID[state.skin]
	local ab = skin and skin.ability
	if not ab then
		Skill.button.Visible = false
		Skill.label.Text = ""
		return
	end
	Skill.button.Visible = true
	local passed = os.clock() - stateAt
	if ab.kind == "active" then
		local cdLeft = math.max(0, (state.cdLeft or 0) - passed)
		local activeLeft = math.max(0, (state.activeLeft or 0) - passed)
		Skill.button.Text = activeLeft > 0 and string.format("%.0f", activeLeft) or (cdLeft > 0 and string.format("%d", math.ceil(cdLeft)) or "Q")
		Skill.button.BackgroundColor3 = activeLeft > 0 and C.green or (cdLeft > 0 and C.panel2 or skin.a)
		Skill.cover.Size = UDim2.fromScale(1, math.clamp(cdLeft / ab.cd, 0, 1))
		Skill.label.Text = "⚡ " .. ab.name
		Skill.stroke.Color = cdLeft > 0 and C.line or C.gold
	else
		Skill.button.Text = "✦"
		Skill.button.BackgroundColor3 = skin.a:Lerp(C.bg, 0.4)
		Skill.cover.Size = UDim2.fromScale(1, 0)
		Skill.label.Text = "✦ " .. ab.name .. " (늘 켜짐)"
		Skill.stroke.Color = C.line
	end
end

-- 큰 글자 배너
local function banner(title: string, sub: string, color: Color3)
	local frame = new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0.5, 0, 0.32, 0),
		Size = UDim2.new(0, 700, 0, 110),
		BackgroundTransparency = 1,
		ZIndex = 15,
		Parent = gui,
	})
	local sc = new("UIScale", { Scale = uiScale * 1.5, Parent = frame })
	local t = text({ Size = UDim2.new(1, 0, 0, 64), TextXAlignment = Enum.TextXAlignment.Center, TextSize = 52, Font = Enum.Font.GothamBlack, TextColor3 = color, TextStrokeTransparency = 0, Text = title, Parent = frame })
	local s = text({ Position = UDim2.new(0, 0, 0, 66), Size = UDim2.new(1, 0, 0, 34), TextXAlignment = Enum.TextXAlignment.Center, TextSize = 24, TextStrokeTransparency = 0.3, Text = sub, Parent = frame })
	TweenService:Create(sc, TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = uiScale }):Play()
	task.delay(2, function()
		TweenService:Create(t, TweenInfo.new(0.4), { TextTransparency = 1, TextStrokeTransparency = 1 }):Play()
		TweenService:Create(s, TweenInfo.new(0.4), { TextTransparency = 1, TextStrokeTransparency = 1 }):Play()
		task.delay(0.45, function()
			frame:Destroy()
		end)
	end)
end

local function myCenter(): Vector3?
	local char = player.Character
	return char and Fx.holeCenter(char) or nil
end

------------------------------------------------------------------------
-- 서버 메시지
------------------------------------------------------------------------
local lastRadius = -1
local handlers: { [string]: (any) -> () } = {}

local lastInLobby = nil
function handlers.state(data: any)
	local grew = state ~= nil and data.radius > lastRadius * 1.05 and not data.inLobby
	state = data
	stateAt = os.clock()
	Fx.updateGallery(data.skins, data.skin)
	refreshQuests()
	refreshSkill()
	if data.inLobby ~= lastInLobby then
		lastInLobby = data.inLobby
		lastRadius = -1
	end
	if data.radius ~= lastRadius then
		lastRadius = data.radius
		applyRadius(data.radius)
	end
	if grew then
		local c = myCenter()
		if c then
			Fx.ring(c, C.accent, data.radius * 1.5, data.radius * 3, 0.5)
		end
	end
	refreshAll()
end

local lastRing = 0
function handlers.eat(data: any)
	if state then
		state.mass = data.mass
		if data.radius and data.radius ~= state.radius then
			state.radius = data.radius
			state.pullRange = data.pullRange
			-- 카메라와 문은 조금씩 커질 때마다 맞춘다. 문이 열리는 크기를 넘었으면 바로
			local crossed = false
			for _, zone in ipairs(Config.Zones) do
				if zone.need > lastRadius and zone.need <= data.radius then
					crossed = true
				end
			end
			if crossed or math.abs(data.radius - lastRadius) > lastRadius * 0.02 then
				lastRadius = data.radius
				applyRadius(data.radius)
			end
			-- 10% 커질 때마다 빛 고리
			if data.radius > lastRing * 1.1 then
				lastRing = data.radius
				local c = myCenter()
				if c then
					Fx.ring(c, C.accent, data.radius * 1.5, data.radius * 3, 0.5)
				end
			end
		end
	end
	-- 타격감: 삼킨 자리에서 빛줄기가 빨려 들고, 블랙홀이 꿀꺽 부풀고, 큰 걸 먹으면 화면이 흔들린다
	local r = state and state.radius or 3
	local c = myCenter()
	local biggest = 0
	local anyGolden = false
	for i, e in ipairs(data.list) do
		biggest = math.max(biggest, e.size)
		if e.golden then
			anyGolden = true
		end
		if i <= 6 or (e.golden and i <= 12) then
			local col = e.golden and C.gold or Color3.fromHSV((os.clock() * 0.3 + i * 0.07) % 1, 0.5, 1)
			Fx.popup(e.pos + Vector3.new(0, e.size * 1.2 + 2, 0), (e.golden and "✨ +" or "+") .. fmt(e.mass), e.golden and C.gold or Color3.fromRGB(210, 170, 255), (e.golden and 28 or 20) + math.min(14, e.size))
			if c then
				Fx.streak(e.pos + Vector3.new(0, e.size * 0.6, 0), c + Vector3.new(0, 0.5, 0), col, math.clamp(e.size * 0.35, 0.3, r * 0.25))
			end
		end
	end
	local ratio = biggest / r
	local char = player.Character
	if char then
		Fx.pulse(char, math.clamp(0.04 + ratio * 0.18, 0.04, 0.25))
	end
	local combo = data.combo or 0
	Fx.sound("pop", 0.25 + ratio * 0.3, 1.3 + math.min(combo, 60) * 0.012 - ratio * 0.6 + math.random() * 0.08)
	if ratio > 0.5 or data.burst then
		Fx.sound("whoosh", 0.5, 0.55)
		Feel.shake(math.clamp(ratio * 0.6, 0.15, 0.9) * (data.burst and 2 or 1))
		if c then
			Fx.burst(c + Vector3.new(0, 1, 0), C.pink, 24, r * 2, math.max(0.4, r * 0.1))
			Fx.ring(c, C.pink, r * 1.2, r * 2.6, 0.4)
		end
		if ratio > 0.75 or data.burst then
			Feel.flash(Color3.fromRGB(255, 230, 255), data.burst and 0.45 or 0.22)
		end
	end
	if anyGolden then
		Fx.sound("slash", 0.6, 1.5)
		Feel.flash(C.gold, 0.25)
		if c then
			Fx.burst(c + Vector3.new(0, 2, 0), C.gold, 40, 20 + r, math.max(0.6, r * 0.12))
		end
	end
	addCombo(combo, data.comboBonus or 0)
	refreshAll()
end

function handlers.toast(data: any)
	toast(data)
end

function handlers.upgraded(data: any)
	if data.quiet then
		return
	end
	Fx.sound("pop", 0.5, 1.9)
	local c = myCenter()
	if c and state then
		Fx.burst(c + Vector3.new(0, 1, 0), C.gold, 25, 10 + state.radius, 0.6)
	end
end

function handlers.zone(data: any)
	local zone = Config.Zones[data]
	if zone then
		if zone.world ~= currentWorld then
			applyWorld(zone.world)
		end
		local n = table.find(Config.zonesOf(zone.world), data) or data
		banner(string.format("%d · %s", n, zone.name), zone.world == 2 and "달콤한 것들이 기다려요" or "더 큰 것들이 기다려요", zone.ground:Lerp(Color3.new(1, 1, 1), 0.4))
		Fx.sound("whoosh", 0.5, 0.8)
		refreshAll()
	end
end

function handlers.world(data: any)
	if data == 0 then
		banner("🏠 로비", "캡슐 뽑기 · 스킨 전시관 · 상점 · 매일 보상", Color3.fromRGB(120, 255, 200))
		Fx.sound("whoosh", 0.8, 0.5)
		return
	end
	local w = Config.Worlds[data]
	if w then
		applyWorld(data)
		banner(string.format("%s 세계 %d", data == 2 and "🍭" or "🌍", data), w.name, w.sky)
		Fx.sound("whoosh", 0.8, 0.5)
		refreshAll()
	end
end

function handlers.bigbang(data: any)
	local c = myCenter()
	if c then
		Fx.pillar(c, Color3.new(1, 1, 1), 400, 30, 1.2)
		for i = 0, 4 do
			task.delay(i * 0.12, function()
				Fx.ring(c, Color3.fromHSV(i / 5, 0.7, 1), 10, 200 + i * 60, 0.9)
			end)
		end
	end
	Fx.sound("whoosh", 1, 0.3)
	local sub = string.format("빅뱅 %d회 · 🌑 암흑 물질 +%d", data.count, data.dm)
	if #data.skins > 0 then
		sub ..= " · 🎨 " .. table.concat(data.skins, ", ")
	end
	banner("🌌 BIG BANG", sub, C.pink)
	applyWorld(1)
end

function handlers.bbBought(data: any)
	local b = Config.BB_BY_ID[data.id]
	Fx.sound("pop", 0.6, 1.2)
	if b then
		toast(string.format("%s %s Lv.%d!", b.icon, b.name, data.level))
	end
end

function handlers.hatched(data: any)
	window.Visible = false
	task.spawn(playHatch, data.capsule, data.results)
end

function handlers.gold(data: any)
	local def = Config.SAT_BY_ID[data.id]
	banner("✨ 황금 위성!", def and def.name or "", C.gold)
	Fx.sound("slash", 0.7, 1.3)
end

function handlers.unlock(data: any)
	if data.kind == "skin" then
		banner("🎨 새 스킨!", data.name, C.pink)
	else
		banner("🐉 " .. data.name, "비밀 위성 3종과 전용 스킨이 들어왔어요!", C.gold)
	end
	Fx.sound("whoosh", 0.8, 0.7)
end

function handlers.star(data: any)
	Fx.star(data.pos, data.life)
	toast("☄ 별똥별이 떨어졌어요! 삼키면 질량 2배")
end

function handlers.starGot(data: any)
	Fx.starGot(data.pos)
	banner("⭐ 질량 2배!", string.format("%d초 동안", math.floor(data.left)), C.gold)
end

-- 로비 기계를 누르면 창이 열린다
function handlers.open(data: any)
	if data.page == "capsule" or data.page == "store" or data.page == "skins" then
		if not (window.Visible and currentPage == data.page) then
			openPage(data.page)
		end
	end
end

function handlers.skill(data: any)
	Feel.flash(Color3.fromRGB(200, 230, 255), 0.2)
	Feel.shake(0.4)
	banner("⚡ " .. data.name, data.dur > 0 and string.format("%d초 동안!", data.dur) or "발동!", C.gold)
end

-- 모든 사람의 스킬 모습 (빛줄기, 순간이동, 신의 시선)
function handlers.skillFx(data: any)
	Fx.skillFx(data)
end

-- 세계 2로 넘어갈 수 있다 / 넘어갔다
function handlers.advanceReady(_data: any)
	banner("🍭 세계 2로 갈 수 있어요!", string.format("화면 위 버튼을 누르면 크기가 ÷%d 되고, 훨씬 큰 질량의 세계에서 다시 자라요", Config.WORLD2_SCALE), Color3.fromRGB(255, 160, 220))
	Fx.sound("slash", 0.7, 1.1)
end

function handlers.advanced(data: any)
	applyWorld(2)
	banner("🍭 세계 2 · 과자 왕국", string.format("⚫ %s → ⚫ %s  ·  다시 작아졌지만 질량은 훨씬 커요", Config.formatSize(data.from), Config.formatSize(data.to)), Color3.fromRGB(255, 160, 220))
	Fx.sound("whoosh", 1, 0.5)
end

-- 떠도는 거대 행성
function handlers.event(data: any)
	if data.kind == "start" then
		local zone = Config.Zones[data.zone]
		banner("🌍 떠도는 거대 행성!", string.format("세계 %d · %s에 나타났어요. 다 같이 먹어요!", data.world, zone and zone.name or "?"), Color3.fromRGB(255, 200, 120))
		Fx.sound("whoosh", 1, 0.35)
	elseif data.kind == "escape" then
		toast("🌍 거대 행성이 멀리 날아가 버렸어요")
	end
end

function handlers.eventReward(data: any)
	banner(data.escaped and "🌍 행성을 놓쳤어요" or string.format("🌍 행성 격파! %d등", data.rank), string.format("깎은 몫 %d%%  ·  💠 +%s  ·  크기 +%.1f%%%s", math.floor(data.share * 100 + 0.5), fmt(data.mass), data.grow * 100, data.dm > 0 and string.format("  ·  🌑 +%d", data.dm) or ""), C.gold)
	Fx.sound("slash", 0.8, 1)
	Feel.flash(C.gold, 0.3)
end

function handlers.quest(data: any)
	banner("📋 퀘스트 완료!", data.text .. "  →  " .. data.reward, Color3.fromRGB(120, 255, 180))
	Fx.sound("slash", 0.6, 1.2)
end

function handlers.daily(data: any)
	banner("🎁 매일 보상!", string.format("연속 %d일 · 🌑 +%d · 💠 +%s", data.streak, data.dm, fmt(data.mass)), C.gold)
	Fx.sound("slash", 0.7, 1.1)
end

Push.OnClientEvent:Connect(function(kind: string, data: any)
	local f = handlers[kind]
	if f then
		f(data)
	end
end)

------------------------------------------------------------------------
-- 👑 VIP 채팅 태그
------------------------------------------------------------------------
pcall(function()
	TextChatService.OnIncomingMessage = function(message: TextChatMessage)
		local props = Instance.new("TextChatMessageProperties")
		local source = message.TextSource
		local who = source and Players:GetPlayerByUserId(source.UserId)
		if who and who:GetAttribute("VIP") then
			props.PrefixText = '<font color="#FFD750">[👑 VIP]</font> ' .. message.PrefixText
		end
		return props
	end
end)

------------------------------------------------------------------------
-- 시작
------------------------------------------------------------------------
Fx.start()
-- 내 블랙홀 캐릭터: 죽지 않게, 발소리 없이, 카메라가 따라가게
local function setupCharacter(char: Model)
	local hum = char:WaitForChild("Humanoid", 10)
	if hum and hum:IsA("Humanoid") then
		for _, st in ipairs({ Enum.HumanoidStateType.Dead, Enum.HumanoidStateType.FallingDown, Enum.HumanoidStateType.Ragdoll, Enum.HumanoidStateType.Climbing, Enum.HumanoidStateType.Seated, Enum.HumanoidStateType.PlatformStanding }) do
			pcall(function()
				hum:SetStateEnabled(st, false)
			end)
		end
		local cam = workspace.CurrentCamera
		if cam then
			cam.CameraSubject = hum
		end
	end
	local root = char:WaitForChild("HumanoidRootPart", 10)
	if root then
		local function mute(d: Instance)
			if d:IsA("Sound") then
				d.Volume = 0
			end
		end
		for _, d in ipairs(root:GetDescendants()) do
			mute(d)
		end
		root.DescendantAdded:Connect(mute)
	end
	task.wait(0.3)
	if state then
		applyRadius(state.radius)
	end
end
if player.Character then
	task.spawn(setupCharacter, player.Character)
end
player.CharacterAdded:Connect(function(c)
	setupCharacter(c :: Model)
end)
UserInputService.InputBegan:Connect(function(input, processed)
	if processed then
		return
	end
	local key = input.KeyCode
	if key == Enum.KeyCode.B then
		openPage("bigbang")
	elseif key == Enum.KeyCode.M then
		openPage("zones")
	elseif key == Enum.KeyCode.P then
		openPage("sats")
	elseif key == Enum.KeyCode.G then
		openPage("store")
	elseif key == Enum.KeyCode.K then
		openPage("skins")
	elseif key == Enum.KeyCode.Q then
		fireSkill()
	end
end)

-- 매 프레임: 부스트 시계, 미리보기 위성 돌리기, 세계 문 소용돌이
do
	local swirls: { BasePart } = {}
	task.spawn(function()
		local zones = workspace:WaitForChild("Zones")
		for _, d in ipairs(zones:GetChildren()) do
			if d:IsA("BasePart") and d:GetAttribute("Spin") then
				table.insert(swirls, d)
			end
		end
	end)
	local swirlBase: { [BasePart]: CFrame } = {}
	local lastBoost = ""
	local skillTick = 0
	local refreshAsked = 0
	RunService.RenderStepped:Connect(function()
		local t = os.clock()
		if skinPreview then
			skinPreview.active = window.Visible and currentPage == "skins"
		end
		if t > skillTick then
			skillTick = t + 0.2
			refreshSkill()
			-- 거대 행성: 거리와 방향 (화면 기준 화살표)
			local active, ppos, frac = Fx.planetInfo()
			local c = myCenter()
			local cam = workspace.CurrentCamera
			if active and c and cam and state and not state.inLobby and math.abs(ppos.X - c.X) < 15000 then
				local d = Vector3.new(ppos.X - c.X, 0, ppos.Z - c.Z)
				local look = Vector3.new(cam.CFrame.LookVector.X, 0, cam.CFrame.LookVector.Z)
				local arrow = "●"
				if d.Magnitude > 1 and look.Magnitude > 0.01 then
					local ang = math.deg(math.atan2(d.Unit:Cross(look.Unit).Y, d.Unit:Dot(look.Unit)))
					local arrows = { "⬆", "↗", "➡", "↘", "⬇", "↙", "⬅", "↖" }
					local idx = math.floor(((-ang) % 360 + 22.5) / 45) % 8 + 1
					arrow = arrows[idx]
				end
				eventLabel.Text = string.format("🌍 떠도는 거대 행성 %d%%  %s %s", math.floor(frac * 100 + 0.5), arrow, fmt(d.Magnitude))
				eventLabel.Visible = true
			else
				eventLabel.Visible = false
			end
		end
		local bt, ended = boostText()
		if bt ~= lastBoost then
			lastBoost = bt
			HUD.boosts.Text = bt
		end
		if ended and t - refreshAsked > 3 then
			refreshAsked = t
			Request:FireServer("refresh")
		end
		if window.Visible or #spinning > 0 then
			for i = #spinning, 1, -1 do
				local s = spinning[i]
				if not s.vf.Parent then
					table.remove(spinning, i)
				elseif s.vf.Visible and s.model.PrimaryPart then
					s.model:PivotTo(CFrame.Angles(0, t * 0.9 + i, 0))
				end
			end
		end
		for _, p in ipairs(swirls) do
			local base = swirlBase[p]
			if not base then
				base = p.CFrame
				swirlBase[p] = base
			end
			p.CFrame = base * CFrame.Angles(t * 2, 0, 0)
		end
	end)
end

-- 로블록스 메뉴의 "다시 시작(Reset)"을 누르면 죽는 대신 끼인 곳에서 빠져나온다
task.spawn(function()
	local resetEvent = Instance.new("BindableEvent")
	resetEvent.Event:Connect(function()
		Request:FireServer("unstuck")
	end)
	for _ = 1, 20 do
		local ok = pcall(function()
			StarterGui:SetCore("ResetButtonCallback", resetEvent)
		end)
		if ok then
			break
		end
		task.wait(1)
	end
end)

Request:FireServer("hello")
]]></string>
        </Properties>
        <Item class="ModuleScript" referent="13">
          <Properties>
            <string name="Name">Fx</string>
            <string name="Source"><![CDATA[-- Fx (ModuleScript, HoleClient 아래)
-- 블랙홀 모양, 빨려 들어가는 연출, 떠오르는 숫자, 효과음.
-- 블랙홀은 서버가 캐릭터에 붙인 크기(HoleR), 스킨(HoleSkin), 위성(Sats)을 보고 각자 화면에서 그린다.
--   검은 구멍 → 어두운 원반 → 빛나는 테두리 → 소용돌이 팔 세 개 → 도는 강착 원반 → 안으로 빨려 드는 빛 알갱이
--   스킨 효과: 불꽃, 얼음 조각, 은하 별빛, 사탕 가루, 황금 반짝임, 신의 눈, 무지개
--   위성은 블랙홀 둘레를 돌며 둥실거린다. 다시 생긴 물체는 뿅 하고 커지며 나타난다.

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local SoundService = game:GetService("SoundService")
local Debris = game:GetService("Debris")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage:WaitForChild("Config"))
local Props = require(ReplicatedStorage:WaitForChild("Props"))
local SatBuilder = require(ReplicatedStorage:WaitForChild("SatBuilder"))

local Fx = {}

local FLAT = CFrame.Angles(0, 0, math.rad(90))
local BLACK = Color3.new(0, 0, 0)

local folder = Instance.new("Folder")
folder.Name = "HoleFX"
folder.Parent = workspace

-- 미리보기(스킨 창, 스킨 전시관)를 만들 때는 잠깐 다른 곳에 붙인다
local buildParent: Instance? = nil

local function fxPart(size: Vector3, color: Color3, material: Enum.Material, shape: Enum.PartType?, transparency: number?): Part
	local p = Instance.new("Part")
	if shape then
		p.Shape = shape
	end
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	p.Size = size
	p.Color = color
	p.Material = material
	p.Transparency = transparency or 0
	p.Parent = buildParent or folder
	return p
end

-- 납작한 원판: 구 메시를 납작하게 늘려서, 파트 한계(2048)보다 큰 블랙홀도 그릴 수 있다
local DISC_MAX = 2000

local function setDisc(p: BasePart, d: number)
	local s = math.clamp(d, 0.05, DISC_MAX)
	p.Size = Vector3.new(s, p.Size.Y, s)
	local mesh = p:FindFirstChild("DiscMesh")
	if mesh and mesh:IsA("SpecialMesh") then
		mesh.Scale = Vector3.new(math.max(d, 0.05) / s, 1, math.max(d, 0.05) / s)
	end
end

local function disc(d: number, thick: number, color: Color3, material: Enum.Material, transparency: number?): Part
	local p = fxPart(Vector3.new(1, thick, 1), color, material, nil, transparency)
	local mesh = Instance.new("SpecialMesh")
	mesh.Name = "DiscMesh"
	mesh.MeshType = Enum.MeshType.Sphere
	mesh.Parent = p
	setDisc(p, d)
	return p
end

------------------------------------------------------------------------
-- 효과음
------------------------------------------------------------------------
local SOUNDS = {
	pop = "rbxasset://sounds/electronicpingshort.wav",
	whoosh = "rbxasset://sounds/swordlunge.wav",
	slash = "rbxasset://sounds/swordslash.wav",
}

function Fx.sound(name: string, volume: number?, pitch: number?)
	local id = SOUNDS[name]
	if not id then
		return
	end
	local s = Instance.new("Sound")
	s.SoundId = id
	s.Volume = volume or 0.4
	s.PlaybackSpeed = pitch or 1
	s.Parent = SoundService
	s:Play()
	Debris:AddItem(s, 3)
end

------------------------------------------------------------------------
-- 블랙홀 모양
------------------------------------------------------------------------
type Hole = {
	char: Model?,
	center: Vector3?, -- 미리보기는 정해진 자리에 있다
	active: boolean,
	radius: number, -- 지금 보이는 반지름 (target 쪽으로 부드럽게 따라간다)
	target: number,
	buildR: number, -- 파트를 만들 때의 반지름
	lastK: number,
	baseD: { number }, -- 원판 4장의 처음 지름
	pulse: number, -- 삼킬 때 잠깐 부푸는 정도
	skillOn: boolean,
	aura: Part,
	skin: number,
	parts: { Part },
	rim: Part,
	disk: Part,
	void: Part,
	core: Part,
	arms: { { part: Part, t: number, arm: number } },
	ring: { { part: Part, a: number, h: number } },
	motes: { { part: Part, phase: number } },
	light: PointLight,
	effect: string?,
	extras: { { part: Part, kind: string, a: number, k: number } },
	sats: { { model: Model, a: number, size: number } },
	satKey: string,
	tier: number,
	clones: { Hole }?, -- 프리즘 분신
	vortex: { Part }?, -- 은하 소용돌이
	puffAt: number, -- 성운 꼬리 다음 시각
}

local holes: { [Model]: Hole } = {}

local destroyHole: (Hole) -> ()
function destroyHole(h: Hole)
	for _, p in ipairs(h.parts) do
		p:Destroy()
	end
	for _, sat in ipairs(h.sats) do
		sat.model:Destroy()
	end
	if h.clones then
		for _, c in ipairs(h.clones) do
			destroyHole(c)
		end
		h.clones = nil
	end
	if h.vortex then
		for _, p in ipairs(h.vortex) do
			p:Destroy()
		end
		h.vortex = nil
	end
end

-- 스킨 효과용 파티클 (블랙홀 위로 뿜어 올린다)
local function emitter(add: (Part) -> Part, r: number, props: { [string]: any }): ParticleEmitter
	local d = r * 2
	local box = add(fxPart(Vector3.new(d * 0.9, 0.2, d * 0.9), BLACK, Enum.Material.SmoothPlastic, nil, 1))
	box.Name = "Emitter"
	local pe = Instance.new("ParticleEmitter")
	pe.LightEmission = 1
	pe.Drag = 1
	for k, v in pairs(props) do
		(pe :: any)[k] = v
	end
	pe.Parent = box
	return pe
end

local function seq(a: number, b: number): NumberSequence
	return NumberSequence.new({ NumberSequenceKeypoint.new(0, a), NumberSequenceKeypoint.new(1, b) })
end

-- 위성 모델들 (Sats 속성: "id:금,id:금")
local function buildSats(h: Hole, attr: string)
	for _, sat in ipairs(h.sats) do
		sat.model:Destroy()
	end
	h.sats = {}
	h.satKey = attr
	local list = string.split(attr, ",")
	local size = math.clamp(h.buildR * 0.16, 0.45, 40)
	for i, entry in ipairs(list) do
		local id, g = string.match(entry, "^([%w_]+):(%d)$")
		local def = id and Config.SAT_BY_ID[id]
		if def then
			local m = SatBuilder.build(def.shape, def.color, size, g == "1")
			m.Parent = folder
			table.insert(h.sats, { model = m, a = (i - 1) / #list * math.pi * 2, size = size })
		end
	end
end

local function buildHole(char: Model?, r: number, skinIndex: number, lite: boolean?): Hole
	local skin = Config.Skins[skinIndex] or Config.Skins[1]
	local effect = skin.effect
	local parts: { Part } = {}
	local function add(p: Part): Part
		table.insert(parts, p)
		return p
	end
	local d = r * 2
	local rim = add(disc(d * 1.14, 0.12, skin.a, Enum.Material.Neon, 0.15))
	local disk = add(disc(d * 1.05, 0.14, skin.a:Lerp(BLACK, 0.82), Enum.Material.SmoothPlastic))
	local void = add(disc(d * 0.9, 0.16, BLACK, Enum.Material.SmoothPlastic))
	local core = add(disc(d * 0.45, 0.18, BLACK, Enum.Material.Neon))
	-- 스킬을 쓰는 동안 바깥에 퍼지는 빛
	local aura = add(disc(d * 1.6, 0.1, skin.b, Enum.Material.Neon, 1))
	local light = Instance.new("PointLight")
	light.Color = skin.a
	light.Range = math.min(60, 6 + r * 1.5)
	light.Brightness = 1.5
	light.Parent = rim

	-- 소용돌이 팔: 테두리에서 가운데로 휘어 들어간다
	local arms = {}
	local segs = lite and 6 or 9
	for arm = 0, 2 do
		for i = 0, segs - 1 do
			local t = i / (segs - 1)
			local color = skin.a:Lerp(skin.b, t)
			local width = math.max(0.15, r * 0.09 * (1 - t * 0.6))
			local p = add(fxPart(Vector3.new(width, 0.08, math.max(0.3, r * 0.28 * (1 - t * 0.5))), color, Enum.Material.Neon, nil, 0.1 + t * 0.6))
			table.insert(arms, { part = p, t = t, arm = arm })
		end
	end
	-- 강착 원반: 테두리 위를 빠르게 도는 빛 덩어리
	local ring = {}
	local n = lite and 12 or 18
	for i = 0, n - 1 do
		local size = math.max(0.25, r * 0.08)
		local col = (i % 2 == 0) and skin.a or skin.b
		if effect == "candy" and i % 2 == 1 then
			col = Color3.new(1, 1, 1)
		end
		local p = add(fxPart(Vector3.new(size * 1.8, size * 0.6, size), col, Enum.Material.Neon, nil, 0.05))
		table.insert(ring, { part = p, a = i / n * math.pi * 2, h = (i % 3) * 0.12 })
	end
	-- 빨려 드는 빛 알갱이
	local motes = {}
	local moteCount = lite and 6 or 12
	for i = 0, moteCount - 1 do
		local p = add(fxPart(Vector3.new(1, 1, 1) * math.max(0.15, r * 0.05), skin.b, Enum.Material.Neon, Enum.PartType.Ball))
		table.insert(motes, { part = p, phase = i / moteCount })
	end

	-- 스킨 효과
	local extras = {}
	local small = math.max(0.2, r * 0.07)
	if effect == "fire" then
		emitter(add, r, {
			Rate = 40,
			Lifetime = NumberRange.new(0.5, 1),
			Speed = NumberRange.new(2 + r * 0.6, 4 + r * 1.2),
			Size = seq(math.max(0.4, r * 0.25), 0),
			Color = ColorSequence.new(Color3.fromRGB(255, 230, 90), Color3.fromRGB(255, 60, 20)),
			Transparency = seq(0.1, 1),
			RotSpeed = NumberRange.new(-90, 90),
		})
		for i = 0, 7 do
			local p = add(fxPart(Vector3.new(small, small * 4, small), skin.b, Enum.Material.Neon, nil, 0.2))
			table.insert(extras, { part = p, kind = "flame", a = i / 8 * math.pi * 2, k = i })
		end
	elseif effect == "ice" then
		emitter(add, r, {
			Rate = 18,
			Lifetime = NumberRange.new(1.2, 2),
			Speed = NumberRange.new(0.5, 2 + r * 0.2),
			Size = seq(math.max(0.15, r * 0.06), 0),
			Color = ColorSequence.new(Color3.new(1, 1, 1), skin.a),
		})
		for i = 0, 9 do
			local p = add(fxPart(Vector3.new(small * 1.3, small * 5, small * 1.3), skin.a:Lerp(Color3.new(1, 1, 1), (i % 2) * 0.5), Enum.Material.Ice, nil, 0.1))
			table.insert(extras, { part = p, kind = "shard", a = i / 10 * math.pi * 2, k = i })
		end
	elseif effect == "galaxy" then
		emitter(add, r, {
			Rate = 30,
			Lifetime = NumberRange.new(1.5, 2.5),
			Speed = NumberRange.new(0.2, 1 + r * 0.1),
			Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(0.5, math.max(0.15, r * 0.05)), NumberSequenceKeypoint.new(1, 0) }),
			Color = ColorSequence.new(Color3.new(1, 1, 1), skin.a),
		})
		local halo = add(disc(d * 1.5, 0.1, skin.a, Enum.Material.Neon, 0.75))
		table.insert(extras, { part = halo, kind = "halo", a = 0, k = 0 })
		for i = 0, 11 do
			local p = add(fxPart(Vector3.new(1, 1, 1) * small * 0.8, i % 3 == 0 and skin.b or Color3.new(1, 1, 1), Enum.Material.Neon, Enum.PartType.Ball))
			table.insert(extras, { part = p, kind = "orbitStar", a = i / 12 * math.pi * 2, k = i })
		end
	elseif effect == "candy" then
		for i = 0, 15 do
			local p = add(fxPart(Vector3.new(small * 2, small * 0.6, small * 0.6), Color3.fromHSV(i / 16, 0.55, 1), Enum.Material.SmoothPlastic))
			table.insert(extras, { part = p, kind = "sprinkle", a = i / 16 * math.pi * 2, k = i })
		end
	elseif effect == "gold" then
		emitter(add, r, {
			Rate = 14,
			Lifetime = NumberRange.new(0.6, 1.2),
			Speed = NumberRange.new(1, 2 + r * 0.3),
			Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(0.3, math.max(0.25, r * 0.08)), NumberSequenceKeypoint.new(1, 0) }),
			Color = ColorSequence.new(Color3.fromRGB(255, 240, 160), Color3.fromRGB(255, 190, 40)),
		})
		for i = 0, 7 do
			local p = add(fxPart(Vector3.new(small * 1.4, small * 1.4, small * 1.4), Color3.fromRGB(255, 220, 90), Enum.Material.Neon))
			table.insert(extras, { part = p, kind = "glint", a = i / 8 * math.pi * 2, k = i })
		end
	elseif effect == "eye" then
		-- 신의 눈: 구멍 자리에 커다란 눈. 흰자, 홍채, 동공이 움직이는 쪽을 보고, 가끔 깜빡인다
		local sclera = add(disc(d * 0.86, 0.17, Color3.fromRGB(255, 250, 240), Enum.Material.SmoothPlastic))
		local iris = add(disc(d * 0.44, 0.18, skin.a, Enum.Material.Neon))
		local irisRing = add(disc(d * 0.5, 0.175, skin.b, Enum.Material.Neon))
		local pupil = add(disc(d * 0.2, 0.19, BLACK, Enum.Material.SmoothPlastic))
		local shine = add(disc(d * 0.07, 0.2, Color3.new(1, 1, 1), Enum.Material.Neon))
		local lid = add(disc(d * 0.9, 0.21, Color3.fromRGB(60, 25, 20), Enum.Material.SmoothPlastic, 1))
		table.insert(extras, { part = sclera, kind = "sclera", a = 0, k = 0 })
		table.insert(extras, { part = irisRing, kind = "iris", a = 0, k = 0 })
		table.insert(extras, { part = iris, kind = "iris", a = 0, k = 0 })
		table.insert(extras, { part = pupil, kind = "pupil", a = 0, k = 0 })
		table.insert(extras, { part = shine, kind = "shine", a = 0, k = 0 })
		table.insert(extras, { part = lid, kind = "lid", a = 0, k = 0 })
		for i = 0, 15 do
			local p = add(fxPart(Vector3.new(small * 0.9, 0.1, r * 0.5), i % 2 == 0 and skin.a or skin.b, Enum.Material.Neon, nil, 0.15))
			table.insert(extras, { part = p, kind = "ray", a = i / 16 * math.pi * 2, k = i })
		end
		-- 둘레를 도는 황금 세모 셋
		for i = 0, 2 do
			local p = add(fxPart(Vector3.new(small * 3, small * 0.6, small * 3), Color3.fromRGB(255, 215, 90), Enum.Material.Neon))
			table.insert(extras, { part = p, kind = "glint", a = i / 3 * math.pi * 2, k = i })
		end
	elseif effect == "quasar" then
		-- 푸른 퀘이사: 위아래로 뿜는 빛 기둥 두 개와 기울어진 원반
		for _, sgn in ipairs({ 1, -1 }) do
			local jet = add(fxPart(Vector3.new(math.min(2000, r * 4), small * 1.6, small * 1.6), skin.b, Enum.Material.Neon, Enum.PartType.Cylinder, 0.2))
			table.insert(extras, { part = jet, kind = "jet", a = sgn, k = 0 })
		end
		local halo = add(disc(d * 1.4, 0.1, skin.a, Enum.Material.Neon, 0.6))
		table.insert(extras, { part = halo, kind = "halo", a = 0, k = 0 })
	elseif effect == "giant" then
		-- 붉은 거성: 숨 쉬듯 부푸는 붉은 코로나와 불티
		local corona = add(disc(d * 1.4, 0.08, skin.a, Enum.Material.Neon, 0.6))
		table.insert(extras, { part = corona, kind = "corona", a = d * 1.4, k = 0 })
		emitter(add, r, {
			Rate = 18,
			Lifetime = NumberRange.new(0.8, 1.6),
			Speed = NumberRange.new(1, 3 + r * 0.4),
			Size = seq(math.max(0.25, r * 0.07), 0),
			Color = ColorSequence.new(Color3.fromRGB(255, 220, 120), Color3.fromRGB(255, 70, 40)),
		})
	elseif effect == "nebula" then
		-- 초록 성운: 둘레를 천천히 도는 커다란 가스 구름
		for i = 0, 6 do
			local col = skin.a:Lerp(skin.b, i / 6)
			local p = add(fxPart(Vector3.new(1, 1, 1) * math.min(2000, r * (0.7 + (i % 3) * 0.15)), col, Enum.Material.Neon, Enum.PartType.Ball, 0.78))
			table.insert(extras, { part = p, kind = "gas", a = i / 7 * math.pi * 2, k = i })
		end
	elseif effect == "vip" then
		-- 황금 VIP: 금빛 반짝이와 떠 있는 왕관
		for i = 0, 7 do
			local p = add(fxPart(Vector3.new(small * 1.4, small * 1.4, small * 1.4), Color3.fromRGB(255, 220, 90), Enum.Material.Neon))
			table.insert(extras, { part = p, kind = "glint", a = i / 8 * math.pi * 2, k = i })
		end
		local band = add(fxPart(Vector3.new(small * 1.2, r * 0.6, r * 0.6), Color3.fromRGB(255, 200, 60), Enum.Material.Foil, Enum.PartType.Cylinder))
		table.insert(extras, { part = band, kind = "crownBand", a = 0, k = 0 })
		for i = 0, 4 do
			local p = add(fxPart(Vector3.new(small * 1.2, r * 0.25, small * 1.2), Color3.fromRGB(255, 215, 80), Enum.Material.Foil))
			table.insert(extras, { part = p, kind = "crownSpike", a = i / 5 * math.pi * 2, k = i })
			local gem = add(fxPart(Vector3.new(1, 1, 1) * small * 1.2, Color3.fromHSV(i / 5, 0.7, 1), Enum.Material.Neon, Enum.PartType.Ball))
			table.insert(extras, { part = gem, kind = "crownGem", a = i / 5 * math.pi * 2, k = i })
		end
	end

	-- 높은 등급일수록 둘레에 등급 색 보석 고리가 더 촘촘하다 (전설 이상)
	local tier = skin.tier or 1
	if tier >= 4 and not lite then
		local rc = Config.Rarities[tier] and Config.Rarities[tier].color or skin.a
		for i = 0, (tier - 3) * 8 - 1 do
			local p = add(fxPart(Vector3.new(1, 1, 1) * small * 0.9, rc, Enum.Material.Neon))
			table.insert(extras, { part = p, kind = "gem", a = i / ((tier - 3) * 8) * math.pi * 2, k = i })
		end
	end

	return {
		char = char,
		center = nil,
		active = true,
		radius = r,
		target = r,
		buildR = r,
		lastK = 1,
		baseD = { d * 1.14, d * 1.05, d * 0.9, d * 0.45, d * 1.6 },
		pulse = 0,
		skillOn = false,
		aura = aura,
		skin = skinIndex,
		parts = parts,
		rim = rim,
		disk = disk,
		void = void,
		core = core,
		arms = arms,
		ring = ring,
		motes = motes,
		light = light,
		effect = effect,
		extras = extras,
		sats = {},
		satKey = "",
		tier = tier,
		clones = nil,
		vortex = nil,
		puffAt = 0,
	}
end

-- 블랙홀이 있는 바닥 자리 (모든 구역의 바닥 높이는 0)
function Fx.holeCenter(char: Model): Vector3?
	local root = char:FindFirstChild("HumanoidRootPart")
	if not root or not root:IsA("BasePart") then
		return nil
	end
	return Vector3.new(root.Position.X, 0, root.Position.Z)
end

local function updateHole(h: Hole, t: number, dt: number)
	local center = h.center or (h.char and Fx.holeCenter(h.char))
	if not center then
		return
	end
	-- 먹어서 커질 때 부드럽게 커지고, 삼킬 때마다 잠깐 꿀꺽 부푼다
	h.radius += (h.target - h.radius) * math.min(1, dt * 6)
	h.pulse *= math.exp(-dt * 9)
	-- 적색 팽창 중이면 크게
	local swell = 1
	if h.char then
		local sw = h.char:GetAttribute("Swell")
		if type(sw) == "number" then
			swell = sw
		end
	end
	local scaleK = h.radius / h.buildR * (1 + h.pulse) * swell
	if math.abs(scaleK - h.lastK) > 0.002 then
		h.lastK = scaleK
		for i, p in ipairs({ h.rim, h.disk, h.void, h.core, h.aura }) do
			setDisc(p, h.baseD[i] * scaleK)
		end
	end
	local r = h.radius * swell
	local base = CFrame.new(center)
	h.rim.CFrame = base * CFrame.new(0, 0.04, 0)
	h.disk.CFrame = base * CFrame.new(0, 0.06, 0)
	h.void.CFrame = base * CFrame.new(0, 0.08, 0)
	h.core.CFrame = base * CFrame.new(0, 0.1, 0)
	h.aura.CFrame = base * CFrame.new(0, 0.02, 0)
	if h.skillOn then
		h.aura.Transparency = 0.45 + math.sin(t * 10) * 0.15
	elseif h.aura.Transparency < 1 then
		h.aura.Transparency = 1
	end
	if h.effect == "rainbow" then
		local c = Color3.fromHSV((t * 0.15) % 1, 0.8, 1)
		h.rim.Color = c
		h.light.Color = c
		for i, q in ipairs(h.ring) do
			q.part.Color = Color3.fromHSV((t * 0.15 + i / #h.ring) % 1, 0.7, 1)
		end
	elseif h.effect == "fire" then
		h.light.Brightness = 1.5 + math.sin(t * 17) * 0.4 + math.sin(t * 7) * 0.3
	end
	for _, e in ipairs(h.extras) do
		local p = e.part
		if e.kind == "flame" then
			local ang = e.a + t * 1.5
			local flick = 0.7 + math.abs(math.sin(t * 9 + e.k)) * 0.6
			p.CFrame = CFrame.new(center + Vector3.new(math.cos(ang) * r * 1.05, r * 0.15 * flick, math.sin(ang) * r * 1.05)) * CFrame.Angles(0, -ang, math.sin(t * 6 + e.k) * 0.3)
			p.Transparency = 0.1 + (1 - flick) * 0.5
		elseif e.kind == "shard" then
			local ang = e.a + t * 0.4
			p.CFrame = CFrame.new(center + Vector3.new(math.cos(ang) * r * 1.15, r * 0.12, math.sin(ang) * r * 1.15)) * CFrame.Angles(0, -ang, 0) * CFrame.Angles(0, 0, 0.5)
		elseif e.kind == "halo" then
			p.CFrame = base * CFrame.new(0, r * 0.15, 0) * CFrame.Angles(math.sin(t * 0.7) * 0.25, t * 0.3, 0)
		elseif e.kind == "orbitStar" then
			local ang = e.a - t * 0.8
			p.CFrame = CFrame.new(center + Vector3.new(math.cos(ang) * r * 1.45, r * 0.15 + math.sin(ang * 2 + t) * r * 0.08, math.sin(ang) * r * 1.45))
			p.Transparency = 0.2 + (math.sin(t * 5 + e.k * 1.7) + 1) * 0.3
		elseif e.kind == "sprinkle" then
			local ang = e.a + t * 1.2
			local rad = r * (1.25 + math.sin(t * 2 + e.k) * 0.08)
			p.CFrame = CFrame.new(center + Vector3.new(math.cos(ang) * rad, r * 0.1 + math.sin(t * 3 + e.k) * r * 0.06, math.sin(ang) * rad)) * CFrame.Angles(t * 3 + e.k, ang, 0)
		elseif e.kind == "glint" then
			local ang = e.a + t * 0.9
			p.CFrame = CFrame.new(center + Vector3.new(math.cos(ang) * r * 1.3, r * 0.25 + math.sin(t * 2 + e.k) * r * 0.1, math.sin(ang) * r * 1.3)) * CFrame.Angles(t * 2, t * 3, math.rad(45))
			p.Transparency = (math.sin(t * 6 + e.k * 2) + 1) * 0.4
		elseif e.kind == "sclera" then
			p.CFrame = base * CFrame.new(0, 0.12, 0)
			setDisc(p, r * 2 * 0.86)
		elseif e.kind == "iris" or e.kind == "pupil" or e.kind == "shine" then
			-- 눈동자가 움직이는 쪽을 바라본다
			local root = h.char and h.char:FindFirstChild("HumanoidRootPart")
			local vel = (root and root:IsA("BasePart")) and root.AssemblyLinearVelocity or Vector3.zero
			local look = Vector3.new(vel.X, 0, vel.Z)
			local off = look.Magnitude > 1 and look.Unit * r * 0.2 or Vector3.new(math.sin(t * 0.7), 0, math.cos(t * 0.5)) * r * 0.1
			local y = e.kind == "iris" and 0.135 or (e.kind == "pupil" and 0.15 or 0.165)
			local extra = e.kind == "iris" and off * 0.6 or (e.kind == "pupil" and off * 0.75 or off * 0.75 + Vector3.new(r * 0.07, 0, -r * 0.07))
			p.CFrame = CFrame.new(center + extra + Vector3.new(0, y, 0))
			-- 동공은 스킬을 쓰면 크게 열린다
			if e.kind == "pupil" then
				setDisc(p, r * 2 * (h.skillOn and 0.32 or 0.2))
			end
		elseif e.kind == "lid" then
			-- 4초마다 한 번 깜빡
			local blink = (t + e.k) % 4 < 0.14
			p.CFrame = base * CFrame.new(0, 0.18, 0)
			p.Transparency = blink and 0 or 1
		elseif e.kind == "jet" then
			local len = math.min(2000, r * (3.5 + math.sin(t * 8) * 0.4))
			p.Size = Vector3.new(len, p.Size.Y, p.Size.Z)
			p.CFrame = CFrame.new(center + Vector3.new(0, e.a * len / 2 + 0.3, 0)) * FLAT
			p.Transparency = 0.15 + math.abs(math.sin(t * 12)) * 0.25
		elseif e.kind == "corona" then
			setDisc(p, r * 2 * (1.35 + math.sin(t * 2.2) * 0.1))
			p.CFrame = base * CFrame.new(0, 0.03, 0)
			p.Transparency = 0.55 + math.sin(t * 3) * 0.1
		elseif e.kind == "gas" then
			local ang = e.a + t * 0.25
			local rad = r * (1.1 + math.sin(t * 0.6 + e.k) * 0.12)
			p.CFrame = CFrame.new(center + Vector3.new(math.cos(ang) * rad, r * 0.1, math.sin(ang) * rad))
		elseif e.kind == "crownBand" then
			p.CFrame = CFrame.new(center + Vector3.new(0, r * 0.75 + math.sin(t * 2) * r * 0.05, 0)) * CFrame.Angles(0, t * 0.8, 0) * FLAT
		elseif e.kind == "crownSpike" or e.kind == "crownGem" then
			local ang = e.a + t * 0.8
			local h0 = r * 0.75 + math.sin(t * 2) * r * 0.05
			local y = e.kind == "crownSpike" and h0 + r * 0.14 or h0 + r * 0.28
			p.CFrame = CFrame.new(center + Vector3.new(math.cos(ang) * r * 0.3, y, math.sin(ang) * r * 0.3))
		elseif e.kind == "gem" then
			local ang = e.a - t * 0.5
			p.CFrame = CFrame.new(center + Vector3.new(math.cos(ang) * r * 1.55, r * 0.05 + math.sin(t * 3 + e.k) * r * 0.04, math.sin(ang) * r * 1.55)) * CFrame.Angles(t, t * 2, 0)
		elseif e.kind == "ray" then
			local ang = e.a + t * 0.25
			local len = 1 + math.sin(t * 3 + e.k) * 0.2
			local pos = center + Vector3.new(math.cos(ang) * r * 1.3, 0.1, math.sin(ang) * r * 1.3)
			p.CFrame = CFrame.lookAt(pos, pos + Vector3.new(math.cos(ang), 0, math.sin(ang)))
			p.Size = Vector3.new(p.Size.X, 0.1, r * 0.35 * len)
		end
	end
	for i, sat in ipairs(h.sats) do
		local ang = sat.a + t * (0.9 - math.min(0.5, r * 0.002))
		local rad = r * 1.3 + sat.size * 2.5 + 1
		local y = r * 0.25 + sat.size * 1.5 + math.sin(t * 2.2 + i * 1.3) * sat.size * 0.5
		local pos = center + Vector3.new(math.cos(ang) * rad, y, math.sin(ang) * rad)
		sat.model:PivotTo(CFrame.lookAt(pos, pos + Vector3.new(-math.sin(ang), 0, math.cos(ang))) * CFrame.Angles(0, t * 1.5 + i, 0))
	end
	-- 테두리가 숨 쉬듯 빛난다
	h.rim.Transparency = 0.1 + (math.sin(t * 3) + 1) * 0.1
	local spin = t * 1.4
	for _, a in ipairs(h.arms) do
		local ang = spin + a.arm * (math.pi * 2 / 3) + a.t * 2.4
		local rad = r * (1.0 - a.t * 0.8)
		local pos = center + Vector3.new(math.cos(ang) * rad, 0.12, math.sin(ang) * rad)
		a.part.CFrame = CFrame.lookAt(pos, pos + Vector3.new(-math.sin(ang), 0, math.cos(ang)))
	end
	for _, q in ipairs(h.ring) do
		local ang = q.a + t * 2.6
		local rad = r * 1.08
		local pos = center + Vector3.new(math.cos(ang) * rad, 0.25 + q.h + math.sin(t * 4 + q.a * 3) * 0.08 * r, math.sin(ang) * rad)
		q.part.CFrame = CFrame.lookAt(pos, pos + Vector3.new(-math.sin(ang), 0, math.cos(ang)))
	end
	for _, m in ipairs(h.motes) do
		local k = (t * 0.6 + m.phase) % 1
		local ang = m.phase * 20 + k * 6
		local rad = r * 1.2 * (1 - k)
		m.part.CFrame = CFrame.new(center + Vector3.new(math.cos(ang) * rad, 0.3 + (1 - k) * r * 0.2, math.sin(ang) * rad))
		m.part.Transparency = k * 0.8
	end
	if h.char then
		Fx.skillVisuals(h, center, r, t, dt)
	end
end

------------------------------------------------------------------------
-- 스킬과 능력 모습 (모든 화면에서 보인다: 캐릭터 속성 SkillId를 보고 그린다)
------------------------------------------------------------------------
local function puff(pos: Vector3, size: number, color: Color3, life: number)
	local p = fxPart(Vector3.new(1, 1, 1) * math.min(2000, size), color, Enum.Material.Neon, Enum.PartType.Ball, 0.6)
	p.CFrame = CFrame.new(pos)
	TweenService:Create(p, TweenInfo.new(life, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Transparency = 1, Size = p.Size * 1.6 }):Play()
	Debris:AddItem(p, life + 0.05)
end

function Fx.skillVisuals(h: Hole, center: Vector3, r: number, t: number, dt: number)
	local char = h.char :: Model
	local id = char:GetAttribute("SkillId")
	-- 프리즘 분신: 무지개 분신 둘 (서버와 같은 궤도)
	if id == "prism" then
		if not h.clones then
			h.clones = {}
			for _ = 1, 2 do
				local c = buildHole(nil, h.radius * 0.7, h.skin, true)
				table.insert(h.clones or {}, c)
			end
		end
		local clones = h.clones or {}
		for k, c in ipairs(clones) do
			local a = t * 2.2 + (k - 1) * math.pi
			c.center = center + Vector3.new(math.cos(a), 0, math.sin(a)) * r * 2.5
			c.target = r * 0.7
			updateHole(c, t, dt)
			c.rim.Color = Color3.fromHSV((t * 0.5 + k * 0.5) % 1, 0.8, 1)
		end
	elseif h.clones then
		for _, c in ipairs(h.clones) do
			Fx.burst((c.center or center) + Vector3.new(0, 1, 0), Color3.fromHSV(math.random(), 0.7, 1), 20, 10 + r, math.max(0.4, r * 0.08))
			destroyHole(c)
		end
		h.clones = nil
	end
	-- 은하 소용돌이: 반지름 4배 둘레에서 빛 알갱이가 소용돌이치며 빨려 든다
	if id == "vortex" then
		if not h.vortex then
			h.vortex = {}
			for i = 0, 23 do
				local p = fxPart(Vector3.new(1, 1, 1) * math.max(0.3, r * 0.12), i % 2 == 0 and Color3.fromRGB(200, 210, 255) or Color3.fromRGB(255, 220, 255), Enum.Material.Neon, Enum.PartType.Ball)
				table.insert(h.vortex or {}, p)
			end
		end
		local vparts = h.vortex or {}
		for i, p in ipairs(vparts) do
			local k = (t * 0.5 + i / 24) % 1
			local ang = i / 24 * math.pi * 2 + k * 5
			local rad = r * 4 * (1 - k) + r
			p.CFrame = CFrame.new(center + Vector3.new(math.cos(ang) * rad, 0.5 + (1 - k) * r * 0.3, math.sin(ang) * rad))
			p.Transparency = k * 0.7
		end
	elseif h.vortex then
		for _, p in ipairs(h.vortex) do
			p:Destroy()
		end
		h.vortex = nil
	end
	-- 성운 꼬리: 지나간 자리에 초록 구름
	if h.effect == "nebula" and t > h.puffAt then
		h.puffAt = t + 0.15
		local cam = workspace.CurrentCamera
		if cam and (cam.CFrame.Position - center).Magnitude < 800 + r * 10 then
			local skin = Config.Skins[h.skin]
			puff(center + Vector3.new(0, r * 0.1, 0), r * 1.2, skin.a:Lerp(skin.b, math.random()), 2)
		end
	end
end

-- 한 번 쓰는 스킬 모습: 빛줄기, 순간이동, 신의 시선
function Fx.skillFx(data: any)
	local r = data.r or 3
	local from: Vector3 = data.from
	if data.id == "beam" and data.to then
		local to: Vector3 = data.to
		local len = (to - from).Magnitude
		local mid = (from + to) / 2 + Vector3.new(0, r * 0.3, 0)
		local beam = fxPart(Vector3.new(math.min(2000, len), r * 0.9, r * 0.9), Color3.fromRGB(150, 230, 255), Enum.Material.Neon, Enum.PartType.Cylinder, 0.1)
		beam.CFrame = CFrame.lookAt(mid, mid + (to - from)) * CFrame.Angles(0, math.rad(90), 0)
		TweenService:Create(beam, TweenInfo.new(0.6), { Transparency = 1, Size = Vector3.new(beam.Size.X, r * 0.1, r * 0.1) }):Play()
		Debris:AddItem(beam, 0.65)
		for k = 0, 6 do
			Fx.burst(from:Lerp(to, k / 6) + Vector3.new(0, 1, 0), Color3.fromRGB(150, 230, 255), 10, 10 + r, math.max(0.4, r * 0.1))
		end
		Fx.sound("slash", 0.8, 0.7)
	elseif data.id == "blink" and data.to then
		local to: Vector3 = data.to
		for k = 0, 8 do
			local pos = from:Lerp(to, k / 8)
			task.delay(k * 0.02, function()
				puff(pos + Vector3.new(0, r * 0.2, 0), r * 1.1, Color3.fromRGB(190, 240, 255), 0.8)
			end)
		end
		Fx.ring(to, Color3.fromRGB(200, 245, 255), r * 1.5, r * 4, 0.5)
		Fx.sound("whoosh", 0.9, 1.6)
	elseif data.id == "eye" then
		-- 땅에 거대한 눈이 열렸다가 감긴다
		local d = r * 14
		local sclera = disc(d, 0.3, Color3.fromRGB(255, 250, 235), Enum.Material.Neon, 0.3)
		local iris = disc(d * 0.45, 0.32, Color3.fromRGB(255, 200, 80), Enum.Material.Neon, 0.1)
		local pupil = disc(d * 0.2, 0.34, BLACK, Enum.Material.SmoothPlastic, 0)
		for i, p in ipairs({ sclera, iris, pupil }) do
			p.CFrame = CFrame.new(from + Vector3.new(0, 0.3 + i * 0.02, 0))
		end
		local start = os.clock()
		local conn: RBXScriptConnection
		conn = RunService.RenderStepped:Connect(function()
			local k = math.min(1, (os.clock() - start) / 1.4)
			local open = k < 0.3 and k / 0.3 or (k > 0.75 and (1 - k) / 0.25 or 1)
			setDisc(sclera, d * math.max(0.02, open))
			setDisc(iris, d * 0.45 * math.max(0.02, open))
			setDisc(pupil, d * (0.12 + 0.12 * open))
			sclera.Transparency = 1 - open * 0.7
			if k >= 1 then
				conn:Disconnect()
				sclera:Destroy()
				iris:Destroy()
				pupil:Destroy()
			end
		end)
		for i = 0, 11 do
			local a = i / 12 * math.pi * 2
			Fx.streak(from + Vector3.new(math.cos(a), 0, math.sin(a)) * r * 7, from + Vector3.new(0, 1, 0), Color3.fromRGB(255, 215, 90), math.max(0.5, r * 0.25))
		end
		Fx.pillar(from, Color3.fromRGB(255, 220, 120), 200 + r * 4, r * 0.8, 1)
		Fx.sound("whoosh", 1, 0.4)
	elseif data.id == "swell" or data.id == "vortex" or data.id == "prism" then
		Fx.ring(from, Color3.fromRGB(255, 255, 255), r * 2, r * 6, 0.6)
		Fx.sound("whoosh", 0.8, 0.8)
	end
end

-- 로비에서는 블랙홀을 작게 보여 준다 (광장을 다 덮지 않게)
local LOBBY_SHOW = 8
local function shownRadius(char: Model, r: number): number
	local c = Fx.holeCenter(char)
	if c and Config.inLobby(c) then
		return math.min(r, LOBBY_SHOW)
	end
	return r
end

local function syncHole(char: Model)
	local rawR = char:GetAttribute("HoleR")
	local skin = char:GetAttribute("HoleSkin")
	local h = holes[char]
	local r = type(rawR) == "number" and shownRadius(char, rawR) or nil
	if type(r) ~= "number" or not char.Parent then
		if h then
			destroyHole(h)
			holes[char] = nil
		end
		return
	end
	local skinIndex = type(skin) == "number" and skin or 1
	local sats = char:GetAttribute("Sats")
	local satKey = type(sats) == "string" and sats or ""
	if h and h.skin == skinIndex then
		-- 크기가 조금 바뀐 건 다시 만들지 않고 늘린다
		h.target = r
		local k = r / h.buildR
		if k < 1.15 and k > 0.87 then
			if h.satKey ~= satKey then
				buildSats(h, satKey)
			end
			return
		end
	end
	local shown = h and h.radius or r
	-- 로비 ↔ 세계처럼 크기가 확 바뀌면 바로 그 크기로
	if shown > r * 3 or shown < r / 3 then
		shown = r
	end
	if h then
		destroyHole(h)
	end
	local nh = buildHole(char, r, skinIndex)
	nh.radius = shown
	nh.skillOn = char:GetAttribute("SkillOn") == true
	holes[char] = nh
	buildSats(nh, satKey)
end

-- 삼킬 때 블랙홀이 꿀꺽 부푼다
function Fx.pulse(char: Model, amount: number)
	local h = holes[char]
	if h then
		h.pulse = math.max(h.pulse, amount)
	end
end

local function watchCharacter(char: Model)
	syncHole(char)
	char:GetAttributeChangedSignal("HoleR"):Connect(function()
		syncHole(char)
	end)
	char:GetAttributeChangedSignal("HoleSkin"):Connect(function()
		syncHole(char)
	end)
	char:GetAttributeChangedSignal("Sats"):Connect(function()
		syncHole(char)
	end)
	char:GetAttributeChangedSignal("SkillOn"):Connect(function()
		local h = holes[char]
		if h then
			h.skillOn = char:GetAttribute("SkillOn") == true
		end
	end)
	char.AncestryChanged:Connect(function()
		if not char.Parent then
			syncHole(char)
		end
	end)
end

local function watchPlayer(player: Player)
	if player.Character then
		watchCharacter(player.Character)
	end
	player.CharacterAdded:Connect(function(c)
		watchCharacter(c :: Model)
	end)
end

------------------------------------------------------------------------
-- 스킨 미리보기: 스킨 창(ViewportFrame)과 시작 지점 뒤 스킨 전시관
------------------------------------------------------------------------
local previews: { Hole } = {}

function Fx.preview(skinIndex: number, r: number, center: Vector3, parent: Instance): Hole
	buildParent = parent
	local ok, h = pcall(buildHole, nil, r, skinIndex, true)
	buildParent = nil
	if not ok then
		error(h)
	end
	h.center = center
	table.insert(previews, h)
	return h
end

function Fx.removePreview(h: Hole)
	destroyHole(h)
	local i = table.find(previews, h)
	if i then
		table.remove(previews, i)
	end
end

type GalleryItem = { hole: Hole, label: TextLabel, skin: any }
local gallery: { GalleryItem } = {}

local function buildGallery()
	local lobbyFolder = workspace:WaitForChild("Lobby", 60)
	if not lobbyFolder then
		return
	end
	local f = Instance.new("Folder")
	f.Name = "SkinGallery"
	f.Parent = folder
	for _, ped in ipairs(lobbyFolder:GetChildren()) do
		local k = ped:GetAttribute("SkinIndex")
		local hr = ped:GetAttribute("HoleR")
		local skin = type(k) == "number" and Config.Skins[k]
		if ped:IsA("BasePart") and skin and type(hr) == "number" then
			-- 받침(세운 원기둥) 윗면 위에 그린다
			local center = ped.Position + Vector3.new(0, ped.Size.X / 2 + 0.05, 0)
			local h = Fx.preview(k, hr, center, f)
			h.active = false
			if hr < 10 then
				local anchor = fxPart(Vector3.new(0.2, 0.2, 0.2), skin.a, Enum.Material.Neon, nil, 1)
				anchor.CFrame = CFrame.new(center + Vector3.new(0, 10, 0))
				anchor.Parent = f
				local bb = Instance.new("BillboardGui")
				bb.Size = UDim2.new(0, 190, 0, 64)
				bb.LightInfluence = 0
				bb.MaxDistance = 220
				bb.Parent = anchor
				local l = Instance.new("TextLabel")
				l.Size = UDim2.fromScale(1, 1)
				l.BackgroundTransparency = 1
				l.Font = Enum.Font.GothamBlack
				l.TextScaled = true
				l.TextColor3 = skin.b
				l.TextStrokeTransparency = 0.2
				l.Text = skin.name
				l.Parent = bb
				table.insert(gallery, { hole = h, label = l, skin = skin })
			else
				table.insert(gallery, { hole = h, label = nil :: any, skin = skin })
			end
		end
	end
end

-- 전시관 이름표: 가진 스킨, 쓰는 스킨, 얻는 법
function Fx.updateGallery(owned: { string }, selected: string)
	for _, g in ipairs(gallery) do
		if not g.label then
			continue
		end
		local skin = g.skin
		local status
		if skin.id == selected then
			status = "✔ 사용 중"
		elseif table.find(owned, skin.id) then
			status = "열림"
		elseif skin.unlock == "bigbang" then
			status = string.format("🔒 빅뱅 %d번", skin.value)
		elseif skin.unlock == "dm" then
			status = string.format("🌑 %d", skin.value)
		elseif skin.unlock == "world2" then
			status = "🔒 사탕 태양"
		else
			status = "💎 " .. Config.PASS_BY_KEY[skin.value].name
		end
		local ab = skin.ability
		g.label.Text = skin.name .. "\n" .. status .. (ab and ("\n" .. (ab.kind == "active" and "⚡ " or "✦ ") .. ab.name) or "")
	end
end

------------------------------------------------------------------------
-- 빨려 들어가는 연출: 모든 화면에서, 누가 삼켰든 그 블랙홀로 소용돌이치며 들어간다
------------------------------------------------------------------------
type Sucked = { part: BasePart, offset: Vector3, height: number, size: Vector3, tr: number }

-- 한 번에 너무 많이 빨려 들면 (아주 큰 블랙홀) 작은 것들은 바로 사라지게 해서 화면이 버벅이지 않게 한다
local MAX_SUCKING = 40
local sucking = 0

local function hideNow(model: Model)
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("BasePart") then
			d.LocalTransparencyModifier = 1
		elseif d:IsA("ParticleEmitter") or d:IsA("PointLight") or d:IsA("Sparkles") then
			(d :: any).Enabled = false
		end
	end
end

local function suck(model: Model)
	local id = model:GetAttribute("EatenBy")
	if type(id) ~= "number" then
		return
	end
	local eater = Players:GetPlayerByUserId(id)
	local char = eater and eater.Character
	local center = char and Fx.holeCenter(char)
	if not center then
		hideNow(model)
		return
	end
	if not model:IsDescendantOf(workspace) then
		hideNow(model)
		return
	end
	local size = model:GetAttribute("Size")
	local holeR = char and char:GetAttribute("HoleR")
	if sucking >= MAX_SUCKING or (type(size) == "number" and type(holeR) == "number" and size < holeR * 0.04) then
		hideNow(model)
		return
	end
	sucking += 1
	local list: { Sucked } = {}
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("BasePart") then
			local off = d.Position - center
			table.insert(list, { part = d, offset = Vector3.new(off.X, 0, off.Z), height = off.Y, size = d.Size, tr = d.Transparency })
		elseif d:IsA("ParticleEmitter") or d:IsA("PointLight") or d:IsA("SpotLight") then
			(d :: any).Enabled = false
		end
	end
	local start = os.clock()
	local duration = 0.5
	local conn: RBXScriptConnection
	conn = RunService.RenderStepped:Connect(function()
		local t = math.min(1, (os.clock() - start) / duration)
		local c = Fx.holeCenter(char :: Model) or center
		local ease = t * t
		local spin = CFrame.Angles(0, ease * 5, 0)
		for _, s in ipairs(list) do
			local p = s.part
			if p.Parent then
				local off = spin * (s.offset * (1 - ease))
				p.CFrame = CFrame.new(c + off + Vector3.new(0, s.height * (1 - ease) - ease * 2, 0)) * CFrame.Angles(ease * 6, ease * 4, 0)
				p.Size = s.size * math.max(0.05, 1 - ease * 0.95)
				p.Transparency = s.tr + (1 - s.tr) * ease
			end
		end
		if t >= 1 then
			conn:Disconnect()
			sucking -= 1
			for _, s in ipairs(list) do
				s.part.LocalTransparencyModifier = 1
			end
		end
	end)
end

-- 다시 생긴 물체: 작게 시작해서 통통 튀듯 원래 크기로
local readyAt = math.huge

local growing = 0
local function growIn(model: Model)
	-- 내 블랙홀에 비해 아주 작은 것, 한꺼번에 너무 많은 것은 연출 없이 바로 나타난다
	local size0 = model:GetAttribute("Size")
	local me = Players.LocalPlayer.Character
	local myR = me and me:GetAttribute("HoleR")
	if growing >= 20 or (type(size0) == "number" and type(myR) == "number" and size0 < myR * 0.03) then
		return
	end
	if Fx.isFar(model:GetPivot().Position) then
		return
	end
	growing += 1
	local ok = pcall(function()
		model:ScaleTo(0.05)
	end)
	if not ok then
		growing -= 1
		return
	end
	local pos = model:GetPivot().Position
	local size = model:GetAttribute("Size")
	local s = type(size) == "number" and size or 2
	Fx.burst(pos + Vector3.new(0, s * 0.5, 0), Color3.fromRGB(255, 255, 220), 10, 4 + s, math.clamp(s * 0.2, 0.3, 6))
	local start = os.clock()
	local conn: RBXScriptConnection
	conn = RunService.RenderStepped:Connect(function()
		local t = math.min(1, (os.clock() - start) / 0.45)
		if not model.Parent or model:GetAttribute("EatenBy") then
			conn:Disconnect()
			growing -= 1
			return
		end
		-- 살짝 넘쳤다가 돌아오는 곡선
		local c = 1.7
		local k = 1 + (c + 1) * (t - 1) ^ 3 + c * (t - 1) ^ 2
		pcall(function()
			model:ScaleTo(math.max(0.05, k))
		end)
		if t >= 1 then
			conn:Disconnect()
			growing -= 1
			pcall(function()
				model:ScaleTo(1)
			end)
		end
	end)
end

-- 황금 물체: 금박을 입히고 반짝이게 (내 화면에서만 바꾼다)
local GOLD = Color3.fromRGB(255, 205, 60)
local function goldify(model: Model)
	if model:GetAttribute("Goldified") or not model:GetAttribute("Golden") then
		return
	end
	model:SetAttribute("Goldified", true)
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("BasePart") and d.Transparency < 0.9 and d.Material ~= Enum.Material.Neon then
			d.Color = d.Color:Lerp(GOLD, 0.75)
			d.Material = Enum.Material.Foil
			d.Reflectance = 0.2
		end
	end
	local pp = model.PrimaryPart
	if pp then
		local sp = Instance.new("Sparkles")
		sp.SparkleColor = GOLD
		sp.Parent = pp
		local light = Instance.new("PointLight")
		light.Color = GOLD
		light.Range = 16
		light.Brightness = 2
		light.Parent = pp
	end
end

local function watchObject(model: Instance)
	if not model:IsA("Model") then
		return
	end
	-- 숨겨 뒀다가 다시 꺼낸 물체는 이미 지켜보고 있다
	if model:GetAttribute("Unculling") then
		return
	end
	goldify(model :: Model)
	model:GetAttributeChangedSignal("Golden"):Connect(function()
		goldify(model :: Model)
	end)
	if model:GetAttribute("EatenBy") then
		suck(model :: Model)
	elseif os.clock() > readyAt then
		growIn(model :: Model)
	end
	model:GetAttributeChangedSignal("EatenBy"):Connect(function()
		suck(model :: Model)
	end)
end

------------------------------------------------------------------------
-- 떠오르는 숫자와 터지는 빛
------------------------------------------------------------------------
function Fx.popup(pos: Vector3, text: string, color: Color3, size: number)
	local anchor = fxPart(Vector3.new(0.2, 0.2, 0.2), color, Enum.Material.Neon, nil, 1)
	anchor.CFrame = CFrame.new(pos)
	local bb = Instance.new("BillboardGui")
	bb.Size = UDim2.new(0, 220, 0, 50)
	bb.AlwaysOnTop = true
	bb.LightInfluence = 0
	bb.MaxDistance = 3000
	bb.Parent = anchor
	local l = Instance.new("TextLabel")
	l.Size = UDim2.fromScale(1, 1)
	l.BackgroundTransparency = 1
	l.Font = Enum.Font.GothamBlack
	l.TextSize = size
	l.TextColor3 = color
	l.TextStrokeTransparency = 0.2
	l.Text = text
	l.Parent = bb
	TweenService:Create(anchor, TweenInfo.new(0.9, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Position = pos + Vector3.new(0, 4, 0) }):Play()
	TweenService:Create(l, TweenInfo.new(0.4, Enum.EasingStyle.Linear, Enum.EasingDirection.In, 0, false, 0.5), { TextTransparency = 1, TextStrokeTransparency = 1 }):Play()
	Debris:AddItem(anchor, 1)
end

function Fx.burst(pos: Vector3, color: Color3, count: number, speed: number, size: number)
	local anchor = fxPart(Vector3.new(0.2, 0.2, 0.2), color, Enum.Material.Neon, nil, 1)
	anchor.CFrame = CFrame.new(pos)
	local pe = Instance.new("ParticleEmitter")
	pe.Rate = 0
	pe.Lifetime = NumberRange.new(0.3, 0.7)
	pe.Speed = NumberRange.new(speed * 0.5, speed)
	pe.SpreadAngle = Vector2.new(180, 180)
	pe.Drag = 4
	pe.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, size), NumberSequenceKeypoint.new(1, 0) })
	pe.LightEmission = 1
	pe.Color = ColorSequence.new(color)
	pe.Parent = anchor
	pe:Emit(count)
	Debris:AddItem(anchor, 1.2)
end

-- 바닥에 퍼지는 빛 고리
function Fx.ring(pos: Vector3, color: Color3, fromD: number, toD: number, life: number)
	local p = disc(fromD, 0.2, color, Enum.Material.Neon, 0.2)
	p.CFrame = CFrame.new(pos + Vector3.new(0, 0.25, 0))
	local start = os.clock()
	local conn: RBXScriptConnection
	conn = RunService.RenderStepped:Connect(function()
		local k = math.min(1, (os.clock() - start) / life)
		local e = 1 - (1 - k) * (1 - k)
		setDisc(p, fromD + (toD - fromD) * e)
		p.Transparency = 0.2 + 0.8 * k
		if k >= 1 then
			conn:Disconnect()
			p:Destroy()
		end
	end)
end

-- 삼킨 물체 자리에서 블랙홀 가운데로 빨려 드는 빛줄기
function Fx.streak(from: Vector3, to: Vector3, color: Color3, size: number)
	local p = fxPart(Vector3.new(1, 1, 1) * size, color, Enum.Material.Neon, Enum.PartType.Ball)
	p.CFrame = CFrame.new(from)
	local side = Vector3.new(-(to.Z - from.Z), 0, to.X - from.X)
	if side.Magnitude > 0.01 then
		side = side.Unit * math.min(side.Magnitude, 40) * 0.3
	end
	local start = os.clock()
	local conn: RBXScriptConnection
	conn = RunService.RenderStepped:Connect(function()
		local k = math.min(1, (os.clock() - start) / 0.32)
		local pos = from:Lerp(to, k * k) + side * math.sin(k * math.pi) + Vector3.new(0, math.sin(k * math.pi) * size, 0)
		p.CFrame = CFrame.new(pos)
		p.Size = Vector3.new(1, 1, 1) * size * (1 - k * 0.8)
		p.Transparency = k * 0.6
		if k >= 1 then
			conn:Disconnect()
			p:Destroy()
		end
	end)
end

-- 빛기둥
function Fx.pillar(pos: Vector3, color: Color3, height: number, width: number, life: number)
	local p = fxPart(Vector3.new(height, width, width), color, Enum.Material.Neon, Enum.PartType.Cylinder, 0.1)
	p.CFrame = CFrame.new(pos + Vector3.new(0, height / 2, 0)) * FLAT
	TweenService:Create(p, TweenInfo.new(life, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Size = Vector3.new(height, 0.1, 0.1), Transparency = 1 }):Play()
	Debris:AddItem(p, life + 0.05)
end

------------------------------------------------------------------------
-- 별똥별: 하늘에서 떨어져 바닥에서 반짝인다. 삼키면 질량 2배
------------------------------------------------------------------------
local currentStar: Model? = nil

function Fx.clearStar()
	if currentStar then
		currentStar:Destroy()
		currentStar = nil
	end
end

function Fx.star(pos: Vector3, life: number)
	Fx.clearStar()
	local model = Instance.new("Model")
	model.Name = "ShootingStar"
	model.Parent = folder
	currentStar = model
	local gold = Color3.fromRGB(255, 225, 90)
	local core = fxPart(Vector3.new(3, 3, 3), gold, Enum.Material.Neon, Enum.PartType.Ball)
	core.Parent = model
	local points = {}
	for _ = 1, 5 do
		local p = fxPart(Vector3.new(1.1, 3.2, 1.1), gold:Lerp(Color3.new(1, 1, 1), 0.3), Enum.Material.Neon)
		p.Parent = model
		table.insert(points, p)
	end
	local light = Instance.new("PointLight")
	light.Color = gold
	light.Range = 30
	light.Brightness = 3
	light.Parent = core
	local beam = fxPart(Vector3.new(120, 4, 4), gold, Enum.Material.Neon, Enum.PartType.Cylinder, 0.6)
	beam.Parent = model
	local tag = Instance.new("BillboardGui")
	tag.Size = UDim2.new(0, 180, 0, 40)
	tag.StudsOffset = Vector3.new(0, 7, 0)
	tag.AlwaysOnTop = true
	tag.LightInfluence = 0
	tag.MaxDistance = 5000
	tag.Parent = core
	local l = Instance.new("TextLabel")
	l.Size = UDim2.fromScale(1, 1)
	l.BackgroundTransparency = 1
	l.Font = Enum.Font.GothamBlack
	l.TextScaled = true
	l.TextColor3 = gold
	l.TextStrokeTransparency = 0.2
	l.Text = "⭐ 질량 2배"
	l.Parent = tag
	local trail = Instance.new("ParticleEmitter")
	trail.Rate = 40
	trail.Lifetime = NumberRange.new(0.4, 0.8)
	trail.Speed = NumberRange.new(0, 2)
	trail.Size = seq(1.5, 0)
	trail.LightEmission = 1
	trail.Color = ColorSequence.new(gold, Color3.fromRGB(255, 140, 60))
	trail.Parent = core

	local from = pos + Vector3.new(-90, 220, -60)
	local start = os.clock()
	local fall = 1.1
	Fx.sound("whoosh", 0.5, 0.6)
	local landed = false
	local conn: RBXScriptConnection
	conn = RunService.RenderStepped:Connect(function()
		if currentStar ~= model or not model.Parent then
			conn:Disconnect()
			return
		end
		local age = os.clock() - start
		if age > life + fall then
			conn:Disconnect()
			Fx.clearStar()
			return
		end
		local c: Vector3
		if age < fall then
			local k = age / fall
			c = from:Lerp(pos + Vector3.new(0, 4, 0), k * k)
			beam.Transparency = 1
		else
			if not landed then
				landed = true
				Fx.ring(pos, gold, 4, 60, 0.7)
				Fx.burst(pos + Vector3.new(0, 3, 0), gold, 40, 40, 2)
				Fx.sound("pop", 0.6, 0.7)
			end
			c = pos + Vector3.new(0, 4 + math.sin(age * 3) * 0.8, 0)
			beam.Transparency = 0.55 + math.sin(age * 4) * 0.1
			beam.CFrame = CFrame.new(pos + Vector3.new(0, 60, 0)) * FLAT
		end
		core.CFrame = CFrame.new(c)
		local spin = CFrame.Angles(0, age * 2, 0)
		for i, p in ipairs(points) do
			p.CFrame = CFrame.new(c) * spin * CFrame.Angles(0, 0, (i - 1) * math.pi * 2 / 5) * CFrame.new(0, 2.2, 0)
		end
	end)
end

function Fx.starGot(pos: Vector3)
	Fx.clearStar()
	local gold = Color3.fromRGB(255, 225, 90)
	Fx.ring(pos, gold, 6, 140, 0.9)
	Fx.pillar(pos, gold, 200, 14, 0.8)
	Fx.burst(pos + Vector3.new(0, 4, 0), gold, 60, 60, 3)
	Fx.sound("slash", 0.6, 1.4)
end

------------------------------------------------------------------------
-- 떠도는 거대 행성 (서버 이벤트). 서버의 보이지 않는 부품을 따라 행성을 그린다
------------------------------------------------------------------------
local Planet = { model = nil :: Model?, label = nil :: TextLabel?, built = 0, lastScale = 1, chunkAt = 0 }

local function planetTick(t: number)
	local folder0 = workspace:FindFirstChild("Event")
	local anchor = folder0 and folder0:FindFirstChild("GiantPlanet")
	if not anchor or not anchor:IsA("BasePart") then
		return
	end
	local active = anchor:GetAttribute("Active") == true
	local R = anchor:GetAttribute("Radius")
	if not active or type(R) ~= "number" then
		if Planet.model then
			local pp = Planet.model.PrimaryPart
			if pp then
				Fx.burst(pp.Position, Color3.fromRGB(255, 200, 120), 60, 60 + Planet.built, math.max(1, Planet.built * 0.1))
			end
			Planet.model:Destroy()
			Planet.model = nil
		end
		return
	end
	if not Planet.model or Planet.built ~= R then
		if Planet.model then
			Planet.model:Destroy()
		end
		local m = Props.build("planet", R, CFrame.new(), 7)
		for _, d in ipairs(m:GetDescendants()) do
			if d:IsA("BasePart") then
				d.CanCollide = false
				d.CanQuery = false
				d.CastShadow = false
			end
		end
		local pp = m.PrimaryPart
		if pp then
			local bb = Instance.new("BillboardGui")
			bb.Size = UDim2.new(0, 320, 0, 60)
			bb.StudsOffset = Vector3.new(0, R * 1.3, 0)
			bb.AlwaysOnTop = true
			bb.LightInfluence = 0
			bb.MaxDistance = 20000
			bb.Parent = pp
			local l = Instance.new("TextLabel")
			l.Size = UDim2.fromScale(1, 1)
			l.BackgroundTransparency = 1
			l.Font = Enum.Font.GothamBlack
			l.TextScaled = true
			l.TextColor3 = Color3.fromRGB(255, 220, 140)
			l.TextStrokeTransparency = 0.2
			l.Parent = bb
			Planet.label = l
		end
		m.Parent = folder
		Planet.model = m
		Planet.built = R
		Planet.lastScale = 1
	end
	local model = Planet.model :: Model
	local hp = anchor:GetAttribute("HP")
	local maxHp = anchor:GetAttribute("MaxHP")
	local frac = (type(hp) == "number" and type(maxHp) == "number" and maxHp > 0) and math.clamp(hp / maxHp, 0, 1) or 1
	local scale = 0.4 + 0.6 * math.sqrt(frac)
	if math.abs(scale - Planet.lastScale) > 0.02 then
		Planet.lastScale = scale
		pcall(function()
			model:ScaleTo(scale)
		end)
	end
	local pos = anchor.Position
	model:PivotTo(CFrame.new(pos.X, R * scale, pos.Z) * CFrame.Angles(0.3, t * 0.15, 0) * CFrame.new(0, -R * scale, 0))
	if Planet.label then
		Planet.label.Text = string.format("🌍 떠도는 거대 행성  %d%%", math.floor(frac * 100 + 0.5))
	end
	-- 내 블랙홀이 닿아 있으면 조각이 빨려 든다
	local me = Players.LocalPlayer.Character
	local c = me and Fx.holeCenter(me)
	local myR = me and me:GetAttribute("HoleR")
	if c and type(myR) == "number" and t > Planet.chunkAt then
		local shownR = R * scale
		local d = Vector3.new(c.X - pos.X, 0, c.Z - pos.Z)
		if d.Magnitude < shownR + myR then
			Planet.chunkAt = t + 0.12
			local dir = d.Magnitude > 0.1 and d.Unit or Vector3.new(1, 0, 0)
			Fx.streak(Vector3.new(pos.X, shownR, pos.Z) + dir * shownR, c + Vector3.new(0, 0.5, 0), Color3.fromHSV(0.05 + math.random() * 0.1, 0.6, 1), math.clamp(shownR * 0.06, 0.4, 30))
		end
	end
end

-- 플레이어 화면이 아는 행성 위치 (화살표용)
function Fx.planetInfo(): (boolean, Vector3, number)
	local folder0 = workspace:FindFirstChild("Event")
	local anchor = folder0 and folder0:FindFirstChild("GiantPlanet")
	if anchor and anchor:IsA("BasePart") and anchor:GetAttribute("Active") == true then
		local hp = anchor:GetAttribute("HP")
		local maxHp = anchor:GetAttribute("MaxHP")
		local frac = (type(hp) == "number" and type(maxHp) == "number" and maxHp > 0) and hp / maxHp or 1
		return true, anchor.Position, frac
	end
	return false, Vector3.zero, 0
end

------------------------------------------------------------------------
-- 먼 물체 숨기기: 내 블랙홀 근처 물체만 그려서 화면이 버벅이지 않게 한다
-- (먼 물체는 내 화면에서만 잠시 치워 둔다. 가까워지면 다시 꺼낸다)
------------------------------------------------------------------------
local Cull = { folder = nil :: Folder?, pivots = setmetatable({}, { __mode = "k" }) :: any, focus = Vector3.zero, dist = math.huge }

function Fx.isFar(pos: Vector3): boolean
	local dx, dz = pos.X - Cull.focus.X, pos.Z - Cull.focus.Z
	return dx * dx + dz * dz > Cull.dist * Cull.dist
end

local function cullTick(objects: Instance)
	local me = Players.LocalPlayer.Character
	local c = me and Fx.holeCenter(me)
	if not c then
		return
	end
	local rawR = me and me:GetAttribute("HoleR")
	local r = type(rawR) == "number" and shownRadius(me :: Model, rawR) or 5
	Cull.focus = c
	Cull.dist = math.clamp(350 + r * 12, 350, 6000)
	if not Cull.folder then
		local f = Instance.new("Folder")
		f.Name = "CulledObjects"
		f.Parent = ReplicatedStorage
		Cull.folder = f
	end
	local culled = Cull.folder :: Folder
	local function pivotOf(m: Model): Vector3
		local p = Cull.pivots[m]
		if not p then
			p = m:GetPivot().Position
			Cull.pivots[m] = p
		end
		return p
	end
	for _, m in ipairs(objects:GetChildren()) do
		if m:IsA("Model") and not m:GetAttribute("EatenBy") and Fx.isFar(pivotOf(m)) then
			m:SetAttribute("Culled", true)
			m.Parent = culled
		end
	end
	for _, m in ipairs(culled:GetChildren()) do
		if m:IsA("Model") and not Fx.isFar(pivotOf(m)) then
			m:SetAttribute("Unculling", true)
			m.Parent = objects
			m:SetAttribute("Unculling", nil)
			m:SetAttribute("Culled", nil)
		end
	end
end

------------------------------------------------------------------------
-- 시작
------------------------------------------------------------------------
function Fx.start()
	for _, player in ipairs(Players:GetPlayers()) do
		watchPlayer(player)
	end
	Players.PlayerAdded:Connect(watchPlayer)
	task.spawn(function()
		local objects = workspace:WaitForChild("Objects")
		for _, m in ipairs(objects:GetChildren()) do
			watchObject(m)
		end
		objects.ChildAdded:Connect(watchObject)
		-- 처음 물체들이 다 내려오기 전에는 뿅 연출을 하지 않는다
		task.delay(4, function()
			readyAt = os.clock()
		end)
	end)
	task.spawn(buildGallery)
	task.spawn(function()
		local objects = workspace:WaitForChild("Objects")
		task.wait(3)
		while true do
			local ok, err = pcall(cullTick, objects)
			if not ok then
				warn("[BlackHole] 물체 숨기기 오류:", err)
			end
			task.wait(0.4)
		end
	end)
	local galleryCheck = 0
	RunService.RenderStepped:Connect(function(dt: number)
		local t = os.clock()
		for char, h in pairs(holes) do
			if not char.Parent then
				destroyHole(h)
				holes[char] = nil
			else
				updateHole(h, t, dt)
			end
		end
		-- 전시관은 카메라가 가까울 때만 움직인다
		if t > galleryCheck then
			galleryCheck = t + 0.5
			-- 로비에 들어가고 나올 때 블랙홀 크기 바꾸기
			for char, h in pairs(holes) do
				local raw = char:GetAttribute("HoleR")
				if type(raw) == "number" and math.abs(shownRadius(char, raw) - h.target) > 0.01 then
					syncHole(char)
				end
			end
			local cam = workspace.CurrentCamera
			local cp = cam and cam.CFrame.Position or Vector3.zero
			for _, g in ipairs(gallery) do
				local c = g.hole.center or Vector3.zero
				g.hole.active = (c - cp).Magnitude < 450
			end
		end
		for _, h in ipairs(previews) do
			if h.active then
				updateHole(h, t, dt)
			end
		end
		planetTick(t)
	end)
end

return Fx
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
  <Item class="Workspace" referent="14">
    <Properties>
      <string name="Name">Workspace</string>
      <float name="Gravity">196.2</float>
      <bool name="NeedsPivotMigration">false</bool>
      <bool name="StreamingEnabled">false</bool>
    </Properties>
  </Item>
</roblox>
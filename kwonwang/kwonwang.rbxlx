    <Item class="Script" referent="6">
      <Properties>
        <string name="Name">KwonServer</string>
        <token name="RunContext">0</token>
        <string name="Source"><![CDATA[-- 권왕(拳王): 맨손의 강호 — 서버
-- 기록, 캐릭터, 기술 확인, 수련, 상점, 권법 배우기
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local DataStoreService = game:GetService("DataStoreService")
local RunService = game:GetService("RunService")

local Config = require(ReplicatedStorage:WaitForChild("Config"))
local World = require(script:WaitForChild("World"))
local Combat = require(script:WaitForChild("Combat"))
local Npc = require(script:WaitForChild("Npc"))
local Skills = require(script:WaitForChild("Skills"))

local DATASTORE_NAME = "Kwonwang_v1"
local SAVE_INTERVAL = 90

------------------------------------------------------------------------
-- 통신
------------------------------------------------------------------------
local remotes = Instance.new("Folder")
remotes.Name = "KwonRemotes"
local Request = Instance.new("RemoteEvent")
Request.Name = "Request"
Request.Parent = remotes
local Push = Instance.new("RemoteEvent")
Push.Name = "Push"
Push.Parent = remotes
remotes.Parent = ReplicatedStorage

------------------------------------------------------------------------
-- 기록
------------------------------------------------------------------------
type Profile = {
	coins: number,
	stats: { [string]: number },
	styles: { [string]: boolean },
	style: string, -- "" = 아직 안 골랐다
	mastery: { [string]: { lv: number, xp: number } },
	potions: number,
	elixirUntil: number,
	kills: number,
	bosses: { [string]: number },
	pvpWins: number,
	found: { [string]: boolean }, -- 찾아낸 사부
	trials: { [string]: boolean }, -- 넘은 사부의 시험
	story: number, -- 이야기 몇째 장
	prog: number, -- 그 장의 진행
	fragments: { [string]: boolean }, -- 주운 비급 조각
	stamina: number,
	staminaAt: number,
	gradeUp: { [string]: number }, -- 권법 승급 (깨달음) 횟수
}

local function defaultProfile(): Profile
	return {
		coins = 0,
		stats = { str = 0, vit = 0, agi = 0, chi = 0 },
		styles = {},
		style = "",
		mastery = {},
		potions = 2,
		elixirUntil = 0,
		kills = 0,
		bosses = {},
		pvpWins = 0,
		found = {},
		trials = {},
		story = 1,
		prog = 0,
		fragments = {},
		stamina = Config.STAMINA.max,
		staminaAt = os.time(),
		gradeUp = {},
	}
end

local function sanitize(data: any): Profile
	local p = defaultProfile()
	if type(data) ~= "table" then
		return p
	end
	local function num(v: any, hi: number): number
		if type(v) ~= "number" or v ~= v then
			return 0
		end
		return math.clamp(v, 0, hi)
	end
	p.coins = math.floor(num(data.coins, 1e12))
	if type(data.stats) == "table" then
		for _, s in ipairs(Config.Stats) do
			p.stats[s.id] = math.floor(num(data.stats[s.id], 1e9))
		end
	end
	if type(data.styles) == "table" then
		for id, v in pairs(data.styles) do
			if type(id) == "string" and Config.STYLE_BY_ID[id] and v == true then
				p.styles[id] = true
			end
		end
	end
	if type(data.style) == "string" and p.styles[data.style] then
		p.style = data.style
	end
	if type(data.mastery) == "table" then
		for id, m in pairs(data.mastery) do
			if type(id) == "string" and Config.STYLE_BY_ID[id] and type(m) == "table" then
				p.mastery[id] = { lv = math.clamp(math.floor(num(m.lv, Config.MASTERY_MAX)), 1, Config.MASTERY_MAX), xp = num(m.xp, 1e9) }
			end
		end
	end
	p.potions = math.floor(num(data.potions, 5))
	p.elixirUntil = num(data.elixirUntil, 1e11)
	p.kills = math.floor(num(data.kills, 1e9))
	if type(data.bosses) == "table" then
		for id, n in pairs(data.bosses) do
			if type(id) == "string" and Config.Bosses[id] then
				p.bosses[id] = math.floor(num(n, 1e9))
			end
		end
	end
	p.pvpWins = math.floor(num(data.pvpWins, 1e9))
	local function flags(src: any, valid: (string) -> boolean): { [string]: boolean }
		local out = {}
		if type(src) == "table" then
			for k, v in pairs(src) do
				if type(k) == "string" and v == true and valid(k) then
					out[k] = true
				end
			end
		end
		return out
	end
	p.found = flags(data.found, function(k)
		return Config.MASTERS[k] ~= nil
	end)
	p.trials = flags(data.trials, function(k)
		return Config.MASTERS[k] ~= nil
	end)
	p.fragments = flags(data.fragments, function(k)
		local i = tonumber(k)
		return i ~= nil and Config.Fragments[i] ~= nil
	end)
	if type(data.gradeUp) == "table" then
		for id, v in pairs(data.gradeUp) do
			if type(id) == "string" and Config.STYLE_BY_ID[id] and type(v) == "number" then
				p.gradeUp[id] = math.clamp(math.floor(v), 0, #Config.BREAKTHROUGH)
			end
		end
	end
	p.story = math.clamp(math.floor(num(data.story, #Config.Story)), 1, #Config.Story)
	p.prog = math.floor(num(data.prog, 1e6))
	p.stamina = type(data.stamina) == "number" and num(data.stamina, Config.STAMINA.max) or Config.STAMINA.max
	p.staminaAt = type(data.staminaAt) == "number" and num(data.staminaAt, 1e11) or os.time()
	return p
end

type State = {
	canSave: boolean,
	dirty: boolean,
	tester: boolean,
	reqWindow: number,
	reqCount: number,
	training: any?,
	trainAt: number,
	ringIdx: number,
	potionAt: number,
	charConn: RBXScriptConnection?,
	tpIdx: number?,
	simmaAt: number?,
}

local profiles: { [Player]: Profile } = {}
local states: { [Player]: State } = {}

local store: DataStore? = nil
do
	local ok, ds = pcall(function()
		return DataStoreService:GetDataStore(DATASTORE_NAME)
	end)
	if ok then
		store = ds
	end
end

local function loadProfile(player: Player): (Profile, boolean)
	local ds = store
	if not ds then
		return defaultProfile(), false
	end
	for attempt = 1, 3 do
		local ok, result = pcall(function()
			return ds:GetAsync("p_" .. player.UserId)
		end)
		if ok then
			return sanitize(result), true
		end
		task.wait(attempt)
	end
	return defaultProfile(), false
end

local function saveProfile(player: Player)
	local p, st = profiles[player], states[player]
	local ds = store
	if not p or not st or not st.canSave or not ds then
		return
	end
	local ok = pcall(function()
		ds:SetAsync("p_" .. player.UserId, p)
	end)
	if ok then
		st.dirty = false
	end
end

local function isTester(player: Player): boolean
	if not Config.TEST_MODE then
		return false
	end
	if RunService:IsStudio() then
		return true
	end
	return game.CreatorType == Enum.CreatorType.User and player.UserId == game.CreatorId
end

------------------------------------------------------------------------
-- 계산
------------------------------------------------------------------------
local Calc = {}

function Calc.total(p: Profile): number
	local t = 0
	for _, s in ipairs(Config.Stats) do
		t += p.stats[s.id] or 0
	end
	return t
end

function Calc.mastery(p: Profile, styleId: string): { lv: number, xp: number }
	local m = p.mastery[styleId]
	if not m then
		m = { lv = 1, xp = 0 }
		p.mastery[styleId] = m
	end
	return m
end

function Calc.unlocked(p: Profile, slot: string): boolean
	if p.style == "" then
		return false
	end
	local need = Config.SKILL_UNLOCK[slot]
	if not need then
		return true
	end
	return Calc.mastery(p, p.style).lv >= need
end

------------------------------------------------------------------------
-- 상태 보내기와 이름표
------------------------------------------------------------------------
local function toast(player: Player, text: string)
	Push:FireClient(player, "toast", text)
end

local function pushState(player: Player)
	local p, st = profiles[player], states[player]
	if not p or not st then
		return
	end
	local idx, realm = Config.realmOf(Calc.total(p))
	local mastery = {}
	for id in pairs(p.styles) do
		local m = Calc.mastery(p, id)
		mastery[id] = { lv = m.lv, xp = m.xp, need = Config.masteryNeed(m.lv) }
	end
	local owned = {}
	for id in pairs(p.styles) do
		table.insert(owned, id)
	end
	Push:FireClient(player, "state", {
		coins = p.coins,
		stats = p.stats,
		total = Calc.total(p),
		realm = idx,
		realmName = realm.name,
		styles = owned,
		style = p.style,
		mastery = mastery,
		potions = p.potions,
		elixirLeft = math.max(0, p.elixirUntil - os.time()),
		kills = p.kills,
		bosses = p.bosses,
		pvpWins = p.pvpWins,
		learnCost = Config.LEARN_COST[math.min(#owned + 1, #Config.LEARN_COST)],
		training = st.training and st.training.kind or nil,
		tester = st.tester,
		canSave = st.canSave,
		found = p.found,
		trials = p.trials,
		story = p.story,
		prog = p.prog,
		fragments = p.fragments,
		stamina = math.floor(p.stamina),
		gradeUp = p.gradeUp,
		power = (function()
			local f = Combat.fighterOfPlayer(player)
			return f and (f :: any).power or 0
		end)(),
	})
end

local function updateTag(player: Player)
	local p = profiles[player]
	local char = player.Character
	local head = char and char:FindFirstChild("Head")
	if not p or not head then
		return
	end
	local _, realm = Config.realmOf(Calc.total(p))
	local style = Config.STYLE_BY_ID[p.style]
	local gui = head:FindFirstChild("KwonTag") :: BillboardGui?
	if not gui then
		local g = Instance.new("BillboardGui")
		g.Name = "KwonTag"
		g.Size = UDim2.new(0, 300, 0, 60)
		g.StudsOffset = Vector3.new(0, 2.6, 0)
		g.AlwaysOnTop = true
		g.LightInfluence = 0
		g.MaxDistance = 120
		local top = Instance.new("TextLabel")
		top.Name = "Top"
		top.BackgroundTransparency = 1
		top.Size = UDim2.fromScale(1, 0.55)
		top.Font = Enum.Font.GothamBlack
		top.TextScaled = true
		top.TextStrokeTransparency = 0.3
		top.Parent = g
		local bottom = Instance.new("TextLabel")
		bottom.Name = "Bottom"
		bottom.BackgroundTransparency = 1
		bottom.Position = UDim2.fromScale(0, 0.55)
		bottom.Size = UDim2.fromScale(1, 0.45)
		bottom.Font = Enum.Font.GothamBold
		bottom.TextScaled = true
		bottom.TextStrokeTransparency = 0.3
		bottom.Parent = g
		g.Parent = head
		gui = g
	end
	local g = gui :: BillboardGui
	local top = g:FindFirstChild("Top") :: TextLabel
	local bottom = g:FindFirstChild("Bottom") :: TextLabel
	top.Text = string.format("[%s] %s", realm.name, player.DisplayName)
	top.TextColor3 = realm.color
	bottom.Text = style and (style.icon .. " " .. style.name) or "권법 없음"
	bottom.TextColor3 = style and style.color or Color3.fromRGB(200, 200, 200)
	char:SetAttribute("Realm", realm.name)
	local ls = player:FindFirstChild("leaderstats")
	if ls then
		local rv = ls:FindFirstChild("경지")
		if rv and rv:IsA("StringValue") then
			rv.Value = realm.name
		end
		local cv = ls:FindFirstChild("은자")
		if cv and cv:IsA("StringValue") then
			cv.Value = Config.formatNumber(p.coins)
		end
	end
end

-- 능력치·권법·숙련이 바뀌면 무인 수치를 다시 맞춘다
local function refreshFighter(player: Player)
	local p = profiles[player]
	local f = Combat.fighterOfPlayer(player)
	if not p or not f then
		return
	end
	local idx = Config.realmOf(Calc.total(p))
	local m = p.style ~= "" and Calc.mastery(p, p.style).lv or 1
	f.style = p.style
	-- 경지 배율: 경지가 오를 때마다 피해·체력이 크게 오른다
	local power = Config.realmPower(idx)
	local styleDef = Config.STYLE_BY_ID[p.style]
	local grade = styleDef and Config.GRADES[Config.styleGrade(styleDef, p.gradeUp[p.style])] or 1
	f.dmgMult = Config.statMult(p.stats.str) * (1 + 0.03 * (m - 1)) * power * grade
	f.skillMult = math.sqrt(Config.statMult(p.stats.chi))
	local oldMax = f.maxHp
	f.maxHp = math.floor(Config.maxHp(p.stats.vit) * power)
	if oldMax > 0 then
		f.hp = math.min(f.maxHp, f.hp * f.maxHp / oldMax)
	end
	f.walk = Config.walkSpeed(p.stats.agi) * (styleDef and Config.gradeWalk(styleDef, p.gradeUp[p.style]) or 1)
	local cm = Config.chiMax(p.stats.chi, idx)
	;(f :: any).chiMax = cm
	f.model:SetAttribute("ChiMax", cm)
	local cp = Config.playerPower(f.dmgMult, f.maxHp)
	;(f :: any).power = cp
	f.model:SetAttribute("Power", cp)
	f.model:SetAttribute("Awaken", Config.awakenTier(m))
	Combat.sync(f)
	updateTag(player)
end

------------------------------------------------------------------------
-- 쓰러짐과 보상
------------------------------------------------------------------------
local function respawnPlayer(player: Player)
	local f = Combat.fighterOfPlayer(player)
	if not f then
		return
	end
	f.dead = false
	f.hp = f.maxHp
	f.posture = 0
	f.stunUntil = 0
	f.brokenUntil = 0
	f.act = nil
	f.iframeUntil = os.clock() + 2
	Combat.sync(f)
	local char = player.Character
	if char then
		char:PivotTo(CFrame.new(Config.SPAWN))
	end
	Push:FireClient(player, "respawn")
end

local function addMastery(player: Player, p: Profile, amount: number)
	if p.style == "" then
		return
	end
	local m = Calc.mastery(p, p.style)
	if m.lv >= Config.MASTERY_MAX then
		return
	end
	m.xp += amount
	local leveled = false
	while m.lv < Config.MASTERY_MAX and m.xp >= Config.masteryNeed(m.lv) do
		m.xp -= Config.masteryNeed(m.lv)
		m.lv += 1
		leveled = true
	end
	if leveled then
		local style = Config.STYLE_BY_ID[p.style]
		local unlocked = nil
		for slot, need in pairs(Config.SKILL_UNLOCK) do
			if need == m.lv then
				unlocked = style.skills[slot].name .. " (" .. slot .. ")"
			end
		end
		local awaken = nil
		for tier, a in ipairs(Config.AWAKEN) do
			if a.lv == m.lv then
				awaken = tier
			end
		end
		Push:FireClient(player, "mastery", { style = p.style, lv = m.lv, unlocked = unlocked, awaken = awaken })
		refreshFighter(player)
		pushState(player)
	end
	states[player].dirty = true
end

------------------------------------------------------------------------
-- 강호 이야기 (차례로 이어지는 장)
------------------------------------------------------------------------
local Story = {}

local function countKeys(t: { [any]: any }): number
	local n = 0
	for _ in pairs(t) do
		n += 1
	end
	return n
end

-- 권법을 준다 (이야기·숨은 권법)
local function grantStyle(player: Player, id: string, banner: boolean?)
	local p = profiles[player]
	if not p or p.styles[id] then
		return
	end
	p.styles[id] = true
	Calc.mastery(p, id)
	if banner then
		Push:FireClient(player, "learned", { style = id, hidden = Config.STYLE_BY_ID[id].hidden == true })
	end
	local st = states[player]
	if st then
		st.dirty = true
	end
end

function Story.done(p: Profile, g: any): boolean
	local k = g.kind
	if k == "kill" or k == "train" or k == "trial" or k == "boss" then
		return p.prog >= (g.n or 1)
	elseif k == "found" then
		return countKeys(p.found) >= g.n
	elseif k == "learn" then
		if g.id then
			return p.styles[g.id] == true
		end
		return countKeys(p.styles) >= g.n
	elseif k == "realm" then
		return Config.realmOf(Calc.total(p)) >= g.n
	elseif k == "fragment" then
		return countKeys(p.fragments) >= g.n
	end
	return false
end

function Story.advance(player: Player)
	local p = profiles[player]
	for _ = 1, 3 do
		local ch = p and Config.Story[p.story]
		if not ch or ch.goal.kind == "done" then
			break
		end
		local r = ch.reward or {}
		p.coins += r.coins or 0
		for _, stat in ipairs(Config.Stats) do
			p.stats[stat.id] += r.stats or 0
		end
		p.story = math.min(#Config.Story, p.story + 1)
		p.prog = 0
		Push:FireClient(player, "storyDone", { title = ch.title, coins = r.coins, stats = r.stats, next = Config.Story[p.story].title })
		-- 다음 장이 이미 이뤄졌다면 (경지 등) 이어서 넘긴다
		local nxt = Config.Story[p.story]
		if not (nxt.goal.kind ~= "talk" and nxt.goal.kind ~= "kill" and nxt.goal.kind ~= "train" and nxt.goal.kind ~= "trial" and nxt.goal.kind ~= "boss" and Story.done(p, nxt.goal)) then
			break
		end
	end
	states[player].dirty = true
	refreshFighter(player)
	pushState(player)
end

-- 무슨 일이 일어났다 (적을 쓰러뜨림, 수련, 시험 통과 ...)
function Story.event(player: Player, kind: string, id: string?, amount: number?)
	local p = profiles[player]
	local ch = p and Config.Story[p.story]
	if not ch then
		return
	end
	local g = ch.goal
	if g.kind == kind and (g.id == nil or g.id == id) then
		p.prog += amount or 1
		Push:FireClient(player, "storyProg", { prog = p.prog })
	end
	if Story.done(p, g) then
		Story.advance(player)
	end
end

-- 경지·권법 수처럼 저절로 이뤄지는 목표를 다시 본다
function Story.check(player: Player)
	Story.event(player, "check")
end

-- 청운 장로와 이야기
function Story.talk(player: Player)
	local p = profiles[player]
	local ch = p and Config.Story[p.story]
	if not ch then
		return
	end
	Push:FireClient(player, "dialog", { who = "청운 장로", title = ch.title, text = ch.text })
	if ch.goal.kind == "talk" then
		Story.advance(player)
	end
end

------------------------------------------------------------------------
-- 사부의 시험: 사부가 기운으로 빚은 분신과 겨룬다
------------------------------------------------------------------------
local Trial = {}
local activeTrial: { [Player]: any } = {}

local function trialDef(style: any, master: any): any
	local moves = {}
	local list = table.clone(style.combo)
	table.insert(list, style.heavy)
	for _, m in ipairs(list) do
		if m.hits and #m.hits > 0 then
			local shift = 0.35
			local hits = {}
			for _, h in ipairs(m.hits) do
				local c = table.clone(h)
				c.t = h.t + shift
				c.dmg = h.dmg * 1.4
				table.insert(hits, c)
			end
			table.insert(moves, { id = m.id .. "T", name = m.name, pose = m.pose, windup = m.hits[1].t + shift, dur = m.dur + shift, range = (m.hits[1].range or 5) + 1, lunge = m.lunge, hits = hits })
		end
	end
	return {
		name = master.name .. "의 분신", hp = 420, posture = 220, speed = 19, aggro = 90, keep = 4, scale = 1.15, elite = true, duel = true,
		shirt = style.color, pants = style.color:Lerp(Color3.new(0, 0, 0), 0.5), style = style.id, coins = 0, xp = 80, moves = moves,
	}
end

function Trial.start(player: Player, styleId: string)
	local style = Config.STYLE_BY_ID[styleId]
	local master = Config.MASTERS[styleId]
	local f = Combat.fighterOfPlayer(player)
	if not style or not master or not f or f.dead then
		return
	end
	if activeTrial[player] then
		toast(player, "이미 시험 중이에요")
		return
	end
	local key = "trial_" .. styleId
	Config.Enemies[key] = trialDef(style, master)
	local e = Npc.spawn(key, false, master.at + (f.root.Position - master.at).Unit * 6, "trial")
	if not e then
		return
	end
	local ef = e.f :: any
	ef.trialOwner = player
	ef.trialStyle = styleId
	-- 분신은 시험을 청한 사람과 비슷한 힘으로 (센 사람에게도 시험이 시험이도록)
	local want = ((f :: any).power or 100) * (style.secret and 1.15 or 0.85)
	local k = want / math.max(1, ef.power or 100)
	if k > 1 then
		ef.maxHp = math.floor(ef.maxHp * k)
		ef.hp = ef.maxHp
		ef.dmgMult *= k
		ef.power = math.floor(want)
		ef.model:SetAttribute("Power", ef.power)
		Combat.sync(ef)
	end
	e.target = f
	ef.model:SetAttribute("Style", styleId)
	activeTrial[player] = ef
	Push:FireClient(player, "dialog", { who = master.name, title = "사부의 시험", text = "내 권법을 원하는가. 그럼 내 분신을 꺾어 보아라. 마구 휘두르는 주먹은 통하지 않는다." })
	Push:FireClient(player, "trial", { m = ef.model, name = master.name, style = styleId })
	-- 너무 오래 끌면 사부가 거둔다
	task.delay(150, function()
		if activeTrial[player] == ef and not ef.dead then
			activeTrial[player] = nil
			Npc.despawn(ef)
			toast(player, "⌛ 시험 시간이 다 됐어요. 다시 청하세요")
		end
	end)
end

function Trial.ended(player: Player, won: boolean)
	local ef = activeTrial[player]
	if not ef then
		return
	end
	activeTrial[player] = nil
	local p = profiles[player]
	if won and p then
		local id = ef.trialStyle
		p.trials[id] = true
		local style = Config.STYLE_BY_ID[id]
		Push:FireClient(player, "trialWin", { style = id, master = Config.MASTERS[id].name })
		toast(player, string.format("🥋 시험 통과! 이제 %s을(를) 배울 수 있어요 (사부 곁에서 T)", style.name))
		states[player].dirty = true
		Story.event(player, "trial")
		pushState(player)
	elseif not ef.dead then
		Npc.despawn(ef)
	end
end

Skills.init(Push)
Combat.init(Push, {
	onKill = function(f: any, by: any)
		if f.npc then
			Npc.onDeath(f)
			local killer = by and by.player
			local p = killer and profiles[killer]
			if killer and p then
				local isBoss = f.model:GetAttribute("Boss") == true
				-- 이야기·시험
				if f.trialOwner == killer then
					Trial.ended(killer, true)
				end
				local isBossKill = f.model:GetAttribute("Boss") == true
				if isBossKill then
					for id, def in pairs(Config.Bosses) do
						if def == f.npc then
							Story.event(killer, "boss", id)
							-- 혈마를 꺾으면 그 손이 넘어온다
							if id == "hyeolma" then
								grantStyle(killer, "hyeolma", true)
							end
						end
					end
				elseif f.typeId then
					Story.event(killer, "kill", f.typeId)
				end
				-- 심마를 이긴 주인: 모든 능력치가 크게 오른다
				if f.simmaOwner == killer then
					local ridx = Config.realmOf(Calc.total(p))
					local gain = math.floor(Config.Training.simma.reward * (1 + 0.25 * (ridx - 1)))
					for _, st in ipairs(Config.Stats) do
						p.stats[st.id] += gain
					end
					Push:FireClient(killer, "simmaWin", { gain = gain })
					refreshFighter(killer)
					Story.check(killer)
				end
				local coins = math.floor(f.npc.coins * (f.rewardMult or 1))
				local xp = math.floor(f.npc.xp * (f.rewardMult or 1))
				p.coins += coins
				p.kills += 1
				if isBoss then
					for id, def in pairs(Config.Bosses) do
						if def == f.npc then
							p.bosses[id] = (p.bosses[id] or 0) + 1
						end
					end
				end
				addMastery(killer, p, xp)
				states[killer].dirty = true
				Push:FireClient(killer, "reward", { coins = coins, xp = xp, name = f.name, boss = isBoss })
				updateTag(killer)
				pushState(killer)
			end
		elseif f.player then
			local player = f.player
			Trial.ended(player, false)
			-- 비무대에서 이기면 기록
			local winner = by and by.player
			if winner and profiles[winner] then
				profiles[winner].pvpWins += 1
				states[winner].dirty = true
				Push:FireAllClients("duel", { winner = winner.DisplayName, loser = player.DisplayName })
				pushState(winner)
			end
			task.delay(Config.RESPAWN_TIME, function()
				if player.Parent then
					respawnPlayer(player)
				end
			end)
		end
	end,
	onHit = function(att: any, _tgt: any, dmg: number, opt: any)
		if att.player and not opt.chain then
			local p = profiles[att.player]
			if p then
				addMastery(att.player, p, 1 + dmg * 0.05)
			end
		end
	end,
	onDeflect = function(tgt: any, _att: any)
		if tgt.player then
			local p = profiles[tgt.player]
			if p then
				addMastery(tgt.player, p, 3)
			end
		end
	end,
})

------------------------------------------------------------------------
-- 맵과 적
------------------------------------------------------------------------
-- 맵을 먼저 짓고, 요청·사부·적은 아래에서 차례로 (적 만들기가 늦거나 틀려도 나머지는 돈다)
pcall(World.setupLighting)
local okWorld, builtWorld = pcall(World.build)
if not okWorld then
	warn("[권왕] 맵 만들기 오류:", builtWorld)
end
local W: any = okWorld and builtWorld or { train = {}, rings = {} }
Npc.init(Push)

task.spawn(function()
	local dt = 0.05
	while true do
		task.wait(dt)
		local ok, err = pcall(Combat.tick, dt)
		if not ok then
			warn("[권왕] 싸움 틱 오류:", err)
		end
	end
end)

------------------------------------------------------------------------
-- 기술 쓰기 (화면이 먼저 움직이고 알려 준다)
------------------------------------------------------------------------
local Actions = {}

local function nearestHostile(f: any, range: number): any?
	local best, bestD = nil, range
	for _, other in pairs(Combat.fighters) do
		if Combat.hostile(f, other) then
			local d = (other.root.Position - f.root.Position).Magnitude
			if d < bestD then
				best, bestD = other, d
			end
		end
	end
	return best
end

-- 완전 각성: 그림자 메아리가 같은 기술을 한 번 더 (절반 위력)
local function echoAct(f: any, move: any, slot: any, speed: number, dmgScale: number)
	local A = Config.AWAKEN[2]
	task.delay(A.echoDelay, function()
		if f.dead or not f.model.Parent then
			return
		end
		Push:FireAllClients("echo", { m = f.model, style = f.style, slot = slot, pose = move.pose, dur = move.dur / speed })
		for _, h in ipairs(move.hits or {}) do
			task.delay(h.t / speed, function()
				if f.dead then
					return
				end
				local eh = table.clone(h)
				eh.dmg *= A.echo * dmgScale
				eh.posture *= A.echo
				for _, victim in ipairs(Combat.query(f, eh)) do
					Combat.applyHit(f, victim, eh, { move = move, isSkill = true, chain = true })
				end
			end)
		end
		if move.proj then
			task.delay(move.dur / speed * 0.42, function()
				if not f.dead then
					Combat.fire(f, move.proj, 0.6, { move = move, isSkill = true })
				end
			end)
		end
	end)
end

function Actions.act(player: Player, slotArg: any, seqArg: any, chargeArg: any, perfectArg: any)
	local p = profiles[player]
	local f = Combat.fighterOfPlayer(player)
	if not p or not f or p.style == "" then
		return
	end
	local style = Config.STYLE_BY_ID[p.style]
	local slot: any = slotArg
	if type(slot) == "number" then
		slot = math.floor(slot)
		if slot < 1 or slot > #style.combo then
			return
		end
	elseif slot ~= "H" and slot ~= "E" and slot ~= "R" and slot ~= "G" and slot ~= "F" and not Config.ACTION_MOVES[slot] then
		return
	end
	local seq = math.floor(tonumber(seqArg) or 0)
	local move = Config.move(p.style, slot)
	if not move then
		return
	end
	local t = os.clock()
	if f.dead or Combat.stunned(f) then
		return
	end
	-- 몸놀림 기술은 그 순간에만: 대시 직후, 공중, 흘리기 직후
	local fa = f :: any
	if slot == "D" and t - (f.dashAt or 0) > Config.ACTION_WINDOW.D + 0.15 then
		return
	elseif slot == "A" then
		if not f.hum or f.hum.FloorMaterial ~= Enum.Material.Air or t - (fa.airAtkAt or 0) < 0.8 then
			return
		end
		fa.airAtkAt = t
	elseif slot == "C" then
		if t - (fa.deflectAt or 0) > Config.ACTION_WINDOW.C + 0.15 then
			return
		end
		fa.deflectAt = 0
	elseif slot == "J" then
		-- 공중 연격: 공중에서, 1.5초 안에 세 번까지
		if not f.hum or f.hum.FloorMaterial ~= Enum.Material.Air then
			return
		end
		if t - (fa.airJAt or 0) > 1.5 then
			fa.airJCount = 0
		end
		if (fa.airJCount or 0) >= 3 then
			return
		end
		fa.airJCount = (fa.airJCount or 0) + 1
		fa.airJAt = t
	end
	-- 각성 단계 (숙련 6 / 10)
	local tier = Config.awakenTier(Calc.mastery(p, p.style).lv)
	if slot == "F" and (tier < 1 or fa.lastSlot ~= #style.combo or t - (fa.lastSlotAt or 0) > 1.6) then
		return
	end
	-- 앞 기술이 거의 끝났을 때만 다음 기술 (연타는 70%부터 이어진다)
	local act = f.act
	if act and t < act.start + act.dur * (type(slot) == "number" and 0.7 or 0.85) and slot ~= "C" then
		return
	end
	if slot == "E" or slot == "R" or slot == "G" then
		if not Calc.unlocked(p, slot) then
			toast(player, string.format("🔒 %s: 숙련도 %d에 열려요", move.name, Config.SKILL_UNLOCK[slot]))
			return
		end
		if t < (f.cds[slot] or 0) then
			return
		end
		local cost = move.chi or 0
		if f.chi < cost then
			toast(player, string.format("내공이 부족해요 (🌀 %d 필요)", cost))
			return
		end
		f.chi -= cost
		f.cds[slot] = t + (move.cd or 0) * (tier > 0 and Config.AWAKEN[tier].cd or 1)
	end
	local speed = Config.actSpeed(style, p.gradeUp[p.style], (f.buffs.frenzy or 0) > t)
	local charge = 0
	if slot == "H" and style.charge then
		charge = math.clamp(tonumber(chargeArg) or 0, 0, style.charge)
	end
	local bloom = false
	local dmgScale = 1
	if slot == "H" then
		if style.id == "maehwa" and f.stacks.petal >= 20 then
			bloom = true
			f.stacks.petal = 0
		elseif style.id == "taeheo" and f.stacks.flow > 0 then
			dmgScale = 1 + (move.stackDmg or 0.5) * f.stacks.flow
			f.stacks.flow = 0
		end
	end
	-- 무영 그림자 걸음: 가장 가까운 적의 등 뒤로
	local teleported = false
	if move.teleport then
		local tgt = nearestHostile(f, move.teleport)
		if not tgt then
			toast(player, "가까이에 상대가 없어요")
			f.chi += move.chi or 0
			f.cds[slot] = 0
			return
		end
		local behind = tgt.root.Position - Combat.look(tgt) * 3.5
		local char = player.Character
		if char then
			char:PivotTo(CFrame.lookAt(behind + Vector3.new(0, 0.5, 0), Vector3.new(tgt.root.Position.X, behind.Y + 0.5, tgt.root.Position.Z)))
		end
		teleported = true
		Push:FireAllClients("blink", f.model, behind)
	end
	-- 박자: 앞 연타가 끝나 갈 즈음 정확히 이었는가 (화면이 알려 준 것을 서버가 넉넉히 다시 본다)
	local perfect = false
	local prev = fa.lastAct
	if perfectArg == true and (type(slot) == "number" and slot > 1 or slot == "F") and prev then
		local frac = (t - prev.start) / math.max(0.05, prev.dur)
		perfect = frac >= 0.45 and frac <= 1.0 + 0.45 / math.max(0.05, prev.dur)
	end
	if type(slot) == "number" or slot == "F" then
		if perfect then
			fa.perfectChain = (fa.perfectChain or 0) + 1
			fa.sloppy = math.max(0, (fa.sloppy or 0) - 2)
			dmgScale *= Config.RHYTHM.bonus * (fa.perfectChain >= Config.RHYTHM.chain and Config.RHYTHM.chainBonus or 1)
		else
			if slot ~= 1 then
				fa.perfectChain = 0
			end
			fa.sloppy = math.min(6, (fa.sloppy or 0) + 1)
		end
	end
	-- 각성: 기술이 세진다 (완전 각성이면 연타까지 모두)
	if tier >= 2 or (tier == 1 and type(slot) == "string") then
		dmgScale *= Config.AWAKEN[tier].dmg
	end
	local first = move.hits and move.hits[1]
	local newAct = Combat.begin(f, move, slot, seq, { speed = speed, charge = charge, bloom = bloom, align = first and first.t / speed or nil })
	;(newAct :: any).dmgScale = dmgScale
	;(newAct :: any).perfect = perfect
	fa.lastSlot = slot
	fa.lastSlotAt = t
	fa.lastAct = newAct
	if tier >= 2 and (slot == "E" or slot == "R" or slot == "H" or slot == "F" or slot == "G") then
		echoAct(f, move, slot, speed, dmgScale)
	end
	;(newAct :: any).teleport = teleported
	-- 권법마다 다른 기술 장치
	if move.mech then
		Skills.run(f, move, { scale = dmgScale, speed = speed })
	end
	if move.buff then
		f.buffs[move.buff.kind] = t + move.buff.dur
		f.model:SetAttribute("Buff", move.buff.kind)
		task.delay(move.buff.dur, function()
			if f.model:GetAttribute("Buff") == move.buff.kind and os.clock() >= (f.buffs[move.buff.kind] or 0) then
				f.model:SetAttribute("Buff", nil)
			end
		end)
	end
	if move.counter then
		f.counterUntil = t + move.counter
	end
	-- 장풍: 손을 내뻗는 순간 서버가 날린다
	if move.proj then
		local scale = 1
		if charge > 0 and move.chargeMult then
			scale = 1 + (move.chargeMult - 1) * charge / style.charge
		end
		task.delay(move.dur / speed * 0.42, function()
			if f.act == newAct and not f.dead then
				f.lastSwingAt = os.clock()
				Combat.fire(f, move.proj, scale, { move = move, isSkill = type(slot) == "string" and slot ~= "H" })
			end
		end)
	end
	Combat.sync(f)
end

-- 화면이 알려 준 맞힘
function Actions.hit(player: Player, seqArg: any, idxArg: any, targets: any)
	local f = Combat.fighterOfPlayer(player)
	if not f or f.dead then
		return
	end
	local act = f.act
	local seq = math.floor(tonumber(seqArg) or -99)
	local idx = math.floor(tonumber(idxArg) or 0)
	if not act or act.seq ~= seq then
		return
	end
	local move = act.move
	local h = move.hits and move.hits[idx]
	if not h then
		return
	end
	-- 시간 확인 (통신이 늦은 만큼 넉넉히)
	local t = os.clock()
	local due = act.start + h.t / act.speed
	if t < due - 0.3 or t > due + 0.7 then
		return
	end
	if not act.swung[idx] then
		act.swung[idx] = true
		f.lastSwingAt = t
	end
	local scale = (act :: any).dmgScale or 1
	local hit = h
	if scale ~= 1 then
		hit = table.clone(h)
		hit.dmg *= scale
		hit.posture *= scale
	end
	local isSkill = type(act.slot) == "string" and act.slot ~= "H"
	if type(targets) == "table" then
		local n = 0
		for _, m in ipairs(targets) do
			n += 1
			if n > 12 then
				break
			end
			local tgt = Combat.fighters[m :: Model] -- 등록된 무인만 (아무 값이나 오면 nil)
			if tgt then
				local key = idx .. ":" .. tostring(m)
				if not act.done[key] and Combat.plausible(f, tgt, h) then
					act.done[key] = true
					Combat.applyHit(f, tgt, hit, { move = move, act = act, isSkill = isSkill, teleport = (act :: any).teleport })
				end
			end
		end
	end
	-- 매화 만개: 첫 맞힘에 둘레로 꽃잎이 터진다
	if idx == 1 and act.bloom and not (act :: any).bloomDone then
		(act :: any).bloomDone = true
		local b = move.bloom
		Push:FireAllClients("bloom", f.model, b.radius)
		for _, victim in ipairs(Combat.query(f, { range = 0, radius = b.radius, aoe = true })) do
			Combat.applyHit(f, victim, { dmg = b.dmg, posture = b.posture, stun = 0.8, kb = 30, aoe = true }, { move = move, act = act, isSkill = true, chain = true })
		end
	end
end

function Actions.guard(player: Player, on: any)
	local f = Combat.fighterOfPlayer(player)
	if not f or f.dead then
		return
	end
	local want = on == true
	if want and (Combat.stunned(f) or Combat.busy(f)) then
		return
	end
	if want and not f.guarding then
		f.guardStart = os.clock()
	end
	f.guarding = want
	f.model:SetAttribute("Guard", want)
end

function Actions.dash(player: Player, kindArg: any)
	local p = profiles[player]
	local f = Combat.fighterOfPlayer(player)
	if not p or not f or f.dead or Combat.stunned(f) then
		return
	end
	local style = Config.STYLE_BY_ID[p.style]
	local cd = style and style.dashCd or Config.DASH_CD
	local charges = style and style.dashCharges or 1
	local t = os.clock()
	if t - f.dashAt > cd then
		f.dashUsed = 0
	end
	if f.dashUsed >= charges then
		return
	end
	f.dashUsed += 1
	f.dashAt = t
	f.iframeUntil = math.max(f.iframeUntil, t + Config.DASH_IFRAMES)
	f.guarding = false
	f.act = nil
	local kind = (kindArg == "back" or kindArg == "left" or kindArg == "right") and kindArg or "front"
	Push:FireAllClients("dash", f.model, kind)
end

function Actions.potion(player: Player)
	local p, st = profiles[player], states[player]
	local f = Combat.fighterOfPlayer(player)
	if not p or not st or not f or f.dead then
		return
	end
	if p.potions <= 0 then
		toast(player, "금창약이 없어요 (마을 만물상)")
		return
	end
	if os.clock() - st.potionAt < 4 then
		return
	end
	st.potionAt = os.clock()
	p.potions -= 1
	f.hp = math.min(f.maxHp, f.hp + f.maxHp * Config.POTION_HEAL)
	Combat.sync(f)
	st.dirty = true
	Push:FireAllClients("heal", f.model)
	pushState(player)
end

-- 권법 배우기 (처음 하나는 공짜) / 바꾸기
function Actions.learn(player: Player, id: any)
	local p, st = profiles[player], states[player]
	local style = type(id) == "string" and Config.STYLE_BY_ID[id]
	if not p or not st or not style then
		return
	end
	if not p.styles[style.id] then
		local count = 0
		for _ in pairs(p.styles) do
			count += 1
		end
		-- 기본 권법은 장로에게, 숨은 권법은 조건을 채워야, 사부의 권법은 사부를 찾아 시험을 넘어야
		if style.starter then
			toast(player, "삼재권은 청운 장로에게 받아요")
			return
		elseif style.hidden and not Config.MASTERS[style.id] then
			toast(player, "🔒 " .. (style.unlockHint or "숨겨진 권법"))
			return
		end
		local master = Config.MASTERS[style.id]
		if not master then
			return
		end
		if style.realmReq and Config.realmOf(Calc.total(p)) < style.realmReq then
			toast(player, string.format("🔒 %s은(는) %s의 경지에 올라야 익힐 수 있어요", style.name, Config.Realms[style.realmReq].name))
			return
		end
		if not p.found[style.id] then
			toast(player, "❓ 아직 이 권법의 사부를 찾지 못했어요. 소문: " .. (master.rumor or ""))
			return
		end
		local f0 = Combat.fighterOfPlayer(player)
		local pos = f0 and f0.root.Position
		local d = pos and Vector3.new(pos.X - master.at.X, 0, pos.Z - master.at.Z).Magnitude or math.huge
		if d > Config.MASTER_RANGE then
			toast(player, string.format("📍 %s을(를) 배우려면 %s의 %s에게 가야 해요", style.name, master.region, master.name))
			Push:FireClient(player, "guide", { style = style.id })
			return
		end
		if not p.trials[style.id] then
			Trial.start(player, style.id)
			return
		end
		local cost = Config.LEARN_COST[math.min(count + 1, #Config.LEARN_COST)]
		if p.coins < cost then
			toast(player, string.format("은자가 부족해요 (💰 %s 필요)", Config.formatNumber(cost)))
			return
		end
		p.coins -= cost
		p.styles[style.id] = true
		Calc.mastery(p, style.id)
		Push:FireClient(player, "learned", { style = style.id, first = count == 0 })
		Story.check(player)
	end
	local f = Combat.fighterOfPlayer(player)
	if f and f.combatUntil > os.clock() and p.style ~= "" and p.style ~= style.id and not st.tester then
		toast(player, "싸우는 중에는 권법을 바꿀 수 없어요")
		return
	end
	p.style = style.id
	if f then
		f.stacks = { flow = 0, petal = 0, petalAt = 0, charge = 0 }
		f.buffs = {}
		f.cds = {}
	end
	st.dirty = true
	refreshFighter(player)
	pushState(player)
end

function Actions.buy(player: Player, id: any)
	local p, st = profiles[player], states[player]
	local item = type(id) == "string" and Config.SHOP_BY_ID[id]
	if not p or not st or not item then
		return
	end
	if item.id == "potion" and p.potions >= item.max then
		toast(player, "금창약은 5개까지 들 수 있어요")
		return
	end
	if p.coins < item.cost then
		toast(player, string.format("은자가 부족해요 (💰 %s 필요)", Config.formatNumber(item.cost)))
		return
	end
	p.coins -= item.cost
	if item.id == "potion" then
		p.potions += 1
	elseif item.id == "elixir" then
		p.elixirUntil = math.max(os.time(), p.elixirUntil) + 300
	elseif item.id == "pill" then
		for _, s in ipairs(Config.Stats) do
			p.stats[s.id] += 10
		end
		refreshFighter(player)
	end
	st.dirty = true
	toast(player, item.icon .. " " .. item.name .. "을(를) 샀어요")
	pushState(player)
end

------------------------------------------------------------------------
-- 수련
------------------------------------------------------------------------
local Train = {}

-- 수련 기력: 시간이 지나면 찬다
local function regenStamina(p: Profile)
	local S = Config.STAMINA
	local now = os.time()
	if p.stamina >= S.max then
		p.staminaAt = now
		return
	end
	local ticks = math.floor((now - p.staminaAt) / S.regenEvery)
	if ticks > 0 then
		p.stamina = math.min(S.max, p.stamina + ticks)
		p.staminaAt += ticks * S.regenEvery
	end
end

function Train.start(player: Player, info: any, hard: boolean?)
	local p, st = profiles[player], states[player]
	local f = Combat.fighterOfPlayer(player)
	if not p or not st or not f or f.dead then
		return
	end
	if f.combatUntil > os.clock() then
		toast(player, "싸우는 중에는 수련할 수 없어요")
		return
	end
	local kindInfo = Config.Training[info.kind]
	local realmIdx = Config.realmOf(Calc.total(p))
	if kindInfo and kindInfo.realm and realmIdx < kindInfo.realm then
		toast(player, string.format("%s %s은(는) 경지 %s부터 할 수 있어요", kindInfo.icon, kindInfo.name, Config.Realms[kindInfo.realm].name))
		return
	end
	-- 심마 대련: 마음속의 마귀를 불러내 싸운다 (이기면 모든 능력치)
	if kindInfo and kindInfo.fight then
		local t = os.clock()
		if t - (st.simmaAt or 0) < 60 then
			toast(player, string.format("👁 심마가 아직 가라앉지 않았어요 (%d초)", math.ceil(60 - (t - st.simmaAt))))
			return
		end
		st.simmaAt = t
		local e = Npc.spawn("simma", false, info.pos + Vector3.new(0, 0, -14), "simma")
		if e then
			(e.f :: any).simmaOwner = player
			e.target = f
			Push:FireAllClients("simma", e.f.model)
			toast(player, "👁 심마가 형체를 얻었다! 이기면 모든 능력치가 크게 오른다")
		end
		return
	end
	if hard and realmIdx < Config.HARD_TRAIN.realm then
		toast(player, string.format("🔥 강화 수련은 경지 %s부터 할 수 있어요", Config.Realms[Config.HARD_TRAIN.realm].name))
		return
	end
	st.training = { kind = info.kind, index = info.index, pos = info.pos, hard = hard == true }
	st.ringIdx = 1
	if info.kind ~= "bamboo" then
		local char = player.Character
		local at = info.pos + Vector3.new(0, 3.5, info.kind == "waterfall" and 0 or 5)
		if char then
			char:PivotTo(CFrame.lookAt(at, Vector3.new(info.pos.X, at.Y, info.pos.Z) + (info.kind == "waterfall" and Vector3.new(1, 0, 0) or Vector3.new(0, 0, 0))))
		end
		f.walk = 0
	end
	Push:FireClient(player, "train", { kind = info.kind, rings = info.kind == "bamboo" and W.rings or nil, hard = hard == true })
	Push:FireAllClients("trainPose", f.model, info.kind)
	pushState(player)
end

function Train.stop(player: Player)
	local st = states[player]
	local f = Combat.fighterOfPlayer(player)
	if not st or not st.training then
		return
	end
	st.training = nil
	if f then
		Push:FireAllClients("trainPose", f.model, nil)
	end
	refreshFighter(player)
	Push:FireClient(player, "train", nil)
	pushState(player)
end

-- grade: "perfect" / "good" / "miss", 경공은 ring 번호
function Train.hit(player: Player, grade: any, ringArg: any)
	local p, st = profiles[player], states[player]
	if not p or not st or not st.training then
		return
	end
	local t = os.clock()
	if t - st.trainAt < Config.TRAIN_COOLDOWN then
		return
	end
	local kind = st.training.kind
	local info = Config.Training[kind]
	local gain = 0
	if kind == "bamboo" then
		local idx = math.floor(tonumber(ringArg) or 0)
		local pos = W.rings[idx]
		local f = Combat.fighterOfPlayer(player)
		if not pos or not f or idx ~= st.ringIdx or (f.root.Position - pos).Magnitude > 12 then
			return
		end
		st.ringIdx = idx % #W.rings + 1
		gain = info.base * 2
	else
		if grade == "perfect" then
			gain = info.base * 2
		elseif grade == "good" then
			gain = info.base
		else
			gain = 0
		end
	end
	st.trainAt = t
	-- 기력이 있어야 몸이 받아들인다
	regenStamina(p)
	local cost = st.training.hard and Config.STAMINA.hardCost or Config.STAMINA.cost
	if gain > 0 and p.stamina < cost then
		toast(player, "😮‍💨 기력이 다했어요. 객잔에서 쉬거나 조금 기다리세요")
		Train.stop(player)
		return
	end
	if gain > 0 then
		p.stamina -= cost
	end
	if gain <= 0 then
		Push:FireClient(player, "trained", { stat = info.stat, gain = 0, grade = grade })
		return
	end
	-- 경지가 오를수록, 소환단을 먹었으면 더 많이
	local idx = Config.realmOf(Calc.total(p))
	local mult = (1 + 0.25 * (idx - 1)) * (p.elixirUntil > os.time() and 2 or 1) * (st.training.hard and Config.HARD_TRAIN.mult or 1)
	local amount = math.max(1, math.floor(gain * mult + 0.5))
	local beforeIdx = idx
	if info.gains then
		-- 여러 능력치가 함께 오르는 수련
		for stat, k in pairs(info.gains) do
			p.stats[stat] += math.max(1, math.floor(gain * k * mult + 0.5))
		end
		amount = math.max(1, math.floor(gain * (info.gains[info.stat] or 1) * mult + 0.5))
	else
		p.stats[info.stat] += amount
	end
	st.dirty = true
	local afterIdx, realm = Config.realmOf(Calc.total(p))
	Push:FireClient(player, "trained", { stat = info.stat, gain = amount, grade = grade, total = p.stats[info.stat], ring = st.ringIdx })
	if afterIdx > beforeIdx then
		Push:FireAllClients("realm", { name = player.DisplayName, realm = realm.name })
	end
	Story.event(player, "train")
	refreshFighter(player)
	if st.training and kind ~= "bamboo" then
		local f = Combat.fighterOfPlayer(player)
		if f then
			f.walk = 0
		end
	end
	pushState(player)
end

-- 수련 자리를 벗어나면 끝 (경공은 숲을 벗어나면)
task.spawn(function()
	while true do
		task.wait(0.5)
		for player, st in pairs(states) do
			local tr = st.training
			local f = Combat.fighterOfPlayer(player)
			if tr and f then
				local limit = tr.kind == "bamboo" and 140 or 12
				if (Vector3.new(f.root.Position.X, 0, f.root.Position.Z) - Vector3.new(tr.pos.X, 0, tr.pos.Z)).Magnitude > limit or f.combatUntil > os.clock() then
					Train.stop(player)
				end
			end
		end
	end
end)

------------------------------------------------------------------------
-- 시험용 (테스트 계정)
------------------------------------------------------------------------
local function testAction(player: Player, p: Profile, action: string, arg: any)
	local f = Combat.fighterOfPlayer(player)
	if action == "testCoins" then
		p.coins += math.clamp(tonumber(arg) or 1000, 0, 1e9)
	elseif action == "testStats" then
		for _, s in ipairs(Config.Stats) do
			p.stats[s.id] += math.clamp(tonumber(arg) or 100, 0, 1e7)
		end
	elseif action == "testMastery" then
		if p.style ~= "" then
			local m = Calc.mastery(p, p.style)
			m.lv = Config.MASTERY_MAX
			m.xp = 0
		end
	elseif action == "testChi" then
		if f then
			f.chi = (f :: any).chiMax or Config.CHI_MAX
			f.cds = {}
		end
	elseif action == "testHeal" then
		if f then
			f.hp = f.maxHp
			f.posture = 0
		end
	elseif action == "testBoss" then
		if f then
			Npc.spawn(type(arg) == "string" and Config.Bosses[arg] and arg or "heukho", true, f.root.Position + Combat.look(f) * 30, "test")
		end
	elseif action == "testEnemy" then
		if f then
			local id = type(arg) == "string" and Config.Enemies[arg] and arg or "bandit"
			Npc.spawn(id, false, f.root.Position + Combat.look(f) * 18, "test")
		end
	elseif action == "testDie" then
		if f then
			Combat.kill(f, nil)
		end
	elseif action == "testStory" then
		Story.advance(player)
	elseif action == "testTrial" then
		local ef = activeTrial[player]
		if ef then
			Trial.ended(player, true)
			Npc.despawn(ef)
		end
		for id in pairs(Config.MASTERS) do
			p.found[id] = true
			p.trials[id] = true
		end
	elseif action == "testTp" then
		-- 다음 사부에게 순간이동
		if f then
			local st = states[player]
			st.tpIdx = ((st.tpIdx or 0) :: number) % #Config.Styles + 1
			local m = Config.MASTERS[Config.Styles[st.tpIdx].id]
			if m then
				f.root.CFrame = CFrame.new(m.at + Vector3.new(0, 4, 12))
				toast(player, "🌀 " .. m.region .. " · " .. m.name)
			end
		end
	elseif action == "testStyle" then
		-- 권법 테스트: 어떤 권법이든 (숨은 것도) 바로 익혀 숙련 최대로 쓴다
		local sd = type(arg) == "string" and Config.STYLE_BY_ID[arg]
		if sd then
			p.styles[sd.id] = true
			p.style = sd.id
			local m = Calc.mastery(p, sd.id)
			m.lv = Config.MASTERY_MAX
			m.xp = 0
			if f then
				f.chi = (f :: any).chiMax or Config.CHI_MAX
			end
			Push:FireClient(player, "learned", { style = sd.id, hidden = sd.hidden == true })
		end
	elseif action == "testSecretMaster" then
		-- 숨은 사부 곁으로
		if f then
			local sm = Config.SECRET_MASTER
			f.root.CFrame = CFrame.new(sm.at + Vector3.new(0, 4, 10))
			toast(player, "🧭 " .. sm.name .. " (" .. sm.region .. ")")
		end
	elseif action == "testBreak" then
		if p.style ~= "" then
			p.gradeUp[p.style] = #Config.BREAKTHROUGH
		end
	elseif action == "testSecret" then
		-- 시크릿 테스트: 숨은 권법을 진짜 길로 얻어 본다
		if arg == "fragment" then
			for i = 1, #Config.Fragments do
				if not p.fragments[tostring(i)] then
					p.fragments[tostring(i)] = true
					local n = countKeys(p.fragments)
					Push:FireClient(player, "fragment", { n = n, total = #Config.Fragments })
					if n >= #Config.Fragments then
						grantStyle(player, "mugeuk", true)
					end
					Story.event(player, "fragment")
					break
				end
			end
		elseif arg == "fragmentTp" then
			for i, fr in ipairs(Config.Fragments) do
				if not p.fragments[tostring(i)] and f then
					f.root.CFrame = CFrame.new(fr.at + Vector3.new(0, 4, 8))
					toast(player, "📖 비급 조각: " .. (fr.hint or ""))
					break
				end
			end
		elseif arg == "mugeuk" then
			for i = 1, #Config.Fragments do
				p.fragments[tostring(i)] = true
			end
			Push:FireClient(player, "fragment", { n = #Config.Fragments, total = #Config.Fragments })
			grantStyle(player, "mugeuk", true)
		elseif arg == "hyeolma" then
			grantStyle(player, "hyeolma", true)
		elseif arg == "lock" then
			-- 숨은 권법을 다시 잠근다 (처음부터 다시 얻어 보기)
			p.styles.mugeuk = nil :: any
			p.styles.hyeolma = nil :: any
			p.styles.gaecheon = nil :: any
			p.trials.gaecheon = nil :: any
			p.fragments = {}
			if p.style == "mugeuk" or p.style == "hyeolma" or p.style == "gaecheon" then
				p.style = "samjae"
			end
		end
	elseif action == "testReset" then
		profiles[player] = defaultProfile()
	else
		return
	end
	refreshFighter(player)
	if f then
		Combat.sync(f)
	end
	updateTag(player)
	pushState(player)
	Story.check(player)
end

------------------------------------------------------------------------
-- 요청 받기
------------------------------------------------------------------------
Request.OnServerEvent:Connect(function(player: Player, action: any, a1: any, a2: any, a3: any)
	local p, st = profiles[player], states[player]
	if not p or not st or type(action) ~= "string" then
		return
	end
	local t = os.clock()
	if t - st.reqWindow > 1 then
		st.reqWindow = t
		st.reqCount = 0
	end
	st.reqCount += 1
	if st.reqCount > 60 then
		return
	end
	if st.training and (action == "act" or action == "dash") then
		Train.stop(player)
	end
	if action == "act" then
		Actions.act(player, a1, a2, a3)
	elseif action == "hit" then
		Actions.hit(player, a1, a2, a3)
	elseif action == "guard" then
		Actions.guard(player, a1)
	elseif action == "dash" then
		Actions.dash(player, a1)
	elseif action == "emote" then
		local f = Combat.fighterOfPlayer(player)
		if f and not f.dead and not Combat.busy(f) and type(a1) == "string" and #a1 < 20 then
			Push:FireAllClients("emote", f.model, a1)
		end
	elseif action == "sprint" then
		local f = Combat.fighterOfPlayer(player)
		if f then
			(f :: any).sprint = a1 == true
			f.model:SetAttribute("Sprint", a1 == true or nil)
		end
	elseif action == "djump" then
		local f = Combat.fighterOfPlayer(player)
		if f then
			Push:FireAllClients("djump", f.model)
		end
	elseif action == "potion" then
		Actions.potion(player)
	elseif action == "learn" then
		Actions.learn(player, a1)
	elseif action == "buy" then
		Actions.buy(player, a1)
	elseif action == "trainHit" then
		Train.hit(player, a1, a2)
	elseif action == "trainStop" then
		Train.stop(player)
	elseif action == "hello" then
		pushState(player)
		if st.tester then
			toast(player, "🧪 테스트 계정이에요. 기록은 저장하지 않아요")
		elseif not st.canSave then
			toast(player, "저장이 꺼져 있어요. 이번 기록은 저장되지 않아요")
		end
		-- 이야기 첫 장이면 장로를 찾아가라고
		if p.story == 1 then
			Push:FireClient(player, "dialog", { who = "강호", title = "권왕: 맨손의 강호", text = "맨손 하나로 강호를 꺾어라. 먼저 마을의 청운 장로를 찾아가 말을 걸어 보자. (노란 길잡이를 따라가서 T)" })
		end
	elseif action == "talkElder" then
		Story.talk(player)
	elseif action == "breakthrough" then
		-- 권법 승급 (깨달음): 숙련 10, 경지, 은자
		local sd = type(a1) == "string" and Config.STYLE_BY_ID[a1]
		if not sd or not p.styles[sd.id] then
			return
		end
		local ups = p.gradeUp[sd.id] or 0
		local step = Config.BREAKTHROUGH[ups + 1]
		if not step then
			toast(player, "더 오를 깨달음이 없어요")
			return
		elseif Calc.mastery(p, sd.id).lv < Config.MASTERY_MAX then
			toast(player, string.format("승급하려면 %s 숙련 %d이 필요해요", sd.name, Config.MASTERY_MAX))
			return
		elseif Config.realmOf(Calc.total(p)) < step.realm then
			toast(player, string.format("%s은(는) %s의 경지부터예요", step.name, Config.Realms[step.realm].name))
			return
		elseif p.coins < step.coins then
			toast(player, string.format("은자가 부족해요 (💰 %s 필요)", Config.formatNumber(step.coins)))
			return
		end
		p.coins -= step.coins
		p.gradeUp[sd.id] = ups + 1
		st.dirty = true
		Push:FireClient(player, "breakthrough", { style = sd.id, grade = Config.styleGrade(sd, ups + 1), step = step.name })
		refreshFighter(player)
		pushState(player)
	elseif string.sub(action, 1, 4) == "test" and st.tester then
		testAction(player, p, action, a1)
	end
end)

-- 월드의 T 누르기
if W.shop then
	W.shop.Triggered:Connect(function(player: Player)
		Push:FireClient(player, "open", { page = "shop" })
	end)
end
-- 객잔: 은자를 내고 쉬면 수련 기력이 가득 찬다
if W.inn then
	W.inn.Triggered:Connect(function(player: Player)
		local p = profiles[player]
		if not p then
			return
		end
		regenStamina(p)
		if p.stamina >= Config.STAMINA.max then
			toast(player, "기력이 이미 가득해요")
			return
		end
		if p.coins < Config.STAMINA.innCost then
			toast(player, string.format("은자가 부족해요 (💰 %d)", Config.STAMINA.innCost))
			return
		end
		p.coins -= Config.STAMINA.innCost
		p.stamina = Config.STAMINA.max
		p.staminaAt = os.time()
		states[player].dirty = true
		toast(player, "🛏 푹 쉬었다. 기력이 가득 찼다")
		pushState(player)
	end)
end
-- 비급 조각 줍기 (다섯을 모으면 무극신권)
for i, frag in ipairs(W.fragments or {}) do
	frag.Triggered:Connect(function(player: Player)
		local p = profiles[player]
		if not p or p.fragments[tostring(i)] then
			return
		end
		p.fragments[tostring(i)] = true
		local n = countKeys(p.fragments)
		Push:FireClient(player, "fragment", { n = n, total = #Config.Fragments })
		if n >= #Config.Fragments then
			grantStyle(player, "mugeuk", true)
		end
		states[player].dirty = true
		Story.event(player, "fragment")
		pushState(player)
	end)
end
for _, info in ipairs(W.train or {}) do
	info.prompt.Triggered:Connect(function(player: Player)
		Train.start(player, info)
	end)
	if info.hard then
		info.hard.Triggered:Connect(function(player: Player)
			Train.start(player, info, true)
		end)
	end
end

------------------------------------------------------------------------
-- 들어오고 나가기
------------------------------------------------------------------------
local function setupCharacter(player: Player, char: Model)
	local hum = char:WaitForChild("Humanoid", 10)
	local root = char:WaitForChild("HumanoidRootPart", 10)
	if not hum or not root or not hum:IsA("Humanoid") then
		return
	end
	hum.BreakJointsOnDeath = false
	hum.MaxHealth = 1e9
	hum.Health = 1e9
	hum.JumpPower = 55
	hum.UseJumpPower = true
	local p = profiles[player]
	if not p then
		return
	end
	local f = Combat.register(char, { player = player, name = player.DisplayName, hp = Config.maxHp(p.stats.vit), style = p.style })
	f.iframeUntil = os.clock() + 2
	refreshFighter(player)
	char.AncestryChanged:Connect(function()
		if not char.Parent then
			Combat.unregister(char)
		end
	end)
	local st = states[player]
	if st then
		st.training = nil
	end
end

local function onPlayerAdded(player: Player)
	local st: State = { canSave = false, dirty = false, tester = false, reqWindow = 0, reqCount = 0, training = nil, trainAt = 0, ringIdx = 1, potionAt = 0 }
	states[player] = st
	local ls = Instance.new("Folder")
	ls.Name = "leaderstats"
	local realmValue = Instance.new("StringValue")
	realmValue.Name = "경지"
	realmValue.Value = "삼류"
	realmValue.Parent = ls
	local coinValue = Instance.new("StringValue")
	coinValue.Name = "은자"
	coinValue.Value = "0"
	coinValue.Parent = ls
	ls.Parent = player
	local profile, ok
	if isTester(player) then
		profile, ok = defaultProfile(), false
		st.tester = true
	else
		profile, ok = loadProfile(player)
	end
	if not player.Parent then
		return
	end
	-- 누구나 삼재권 하나는 몸에 지니고 시작한다
	if not profile.styles.samjae then
		profile.styles.samjae = true
	end
	if profile.style == "" then
		profile.style = "samjae"
	end
	profiles[player] = profile
	st.canSave = ok
	player.CharacterAdded:Connect(function(char)
		setupCharacter(player, char)
	end)
	if player.Character then
		task.spawn(setupCharacter, player, player.Character)
	end
	pushState(player)

end

local function onPlayerRemoving(player: Player)
	saveProfile(player)
	profiles[player] = nil
	states[player] = nil
end

Players.PlayerAdded:Connect(onPlayerAdded)
Players.PlayerRemoving:Connect(onPlayerRemoving)
for _, player in ipairs(Players:GetPlayers()) do
	task.spawn(onPlayerAdded, player)
end

task.spawn(function()
	while true do
		task.wait(SAVE_INTERVAL)
		for player, st in pairs(states) do
			if st.dirty then
				task.spawn(saveProfile, player)
			end
		end
	end
end)

game:BindToClose(function()
	for player in pairs(profiles) do
		task.spawn(saveProfile, player)
	end
	task.wait(2)
end)

------------------------------------------------------------------------
-- 사부와 적 (몸 만들기는 시간이 걸릴 수 있어 맨 나중에, 따로)
------------------------------------------------------------------------
task.spawn(function()
	local ok, err = pcall(Npc.spawnMasters, function(player: Player, styleId: string)
		local p = profiles[player]
		if not p then
			return
		end
		if not p.found[styleId] then
			p.found[styleId] = true
			Story.event(player, "found")
		end
		local m = Config.MASTERS[styleId]
		local sdef = Config.STYLE_BY_ID[styleId]
		if sdef and sdef.realmReq and not p.styles[styleId] and Config.realmOf(Calc.total(p)) < sdef.realmReq then
			Push:FireClient(player, "dialog", { who = m.name, title = "「" .. m.quote .. "」", text = string.format("...아직 이르다. 네 안의 하늘이 열리지 않았다. %s에 이르거든 다시 오너라.", Config.Realms[sdef.realmReq].name) })
			return
		end
		if not p.styles[styleId] and not p.trials[styleId] then
			-- 아직 시험을 안 넘었다: 사부가 시험을 낸다
			Push:FireClient(player, "dialog", { who = m.name, title = "「" .. m.quote .. "」", text = "제자가 되고 싶다면 먼저 내 분신을 꺾어라. 준비가 되면 다시 말을 걸어라. (다시 T를 누르면 시험이 시작된다)", trial = styleId })
			local st = states[player]
			if st and (st :: any).trialAsk == styleId then
				(st :: any).trialAsk = nil
				Trial.start(player, styleId)
			elseif st then
				(st :: any).trialAsk = styleId
			end
			return
		end
		Push:FireClient(player, "open", { page = "styles", style = styleId, master = true })
	end)
	if not ok then
		warn("[권왕] 사부 만들기 오류:", err)
	end
	ok, err = pcall(Npc.spawnElder, function(player: Player)
		Story.talk(player)
	end)
	if not ok then
		warn("[권왕] 장로 만들기 오류:", err)
	end
	ok, err = pcall(Npc.populate)
	if not ok then
		warn("[권왕] 적 만들기 오류:", err)
	end
	Npc.start()
end)

-- 사부를 찾았는가 (가까이 가면 찾은 것) / 기력 갱신
task.spawn(function()
	while true do
		task.wait(1)
		for player, p in pairs(profiles) do
			local f = Combat.fighterOfPlayer(player)
			if f and not f.dead then
				for id, m in pairs(Config.MASTERS) do
					if not p.found[id] and (f.root.Position - m.at).Magnitude < 50 then
						p.found[id] = true
						states[player].dirty = true
						Push:FireClient(player, "found", { style = id, master = m.name, region = m.region })
						Story.event(player, "found")
						pushState(player)
					end
				end
			end
		end
	end
end)
]]></string>
      </Properties>
      <Item class="ModuleScript" referent="7">
        <Properties>
          <string name="Name">Combat</string>
          <string name="Source"><![CDATA[-- 권왕: 싸움 판정 (서버). 사람과 적을 똑같이 '무인'으로 다룬다
-- 사람의 맞힘은 화면이 먼저 알려 주고(바로 반응하게), 서버가 거리·시간을 확인해 정한다
-- 적의 맞힘은 서버가 직접 정한다
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage:WaitForChild("Config"))

local Combat = {}

export type Act = {
	move: any,
	slot: any,
	seq: number,
	start: number,
	dur: number,
	speed: number,
	done: { [string]: boolean }, -- "맞힘번호:대상" 한 번씩만
	swung: { [number]: boolean },
	charge: number,
	bloom: boolean,
	enemy: boolean,
}

export type Fighter = {
	model: Model,
	root: BasePart,
	hum: Humanoid,
	player: Player?,
	npc: any?, -- 적이면 적 정보
	name: string,
	hp: number,
	maxHp: number,
	posture: number,
	postureMax: number,
	chi: number,
	style: string,
	act: Act?,
	stunUntil: number,
	brokenUntil: number,
	iframeUntil: number,
	guarding: boolean,
	guardStart: number,
	counterUntil: number,
	buffs: { [string]: number },
	lastHurtAt: number,
	lastSwingAt: number,
	cds: { [string]: number },
	stacks: { flow: number, petal: number, petalAt: number, charge: number },
	dead: boolean,
	combatUntil: number,
	dmgMult: number,
	skillMult: number,
	walk: number,
	lastAttacker: Fighter?,
	dashAt: number,
	dashUsed: number,
}

Combat.fighters = {} :: { [Model]: Fighter }
Combat.projectiles = {} :: { any }
local Push: RemoteEvent
local hooks: { [string]: any } = {}

function Combat.init(push: RemoteEvent, h: { [string]: any })
	Push = push
	hooks = h
end

local function now(): number
	return os.clock()
end

local function flat(v: Vector3): Vector3
	local f = Vector3.new(v.X, 0, v.Z)
	if f.Magnitude < 1e-4 then
		return Vector3.new(0, 0, -1)
	end
	return f.Unit
end

function Combat.look(f: Fighter): Vector3
	return flat(f.root.CFrame.LookVector)
end

function Combat.styleOf(f: Fighter): any
	return Config.STYLE_BY_ID[f.style]
end

-- 비무대 위인지
function Combat.onRing(pos: Vector3): boolean
	local R = Config.RING
	return math.abs(pos.X - R.center.X) <= R.size / 2 and math.abs(pos.Z - R.center.Z) <= R.size / 2 and pos.Y > R.height - 1
end

-- 서로 때릴 수 있는 사이인지
function Combat.hostile(a: Fighter, b: Fighter): boolean
	if a == b or a.dead or b.dead then
		return false
	end
	if a.player and b.player then
		return Combat.onRing(a.root.Position) and Combat.onRing(b.root.Position)
	end
	if not a.player and not b.player then
		return false
	end
	return true
end

function Combat.register(model: Model, info: any): Fighter
	local root = model:FindFirstChild("HumanoidRootPart") :: BasePart
	local hum = model:FindFirstChildOfClass("Humanoid") :: Humanoid
	local f: Fighter = {
		model = model,
		root = root,
		hum = hum,
		player = info.player,
		npc = info.npc,
		name = info.name or model.Name,
		hp = info.hp,
		maxHp = info.hp,
		posture = 0,
		postureMax = info.postureMax or Config.POSTURE_MAX,
		chi = 0,
		style = info.style or "",
		act = nil,
		stunUntil = 0,
		brokenUntil = 0,
		iframeUntil = 0,
		guarding = false,
		guardStart = 0,
		counterUntil = 0,
		buffs = {},
		lastHurtAt = 0,
		lastSwingAt = -10,
		cds = {},
		stacks = { flow = 0, petal = 0, petalAt = 0, charge = 0 },
		dead = false,
		combatUntil = 0,
		dmgMult = info.dmgMult or 1,
		skillMult = info.skillMult or 1,
		walk = info.walk or Config.WALK_SPEED,
		lastAttacker = nil,
		dashAt = 0,
		dashUsed = 0,
	}
	Combat.fighters[model] = f
	Combat.sync(f)
	return f
end

function Combat.unregister(model: Model)
	Combat.fighters[model] = nil
end

-- 화면이 읽는 값 (모델 속성)
function Combat.sync(f: Fighter)
	local m = f.model
	m:SetAttribute("Hp", math.max(0, math.floor(f.hp + 0.5)))
	m:SetAttribute("MaxHp", f.maxHp)
	m:SetAttribute("Posture", math.floor(f.posture + 0.5))
	m:SetAttribute("PostureMax", f.postureMax)
	m:SetAttribute("Chi", math.floor(f.chi))
	m:SetAttribute("Style", f.style)
	m:SetAttribute("Guard", f.guarding)
	m:SetAttribute("Flow", f.stacks.flow)
	m:SetAttribute("Petal", f.stacks.petal)
	m:SetAttribute("Charge", f.stacks.charge)
	m:SetAttribute("Dead", f.dead)
end

function Combat.stunned(f: Fighter): boolean
	return now() < f.stunUntil or f.dead
end

-- 지금 무엇에도 밀리지 않는지 (기술의 armor, 철포삼, 금강체)
local function armored(f: Fighter): boolean
	local t = now()
	if (f.buffs.ironshirt or 0) > t then
		return true
	end
	local act = f.act
	if act and t < act.start + act.dur then
		if act.move.armor then
			return true
		end
		local style = Combat.styleOf(f)
		if style and style.armorWhileAttacking and not act.enemy then
			return true
		end
	end
	return false
end

-- 받는 피해 배율
local function defense(f: Fighter): number
	local t = now()
	local m = 1
	if (f.buffs.ironshirt or 0) > t then
		m *= 0.5
	end
	local style = Combat.styleOf(f)
	local act = f.act
	if style and style.armorWhileAttacking and act and t < act.start + act.dur then
		m *= style.armorWhileAttacking
	end
	return m
end

local function interrupt(f: Fighter)
	if f.act then
		f.act = nil
		Push:FireAllClients("interrupt", f.model)
	end
end

-- 안전 지대 (마을, 사부의 자리)
local function inSafe(pos: Vector3): boolean
	for _, r in ipairs(Config.Regions) do
		if r.safe and math.abs(pos.X - r.center.X) <= r.size.X / 2 and math.abs(pos.Z - r.center.Z) <= r.size.Z / 2 then
			return true
		end
	end
	return false
end

local function knock(f: Fighter, vel: Vector3, stun: number)
	if f.player then
		Push:FireClient(f.player, "knock", vel, stun)
	elseif f.root and f.root.Parent and not f.root.Anchored then
		f.root.AssemblyLinearVelocity = vel
	end
end

-- 흘리기: 친 쪽은 헛힘에 앞으로 지나쳐 옆으로 흘러가고, 흘린 쪽은 반대로 살짝 비켜선다
local function redirect(tgt: Fighter, att: Fighter): number
	local right = tgt.root.CFrame.RightVector
	local rel = att.root.Position - tgt.root.Position
	local side = right:Dot(rel) >= 0 and 1 or -1
	local attLook = att.root.CFrame.LookVector
	knock(att, Vector3.new(attLook.X, 0, attLook.Z) * 18 + Vector3.new(right.X, 0, right.Z) * side * 16, 0)
	knock(tgt, -Vector3.new(right.X, 0, right.Z) * side * 7, 0)
	return side
end

function Combat.stun(f: Fighter, dur: number)
	f.stunUntil = math.max(f.stunUntil, now() + dur)
	interrupt(f)
	f.guarding = false
end

local function addChi(f: Fighter, amount: number)
	if f.player then
		f.chi = math.clamp(f.chi + amount, 0, (f :: any).chiMax or Config.CHI_MAX)
	end
end

local function addPosture(f: Fighter, amount: number): boolean
	f.posture += amount
	f.lastHurtAt = now()
	if f.posture >= f.postureMax then
		-- 파훼
		f.posture = f.postureMax
		f.brokenUntil = now() + Config.BREAK_STUN
		Combat.stun(f, Config.BREAK_STUN)
		Push:FireAllClients("broken", f.model, Config.BREAK_STUN)
		return true
	end
	return false
end

-- 막기를 깨부순다 (사자후): 균형을 가득 채워 파훼
function Combat.breakGuard(f: Fighter)
	if f.dead then
		return
	end
	f.guarding = false
	addPosture(f, f.postureMax)
end

function Combat.kill(f: Fighter, by: Fighter?)
	if f.dead then
		return
	end
	f.dead = true
	f.hp = 0
	f.act = nil
	f.guarding = false
	Combat.sync(f)
	Push:FireAllClients("ko", f.model, by and by.model or nil)
	if hooks.onKill then
		hooks.onKill(f, by)
	end
end

-- 피해 숫자 (공격자 쪽 배율)
local function damageOf(att: Fighter, hit: any, move: any, isSkill: boolean, act: Act?): number
	local d = hit.dmg * att.dmgMult
	if isSkill then
		d *= att.skillMult
	end
	if act and act.charge > 0 and move.chargeMult then
		local style = Combat.styleOf(att)
		local k = math.clamp(act.charge / (style and style.charge or 1.5), 0, 1)
		d *= 1 + (move.chargeMult - 1) * k
	end
	return d
end

------------------------------------------------------------------------
-- 한 번 맞히기. kind를 돌려준다: hit / block / deflect / guardbreak / clash / dodge / counter / miss
-- opt = { move, act, isSkill, unblockable, slotKey, chain }
------------------------------------------------------------------------
function Combat.applyHit(att: Fighter, tgt: Fighter, hit: any, opt: any): string
	if not Combat.hostile(att, tgt) then
		return "miss"
	end
	local t = now()
	if t < tgt.iframeUntil then
		-- 見切り: 맞기 직전에 대시로 피했다 → 상대가 잠깐 굳고, 곧바로 클릭하면 반격
		local fa = tgt :: any
		if tgt.player and t - tgt.dashAt < 0.4 and t - (fa.pdodgeAt or 0) > 0.6 then
			fa.pdodgeAt = t
			fa.deflectAt = t
			att.stunUntil = math.max(att.stunUntil, t + 0.45)
			interrupt(att)
			Push:FireAllClients("pdodge", { m = tgt.model, a = att.model })
		else
			Push:FireAllClients("hit", { a = att.model, t = tgt.model, kind = "dodge", pos = tgt.root.Position })
		end
		return "dodge"
	end
	local move = opt.move or {}
	local toAtt = flat(att.root.Position - tgt.root.Position)
	local facing = Combat.look(tgt):Dot(toAtt)
	local pos = tgt.root.Position:Lerp(att.root.Position, 0.35) + Vector3.new(0, 1, 0)
	att.combatUntil = t + Config.COMBAT_TAG
	tgt.combatUntil = t + Config.COMBAT_TAG
	tgt.lastAttacker = att

	-- 전투력 차이: 훨씬 약한 적의 공격은 덜 아프거나, 끄떡없거나, 호신강기에 튕겨 나간다 (붉은 공격도)
	local gapMul, steady = 1, false
	if att.npc and tgt.player then
		local pa, pt = (att :: any).power or 100, (tgt :: any).power or 100
		local immune
		gapMul, steady, immune = Config.powerGap(pt / math.max(1, pa))
		if immune then
			att.stunUntil = math.max(att.stunUntil, t + 0.45)
			interrupt(att)
			knock(att, toAtt * 22 + Vector3.new(0, 8, 0), 0.45)
			Push:FireAllClients("hit", { a = att.model, t = tgt.model, kind = "aura", pos = pos })
			return "immune"
		end
	end

	-- 격돌: 상대도 같은 순간 나를 향해 휘둘렀다
	if not opt.chain and not opt.proj and math.abs(tgt.lastSwingAt - t) <= Config.CLASH_WINDOW and facing > 0.5 and tgt.act and not move.aoe then
		-- 둘 다 서로 반대쪽으로 튕겨 난다
		knock(att, toAtt * 18 + Vector3.new(0, 6, 0), 0.3)
		knock(tgt, -toAtt * 18 + Vector3.new(0, 6, 0), 0.3)
		addPosture(att, 10)
		addPosture(tgt, 10)
		interrupt(att)
		interrupt(tgt)
		att.stunUntil = math.max(att.stunUntil, t + 0.3)
		tgt.stunUntil = math.max(tgt.stunUntil, t + 0.3)
		Push:FireAllClients("hit", { a = att.model, t = tgt.model, kind = "clash", pos = pos })
		return "clash"
	end

	-- 만류귀종: 잠깐 모든 공격을 저절로 흘려 되받아친다 (막을 수 없는 공격도)
	local ta = tgt :: any
	if t < (ta.reflectUntil or 0) and not opt.chain then
		att.stunUntil = math.max(att.stunUntil, t + 0.6)
		interrupt(att)
		local side = redirect(tgt, att)
		Push:FireAllClients("hit", { a = att.model, t = tgt.model, kind = "deflect", pos = pos, counter = true, side = side })
		local rh = ta.reflectHit
		if rh then
			task.defer(function()
				if not tgt.dead and not att.dead then
					Combat.applyHit(tgt, att, rh, { move = { name = "되흘림" }, isSkill = true, chain = true })
				end
			end)
		end
		return "counter"
	end

	local tStyle = Combat.styleOf(tgt)
	-- 취권: 비틀거려 저절로 피한다
	if tStyle and tStyle.dodgeChance and not opt.unblockable then
		local chance = 0
		if (tgt.buffs.sway or 0) > t then
			chance = 0.6
		elseif tgt.act or tgt.root.AssemblyLinearVelocity.Magnitude > 4 then
			chance = tStyle.dodgeChance
		end
		if chance > 0 and math.random() < chance then
			Push:FireAllClients("hit", { a = att.model, t = tgt.model, kind = "dodge", pos = pos, drunk = true })
			if (tgt.buffs.sway or 0) > t then
				-- 취보 중엔 피하면서 되받아친다
				task.defer(function()
					Combat.applyHit(tgt, att, { dmg = 6, posture = 10, stun = 0.4, kb = 10 }, { chain = true })
				end)
			end
			return "dodge"
		end
	end

	-- 태허 유수회선: 받아넘기고 되받아친다
	if t < tgt.counterUntil and not opt.unblockable and facing > -0.2 then
		tgt.counterUntil = 0
		addPosture(att, (hit.posture or 10) * Config.DEFLECT_POSTURE)
		att.stunUntil = math.max(att.stunUntil, t + Config.DEFLECT_STAGGER)
		interrupt(att)
		tgt.stacks.flow = math.min(3, tgt.stacks.flow + 1)
		local side = redirect(tgt, att)
		Push:FireAllClients("hit", { a = att.model, t = tgt.model, kind = "deflect", pos = pos, counter = true, side = side })
		;(tgt :: any).deflectAt = now()
		local style = Combat.styleOf(tgt)
		local ch = style and style.skills.E.counterHit
		if ch then
			Push:FireAllClients("act", { m = tgt.model, style = tgt.style, pose = ch.pose, dur = 0.5, seq = -1 })
			task.delay(0.12, function()
				if not tgt.dead and not att.dead then
					Combat.applyHit(tgt, att, ch.hit, { move = { name = "되받아치기" }, isSkill = true, chain = true })
				end
			end)
		end
		Combat.sync(tgt)
		return "counter"
	end

	local postureDmg = (hit.posture or 0)
	local aStyle0 = Combat.styleOf(att)
	if aStyle0 and aStyle0.postureMult then
		postureDmg *= aStyle0.postureMult
	end
	-- 막기·흘리기 (앞에서 온 것만, 막을 수 없는 공격은 안 된다)
	if tgt.guarding and facing > 0.2 and not opt.unblockable and not opt.chain then
		local window = (tStyle and tStyle.deflect or Config.DEFLECT_WINDOW) + 0.06 -- 0.06 = 통신 늦음 여유
		if t - tgt.guardStart <= window then
			-- 흘리기 성공
			local broke = addPosture(att, postureDmg * Config.DEFLECT_POSTURE + 6)
			if not broke then
				att.stunUntil = math.max(att.stunUntil, t + Config.DEFLECT_STAGGER)
				interrupt(att)
			end
			tgt.posture = math.max(0, tgt.posture - 6)
			addChi(tgt, Config.CHI_ON_DEFLECT)
			if tStyle and tStyle.id == "taeheo" then
				tgt.stacks.flow = math.min(3, tgt.stacks.flow + 1)
			end
			Combat.sync(tgt)
			Combat.sync(att)
			local side = redirect(tgt, att)
			Push:FireAllClients("hit", { a = att.model, t = tgt.model, kind = "deflect", pos = pos, side = side })
			;(tgt :: any).deflectAt = now()
			if hooks.onDeflect then
				hooks.onDeflect(tgt, att)
			end
			return "deflect"
		end
		-- 그냥 막기
		local d = damageOf(att, hit, move, opt.isSkill, opt.act) * Config.BLOCK_DAMAGE * (tStyle and tStyle.weakBlock or 1) * defense(tgt) * gapMul
		tgt.hp -= d
		local broke = (not steady) and addPosture(tgt, postureDmg * Config.BLOCK_POSTURE)
		if not steady then
			knock(tgt, -toAtt * math.min(20, (hit.kb or 0) * 0.4 + 4), 0)
		end
		addChi(tgt, d * Config.CHI_ON_HURT)
		Combat.sync(tgt)
		Push:FireAllClients("hit", { a = att.model, t = tgt.model, kind = broke and "guardbreak" or "block", pos = pos, dmg = d })
		if tgt.hp <= 0 then
			Combat.kill(tgt, att)
		end
		return broke and "guardbreak" or "block"
	end

	-- 맞았다
	local d = damageOf(att, hit, move, opt.isSkill, opt.act) * defense(tgt) * gapMul
	local crit = false
	local aStyle = Combat.styleOf(att)
	if aStyle and aStyle.backstab and facing < -0.3 then
		d *= aStyle.backstab
		crit = true
	end
	if opt.teleport then
		crit = true
	end
	-- 카운터: 적이 휘두르려고 멈칫한 사이에 먼저 꽂으면 1.5배, 그 공격이 끊긴다
	local counterHit = false
	if tgt.npc and tgt.act and tgt.act.move and t < tgt.act.start + (tgt.act.move.windup or 0) then
		d *= 1.5
		crit = true
		counterHit = true
		interrupt(tgt)
	end
	local wasBroken = t < tgt.brokenUntil
	if wasBroken then
		d *= Config.BROKEN_MULT
		tgt.brokenUntil = 0
		tgt.posture = 0
		crit = true
	end
	tgt.hp -= d
	-- 흡혈 (혈마신수)
	if aStyle and aStyle.lifesteal and att.player and not att.dead then
		att.hp = math.min(att.maxHp, att.hp + d * aStyle.lifesteal * ((att.buffs.frenzy or 0) > t and 3 or 1))
		att.model:SetAttribute("Hp", math.floor(att.hp + 0.5))
	end
	if not steady then
		addPosture(tgt, postureDmg * 0.4)
	end
	local heavy = not steady and ((hit.kb or 0) >= 20 or (hit.stun or 0) >= 0.6 or wasBroken)
	if not armored(tgt) and not steady then
		local stun = hit.stun or 0.3
		local fa = tgt :: any
		if tgt.npc then
			-- 적은 경직이 짧고, 2.5초 안에 너무 오래 묶이면 잠깐 버티며 곧바로 되받아친다 (무한 경직 방지)
			stun *= 0.6
			if t - (fa.poiseAt or 0) > 2.5 then
				fa.poiseAt = t
				fa.poiseSum = 0
			end
			fa.poiseSum = (fa.poiseSum or 0) + stun
			if fa.poiseSum > 1.2 and t >= (fa.poiseUntil or 0) then
				fa.poiseSum = 0
				fa.poiseUntil = t + 1.5
				fa.retaliate = true
				tgt.model:SetAttribute("Poise", true)
				Push:FireAllClients("poise", tgt.model)
				task.delay(1.5, function()
					if tgt.model.Parent then
						tgt.model:SetAttribute("Poise", nil)
					end
				end)
			end
			if t < (fa.poiseUntil or 0) and not heavy and not wasBroken then
				stun = 0
			end
		end
		if stun > 0 then
			if (hit.up or 0) >= 25 then
				tgt.model:SetAttribute("LaunchedAt", t)
			end
			Combat.stun(tgt, stun)
			local dir = flat(tgt.root.Position - att.root.Position)
			local kb = (hit.kb or 0) * (wasBroken and 1.5 or 1)
			knock(tgt, dir * kb + Vector3.new(0, (hit.up or 0) + (kb > 25 and 12 or 0), 0), stun)
		end
	end
	addChi(att, d * Config.CHI_ON_HIT)
	addChi(tgt, d * Config.CHI_ON_HURT)

	-- 공격한 쪽 권법 장치: 꽃잎, 전하
	local chain = false
	local star = false
	if aStyle and not opt.chain then
		if aStyle.starEvery then
			-- 개천: 다섯 번 맞힐 때마다 별이 떨어진다
			local fa = att :: any
			fa.starN = (fa.starN or 0) + 1
			if fa.starN >= aStyle.starEvery then
				fa.starN = 0
				star = true
			end
		end
		if aStyle.id == "maehwa" then
			if t - att.stacks.petalAt > 1.2 then
				att.stacks.petal = 0
			end
			att.stacks.petal = math.min(20, att.stacks.petal + 1)
			att.stacks.petalAt = t
		elseif aStyle.id == "byeokryeok" then
			att.stacks.charge += 1
			if att.stacks.charge >= 5 then
				att.stacks.charge = 0
				chain = true
			end
		end
	end
	Combat.sync(att)
	Combat.sync(tgt)
	Push:FireAllClients("hit", {
		a = att.model,
		t = tgt.model,
		kind = "hit",
		pos = pos,
		dmg = d,
		heavy = heavy,
		crit = crit,
		style = att.style,
		strike = move.strike == true,
		broken = wasBroken,
		counter = counterHit,
		steady = steady,
	})
	if hooks.onHit then
		hooks.onHit(att, tgt, d, opt)
	end
	if tgt.hp <= 0 then
		Combat.kill(tgt, att)
	end
	-- 벽력: 연쇄 번개
	if chain then
		local victims = {}
		for _, other in pairs(Combat.fighters) do
			if other ~= tgt and Combat.hostile(att, other) and (other.root.Position - tgt.root.Position).Magnitude <= 16 then
				table.insert(victims, other)
			end
		end
		Push:FireAllClients("chain", { from = tgt.model, to = (function()
			local list = {}
			for _, v in ipairs(victims) do
				table.insert(list, v.model)
			end
			return list
		end)() })
		for _, v in ipairs(victims) do
			Combat.applyHit(att, v, { dmg = 9, posture = 12, stun = 1.0, kb = 4 }, { chain = true, move = { strike = true } })
		end
		if not tgt.dead then
			Combat.stun(tgt, 1.0)
		end
	end
	if star then
		local at = tgt.root.Position
		Push:FireAllClients("star", { at = at, style = att.style })
		task.delay(0.35, function()
			if att.dead then
				return
			end
			for _, other in pairs(Combat.fighters) do
				if Combat.hostile(att, other) and not other.dead and (other.root.Position - at).Magnitude <= 14 then
					Combat.applyHit(att, other, { dmg = 22, posture = 25, stun = 0.6, kb = 18, up = 8 }, { chain = true, isSkill = true, move = { name = "낙성" } })
				end
			end
		end)
	end
	return "hit"
end

------------------------------------------------------------------------
-- 기술 시작 (사람과 적 공통). 화면들에게 동작을 알린다
------------------------------------------------------------------------
function Combat.begin(f: Fighter, move: any, slot: any, seq: number, opt: any?): Act
	local o = opt or {}
	local speed = o.speed or 1
	local act: Act = {
		move = move,
		slot = slot,
		seq = seq,
		start = now(),
		dur = move.dur / speed,
		speed = speed,
		done = {},
		swung = {},
		charge = o.charge or 0,
		bloom = o.bloom == true,
		enemy = o.enemy == true,
	}
	f.act = act
	f.guarding = false
	if move.iframes then
		f.iframeUntil = math.max(f.iframeUntil, now() + move.iframes)
	end
	Push:FireAllClients("act", {
		m = f.model,
		style = f.style,
		slot = slot,
		pose = move.pose,
		dur = act.dur,
		align = o.align,
		seq = seq,
		id = move.id,
		charge = act.charge,
		bloom = act.bloom,
		unblockable = move.unblockable,
		windup = move.windup and move.windup / speed or nil,
	})
	return act
end

-- 기술이 끝났는지
function Combat.busy(f: Fighter): boolean
	local act = f.act
	return act ~= nil and now() < act.start + act.dur
end

-- 앞쪽 상자 안의 상대들 (서버 판정용)
function Combat.query(att: Fighter, hit: any, from: Vector3?): { Fighter }
	local origin = from or att.root.Position
	local look = Combat.look(att)
	local center = hit.aoe and origin or origin + look * (hit.range * 0.55)
	local list = {}
	for _, f in pairs(Combat.fighters) do
		if Combat.hostile(att, f) then
			local dist = Vector3.new(f.root.Position.X - center.X, 0, f.root.Position.Z - center.Z).Magnitude
			local reach = hit.aoe and hit.radius or (hit.range * 0.55 + hit.radius)
			if dist <= reach + 1.5 and math.abs(f.root.Position.Y - origin.Y) < 9 then
				table.insert(list, f)
			end
		end
	end
	return list
end

-- 화면이 알려 준 맞힘이 믿을 만한지 (거리)
function Combat.plausible(att: Fighter, tgt: Fighter, hit: any): boolean
	local d = Vector3.new(tgt.root.Position.X - att.root.Position.X, 0, tgt.root.Position.Z - att.root.Position.Z).Magnitude
	local reach = hit.aoe and hit.radius or (hit.range + hit.radius)
	return d <= reach + Config.HIT_TOLERANCE + 3 and math.abs(tgt.root.Position.Y - att.root.Position.Y) < 14
end

------------------------------------------------------------------------
-- 장풍
------------------------------------------------------------------------
function Combat.fire(owner: Fighter, proj: any, scale: number, opt: any)
	local look = Combat.look(owner)
	local pos = owner.root.Position + look * 2.5 + Vector3.new(0, 0.8, 0)
	local p = {
		owner = owner,
		pos = pos,
		dir = look,
		speed = proj.speed,
		life = proj.life,
		radius = proj.radius * scale,
		hit = { dmg = proj.dmg * scale, posture = proj.posture * scale, stun = proj.stun, kb = proj.kb * math.sqrt(scale), range = 0, radius = proj.radius * scale },
		pierce = proj.pierce == true,
		hitSet = {},
		opt = opt,
	}
	table.insert(Combat.projectiles, p)
	Push:FireAllClients("proj", { m = owner.model, pos = pos, dir = look, speed = proj.speed, life = proj.life, size = (proj.size or 3) * scale, style = owner.style })
end

function Combat.stepProjectiles(dt: number)
	for i = #Combat.projectiles, 1, -1 do
		local p = Combat.projectiles[i]
		p.life -= dt
		local step = p.dir * p.speed * dt
		local from = p.pos
		p.pos += step
		local stop = p.life <= 0 or p.owner.dead
		if not stop then
			for _, f in pairs(Combat.fighters) do
				if not p.hitSet[f] and Combat.hostile(p.owner, f) then
					-- 지나온 선분과 거리
					local v = f.root.Position - from
					local seg = step.Magnitude > 0 and step.Unit or p.dir
					local along = math.clamp(v:Dot(seg), 0, step.Magnitude)
					local closest = from + seg * along
					local dist = Vector3.new(f.root.Position.X - closest.X, 0, f.root.Position.Z - closest.Z).Magnitude
					if dist <= p.radius + 1.5 and math.abs(f.root.Position.Y - closest.Y) < 6 then
						p.hitSet[f] = true
						Combat.applyHit(p.owner, f, p.hit, { move = p.opt.move, isSkill = p.opt.isSkill, proj = true })
						if not p.pierce then
							stop = true
							break
						end
					end
				end
			end
		end
		if stop then
			table.remove(Combat.projectiles, i)
		end
	end
end

------------------------------------------------------------------------
-- 매 순간: 균형·내공 회복, 걷는 속도 (기절·막기)
------------------------------------------------------------------------
function Combat.tick(dt: number)
	local t = now()
	for _, f in pairs(Combat.fighters) do
		if not f.dead then
			local changed = false
			if f.posture > 0 and t - f.lastHurtAt > Config.POSTURE_REGEN_DELAY and t > f.brokenUntil then
				f.posture = math.max(0, f.posture - Config.POSTURE_REGEN * dt)
				changed = true
			end
			-- 자연 회복 (맞은 지 오래면 체력이 조금씩 찬다. 적은 싸움을 멈추고 8초 뒤부터)
			if not f.dead and f.hp < f.maxHp then
				local delay = f.npc and 8 or Config.REGEN_DELAY
				if t - f.lastHurtAt > delay and t > f.stunUntil then
					local rate = f.npc and 0.04 or (inSafe(f.root.Position) and Config.REGEN_SAFE_RATE or Config.REGEN_RATE)
					f.hp = math.min(f.maxHp, f.hp + f.maxHp * rate * dt)
					f.model:SetAttribute("Hp", math.floor(f.hp + 0.5))
				end
			end
			local cmax = (f :: any).chiMax or Config.CHI_MAX
			if f.player and f.chi < cmax then
				f.chi = math.min(cmax, f.chi + Config.CHI_REGEN * dt * (f.skillMult or 1) * math.sqrt(cmax / Config.CHI_MAX))
				changed = true
			end
			if f.act and t > f.act.start + f.act.dur then
				f.act = nil
			end
			local speed = f.walk
			if t < f.stunUntil then
				speed = 0
			elseif f.guarding then
				speed = f.walk * 0.4
			elseif f.act and not f.npc then
				speed = f.walk * 0.35
			elseif (f :: any).sprint then
				speed = f.walk * 1.45
			end
			if f.hum and math.abs(f.hum.WalkSpeed - speed) > 0.1 then
				f.hum.WalkSpeed = speed
			end
			if changed then
				-- 자주 바뀌는 값은 반올림해서 보낸다 (속성은 바뀔 때만 전달된다)
				f.model:SetAttribute("Posture", math.floor(f.posture + 0.5))
				f.model:SetAttribute("Chi", math.floor(f.chi))
			end
		end
	end
	Combat.stepProjectiles(dt)
end

function Combat.fighterOfPlayer(player: Player): Fighter?
	local char = player.Character
	return char and Combat.fighters[char] or nil
end

local _ = Players
return Combat
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="8">
        <Properties>
          <string name="Name">Npc</string>
          <string name="Source"><![CDATA[-- 권왕: 무기를 든 적과 보스 (서버가 움직인다)
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage:WaitForChild("Config"))
local Combat = require(script.Parent:WaitForChild("Combat"))

local Npc = {}

type Enemy = {
	f: any,
	def: any,
	kind: string, -- "enemy" / "boss"
	typeId: string,
	home: Vector3,
	target: any?,
	nextAttack: number,
	guardUntil: number,
	strafe: number,
	phase2: boolean,
	seq: number,
	region: string,
	engaged: { [Player]: boolean },
	level: number,
	attackingUntil: number,
	nextPattern: number?,
}

Npc.list = {} :: { Enemy }
local folder: Folder
local Push: RemoteEvent
local SKIN = Color3.fromRGB(234, 184, 146)

function Npc.init(push: RemoteEvent)
	Push = push
	folder = Instance.new("Folder")
	folder.Name = "Enemies"
	folder.Parent = workspace
end

------------------------------------------------------------------------
-- 몸과 무기
------------------------------------------------------------------------
local function weaponPart(name: string, size: Vector3, color: Color3, material: Enum.Material, parent: Instance): Part
	local p = Instance.new("Part")
	p.Name = name
	p.Size = size
	p.Color = color
	p.Material = material
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.Massless = true
	p.Parent = parent
	return p
end

-- 손에 무기를 붙인다. 날은 손의 앞(-Z)으로 뻗는다
local function attachWeapon(model: Model, kind: string)
	local w = Config.Weapons[kind]
	if not w then
		return
	end
	local function onHand(handName: string)
		local hand = model:FindFirstChild(handName)
		if not hand or not hand:IsA("BasePart") then
			return
		end
		local L = w.length
		local wf = Instance.new("Model")
		wf.Name = "Weapon"
		wf.Parent = model
		local grip = weaponPart("Grip", Vector3.new(0.35, 0.35, kind == "spear" and L or 1.1), w.handle, Enum.Material.Wood, wf)
		local blade: Part
		if kind == "spear" then
			blade = weaponPart("Blade", Vector3.new(0.25, 0.6, 1.4), w.color, Enum.Material.Metal, wf)
		elseif kind == "club" then
			blade = weaponPart("Blade", Vector3.new(0.75, 0.75, L), w.color, Enum.Material.Wood, wf)
		elseif kind == "staff" then
			blade = weaponPart("Blade", Vector3.new(0.4, 0.4, L), w.color, Enum.Material.Wood, wf)
		else
			blade = weaponPart("Blade", Vector3.new(0.12, kind == "greatsword" and 0.9 or 0.45, L), w.color, Enum.Material.Metal, wf)
		end
		local guard = weaponPart("Guard", Vector3.new(0.3, 0.9, 0.2), Color3.fromRGB(160, 130, 60), Enum.Material.Metal, wf)
		local base = hand.CFrame * CFrame.new(0, -0.25, 0)
		if kind == "spear" then
			grip.CFrame = base
			blade.CFrame = base * CFrame.new(0, 0, -L / 2 - 0.6)
			guard.CFrame = base * CFrame.new(0, 0, -L / 2 + 0.1)
		else
			grip.CFrame = base * CFrame.new(0, 0, 0.3)
			guard.CFrame = base * CFrame.new(0, 0, -0.3)
			blade.CFrame = base * CFrame.new(0, 0, -0.3 - L / 2)
		end
		for _, p in ipairs({ grip, blade, guard }) do
			local weld = Instance.new("WeldConstraint")
			weld.Part0 = hand
			weld.Part1 = p
			weld.Parent = p
		end
	end
	onHand("RightHand")
	if kind == "dual" then
		onHand("LeftHand")
	end
end

-- 몸을 직접 짠다 (R15 관절 이름 그대로). 로블록스 기본 몸 만들기가 안 될 때 쓴다
-- 관절 자리 J를 기준으로 C0·C1을 맞춘다. 발바닥이 HumanoidRootPart 중심에서 3칸 아래
local RIG: { { any } } = {
	-- 이름, 크기, 중심, 부모, 관절 이름, 관절 자리
	{ "LowerTorso", Vector3.new(2, 0.4, 1), Vector3.new(0, -0.8, 0), "HumanoidRootPart", "Root", Vector3.new(0, -0.8, 0) },
	{ "UpperTorso", Vector3.new(2, 1.6, 1), Vector3.new(0, 0.2, 0), "LowerTorso", "Waist", Vector3.new(0, -0.6, 0) },
	{ "Head", Vector3.new(1.2, 1.2, 1.2), Vector3.new(0, 1.6, 0), "UpperTorso", "Neck", Vector3.new(0, 1.0, 0) },
	{ "RightUpperArm", Vector3.new(1, 1.2, 1), Vector3.new(1.5, 0.4, 0), "UpperTorso", "RightShoulder", Vector3.new(1.5, 0.8, 0) },
	{ "RightLowerArm", Vector3.new(1, 0.95, 1), Vector3.new(1.5, -0.675, 0), "RightUpperArm", "RightElbow", Vector3.new(1.5, -0.2, 0) },
	{ "RightHand", Vector3.new(1, 0.3, 1), Vector3.new(1.5, -1.3, 0), "RightLowerArm", "RightWrist", Vector3.new(1.5, -1.15, 0) },
	{ "LeftUpperArm", Vector3.new(1, 1.2, 1), Vector3.new(-1.5, 0.4, 0), "UpperTorso", "LeftShoulder", Vector3.new(-1.5, 0.8, 0) },
	{ "LeftLowerArm", Vector3.new(1, 0.95, 1), Vector3.new(-1.5, -0.675, 0), "LeftUpperArm", "LeftElbow", Vector3.new(-1.5, -0.2, 0) },
	{ "LeftHand", Vector3.new(1, 0.3, 1), Vector3.new(-1.5, -1.3, 0), "LeftLowerArm", "LeftWrist", Vector3.new(-1.5, -1.15, 0) },
	{ "RightUpperLeg", Vector3.new(1, 1.1, 1), Vector3.new(0.5, -1.55, 0), "LowerTorso", "RightHip", Vector3.new(0.5, -1.0, 0) },
	{ "RightLowerLeg", Vector3.new(1, 0.7, 1), Vector3.new(0.5, -2.45, 0), "RightUpperLeg", "RightKnee", Vector3.new(0.5, -2.1, 0) },
	{ "RightFoot", Vector3.new(1, 0.2, 1.1), Vector3.new(0.5, -2.9, -0.05), "RightLowerLeg", "RightAnkle", Vector3.new(0.5, -2.8, 0) },
	{ "LeftUpperLeg", Vector3.new(1, 1.1, 1), Vector3.new(-0.5, -1.55, 0), "LowerTorso", "LeftHip", Vector3.new(-0.5, -1.0, 0) },
	{ "LeftLowerLeg", Vector3.new(1, 0.7, 1), Vector3.new(-0.5, -2.45, 0), "LeftUpperLeg", "LeftKnee", Vector3.new(-0.5, -2.1, 0) },
	{ "LeftFoot", Vector3.new(1, 0.2, 1.1), Vector3.new(-0.5, -2.9, -0.05), "LeftLowerLeg", "LeftAnkle", Vector3.new(-0.5, -2.8, 0) },
}

local function manualRig(colors: { head: Color3, torso: Color3, arms: Color3, legs: Color3 }, s: number): Model
	local model = Instance.new("Model")
	local root = Instance.new("Part")
	root.Name = "HumanoidRootPart"
	root.Size = Vector3.new(2, 2, 1) * s
	root.Transparency = 1
	root.CanCollide = false
	root.Parent = model
	model.PrimaryPart = root
	local parts: { [string]: BasePart } = { HumanoidRootPart = root }
	for _, r in ipairs(RIG) do
		local name, size, center, parentName, jointName, joint = r[1], r[2], r[3], r[4], r[5], r[6]
		local p = Instance.new("Part")
		p.Name = name
		p.Size = size * s
		p.CFrame = CFrame.new(center * s)
		p.TopSurface = Enum.SurfaceType.Smooth
		p.BottomSurface = Enum.SurfaceType.Smooth
		p.CanCollide = name == "UpperTorso" or name == "LowerTorso" or name == "Head"
		p.Material = Enum.Material.SmoothPlastic
		if name == "Head" then
			p.Color = colors.head
			local mesh = Instance.new("SpecialMesh")
			mesh.MeshType = Enum.MeshType.Head
			mesh.Scale = Vector3.new(1.25, 1.25, 1.25)
			mesh.Parent = p
			local face = Instance.new("Decal")
			face.Name = "face"
			face.Texture = "rbxasset://textures/face.png"
			face.Face = Enum.NormalId.Front
			face.Parent = p
		elseif string.find(name, "Torso") then
			p.Color = colors.torso
		elseif string.find(name, "Arm") or string.find(name, "Hand") then
			p.Color = colors.arms
		else
			p.Color = colors.legs
		end
		p.Parent = model
		parts[name] = p
		local parent = parts[parentName]
		local m = Instance.new("Motor6D")
		m.Name = jointName
		m.Part0 = parent
		m.Part1 = p
		local j = joint * s
		m.C0 = CFrame.new(j - parent.Position)
		m.C1 = CFrame.new(j - center * s)
		m.Parent = p
	end
	local hum = Instance.new("Humanoid")
	hum.RigType = Enum.HumanoidRigType.R15
	hum.HipHeight = 2 * s
	hum.AutomaticScalingEnabled = false
	hum.Parent = model
	return model
end

-- 사람 몸 하나 (로블록스 기본 몸, 안 되면 직접 짠 몸)
local function body(colors: { head: Color3, torso: Color3, arms: Color3, legs: Color3 }, s: number): Model
	local ok, model = pcall(function()
		local desc = Instance.new("HumanoidDescription")
		desc.HeadColor = colors.head
		desc.LeftArmColor = colors.arms
		desc.RightArmColor = colors.arms
		desc.TorsoColor = colors.torso
		desc.LeftLegColor = colors.legs
		desc.RightLegColor = colors.legs
		desc.HeightScale = s
		desc.WidthScale = s
		desc.DepthScale = s
		desc.HeadScale = s
		return Players:CreateHumanoidModelFromDescription(desc, Enum.HumanoidRigType.R15)
	end)
	if ok and typeof(model) == "Instance" and model:IsA("Model") and model:FindFirstChild("HumanoidRootPart") and model:FindFirstChild("LowerTorso") then
		-- 기본 걷기 스크립트는 쓰지 않는다 (몸동작은 화면이 그린다)
		local animate = model:FindFirstChild("Animate")
		if animate then
			animate:Destroy()
		end
		return model
	end
	if not ok then
		warn("[권왕] 기본 몸 만들기 실패, 직접 짠 몸을 씁니다:", model)
	end
	return manualRig(colors, s)
end
Npc.body = body

local function buildRig(def: any, label: string, isBoss: boolean): Model
	local s = def.scale or 1
	local model = body({ head = SKIN, torso = def.shirt, arms = SKIN, legs = def.pants }, s)
	model.Name = label
	local hum = model:FindFirstChildOfClass("Humanoid")
	if hum then
		hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
		hum.BreakJointsOnDeath = false
		hum.MaxHealth = 1e9
		hum.Health = 1e9
		hum.WalkSpeed = def.speed
	end
	-- 이마 띠 (적은 붉은, 보스는 검은 금빛)
	local head = model:FindFirstChild("Head")
	if head and head:IsA("BasePart") then
		local band = Instance.new("Part")
		band.Name = "Headband"
		band.Size = Vector3.new(head.Size.X * 1.05, head.Size.Y * 0.18, head.Size.Z * 1.05)
		band.Color = isBoss and Color3.fromRGB(30, 25, 20) or Color3.fromRGB(170, 30, 30)
		band.Material = isBoss and Enum.Material.Foil or Enum.Material.Fabric
		band.CanCollide = false
		band.CanQuery = false
		band.Massless = true
		band.CFrame = head.CFrame * CFrame.new(0, head.Size.Y * 0.18, 0)
		band.Parent = model
		local weld = Instance.new("WeldConstraint")
		weld.Part0 = head
		weld.Part1 = band
		weld.Parent = band
	end
	attachWeapon(model, def.weapon)
	model:SetAttribute("NPC", true)
	model:SetAttribute("Boss", isBoss)
	model:SetAttribute("Label", label)
	model:SetAttribute("Scale", def.scale or 1)
	model:SetAttribute("Weapon", def.weapon)
	return model
end

------------------------------------------------------------------------
-- 나타나기
------------------------------------------------------------------------
function Npc.spawn(typeId: string, isBoss: boolean, at: Vector3, region: string): Enemy?
	local def = isBoss and Config.Bosses[typeId] or Config.Enemies[typeId]
	if not def then
		return nil
	end
	local model = buildRig(def, def.name, isBoss)
	local pos = at + Vector3.new(math.random(-8, 8), 4 * (def.scale or 1), math.random(-8, 8))
	model:PivotTo(CFrame.new(pos))
	model.Parent = folder
	local root = model:FindFirstChild("HumanoidRootPart")
	if root and root:IsA("BasePart") then
		pcall(function()
			root:SetNetworkOwner(nil)
		end)
	end
	-- 마을에서 멀수록 단계가 높다: 체력·균형·피해·보상이 함께 오른다
	local lv = Config.enemyLevel(at)
	model:SetAttribute("Level", lv)
	-- mult: 허공 균열 같은 후반 땅의 적은 체력·피해가 겹으로 세다
	local mult = def.mult or 1
	local f = Combat.register(model, {
		npc = def,
		name = def.name,
		hp = math.floor(def.hp * (1 + 0.28 * (lv - 1)) * mult),
		postureMax = math.floor(def.posture * (1 + 0.1 * (lv - 1)) * math.sqrt(mult)),
		walk = def.speed,
		style = def.style or "",
		dmgMult = Config.ENEMY_DMG * (1 + 0.18 * (lv - 1)) * mult,
	})
	;(f :: any).rewardMult = (1 + 0.25 * (lv - 1)) * math.sqrt(mult)
	;(f :: any).typeId = typeId
	local cp = Config.enemyPower(f.dmgMult, f.maxHp, isBoss)
	;(f :: any).power = cp
	model:SetAttribute("Power", cp)
	local e: Enemy = {
		f = f,
		def = def,
		kind = isBoss and "boss" or "enemy",
		typeId = typeId,
		home = at,
		target = nil,
		nextAttack = os.clock() + 1,
		guardUntil = 0,
		strafe = math.random() < 0.5 and 1 or -1,
		phase2 = false,
		seq = 0,
		region = region,
		engaged = {},
		level = lv,
		attackingUntil = 0,
	}
	table.insert(Npc.list, e)
	return e
end

-- 지역마다 적과 보스를 놓는다
function Npc.populate()
	for _, region in ipairs(Config.Regions) do
		for _, camp in ipairs(region.camps or {}) do
			for _ = 1, camp.count do
				local ok, err = pcall(Npc.spawn, camp.enemy, false, camp.at, region.id)
				if not ok then
					warn("[권왕] 적 만들기 오류:", camp.enemy, err)
				end
			end
		end
		if region.boss then
			local ok, err = pcall(Npc.spawn, region.boss.id, true, region.boss.at, region.id)
			if not ok then
				warn("[권왕] 보스 만들기 오류:", region.boss.id, err)
			end
		end
	end
end

------------------------------------------------------------------------
-- 일곱 사부 (싸우지 않는다. 가까이 가서 T를 누르면 권법을 배운다)
------------------------------------------------------------------------
local function masterTag(head: BasePart, name: string, style: any)
	local g = Instance.new("BillboardGui")
	g.Name = "MasterTag"
	g.Size = UDim2.new(0, 320, 0, 74)
	g.StudsOffset = Vector3.new(0, 3.2, 0)
	g.AlwaysOnTop = true
	g.LightInfluence = 0
	g.MaxDistance = 160
	for i, line in ipairs({ { (style.elder and "" or "사부 · ") .. name, Color3.fromRGB(255, 225, 150), 0.52 }, { style.icon .. " " .. style.name .. (style.elder and "" or "  (T)"), style.color, 0.48 } }) do
		local l = Instance.new("TextLabel")
		l.BackgroundTransparency = 1
		l.Position = UDim2.fromScale(0, i == 1 and 0 or 0.52)
		l.Size = UDim2.fromScale(1, line[3])
		l.Font = Enum.Font.GothamBlack
		l.TextScaled = true
		l.TextColor3 = line[2]
		l.TextStrokeTransparency = 0.2
		l.Text = line[1]
		l.Parent = g
	end
	g.Parent = head
end

-- 사부 차림: 몸 부위에 붙는 장식 (기본 몸이든 직접 짠 몸이든 부위 이름은 같다)
local function wear(model: Model, partName: string, name: string, size: Vector3, offset: CFrame, color: Color3, material: Enum.Material?, shape: Enum.PartType?): Part?
	local base = model:FindFirstChild(partName)
	if not base or not base:IsA("BasePart") then
		return nil
	end
	local p = Instance.new("Part")
	p.Name = name
	if shape then
		p.Shape = shape
	end
	p.Size = size
	p.Color = color
	p.Material = material or Enum.Material.Fabric
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.Massless = true
	p.CFrame = base.CFrame * offset
	p.Parent = model
	local w = Instance.new("WeldConstraint")
	w.Part0 = base
	w.Part1 = p
	w.Parent = p
	return p
end

local GOLD = Color3.fromRGB(235, 190, 80)
local WHITE_HAIR = Color3.fromRGB(240, 240, 235)

local function dressMaster(model: Model, style: any)
	local robe = style.color:Lerp(Color3.new(0, 0, 0), 0.35)
	local trim = style.color2
	local head = model:FindFirstChild("Head") :: BasePart?
	local hs = head and head.Size or Vector3.new(1.2, 1.2, 1.2)
	-- 공통: 앞뒤로 갈라진 긴 도포, 금빛 어깨받이, 허리띠 끈, 등 망토
	for _, z in ipairs({ -1, 1 }) do
		wear(model, "LowerTorso", "RobePanel", Vector3.new(2.1, 2.4, 0.18), CFrame.new(0, -1.35, z * 0.55), robe)
		wear(model, "LowerTorso", "RobeTrim", Vector3.new(2.15, 0.25, 0.22), CFrame.new(0, -2.5, z * 0.55), trim, Enum.Material.SmoothPlastic)
	end
	for _, x in ipairs({ -1, 1 }) do
		wear(model, "UpperTorso", "Pauldron", Vector3.new(1.25, 0.45, 1.35), CFrame.new(x * 1.15, 0.72, 0) * CFrame.Angles(0, 0, -x * math.rad(15)), GOLD, Enum.Material.Metal)
		wear(model, "LowerTorso", "SashTail", Vector3.new(0.3, 1.6, 0.1), CFrame.new(x * 0.35, -0.9, 0.62) * CFrame.Angles(math.rad(8), 0, x * math.rad(6)), trim)
	end
	wear(model, "UpperTorso", "Cape", Vector3.new(2.1, 3.6, 0.14), CFrame.new(0, -0.9, 0.62) * CFrame.Angles(math.rad(10), 0, 0), style.color)
	wear(model, "UpperTorso", "Collar", Vector3.new(1.4, 0.35, 1.15), CFrame.new(0, 0.85, -0.05), trim, Enum.Material.SmoothPlastic)

	local id = style.id
	local function beard(color: Color3)
		wear(model, "Head", "Beard", Vector3.new(hs.X * 0.55, hs.Y * 1.1, 0.35), CFrame.new(0, -hs.Y * 0.62, -hs.Z * 0.42), color)
		for _, x in ipairs({ -1, 1 }) do
			wear(model, "Head", "Mustache", Vector3.new(hs.X * 0.35, 0.12, 0.12), CFrame.new(x * hs.X * 0.2, -hs.Y * 0.12, -hs.Z * 0.52) * CFrame.Angles(0, 0, x * math.rad(-25)), color)
		end
	end
	if id == "taeheo" then
		-- 물빛 도인: 흰 수염과 상투
		beard(WHITE_HAIR)
		wear(model, "Head", "Topknot", Vector3.new(0.6, 0.6, 0.6), CFrame.new(0, hs.Y * 0.62, 0.05), WHITE_HAIR, Enum.Material.SmoothPlastic, Enum.PartType.Ball)
		wear(model, "Head", "Hairband", Vector3.new(hs.X * 1.03, 0.18, hs.Z * 1.03), CFrame.new(0, hs.Y * 0.28, 0), trim, Enum.Material.Neon)
	elseif id == "geumgang" then
		-- 금강 대사: 염주와 비스듬한 가사
		for k = 0, 13 do
			local a = k / 14 * math.pi * 2
			wear(model, "UpperTorso", "Bead", Vector3.new(0.32, 0.32, 0.32), CFrame.new(math.cos(a) * 0.62, 0.62 - math.abs(math.sin(a)) * 0.15, math.sin(a) * 0.55), Color3.fromRGB(110, 60, 30), Enum.Material.Wood, Enum.PartType.Ball)
		end
		wear(model, "UpperTorso", "Kasaya", Vector3.new(0.55, 2.6, 1.12), CFrame.new(0, 0, 0) * CFrame.Angles(0, 0, math.rad(35)), Color3.fromRGB(190, 50, 35))
		wear(model, "Head", "Urna", Vector3.new(0.15, 0.15, 0.1), CFrame.new(0, hs.Y * 0.22, -hs.Z * 0.5), GOLD, Enum.Material.Neon)
	elseif id == "maehwa" then
		-- 매화 선자: 긴 머리, 꽃 비녀, 넓은 소매
		wear(model, "Head", "LongHair", Vector3.new(hs.X * 1.05, hs.Y * 2.2, 0.35), CFrame.new(0, -hs.Y * 0.55, hs.Z * 0.5), Color3.fromRGB(25, 20, 25))
		wear(model, "Head", "HairTop", Vector3.new(hs.X * 1.08, hs.Y * 0.4, hs.Z * 1.08), CFrame.new(0, hs.Y * 0.4, 0.05), Color3.fromRGB(25, 20, 25))
		wear(model, "Head", "Hairpin", Vector3.new(0.5, 0.5, 0.5), CFrame.new(hs.X * 0.45, hs.Y * 0.5, 0.2), style.color, Enum.Material.Neon, Enum.PartType.Ball)
		for _, side in ipairs({ "Right", "Left" }) do
			wear(model, side .. "LowerArm", "Sleeve", Vector3.new(1.45, 1.1, 1.45), CFrame.new(0, -0.2, 0), trim)
		end
	elseif id == "cheonryong" then
		-- 용천 노조: 용뿔 관과 흰 수염
		beard(WHITE_HAIR)
		wear(model, "Head", "Crown", Vector3.new(hs.X * 0.9, 0.3, hs.Z * 0.6), CFrame.new(0, hs.Y * 0.55, 0), GOLD, Enum.Material.Metal)
		for _, x in ipairs({ -1, 1 }) do
			wear(model, "Head", "DragonHorn", Vector3.new(0.22, 1.3, 0.22), CFrame.new(x * hs.X * 0.35, hs.Y * 0.95, 0.15) * CFrame.Angles(math.rad(-25), 0, -x * math.rad(25)), GOLD, Enum.Material.Metal)
		end
		wear(model, "Head", "CrownGem", Vector3.new(0.3, 0.3, 0.3), CFrame.new(0, hs.Y * 0.6, -hs.Z * 0.32), style.color, Enum.Material.Neon, Enum.PartType.Ball)
	elseif id == "muyeong" then
		-- 무영객: 두건, 복면, 보랏빛 눈
		wear(model, "Head", "Hood", Vector3.new(hs.X * 1.12, hs.Y * 1.12, hs.Z * 1.0), CFrame.new(0, hs.Y * 0.06, hs.Z * 0.1), Color3.fromRGB(20, 18, 26))
		wear(model, "Head", "Mask", Vector3.new(hs.X * 0.9, hs.Y * 0.42, 0.12), CFrame.new(0, -hs.Y * 0.22, -hs.Z * 0.5), Color3.fromRGB(15, 12, 20))
		for _, x in ipairs({ -1, 1 }) do
			wear(model, "Head", "ShadowEye", Vector3.new(0.22, 0.09, 0.05), CFrame.new(x * hs.X * 0.18, hs.Y * 0.08, -hs.Z * 0.52), Color3.fromRGB(190, 120, 255), Enum.Material.Neon)
		end
	elseif id == "byeokryeok" then
		-- 뇌정진군: 곤두선 머리, 번개 팔찌
		for k = -2, 2 do
			wear(model, "Head", "SpikeHair", Vector3.new(0.25, 0.8, 0.25), CFrame.new(k * hs.X * 0.18, hs.Y * 0.65, 0.1) * CFrame.Angles(math.rad(-15), 0, k * math.rad(-12)), Color3.fromRGB(255, 245, 200), Enum.Material.Neon)
		end
		wear(model, "Head", "Headband", Vector3.new(hs.X * 1.04, 0.2, hs.Z * 1.04), CFrame.new(0, hs.Y * 0.25, 0), style.color, Enum.Material.Neon)
		for _, side in ipairs({ "Right", "Left" }) do
			wear(model, side .. "LowerArm", "Bracer", Vector3.new(1.12, 0.5, 1.12), CFrame.new(0, -0.2, 0), style.color, Enum.Material.Neon)
			local hand = model:FindFirstChild(side .. "Hand")
			if hand and hand:IsA("BasePart") then
				local e = Instance.new("ParticleEmitter")
				e.Rate = 8
				e.Color = ColorSequence.new(Color3.fromRGB(255, 250, 180))
				e.LightEmission = 1
				e.Size = NumberSequence.new(0.25, 0)
				e.Lifetime = NumberRange.new(0.15, 0.3)
				e.Speed = NumberRange.new(4, 8)
				e.SpreadAngle = Vector2.new(180, 180)
				e.Parent = hand
			end
		end
	elseif id == "gaecheon" then
		-- 무명 노인: 땅에 끌리는 흰 수염, 별을 박은 관, 둘레를 도는 별빛
		beard(WHITE_HAIR)
		wear(model, "Head", "LongBeard", Vector3.new(hs.X * 0.5, hs.Y * 2.4, 0.3), CFrame.new(0, -hs.Y * 1.5, -hs.Z * 0.45), WHITE_HAIR)
		wear(model, "Head", "StarCrown", Vector3.new(hs.X * 1.05, 0.25, hs.Z * 1.05), CFrame.new(0, hs.Y * 0.55, 0), Color3.fromRGB(230, 235, 255), Enum.Material.Neon)
		for k = 0, 4 do
			local a = k / 5 * math.pi * 2
			wear(model, "Head", "CrownStar", Vector3.new(0.3, 0.3, 0.3), CFrame.new(math.cos(a) * hs.X * 0.5, hs.Y * 0.75, math.sin(a) * hs.Z * 0.5), style.color2, Enum.Material.Neon, Enum.PartType.Ball)
		end
		local headPart = model:FindFirstChild("Head")
		if headPart and headPart:IsA("BasePart") then
			local e = Instance.new("ParticleEmitter")
			e.Rate = 10
			e.Color = ColorSequence.new(style.color, style.color2)
			e.LightEmission = 1
			e.Size = NumberSequence.new(0.35, 0)
			e.Lifetime = NumberRange.new(1, 2)
			e.Speed = NumberRange.new(1, 3)
			e.SpreadAngle = Vector2.new(180, 180)
			e.Parent = headPart
		end
	elseif id == "chwi" then
		-- 취선옹: 넓은 삿갓, 허리의 술 호리병, 붉은 뺨
		beard(Color3.fromRGB(170, 170, 165))
		wear(model, "Head", "StrawHat", Vector3.new(0.25, 3.4, 3.4), CFrame.new(0, hs.Y * 0.62, 0) * CFrame.Angles(0, 0, math.rad(90)), Color3.fromRGB(205, 175, 110), Enum.Material.Fabric, Enum.PartType.Cylinder)
		wear(model, "Head", "HatTop", Vector3.new(1.2, 0.8, 1.2), CFrame.new(0, hs.Y * 0.85, 0), Color3.fromRGB(190, 160, 95), Enum.Material.Fabric, Enum.PartType.Ball)
		wear(model, "LowerTorso", "GourdLow", Vector3.new(0.9, 0.9, 0.9), CFrame.new(1.25, -0.4, 0.2), Color3.fromRGB(200, 120, 40), Enum.Material.SmoothPlastic, Enum.PartType.Ball)
		wear(model, "LowerTorso", "GourdTop", Vector3.new(0.6, 0.6, 0.6), CFrame.new(1.25, 0.25, 0.2), Color3.fromRGB(200, 120, 40), Enum.Material.SmoothPlastic, Enum.PartType.Ball)
		for _, x in ipairs({ -1, 1 }) do
			wear(model, "Head", "Cheek", Vector3.new(0.25, 0.14, 0.05), CFrame.new(x * hs.X * 0.28, -hs.Y * 0.05, -hs.Z * 0.51), Color3.fromRGB(240, 110, 110), Enum.Material.SmoothPlastic)
		end
	end
end

-- 청운 장로: 이야기를 들려주는 노인 (마을)
function Npc.spawnElder(onTalk: (Player) -> ())
	local mf = workspace:FindFirstChild("Masters") or Instance.new("Folder")
	mf.Name = "Masters"
	mf.Parent = workspace
	local robe = Color3.fromRGB(120, 95, 70)
	local model = body({ head = SKIN, torso = robe, arms = Color3.fromRGB(150, 125, 95), legs = Color3.fromRGB(80, 65, 50) }, 1.05)
	model.Name = "Elder"
	local hum = model:FindFirstChildOfClass("Humanoid")
	if hum then
		hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
		hum.WalkSpeed = 0
	end
	local head = model:FindFirstChild("Head") :: BasePart?
	local hs = head and head.Size or Vector3.new(1.2, 1.2, 1.2)
	wear(model, "Head", "Beard", Vector3.new(hs.X * 0.55, hs.Y * 1.2, 0.35), CFrame.new(0, -hs.Y * 0.65, -hs.Z * 0.42), Color3.fromRGB(240, 240, 235))
	wear(model, "Head", "Topknot", Vector3.new(0.6, 0.6, 0.6), CFrame.new(0, hs.Y * 0.62, 0.05), Color3.fromRGB(235, 235, 230), Enum.Material.SmoothPlastic, Enum.PartType.Ball)
	for _, z in ipairs({ -1, 1 }) do
		wear(model, "LowerTorso", "RobePanel", Vector3.new(2.1, 2.4, 0.18), CFrame.new(0, -1.35, z * 0.55), robe)
	end
	wear(model, "RightHand", "Staff", Vector3.new(0.3, 6.5, 0.3), CFrame.new(0, 1.2, 0), Color3.fromRGB(100, 70, 45), Enum.Material.Wood)
	local root = model:FindFirstChild("HumanoidRootPart") :: BasePart
	local up = (hum and hum.HipHeight or 2) + root.Size.Y / 2
	local at = Config.ELDER_AT
	model:PivotTo(CFrame.lookAt(at + Vector3.new(0, up, 0), at + Vector3.new(0, up, 10)))
	root.Anchored = true
	model:SetAttribute("NPC", true)
	model:SetAttribute("Master", true)
	model:SetAttribute("Label", "청운 장로")
	if head then
		masterTag(head, "청운 장로", { icon = "📜", name = "이야기 (T)", color = Color3.fromRGB(255, 225, 150), elder = true })
	end
	local pp = Instance.new("ProximityPrompt")
	pp.Name = "Elder"
	pp.ActionText = "이야기"
	pp.ObjectText = "청운 장로"
	pp.HoldDuration = 0
	pp.MaxActivationDistance = 14
	pp.RequiresLineOfSight = false
	pp.KeyboardKeyCode = Enum.KeyCode.T
	pp.Parent = root
	pp.Triggered:Connect(onTalk)
	model.Parent = mf
end

function Npc.spawnMasters(onTrigger: (Player, string) -> ())
	local mf = Instance.new("Folder")
	mf.Name = "Masters"
	mf.Parent = workspace
	for _, style in ipairs(Config.Styles) do
		local info = Config.MASTERS[style.id]
		if info then
			local ok, err = pcall(function()
				local s = 1.2
				local model = body({ head = SKIN, torso = style.color:Lerp(Color3.new(1, 1, 1), 0.1), arms = style.color:Lerp(Color3.new(1, 1, 1), 0.25), legs = style.color:Lerp(Color3.new(0, 0, 0), 0.55) }, s)
				model.Name = "Master_" .. style.id
				local hum = model:FindFirstChildOfClass("Humanoid")
				local root = model:FindFirstChild("HumanoidRootPart") :: BasePart
				if hum then
					hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
					hum.WalkSpeed = 0
					hum.JumpPower = 0
				end
				-- 허리띠 (권법의 둘째 빛깔)
				local lower = model:FindFirstChild("LowerTorso")
				if lower and lower:IsA("BasePart") then
					local sash = Instance.new("Part")
					sash.Name = "Sash"
					sash.Size = Vector3.new(lower.Size.X * 1.08, 0.35, lower.Size.Z * 1.15)
					sash.Color = style.color2
					sash.Material = Enum.Material.Fabric
					sash.CanCollide = false
					sash.CanQuery = false
					sash.Massless = true
					sash.CFrame = lower.CFrame * CFrame.new(0, 0.1, 0)
					sash.Parent = model
					local weld = Instance.new("WeldConstraint")
					weld.Part0 = lower
					weld.Part1 = sash
					weld.Parent = sash
				end
				pcall(dressMaster, model, style)
				local up = (hum and hum.HipHeight or 2 * s) + root.Size.Y / 2
				local at = info.at
				local face = Vector3.new(0, at.Y, 0) - at
				face = Vector3.new(face.X, 0, face.Z)
				local pos = at + Vector3.new(0, up, 0)
				model:PivotTo(CFrame.lookAt(pos, pos + (face.Magnitude > 1 and face.Unit or Vector3.new(0, 0, 1))))
				root.Anchored = true
				model:SetAttribute("NPC", true)
				model:SetAttribute("Master", true)
				model:SetAttribute("Awaken", 2)
				model:SetAttribute("Quote", info.quote)
				-- 발밑의 빛나는 진
				for i, r in ipairs({ 5, 3.2 }) do
					local sig = Instance.new("Part")
					sig.Name = "MasterSigil"
					sig.Anchored = true
					sig.CanCollide = false
					sig.CanQuery = false
					sig.Shape = Enum.PartType.Cylinder
					sig.Size = Vector3.new(0.1, r * 2, r * 2)
					sig.CFrame = CFrame.new(at + Vector3.new(0, 0.08 + i * 0.02, 0)) * CFrame.Angles(0, 0, math.rad(90))
					sig.Color = i == 1 and style.color or style.color2
					sig.Material = Enum.Material.Neon
					sig.Transparency = i == 1 and 0.55 or 0.7
					sig.Parent = mf
				end
				model:SetAttribute("Style", style.id)
				model:SetAttribute("Label", info.name)
				local head = model:FindFirstChild("Head")
				if head and head:IsA("BasePart") then
					masterTag(head, info.name, style)
				end
				local pp = Instance.new("ProximityPrompt")
				pp.Name = "Master"
				pp.ActionText = "권법 배우기"
				pp.ObjectText = info.name
				pp.HoldDuration = 0
				pp.MaxActivationDistance = 16
				pp.RequiresLineOfSight = false
				pp.KeyboardKeyCode = Enum.KeyCode.T
				pp.Parent = root
				pp.Triggered:Connect(function(player: Player)
					onTrigger(player, style.id)
				end)
				model.Parent = mf
			end)
			if not ok then
				warn("[권왕] 사부 만들기 오류:", style.id, err)
			end
		end
	end
end

-- 싸움 없이 치운다 (시험이 끝났을 때)
function Npc.despawn(f: any)
	for i, e in ipairs(Npc.list) do
		if e.f == f then
			table.remove(Npc.list, i)
			break
		end
	end
	Combat.unregister(f.model)
	f.model:Destroy()
end

function Npc.find(model: Model): Enemy?
	for _, e in ipairs(Npc.list) do
		if e.f.model == model then
			return e
		end
	end
	return nil
end

-- 쓰러진 적: 잠시 뒤 치우고, 정해진 시간 뒤 다시 나타난다
function Npc.onDeath(f: any)
	for i, e in ipairs(Npc.list) do
		if e.f == f then
			table.remove(Npc.list, i)
			for player in pairs(e.engaged) do
				Push:FireClient(player, "boss", nil)
			end
			task.delay(2.5, function()
				Combat.unregister(f.model)
				f.model:Destroy()
			end)
			local wait = e.kind == "boss" and (e.def.respawn or 120) or Config.ENEMY_RESPAWN
			if e.region == "simma" or e.region == "trial" or e.region == "summon" then
				return -- 심마는 다시 나타나지 않는다
			end
			task.delay(wait, function()
				local ok, err = pcall(Npc.spawn, e.typeId, e.kind == "boss", e.home, e.region)
				if not ok then
					warn("[권왕] 적 다시 만들기 오류:", e.typeId, err)
				end
			end)
			return
		end
	end
end

------------------------------------------------------------------------
-- 생각하기 (0.1초마다)
------------------------------------------------------------------------
local function flatDist(a: Vector3, b: Vector3): number
	return Vector3.new(a.X - b.X, 0, a.Z - b.Z).Magnitude
end

local function inSafe(pos: Vector3): boolean
	for _, r in ipairs(Config.Regions) do
		if r.safe and math.abs(pos.X - r.center.X) <= r.size.X / 2 and math.abs(pos.Z - r.center.Z) <= r.size.Z / 2 then
			return true
		end
	end
	return false
end

local function faceTo(e: Enemy, pos: Vector3)
	local root = e.f.root
	local p = root.Position
	local dir = Vector3.new(pos.X - p.X, 0, pos.Z - p.Z)
	if dir.Magnitude > 0.1 then
		root.CFrame = CFrame.lookAt(p, p + dir)
	end
end

local function nearestPlayer(e: Enemy, radius: number): any?
	local best, bestD = nil, radius
	local pos = e.f.root.Position
	for _, player in ipairs(Players:GetPlayers()) do
		local pf = Combat.fighterOfPlayer(player)
		if pf and not pf.dead and not inSafe(pf.root.Position) then
			local d = flatDist(pf.root.Position, pos)
			if d < bestD then
				best, bestD = pf, d
			end
		end
	end
	return best
end

local function attack(e: Enemy, move: any)
	local f = e.f
	local tgt = e.target
	if not tgt then
		return
	end
	e.seq += 1
	local speed = (e.phase2 and e.def.phase2 and e.def.phase2.speed) or 1
	faceTo(e, tgt.root.Position)
	local act = Combat.begin(f, move, move.id, e.seq, { enemy = true, speed = speed, align = move.windup / speed })
	f.hum:MoveTo(f.root.Position)
	-- 순간이동 (보스): 멈칫이 끝나기 직전 상대 등 뒤로
	if move.teleport then
		task.delay(math.max(0, move.windup / speed - 0.12), function()
			if f.act == act and not f.dead and not tgt.dead then
				local behind = tgt.root.Position - Combat.look(tgt) * 4
				f.root.CFrame = CFrame.lookAt(behind, Vector3.new(tgt.root.Position.X, behind.Y, tgt.root.Position.Z))
				Push:FireAllClients("blink", f.model, behind)
			end
		end)
	end
	-- 앞으로 내딛기
	if move.lunge then
		task.delay(math.max(0, move.windup / speed - 0.08), function()
			if f.act == act and not f.dead then
				if e.target then
					faceTo(e, e.target.root.Position)
				end
				f.root.AssemblyLinearVelocity = Combat.look(f) * (move.lunge / 0.22) + Vector3.new(0, 2, 0)
			end
		end)
	end
	for i, h in ipairs(move.hits) do
		task.delay(h.t / speed, function()
			if f.act ~= act or f.dead then
				return
			end
			f.lastSwingAt = os.clock()
			-- 큰 보스는 팔이 길다
			local hh = h
			if e.def.reach then
				hh = table.clone(h)
				hh.range *= e.def.reach
				hh.radius *= e.def.reach
			end
			for _, victim in ipairs(Combat.query(f, hh)) do
				Combat.applyHit(f, victim, hh, { move = move, act = act, unblockable = move.unblockable, slotKey = i })
			end
		end)
	end
	local recover = (0.55 + math.random() * 0.7) / speed
	if e.kind == "boss" then
		recover *= 0.7
	end
	e.nextAttack = os.clock() + act.dur + recover
	e.attackingUntil = os.clock() + act.dur + 0.25
end

------------------------------------------------------------------------
-- 보스 패턴: 바닥에 붉은 표시가 먼저 뜨고, 잠시 뒤 터진다 (대시로 피하거나 표시 밖으로)
--   quake  보스 둘레가 울린다            leap   표적 자리로 뛰어올라 내려찍는다
--   charge 표적 쪽으로 한 줄 돌진         rain   표적 둘레 여러 곳에 벼락·얼음·피
--   donut  보스에서 떨어진 고리가 터진다 (보스 품으로 파고들면 안전)
--   summon 부하를 부른다
------------------------------------------------------------------------
local BOSS_RED = Color3.fromRGB(255, 60, 40)
local function playersNear(f: any, center: Vector3, r0: number, r1: number): { any }
	local out = {}
	for _, o in pairs(Combat.fighters) do
		if Combat.hostile(f, o) and not o.dead then
			local d = Vector3.new(o.root.Position.X - center.X, 0, o.root.Position.Z - center.Z).Magnitude
			if d >= r0 and d <= r1 then
				table.insert(out, o)
			end
		end
	end
	return out
end

local function bossHit(e: Enemy, victims: { any }, h: any, name: string)
	for _, o in ipairs(victims) do
		Combat.applyHit(e.f, o, h, { move = { name = name }, unblockable = true })
	end
end

local function telegraph(at: Vector3, radius: number, time: number, color: Color3?)
	Push:FireAllClients("skillfx", { kind = "telegraph", at = at, radius = radius, time = time, color = color or BOSS_RED })
end

local function runPattern(e: Enemy, tgt: any, pat: any, phase: number)
	local f = e.f
	local sp = 1 + 0.15 * (phase - 1) -- 단계가 오를수록 빨라진다
	local warn = (pat.warn or 1.0) / sp
	local h = pat.hit
	local kind = pat.kind
	-- 몸짓 (멈칫하며 기를 모은다)
	local act = Combat.begin(f, { id = "bp_" .. kind, name = pat.name, pose = pat.pose or "w_overhead", dur = warn + 0.5, hits = {} }, "pat", e.seq + 1, { enemy = true })
	e.seq += 1
	f.hum:MoveTo(f.root.Position)
	faceTo(e, tgt.root.Position)
	Push:FireAllClients("bossCall", { m = f.model, name = pat.name })
	local function later(sec: number, fn: () -> ())
		task.delay(sec, function()
			if not f.dead and f.root.Parent then
				fn()
			end
		end)
	end
	if kind == "quake" then
		local at = f.root.Position
		telegraph(at, pat.radius, warn)
		later(warn, function()
			Push:FireAllClients("skillfx", { kind = "wave", at = at, radius = pat.radius, color = BOSS_RED })
			bossHit(e, playersNear(f, at, 0, pat.radius), h, pat.name)
		end)
	elseif kind == "leap" then
		local at = tgt.root.Position
		telegraph(at, pat.radius, warn)
		later(warn * 0.55, function()
			-- 뛰어오른다 (보이게 높이)
			f.root.AssemblyLinearVelocity = Vector3.new(0, 70, 0)
		end)
		later(warn, function()
			f.root.CFrame = CFrame.new(at + Vector3.new(0, 4 * (e.def.scale or 1), 0)) * (f.root.CFrame - f.root.Position)
			Push:FireAllClients("skillfx", { kind = "drop", at = at, radius = pat.radius, color = BOSS_RED })
			bossHit(e, playersNear(f, at, 0, pat.radius), h, pat.name)
		end)
	elseif kind == "charge" then
		local from = f.root.Position
		local dir = Vector3.new(tgt.root.Position.X - from.X, 0, tgt.root.Position.Z - from.Z)
		dir = dir.Magnitude > 0.1 and dir.Unit or Vector3.new(0, 0, -1)
		local len = pat.length or 40
		local times = pat.times or 1
		for k = 0, times - 1 do
			later(k * (warn + 0.35), function()
				local start = f.root.Position
				if k > 0 and e.target then
					local d2 = Vector3.new(e.target.root.Position.X - start.X, 0, e.target.root.Position.Z - start.Z)
					dir = d2.Magnitude > 0.1 and d2.Unit or dir
				end
				Push:FireAllClients("skillfx", { kind = "lineTele", from = start, to = start + dir * len, width = pat.width or 8, time = warn, color = BOSS_RED })
				later(warn, function()
					local p0 = f.root.Position
					f.root.CFrame = CFrame.lookAt(p0, p0 + dir)
					f.root.AssemblyLinearVelocity = dir * (len / 0.35)
					Push:FireAllClients("afterimage", f.model)
					local hitSet = {}
					for s = 1, 5 do
						later(s * 0.07, function()
							for _, o in ipairs(playersNear(f, f.root.Position, 0, (pat.width or 8) * 0.6 + 2)) do
								if not hitSet[o] then
									hitSet[o] = true
									bossHit(e, { o }, h, pat.name)
								end
							end
						end)
					end
				end)
			end)
		end
	elseif kind == "rain" then
		local n = (pat.count or 5) + (phase - 1) * 2
		for i = 1, n do
			local base = tgt.root.Position
			local a = math.random() * math.pi * 2
			local at = i == 1 and base or base + Vector3.new(math.cos(a), 0, math.sin(a)) * math.random(4, pat.spread or 18)
			later((i - 1) * 0.12, function()
				telegraph(at, pat.radius, warn, pat.color)
				later(warn, function()
					Push:FireAllClients("skillfx", { kind = "strike", at = at, radius = pat.radius, fx = pat.fx or "lightning", color = pat.color or BOSS_RED })
					bossHit(e, playersNear(f, at, 0, pat.radius), h, pat.name)
				end)
			end)
		end
	elseif kind == "donut" then
		local at = f.root.Position
		Push:FireAllClients("skillfx", { kind = "donut", at = at, inner = pat.inner, outer = pat.outer, time = warn, color = BOSS_RED })
		later(warn, function()
			Push:FireAllClients("skillfx", { kind = "wave", at = at, radius = pat.outer, color = BOSS_RED })
			bossHit(e, playersNear(f, at, pat.inner, pat.outer), h, pat.name)
		end)
	elseif kind == "summon" then
		local alive = 0
		for _, o in ipairs(Npc.list) do
			if (o :: any).summoner == e and not o.f.dead then
				alive += 1
			end
		end
		for i = 1, math.max(0, math.min(pat.count or 3, (pat.max or 6) - alive)) do
			local a = i / 3 * math.pi * 2
			local at = f.root.Position + Vector3.new(math.cos(a) * 10, 0, math.sin(a) * 10)
			Push:FireAllClients("skillfx", { kind = "mark", at = at, radius = 4, time = warn, color = BOSS_RED })
			later(warn, function()
				local m = Npc.spawn(pat.enemy, false, at, "summon")
				if m then
					(m :: any).summoner = e
					m.target = tgt
				end
			end)
		end
	end
	local cd = (pat.cd or 7) / sp
	e.nextPattern = os.clock() + warn + cd
	e.nextAttack = os.clock() + warn + 0.8
	e.attackingUntil = os.clock() + warn + 0.5
	local _ = act
end

-- 보스 단계: 체력 2/3, 1/3에서 다음 단계로 (빨라지고 패턴이 늘어난다)
local function bossPhase(e: Enemy): number
	local f = e.f
	local r = f.hp / math.max(1, f.maxHp)
	local ph = r > 0.66 and 1 or (r > 0.33 and 2 or 3)
	local old = (e :: any).phase or 1
	if ph > old then
		(e :: any).phase = ph
		f.model:SetAttribute("BossPhase", ph)
		f.walk = e.def.speed * (1 + 0.12 * (ph - 1))
		Push:FireAllClients("bossPhase", f.model, e.def.name, ph)
		-- 단계가 바뀌면 곧바로 큰 패턴
		e.nextPattern = os.clock() + 0.6
	end
	return ph
end

local function think(e: Enemy, t: number)
	local f = e.f
	if f.dead or not f.root.Parent then
		return
	end
	local pos = f.root.Position
	-- 버티기에 들어가면 곧바로 되받아친다
	if (f :: any).retaliate then
		(f :: any).retaliate = nil
		e.nextAttack = math.min(e.nextAttack, t)
	end
	-- 근처에 사람이 없으면 쉰다
	local anyone = false
	for _, player in ipairs(Players:GetPlayers()) do
		local pf = Combat.fighterOfPlayer(player)
		if pf and flatDist(pf.root.Position, pos) < Config.ENEMY_ACTIVE_RANGE then
			anyone = true
			break
		end
	end
	if not anyone then
		e.target = nil
		return
	end
	-- 너무 멀리 끌려 나오면 집으로
	if flatDist(pos, e.home) > 150 then
		e.target = nil
	end
	if Combat.stunned(f) then
		f.hum:MoveTo(pos)
		return
	end
	if f.guarding and t > e.guardUntil then
		f.guarding = false
		f.model:SetAttribute("Guard", false)
	end
	-- 보스 단계 (세 단계)
	local phase = 1
	if e.kind == "boss" then
		phase = bossPhase(e)
		e.phase2 = phase >= 2
	end
	if Combat.busy(f) then
		if e.target and not (f.act and f.act.move.lunge) then
			faceTo(e, e.target.root.Position)
		end
		return
	end
	-- 상대 고르기
	local tgt = e.target
	-- 사부의 분신은 시험을 청한 사람하고만 겨룬다 (사부의 자리 안에서도)
	local owner = (f :: any).trialOwner
	if owner then
		tgt = Combat.fighterOfPlayer(owner)
	end
	if tgt and (tgt.dead or not tgt.root.Parent or (inSafe(tgt.root.Position) and not e.def.duel) or flatDist(tgt.root.Position, pos) > e.def.aggro * 1.6) then
		tgt = nil
	end
	if not tgt and not owner then
		tgt = nearestPlayer(e, e.def.aggro)
	end
	-- 처음 상대를 잡으면 둘레의 동료도 함께 덤빈다
	if tgt and not e.target then
		for _, o in ipairs(Npc.list) do
			if o ~= e and not o.target and not o.f.dead and flatDist(o.f.root.Position, pos) < 45 then
				o.target = tgt
			end
		end
	end
	e.target = tgt
	if not tgt then
		if flatDist(pos, e.home) > 10 then
			f.hum:MoveTo(e.home)
		end
		return
	end
	-- 보스: 싸우는 사람 화면에 체력 막대
	if e.kind == "boss" and tgt.player and not e.engaged[tgt.player] then
		e.engaged[tgt.player] = true
		Push:FireClient(tgt.player, "boss", f.model)
	end
	local d = flatDist(tgt.root.Position, pos)
	-- 보스 패턴 (단계마다 쓸 수 있는 것이 늘어난다)
	if e.kind == "boss" and e.def.patterns then
		local ea = e :: any
		if not ea.nextPattern then
			ea.nextPattern = t + 3
		end
		if t >= ea.nextPattern and d < 50 then
			local pool = {}
			for _, pat in ipairs(e.def.patterns) do
				if (pat.phase or 1) <= phase then
					table.insert(pool, pat)
				end
			end
			if #pool > 0 then
				runPattern(e, tgt, pool[math.random(1, #pool)], phase)
				return
			end
		end
	end
	-- 상대가 막 치기 시작하면 가끔 막는다 (보스는 더 자주)
	local tact = tgt.act
	if tact and t - tact.start < 0.18 and d < 11 and not f.guarding and not (tact :: any).perfect then
		-- 마구 누르는 연타는 읽혀서 막히고 흘려진다. 박자를 맞춘 일격(連)은 읽지 못한다
		local sloppy = (tgt :: any).sloppy or 0
		local chance = (e.kind == "boss" and 0.4 or 0.22) + math.min(0.5, sloppy * 0.09)
		if math.random() < chance then
			f.guarding = true
			f.guardStart = t
			e.guardUntil = t + 0.7
			f.model:SetAttribute("Guard", true)
			faceTo(e, tgt.root.Position)
			f.hum:MoveTo(pos)
			return
		end
	end
	if f.guarding then
		faceTo(e, tgt.root.Position)
		return
	end
	-- 공격 사이엔 자주 막기 자세를 잡는다: 마구 치면 막히고, 막 잡은 막기엔 흘려진다
	-- (상대가 칠 때를 기다려 흘리고 파고들거나, 균형을 깨거나, 뒤를 잡아야 한다)
	if d < 8 and t < e.nextAttack and math.random() < (e.kind == "boss" and 0.22 or (e.def.elite and 0.18 or 0.12)) then
		f.guarding = true
		f.guardStart = t
		e.guardUntil = t + 0.6 + math.random() * 0.7
		f.model:SetAttribute("Guard", true)
		faceTo(e, tgt.root.Position)
		f.hum:MoveTo(pos)
		return
	end
	-- 한 사람을 한꺼번에 치는 적은 둘까지: 나머지는 둘레를 돌며 차례를 기다린다 (보스와 분신은 예외)
	local waiting = false
	if e.kind ~= "boss" and not e.def.duel then
		local busy = 0
		for _, o in ipairs(Npc.list) do
			if o ~= e and o.target == tgt and not o.f.dead and (o.attackingUntil > t or o.kind == "boss") and flatDist(o.f.root.Position, tgt.root.Position) < 20 then
				busy += 1
			end
		end
		waiting = busy >= Config.MAX_ATTACKERS
	end
	if waiting and t >= e.nextAttack then
		e.nextAttack = t + 0.3 + math.random() * 0.5
	end
	-- 칠 수 있으면 친다
	if t >= e.nextAttack then
		local weak = e.kind ~= "boss" and not e.def.elite and not e.def.duel and e.level <= Config.NO_RED_LEVEL
		local moves = {}
		for _, m in ipairs(e.def.moves) do
			-- 약한 적은 붉은 공격(막을 수 없는 공격)을 쓰지 않는다
			if d <= m.range * (e.def.reach or 1) + 1 and not (weak and m.unblockable) then
				table.insert(moves, m)
			end
		end
		if e.phase2 and e.def.phase2 and e.def.phase2.extra and d <= e.def.phase2.extra.range + 1 then
			table.insert(moves, e.def.phase2.extra)
		end
		if #moves > 0 then
			attack(e, moves[math.random(1, #moves)])
			return
		end
	end
	-- 거리 맞추기: 멀면 다가가고, 가까우면 옆으로 돈다
	local keep = (e.def.keep or 5) + (waiting and 5 or 0)
	local to = tgt.root.Position - pos
	local flatTo = Vector3.new(to.X, 0, to.Z)
	local dir = flatTo.Magnitude > 0.1 and flatTo.Unit or Vector3.new(0, 0, 1)
	-- 동료끼리 겹치지 않게 서로 밀어낸다 (한 덩어리로 뭉치지 않고 둘레로 퍼진다)
	local apart = Vector3.zero
	for _, o in ipairs(Npc.list) do
		if o ~= e and not o.f.dead and o.f.root.Parent then
			local off = pos - o.f.root.Position
			local od = Vector3.new(off.X, 0, off.Z).Magnitude
			if od < 6 and od > 0.05 then
				apart += Vector3.new(off.X, 0, off.Z).Unit * (6 - od)
			end
		end
	end
	if d > keep + 2 then
		f.hum:MoveTo(tgt.root.Position - dir * keep + apart)
	elseif d < keep - 2 then
		f.hum:MoveTo(pos - dir * 4 + apart)
	else
		if math.random() < 0.05 then
			e.strafe = -e.strafe
		end
		local side = Vector3.new(-dir.Z, 0, dir.X) * e.strafe
		f.hum:MoveTo(pos + side * 5 + apart)
		faceTo(e, tgt.root.Position)
	end
end

function Npc.start()
	task.spawn(function()
		while true do
			task.wait(0.1)
			local t = os.clock()
			for _, e in ipairs(Npc.list) do
				local ok, err = pcall(think, e, t)
				if not ok then
					warn("[권왕] 적 생각 오류:", err)
				end
			end
		end
	end)
end

return Npc
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="9">
        <Properties>
          <string name="Name">Skills</string>
          <string name="Source"><![CDATA[-- 권왕: 권법마다 다른 기술 장치 (서버)
-- 기술 정의의 mech = { kind = ... } 를 읽어 그 권법만의 방식으로 친다
--   zone     정해진 자리에 오래 남아 끌어당기거나 피를 빨아들이는 소용돌이
--   reflect  잠깐 모든 공격을 저절로 흘려 되받아치고, 끝에 큰 물결
--   cone     앞쪽 부채꼴 (사자후: 막기를 깬다 / 취화: 불길이 이어진다)
--   drop     가까운 적 자리에 붉은 원이 뜨고, 잠시 뒤 하늘에서 내리찍는다
--   line     앞으로 한 줄로 차례차례 솟는 기둥
--   chainTp  적들 사이를 순간이동하며 차례로 찬다
--   targets  둘레의 적 몇을 골라 그 머리 위로 내리꽂는다 (번개, 별)
--   storm    한동안 둘레 아무 데나 벼락이 쏟아진다
--   freeze   둘레의 시간이 멈추고, 멈춘 적을 한 번에 지운다
--   launch   둘레의 적을 모두 하늘로 띄웠다가 빛으로 내리친다
--   moving   내 몸을 따라다니며 계속 베는 꽃잎 폭풍
--   trail    돌진한 길에 남은 향기가 잠시 뒤 터진다
local Combat = require(script.Parent:WaitForChild("Combat"))

local Skills = {}
local Push: RemoteEvent

function Skills.init(push: RemoteEvent)
	Push = push
end

local function flat(v: Vector3): Vector3
	local f = Vector3.new(v.X, 0, v.Z)
	return f.Magnitude > 1e-3 and f.Unit or Vector3.new(0, 0, -1)
end

local function hostilesNear(f: any, center: Vector3, radius: number): { any }
	local out = {}
	for _, o in pairs(Combat.fighters) do
		if Combat.hostile(f, o) and not o.dead then
			local d = Vector3.new(o.root.Position.X - center.X, 0, o.root.Position.Z - center.Z).Magnitude
			if d <= radius and math.abs(o.root.Position.Y - center.Y) < 30 then
				table.insert(out, o)
			end
		end
	end
	return out
end

local function nearestList(f: any, range: number, n: number): { any }
	local list = hostilesNear(f, f.root.Position, range)
	table.sort(list, function(a, b)
		return (a.root.Position - f.root.Position).Magnitude < (b.root.Position - f.root.Position).Magnitude
	end)
	local out = {}
	for i = 1, math.min(n, #list) do
		out[i] = list[i]
	end
	return out
end

local function scaled(h: any, k: number): any
	local c = table.clone(h)
	c.dmg = (c.dmg or 0) * k
	c.posture = (c.posture or 0) * k
	return c
end

local function strike(f: any, tgt: any, h: any, move: any)
	if tgt.dead or f.dead then
		return
	end
	Combat.applyHit(f, tgt, h, { move = move, isSkill = true, chain = true })
end

local function pullTo(o: any, center: Vector3, power: number)
	local dir = Vector3.new(center.X - o.root.Position.X, 0, center.Z - o.root.Position.Z)
	if dir.Magnitude < 1.5 then
		return
	end
	local vel = dir.Unit * math.min(power, dir.Magnitude * 6)
	if o.player then
		Push:FireClient(o.player, "knock", vel, 0)
	elseif not o.root.Anchored then
		o.root.AssemblyLinearVelocity = vel + Vector3.new(0, o.root.AssemblyLinearVelocity.Y, 0)
	end
end

-- 기술 하나의 장치를 돌린다. ctx = { scale, speed }
function Skills.run(f: any, move: any, ctx: any)
	local m = move.mech
	if not m then
		return
	end
	local sp = ctx.speed or 1
	local sc = ctx.scale or 1
	local look = flat(Combat.look(f))
	local style = f.style
	local function alive(): boolean
		return not f.dead and f.root.Parent ~= nil
	end
	local function after(sec: number, fn: () -> ())
		task.delay(sec / sp, function()
			if alive() then
				fn()
			end
		end)
	end
	local hit = m.hit and scaled(m.hit, sc) or nil
	local kind = m.kind

	if kind == "zone" then
		local center = m.at == "self" and f.root.Position or f.root.Position + look * (m.dist or 8)
		Push:FireAllClients("skillfx", { kind = "zone", at = center, radius = m.radius, dur = m.dur / sp, style = style, fx = m.fx })
		local n = math.floor(m.dur / m.every)
		for i = 0, n - 1 do
			after((m.delay or 0) + i * m.every, function()
				local victims = hostilesNear(f, center, m.radius)
				for _, o in ipairs(victims) do
					if m.pull then
						pullTo(o, center, m.pull)
					end
					if hit then
						strike(f, o, hit, move)
					end
				end
				-- 혈해: 적 하나 벨 때마다 체력을 되찾는다
				if m.heal and #victims > 0 then
					f.hp = math.min(f.maxHp, f.hp + f.maxHp * m.heal * #victims)
					Combat.sync(f)
				end
			end)
		end
	elseif kind == "reflect" then
		f.reflectUntil = os.clock() + m.dur / sp
		f.reflectHit = hit
		Push:FireAllClients("skillfx", { kind = "reflect", m = f.model, dur = m.dur / sp, style = style })
		after(m.dur, function()
			Push:FireAllClients("skillfx", { kind = "wave", at = f.root.Position, radius = m.radius, style = style })
			for _, o in ipairs(hostilesNear(f, f.root.Position, m.radius)) do
				strike(f, o, scaled(m.wave, sc), move)
			end
		end)
	elseif kind == "cone" then
		local ticks = m.dur and math.max(1, math.floor(m.dur / m.every)) or 1
		Push:FireAllClients("skillfx", { kind = "cone", m = f.model, range = m.range, angle = m.angle, dur = (m.dur or 0.4) / sp, delay = (m.delay or 0) / sp, style = style, fx = m.fx })
		for i = 0, ticks - 1 do
			after((m.delay or 0) + i * (m.every or 0), function()
				local fwd = flat(Combat.look(f))
				local cosA = math.cos(math.rad(m.angle / 2))
				for _, o in ipairs(hostilesNear(f, f.root.Position, m.range)) do
					local to = flat(o.root.Position - f.root.Position)
					if fwd:Dot(to) >= cosA then
						strike(f, o, hit, move)
						-- 사자후: 막기를 깨부순다
						if m.guardBreak and not o.dead then
							Combat.breakGuard(o)
						end
					end
				end
			end)
		end
	elseif kind == "drop" then
		local tgt = nearestList(f, m.range or 26, 1)[1]
		local at = tgt and tgt.root.Position or f.root.Position + look * (m.dist or 10)
		at = Vector3.new(at.X, f.root.Position.Y, at.Z)
		Push:FireAllClients("skillfx", { kind = "telegraph", at = at, radius = m.radius, time = m.delay / sp, style = style })
		after(m.delay, function()
			Push:FireAllClients("skillfx", { kind = "drop", at = at, radius = m.radius, style = style, fx = m.fx })
			for _, o in ipairs(hostilesNear(f, at, m.radius)) do
				strike(f, o, hit, move)
			end
		end)
	elseif kind == "line" then
		local origin = f.root.Position
		for i = 1, m.count do
			after(m.delay + (i - 1) * m.step, function()
				local p = origin + look * (m.start + (i - 1) * m.spacing)
				Push:FireAllClients("skillfx", { kind = "pillar", at = p, radius = m.radius, style = style, i = i })
				for _, o in ipairs(hostilesNear(f, p, m.radius)) do
					strike(f, o, hit, move)
				end
			end)
		end
	elseif kind == "chainTp" then
		local list = nearestList(f, m.range, m.n)
		if #list == 0 then
			return
		end
		f.iframeUntil = math.max(f.iframeUntil, os.clock() + (m.delay + #list * m.every + 0.3) / sp)
		for i = 1, m.n do
			local tgt = list[((i - 1) % #list) + 1]
			after(m.delay + (i - 1) * m.every, function()
				if tgt.dead or not tgt.root.Parent then
					return
				end
				-- 상대 등 뒤로 (돌 때마다 다른 쪽으로)
				local a = i * 2.1
				local off = Vector3.new(math.cos(a), 0, math.sin(a)) * 3.5
				local at = tgt.root.Position + off
				local cf = CFrame.lookAt(at + Vector3.new(0, 0.5, 0), Vector3.new(tgt.root.Position.X, at.Y + 0.5, tgt.root.Position.Z))
				if f.player and f.player.Character then
					f.player.Character:PivotTo(cf)
				else
					f.root.CFrame = cf
				end
				Push:FireAllClients("blink", f.model, at)
				Push:FireAllClients("skillfx", { kind = "slash", m = f.model, t = tgt.model, style = style, i = i })
				strike(f, tgt, hit, move)
			end)
		end
	elseif kind == "targets" then
		local list = nearestList(f, m.range, m.n)
		if #list == 0 then
			-- 아무도 없으면 앞에
			Push:FireAllClients("skillfx", { kind = "strike", at = f.root.Position + look * 10, radius = m.radius, style = style, fx = m.fx, delay = m.delay / sp })
			return
		end
		for i, tgt in ipairs(list) do
			local at = tgt.root.Position
			Push:FireAllClients("skillfx", { kind = "mark", at = at, radius = m.radius, time = (m.delay + (i - 1) * (m.stagger or 0)) / sp, style = style })
			after(m.delay + (i - 1) * (m.stagger or 0), function()
				local now = tgt.root.Parent and tgt.root.Position or at
				Push:FireAllClients("skillfx", { kind = "strike", at = now, radius = m.radius, style = style, fx = m.fx })
				for _, o in ipairs(hostilesNear(f, now, m.radius)) do
					strike(f, o, hit, move)
				end
			end)
		end
	elseif kind == "storm" then
		local n = math.floor(m.dur / m.every)
		Push:FireAllClients("skillfx", { kind = "stormcloud", m = f.model, dur = m.dur / sp, radius = m.range, style = style })
		for i = 0, n - 1 do
			after((m.delay or 0) + i * m.every, function()
				local list = hostilesNear(f, f.root.Position, m.range)
				local at
				if #list > 0 then
					at = list[math.random(1, #list)].root.Position
				else
					local a = math.random() * math.pi * 2
					at = f.root.Position + Vector3.new(math.cos(a), 0, math.sin(a)) * math.random(4, m.range)
				end
				Push:FireAllClients("skillfx", { kind = "strike", at = at, radius = m.radius, style = style, fx = "lightning", small = true })
				for _, o in ipairs(hostilesNear(f, at, m.radius)) do
					strike(f, o, hit, move)
				end
			end)
		end
		after((m.delay or 0) + m.dur, function()
			Push:FireAllClients("skillfx", { kind = "strike", at = f.root.Position + look * 4, radius = m.finalRadius, style = style, fx = "lightning" })
			for _, o in ipairs(hostilesNear(f, f.root.Position, m.finalRadius)) do
				strike(f, o, scaled(m.final, sc), move)
			end
		end)
	elseif kind == "freeze" then
		after(m.delay, function()
			local victims = hostilesNear(f, f.root.Position, m.radius)
			local models = {}
			for _, o in ipairs(victims) do
				Combat.stun(o, m.dur)
				o.model:SetAttribute("Frozen", true)
				table.insert(models, o.model)
			end
			Push:FireAllClients("skillfx", { kind = "freeze", at = f.root.Position, radius = m.radius, targets = models, dur = m.dur / sp, style = style })
			after(m.hitAt, function()
				for _, o in ipairs(victims) do
					if o.model.Parent then
						o.model:SetAttribute("Frozen", nil)
					end
					Push:FireAllClients("skillfx", { kind = "erase", t = o.model, style = style })
					strike(f, o, hit, move)
				end
			end)
			task.delay((m.dur + 0.2) / sp, function()
				for _, o in ipairs(victims) do
					if o.model.Parent then
						o.model:SetAttribute("Frozen", nil)
					end
				end
			end)
		end)
	elseif kind == "launch" then
		after(m.delay, function()
			local victims = hostilesNear(f, f.root.Position, m.radius)
			for _, o in ipairs(victims) do
				Combat.stun(o, m.stun or 1.5)
				o.model:SetAttribute("LaunchedAt", os.clock())
				if o.player then
					Push:FireClient(o.player, "knock", Vector3.new(0, m.up, 0), m.stun or 1.5)
				elseif not o.root.Anchored then
					o.root.AssemblyLinearVelocity = Vector3.new(0, m.up, 0)
				end
			end
			Push:FireAllClients("skillfx", { kind = "launch", at = f.root.Position, radius = m.radius, style = style })
			after(m.hitAt, function()
				Push:FireAllClients("skillfx", { kind = "beam", at = f.root.Position, radius = m.radius, style = style })
				for _, o in ipairs(victims) do
					strike(f, o, hit, move)
				end
			end)
		end)
	elseif kind == "moving" then
		Push:FireAllClients("skillfx", { kind = "moving", m = f.model, radius = m.radius, dur = m.dur / sp, style = style })
		local n = math.floor(m.dur / m.every)
		for i = 0, n - 1 do
			after((m.delay or 0) + i * m.every, function()
				for _, o in ipairs(hostilesNear(f, f.root.Position, m.radius)) do
					strike(f, o, hit, move)
				end
			end)
		end
	elseif kind == "trail" then
		local from = f.root.Position
		after(m.delay, function()
			local to = f.root.Position
			local pts = {}
			for k = 0, m.count - 1 do
				table.insert(pts, from:Lerp(to, (k + 0.5) / m.count))
			end
			Push:FireAllClients("skillfx", { kind = "trail", points = pts, radius = m.radius, style = style })
			local done = {}
			for _, p in ipairs(pts) do
				for _, o in ipairs(hostilesNear(f, p, m.radius)) do
					if not done[o] then
						done[o] = true
						strike(f, o, hit, move)
					end
				end
			end
		end)
	end
end

return Skills
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="10">
        <Properties>
          <string name="Name">World</string>
          <string name="Source"><![CDATA[-- 권왕: 강호 (오픈 월드). 가운데 청운 마을, 서쪽 대나무 숲, 북쪽 흑호채, 동쪽 비류 폭포 계곡, 남쪽 들판
-- 그리고 강호 곳곳에 흩어진 일곱 사부의 자리
local Lighting = game:GetService("Lighting")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage:WaitForChild("Config"))

local World = {}

local folder: Folder
local rng = Random.new(1337)

local function part(props: { [string]: any }): Part
	local p = Instance.new("Part")
	p.Anchored = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	for k, v in pairs(props) do
		if k ~= "Parent" then
			(p :: any)[k] = v
		end
	end
	if p.CanCollide == false then
		p.CanQuery = false
	end
	p.Parent = props.Parent or folder
	return p
end

local function sign(target: BasePart, face: Enum.NormalId, lines: { { any } })
	local gui = Instance.new("SurfaceGui")
	gui.Face = face
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 20
	gui.LightInfluence = 0.3
	gui.Parent = target
	local list = Instance.new("UIListLayout")
	list.VerticalAlignment = Enum.VerticalAlignment.Center
	list.Parent = gui
	for _, line in ipairs(lines) do
		local l = Instance.new("TextLabel")
		l.BackgroundTransparency = 1
		l.Size = UDim2.fromScale(1, line[3] or 0.5)
		l.Font = Enum.Font.GothamBlack
		l.TextScaled = true
		l.TextColor3 = line[2]
		l.TextStrokeTransparency = 0.4
		l.Text = line[1]
		l.Parent = gui
	end
end

local function prompt(target: BasePart, action: string, object: string, name: string): ProximityPrompt
	local pp = Instance.new("ProximityPrompt")
	pp.Name = name
	pp.ActionText = action
	pp.ObjectText = object
	pp.HoldDuration = 0
	pp.MaxActivationDistance = 12
	pp.RequiresLineOfSight = false
	pp.KeyboardKeyCode = Enum.KeyCode.T
	pp.Parent = target
	return pp
end

function World.setupLighting()
	Lighting.ClockTime = 16.2
	Lighting.Brightness = 2.3
	Lighting.Ambient = Color3.fromRGB(110, 100, 95)
	Lighting.OutdoorAmbient = Color3.fromRGB(150, 140, 130)
	Lighting.EnvironmentDiffuseScale = 0.5
	Lighting.EnvironmentSpecularScale = 0.5
	local atmo = Lighting:FindFirstChildOfClass("Atmosphere") or Instance.new("Atmosphere")
	atmo.Density = 0.24
	atmo.Haze = 1.1
	atmo.Color = Color3.fromRGB(240, 215, 190)
	atmo.Decay = Color3.fromRGB(150, 110, 90)
	atmo.Parent = Lighting
	local bloom = Lighting:FindFirstChildOfClass("BloomEffect") or Instance.new("BloomEffect")
	bloom.Intensity = 0.6
	bloom.Size = 28
	bloom.Threshold = 1.3
	bloom.Parent = Lighting
	local cc = Lighting:FindFirstChildOfClass("ColorCorrectionEffect") or Instance.new("ColorCorrectionEffect")
	cc.Name = "Mood"
	cc.Saturation = 0.1
	cc.Contrast = 0.1
	cc.TintColor = Color3.fromRGB(255, 245, 232)
	cc.Parent = Lighting
	-- 낮과 밤: 한 바퀴 16분. 밤에도 길이 보이게 바깥 빛을 조금 남긴다
	task.spawn(function()
		local DAY = 16 * 60
		local t0 = os.clock() - (16.2 - 6) / 24 * DAY
		while true do
			local h = (6 + (os.clock() - t0) / DAY * 24) % 24
			Lighting.ClockTime = h
			local night = (h < 6.5 or h > 18.5) and 1 or 0
			local dusk = math.clamp(1 - math.abs(h - 18.5) / 1.5, 0, 1) + math.clamp(1 - math.abs(h - 6.5) / 1.5, 0, 1)
			local k = math.max(night, dusk * 0.6)
			Lighting.OutdoorAmbient = Color3.fromRGB(150, 140, 130):Lerp(Color3.fromRGB(95, 105, 150), k)
			Lighting.Brightness = 2.3 - k * 0.9
			task.wait(1)
		end
	end)
end

------------------------------------------------------------------------
-- 건축 (특정 나라 양식이 아닌 판타지풍: 흰 돌, 금빛 테, 빛나는 수정, 깃발)
------------------------------------------------------------------------
local ROOF = Color3.fromRGB(60, 72, 100) -- 짙은 청석 지붕
local WOOD = Color3.fromRGB(95, 65, 45)
local STONE = Color3.fromRGB(205, 198, 182) -- 밝은 돌
local STONE_DARK = Color3.fromRGB(95, 92, 98)
local GOLD = Color3.fromRGB(235, 190, 80)
local WARM = Color3.fromRGB(255, 200, 120) -- 창과 등의 따뜻한 빛
local IRON = Color3.fromRGB(45, 45, 50)

local function light(target: BasePart, color: Color3, range: number, brightness: number?)
	local l = Instance.new("PointLight")
	l.Color = color
	l.Range = range
	l.Brightness = brightness or 1.5
	l.Parent = target
end

local function wedge(props: { [string]: any }): WedgePart
	local w = Instance.new("WedgePart")
	w.Anchored = true
	for k, v in pairs(props) do
		if k ~= "Parent" then
			(w :: any)[k] = v
		end
	end
	w.Parent = props.Parent or folder
	return w
end

local function disc(name: string, at: Vector3, radius: number, height: number, color: Color3, material: Enum.Material, parent: Instance, collide: boolean?): Part
	return part({ Name = name, Shape = Enum.PartType.Cylinder, Size = Vector3.new(height, radius * 2, radius * 2), CFrame = CFrame.new(at) * CFrame.Angles(0, 0, math.rad(90)), Color = color, Material = material, CanCollide = collide ~= false, Parent = parent })
end

-- 떠 있는 수정 (마름모꼴로 세워 빛낸다)
local function crystal(at: Vector3, size: number, color: Color3, parent: Instance): Part
	local c = part({ Name = "Crystal", Size = Vector3.new(size, size * 1.6, size), CFrame = CFrame.new(at) * CFrame.Angles(0, math.rad(45), 0) * CFrame.Angles(math.rad(45), 0, math.rad(45)), Color = color, Material = Enum.Material.Neon, CanCollide = false, Parent = parent })
	light(c, color, size * 8, 2)
	return c
end

-- 깃발 (장대 + 천)
local function banner(at: Vector3, h: number, color: Color3, parent: Instance)
	part({ Name = "BannerPole", Size = Vector3.new(0.6, h, 0.6), Position = at + Vector3.new(0, h / 2, 0), Color = IRON, Material = Enum.Material.Metal, Parent = parent })
	part({ Name = "BannerCloth", Size = Vector3.new(3.4, h * 0.45, 0.15), Position = at + Vector3.new(1.9, h * 0.72, 0), Color = color, Material = Enum.Material.Fabric, CanCollide = false, Parent = parent })
	part({ Name = "BannerTip", Shape = Enum.PartType.Ball, Size = Vector3.new(1, 1, 1), Position = at + Vector3.new(0, h + 0.4, 0), Color = GOLD, Material = Enum.Material.Metal, CanCollide = false, Parent = parent })
end

-- 화로 (돌 받침 + 불)
local function brazier(at: Vector3, s: number, parent: Instance)
	part({ Name = "BrazierStand", Size = Vector3.new(1.4, 4, 1.4) * s, Position = at + Vector3.new(0, 2 * s, 0), Color = STONE_DARK, Material = Enum.Material.Granite, Parent = parent })
	local bowl = disc("BrazierBowl", at + Vector3.new(0, 4.4 * s, 0), 1.6 * s, 0.9 * s, GOLD, Enum.Material.Metal, parent)
	local fire = Instance.new("Fire")
	fire.Size = 5 * s
	fire.Heat = 7
	fire.Parent = bowl
	light(bowl, Color3.fromRGB(255, 160, 80), 18 * s, 1.6)
end

-- 맞배지붕: cf = 처마 높이의 가운데, w×d 위를 덮는다
local function roof(cf: CFrame, w: number, d: number, color: Color3, wallColor: Color3, parent: Instance): number
	local over = 1.8
	local hd = d / 2 + over
	local a = math.rad(32)
	local H = hd * math.tan(a)
	local L = hd / math.cos(a)
	local W = w + over * 2
	for _, side in ipairs({ -1, 1 }) do
		part({ Name = "Roof", Size = Vector3.new(W, 0.8, L), CFrame = cf * CFrame.new(0, H / 2, side * hd / 2) * CFrame.Angles(side * a, 0, 0), Color = color, Material = Enum.Material.Slate, Parent = parent })
	end
	for _, sx in ipairs({ -1, 1 }) do
		local x = sx * (w / 2 - 0.2)
		wedge({ Name = "Gable", Size = Vector3.new(0.6, H, hd - over), CFrame = cf * CFrame.new(x, H / 2 - 0.3, -(hd - over) / 2), Color = wallColor, Material = Enum.Material.Plaster, Parent = parent })
		wedge({ Name = "Gable", Size = Vector3.new(0.6, H, hd - over), CFrame = cf * CFrame.new(x, H / 2 - 0.3, (hd - over) / 2) * CFrame.Angles(0, math.pi, 0), Color = wallColor, Material = Enum.Material.Plaster, Parent = parent })
	end
	part({ Name = "Ridge", Size = Vector3.new(W + 0.4, 0.9, 1.2), CFrame = cf * CFrame.new(0, H + 0.25, 0), Color = color:Lerp(Color3.new(0, 0, 0), 0.3), Material = Enum.Material.Slate, Parent = parent })
	return H
end

-- 집 한 채: 돌 기단, 벽, 나무 뼈대, 빛나는 창, 지붕. 앞은 -Z (tiers = 2면 이층)
local WALLS = { Color3.fromRGB(225, 212, 188), Color3.fromRGB(210, 196, 170), Color3.fromRGB(190, 180, 168), Color3.fromRGB(220, 205, 175) }
local ROOFS = { ROOF, Color3.fromRGB(150, 75, 55), Color3.fromRGB(80, 100, 72), Color3.fromRGB(70, 66, 78) }
local function building(at: Vector3, w: number, d: number, rotY: number, parent: Instance, opt: any?)
	local o = opt or {}
	local cf = CFrame.new(at) * CFrame.Angles(0, rotY, 0)
	local h = o.h or 10
	local t = o.terrace or 1
	local wall = o.wall or WALLS[rng:NextInteger(1, #WALLS)]
	local roofColor = o.roof or ROOFS[rng:NextInteger(1, #ROOFS)]
	part({ Name = "Plinth", Size = Vector3.new(w + 2, t, d + 2), CFrame = cf * CFrame.new(0, t / 2, 0), Color = STONE_DARK, Material = Enum.Material.Cobblestone, Parent = parent })
	local base = cf * CFrame.new(0, t, 0)
	local function storey(b: CFrame, sw: number, sd: number, sh: number, withDoor: boolean)
		part({ Name = "Wall", Size = Vector3.new(sw, sh, sd), CFrame = b * CFrame.new(0, sh / 2, 0), Color = wall, Material = Enum.Material.Plaster, Parent = parent })
		-- 나무 뼈대 (모서리 기둥, 위아래 띠)
		for _, sx in ipairs({ -1, 1 }) do
			for _, sz in ipairs({ -1, 1 }) do
				part({ Name = "Post", Size = Vector3.new(1, sh, 1), CFrame = b * CFrame.new(sx * sw / 2, sh / 2, sz * sd / 2), Color = WOOD, Material = Enum.Material.Wood, Parent = parent })
			end
		end
		part({ Name = "Beam", Size = Vector3.new(sw + 0.6, 0.8, sd + 0.6), CFrame = b * CFrame.new(0, sh - 0.4, 0), Color = WOOD, Material = Enum.Material.Wood, Parent = parent })
		-- 창 (앞뒤로, 따뜻하게 빛난다)
		local nWin = math.max(1, math.floor(sw / 7))
		for i = 1, nWin do
			local x = -sw / 2 + i * sw / (nWin + 1)
			if not (withDoor and math.abs(x) < 3) then
				for _, sz in ipairs({ -1, 1 }) do
					part({ Name = "Window", Size = Vector3.new(2, 2.6, 0.2), CFrame = b * CFrame.new(x, sh * 0.58, sz * (sd / 2 + 0.05)), Color = WARM, Material = Enum.Material.Neon, Transparency = 0.25, CanCollide = false, Parent = parent })
					part({ Name = "Sill", Size = Vector3.new(2.6, 0.3, 0.5), CFrame = b * CFrame.new(x, sh * 0.58 - 1.45, sz * (sd / 2 + 0.2)), Color = WOOD, Material = Enum.Material.Wood, CanCollide = false, Parent = parent })
				end
			end
		end
		if withDoor then
			part({ Name = "Door", Size = Vector3.new(3.6, 6.4, 0.3), CFrame = b * CFrame.new(0, 3.2, -sd / 2 - 0.1), Color = WOOD, Material = Enum.Material.WoodPlanks, Parent = parent })
			part({ Name = "DoorArch", Size = Vector3.new(5, 0.9, 0.6), CFrame = b * CFrame.new(0, 6.8, -sd / 2 - 0.2), Color = STONE, Material = Enum.Material.Marble, Parent = parent })
		end
	end
	storey(base, w, d, h, true)
	local top = base * CFrame.new(0, h, 0)
	local rw, rd = w, d
	if o.tiers == 2 then
		-- 이층은 살짝 내밀어 짓는다
		local w2, d2, h2 = w + 1.2, d + 1.2, h * 0.75
		storey(top, w2, d2, h2, false)
		top = top * CFrame.new(0, h2, 0)
		rw, rd = w2, d2
	end
	roof(top, rw, rd, roofColor, wall, parent)
	-- 차양과 벽등
	if o.awning ~= false then
		local aw = part({ Name = "Awning", Size = Vector3.new(math.min(w * 0.5, 10), 0.3, 3), CFrame = base * CFrame.new(0, 7.6, -d / 2 - 1.5) * CFrame.Angles(math.rad(-18), 0, 0), Color = o.awningColor or Color3.fromRGB(150, 50, 45):Lerp(Color3.fromRGB(50, 80, 140), rng:NextNumber()), Material = Enum.Material.Fabric, CanCollide = false, Parent = parent })
		local _ = aw
	end
	local lamp = part({ Name = "WallLamp", Size = Vector3.new(0.9, 1.3, 0.9), CFrame = base * CFrame.new(w / 2 - 1.6, 6, -d / 2 - 0.8), Color = WARM, Material = Enum.Material.Neon, CanCollide = false, Parent = parent })
	light(lamp, WARM, 14, 1.2)
	if o.sign then
		local board = part({ Name = "Signboard", Size = Vector3.new(math.min(w * 0.6, 14), 2.6, 0.4), CFrame = base * CFrame.new(0, h - 1.4, -d / 2 - 0.5), Color = Color3.fromRGB(40, 30, 25), Material = Enum.Material.Wood, CanCollide = false, Parent = parent })
		sign(board, Enum.NormalId.Front, { { o.sign, GOLD, 1 } })
	end
end
local function house(at: Vector3, w: number, d: number, rotY: number, parent: Instance)
	building(at, w, d, rotY, parent, { tiers = rng:NextNumber() < 0.4 and 2 or 1 })
end

-- 첨탑: 가늘어지는 돌 원통을 쌓고 금빛 테를 두른 뒤 꼭대기에 수정
local function spire(at: Vector3, levels: number, r0: number, glow: Color3, parent: Instance)
	disc("SpireBase", at + Vector3.new(0, 1.2, 0), r0 + 4, 2.4, STONE_DARK, Enum.Material.Granite, parent)
	local y = 2.4
	local r = r0
	for i = 1, levels do
		local h = i == 1 and 14 or 9
		disc("SpireBody", at + Vector3.new(0, y + h / 2, 0), r, h, STONE, Enum.Material.Marble, parent)
		disc("SpireRing", at + Vector3.new(0, y + h, 0), r + 0.9, 1.1, GOLD, Enum.Material.Metal, parent)
		-- 층마다 빛나는 좁은 창
		for k = 0, 3 do
			local a = k / 4 * math.pi * 2 + i * 0.4
			part({ Name = "SpireWindow", Size = Vector3.new(1.1, h * 0.45, 0.3), CFrame = CFrame.lookAt(at + Vector3.new(math.cos(a) * r, y + h * 0.55, math.sin(a) * r), at + Vector3.new(0, y + h * 0.55, 0)), Color = glow, Material = Enum.Material.Neon, CanCollide = false, Parent = parent })
		end
		y += h + 1.1
		r *= 0.8
	end
	for k = 1, 4 do
		disc("SpireCap", at + Vector3.new(0, y + k * 1.2, 0), r * (1 - k * 0.2), 1.2, STONE, Enum.Material.Marble, parent)
	end
	crystal(at + Vector3.new(0, y + 10, 0), 3.2, glow, parent)
end

-- 큰 돌문: 두 기둥 + 위를 가로지르는 들보, 문장(빛나는 고리), 양쪽 깃발
local function monumentGate(center: Vector3, yaw: number, parent: Instance, title: string, accent: Color3)
	local cf = CFrame.new(center) * CFrame.Angles(0, yaw, 0)
	for _, sx in ipairs({ -1, 1 }) do
		local x = sx * 13
		part({ Name = "GateFoot", Size = Vector3.new(7, 3, 7), CFrame = cf * CFrame.new(x, 1.5, 0), Color = STONE_DARK, Material = Enum.Material.Granite, Parent = parent })
		part({ Name = "GatePylon", Size = Vector3.new(5, 26, 5), CFrame = cf * CFrame.new(x, 16, 0), Color = STONE, Material = Enum.Material.Marble, Parent = parent })
		part({ Name = "GateBand", Size = Vector3.new(5.6, 0.8, 5.6), CFrame = cf * CFrame.new(x, 9, 0), Color = GOLD, Material = Enum.Material.Metal, Parent = parent })
		part({ Name = "GateCap", Size = Vector3.new(6.4, 1.6, 6.4), CFrame = cf * CFrame.new(x, 29.8, 0), Color = GOLD, Material = Enum.Material.Metal, Parent = parent })
		crystal((cf * CFrame.new(x, 34, 0)).Position, 2.4, accent, parent)
		-- 기둥 앞뒤로 늘어진 깃발
		for _, sz in ipairs({ -1, 1 }) do
			part({ Name = "GateBanner", Size = Vector3.new(3.6, 12, 0.15), CFrame = cf * CFrame.new(x, 19, sz * 2.6), Color = accent, Material = Enum.Material.Fabric, CanCollide = false, Parent = parent })
			part({ Name = "GateBannerTrim", Size = Vector3.new(3.8, 0.5, 0.2), CFrame = cf * CFrame.new(x, 13, sz * 2.62), Color = GOLD, Material = Enum.Material.Metal, CanCollide = false, Parent = parent })
		end
	end
	-- 문 바깥 양쪽 화로
	for _, sx in ipairs({ -1, 1 }) do
		brazier((cf * CFrame.new(sx * 20, 0, -5)).Position, 1, parent)
	end
	part({ Name = "GateLintel", Size = Vector3.new(34, 4, 5.4), CFrame = cf * CFrame.new(0, 27, 0), Color = STONE, Material = Enum.Material.Marble, Parent = parent })
	part({ Name = "GateLintelGold", Size = Vector3.new(34.4, 0.6, 5.8), CFrame = cf * CFrame.new(0, 25.1, 0), Color = GOLD, Material = Enum.Material.Metal, CanCollide = false, Parent = parent })
	-- 가운데 문장: 금빛 고리 안의 빛
	local ring = part({ Name = "GateEmblem", Shape = Enum.PartType.Cylinder, Size = Vector3.new(1, 7, 7), CFrame = cf * CFrame.new(0, 31.5, 0) * CFrame.Angles(0, math.rad(90), 0), Color = GOLD, Material = Enum.Material.Metal, CanCollide = false, Parent = parent })
	local _ = ring
	local core = part({ Name = "GateEmblemCore", Shape = Enum.PartType.Cylinder, Size = Vector3.new(1.2, 4.6, 4.6), CFrame = cf * CFrame.new(0, 31.5, 0) * CFrame.Angles(0, math.rad(90), 0), Color = accent, Material = Enum.Material.Neon, CanCollide = false, Parent = parent })
	light(core, accent, 24, 2)
	for _, sz in ipairs({ -1, 1 }) do
		local board = part({ Name = "GateTitle", Size = Vector3.new(20, 3, 0.3), CFrame = cf * CFrame.new(0, 27, sz * 2.86) * CFrame.Angles(0, sz > 0 and math.pi or 0, 0), Color = STONE, Material = Enum.Material.Marble, CanCollide = false, Transparency = 1, Parent = parent })
		sign(board, Enum.NormalId.Front, { { title, GOLD, 1 } })
	end
end

-- 원형 정자: 돌기둥, 둥근 띠, 층층이 줄어드는 둥근 지붕, 꼭대기 수정
local function pavilion(center: Vector3, r: number, n: number, h: number, roofColor: Color3, parent: Instance, glow: Color3?)
	for k = 0, n - 1 do
		local a = (k + 0.5) / n * math.pi * 2
		local p = center + Vector3.new(math.cos(a) * r, 0, math.sin(a) * r)
		part({ Name = "PavilionColumn", Shape = Enum.PartType.Cylinder, Size = Vector3.new(h, 1.5, 1.5), CFrame = CFrame.new(p + Vector3.new(0, h / 2, 0)) * CFrame.Angles(0, 0, math.rad(90)), Color = STONE, Material = Enum.Material.Marble, Parent = parent })
		part({ Name = "ColumnCap", Size = Vector3.new(2, 0.6, 2), Position = p + Vector3.new(0, h - 0.3, 0), Color = GOLD, Material = Enum.Material.Metal, Parent = parent })
	end
	disc("PavilionRing", center + Vector3.new(0, h + 0.7, 0), r + 1.2, 1.4, STONE, Enum.Material.Marble, parent)
	disc("PavilionGold", center + Vector3.new(0, h + 0.05, 0), r + 1.4, 0.3, GOLD, Enum.Material.Metal, parent, false)
	for k = 1, 5 do
		local rr = (r + 1.5) * math.cos(math.rad(k * 16))
		disc("PavilionDome", center + Vector3.new(0, h + 1.4 + k * 1.1, 0), rr, 1.2, roofColor, Enum.Material.Slate, parent)
	end
	crystal(center + Vector3.new(0, h + 1.4 + 5 * 1.1 + 4.5, 0), 2.2, glow or GOLD, parent)
end

------------------------------------------------------------------------
-- 작은 것들 (집, 나무, 바위, 대나무)
------------------------------------------------------------------------
local function tree(at: Vector3, s: number, parent: Instance, blossom: boolean?)
	part({ Name = "Trunk", Shape = Enum.PartType.Cylinder, Size = Vector3.new(10 * s, 1.6 * s, 1.6 * s), CFrame = CFrame.new(at + Vector3.new(0, 5 * s, 0)) * CFrame.Angles(0, 0, math.rad(90)), Color = Color3.fromRGB(90, 60, 40), Material = Enum.Material.Wood, Parent = parent })
	-- 매화는 짙은 홍매와 흰 백매를 섞는다
	local leaf = blossom and (rng:NextNumber() < 0.6 and Color3.fromRGB(215, 55, 85) or Color3.fromRGB(250, 236, 240)) or Color3.fromRGB(70, 120, 60)
	for i = 1, 3 do
		part({
			Name = "Leaves",
			Shape = Enum.PartType.Ball,
			Size = Vector3.new(1, 1, 1) * (6 + i) * s,
			CFrame = CFrame.new(at + Vector3.new(rng:NextNumber(-2, 2) * s, (8 + i * 1.5) * s, rng:NextNumber(-2, 2) * s)),
			Color = leaf:Lerp(Color3.new(1, 1, 1), rng:NextNumber(0, 0.15)),
			Material = Enum.Material.Grass,
			CanCollide = false,
			Parent = parent,
		})
	end
end

local function rock(at: Vector3, s: number, parent: Instance, color: Color3?)
	part({
		Name = "Rock",
		Size = Vector3.new(rng:NextNumber(0.8, 1.3), rng:NextNumber(0.5, 0.9), rng:NextNumber(0.8, 1.3)) * s,
		CFrame = CFrame.new(at + Vector3.new(0, s * 0.3, 0)) * CFrame.Angles(rng:NextNumber(-0.3, 0.3), rng:NextNumber(0, 6), rng:NextNumber(-0.3, 0.3)),
		Color = color or Color3.fromRGB(120, 115, 110),
		Material = Enum.Material.Slate,
		Parent = parent,
	})
end

local function bamboo(at: Vector3, parent: Instance)
	local h = rng:NextNumber(22, 38)
	part({ Name = "Bamboo", Shape = Enum.PartType.Cylinder, Size = Vector3.new(h, 1, 1), CFrame = CFrame.new(at + Vector3.new(0, h / 2, 0)) * CFrame.Angles(rng:NextNumber(-0.05, 0.05), 0, math.rad(90) + rng:NextNumber(-0.05, 0.05)), Color = Color3.fromRGB(110, 160, 70):Lerp(Color3.fromRGB(170, 190, 90), rng:NextNumber()), Material = Enum.Material.SmoothPlastic, Parent = parent })
	part({ Name = "BambooLeaf", Size = Vector3.new(6, 0.3, 2.5), CFrame = CFrame.new(at + Vector3.new(1.5, h - 2, 0)) * CFrame.Angles(0, rng:NextNumber(0, 6), 0.4), Color = Color3.fromRGB(90, 150, 60), Material = Enum.Material.Grass, CanCollide = false, Parent = parent })
end

------------------------------------------------------------------------
-- 길
------------------------------------------------------------------------
-- 점 p가 어느 길에서 margin칸 안인가 (나무·대나무를 길 위에 심지 않게)
local function nearRoad(p: Vector3, margin: number): boolean
	local q = Vector3.new(p.X, 0, p.Z)
	for _, road in ipairs(Config.Roads) do
		for i = 1, #road - 1 do
			local a, b = road[i], road[i + 1]
			local ab = b - a
			local len2 = ab:Dot(ab)
			local t = len2 > 0 and math.clamp((q - a):Dot(ab) / len2, 0, 1) or 0
			if (q - (a + ab * t)).Magnitude < margin then
				return true
			end
		end
	end
	return false
end
World.nearRoad = nearRoad

local function roads()
	for k, road in ipairs(Config.Roads) do
		for i = 1, #road - 1 do
			local a, b = road[i], road[i + 1]
			local len = (b - a).Magnitude
			if len > 0.5 then
				-- 길마다 살짝 다른 높이 (겹치는 곳이 깜빡이지 않게)
				local y = -0.08 + k * 0.012
				local mid = (a + b) / 2 + Vector3.new(0, y, 0)
				part({ Name = "Road", Size = Vector3.new(18, 1, len + 18), CFrame = CFrame.lookAt(mid, mid + (b - a)), Color = Color3.fromRGB(170, 145, 105), Material = Enum.Material.Ground, Parent = folder })
			end
		end
	end
end

------------------------------------------------------------------------
-- 땅
------------------------------------------------------------------------
local function ground()
	-- 바탕 풀밭 (2048 넘지 않게 4×4 조각)
	local W = Config.WORLD_HALF
	local n = 4
	local tile = W * 2 / n
	for i = 0, n - 1 do
		for j = 0, n - 1 do
			part({ Name = "BaseGround", Size = Vector3.new(tile, 6, tile), Position = Vector3.new(-W + tile * (i + 0.5), -3, -W + tile * (j + 0.5)), Color = Color3.fromRGB(105, 135, 80), Material = Enum.Material.Grass, Parent = folder })
		end
	end
	-- 지역 바닥 (조금 두껍게 깔아 겹쳐 깜빡이지 않게)
	for k, r in ipairs(Config.Regions) do
		if not r.noGround then
			part({ Name = "RegionGround", Size = Vector3.new(r.size.X, 1, r.size.Z), Position = r.center + Vector3.new(0, -0.35 + k * 0.01, 0), Color = r.ground, Material = r.material, Parent = folder })
		end
	end
	roads()
	-- 세상 끝 (보이지 않는 벽)
	-- (한 조각이 2048을 넘지 않게 여러 토막)
	local pieces = math.ceil(W * 2 / 1600)
	local seg = W * 2 / pieces
	for _, d in ipairs({ { 1, 0 }, { -1, 0 }, { 0, 1 }, { 0, -1 } }) do
		for k = 0, pieces - 1 do
			local along = -W + seg * (k + 0.5)
			local size = d[1] ~= 0 and Vector3.new(40, 400, seg) or Vector3.new(seg, 400, 40)
			local pos = d[1] ~= 0 and Vector3.new(d[1] * (W - 20), 200, along) or Vector3.new(along, 200, d[2] * (W - 20))
			part({ Name = "WorldWall", Size = size, Position = pos, Transparency = 1, Parent = folder })
		end
	end
	-- 멀리 둘러싼 산 (배경)
	for i = 0, 31 do
		local a = i / 32 * math.pi * 2
		local dist = Config.WORLD_HALF + 260 + rng:NextNumber(-60, 60)
		local h = rng:NextNumber(260, 520)
		local cap = rng:NextNumber(0.18, 0.28)
		part({
			Name = "SnowCap",
			Size = Vector3.new(160, h * cap, 130),
			CFrame = CFrame.new(math.cos(a) * dist, h - 20 - h * cap / 2 + 2, math.sin(a) * dist) * CFrame.Angles(0, -a, 0),
			Color = Color3.fromRGB(240, 244, 250),
			Material = Enum.Material.Snow,
			CanCollide = false,
			Parent = folder,
		})
		part({
			Name = "FarMountain",
			Size = Vector3.new(rng:NextNumber(260, 420), h, rng:NextNumber(200, 300)),
			CFrame = CFrame.new(math.cos(a) * dist, h / 2 - 20, math.sin(a) * dist) * CFrame.Angles(0, -a, 0) * CFrame.Angles(0, 0, rng:NextNumber(-0.1, 0.1)),
			Color = Color3.fromRGB(95, 110, 120):Lerp(Color3.fromRGB(140, 150, 160), rng:NextNumber()),
			Material = Enum.Material.Rock,
			CanCollide = false,
			Parent = folder,
		})
	end
end

------------------------------------------------------------------------
-- 청운 마을
------------------------------------------------------------------------
local function village(out: any)
	local f = Instance.new("Folder")
	f.Name = "Village"
	f.Parent = folder
	-- 마을 성벽 (높은 흰 돌담, 돌 갓, 성가퀴) 네 방향 입구
	local R = 175
	for _, side in ipairs({ { 1, 0 }, { -1, 0 }, { 0, 1 }, { 0, -1 } }) do
		for _, seg in ipairs({ -1, 1 }) do
			local len = R - 14
			local along = seg * (14 + len / 2)
			local alongX = side[1] == 0
			local function at(y: number, out: number): Vector3
				return alongX and Vector3.new(along, y, side[2] * (R + out)) or Vector3.new(side[1] * (R + out), y, along)
			end
			local function sz(l: number, h: number, t: number): Vector3
				return alongX and Vector3.new(l, h, t) or Vector3.new(t, h, l)
			end
			part({ Name = "VillageWall", Size = sz(len, 12, 4), Position = at(6, 0), Color = STONE, Material = Enum.Material.Cobblestone, Parent = f })
			part({ Name = "WallTrim", Size = sz(len + 0.2, 0.6, 4.6), Position = at(2, 0), Color = STONE_DARK, Material = Enum.Material.Granite, Parent = f })
			part({ Name = "WallCap", Size = sz(len + 0.2, 0.9, 5.4), Position = at(12.45, 0), Color = Color3.fromRGB(225, 220, 205), Material = Enum.Material.Marble, Parent = f })
			local count = math.floor(len / 7)
			for k = 0, count - 1 do
				local off = -len / 2 + (k + 0.5) * (len / count)
				local pos = alongX and Vector3.new(along + off, 14, side[2] * (R + 2.2)) or Vector3.new(side[1] * (R + 2.2), 14, along + off)
				part({ Name = "Merlon", Size = sz(3, 2.4, 1.2), Position = pos, Color = STONE, Material = Enum.Material.Cobblestone, Parent = f })
			end
			-- 성벽 바깥에 드리운 깃발
			for _, off in ipairs({ -len * 0.25, len * 0.25 }) do
				local pos = alongX and Vector3.new(along + off, 7.5, side[2] * (R + 2.15)) or Vector3.new(side[1] * (R + 2.15), 7.5, along + off)
				part({ Name = "WallBanner", Size = sz(4, 9, 0.15), Position = pos, Color = Color3.fromRGB(40, 70, 140), Material = Enum.Material.Fabric, CanCollide = false, Parent = f })
				part({ Name = "WallBannerTrim", Size = sz(4.2, 0.5, 0.2), Position = pos + Vector3.new(0, 4.5, 0), Color = GOLD, Material = Enum.Material.Metal, CanCollide = false, Parent = f })
			end
		end
	end
	-- 네 모서리 둥근 망루 (꼭대기에 수정)
	for _, cx in ipairs({ -1, 1 }) do
		for _, cz in ipairs({ -1, 1 }) do
			local c = Vector3.new(cx * R, 0, cz * R)
			disc("CornerTower", c + Vector3.new(0, 11, 0), 9, 22, STONE, Enum.Material.Cobblestone, f)
			disc("CornerTowerRing", c + Vector3.new(0, 22.4, 0), 10, 1, GOLD, Enum.Material.Metal, f)
			disc("CornerTowerTop", c + Vector3.new(0, 23.6, 0), 10.5, 1.4, Color3.fromRGB(225, 220, 205), Enum.Material.Marble, f)
			for k = 0, 9 do
				local a = k / 10 * math.pi * 2
				part({ Name = "TowerMerlon", Size = Vector3.new(2.4, 2.4, 1.2), CFrame = CFrame.lookAt(c + Vector3.new(math.cos(a) * 9.8, 25.5, math.sin(a) * 9.8), c + Vector3.new(0, 25.5, 0)), Color = STONE, Material = Enum.Material.Cobblestone, Parent = f })
			end
			crystal(c + Vector3.new(0, 31, 0), 3, Color3.fromRGB(120, 200, 255), f)
		end
	end
	-- 큰 돌문 네 개 (성벽 바깥에 선다)
	for _, g in ipairs({ { Vector3.new(0, 0, -R - 9), 0 }, { Vector3.new(0, 0, R + 9), 0 }, { Vector3.new(-R - 9, 0, 0), math.rad(90) }, { Vector3.new(R + 9, 0, 0), math.rad(90) } }) do
		monumentGate(g[1], g[2], f, "청운 마을", Color3.fromRGB(110, 190, 255))
	end
	-- 북쪽 길 양옆의 높은 첨탑 둘
	for _, sx in ipairs({ -1, 1 }) do
		spire(Vector3.new(sx * 110, 0, -95), 5, 9, Color3.fromRGB(120, 200, 255), f)
	end
	-- 마을 한가운데 분수: 둥근 못과 떠오른 큰 수정
	local fc = Vector3.new(0, 0, -62)
	disc("FountainRim", fc + Vector3.new(0, 1, 0), 11, 2, STONE, Enum.Material.Marble, f)
	disc("FountainWater", fc + Vector3.new(0, 1.9, 0), 10, 0.4, Color3.fromRGB(90, 170, 220), Enum.Material.Glass, f, false).Transparency = 0.3
	disc("FountainPillar", fc + Vector3.new(0, 4.5, 0), 1.6, 9, STONE, Enum.Material.Marble, f)
	disc("FountainGold", fc + Vector3.new(0, 9.2, 0), 2.4, 0.6, GOLD, Enum.Material.Metal, f)
	crystal(fc + Vector3.new(0, 14, 0), 4, Color3.fromRGB(120, 200, 255), f)
	local spray = part({ Name = "FountainSpray", Size = Vector3.new(2, 1, 2), Position = fc + Vector3.new(0, 9, 0), Transparency = 1, CanCollide = false, Parent = f })
	local e = Instance.new("ParticleEmitter")
	e.Rate = 40
	e.Color = ColorSequence.new(Color3.fromRGB(200, 235, 255))
	e.Size = NumberSequence.new(0.4, 0.1)
	e.Transparency = NumberSequence.new(0.3, 1)
	e.Speed = NumberRange.new(8, 12)
	e.SpreadAngle = Vector2.new(30, 30)
	e.Acceleration = Vector3.new(0, -25, 0)
	e.Lifetime = NumberRange.new(0.8, 1.2)
	e.Parent = spray
	-- 큰길의 쇠 등기둥 (따뜻한 빛)
	for _, z in ipairs({ -160, -135, -85, -40, 20, 140, 160 }) do
		for _, sx in ipairs({ -1, 1 }) do
			local p = Vector3.new(sx * 13, 0, z)
			part({ Name = "LampPost", Size = Vector3.new(0.6, 10, 0.6), Position = p + Vector3.new(0, 5, 0), Color = IRON, Material = Enum.Material.Metal, Parent = f })
			part({ Name = "LampFoot", Size = Vector3.new(1.6, 0.8, 1.6), Position = p + Vector3.new(0, 0.4, 0), Color = STONE_DARK, Material = Enum.Material.Granite, Parent = f })
			local lamp = part({ Name = "StreetLamp", Size = Vector3.new(1.4, 1.8, 1.4), Position = p + Vector3.new(0, 10.6, 0), Color = WARM, Material = Enum.Material.Neon, CanCollide = false, Parent = f })
			part({ Name = "LampCap", Size = Vector3.new(2, 0.5, 2), Position = p + Vector3.new(0, 11.7, 0), Color = IRON, Material = Enum.Material.Metal, CanCollide = false, Parent = f })
			light(lamp, WARM, 18, 1.3)
		end
	end
	-- 집들 (둘레)
	local spots = {
		{ -130, -140 }, { -90, -150 }, { 90, -150 }, { 130, -140 },
		{ -145, -60 }, { -145, 40 }, { -145, 120 }, { 145, -60 }, { 145, 40 }, { 145, 120 },
		{ -100, 150 }, { -50, 155 }, { 50, 155 }, { 100, 150 },
	}
	for _, s in ipairs(spots) do
		local x, z = s[1], s[2]
		local rot = math.abs(x) > 130 and (x > 0 and math.rad(-90) or math.rad(90)) or (z > 0 and math.rad(180) or 0)
		house(Vector3.new(x, 0, z), rng:NextNumber(18, 26), rng:NextNumber(14, 18), rot, f)
	end
	-- 매화나무
	for _, s in ipairs({ { -40, -60 }, { 40, -60 }, { -110, 70 }, { 110, 70 }, { -60, 40 }, { 60, 40 } }) do
		tree(Vector3.new(s[1], 0, s[2]), 1.1, f)
	end

	-- 비무대: 돌 단, 네 기둥, 붉은 줄, 계단
	local ring = Config.RING
	local c = ring.center
	part({ Name = "RingBase", Size = Vector3.new(ring.size, ring.height, ring.size), Position = c + Vector3.new(0, ring.height / 2, 0), Color = Color3.fromRGB(150, 140, 125), Material = Enum.Material.Granite, Parent = f })
	part({ Name = "RingTop", Size = Vector3.new(ring.size - 2, 0.3, ring.size - 2), Position = c + Vector3.new(0, ring.height + 0.1, 0), Color = Color3.fromRGB(175, 60, 50), Material = Enum.Material.Fabric, Parent = f })
	part({ Name = "RingMark", Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.2, 18, 18), CFrame = CFrame.new(c + Vector3.new(0, ring.height + 0.3, 0)) * CFrame.Angles(0, 0, math.rad(90)), Color = Color3.fromRGB(240, 230, 210), Material = Enum.Material.Fabric, CanCollide = false, Parent = f })
	local hs = ring.size / 2
	for _, x in ipairs({ -1, 1 }) do
		for _, z in ipairs({ -1, 1 }) do
			part({ Name = "RingPost", Size = Vector3.new(2, 8, 2), Position = c + Vector3.new(x * (hs - 1), ring.height + 4, z * (hs - 1)), Color = Color3.fromRGB(60, 40, 30), Material = Enum.Material.Wood, Parent = f })
		end
	end
	for _, h in ipairs({ 3.5, 6 }) do
		for _, side in ipairs({ { 1, 0 }, { -1, 0 }, { 0, 1 } }) do
			local size = side[1] ~= 0 and Vector3.new(0.3, 0.3, ring.size - 2) or Vector3.new(ring.size - 2, 0.3, 0.3)
			part({ Name = "RingRope", Size = size, Position = c + Vector3.new(side[1] * (hs - 1), ring.height + h, side[2] * (hs - 1)), Color = Color3.fromRGB(220, 40, 40), Material = Enum.Material.Fabric, CanCollide = false, Parent = f })
		end
	end
	for i = 1, 3 do
		part({ Name = "RingStep", Size = Vector3.new(14, i, 3), Position = c + Vector3.new(0, i / 2, -hs - 4.5 + i * 1.5 - 1.5), Color = Color3.fromRGB(140, 130, 115), Material = Enum.Material.Granite, Parent = f })
	end
	local board = part({ Name = "RingSign", Size = Vector3.new(26, 7, 1), Position = c + Vector3.new(0, ring.height + 12, hs + 1), Color = Color3.fromRGB(40, 25, 20), Material = Enum.Material.Wood, CanCollide = false, Parent = f })
	sign(board, Enum.NormalId.Front, { { "⚔ 비무대", Color3.fromRGB(255, 220, 140), 0.6 }, { "올라선 사람끼리 겨룬다", Color3.fromRGB(255, 255, 255), 0.4 } })
	sign(board, Enum.NormalId.Back, { { "⚔ 비무대", Color3.fromRGB(255, 220, 140), 0.6 }, { "올라선 사람끼리 겨룬다", Color3.fromRGB(255, 255, 255), 0.4 } })

	-- 강호 안내판: 일곱 사부가 어디 있는지 (양옆에 일곱 권법의 깃발)
	local boardAt = Vector3.new(0, 0, -110)
	for i, style in ipairs(Config.Styles) do
		local sx = i % 2 == 0 and 1 or -1
		banner(boardAt + Vector3.new(sx * (22 + math.floor((i - 1) / 2) * 5), 0, 0), 14, style.color, f)
	end
	for _, x in ipairs({ -1, 1 }) do
		part({ Name = "BoardPost", Size = Vector3.new(1.4, 16, 1.4), Position = boardAt + Vector3.new(x * 17, 8, 0), Color = WOOD, Material = Enum.Material.Wood, Parent = f })
	end
	part({ Name = "BoardRoof", Size = Vector3.new(40, 1, 5), Position = boardAt + Vector3.new(0, 16.5, 0), Color = ROOF, Material = Enum.Material.Slate, Parent = f })
	local mboard = part({ Name = "MasterBoard", Size = Vector3.new(32, 13, 0.6), Position = boardAt + Vector3.new(0, 9, 0), Color = Color3.fromRGB(35, 25, 18), Material = Enum.Material.Wood, CanCollide = false, Parent = f })
	-- 사부의 자리는 알려 주지 않는다. 떠도는 소문만
	local lines: { { any } } = { { "강호에 떠도는 소문", Color3.fromRGB(255, 215, 120), 0.16 } }
	for _, style in ipairs(Config.Styles) do
		local m = Config.MASTERS[style.id]
		if m then
			table.insert(lines, { "· " .. m.rumor, Color3.fromRGB(235, 225, 205), 0.11 })
		end
	end
	table.insert(lines, { "찾아낸 사부만 지도에 나온다", Color3.fromRGB(200, 190, 170), 0.1 })
	sign(mboard, Enum.NormalId.Front, lines)
	sign(mboard, Enum.NormalId.Back, lines)

	-- 상점 (객잔 앞 좌판)
	local stall = part({ Name = "Shop", Size = Vector3.new(14, 4, 7), Position = Vector3.new(-75, 2, 25), Color = Color3.fromRGB(130, 85, 50), Material = Enum.Material.Wood, Parent = f })
	part({ Name = "ShopRoof", Size = Vector3.new(17, 0.8, 10), CFrame = CFrame.new(-75, 10, 25) * CFrame.Angles(math.rad(-10), 0, 0), Color = Color3.fromRGB(200, 60, 50), Material = Enum.Material.Fabric, Parent = f })
	for _, x in ipairs({ -1, 1 }) do
		part({ Name = "ShopPole", Size = Vector3.new(0.6, 9, 0.6), Position = Vector3.new(-75 + x * 7.5, 5, 28.5), Color = WOOD, Material = Enum.Material.Wood, Parent = f })
	end
	local shopSign = part({ Name = "ShopSign", Size = Vector3.new(12, 3, 0.4), Position = Vector3.new(-75, 7, 21.2), Color = Color3.fromRGB(30, 20, 18), Material = Enum.Material.Wood, CanCollide = false, Parent = f })
	sign(shopSign, Enum.NormalId.Front, { { "🧪 만물상", Color3.fromRGB(255, 220, 140), 1 } })
	out.shop = prompt(stall, "물건 보기", "만물상", "Shop")
	-- 객잔: 쉬면 수련 기력이 가득 찬다
	building(Config.INN_AT, 18, 14, math.rad(90), f, { tiers = 2, sign = "객잔", awningColor = Color3.fromRGB(150, 60, 40) })
	local innDesk = part({ Name = "InnDesk", Size = Vector3.new(3, 3.2, 6), Position = Config.INN_AT + Vector3.new(-11, 1.6, 0), Color = Color3.fromRGB(110, 75, 50), Material = Enum.Material.Wood, Parent = f })
	out.inn = prompt(innDesk, string.format("쉬기 (💰 %d)", Config.STAMINA.innCost), "객잔 · 기력 채우기", "Inn")
end

------------------------------------------------------------------------
-- 수련 자리
------------------------------------------------------------------------
local function trainingSpots(out: any)
	local f = Instance.new("Folder")
	f.Name = "Training"
	f.Parent = folder
	out.train = {}
	for i, spot in ipairs(Config.TrainingSpots) do
		local at = spot.at
		local target: BasePart
		if spot.kind == "rock" then
			rock(at + Vector3.new(4, 0, 4), 9, f)
			target = part({ Name = "LiftRock", Shape = Enum.PartType.Ball, Size = Vector3.new(4.5, 4.5, 4.5), Position = at + Vector3.new(0, 2.2, 0), Color = Color3.fromRGB(130, 125, 115), Material = Enum.Material.Slate, Parent = f })
		elseif spot.kind == "dummy" then
			target = part({ Name = "Mook", Shape = Enum.PartType.Cylinder, Size = Vector3.new(7, 2.4, 2.4), CFrame = CFrame.new(at + Vector3.new(0, 3.5, 0)) * CFrame.Angles(0, 0, math.rad(90)), Color = Color3.fromRGB(140, 95, 55), Material = Enum.Material.Wood, Parent = f })
			for k, h in ipairs({ 5.2, 4.6, 3.0 }) do
				part({ Name = "MookArm", Size = Vector3.new(0.5, 0.5, 3), CFrame = CFrame.new(at + Vector3.new((k - 2) * 0.6, h, -1.6)) * CFrame.Angles(math.rad(k == 3 and -20 or 10), math.rad((k - 2) * 25), 0), Color = Color3.fromRGB(120, 80, 45), Material = Enum.Material.Wood, Parent = f })
			end
			part({ Name = "MookBase", Size = Vector3.new(5, 1, 5), Position = at + Vector3.new(0, 0.5, 0), Color = Color3.fromRGB(90, 60, 40), Material = Enum.Material.Wood, Parent = f })
		elseif spot.kind == "mabo" then
			-- 마보 참장: 세 개의 말뚝 위에서 버틴다
			part({ Name = "MaboBase", Size = Vector3.new(8, 0.8, 8), Position = at + Vector3.new(0, 0.4, 0), Color = Color3.fromRGB(110, 85, 60), Material = Enum.Material.WoodPlanks, Parent = f })
			for k = -1, 1 do
				part({ Name = "MaboPost", Shape = Enum.PartType.Cylinder, Size = Vector3.new(2.6, 1.2, 1.2), CFrame = CFrame.new(at + Vector3.new(k * 2.4, 2.1, 0)) * CFrame.Angles(0, 0, math.rad(90)), Color = Color3.fromRGB(130, 95, 60), Material = Enum.Material.Wood, Parent = f })
			end
			target = part({ Name = "MaboStake", Size = Vector3.new(1.2, 3.4, 1.2), Position = at + Vector3.new(0, 1.7, 2.6), Color = Color3.fromRGB(150, 110, 70), Material = Enum.Material.Wood, Parent = f })
		elseif spot.kind == "ironpalm" then
			-- 철사장: 화로 위의 달군 쇠모래 솥
			part({ Name = "CauldronStand", Size = Vector3.new(4.5, 2.4, 4.5), Position = at + Vector3.new(0, 1.2, 0), Color = Color3.fromRGB(70, 65, 65), Material = Enum.Material.Slate, Parent = f })
			target = part({ Name = "IronCauldron", Shape = Enum.PartType.Cylinder, Size = Vector3.new(2.2, 5, 5), CFrame = CFrame.new(at + Vector3.new(0, 3.5, 0)) * CFrame.Angles(0, 0, math.rad(90)), Color = Color3.fromRGB(55, 50, 50), Material = Enum.Material.Metal, Parent = f })
			local sand = part({ Name = "HotSand", Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.3, 4.2, 4.2), CFrame = CFrame.new(at + Vector3.new(0, 4.6, 0)) * CFrame.Angles(0, 0, math.rad(90)), Color = Color3.fromRGB(255, 120, 40), Material = Enum.Material.Neon, CanCollide = false, Parent = f })
			light(sand, Color3.fromRGB(255, 130, 60), 14, 1.6)
			local smoke = Instance.new("Smoke")
			smoke.Color = Color3.fromRGB(120, 110, 100)
			smoke.Opacity = 0.08
			smoke.RiseVelocity = 3
			smoke.Size = 1.5
			smoke.Parent = sand
		elseif spot.kind == "breathing" then
			-- 운기조식: 하늘 고리 아래의 방석, 둘레에 작은 수정
			target = part({ Name = "MeditationCushion", Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.8, 4, 4), CFrame = CFrame.new(at + Vector3.new(0, 0.6, 0)) * CFrame.Angles(0, 0, math.rad(90)), Color = Color3.fromRGB(120, 60, 140), Material = Enum.Material.Fabric, Parent = f })
			for k = 0, 2 do
				local a = k / 3 * math.pi * 2
				crystal(at + Vector3.new(math.cos(a) * 3.5, 2.2, math.sin(a) * 3.5), 0.9, Color3.fromRGB(150, 230, 255), f)
			end
		elseif spot.kind == "simma" then
			-- 심마 대련: 옛 투기장 한가운데의 검은 제단
			target = part({ Name = "SimmaAltar", Shape = Enum.PartType.Cylinder, Size = Vector3.new(1.4, 9, 9), CFrame = CFrame.new(at + Vector3.new(0, 0.7, 0)) * CFrame.Angles(0, 0, math.rad(90)), Color = Color3.fromRGB(30, 20, 35), Material = Enum.Material.Slate, Parent = f })
			for k = 0, 3 do
				local a = k / 4 * math.pi * 2 + math.rad(45)
				local p = at + Vector3.new(math.cos(a) * 5.5, 0, math.sin(a) * 5.5)
				part({ Name = "SimmaPillar", Size = Vector3.new(1, 7, 1), Position = p + Vector3.new(0, 3.5, 0), Color = Color3.fromRGB(40, 30, 45), Material = Enum.Material.Slate, Parent = f })
				crystal(p + Vector3.new(0, 8.5, 0), 1.2, Color3.fromRGB(190, 70, 255), f)
			end
			local eye = part({ Name = "SimmaEye", Shape = Enum.PartType.Ball, Size = Vector3.new(2, 2, 2), Position = at + Vector3.new(0, 6, 0), Color = Color3.fromRGB(200, 60, 255), Material = Enum.Material.Neon, CanCollide = false, Parent = f })
			light(eye, Color3.fromRGB(200, 60, 255), 24, 2)
		elseif spot.kind == "waterfall" then
			target = part({ Name = "MeditationStone", Size = Vector3.new(8, 1.2, 8), Position = at + Vector3.new(0, 0.6, 0), Color = Color3.fromRGB(110, 120, 120), Material = Enum.Material.Slate, Parent = f })
		else
			target = part({ Name = "BambooPost", Size = Vector3.new(3, 8, 3), Position = at + Vector3.new(0, 4, 0), Color = Color3.fromRGB(150, 180, 80), Material = Enum.Material.Wood, Parent = f })
			local s = part({ Name = "BambooSign", Size = Vector3.new(10, 3, 0.4), Position = at + Vector3.new(0, 10, 0), Color = Color3.fromRGB(30, 25, 18), Material = Enum.Material.Wood, CanCollide = false, Parent = f })
			sign(s, Enum.NormalId.Front, { { "🎋 경공 수련", Color3.fromRGB(200, 255, 160), 1 } })
		end
		local info = Config.Training[spot.kind]
		-- 강화 수련: 같은 자리, Y키. 빠르고 까다롭지만 세 배 (싸우는 수련엔 없다)
		local hard: ProximityPrompt? = nil
		if not info.fight then
			hard = prompt(target, "강화 수련 (이류부터)", "🔥 " .. info.name, "TrainHard")
			;(hard :: ProximityPrompt).KeyboardKeyCode = Enum.KeyCode.Y
			;(hard :: ProximityPrompt).UIOffset = Vector2.new(0, 70)
		end
		local action = info.fight and "심마 불러내기" or "수련하기"
		local need = info.realm and info.realm > 1 and (" (" .. Config.Realms[info.realm].name .. "부터)") or ""
		table.insert(out.train, { prompt = prompt(target, action .. need, info.icon .. " " .. info.name, "Train"), hard = hard, kind = spot.kind, index = i, pos = at })
	end
	-- 대나무 경공 고리 (숲 속에 한 바퀴)
	out.rings = {}
	local base = Vector3.new(-380, 0, -10)
	for k = 0, 9 do
		local a = k / 10 * math.pi * 2
		local pos = base + Vector3.new(math.cos(a) * 70, 6 + (k % 3) * 7, math.sin(a) * 70)
		local ringModel = Instance.new("Model")
		ringModel.Name = "BambooRing" .. (k + 1)
		ringModel.Parent = f
		for s = 0, 11 do
			local b = s / 12 * math.pi * 2
			part({ Name = "RingPiece", Size = Vector3.new(1, 1.6, 1), CFrame = CFrame.lookAt(pos, pos + Vector3.new(-math.sin(a), 0, math.cos(a))) * CFrame.new(math.cos(b) * 5, math.sin(b) * 5, 0), Color = Color3.fromRGB(170, 255, 120), Material = Enum.Material.Neon, Transparency = 0.3, CanCollide = false, Parent = ringModel })
		end
		table.insert(out.rings, pos)
	end
end

------------------------------------------------------------------------
-- 대나무 숲, 흑호채, 폭포 계곡
------------------------------------------------------------------------
local function regions()
	-- 대나무 숲
	local bf = Instance.new("Folder")
	bf.Name = "Bamboo"
	bf.Parent = folder
	local B = Config.Regions[2]
	for _ = 1, 140 do
		local x = B.center.X + rng:NextNumber(-B.size.X / 2 + 10, B.size.X / 2 - 10)
		local z = B.center.Z + rng:NextNumber(-B.size.Z / 2 + 10, B.size.Z / 2 - 10)
		-- 길과 경공 고리 자리는 비워 둔다
		local d = (Vector3.new(x, 0, z) - Vector3.new(-380, 0, -10)).Magnitude
		if math.abs(z) > 14 and (d < 55 or d > 85) and not nearRoad(Vector3.new(x, 0, z), 14) then
			bamboo(Vector3.new(x, 0, z), bf)
		end
	end
	-- 흑호채: 나무 울타리, 망루, 천막
	local ff = Instance.new("Folder")
	ff.Name = "Fort"
	ff.Parent = folder
	local F = Config.Regions[3]
	local fx, fz = F.center.X, F.center.Z
	local fw, fd = 300, 340
	for _, side in ipairs({ { 1, 0 }, { -1, 0 }, { 0, -1 }, { 0, 1 } }) do
		local count = 30
		for k = 0, count - 1 do
			local along = -0.5 + (k + 0.5) / count
			local gateGap = side[2] == 1 and math.abs(along) < 0.08
			if not gateGap then
				local pos = side[1] ~= 0 and Vector3.new(fx + side[1] * fw / 2, 0, fz + along * fd) or Vector3.new(fx + along * fw, 0, fz + side[2] * fd / 2)
				local h = rng:NextNumber(11, 14)
				part({ Name = "Palisade", Size = Vector3.new(1.6, h, 1.6), CFrame = CFrame.new(pos + Vector3.new(0, h / 2, 0)) * CFrame.Angles(0, rng:NextNumber(0, 3), 0), Color = Color3.fromRGB(100, 70, 45), Material = Enum.Material.Wood, Parent = ff })
				if side[1] ~= 0 then
					part({ Name = "PalisadeFill", Size = Vector3.new(1.2, 10, fd / count + 0.4), Position = pos + Vector3.new(0, 5, 0), Color = Color3.fromRGB(90, 62, 40), Material = Enum.Material.Wood, Parent = ff })
				else
					part({ Name = "PalisadeFill", Size = Vector3.new(fw / count + 0.4, 10, 1.2), Position = pos + Vector3.new(0, 5, 0), Color = Color3.fromRGB(90, 62, 40), Material = Enum.Material.Wood, Parent = ff })
				end
			end
		end
	end
	for _, c in ipairs({ { -1, 1 }, { 1, 1 }, { -1, -1 }, { 1, -1 } }) do
		local pos = Vector3.new(fx + c[1] * (fw / 2 - 6), 0, fz + c[2] * (fd / 2 - 6))
		for _, dx in ipairs({ -1, 1 }) do
			for _, dz in ipairs({ -1, 1 }) do
				part({ Name = "TowerLeg", Size = Vector3.new(1, 22, 1), Position = pos + Vector3.new(dx * 3, 11, dz * 3), Color = Color3.fromRGB(90, 62, 40), Material = Enum.Material.Wood, Parent = ff })
			end
		end
		part({ Name = "TowerDeck", Size = Vector3.new(9, 1, 9), Position = pos + Vector3.new(0, 22, 0), Color = Color3.fromRGB(110, 75, 50), Material = Enum.Material.WoodPlanks, Parent = ff })
		part({ Name = "TowerRoof", Size = Vector3.new(11, 1, 11), CFrame = CFrame.new(pos + Vector3.new(0, 28, 0)) * CFrame.Angles(0, math.rad(45), 0), Color = Color3.fromRGB(60, 45, 35), Material = Enum.Material.Wood, Parent = ff })
	end
	for _ = 1, 10 do
		local pos = Vector3.new(fx + rng:NextNumber(-110, 110), 0, fz + rng:NextNumber(-60, 140))
		part({ Name = "Tent", Size = Vector3.new(12, 8, 10), CFrame = CFrame.new(pos + Vector3.new(0, 3, 0)) * CFrame.Angles(0, rng:NextNumber(0, 3), math.rad(45)), Color = Color3.fromRGB(150, 130, 100), Material = Enum.Material.Fabric, Parent = ff })
	end
	-- 두목의 단 (깃발과 화톳불)
	local bossAt = Config.Regions[3].boss.at
	part({ Name = "BossFloor", Shape = Enum.PartType.Cylinder, Size = Vector3.new(1, 70, 70), CFrame = CFrame.new(bossAt + Vector3.new(0, 0.3, 0)) * CFrame.Angles(0, 0, math.rad(90)), Color = Color3.fromRGB(80, 60, 50), Material = Enum.Material.Cobblestone, Parent = ff })
	for k = 0, 5 do
		local a = k / 6 * math.pi * 2
		local p = bossAt + Vector3.new(math.cos(a) * 33, 0, math.sin(a) * 33)
		part({ Name = "BrazierPole", Size = Vector3.new(1, 6, 1), Position = p + Vector3.new(0, 3, 0), Color = Color3.fromRGB(60, 50, 45), Material = Enum.Material.Metal, Parent = ff })
		local fire = part({ Name = "Brazier", Shape = Enum.PartType.Ball, Size = Vector3.new(2.4, 2.4, 2.4), Position = p + Vector3.new(0, 6.8, 0), Color = Color3.fromRGB(255, 140, 50), Material = Enum.Material.Neon, CanCollide = false, Parent = ff })
		local flame = Instance.new("Fire")
		flame.Size = 6
		flame.Heat = 8
		flame.Parent = fire
	end
	local banner = part({ Name = "FortBanner", Size = Vector3.new(16, 22, 0.4), Position = bossAt + Vector3.new(0, 18, -38), Color = Color3.fromRGB(30, 25, 25), Material = Enum.Material.Fabric, CanCollide = false, Parent = ff })
	sign(banner, Enum.NormalId.Front, { { "흑호", Color3.fromRGB(230, 60, 40), 0.7 }, { "흑호채", Color3.fromRGB(255, 220, 160), 0.3 } })
	sign(banner, Enum.NormalId.Back, { { "흑호", Color3.fromRGB(230, 60, 40), 0.7 }, { "흑호채", Color3.fromRGB(255, 220, 160), 0.3 } })

	-- 비류 폭포 계곡: 동쪽 절벽, 폭포, 연못, 나무와 바위
	local vf = Instance.new("Folder")
	vf.Name = "Valley"
	vf.Parent = folder
	local V = Config.Regions[4]
	local cliffX = V.center.X + V.size.X / 2 - 15
	for k = -5, 5 do
		local h = rng:NextNumber(90, 140)
		part({ Name = "Cliff", Size = Vector3.new(40, h, 46), CFrame = CFrame.new(cliffX + rng:NextNumber(-6, 6), h / 2 - 5, k * 40) * CFrame.Angles(0, rng:NextNumber(-0.15, 0.15), 0), Color = Color3.fromRGB(105, 100, 95), Material = Enum.Material.Rock, Parent = vf })
	end
	local fallX = cliffX - 22
	local fall = part({ Name = "Waterfall", Size = Vector3.new(3, 110, 30), Position = Vector3.new(fallX, 55, 0), Color = Color3.fromRGB(170, 220, 255), Material = Enum.Material.Glass, Transparency = 0.35, CanCollide = false, Parent = vf })
	local mist = Instance.new("ParticleEmitter")
	mist.Rate = 40
	mist.Lifetime = NumberRange.new(1.5, 3)
	mist.Speed = NumberRange.new(-30, -50)
	mist.SpreadAngle = Vector2.new(10, 10)
	mist.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 2), NumberSequenceKeypoint.new(1, 6) })
	mist.Transparency = NumberSequence.new(0.6, 1)
	mist.Color = ColorSequence.new(Color3.fromRGB(230, 245, 255))
	mist.EmissionDirection = Enum.NormalId.Bottom
	mist.Parent = fall
	part({ Name = "Pond", Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.6, 90, 90), CFrame = CFrame.new(fallX - 35, 0.15, 0) * CFrame.Angles(0, 0, math.rad(90)), Color = Color3.fromRGB(70, 140, 180), Material = Enum.Material.Glass, Transparency = 0.25, CanCollide = false, Parent = vf })
	for _ = 1, 26 do
		local x = V.center.X + rng:NextNumber(-V.size.X / 2 + 20, V.size.X / 2 - 70)
		local z = V.center.Z + rng:NextNumber(-V.size.Z / 2 + 20, V.size.Z / 2 - 20)
		if math.abs(z) > 30 and not nearRoad(Vector3.new(x, 0, z), 16) then
			tree(Vector3.new(x, 0, z), rng:NextNumber(1, 1.6), vf)
		end
	end
	for _ = 1, 30 do
		local at = Vector3.new(V.center.X + rng:NextNumber(-200, 160), 0, V.center.Z + rng:NextNumber(-200, 200))
		if not nearRoad(at, 16) then
			rock(at, rng:NextNumber(3, 9), vf)
		end
	end
	-- 바깥 들판의 나무
	local edge = Config.WORLD_HALF - 60
	for _ = 1, 140 do
		local x, z = rng:NextNumber(-edge, edge), rng:NextNumber(-edge, edge)
		local inside = nearRoad(Vector3.new(x, 0, z), 18)
		for _, r in ipairs(Config.Regions) do
			if not r.noGround and math.abs(x - r.center.X) < r.size.X / 2 + 10 and math.abs(z - r.center.Z) < r.size.Z / 2 + 10 then
				inside = true
			end
		end
		for _, r in ipairs(Config.Regions) do
			for _, camp in ipairs(r.camps or {}) do
				if (Vector3.new(x, 0, z) - camp.at).Magnitude < 30 then
					inside = true
				end
			end
		end
		for _, lm in ipairs(Config.Landmarks) do
			if (Vector3.new(x, 0, z) - lm.at).Magnitude < 80 then
				inside = true
			end
		end
		if not inside then
			tree(Vector3.new(x, 0, z), rng:NextNumber(1.2, 2), folder)
		end
	end
end

------------------------------------------------------------------------
-- 일곱 사부의 자리
------------------------------------------------------------------------

local function cyl(name: string, at: Vector3, radius: number, height: number, color: Color3, material: Enum.Material, parent: Instance, collide: boolean?): Part
	return part({ Name = name, Shape = Enum.PartType.Cylinder, Size = Vector3.new(height, radius * 2, radius * 2), CFrame = CFrame.new(at) * CFrame.Angles(0, 0, math.rad(90)), Color = color, Material = material, CanCollide = collide ~= false, Parent = parent })
end

local function emitter(target: BasePart, color: Color3, rate: number, size: number, speed: number, life: number)
	local e = Instance.new("ParticleEmitter")
	e.Rate = rate
	e.Color = ColorSequence.new(color)
	e.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, size), NumberSequenceKeypoint.new(1, 0) })
	e.Transparency = NumberSequence.new(0.2, 1)
	e.Speed = NumberRange.new(speed * 0.5, speed)
	e.Lifetime = NumberRange.new(life * 0.6, life)
	e.SpreadAngle = Vector2.new(180, 180)
	e.LightEmission = 0.6
	e.Parent = target
end

local SITES: { [string]: (r: any, at: Vector3, color: Color3, f: Instance) -> () } = {}

-- 태허호: 맑은 호수 한가운데 정자, 다리로 건너간다
function SITES.taeheo(r: any, at: Vector3, color: Color3, f: Instance)
	local c = r.center
	cyl("Lake", c + Vector3.new(0, 0.3, 0), 75, 0.6, Color3.fromRGB(80, 150, 200), Enum.Material.Glass, f, false).Transparency = 0.3
	cyl("Island", c + Vector3.new(0, at.Y / 2, 0), 15, at.Y, Color3.fromRGB(150, 140, 120), Enum.Material.Cobblestone, f)
	pavilion(c + Vector3.new(0, at.Y, 0), 10, 8, 11, Color3.fromRGB(70, 110, 150), f, color)
	-- 다리 (길이 오는 쪽으로)
	local dir = Vector3.new(1, 0, -1).Unit
	local from = c + dir * 13
	local to = c + dir * 82
	local mid = (from + to) / 2 + Vector3.new(0, at.Y - 0.4, 0)
	part({ Name = "Bridge", Size = Vector3.new(6, 0.8, (to - from).Magnitude), CFrame = CFrame.lookAt(mid, mid + dir), Color = Color3.fromRGB(130, 90, 55), Material = Enum.Material.WoodPlanks, Parent = f })
	for _, side in ipairs({ -1, 1 }) do
		local off = Vector3.new(-dir.Z, 0, dir.X) * side * 2.8
		part({ Name = "BridgeRail", Size = Vector3.new(0.4, 0.4, (to - from).Magnitude), CFrame = CFrame.lookAt(mid + off + Vector3.new(0, 2.2, 0), mid + off + Vector3.new(0, 2.2, 0) + dir), Color = GOLD, Material = Enum.Material.Metal, CanCollide = false, Parent = f })
	end
	for _ = 1, 18 do
		local a, d = rng:NextNumber(0, math.pi * 2), rng:NextNumber(22, 70)
		cyl("LilyPad", c + Vector3.new(math.cos(a) * d, 0.62, math.sin(a) * d), rng:NextNumber(1, 2), 0.1, Color3.fromRGB(80, 150, 70), Enum.Material.Grass, f, false)
	end
	for _ = 1, 14 do
		local a = rng:NextNumber(0, math.pi * 2)
		local p = c + Vector3.new(math.cos(a), 0, math.sin(a)) * rng:NextNumber(90, 135)
		if not nearRoad(p, 16) then
			tree(p, rng:NextNumber(1.1, 1.6), f)
		end
	end
end

-- 금강사: 돌 기단 위의 절, 큰 종과 향로
function SITES.geumgang(r: any, at: Vector3, color: Color3, f: Instance)
	local base = Vector3.new(at.X, 0, at.Z - 10)
	part({ Name = "TempleBase", Size = Vector3.new(80, at.Y, 56), Position = base + Vector3.new(0, at.Y / 2, 0), Color = Color3.fromRGB(165, 155, 140), Material = Enum.Material.Granite, Parent = f })
	for i = 1, 5 do
		local h = at.Y * i / 5
		part({ Name = "TempleStep", Size = Vector3.new(26, h, 3), Position = base + Vector3.new(0, h / 2, 28 + (5 - i) * 3 + 1.5), Color = Color3.fromRGB(150, 140, 125), Material = Enum.Material.Granite, Parent = f })
	end
	building(base + Vector3.new(0, at.Y, -12), 44, 22, math.pi, f, { tiers = 2, h = 13, wall = STONE, roof = Color3.fromRGB(190, 150, 60), sign = "금강사", awning = false })
	spire(Vector3.new(at.X + 60, 0, at.Z - 14), 4, 7, color, f)
	local bellFrame = base + Vector3.new(-28, at.Y, 12)
	for _, x in ipairs({ -1, 1 }) do
		part({ Name = "BellPost", Size = Vector3.new(1, 12, 1), Position = bellFrame + Vector3.new(x * 4, 6, 0), Color = WOOD, Material = Enum.Material.Wood, Parent = f })
	end
	part({ Name = "BellBeam", Size = Vector3.new(10, 1, 1.2), Position = bellFrame + Vector3.new(0, 12, 0), Color = WOOD, Material = Enum.Material.Wood, Parent = f })
	cyl("Bell", bellFrame + Vector3.new(0, 8.5, 0), 2.4, 5, Color3.fromRGB(200, 160, 70), Enum.Material.Metal, f)
	local burner = cyl("Incense", Vector3.new(at.X, at.Y + 1.5, at.Z + 10), 2, 3, Color3.fromRGB(70, 60, 50), Enum.Material.Metal, f)
	local smoke = Instance.new("Smoke")
	smoke.Color = Color3.fromRGB(230, 225, 215)
	smoke.Opacity = 0.12
	smoke.RiseVelocity = 3
	smoke.Size = 1
	smoke.Parent = burner
	for _, x in ipairs({ -1, 1 }) do
		local lamp = part({ Name = "StoneLantern", Size = Vector3.new(2.4, 5, 2.4), Position = Vector3.new(at.X + x * 16, at.Y + 2.5, at.Z + 14), Color = Color3.fromRGB(140, 135, 125), Material = Enum.Material.Granite, Parent = f })
		light(lamp, Color3.fromRGB(255, 200, 120), 16)
	end
	for _ = 1, 12 do
		local p = r.center + Vector3.new(rng:NextNumber(-140, 140), 0, rng:NextNumber(-140, 140))
		if (p - base).Magnitude > 60 and not nearRoad(p, 16) then
			tree(p, rng:NextNumber(1.2, 1.8), f)
		end
	end
end

-- 매화원: 꽃잎이 흩날리는 매화나무 숲과 둥근 달문
function SITES.maehwa(r: any, at: Vector3, color: Color3, f: Instance)
	local c = r.center
	tree(Vector3.new(at.X, 0, at.Z - 14), 2.6, f, true)
	for _ = 1, 42 do
		local p = c + Vector3.new(rng:NextNumber(-140, 140), 0, rng:NextNumber(-140, 140))
		if (p - Vector3.new(at.X, 0, at.Z)).Magnitude > 28 and not nearRoad(p, 14) then
			tree(p, rng:NextNumber(1.1, 1.7), f, true)
		end
	end
	-- 달문 (길이 들어오는 쪽)
	local gate = Vector3.new(c.X, 0, c.Z + 92)
	for k = 0, 23 do
		local a = k / 24 * math.pi * 2
		if 10 + math.sin(a) * 10 < 3 then
			continue
		end
		part({ Name = "MoonGate", Size = Vector3.new(2.6, 2.6, 2), Position = gate + Vector3.new(math.cos(a) * 10, 10 + math.sin(a) * 10, 0), Color = STONE, Material = Enum.Material.Marble, Parent = f })
	end
	crystal(gate + Vector3.new(0, 23, 0), 2.6, color, f)
	pavilion(Vector3.new(at.X - 28, 0, at.Z + 4), 6, 6, 8, Color3.fromRGB(150, 80, 100), f, color)
	-- 꽃잎 바람
	local sky = part({ Name = "PetalSky", Size = Vector3.new(120, 1, 120), Position = Vector3.new(at.X, 34, at.Z), Transparency = 1, CanCollide = false, Parent = f })
	local e = Instance.new("ParticleEmitter")
	e.Rate = 30
	e.Color = ColorSequence.new(Color3.fromRGB(255, 190, 215))
	e.Size = NumberSequence.new(0.35)
	e.Lifetime = NumberRange.new(6, 9)
	e.Speed = NumberRange.new(3, 6)
	e.Acceleration = Vector3.new(1.5, -1.2, 0.8)
	e.EmissionDirection = Enum.NormalId.Bottom
	e.RotSpeed = NumberRange.new(-120, 120)
	e.Parent = sky
	part({ Name = "PlumPath", Size = Vector3.new(6, 0.4, 70), Position = Vector3.new(at.X, 0.25, at.Z + 45), Color = Color3.fromRGB(200, 190, 175), Material = Enum.Material.Cobblestone, Parent = f })
end

-- 천룡봉: 비탈길로 오르는 바위 봉우리, 금빛 용이 기둥을 감는다
function SITES.cheonryong(r: any, at: Vector3, color: Color3, f: Instance)
	local top = at.Y
	part({ Name = "PeakRock", Size = Vector3.new(56, top, 56), Position = Vector3.new(at.X, top / 2, at.Z), Color = Color3.fromRGB(115, 110, 105), Material = Enum.Material.Rock, Parent = f })
	local rampC = Vector3.new(at.X - 28 - 22, top / 2, at.Z)
	local ramp = Instance.new("WedgePart")
	ramp.Name = "PeakRamp"
	ramp.Anchored = true
	ramp.Size = Vector3.new(14, top, 44)
	ramp.CFrame = CFrame.lookAt(rampC, rampC - Vector3.xAxis)
	ramp.Color = Color3.fromRGB(125, 118, 110)
	ramp.Material = Enum.Material.Slate
	ramp.Parent = f
	local pillar = part({ Name = "DragonPillar", Size = Vector3.new(4, 34, 4), Position = Vector3.new(at.X + 18, top + 17, at.Z), Color = STONE, Material = Enum.Material.Marble, Parent = f })
	pavilion(Vector3.new(at.X, top, at.Z), 10, 8, 11, ROOF, f, GOLD)
	local _ = pillar
	for k = 0, 40 do
		local u = k / 40
		local a = u * math.pi * 5
		local p = Vector3.new(at.X + 18 + math.cos(a) * 4.5, top + 2 + u * 34, at.Z + math.sin(a) * 4.5)
		local ball = part({ Name = "DragonBody", Shape = Enum.PartType.Ball, Size = Vector3.new(1, 1, 1) * (2.6 - u * 1.2), Position = p, Color = Color3.fromRGB(255, 200, 80), Material = Enum.Material.Neon, CanCollide = false, Parent = f })
		if k == 40 then
			ball.Size = Vector3.new(4, 4, 4)
			light(ball, Color3.fromRGB(255, 200, 90), 30, 2)
		end
	end
	for _ = 1, 26 do
		local p = r.center + Vector3.new(rng:NextNumber(-140, 140), 0, rng:NextNumber(-140, 140))
		if (p - Vector3.new(at.X, 0, at.Z)).Magnitude > 50 and not nearRoad(p, 16) then
			rock(p, rng:NextNumber(5, 14), f, Color3.fromRGB(110, 105, 100))
		end
	end
end

-- 무영곡: 높은 검은 절벽 사이 무너진 사당, 보랏빛 등
function SITES.muyeong(r: any, at: Vector3, color: Color3, f: Instance)
	local c = r.center
	for _, side in ipairs({ -1, 1 }) do
		for k = -3, 3 do
			local h = rng:NextNumber(60, 110)
			part({ Name = "DarkCliff", Size = Vector3.new(46, h, 30), CFrame = CFrame.new(c.X + k * 42, h / 2 - 4, c.Z + side * rng:NextNumber(70, 90)) * CFrame.Angles(0, rng:NextNumber(-0.2, 0.2), 0), Color = Color3.fromRGB(45, 42, 52), Material = Enum.Material.Rock, Parent = f })
		end
	end
	part({ Name = "ShrineBase", Size = Vector3.new(34, at.Y, 34), Position = Vector3.new(at.X, at.Y / 2, at.Z), Color = Color3.fromRGB(70, 65, 75), Material = Enum.Material.Slate, Parent = f })
	for k = 0, 5 do
		local a = k / 6 * math.pi * 2
		local h = rng:NextNumber(4, 14)
		part({ Name = "BrokenPillar", Size = Vector3.new(2, h, 2), CFrame = CFrame.new(at.X + math.cos(a) * 14, at.Y + h / 2, at.Z + math.sin(a) * 14) * CFrame.Angles(rng:NextNumber(-0.15, 0.15), 0, rng:NextNumber(-0.15, 0.15)), Color = Color3.fromRGB(90, 80, 95), Material = Enum.Material.Slate, Parent = f })
	end
	for k = 0, 5 do
		local p = Vector3.new(c.X + 80 - k * 22, 0, c.Z + (k % 2 == 0 and -14 or 14))
		part({ Name = "LanternPole", Size = Vector3.new(0.6, 7, 0.6), Position = p + Vector3.new(0, 3.5, 0), Color = Color3.fromRGB(40, 35, 45), Material = Enum.Material.Wood, Parent = f })
		local lamp = part({ Name = "ShadowLantern", Shape = Enum.PartType.Ball, Size = Vector3.new(1.6, 1.6, 1.6), Position = p + Vector3.new(0, 7.5, 0), Color = color, Material = Enum.Material.Neon, CanCollide = false, Parent = f })
		light(lamp, color, 18, 2)
	end
end

-- 뇌운 고원: 돌 원단과 번개 받는 쇠기둥
function SITES.byeokryeok(r: any, at: Vector3, color: Color3, f: Instance)
	cyl("ThunderRing", Vector3.new(at.X, at.Y / 2, at.Z), 24, at.Y, Color3.fromRGB(110, 110, 120), Enum.Material.Granite, f)
	cyl("ThunderMark", Vector3.new(at.X, at.Y + 0.05, at.Z), 10, 0.1, Color3.fromRGB(255, 230, 120), Enum.Material.Neon, f, false).Transparency = 0.5
	for k = 0, 7 do
		local a = k / 8 * math.pi * 2
		local p = Vector3.new(at.X + math.cos(a) * 40, 0, at.Z + math.sin(a) * 40)
		part({ Name = "LightningRod", Size = Vector3.new(1.4, 28, 1.4), Position = p + Vector3.new(0, 14, 0), Color = Color3.fromRGB(70, 70, 80), Material = Enum.Material.Metal, Parent = f })
		local tip = part({ Name = "RodTip", Shape = Enum.PartType.Ball, Size = Vector3.new(2.4, 2.4, 2.4), Position = p + Vector3.new(0, 29, 0), Color = color, Material = Enum.Material.Neon, CanCollide = false, Parent = f })
		light(tip, color, 22, 2)
		emitter(tip, Color3.fromRGB(200, 230, 255), 6, 0.5, 8, 0.25)
	end
	for _ = 1, 20 do
		local p = r.center + Vector3.new(rng:NextNumber(-140, 140), 0, rng:NextNumber(-140, 140))
		if (p - Vector3.new(at.X, 0, at.Z)).Magnitude > 50 and not nearRoad(p, 16) then
			rock(p, rng:NextNumber(4, 10), f, Color3.fromRGB(70, 68, 72))
		end
	end
end

-- 취선 주막: 술독과 탁자, '酒' 깃발
function SITES.chwi(r: any, at: Vector3, color: Color3, f: Instance)
	building(Vector3.new(at.X, 0, at.Z + 36), 34, 18, 0, f, { tiers = 2, sign = "취선 주막", awningColor = Color3.fromRGB(170, 60, 40) })
	for _, x in ipairs({ -16, 16 }) do
		part({ Name = "Table", Size = Vector3.new(7, 0.6, 4), Position = Vector3.new(at.X + x, 3, at.Z + 4), Color = Color3.fromRGB(120, 80, 50), Material = Enum.Material.Wood, Parent = f })
		part({ Name = "TableLeg", Size = Vector3.new(5, 2.7, 2), Position = Vector3.new(at.X + x, 1.35, at.Z + 4), Color = Color3.fromRGB(90, 60, 40), Material = Enum.Material.Wood, Parent = f })
		for _, dz in ipairs({ -3.5, 3.5 }) do
			cyl("Stool", Vector3.new(at.X + x, 0.9, at.Z + 4 + dz), 1, 1.8, Color3.fromRGB(110, 75, 45), Enum.Material.Wood, f)
		end
	end
	for k = 1, 9 do
		local p = Vector3.new(at.X + 24 + (k % 3) * 3.4, 0, at.Z + 20 + math.floor((k - 1) / 3) * 3.4)
		cyl("WineJar", p + Vector3.new(0, 1.6, 0), 1.5, 3.2, Color3.fromRGB(110, 70, 45), Enum.Material.Slate, f)
	end
	local pole = part({ Name = "FlagPole", Size = Vector3.new(0.8, 20, 0.8), Position = Vector3.new(at.X - 26, 10, at.Z + 22), Color = WOOD, Material = Enum.Material.Wood, Parent = f })
	local _ = pole
	local flag = part({ Name = "WineFlag", Size = Vector3.new(6, 9, 0.2), Position = Vector3.new(at.X - 22.6, 14, at.Z + 22), Color = Color3.fromRGB(200, 50, 40), Material = Enum.Material.Fabric, CanCollide = false, Parent = f })
	sign(flag, Enum.NormalId.Front, { { "주막", Color3.fromRGB(255, 240, 220), 1 } })
	sign(flag, Enum.NormalId.Back, { { "주막", Color3.fromRGB(255, 240, 220), 1 } })
end

local function masterSites()
	for _, r in ipairs(Config.Regions) do
		local styleId = r.master
		local style = styleId and Config.STYLE_BY_ID[styleId]
		if style then
			local f = Instance.new("Folder")
			f.Name = "Master_" .. r.id
			f.Parent = folder
			local builder = SITES[style.id]
			if builder then
				local ok, err = pcall(builder, r, r.masterAt, style.color, f)
				if not ok then
					warn("[권왕] 사부 자리 만들기 오류:", r.id, err)
				end
			end
			-- 길이 들어오는 자리에 큰 돌문
			local ok2, err2 = pcall(function()
				for _, road in ipairs(Config.Roads) do
					local a, b = road[#road - 1], road[#road]
					local inside = math.abs(b.X - r.center.X) < r.size.X / 2 and math.abs(b.Z - r.center.Z) < r.size.Z / 2
					if inside then
						local dir = (b - a).Unit
						local p = a
						for k = 0, 400 do
							p = a + dir * (k * 2)
							if math.abs(p.X - r.center.X) < r.size.X / 2 - 8 and math.abs(p.Z - r.center.Z) < r.size.Z / 2 - 8 then
								break
							end
						end
						monumentGate(Vector3.new(p.X, 0, p.Z), math.atan2(-dir.X, -dir.Z), f, string.split(r.name, " (")[1], style.color)
					end
				end
			end)
			if not ok2 then
				warn("[권왕] 사부 자리 문 오류:", r.id, err2)
			end
			-- (빛기둥은 사부를 찾은 사람의 화면에만 그린다)
		end
	end
end

------------------------------------------------------------------------
-- 큰 볼거리 (멀리서도 보이는 랜드마크)
------------------------------------------------------------------------
local LANDMARK: { [string]: (at: Vector3, f: Instance) -> () } = {}

-- 거신상: 주먹을 손바닥에 모아 예를 갖춘 거대한 돌 무인
function LANDMARK.colossus(at: Vector3, f: Instance)
	local face = (Vector3.new(0, 0, 0) - at)
	face = Vector3.new(face.X, 0, face.Z).Unit
	local cf = CFrame.lookAt(at, at + face)
	local function blk(name: string, size: Vector3, off: Vector3, color: Color3?, mat: Enum.Material?, rot: CFrame?)
		part({ Name = name, Size = size, CFrame = cf * CFrame.new(off) * (rot or CFrame.identity), Color = color or Color3.fromRGB(160, 155, 145), Material = mat or Enum.Material.Granite, Parent = f })
	end
	blk("ColossusBase", Vector3.new(34, 6, 30), Vector3.new(0, 3, 0), STONE_DARK, Enum.Material.Cobblestone)
	blk("ColossusBase2", Vector3.new(26, 4, 22), Vector3.new(0, 8, 0), STONE, Enum.Material.Marble)
	for i = 1, 4 do
		blk("ColossusStep", Vector3.new(14, i * 2.5, 3), Vector3.new(0, i * 1.25, -15 - (5 - i) * 3), STONE, Enum.Material.Marble)
	end
	local y = 10
	-- 다리 (말 타듯 벌려 선 자세)
	for _, sx in ipairs({ -1, 1 }) do
		blk("ColossusLeg", Vector3.new(5.5, 20, 6), Vector3.new(sx * 6, y + 10, 0), nil, nil, CFrame.Angles(0, 0, sx * math.rad(12)))
		blk("ColossusFoot", Vector3.new(7, 2.5, 9), Vector3.new(sx * 8, y + 1.25, -1))
	end
	blk("ColossusHip", Vector3.new(16, 6, 8), Vector3.new(0, y + 21, 0))
	blk("ColossusSash", Vector3.new(16.6, 2, 8.6), Vector3.new(0, y + 23, 0), GOLD, Enum.Material.Metal)
	blk("ColossusTorso", Vector3.new(18, 18, 9), Vector3.new(0, y + 33, 0))
	blk("ColossusHead", Vector3.new(8, 9, 8), Vector3.new(0, y + 47, 0))
	for _, sx in ipairs({ -1, 1 }) do
		part({ Name = "ColossusEye", Size = Vector3.new(1.4, 0.8, 0.4), CFrame = cf * CFrame.new(sx * 1.8, y + 48, -4.1), Color = Color3.fromRGB(120, 220, 255), Material = Enum.Material.Neon, CanCollide = false, Parent = f })
		-- 어깨에서 가슴 앞으로 모은 팔
		blk("ColossusUpperArm", Vector3.new(5, 12, 5), Vector3.new(sx * 11.5, y + 36, -3), nil, nil, CFrame.Angles(math.rad(-40), 0, sx * math.rad(20)))
		blk("ColossusForearm", Vector3.new(4.5, 11, 4.5), Vector3.new(sx * 6, y + 32, -10), nil, nil, CFrame.Angles(math.rad(-90), sx * math.rad(-55), 0))
	end
	part({ Name = "ColossusFist", Shape = Enum.PartType.Ball, Size = Vector3.new(6, 6, 6), CFrame = cf * CFrame.new(-1.2, y + 33, -14), Color = Color3.fromRGB(160, 155, 145), Material = Enum.Material.Granite, Parent = f })
	blk("ColossusPalm", Vector3.new(1.5, 7, 6), Vector3.new(2.2, y + 33, -14))
	crystal((cf * CFrame.new(0, y + 62, 0)).Position, 4, Color3.fromRGB(120, 220, 255), f)
	for _, sx in ipairs({ -1, 1 }) do
		brazier((cf * CFrame.new(sx * 15, 10, -9)).Position, 1.3, f)
	end
end

-- 하늘 고리: 공중에 선 거대한 돌 고리와 그 안에 떠 있는 수정들
function LANDMARK.skyring(at: Vector3, f: Instance)
	local face = Vector3.new(-at.X, 0, -at.Z).Unit
	local c = at + Vector3.new(0, 60, 0)
	local cf = CFrame.lookAt(c, c + face)
	local R = 30
	for k = 0, 39 do
		local a = k / 40 * math.pi * 2
		part({ Name = "SkyRingStone", Size = Vector3.new(5.4, 5.4, 4), CFrame = cf * CFrame.new(math.cos(a) * R, math.sin(a) * R, 0) * CFrame.Angles(0, 0, a), Color = k % 5 == 0 and GOLD or STONE, Material = k % 5 == 0 and Enum.Material.Metal or Enum.Material.Marble, CanCollide = false, Parent = f })
	end
	crystal(c, 6, Color3.fromRGB(150, 230, 255), f)
	for k = 0, 5 do
		local a = k / 6 * math.pi * 2
		crystal((cf * CFrame.new(math.cos(a) * 14, math.sin(a) * 14, 0)).Position, 2.2, Color3.fromRGB(200, 170, 255), f)
	end
	-- 땅의 둥근 돌 터와 하늘로 이어진 빛
	disc("SkyRingFloor", at + Vector3.new(0, 0.4, 0), 26, 0.8, STONE, Enum.Material.Marble, f)
	disc("SkyRingRune", at + Vector3.new(0, 0.85, 0), 18, 0.1, Color3.fromRGB(150, 230, 255), Enum.Material.Neon, f, false).Transparency = 0.5
	part({ Name = "SkyRingBeam", Size = Vector3.new(1.6, 30, 1.6), Position = at + Vector3.new(0, 15, 0), Color = Color3.fromRGB(150, 230, 255), Material = Enum.Material.Neon, Transparency = 0.5, CanCollide = false, CastShadow = false, Parent = f })
	for k = 0, 7 do
		local a = k / 8 * math.pi * 2
		local p = at + Vector3.new(math.cos(a) * 24, 0, math.sin(a) * 24)
		part({ Name = "SkyRingObelisk", Size = Vector3.new(2.4, 12, 2.4), Position = p + Vector3.new(0, 6, 0), Color = STONE, Material = Enum.Material.Marble, Parent = f })
		part({ Name = "ObeliskTip", Size = Vector3.new(1.2, 1.2, 1.2), CFrame = CFrame.new(p + Vector3.new(0, 12.8, 0)) * CFrame.Angles(math.rad(45), 0, math.rad(45)), Color = Color3.fromRGB(150, 230, 255), Material = Enum.Material.Neon, CanCollide = false, Parent = f })
	end
end

-- 옛 투기장: 무너진 둥근 기둥 벽, 모래 바닥, 몇 개 남은 아치
function LANDMARK.colosseum(at: Vector3, f: Instance)
	disc("ArenaSand", at + Vector3.new(0, 0.3, 0), 36, 0.6, Color3.fromRGB(205, 185, 140), Enum.Material.Sand, f)
	disc("ArenaCircle", at + Vector3.new(0, 0.65, 0), 14, 0.1, Color3.fromRGB(150, 60, 50), Enum.Material.Slate, f, false)
	local n = 28
	local heights = {}
	for k = 0, n - 1 do
		local a = k / n * math.pi * 2
		local h = (k % 7 == 3) and 0 or (rng:NextNumber() < 0.3 and rng:NextNumber(5, 12) or 22)
		heights[k] = h
		if h > 0 then
			local p = at + Vector3.new(math.cos(a) * 42, 0, math.sin(a) * 42)
			part({ Name = "ArenaPillar", Size = Vector3.new(4, h, 4), CFrame = CFrame.lookAt(p + Vector3.new(0, h / 2, 0), at + Vector3.new(0, h / 2, 0)), Color = Color3.fromRGB(190, 180, 160), Material = Enum.Material.Cobblestone, Parent = f })
		end
	end
	-- 온전한 기둥 둘 사이엔 아치 들보
	for k = 0, n - 1 do
		local k2 = (k + 1) % n
		if heights[k] == 22 and heights[k2] == 22 then
			local a = (k + 0.5) / n * math.pi * 2
			local p = at + Vector3.new(math.cos(a) * 42, 23, math.sin(a) * 42)
			part({ Name = "ArenaLintel", Size = Vector3.new(10, 2.4, 4.4), CFrame = CFrame.lookAt(p, at + Vector3.new(0, 23, 0)) * CFrame.Angles(0, math.rad(90), 0), Color = Color3.fromRGB(180, 170, 150), Material = Enum.Material.Cobblestone, Parent = f })
		end
	end
	-- 계단식 관중석 (바깥 둘레)
	for i = 1, 3 do
		local r = 46 + i * 4
		for k = 0, 35 do
			if k % 9 ~= 0 then
				local a = k / 36 * math.pi * 2
				local p = at + Vector3.new(math.cos(a) * r, i * 1.5, math.sin(a) * r)
				part({ Name = "ArenaSeat", Size = Vector3.new(4, i * 3, 9.2), CFrame = CFrame.lookAt(p, Vector3.new(at.X, p.Y, at.Z)) * CFrame.Angles(0, math.rad(90), 0), Color = Color3.fromRGB(170, 160, 140), Material = Enum.Material.Cobblestone, Parent = f })
			end
		end
	end
	for k = 0, 3 do
		local a = k / 4 * math.pi * 2 + 0.4
		banner(at + Vector3.new(math.cos(a) * 34, 0, math.sin(a) * 34), 16, Color3.fromRGB(150, 40, 35), f)
	end
end

-- 수정 들판: 땅에서 솟은 거대한 수정 무리
function LANDMARK.crystals(at: Vector3, f: Instance)
	disc("CrystalGlow", at + Vector3.new(0, 0.2, 0), 70, 0.4, Color3.fromRGB(70, 60, 110), Enum.Material.Slate, f)
	for k = 1, 26 do
		local a = rng:NextNumber(0, math.pi * 2)
		local d = rng:NextNumber(0, 62)
		local h = rng:NextNumber(6, 26) * (d < 20 and 1.6 or 1)
		local w = h * rng:NextNumber(0.22, 0.35)
		local p = at + Vector3.new(math.cos(a) * d, h * 0.4, math.sin(a) * d)
		local color = k % 3 == 0 and Color3.fromRGB(200, 140, 255) or Color3.fromRGB(110, 220, 255)
		local cr = part({ Name = "GiantCrystal", Size = Vector3.new(w, h, w), CFrame = CFrame.new(p) * CFrame.Angles(rng:NextNumber(-0.35, 0.35), rng:NextNumber(0, 6), rng:NextNumber(-0.35, 0.35)), Color = color, Material = Enum.Material.Neon, Transparency = 0.15, Parent = f })
		if k % 4 == 0 then
			light(cr, color, 30, 1.5)
		end
	end
	crystal(at + Vector3.new(0, 48, 0), 7, Color3.fromRGB(180, 150, 255), f)
end

-- 천년 고목: 하늘을 덮는 거대한 나무와 뿌리 사이의 돌 제단
function LANDMARK.worldtree(at: Vector3, f: Instance)
	local bark = Color3.fromRGB(85, 62, 45)
	disc("TreeTrunk", at + Vector3.new(0, 40, 0), 9, 80, bark, Enum.Material.Wood, f)
	for k = 0, 7 do
		local a = k / 8 * math.pi * 2
		local p = at + Vector3.new(math.cos(a) * 12, 3, math.sin(a) * 12)
		part({ Name = "TreeRoot", Size = Vector3.new(4, 4, 18), CFrame = CFrame.lookAt(p, at + Vector3.new(0, 8, 0)), Color = bark, Material = Enum.Material.Wood, Parent = f })
	end
	for k = 0, 5 do
		local a = k / 6 * math.pi * 2 + 0.3
		local from = at + Vector3.new(0, 55 + (k % 3) * 8, 0)
		local to = from + Vector3.new(math.cos(a) * 32, 14, math.sin(a) * 32)
		part({ Name = "TreeBranch", Size = Vector3.new(3.5, 3.5, (to - from).Magnitude), CFrame = CFrame.lookAt((from + to) / 2, to), Color = bark, Material = Enum.Material.Wood, Parent = f })
		part({ Name = "TreeCanopy", Shape = Enum.PartType.Ball, Size = Vector3.new(1, 1, 1) * rng:NextNumber(26, 36), Position = to + Vector3.new(0, 6, 0), Color = Color3.fromRGB(60, 120, 60):Lerp(Color3.fromRGB(110, 160, 80), rng:NextNumber()), Material = Enum.Material.Grass, CanCollide = false, Parent = f })
	end
	part({ Name = "TreeCrown", Shape = Enum.PartType.Ball, Size = Vector3.new(50, 50, 50), Position = at + Vector3.new(0, 92, 0), Color = Color3.fromRGB(75, 135, 65), Material = Enum.Material.Grass, CanCollide = false, Parent = f })
	-- 반딧불
	local glow = part({ Name = "Fireflies", Size = Vector3.new(80, 30, 80), Position = at + Vector3.new(0, 25, 0), Transparency = 1, CanCollide = false, Parent = f })
	local e = Instance.new("ParticleEmitter")
	e.Rate = 25
	e.Color = ColorSequence.new(Color3.fromRGB(230, 255, 150))
	e.LightEmission = 1
	e.Size = NumberSequence.new(0.3)
	e.Lifetime = NumberRange.new(3, 6)
	e.Speed = NumberRange.new(0.5, 2)
	e.SpreadAngle = Vector2.new(180, 180)
	e.Parent = glow
	-- 뿌리 앞 제단
	local face = Vector3.new(-at.X, 0, -at.Z).Unit
	local altar = at + face * 18
	disc("TreeAltar", altar + Vector3.new(0, 0.8, 0), 6, 1.6, STONE, Enum.Material.Marble, f)
	crystal(altar + Vector3.new(0, 5, 0), 2.4, Color3.fromRGB(170, 255, 140), f)
end

-- 핏빛 달: 혈월곡 하늘에 걸린 붉은 달 (어디서든 보인다)
function LANDMARK.moon(at: Vector3, f: Instance)
	local moon = part({ Name = "BloodMoon", Shape = Enum.PartType.Ball, Size = Vector3.new(80, 80, 80), Position = at + Vector3.new(0, 300, 0), Color = Color3.fromRGB(200, 40, 40), Material = Enum.Material.Neon, CanCollide = false, CastShadow = false, Parent = f })
	light(moon, Color3.fromRGB(255, 60, 50), 60, 1)
end

-- 혈월곡: 붉은 바위 가시, 핏빛 수정, 두목의 단
local function lair(r: any, f: Instance)
	local c = r.center
	for k = 0, 23 do
		local a = k / 24 * math.pi * 2 + rng:NextNumber(-0.08, 0.08)
		local d = rng:NextNumber(150, 175)
		local h = rng:NextNumber(30, 70)
		local p = Vector3.new(c.X + math.cos(a) * d, h / 2 - 2, c.Z + math.sin(a) * d)
		if not nearRoad(p, 20) then
			part({ Name = "LairSpire", Size = Vector3.new(rng:NextNumber(8, 14), h, rng:NextNumber(8, 14)), CFrame = CFrame.new(p) * CFrame.Angles(rng:NextNumber(-0.2, 0.2), rng:NextNumber(0, 6), rng:NextNumber(-0.2, 0.2)), Color = Color3.fromRGB(70, 35, 38), Material = Enum.Material.Rock, Parent = f })
		end
	end
	local bossAt = r.boss.at
	disc("LairArena", bossAt + Vector3.new(0, 0.6, 0), 34, 1.2, Color3.fromRGB(60, 40, 42), Enum.Material.Slate, f)
	disc("LairRune", bossAt + Vector3.new(0, 1.25, 0), 26, 0.1, Color3.fromRGB(200, 40, 40), Enum.Material.Neon, f, false).Transparency = 0.5
	for k = 0, 5 do
		local a = k / 6 * math.pi * 2
		local p = bossAt + Vector3.new(math.cos(a) * 30, 0, math.sin(a) * 30)
		part({ Name = "LairPillar", Size = Vector3.new(3, 16, 3), Position = p + Vector3.new(0, 8, 0), Color = Color3.fromRGB(50, 30, 32), Material = Enum.Material.Slate, Parent = f })
		crystal(p + Vector3.new(0, 20, 0), 2.6, Color3.fromRGB(255, 50, 50), f)
		banner(p + Vector3.new(4, 0, 0), 12, Color3.fromRGB(140, 20, 25), f)
	end
	for _ = 1, 14 do
		local p = c + Vector3.new(rng:NextNumber(-150, 150), 0, rng:NextNumber(-150, 150))
		if (p - bossAt).Magnitude > 45 and not nearRoad(p, 14) then
			local h = rng:NextNumber(4, 12)
			part({ Name = "BloodCrystal", Size = Vector3.new(h * 0.3, h, h * 0.3), CFrame = CFrame.new(p + Vector3.new(0, h * 0.4, 0)) * CFrame.Angles(rng:NextNumber(-0.3, 0.3), rng:NextNumber(0, 6), rng:NextNumber(-0.3, 0.3)), Color = Color3.fromRGB(220, 40, 50), Material = Enum.Material.Neon, Transparency = 0.15, Parent = f })
		end
	end
end

local function landmarks()
	for _, lm in ipairs(Config.Landmarks) do
		local builder = LANDMARK[lm.id]
		if builder then
			local f = Instance.new("Folder")
			f.Name = "Landmark_" .. lm.id
			f.Parent = folder
			local ok, err = pcall(builder, lm.at, f)
			if not ok then
				warn("[권왕] 랜드마크 오류:", lm.id, err)
			end
		end
	end
	for _, r in ipairs(Config.Regions) do
		if r.id == "lair" then
			local f = Instance.new("Folder")
			f.Name = "Lair"
			f.Parent = folder
			local ok, err = pcall(lair, r, f)
			if not ok then
				warn("[권왕] 혈월곡 오류:", err)
			end
		end
	end
end

------------------------------------------------------------------------
-- 바깥 다섯 땅 (설산, 늪, 황야, 해안, 혈교 본산)
------------------------------------------------------------------------
local function regionById(id: string): any
	for _, r in ipairs(Config.Regions) do
		if r.id == id then
			return r
		end
	end
	return nil
end

local function randIn(r: any, margin: number): Vector3
	return r.center + Vector3.new(rng:NextNumber(-r.size.X / 2 + margin, r.size.X / 2 - margin), 0, rng:NextNumber(-r.size.Z / 2 + margin, r.size.Z / 2 - margin))
end

local function clearOf(p: Vector3, r: any): boolean
	if nearRoad(p, 18) then
		return false
	end
	for _, camp in ipairs(r.camps or {}) do
		if (p - camp.at).Magnitude < 35 then
			return false
		end
	end
	if r.boss and (p - r.boss.at).Magnitude < 60 then
		return false
	end
	return true
end

-- 눈 덮인 침엽수 (층층이 줄어드는 가지)
local function pine(at: Vector3, s: number, parent: Instance, snowy: boolean)
	part({ Name = "PineTrunk", Size = Vector3.new(1.4, 8, 1.4) * s, Position = at + Vector3.new(0, 4 * s, 0), Color = Color3.fromRGB(80, 55, 40), Material = Enum.Material.Wood, Parent = parent })
	for i = 0, 3 do
		local w = (9 - i * 2) * s
		part({ Name = "PineLayer", Size = Vector3.new(w, 2.6 * s, w), CFrame = CFrame.new(at + Vector3.new(0, (5 + i * 2.6) * s, 0)) * CFrame.Angles(0, math.rad(i * 25), 0), Color = Color3.fromRGB(40, 85, 55), Material = Enum.Material.Grass, CanCollide = false, Parent = parent })
		if snowy then
			part({ Name = "PineSnow", Size = Vector3.new(w * 0.9, 0.5 * s, w * 0.9), CFrame = CFrame.new(at + Vector3.new(0, (6.4 + i * 2.6) * s, 0)) * CFrame.Angles(0, math.rad(i * 25), 0), Color = Color3.fromRGB(245, 248, 252), Material = Enum.Material.Snow, CanCollide = false, Parent = parent })
		end
	end
end

local function deadTree(at: Vector3, s: number, parent: Instance)
	part({ Name = "DeadTrunk", Size = Vector3.new(1.2, 12, 1.2) * s, CFrame = CFrame.new(at + Vector3.new(0, 6 * s, 0)) * CFrame.Angles(rng:NextNumber(-0.15, 0.15), 0, rng:NextNumber(-0.15, 0.15)), Color = Color3.fromRGB(60, 55, 45), Material = Enum.Material.Wood, Parent = parent })
	for k = 1, 3 do
		local a = rng:NextNumber(0, math.pi * 2)
		local from = at + Vector3.new(0, (6 + k * 2) * s, 0)
		local to = from + Vector3.new(math.cos(a) * 5 * s, 2.5 * s, math.sin(a) * 5 * s)
		part({ Name = "DeadBranch", Size = Vector3.new(0.5 * s, 0.5 * s, (to - from).Magnitude), CFrame = CFrame.lookAt((from + to) / 2, to), Color = Color3.fromRGB(60, 55, 45), Material = Enum.Material.Wood, CanCollide = false, Parent = parent })
	end
end

local OUTER: { [string]: (r: any, f: Instance) -> () } = {}

function OUTER.snow(r: any, f: Instance)
	for _ = 1, 70 do
		local p = randIn(r, 20)
		if clearOf(p, r) then
			pine(p, rng:NextNumber(1.2, 2.2), f, true)
		end
	end
	for _ = 1, 22 do
		local p = randIn(r, 20)
		if clearOf(p, r) then
			local h = rng:NextNumber(6, 18)
			part({ Name = "IceSpike", Size = Vector3.new(h * 0.3, h, h * 0.3), CFrame = CFrame.new(p + Vector3.new(0, h * 0.4, 0)) * CFrame.Angles(rng:NextNumber(-0.25, 0.25), rng:NextNumber(0, 6), rng:NextNumber(-0.25, 0.25)), Color = Color3.fromRGB(170, 220, 245), Material = Enum.Material.Glass, Transparency = 0.25, Parent = f })
		end
	end
	disc("FrozenLake", Vector3.new(r.center.X + 300, 0.3, r.center.Z + 120), 70, 0.4, Color3.fromRGB(190, 225, 245), Enum.Material.Ice, f)
	-- 빙마의 얼음 옥좌
	local b = r.boss.at
	disc("IceThrone", b + Vector3.new(0, 0.6, 0), 34, 1.2, Color3.fromRGB(200, 230, 250), Enum.Material.Ice, f)
	for k = 0, 7 do
		local a = k / 8 * math.pi * 2
		local p = b + Vector3.new(math.cos(a) * 30, 0, math.sin(a) * 30)
		part({ Name = "IcePillar", Size = Vector3.new(3, 18, 3), CFrame = CFrame.new(p + Vector3.new(0, 9, 0)) * CFrame.Angles(0, a, 0.1), Color = Color3.fromRGB(170, 215, 245), Material = Enum.Material.Glass, Transparency = 0.2, Parent = f })
	end
	crystal(b + Vector3.new(0, 26, 0), 5, Color3.fromRGB(160, 220, 255), f)
end

function OUTER.swamp(r: any, f: Instance)
	for _ = 1, 26 do
		local p = randIn(r, 30)
		if clearOf(p, r) then
			disc("BogPool", p + Vector3.new(0, 0.35, 0), rng:NextNumber(10, 26), 0.3, Color3.fromRGB(45, 70, 50), Enum.Material.Glass, f, false).Transparency = 0.2
		end
	end
	for _ = 1, 55 do
		local p = randIn(r, 20)
		if clearOf(p, r) then
			deadTree(p, rng:NextNumber(1, 1.8), f)
		end
	end
	-- 자욱한 독안개
	for _ = 1, 8 do
		local fog = part({ Name = "SwampFog", Size = Vector3.new(120, 4, 120), Position = randIn(r, 60) + Vector3.new(0, 3, 0), Transparency = 1, CanCollide = false, Parent = f })
		local e = Instance.new("ParticleEmitter")
		e.Rate = 6
		e.Color = ColorSequence.new(Color3.fromRGB(140, 180, 110))
		e.Size = NumberSequence.new(14, 22)
		e.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.5, 0.8), NumberSequenceKeypoint.new(1, 1) })
		e.Lifetime = NumberRange.new(8, 12)
		e.Speed = NumberRange.new(0.5, 1.5)
		e.Parent = fog
	end
	-- 무너진 사당 (비급 조각이 있다)
	local ruin = Vector3.new(320, 0, 1700)
	part({ Name = "RuinBase", Size = Vector3.new(26, 1.2, 26), Position = ruin + Vector3.new(0, 0.6, 0), Color = Color3.fromRGB(90, 95, 80), Material = Enum.Material.Cobblestone, Parent = f })
	for k = 0, 3 do
		local a = k / 4 * math.pi * 2 + 0.6
		local h = rng:NextNumber(5, 12)
		part({ Name = "RuinPillar", Size = Vector3.new(2, h, 2), Position = ruin + Vector3.new(math.cos(a) * 10, h / 2, math.sin(a) * 10), Color = Color3.fromRGB(100, 105, 90), Material = Enum.Material.Cobblestone, Parent = f })
	end
end

function OUTER.badlands(r: any, f: Instance)
	for _ = 1, 18 do
		local p = randIn(r, 50)
		if clearOf(p, r) then
			local h = rng:NextNumber(25, 70)
			local w = rng:NextNumber(30, 60)
			part({ Name = "Mesa", Size = Vector3.new(w, h, w * rng:NextNumber(0.7, 1.3)), CFrame = CFrame.new(p + Vector3.new(0, h / 2, 0)) * CFrame.Angles(0, rng:NextNumber(0, 3), 0), Color = Color3.fromRGB(175, 95, 60):Lerp(Color3.fromRGB(210, 140, 90), rng:NextNumber()), Material = Enum.Material.Sand, Parent = f })
			part({ Name = "MesaTop", Size = Vector3.new(w * 1.05, 3, w * 1.05), Position = p + Vector3.new(0, h + 1.5, 0), Color = Color3.fromRGB(150, 80, 50), Material = Enum.Material.Slate, Parent = f })
		end
	end
	for _ = 1, 40 do
		local p = randIn(r, 20)
		if clearOf(p, r) then
			local h = rng:NextNumber(4, 12)
			part({ Name = "RockPillar", Size = Vector3.new(h * 0.35, h, h * 0.35), CFrame = CFrame.new(p + Vector3.new(0, h / 2, 0)) * CFrame.Angles(0, rng:NextNumber(0, 3), rng:NextNumber(-0.15, 0.15)), Color = Color3.fromRGB(160, 90, 55), Material = Enum.Material.Rock, Parent = f })
		end
	end
end

function OUTER.coast(r: any, f: Instance)
	-- 서쪽은 바다
	local W = Config.WORLD_HALF
	local seaX = r.center.X - r.size.X / 2 - 160
	for k = -2, 2 do
		part({ Name = "Sea", Size = Vector3.new(320, 1, 960), Position = Vector3.new(seaX, -0.4, k * 960), Color = Color3.fromRGB(40, 100, 150), Material = Enum.Material.Glass, Transparency = 0.15, CanCollide = false, Parent = f })
	end
	local _ = W
	-- 바다 쪽 벼랑
	for k = -12, 12 do
		local h = rng:NextNumber(18, 40)
		part({ Name = "SeaCliff", Size = Vector3.new(30, h, 52), CFrame = CFrame.new(r.center.X - r.size.X / 2 + 10, h / 2 - 8, k * 48) * CFrame.Angles(0, rng:NextNumber(-0.1, 0.1), 0), Color = Color3.fromRGB(120, 115, 105), Material = Enum.Material.Rock, Parent = f })
	end
	-- 난파선
	local wreck = Vector3.new(-1880, 0, -60)
	part({ Name = "WreckHull", Size = Vector3.new(14, 8, 50), CFrame = CFrame.new(wreck + Vector3.new(0, 3, 0)) * CFrame.Angles(0, 0.4, math.rad(18)), Color = Color3.fromRGB(90, 60, 40), Material = Enum.Material.WoodPlanks, Parent = f })
	part({ Name = "WreckMast", Size = Vector3.new(1.6, 30, 1.6), CFrame = CFrame.new(wreck + Vector3.new(2, 14, 4)) * CFrame.Angles(0.2, 0, 0.5), Color = Color3.fromRGB(80, 55, 35), Material = Enum.Material.Wood, Parent = f })
	part({ Name = "WreckSail", Size = Vector3.new(0.2, 14, 16), CFrame = CFrame.new(wreck + Vector3.new(6, 18, 4)) * CFrame.Angles(0.2, 0, 0.5), Color = Color3.fromRGB(200, 190, 160), Material = Enum.Material.Fabric, CanCollide = false, Parent = f })
	for _ = 1, 30 do
		local p = randIn(r, 30)
		if clearOf(p, r) and p.X > r.center.X - r.size.X / 2 + 50 then
			rock(p, rng:NextNumber(3, 9), f, Color3.fromRGB(140, 135, 120))
		end
	end
end

function OUTER.cult(r: any, f: Instance)
	local c = r.center
	local half = 260
	-- 붉은 성벽과 정문
	for _, side in ipairs({ { 1, 0 }, { -1, 0 }, { 0, 1 }, { 0, -1 } }) do
		for _, seg in ipairs({ -1, 1 }) do
			local len = half - 16
			local along = seg * (16 + len / 2)
			local pos = side[1] ~= 0 and Vector3.new(c.X + side[1] * half, 9, c.Z + along) or Vector3.new(c.X + along, 9, c.Z + side[2] * half)
			local size = side[1] ~= 0 and Vector3.new(6, 18, len) or Vector3.new(len, 18, 6)
			part({ Name = "CultWall", Size = size, Position = pos, Color = Color3.fromRGB(70, 25, 28), Material = Enum.Material.Slate, Parent = f })
			part({ Name = "CultWallTrim", Size = size + Vector3.new(0.4, -16, 0.4), Position = pos + Vector3.new(0, 9.5, 0), Color = Color3.fromRGB(160, 30, 40), Material = Enum.Material.Neon, Transparency = 0.3, CanCollide = false, Parent = f })
		end
	end
	for _, sx in ipairs({ -1, 1 }) do
		for _, sz in ipairs({ -1, 1 }) do
			spire(Vector3.new(c.X + sx * half, 0, c.Z + sz * half), 3, 7, Color3.fromRGB(255, 50, 60), f)
		end
	end
	monumentGate(Vector3.new(c.X, 0, c.Z + half + 10), 0, f, "혈교 본산", Color3.fromRGB(230, 40, 50))
	-- 혈마의 제단
	local b = r.boss.at
	disc("BloodAltar", b + Vector3.new(0, 1, 0), 38, 2, Color3.fromRGB(50, 20, 22), Enum.Material.Slate, f)
	disc("BloodRune", b + Vector3.new(0, 2.05, 0), 28, 0.1, Color3.fromRGB(220, 30, 40), Enum.Material.Neon, f, false).Transparency = 0.4
	for k = 0, 5 do
		local a = k / 6 * math.pi * 2
		local p = b + Vector3.new(math.cos(a) * 34, 0, math.sin(a) * 34)
		brazier(p, 1.6, f)
		banner(p + Vector3.new(3, 0, 0), 16, Color3.fromRGB(140, 15, 25), f)
	end
	for _ = 1, 20 do
		local p = randIn(r, 40)
		if clearOf(p, r) then
			local h = rng:NextNumber(5, 14)
			part({ Name = "BloodCrystal", Size = Vector3.new(h * 0.3, h, h * 0.3), CFrame = CFrame.new(p + Vector3.new(0, h * 0.4, 0)) * CFrame.Angles(rng:NextNumber(-0.3, 0.3), rng:NextNumber(0, 6), rng:NextNumber(-0.3, 0.3)), Color = Color3.fromRGB(220, 40, 50), Material = Enum.Material.Neon, Transparency = 0.15, Parent = f })
		end
	end
end

-- 허공 균열: 갈라진 땅, 떠 있는 바위, 보랏빛 균열, 천마의 제단
function OUTER.rift(r: any, f: Instance)
	local c = r.center
	local VOID = Color3.fromRGB(150, 90, 255)
	-- 땅을 가르는 빛나는 균열
	for _ = 1, 14 do
		local p = randIn(r, 30)
		if clearOf(p, r) then
			local len = rng:NextNumber(30, 90)
			part({ Name = "RiftCrack", Size = Vector3.new(rng:NextNumber(1.5, 4), 0.3, len), CFrame = CFrame.new(p + Vector3.new(0, 0.2, 0)) * CFrame.Angles(0, rng:NextNumber(0, math.pi), 0), Color = VOID, Material = Enum.Material.Neon, CanCollide = false, Parent = f })
		end
	end
	-- 하늘에 뜬 부서진 바위
	for _ = 1, 26 do
		local p = randIn(r, 20)
		local s = rng:NextNumber(6, 22)
		part({ Name = "FloatingRock", Size = Vector3.new(s, s * 0.7, s * 0.9), CFrame = CFrame.new(p + Vector3.new(0, rng:NextNumber(40, 120), 0)) * CFrame.Angles(rng:NextNumber(0, 6), rng:NextNumber(0, 6), rng:NextNumber(0, 6)), Color = Color3.fromRGB(60, 50, 75), Material = Enum.Material.Slate, Parent = f })
	end
	-- 보랏빛 수정 기둥
	for _ = 1, 18 do
		local p = randIn(r, 40)
		if clearOf(p, r) then
			local h = rng:NextNumber(8, 26)
			part({ Name = "VoidCrystal", Size = Vector3.new(h * 0.25, h, h * 0.25), CFrame = CFrame.new(p + Vector3.new(0, h * 0.4, 0)) * CFrame.Angles(rng:NextNumber(-0.4, 0.4), rng:NextNumber(0, 6), rng:NextNumber(-0.4, 0.4)), Color = VOID, Material = Enum.Material.Neon, Transparency = 0.2, Parent = f })
		end
	end
	for _, sx in ipairs({ -1, 1 }) do
		for _, sz in ipairs({ -1, 1 }) do
			spire(Vector3.new(c.X + sx * 270, 0, c.Z + sz * 270), 4, 7, VOID, f)
		end
	end
	monumentGate(Vector3.new(c.X + 360, 0, c.Z), math.rad(90), f, "허공 균열", VOID)
	-- 천마의 제단: 하늘로 열린 검은 고리
	local b = r.boss.at
	disc("RiftAltar", b + Vector3.new(0, 1, 0), 40, 2, Color3.fromRGB(30, 20, 45), Enum.Material.Slate, f)
	disc("RiftRune", b + Vector3.new(0, 2.05, 0), 30, 0.1, VOID, Enum.Material.Neon, f, false).Transparency = 0.35
	local ringC = b + Vector3.new(0, 70, 0)
	for k = 0, 23 do
		local a = k / 24 * math.pi * 2
		part({ Name = "SkyRiftRing", Size = Vector3.new(4, 4, 9), CFrame = CFrame.lookAt(ringC + Vector3.new(math.cos(a) * 34, 0, math.sin(a) * 34), ringC) , Color = k % 2 == 0 and VOID or Color3.fromRGB(20, 10, 30), Material = Enum.Material.Neon, CanCollide = false, Parent = f })
	end
	local hole = part({ Name = "SkyRiftCore", Shape = Enum.PartType.Ball, Size = Vector3.new(40, 40, 40), Position = ringC, Color = Color3.new(0, 0, 0), Material = Enum.Material.SmoothPlastic, CanCollide = false, Parent = f })
	light(hole, VOID, 80, 3)
	for k = 0, 7 do
		local a = k / 8 * math.pi * 2
		brazier(b + Vector3.new(math.cos(a) * 36, 0, math.sin(a) * 36), 1.6, f)
	end
end

-- 숨은 사부의 자리: 세상 끝 구석, 구름이 땅에 닿는 작은 절벽 (표지도, 지도도 없다)
local function secretSite()
	local sm = Config.SECRET_MASTER
	if not sm then
		return
	end
	local f = Instance.new("Folder")
	f.Name = "SecretSite"
	f.Parent = folder
	local at = Vector3.new(sm.at.X, 0, sm.at.Z)
	local STAR = Color3.fromRGB(180, 215, 255)
	disc("CloudFloor", at + Vector3.new(0, 0.6, 0), 34, 1.2, Color3.fromRGB(235, 240, 250), Enum.Material.SmoothPlastic, f)
	disc("StarCircle", at + Vector3.new(0, 1.25, 0), 12, 0.1, STAR, Enum.Material.Neon, f, false).Transparency = 0.4
	-- 구름 (흰 공을 겹쳐 둥실)
	for _ = 1, 40 do
		local a = rng:NextNumber(0, math.pi * 2)
		local d = rng:NextNumber(18, 60)
		local s = rng:NextNumber(8, 18)
		part({ Name = "Cloud", Shape = Enum.PartType.Ball, Size = Vector3.new(s, s * 0.6, s), Position = at + Vector3.new(math.cos(a) * d, rng:NextNumber(0, 6), math.sin(a) * d), Color = Color3.fromRGB(245, 248, 255), Material = Enum.Material.SmoothPlastic, Transparency = 0.25, CanCollide = false, Parent = f })
	end
	-- 별을 매단 고목 하나
	part({ Name = "OldTree", Size = Vector3.new(3, 22, 3), Position = at + Vector3.new(14, 11, 6), Color = Color3.fromRGB(90, 70, 55), Material = Enum.Material.Wood, Parent = f })
	for k = 1, 9 do
		crystal(at + Vector3.new(14 + rng:NextNumber(-8, 8), 18 + rng:NextNumber(0, 10), 6 + rng:NextNumber(-8, 8)), 0.8, STAR, f)
		local _ = k
	end
	-- 노인이 앉는 바위
	part({ Name = "SitRock", Size = Vector3.new(6, 1.6, 6), Position = at + Vector3.new(0, 1.2, 0), Color = Color3.fromRGB(120, 120, 130), Material = Enum.Material.Slate, Parent = f })
end

local function outerLands()
	for id, builder in pairs(OUTER) do
		local r = regionById(id)
		if r then
			local f = Instance.new("Folder")
			f.Name = "Land_" .. id
			f.Parent = folder
			local ok, err = pcall(builder, r, f)
			if not ok then
				warn("[권왕] 바깥 땅 오류:", id, err)
			end
		end
	end
end

------------------------------------------------------------------------
-- 적의 진: 모닥불, 천막, 상자 (적이 뜬금없이 서 있지 않게)
------------------------------------------------------------------------
local function camps()
	local f = Instance.new("Folder")
	f.Name = "Camps"
	f.Parent = folder
	for _, r in ipairs(Config.Regions) do
		for _, camp in ipairs(r.camps or {}) do
			local c = camp.at
			local fire = part({ Name = "Campfire", Shape = Enum.PartType.Ball, Size = Vector3.new(1.6, 1.6, 1.6), Position = c + Vector3.new(0, 0.8, 0), Color = Color3.fromRGB(255, 140, 50), Material = Enum.Material.Neon, CanCollide = false, Parent = f })
			local flame = Instance.new("Fire")
			flame.Size = 5
			flame.Heat = 6
			flame.Parent = fire
			light(fire, Color3.fromRGB(255, 150, 70), 20, 1.5)
			for k = 0, 5 do
				local a = k / 6 * math.pi * 2
				part({ Name = "FireStone", Size = Vector3.new(1.2, 0.8, 1.2), Position = c + Vector3.new(math.cos(a) * 2, 0.4, math.sin(a) * 2), Color = Color3.fromRGB(110, 105, 100), Material = Enum.Material.Slate, Parent = f })
			end
			for k = 0, 1 do
				local a = rng:NextNumber(0, math.pi * 2)
				local p = c + Vector3.new(math.cos(a), 0, math.sin(a)) * 14
				if not nearRoad(p, 12) then
					part({ Name = "CampTent", Size = Vector3.new(9, 6.5, 8), CFrame = CFrame.new(p + Vector3.new(0, 2.4, 0)) * CFrame.Angles(0, a, math.rad(45)), Color = Color3.fromRGB(130, 110, 85):Lerp(Color3.fromRGB(90, 60, 50), k * 0.5), Material = Enum.Material.Fabric, Parent = f })
				end
				local q = c + Vector3.new(math.cos(a + 1.5), 0, math.sin(a + 1.5)) * 8
				part({ Name = "Crate", Size = Vector3.new(2.6, 2.6, 2.6), CFrame = CFrame.new(q + Vector3.new(0, 1.3, 0)) * CFrame.Angles(0, rng:NextNumber(0, 1.5), 0), Color = Color3.fromRGB(120, 85, 50), Material = Enum.Material.WoodPlanks, Parent = f })
			end
		end
	end
end

------------------------------------------------------------------------
-- 비급 조각 (외진 곳에 숨은 빛나는 두루마리)
------------------------------------------------------------------------
local function fragments(out: any)
	local f = Instance.new("Folder")
	f.Name = "Fragments"
	f.Parent = folder
	out.fragments = {}
	for i, frag in ipairs(Config.Fragments) do
		local at = frag.at
		local stand = part({ Name = "FragmentStand", Size = Vector3.new(2.4, 2, 2.4), Position = at + Vector3.new(0, 1, 0), Color = STONE_DARK, Material = Enum.Material.Granite, Parent = f })
		local scroll = disc("FragmentScroll", at + Vector3.new(0, 2.6, 0), 0.5, 2.2, Color3.fromRGB(255, 225, 140), Enum.Material.Neon, f, false)
		light(scroll, Color3.fromRGB(255, 220, 140), 14, 1.5)
		local e = Instance.new("ParticleEmitter")
		e.Rate = 6
		e.Color = ColorSequence.new(Color3.fromRGB(255, 230, 150))
		e.LightEmission = 1
		e.Size = NumberSequence.new(0.3, 0)
		e.Speed = NumberRange.new(1, 3)
		e.Lifetime = NumberRange.new(1, 2)
		e.Parent = scroll
		table.insert(out.fragments, prompt(stand, "줍기", "비급 조각 " .. i, "Fragment"))
	end
end

------------------------------------------------------------------------
-- 땅의 높낮이 (로블록스 지형): 세상 끝을 두른 산맥과 들판의 언덕
------------------------------------------------------------------------
local function terrainHills()
	local terrain = workspace:FindFirstChildOfClass("Terrain")
	if not terrain then
		return
	end
	local W = Config.WORLD_HALF
	local function inRegion(p: Vector3, pad: number): boolean
		for _, r in ipairs(Config.Regions) do
			if not r.noGround and math.abs(p.X - r.center.X) < r.size.X / 2 + pad and math.abs(p.Z - r.center.Z) < r.size.Z / 2 + pad then
				return true
			end
		end
		for _, lm in ipairs(Config.Landmarks) do
			if (p - lm.at).Magnitude < 120 then
				return true
			end
		end
		local sm = Config.SECRET_MASTER
		if sm and Vector3.new(p.X - sm.at.X, 0, p.Z - sm.at.Z).Magnitude < 160 + pad then
			return true
		end
		return false
	end
	-- 세상 끝 산맥 (북쪽은 눈, 동쪽은 붉은 바위, 서쪽은 바다라 낮게)
	for k = 0, 59 do
		local a = k / 60 * math.pi * 2
		local p = Vector3.new(math.cos(a) * (W - 60), 0, math.sin(a) * (W - 60))
		-- 구석의 땅 (혈교 본산, 허공 균열, 숨은 사부)으로 가는 길은 산을 비운다
		local open = false
		for _, corner in ipairs({ Vector3.new(1750, 0, -1750), Vector3.new(-1750, 0, -1750), Config.SECRET_MASTER and Config.SECRET_MASTER.at or Vector3.zero }) do
			if Vector3.new(p.X - corner.X, 0, p.Z - corner.Z).Magnitude < 700 then
				open = true
			end
		end
		if p.X > -W + 400 and not open then
			local rad = rng:NextNumber(140, 260)
			local mat = p.Z < -W * 0.5 and Enum.Material.Snow or (p.X > W * 0.5 and Enum.Material.Sandstone or Enum.Material.Rock)
			pcall(function()
				terrain:FillBall(p - Vector3.new(0, rad * 0.35, 0), rad, mat)
			end)
		end
	end
	-- 들판의 완만한 언덕
	local made = 0
	for _ = 1, 160 do
		if made >= 45 then
			break
		end
		local p = Vector3.new(rng:NextNumber(-W + 300, W - 300), 0, rng:NextNumber(-W + 300, W - 300))
		local rad = rng:NextNumber(40, 90)
		if not inRegion(p, rad + 20) and not nearRoad(p, rad + 25) then
			made += 1
			pcall(function()
				terrain:FillBall(p - Vector3.new(0, rad * 0.7, 0), rad, Enum.Material.Grass)
			end)
		end
	end
end

------------------------------------------------------------------------
-- 지역 이름 표지
------------------------------------------------------------------------
local function regionSigns()
	for _, r in ipairs(Config.Regions) do
		if r.id ~= "village" and not r.noGround then
			local dir = Vector3.new(r.center.X, 0, r.center.Z).Unit
			local pos = r.center - dir * (math.max(r.size.X, r.size.Z) / 2 - 12)
			-- 길 옆 (길과 직각으로 비켜서)
			local side = Vector3.new(-dir.Z, 0, dir.X) * 16
			local post = part({ Name = "RegionPost", Size = Vector3.new(1.4, 10, 1.4), Position = pos + side + Vector3.new(0, 5, 0), Color = WOOD, Material = Enum.Material.Wood, Parent = folder })
			local board = part({ Name = "RegionSign", Size = Vector3.new(20, 5, 0.5), CFrame = CFrame.lookAt(pos + side + Vector3.new(0, 11, 0), pos + side + Vector3.new(0, 11, 0) - dir), Color = Color3.fromRGB(35, 25, 18), Material = Enum.Material.Wood, CanCollide = false, Parent = folder })
			sign(board, Enum.NormalId.Front, { { r.name, Color3.fromRGB(255, 225, 160), 1 } })
			local _ = post
		end
	end
end

function World.build(): any
	folder = Instance.new("Folder")
	folder.Name = "Gangho"
	folder.Parent = workspace
	local old = workspace:FindFirstChild("Baseplate")
	if old then
		old:Destroy()
	end
	local out: any = { train = {}, rings = {} }
	-- 한 조각이 틀려도 나머지는 다 만든다
	for _, step in ipairs({
		{ "땅", ground },
		{ "마을", function()
			village(out)
		end },
		{ "수련터", function()
			trainingSpots(out)
		end },
		{ "지역", regions },
		{ "사부의 자리", masterSites },
		{ "랜드마크", landmarks },
		{ "바깥 땅", outerLands },
		{ "적의 진", camps },
		{ "비급 조각", function()
			fragments(out)
		end },
		{ "숨은 자리", secretSite },
		{ "지형", terrainHills },
		{ "표지", regionSigns },
	}) do
		local ok, err = pcall(step[2] :: any)
		if not ok then
			warn("[권왕] 맵 만들기 오류 (" .. step[1] .. "):", err)
		end
	end
	local spawn = Instance.new("SpawnLocation")
	spawn.Name = "VillageSpawn"
	spawn.Anchored = true
	spawn.Size = Vector3.new(10, 1, 10)
	spawn.Position = Config.SPAWN - Vector3.new(0, 3.5, 0)
	spawn.Transparency = 1
	spawn.CanCollide = false
	spawn.Neutral = true
	spawn.Duration = 0
	spawn.Parent = folder
	return out
end

return World
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="StarterPlayer" referent="11">
    <Properties>
      <string name="Name">StarterPlayer</string>
      <float name="CameraMaxZoomDistance">45</float>
    </Properties>
    <Item class="StarterPlayerScripts" referent="12">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="LocalScript" referent="13">
        <Properties>
          <string name="Name">KwonClient</string>
          <string name="Source"><![CDATA[-- 권왕(拳王): 맨손의 강호 — 화면
-- 누르는 순간 내 몸이 먼저 움직이고(기다리지 않는다), 맞힌 상대는 서버에 알린다
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local Lighting = game:GetService("Lighting")

local Config = require(ReplicatedStorage:WaitForChild("Config"))
local Anim = require(script:WaitForChild("Anim"))
local Fx = require(script:WaitForChild("Fx"))
local UI = require(script:WaitForChild("UI"))

local player = Players.LocalPlayer
local remotes = ReplicatedStorage:WaitForChild("KwonRemotes")
local Request = remotes:WaitForChild("Request") :: RemoteEvent
local Push = remotes:WaitForChild("Push") :: RemoteEvent

UI.init(Request)
Fx.bindAnim(Anim)
Anim.start()

local state: any = nil
local launchedAt: { [Instance]: number } = {} -- 하늘로 띄운 적 (공중 연격 판단)
local function rootOfChar(): BasePart?
	local c = player.Character
	local r = c and c:FindFirstChild("HumanoidRootPart")
	return (r and r:IsA("BasePart")) and r or nil
end

------------------------------------------------------------------------
-- 무인 지켜보기 (사람과 적 모두 몸동작을 그린다)
------------------------------------------------------------------------
local function watchChar(char: Model)
	task.spawn(function()
		char:WaitForChild("HumanoidRootPart", 10)
		char:WaitForChild("Humanoid", 10)
		Anim.watch(char)
	end)
end
local function watchPlayer(p: Player)
	if p.Character then
		watchChar(p.Character)
	end
	p.CharacterAdded:Connect(watchChar)
end
for _, p in ipairs(Players:GetPlayers()) do
	watchPlayer(p)
end
Players.PlayerAdded:Connect(watchPlayer)
task.spawn(function()
	local enemies = workspace:WaitForChild("Enemies")
	local function add(m: Instance)
		if m:IsA("Model") then
			watchChar(m)
			task.spawn(UI.enemyTag, m)
			m:GetAttributeChangedSignal("LaunchedAt"):Connect(function()
				launchedAt[m] = os.clock()
			end)
		end
	end
	for _, m in ipairs(enemies:GetChildren()) do
		add(m)
	end
	enemies.ChildAdded:Connect(add)
end)

-- 각성의 기운 (사람과 사부): 0.5초마다 단계에 맞춰 붙이고 뗀다
local handKey: { [Model]: string } = setmetatable({}, { __mode = "k" }) :: any
task.spawn(function()
	while true do
		task.wait(0.5)
		local list: { Model } = {}
		for _, p in ipairs(Players:GetPlayers()) do
			if p.Character then
				table.insert(list, p.Character)
			end
		end
		local mf = workspace:FindFirstChild("Masters")
		for _, m in ipairs(mf and mf:GetChildren() or {}) do
			if m:IsA("Model") then
				table.insert(list, m)
			end
		end
		for _, m in ipairs(list) do
			local style = Config.STYLE_BY_ID[tostring(m:GetAttribute("Style") or "")]
			local tier = tonumber(m:GetAttribute("Awaken")) or 0
			pcall(Fx.awakenAura, m, style and tier or 0, style and style.color or Color3.new(1, 1, 1))
		end
		-- 권법마다 손에 맺힌 기운 (사부의 분신도)
		local ef = workspace:FindFirstChild("Enemies")
		for _, m in ipairs(ef and ef:GetChildren() or {}) do
			if m:IsA("Model") and m:GetAttribute("Style") then
				table.insert(list, m)
			end
		end
		for _, m in ipairs(list) do
			local key = tostring(m:GetAttribute("Style") or "") .. ":" .. tostring(tonumber(m:GetAttribute("Awaken")) or 0)
			if handKey[m] ~= key then
				handKey[m] = key
				pcall(Fx.styleHands, m, m:GetAttribute("Style"), tonumber(m:GetAttribute("Awaken")) or 0)
			end
		end
	end
end)

-- 빠르게 움직이면 화면 가장자리에 바람 줄
RunService.RenderStepped:Connect(function()
	local root = rootOfChar()
	if root then
		local v = root.AssemblyLinearVelocity
		UI.setSpeed(math.clamp((Vector3.new(v.X, 0, v.Z).Magnitude - 27) / 35, 0, 1))
	end
end)

-- 사부: 권법 자세로 서 있다가, 가까이 오면 가끔 시범을 보인다
task.spawn(function()
	local masters = workspace:WaitForChild("Masters")
	local function add(m: Instance)
		if m:IsA("Model") then
			watchChar(m)
		end
	end
	for _, m in ipairs(masters:GetChildren()) do
		add(m)
	end
	masters.ChildAdded:Connect(add)
	local nextShow: { [Instance]: number } = {}
	local nextSpeak: { [Instance]: number } = {}
	-- 말풍선
	local function speak(m: Model, text: string, color: Color3)
		local head = m:FindFirstChild("Head")
		if text == "" or not head or not head:IsA("BasePart") then
			return
		end
		local bb = Instance.new("BillboardGui")
		bb.Size = UDim2.new(0, 360, 0, 70)
		bb.StudsOffset = Vector3.new(0, 6.2, 0)
		bb.AlwaysOnTop = true
		bb.LightInfluence = 0
		bb.MaxDistance = 80
		local frame = Instance.new("Frame")
		frame.Size = UDim2.fromScale(1, 1)
		frame.BackgroundColor3 = Color3.fromRGB(20, 16, 14)
		frame.BackgroundTransparency = 0.2
		frame.Parent = bb
		local corner = Instance.new("UICorner")
		corner.CornerRadius = UDim.new(0, 12)
		corner.Parent = frame
		local stroke = Instance.new("UIStroke")
		stroke.Color = color
		stroke.Thickness = 2
		stroke.Parent = frame
		local label = Instance.new("TextLabel")
		label.BackgroundTransparency = 1
		label.Size = UDim2.new(1, -16, 1, -8)
		label.Position = UDim2.new(0, 8, 0, 4)
		label.Font = Enum.Font.GothamBold
		label.TextScaled = true
		label.TextWrapped = true
		label.TextColor3 = Color3.fromRGB(255, 245, 225)
		label.Text = "「" .. text .. "」"
		label.Parent = frame
		bb.Parent = head
		task.delay(5, function()
			bb:Destroy()
		end)
	end
	-- 사부 둘레를 도는 기운의 구슬
	local orbs: { [Instance]: { Part } } = {}
	RunService.RenderStepped:Connect(function()
		local t = os.clock()
		local me = rootOfChar()
		for _, m in ipairs(masters:GetChildren()) do
			local root = m:FindFirstChild("HumanoidRootPart")
			local style = Config.STYLE_BY_ID[tostring(m:GetAttribute("Style") or "")]
			if root and root:IsA("BasePart") and style and me and (root.Position - me.Position).Magnitude < 140 then
				local list = orbs[m]
				if not list then
					list = {}
					for i = 1, 3 do
						local o = Instance.new("Part")
						o.Name = "MasterOrb"
						o.Shape = Enum.PartType.Ball
						o.Size = Vector3.new(0.7, 0.7, 0.7)
						o.Anchored = true
						o.CanCollide = false
						o.CanQuery = false
						o.CanTouch = false
						o.CastShadow = false
						o.Material = Enum.Material.Neon
						o.Color = i == 2 and style.color2 or style.color
						o.Parent = workspace
						local l = Instance.new("PointLight")
						l.Color = style.color
						l.Range = 8
						l.Brightness = 1.2
						l.Parent = o
						table.insert(list, o)
					end
					orbs[m] = list
				end
				for i, o in ipairs(list) do
					local a = t * 1.6 + i / 3 * math.pi * 2
					o.Position = root.Position + Vector3.new(math.cos(a) * 4, 0.5 + math.sin(t * 2 + i) * 1.2, math.sin(a) * 4)
				end
			elseif orbs[m] then
				for _, o in ipairs(orbs[m]) do
					o:Destroy()
				end
				orbs[m] = nil
			end
		end
	end)
	while true do
		task.wait(0.5)
		local char = player.Character
		local me = char and char:FindFirstChild("HumanoidRootPart")
		for _, m in ipairs(masters:GetChildren()) do
			local root = m:FindFirstChild("HumanoidRootPart")
			local style = Config.STYLE_BY_ID[m:GetAttribute("Style") :: any]
			if me and me:IsA("BasePart") and root and root:IsA("BasePart") and style and (root.Position - me.Position).Magnitude < 70 then
				local t = os.clock()
				local dist = (root.Position - me.Position).Magnitude
				-- 가까이 오면 한마디
				if dist < 32 and t >= (nextSpeak[m] or 0) then
					nextSpeak[m] = t + 30
					speak(m :: Model, tostring(m:GetAttribute("Quote") or ""), style.color)
				end
				if t >= (nextShow[m] or 0) and not Anim.playing(m :: Model) then
					-- 시범: 연타, 강타, 기술을 섞어 제대로 보여 준다
					local picks: { any } = { 1, 2, 3, 4, "H", "E", "R", "F" }
					local slot = picks[math.random(1, #picks)]
					local mv = Config.move(style.id, slot)
					if mv then
						Anim.play(m :: Model, mv.pose, mv.dur)
						Fx.limbTrails(m :: Model, mv.pose, mv.dur, style.color, style.color2)
						Fx.cast(style.id, slot, m :: Model, mv.dur)
						for _, h in ipairs(mv.hits or {}) do
							task.delay(h.t, function()
								Fx.swing(style.id, m :: Model, (h.kb or 0) >= 20)
							end)
						end
					end
					nextShow[m] = t + math.random(30, 50) / 10
				end
			end
		end
	end
end)

------------------------------------------------------------------------
-- 내 몸
------------------------------------------------------------------------
local function myChar(): Model?
	return player.Character
end
local function myRoot(): BasePart?
	local c = player.Character
	local r = c and c:FindFirstChild("HumanoidRootPart")
	return (r and r:IsA("BasePart")) and r or nil
end
local function myHum(): Humanoid?
	local c = player.Character
	return c and c:FindFirstChildOfClass("Humanoid") or nil
end
local function myStyle(): any
	return state and state.style ~= "" and Config.STYLE_BY_ID[state.style] or nil
end
local function flat(v: Vector3): Vector3
	local f = Vector3.new(v.X, 0, v.Z)
	return f.Magnitude > 1e-4 and f.Unit or Vector3.new(0, 0, -1)
end

local seq = 0
local actSeq = -1
local actStart = 0
local actDur = 0
local buffered: any = nil
local guarding = false
local chargeStart: number? = nil
local stunUntil = 0
local dead = false
local dashAt = 0
local dashUsed = 0
local airJumped = false
local deflectAt = 0 -- 마지막으로 흘린 때 (곧바로 클릭하면 반격)
-- 연타 박자
local earlyPresses = 0 -- 지금 동작 중에 너무 일찍 누른 횟수
local comboBroken = false -- 흐트러졌다 (마구 눌렀다)
local nextPerfect = false -- 다음 동작이 박자를 맞췄는가
local perfectChain = 0
local lastComboSlot: any = nil
local airJ = 0
local airAttacked = false
local sprinting = false
local cds: { [string]: number } = {}
local cdLen: { [string]: number } = {}
local predictedAt: { [Model]: number } = {}
local training: string? = nil

------------------------------------------------------------------------
-- 카메라 흔들림
------------------------------------------------------------------------
-- 카메라가 순간 다가섰다 돌아온다 (흘리기·반격의 손맛)
local fovBase: number? = nil
local function fovPunch(delta: number, time: number)
	local cam = workspace.CurrentCamera
	if not cam then
		return
	end
	fovBase = fovBase or cam.FieldOfView
	local base = fovBase :: number
	cam.FieldOfView = base + delta
	game:GetService("TweenService"):Create(cam, TweenInfo.new(time, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { FieldOfView = base }):Play()
end

local shakeAmp = 0
local function shake(amount: number)
	shakeAmp = math.max(shakeAmp, amount)
end
RunService:BindToRenderStep("KwonShake", Enum.RenderPriority.Camera.Value + 1, function(dt: number)
	local cam = workspace.CurrentCamera
	if not cam then
		return
	end
	if shakeAmp > 0.01 then
		local a = shakeAmp
		cam.CFrame = cam.CFrame * CFrame.new((math.random() - 0.5) * a, (math.random() - 0.5) * a, 0) * CFrame.Angles((math.random() - 0.5) * a * 0.02, (math.random() - 0.5) * a * 0.02, 0)
		shakeAmp *= math.exp(-dt * 14)
	end
end)
local cc = Instance.new("ColorCorrectionEffect")
cc.Name = "KwonHitTint"
cc.Parent = Lighting
local function tint(color: Color3, strength: number, time: number)
	cc.TintColor = Color3.new(1, 1, 1):Lerp(color, strength)
	cc.Contrast = strength * 0.4
	task.delay(time, function()
		cc.TintColor = Color3.new(1, 1, 1)
		cc.Contrast = 0
	end)
end

------------------------------------------------------------------------
-- 맞힐 상대 찾기 (서버와 같은 상자)
------------------------------------------------------------------------
local function onRing(pos: Vector3): boolean
	local R = Config.RING
	return math.abs(pos.X - R.center.X) <= R.size / 2 and math.abs(pos.Z - R.center.Z) <= R.size / 2 and pos.Y > R.height - 1
end

local function foes(): { Model }
	local list = {}
	local enemies = workspace:FindFirstChild("Enemies")
	if enemies then
		for _, m in ipairs(enemies:GetChildren()) do
			if m:IsA("Model") and m:GetAttribute("Dead") ~= true then
				table.insert(list, m)
			end
		end
	end
	local me = myRoot()
	if me and onRing(me.Position) then
		for _, p in ipairs(Players:GetPlayers()) do
			local c = p.Character
			local r = c and c:FindFirstChild("HumanoidRootPart")
			if p ~= player and c and r and r:IsA("BasePart") and onRing(r.Position) and c:GetAttribute("Dead") ~= true then
				table.insert(list, c)
			end
		end
	end
	return list
end

local function rootOf(m: Model): BasePart?
	local r = m:FindFirstChild("HumanoidRootPart")
	return (r and r:IsA("BasePart")) and r or nil
end

local function query(hit: any): { Model }
	local root = myRoot()
	if not root then
		return {}
	end
	local look = flat(root.CFrame.LookVector)
	local origin = root.Position
	local center = hit.aoe and origin or origin + look * (hit.range * 0.55)
	local reach = hit.aoe and hit.radius or (hit.range * 0.55 + hit.radius)
	local out = {}
	for _, m in ipairs(foes()) do
		local r = rootOf(m)
		if r then
			local d = Vector3.new(r.Position.X - center.X, 0, r.Position.Z - center.Z).Magnitude
			if d <= reach + 1 and math.abs(r.Position.Y - origin.Y) < 9 then
				table.insert(out, m)
			end
		end
	end
	return out
end

-- 가까운 적 쪽으로 몸을 돌린다 (카메라 방향 75도 안, 14칸 안)
local function aim(): number?
	local root = myRoot()
	local cam = workspace.CurrentCamera
	if not root or not cam then
		return nil
	end
	local camDir = flat(cam.CFrame.LookVector)
	local best, bestScore = nil, math.huge
	for _, m in ipairs(foes()) do
		local r = rootOf(m)
		if r then
			local v = Vector3.new(r.Position.X - root.Position.X, 0, r.Position.Z - root.Position.Z)
			local d = v.Magnitude
			if d < 14 and d > 0.1 and v.Unit:Dot(camDir) > math.cos(math.rad(75)) then
				if d < bestScore then
					best, bestScore = r, d
				end
			end
		end
	end
	local dir = best and flat(best.Position - root.Position) or camDir
	root.CFrame = CFrame.lookAt(root.Position, root.Position + dir)
	return best and bestScore or nil
end

-- 잠깐 앞으로 미끄러지기 (내 몸은 내가 움직인다)
local function push(vel: Vector3, time: number)
	local root = myRoot()
	if not root then
		return
	end
	local start = os.clock()
	local conn: RBXScriptConnection
	conn = RunService.Heartbeat:Connect(function()
		if not root.Parent or os.clock() - start > time then
			conn:Disconnect()
			return
		end
		root.AssemblyLinearVelocity = Vector3.new(vel.X, math.max(root.AssemblyLinearVelocity.Y, vel.Y), vel.Z)
	end)
end

------------------------------------------------------------------------
-- 기술 쓰기
------------------------------------------------------------------------
local function busy(): boolean
	return os.clock() < actStart + actDur
end

local function canAct(): boolean
	return not dead and os.clock() >= stunUntil and not guarding and myChar() ~= nil and myStyle() ~= nil
end

local startMove: (any, number?) -> ()

local function unlocked(slot: string): boolean
	local need = Config.SKILL_UNLOCK[slot]
	if not need or not state then
		return true
	end
	local m = state.mastery and state.mastery[state.style]
	return (m and m.lv or 1) >= need
end

startMove = function(slot: any, charge: number?)
	local style = myStyle()
	local char = myChar()
	local root = myRoot()
	if not style or not char or not root then
		return
	end
	local move = Config.move(style.id, slot)
	if not move then
		return
	end
	local now = os.clock()
	-- 앞 기술이 남아 있으면 줄 세운다 (끝날 때 바로 나간다)
	if busy() then
		if now >= actStart + actDur * (type(slot) == "number" and 0.7 or 0.85) then
			-- 이어 쓸 수 있는 순간
		else
			buffered = { slot = slot, charge = charge, at = now }
			return
		end
	end
	if slot == "E" or slot == "R" or slot == "G" then
		if not unlocked(slot) then
			UI.toast(string.format("🔒 %s: 숙련도 %d에 열려요", move.name, Config.SKILL_UNLOCK[slot]))
			return
		end
		if now < (cds[slot] or 0) then
			return
		end
		local chi = char:GetAttribute("Chi")
		if type(chi) == "number" and chi < (move.chi or 0) then
			UI.toast(string.format("내공이 부족해요 (🌀 %d 필요)", move.chi or 0))
			return
		end
		cds[slot] = now + (move.cd or 0)
		cdLen[slot] = move.cd or 1
	end
	local speed = Config.actSpeed(style, state and state.gradeUp and state.gradeUp[style.id] or 0, char:GetAttribute("Buff") == "frenzy")
	local dur = move.dur / speed
	local gap = aim()
	seq += 1
	local mySeq = seq
	actSeq = mySeq
	actStart = now
	actDur = dur
	buffered = nil
	local first = move.hits and move.hits[1]
	Anim.play(char, move.pose, dur, { align = first and first.t / speed or nil })
	Fx.limbTrails(char, move.pose, dur, style.color, style.color2)
	Fx.cast(style.id, slot, char, dur)
	local perfect = nextPerfect
	nextPerfect = false
	Request:FireServer("act", slot, mySeq, charge, perfect)
	if type(slot) == "number" or slot == "F" then
		earlyPresses = 0
		lastComboSlot = slot
		if perfect then
			perfectChain += 1
			local big = perfectChain >= Config.RHYTHM.chain
			Fx.text(root.Position + Vector3.new(0, 4.5, 0), big and string.format("연속 정타 ×%d", perfectChain) or "정타!", big and Color3.fromRGB(255, 200, 80) or Color3.fromRGB(255, 235, 170), big and 30 or 22, 0.8)
			Fx.ring(root.Position - Vector3.new(0, 2.5, 0), style.color, 2, big and 12 or 7, 0.3)
			Fx.sound("ping", 0.35, big and 1.6 or 1.3)
		elseif slot ~= 1 then
			perfectChain = 0
		end
	end
	if slot == "F" then
		-- 각성 마무리: 크게 휘둘러 하늘로 띄운다
		UI.flash(style.color, 0.25)
		fovPunch(-6, 0.4)
		Fx.text(root.Position + Vector3.new(0, 6, 0), "✦ " .. move.name, style.color, 34, 1.2)
	end
	if move.hover then
		-- 공중 연격: 나도 공중에 머문다
		root.AssemblyLinearVelocity = Vector3.new(root.AssemblyLinearVelocity.X * 0.3, move.hover, root.AssemblyLinearVelocity.Z * 0.3)
	end
	if slot == "C" then
		Fx.text(root.Position + Vector3.new(0, 5, 0), "반격!", Color3.fromRGB(255, 220, 120), 38)
		UI.flash(Color3.fromRGB(255, 230, 160), 0.2)
	elseif slot == "D" then
		Fx.afterimage(char, style.color, 0.35)
	end
	if move.dive then
		-- 잠깐 떠올랐다가 땅으로 내리꽂는다
		local diveStart = os.clock()
		local conn: RBXScriptConnection
		conn = RunService.Heartbeat:Connect(function()
			local t = os.clock() - diveStart
			if not root.Parent or t > dur then
				conn:Disconnect()
				return
			end
			local v = root.AssemblyLinearVelocity
			if t < 0.12 then
				root.AssemblyLinearVelocity = Vector3.new(v.X * 0.5, 10, v.Z * 0.5)
			else
				root.AssemblyLinearVelocity = Vector3.new(v.X * 0.3, -move.dive, v.Z * 0.3)
			end
		end)
		task.delay((first and first.t or 0.3) / speed, function()
			if actSeq == mySeq then
				local feet = root.Position - Vector3.new(0, 2.6, 0)
				Fx.ring(feet + Vector3.new(0, 0.3, 0), style.color, 3, 24, 0.45)
				Fx.ring(feet + Vector3.new(0, 0.4, 0), Color3.new(1, 1, 1), 2, 14, 0.3)
				Fx.dust(feet, 4)
				Fx.sound("heavy", 0.9, 0.55)
				shake(1)
			end
		end)
	end
	local look = flat(root.CFrame.LookVector)
	-- 상대가 조금 떨어져 있으면 한 걸음에 파고든다 (거리를 좁히며 친다)
	local close = 0
	if gap and gap > 4.5 and not move.teleport and not move.proj and move.hits and #move.hits > 0 then
		close = math.min(gap - 3.5, 7)
	end
	local lunge = (move.lunge or 0) + close
	if lunge > 0 and not move.teleport then
		push(look * (lunge / 0.16), 0.16)
		if close > 2 then
			Fx.afterimage(char, style.color, 0.25)
		end
	end
	if move.jump then
		root.AssemblyLinearVelocity = Vector3.new(root.AssemblyLinearVelocity.X, move.jump, root.AssemblyLinearVelocity.Z)
	end
	if slot == "G" then
		UI.cinematic(move.name, style.color, dur)
		Fx.ult(style.id, char, dur)
		shake(1.2)
		tint(style.color, 0.25, dur)
	end
	-- 휘두르는 소리와 맞힘 알리기
	for i, h in ipairs(move.hits or {}) do
		task.delay(h.t / speed, function()
			if actSeq ~= mySeq or dead then
				return
			end
			Fx.sound("swing", 0.35, 1.05 + math.random() * 0.25)
			Fx.swing(style.id, char, (h.kb or 0) >= 20)
			local targets = query(h)
			Request:FireServer("hit", mySeq, i, targets)
			-- 바로 반응 (서버가 정하기 전에): 멈칫과 불꽃
			for _, m in ipairs(targets) do
				local r = rootOf(m)
				if r and m:GetAttribute("Guard") ~= true then
					predictedAt[m] = os.clock()
					local heavy = (h.kb or 0) >= 20 or (h.stun or 0) >= 0.6
					Fx.hitstop({ char, m }, heavy and 0.1 or 0.05)
					if heavy then
						-- 큰 한 방: 순간 번쩍이는 임팩트 프레임과 카메라 당김
						UI.flash(Color3.new(1, 1, 1), 0.18)
						fovPunch(-4, 0.25)
					end
					Fx.styleHit(style.id, r.Position:Lerp(root.Position, 0.35) + Vector3.new(0, 1, 0), heavy, look)
					Fx.sound(heavy and "heavy" or "hit", heavy and 0.9 or 0.6, heavy and 0.6 or 0.85 + math.random() * 0.2)
					shake(heavy and 0.9 or 0.35)
					if m:GetAttribute("Poise") ~= true then
						Anim.play(m, (math.random() < 0.5) and "flinch_l" or "flinch_r", 0.3)
					end
				end
			end
		end)
	end
	if move.proj then
		task.delay(dur * 0.42, function()
			if actSeq == mySeq then
				Fx.sound("swing", 0.6, 0.7)
				shake(0.4)
			end
		end)
	end
end

-- 줄 세운 입력: 앞 기술이 끝나면 바로
RunService.Heartbeat:Connect(function()
	if buffered and not busy() and canAct() then
		local b = buffered
		buffered = nil
		if os.clock() - b.at < 0.5 then
			nextPerfect = b.perfect == true
			startMove(b.slot, b.charge)
		end
	elseif buffered and os.clock() >= actStart + actDur * 0.7 and canAct() and type(buffered.slot) == "number" then
		local b = buffered
		buffered = nil
		nextPerfect = b.perfect == true
		startMove(b.slot, b.charge)
	end
end)

local function attack()
	if training and training ~= "bamboo" then
		UI.trainPress()
		return
	end
	if not canAct() then
		return
	end
	local style = myStyle()
	if not style then
		UI.openPage("styles", { first = true })
		return
	end
	local now = os.clock()
	-- 몸놀림 기술: 흘리기 직후 = 반격, 공중 = 낙하격, 대시 직후 = 돌진 일격
	local hum = myHum()
	if now - deflectAt < Config.ACTION_WINDOW.C then
		deflectAt = 0
		startMove("C")
		return
	end
	if hum and hum.FloorMaterial == Enum.Material.Air and not busy() then
		-- 띄운 적이 가까이 있으면 공중 연격 (세 번까지), 아니면 내리꽂는 낙하격
		local root = myRoot()
		local near = false
		if root then
			for m, at in pairs(launchedAt) do
				local r = m.Parent and rootOf(m :: Model)
				if r and now - at < 1.6 and (r.Position - root.Position).Magnitude < 12 then
					near = true
				end
			end
		end
		if near and airJ < 3 then
			airJ += 1
			aim()
			startMove("J")
			return
		elseif not airAttacked then
			airAttacked = true
			startMove("A")
			return
		end
	end
	if now - dashAt < Config.ACTION_WINDOW.D and not busy() then
		dashAt = 0
		startMove("D")
		return
	end
	-- 연타는 박자다: 앞 동작이 끝나 갈 즈음 눌러야 이어지고(딱 맞으면 連), 너무 일찍 마구 누르면 흐트러진다
	local R = Config.RHYTHM
	local meChar = myChar()
	local tier = meChar and tonumber(meChar:GetAttribute("Awaken")) or 0
	local function nextSlot(): any
		if lastComboSlot == #style.combo and tier >= 1 then
			return "F"
		elseif type(lastComboSlot) == "number" and lastComboSlot < #style.combo then
			return lastComboSlot + 1
		end
		return 1
	end
	local root = myRoot()
	if busy() then
		local frac = (now - actStart) / math.max(0.05, actDur)
		if frac < R.early then
			earlyPresses += 1
			if earlyPresses >= 2 and not comboBroken then
				comboBroken = true
				if root then
					Fx.text(root.Position + Vector3.new(0, 4, 0), "흐트러짐", Color3.fromRGB(200, 190, 180), 22, 0.6)
				end
			end
			return
		end
		if comboBroken or type(lastComboSlot) ~= "number" and lastComboSlot ~= "F" then
			return
		end
		buffered = { slot = nextSlot(), at = now, perfect = frac >= R.perfectFrom }
		return
	end
	local ended = actStart + actDur
	if comboBroken then
		-- 흐트러지면 잠깐 숨을 고른 뒤 처음부터
		if now < ended + R.breakLock then
			return
		end
		comboBroken = false
		lastComboSlot = nil
		perfectChain = 0
	end
	local slot: any = 1
	if (type(lastComboSlot) == "number" or lastComboSlot == "F") and now - ended <= Config.COMBO_WINDOW and lastComboSlot ~= "F" then
		slot = nextSlot()
		nextPerfect = now - ended <= R.late
	end
	startMove(slot)
end

local function heavyDown()
	if not canAct() then
		return
	end
	local style = myStyle()
	if style and style.charge then
		chargeStart = os.clock()
		local char = myChar()
		if char then
			Anim.setLoop(char, "double_palm", 3)
			local root = myRoot()
			if root then
				Fx.ring(root.Position - Vector3.new(0, 2.5, 0), style.color, 2, 8, 0.5)
			end
		end
		return
	end
	startMove("H")
end

local function heavyUp()
	if not chargeStart then
		return
	end
	local style = myStyle()
	local held = os.clock() - (chargeStart :: number)
	chargeStart = nil
	local char = myChar()
	if char then
		Anim.setLoop(char, nil)
	end
	if style then
		startMove("H", math.clamp(held, 0, style.charge or 1.5))
	end
end

local function skill(slot: string)
	if canAct() then
		startMove(slot)
	end
end

local function guardDown()
	if training == "dummy" then
		UI.trainPress()
		return
	end
	if dead or os.clock() < stunUntil or busy() then
		return
	end
	guarding = true
	Request:FireServer("guard", true)
end
local function guardUp()
	if guarding then
		guarding = false
		Request:FireServer("guard", false)
	end
end

local function dash()
	local style = myStyle()
	local root = myRoot()
	local hum = myHum()
	local char = myChar()
	if not root or not hum or not char or dead or os.clock() < stunUntil then
		return
	end
	local now = os.clock()
	local cd = style and style.dashCd or Config.DASH_CD
	local charges = style and style.dashCharges or 1
	if now - dashAt > cd then
		dashUsed = 0
	end
	if dashUsed >= charges then
		return
	end
	dashUsed += 1
	dashAt = now
	guardUp()
	actSeq = -1
	actDur = 0
	local dir = hum.MoveDirection.Magnitude > 0.1 and flat(hum.MoveDirection) or flat(root.CFrame.LookVector)
	-- 카메라 기준으로 앞/뒤/옆을 가려 동작을 바꾼다 (뒤 = 공중제비, 옆 = 구르기)
	local cam = workspace.CurrentCamera
	local camLook = cam and flat(cam.CFrame.LookVector) or flat(root.CFrame.LookVector)
	local along = dir:Dot(camLook)
	local kind = "front"
	if hum.MoveDirection.Magnitude > 0.1 and along < -0.5 then
		kind = "back"
	elseif hum.MoveDirection.Magnitude > 0.1 and math.abs(along) <= 0.5 then
		kind = camLook:Cross(dir).Y < 0 and "right" or "left"
	end
	if kind == "front" then
		root.CFrame = CFrame.lookAt(root.Position, root.Position + dir)
	else
		root.CFrame = CFrame.lookAt(root.Position, root.Position + camLook)
	end
	push(dir * Config.DASH_SPEED + (kind == "back" and Vector3.new(0, 18, 0) or Vector3.zero), Config.DASH_TIME)
	local pose = kind == "back" and "backflip" or (kind == "right" and "side_roll_r" or (kind == "left" and "side_roll_l" or "dash"))
	Anim.play(char, pose, kind == "front" and 0.28 or 0.4)
	Fx.afterimage(char, style and style.color or Color3.new(1, 1, 1), 0.3)
	Fx.limbTrails(char, pose, 0.35, style and style.color or Color3.new(1, 1, 1), style and style.color2 or Color3.new(1, 1, 1))
	Fx.ring(root.Position - Vector3.new(0, 2.5, 0), style and style.color or Color3.new(1, 1, 1), 2, 8, 0.3)
	Fx.sound("swing", 0.4, 1.6)
	Request:FireServer("dash", kind)
end

local function doubleJump()
	local root = myRoot()
	local hum = myHum()
	local char = myChar()
	if not root or not hum or not char or dead or airJumped then
		return
	end
	if hum.FloorMaterial ~= Enum.Material.Air then
		return
	end
	airJumped = true
	root.AssemblyLinearVelocity = Vector3.new(root.AssemblyLinearVelocity.X, Config.DOUBLE_JUMP, root.AssemblyLinearVelocity.Z)
	Anim.play(char, "double_jump", 0.45)
	local style = myStyle()
	Fx.ring(root.Position - Vector3.new(0, 2.5, 0), style and style.color or Color3.new(1, 1, 1), 2, 9, 0.35)
	Fx.sound("jump", 0.5, 1.3)
	Request:FireServer("djump")
end

-- Shift를 누르고 있으면 달린다
local function setSprint(on: boolean)
	if sprinting == on then
		return
	end
	sprinting = on
	local char = myChar()
	if char then
		char:SetAttribute("Sprint", on or nil)
	end
	Request:FireServer("sprint", on)
end

local doEmote: (string) -> () = function(_id: string) end

------------------------------------------------------------------------
-- 입력
------------------------------------------------------------------------
UserInputService.InputBegan:Connect(function(input: InputObject, processed: boolean)
	if processed then
		return
	end
	local t = input.UserInputType
	local k = input.KeyCode
	if t == Enum.UserInputType.MouseButton1 then
		attack()
	elseif k == Enum.KeyCode.Z then
		heavyDown()
	elseif k == Enum.KeyCode.E then
		skill("E")
	elseif k == Enum.KeyCode.R then
		skill("R")
	elseif k == Enum.KeyCode.G then
		skill("G")
	elseif k == Enum.KeyCode.Q then
		dash()
	elseif k == Enum.KeyCode.F then
		guardDown()
	elseif k == Enum.KeyCode.H then
		Request:FireServer("potion")
	elseif k == Enum.KeyCode.Space then
		if training and training ~= "bamboo" then
			UI.trainPress()
		else
			doubleJump()
		end
	elseif k == Enum.KeyCode.Tab then
		UI.openPage("stats")
	elseif k == Enum.KeyCode.M then
		UI.toggleMap()
	elseif k == Enum.KeyCode.One or k == Enum.KeyCode.Two or k == Enum.KeyCode.Three or k == Enum.KeyCode.Four then
		-- 몸짓: 서서 할 수 있는 동작
		if not busy() and not dead and not guarding and not training then
			local id = ({ [Enum.KeyCode.One] = "salute", [Enum.KeyCode.Two] = "taunt", [Enum.KeyCode.Three] = "kata", [Enum.KeyCode.Four] = "meditate" })[k]
			if id then
				doEmote(id)
			end
		end
	elseif k == Enum.KeyCode.LeftShift or k == Enum.KeyCode.RightShift then
		setSprint(true)
	end
end)
UserInputService.InputEnded:Connect(function(input: InputObject)
	if input.KeyCode == Enum.KeyCode.Z then
		heavyUp()
	elseif input.KeyCode == Enum.KeyCode.F then
		guardUp()
	elseif input.KeyCode == Enum.KeyCode.LeftShift or input.KeyCode == Enum.KeyCode.RightShift then
		setSprint(false)
	end
end)
UI.mobile({
	attack = attack,
	heavyDown = heavyDown,
	heavyUp = heavyUp,
	guardDown = guardDown,
	guardUp = guardUp,
	dash = dash,
	E = function()
		skill("E")
	end,
	R = function()
		skill("R")
	end,
	G = function()
		skill("G")
	end,
	potion = function()
		Request:FireServer("potion")
	end,
	train = function()
		UI.trainPress()
	end,
})

-- 땅에 닿으면 두 번 뛰기·낙하격을 되살린다. 세게 떨어지면 내려앉는 자세
local fallSpeed = 0
RunService.Heartbeat:Connect(function()
	local hum = myHum()
	local root = myRoot()
	if not hum or not root then
		return
	end
	if hum.FloorMaterial ~= Enum.Material.Air then
		airJumped = false
		airAttacked = false
		airJ = 0
		if fallSpeed > 55 and not busy() and not dead then
			local char = myChar()
			if char then
				Anim.play(char, "land", 0.35)
				Fx.dust(root.Position - Vector3.new(0, 2.6, 0), 2.5)
				shake(0.3)
			end
		end
		fallSpeed = 0
	else
		fallSpeed = math.max(fallSpeed, -root.AssemblyLinearVelocity.Y)
	end
end)


------------------------------------------------------------------------
-- 서버 소식
------------------------------------------------------------------------
local handlers: { [string]: (...any) -> () } = {}

local function modelPos(m: Model?): Vector3?
	local r = m and rootOf(m)
	return r and r.Position or nil
end

function handlers.state(data: any)
	state = data
	UI.setState(data)
end

function handlers.toast(msg: string)
	UI.toast(msg)
end

function handlers.open(data: any)
	UI.openPage(data.page, data)
end

-- 몸짓 (1 포권, 2 도발, 3 권법 시연, 4 명상)
local EMOTES = { salute = { "salute", 1.2 }, taunt = { "taunt", 1.4 }, kata = { "kata", 2.0 }, meditate = { "meditate", 3.0 } }
function handlers.emote(m: Model, id: any, isLocal: boolean?)
	local e = EMOTES[tostring(id)]
	if not e or not m or not m.Parent or (m == myChar() and not isLocal) then
		return
	end
	Anim.play(m, e[1], e[2], { fadeOut = 0.3 })
	local style = Config.STYLE_BY_ID[tostring(m:GetAttribute("Style") or "")]
	local r = rootOf(m)
	if style and r then
		if id == "kata" then
			Fx.limbTrails(m, "kata", e[2], style.color, style.color2)
			for k = 0, 3 do
				task.delay(0.15 + k * 0.4, function()
					Fx.swing(style.id, m, k == 3)
				end)
			end
		elseif id == "meditate" then
			Fx.ring(r.Position - Vector3.new(0, 2.5, 0), style.color, 2, 12, 1.2)
		elseif id == "salute" then
			Fx.ring(r.Position + r.CFrame.LookVector * 1.5, style.color2, 1, 5, 0.4, r.CFrame.LookVector)
		end
	end
end

doEmote = function(id: string)
	local char = myChar()
	if char then
		handlers.emote(char, id, true)
		Request:FireServer("emote", id)
	end
end

-- 심마 대련
function handlers.simma(m: Model)
	local r = m and rootOf(m)
	if r then
		Fx.text(r.Position + Vector3.new(0, 6, 0), "👁 심마", Color3.fromRGB(200, 80, 255), 40, 1.5)
		Fx.ring(r.Position - Vector3.new(0, 2.5, 0), Color3.fromRGB(190, 60, 255), 3, 30, 0.8)
		Fx.afterimage(m, Color3.fromRGB(120, 40, 180), 0.8)
	end
	UI.banner("👁 심마 대련", "마음속의 마귀를 꺾어라", Color3.fromRGB(200, 90, 255))
	shake(0.8)
end
-- 사부의 시험: 사부의 분신이 나타난다
function handlers.trial(data: any)
	local m = data.m
	local s = Config.STYLE_BY_ID[data.style]
	local color = s and s.color or Color3.fromRGB(255, 220, 120)
	local r = m and rootOf(m)
	if r then
		Fx.text(r.Position + Vector3.new(0, 6, 0), "⚔ 분신", color, 40, 1.5)
		Fx.ring(r.Position - Vector3.new(0, 2.5, 0), color, 3, 30, 0.8)
		Fx.afterimage(m, color, 0.8)
	end
	UI.banner("⚔ " .. data.name .. "의 시험", "분신을 꺾어라 · 흘리고(F) 반격하라", color)
	shake(0.8)
end
function handlers.simmaWin(data: any)
	UI.banner("👁 심마를 꺾었다!", string.format("모든 능력치 +%d", data.gain or 0), Color3.fromRGB(255, 220, 120))
	Fx.sound("ping", 0.9, 0.9)
end

-- 사부에게 가는 길잡이
function handlers.guide(data: any)
	UI.setGuide(data.style)
end

-- 누군가 기술을 쓴다
function handlers.act(data: any)
	local m: Model = data.m
	if not m or not m.Parent then
		return
	end
	if m == myChar() and data.seq ~= -1 then
		return -- 내 몸은 이미 움직였다
	end
	Anim.play(m, data.pose, data.dur, { align = data.align })
	local style = type(data.style) == "string" and Config.STYLE_BY_ID[data.style]
	if style and data.slot ~= nil then
		Fx.cast(style.id, data.slot, m, data.dur)
		local mv = Config.move(style.id, data.slot)
		for _, h in ipairs(mv and mv.hits or {}) do
			task.delay(h.t * (data.dur / math.max(0.05, mv.dur)), function()
				if m.Parent then
					Fx.swing(style.id, m, (h.kb or 0) >= 20)
				end
			end)
		end
	end
	local color = style and style.color or (data.unblockable and Color3.fromRGB(255, 60, 40) or Color3.fromRGB(235, 235, 245))
	Fx.limbTrails(m, data.pose, data.dur, color, style and style.color2 or Color3.new(1, 1, 1))
	local pos = modelPos(m)
	local me = myRoot()
	local near = pos and me and (pos - me.Position).Magnitude < 60
	-- 적이 휘두르기 직전: 무기가 반짝인다 (흘릴 때!), 붉으면 막을 수 없다
	if data.windup and pos then
		if data.unblockable then
			Fx.text(pos + Vector3.new(0, 5, 0), "⚠ 위험", Color3.fromRGB(255, 70, 50), 34, 1.5)
			Fx.ring(pos - Vector3.new(0, 2.5, 0), Color3.fromRGB(255, 50, 40), 3, 14, data.windup)
		end
		task.delay(math.max(0, data.windup - 0.14), function()
			local p2 = modelPos(m)
			if not p2 then
				return
			end
			local blade = nil
			for _, w in ipairs(m:GetChildren()) do
				if w.Name == "Weapon" then
					local b = w:FindFirstChild("Blade")
					if b and b:IsA("BasePart") then
						blade = b
					end
				end
			end
			local at = blade and blade.Position or (p2 + Vector3.new(0, 2, 0))
			Fx.spark(at, data.unblockable and Color3.fromRGB(255, 60, 40) or Color3.fromRGB(255, 255, 230), 0.8, 4)
			if near then
				Fx.sound("ping", 0.35, data.unblockable and 0.6 or 1.6)
			end
		end)
	end
	if type(data.id) == "string" and string.sub(data.id, -1) == "G" and style then
		Fx.ult(style.id, m, data.dur)
		if near then
			shake(0.8)
		end
	end
end

function handlers.interrupt(m: Model)
	if m == myChar() then
		actSeq = -1
		actDur = 0
		buffered = nil
	end
	Anim.stop(m)
end

-- 맞힘 결과
function handlers.hit(data: any)
	local a: Model, t: Model = data.a, data.t
	local pos: Vector3 = data.pos
	local me = myChar()
	local mine = a == me
	local hurt = t == me
	local aRoot, tRoot = a and rootOf(a), t and rootOf(t)
	local dir = (aRoot and tRoot) and flat(tRoot.Position - aRoot.Position) or Vector3.new(0, 0, -1)
	local kind = data.kind
	if kind == "hit" then
		local predicted = mine and predictedAt[t] and os.clock() - predictedAt[t] < 0.6
		if not predicted then
			local hs = data.broken and 0.16 or (data.heavy and 0.1 or 0.055)
			Fx.hitstop({ a, t }, hs)
			Fx.styleHit(data.style, pos, data.heavy, dir)
			Fx.sound(data.heavy and "heavy" or "hit", data.heavy and 0.9 or 0.6, data.heavy and 0.6 or 0.9, if mine or hurt then nil else pos)
			if t and t:GetAttribute("Poise") ~= true and not data.steady then
				local side = (aRoot and tRoot) and (tRoot.CFrame.RightVector:Dot(aRoot.Position - tRoot.Position) > 0 and "flinch_r" or "flinch_l") or "flinch_l"
				local pose = data.broken and "knockdown" or (data.heavy and "hit_heavy" or side)
				Anim.play(t, pose, data.broken and 0.7 or (data.heavy and 0.5 or 0.3))
			end
		elseif data.heavy and t and t:GetAttribute("Poise") ~= true then
			Anim.play(t, data.broken and "knockdown" or "hit_heavy", data.broken and 0.7 or 0.5)
		end
		if data.counter then
			Fx.text(pos + Vector3.new(0, 5.5, 0), "카운터!", Color3.fromRGB(255, 140, 60), 38, 1)
			if mine then
				fovPunch(-5, 0.3)
				UI.flash(Color3.fromRGB(255, 200, 140), 0.18)
			end
		end
		if data.strike then
			Fx.lightning(pos + Vector3.new(math.random(-4, 4), 60, math.random(-4, 4)), pos, Color3.fromRGB(255, 245, 140), 0.7)
		end
		local col = data.crit and Color3.fromRGB(255, 220, 80) or (hurt and Color3.fromRGB(255, 90, 80) or Color3.new(1, 1, 1))
		Fx.text(pos + Vector3.new(0, 2, 0), (data.crit and "치명 " or "") .. tostring(math.floor((data.dmg or 0) + 0.5)), col, data.crit and 34 or 26)
		if data.broken then
			Fx.text(pos + Vector3.new(0, 5, 0), "파훼!", Color3.fromRGB(255, 200, 80), 40)
			Fx.ring(pos, Color3.fromRGB(255, 200, 80), 2, 18, 0.45)
			if mine or hurt then
				shake(1.6)
				UI.flash(Color3.fromRGB(255, 220, 140), 0.35)
			end
		end
		if hurt and data.steady then
			-- 전투력 차이: 맞아도 끄떡없다
			Fx.text(pos + Vector3.new(0, 4, 0), "끄떡없다", Color3.fromRGB(200, 220, 255), 24, 0.8)
			shake(0.2)
		elseif hurt then
			shake(data.heavy and 1.4 or 0.6)
			UI.flash(Color3.fromRGB(255, 40, 30), data.heavy and 0.3 or 0.12)
		elseif mine and data.heavy and not predicted then
			shake(0.9)
		end
	elseif kind == "aura" then
		-- 호신강기: 전투력 차이가 너무 커서 약한 적의 공격이 몸에 닿기도 전에 튕겨 나간다
		local ts = t and Config.STYLE_BY_ID[tostring(t:GetAttribute("Style") or "")]
		local c = ts and ts.color or Color3.fromRGB(255, 230, 160)
		Fx.hitstop({ a }, 0.08)
		if tRoot then
			Fx.ring(tRoot.Position, c, 3, 11, 0.35, dir)
			Fx.ring(tRoot.Position - Vector3.new(0, 2.5, 0), Color3.new(1, 1, 1), 2, 9, 0.3)
		end
		Fx.spark(pos, c, 1.4, 8)
		Fx.sound("deflect", 0.5, 1.5)
		Fx.text(pos + Vector3.new(0, 4, 0), "호신강기", c, 30, 0.9)
		if a then
			Anim.play(a, "parried", 0.45)
		end
	elseif kind == "block" or kind == "guardbreak" then
		Fx.hitstop({ a, t }, 0.05)
		Fx.spark(pos, Color3.fromRGB(230, 230, 255), 1, 6)
		Fx.sound("block", 0.5, 0.75)
		if t then
			Anim.play(t, "block_hit", 0.3)
		end
		if kind == "guardbreak" then
			Fx.text(pos + Vector3.new(0, 4, 0), "막기가 깨졌다!", Color3.fromRGB(255, 200, 80), 32)
			Fx.ring(pos, Color3.fromRGB(255, 200, 80), 2, 16, 0.4)
			shake(1.2)
		else
			Fx.text(pos + Vector3.new(0, 2, 0), tostring(math.floor((data.dmg or 0) + 0.5)), Color3.fromRGB(190, 190, 210), 20)
		end
		if hurt then
			shake(0.35)
		end
	elseif kind == "deflect" then
		-- 흘리기: 모든 게 아주 잠깐 멈추고, 차가운 빛이 번쩍
		Fx.hitstop({ a, t }, 0.18)
		Fx.spark(pos, Color3.fromRGB(180, 230, 255), 1.6, 12)
		Fx.ring(pos, Color3.fromRGB(200, 240, 255), 1, 10, 0.3, dir)
		Fx.sound("deflect", 0.8, 1.2 + math.random() * 0.2)
		Fx.text(pos + Vector3.new(0, 4, 0), data.counter and "되받아치기!" or "흘리기!", Color3.fromRGB(170, 230, 255), 36)
		if t and t == myChar() then
			deflectAt = os.clock()
			Fx.text(pos + Vector3.new(0, 7, 0), "지금 클릭 → 반격", Color3.fromRGB(255, 220, 120), 26, 1)
		end
		-- 흘린 쪽은 몸을 돌려 바깥으로 쓸어 내고, 친 쪽은 헛힘에 지나쳐 휘청인다
		local side = (type(data.side) == "number" and data.side < 0) and -1 or 1
		if t then
			Anim.play(t, side > 0 and "parry_r" or "parry_l", 0.6, { fadeOut = 0.2 })
			local ts = Config.STYLE_BY_ID[tostring(t:GetAttribute("Style") or "")]
			Fx.parryArc(t, side, ts and ts.color or Color3.fromRGB(190, 235, 255))
			Fx.limbTrails(t, side > 0 and "parry_r" or "parry_l", 0.5, ts and ts.color or Color3.fromRGB(190, 235, 255), Color3.new(1, 1, 1))
		end
		if a then
			Anim.play(a, "parried", Config.DEFLECT_STAGGER + 0.3, { fadeOut = 0.2 })
		end
		if mine or hurt then
			shake(0.7)
			UI.flash(Color3.fromRGB(170, 220, 255), 0.25)
			tint(Color3.fromRGB(170, 210, 255), 0.35, 0.18)
			fovPunch(-8, 0.35)
		end
	elseif kind == "clash" then
		-- 격돌: 주먹과 주먹이 부딪힌다
		Fx.hitstop({ a, t }, 0.14)
		Fx.spark(pos, Color3.fromRGB(255, 240, 200), 2.4, 16)
		Fx.ring(pos, Color3.new(1, 1, 1), 2, 16, 0.4, dir)
		Fx.ring(pos - Vector3.new(0, 2, 0), Color3.fromRGB(255, 220, 160), 2, 22, 0.5)
		Fx.sound("heavy", 1, 0.45)
		Fx.text(pos + Vector3.new(0, 5, 0), "격돌!", Color3.fromRGB(255, 240, 200), 40)
		if mine or hurt then
			shake(1.5)
			UI.flash(Color3.new(1, 1, 1), 0.35)
		end
	elseif kind == "dodge" then
		if t then
			local tt = Config.STYLE_BY_ID[tostring(t:GetAttribute("Style") or "")]
			Fx.afterimage(t, tt and tt.color or Color3.fromRGB(200, 200, 255), 0.35)
		end
		Fx.text(pos + Vector3.new(0, 3, 0), data.drunk and "취보!" or "회피", Color3.fromRGB(220, 220, 255), 26)
	end
end

function handlers.broken(m: Model, secs: number)
	Anim.play(m, "broken", secs)
	local p = modelPos(m)
	if p then
		Fx.text(p + Vector3.new(0, 5, 0), "파훼!", Color3.fromRGB(255, 200, 80), 40)
	end
	if m == myChar() then
		stunUntil = os.clock() + secs
		actSeq = -1
		actDur = 0
	end
end

function handlers.ko(m: Model, _by: Model?)
	Anim.play(m, "knockdown", 1.2)
	local p = modelPos(m)
	if p then
		Fx.dust(p - Vector3.new(0, 2, 0), 3)
		Fx.sound("fall", 0.6, 0.8, p)
	end
	if m == myChar() then
		dead = true
		actSeq = -1
		guarding = false
		UI.ko(true, Config.RESPAWN_TIME)
	end
end

function handlers.respawn()
	dead = false
	stunUntil = 0
	UI.ko(false)
end

function handlers.knock(vel: Vector3, stun: number)
	local root = myRoot()
	if root then
		push(vel, 0.12)
	end
	if stun and stun > 0 then
		stunUntil = math.max(stunUntil, os.clock() + stun)
		actSeq = -1
		actDur = 0
		buffered = nil
	end
end

function handlers.proj(data: any)
	Fx.projectile(data)
end

-- 적이 경직을 버텨 낸다 (곧 되받아친다)
function handlers.poise(m: Model)
	local r = m and m:FindFirstChild("HumanoidRootPart")
	if r and r:IsA("BasePart") then
		Fx.text(r.Position + Vector3.new(0, 5, 0), "버팀!", Color3.fromRGB(255, 160, 80), 30, 1.2)
		Fx.ring(r.Position - Vector3.new(0, 2.5, 0), Color3.fromRGB(255, 150, 70), 2, 12, 0.4)
	end
end

function handlers.dash(m: Model, kind: any)
	if m == myChar() then
		return
	end
	local pose = kind == "back" and "backflip" or (kind == "right" and "side_roll_r" or (kind == "left" and "side_roll_l" or "dash"))
	Anim.play(m, pose, kind == "front" and 0.28 or 0.4)
	local s = Config.STYLE_BY_ID[tostring(m:GetAttribute("Style") or "")]
	Fx.afterimage(m, s and s.color or Color3.new(1, 1, 1), 0.3)
end

function handlers.djump(m: Model)
	if m ~= myChar() then
		Anim.play(m, "double_jump", 0.45)
	end
end

function handlers.blink(m: Model, to: Vector3)
	local p = modelPos(m)
	if p then
		Fx.afterimage(m, Color3.fromRGB(60, 30, 100), 0.4)
	end
	Fx.ring(to - Vector3.new(0, 2.5, 0), Color3.fromRGB(150, 100, 255), 2, 10, 0.3)
	Fx.sound("swing", 0.6, 0.6, to)
end

function handlers.chain(data: any)
	local from = modelPos(data.from)
	if not from then
		return
	end
	for _, m in ipairs(data.to or {}) do
		local p = modelPos(m)
		if p then
			Fx.lightning(from, p, Color3.fromRGB(255, 245, 140), 0.45)
		end
	end
	Fx.text(from + Vector3.new(0, 5, 0), "⚡ 연쇄 번개!", Color3.fromRGB(255, 245, 140), 30)
end

function handlers.bloom(m: Model, radius: number)
	local p = modelPos(m)
	if p then
		Fx.bloom(p - Vector3.new(0, 2, 0), radius)
		Fx.text(p + Vector3.new(0, 5, 0), "🌸 만개!", Color3.fromRGB(255, 150, 200), 36)
		if m == myChar() then
			shake(1)
		end
	end
end

function handlers.heal(m: Model)
	local p = modelPos(m)
	if p then
		Fx.spark(p, Color3.fromRGB(120, 255, 140), 1.2, 8)
		Fx.text(p + Vector3.new(0, 3, 0), "+ 회복", Color3.fromRGB(120, 255, 140), 24)
	end
end

function handlers.trainPose(m: Model, kind: string?)
	if kind == "waterfall" or kind == "breathing" then
		Anim.setLoop(m, "meditate", 2)
	elseif kind == "mabo" then
		Anim.setLoop(m, "horse_stance", 2.4)
	elseif kind == "ironpalm" then
		Anim.setLoop(m, "palm_strike", 1.0)
	elseif kind == "rock" then
		Anim.setLoop(m, "lift", 1.4)
	else
		Anim.setLoop(m, nil)
	end
end

function handlers.train(data: any)
	if data then
		training = data.kind
		UI.trainStart(data.kind, data.rings, function(grade: string, idx: number?)
			Request:FireServer("trainHit", grade, idx)
		end, data.hard == true)
	else
		training = nil
		UI.trainStop()
	end
end

function handlers.trained(data: any)
	UI.trainResult(data)
	if data.gain > 0 then
		Fx.sound("ping", 0.4, data.grade == "perfect" and 1.8 or 1.3)
		local root = myRoot()
		if root and data.grade == "perfect" then
			local s = myStyle()
			Fx.ring(root.Position - Vector3.new(0, 2.5, 0), s and s.color or Color3.fromRGB(255, 220, 120), 2, 10, 0.4)
		end
	end
end

function handlers.learned(data: any)
	local s = Config.STYLE_BY_ID[data.style]
	if s then
		if data.hidden then
			-- 숨은 권법: 하늘이 갈라진다
			UI.cinematic("🔓 " .. s.name, s.color, 2.6)
			UI.banner("🔓 숨겨진 권법 " .. s.icon .. " " .. s.name, string.format("[%s] %s", s.grade, s.hanja), s.color)
			local char = myChar()
			if char then
				Fx.ult(s.id, char, 1.8)
			end
			shake(1.4)
			Fx.sound("ping", 1, 0.6)
		else
			UI.banner(s.icon .. " " .. s.name .. " 입문!", string.format("[%s] %s · 권법 창에서 바꿔 쓸 수 있다", s.grade, s.hanja), s.color)
		end
		UI.closeWindow()
		UI.setGuide(nil)
	end
end

-- 권법 승급 (깨달음)
function handlers.breakthrough(data: any)
	local s = Config.STYLE_BY_ID[data.style]
	if not s then
		return
	end
	UI.cinematic("⬆ " .. s.name .. " · " .. data.step, s.color, 2.2)
	UI.banner("⬆ " .. data.step .. "!", string.format("%s 등급이 [%s]로 올랐다", s.name, data.grade), Config.GRADE_COLOR[data.grade] or s.color)
	local char = myChar()
	if char then
		Fx.ult(s.id, char, 1.6)
	end
	shake(1.2)
	Fx.sound("ping", 1, 0.7)
end

-- 권법마다 다른 기술 장치의 연출
function handlers.skillfx(data: any)
	Fx.mech(data)
	if data.kind == "drop" or data.kind == "beam" or data.kind == "freeze" then
		local r = myRoot()
		if r and data.at and (r.Position - data.at).Magnitude < 60 then
			shake(data.kind == "freeze" and 0.6 or 1.3)
		end
	end
end

-- 개천신권: 별이 떨어진다
function handlers.star(data: any)
	Fx.starfall(data.at, data.style)
end

-- 이야기
function handlers.dialog(data: any)
	UI.dialog(data)
	Fx.sound("ping", 0.4, 1.2)
end

function handlers.storyDone(data: any)
	local parts = {}
	if data.coins and data.coins > 0 then
		table.insert(parts, "💰 +" .. Config.formatNumber(data.coins))
	end
	if data.stats and data.stats > 0 then
		table.insert(parts, string.format("모든 능력치 +%d", data.stats))
	end
	UI.banner("📜 " .. data.title .. " 완료", table.concat(parts, "  ") .. (data.next and ("  ·  다음: " .. data.next) or ""), Color3.fromRGB(255, 200, 110))
	Fx.sound("ping", 0.8, 1)
end

function handlers.storyProg(data: any)
	if state then
		state.prog = data.prog
		UI.refreshWorld(state)
	end
end

function handlers.found(data: any)
	local s = Config.STYLE_BY_ID[data.style]
	UI.banner("🏯 사부를 찾았다: " .. data.master, (s and (s.icon .. " " .. s.name .. "의 주인 · ") or "") .. data.region .. " · 하늘로 빛기둥이 솟았다", s and s.color or nil)
	Fx.sound("ping", 0.7, 0.9)
end

function handlers.fragment(data: any)
	UI.banner(string.format("📖 비급 조각 %d / %d", data.n, data.total), data.n >= data.total and "조각이 하나로 모였다..." or "옛 고수의 글씨가 희미하게 빛난다", Color3.fromRGB(255, 230, 160))
	Fx.sound("ping", 0.8, 1.1)
end

function handlers.trialWin(data: any)
	local s = Config.STYLE_BY_ID[data.style]
	UI.cinematic("⚔ 시험 통과", s and s.color or Color3.fromRGB(255, 220, 120), 1.6)
	UI.banner("⚔ " .. data.master .. "의 시험 통과!", "사부 곁에서 T를 눌러 " .. (s and s.name or "") .. "을(를) 배워라", s and s.color or nil)
end

function handlers.mastery(data: any)
	local s = Config.STYLE_BY_ID[data.style]
	if data.awaken and s then
		-- 각성! 하늘로 빛이 솟고 화면이 갈라진다
		local a = Config.AWAKEN[data.awaken]
		UI.cinematic(a.mark .. " " .. s.name .. " " .. a.name, s.color, 2.2)
		UI.banner(a.mark .. " " .. a.name .. "!", data.awaken == 1 and "기술이 세지고, 연타 다섯 번째 '" .. s.finisher.name .. "'가 열렸다" or "모든 기술이 세지고, 그림자 메아리가 기술을 한 번 더 되풀이한다", s.color)
		local char = myChar()
		if char then
			Fx.ult(s.id, char, 1.6)
		end
		shake(1.2)
		Fx.sound("ping", 0.9, 0.8)
		return
	end
	UI.banner(string.format("%s 숙련 %d", s and s.name or "", data.lv), data.unlocked and ("새 기술: " .. data.unlocked) or nil, s and s.color or nil)
	Fx.sound("ping", 0.6, 1.5)
end

-- 완전 각성: 그림자 메아리가 같은 기술을 되풀이한다
function handlers.echo(data: any)
	local m = data.m
	if m and m.Parent then
		Fx.echo(m, data.style, data.slot, data.dur)
	end
end

-- 見切り: 맞기 직전에 피했다 (시간이 멈춘 듯)
function handlers.pdodge(data: any)
	local m, a = data.m, data.a
	local r = m and rootOf(m)
	if r then
		Fx.text(r.Position + Vector3.new(0, 5, 0), "간파!", Color3.fromRGB(180, 230, 255), 38, 1.2)
		Fx.ring(r.Position - Vector3.new(0, 2.5, 0), Color3.fromRGB(180, 230, 255), 2, 18, 0.5)
		Fx.afterimage(m, Color3.fromRGB(180, 230, 255), 0.5)
	end
	if a then
		Fx.hitstop({ a }, 0.35)
	end
	if m == myChar() then
		deflectAt = os.clock()
		fovPunch(-10, 0.5)
		tint(Color3.fromRGB(160, 200, 255), 0.4, 0.45)
		UI.flash(Color3.fromRGB(200, 230, 255), 0.2)
		Fx.sound("deflect", 0.8, 0.7)
	end
end

function handlers.reward(data: any)
	UI.toast(string.format("%s 쓰러뜨림  💰 +%d  숙련 +%d", data.name, data.coins, data.xp))
	if data.boss then
		UI.banner("🏆 " .. data.name .. " 격파!", string.format("💰 +%d", data.coins), Color3.fromRGB(255, 210, 120))
	end
end

function handlers.boss(m: Model?)
	UI.setBoss(m)
end

function handlers.bossPhase(m: Model, name: string, phase: number?)
	local ph = phase or 2
	UI.cinematic("👹 " .. name .. " · " .. ph .. "단계", Color3.fromRGB(255, 60, 40), 1.6)
	UI.banner("👹 " .. name .. " · " .. ph .. "단계", ph >= 3 and "마지막 발악! 모든 패턴을 쓴다" or "분노했다! 빨라지고 새 패턴이 열린다", Color3.fromRGB(255, 80, 60))
	local r = m and rootOf(m)
	if r then
		Fx.ring(r.Position - Vector3.new(0, 2.5, 0), Color3.fromRGB(255, 60, 40), 4, 60, 0.7)
		Fx.afterimage(m, Color3.fromRGB(255, 40, 30), 0.8)
	end
	shake(1.4)
	UI.bossPhase(ph)
end

-- 보스가 패턴 이름을 외친다
function handlers.bossCall(data: any)
	local r = data.m and rootOf(data.m)
	if r then
		local scale = tonumber(data.m:GetAttribute("Scale")) or 2
		Fx.text(r.Position + Vector3.new(0, 6 + scale * 2, 0), "⚠ " .. data.name, Color3.fromRGB(255, 120, 90), 36, 1.2)
	end
end

function handlers.afterimage(m: Model)
	if m and m.Parent then
		Fx.afterimage(m, Color3.fromRGB(255, 50, 40), 0.5)
	end
end

function handlers.duel(data: any)
	UI.toast(string.format("⚔ 비무대: %s 승, %s 패", data.winner, data.loser))
end

function handlers.realm(data: any)
	UI.banner(string.format("✨ %s, %s의 경지에 오르다", data.name, data.realm), nil, Color3.fromRGB(255, 220, 140))
end

Push.OnClientEvent:Connect(function(kind: string, ...)
	local f = handlers[kind]
	if f then
		local ok, err = pcall(f, ...)
		if not ok then
			warn("[권왕] 화면 처리 오류:", kind, err)
		end
	end
end)

------------------------------------------------------------------------
-- 매 순간 화면 (막대, 기술 칸)
------------------------------------------------------------------------
RunService.RenderStepped:Connect(function()
	local char = myChar()
	if not char then
		return
	end
	local hp = char:GetAttribute("Hp")
	local mx = char:GetAttribute("MaxHp")
	local po = char:GetAttribute("Posture")
	local pm = char:GetAttribute("PostureMax")
	local chi = char:GetAttribute("Chi")
	if type(hp) == "number" and type(mx) == "number" then
		local cmax = char:GetAttribute("ChiMax")
		UI.bars(hp, mx, type(po) == "number" and po or 0, type(pm) == "number" and pm or 100, type(chi) == "number" and chi or 0, type(cmax) == "number" and cmax or Config.CHI_MAX)
	end
	local style = myStyle()
	if not style then
		UI.styleLine("🥋 권법이 없다", Color3.fromRGB(230, 220, 200), "")
		return
	end
	local now = os.clock()
	local info: { [string]: any } = {
		M1 = { name = style.combo[1].name },
		H = { name = style.heavy.name },
		Q = { name = "대시", cd = math.max(0, (dashAt + (style.dashCd or Config.DASH_CD) - now) / (style.dashCd or Config.DASH_CD)) },
		F = { name = guarding and "막는 중" or "막기·흘리기" },
		P = { name = string.format("금창약 %d", state and state.potions or 0) },
	}
	for _, slot in ipairs({ "E", "R", "G" }) do
		local sk = style.skills[slot]
		local left = (cds[slot] or 0) - now
		info[slot] = { name = sk.name, locked = not unlocked(slot), cd = left > 0 and left / (cdLen[slot] or 1) or (slot == "G" and type(chi) == "number" and chi < 100 and 1 - chi / 100 or 0) }
	end
	UI.slots(info)
	-- 권법 장치 표시
	local stacks = ""
	if style.id == "taeheo" then
		stacks = "기류 " .. string.rep("●", tonumber(char:GetAttribute("Flow")) or 0) .. string.rep("○", 3 - (tonumber(char:GetAttribute("Flow")) or 0))
	elseif style.id == "maehwa" then
		local n = tonumber(char:GetAttribute("Petal")) or 0
		stacks = n >= 20 and "🌸 만개 준비! (Z)" or string.format("꽃잎 %d / 20", n)
	elseif style.id == "byeokryeok" then
		local n = tonumber(char:GetAttribute("Charge")) or 0
		stacks = "전하 " .. string.rep("⚡", n) .. string.rep("·", 5 - n)
	elseif style.id == "cheonryong" and chargeStart then
		stacks = string.format("용기 모으는 중 %d%%", math.floor(math.clamp((now - chargeStart) / (style.charge or 1.5), 0, 1) * 100))
	end
	local buff = char:GetAttribute("Buff")
	if buff == "ironshirt" then
		stacks ..= "  🔔 철포삼"
	elseif buff == "sway" then
		stacks ..= "  🍶 취보"
	end
	local tierNow = tonumber(char:GetAttribute("Awaken")) or 0
	if perfectChain >= 2 then
		stacks ..= string.format("  정타 ×%d", perfectChain)
	end
	if comboBroken then
		stacks ..= "  (흐트러짐)"
	end
	UI.styleLine((tierNow > 0 and (Config.AWAKEN[tierNow].mark .. " ") or "") .. style.icon .. " " .. style.name, style.color, stacks)
end)

-- 몸동작 점검: 내 몸의 관절을 몇 개 붙잡았는지 (못 붙잡으면 동작이 안 보인다)
task.delay(6, function()
	local char = player.Character
	if char then
		local n = Anim.jointCount(char)
		print(string.format("[권왕] 몸동작 관절 %d / 11개 연결", n))
		if n < 8 then
			UI.toast(string.format("⚠ 몸동작 관절을 %d개만 찾았어요. 동작이 제대로 안 보일 수 있어요", n))
		end
	end
end)

Request:FireServer("hello")
]]></string>
        </Properties>
        <Item class="ModuleScript" referent="14">
          <Properties>
            <string name="Name">Anim</string>
            <string name="Source"><![CDATA[-- 권왕: 관절을 직접 움직이는 몸동작 (모든 화면에서, 모든 무인에게)
-- 로블록스 기본 걷기 동작 위에 권법 자세를 얹고, 기술을 쓰면 온몸을 그 동작으로 덮는다
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage:WaitForChild("Config"))
local Poses = require(ReplicatedStorage:WaitForChild("Poses"))

local Anim = {}

type Track = {
	pose: string,
	keys: { any },
	start: number,
	dur: number,
	align: number?,
	alignFrac: number,
	paused: number, -- 멈춘 시간의 합 (히트스톱)
	freezeUntil: number,
	loop: boolean,
	fadeOut: number,
	weight: number,
}

type Rec = {
	model: Model,
	motors: { [string]: any }, -- Motor6D 또는 AnimationConstraint (둘 다 Transform이 있다)
	track: Track?,
	loop: Track?,
	walk: number,
	npc: boolean,
	guardW: number,
	stanceW: number,
	sprintW: number,
	moveW: number,
	airW: number,
	breath: number,
	idleT: number,
	idleNext: number,
	lastActAt: number,
	lastT: number,
	written: { [string]: CFrame }, -- 지난번에 내가 쓴 값 (기본 동작이 안 건드린 관절을 알아보려고)
}

local recs: { [Model]: Rec } = {}
local RAD = math.pi / 180
local ZERO3 = { 0, 0, 0 }
local ZERO6 = { 0, 0, 0, 0, 0, 0 }

------------------------------------------------------------------------
-- 키프레임 다듬기: 빠진 관절은 그 무인의 기본 자세로 채운다
------------------------------------------------------------------------
local filledCache: { [string]: { any } } = {}

local function basePose(stance: string?): { [string]: { number } }
	local base: { [string]: { number } } = {}
	for name in pairs(Poses.MOTORS) do
		base[name] = name == "R" and ZERO6 or ZERO3
	end
	if stance then
		local st = Poses.stances[stance]
		if st then
			for k, v in pairs(st) do
				base[k] = v
			end
		end
		local legs = Poses.stanceLegs[stance] or Poses.stanceLegs.default
		for k, v in pairs(legs) do
			base[k] = v
		end
	end
	return base
end

local function filled(pose: string, stance: string?): { any }?
	local key = pose .. "|" .. (stance or "")
	local cached = filledCache[key]
	if cached then
		return cached
	end
	local raw = Poses.anims[pose]
	if not raw then
		return nil
	end
	local base = basePose(stance)
	local out = {}
	for _, k in ipairs(raw) do
		local j = {}
		for name in pairs(Poses.MOTORS) do
			local v = k.j[name] or base[name]
			if name == "R" then
				j[name] = { v[1] or 0, v[2] or 0, v[3] or 0, v[4] or 0, v[5] or 0, v[6] or 0 }
			else
				j[name] = { v[1] or 0, v[2] or 0, v[3] or 0 }
			end
		end
		table.insert(out, { t = k.t, e = k.e, j = j })
	end
	filledCache[key] = out
	return out
end

local function firstSnap(keys: { any }): number
	for _, k in ipairs(keys) do
		if k.e == "snap" and k.t > 0 then
			return k.t
		end
	end
	return 0.4
end

local function ease(u: number, kind: string?): number
	if kind == "snap" then
		return 1 - (1 - u) ^ 3
	end
	return u * u * (3 - 2 * u)
end

-- 비율 p(0~1)에서의 관절 값
local function sample(keys: { any }, p: number): { [string]: { number } }
	if p <= keys[1].t or #keys == 1 then
		return keys[1].j
	end
	for i = 2, #keys do
		local b = keys[i]
		if p <= b.t then
			local a = keys[i - 1]
			local u = ease((p - a.t) / math.max(1e-4, b.t - a.t), b.e)
			local out = {}
			for name, va in pairs(a.j) do
				local vb = b.j[name]
				local v = {}
				for n = 1, #va do
					v[n] = va[n] + (vb[n] - va[n]) * u
				end
				out[name] = v
			end
			return out
		end
	end
	return keys[#keys].j
end

local function toCF(name: string, v: { number }): CFrame
	local rot = CFrame.fromEulerAnglesYXZ(v[1] * RAD, v[2] * RAD, v[3] * RAD)
	if name == "R" then
		return CFrame.new(v[4], v[5], v[6]) * rot
	end
	return rot
end

------------------------------------------------------------------------
-- 무인 등록
------------------------------------------------------------------------
-- 관절 찾기: 예전 몸은 Motor6D, 새 로블록스 몸(아바타 관절 업그레이드)은 AnimationConstraint.
-- 둘 다 Transform으로 움직이므로 이름만 맞으면 어느 쪽이든 쓴다
local function isJoint(x: Instance?): boolean
	return x ~= nil and (x:IsA("Motor6D") or x:IsA("AnimationConstraint"))
end
local function motorsOf(model: Model): { [string]: any }
	local m = {}
	for name, info in pairs(Poses.MOTORS) do
		local p = model:FindFirstChild(info[1])
		local motor = p and p:FindFirstChild(info[2])
		if not isJoint(motor) then
			-- 다른 곳에 붙어 있을 수도 있다 (몸 전체에서 같은 이름의 관절)
			motor = nil
			for _, d in ipairs(model:GetDescendants()) do
				if d.Name == info[2] and isJoint(d) then
					motor = d
					break
				end
			end
		end
		if motor then
			m[name] = motor
		end
	end
	return m
end

-- 몸동작이 붙은 관절 수 (화면 점검용)
function Anim.jointCount(model: Model): number
	local n = 0
	for _ in pairs(motorsOf(model)) do
		n += 1
	end
	return n
end

function Anim.watch(model: Model)
	if recs[model] then
		return
	end
	local motors = motorsOf(model)
	if not motors.R or not motors.W then
		-- 아직 몸이 다 안 들어왔다
		task.delay(0.5, function()
			if model.Parent and not recs[model] then
				Anim.watch(model)
			end
		end)
		return
	end
	recs[model] = {
		model = model,
		motors = motors,
		track = nil,
		loop = nil,
		walk = 0,
		npc = model:GetAttribute("NPC") == true,
		guardW = 0,
		stanceW = 0,
		sprintW = 0,
		moveW = 0,
		airW = 0,
		breath = math.random() * 6,
		idleT = 0,
		idleNext = 3 + math.random() * 4,
		lastActAt = 0,
		lastT = os.clock(),
		written = {},
	}
	-- 하늘로 띄워지면 허우적대며 한 바퀴
	model:GetAttributeChangedSignal("LaunchedAt"):Connect(function()
		Anim.play(model, "launched", 0.9)
	end)
end

local function stanceOf(model: Model): string?
	local weapon = model:GetAttribute("Weapon")
	if type(weapon) == "string" then
		return weapon == "spear" and "stance_spear" or "stance_weapon"
	end
	local styleId = model:GetAttribute("Style")
	local style = type(styleId) == "string" and Config.STYLE_BY_ID[styleId]
	return style and style.stance or nil
end

-- 기술 동작 재생. align = 첫 '꽂히는' 순간을 이 초에 맞춘다
function Anim.play(model: Model, pose: string, dur: number, opt: any?)
	Anim.watch(model)
	local rec = recs[model]
	if not rec then
		return
	end
	local keys = filled(pose, stanceOf(model))
	if not keys then
		return
	end
	local o = opt or {}
	if not o.idle then
		rec.lastActAt = os.clock()
	end
	rec.track = {
		pose = pose,
		keys = keys,
		start = os.clock(),
		dur = math.max(0.05, dur),
		align = o.align,
		alignFrac = firstSnap(keys),
		paused = 0,
		freezeUntil = 0,
		loop = false,
		fadeOut = o.fadeOut or 0.12,
		weight = 0,
	}
end

function Anim.stop(model: Model)
	local rec = recs[model]
	if rec then
		rec.track = nil
	end
end

-- 계속 되풀이하는 동작 (명상, 바위 들기). nil이면 끈다
function Anim.setLoop(model: Model, pose: string?, dur: number?)
	Anim.watch(model)
	local rec = recs[model]
	if not rec then
		return
	end
	if not pose then
		rec.loop = nil
		return
	end
	local keys = filled(pose :: string, stanceOf(model))
	if not keys then
		return
	end
	rec.loop = { pose = pose, keys = keys, start = os.clock(), dur = dur or 1.2, align = nil, alignFrac = 0.4, paused = 0, freezeUntil = 0, loop = true, fadeOut = 0, weight = 1 }
end

-- 히트스톱: 잠깐 동작이 멈춘다
function Anim.freeze(model: Model, secs: number)
	local rec = recs[model]
	local tr = rec and rec.track
	if tr then
		tr.freezeUntil = math.max(tr.freezeUntil, os.clock() + secs)
	end
end

function Anim.playing(model: Model): string?
	local rec = recs[model]
	local tr = rec and rec.track
	if tr and os.clock() - tr.start - tr.paused < tr.dur then
		return tr.pose
	end
	return nil
end

------------------------------------------------------------------------
-- 매 순간 (물리 계산 직전: 기본 걷기 동작이 들어간 뒤)
------------------------------------------------------------------------
local function trackPose(tr: Track, t: number, dt: number): ({ [string]: { number } }?, number)
	if t < tr.freezeUntil then
		tr.paused += dt
	end
	local elapsed = t - tr.start - tr.paused
	if tr.loop then
		local p = (elapsed / tr.dur) % 1
		return sample(tr.keys, p), 1
	end
	if elapsed >= tr.dur then
		return nil, 0
	end
	local p
	local a = tr.align
	if a and a > 0 and a < tr.dur then
		if elapsed < a then
			p = elapsed / a * tr.alignFrac
		else
			p = tr.alignFrac + (elapsed - a) / (tr.dur - a) * (1 - tr.alignFrac)
		end
	else
		p = elapsed / tr.dur
	end
	-- 처음엔 재빨리 들어오고, 끝에서 자세로 녹아 돌아간다
	local w = math.min(1, elapsed / 0.05)
	local left = tr.dur - elapsed
	if left < tr.fadeOut then
		w = math.min(w, left / tr.fadeOut)
	end
	return sample(tr.keys, math.clamp(p, 0, 1)), w
end

-- 기본 몸놀림 (사람·적 모두): 가만히 = 가볍게 들썩이는 무인의 호흡, 움직이면 = 걷기·달리기·옆걸음·뒷걸음,
-- 공중 = 오를 땐 무릎을 당기고 내려올 땐 다리를 편다. 관절마다 { X, Y, Z (도), 위치 } 값을 돌려준다
local IDLE: { [string]: { number } } = {
	R = { -2, 0, 0, 0, -0.05, 0 }, W = { 3, 0, 0 }, N = { -3, 0, 0 },
	RS = { 4, 0, 7 }, LS = { 4, 0, -7 }, RE = { 14, 0, 0 }, LE = { 14, 0, 0 },
	RH = { 3, 0, 2 }, LH = { 3, 0, -2 }, RK = { -6, 0, 0 }, LK = { -6, 0, 0 },
}
local function moveJ(name: string, s: number, c: number, f: number, sd: number, amt: number): { number }
	local stride = 40 * amt
	if name == "R" then
		local lean = -(4 + 8 * amt) * math.max(f, 0) + 6 * math.max(-f, 0)
		return { lean, s * 6 * amt * f, s * 2.5 * amt - sd * 6 * amt, 0, -0.12 + math.abs(c) * 0.24 * amt, 0 }
	elseif name == "W" then
		return { 3 * amt, -s * 10 * amt * f, 0 }
	elseif name == "N" then
		return { -3 * amt, s * 6 * amt * f, sd * 4 }
	elseif name == "RS" then
		return { -s * 44 * amt * f, 0, 9 + math.abs(sd) * 8 }
	elseif name == "LS" then
		return { s * 44 * amt * f, 0, -9 - math.abs(sd) * 8 }
	elseif name == "RE" then
		return { 25 + 40 * amt, 0, 0 }
	elseif name == "LE" then
		return { 25 + 40 * amt, 0, 0 }
	elseif name == "RH" then
		return { s * stride * f, 0, -s * 18 * sd * amt + 3 }
	elseif name == "LH" then
		return { -s * stride * f, 0, s * 18 * sd * amt - 3 }
	elseif name == "RK" then
		return { -(8 + 62 * math.max(0, c)) * amt, 0, 0 }
	elseif name == "LK" then
		return { -(8 + 62 * math.max(0, -c)) * amt, 0, 0 }
	end
	return ZERO3
end
local AIR_UP: { [string]: { number } } = {
	R = { 6, 0, 0, 0, 0.2, 0 }, W = { -4, 0, 0 }, N = { 4, 0, 0 },
	RS = { 40, 0, 35 }, LS = { 40, 0, -35 }, RE = { 50, 0, 0 }, LE = { 50, 0, 0 },
	RH = { 60, 0, 6 }, LH = { 22, 0, -6 }, RK = { -85, 0, 0 }, LK = { -40, 0, 0 },
}
local AIR_DOWN: { [string]: { number } } = {
	R = { -6, 0, 0, 0, 0, 0 }, W = { 6, 0, 0 }, N = { -6, 0, 0 },
	RS = { 20, 0, 50 }, LS = { 20, 0, -50 }, RE = { 30, 0, 0 }, LE = { 30, 0, 0 },
	RH = { 22, 0, 8 }, LH = { -8, 0, -8 }, RK = { -30, 0, 0 }, LK = { -18, 0, 0 },
}

local IDLE_HAND = { { "idle_shadow", 1.0 }, { "idle_stretch", 1.6 }, { "idle_crack", 1.4 }, { "idle_shift", 0.9 }, { "idle_look", 1.6 } }
local IDLE_WEAPON = { { "idle_weapon", 1.6 }, { "idle_look", 1.6 } }

local function step(dt: number)
	local t = os.clock()
	for model, rec in pairs(recs) do
		if not model.Parent then
			recs[model] = nil
			continue
		end
		local root = model:FindFirstChild("HumanoidRootPart")
		if not root or not root:IsA("BasePart") then
			continue
		end
		local motors = rec.motors
		local stance = stanceOf(model)
		local vel = root.AssemblyLinearVelocity
		local flatVel = Vector3.new(vel.X, 0, vel.Z)
		local flatSpeed = flatVel.Magnitude
		local moving = flatSpeed > 2
		local hum = model:FindFirstChildOfClass("Humanoid")
		local inAir = (hum and hum.FloorMaterial == Enum.Material.Air) or math.abs(vel.Y) > 8
		local airborne = inAir and math.abs(vel.Y) > 3
		local dead = model:GetAttribute("Dead") == true
		local guarding = model:GetAttribute("Guard") == true

		-- 1) 기술 동작
		local actPose, actW = nil, 0
		local tr = rec.track
		if tr then
			actPose, actW = trackPose(tr, t, dt)
			if not actPose then
				rec.track = nil
			end
		end
		if dead and not actPose then
			-- 쓰러져 있다
			local keys = filled("knockdown", stance)
			if keys then
				actPose, actW = sample(keys, 0.5), 1
			end
		end
		-- 2) 되풀이 동작 (수련)
		local loopPose = nil
		if rec.loop and not actPose then
			loopPose = trackPose(rec.loop, t, dt)
		end

		-- 3) 기본 몸놀림의 무게 (부드럽게 넘어간다)
		local k = math.min(1, dt * 10)
		rec.moveW += (((moving and not airborne) and 1 or 0) - rec.moveW) * k
		rec.airW += ((airborne and 1 or 0) - rec.airW) * math.min(1, dt * 8)
		local amt = math.clamp(flatSpeed / 16, 0, 1.5)
		if moving then
			rec.walk += dt * (5 + flatSpeed * 0.45)
		end
		rec.breath += dt * (guarding and 3.2 or 2.3)
		local s, c = math.sin(rec.walk), math.cos(rec.walk)
		local local3 = root.CFrame:VectorToObjectSpace(flatVel)
		local f = moving and math.clamp(-local3.Z / flatSpeed, -1, 1) or 1
		local sd = moving and math.clamp(local3.X / flatSpeed, -1, 1) or 0
		local b = math.sin(rec.breath)
		local still = (1 - rec.moveW) * (1 - rec.airW)

		-- 4) 권법 자세, 막기, 달리기
		local guardTarget = (guarding and not actPose) and 1 or 0
		rec.guardW += (guardTarget - rec.guardW) * math.min(1, dt * 18)
		local stanceTarget = (stance and not dead) and 1 or 0
		rec.stanceW += (stanceTarget - rec.stanceW) * math.min(1, dt * 8)
		local stanceJ = stance and Poses.stances[stance]
		local legsJ = stance and (Poses.stanceLegs[stance] or Poses.stanceLegs.default)
		local blockJ = filled("block", stance)
		local blockPose = blockJ and blockJ[1].j
		local sprintTarget = (model:GetAttribute("Sprint") == true and moving and not actPose and not guarding and not dead) and 1 or 0
		rec.sprintW += (sprintTarget - rec.sprintW) * math.min(1, dt * 10)
		local sprintJ = Poses.anims.sprint_upper and Poses.anims.sprint_upper[1].j
		local airJ = vel.Y > 0 and AIR_UP or AIR_DOWN

		-- 가만히 서 있으면 가끔 몸짓 (그림자 주먹, 기지개, 손 풀기, 자세 바꾸기, 둘러보기)
		if still > 0.9 and not actPose and not loopPose and not guarding and not dead and t - rec.lastActAt > 4 and model:GetAttribute("Master") ~= true then
			rec.idleT += dt
			if rec.idleT > rec.idleNext then
				rec.idleT = 0
				rec.idleNext = 4 + math.random() * 5
				local ok = true
				if rec.npc then
					-- 적은 곁에 사람이 없을 때만 (싸우다 딴청 부리지 않게)
					local me = Players.LocalPlayer.Character
					local mr = me and me:FindFirstChild("HumanoidRootPart")
					ok = not (mr and mr:IsA("BasePart") and (mr.Position - root.Position).Magnitude < 30)
				end
				if ok then
					local list = model:GetAttribute("Weapon") and IDLE_WEAPON or IDLE_HAND
					local pick = list[math.random(1, #list)]
					Anim.play(model, pick[1], pick[2], { idle = true, fadeOut = 0.25 })
				end
			end
		else
			rec.idleT = 0
		end

		for name, motor in pairs(motors) do
			-- 기본 몸놀림 층: 가만히 → 걷기 → 공중
			local out = toCF(name, IDLE[name] or (name == "R" and ZERO6 or ZERO3))
			if rec.moveW > 0.01 then
				out = out:Lerp(toCF(name, moveJ(name, s, c, f, sd, amt)), rec.moveW)
			end
			if rec.airW > 0.01 then
				out = out:Lerp(toCF(name, airJ[name] or (name == "R" and ZERO6 or ZERO3)), rec.airW)
			end
			-- 권법 자세 (윗몸은 늘, 움직일 땐 팔이 조금 풀린다 / 다리는 서 있을 때만)
			if rec.stanceW > 0.01 and stanceJ then
				local sv = stanceJ[name]
				if Poses.UPPER[name] and sv then
					out = out:Lerp(toCF(name, sv), rec.stanceW * (1 - 0.4 * rec.moveW) * (1 - 0.5 * rec.airW))
				elseif legsJ and legsJ[name] and still > 0.01 then
					out = out:Lerp(toCF(name, legsJ[name]), rec.stanceW * 0.9 * still)
				end
			end
			-- 숨: 서 있을 땐 가볍게 들썩인다 (무릎과 어깨가 함께)
			if still > 0.01 and not actPose then
				if name == "R" then
					out = CFrame.new(0, b * 0.07 * still, 0) * out
				elseif name == "RK" or name == "LK" then
					out = out * CFrame.Angles(-b * 4 * RAD * still, 0, 0)
				elseif name == "W" then
					out = out * CFrame.Angles(b * 1.6 * RAD * still, 0, 0)
				elseif name == "N" then
					out = out * CFrame.Angles(-b * 1.2 * RAD * still, 0, 0)
				elseif name == "RS" or name == "LS" then
					out = out * CFrame.Angles(b * 2.5 * RAD * still, 0, (name == "RS" and 1 or -1) * b * 1.5 * RAD * still)
				end
			end
			if rec.sprintW > 0.01 and sprintJ and sprintJ[name] and (Poses.UPPER[name] or name == "R") then
				out = out:Lerp(toCF(name, sprintJ[name]), rec.sprintW * (name == "R" and 0.6 or 1))
			end
			if rec.guardW > 0.01 and blockPose and (Poses.UPPER[name] or (name == "R" and not moving)) then
				out = out:Lerp(toCF(name, blockPose[name]), rec.guardW)
			end
			if loopPose then
				out = toCF(name, loopPose[name])
			end
			if actPose and actW > 0 then
				out = out:Lerp(toCF(name, actPose[name]), actW)
			end
			motor.Transform = out
			rec.written[name] = out
		end
	end
end

function Anim.start()
	RunService.Stepped:Connect(function(_time: number, dt: number)
		local ok, err = pcall(step, dt)
		if not ok then
			warn("[권왕] 몸동작 오류:", err)
		end
	end)
end

return Anim
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="15">
          <Properties>
            <string name="Name">Fx</string>
            <string name="Source"><![CDATA[-- 권왕: 타격감 (불꽃, 충격파, 잔상, 숫자, 권법마다 다른 빛)
local Debris = game:GetService("Debris")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local SoundService = game:GetService("SoundService")
local TweenService = game:GetService("TweenService")

local Config = require(ReplicatedStorage:WaitForChild("Config"))
local Poses = require(ReplicatedStorage:WaitForChild("Poses"))

local Fx = {}

local folder = Instance.new("Folder")
folder.Name = "KwonFx"
folder.Parent = workspace

------------------------------------------------------------------------
-- 소리 (로블록스에 들어 있는 기본 소리. 더 좋은 소리 번호가 있으면 여기만 바꾸면 된다)
------------------------------------------------------------------------
local SOUNDS = {
	swing = "rbxasset://sounds/swordlunge.wav",
	hit = "rbxasset://sounds/action_jump_land.mp3",
	heavy = "rbxasset://sounds/action_jump_land.mp3",
	block = "rbxasset://sounds/swordslash.wav",
	deflect = "rbxasset://sounds/unsheath.wav",
	ping = "rbxasset://sounds/electronicpingshort.wav",
	fall = "rbxasset://sounds/action_falling.mp3",
	jump = "rbxasset://sounds/action_jump.mp3",
	splash = "rbxasset://sounds/impact_water.mp3",
}

function Fx.sound(name: string, volume: number?, pitch: number?, at: Vector3?)
	local id = SOUNDS[name]
	if not id then
		return
	end
	local s = Instance.new("Sound")
	s.SoundId = id
	s.Volume = volume or 0.5
	s.PlaybackSpeed = pitch or 1
	if at then
		local a = Instance.new("Part")
		a.Anchored = true
		a.CanCollide = false
		a.CanQuery = false
		a.Transparency = 1
		a.Size = Vector3.new(0.2, 0.2, 0.2)
		a.Position = at
		a.Parent = folder
		s.RollOffMaxDistance = 160
		s.Parent = a
		Debris:AddItem(a, 3)
	else
		s.Parent = SoundService
		Debris:AddItem(s, 3)
	end
	s:Play()
end

------------------------------------------------------------------------
-- 기본 조각
------------------------------------------------------------------------
local function piece(size: Vector3, color: Color3, material: Enum.Material?, shape: Enum.PartType?, transparency: number?): Part
	local p = Instance.new("Part")
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	p.Size = size
	p.Color = color
	p.Material = material or Enum.Material.Neon
	if shape then
		p.Shape = shape
	end
	p.Transparency = transparency or 0
	p.Parent = folder
	return p
end

-- 두 점이 같으면 방향을 정할 수 없어서 (NaN) 그냥 그 자리에 둔다
local function lookAt(from: Vector3, to: Vector3): CFrame
	if (to - from).Magnitude < 1e-3 then
		return CFrame.new(from)
	end
	return CFrame.lookAt(from, to)
end

local function tween(inst: Instance, time: number, goal: { [string]: any }, style: Enum.EasingStyle?, dir: Enum.EasingDirection?)
	local tw = TweenService:Create(inst, TweenInfo.new(time, style or Enum.EasingStyle.Quad, dir or Enum.EasingDirection.Out), goal)
	tw:Play()
	return tw
end

-- 터지는 빛 조각
function Fx.spark(pos: Vector3, color: Color3, size: number, count: number)
	local flash = piece(Vector3.new(1, 1, 1) * size, Color3.new(1, 1, 1), Enum.Material.Neon, Enum.PartType.Ball, 0)
	flash.Position = pos
	tween(flash, 0.12, { Size = Vector3.new(1, 1, 1) * size * 2.4, Transparency = 1 })
	Debris:AddItem(flash, 0.15)
	for _ = 1, count do
		local dir = Vector3.new(math.random() - 0.5, math.random() * 0.8 - 0.2, math.random() - 0.5)
		if dir.Magnitude < 0.05 then
			dir = Vector3.new(0, 1, 0)
		end
		dir = dir.Unit
		local len = size * (0.6 + math.random() * 0.8)
		local shard = piece(Vector3.new(0.15 * size, 0.15 * size, len), color, Enum.Material.Neon)
		shard.CFrame = CFrame.lookAt(pos, pos + dir)
		local to = pos + dir * size * (2 + math.random() * 2.5)
		tween(shard, 0.22, { CFrame = CFrame.lookAt(to, to + dir), Size = Vector3.new(0.05, 0.05, len * 0.3), Transparency = 1 })
		Debris:AddItem(shard, 0.25)
	end
end

-- 바닥에 퍼지는 충격파 고리 (vertical이면 세워서)
function Fx.ring(pos: Vector3, color: Color3, fromD: number, toD: number, life: number, faceDir: Vector3?)
	local p = piece(Vector3.new(0.2, fromD, fromD), color, Enum.Material.Neon, Enum.PartType.Cylinder, 0.15)
	if faceDir then
		p.CFrame = lookAt(pos, pos + faceDir) * CFrame.Angles(0, math.rad(90), 0)
	else
		p.CFrame = CFrame.new(pos) * CFrame.Angles(0, 0, math.rad(90))
	end
	tween(p, life, { Size = Vector3.new(0.05, toD, toD), Transparency = 1 })
	Debris:AddItem(p, life + 0.05)
end

-- 떠오르는 글자 (피해 숫자, '흘리기!' 같은 말)
function Fx.text(pos: Vector3, text: string, color: Color3, size: number, rise: number?)
	local anchor = piece(Vector3.new(0.2, 0.2, 0.2), color, Enum.Material.Neon, nil, 1)
	anchor.Position = pos
	local bb = Instance.new("BillboardGui")
	bb.Size = UDim2.new(0, 300, 0, 70)
	bb.AlwaysOnTop = true
	bb.LightInfluence = 0
	bb.MaxDistance = 300
	bb.Parent = anchor
	local l = Instance.new("TextLabel")
	l.Size = UDim2.fromScale(1, 1)
	l.BackgroundTransparency = 1
	l.Font = Enum.Font.GothamBlack
	l.TextSize = size
	l.TextColor3 = color
	l.TextStrokeTransparency = 0
	l.TextStrokeColor3 = Color3.fromRGB(20, 10, 10)
	l.Text = text
	l.Parent = bb
	local sc = Instance.new("UIScale")
	sc.Scale = 1.8
	sc.Parent = l
	tween(sc, 0.14, { Scale = 1 }, Enum.EasingStyle.Back)
	tween(anchor, 0.8, { Position = pos + Vector3.new(math.random() * 2 - 1, rise or 3.5, 0) })
	task.delay(0.45, function()
		tween(l, 0.35, { TextTransparency = 1, TextStrokeTransparency = 1 })
	end)
	Debris:AddItem(anchor, 0.85)
end

-- 흙먼지
function Fx.dust(pos: Vector3, size: number)
	for _ = 1, 5 do
		local p = piece(Vector3.new(1, 1, 1) * size * (0.6 + math.random() * 0.6), Color3.fromRGB(190, 170, 140), Enum.Material.SmoothPlastic, Enum.PartType.Ball, 0.4)
		p.Position = pos + Vector3.new(math.random() * 2 - 1, 0, math.random() * 2 - 1) * size
		tween(p, 0.6, { Size = p.Size * 2.2, Position = p.Position + Vector3.new(0, size, 0), Transparency = 1 })
		Debris:AddItem(p, 0.65)
	end
end

-- 번개 (지그재그 빛줄기)
function Fx.lightning(from: Vector3, to: Vector3, color: Color3?, width: number?)
	local col = color or Color3.fromRGB(255, 245, 140)
	local w = width or 0.35
	local n = 7
	local prev = from
	for i = 1, n do
		local k = i / n
		local p = from:Lerp(to, k)
		if i < n then
			p += Vector3.new(math.random() - 0.5, math.random() - 0.5, math.random() - 0.5) * (to - from).Magnitude * 0.12
		end
		local len = (p - prev).Magnitude
		if len > 0.05 then
			local seg = piece(Vector3.new(w, w, len), col, Enum.Material.Neon)
			seg.CFrame = lookAt((prev + p) / 2, p)
			tween(seg, 0.25, { Transparency = 1, Size = Vector3.new(w * 0.2, w * 0.2, len) })
			Debris:AddItem(seg, 0.3)
		end
		prev = p
	end
end

-- 잔상: 몸을 반투명한 그림자로 남긴다
function Fx.afterimage(model: Model, color: Color3, life: number?)
	for _, d in ipairs(model:GetChildren()) do
		if d:IsA("BasePart") and d.Name ~= "HumanoidRootPart" and d.Transparency < 0.9 then
			local p = piece(d.Size, color, Enum.Material.Neon, nil, 0.45)
			p.CFrame = d.CFrame
			tween(p, life or 0.35, { Transparency = 1 })
			Debris:AddItem(p, (life or 0.35) + 0.05)
		end
	end
end

------------------------------------------------------------------------
-- 손발 잔상 (기술 쓰는 동안)
------------------------------------------------------------------------
local function trailOn(part: BasePart, color: Color3, color2: Color3, life: number)
	local a0 = Instance.new("Attachment")
	a0.Position = Vector3.new(0, 0.7, 0)
	a0.Parent = part
	local a1 = Instance.new("Attachment")
	a1.Position = Vector3.new(0, -0.8, 0)
	a1.Parent = part
	local tr = Instance.new("Trail")
	tr.Attachment0 = a0
	tr.Attachment1 = a1
	tr.Lifetime = 0.28
	tr.LightEmission = 1
	tr.FaceCamera = true
	tr.Color = ColorSequence.new(color2, color)
	tr.Transparency = NumberSequence.new(0, 1)
	tr.WidthScale = NumberSequence.new(1.2, 0.2)
	tr.Parent = part
	task.delay(life, function()
		tr.Enabled = false
		Debris:AddItem(tr, 0.3)
		Debris:AddItem(a0, 0.3)
		Debris:AddItem(a1, 0.3)
	end)
end

function Fx.limbTrails(model: Model, pose: string, dur: number, color: Color3, color2: Color3)
	-- 무기를 든 적은 무기 날에, 맨손이면 휘두르는 손발에
	local hasWeapon = false
	for _, w in ipairs(model:GetChildren()) do
		if w.Name == "Weapon" then
			local blade = w:FindFirstChild("Blade")
			if blade and blade:IsA("BasePart") then
				trailOn(blade, color, color2, dur)
				hasWeapon = true
			end
		end
	end
	if hasWeapon then
		return
	end
	for _, name in ipairs(Poses.limbs[pose] or {}) do
		local part = model:FindFirstChild(name)
		if part and part:IsA("BasePart") then
			trailOn(part, color, color2, dur)
		end
	end
end

------------------------------------------------------------------------
-- 권법마다 다른 빛 (맞힌 자리에)
------------------------------------------------------------------------
local function styleOf(id: any): any
	return type(id) == "string" and Config.STYLE_BY_ID[id] or nil
end

function Fx.styleHit(styleId: any, pos: Vector3, heavy: boolean, dir: Vector3?)
	local style = styleOf(styleId)
	if not style then
		Fx.spark(pos, Color3.fromRGB(255, 230, 200), heavy and 2 or 1.2, heavy and 10 or 6)
		return
	end
	local s = heavy and 1.6 or 1
	local c, c2 = style.color, style.color2
	Fx.spark(pos, c, 1.3 * s, heavy and 12 or 7)
	if style.fx == "water" then
		-- 물방울과 물결
		Fx.ring(pos, c2, 1, 9 * s, 0.35, dir)
		for _ = 1, 6 do
			local drop = piece(Vector3.new(0.5, 0.5, 0.5), c2, Enum.Material.Glass, Enum.PartType.Ball, 0.2)
			drop.Position = pos
			local to = pos + Vector3.new(math.random() * 6 - 3, math.random() * 4, math.random() * 6 - 3) * s
			tween(drop, 0.4, { Position = to, Transparency = 1 })
			Debris:AddItem(drop, 0.45)
		end
	elseif style.fx == "gold" then
		-- 금빛 범종 소리 같은 둥근 빛
		local bell = piece(Vector3.new(1, 1, 1) * 3 * s, c, Enum.Material.Neon, Enum.PartType.Ball, 0.3)
		bell.Position = pos
		tween(bell, 0.3, { Size = Vector3.new(1, 1, 1) * 9 * s, Transparency = 1 })
		Debris:AddItem(bell, 0.35)
		Fx.ring(pos, c, 2, 14 * s, 0.4, dir)
	elseif style.fx == "petal" then
		for _ = 1, heavy and 14 or 8 do
			local petal = piece(Vector3.new(0.7, 0.08, 0.5), math.random() < 0.5 and c or c2, Enum.Material.SmoothPlastic)
			petal.CFrame = CFrame.new(pos) * CFrame.Angles(math.random() * 6, math.random() * 6, math.random() * 6)
			local to = pos + Vector3.new(math.random() * 10 - 5, math.random() * 5 - 1, math.random() * 10 - 5) * s
			tween(petal, 0.9, { CFrame = CFrame.new(to) * CFrame.Angles(math.random() * 6, math.random() * 6, math.random() * 6), Transparency = 1 })
			Debris:AddItem(petal, 0.95)
		end
	elseif style.fx == "dragon" then
		Fx.ring(pos, c, 1, 10 * s, 0.35, dir)
		Fx.ring(pos, c2, 1, 6 * s, 0.25, dir)
	elseif style.fx == "shadow" then
		for _ = 1, 6 do
			local smoke = piece(Vector3.new(1, 1, 1) * (1.5 + math.random()) * s, Color3.fromRGB(30, 15, 50), Enum.Material.SmoothPlastic, Enum.PartType.Ball, 0.3)
			smoke.Position = pos + Vector3.new(math.random() * 2 - 1, math.random() * 2 - 1, math.random() * 2 - 1)
			tween(smoke, 0.5, { Size = smoke.Size * 2.5, Transparency = 1 })
			Debris:AddItem(smoke, 0.55)
		end
		Fx.ring(pos, c, 1, 8 * s, 0.3, dir)
	elseif style.fx == "lightning" then
		for _ = 1, heavy and 4 or 2 do
			local off = Vector3.new(math.random() * 8 - 4, math.random() * 6, math.random() * 8 - 4) * s
			Fx.lightning(pos, pos + off, c, 0.3)
		end
	elseif style.fx == "basic" then
		Fx.ring(pos, c2, 1, 7 * s, 0.25, dir)
	elseif style.fx == "void" then
		-- 무극: 맞은 자리가 한 점으로 꺼졌다 터진다
		local hole = piece(Vector3.new(3, 3, 3) * s, Color3.new(0, 0, 0), Enum.Material.SmoothPlastic, Enum.PartType.Ball, 0.1)
		hole.Position = pos
		tween(hole, 0.15, { Size = Vector3.new(0.2, 0.2, 0.2) })
		Debris:AddItem(hole, 0.16)
		task.delay(0.15, function()
			Fx.ring(pos, c2, 0.5, 14 * s, 0.35, dir)
			Fx.ring(pos, c, 0.5, 9 * s, 0.3)
		end)
	elseif style.fx == "blood" then
		-- 혈마: 핏빛 방울이 튀고 붉은 고리
		Fx.ring(pos, c, 1, 9 * s, 0.3, dir)
		for _ = 1, heavy and 10 or 6 do
			local drop = piece(Vector3.new(0.4, 0.4, 0.4), c, Enum.Material.Neon, Enum.PartType.Ball, 0.1)
			drop.Position = pos
			tween(drop, 0.45, { Position = pos + Vector3.new(math.random() * 6 - 3, math.random() * 3 - 2, math.random() * 6 - 3) * s, Transparency = 1 })
			Debris:AddItem(drop, 0.5)
		end
	elseif style.fx == "cosmic" then
		-- 개천: 별빛이 사방으로 튀고 금빛 고리
		Fx.ring(pos, c2, 1, 10 * s, 0.3, dir)
		for _ = 1, heavy and 10 or 6 do
			local st = piece(Vector3.new(0.35, 0.35, 0.35), math.random() < 0.5 and c or Color3.new(1, 1, 1), Enum.Material.Neon, Enum.PartType.Ball, 0)
			st.Position = pos
			tween(st, 0.5, { Position = pos + Vector3.new(math.random() * 8 - 4, math.random() * 6 - 1, math.random() * 8 - 4) * s, Transparency = 1 })
			Debris:AddItem(st, 0.55)
		end
	elseif style.fx == "drunk" then
		Fx.ring(pos, c, 1, 8 * s, 0.4, dir)
		if heavy then
			local fire = piece(Vector3.new(1, 1, 1) * 3, Color3.fromRGB(255, 120, 40), Enum.Material.Neon, Enum.PartType.Ball, 0.2)
			fire.Position = pos
			tween(fire, 0.35, { Size = Vector3.new(1, 1, 1) * 8, Transparency = 1 })
			Debris:AddItem(fire, 0.4)
		end
	end
end

------------------------------------------------------------------------
-- 장풍 (날아가는 기운)
------------------------------------------------------------------------
function Fx.projectile(data: any)
	local style = styleOf(data.style)
	local c = style and style.color or Color3.fromRGB(120, 255, 230)
	local c2 = style and style.color2 or Color3.new(1, 1, 1)
	local size = data.size or 3
	local ball = piece(Vector3.new(1, 1, 1) * size, c, Enum.Material.Neon, Enum.PartType.Ball, 0.15)
	local core = piece(Vector3.new(1, 1, 1) * size * 0.55, c2, Enum.Material.Neon, Enum.PartType.Ball, 0)
	ball.Position = data.pos
	core.Position = data.pos
	local a0 = Instance.new("Attachment")
	a0.Position = Vector3.new(0, size * 0.4, 0)
	a0.Parent = ball
	local a1 = Instance.new("Attachment")
	a1.Position = Vector3.new(0, -size * 0.4, 0)
	a1.Parent = ball
	local tr = Instance.new("Trail")
	tr.Attachment0 = a0
	tr.Attachment1 = a1
	tr.Lifetime = 0.3
	tr.LightEmission = 1
	tr.Color = ColorSequence.new(c2, c)
	tr.Transparency = NumberSequence.new(0, 1)
	tr.Parent = ball
	-- 용 모양: 몸통이 따라오며 꿈틀댄다
	local tail = {}
	if style and style.fx == "dragon" then
		for i = 1, 6 do
			local seg = piece(Vector3.new(1, 1, 1) * size * (0.85 - i * 0.1), c:Lerp(c2, i / 8), Enum.Material.Neon, Enum.PartType.Ball, 0.25)
			seg.Position = data.pos
			table.insert(tail, seg)
		end
	end
	local start = os.clock()
	local dir: Vector3 = data.dir
	local conn: RBXScriptConnection
	conn = RunService.RenderStepped:Connect(function()
		local t = os.clock() - start
		local pos = data.pos + dir * data.speed * t
		ball.Position = pos
		core.Position = pos
		local side = Vector3.new(-dir.Z, 0, dir.X)
		for i, seg in ipairs(tail) do
			local back = math.max(0, t - i * 0.025)
			seg.Position = data.pos + dir * data.speed * back + side * math.sin(back * 18 + i) * size * 0.4
		end
		if t >= data.life then
			conn:Disconnect()
			Fx.spark(pos, c, size * 0.6, 6)
			for _, p in ipairs({ ball, core, table.unpack(tail) }) do
				tween(p, 0.15, { Transparency = 1 })
				Debris:AddItem(p, 0.2)
			end
		end
	end)
end

------------------------------------------------------------------------
-- 큰 연출
------------------------------------------------------------------------
-- 꽃잎 폭발 (매화 만개)
function Fx.bloom(pos: Vector3, radius: number)
	Fx.ring(pos, Color3.fromRGB(255, 150, 200), 2, radius * 2.2, 0.5)
	for _ = 1, 40 do
		local petal = piece(Vector3.new(1, 0.1, 0.7), Color3.fromRGB(255, 130 + math.random(0, 80), 190), Enum.Material.SmoothPlastic)
		petal.CFrame = CFrame.new(pos + Vector3.new(0, 2, 0)) * CFrame.Angles(math.random() * 6, math.random() * 6, 0)
		local a = math.random() * math.pi * 2
		local to = pos + Vector3.new(math.cos(a) * radius, math.random() * 8, math.sin(a) * radius)
		tween(petal, 1.1, { CFrame = CFrame.new(to) * CFrame.Angles(math.random() * 6, math.random() * 6, 0), Transparency = 1 })
		Debris:AddItem(petal, 1.15)
	end
end

------------------------------------------------------------------------
-- 기술 쓰는 순간의 연출 (Z 강타·E·R). 오의(G)는 Fx.ult
------------------------------------------------------------------------
local function rootPart(model: Model): BasePart?
	local r = model:FindFirstChild("HumanoidRootPart")
	return (r and r:IsA("BasePart")) and r or nil
end

-- 몸을 따라다니는 조각들 (dur초 동안). place(t) 가 { [Part] = CFrame } 를 돌려준다
local function follow(model: Model, dur: number, parts: { Part }, place: (number, CFrame) -> { CFrame }, fade: number?)
	local start = os.clock()
	local conn: RBXScriptConnection
	conn = RunService.RenderStepped:Connect(function()
		local t = os.clock() - start
		local r = rootPart(model)
		if t > dur or not r or not model.Parent then
			conn:Disconnect()
			for _, p in ipairs(parts) do
				tween(p, fade or 0.25, { Transparency = 1 })
				Debris:AddItem(p, (fade or 0.25) + 0.05)
			end
			return
		end
		local cfs = place(t, r.CFrame)
		for i, p in ipairs(parts) do
			if cfs[i] then
				p.CFrame = cfs[i]
			end
		end
	end)
end

-- 몸에서 터지는 기운 (모든 기술 공통)
local function flare(pos: Vector3, color: Color3, size: number)
	local b = piece(Vector3.new(1, 1, 1) * size, color, Enum.Material.Neon, Enum.PartType.Ball, 0.35)
	b.Position = pos
	tween(b, 0.35, { Size = Vector3.new(1, 1, 1) * size * 2.6, Transparency = 1 })
	Debris:AddItem(b, 0.4)
	for _ = 1, 8 do
		local a = math.random() * math.pi * 2
		local shard = piece(Vector3.new(0.3, 2.4, 0.3), color, Enum.Material.Neon)
		local from = pos + Vector3.new(math.cos(a) * size * 0.6, -2, math.sin(a) * size * 0.6)
		shard.Position = from
		tween(shard, 0.5, { Position = from + Vector3.new(0, 6 + math.random() * 4, 0), Size = Vector3.new(0.1, 0.6, 0.1), Transparency = 1 })
		Debris:AddItem(shard, 0.55)
	end
end

-- 앞으로 뻗는 기운의 띠 (돌진 기술의 지나간 길)
local function streak(from: Vector3, to: Vector3, color: Color3, width: number, life: number)
	if (to - from).Magnitude < 0.5 then
		return
	end
	local p = piece(Vector3.new(width, width * 0.4, (to - from).Magnitude), color, Enum.Material.Neon, nil, 0.2)
	p.CFrame = lookAt((from + to) / 2, to)
	tween(p, life, { Size = Vector3.new(width * 0.1, width * 0.05, (to - from).Magnitude), Transparency = 1 })
	Debris:AddItem(p, life + 0.05)
end

-- 오의 연출 (권법마다 전혀 다르게). 발밑 진 → 모으기 → 절정(dur의 85%)에 터진다
local function beam(at: Vector3, color: Color3, width: number, height: number, life: number)
	local b = piece(Vector3.new(width, 1, width), color, Enum.Material.Neon, Enum.PartType.Cylinder, 0.15)
	b.CFrame = CFrame.new(at) * CFrame.Angles(0, 0, math.rad(90))
	b.Size = Vector3.new(1, width, width)
	tween(b, 0.18, { Size = Vector3.new(height, width, width), CFrame = CFrame.new(at + Vector3.new(0, height / 2, 0)) * CFrame.Angles(0, 0, math.rad(90)) })
	task.delay(0.18, function()
		tween(b, life, { Size = Vector3.new(height, width * 0.1, width * 0.1), Transparency = 1 })
	end)
	Debris:AddItem(b, life + 0.25)
	return b
end
local function sphere(at: Vector3, color: Color3, from: number, to: number, life: number, material: Enum.Material?, trans: number?)
	local s = piece(Vector3.new(from, from, from), color, material or Enum.Material.Neon, Enum.PartType.Ball, trans or 0.3)
	s.Position = at
	tween(s, life, { Size = Vector3.new(to, to, to), Transparency = 1 })
	Debris:AddItem(s, life + 0.05)
	return s
end
-- 돌며 솟는 조각 무리 (용, 꽃잎 회오리, 별 은하)
local function spiral(base: Vector3, n: number, dur: number, size: number, colors: { Color3 }, mat: Enum.Material, radius: number, rise: number, spin: number, shape: Enum.PartType?)
	local segs = {}
	for i = 1, n do
		local seg = piece(Vector3.new(1, 1, 1) * size * (1 - i / n * 0.5), colors[(i % #colors) + 1], mat, shape or Enum.PartType.Ball, 0.15)
		seg.Position = base
		table.insert(segs, seg)
	end
	local start = os.clock()
	local conn: RBXScriptConnection
	conn = RunService.RenderStepped:Connect(function()
		local t = os.clock() - start
		for i, seg in ipairs(segs) do
			local k = math.max(0, t - i * 0.035)
			local a = k * spin + i * 0.3
			local r = radius * (1 - math.min(0.6, k * 0.4))
			seg.CFrame = CFrame.new(base + Vector3.new(math.cos(a) * r, k * rise, math.sin(a) * r)) * CFrame.Angles(a, a * 0.5, 0)
		end
		if t > dur then
			conn:Disconnect()
			for _, seg in ipairs(segs) do
				tween(seg, 0.35, { Transparency = 1 })
				Debris:AddItem(seg, 0.4)
			end
		end
	end)
end

function Fx.ult(styleId: string, model: Model, dur: number)
	local style = styleOf(styleId)
	local root = model:FindFirstChild("HumanoidRootPart")
	if not style or not root or not root:IsA("BasePart") then
		return
	end
	local base = Vector3.new(root.Position.X, root.Position.Y - 2.5, root.Position.Z)
	local look = Vector3.new(root.CFrame.LookVector.X, 0, root.CFrame.LookVector.Z)
	look = look.Magnitude > 0.01 and look.Unit or Vector3.new(0, 0, -1)
	local c, c2 = style.color, style.color2
	local climax = dur * 0.85
	-- 공통: 발밑의 두 겹 진 (도는 띠)
	local circle = piece(Vector3.new(0.3, 4, 4), c, Enum.Material.Neon, Enum.PartType.Cylinder, 0.3)
	circle.CFrame = CFrame.new(base + Vector3.new(0, 0.2, 0)) * CFrame.Angles(0, 0, math.rad(90))
	tween(circle, 0.5, { Size = Vector3.new(0.3, 36, 36) })
	local inner = piece(Vector3.new(0.35, 4, 4), c2, Enum.Material.Neon, Enum.PartType.Cylinder, 0.45)
	inner.CFrame = CFrame.new(base + Vector3.new(0, 0.25, 0)) * CFrame.Angles(0, 0, math.rad(90))
	tween(inner, 0.6, { Size = Vector3.new(0.35, 22, 22) })
	task.delay(dur - 0.3, function()
		tween(circle, 0.3, { Transparency = 1 })
		tween(inner, 0.3, { Transparency = 1 })
	end)
	Debris:AddItem(circle, dur + 0.1)
	Debris:AddItem(inner, dur + 0.1)
	-- 모으는 동안 둘레에서 빛이 빨려 든다
	for k = 0, 9 do
		task.delay(k * dur * 0.05, function()
			local a = math.random() * math.pi * 2
			local from = base + Vector3.new(math.cos(a) * 18, math.random() * 8 + 1, math.sin(a) * 18)
			local mote = piece(Vector3.new(0.8, 0.8, 0.8), k % 2 == 0 and c or c2, Enum.Material.Neon, Enum.PartType.Ball, 0.1)
			mote.Position = from
			tween(mote, 0.4, { Position = base + Vector3.new(0, 3, 0), Size = Vector3.new(0.2, 0.2, 0.2) }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
			Debris:AddItem(mote, 0.45)
		end)
	end
	local fx = style.fx
	if fx == "water" then
		-- 물의 돔이 솟고, 물의 용이 감아 오르다, 해일 고리가 퍼져 나간다
		local dome = piece(Vector3.new(4, 4, 4), c2, Enum.Material.Glass, Enum.PartType.Ball, 0.55)
		dome.Position = base
		tween(dome, dur * 0.6, { Size = Vector3.new(30, 18, 30) })
		task.delay(climax, function()
			tween(dome, 0.3, { Size = Vector3.new(44, 4, 44), Transparency = 1 })
		end)
		Debris:AddItem(dome, climax + 0.4)
		spiral(base, 16, climax, 3.6, { c, c2 }, Enum.Material.Glass, 10, 20, 6)
		task.delay(climax, function()
			for k = 0, 3 do
				task.delay(k * 0.08, function()
					Fx.ring(base + Vector3.new(0, 0.5 + k * 0.6, 0), k % 2 == 0 and c2 or c, 4, 50 + k * 10, 0.6)
				end)
			end
			for _ = 1, 24 do
				local a = math.random() * math.pi * 2
				local drop = piece(Vector3.new(0.8, 0.8, 0.8), c2, Enum.Material.Glass, Enum.PartType.Ball, 0.1)
				drop.Position = base + Vector3.new(0, 2, 0)
				tween(drop, 0.7, { Position = base + Vector3.new(math.cos(a) * 22, math.random() * 12, math.sin(a) * 22), Transparency = 1 })
				Debris:AddItem(drop, 0.75)
			end
		end)
	elseif fx == "gold" then
		-- 등 뒤의 금빛 후광, 둘레를 도는 경문 고리, 하늘에서 내려찍는 손바닥과 빛기둥
		local halo = piece(Vector3.new(0.4, 12, 12), c, Enum.Material.Neon, Enum.PartType.Cylinder, 0.35)
		halo.CFrame = CFrame.lookAt(base + Vector3.new(0, 6, 0) - look * 1.5, base + Vector3.new(0, 6, 0) - look * 3) * CFrame.Angles(0, math.rad(90), 0)
		tween(halo, 0.5, { Size = Vector3.new(0.4, 16, 16) })
		task.delay(dur - 0.3, function()
			tween(halo, 0.3, { Transparency = 1 })
		end)
		Debris:AddItem(halo, dur + 0.1)
		for k = 0, 2 do
			task.delay(k * 0.2, function()
				Fx.ring(base + Vector3.new(0, 2 + k * 3, 0), c2, 6, 12, 0.6)
			end)
		end
		local target = base + look * 6
		local palm = piece(Vector3.new(16, 2, 20), c, Enum.Material.Neon, nil, 0.25)
		palm.CFrame = CFrame.new(target + Vector3.new(0, 70, 0))
		local fingers = {}
		for i = -2, 2 do
			local fg = piece(Vector3.new(2.6, 1.8, 9), c2, Enum.Material.Neon, nil, 0.3)
			fg.CFrame = palm.CFrame * CFrame.new(i * 3.2, 0, -13)
			table.insert(fingers, fg)
		end
		task.delay(climax - 0.2, function()
			tween(palm, 0.2, { CFrame = CFrame.new(target + Vector3.new(0, 1, 0)) }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
			for i, fg in ipairs(fingers) do
				tween(fg, 0.2, { CFrame = CFrame.new(target + Vector3.new(0, 1, 0)) * CFrame.new((i - 3) * 3.2, 0, -13) }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
			end
			task.delay(0.2, function()
				beam(target, c2, 10, 120, 0.6)
				Fx.ring(target, c, 4, 64, 0.6)
				Fx.ring(target + Vector3.new(0, 1, 0), c2, 4, 40, 0.5)
				Fx.dust(target, 7)
				tween(palm, 0.6, { Transparency = 1 })
				for _, fg in ipairs(fingers) do
					tween(fg, 0.6, { Transparency = 1 })
				end
			end)
		end)
		Debris:AddItem(palm, dur + 1)
		for _, fg in ipairs(fingers) do
			Debris:AddItem(fg, dur + 1)
		end
	elseif fx == "petal" then
		-- 꽃잎 회오리가 몸을 감싸 솟고, 다섯 번 피었다가 마지막에 크게 만개
		spiral(base, 30, dur, 1.4, { c, c2, Color3.fromRGB(255, 240, 245) }, Enum.Material.SmoothPlastic, 9, 10, 9, Enum.PartType.Block)
		for k = 0, 3 do
			task.delay(k * dur * 0.2, function()
				Fx.bloom(base + Vector3.new(0, 1, 0), 10 + k * 2)
			end)
		end
		task.delay(climax, function()
			Fx.bloom(base + Vector3.new(0, 1, 0), 26)
			sphere(base + Vector3.new(0, 2, 0), c, 4, 30, 0.5, Enum.Material.Neon, 0.6)
		end)
	elseif fx == "dragon" then
		-- 용 한 마리가 몸을 감아 하늘로, 이어 아홉 용 기둥이 땅을 뚫는다
		spiral(base, 18, dur, 4, { c, c2 }, Enum.Material.Neon, 9, 26, 7)
		for i = 0, 8 do
			task.delay(climax - 0.3 + i * 0.05, function()
				local a = i / 9 * math.pi * 2
				local p = base + Vector3.new(math.cos(a) * 15, 0, math.sin(a) * 15)
				beam(p, i % 2 == 0 and c or c2, 4, 70, 0.5)
				Fx.ring(p + Vector3.new(0, 0.3, 0), c, 1, 10, 0.4)
			end)
		end
		task.delay(climax, function()
			Fx.ring(base + Vector3.new(0, 0.5, 0), c, 4, 56, 0.6)
			Fx.dust(base, 6)
		end)
	elseif fx == "shadow" then
		-- 검은 구가 몸을 삼키고, 여섯 그림자가 사방에서 엇갈려 지나간다
		sphere(base + Vector3.new(0, 3, 0), Color3.fromRGB(20, 10, 35), 2, 14, 0.4, Enum.Material.SmoothPlastic, 0.2)
		for k = 0, 5 do
			task.delay(0.25 + k * (climax - 0.25) / 6, function()
				local a = k / 6 * math.pi * 2
				local p = base + Vector3.new(math.cos(a) * 10, 3, math.sin(a) * 10)
				local q = base + Vector3.new(-math.cos(a) * 10, 3, -math.sin(a) * 10)
				local ghost = piece(Vector3.new(2, 5, 1), Color3.fromRGB(40, 20, 70), Enum.Material.Neon, nil, 0.3)
				ghost.CFrame = lookAt(p, q)
				tween(ghost, 0.18, { CFrame = lookAt(q, q + (q - p)) })
				streak(p, q, c, 0.6, 0.3)
				task.delay(0.18, function()
					tween(ghost, 0.2, { Transparency = 1 })
				end)
				Debris:AddItem(ghost, 0.45)
			end)
		end
		task.delay(climax, function()
			sphere(base + Vector3.new(0, 3, 0), c, 3, 30, 0.45, Enum.Material.Neon, 0.4)
			Fx.ring(base + Vector3.new(0, 0.4, 0), c, 3, 40, 0.5)
		end)
	elseif fx == "lightning" then
		-- 머리 위로 먹구름이 모이고, 벼락이 쏟아지다 마지막에 거대한 한 줄기
		local cloud = piece(Vector3.new(4, 40, 40), Color3.fromRGB(40, 40, 60), Enum.Material.SmoothPlastic, Enum.PartType.Cylinder, 0.4)
		cloud.CFrame = CFrame.new(base + Vector3.new(0, 55, 0)) * CFrame.Angles(0, 0, math.rad(90))
		tween(cloud, 0.6, { Size = Vector3.new(6, 70, 70) })
		task.delay(dur, function()
			tween(cloud, 0.4, { Transparency = 1 })
		end)
		Debris:AddItem(cloud, dur + 0.5)
		for k = 0, 11 do
			task.delay(0.4 + k * (climax - 0.4) / 12, function()
				local a = math.random() * math.pi * 2
				local p = base + Vector3.new(math.cos(a), 0, math.sin(a)) * math.random(4, 22)
				Fx.lightning(p + Vector3.new(0, 55, 0), p, c, 0.7)
				Fx.ring(p, c, 1, 9, 0.3)
			end)
		end
		task.delay(climax, function()
			local p = base + look * 6
			Fx.lightning(p + Vector3.new(0, 80, 0), p, c2, 3)
			Fx.lightning(p + Vector3.new(4, 80, 0), p, c, 2)
			beam(p, c2, 8, 90, 0.4)
			Fx.ring(p, c, 4, 50, 0.5)
		end)
	elseif fx == "drunk" then
		-- 술기운이 불길이 되어 앞으로 쏟아진다 (불덩이 줄기)
		for k = 0, 13 do
			task.delay(0.35 + k * (climax - 0.35) / 14, function()
				local from = base + Vector3.new(0, 4, 0) + look * 2
				local side = Vector3.new(-look.Z, 0, look.X) * (math.random() * 6 - 3)
				local ball = piece(Vector3.new(2, 2, 2), k % 2 == 0 and Color3.fromRGB(255, 140, 40) or c, Enum.Material.Neon, Enum.PartType.Ball, 0.1)
				ball.Position = from
				tween(ball, 0.45, { Position = from + look * 20 + side + Vector3.new(0, -2, 0), Size = Vector3.new(6, 6, 6), Transparency = 1 })
				Debris:AddItem(ball, 0.5)
			end)
		end
		task.delay(climax, function()
			Fx.ring(base + Vector3.new(0, 0.5, 0) + look * 10, Color3.fromRGB(255, 140, 40), 4, 36, 0.5)
			sphere(base + look * 12 + Vector3.new(0, 2, 0), Color3.fromRGB(255, 120, 30), 4, 22, 0.4)
		end)
	elseif fx == "basic" then
		-- 하늘·땅·사람: 세 기둥이 셋으로 서고, 한 주먹에 모여 땅이 갈라진다
		for k = 0, 2 do
			task.delay(k * 0.2, function()
				local a = k / 3 * math.pi * 2
				local p = base + Vector3.new(math.cos(a) * 9, 0, math.sin(a) * 9)
				beam(p, k == 1 and c2 or c, 3, 40, climax - k * 0.2)
			end)
		end
		task.delay(climax, function()
			for k = 0, 7 do
				local a = k / 8 * math.pi * 2
				local p = base + look * 4
				streak(p, p + Vector3.new(math.cos(a), 0, math.sin(a)) * 22, c, 1.2, 0.5)
			end
			Fx.ring(base + look * 4 + Vector3.new(0, 0.4, 0), c, 3, 40, 0.5)
			Fx.dust(base + look * 4, 6)
		end)
	elseif fx == "void" then
		-- 무극: 검은 구와 흰 구가 서로를 돌다(태극), 모든 것이 한 점으로 빨려 들었다가 터진다
		local orbs = { piece(Vector3.new(3, 3, 3), Color3.new(0, 0, 0), Enum.Material.SmoothPlastic, Enum.PartType.Ball, 0), piece(Vector3.new(3, 3, 3), Color3.new(1, 1, 1), Enum.Material.Neon, Enum.PartType.Ball, 0) }
		follow(model, climax, orbs, function(t, cf)
			local a = t * 6
			local r = 7 - math.min(6, t * 3)
			local p = cf.Position + Vector3.new(0, 3, 0)
			return { CFrame.new(p + Vector3.new(math.cos(a) * r, math.sin(t * 3), math.sin(a) * r)), CFrame.new(p - Vector3.new(math.cos(a) * r, math.sin(t * 3), math.sin(a) * r)) }
		end)
		local hole = piece(Vector3.new(40, 40, 40), Color3.new(0, 0, 0), Enum.Material.SmoothPlastic, Enum.PartType.Ball, 0.6)
		hole.Position = base + Vector3.new(0, 3, 0)
		tween(hole, climax, { Size = Vector3.new(1, 1, 1), Transparency = 0 }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
		Debris:AddItem(hole, climax + 0.05)
		task.delay(climax, function()
			sphere(base + Vector3.new(0, 3, 0), Color3.new(1, 1, 1), 2, 50, 0.55, Enum.Material.Neon, 0.2)
			for k = 0, 3 do
				task.delay(k * 0.07, function()
					Fx.ring(base + Vector3.new(0, 3, 0), k % 2 == 0 and c2 or c, 2, 60 - k * 8, 0.55)
				end)
			end
		end)
	elseif fx == "blood" then
		-- 혈마 강림: 하늘에 핏빛 달, 핏방울 비, 마지막에 거대한 X자 손톱
		local moon = piece(Vector3.new(16, 16, 16), Color3.fromRGB(180, 10, 25), Enum.Material.Neon, Enum.PartType.Ball, 0.2)
		moon.Position = base + Vector3.new(0, 45, 0) - look * 10
		tween(moon, 0.5, { Size = Vector3.new(26, 26, 26) })
		task.delay(dur, function()
			tween(moon, 0.4, { Transparency = 1 })
		end)
		Debris:AddItem(moon, dur + 0.5)
		for k = 0, 23 do
			task.delay(k * climax / 24, function()
				local p = base + Vector3.new(math.random() * 30 - 15, 40, math.random() * 30 - 15)
				local drop = piece(Vector3.new(0.4, 2.4, 0.4), c, Enum.Material.Neon, nil, 0.1)
				drop.Position = p
				tween(drop, 0.4, { Position = Vector3.new(p.X, base.Y + 0.5, p.Z) }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
				Debris:AddItem(drop, 0.42)
			end)
		end
		task.delay(climax, function()
			local center = base + look * 5 + Vector3.new(0, 4, 0)
			for _, sgn in ipairs({ 1, -1 }) do
				for i = -1, 1 do
					local bar = piece(Vector3.new(0.6, 0.6, 26), i == 0 and c2 or c, Enum.Material.Neon, nil, 0.05)
					bar.CFrame = lookAt(center, center + look) * CFrame.Angles(0, 0, sgn * math.rad(45)) * CFrame.new(i * 1.6, 0, 0) * CFrame.Angles(math.rad(90), 0, 0)
					tween(bar, 0.5, { Size = Vector3.new(0.1, 0.1, 34), Transparency = 1 })
					Debris:AddItem(bar, 0.55)
				end
			end
			Fx.ring(base + Vector3.new(0, 0.5, 0), c, 4, 46, 0.55)
		end)
	elseif fx == "cosmic" then
		-- 개천벽지: 하늘에 문이 열리고, 은하가 땅에 돌고, 별들이 쏟아지다 하늘에서 빛이 내리꽂힌다
		local gateC = base + Vector3.new(0, 60, 0)
		local gate = {}
		for k = 0, 17 do
			local p = piece(Vector3.new(3, 3, 7), k % 2 == 0 and c or c2, Enum.Material.Neon, nil, 0.1)
			table.insert(gate, p)
		end
		local start = os.clock()
		local conn: RBXScriptConnection
		conn = RunService.RenderStepped:Connect(function()
			local t = os.clock() - start
			local r = math.min(30, 4 + t * 30)
			for k, p in ipairs(gate) do
				local a = k / #gate * math.pi * 2 + t * 1.5
				local at = gateC + Vector3.new(math.cos(a) * r, 0, math.sin(a) * r)
				p.CFrame = CFrame.lookAt(at, gateC)
			end
			if t > dur then
				conn:Disconnect()
				for _, p in ipairs(gate) do
					tween(p, 0.4, { Transparency = 1 })
					Debris:AddItem(p, 0.45)
				end
			end
		end)
		local core = piece(Vector3.new(4, 4, 4), Color3.new(1, 1, 1), Enum.Material.Neon, Enum.PartType.Ball, 0.1)
		core.Position = gateC
		tween(core, dur * 0.6, { Size = Vector3.new(36, 36, 36), Color = c })
		task.delay(dur, function()
			tween(core, 0.4, { Transparency = 1 })
		end)
		Debris:AddItem(core, dur + 0.5)
		spiral(base + Vector3.new(0, 0.5, 0), 36, dur, 1, { c, c2, Color3.new(1, 1, 1) }, Enum.Material.Neon, 16, 0.5, 4)
		for k = 0, 9 do
			task.delay(0.45 + k * (climax - 0.45) / 10, function()
				local a = math.random() * math.pi * 2
				Fx.starfall(base + Vector3.new(math.cos(a), 0, math.sin(a)) * math.random(4, 20), styleId)
			end)
		end
		task.delay(climax, function()
			beam(base + look * 2, Color3.new(1, 1, 1), 16, 140, 0.7)
			beam(base + look * 2, c, 24, 140, 0.5)
			for k = 0, 3 do
				task.delay(k * 0.08, function()
					Fx.ring(base + Vector3.new(0, 0.5 + k, 0), k % 2 == 0 and c or c2, 4, 70 - k * 10, 0.6)
				end)
			end
			Fx.dust(base, 8)
		end)
	end
end

-- 별 하나가 떨어진다 (개천신권 장치, 낙성우, 오의)
function Fx.starfall(at: Vector3, styleId: any)
	local style = styleOf(styleId)
	local c = style and style.color or Color3.fromRGB(150, 200, 255)
	local c2 = style and style.color2 or Color3.fromRGB(255, 245, 190)
	local ground = Vector3.new(at.X, at.Y - 2, at.Z)
	local from = ground + Vector3.new(math.random() * 16 - 8, 70, math.random() * 16 - 8)
	local star = piece(Vector3.new(2.6, 2.6, 2.6), c2, Enum.Material.Neon, Enum.PartType.Ball, 0)
	star.Position = from
	local tail = piece(Vector3.new(1.2, 1.2, 14), c, Enum.Material.Neon, nil, 0.3)
	tail.CFrame = lookAt(from, ground) * CFrame.new(0, 0, 7)
	tween(star, 0.32, { Position = ground }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
	tween(tail, 0.32, { CFrame = lookAt(ground, ground + (ground - from)) * CFrame.new(0, 0, -7) }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
	Debris:AddItem(star, 0.34)
	Debris:AddItem(tail, 0.34)
	task.delay(0.32, function()
		Fx.ring(ground + Vector3.new(0, 0.3, 0), c, 2, 26, 0.45)
		Fx.ring(ground + Vector3.new(0, 0.4, 0), c2, 1, 14, 0.35)
		Fx.spark(ground + Vector3.new(0, 1, 0), c2, 2.4, 12)
		Fx.dust(ground, 3)
		Fx.sound("heavy", 0.6, 0.8, ground)
	end)
end

-- 권법마다 다른 휘두름 무늬 (주먹이 나갈 때마다 그 권법만의 빛이 앞으로 뻗는다)
local function flourish(style: any, r: BasePart, heavy: boolean)
	local c, c2 = style.color, style.color2
	local cf = r.CFrame
	local look, right, up = cf.LookVector, cf.RightVector, Vector3.new(0, 1, 0)
	local base = r.Position + Vector3.new(0, 0.6, 0)
	local s = heavy and 1.6 or 1
	local kind = style.fx
	if kind == "water" then
		-- 물의 초승달: 물방울이 둥글게 휘어 앞으로 흐른다
		for i = -4, 4 do
			local a = i / 4 * 1.1
			local p = base + (look * math.cos(a) + right * math.sin(a)) * 4.2 * s
			local d = piece(Vector3.new(0.55, 0.55, 0.55) * s, i % 2 == 0 and c2 or c, Enum.Material.Glass, Enum.PartType.Ball, 0.15)
			d.Position = base + look * 1.5
			tween(d, 0.16, { Position = p })
			task.delay(0.16, function()
				tween(d, 0.3, { Position = p + look * 3 + Vector3.new(0, -1, 0), Transparency = 1, Size = Vector3.new(0.2, 0.2, 0.2) })
			end)
			Debris:AddItem(d, 0.5)
		end
	elseif kind == "gold" then
		-- 금강의 그림자 주먹: 금빛 큰 주먹이 겹쳐 뻗는다
		local fist = piece(Vector3.new(2.2, 2.2, 2.2) * s, c, Enum.Material.Neon, Enum.PartType.Ball, 0.35)
		fist.Position = base + look * 1.5
		tween(fist, 0.18, { Position = base + look * 6 * s, Size = Vector3.new(3.4, 3.4, 3.4) * s, Transparency = 1 })
		Debris:AddItem(fist, 0.2)
		local hex = piece(Vector3.new(0.2, 4, 4) * s, c2, Enum.Material.Neon, Enum.PartType.Cylinder, 0.4)
		hex.CFrame = lookAt(base + look * 5, base + look * 6) * CFrame.Angles(0, math.rad(90), 0)
		tween(hex, 0.25, { Size = Vector3.new(0.05, 8, 8) * s, Transparency = 1 })
		Debris:AddItem(hex, 0.3)
	elseif kind == "petal" then
		-- 매화 부채: 꽃잎이 부채꼴로 흩뿌려진다
		for _ = 1, heavy and 12 or 7 do
			local a = (math.random() - 0.5) * 1.6
			local dir = look * math.cos(a) + right * math.sin(a)
			local pt = piece(Vector3.new(0.6, 0.06, 0.45), math.random() < 0.5 and c or c2, Enum.Material.SmoothPlastic)
			pt.CFrame = CFrame.new(base + look * 1.5) * CFrame.Angles(math.random() * 6, math.random() * 6, 0)
			tween(pt, 0.45, { CFrame = CFrame.new(base + dir * (5 + math.random() * 3) * s + up * (math.random() * 2 - 0.5)) * CFrame.Angles(math.random() * 6, math.random() * 6, 0), Transparency = 1 })
			Debris:AddItem(pt, 0.5)
		end
	elseif kind == "dragon" then
		-- 용의 몸: 굽이치는 빛 구슬이 앞으로 헤엄친다
		for i = 1, 7 do
			local seg = piece(Vector3.new(1, 1, 1) * (1.6 - i * 0.15) * s, c:Lerp(c2, i / 7), Enum.Material.Neon, Enum.PartType.Ball, 0.15)
			seg.Position = base + look * 1.5
			local p = base + look * (1.5 + i * 1.1 * s) + right * math.sin(i * 0.9) * 1.2 + up * math.cos(i * 0.9) * 0.6
			task.delay(i * 0.015, function()
				tween(seg, 0.14, { Position = p })
				task.delay(0.14, function()
					tween(seg, 0.25, { Transparency = 1, Size = seg.Size * 0.3 })
				end)
			end)
			Debris:AddItem(seg, 0.5)
		end
	elseif kind == "shadow" then
		-- 그림자 십자: 보랏빛 두 줄이 엇갈린다
		for _, sgn in ipairs({ 1, -1 }) do
			local bar = piece(Vector3.new(0.25, 0.25, 5 * s), c, Enum.Material.Neon, nil, 0.1)
			bar.CFrame = lookAt(base + look * 3.5, base + look * 4.5) * CFrame.Angles(0, 0, sgn * math.rad(45)) * CFrame.Angles(math.rad(90), 0, 0)
			tween(bar, 0.22, { Size = Vector3.new(0.05, 0.05, 7 * s), Transparency = 1 })
			Debris:AddItem(bar, 0.25)
		end
		local smoke = piece(Vector3.new(1.5, 1.5, 1.5), Color3.fromRGB(30, 15, 45), Enum.Material.SmoothPlastic, Enum.PartType.Ball, 0.4)
		smoke.Position = base - look * 0.5
		tween(smoke, 0.4, { Size = Vector3.new(4, 4, 4), Transparency = 1 })
		Debris:AddItem(smoke, 0.45)
	elseif kind == "lightning" then
		-- 벼락 주먹: 주먹 끝에서 갈라지는 번개
		local tip = base + look * 2
		for _ = 1, heavy and 3 or 2 do
			Fx.lightning(tip, tip + look * (5 + math.random() * 3) * s + right * (math.random() * 4 - 2) + up * (math.random() * 2 - 1), c, 0.22)
		end
	elseif kind == "drunk" then
		-- 취기: 술 방울과 불씨가 휘청이며 퍼진다
		for _ = 1, 5 do
			local f = piece(Vector3.new(0.7, 0.7, 0.7) * s, math.random() < 0.5 and Color3.fromRGB(255, 140, 50) or c, Enum.Material.Neon, Enum.PartType.Ball, 0.2)
			f.Position = base + look * 1.5
			tween(f, 0.35, { Position = base + look * (3 + math.random() * 3) + right * (math.random() * 4 - 2) + up * math.random() * 2, Size = Vector3.new(0.1, 0.1, 0.1), Transparency = 1 })
			Debris:AddItem(f, 0.4)
		end
	elseif kind == "basic" then
		-- 삼재: 바른 주먹이 공기를 꿰뚫는 세 겹 고리
		for i = 1, 3 do
			task.delay(i * 0.03, function()
				Fx.ring(base + look * (1.5 + i * 1.2), i == 2 and c2 or c, 0.5, (2 + i) * s, 0.18, look)
			end)
		end
	elseif kind == "void" then
		-- 무극: 앞이 한 점으로 빨려 들었다가 터진다
		local p0 = base + look * 4
		local hole = piece(Vector3.new(4, 4, 4) * s, Color3.new(0, 0, 0), Enum.Material.SmoothPlastic, Enum.PartType.Ball, 0.2)
		hole.Position = p0
		tween(hole, 0.12, { Size = Vector3.new(0.3, 0.3, 0.3) })
		task.delay(0.12, function()
			hole:Destroy()
			Fx.ring(p0, c2, 0.5, 10 * s, 0.3, look)
			Fx.ring(p0, c, 0.5, 6 * s, 0.25)
		end)
		Debris:AddItem(hole, 0.2)
	elseif kind == "cosmic" then
		-- 개천: 주먹을 따라 나선으로 감기는 별빛
		for i = 1, 8 do
			local a = i * 0.9
			local st = piece(Vector3.new(0.45, 0.45, 0.45) * s, i % 2 == 0 and c or c2, Enum.Material.Neon, Enum.PartType.Ball, 0)
			st.Position = base + look * 1.5
			local p = base + look * (1.5 + i * 0.7 * s) + right * math.cos(a) * 1.1 + up * math.sin(a) * 1.1
			task.delay(i * 0.01, function()
				tween(st, 0.15, { Position = p })
				task.delay(0.15, function()
					tween(st, 0.25, { Transparency = 1, Size = Vector3.new(0.1, 0.1, 0.1) })
				end)
			end)
			Debris:AddItem(st, 0.45)
		end
		if heavy then
			Fx.ring(base + look * 5, c2, 1, 9, 0.25, look)
		end
	elseif kind == "blood" then
		-- 혈마: 핏빛 세 갈래 손톱 자국
		for i = -1, 1 do
			local bar = piece(Vector3.new(0.18, 0.18, 4.5 * s), i == 0 and c2 or c, Enum.Material.Neon, nil, 0.05)
			bar.CFrame = lookAt(base + look * 3.2 + right * i * 0.7, base + look * 4.2 + right * i * 0.7) * CFrame.Angles(0, 0, math.rad(60)) * CFrame.Angles(math.rad(90), 0, 0)
			tween(bar, 0.28, { Size = Vector3.new(0.04, 0.04, 6 * s), Transparency = 1 })
			Debris:AddItem(bar, 0.3)
		end
	end
end

-- 권법마다 손에 맺힌 기운 (쓰는 권법이 바뀌면 바뀐다, 각성하면 짙어진다)
local HAND_FX = {
	water = { tex = "rbxasset://textures/particles/sparkles_main.dds", speed = 1.5, life = 0.6, size = 0.35 },
	gold = { tex = "rbxasset://textures/particles/sparkles_main.dds", speed = 2, life = 0.5, size = 0.4 },
	petal = { tex = "rbxasset://textures/particles/sparkles_main.dds", speed = 2.5, life = 0.9, size = 0.3 },
	dragon = { tex = "rbxasset://textures/particles/fire_main.dds", speed = 2, life = 0.45, size = 0.5 },
	shadow = { tex = "rbxasset://textures/particles/smoke_main.dds", speed = 1, life = 0.7, size = 0.6 },
	lightning = { tex = "rbxasset://textures/particles/sparkles_main.dds", speed = 6, life = 0.15, size = 0.3 },
	drunk = { tex = "rbxasset://textures/particles/fire_main.dds", speed = 1.5, life = 0.5, size = 0.4 },
	basic = { tex = "rbxasset://textures/particles/sparkles_main.dds", speed = 1, life = 0.4, size = 0.2 },
	void = { tex = "rbxasset://textures/particles/smoke_main.dds", speed = 0.6, life = 1, size = 0.7 },
	blood = { tex = "rbxasset://textures/particles/smoke_main.dds", speed = 1.2, life = 0.6, size = 0.5 },
	cosmic = { tex = "rbxasset://textures/particles/sparkles_main.dds", speed = 2, life = 1, size = 0.35 },
}
function Fx.styleHands(model: Model, styleId: any, tier: number)
	for _, d in ipairs(model:GetDescendants()) do
		if d.Name == "KwonStyleHand" then
			d:Destroy()
		end
	end
	local style = styleOf(styleId)
	local h = style and HAND_FX[style.fx]
	if not style or not h then
		return
	end
	for _, side in ipairs({ "RightHand", "LeftHand", "Right Arm", "Left Arm" }) do
		local hand = model:FindFirstChild(side)
		if hand and hand:IsA("BasePart") then
			local e = Instance.new("ParticleEmitter")
			e.Name = "KwonStyleHand"
			e.Texture = h.tex
			e.Color = ColorSequence.new(style.color, style.color2)
			e.LightEmission = style.fx == "shadow" and 0 or 1
			e.Transparency = NumberSequence.new(0.3, 1)
			e.Size = NumberSequence.new(h.size * (1 + tier * 0.4), 0)
			e.Lifetime = NumberRange.new(h.life * 0.7, h.life)
			e.Speed = NumberRange.new(h.speed * 0.5, h.speed)
			e.SpreadAngle = Vector2.new(180, 180)
			e.Rate = 6 + tier * 10
			e.Parent = hand
		end
	end
end

-- 휘두를 때마다 앞에 터지는 바람 (빗나가도 보인다)
function Fx.swing(styleId: any, model: Model, heavy: boolean)
	local r = rootPart(model)
	if not r then
		return
	end
	local style = styleOf(styleId)
	local c = style and style.color or Color3.fromRGB(240, 240, 255)
	local look = r.CFrame.LookVector
	local pos = r.Position + look * 3.5 + Vector3.new(0, 0.6, 0)
	Fx.ring(pos, c, 1, heavy and 9 or 5, heavy and 0.28 or 0.18, look)
	local arc = piece(Vector3.new(heavy and 5 or 3.4, 0.15, 1.2), c, Enum.Material.Neon, nil, 0.25)
	arc.CFrame = lookAt(pos, pos + look) * CFrame.Angles(0, 0, math.random() * math.pi)
	tween(arc, 0.18, { Size = Vector3.new(heavy and 9 or 6, 0.05, 0.3), Transparency = 1 })
	Debris:AddItem(arc, 0.2)
	if style then
		flourish(style, r, heavy)
	end
end

function Fx.cast(styleId: any, slot: any, model: Model, dur: number)
	local style = styleOf(styleId)
	local r = rootPart(model)
	if not style or not r or slot == "G" or type(slot) == "number" then
		return
	end
	local c, c2 = style.color, style.color2
	local pos = r.Position
	local look = Vector3.new(r.CFrame.LookVector.X, 0, r.CFrame.LookVector.Z)
	look = look.Magnitude > 0.01 and look.Unit or Vector3.new(0, 0, -1)
	local feet = pos - Vector3.new(0, 2.6, 0)
	-- 공통: 발밑 고리와 몸의 기운
	Fx.ring(feet + Vector3.new(0, 0.2, 0), c, 2, slot == "H" and 12 or 16, 0.45)
	flare(pos, c, slot == "H" and 2.5 or 3.5)
	Fx.sound("swing", 0.5, slot == "H" and 0.7 or 0.55)
	-- 각성한 기술: 금빛 (완전 각성은 흰빛) 고리가 한 겹 더, 머리 위에 覺
	local tier = tonumber(model:GetAttribute("Awaken")) or 0
	if tier >= 1 then
		local glow = tier >= 2 and Color3.fromRGB(255, 250, 235) or Color3.fromRGB(255, 210, 90)
		Fx.ring(feet + Vector3.new(0, 0.3, 0), glow, 3, slot == "H" and 18 or 24, 0.55)
		flare(pos + Vector3.new(0, 1, 0), c2, 2.5)
		Fx.text(pos + Vector3.new(0, 4.2, 0), tier >= 2 and "✦✦" or "✦", glow, 22, 0.6)
	end
	-- 각성 마무리: 땅에서 솟는 기둥과 하늘로 치솟는 고리
	if slot == "F" then
		task.delay(0.24, function()
			local column = piece(Vector3.new(4, 1, 4), c, Enum.Material.Neon, nil, 0.25)
			local at = pos + look * 4 - Vector3.new(0, 2.5, 0)
			column.Position = at
			tween(column, 0.3, { Size = Vector3.new(1.2, 34, 1.2), Position = at + Vector3.new(0, 17, 0), Transparency = 1 })
			Debris:AddItem(column, 0.35)
			for k = 0, 2 do
				task.delay(k * 0.06, function()
					Fx.ring(at + Vector3.new(0, 2 + k * 4, 0), k == 1 and c2 or c, 2, 10 - k * 2, 0.35)
				end)
			end
			Fx.dust(at, 3)
		end)
		return
	elseif slot == "J" then
		Fx.ring(pos, c, 1, 8, 0.25, look)
		return
	end
	local fx = style.fx
	local key = fx .. ":" .. tostring(slot)

	if key == "water:H" then
		-- 앞으로 밀려가는 물결 벽
		task.delay(0.25, function()
			for k = 0, 2 do
				task.delay(k * 0.06, function()
					Fx.ring(pos + look * (4 + k * 3), c2, 2, 12 + k * 3, 0.35, look)
				end)
			end
		end)
	elseif key == "water:E" then
		-- 몸을 감싸고 도는 물의 띠 두 줄 (받아넘기기 자세)
		local parts = {}
		for i = 1, 10 do
			table.insert(parts, piece(Vector3.new(0.9, 0.9, 0.9), i % 2 == 0 and c or c2, Enum.Material.Neon, Enum.PartType.Ball, 0.2))
		end
		follow(model, dur + 0.3, parts, function(t, cf)
			local out = {}
			for i = 1, 10 do
				local a = t * 9 + i / 10 * math.pi * 2
				local y = (i % 2 == 0) and 0.8 or -0.8
				out[i] = cf * CFrame.new(math.cos(a) * 3.4, y + math.sin(a * 2) * 0.4, math.sin(a) * 3.4)
			end
			return out
		end)
	elseif key == "water:R" then
		-- 안으로 말려드는 소용돌이
		local parts = {}
		for i = 1, 16 do
			table.insert(parts, piece(Vector3.new(1.4, 1.4, 1.4), c:Lerp(c2, i / 16), Enum.Material.Neon, Enum.PartType.Ball, 0.25))
		end
		follow(model, dur, parts, function(t, cf)
			local out = {}
			for i = 1, 16 do
				local a = t * 8 + i / 16 * math.pi * 2
				local rad = math.max(2, 14 - t * 14) + (i % 3)
				out[i] = CFrame.new(cf.Position + Vector3.new(math.cos(a) * rad, -1.5 + (i % 4) * 0.8, math.sin(a) * rad))
			end
			return out
		end)
		for k = 0, 3 do
			task.delay(k * 0.2, function()
				Fx.ring(feet + Vector3.new(0, 0.3, 0), c2, 24, 4, 0.3)
			end)
		end
	elseif key == "gold:H" then
		-- 금빛 손바닥이 앞으로 날아간다
		task.delay(0.35, function()
			local palm = piece(Vector3.new(6, 7, 0.6), c, Enum.Material.Neon, nil, 0.2)
			local from = pos + look * 2
			palm.CFrame = lookAt(from, from + look)
			tween(palm, 0.3, { CFrame = lookAt(from + look * 12, from + look * 13), Size = Vector3.new(9, 10, 0.3), Transparency = 1 })
			Debris:AddItem(palm, 0.35)
			Fx.ring(from + look * 3, c2, 3, 16, 0.4, look)
		end)
	elseif key == "gold:E" then
		-- 금빛 갑옷: 발에서 머리로 오르는 고리 셋, 몸을 감싸는 금빛 껍질
		for k = 0, 2 do
			task.delay(k * 0.1, function()
				local ring = piece(Vector3.new(0.3, 6, 6), c, Enum.Material.Neon, Enum.PartType.Cylinder, 0.2)
				ring.CFrame = CFrame.new(feet) * CFrame.Angles(0, 0, math.rad(90))
				tween(ring, 0.4, { CFrame = CFrame.new(feet + Vector3.new(0, 6, 0)) * CFrame.Angles(0, 0, math.rad(90)), Transparency = 1 })
				Debris:AddItem(ring, 0.45)
			end)
		end
		Fx.aura(model, c, 6)
	elseif key == "gold:R" then
		-- 사자후: 앞으로 퍼지는 소리 고리와 땅을 휩쓰는 큰 충격파
		for k = 0, 4 do
			task.delay(0.15 + k * 0.08, function()
				Fx.ring(pos + look * (3 + k * 3), c, 3, 10 + k * 4, 0.35, look)
			end)
		end
		task.delay(0.2, function()
			Fx.ring(feet + Vector3.new(0, 0.3, 0), c, 4, 44, 0.6)
			Fx.ring(feet + Vector3.new(0, 0.4, 0), c2, 2, 30, 0.5)
			Fx.dust(feet, 5)
		end)
	elseif key == "petal:H" or key == "petal:R" then
		-- 지나간 길에 남는 매화빛 칼금과 꽃잎
		local lunge = slot == "R" and 22 or 14
		task.delay(0.12, function()
			streak(pos, pos + look * lunge, c, 1.6, 0.5)
			streak(pos + Vector3.new(0, 1, 0), pos + look * lunge + Vector3.new(0, 1, 0), c2, 0.7, 0.4)
			for k = 0, 5 do
				local p = pos + look * (lunge * k / 5)
				for _ = 1, 3 do
					local petal = piece(Vector3.new(0.8, 0.08, 0.6), math.random() < 0.5 and c or c2, Enum.Material.SmoothPlastic)
					petal.CFrame = CFrame.new(p) * CFrame.Angles(math.random() * 6, math.random() * 6, 0)
					tween(petal, 1, { CFrame = CFrame.new(p + Vector3.new(math.random() * 4 - 2, -2, math.random() * 4 - 2)) * CFrame.Angles(math.random() * 6, 0, math.random() * 6), Transparency = 1 })
					Debris:AddItem(petal, 1.05)
				end
			end
		end)
		if slot == "R" then
			for k = 1, 3 do
				task.delay(k * 0.07, function()
					Fx.afterimage(model, c, 0.4)
				end)
			end
		end
	elseif key == "petal:E" then
		-- 여덟 번의 번쩍임
		for k = 0, 7 do
			task.delay(0.08 + k * dur / 9, function()
				local rr = rootPart(model)
				if rr then
					local side = Vector3.new(-look.Z, 0, look.X) * (math.random() * 3 - 1.5)
					Fx.spark(rr.Position + rr.CFrame.LookVector * 3.5 + side + Vector3.new(0, math.random() * 2 - 0.5, 0), k % 2 == 0 and c or c2, 0.9, 4)
				end
			end)
		end
	elseif key == "dragon:H" or key == "dragon:E" then
		-- 두 손 앞에 모이는 용의 기운
		local orb = piece(Vector3.new(1, 1, 1), c, Enum.Material.Neon, Enum.PartType.Ball, 0.1)
		orb.Position = pos + look * 2.5
		tween(orb, dur * 0.4, { Size = Vector3.new(4, 4, 4), Transparency = 0.3 })
		task.delay(dur * 0.42, function()
			tween(orb, 0.12, { Size = Vector3.new(7, 7, 7), Transparency = 1 })
			Fx.ring(pos + look * 3, c2, 2, 14, 0.35, look)
		end)
		Debris:AddItem(orb, dur * 0.42 + 0.15)
	elseif key == "dragon:R" then
		-- 몸을 휘감으며 같이 솟구치는 용
		local parts = {}
		for i = 1, 10 do
			table.insert(parts, piece(Vector3.new(1, 1, 1) * (2.4 - i * 0.15), c:Lerp(c2, i / 10), Enum.Material.Neon, Enum.PartType.Ball, 0.2))
		end
		follow(model, dur + 0.2, parts, function(t, cf)
			local out = {}
			for i = 1, 10 do
				local k = math.max(0, t - i * 0.03)
				local a = k * 14
				out[i] = CFrame.new(cf.Position + Vector3.new(math.cos(a) * 3, -2 + k * 4 - i * 0.4, math.sin(a) * 3))
			end
			return out
		end)
		local column = piece(Vector3.new(3, 1, 3), c, Enum.Material.Neon, nil, 0.3)
		column.Position = feet
		tween(column, 0.3, { Size = Vector3.new(1.5, 40, 1.5), Position = feet + Vector3.new(0, 20, 0), Transparency = 1 })
		Debris:AddItem(column, 0.35)
	elseif key == "shadow:H" then
		for k = 1, 4 do
			task.delay(k * 0.06, function()
				Fx.afterimage(model, Color3.fromRGB(70, 40, 120), 0.45)
			end)
		end
		task.delay(0.1, function()
			streak(pos, pos + look * 12, Color3.fromRGB(60, 30, 100), 1.4, 0.45)
		end)
	elseif key == "shadow:E" then
		-- 사라지는 자리에 검은 연기
		for _ = 1, 8 do
			local smoke = piece(Vector3.new(1, 1, 1) * (2 + math.random()), Color3.fromRGB(25, 12, 45), Enum.Material.SmoothPlastic, Enum.PartType.Ball, 0.2)
			smoke.Position = pos + Vector3.new(math.random() * 3 - 1.5, math.random() * 3 - 1.5, math.random() * 3 - 1.5)
			tween(smoke, 0.7, { Size = smoke.Size * 3, Transparency = 1 })
			Debris:AddItem(smoke, 0.75)
		end
	elseif key == "shadow:R" then
		-- 몸을 둘러싼 검보랏빛 회오리 고리
		local parts = {}
		for i = 1, 3 do
			table.insert(parts, piece(Vector3.new(0.25, 7 + i, 7 + i), c, Enum.Material.Neon, Enum.PartType.Cylinder, 0.35))
		end
		follow(model, dur, parts, function(t, cf)
			local out = {}
			for i = 1, 3 do
				out[i] = CFrame.new(cf.Position) * CFrame.Angles(t * 12 + i, t * 9 + i * 2, 0)
			end
			return out
		end)
	elseif key == "lightning:H" or key == "lightning:E" then
		local lunge = slot == "E" and 20 or 18
		task.delay(0.08, function()
			local prev = pos
			for k = 1, 5 do
				local side = Vector3.new(-look.Z, 0, look.X) * ((k % 2 == 0) and 2.5 or -2.5)
				local p = pos + look * (lunge * k / 5) + (slot == "E" and side or Vector3.zero)
				Fx.lightning(prev, p, c, 0.5)
				prev = p
			end
			Fx.spark(pos + look * lunge, c2, 1.6, 8)
		end)
	elseif key == "lightning:R" then
		-- 하늘을 가리키면 주변에 벼락이 내리꽂힌다
		local orb = piece(Vector3.new(1.5, 1.5, 1.5), c2, Enum.Material.Neon, Enum.PartType.Ball, 0)
		orb.Position = pos + Vector3.new(0, 4, 0)
		tween(orb, 0.3, { Size = Vector3.new(3, 3, 3), Transparency = 0.4 })
		Debris:AddItem(orb, 0.4)
		for k = 0, 5 do
			task.delay(0.3 + k * 0.07, function()
				local a = math.random() * math.pi * 2
				local p = feet + Vector3.new(math.cos(a), 0, math.sin(a)) * math.random(4, 16)
				Fx.lightning(p + Vector3.new(0, 55, 0), p, c, 0.7)
				Fx.ring(p + Vector3.new(0, 0.3, 0), c, 1, 8, 0.3)
			end)
		end
	elseif key == "drunk:H" then
		task.delay(0.25, function()
			for _ = 1, 10 do
				local drop = piece(Vector3.new(0.5, 0.5, 0.5), Color3.fromRGB(255, 160, 60), Enum.Material.Neon, Enum.PartType.Ball, 0.1)
				drop.Position = pos + look * 3
				tween(drop, 0.45, { Position = pos + look * 3 + Vector3.new(math.random() * 8 - 4, math.random() * 5, math.random() * 8 - 4), Transparency = 1 })
				Debris:AddItem(drop, 0.5)
			end
			Fx.ring(pos + look * 3, c, 2, 12, 0.35, look)
		end)
	elseif key == "drunk:E" then
		Fx.aura(model, c, 3)
	elseif key == "drunk:R" then
		-- 여덟 신선의 빛이 몸 둘레를 돈다
		local parts = {}
		for i = 1, 8 do
			table.insert(parts, piece(Vector3.new(1.3, 1.3, 1.3), i % 2 == 0 and c or c2, Enum.Material.Neon, Enum.PartType.Ball, 0.1))
		end
		follow(model, dur, parts, function(t, cf)
			local out = {}
			for i = 1, 8 do
				local a = t * 10 + i / 8 * math.pi * 2
				out[i] = CFrame.new(cf.Position + Vector3.new(math.cos(a) * 6, math.sin(t * 6 + i) * 1.5, math.sin(a) * 6))
			end
			return out
		end)
		for k = 0, 3 do
			task.delay(k * 0.25, function()
				Fx.ring(feet + Vector3.new(0, 0.3, 0), c, 3, 18, 0.35)
			end)
		end
	elseif key == "basic:H" then
		-- 정권: 주먹 끝에서 공기가 세 겹으로 터진다
		task.delay(0.28, function()
			for k = 0, 2 do
				task.delay(k * 0.04, function()
					Fx.ring(pos + look * (3 + k * 2), k == 1 and c2 or c, 1, 7 + k * 3, 0.3, look)
				end)
			end
		end)
	elseif key == "basic:E" then
		task.delay(0.2, function()
			streak(pos - look * 6, pos + look * 3, c, 1.2, 0.3)
		end)
	elseif key == "basic:R" then
		for k = 0, 2 do
			task.delay(0.15 + k * 0.2, function()
				Fx.ring(pos + look * 3, c, 1, 8, 0.25, look)
				Fx.spark(pos + look * 3, c2, 1, 5)
			end)
		end
	elseif key == "void:H" then
		-- 무극장: 앞이 한 점으로 꺼졌다가 크게 터진다
		task.delay(0.3, function()
			local p0 = pos + look * 5
			local hole = piece(Vector3.new(8, 8, 8), Color3.new(0, 0, 0), Enum.Material.SmoothPlastic, Enum.PartType.Ball, 0.2)
			hole.Position = p0
			tween(hole, 0.12, { Size = Vector3.new(0.4, 0.4, 0.4) })
			Debris:AddItem(hole, 0.13)
			task.delay(0.12, function()
				Fx.ring(p0, Color3.new(1, 1, 1), 1, 22, 0.4, look)
				Fx.ring(p0, c, 1, 14, 0.35)
			end)
		end)
	elseif key == "void:E" then
		-- 허공격: 손가락 끝에서 하얀 선이 멀리 꿰뚫는다
		task.delay(0.2, function()
			streak(pos + look * 2, pos + look * 32, Color3.new(1, 1, 1), 0.8, 0.4)
			streak(pos + look * 2, pos + look * 32, c, 2, 0.3)
		end)
	elseif key == "void:R" then
		-- 무극회선: 둘레의 빛이 빨려 들었다 터진다
		for k = 0, 11 do
			local a = k / 12 * math.pi * 2
			local m = piece(Vector3.new(1, 1, 1), k % 2 == 0 and c or Color3.new(1, 1, 1), Enum.Material.Neon, Enum.PartType.Ball, 0.1)
			m.Position = pos + Vector3.new(math.cos(a) * 14, 0, math.sin(a) * 14)
			tween(m, dur * 0.7, { Position = pos, Size = Vector3.new(0.2, 0.2, 0.2) }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
			Debris:AddItem(m, dur * 0.7)
		end
		task.delay(dur * 0.75, function()
			Fx.ring(feet + Vector3.new(0, 0.3, 0), c, 2, 30, 0.45)
			Fx.ring(pos, Color3.new(1, 1, 1), 2, 22, 0.4)
		end)
	elseif key == "blood:H" then
		-- 혈수천강: 두 손이 내리꽂힌 자리에 피의 웅덩이와 가시
		task.delay(0.32, function()
			local at = feet + look * 4
			Fx.ring(at + Vector3.new(0, 0.3, 0), c, 2, 20, 0.45)
			for k = 0, 7 do
				local a = k / 8 * math.pi * 2
				local p = at + Vector3.new(math.cos(a) * 4, 0, math.sin(a) * 4)
				local spike = piece(Vector3.new(0.6, 0.5, 0.6), c, Enum.Material.Neon, nil, 0)
				spike.CFrame = CFrame.new(p) * CFrame.Angles(math.cos(a) * 0.4, 0, math.sin(a) * 0.4)
				tween(spike, 0.15, { Size = Vector3.new(0.6, 5, 0.6) })
				task.delay(0.2, function()
					tween(spike, 0.3, { Transparency = 1 })
				end)
				Debris:AddItem(spike, 0.55)
			end
		end)
	elseif key == "blood:E" then
		-- 혈영보: 지나간 길에 핏빛 잔상
		task.delay(0.1, function()
			streak(pos, pos + look * 24, c, 2.2, 0.45)
			Fx.afterimage(model, c, 0.5)
		end)
	elseif key == "blood:R" then
		-- 혈해: 둘레로 피의 바다가 퍼진다
		task.delay(0.28, function()
			local sea = piece(Vector3.new(0.3, 4, 4), c, Enum.Material.Neon, Enum.PartType.Cylinder, 0.3)
			sea.CFrame = CFrame.new(feet + Vector3.new(0, 0.2, 0)) * CFrame.Angles(0, 0, math.rad(90))
			tween(sea, 0.35, { Size = Vector3.new(0.3, 28, 28) })
			task.delay(0.5, function()
				tween(sea, 0.4, { Transparency = 1 })
			end)
			Debris:AddItem(sea, 1)
			for _ = 1, 16 do
				local d = piece(Vector3.new(0.5, 0.5, 0.5), c2, Enum.Material.Neon, Enum.PartType.Ball, 0.1)
				d.Position = feet + Vector3.new(math.random() * 20 - 10, 0.5, math.random() * 20 - 10)
				tween(d, 0.5, { Position = d.Position + Vector3.new(0, math.random() * 6 + 2, 0), Transparency = 1 })
				Debris:AddItem(d, 0.55)
			end
		end)
	elseif key == "cosmic:H" then
		-- 개천일도: 손날이 지나간 자리에 하늘까지 닿는 금
		task.delay(0.36, function()
			local at = feet + look * 6
			local slash = piece(Vector3.new(0.5, 40, 3), c2, Enum.Material.Neon, nil, 0.05)
			slash.CFrame = CFrame.lookAt(at + Vector3.new(0, 20, 0), at + Vector3.new(0, 20, 0) + look)
			tween(slash, 0.45, { Size = Vector3.new(0.1, 60, 0.4), Transparency = 1 })
			Debris:AddItem(slash, 0.5)
			Fx.ring(at + Vector3.new(0, 0.3, 0), c, 2, 22, 0.45)
			streak(at - look * 4, at + look * 14, c, 1.4, 0.4)
		end)
	elseif key == "cosmic:E" then
		-- 유성추: 솟을 때 별빛 꼬리, 떨어진 자리에 별이 터진다
		local trail = {}
		for i = 1, 6 do
			table.insert(trail, piece(Vector3.new(1, 1, 1) * (1.4 - i * 0.15), i % 2 == 0 and c or c2, Enum.Material.Neon, Enum.PartType.Ball, 0.1))
		end
		follow(model, dur * 0.7, trail, function(t, cf)
			local out = {}
			for i = 1, 6 do
				out[i] = CFrame.new(cf.Position + Vector3.new(0, -i * 0.8, 0) + cf.LookVector * (-i * 0.4) + Vector3.new(math.sin(t * 20 + i), 0, math.cos(t * 20 + i)) * 0.3)
			end
			return out
		end)
		task.delay(dur * 0.72, function()
			local rr = rootPart(model)
			if rr then
				Fx.starfall(rr.Position, styleId)
			end
		end)
	elseif key == "cosmic:R" then
		-- 낙성우: 별비
		for k = 0, 5 do
			task.delay(0.3 + k * 0.11, function()
				local a = math.random() * math.pi * 2
				Fx.starfall(pos + Vector3.new(math.cos(a), 0, math.sin(a)) * math.random(3, 15), styleId)
			end)
		end
	end
end

-- 흘리기의 빛: 흘린 손이 지나간 반원을 따라 빛이 흐르고, 물결처럼 퍼진다
function Fx.parryArc(model: Model, side: number, color: Color3)
	local r = rootPart(model)
	if not r then
		return
	end
	local cf = r.CFrame * CFrame.new(0, 0.6, 0)
	local n = 9
	for i = 0, n - 1 do
		task.delay(i * 0.018, function()
			local a0 = math.rad(-35 + i * 15) * side
			local a1 = math.rad(-35 + (i + 1) * 15) * side
			local p0 = (cf * CFrame.new(math.sin(a0) * 3.4, i * 0.06, -math.cos(a0) * 3.4)).Position
			local p1 = (cf * CFrame.new(math.sin(a1) * 3.4, (i + 1) * 0.06, -math.cos(a1) * 3.4)).Position
			local seg = piece(Vector3.new(0.5, 0.18, (p1 - p0).Magnitude + 0.3), i % 3 == 0 and Color3.new(1, 1, 1) or color, Enum.Material.Neon, nil, 0.05)
			seg.CFrame = lookAt((p0 + p1) / 2, p1)
			tween(seg, 0.35, { Size = Vector3.new(0.05, 0.05, seg.Size.Z * 1.3), Transparency = 1 })
			Debris:AddItem(seg, 0.4)
		end)
	end
	-- 흘려 보낸 쪽으로 퍼지는 물결 고리
	local out = (cf * CFrame.new(side * 3, 0, -1)).Position
	Fx.ring(out, color, 1, 9, 0.4, r.CFrame.RightVector * side)
	Fx.ring(r.Position - Vector3.new(0, 2.5, 0), color, 2, 10, 0.4)
end

-- 그림자 메아리 (완전 각성): 흰 그림자가 같은 기술을 한 번 더 그려 낸다
function Fx.echo(model: Model, styleId: any, slot: any, dur: number)
	local style = styleOf(styleId)
	local c2 = style and style.color2 or Color3.new(1, 1, 1)
	Fx.text((rootPart(model) or { Position = Vector3.zero } :: any).Position + Vector3.new(0, 5.5, 0), "메아리", c2, 26, 0.8)
	for k = 0, 5 do
		task.delay(k * dur / 6, function()
			if model.Parent then
				Fx.afterimage(model, k % 2 == 0 and c2 or (style and style.color or c2), 0.4)
			end
		end)
	end
	Fx.cast(styleId, slot, model, dur)
end

-- 각성의 기운: 몸에서 빛 조각이 피어오른다 (완전 각성은 둘레에 빛 고리도)
local auras: { [Model]: { tier: number, parts: { Instance } } } = {}
function Fx.awakenAura(model: Model, tier: number, color: Color3)
	local cur = auras[model]
	if cur and cur.tier == tier then
		return
	end
	if cur then
		for _, p in ipairs(cur.parts) do
			p:Destroy()
		end
		auras[model] = nil
	end
	local r = rootPart(model)
	if tier <= 0 or not r then
		return
	end
	local parts: { Instance } = {}
	local att = Instance.new("Attachment")
	att.Name = "AwakenAura"
	att.Position = Vector3.new(0, -1, 0)
	att.Parent = r
	table.insert(parts, att)
	local e = Instance.new("ParticleEmitter")
	e.Rate = tier >= 2 and 22 or 10
	e.Color = ColorSequence.new(color, tier >= 2 and Color3.new(1, 1, 1) or color)
	e.LightEmission = 1
	e.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, tier >= 2 and 0.5 or 0.35), NumberSequenceKeypoint.new(1, 0) })
	e.Transparency = NumberSequence.new(0.1, 1)
	e.Lifetime = NumberRange.new(0.8, 1.4)
	e.Speed = NumberRange.new(2, 5)
	e.SpreadAngle = Vector2.new(40, 40)
	e.EmissionDirection = Enum.NormalId.Top
	e.Shape = Enum.ParticleEmitterShape.Cylinder
	e.ShapeStyle = Enum.ParticleEmitterShapeStyle.Surface
	e.Parent = att
	table.insert(parts, e)
	if tier >= 2 then
		local ring = piece(Vector3.new(0.15, 7, 7), color, Enum.Material.Neon, Enum.PartType.Cylinder, 0.55)
		table.insert(parts, ring)
		local start = os.clock()
		local conn: RBXScriptConnection
		conn = RunService.RenderStepped:Connect(function()
			local rr = rootPart(model)
			if not ring.Parent or not rr then
				conn:Disconnect()
				return
			end
			local t = os.clock() - start
			ring.CFrame = CFrame.new(rr.Position - Vector3.new(0, 2.6, 0)) * CFrame.Angles(0, t * 2, math.rad(90))
		end)
	end
	auras[model] = { tier = tier, parts = parts }
end

-- 몸을 감싸는 은은한 기운 (철포삼, 취보처럼 오래 가는 기술)
function Fx.aura(model: Model, color: Color3, dur: number)
	local shell = piece(Vector3.new(7, 7, 7), color, Enum.Material.ForceField, Enum.PartType.Ball, 0)
	local sparks = {}
	for _ = 1, 4 do
		table.insert(sparks, piece(Vector3.new(0.5, 0.5, 0.5), color, Enum.Material.Neon, Enum.PartType.Ball, 0))
	end
	local parts = { shell, table.unpack(sparks) }
	follow(model, dur, parts, function(t, cf)
		local out = { CFrame.new(cf.Position) }
		for i = 1, 4 do
			local a = t * 4 + i / 4 * math.pi * 2
			out[i + 1] = CFrame.new(cf.Position + Vector3.new(math.cos(a) * 3, ((t * 2 + i * 0.25) % 1) * 6 - 3, math.sin(a) * 3))
		end
		return out
	end, 0.4)
end

------------------------------------------------------------------------
-- 히트스톱: 맞은 순간 둘 다 멈칫. 내 몸이면 아주 잠깐 굳힌다
------------------------------------------------------------------------
local Anim: any = nil
function Fx.bindAnim(a: any)
	Anim = a
end

function Fx.hitstop(models: { Model }, secs: number)
	local me = Players.LocalPlayer.Character
	for _, m in ipairs(models) do
		if Anim then
			Anim.freeze(m, secs)
		end
		if m == me then
			local root = m:FindFirstChild("HumanoidRootPart")
			if root and root:IsA("BasePart") and not root.Anchored then
				local vel = root.AssemblyLinearVelocity
				root.Anchored = true
				task.delay(secs, function()
					if root.Parent then
						root.Anchored = false
						root.AssemblyLinearVelocity = vel
					end
				end)
			end
		end
	end
end

------------------------------------------------------------------------
-- 기술 장치 연출 (서버가 알려 준다): 소용돌이, 붉은 원, 내리찍기, 기둥, 시간 멈춤 ...
------------------------------------------------------------------------
local function groundDisc(at: Vector3, radius: number, color: Color3, trans: number, h: number?): Part
	local d = piece(Vector3.new(h or 0.2, radius * 2, radius * 2), color, Enum.Material.Neon, Enum.PartType.Cylinder, trans)
	d.CFrame = CFrame.new(at.X, at.Y - 2.4, at.Z) * CFrame.Angles(0, 0, math.rad(90))
	return d
end
local function fadeAfter(p: Instance, t: number, life: number)
	task.delay(t, function()
		if p.Parent then
			tween(p, life, { Transparency = 1 })
		end
	end)
	Debris:AddItem(p, t + life + 0.05)
end

function Fx.mech(data: any)
	local style = styleOf(data.style)
	local c = data.color or (style and style.color) or Color3.fromRGB(255, 230, 180)
	local c2 = data.color and data.color:Lerp(Color3.new(1, 1, 1), 0.5) or (style and style.color2) or Color3.new(1, 1, 1)
	local kind = data.kind
	if kind == "zone" then
		local at, r, dur = data.at, data.radius, data.dur
		local disc = groundDisc(at, 1, c, 0.55)
		tween(disc, 0.25, { Size = Vector3.new(0.2, r * 2, r * 2) })
		fadeAfter(disc, dur, 0.3)
		local rim = groundDisc(at, r, c2, 0.3, 0.35)
		fadeAfter(rim, dur, 0.3)
		-- 둘레를 도는 조각 (물방울 / 핏방울 / 검은 티끌)
		local mat = data.fx == "water" and Enum.Material.Glass or Enum.Material.Neon
		local bits = {}
		for i = 1, 16 do
			local b = piece(Vector3.new(1, 1, 1) * (data.fx == "void" and 0.7 or 1), i % 2 == 0 and c or c2, mat, Enum.PartType.Ball, 0.15)
			table.insert(bits, b)
		end
		local start = os.clock()
		local conn: RBXScriptConnection
		conn = RunService.RenderStepped:Connect(function()
			local t = os.clock() - start
			for i, b in ipairs(bits) do
				local k = (i / #bits + t * 0.35) % 1
				local rr = data.fx == "blood" and r * (0.3 + 0.7 * ((i * 0.37) % 1)) or r * (1 - k)
				local a = i * 0.9 + t * (data.fx == "blood" and 1 or 5)
				local y = data.fx == "blood" and ((t * 2 + i * 0.3) % 1) * 5 or k * 3
				b.Position = Vector3.new(at.X + math.cos(a) * rr, at.Y - 2 + y, at.Z + math.sin(a) * rr)
			end
			if t > dur then
				conn:Disconnect()
				for _, b in ipairs(bits) do
					tween(b, 0.25, { Transparency = 1 })
					Debris:AddItem(b, 0.3)
				end
			end
		end)
		Fx.ring(at - Vector3.new(0, 2.2, 0), c, 1, r * 2, 0.4)
	elseif kind == "reflect" then
		-- 물의 장막 (몸을 감싼 유리 구슬)
		local m = data.m
		local shell = piece(Vector3.new(9, 9, 9), c2, Enum.Material.Glass, Enum.PartType.Ball, 0.6)
		local band = piece(Vector3.new(0.4, 11, 11), c, Enum.Material.Neon, Enum.PartType.Cylinder, 0.4)
		follow(m, data.dur, { shell, band }, function(t, cf)
			return { CFrame.new(cf.Position), CFrame.new(cf.Position) * CFrame.Angles(t * 2, t * 3, math.rad(90)) }
		end, 0.3)
	elseif kind == "wave" then
		local at, r = data.at, data.radius
		for k = 0, 3 do
			task.delay(k * 0.07, function()
				Fx.ring(at - Vector3.new(0, 2 - k * 0.6, 0), k % 2 == 0 and c2 or c, 3, r * 2 + k * 6, 0.55)
			end)
		end
		local dome = piece(Vector3.new(6, 6, 6), c2, Enum.Material.Glass, Enum.PartType.Ball, 0.4)
		dome.Position = at
		tween(dome, 0.4, { Size = Vector3.new(r * 2, r * 0.8, r * 2), Transparency = 1 })
		Debris:AddItem(dome, 0.45)
	elseif kind == "cone" then
		local m = data.m
		local root = m and rootPart(m)
		if not root then
			return
		end
		local range, dur = data.range, data.dur or 0.4
		task.delay(data.delay or 0, function()
			if data.fx == "fire" then
				-- 불길이 앞쪽 부채꼴로 쏟아진다
				local n = math.max(6, math.floor(dur / 0.05))
				for k = 0, n - 1 do
					task.delay(k * dur / n, function()
						local r = rootPart(m)
						if not r then
							return
						end
						local look = r.CFrame.LookVector
						local side = r.CFrame.RightVector * (math.random() * 2 - 1) * math.tan(math.rad(data.angle / 2)) * range
						local from = r.Position + Vector3.new(0, 1.4, 0) + look * 1.5
						local ball = piece(Vector3.new(1.4, 1.4, 1.4), k % 3 == 0 and Color3.fromRGB(255, 230, 120) or Color3.fromRGB(255, 120, 30), Enum.Material.Neon, Enum.PartType.Ball, 0.1)
						ball.Position = from
						tween(ball, 0.4, { Position = from + look * range + side, Size = Vector3.new(5, 5, 5), Transparency = 1 })
						Debris:AddItem(ball, 0.45)
					end)
				end
			else
				-- 포효: 앞으로 퍼져 나가는 금빛 반달 고리
				for k = 0, 3 do
					task.delay(k * 0.06, function()
						local r = rootPart(m)
						if not r then
							return
						end
						local look = r.CFrame.LookVector
						Fx.ring(r.Position + look * (3 + k * range / 5), k % 2 == 0 and c or c2, 3, 8 + k * range * 0.35, 0.4, look)
					end)
				end
				Fx.dust(root.Position - Vector3.new(0, 2.5, 0), 4)
			end
		end)
	elseif kind == "telegraph" or kind == "mark" then
		-- 바닥의 원이 가운데부터 차오른다: 다 차면 떨어진다
		local at, r, time = data.at, data.radius, data.time or 1
		local rim = groundDisc(at, r, kind == "telegraph" and c or c2, 0.25, 0.3)
		local fill = groundDisc(at, 0.5, c, 0.55, 0.25)
		tween(fill, time, { Size = Vector3.new(0.25, r * 2, r * 2) }, Enum.EasingStyle.Linear)
		fadeAfter(rim, time, 0.15)
		fadeAfter(fill, time, 0.15)
	elseif kind == "lineTele" then
		-- 보스 돌진 길: 바닥에 붉은 띠가 차오른다
		local from, to, w, time = data.from, data.to, data.width or 8, data.time or 1
		local mid = (from + to) / 2
		local len = (to - from).Magnitude
		local cf = CFrame.lookAt(Vector3.new(mid.X, from.Y - 2.35, mid.Z), Vector3.new(to.X, from.Y - 2.35, to.Z))
		local rim = piece(Vector3.new(w, 0.25, len), c, Enum.Material.Neon, nil, 0.6)
		rim.CFrame = cf
		local fill = piece(Vector3.new(w, 0.3, 0.5), c, Enum.Material.Neon, nil, 0.35)
		fill.CFrame = cf * CFrame.new(0, 0, len / 2)
		tween(fill, time, { Size = Vector3.new(w, 0.3, len), CFrame = cf }, Enum.EasingStyle.Linear)
		fadeAfter(rim, time, 0.15)
		fadeAfter(fill, time, 0.15)
	elseif kind == "donut" then
		-- 보스에서 떨어진 고리: 안쪽은 안전 (보스 품으로 파고들어라)
		local at, r0, r1, time = data.at, data.inner, data.outer, data.time or 1
		local outer = groundDisc(at, r1, c, 0.55, 0.25)
		local safe = groundDisc(at, r0, Color3.fromRGB(120, 255, 160), 0.5, 0.3)
		local fill = groundDisc(at, r1, c, 0.8, 0.28)
		tween(fill, time, { Transparency = 0.3 }, Enum.EasingStyle.Linear)
		fadeAfter(outer, time, 0.15)
		fadeAfter(safe, time, 0.15)
		fadeAfter(fill, time, 0.15)
		Fx.text(at + Vector3.new(0, 3, 0), "안으로!", Color3.fromRGB(150, 255, 170), 28, 1)
	elseif kind == "drop" then
		-- 하늘에서 내리찍는 거대한 손바닥 (또는 그 권법의 빛)
		local at, r = data.at, data.radius
		local palm = piece(Vector3.new(r * 1.2, 2, r * 1.5), c, Enum.Material.Neon, nil, 0.2)
		palm.CFrame = CFrame.new(at + Vector3.new(0, 60, 0))
		tween(palm, 0.14, { CFrame = CFrame.new(at + Vector3.new(0, -1, 0)) }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
		fadeAfter(palm, 0.2, 0.5)
		for i = -2, 2 do
			local fg = piece(Vector3.new(r * 0.18, 1.6, r * 0.6), c2, Enum.Material.Neon, nil, 0.25)
			fg.CFrame = CFrame.new(at + Vector3.new(i * r * 0.22, 60, -r * 1.0))
			tween(fg, 0.14, { CFrame = CFrame.new(at + Vector3.new(i * r * 0.22, -1, -r * 1.0)) }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
			fadeAfter(fg, 0.2, 0.5)
		end
		task.delay(0.14, function()
			beam(at - Vector3.new(0, 2.4, 0), c2, r * 0.6, 100, 0.5)
			Fx.ring(at - Vector3.new(0, 2.2, 0), c, 3, r * 4, 0.6)
			Fx.ring(at - Vector3.new(0, 2.1, 0), c2, 2, r * 2.4, 0.5)
			Fx.dust(at - Vector3.new(0, 2.4, 0), 7)
			Fx.sound("heavy", 1, 0.5, at)
		end)
	elseif kind == "pillar" then
		-- 땅을 뚫고 솟는 용 기둥
		local at, r = data.at, data.radius
		local p = at - Vector3.new(0, 2.4, 0)
		beam(p, (data.i or 1) % 2 == 0 and c2 or c, r * 0.9, 50, 0.45)
		Fx.ring(p + Vector3.new(0, 0.3, 0), c, 1, r * 2.4, 0.4)
		Fx.dust(p, 3)
		for k = 1, 4 do
			local seg = piece(Vector3.new(1, 1, 1) * (2.2 - k * 0.3), c:Lerp(c2, k / 4), Enum.Material.Neon, Enum.PartType.Ball, 0.1)
			seg.Position = p
			tween(seg, 0.4, { Position = p + Vector3.new(math.cos(k * 1.6) * 2, 12 + k * 7, math.sin(k * 1.6) * 2), Transparency = 1 })
			Debris:AddItem(seg, 0.45)
		end
	elseif kind == "slash" then
		local a, t = data.m and rootPart(data.m), data.t and rootPart(data.t)
		if a and t then
			streak(a.Position, t.Position + (t.Position - a.Position).Unit * 4, c, 0.8, 0.3)
			Fx.afterimage(data.m, Color3.fromRGB(40, 20, 70), 0.35)
			Fx.ring(t.Position, c, 1, 9, 0.3)
		end
	elseif kind == "strike" then
		local at = data.at
		local ground = at - Vector3.new(0, 2.4, 0)
		if data.fx == "star" then
			Fx.starfall(at, data.style)
		elseif data.fx == "ice" or data.fx == "blood" then
			-- 땅에서 솟는 얼음 창 / 핏빛 가시
			for k = 0, 6 do
				local a = k / 7 * math.pi * 2
				local p = ground + Vector3.new(math.cos(a), 0, math.sin(a)) * (k == 0 and 0 or (data.radius or 6) * 0.55)
				local spike = piece(Vector3.new(1.4, 0.5, 1.4), k % 2 == 0 and c or c2, data.fx == "ice" and Enum.Material.Glass or Enum.Material.Neon, nil, 0.1)
				spike.CFrame = CFrame.new(p) * CFrame.Angles(math.cos(a) * 0.35, 0, math.sin(a) * 0.35)
				tween(spike, 0.12, { Size = Vector3.new(1.4, k == 0 and 11 or 7, 1.4) })
				fadeAfter(spike, 0.35, 0.35)
			end
			Fx.ring(ground + Vector3.new(0, 0.3, 0), c, 1, (data.radius or 6) * 2.2, 0.35)
			Fx.sound("heavy", 0.7, 1.1, at)
		else
			Fx.lightning(ground + Vector3.new(math.random(-6, 6), 70, math.random(-6, 6)), ground, c, data.small and 0.6 or 1.6)
			if not data.small then
				Fx.lightning(ground + Vector3.new(math.random(-6, 6), 70, math.random(-6, 6)), ground, c2, 1)
				beam(ground, c2, data.radius * 0.6, 80, 0.35)
			end
			Fx.ring(ground + Vector3.new(0, 0.3, 0), c, 1, (data.radius or 5) * 2.2, 0.3)
			Fx.sound("heavy", data.small and 0.4 or 0.8, 1.3, at)
		end
	elseif kind == "stormcloud" then
		local cloud = piece(Vector3.new(3, (data.radius or 20) * 2, (data.radius or 20) * 2), Color3.fromRGB(45, 45, 65), Enum.Material.SmoothPlastic, Enum.PartType.Cylinder, 0.45)
		follow(data.m, data.dur, { cloud }, function(t, cf)
			return { CFrame.new(cf.Position + Vector3.new(0, 50, 0)) * CFrame.Angles(t * 0.5, 0, math.rad(90)) }
		end, 0.4)
	elseif kind == "freeze" then
		-- 시간이 멈춘다: 잿빛 돔, 멈춘 적은 유리에 갇힌다
		local at, r = data.at, data.radius
		local dome = piece(Vector3.new(4, 4, 4), Color3.fromRGB(220, 220, 235), Enum.Material.Glass, Enum.PartType.Ball, 0.5)
		dome.Position = at
		tween(dome, 0.35, { Size = Vector3.new(r * 2, r * 1.2, r * 2) })
		fadeAfter(dome, data.dur * 0.7, 0.3)
		Fx.ring(at - Vector3.new(0, 2.2, 0), Color3.new(1, 1, 1), 2, r * 2, 0.5)
		for _, m in ipairs(data.targets or {}) do
			local tr = rootPart(m)
			if tr then
				local box = piece(Vector3.new(4.5, 7, 4.5), Color3.fromRGB(200, 220, 255), Enum.Material.Glass, nil, 0.45)
				box.CFrame = tr.CFrame * CFrame.new(0, 0.5, 0)
				fadeAfter(box, data.dur * 0.6, 0.2)
			end
		end
		Fx.sound("deflect", 0.8, 0.5, at)
	elseif kind == "erase" then
		local tr = data.t and rootPart(data.t)
		if tr then
			sphere(tr.Position, Color3.new(1, 1, 1), 2, 14, 0.35, Enum.Material.Neon, 0.2)
			Fx.ring(tr.Position, c, 1, 16, 0.35)
			Fx.spark(tr.Position, Color3.new(1, 1, 1), 2, 10)
		end
	elseif kind == "launch" then
		local at, r = data.at, data.radius
		for k = 0, 4 do
			task.delay(k * 0.06, function()
				Fx.ring(at - Vector3.new(0, 2 - k * 4, 0), k % 2 == 0 and c or c2, 2, r * 2 - k * 4, 0.45)
			end)
		end
		for _ = 1, 14 do
			local a = math.random() * math.pi * 2
			local p = at + Vector3.new(math.cos(a) * r * math.random(), -2, math.sin(a) * r * math.random())
			streak(p, p + Vector3.new(0, 26, 0), c2, 0.5, 0.4)
		end
	elseif kind == "beam" then
		local at, r = data.at, data.radius
		beam(at - Vector3.new(0, 2.4, 0), Color3.new(1, 1, 1), r * 0.6, 160, 0.6)
		beam(at - Vector3.new(0, 2.4, 0), c, r * 1.0, 160, 0.45)
		Fx.ring(at - Vector3.new(0, 2.2, 0), c, 4, r * 3, 0.6)
		Fx.dust(at - Vector3.new(0, 2.4, 0), 8)
	elseif kind == "moving" then
		-- 몸을 따라다니는 꽃잎 폭풍
		local bits = {}
		for i = 1, 26 do
			table.insert(bits, piece(Vector3.new(1, 0.1, 0.7), i % 3 == 0 and Color3.fromRGB(255, 240, 245) or (i % 2 == 0 and c or c2), Enum.Material.SmoothPlastic, nil, 0.05))
		end
		local r = data.radius
		follow(data.m, data.dur, bits, function(t, cf)
			local out = {}
			for i = 1, #bits do
				local a = t * 7 + i / #bits * math.pi * 2
				local rr = r * (0.4 + 0.6 * ((i * 0.53) % 1))
				out[i] = CFrame.new(cf.Position + Vector3.new(math.cos(a) * rr, math.sin(t * 4 + i) * 2.5, math.sin(a) * rr)) * CFrame.Angles(a, t * 5, 0)
			end
			return out
		end, 0.3)
	elseif kind == "trail" then
		for i, p in ipairs(data.points or {}) do
			task.delay(i * 0.05, function()
				Fx.bloom(p - Vector3.new(0, 1.5, 0), data.radius or 6)
				Fx.ring(p - Vector3.new(0, 2.2, 0), c, 1, (data.radius or 6) * 2, 0.35)
			end)
		end
	end
end

return Fx
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="16">
          <Properties>
            <string name="Name">UI</string>
            <string name="Source"><![CDATA[-- 권왕: 화면 (체력·균형·내공 막대, 기술 칸, 창, 수련 놀이, 알림)
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")

local Config = require(ReplicatedStorage:WaitForChild("Config"))

local UI = {}

local player = Players.LocalPlayer
local Request: RemoteEvent

local C = {
	bg = Color3.fromRGB(22, 16, 14),
	panel = Color3.fromRGB(40, 28, 24),
	panel2 = Color3.fromRGB(64, 44, 34),
	line = Color3.fromRGB(190, 150, 90),
	gold = Color3.fromRGB(255, 210, 120),
	text = Color3.fromRGB(250, 240, 225),
	dim = Color3.fromRGB(200, 185, 165),
	red = Color3.fromRGB(220, 60, 50),
	hp = Color3.fromRGB(215, 50, 45),
	posture = Color3.fromRGB(255, 180, 60),
	chi = Color3.fromRGB(80, 170, 255),
	green = Color3.fromRGB(90, 200, 120),
}
UI.C = C

local function new(class: string, props: { [string]: any }?, children: { Instance }?): any
	local inst = Instance.new(class)
	if props then
		for k, v in pairs(props) do
			if k ~= "Parent" then
				(inst :: any)[k] = v
			end
		end
	end
	for _, c in ipairs(children or {}) do
		c.Parent = inst
	end
	if props and props.Parent then
		inst.Parent = props.Parent
	end
	return inst
end
local function corner(r: number?): UICorner
	return new("UICorner", { CornerRadius = UDim.new(0, r or 10) })
end
local function stroke(color: Color3?, t: number?): UIStroke
	return new("UIStroke", { Color = color or C.line, Thickness = t or 1.5, ApplyStrokeMode = Enum.ApplyStrokeMode.Border })
end
local function text(props: { [string]: any }): TextLabel
	local base = { BackgroundTransparency = 1, Font = Enum.Font.GothamBold, TextColor3 = C.text, TextSize = 16, TextWrapped = true, TextXAlignment = Enum.TextXAlignment.Left }
	for k, v in pairs(props) do
		base[k] = v
	end
	return new("TextLabel", base)
end
local function button(props: { [string]: any }, onClick: () -> ()): TextButton
	local base = { BackgroundColor3 = C.panel2, Font = Enum.Font.GothamBlack, TextColor3 = C.text, TextSize = 16, AutoButtonColor = true, Text = "" }
	for k, v in pairs(props) do
		base[k] = v
	end
	local b = new("TextButton", base, { corner(8) })
	b.Activated:Connect(onClick)
	return b
end
UI.new, UI.corner, UI.stroke, UI.text, UI.button = new, corner, stroke, text, button

local gui: ScreenGui
local uiScale = 1
local windowScale = 1

-- 화면 크기에 맞춘 확대. 게임 시작 직후엔 화면 크기가 1×1로 잡힐 때가 있어
-- (그때 재면 창이 안 보일 만큼 작아진다) 크기가 바뀔 때마다 다시 재고, 너무 작으면 무시한다
local scales: { { s: UIScale, kind: string } } = {}
local function scaleFor(kind: string): number
	if kind == "window" then
		return windowScale
	elseif kind == "map" then
		return math.min(uiScale * 0.9, windowScale)
	end
	return uiScale
end
local function scaled(parent: Instance, kind: string?): UIScale
	local k = kind or "ui"
	local sc = Instance.new("UIScale")
	sc.Scale = scaleFor(k)
	sc.Parent = parent
	table.insert(scales, { s = sc, kind = k })
	return sc
end
local function measure()
	local cam = workspace.CurrentCamera
	local vp = cam and cam.ViewportSize or Vector2.new(1280, 720)
	if vp.X < 320 or vp.Y < 240 then
		vp = Vector2.new(1280, 720) -- 아직 화면이 안 잡혔다
	end
	uiScale = math.clamp(vp.Y / 720, 0.75, 1.7)
	windowScale = math.clamp(math.min(uiScale, vp.Y * 0.9 / 600, vp.X * 0.95 / 900), 0.5, 1.7)
	for _, e in ipairs(scales) do
		if e.s.Parent then
			e.s.Scale = scaleFor(e.kind)
		end
	end
end

------------------------------------------------------------------------
-- 알림과 큰 글자
------------------------------------------------------------------------
local toastBox: Frame
function UI.toast(msg: string)
	if not toastBox then
		return
	end
	local l = text({ Size = UDim2.new(1, 0, 0, 34), Text = msg, TextSize = 21, TextXAlignment = Enum.TextXAlignment.Center, TextStrokeTransparency = 0.3, Parent = toastBox })
	task.delay(3, function()
		TweenService:Create(l, TweenInfo.new(0.4), { TextTransparency = 1, TextStrokeTransparency = 1 }):Play()
		task.delay(0.45, function()
			l:Destroy()
		end)
	end)
	local kids = toastBox:GetChildren()
	if #kids > 6 then
		for i = 1, #kids - 6 do
			if kids[i]:IsA("TextLabel") then
				kids[i]:Destroy()
			end
		end
	end
end

function UI.banner(title: string, sub: string?, color: Color3?)
	local f = new("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0.5, 0, 0.3, 0), Size = UDim2.new(0, 760, 0, 110), BackgroundTransparency = 1, ZIndex = 20, Parent = gui })
	local sc = new("UIScale", { Scale = uiScale * 1.6, Parent = f })
	local t = text({ Size = UDim2.new(1, 0, 0, 64), Text = title, TextSize = 50, Font = Enum.Font.GothamBlack, TextColor3 = color or C.gold, TextXAlignment = Enum.TextXAlignment.Center, TextStrokeTransparency = 0, Parent = f })
	local s = text({ Position = UDim2.new(0, 0, 0, 66), Size = UDim2.new(1, 0, 0, 34), Text = sub or "", TextSize = 22, TextXAlignment = Enum.TextXAlignment.Center, TextStrokeTransparency = 0.3, Parent = f })
	TweenService:Create(sc, TweenInfo.new(0.25, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = uiScale }):Play()
	task.delay(2.2, function()
		TweenService:Create(t, TweenInfo.new(0.4), { TextTransparency = 1, TextStrokeTransparency = 1 }):Play()
		TweenService:Create(s, TweenInfo.new(0.4), { TextTransparency = 1, TextStrokeTransparency = 1 }):Play()
		task.delay(0.45, function()
			f:Destroy()
		end)
	end)
end

-- 화면 번쩍임
local flash: Frame
function UI.flash(color: Color3, strength: number)
	flash.BackgroundColor3 = color
	flash.BackgroundTransparency = 1 - math.clamp(strength, 0, 0.7)
	TweenService:Create(flash, TweenInfo.new(0.3), { BackgroundTransparency = 1 }):Play()
end

-- 오의: 위아래 검은 띠와 기술 이름
local bars: { Frame } = {}
function UI.cinematic(name: string, color: Color3, dur: number)
	for _, b in ipairs(bars) do
		TweenService:Create(b, TweenInfo.new(0.2), { Size = UDim2.new(1, 0, 0.1, 0) }):Play()
	end
	UI.banner("오의 · " .. name, nil, color)
	task.delay(dur, function()
		for _, b in ipairs(bars) do
			TweenService:Create(b, TweenInfo.new(0.3), { Size = UDim2.new(1, 0, 0, 0) }):Play()
		end
	end)
end

------------------------------------------------------------------------
-- 내 막대 (아래 가운데)
------------------------------------------------------------------------
local HUD: any = {}

-- 위가 밝고 아래가 어두운 빛 (막대·칸에 입힌다)
local function sheen(parent: Instance, top: number?, bottom: number?)
	new("UIGradient", { Rotation = 90, Color = ColorSequence.new(Color3.new(1, 1, 1):Lerp(Color3.new(1, 1, 1), 0), Color3.fromRGB(150, 150, 150)), Transparency = NumberSequence.new(top or 0, bottom or 0), Parent = parent })
end
UI.sheen = sheen
local meterTrails: { [Frame]: Frame } = {}
local function meter(parent: Instance, pos: UDim2, size: UDim2, color: Color3, label: string): (Frame, TextLabel)
	local back = new("Frame", { Position = pos, Size = size, BackgroundColor3 = Color3.fromRGB(16, 11, 10), BackgroundTransparency = 0.1, Parent = parent }, { corner(6), stroke(Color3.fromRGB(150, 115, 70), 1.4) })
	-- 깎인 만큼 잠깐 남는 흰 띠 (맞은 양이 보인다)
	local trail = new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.fromRGB(255, 240, 220), BackgroundTransparency = 0.25, Parent = back }, { corner(6) })
	local fill = new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = color, ZIndex = 2, Parent = back }, { corner(6) })
	sheen(fill)
	meterTrails[fill] = trail
	local l = text({ Size = UDim2.fromScale(1, 1), Text = label, TextSize = 16, Font = Enum.Font.GothamBold, TextXAlignment = Enum.TextXAlignment.Center, TextStrokeTransparency = 0.3, ZIndex = 3, Parent = back })
	return fill, l
end
-- 흰 띠가 천천히 따라 내려온다
local function trailTo(fill: Frame, r: number)
	fill.Size = UDim2.fromScale(r, 1)
	local trail = meterTrails[fill]
	if trail then
		local cur = trail.Size.X.Scale
		trail.Size = UDim2.fromScale(r > cur and r or cur + (r - cur) * 0.06, 1)
	end
end

local function buildHud()
	local hud = new("Frame", { AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -14), Size = UDim2.new(0, 660, 0, 176), BackgroundTransparency = 1, Parent = gui })
	scaled(hud)
	-- 막대 뒤의 어두운 판과 금빛 테
	local plate = new("Frame", { Position = UDim2.new(0, -14, 0, 48), Size = UDim2.new(1, 28, 0, 76), BackgroundColor3 = Color3.fromRGB(14, 10, 9), BackgroundTransparency = 0.35, ZIndex = 0, Parent = hud }, { corner(12), stroke(Color3.fromRGB(150, 115, 70), 1) })
	new("UIGradient", { Rotation = 90, Transparency = NumberSequence.new(0.2, 0.6), Parent = plate })
	HUD.style = text({ Size = UDim2.new(1, 0, 0, 28), TextSize = 22, Font = Enum.Font.GothamBlack, TextXAlignment = Enum.TextXAlignment.Center, TextStrokeTransparency = 0.3, Parent = hud })
	HUD.stacks = text({ Position = UDim2.new(0, 0, 0, 27), Size = UDim2.new(1, 0, 0, 22), TextSize = 18, TextColor3 = C.gold, TextXAlignment = Enum.TextXAlignment.Center, TextStrokeTransparency = 0.3, Parent = hud })
	-- 균형: 가운데에서 양옆으로 차오른다 (꽉 차면 파훼)
	local pBack = new("Frame", { Position = UDim2.new(0.15, 0, 0, 54), Size = UDim2.new(0.7, 0, 0, 12), BackgroundColor3 = Color3.fromRGB(20, 14, 12), BackgroundTransparency = 0.3, Parent = hud }, { corner(5) })
	HUD.posture = new("Frame", { AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.fromScale(0.5, 0), Size = UDim2.fromScale(0, 1), BackgroundColor3 = C.posture, Parent = pBack }, { corner(5) })
	HUD.hp, HUD.hpText = meter(hud, UDim2.new(0, 0, 0, 72), UDim2.new(1, 0, 0, 26), C.hp, "")
	HUD.chi, HUD.chiText = meter(hud, UDim2.new(0.15, 0, 0, 102), UDim2.new(0.7, 0, 0, 16), C.chi, "")
	-- 기술 칸
	local row = new("Frame", { Position = UDim2.new(0, 0, 0, 124), Size = UDim2.new(1, 0, 0, 50), BackgroundTransparency = 1, Parent = hud }, {
		new("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, HorizontalAlignment = Enum.HorizontalAlignment.Center, Padding = UDim.new(0, 6) }),
	})
	HUD.slots = {}
	for _, s in ipairs({ { "M1", "클릭" }, { "H", "Z 강타" }, { "E", "E" }, { "R", "R" }, { "G", "G 오의" }, { "Q", "Q 대시" }, { "F", "F 막기" }, { "P", "H 약" } }) do
		local cell = new("Frame", { Size = UDim2.new(0, 76, 1, 0), BackgroundColor3 = C.panel, BackgroundTransparency = 0.1, Parent = row }, { corner(8) })
		local st = stroke(C.line, 1.2)
		st.Parent = cell
		sheen(cell, 0, 0)
		-- 위의 빛깔 띠 (쓰는 권법의 빛)
		local stripe = new("Frame", { Size = UDim2.new(1, -8, 0, 3), Position = UDim2.new(0, 4, 0, 2), BackgroundColor3 = C.gold, BorderSizePixel = 0, ZIndex = 3, Parent = cell }, { corner(2) })
		local name = text({ Size = UDim2.new(1, -4, 0.62, 0), Position = UDim2.new(0, 2, 0, 2), TextSize = 14, Font = Enum.Font.GothamBold, TextXAlignment = Enum.TextXAlignment.Center, ZIndex = 3, Parent = cell })
		local key = text({ Position = UDim2.new(0, 0, 0.6, 0), Size = UDim2.new(1, 0, 0.4, 0), Text = s[2], TextSize = 12, TextColor3 = C.dim, TextXAlignment = Enum.TextXAlignment.Center, ZIndex = 3, Parent = cell })
		local cd = new("Frame", { AnchorPoint = Vector2.new(0, 1), Position = UDim2.fromScale(0, 1), Size = UDim2.fromScale(1, 0), BackgroundColor3 = Color3.new(0, 0, 0), BackgroundTransparency = 0.35, ZIndex = 4, Parent = cell }, { corner(8) })
		local _ = key
		HUD.slots[s[1]] = { cell = cell, name = name, cd = cd, stripe = stripe, stroke = st }
	end
end

-- 매 순간 내 막대
function UI.bars(hp: number, maxHp: number, posture: number, postureMax: number, chi: number, chiMax: number?)
	if not HUD.hp then
		return
	end
	trailTo(HUD.hp, math.clamp(hp / math.max(1, maxHp), 0, 1))
	HUD.hpText.Text = string.format("❤ %d / %d", math.floor(hp), maxHp)
	local pr = math.clamp(posture / math.max(1, postureMax), 0, 1)
	HUD.posture.Size = UDim2.fromScale(pr, 1)
	HUD.posture.BackgroundColor3 = pr > 0.75 and C.red or C.posture
	local cm = chiMax or Config.CHI_MAX
	HUD.chi.Size = UDim2.fromScale(math.clamp(chi / cm, 0, 1), 1)
	HUD.chiText.Text = string.format("🌀 내공 %d / %d", math.floor(chi), cm)
end

-- 기술 칸 (이름, 잠김, 대기 시간 비율)
function UI.slots(info: { [string]: { name: string, locked: boolean?, cd: number? } })
	if not HUD.slots then
		return
	end
	for key, s in pairs(HUD.slots) do
		local i = info[key]
		if i then
			s.name.Text = (i.locked and "🔒 " or "") .. i.name
			s.name.TextColor3 = i.locked and C.dim or C.text
			local cdr = math.clamp(i.cd or 0, 0, 1)
			s.cd.Size = UDim2.fromScale(1, cdr)
			-- 쓸 수 있는 기술은 테가 권법 빛으로 빛난다
			if s.stripe and HUD.styleColor then
				s.stripe.BackgroundColor3 = HUD.styleColor
				s.stroke.Color = (cdr <= 0 and not i.locked and (key == "E" or key == "R" or key == "G")) and HUD.styleColor or C.line
				s.stroke.Thickness = (cdr <= 0 and not i.locked and key == "G") and 2.5 or 1.2
			end
		end
	end
end

function UI.styleLine(t: string, color: Color3, stacks: string)
	if HUD.style then
		HUD.style.Text = t
		HUD.style.TextColor3 = color
		HUD.styleColor = color
		HUD.stacks.Text = stacks
	end
end

------------------------------------------------------------------------
-- 보스 막대 (위 가운데)
------------------------------------------------------------------------
local bossFrame: Frame
local bossFill: Frame
local bossPosture: Frame
local bossName: TextLabel
local bossSub: TextLabel
local bossHpText: TextLabel
local bossModel: Model? = nil
function UI.setBoss(model: Model?)
	bossModel = model
	bossFrame.Visible = model ~= nil
	if model then
		local label = model:GetAttribute("Label")
		bossName.Text = "👹 " .. (type(label) == "string" and label or "보스")
		UI.bossPhase(tonumber(model:GetAttribute("BossPhase")) or 1)
	end
end
function UI.bossPhase(ph: number)
	if bossSub and bossModel then
		local lv = bossModel:GetAttribute("Level")
		local power = bossModel:GetAttribute("Power")
		bossSub.Text = string.format("Lv.%s  ·  %d단계 / 3  ·  ⚔ 전투력 %s", tostring(lv or "?"), ph, Config.formatNumber(tonumber(power) or 0))
		bossSub.TextColor3 = ph >= 3 and Color3.fromRGB(255, 90, 70) or (ph == 2 and Color3.fromRGB(255, 170, 90) or C.dim)
	end
end

------------------------------------------------------------------------
-- 적 머리 위 이름표 (이름, 체력, 균형)
------------------------------------------------------------------------
function UI.enemyTag(model: Model)
	local head = model:WaitForChild("Head", 5)
	if not head or not head:IsA("BasePart") or head:FindFirstChild("EnemyTag") then
		return
	end
	local isBoss = model:GetAttribute("Boss") == true
	local w = isBoss and 300 or 230
	local bb = new("BillboardGui", { Name = "EnemyTag", Size = UDim2.new(0, w, 0, 76), StudsOffset = Vector3.new(0, 3.2, 0), AlwaysOnTop = true, LightInfluence = 0, MaxDistance = isBoss and 200 or 130, Parent = head })
	local label = model:GetAttribute("Label")
	local lv = model:GetAttribute("Level")
	local lvText = type(lv) == "number" and string.format("Lv.%d ", lv) or ""
	local name = text({ Size = UDim2.new(1, 0, 0, 26), Text = (isBoss and "👹 " or "⚔ ") .. lvText .. (type(label) == "string" and label or "적"), TextSize = isBoss and 23 or 20, Font = Enum.Font.GothamBlack, TextColor3 = isBoss and C.gold or (type(lv) == "number" and lv >= 7 and Color3.fromRGB(255, 110, 90) or Color3.fromRGB(255, 200, 190)), TextXAlignment = Enum.TextXAlignment.Center, TextStrokeTransparency = 0.1, Parent = bb })
	local _ = name
	local back = new("Frame", { Position = UDim2.new(0, 0, 0, 29), Size = UDim2.new(1, 0, 0, 12), BackgroundColor3 = Color3.fromRGB(20, 10, 10), Parent = bb }, { corner(4), stroke(Color3.fromRGB(0, 0, 0), 1) })
	local fill = new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = C.hp, Parent = back }, { corner(4) })
	local pback = new("Frame", { Position = UDim2.new(0.15, 0, 0, 45), Size = UDim2.new(0.7, 0, 0, 7), BackgroundColor3 = Color3.fromRGB(20, 10, 10), BackgroundTransparency = 0.3, Parent = bb }, { corner(3) })
	local pfill = new("Frame", { AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.fromScale(0.5, 0), Size = UDim2.fromScale(0, 1), BackgroundColor3 = C.posture, Parent = pback }, { corner(3) })
	-- 전투력 견주기: 차이가 크면 그 적의 공격은 나에게 통하지 않는다
	local powerLabel = text({ Position = UDim2.new(0, 0, 0, 55), Size = UDim2.new(1, 0, 0, 20), TextSize = 15, Font = Enum.Font.GothamBold, TextXAlignment = Enum.TextXAlignment.Center, TextStrokeTransparency = 0.2, Parent = bb })
	local function refreshPower()
		local ep = model:GetAttribute("Power")
		local char = player.Character
		local mp = char and char:GetAttribute("Power")
		if type(ep) ~= "number" then
			powerLabel.Text = ""
			return
		end
		local tagText, col = "", Color3.fromRGB(230, 220, 200)
		if type(mp) == "number" then
			local r = mp / math.max(1, ep)
			local G = Config.POWER_GAP
			if r >= G.immune then
				tagText, col = " · 호신강기 (통하지 않음)", Color3.fromRGB(150, 150, 150)
			elseif r >= G.steady then
				tagText, col = " · 한참 약함", Color3.fromRGB(170, 200, 170)
			elseif r >= G.soft then
				tagText, col = " · 약함", Color3.fromRGB(180, 230, 180)
			elseif r >= 0.8 then
				tagText, col = " · 비슷", Color3.fromRGB(255, 230, 160)
			elseif r >= 0.5 then
				tagText, col = " · 강함", Color3.fromRGB(255, 150, 100)
			else
				tagText, col = " · 아주 강함", Color3.fromRGB(255, 80, 70)
			end
		end
		powerLabel.Text = "⚔ 전투력 " .. Config.formatNumber(ep) .. tagText
		powerLabel.TextColor3 = col
	end
	refreshPower()
	model:GetAttributeChangedSignal("Power"):Connect(refreshPower)
	-- 내 전투력이 바뀌면 다시 견준다 (적이 사라지면 그만)
	task.spawn(function()
		while true do
			task.wait(2)
			if not model.Parent or not bb.Parent then
				break
			end
			if not pcall(refreshPower) then
				break
			end
		end
	end)
	local function refresh()
		local hp = model:GetAttribute("Hp")
		local mx = model:GetAttribute("MaxHp")
		local po = model:GetAttribute("Posture")
		local pm = model:GetAttribute("PostureMax")
		if type(hp) == "number" and type(mx) == "number" then
			fill.Size = UDim2.fromScale(math.clamp(hp / math.max(1, mx), 0, 1), 1)
		end
		if type(po) == "number" and type(pm) == "number" then
			local r = math.clamp(po / math.max(1, pm), 0, 1)
			pfill.Size = UDim2.fromScale(r, 1)
			pfill.BackgroundColor3 = r > 0.75 and C.red or C.posture
		end
		bb.Enabled = model:GetAttribute("Dead") ~= true
	end
	refresh()
	model:GetAttributeChangedSignal("Hp"):Connect(refresh)
	model:GetAttributeChangedSignal("Posture"):Connect(refresh)
	model:GetAttributeChangedSignal("Dead"):Connect(refresh)
end

------------------------------------------------------------------------
-- 창
------------------------------------------------------------------------
local window: Frame
local windowTitle: TextLabel
local pages: { [string]: Frame } = {}
local refreshers: { [string]: (boolean?) -> () } = {}
local current = ""
local state: any = nil
local TITLES = { styles = "🥋 권법", stats = "📊 능력치와 경지", shop = "🧪 만물상", help = "📜 도움말", test = "🧪 테스트" }

local function makePage(name: string): Frame
	local f = new("Frame", { Position = UDim2.new(0, 16, 0, 56), Size = UDim2.new(1, -32, 1, -68), BackgroundTransparency = 1, Visible = false, Parent = window })
	pages[name] = f
	return f
end

local function scroller(parent: Instance, size: UDim2, pos: UDim2?): ScrollingFrame
	return new("ScrollingFrame", { Position = pos or UDim2.new(), Size = size, BackgroundTransparency = 1, BorderSizePixel = 0, ScrollBarThickness = 8, ScrollBarImageColor3 = C.line, AutomaticCanvasSize = Enum.AutomaticSize.Y, CanvasSize = UDim2.new(), Parent = parent })
end

local pageOpt: any = nil
function UI.openPage(name: string, opt: any?)
	pageOpt = opt
	if window.Visible and current == name and not opt then
		window.Visible = false
		return
	end
	current = name
	for n, f in pairs(pages) do
		f.Visible = n == name
	end
	windowTitle.Text = TITLES[name] or name
	window.Visible = true
	local r = refreshers[name]
	if r then
		r(true)
	end
end

function UI.closeWindow()
	window.Visible = false
end

function UI.windowOpen(): boolean
	return window.Visible
end

-- 내 몸이 지금 어디 있나
local function myPos(): Vector3?
	local char = player.Character
	local root = char and char:FindFirstChild("HumanoidRootPart")
	return (root and root:IsA("BasePart")) and root.Position or nil
end

-- 여기서 그곳까지 방향 (북 = -Z)과 거리
local DIRS = { "북", "북동", "동", "남동", "남", "남서", "서", "북서" }
local function bearing(from: Vector3, to: Vector3): (string, number)
	local d = Vector3.new(to.X - from.X, 0, to.Z - from.Z)
	local ang = math.deg(math.atan2(d.X, -d.Z)) % 360
	return DIRS[math.floor((ang + 22.5) / 45) % 8 + 1], d.Magnitude
end
UI.bearing = bearing

local function nearMaster(id: string): boolean
	local m = Config.MASTERS[id]
	local pos = myPos()
	if not m or not pos then
		return false
	end
	return Vector3.new(pos.X - m.at.X, 0, pos.Z - m.at.Z).Magnitude <= Config.MASTER_RANGE
end

local function buildStyles()
	local page = makePage("styles")
	local list = scroller(page, UDim2.new(0.4, -8, 1, 0))
	new("UIListLayout", { Padding = UDim.new(0, 6), Parent = list })
	local detail = new("Frame", { Position = UDim2.new(0.4, 4, 0, 0), Size = UDim2.new(0.6, -4, 1, 0), BackgroundColor3 = C.panel, Parent = page }, { corner(12), stroke(C.line, 1.5) })
	local dTitle = text({ Position = UDim2.new(0, 14, 0, 8), Size = UDim2.new(1, -28, 0, 36), TextSize = 28, Font = Enum.Font.GothamBlack, Parent = detail })
	local dHanja = text({ Position = UDim2.new(0, 14, 0, 44), Size = UDim2.new(1, -28, 0, 22), TextSize = 17, TextColor3 = C.dim, Parent = detail })
	local dMaster = text({ Position = UDim2.new(0, 14, 0, 68), Size = UDim2.new(1, -28, 0, 24), TextSize = 17, TextColor3 = C.gold, RichText = true, Parent = detail })
	local bodyScroll = scroller(detail, UDim2.new(1, -20, 1, -170), UDim2.new(0, 14, 0, 96))
	local dBody = text({ Size = UDim2.new(1, -12, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, TextSize = 17, RichText = true, TextYAlignment = Enum.TextYAlignment.Top, Parent = bodyScroll })
	local selected = Config.Styles[1].id
	local action = "learn"
	local dBtn = button({ AnchorPoint = Vector2.new(0, 1), Position = UDim2.new(0, 14, 1, -12), Size = UDim2.new(0.62, -20, 0, 56), TextSize = 21, BackgroundColor3 = C.red, Parent = detail }, function()
		if action == "learn" then
			Request:FireServer("learn", selected)
		elseif action == "break" then
			Request:FireServer("breakthrough", selected)
		elseif action == "guide" then
			UI.setGuide(selected)
			window.Visible = false
		end
	end)
	local guideBtn = button({ AnchorPoint = Vector2.new(1, 1), Position = UDim2.new(1, -14, 1, -12), Size = UDim2.new(0.38, -14, 0, 56), Text = "📍 길 안내", TextSize = 20, BackgroundColor3 = C.panel2, Parent = detail }, function()
		if state and state.found and state.found[selected] then
			UI.setGuide(selected)
			window.Visible = false
		end
	end)
	local cards: { [string]: TextButton } = {}
	local function show(id: string)
		selected = id
		local s = Config.STYLE_BY_ID[id]
		local owned = state and table.find(state.styles, id) ~= nil
		local found = state and state.found and state.found[id]
		local passed = state and state.trials and state.trials[id]
		local ups = (state and state.gradeUp and state.gradeUp[id]) or 0
		local gradeNow = Config.styleGrade(s, ups)
		local gradeColor = Config.GRADE_COLOR[gradeNow] or C.dim
		local gradeTag = string.format('<font color="#%02X%02X%02X">[%s%s]</font>', math.floor(gradeColor.R * 255), math.floor(gradeColor.G * 255), math.floor(gradeColor.B * 255), gradeNow, ups > 0 and string.rep("⬆", ups) or "")
		for sid, card in pairs(cards) do
			local st = card:FindFirstChildOfClass("UIStroke")
			if st then
				st.Thickness = sid == id and 3 or 1
			end
		end
		guideBtn.Visible = found == true and not owned
		-- 숨은 권법은 얻기 전엔 이름도 모른다
		if s.hidden and not owned and not (s.secret and found) then
			dTitle.Text = "❓ 숨겨진 권법"
			dTitle.TextColor3 = C.dim
			dHanja.Text = "???"
			dMaster.Text = gradeTag .. "  전해지는 이야기만 남아 있다"
			dBody.Text = "🔒 " .. (s.unlockHint or "") .. (s.secret and "\n\n지도에 나오지 않는 숨은 사부가 있다." or "\n\n이 권법은 사부에게 배울 수 없다. 강호를 누비며 길을 찾아라.")
			dBtn.Text = "🔒 조건을 채워야 익힌다"
			dBtn.BackgroundColor3 = C.panel
			action = "none"
			return
		end
		dTitle.Text = s.icon .. " " .. s.name
		dTitle.TextColor3 = s.color
		dHanja.Text = s.hanja
		local master = Config.MASTERS[id]
		local pos = myPos()
		if master and not found and not owned then
			dMaster.Text = gradeTag .. '  <font color="#C8B8A0">❓ 사부의 행방을 모른다 · 소문: ' .. (master.rumor or "") .. "</font>"
		elseif master then
			local where = ""
			if pos then
				local dir, dist = bearing(pos, master.at)
				where = dist <= Config.MASTER_RANGE and "  ·  <b>바로 곁</b>" or string.format("  ·  %s쪽 %d칸", dir, math.floor(dist))
			end
			dMaster.Text = string.format("%s  📍 사부 %s · %s%s", gradeTag, master.name, master.region, where)
		else
			dMaster.Text = gradeTag .. (s.starter and "  청운 장로에게 받은 기본 권법" or "")
		end
		local lines = { s.desc, "", "<b>고유 장치</b>  " .. s.gimmick, "", "<b>연타 (클릭)</b>" }
		local names = {}
		for _, m in ipairs(s.combo) do
			table.insert(names, m.name)
		end
		table.insert(lines, table.concat(names, " → "))
		table.insert(lines, "<b>Z 강타</b>  " .. s.heavy.name)
		local m = state and state.mastery and state.mastery[id]
		local lv = m and m.lv or 0
		for _, slot in ipairs({ "E", "R", "G" }) do
			local sk = s.skills[slot]
			local need = Config.SKILL_UNLOCK[slot]
			local lockTxt = lv >= need and "" or string.format(' <font color="#AA9988">(숙련 %d)</font>', need)
			table.insert(lines, string.format("<b>%s %s</b>%s  %s", slot == "G" and "오의 G" or slot, sk.name, lockTxt, sk.desc))
		end
		-- 각성
		local A1, A2 = Config.AWAKEN[1], Config.AWAKEN[2]
		local function tag(need: number): string
			return lv >= need and ' <font color="#FFD25A">(열림)</font>' or string.format(' <font color="#AA9988">(숙련 %d)</font>', need)
		end
		table.insert(lines, "")
		table.insert(lines, string.format("<b>%s %s</b>%s  기술(Z·E·R·G) 피해 ×%.2f, 대기 -%d%%, 연타 다섯 번째 <b>%s</b> (상대를 하늘로 띄운다)", A1.mark, A1.name, tag(A1.lv), A1.dmg, math.floor((1 - A1.cd) * 100 + 0.5), s.finisher and s.finisher.name or ""))
		table.insert(lines, string.format("<b>%s %s</b>%s  모든 기술 ×%.2f, 대기 -%d%%, 그림자 메아리가 기술을 한 번 더 (절반 위력), 몸에 각성의 기운", A2.mark, A2.name, tag(A2.lv), A2.dmg, math.floor((1 - A2.cd) * 100 + 0.5)))
		if m then
			table.insert(lines, "")
			table.insert(lines, string.format("숙련도 %d / %d  (%d / %d)", m.lv, Config.MASTERY_MAX, math.floor(m.xp), m.need))
		end
		if master and not passed and not owned then
			table.insert(lines, "")
			table.insert(lines, '<font color="#FFB070"><b>사부의 시험</b>  사부의 분신과 겨뤄 이겨야 제자로 받아 준다. 마구 휘두르면 막히고 되받아친다.</font>')
		end
		if s.realmReq then
			table.insert(lines, "")
			table.insert(lines, string.format('<font color="#FFE8A0"><b>경지 제한</b>  %s에 올라야 사부가 시험을 허락한다</font>', Config.Realms[s.realmReq].name))
		end
		-- 승급 (깨달음)
		if owned then
			local step = Config.BREAKTHROUGH[ups + 1]
			table.insert(lines, "")
			if step then
				table.insert(lines, string.format("<b>⬆ 권법 승급 (%s)</b>  숙련 %d · %s 이상 · 💰 %s → [%s] (피해 ×%.2f → ×%.2f)", step.name, Config.MASTERY_MAX, Config.Realms[step.realm].name, Config.formatNumber(step.coins), Config.styleGrade(s, ups + 1), Config.GRADES[gradeNow], Config.GRADES[Config.styleGrade(s, ups + 1)]))
			else
				table.insert(lines, string.format("<b>⬆ 권법 승급</b>  모든 깨달음을 얻었다 [%s]", gradeNow))
			end
		end
		dBody.Text = table.concat(lines, "\n")
		local cost = state and state.learnCost or 0
		local canBreak = owned and Config.BREAKTHROUGH[ups + 1] ~= nil and lv >= Config.MASTERY_MAX
		if canBreak then
			local step = Config.BREAKTHROUGH[ups + 1]
			dBtn.Text = string.format("⬆ 승급  💰 %s", Config.formatNumber(step.coins))
			dBtn.BackgroundColor3 = (state and state.coins >= step.coins and state.realm >= step.realm) and Color3.fromRGB(200, 150, 40) or C.panel
			action = "break"
		elseif state and state.style == id then
			dBtn.Text = "✔ 쓰는 중"
			dBtn.BackgroundColor3 = C.green
			action = "none"
		elseif owned then
			dBtn.Text = "이 권법으로 바꾸기"
			dBtn.BackgroundColor3 = C.panel2
			action = "learn"
		elseif not master then
			dBtn.Text = "청운 장로에게 받는다"
			dBtn.BackgroundColor3 = C.panel
			action = "none"
		elseif not found then
			dBtn.Text = "❓ 먼저 사부를 찾아라"
			dBtn.BackgroundColor3 = C.panel
			action = "none"
		elseif not passed then
			local near = nearMaster(id)
			dBtn.Text = near and "⚔ 시험 받기" or "사부에게 가서 시험 받기"
			dBtn.BackgroundColor3 = near and C.red or Color3.fromRGB(150, 110, 50)
			action = near and "learn" or "guide"
		elseif nearMaster(id) then
			dBtn.Text = string.format("배우기  💰 %s", Config.formatNumber(cost))
			dBtn.BackgroundColor3 = (state and state.coins >= cost) and C.red or C.panel
			action = "learn"
		else
			dBtn.Text = string.format("사부에게 가기 (💰 %s)", Config.formatNumber(cost))
			dBtn.BackgroundColor3 = Color3.fromRGB(150, 110, 50)
			action = "guide"
		end
	end
	for _, s in ipairs(Config.Styles) do
		local card = button({ Size = UDim2.new(1, -10, 0, 64), BackgroundColor3 = C.panel2, Text = "", Parent = list }, function()
			show(s.id)
		end)
		new("UIStroke", { Color = s.color, Thickness = 1, Parent = card })
		text({ Name = "Title", Position = UDim2.new(0, 10, 0, 4), Size = UDim2.new(1, -20, 0, 30), Text = s.hidden and "❓ 숨겨진 권법" or (s.icon .. " " .. s.name), TextSize = 20, Font = Enum.Font.GothamBlack, TextColor3 = s.hidden and C.dim or s.color, Parent = card })
		local sub = text({ Name = "Sub", Position = UDim2.new(0, 10, 0, 34), Size = UDim2.new(1, -20, 0, 24), TextSize = 15, TextColor3 = C.dim, Parent = card })
		sub.Text = s.hidden and "???" or s.hanja
		cards[s.id] = card
	end
	refreshers.styles = function(reset: boolean?)
		for id, card in pairs(cards) do
			local sub = card:FindFirstChild("Sub") :: TextLabel?
			if sub and state then
				local m = state.mastery and state.mastery[id]
				local s = Config.STYLE_BY_ID[id]
				local owned = table.find(state.styles, id) ~= nil
				local title = card:FindFirstChild("Title") :: TextLabel?
				local found = state.found and state.found[id]
				local ups = (state.gradeUp and state.gradeUp[id]) or 0
				if s.hidden and not owned and not (s.secret and found) then
					sub.Text = "[" .. s.grade .. "]  ???"
					if title then
						title.Text = "❓ 숨겨진 권법"
						title.TextColor3 = C.dim
					end
				else
					local mark = owned and "" or ((state.trials and state.trials[id]) and "  · 시험 통과" or ((state.found and state.found[id]) and "  · 사부 찾음" or (Config.MASTERS[id] and "  · ❓" or "")))
					sub.Text = "[" .. Config.styleGrade(s, ups) .. string.rep("⬆", ups) .. "] " .. s.hanja .. (m and string.format("  ·  숙련 %d", m.lv) or "") .. mark .. (state.style == id and "  ✔" or "")
					if title then
						title.Text = s.icon .. " " .. s.name
						title.TextColor3 = s.color
					end
				end
				sub.TextColor3 = Config.GRADE_COLOR[Config.styleGrade(s, ups)] or C.dim
			end
		end
		if reset then
			selected = pageOpt and pageOpt.style or (state and state.style ~= "" and state.style) or selected
		end
		show(selected)
	end
end

local function buildStats()
	local page = makePage("stats")
	local info = text({ Size = UDim2.new(1, 0, 1, 0), TextSize = 18, RichText = true, TextYAlignment = Enum.TextYAlignment.Top, Parent = page })
	refreshers.stats = function()
		if not state then
			return
		end
		local lines = {}
		local idx = state.realm
		local realm = Config.Realms[idx]
		local nextRealm = Config.Realms[idx + 1]
		table.insert(lines, string.format("<b>경지: %s</b>  (능력치 합 %s%s)", realm.name, Config.formatNumber(state.total), nextRealm and string.format(" / 다음 %s는 %s", nextRealm.name, Config.formatNumber(nextRealm.need)) or ""))
		table.insert(lines, string.format("경지 배율 ×%.2f (사경까지 경지마다 ×1.22, 그 위로는 ×1.32씩 겹으로, 수련 효과 +25%%) · 경지는 열여섯 단계", Config.realmPower(idx)))
		table.insert(lines, "")
		for _, s in ipairs(Config.Stats) do
			local v = state.stats[s.id] or 0
			table.insert(lines, string.format("%s <b>%s %s</b>  — %s ×%.2f", s.icon, s.name, Config.formatNumber(v), s.desc, Config.statMult(v)))
		end
		table.insert(lines, "")
		table.insert(lines, "<b>수련하는 곳</b>")
		for _, t in pairs(Config.Training) do
			local stat = nil
			for _, s in ipairs(Config.Stats) do
				if s.id == t.stat then
					stat = s
				end
			end
			local need = t.realm and t.realm > 1 and string.format(' <font color="#FFD25A">[%s부터]</font>', Config.Realms[t.realm].name) or ""
			table.insert(lines, string.format("%s %s%s → %s  (%s)", t.icon, t.name, need, t.fight and "모든 능력치" or ((stat and stat.icon or "") .. " " .. (stat and stat.name or "")), t.desc))
		end
		table.insert(lines, "")
		table.insert(lines, string.format("💰 은자 %s   ⚔ 쓰러뜨린 적 %d   🏆 비무대 승리 %d   🧪 금창약 %d", Config.formatNumber(state.coins), state.kills, state.pvpWins, state.potions))
		if state.elixirLeft > 0 then
			table.insert(lines, string.format("💊 소환단: %d초 남음 (수련 2배)", state.elixirLeft))
		end
		info.Text = table.concat(lines, "\n")
	end
end

local function buildShop()
	local page = makePage("shop")
	local list = new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Parent = page }, { new("UIListLayout", { Padding = UDim.new(0, 8) }) })
	local labels = {}
	for _, item in ipairs(Config.Shop) do
		local row = new("Frame", { Size = UDim2.new(1, 0, 0, 70), BackgroundColor3 = C.panel2, Parent = list }, { corner(10), stroke(C.line, 1) })
		text({ Position = UDim2.new(0, 14, 0, 6), Size = UDim2.new(1, -200, 0, 28), Text = item.icon .. " " .. item.name, TextSize = 20, Font = Enum.Font.GothamBlack, Parent = row })
		text({ Position = UDim2.new(0, 14, 0, 36), Size = UDim2.new(1, -200, 0, 26), Text = item.desc, TextSize = 14, TextColor3 = C.dim, Parent = row })
		labels[item.id] = button({ AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -12, 0.5, 0), Size = UDim2.new(0, 160, 0, 46), Text = "💰 " .. Config.formatNumber(item.cost), TextSize = 18, BackgroundColor3 = C.red, Parent = row }, function()
			Request:FireServer("buy", item.id)
		end)
	end
	refreshers.shop = function()
		for _, item in ipairs(Config.Shop) do
			local can = state and state.coins >= item.cost
			labels[item.id].BackgroundColor3 = can and C.red or C.panel
		end
	end
end

local function buildHelp()
	local page = makePage("help")
	local scroll = scroller(page, UDim2.fromScale(1, 1))
	text({
		Size = UDim2.new(1, -14, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		TextSize = 17,
		RichText = true,
		TextYAlignment = Enum.TextYAlignment.Top,
		Parent = scroll,
		Text = table.concat({
			"<b>🥋 맨손 하나로 강호를 꺾어라</b>",
			"",
			"<b>조작</b>",
			"• 클릭: 연타 (네 번까지 이어진다) · Z: 강타 (강한 한 방) (천룡장은 누르고 있다 놓기)",
			"• E · R: 기술 · G: 오의 (내공 100) · Q: 대시 (잠깐 무적) · 공중에서 Space: 두 번 뛰기",
			"• F: 막기. <b>맞기 직전에 누르면 흘리기</b> — 피해 없이 흘려 내고 상대가 휘청인다",
			"• H: 금창약 · T(가까이): 사부·수련·상점 · Tab: 능력치 · M: 지도 · Shift: 달리기",
			"",
			"<b>연타는 박자</b>",
			"• 앞 동작이 끝나 갈 즈음 눌러야 이어진다. 딱 맞으면 <b>정타</b> (피해 +15%, 세 번 이으면 연속 정타 +30%)",
			"• 너무 일찍 마구 누르면 <b>흐트러진다</b>: 연타가 끊기고 적이 읽어서 막고 흘린다",
			"• 숙련 6 각성: 연타 다섯 번째 마무리가 상대를 하늘로 띄운다 → 두 번 뛰고 공중에서 클릭 = 공중 연격 (세 번)",
			"• 맞기 직전에 대시로 피하면 <b>간파</b>: 상대가 굳고, 곧바로 클릭하면 반격",
			"",
			"<b>몸놀림</b>",
			"• 대시 바로 뒤 클릭: <b>돌진 일격</b> · 공중에서 클릭: <b>낙하격</b> (내리꽂아 주변을 친다)",
			"• 흘리기 바로 뒤 클릭: <b>반격</b> (크게 아프고 균형을 많이 깎는다)",

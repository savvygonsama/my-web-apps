	stance_geumgang = { W = { 5, 0, 0 }, N = { -5, 0, 0 }, RS = { 15, 0, 22 }, RE = { 95, 0, 0 }, LS = { 15, 0, -22 }, LE = { 95, 0, 0 } },
	-- 매화: 한 손을 길게 내밀고 가볍게
	stance_maehwa = { W = { 0, -25, 0 }, N = { 0, 25, 0 }, RS = { 30, 0, 12 }, RE = { 110, 0, 0 }, LS = { 75, 0, -5 }, LE = { 35, 0, 0 } },

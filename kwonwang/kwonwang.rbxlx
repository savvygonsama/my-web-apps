-- 여덟 번 연타 (양손이 번갈아)
A.flurry = {
	{ t = 0, j = { W = { 0, -20, 0 }, RS = { 60, 0, 10 }, RE = { 100, 0, 0 }, LS = { 60, 0, -10 }, LE = { 100, 0, 0 }, R = { -5, 0, 0, 0, -0.4, 0 } } },
}
for i = 1, 8 do
	local right = i % 2 == 1
	table.insert(A.flurry, { t = (i - 0.5) / 8.6, e = "snap", j = {
		W = { 0, right and 30 or -30, 0 },
		RS = right and { 92, 0, -5 + i } or { 50, 0, 10 }, RE = right and { 0, 0, 0 } or { 110, 0, 0 },
		LS = right and { 50, 0, -10 } or { 92, 0, 5 - i }, LE = right and { 110, 0, 0 } or { 0, 0, 0 },
		R = { -8, 0, 0, 0, -0.5, -0.4 },
	} })
end
table.insert(A.flurry, { t = 1, j = { W = { 0, 40, 0 }, RS = { 95, 0, 0 }, RE = { 0, 0, 0 }, LS = { 30, 0, -20 }, LE = { 100, 0, 0 }, R = { -10, 0, 0, 0, -0.6, -0.8 } } })


	{ t = 0, j = { W = { 10, 0, 0 }, RS = { 20, 0, 30 }, RE = { 110, 0, 0 }, LS = { 20, 0, -30 }, LE = { 110, 0, 0 }, R = { 5, 0, 0, 0, -0.6, 0.5 } } },

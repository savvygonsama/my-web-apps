	section("🎯 수련 목인·시간", {
		{ "🎯 수련 목인 세우기", "testDummy" }, { "🧹 테스트로 부른 것 치우기", "testClear" }, { "⏸ 시간 멈춤·흐름", "testTime", "freeze" },
		{ "🌅 새벽 (6시)", "testTime", 6 }, { "☀ 한낮 (12시)", "testTime", 12 }, { "🌇 저녁 (18시)", "testTime", 18 },
		{ "🌙 한밤 (0시)", "testTime", 0 }, { "⏩ 3시간 뒤로", "testTime", "+3" },
		{ "💎 두 배 수련 (테스트로 켜기)", "testPremium", "train2x" }, { "🤖 자동 수련 (테스트로 켜기)", "testPremium", "autoTrain" }, { "⚙ 고급 자동 수련 (테스트로 켜기)", "testPremium", "autoTrain2" },
	})
	-- 수련 자리로 바로 (종류마다 첫 자리)
	local trainItems = {}
	for _, id in ipairs({ "rock", "dummy", "waterfall", "mabo", "ironpalm", "breathing", "simma", "geumjong", "cheongeun", "jucheon", "heogong", "cheonsang" }) do
		local t = Config.Training[id]
		if t then
			table.insert(trainItems, { "🌀 " .. t.icon .. " " .. t.name, "testTrainTp", id })
		end
	end
	section("🏋 수련 텔레포트", trainItems)
	-- 권법 테스트: 어떤 권법이든 바로 (숙련 최대·내공 가득)
	local styleItems = {}
	for _, st in ipairs(Config.Styles) do
		table.insert(styleItems, { st.icon .. " " .. st.name .. " [" .. st.grade .. "]", "testStyle", st.id, color = st.color:Lerp(Color3.new(0, 0, 0), 0.55) })
	end
	section("🥋 권법 테스트 (바로 익혀 숙련 최대로)", styleItems)
	section("🔓 시크릿 테스트 (숨은 권법 얻는 길)", {
		{ "📖 비급 조각 +1", "testSecret", "fragment" }, { "🧭 다음 비급 조각으로", "testSecret", "fragmentTp" }, { "🌌 무극신권 얻기", "testSecret", "mugeuk" },
		{ "🩸 혈마신수 얻기", "testSecret", "hyeolma" }, { "🔒 숨은 권법 다시 잠그기", "testSecret", "lock" }, { "👹 혈마 부르기", "testBoss", "hyeolma" },
		{ "🧭 숨은 사부에게 가기", "testSecretMaster" }, { "📍 숨은 사부 길잡이", "guide:gaecheon" }, { "✨ 무극 경지로 (능력치)", "testStats", 2609500 },
		{ "⬆ 지금 권법 승급 최대", "testBreak" }, { "👹 천마 부르기", "testBoss", "cheonma" }, { "👑 천제신권 바로 쓰기", "testStyle", "gaecheon" },
		{ "🌑 파천신권 얻기 (천마 처치 보상)", "testSecret", "pacheon" }, { "🌪 풍신각 바로 쓰기", "testStyle", "pungsin" }, { "✴ 천외천 경지로 (능력치)", "testStats", 125000000 }, { "🌸 초·매화난무권 바로 쓰기 (초월)", "testStyle", "chomaehwa" }, { "🌸 천앵선에게 (초월의 시련)", "testSecretMaster", "chomaehwa" }, { "🍾 초·취팔선권 바로 쓰기 (초월)", "testStyle", "chochwi" }, { "🍾 만취선에게 (초월의 시련)", "testSecretMaster", "chochwi" }, { "⚔ 천겁 레이드 지금 (천상계에서)", "testRaid", true }, { "🌀 구름 미궁 바로 들어가기", "testMaze", true },
		{ "🧭 시원자에게 가기 (태초신권)", "testSecretMaster", "taecho" }, { "📍 시원자 길잡이", "guide:taecho" }, { "✴ 태초신권 바로 쓰기", "testStyle", "taecho" },
		{ "🧭 권존에게 가기 (일월신권)", "testSecretMaster", "ilwol" }, { "📍 권존 길잡이", "guide:ilwol" }, { "☀ 일월신권 바로 쓰기", "testStyle", "ilwol" },
		{ "🧭 영겁노인에게 가기 (영겁신권)", "testSecretMaster", "yeonggeop" }, { "📍 영겁노인 길잡이", "guide:yeonggeop" }, { "⏳ 영겁신권 바로 쓰기", "testStyle", "yeonggeop" },
	})
	-- 모든 권법 얻는 법 (테스트 창에만 적는다)
	order += 1
	text({ Size = UDim2.new(1, -12, 0, 26), Text = "📖 모든 권법 얻는 법", TextSize = 19, Font = Enum.Font.GothamBlack, TextColor3 = C.gold, LayoutOrder = order, Parent = list })
	local how = {}
	local HIDDEN_HOW: { [string]: string } = {
		mugeuk = "강호 곳곳의 비급 조각 다섯을 모두 줍는다 (지도에 안 나온다). 자리: ",
		hyeolma = "북동쪽 끝 혈교 본산의 보스 '혈마'를 쓰러뜨리면 바로 얻는다",
		pacheon = "북서쪽 끝 허공 균열의 보스 '천마'를 쓰러뜨리면 바로 얻는다",
		musang = "마을 비무대에서 다른 사람을 백 번 이기면 바로 얻는다 (비무 승리는 능력치 창과 순위표에 나온다)",
	}
	for _, st in ipairs(Config.Styles) do
		local m = Config.MASTERS[st.id]
		local line: string
		if st.starter then
			line = "처음부터 가지고 시작한다 (청운 장로에게 받는다)"
		elseif st.awakenOf then
			local base = Config.STYLE_BY_ID[st.awakenOf]
			local A = Config.AWAKEN_STYLE
			line = string.format("각성 권법: %s 숙련 %d + 깨달음(승급) %d번 + %s 경지%s + 💰 %s → 상급 수련장의 각성선인 곁에서 권법 창의 '🔥 각성 시련' → 각성한 그림자(체력 %d배)를 넘으면 바로 얻는다",
				base and base.name or st.awakenOf, Config.MASTERY_MAX, #Config.BREAKTHROUGH, Config.Realms[A.realm].name, st.rebirthReq and string.format(" + ♻ 환생 %d번", st.rebirthReq) or "", Config.formatNumber(A.coins), A.trialHp)
		elseif HIDDEN_HOW[st.id] then
			line = HIDDEN_HOW[st.id]
			if st.id == "mugeuk" then
				local spots = {}
				for _, fr in ipairs(Config.Fragments) do
					table.insert(spots, fr.hint)
				end
				line ..= table.concat(spots, " · ")
			end
		elseif m then
			local need = {}
			if st.realmReq then
				table.insert(need, Config.Realms[st.realmReq].name .. " 경지")
			end
			if st.styleReq then
				local rq = Config.STYLE_BY_ID[st.styleReq]
				table.insert(need, (rq and rq.name or st.styleReq) .. "을(를) 익힌 뒤")
			end
			local tk = Config.TRIAL_KINDS[(Config.trialNeed(st.id))]
			line = string.format("%s%s의 %s에게 가서 T → %s을 넘고 → 은자를 바쳐 배운다%s%s",
				#need > 0 and ("[" .. table.concat(need, ", ") .. "] ") or "", m.region, m.name, tk and (tk.icon .. " " .. tk.title) or "시험",
				m.secret and " (숨은 사부: 지도에 안 나온다)" or "", st.trialHp and " · 궁극의 시험 (1.5배)" or "")
		else
			line = st.unlockHint or "?"
		end
		table.insert(how, string.format("<b>%s %s</b> [%s]\n   %s", st.icon, st.name, st.grade, line))
	end
	order += 1
	text({ Size = UDim2.new(1, -14, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, TextSize = 16, RichText = true, TextWrapped = true, TextYAlignment = Enum.TextYAlignment.Top, LayoutOrder = order, Parent = list, Text = table.concat(how, "\n") })
	section("적과 보스", {
		{ "👹 흑호", "testBoss", "heukho" }, { "👹 혈랑", "testBoss", "hyeolrang" }, { "👹 빙마", "testBoss", "bingma" },
		{ "🪵 무뢰배", "testEnemy", "thug" }, { "🗡 산적", "testEnemy", "bandit" }, { "🔱 창병", "testEnemy", "spearman" },
		{ "🪓 곤봉 산적", "testEnemy", "brute" }, { "🥷 쌍도 자객", "testEnemy", "assassin" }, { "🛡 철갑 무사", "testEnemy", "ironguard" },
		{ "🌑 흑영 자객", "testEnemy", "shadowblade" }, { "🩸 혈교도", "testEnemy", "cultist" }, { "🩸 혈교 장로", "testEnemy", "cultelder" },
		{ "🌀 균열 마물", "testEnemy", "riftling" }, { "🌌 허공 마인", "testEnemy", "voidwalker" }, { "🗿 석상 수호자", "testEnemy", "stonegolem" },
		{ "👁 천마 사도", "testEnemy", "apostle" },
	})
end

------------------------------------------------------------------------
-- 수련 놀이
------------------------------------------------------------------------
local trainFrame: Frame
local trainTitle: TextLabel
local trainHint: TextLabel
local trainGuide: TextLabel
local trainArea: Frame
local trainConn: RBXScriptConnection? = nil
local trainPress: (() -> ())? = nil

function UI.trainPress()
	if trainPress then
		trainPress()
	end
end

function UI.trainStop()
	if trainConn then
		trainConn:Disconnect()
		trainConn = nil
	end
	trainPress = nil
	trainFrame.Visible = false
	for _, c in ipairs(trainArea:GetChildren()) do
		c:Destroy()
	end
end

-- 박자 놀이: getPhase()가 0~1, 1이 '지금!' 순간
local function rhythm(onGrade: (string) -> (), hard: boolean?, basePeriod: number?)
	local circle = new("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.new(0, 60, 0, 60), BackgroundColor3 = C.gold, BackgroundTransparency = 0.2, Parent = trainArea }, { corner(999) })
	local target = new("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.new(0, 70, 0, 70), BackgroundTransparency = 1, Parent = trainArea }, { corner(999), stroke(Color3.new(1, 1, 1), 3) })
	local _ = target
	local start = os.clock()
	local H = Config.HARD_TRAIN
	local J = Config.TRAIN_JUDGE
	local period = (basePeriod or J.period) * (hard and H.period / J.period or 1)
	return circle, function(): number
		local p = ((os.clock() - start) % period) / period
		return p
	end, function()
		local p = ((os.clock() - start) % period) / period
		-- 고리가 하얀 원에 겹칠 때 (p ≈ 1 또는 0)
		local off = math.min(p, 1 - p)
		local grade = off < (hard and H.perfect or J.perfect) and "perfect" or (off < (hard and H.good or J.good) and "good" or "miss")
		onGrade(grade)
	end
end

function UI.trainStart(kind: string, rings: { Vector3 }?, send: (string, number?) -> (), hard: boolean?)
	UI.trainStop()
	local info = Config.Training[kind]
	trainFrame.Visible = true
	trainTitle.Text = (hard and "🔥 강화 수련 · " or info.icon .. " ") .. info.name
	trainTitle.TextColor3 = hard and Color3.fromRGB(255, 120, 70) or C.gold
	trainHint.Text = info.desc .. (UserInputService.TouchEnabled and "  (화면 버튼)" or "  (Space 또는 클릭, 움직이면 끝)")
	trainGuide.Text = "📘 " .. (TRAIN_GUIDE[kind] or info.desc)
	-- 상급 수련은 앞의 수련과 같은 판정 화면을 쓴다
	kind = info.ui or kind
	if kind == "bamboo" then
		-- 다음 고리를 화살표로
		local arrow = text({ Size = UDim2.fromScale(1, 1), TextSize = 22, TextXAlignment = Enum.TextXAlignment.Center, TextColor3 = Color3.fromRGB(190, 255, 150), Parent = trainArea })
		local idx = 1
		local list = rings or {}
		trainConn = RunService.RenderStepped:Connect(function()
			local char = player.Character
			local root = char and char:FindFirstChild("HumanoidRootPart")
			local pos = list[idx]
			if not root or not root:IsA("BasePart") or not pos then
				return
			end
			local d = (root.Position - pos).Magnitude
			arrow.Text = string.format("🎋 고리 %d / %d  ·  %d칸", idx, #list, math.floor(d))
			if d < Config.TRAIN_JUDGE.ring then
				send("ring", idx)
				idx = idx % #list + 1
			end
		end)
		return
	end
	if kind == "mabo" then
		-- 마보 참장: 기울어지는 몸을 가운데(초록)에 붙잡아 둔다. 누르면 오른쪽, 가만두면 바람에 밀려 왼쪽
		local bar = new("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.new(0, 300, 0, 26), BackgroundColor3 = Color3.fromRGB(60, 40, 35), Parent = trainArea }, { corner(8) })
		local zoneW = hard and Config.TRAIN_JUDGE.maboHard or Config.TRAIN_JUDGE.mabo
		new("Frame", { AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.fromScale(0.5, 0), Size = UDim2.fromScale(zoneW, 1), BackgroundColor3 = C.green, BackgroundTransparency = 0.25, Parent = bar }, { corner(8) })
		local needle = new("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.new(0, 8, 1, 14), BackgroundColor3 = Color3.new(1, 1, 1), Parent = bar }, { corner(4) })
		local x, v, acc = 0.5, 0, 0
		trainPress = function()
			v += 0.55
		end
		trainConn = RunService.RenderStepped:Connect(function(dt: number)
			local t = os.clock()
			local gust = math.sin(t * 1.3) * 0.2 + math.sin(t * 2.9) * 0.12 * (hard and 1.6 or 1)
			v = v * (1 - dt * 2.2) + (-0.45 + gust) * dt * 2
			x = math.clamp(x + v * dt, 0, 1)
			needle.Position = UDim2.fromScale(x, 0.5)
			acc += dt
			if acc >= 1.2 then
				acc = 0
				local d = math.abs(x - 0.5)
				send(d < zoneW * 0.2 and "perfect" or (d < zoneW / 2 and "good" or "miss"))
			end
		end)
		return
	end
	local circle, phase, press = rhythm(function(grade)
		send(grade)
	end, hard, info.period)
	trainPress = press
	trainConn = RunService.RenderStepped:Connect(function()
		local p = phase()
		if kind == "waterfall" or kind == "breathing" then
			-- 숨: 커졌다 작아졌다, 가장 클 때가 '지금'
			local s = 20 + 50 * (0.5 - 0.5 * math.cos(p * math.pi * 2 + math.pi))
			circle.Size = UDim2.new(0, s, 0, s)
			circle.BackgroundColor3 = C.chi
		elseif kind == "dummy" or kind == "ironpalm" then
			-- 나무팔이 들어온다: 끝에서 번쩍
			local s = 70
			circle.Size = UDim2.new(0, s, 0, s)
			circle.BackgroundTransparency = 1 - p ^ 4
			circle.BackgroundColor3 = kind == "ironpalm" and Color3.fromRGB(255, 110, 40) or Color3.fromRGB(230, 160, 90)
		else
			-- 바위: 큰 고리가 줄어든다
			local s = 70 + 160 * (1 - p)
			circle.Size = UDim2.new(0, s, 0, s)
			circle.BackgroundColor3 = C.gold
			circle.BackgroundTransparency = 0.6
		end
	end)
end

function UI.trainResult(data: any)
	if not trainFrame.Visible then
		return
	end
	local stat = nil
	for _, s in ipairs(Config.Stats) do
		if s.id == data.stat then
			stat = s
		end
	end
	local word = data.grade == "perfect" and "완벽!" or (data.grade == "good" and "좋음" or (data.grade == "ring" and "통과!" or "놓침"))
	local color = data.grade == "perfect" and C.gold or (data.gain > 0 and C.text or C.red)
	local l = text({ AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.15), Size = UDim2.new(1, 0, 0, 30), Text = data.gain > 0 and string.format("%s  %s +%d", word, stat and (stat.icon .. " " .. stat.name) or "", data.gain) or word, TextSize = 22, Font = Enum.Font.GothamBlack, TextColor3 = color, TextXAlignment = Enum.TextXAlignment.Center, TextStrokeTransparency = 0.2, Parent = trainArea })
	TweenService:Create(l, TweenInfo.new(0.7), { Position = UDim2.fromScale(0.5, -0.1), TextTransparency = 1, TextStrokeTransparency = 1 }):Play()
	task.delay(0.75, function()
		l:Destroy()
	end)
end

------------------------------------------------------------------------
-- 쓰러졌을 때
------------------------------------------------------------------------
local koFrame: Frame
local koText: TextLabel
function UI.ko(on: boolean, secs: number?)
	koFrame.Visible = on
	if on then
		local left = secs or Config.RESPAWN_TIME
		task.spawn(function()
			while koFrame.Visible and left > 0 do
				koText.Text = string.format("쓰러졌다…  %d초 뒤 마을에서 다시 일어난다", math.ceil(left))
				task.wait(0.25)
				left -= 0.25
			end
		end)
	end
end

------------------------------------------------------------------------
-- 상태 받기
------------------------------------------------------------------------
local topInfo: TextLabel
function UI.setState(s: any)
	state = s
	local realm = Config.Realms[s.realm]
	topInfo.Text = string.format("[%s] ⚔ 전투력 %s   💰 %s   🧪 %d   💪%s ❤%s 🍃%s 🌀%s", realm.name, Config.formatNumber(s.power or 0), Config.formatNumber(s.coins), s.potions, Config.formatNumber(s.stats.str), Config.formatNumber(s.stats.vit), Config.formatNumber(s.stats.agi), Config.formatNumber(s.stats.chi))
	if s.gateNext then
		topInfo.Text ..= "   ⛩ 관문 열림"
	end
	if s.autoOn and s.premium and (s.premium.autoTrain or s.premium.autoTrain2) then
		topInfo.Text ..= s.premium.autoTrain2 and "   ⚙ 고급 자동 수련" or "   🤖 자동 수련"
	end
	topInfo.TextColor3 = realm.color
	local menu = gui:FindFirstChild("Menu", true)
	local testBtn = menu and menu:FindFirstChild("TestButton")
	if testBtn then
		testBtn.Visible = s.tester == true
	end
	-- 들판 PvP: 켜짐(붉은) / 꺼짐(푸른). 한 번 쓰러지기 전에는 끌 수 없다 (자물쇠)
	local pvpBtn = menu and menu:FindFirstChild("PvpButton")
	if pvpBtn and pvpBtn:IsA("TextButton") then
		pvpBtn.Text = s.pvpOff and "🕊 PvP 꺼짐" or ((s.pvpUnlocked and "⚔" or "🔒") .. " PvP 켜짐")
		pvpBtn.BackgroundColor3 = s.pvpOff and Color3.fromRGB(50, 90, 140) or Color3.fromRGB(140, 40, 35)
	end
	if window.Visible and refreshers[current] then
		refreshers[current]()
	end
	if UI.refreshWorld then
		UI.refreshWorld(s)
	end
end

------------------------------------------------------------------------
-- 지도 (오른쪽 위, M으로 크게)와 길잡이
------------------------------------------------------------------------
local mapFrame: Frame
local mapInner: Frame
local mapMe: TextLabel
local mapGuide: Frame
local mapDots: { Frame } = {}
local mapBig = false
local guideStyle: string? = nil
local guidePart: Part? = nil
local guideLabel: TextLabel? = nil
local masterMarks: { [string]: { stroke: UIStroke, icon: TextLabel, color: Color3, glyph: string } } = {}
local beacons: { [string]: Part } = {}
local storyMark: Frame? = nil

-- 1.5판: 지역마다 권장 전투력 (서버가 적들의 전투력으로 정해 ReplicatedStorage.KwonRegionPower에 적어 둔다)
local function regionPower(id: string): (number?, number?)
	local f = game:GetService("ReplicatedStorage"):FindFirstChild("KwonRegionPower")
	if not f then
		return nil, nil
	end
	local a, b = f:GetAttribute(id), f:GetAttribute(id .. "_boss")
	return (type(a) == "number" and a or nil), (type(b) == "number" and b or nil)
end
UI.regionPower = regionPower
-- 권장 전투력과 내 전투력을 견준 한 줄 (위험·알맞음·여유)
local function powerAdvice(rec: number): string
	local mine = state and state.power or 0
	if mine <= 0 then
		return string.format("⚔ 권장 전투력 %s", Config.formatNumber(rec))
	end
	local r = mine / rec
	local tag = r < 0.6 and "⚠ 위험" or (r < 1 and "조금 버거움" or (r < 2.5 and "알맞음" or "여유"))
	return string.format("⚔ 권장 %s (내 %s · %s)", Config.formatNumber(rec), Config.formatNumber(mine), tag)
end
-- 1.9.1판: 지도 글자 정돈. 지역 이름과 권장 전투력은 한 덩어리 (지역 가운데)로 묶고,
-- 글자끼리 겹치면 덜 중요한 것부터 감춘다. 작은 지도는 나를 따라 움직이고 (가까운 곳을 크게), 큰 지도는 온 세상을 다 보여 준다 (휠·끌기로 확대·이동)
local regionTags: { [string]: { label: TextLabel, name: string } } = {}
local mapCanvas: Frame
type MapText = { label: TextLabel, prio: number, small: number, big: number, base: UDim2? }
local mapTexts: { MapText } = {}
-- 지도 위 권장 전투력: 내 전투력에 견주어 빨강(위험)·주황(버거움)·초록(알맞음)·회색(여유)
local function refreshRec()
	local mine = state and state.power or 0
	for id, tg in pairs(regionTags) do
		local rec, boss = regionPower(id)
		local l = tg.label
		if not rec then
			l.Text = tg.name
		else
			local r = mine > 0 and mine / rec or 1
			local col = r < 0.6 and "#FF6A5F" or (r < 1 and "#FFBE5A" or (r < 2.5 and "#96F082" or "#CDCDCD"))
			local line = string.format('<font color="%s">⚔%s</font>', col, Config.formatNumber(rec))
			if boss and mapBig then
				line ..= string.format('  <font color="#FF9A9A">👹%s</font>', Config.formatNumber(boss))
			end
			l.Text = tg.name .. "\n" .. line
		end
	end
end

local function mapUV(p: Vector3): UDim2
	local H = Config.WORLD_HALF
	return UDim2.fromScale(math.clamp((p.X + H) / (2 * H), 0, 1), math.clamp((p.Z + H) / (2 * H), 0, 1))
end

local MAP_SMALL = 250
local MAP_BIG = 760
local SMALL_SPAN = 870 -- 작은 지도 한 변에 보이는 넓이 (칸). 2.2판: 1300 → 870 (1.5배 크게 보인다)
local bigZoom = 1
local bigCenter = Vector3.zero
local function viewZoom(): number
	return mapBig and bigZoom or (2 * Config.WORLD_HALF) / SMALL_SPAN
end
-- 지도 판을 옮긴다: 작은 지도는 내가 가운데, 큰 지도는 고른 가운데 (세상 밖이 보이지 않게 묶는다)
local function applyView(pos: Vector3?)
	if not mapCanvas then
		return
	end
	local H = Config.WORLD_HALF
	local z = viewZoom()
	local c = mapBig and bigCenter or (pos or Vector3.zero)
	local u, v = (c.X + H) / (2 * H), (c.Z + H) / (2 * H)
	if mapBig then
		local half = 0.5 / z
		u = math.clamp(u, half, 1 - half)
		v = math.clamp(v, half, 1 - half)
		bigCenter = Vector3.new(u * 2 * H - H, 0, v * 2 * H - H)
	end
	mapCanvas.Size = UDim2.fromScale(z, z)
	mapCanvas.Position = UDim2.fromScale(0.5 - u * z, 0.5 - v * z)
end
-- 겹치는 글자 비켜 놓기 (중요한 것부터 자리를 잡는다). 2.1판: 감추지 않는다. 위아래로 비켜서라도 다 보인다
local function declutter()
	if not mapInner then
		return
	end
	-- 지도 판의 크기 (UIScale을 곱하기 전 값: 글자 크기도 같은 단위라 그대로 견준다)
	local side = (mapBig and MAP_BIG or MAP_SMALL) - 12
	local inner = Vector2.new(side, side)
	local z = viewZoom()
	local cs = inner.X * z
	local ox = mapCanvas.Position.X.Scale * inner.X
	local oy = mapCanvas.Position.Y.Scale * inner.Y
	local placed: { { number } } = {}
	for _, t in ipairs(mapTexts) do
		local l = t.label
		local size = mapBig and t.big or t.small
		t.base = t.base or UDim2.fromScale(l.Position.X.Scale, l.Position.Y.Scale)
		local base = t.base :: UDim2
		local px = ox + base.X.Scale * cs
		local py = oy + base.Y.Scale * cs
		local plain = string.gsub(l.Text, "<[^>]+>", "")
		local lines = string.split(plain, "\n")
		local wide = 0
		for _, ln in ipairs(lines) do
			wide = math.max(wide, utf8.len(ln) or #ln)
		end
		local w = wide * size * 0.62 + 4
		local h = #lines * size * 1.15
		local x0, x1 = px - w / 2, px + w / 2
		local inView = wide > 0 and x1 > 0 and py + h / 2 > 0 and x0 < inner.X and py - h / 2 < inner.Y
		-- 빈 자리를 찾아 위아래로 조금씩 비킨다 (끝내 못 찾으면 제자리에 겹쳐서라도 보인다)
		local dy = 0
		if inView then
			for _, k in ipairs({ 0, 1, -1, 2, -2, 3, -3 }) do
				local y0, y1 = py - h / 2 + k * h, py + h / 2 + k * h
				local free = true
				for _, r in ipairs(placed) do
					if x0 < r[3] and x1 > r[1] and y0 < r[4] and y1 > r[2] then
						free = false
						break
					end
				end
				if free then
					dy = k * h
					break
				end
			end
			table.insert(placed, { x0, py - h / 2 + dy, x1, py + h / 2 + dy })
		end
		l.Position = UDim2.new(base.X.Scale, 0, base.Y.Scale, dy)
		l.Visible = wide > 0
	end
end
local zoomBtns: { GuiObject } = {}
local function placeMap()
	if mapBig then
		mapFrame.AnchorPoint = Vector2.new(0.5, 0.5)
		mapFrame.Position = UDim2.fromScale(0.5, 0.5)
		mapFrame.Size = UDim2.new(0, MAP_BIG, 0, MAP_BIG)
	else
		mapFrame.AnchorPoint = Vector2.new(1, 0)
		mapFrame.Position = UDim2.new(1, -16, 0, 160)
		mapFrame.Size = UDim2.new(0, MAP_SMALL, 0, MAP_SMALL)
	end
	-- 휴대폰은 버튼과 겹치지 않게 작은 지도를 숨기고, 메뉴로 크게만 본다
	mapFrame.Visible = mapBig or not UserInputService.TouchEnabled
	for _, t in ipairs(mapTexts) do
		t.label.TextSize = mapBig and t.big or t.small
	end
	for _, b in ipairs(zoomBtns) do
		b.Visible = mapBig
	end
	refreshRec()
	applyView(myPos())
	task.defer(declutter)
end

function UI.toggleMap()
	mapBig = not mapBig
	if mapBig then
		-- 큰 지도는 온 세상부터
		bigZoom = 1
		bigCenter = Vector3.zero
	end
	placeMap()
end

local function zoomBy(k: number)
	bigZoom = math.clamp(bigZoom * k, 1, 6)
	applyView(nil)
	declutter()
end

local function buildMap()
	mapFrame = new("Frame", { Name = "Map", BackgroundColor3 = Color3.fromRGB(40, 50, 35), BackgroundTransparency = 0.1, ZIndex = 5, Parent = gui }, { corner(12), stroke(C.line, 2) })
	scaled(mapFrame, "map")
	mapInner = new("Frame", { Position = UDim2.new(0, 6, 0, 6), Size = UDim2.new(1, -12, 1, -12), BackgroundColor3 = Color3.fromRGB(70, 95, 120), ClipsDescendants = true, ZIndex = 5, Parent = mapFrame }, { corner(8) })
	-- 모든 것을 얹는 판 (작은 지도에서는 크게 키워 나를 따라 옮긴다)
	mapCanvas = new("Frame", { Name = "Canvas", Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.fromRGB(95, 125, 75), BorderSizePixel = 0, ZIndex = 5, Parent = mapInner })
	local canvas = mapCanvas
	local H = Config.WORLD_HALF
	local function rect(center: Vector3, size: Vector3, color: Color3, z: number): Frame
		return new("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = mapUV(center), Size = UDim2.fromScale(size.X / (2 * H), size.Z / (2 * H)), BackgroundColor3 = color, BorderSizePixel = 0, ZIndex = z, Parent = canvas })
	end
	local function label(at: Vector3, t: string, small: number, big: number, color: Color3, z: number, prio: number): TextLabel
		local l = text({ AnchorPoint = Vector2.new(0.5, 0.5), Position = mapUV(at), Size = UDim2.new(0, 10, 0, 10), AutomaticSize = Enum.AutomaticSize.XY, Text = t, TextSize = small, TextColor3 = color, TextXAlignment = Enum.TextXAlignment.Center, TextStrokeTransparency = 0.15, TextWrapped = false, RichText = true, ZIndex = z, Parent = canvas })
		table.insert(mapTexts, { label = l, prio = prio, small = small, big = big })
		return l
	end
	-- 길
	for _, road in ipairs(Config.Roads) do
		for i = 1, #road - 1 do
			local a, b = road[i], road[i + 1]
			local d = b - a
			new("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = mapUV((a + b) / 2), Size = UDim2.new(d.Magnitude / (2 * H), 0, 0, 3), Rotation = math.deg(math.atan2(d.Z, d.X)), BackgroundColor3 = Color3.fromRGB(190, 165, 120), BorderSizePixel = 0, ZIndex = 6, Parent = canvas })
		end
	end
	-- 지역과 사부: 표시(사부·보스)는 늘 보이고, 이름과 권장 전투력은 한 덩어리
	for _, r in ipairs(Config.Regions) do
		if not r.noGround then
			local f = rect(r.center, r.size, r.ground, 6)
			f.BackgroundTransparency = 0.15
			local style = r.master and Config.STYLE_BY_ID[r.master]
			local tagAt = r.center
			if style then
				-- 사부 자리는 찾기 전엔 물음표만
				local st = new("UIStroke", { Color = style.color, Thickness = 2, Enabled = false, Parent = f })
				local icon = label(r.masterAt, "❓", 14, 17, Color3.fromRGB(220, 210, 190), 9, 3)
				masterMarks[r.master] = { stroke = st, icon = icon, color = style.color, glyph = style.icon }
				tagAt = r.masterAt + Vector3.new(0, 0, 95)
			elseif r.boss then
				label(r.boss.at, "👹", 13, 16, C.red, 9, 3)
			end
			local tag = label(tagAt, r.name, 11, 12, Color3.new(1, 1, 1), 9, r.id == "village" and 2.5 or 2)
			regionTags[r.id] = { label = tag, name = r.name }
		end
	end
	-- 큰 볼거리 (표시는 조금 덜 중요, 이름은 가장 덜 중요)
	for _, lm in ipairs(Config.Landmarks) do
		label(lm.at, lm.icon, 13, 15, Color3.new(1, 1, 1), 8, 1.5)
		label(lm.at + Vector3.new(0, 0, 80), lm.name, 10, 11, Color3.fromRGB(230, 225, 210), 8, 1)
	end
	table.sort(mapTexts, function(x, y)
		return x.prio > y.prio
	end)
	refreshRec()
	task.spawn(function()
		local f = game:GetService("ReplicatedStorage"):WaitForChild("KwonRegionPower", 60)
		if f then
			refreshRec()
			f.AttributeChanged:Connect(function()
				refreshRec()
				declutter()
			end)
		end
	end)
	-- 적 점 (가까운 것만)
	for i = 1, 50 do
		mapDots[i] = new("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.new(0, 5, 0, 5), BackgroundColor3 = Color3.fromRGB(255, 60, 50), BorderSizePixel = 0, Visible = false, ZIndex = 10, Parent = canvas }, { corner(99) })
	end
	mapGuide = new("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.new(0, 20, 0, 20), BackgroundTransparency = 1, Visible = false, ZIndex = 11, Parent = canvas }, { corner(99), stroke(Color3.fromRGB(255, 240, 120), 3) })
	storyMark = new("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.new(0, 14, 0, 14), Rotation = 45, BackgroundColor3 = Color3.fromRGB(255, 170, 60), BorderSizePixel = 0, Visible = false, ZIndex = 11, Parent = canvas }, { stroke(Color3.new(0, 0, 0), 1.5) })
	mapMe = text({ AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.new(0, 20, 0, 20), Text = "▲", TextSize = 18, TextColor3 = Color3.fromRGB(255, 255, 255), TextXAlignment = Enum.TextXAlignment.Center, TextStrokeTransparency = 0, TextWrapped = false, ZIndex = 12, Parent = canvas })
	text({ AnchorPoint = Vector2.new(1, 1), Position = UDim2.new(1, -8, 1, -6), Size = UDim2.new(0, 220, 0, 18), Text = "M: 지도 크게 · 휠: 확대", TextSize = 13, TextColor3 = C.text, TextXAlignment = Enum.TextXAlignment.Right, TextStrokeTransparency = 0.2, ZIndex = 12, Parent = mapFrame })
	-- 큰 지도: 확대·축소·내 자리 단추, 휠과 끌기
	for i, spec in ipairs({ { "＋", 1.4 }, { "－", 1 / 1.4 }, { "◎", 0 } }) do
		local b = button({ AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -10, 0, 10 + (i - 1) * 46), Size = UDim2.new(0, 40, 0, 40), Text = spec[1], TextSize = 22, BackgroundColor3 = C.panel2, ZIndex = 13, Visible = false, Parent = mapFrame }, function()
			if spec[2] == 0 then
				bigZoom = math.max(bigZoom, 3)
				bigCenter = myPos() or Vector3.zero
				applyView(nil)
				declutter()
			else
				zoomBy(spec[2])
			end
		end)
		table.insert(zoomBtns, b)
	end
	local dragging = false
	local dragLast = Vector3.zero
	-- (입력 연결이 실패해도 지도는 그대로 쓰이게)
	pcall(function()
		mapInner.InputBegan:Connect(function(input: InputObject)
			if mapBig and (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch) then
				dragging = true
				dragLast = input.Position
			end
		end)
		UserInputService.InputEnded:Connect(function(input: InputObject)
			if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
				dragging = false
			end
		end)
		UserInputService.InputChanged:Connect(function(input: InputObject)
			if not mapBig then
				return
			end
			if input.UserInputType == Enum.UserInputType.MouseWheel then
				zoomBy(input.Position.Z > 0 and 1.25 or 0.8)
			elseif dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
				local d = input.Position - dragLast
				dragLast = input.Position
				local px = (MAP_BIG - 12)
				pcall(function()
					px = mapInner.AbsoluteSize.X
				end)
				local cs = math.max(1, px * bigZoom)
				bigCenter -= Vector3.new(d.X / cs * 2 * H, 0, d.Y / cs * 2 * H)
				applyView(nil)
				declutter()
			end
		end)
	end)
	placeMap()
end

-- 길잡이: 화면에 사부 자리를 띄운다 (가까이 가면 꺼진다)
function UI.setGuide(styleId: string?)
	if guidePart then
		guidePart:Destroy()
	end
	guidePart = nil
	guideLabel = nil
	guideStyle = nil
	if mapGuide then
		mapGuide.Visible = false
	end
	local m = styleId and Config.MASTERS[styleId]
	local style = styleId and Config.STYLE_BY_ID[styleId]
	if not m or not style then
		return
	end
	guideStyle = styleId
	local p = Instance.new("Part")
	p.Name = "KwonGuide"
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.Transparency = 1
	p.Size = Vector3.new(1, 1, 1)
	p.Position = m.at + Vector3.new(0, 12, 0)
	p.Parent = workspace
	local bb = new("BillboardGui", { Size = UDim2.new(0, 300, 0, 76), AlwaysOnTop = true, LightInfluence = 0, MaxDistance = 100000, Parent = p })
	guideLabel = text({ Size = UDim2.fromScale(1, 1), TextSize = 24, Font = Enum.Font.GothamBlack, TextColor3 = style.color, TextXAlignment = Enum.TextXAlignment.Center, TextStrokeTransparency = 0, Parent = bb })
	guidePart = p
	if mapGuide then
		mapGuide.Position = mapUV(m.at)
		mapGuide.Visible = true
	end
	UI.toast(string.format("📍 %s · %s에게 가세요 (하늘로 솟은 빛기둥)", m.region, m.name))
end

------------------------------------------------------------------------
-- 이야기: 지금 할 일 (왼쪽), 대화 창 (아래), 목표 표시, 사부 빛기둥, 땅마다 공기
------------------------------------------------------------------------
local storyBox: Frame
local storyTitle: TextLabel
local storyGoal: TextLabel
local storyPart: Part? = nil
local storyLabel: TextLabel? = nil
local storyAt: Vector3? = nil
local storyAcceptBtn: TextButton? = nil
local storyChip: TextButton? = nil
local storyHidden = false
local lastStoryState: any = nil

local function countKeys(t: any): number
	local n = 0
	if type(t) == "table" then
		for _ in pairs(t) do
			n += 1
		end
	end
	return n
end

local function nameOf(id: string?): string
	if not id then
		return ""
	end
	local e = Config.Enemies[id] or Config.Bosses[id]
	return e and e.name or id
end

-- 목표 자리: 정해진 곳이 없으면 (시험·배우기) 가장 가까운 알맞은 사부
local function goalTarget(s: any, g: any): Vector3?
	if g.kind == "talk" then
		return Config.ELDER_AT
	end
	if g.at then
		return g.at
	end
	if g.kind == "trial" or g.kind == "learn" then
		local pos = myPos() or Vector3.zero
		local best, bestD = nil, math.huge
		for id, m in pairs(Config.MASTERS) do
			local ok = s.found and s.found[id] and not table.find(s.styles, id)
			if g.kind == "trial" then
				ok = ok and not (s.trials and s.trials[id])
			else
				ok = ok and s.trials and s.trials[id]
			end
			local d = (m.at - pos).Magnitude
			if ok and d < bestD then
				best, bestD = m.at, d
			end
		end
		return best
	end
	return nil
end

local function goalText(s: any, g: any): string
	local k = g.kind
	local prog = s.prog or 0
	if k == "talk" then
		return "청운 장로에게 말 걸기 (T)"
	elseif k == "kill" then
		return string.format("%s 쓰러뜨리기  %d / %d", nameOf(g.id), prog, g.n or 1)
	elseif k == "train" then
		return string.format("수련터에서 수련하기  %d / %d", prog, g.n or 1)
	elseif k == "found" then
		return string.format("소문을 따라 사부 찾기  %d / %d", countKeys(s.found), g.n or 1)
	elseif k == "trial" then
		return "사부 곁에서 T · 사부의 시험 통과하기"
	elseif k == "learn" then
		local want = g.id and Config.STYLE_BY_ID[g.id]
		if want then
			return want.icon .. " " .. want.name .. " 익히기 (숨은 사부)"
		end
		return string.format("사부에게 권법 배우기  %d / %d", #s.styles, g.n or 1)
	elseif k == "realm" then
		local r = Config.Realms[g.n]
		return string.format("%s의 경지에 오르기 (지금 %s)", r and r.name or "", Config.Realms[s.realm].name)
	elseif k == "boss" then
		return nameOf(g.id) .. " 쓰러뜨리기"
	elseif k == "fragment" then
		return string.format("비급 조각 찾기  %d / %d (지도에 없다)", countKeys(s.fragments), g.n or 1)
	end
	return "강호를 마음껏 누비기"
end

local function clearStoryPart()
	if storyPart then
		storyPart:Destroy()
	end
	storyPart = nil
	storyLabel = nil
end

local function refreshStory(s: any)
	local ch = Config.Story[s.story or 1]
	if not storyBox or not ch then
		return
	end
	lastStoryState = s
	storyBox.Visible = not storyHidden
	if storyChip then
		storyChip.Visible = storyHidden
	end
	-- 받지 않은 이야기는 제목만 (목표 표시도, 길잡이도 없다)
	local accepted = s.accepted ~= false or ch.goal.kind == "talk"
	if storyAcceptBtn then
		storyAcceptBtn.Visible = not accepted
	end
	if accepted then
		storyTitle.Text = string.format("📜 %d장 · %s", s.story or 1, ch.title)
		storyGoal.Text = "▸ " .. goalText(s, ch.goal)
	else
		storyTitle.Text = string.format("📜 새 이야기 · %s", ch.title)
		storyGoal.Text = "▸ 받으면 목표가 표시돼요"
	end
	-- 장로에게 말 걸기는 장로 이름표가 있으니 따로 띄우지 않는다
	local at = (accepted and not storyHidden and ch.goal.kind ~= "talk") and goalTarget(s, ch.goal) or nil
	if at ~= storyAt then
		storyAt = at
		clearStoryPart()
		if at then
			local p = Instance.new("Part")
			p.Name = "KwonStoryMark"
			p.Anchored = true
			p.CanCollide = false
			p.CanQuery = false
			p.CanTouch = false
			p.Transparency = 1
			p.Size = Vector3.new(1, 1, 1)
			p.Position = at + Vector3.new(0, 14, 0)
			p.Parent = workspace
			local bb = new("BillboardGui", { Size = UDim2.new(0, 260, 0, 64), AlwaysOnTop = true, LightInfluence = 0, MaxDistance = 100000, Parent = p })
			storyLabel = text({ Size = UDim2.fromScale(1, 1), TextSize = 20, Font = Enum.Font.GothamBlack, TextColor3 = Color3.fromRGB(255, 190, 90), TextXAlignment = Enum.TextXAlignment.Center, TextStrokeTransparency = 0, Parent = bb })
			storyPart = p
		end
	end
	if storyMark then
		storyMark.Visible = at ~= nil
		if at then
			storyMark.Position = mapUV(at)
		end
	end
end

local function storyTick(pos: Vector3)
	if storyAt and storyLabel and storyPart then
		local dir, dist = bearing(pos, storyAt)
		storyLabel.Text = string.format("📜 목표\n%s쪽 · %d칸", dir, math.floor(dist))
		storyLabel.Visible = dist > 18
	end
end

-- 찾은 사부만 지도에 나오고, 하늘로 빛기둥이 솟는다
local function refreshFound(s: any)
	for id, mk in pairs(masterMarks) do
		local found = (s.found and s.found[id]) or table.find(s.styles, id) ~= nil
		mk.stroke.Enabled = found
		mk.icon.Text = found and mk.glyph or "❓"
		mk.icon.TextColor3 = found and mk.color or Color3.fromRGB(220, 210, 190)
		local m = Config.MASTERS[id]
		if found and m and not beacons[id] then
			local b = Instance.new("Part")
			b.Name = "KwonBeacon"
			b.Anchored = true
			b.CanCollide = false
			b.CanQuery = false
			b.CanTouch = false
			b.CastShadow = false
			b.Shape = Enum.PartType.Cylinder
			b.Material = Enum.Material.Neon
			b.Color = mk.color
			b.Transparency = 0.55
			b.Size = Vector3.new(400, 5, 5)
			b.CFrame = CFrame.new(m.at + Vector3.new(0, 210, 0)) * CFrame.Angles(0, 0, math.rad(90))
			b.Parent = workspace
			beacons[id] = b
		end
	end
end

function UI.setStoryHidden(on: boolean)
	storyHidden = on
	if lastStoryState then
		refreshStory(lastStoryState)
	end
end

function UI.refreshWorld(s: any)
	refreshFound(s)
	refreshRec()
	refreshStory(s)
end

-- 대화 창: 글자가 한 자씩 흘러나온다
local dialogFrame: Frame
local dialogWho: TextLabel
local dialogTitle: TextLabel
local dialogText: TextLabel
local dialogAct: TextButton
local dialogTrial: string? = nil
local dialogAccept = false
local dialogSeq = 0
function UI.dialog(data: any)
	if not dialogFrame then
		return
	end
	dialogSeq += 1
	local seq = dialogSeq
	dialogWho.Text = data.who or ""
	dialogTitle.Text = data.title or ""
	dialogText.Text = data.text or ""
	dialogTrial = data.trial
	dialogAccept = data.accept == true
	dialogAct.Visible = dialogTrial ~= nil or dialogAccept
	dialogAct.Text = dialogAccept and "📜 받기" or "⚔ 시험 받기"
	dialogAct.BackgroundColor3 = dialogAccept and Color3.fromRGB(190, 130, 50) or C.red
	dialogFrame.Visible = true
	local n = utf8.len(dialogText.Text) or 0
	pcall(function()
		dialogText.MaxVisibleGraphemes = 0
	end)
	task.spawn(function()
		for i = 1, n, 2 do
			if seq ~= dialogSeq then
				return
			end
			pcall(function()
				dialogText.MaxVisibleGraphemes = i
			end)
			task.wait(0.02)
		end
		pcall(function()
			dialogText.MaxVisibleGraphemes = -1
		end)
	end)
	task.delay(40, function()
		if seq == dialogSeq then
			dialogFrame.Visible = false
		end
	end)
end

function UI.dialogOpen(): boolean
	return dialogFrame ~= nil and dialogFrame.Visible
end

local function buildStory(topLeft: Frame)
	storyBox = new("Frame", { Name = "Story", Position = UDim2.new(0, 0, 0, 424), Size = UDim2.new(0, 400, 0, 74), BackgroundColor3 = C.bg, BackgroundTransparency = 0.3, Parent = topLeft }, { corner(10), stroke(Color3.fromRGB(255, 190, 90), 1.5) })
	storyTitle = text({ Position = UDim2.new(0, 10, 0, 6), Size = UDim2.new(1, -20, 0, 26), TextSize = 19, Font = Enum.Font.GothamBlack, TextColor3 = Color3.fromRGB(255, 200, 110), Parent = storyBox })
	storyGoal = text({ Position = UDim2.new(0, 10, 0, 36), Size = UDim2.new(1, -20, 0, 30), TextSize = 16, TextColor3 = C.text, TextWrapped = true, Parent = storyBox })
	-- 아직 받지 않은 이야기: 눌러서 받는다
	storyAcceptBtn = button({ AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -40, 0, 50), Size = UDim2.new(0, 90, 0, 30), Text = "📜 받기", TextSize = 16, BackgroundColor3 = Color3.fromRGB(190, 130, 50), Visible = false, Parent = storyBox }, function()
		Request:FireServer("storyAccept")
	end)
	-- 이야기 칸 숨기기 / 다시 보기
	button({ AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -6, 0, 6), Size = UDim2.new(0, 26, 0, 26), Text = "✕", TextSize = 15, BackgroundColor3 = C.panel2, Parent = storyBox }, function()
		UI.setStoryHidden(true)
	end)
	storyChip = button({ Position = UDim2.new(0, 0, 0, 386), Size = UDim2.new(0, 120, 0, 34), Text = "📜 이야기 보기", TextSize = 15, BackgroundColor3 = C.bg, Visible = false, Parent = topLeft }, function()
		UI.setStoryHidden(false)
	end)
	-- 대화 창
	dialogFrame = new("Frame", { Name = "Dialog", AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -150), Size = UDim2.new(0, 820, 0, 200), BackgroundColor3 = C.bg, BackgroundTransparency = 0.08, Visible = false, ZIndex = 20, Parent = gui }, { corner(14), stroke(C.line, 2.5) })
	scaled(dialogFrame)
	dialogWho = text({ Position = UDim2.new(0, 20, 0, 10), Size = UDim2.new(0.5, 0, 0, 28), TextSize = 22, Font = Enum.Font.GothamBlack, TextColor3 = C.gold, ZIndex = 21, Parent = dialogFrame })
	dialogTitle = text({ AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -20, 0, 12), Size = UDim2.new(0.5, -20, 0, 24), TextSize = 17, TextColor3 = C.dim, TextXAlignment = Enum.TextXAlignment.Right, ZIndex = 21, Parent = dialogFrame })
	dialogText = text({ Position = UDim2.new(0, 20, 0, 46), Size = UDim2.new(1, -40, 0, 92), TextSize = 19, TextWrapped = true, TextYAlignment = Enum.TextYAlignment.Top, ZIndex = 21, Parent = dialogFrame })
	button({ AnchorPoint = Vector2.new(1, 1), Position = UDim2.new(1, -16, 1, -12), Size = UDim2.new(0, 140, 0, 42), Text = "알겠다", TextSize = 18, BackgroundColor3 = C.panel2, ZIndex = 21, Parent = dialogFrame }, function()
		dialogSeq += 1
		dialogFrame.Visible = false
	end)
	dialogAct = button({ AnchorPoint = Vector2.new(1, 1), Position = UDim2.new(1, -168, 1, -12), Size = UDim2.new(0, 180, 0, 42), Text = "⚔ 시험 받기", TextSize = 18, BackgroundColor3 = C.red, ZIndex = 21, Visible = false, Parent = dialogFrame }, function()
		if dialogAccept then
			Request:FireServer("storyAccept")
		elseif dialogTrial then
			Request:FireServer("learn", dialogTrial)
		end
		dialogSeq += 1
		dialogFrame.Visible = false
	end)
end

-- 땅마다 공기가 다르다 (안개 색과 짙기). 들어서면 이름과 적 수준을 알린다
local AMBIENT = {
	default = { d = 0.24, h = 1.1, c = Color3.fromRGB(240, 215, 190) },
	snow = { d = 0.4, h = 2, c = Color3.fromRGB(225, 235, 255) },
	swamp = { d = 0.5, h = 2.6, c = Color3.fromRGB(140, 170, 110) },
	badlands = { d = 0.32, h = 1.9, c = Color3.fromRGB(255, 185, 130) },
	coast = { d = 0.3, h = 1.6, c = Color3.fromRGB(200, 225, 245) },
	cult = { d = 0.45, h = 2.3, c = Color3.fromRGB(160, 45, 55) },
	rift = { d = 0.5, h = 2.4, c = Color3.fromRGB(110, 70, 190) },
	volcano = { d = 0.48, h = 2.6, c = Color3.fromRGB(200, 90, 50) },
	desert = { d = 0.34, h = 2.2, c = Color3.fromRGB(240, 200, 140) },
	sky = { d = 0.3, h = 1.2, c = Color3.fromRGB(235, 242, 255) },
	maple = { d = 0.28, h = 1.5, c = Color3.fromRGB(255, 200, 150) },
	stone = { d = 0.45, h = 2.2, c = Color3.fromRGB(225, 228, 230) },
	mushroom = { d = 0.45, h = 2.4, c = Color3.fromRGB(170, 130, 210) },
	tea = { d = 0.42, h = 1.8, c = Color3.fromRGB(225, 240, 225) },
}
local regionNow = ""
local function regionAt(pos: Vector3): any
	local best = nil
	for _, r in ipairs(Config.Regions) do
		if not r.noGround and math.abs(pos.X - r.center.X) <= r.size.X / 2 and math.abs(pos.Z - r.center.Z) <= r.size.Z / 2 then
			-- 작은 땅 (사부 자리 등) 을 먼저
			if not best or r.size.X * r.size.Z < best.size.X * best.size.Z then
				best = r
			end
		end
	end
	return best
end
UI.regionAt = regionAt
-- 천상계: 섬 이름, 맑고 밝은 하늘빛, 발아래 구름 바다 (이 화면에서만 만든다. 땅에서는 보이지 않는다)
local skySea: Folder? = nil
local SKY_AMBIENT = { d = 0.16, h = 0.35, c = Color3.fromRGB(225, 238, 255) }
local function skyTick(pos: Vector3)
	local isl = Config.skyIslandAt(pos)
	local id = isl and ("sky_" .. isl.id) or "sky"
	if id ~= regionNow then
		regionNow = id
		if isl then
			local rec = regionPower("sky_" .. isl.id)
			UI.toast(string.format("📍 천상계 · %s%s%s", isl.name, isl.safe and "  · 안전한 곳" or string.format("  · 적 수준 %d", Config.enemyLevel(Vector3.new(pos.X, Config.SKY.y, pos.Z))), (rec and not isl.safe) and ("  · " .. powerAdvice(rec)) or ""))
		end
	end
	local atmo = game:GetService("Lighting"):FindFirstChildOfClass("Atmosphere")
	if atmo then
		atmo.Density += (SKY_AMBIENT.d - atmo.Density) * 0.08
		atmo.Haze += (SKY_AMBIENT.h - atmo.Haze) * 0.08
		atmo.Color = atmo.Color:Lerp(SKY_AMBIENT.c, 0.08)
	end
	if not skySea then
		local f = Instance.new("Folder")
		f.Name = "KwonSkySea"
		for x = -1, 1 do
			for z = -1, 1 do
				local p = Instance.new("Part")
				p.Anchored = true
				p.CanCollide = false
				p.CanQuery = false
				p.CanTouch = false
				p.Size = Vector3.new(2000, 4, 2000)
				p.Position = Vector3.new(x * 2000, Config.SKY.y - 75, z * 2000)
				p.Color = Color3.fromRGB(250, 250, 255)
				p.Material = Enum.Material.SmoothPlastic
				p.Transparency = 0.12
				p.Parent = f
			end
		end
		f.Parent = workspace
		skySea = f
	end
end
local function ambientTick(pos: Vector3)
	if pos.Y > Config.SKY.y - 300 then
		skyTick(pos)
		return
	end
	if skySea then
		skySea:Destroy()
		skySea = nil
	end
	-- 하늘의 천층탑 시련장에서는 땅의 이름을 알리지 않는다
	if pos.Y > 1000 then
		return
	end
	local r = regionAt(pos)
	local id = r and r.id or "wild"
	if id ~= regionNow then
		regionNow = id
		if r then
			local lv = Config.enemyLevel(pos)
			local rec = regionPower(r.id)
			UI.toast(string.format("📍 %s%s%s", r.name, r.safe and "  · 안전한 곳" or string.format("  · 적 수준 %d", lv), (rec and not r.safe) and ("  · " .. powerAdvice(rec)) or ""))
		end
	end
	local a = AMBIENT[r and r.ambient or "default"] or AMBIENT.default
	local atmo = game:GetService("Lighting"):FindFirstChildOfClass("Atmosphere")
	if atmo then
		atmo.Density += (a.d - atmo.Density) * 0.08
		atmo.Haze += (a.h - atmo.Haze) * 0.08
		atmo.Color = atmo.Color:Lerp(a.c, 0.08)
	end
end

local mapAcc = 0
local function updateMap(dt: number)
	local pos = myPos()
	local char = player.Character
	local root = char and char:FindFirstChild("HumanoidRootPart")
	if pos and root and root:IsA("BasePart") then
		mapMe.Position = mapUV(pos)
		if not mapBig then
			applyView(pos)
		end
		local look = root.CFrame.LookVector
		mapMe.Rotation = math.deg(math.atan2(look.X, -look.Z))
	end
	-- 길잡이 글자와 도착
	if guideStyle and guideLabel and pos then
		local m = Config.MASTERS[guideStyle]
		local dir, dist = bearing(pos, m.at)
		guideLabel.Text = string.format("📍 %s\n%s쪽 · %d칸", m.name, dir, math.floor(dist))
		if dist < Config.MASTER_RANGE - 4 then
			UI.toast("🥋 " .. m.name .. " 곁에 왔어요. T를 눌러 권법을 배우세요")
			UI.setGuide(nil)
		end
	end
	if pos then
		storyTick(pos)
	end
	mapAcc += dt
	if mapAcc < 0.25 then
		return
	end
	mapAcc = 0
	if pos then
		ambientTick(pos)
	end
	declutter()
	local n = 0
	local enemies = workspace:FindFirstChild("Enemies")
	if enemies and pos then
		local range = mapBig and 900 or 700
		for _, e in ipairs(enemies:GetChildren()) do
			local r = e:FindFirstChild("HumanoidRootPart")
			if n < #mapDots and r and r:IsA("BasePart") and e:GetAttribute("Dead") ~= true and (r.Position - pos).Magnitude < range then
				n += 1
				local d = mapDots[n]
				d.Position = mapUV(r.Position)
				d.Size = e:GetAttribute("Boss") == true and UDim2.new(0, 10, 0, 10) or UDim2.new(0, 6, 0, 6)
				d.Visible = true
			end
		end
	end
	for i = n + 1, #mapDots do
		mapDots[i].Visible = false
	end
	-- 권법 창이 열려 있으면 사부까지 거리도 새로
	if window.Visible and current == "styles" and refreshers.styles then
		refreshers.styles(false)
	end
end

------------------------------------------------------------------------
-- 바람 줄 (빠르게 달리거나 대시할 때 화면 가장자리로 흐르는 선)
------------------------------------------------------------------------
local speedLines: { { f: Frame, a: number, d: number } } = {}
local speedAmt = 0
function UI.setSpeed(amount: number)
	speedAmt += (amount - speedAmt) * 0.25
	if #speedLines == 0 or not gui then
		return
	end
	local t = os.clock()
	for i, l in ipairs(speedLines) do
		local k = ((t * 2.2 + l.d) % 1)
		local r = 0.42 + k * 0.25
		l.f.Position = UDim2.fromScale(0.5 + math.cos(l.a) * r, 0.5 + math.sin(l.a) * r * 1.1)
		l.f.Rotation = math.deg(l.a)
		l.f.BackgroundTransparency = 1 - speedAmt * 0.55 * (1 - k)
		l.f.Visible = speedAmt > 0.02
		local _ = i
	end
end
local function buildSpeedLines()
	for i = 1, 22 do
		local a = (i / 22) * math.pi * 2 + math.random() * 0.2
		local f = new("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.new(0, 160, 0, 2), BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0, BackgroundTransparency = 1, Visible = false, ZIndex = 2, Parent = gui })
		table.insert(speedLines, { f = f, a = a, d = math.random() })
	end
end

------------------------------------------------------------------------
-- 휴대폰 버튼
------------------------------------------------------------------------
function UI.mobile(actions: { [string]: any })
	if not UserInputService.TouchEnabled then
		return
	end
	local pad = new("Frame", { AnchorPoint = Vector2.new(1, 1), Position = UDim2.new(1, -20, 1, -190), Size = UDim2.new(0, 260, 0, 260), BackgroundTransparency = 1, Parent = gui })
	scaled(pad)
	local function round(label: string, pos: UDim2, size: number, color: Color3, down: () -> (), up: (() -> ())?)
		local b = new("TextButton", { AnchorPoint = Vector2.new(0.5, 0.5), Position = pos, Size = UDim2.new(0, size, 0, size), BackgroundColor3 = color, BackgroundTransparency = 0.25, Text = label, TextSize = 16, Font = Enum.Font.GothamBlack, TextColor3 = C.text, Parent = pad }, { corner(999), stroke(Color3.new(1, 1, 1), 2) })
		b.MouseButton1Down:Connect(down)
		if up then
			b.MouseButton1Up:Connect(up)
			b.MouseLeave:Connect(up)
		end
	end
	round("👊", UDim2.fromScale(0.72, 0.72), 96, C.red, actions.attack)
	round("💥", UDim2.fromScale(0.36, 0.86), 62, C.panel2, actions.heavyDown, actions.heavyUp)
	round("🛡", UDim2.fromScale(0.95, 0.38), 62, C.panel2, actions.guardDown, actions.guardUp)
	round("💨", UDim2.fromScale(0.42, 0.52), 58, C.panel2, actions.dash)
	round("E", UDim2.fromScale(0.12, 0.62), 50, C.panel2, actions.E)
	round("R", UDim2.fromScale(0.62, 0.28), 50, C.panel2, actions.R)
	round("G", UDim2.fromScale(0.22, 0.3), 50, C.gold, actions.G)
	if actions.X then
		round("X", UDim2.fromScale(0.36, 0.14), 46, Color3.fromRGB(255, 140, 190), actions.X)
	end
	round("🧪", UDim2.fromScale(0.95, 0.05), 44, C.green, actions.potion)
	round("●", UDim2.fromScale(0.05, 0.95), 44, C.chi, actions.train)
	round("🐎", UDim2.fromScale(0.05, 0.62), 44, C.panel2, actions.mount)
end

------------------------------------------------------------------------
-- 만들기
------------------------------------------------------------------------
function UI.init(req: RemoteEvent)
	Request = req
	gui = new("ScreenGui", { Name = "KwonUI", ResetOnSpawn = false, IgnoreGuiInset = true, ZIndexBehavior = Enum.ZIndexBehavior.Sibling, Parent = player:WaitForChild("PlayerGui") })
	-- 화면이 클수록 크게 (1080p에서 1.5배). 창은 화면을 넘지 않게. 화면 크기가 바뀌면 다시 잰다
	measure()
	local camConn: RBXScriptConnection? = nil
	local function watchCam()
		if camConn then
			camConn:Disconnect()
			camConn = nil
		end
		local cam = workspace.CurrentCamera
		if cam then
			camConn = cam:GetPropertyChangedSignal("ViewportSize"):Connect(measure)
		end
		measure()
	end
	watchCam()
	workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(watchCam)
	-- 혹시 신호를 놓쳐도 처음 몇 초는 몇 번 더 잰다
	task.spawn(function()
		for _ = 1, 10 do
			task.wait(0.5)
			measure()
		end
	end)
	flash = new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(1, 1, 1), BackgroundTransparency = 1, ZIndex = 40, Active = false, Parent = gui })
	for _, top in ipairs({ true, false }) do
		table.insert(bars, new("Frame", { AnchorPoint = Vector2.new(0, top and 0 or 1), Position = UDim2.fromScale(0, top and 0 or 1), Size = UDim2.new(1, 0, 0, 0), BackgroundColor3 = Color3.new(0, 0, 0), BorderSizePixel = 0, ZIndex = 30, Parent = gui }))
	end
	toastBox = new("Frame", { AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 120), Size = UDim2.new(0, 760, 0, 230), BackgroundTransparency = 1, Parent = gui }, { new("UIListLayout", { VerticalAlignment = Enum.VerticalAlignment.Top }) })
	scaled(toastBox)
	buildHud()
	-- 위 왼쪽: 경지·은자·능력치, 메뉴
	local topLeft = new("Frame", { Name = "TopLeft", Position = UDim2.new(0, 16, 0, 60), Size = UDim2.new(0, 820, 0, 500), BackgroundTransparency = 1, Parent = gui }) :: Frame
	scaled(topLeft)
	topInfo = text({ Size = UDim2.new(1, 0, 0, 28), TextSize = 20, Font = Enum.Font.GothamBlack, TextStrokeTransparency = 0.3, Parent = topLeft })
	local menu = new("Frame", { Name = "Menu", Position = UDim2.new(0, 0, 0, 34), Size = UDim2.new(0, 150, 0, 424), BackgroundTransparency = 1, Parent = topLeft }, { new("UIListLayout", { Padding = UDim.new(0, 4), SortOrder = Enum.SortOrder.LayoutOrder }) })
	for _, item in ipairs({ { "styles", "🥋 권법" }, { "map", "🗺 지도 (M)" }, { "stats", "📊 능력치" }, { "ach", "🏆 업적" }, { "train", "🧘 수련 안내" }, { "manuals", "📜 심법" }, { "shop", "🧪 만물상" }, { "help", "📜 도움말" }, { "tower", "🗼 천층탑으로" }, { "pvp", "⚔ PvP 켜짐" }, { "test", "🧪 테스트" } }) do
		local b = button({ Size = UDim2.new(1, 0, 0, 34), Text = item[2], TextSize = 17, Parent = menu }, function()
			if item[1] == "pvp" then
				Request:FireServer("pvpToggle")
			elseif item[1] == "tower" then
				Request:FireServer("towerTp")
			elseif item[1] == "map" then
				UI.toggleMap()
			else
				UI.openPage(item[1])
			end
		end)
		new("UIStroke", { Color = C.line, Thickness = 1, Parent = b })
		if item[1] == "test" then
			b.Name = "TestButton"
			b.Visible = false
		elseif item[1] == "pvp" then
			b.Name = "PvpButton"
		end
	end
	buildStory(topLeft)
	-- 보스 막대
	-- 보스 막대: 어두운 판, 금빛 테, 이름·단계·전투력, 체력 (흰 띠가 따라온다), 단계 눈금, 균형
	bossFrame = new("Frame", { AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 34), Size = UDim2.new(0, 760, 0, 92), BackgroundColor3 = Color3.fromRGB(14, 8, 8), BackgroundTransparency = 0.25, Visible = false, Parent = gui }, { corner(12), stroke(Color3.fromRGB(190, 60, 40), 2) })
	new("UIGradient", { Rotation = 90, Transparency = NumberSequence.new(0.1, 0.5), Parent = bossFrame })
	scaled(bossFrame)
	bossName = text({ Position = UDim2.new(0, 0, 0, 4), Size = UDim2.new(1, 0, 0, 28), TextSize = 26, Font = Enum.Font.GothamBlack, TextColor3 = Color3.fromRGB(255, 205, 120), TextXAlignment = Enum.TextXAlignment.Center, TextStrokeTransparency = 0.1, Parent = bossFrame })
	bossSub = text({ Position = UDim2.new(0, 0, 0, 32), Size = UDim2.new(1, 0, 0, 18), TextSize = 15, TextColor3 = C.dim, TextXAlignment = Enum.TextXAlignment.Center, TextStrokeTransparency = 0.3, Parent = bossFrame })
	local bb = new("Frame", { Position = UDim2.new(0, 16, 0, 52), Size = UDim2.new(1, -32, 0, 20), BackgroundColor3 = Color3.fromRGB(25, 10, 10), Parent = bossFrame }, { corner(6), stroke(Color3.fromRGB(150, 115, 70), 1.5) })
	local bossTrail = new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.fromRGB(255, 235, 200), BackgroundTransparency = 0.2, Parent = bb }, { corner(6) })
	bossFill = new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.fromRGB(200, 30, 30), ZIndex = 2, Parent = bb }, { corner(6) })
	sheen(bossFill)
	meterTrails[bossFill] = bossTrail
	-- 단계 눈금 (2/3, 1/3)
	for _, x in ipairs({ 0.66, 0.33 }) do
		new("Frame", { Position = UDim2.new(x, -1, 0, -3), Size = UDim2.new(0, 3, 1, 6), BackgroundColor3 = Color3.fromRGB(255, 220, 140), BorderSizePixel = 0, ZIndex = 4, Parent = bb })
	end
	bossHpText = text({ Size = UDim2.fromScale(1, 1), TextSize = 14, Font = Enum.Font.GothamBold, TextXAlignment = Enum.TextXAlignment.Center, TextStrokeTransparency = 0.2, ZIndex = 5, Parent = bb })
	local pb = new("Frame", { Position = UDim2.new(0.25, 0, 0, 77), Size = UDim2.new(0.5, 0, 0, 8), BackgroundColor3 = Color3.fromRGB(20, 10, 10), Parent = bossFrame }, { corner(4) })
	bossPosture = new("Frame", { AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.fromScale(0.5, 0), Size = UDim2.fromScale(0, 1), BackgroundColor3 = C.posture, Parent = pb }, { corner(4) })
	RunService.RenderStepped:Connect(function()
		local m = bossModel
		-- 보스가 쓰러졌거나, 내가 쓰러졌거나, 멀리 떨어지면 막대를 걷는다
		if m and m.Parent then
			local me = Players.LocalPlayer.Character
			local mr = me and me:FindFirstChild("HumanoidRootPart")
			local br = m:FindFirstChild("HumanoidRootPart")
			if m:GetAttribute("Dead") == true or (me and me:GetAttribute("Dead") == true) or (mr and br and mr:IsA("BasePart") and br:IsA("BasePart") and (mr.Position - br.Position).Magnitude > 170) then
				UI.setBoss(nil)
				return
			end
		end
		if m and m.Parent then
			local hp, mx = m:GetAttribute("Hp"), m:GetAttribute("MaxHp")
			local po, pm = m:GetAttribute("Posture"), m:GetAttribute("PostureMax")
			if type(hp) == "number" and type(mx) == "number" then
				trailTo(bossFill, math.clamp(hp / math.max(1, mx), 0, 1))
				bossHpText.Text = string.format("%s / %s", Config.formatNumber(math.max(0, math.floor(hp))), Config.formatNumber(mx))
			end
			if type(po) == "number" and type(pm) == "number" then
				bossPosture.Size = UDim2.fromScale(math.clamp(po / math.max(1, pm), 0, 1), 1)
			end
		elseif m then
			UI.setBoss(nil)
		end
	end)
	-- 창
	window = new("Frame", { Name = "Window", AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.new(0, 900, 0, 600), BackgroundColor3 = C.bg, BackgroundTransparency = 0.04, Visible = false, ZIndex = 10, Parent = gui }, { corner(16), stroke(C.line, 2.5) })
	scaled(window, "window")
	new("UIGradient", { Rotation = 90, Color = ColorSequence.new(Color3.fromRGB(255, 255, 255), Color3.fromRGB(170, 160, 150)), Parent = window })
	windowTitle = text({ Position = UDim2.new(0, 18, 0, 10), Size = UDim2.new(1, -80, 0, 36), TextSize = 28, Font = Enum.Font.GothamBlack, TextColor3 = C.gold, Parent = window })
	new("Frame", { Position = UDim2.new(0, 18, 0, 48), Size = UDim2.new(1, -36, 0, 2), BackgroundColor3 = C.line, BorderSizePixel = 0, Parent = window }, { new("UIGradient", { Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(0.7, 0.4), NumberSequenceKeypoint.new(1, 1) }) }) })
	button({ AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -12, 0, 10), Size = UDim2.new(0, 48, 0, 40), Text = "✕", TextSize = 22, BackgroundColor3 = C.red, Parent = window }, function()
		window.Visible = false
	end)
	buildStyles()
	buildStats()
	buildAch()
	buildShop()
	buildManuals()
	buildSkyShop()
	buildHelp()
	buildTrainGuide()
	buildTest()
	buildMap()
	buildSpeedLines()
	RunService.RenderStepped:Connect(function(dt: number)
		local ok, err = pcall(updateMap, dt)
		if not ok then
			warn("[권왕] 지도 오류:", err)
		end
	end)
	-- 수련 놀이 칸
	trainFrame = new("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0.5, 0, 0.45, 0), Size = UDim2.new(0, 400, 0, 400), BackgroundColor3 = C.bg, BackgroundTransparency = 0.25, Visible = false, Parent = gui }, { corner(16), stroke(C.line, 2) })
	scaled(trainFrame)
	trainTitle = text({ Position = UDim2.new(0, 0, 0, 8), Size = UDim2.new(1, 0, 0, 30), TextSize = 22, Font = Enum.Font.GothamBlack, TextColor3 = C.gold, TextXAlignment = Enum.TextXAlignment.Center, Parent = trainFrame })
	trainHint = text({ Position = UDim2.new(0, 12, 0, 40), Size = UDim2.new(1, -24, 0, 40), TextSize = 14, TextColor3 = C.dim, TextXAlignment = Enum.TextXAlignment.Center, Parent = trainFrame })
	trainArea = new("Frame", { Position = UDim2.new(0, 0, 0, 84), Size = UDim2.new(1, 0, 1, -200), BackgroundTransparency = 1, ClipsDescendants = true, Parent = trainFrame })
	-- 하는 법 (세 걸음)
	trainGuide = text({ AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -52), Size = UDim2.new(1, -24, 0, 62), TextSize = 15, TextWrapped = true, TextColor3 = Color3.fromRGB(255, 230, 170), TextXAlignment = Enum.TextXAlignment.Center, BackgroundColor3 = C.panel2, BackgroundTransparency = 0.4, Parent = trainFrame })
	button({ AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -8), Size = UDim2.new(0, 160, 0, 36), Text = "그만하기", TextSize = 16, BackgroundColor3 = C.panel2, Parent = trainFrame }, function()
		Request:FireServer("trainStop")
	end)
	-- 쓰러짐
	koFrame = new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.fromRGB(30, 0, 0), BackgroundTransparency = 0.55, Visible = false, ZIndex = 35, Parent = gui })
	koText = text({ AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.new(1, 0, 0, 60), TextSize = 30, Font = Enum.Font.GothamBlack, TextXAlignment = Enum.TextXAlignment.Center, TextStrokeTransparency = 0.2, ZIndex = 36, Parent = koFrame })
end

function UI.gui(): ScreenGui
	return gui
end

return UI
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="29">
          <Properties>
            <string name="Name">Ult2</string>
            <string name="Source"><![CDATA[-- 권왕 2.0판: 새 오의들의 화면
-- 각성 권법 아홉의 오의 (혈해만마 · 구룡승천 · 뇌정천망 · 천수여래 · 무영천살 · 창해만류 · 화룡천멸 · 심해강림 · 천풍만검)
-- 초·벽력신권의 뇌룡승천과 초 오의 구천뇌정 (컷씬 포함)
local Lighting = game:GetService("Lighting")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local Config = require(ReplicatedStorage:WaitForChild("Config"))
local Fx = require(script.Parent:WaitForChild("Fx"))
local Demon = require(script.Parent:WaitForChild("Demon"))

local Ult2 = {}
local player = Players.LocalPlayer

local WHITE = Color3.new(1, 1, 1)
local folder = Instance.new("Folder")
folder.Name = "KwonUlt2"
folder.Parent = workspace

local opts: any = {}
function Ult2.init(o: any)
	opts = o or {}
end

local function tween(inst: Instance, time: number, goal: { [string]: any }, style: Enum.EasingStyle?, dir: Enum.EasingDirection?)
	local tw = TweenService:Create(inst, TweenInfo.new(time, style or Enum.EasingStyle.Quad, dir or Enum.EasingDirection.Out), goal)
	tw:Play()
	return tw
end
local function rootOf(m: Instance?): BasePart?
	local r = m and m:FindFirstChild("HumanoidRootPart")
	return (r and r:IsA("BasePart")) and r or nil
end
local function near(pos: Vector3, d: number): boolean
	local cam = workspace.CurrentCamera
	return cam ~= nil and (cam.CFrame.Position - pos).Magnitude < d
end
local function flat(v: Vector3): Vector3
	local f = Vector3.new(v.X, 0, v.Z)
	return f.Magnitude > 1e-3 and f.Unit or Vector3.new(0, 0, -1)
end
local function part(size: Vector3, color: Color3, material: Enum.Material?, alpha: number?, shape: string?): Part
	local p = Instance.new("Part")
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	p.Size = size
	p.Color = color
	p.Material = material or Enum.Material.Neon
	p.Transparency = alpha or 0
	if shape == "ball" then
		p.Shape = Enum.PartType.Ball
	elseif shape == "cyl" then
		p.Shape = Enum.PartType.Cylinder
	end
	p.Parent = folder
	return p
end
local function fadeOut(p: BasePart, time: number, goal: { [string]: any }?)
	local g = goal or {}
	g.Transparency = 1
	tween(p, time, g)
	task.delay(time + 0.05, function()
		p:Destroy()
	end)
end
local function ground(at: Vector3): Vector3
	return Vector3.new(at.X, at.Y - 2.7, at.Z)
end
local function disc(at: Vector3, d: number, color: Color3, alpha: number, mat: Enum.Material?): Part
	local p = part(Vector3.new(0.2, d, d), color, mat or Enum.Material.Neon, alpha, "cyl")
	p.CFrame = CFrame.new(at) * CFrame.Angles(0, 0, math.rad(90))
	return p
end
-- 세로 기둥 (땅에서 위로)
local function column(base: Vector3, height: number, width: number, color: Color3, alpha: number?, mat: Enum.Material?): Part
	local c = part(Vector3.new(height, width, width), color, mat or Enum.Material.Neon, alpha or 0.1, "cyl")
	c.CFrame = CFrame.new(base + Vector3.new(0, height / 2, 0)) * CFrame.Angles(0, 0, math.rad(90))
	return c
end
local function styleColors(id: any): (Color3, Color3)
	local st = type(id) == "string" and Config.STYLE_BY_ID[id] or nil
	if st then
		return st.color, st.color2
	end
	return Color3.fromRGB(255, 200, 90), WHITE
end
local function shakeNear(pos: Vector3, amount: number, range: number)
	if opts.shake and near(pos, range) then
		opts.shake(amount)
	end
end
local function tintNear(pos: Vector3, color: Color3, strength: number, time: number)
	if opts.tint and near(pos, 90) then
		opts.tint(color, strength, time)
	end
end
-- 터지는 곳의 공통 마무리: 고리 셋, 불티, 흙먼지, 빛
local function blast(at: Vector3, radius: number, c: Color3, c2: Color3, power: number?)
	local k = power or 1
	local g = ground(at)
	for i = 0, 2 do
		task.delay(i * 0.07, function()
			Fx.ring(g + Vector3.new(0, 0.3, 0), i == 1 and c2 or c, 3, radius * 2.2 + i * 6, 0.7)
		end)
	end
	Fx.burst("spark", at + Vector3.new(0, 2, 0), c, math.floor(30 * k), 2 * k)
	Fx.burst("dust", g + Vector3.new(0, 0.5, 0), Color3.fromRGB(170, 155, 135), math.floor(24 * k), 2 * k)
	Fx.flash(at + Vector3.new(0, 3, 0), c, 50, 5 * k, 0.7)
	shakeNear(at, 1.2 * k, 90)
end

------------------------------------------------------------------------
-- 용 그리기: 마디 구슬이 길을 따라 늦게 따라오는 몸 + 머리의 뿔과 수염
-- path(t) → 위치 (t는 초). 머리가 앞서고 몸이 같은 길을 조금씩 늦게 간다
------------------------------------------------------------------------
type DragonLook = { body: Color3, belly: Color3, mat: Enum.Material, scale: number, seg: number, trail: Color3 }
local function dragon(look: DragonLook, path: (number) -> Vector3, dur: number, onEnd: (() -> ())?)
	local segs: { BasePart } = {}
	for k = 1, look.seg do
		local s = (2.6 - k * (1.6 / look.seg)) * look.scale
		local p = part(Vector3.new(s, s, s), k % 3 == 0 and look.belly or look.body, look.mat, k == 1 and 0 or 0.05, "ball")
		table.insert(segs, p)
	end
	local head = segs[1]
	head.Size = head.Size * 1.3
	-- 뿔 둘, 수염 둘
	local extras: { { p: BasePart, off: CFrame } } = {}
	for _, sd in ipairs({ -1, 1 }) do
		table.insert(extras, { p = part(Vector3.new(0.3, 0.3, 2.6) * look.scale, look.belly, Enum.Material.Neon, 0), off = CFrame.new(sd * 0.9 * look.scale, 1.2 * look.scale, 0.8 * look.scale) * CFrame.Angles(math.rad(-35), math.rad(sd * 18), 0) })
		table.insert(extras, { p = part(Vector3.new(0.15, 0.15, 3.2) * look.scale, look.trail, Enum.Material.Neon, 0.2), off = CFrame.new(sd * 0.7 * look.scale, -0.6 * look.scale, -1.4 * look.scale) * CFrame.Angles(math.rad(25), math.rad(sd * 30), 0) })
	end
	local a0 = Instance.new("Attachment")
	a0.Position = Vector3.new(0, 1, 0)
	a0.Parent = head
	local a1 = Instance.new("Attachment")
	a1.Position = Vector3.new(0, -1, 0)
	a1.Parent = head
	local tr = Instance.new("Trail")
	tr.Attachment0 = a0
	tr.Attachment1 = a1
	tr.Color = ColorSequence.new(look.trail, look.body)
	tr.Transparency = NumberSequence.new(0.2, 1)
	tr.Lifetime = 0.45
	tr.LightEmission = 0.7
	tr.WidthScale = NumberSequence.new(1, 0)
	tr.Parent = head
	local t0 = os.clock()
	local conn: RBXScriptConnection
	conn = RunService.RenderStepped:Connect(function()
		local t = os.clock() - t0
		if t > dur then
			conn:Disconnect()
			for _, sgm in ipairs(segs) do
				fadeOut(sgm, 0.25)
			end
			for _, e in ipairs(extras) do
				fadeOut(e.p, 0.2)
			end
			if onEnd then
				onEnd()
			end
			return
		end
		for k, sgm in ipairs(segs) do
			local tk = t - (k - 1) * 0.035
			local p = path(math.max(0, tk))
			local q = path(math.max(0, tk - 0.02))
			local d = p - q
			sgm.CFrame = d.Magnitude > 1e-3 and CFrame.lookAt(p, p + d) or CFrame.new(p)
		end
		for _, e in ipairs(extras) do
			e.p.CFrame = head.CFrame * e.off
		end
	end)
end
local function lookFor(kind: string, c: Color3, c2: Color3): DragonLook
	if kind == "fireDragon" then
		return { body = Color3.fromRGB(255, 90, 20), belly = Color3.fromRGB(255, 220, 110), mat = Enum.Material.Neon, scale = 1.9, seg = 22, trail = Color3.fromRGB(255, 160, 60) }
	elseif kind == "thunderDragon" then
		return { body = Color3.fromRGB(160, 130, 255), belly = Color3.fromRGB(255, 250, 200), mat = Enum.Material.Neon, scale = 1.5, seg = 20, trail = Color3.fromRGB(230, 220, 255) }
	end
	return { body = c, belly = c2, mat = Enum.Material.Foil, scale = 1.0, seg = 16, trail = c2 }
end

-- 용이 솟는다: 둘레(또는 내 몸)에서 땅을 뚫고 나와 나선으로 하늘로 감아 오른다
local function dragonsRise(data: any)
	local r = rootOf(data.m)
	local at: Vector3 = data.at
	if not near(at, 220) then
		return
	end
	local c, c2 = styleColors(data.style)
	local look = lookFor(data.look or "nineDragons", c, c2)
	local n = data.n or 1
	local R = data.radius or 10
	local rise = data.rise or 1
	local g = ground(at)
	for i = 1, n do
		local a0 = (i - 1) / n * math.pi * 2
		local start = g + Vector3.new(math.cos(a0), 0, math.sin(a0)) * (n > 1 and R or 2)
		Fx.burst("dust", start + Vector3.new(0, 0.5, 0), Color3.fromRGB(160, 140, 110), 10, 1.4)
		Fx.debris(start, 3, 14)
		dragon(look, function(t: number): Vector3
			local u = t / rise
			local ang = a0 + u * math.pi * 2.2
			local rad = (n > 1 and R or 4) * (1 - 0.4 * u)
			local base = r and r.Parent and ground(r.Position) or g
			return base + Vector3.new(math.cos(ang) * rad, -3 + u * 55, math.sin(ang) * rad)
		end, rise)
	end
	Fx.ring(g + Vector3.new(0, 0.3, 0), c, 3, R * 2.6, 0.6)
	Fx.flash(at, c, 40, 4, 0.6)
	Fx.sound("heavy", 1, 0.6, at)
	shakeNear(at, 1, 70)
end
-- 하늘에서 한 마리가 목표에 내리꽂힌다
local function dragonDive(data: any)
	local at: Vector3 = data.at
	if not near(at, 220) then
		return
	end
	local c, c2 = styleColors(data.style)
	local kind = data.look or "nineDragons"
	local look = lookFor(kind, c, c2)
	local from: Vector3 = data.from or at
	local side = flat(at - from)
	local sky = at + Vector3.new(0, 60, 0) - side * 30 + Vector3.new(side.Z, 0, -side.X) * ((data.i or 1) % 2 == 0 and 14 or -14)
	local dur = 0.32
	dragon(look, function(t: number): Vector3
		local u = math.clamp(t / dur, 0, 1)
		local e = u * u
		return sky:Lerp(at - Vector3.new(0, 2, 0), e) + Vector3.new(0, math.sin(u * math.pi) * 6, 0)
	end, dur + 0.12, function()
		local radius = data.radius or 8
		blast(at, radius, look.body, look.belly, 0.8)
		if kind == "thunderDragon" then
			Fx.lightning(at + Vector3.new(0, 50, 0), at, look.trail, 0.7)
		elseif kind == "fireDragon" then
			Fx.burst("ember", at + Vector3.new(0, 2, 0), look.trail, 30, 2)
		end
		Fx.sound("heavy", 0.8, 0.8, at)
	end)
end
local function dragonsEnd(data: any)
	local at: Vector3 = data.at
	local c, c2 = styleColors(data.style)
	local look = lookFor(data.look or "nineDragons", c, c2)
	local R = data.radius or 20
	local g = ground(at)
	local col = column(g, 90, R * 0.8, look.belly, 0.05)
	fadeOut(col, 0.7, { Size = Vector3.new(120, R * 1.8, R * 1.8) })
	local core = column(g, 90, R * 0.3, WHITE, 0)
	fadeOut(core, 0.4)
	blast(at, R, look.body, look.belly, 1.6)
	if data.look == "thunderDragon" then
		for _ = 1, 6 do
			local a = math.random() * math.pi * 2
			local p = at + Vector3.new(math.cos(a), 0, math.sin(a)) * math.random(3, math.floor(R))
			Fx.lightning(p + Vector3.new(0, 45, 0), p, look.trail, 0.5)
		end
	end
	Fx.sound("heavy", 1, 0.4, at)
	tintNear(at, look.body, 0.25, 0.4)
end
-- 화룡천멸: 떨어진 자리가 용암이 되어 터진다
local function lavaBurst(data: any)
	local at: Vector3 = data.at
	local R = data.radius or 18
	local g = ground(at)
	if (data.i or 1) == 1 then
		local pool = disc(g + Vector3.new(0, 0.12, 0), R * 2, Color3.fromRGB(255, 90, 20), 0.15)
		task.delay(1.6, function()
			fadeOut(pool, 0.8)
		end)
	end
	for _ = 1, 5 do
		local a = math.random() * math.pi * 2
		local p = g + Vector3.new(math.cos(a), 0, math.sin(a)) * math.random(0, math.floor(R * 0.8))
		local col = column(p, 14 + math.random() * 8, 2.6, Color3.fromRGB(255, 120, 30), 0.1)
		fadeOut(col, 0.45, { Size = Vector3.new(26, 0.4, 0.4) })
	end
	Fx.burst("ember", at + Vector3.new(0, 2, 0), Color3.fromRGB(255, 140, 50), 30, 2)
	Fx.flash(at, Color3.fromRGB(255, 110, 30), 40, 4, 0.5)
	Fx.sound("heavy", 0.7, 0.9, at)
	shakeNear(at, 0.7, 60)
end

------------------------------------------------------------------------
-- 혈해만마: 피의 바다, 솟는 손톱, 피의 소용돌이 기둥
------------------------------------------------------------------------
local BLOOD = Color3.fromRGB(150, 0, 18)
local function bloodSea(data: any)
	local at: Vector3 = data.at
	if not near(at, 200) then
		return
	end
	local R = data.radius or 26
	local dur = data.dur or 3
	local g = ground(at)
	local sea = disc(g + Vector3.new(0, 0.1, 0), 2, BLOOD, 0.15, Enum.Material.Glass)
	tween(sea, 0.5, { Size = Vector3.new(0.2, R * 2.1, R * 2.1) })
	local glow = disc(g + Vector3.new(0, 0.14, 0), 2, Color3.fromRGB(230, 20, 40), 0.6)
	tween(glow, 0.5, { Size = Vector3.new(0.2, R * 1.6, R * 1.6) })
	-- 끓는 거품
	local host = part(Vector3.new(R * 1.8, 1, R * 1.8), BLOOD, Enum.Material.SmoothPlastic, 1)
	host.CFrame = CFrame.new(g + Vector3.new(0, 0.6, 0))
	local pe = Instance.new("ParticleEmitter")
	pe.Texture = "rbxasset://textures/particles/sparkles_main.dds"
	pe.Color = ColorSequence.new(Color3.fromRGB(220, 20, 40), BLOOD)
	pe.Rate = 60
	pe.Lifetime = NumberRange.new(0.4, 0.8)
	pe.Speed = NumberRange.new(2, 6)
	pe.Size = NumberSequence.new(0.5, 0)
	pe.Shape = Enum.ParticleEmitterShape.Box
	pe.Parent = host
	task.delay(dur, function()
		pe.Enabled = false
		fadeOut(sea, 0.8)
		fadeOut(glow, 0.6)
		task.delay(1, function()
			host:Destroy()
		end)
	end)
	tintNear(at, Color3.fromRGB(140, 0, 20), 0.3, dur)
	Fx.sound("splash", 1, 0.5, at)
	-- 2.1판: 피의 바다에서 악마 다섯이 허리까지 솟아 바깥을 보며 손톱을 휘두른다
	local n = 5
	local spin = math.random() * math.pi * 2
	for i = 1, n do
		local ang = spin + (i / n) * math.pi * 2
		local out = Vector3.new(math.cos(ang), 0, math.sin(ang))
		local pos = g + out * R * 0.6
		local base = CFrame.lookAt(pos, pos + out)
		local sc = 1.15 + math.random() * 0.35
		local ph = math.random() * 6
		local dm = Demon.spawn(base * CFrame.new(0, -9 * sc, 0), sc, { legs = false })
		dm.anim = function(t: number)
			local rise = math.clamp(t / 0.45, 0, 1)
			rise = 1 - (1 - rise) ^ 3
			local sink = math.clamp((t - dur) / 0.6, 0, 1)
			local y = -9 * sc + 5.8 * sc * rise - 6 * sc * sink
			dm.root = base * CFrame.new(0, y + math.sin(t * 3 + ph) * 0.3 * sc, 0) * CFrame.Angles(0, math.sin(t * 1.3 + ph) * 0.35, 0)
			dm.armR = 0.4 + 2.0 * math.max(0, math.sin(t * 4.4 + ph))
			dm.armL = 0.4 + 2.0 * math.max(0, math.sin(t * 4.4 + ph + math.pi))
		end
		task.delay(dur + 0.6, function()
			Demon.remove(dm, 0.3)
		end)
	end
	Fx.sound("deflect", 0.8, 0.35, at)
end
local function bloodClaw(data: any)
	local at: Vector3 = data.at
	if not near(at, 200) then
		return
	end
	local g = ground(at)
	local yaw = math.random() * math.pi * 2
	-- 휜 손톱 셋이 피에서 솟는다
	for k = -1, 1 do
		local base = CFrame.new(g) * CFrame.Angles(0, yaw, 0) * CFrame.new(k * 1.6, 0, 0)
		for j = 0, 4 do
			local seg = part(Vector3.new(0.7 - j * 0.1, 1.8, 0.7 - j * 0.1), j == 4 and Color3.fromRGB(255, 200, 200) or Color3.fromRGB(200, 15, 35), Enum.Material.Neon, 0)
			local cf = base * CFrame.Angles(math.rad(-12 * j), 0, 0) * CFrame.new(0, 1 + j * 1.6, -j * 0.5)
			seg.CFrame = cf * CFrame.new(0, -9, 0)
			tween(seg, 0.12, { CFrame = cf }, Enum.EasingStyle.Back)
			task.delay(0.3, function()
				fadeOut(seg, 0.25, { CFrame = cf * CFrame.new(0, -4, 0) })
			end)
		end
	end
	Fx.burst("spark", at, Color3.fromRGB(230, 30, 50), 14, 1.2)
	Fx.ring(g + Vector3.new(0, 0.3, 0), Color3.fromRGB(230, 30, 50), 2, (data.radius or 7) * 2, 0.35)
	if (data.i or 1) % 2 == 0 then
		Fx.sound("hit", 0.6, 0.7, at)
	end
end
local function bloodVortex(data: any)
	local at: Vector3 = data.at
	local R = data.radius or 26
	local g = ground(at)
	-- 핏빛 소용돌이 기둥: 돌아가는 고리들이 위로 솟는다
	for k = 0, 9 do
		task.delay(k * 0.04, function()
			local ring = part(Vector3.new(0.4, R * (1.2 - k * 0.07), R * (1.2 - k * 0.07)), k % 2 == 0 and Color3.fromRGB(220, 20, 40) or BLOOD, Enum.Material.Neon, 0.25, "cyl")
			ring.CFrame = CFrame.new(g + Vector3.new(0, 1 + k * 4, 0)) * CFrame.Angles(0, 0, math.rad(90))
			fadeOut(ring, 0.6, { CFrame = ring.CFrame * CFrame.new(10, 0, 0) * CFrame.Angles(math.rad(90), 0, 0) })
		end)
	end
	local col = column(g, 80, R * 0.5, Color3.fromRGB(230, 20, 40), 0.15)
	fadeOut(col, 0.7, { Size = Vector3.new(100, R * 1.2, R * 1.2) })
	blast(at, R, Color3.fromRGB(230, 20, 40), Color3.fromRGB(255, 170, 170), 1.6)
	Fx.sound("splash", 1, 0.4, at)
end

------------------------------------------------------------------------
-- 뇌정천망: 적들을 잇는 번개 그물
------------------------------------------------------------------------
local VIOLET = Color3.fromRGB(175, 110, 255)
local nets: { [Model]: { until_: number, targets: { Model } } } = {}
local function netStart(data: any)
	local m: Model? = data.m
	if not m then
		return
	end
	nets[m :: Model] = { until_ = os.clock() + (data.dur or 2), targets = data.targets or {} }
	local r = rootOf(m)
	if r then
		tintNear(r.Position, Color3.fromRGB(90, 60, 180), 0.3, data.dur or 2)
	end
end
RunService.Heartbeat:Connect(function()
	local t = os.clock()
	for m, net in pairs(nets) do
		if t > net.until_ or not m.Parent then
			nets[m] = nil
		elseif math.random() < 0.5 then
			-- 그물 새로 그리기 (무작위로 이어지는 번개): 나 → 적, 적 → 가까운 적
			local r = rootOf(m)
			local pts: { Vector3 } = {}
			for _, tm in ipairs(net.targets) do
				local tr = rootOf(tm)
				if tr and tm:GetAttribute("Dead") ~= true then
					table.insert(pts, tr.Position)
				end
			end
			if r and near(r.Position, 150) then
				for i, p in ipairs(pts) do
					if i <= 4 then
						Fx.lightning(r.Position + Vector3.new(0, 1, 0), p, VIOLET, 0.25)
					end
					local q = pts[i % #pts + 1]
					if q and q ~= p then
						Fx.lightning(p, q, Color3.fromRGB(220, 200, 255), 0.2)
					end
				end
			end
		end
	end
end)
local function netPulse(data: any)
	for _, tm in ipairs(data.targets or {}) do
		local tr = rootOf(tm)
		if tr then
			local b = part(Vector3.new(1, 1, 1), VIOLET, Enum.Material.Neon, 0.2, "ball")
			b.CFrame = CFrame.new(tr.Position)
			fadeOut(b, 0.25, { Size = Vector3.new(6, 6, 6) })
		end
	end
	local r = rootOf(data.m)
	if r then
		Fx.sound("deflect", 0.6, 1.4, r.Position)
	end
end
local function netEnd(data: any)
	for _, tm in ipairs(data.targets or {}) do
		local tr = rootOf(tm)
		if tr then
			local p = tr.Position
			Fx.lightning(p + Vector3.new(0, 60, 0), p, Color3.fromRGB(235, 225, 255), 0.9)
			local col = column(ground(p), 60, 3, VIOLET, 0.1)
			fadeOut(col, 0.4, { Size = Vector3.new(70, 0.4, 0.4) })
			Fx.ring(ground(p) + Vector3.new(0, 0.3, 0), VIOLET, 2, 18, 0.5)
		end
	end
	local r = rootOf(data.m)
	if r then
		Fx.flash(r.Position, VIOLET, 60, 6, 0.6)
		shakeNear(r.Position, 1.6, 90)
		Fx.sound("heavy", 1, 0.8, r.Position)
	end
	if data.m then
		nets[data.m] = nil
	end
end

------------------------------------------------------------------------
-- 천수여래: 등 뒤의 금빛 여래 (팔 여럿), 팔이 내리치는 손바닥
------------------------------------------------------------------------
local GOLD = Color3.fromRGB(255, 190, 60)
local GOLD_PALE = Color3.fromRGB(255, 245, 200)
local statues: { [Model]: Model } = {}
local function armsStart(data: any)
	local m: Model? = data.m
	local r = rootOf(m)
	if not m or not r then
		return
	end
	local dur = data.dur or 3
	local look = flat(r.CFrame.LookVector)
	local base = CFrame.lookAt(ground(r.Position) - look * 10, ground(r.Position) - look * 10 + look)
	local mdl = Instance.new("Model")
	mdl.Name = "ThousandArms"
	local function add(p: BasePart, cf: CFrame)
		p.CFrame = base * cf * CFrame.new(0, -40, 0)
		p.Parent = mdl
		tween(p, 0.6, { CFrame = base * cf }, Enum.EasingStyle.Back)
	end
	add(part(Vector3.new(12, 16, 7), GOLD, Enum.Material.Foil, 0.15), CFrame.new(0, 14, 0))
	add(part(Vector3.new(8, 8, 8), GOLD, Enum.Material.Foil, 0.15, "ball"), CFrame.new(0, 26, 0))
	add(part(Vector3.new(16, 5, 10), GOLD, Enum.Material.Foil, 0.2), CFrame.new(0, 4.5, 0))
	local halo = part(Vector3.new(0.4, 20, 20), GOLD_PALE, Enum.Material.Neon, 0.4, "cyl")
	add(halo, CFrame.new(0, 26, 4) * CFrame.Angles(0, math.rad(90), 0))
	-- 양쪽으로 부채처럼 펼친 팔 열둘
	for i = 1, 12 do
		local sd = i % 2 == 0 and 1 or -1
		local k = math.ceil(i / 2)
		local cf = CFrame.new(sd * 6, 18, 0) * CFrame.Angles(0, 0, math.rad(sd * (20 + k * 18))) * CFrame.new(0, 7, 0)
		add(part(Vector3.new(1.6, 14, 1.6), GOLD, Enum.Material.Foil, 0.2), cf)
		add(part(Vector3.new(2.6, 3, 1), GOLD_PALE, Enum.Material.Neon, 0.25), cf * CFrame.new(0, 7.5, 0))
	end
	mdl.Parent = folder
	local mm = m :: Model
	statues[mm] = mdl
	task.delay(dur, function()
		for _, p in ipairs(mdl:GetChildren()) do
			if p:IsA("BasePart") then
				fadeOut(p, 0.6)
			end
		end
		task.delay(0.7, function()
			mdl:Destroy()
		end)
		if statues[mm] == mdl then
			statues[mm] = nil
		end
	end)
	Fx.burst("glitter", r.Position + Vector3.new(0, 10, 0), GOLD, 40, 2.4)
	Fx.sound("deflect", 1, 0.4, r.Position)
	tintNear(r.Position, GOLD, 0.2, dur)
end
local function armStrike(data: any)
	local at: Vector3 = data.at
	local r = rootOf(data.m)
	local from = r and (r.Position + Vector3.new(0, 30, 0) - flat(r.CFrame.LookVector) * 10) or (at + Vector3.new(0, 40, 0))
	local g = ground(at)
	-- 금빛 손바닥 하나가 하늘에서 내리친다
	local palm = part(Vector3.new(6, 1.2, 7), GOLD, Enum.Material.Foil, 0.05)
	palm.CFrame = CFrame.new(from)
	tween(palm, 0.14, { CFrame = CFrame.new(g + Vector3.new(0, 0.8, 0)) * CFrame.Angles(0, math.random() * 6, 0) }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
	local beam = part(Vector3.new(1, 1, (from - g).Magnitude), GOLD_PALE, Enum.Material.Neon, 0.5)
	beam.CFrame = CFrame.lookAt((from + g) / 2, g)
	fadeOut(beam, 0.2)
	task.delay(0.14, function()
		Fx.ring(g + Vector3.new(0, 0.3, 0), GOLD, 2, (data.radius or 8) * 2.4, 0.45)
		Fx.burst("dust", g + Vector3.new(0, 0.5, 0), Color3.fromRGB(200, 175, 130), 12, 1.4)
		Fx.burst("glitter", g + Vector3.new(0, 1, 0), GOLD, 10, 1.2)
		Fx.sound("heavy", 0.7, 0.8, at)
		shakeNear(at, 0.6, 60)
		task.delay(0.25, function()
			fadeOut(palm, 0.3)
		end)
	end)
end

------------------------------------------------------------------------
-- 무영천살: 어둠, 붉은 표식, 한꺼번에 터짐, 하늘에서 그림자의 발
------------------------------------------------------------------------
local SHADOW = Color3.fromRGB(30, 12, 50)
local MARK = Color3.fromRGB(255, 40, 60)
local marks: { [Model]: { BasePart } } = {}
local function darkStart(data: any)
	local at: Vector3 = data.at
	local dur = data.dur or 2
	if near(at, 120) then
		local e = Instance.new("ColorCorrectionEffect")
		e.Name = "KwonShadowKill"
		e.Parent = Lighting
		tween(e, 0.3, { Brightness = -0.35, Contrast = 0.3, Saturation = -0.6 })
		task.delay(dur, function()
			tween(e, 0.4, { Brightness = 0, Contrast = 0, Saturation = 0 })
			task.delay(0.45, function()
				e:Destroy()
			end)
		end)
	end
	local g = ground(at)
	local fog = disc(g + Vector3.new(0, 0.1, 0), (data.radius or 36) * 2, SHADOW, 0.35, Enum.Material.SmoothPlastic)
	task.delay(dur, function()
		fadeOut(fog, 0.5)
	end)
	Fx.burst("smoke", at, SHADOW, 30, 2.4)
	Fx.sound("deflect", 0.8, 0.4, at)
end
local function killMark(data: any)
	local t: Model? = data.t
	local tr = rootOf(t)
	if not t or not tr then
		return
	end
	-- 몸 앞에 떠 있는 붉은 X 표식 (몸을 따라간다)
	local list: { BasePart } = {}
	for _, ang in ipairs({ 45, -45 }) do
		local bar = part(Vector3.new(0.4, 5, 0.4), MARK, Enum.Material.Neon, 0)
		table.insert(list, bar)
		bar:SetAttribute("Ang", ang)
	end
	local tm = t :: Model
	marks[tm] = list
	local t0 = os.clock()
	local conn: RBXScriptConnection
	conn = RunService.RenderStepped:Connect(function()
		if marks[tm] ~= list or not tr.Parent then
			conn:Disconnect()
			for _, b in ipairs(list) do
				if b.Parent then
					b:Destroy()
				end
			end
			return
		end
		local cam = workspace.CurrentCamera
		local face = cam and flat(cam.CFrame.Position - tr.Position) or Vector3.new(0, 0, 1)
		local pulse = 1 + 0.15 * math.sin((os.clock() - t0) * 18)
		for _, b in ipairs(list) do
			b.Size = Vector3.new(0.4, 5 * pulse, 0.4)
			b.CFrame = CFrame.lookAt(tr.Position + face * 1.6, tr.Position + face * 3) * CFrame.Angles(0, 0, math.rad(b:GetAttribute("Ang") or 0))
		end
	end)
	Fx.sound("swing", 0.6, 1.4, tr.Position)
end
local function killBurst(data: any)
	for _, t in ipairs(data.targets or {}) do
		local list = marks[t]
		marks[t] = nil
		if list then
			for _, b in ipairs(list) do
				fadeOut(b, 0.2, { Size = Vector3.new(1.2, 10, 1.2) })
			end
		end
		local tr = rootOf(t)
		if tr then
			for _ = 1, 3 do
				local d = Vector3.new(math.random() - 0.5, math.random() - 0.5, math.random() - 0.5).Unit
				local s = part(Vector3.new(0.2, 0.2, 12), MARK, Enum.Material.Neon, 0)
				s.CFrame = CFrame.lookAt(tr.Position - d * 6, tr.Position + d * 6)
				fadeOut(s, 0.25, { Size = Vector3.new(0.05, 0.05, 16) })
			end
			Fx.burst("smoke", tr.Position, SHADOW, 10, 1.2)
			Fx.burst("spark", tr.Position, MARK, 14, 1.2)
		end
	end
	Fx.sound("hit", 1, 0.6)
end
local function shadowStomp(data: any)
	local at: Vector3 = data.at
	local R = data.radius or 20
	local g = ground(at)
	-- 하늘에서 내려오는 거대한 그림자의 발 (발바닥 + 발가락)
	local foot = Instance.new("Model")
	local function add(size: Vector3, cf: CFrame, shape: string?)
		local p = part(size, SHADOW, Enum.Material.Neon, 0.15, shape)
		p.CFrame = cf
		p.Parent = foot
	end
	add(Vector3.new(R * 0.9, 4, R * 1.3), CFrame.new())
	for i = -2, 2 do
		add(Vector3.new(R * 0.18, R * 0.18, R * 0.18), CFrame.new(i * R * 0.17, 0, -R * 0.72), "ball")
	end
	foot.WorldPivot = CFrame.new()
	foot.Parent = folder
	local yaw = math.random() * math.pi * 2
	local fromCF = CFrame.new(g + Vector3.new(0, 90, 0)) * CFrame.Angles(0, yaw, 0)
	local toCF = CFrame.new(g + Vector3.new(0, 2, 0)) * CFrame.Angles(0, yaw, 0)
	foot:PivotTo(fromCF)
	local t0 = os.clock()
	local conn: RBXScriptConnection
	conn = RunService.RenderStepped:Connect(function()
		local u = math.clamp((os.clock() - t0) / 0.3, 0, 1)
		foot:PivotTo(fromCF:Lerp(toCF, u * u))
		if u >= 1 then
			conn:Disconnect()
			blast(at, R, VIOLET, MARK, 1.5)
			Fx.sound("heavy", 1, 0.4, at)
			for _, p in ipairs(foot:GetChildren()) do
				if p:IsA("BasePart") then
					fadeOut(p, 0.6)
				end
			end
			task.delay(0.7, function()
				foot:Destroy()
			end)
		end
	end)
end

------------------------------------------------------------------------
-- 창해만류 · 심해강림
------------------------------------------------------------------------
local WATER = Color3.fromRGB(60, 180, 255)
local walls: { [string]: { BasePart } } = {}
local function keyOf(v: Vector3): string
	return string.format("%d,%d,%d", math.floor(v.X), math.floor(v.Y), math.floor(v.Z))
end
local FOAM = Color3.fromRGB(225, 250, 255)
local DEEP = Color3.fromRGB(10, 30, 80)
local function maelstrom(data: any)
	local at: Vector3 = data.at
	local R = data.radius or 24
	local dur = data.dur or 2.4
	local g = ground(at)
	local pool = disc(g + Vector3.new(0, 0.1, 0), R * 2, WATER, 0.3, Enum.Material.Glass)
	-- 도는 물살 (나선 조각들)과 둘레에서 솟는 물의 벽
	local streaks: { BasePart } = {}
	for i = 1, 14 do
		local s = part(Vector3.new(0.5, 0.3, R * 0.5), i % 2 == 0 and FOAM or WATER, Enum.Material.Neon, 0.3)
		table.insert(streaks, s)
	end
	local wall: { BasePart } = {}
	local N = 22
	for i = 1, N do
		local w = part(Vector3.new(R * 2 * math.pi / N * 1.1, 1, 1.6), WATER, Enum.Material.Glass, 0.3)
		table.insert(wall, w)
	end
	local t0 = os.clock()
	local conn: RBXScriptConnection
	conn = RunService.RenderStepped:Connect(function()
		local t = os.clock() - t0
		if t > dur then
			conn:Disconnect()
			for _, s in ipairs(streaks) do
				fadeOut(s, 0.2)
			end
			return
		end
		for i, s in ipairs(streaks) do
			local a = i / #streaks * math.pi * 2 + t * 3
			local rad = R * (0.25 + 0.65 * ((i * 0.37 + t * 0.5) % 1))
			local p = g + Vector3.new(math.cos(a) * rad, 0.4, math.sin(a) * rad)
			s.CFrame = CFrame.lookAt(p, p + Vector3.new(-math.sin(a), 0, math.cos(a)))
		end
		local h = math.min(1, t / (dur * 0.7)) * 16
		for i, w in ipairs(wall) do
			local a = i / N * math.pi * 2
			w.Size = Vector3.new(w.Size.X, math.max(1, h), 1.6)
			w.CFrame = CFrame.new(g + Vector3.new(math.cos(a) * R, h / 2, math.sin(a) * R)) * CFrame.Angles(0, -a + math.pi / 2, 0)
		end
	end)
	task.delay(dur + 0.3, function()
		fadeOut(pool, 0.6)
	end)
	walls[keyOf(at)] = wall
	Fx.sound("splash", 1, 0.5, at)
end
local function maelstromEnd(data: any)
	local at: Vector3 = data.at
	local R = data.radius or 24
	local g = ground(at)
	local wl = walls[keyOf(at)]
	if wl then
		walls[keyOf(at)] = nil
		-- 벽이 안쪽으로 무너진다
		for _, w in ipairs(wl) do
			tween(w, 0.3, { CFrame = CFrame.new(g + Vector3.new(0, 2, 0)) * (w.CFrame - w.CFrame.Position), Size = Vector3.new(w.Size.X * 0.3, 2, 6) }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
			task.delay(0.3, function()
				fadeOut(w, 0.3)
			end)
		end
	end
	task.delay(0.3, function()
		local col = column(g, 50, R * 0.5, FOAM, 0.1, Enum.Material.Glass)
		fadeOut(col, 0.6, { Size = Vector3.new(70, R * 0.2, R * 0.2) })
		blast(at, R, WATER, FOAM, 1.5)
		Fx.burst("glitter", at + Vector3.new(0, 4, 0), FOAM, 50, 2.6)
		Fx.sound("splash", 1, 0.4, at)
	end)
end
local function abyss(data: any)
	local at: Vector3 = data.at
	local R = data.radius or 24
	local dur = data.dur or 1.8
	local g = ground(at)
	local deep = disc(g + Vector3.new(0, 0.12, 0), 2, DEEP, 0.05, Enum.Material.Glass)
	tween(deep, 0.4, { Size = Vector3.new(0.2, R * 2, R * 2) })
	local rim = disc(g + Vector3.new(0, 0.16, 0), R * 2, WATER, 0.5)
	rim.Size = Vector3.new(0.2, R * 2.05, R * 2.05)
	local host = part(Vector3.new(R * 1.6, 1, R * 1.6), DEEP, Enum.Material.SmoothPlastic, 1)
	host.CFrame = CFrame.new(g + Vector3.new(0, 0.6, 0))
	local pe = Instance.new("ParticleEmitter")
	pe.Texture = "rbxasset://textures/particles/sparkles_main.dds"
	pe.Color = ColorSequence.new(FOAM, WATER)
	pe.Rate = 50
	pe.Lifetime = NumberRange.new(0.6, 1.2)
	pe.Speed = NumberRange.new(3, 7)
	pe.Size = NumberSequence.new(0.6, 0.1)
	pe.Shape = Enum.ParticleEmitterShape.Box
	pe.Parent = host
	task.delay(dur + 0.3, function()
		pe.Enabled = false
		fadeOut(deep, 0.6)
		fadeOut(rim, 0.5)
		task.delay(1.2, function()
			host:Destroy()
		end)
	end)
	tintNear(at, Color3.fromRGB(20, 50, 120), 0.35, dur)
	Fx.sound("splash", 1, 0.4, at)
end
local function abyssEnd(data: any)
	local at: Vector3 = data.at
	local R = data.radius or 24
	local g = ground(at)
	local col = column(g, 1, R * 0.9, WATER, 0.15, Enum.Material.Glass)
	tween(col, 0.25, { Size = Vector3.new(90, R * 0.9, R * 0.9), CFrame = CFrame.new(g + Vector3.new(0, 45, 0)) * CFrame.Angles(0, 0, math.rad(90)) })
	task.delay(0.3, function()
		fadeOut(col, 0.7, { Size = Vector3.new(110, R * 1.3, R * 1.3) })
	end)
	local core = column(g, 90, R * 0.4, FOAM, 0.1, Enum.Material.Neon)
	fadeOut(core, 0.5)
	blast(at, R, WATER, FOAM, 1.6)
	Fx.burst("glitter", at + Vector3.new(0, 8, 0), FOAM, 60, 3)
	Fx.sound("splash", 1, 0.3, at)
end

------------------------------------------------------------------------
-- 천풍만검: 몸을 도는 바람 칼날, 사방으로 쏘아짐, 하늘까지 닿는 회오리
------------------------------------------------------------------------
local WIND = Color3.fromRGB(120, 245, 200)
local blades: { [Model]: { BasePart } } = {}
local function galeBlades(data: any)
	local m: Model? = data.m
	local r = rootOf(m)
	if not m or not r then
		return
	end
	local root = r :: BasePart
	local n = data.n or 12
	local R = data.radius or 9
	local spin = data.spin or 1.2
	local list: { BasePart } = {}
	for i = 1, n do
		local b = part(Vector3.new(0.2, 1.6, 5), i % 2 == 0 and WHITE or WIND, Enum.Material.Neon, 0.1)
		table.insert(list, b)
	end
	local mm = m :: Model
	blades[mm] = list
	local t0 = os.clock()
	local conn: RBXScriptConnection
	conn = RunService.RenderStepped:Connect(function()
		local t = os.clock() - t0
		if t > spin + 0.6 or blades[mm] ~= list or not root.Parent then
			conn:Disconnect()
			return
		end
		for i, b in ipairs(list) do
			local a = i / n * math.pi * 2 + t * 7
			local p = root.Position + Vector3.new(math.cos(a) * R, 0.5 + math.sin(t * 6 + i) * 1.2, math.sin(a) * R)
			b.CFrame = CFrame.lookAt(p, p + Vector3.new(-math.sin(a), 0, math.cos(a)))
		end
	end)
	Fx.sound("swing", 1, 0.8, root.Position)
end
local function galeShoot(data: any)
	local at: Vector3 = data.at
	local range = data.range or 24
	for m, list in pairs(blades) do
		local r = rootOf(m)
		if r and (r.Position - at).Magnitude < 6 then
			blades[m] = nil
			for i, b in ipairs(list) do
				local a = i / #list * math.pi * 2
				local dir = Vector3.new(math.cos(a), 0, math.sin(a))
				tween(b, 0.25, { CFrame = CFrame.lookAt(at + dir * range, at + dir * (range + 2)) })
				task.delay(0.25, function()
					fadeOut(b, 0.2)
				end)
			end
		end
	end
	Fx.ring(ground(at) + Vector3.new(0, 0.5, 0), WIND, 4, range * 2, 0.4)
	Fx.sound("swing", 1, 1.2, at)
end
local function galeTwister(data: any)
	local at: Vector3 = data.at
	local R = data.radius or 16
	local g = ground(at)
	local rings: { BasePart } = {}
	for k = 1, 12 do
		local d = R * (0.4 + k * 0.1)
		table.insert(rings, part(Vector3.new(0.5, d, d), k % 2 == 0 and WHITE or WIND, Enum.Material.Neon, 0.5, "cyl"))
	end
	local t0 = os.clock()
	local conn: RBXScriptConnection
	conn = RunService.RenderStepped:Connect(function()
		local t = os.clock() - t0
		if t > 1.2 then
			conn:Disconnect()
			for _, rg in ipairs(rings) do
				fadeOut(rg, 0.3)
			end
			return
		end
		for k, rg in ipairs(rings) do
			local wob = Vector3.new(math.cos(t * 9 + k), 0, math.sin(t * 9 + k)) * (k * 0.25)
			rg.CFrame = CFrame.new(g + wob + Vector3.new(0, k * 4 * math.min(1, t * 4), 0)) * CFrame.Angles(0, t * 12 + k, math.rad(90))
		end
	end)
	Fx.burst("dust", g + Vector3.new(0, 1, 0), Color3.fromRGB(200, 220, 210), 30, 2.4)
	task.delay(1.1, function()
		blast(at, R, WIND, WHITE, 1.3)
	end)
	Fx.sound("swing", 1, 0.5, at)
end

------------------------------------------------------------------------
-- 초·벽력신권 구천뇌정 (초 오의): 천둥의 눈, 쏟아지는 벼락, 마지막 벼락 기둥
------------------------------------------------------------------------
local function thunderEye(data: any)
	local r = rootOf(data.m)
	if not r or not near(r.Position, 220) then
		return
	end
	local dur = data.dur or 3
	local e = Instance.new("ColorCorrectionEffect")
	e.Name = "KwonThunderEye"
	e.Parent = Lighting
	tween(e, 0.4, { Brightness = -0.2, Contrast = 0.35, Saturation = -0.3, TintColor = Color3.fromRGB(210, 200, 255) })
	task.delay(dur, function()
		tween(e, 0.5, { Brightness = 0, Contrast = 0, Saturation = 0, TintColor = WHITE })
		task.delay(0.55, function()
			e:Destroy()
		end)
	end)
	-- 하늘의 천둥 눈: 먹구름 소용돌이 고리들 + 가운데 빛나는 눈
	local sky = r.Position + Vector3.new(0, 70, 0)
	local rings: { BasePart } = {}
	for k = 1, 6 do
		local d = 20 + k * 14
		table.insert(rings, part(Vector3.new(1.5, d, d), k % 2 == 0 and Color3.fromRGB(40, 35, 60) or Color3.fromRGB(70, 60, 100), Enum.Material.SmoothPlastic, 0.25, "cyl"))
	end
	local eye = part(Vector3.new(1, 18, 18), Color3.fromRGB(230, 220, 255), Enum.Material.Neon, 0.05, "cyl")
	local pupil = part(Vector3.new(1.2, 6, 14), VIOLET, Enum.Material.Neon, 0)
	local t0 = os.clock()
	local conn: RBXScriptConnection
	conn = RunService.RenderStepped:Connect(function()
		local t = os.clock() - t0
		if t > dur then
			conn:Disconnect()
			for _, rg in ipairs(rings) do
				fadeOut(rg, 0.5)
			end
			fadeOut(eye, 0.4)
			fadeOut(pupil, 0.4)
			return
		end
		local open = math.clamp(t / 0.8, 0, 1)
		for k, rg in ipairs(rings) do
			rg.CFrame = CFrame.new(sky + Vector3.new(0, k * 1.5, 0)) * CFrame.Angles(0, t * (0.6 + k * 0.15) * (k % 2 == 0 and 1 or -1), math.rad(90))
		end
		eye.CFrame = CFrame.new(sky - Vector3.new(0, 1, 0)) * CFrame.Angles(0, 0, math.rad(90))
		eye.Size = Vector3.new(1, 18 * open, 18 * open)
		pupil.CFrame = CFrame.new(sky - Vector3.new(0, 1.5, 0))
		pupil.Size = Vector3.new(1.2, 0.2 + 1 * open, 14 * open)
		if math.random() < 0.15 then
			local a = math.random() * math.pi * 2
			Fx.lightning(sky + Vector3.new(math.cos(a) * 30, 0, math.sin(a) * 30), sky + Vector3.new(math.cos(a + 1) * 50, -10, math.sin(a + 1) * 50), Color3.fromRGB(220, 210, 255), 0.4)
		end
	end)
	Fx.sound("deflect", 1, 0.3, r.Position)
end
local function thunderRain(data: any)
	for _, at in ipairs(data.spots or {}) do
		if near(at, 200) then
			Fx.lightning(at + Vector3.new(math.random(-8, 8), 70, math.random(-8, 8)), at, math.random() < 0.4 and Color3.fromRGB(255, 245, 170) or VIOLET, 0.5)
			Fx.ring(ground(at) + Vector3.new(0, 0.3, 0), VIOLET, 1, (data.radius or 6) * 2, 0.3)
		end
	end
	local first = (data.spots or {})[1]
	if first and math.random() < 0.5 then
		Fx.sound("deflect", 0.4, 1.6 + math.random() * 0.4, first)
	end
end
local function thunderPillar(data: any)
	local at: Vector3 = data.at
	local R = data.radius or 24
	local g = ground(at)
	local col = column(g, 200, R * 0.7, Color3.fromRGB(230, 220, 255), 0)
	fadeOut(col, 0.6, { Size = Vector3.new(220, R * 1.6, R * 1.6) })
	local outer = column(g, 200, R * 1.2, VIOLET, 0.5)
	fadeOut(outer, 0.7)
	for _ = 1, 8 do
		local a = math.random() * math.pi * 2
		local p = at + Vector3.new(math.cos(a), 0, math.sin(a)) * math.random(4, math.floor(R))
		Fx.lightning(at + Vector3.new(0, 6, 0), p, Color3.fromRGB(255, 245, 170), 0.6)
	end
	blast(at, R, VIOLET, Color3.fromRGB(255, 245, 170), 2)
	if near(at, 120) and opts.flash then
		opts.flash(WHITE, 0.6)
	end
	Fx.sound("shatter", 0.6, 0.5, at)
	Fx.sound("heavy", 1, 0.3, at)
	shakeNear(at, 2.6, 120)
end

------------------------------------------------------------------------
-- 초·벽력신권: 두 팔의 뇌전 토시 (Sakura가 부채와 같은 자리에서 부른다)
------------------------------------------------------------------------
local function attach(p: BasePart, to: BasePart, cf: CFrame, holder: Instance, list: { Instance })
	p.Massless = true
	p.Anchored = false
	p.CFrame = to.CFrame * cf
	local w = Instance.new("WeldConstraint")
	w.Part0 = to
	w.Part1 = p
	w.Parent = p
	p.Parent = holder
	table.insert(list, p)
end
-- 2.2판: 토시를 새로. 팔꿈치에서 손목으로 좁아지는 쇠 토시 두 겹, 보랏빛 테두리, 바깥쪽의 번개 무늬와 번개 날개 둘,
-- 팔꿈치 보호구, 손목의 노란 고리, 주먹 끝의 빛나는 마디 셋 (주먹을 뻗으면 앞으로 빛난다)
function Ult2.buildGauntlets(model: Model): { Instance }
	local out: { Instance } = {}
	local holder = Instance.new("Folder")
	holder.Name = "Thunder_" .. model.Name
	holder.Parent = folder
	table.insert(out, holder)
	local iron = Color3.fromRGB(52, 46, 72)
	local gold = Color3.fromRGB(255, 245, 170)
	for _, side in ipairs({ "Right", "Left" }) do
		local arm = model:FindFirstChild(side .. "LowerArm")
		local hand = model:FindFirstChild(side .. "Hand")
		local sx = side == "Right" and 1 or -1 -- 팔의 바깥쪽
		if arm and arm:IsA("BasePart") then
			local sz = arm.Size
			-- 두 겹 쇠 토시 (팔꿈치 쪽이 더 넓다)
			attach(part(Vector3.new(sz.X + 0.36, sz.Y * 0.46, sz.Z + 0.36), iron, Enum.Material.Metal, 0), arm, CFrame.new(0, sz.Y * 0.2, 0), holder, out)
			attach(part(Vector3.new(sz.X + 0.26, sz.Y * 0.44, sz.Z + 0.26), iron, Enum.Material.Metal, 0), arm, CFrame.new(0, -sz.Y * 0.24, 0), holder, out)
			-- 보랏빛 테두리 셋
			for _, y in ipairs({ sz.Y * 0.43, -sz.Y * 0.02, -sz.Y * 0.46 }) do
				attach(part(Vector3.new(sz.X + 0.4, 0.09, sz.Z + 0.4), VIOLET, Enum.Material.Neon, 0), arm, CFrame.new(0, y, 0), holder, out)
			end
			-- 바깥쪽의 번개 무늬 (금빛 갈지자)
			local face = sx * (sz.X / 2 + 0.19)
			local zig = { { 0.18, 20 }, { 0.0, -28 }, { -0.18, 20 } }
			for _, zz in ipairs(zig) do
				attach(part(Vector3.new(0.06, sz.Y * 0.2, 0.12), gold, Enum.Material.Neon, 0), arm, CFrame.new(face, zz[1] * sz.Y, 0) * CFrame.Angles(math.rad(zz[2]), 0, 0), holder, out)
			end
			-- 바깥쪽 번개 날개 둘 (팔꿈치 쪽으로 비스듬히 솟는다)
			for k = 0, 1 do
				local fin = part(Vector3.new(0.12, 0.5 - k * 0.12, 0.9 - k * 0.2), VIOLET, Enum.Material.Neon, 0.05)
				attach(fin, arm, CFrame.new(sx * (sz.X / 2 + 0.28 + k * 0.05), sz.Y * (0.3 - k * 0.25), 0.15) * CFrame.Angles(math.rad(-35), 0, sx * math.rad(-20)), holder, out)
			end
			-- 팔꿈치 보호구 (둥근 쇠 + 빛나는 심)
			attach(part(Vector3.new(0.75, 0.75, 0.75), iron, Enum.Material.Metal, 0, "ball"), arm, CFrame.new(0, sz.Y * 0.5, sz.Z * 0.35), holder, out)
			attach(part(Vector3.new(0.32, 0.32, 0.32), VIOLET, Enum.Material.Neon, 0, "ball"), arm, CFrame.new(0, sz.Y * 0.5, sz.Z * 0.35 + 0.3), holder, out)
			-- 손목의 노란 고리 (여기서 번개가 튄다)
			local cuff = part(Vector3.new(sz.X + 0.44, 0.16, sz.Z + 0.44), gold, Enum.Material.Neon, 0)
			attach(cuff, arm, CFrame.new(0, -sz.Y * 0.5 + 0.05, 0), holder, out)
			local a = Instance.new("Attachment")
			a.Parent = cuff
			local e = Instance.new("ParticleEmitter")
			e.Texture = "rbxasset://textures/particles/sparkles_main.dds"
			e.Color = ColorSequence.new(gold, VIOLET)
			e.LightEmission = 1
			e.Rate = 12
			e.Lifetime = NumberRange.new(0.15, 0.35)
			e.Speed = NumberRange.new(3, 7)
			e.SpreadAngle = Vector2.new(180, 180)
			e.Size = NumberSequence.new(0.3, 0)
			e.Parent = a
			local l = Instance.new("PointLight")
			l.Color = VIOLET
			l.Range = 8
			l.Brightness = 1
			l.Parent = cuff
		end
		if hand and hand:IsA("BasePart") then
			local hs = hand.Size
			-- 손등을 덮는 쇠판과 주먹 끝의 빛나는 마디 셋
			attach(part(Vector3.new(hs.X + 0.16, hs.Y * 0.5, hs.Z + 0.16), iron, Enum.Material.Metal, 0), hand, CFrame.new(0, hs.Y * 0.1, 0), holder, out)
			for k = -1, 1 do
				attach(part(Vector3.new(0.2, 0.14, 0.24), gold, Enum.Material.Neon, 0), hand, CFrame.new(k * hs.X * 0.3, -hs.Y / 2 - 0.02, 0), holder, out)
			end
		end
	end
	return out
end
-- 토시를 두른 사람은 가끔 팔에서 손으로 작은 번개가 튄다
local sparkAcc = 0
RunService.Heartbeat:Connect(function(dt)
	sparkAcc += dt
	if sparkAcc < 0.35 then
		return
	end
	sparkAcc = 0
	for _, h in ipairs(folder:GetChildren()) do
		if h:IsA("Folder") and string.sub(h.Name, 1, 8) == "Thunder_" and math.random() < 0.5 then
			local cuffs = {}
			for _, p in ipairs(h:GetChildren()) do
				if p:IsA("BasePart") and p.Material == Enum.Material.Neon and p.Color.G > 0.9 then
					table.insert(cuffs, p)
				end
			end
			local c = cuffs[math.random(1, math.max(1, #cuffs))]
			if c and near(c.Position, 80) then
				Fx.lightning(c.Position, c.Position + Vector3.new(math.random() - 0.5, math.random() - 0.5, math.random() - 0.5) * 4, VIOLET, 0.12)
			end
		end
	end
end)

-- 초 오의 구천뇌정의 컷씬 (쓴 사람 화면에서만, 대사 없이): 몸을 낮게 올려다보다가 하늘의 눈으로 고개를 든다
local cutActive = false
function Ult2.superCut(model: Model, dur: number, name: string, shake: ((number) -> ())?)
	local cam = workspace.CurrentCamera
	local r = rootOf(model)
	if not cam or not r or cutActive then
		return
	end
	cutActive = true
	local pg = player:WaitForChild("PlayerGui")
	local g = Instance.new("ScreenGui")
	g.Name = "KwonThunderCut"
	g.IgnoreGuiInset = true
	g.ResetOnSpawn = false
	g.DisplayOrder = 85
	g.Parent = pg
	local tintF = Instance.new("Frame")
	tintF.Size = UDim2.fromScale(1, 1)
	tintF.BackgroundColor3 = Color3.fromRGB(30, 20, 70)
	tintF.BackgroundTransparency = 1
	tintF.BorderSizePixel = 0
	tintF.Parent = g
	local grad = Instance.new("UIGradient")
	grad.Rotation = 90
	grad.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.1), NumberSequenceKeypoint.new(0.35, 1), NumberSequenceKeypoint.new(0.65, 1), NumberSequenceKeypoint.new(1, 0.1) })
	grad.Parent = tintF
	tween(tintF, 0.3, { BackgroundTransparency = 0.35 })
	local bars: { Frame } = {}
	for i, y in ipairs({ 0, 1 }) do
		local b = Instance.new("Frame")
		b.AnchorPoint = Vector2.new(0, y)
		b.Position = UDim2.fromScale(0, y)
		b.Size = UDim2.new(1, 0, 0, 0)
		b.BackgroundColor3 = Color3.new(0, 0, 0)
		b.BorderSizePixel = 0
		b.ZIndex = 5
		b.Parent = g
		tween(b, 0.15, { Size = UDim2.new(1, 0, 0.14, 0) })
		bars[i] = b
	end
	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.AnchorPoint = Vector2.new(1, 0.5)
	label.Position = UDim2.new(1, -30, 0.5, 0)
	label.Size = UDim2.new(0.5, 0, 0.45, 0)
	label.Font = Enum.Font.GothamBlack
	label.TextScaled = true
	label.TextXAlignment = Enum.TextXAlignment.Right
	label.Text = "초 오의 · " .. name
	label.TextColor3 = Color3.fromRGB(255, 245, 170)
	label.TextStrokeColor3 = VIOLET
	label.TextStrokeTransparency = 0.2
	label.TextTransparency = 1
	label.ZIndex = 6
	label.Parent = bars[2]
	tween(label, 0.25, { TextTransparency = 0 })
	local oldType = cam.CameraType
	local oldFov = cam.FieldOfView
	local look = flat(r.CFrame.LookVector)
	local side = Vector3.new(-look.Z, 0, look.X)
	cam.CameraType = Enum.CameraType.Scriptable
	local t0 = os.clock()
	local focus = r.Position
	local finished = false
	local function restore()
		if finished then
			return
		end
		finished = true
		RunService:UnbindFromRenderStep("KwonThunderCut")
		cam.CameraType = oldType == Enum.CameraType.Scriptable and Enum.CameraType.Custom or oldType
		cam.FieldOfView = oldFov
		cutActive = false
		-- 컷씬이 끝나면 카메라를 내 등 뒤 조금 높은 곳으로 (앞에서 터지는 기술이 잘 보이게)
		local function behind()
			if r.Parent then
				local lk = flat(r.CFrame.LookVector)
				cam.CFrame = CFrame.lookAt(r.Position - lk * 15 + Vector3.new(0, 6, 0), r.Position + lk * 6 + Vector3.new(0, 1, 0))
			end
		end
		behind()
		task.defer(behind)
	end
	RunService:BindToRenderStep("KwonThunderCut", Enum.RenderPriority.Camera.Value, function(dt: number)
		if finished then
			return
		end
		local t = os.clock() - t0
		local u = math.clamp(t / dur, 0, 1)
		if not r.Parent then
			restore()
			return
		end
		focus = focus:Lerp(r.Position, math.min(1, dt * 10))
		local e = u * u * (3 - 2 * u)
		-- 앞쪽 낮은 곳에서 올려다보다가, 끝으로 갈수록 뒤로 빠지며 등 뒤 하늘에 뜬 뇌고 여덟을 함께 잡는다 (2.3판)
		local pos = focus + look * (6 + 8 * e) + side * (3 + 3 * e) + Vector3.new(0, -1.5 + 3 * e, 0)
		local target = focus + Vector3.new(0, 2 + 12 * e, 0) - look * (6 * e)
		cam.CFrame = CFrame.lookAt(pos, target)
		cam.FieldOfView = oldFov - 18 + 30 * e
		if shake and u > 0.5 then
			shake(0.1 + (u - 0.5) * 0.8)
		end
		if math.random() < 0.08 then
			Fx.lightning(focus + Vector3.new(math.random(-20, 20), 60, math.random(-20, 20)), focus + Vector3.new(math.random(-12, 12), 0, math.random(-12, 12)), VIOLET, 0.4)
		end
	end)
	task.delay(dur, function()
		restore()
		for _, b in ipairs(bars) do
			tween(b, 0.18, { Size = UDim2.new(1, 0, 0, 0) })
		end
		tween(label, 0.15, { TextTransparency = 1, TextStrokeTransparency = 1 })
		grad:Destroy()
		tintF.BackgroundColor3 = Color3.fromRGB(240, 235, 255)
		tintF.BackgroundTransparency = 0.15
		tween(tintF, 0.35, { BackgroundTransparency = 1 })
		if shake then
			shake(1.4)
		end
		task.delay(0.5, function()
			g:Destroy()
		end)
	end)
end

local HANDLERS: { [string]: (any) -> () } = {
	dragonsRise = dragonsRise,
	dragonDive = dragonDive,
	dragonsEnd = dragonsEnd,
	lavaBurst = lavaBurst,
	bloodSea = bloodSea,
	bloodClaw = bloodClaw,
	bloodVortex = bloodVortex,
	netStart = netStart,
	netPulse = netPulse,
	netEnd = netEnd,
	armsStart = armsStart,
	armStrike = armStrike,
	darkStart = darkStart,
	killMark = killMark,
	killBurst = killBurst,
	shadowStomp = shadowStomp,
	maelstrom = maelstrom,
	maelstromEnd = maelstromEnd,
	abyss = abyss,
	abyssEnd = abyssEnd,
	galeBlades = galeBlades,
	galeShoot = galeShoot,
	galeTwister = galeTwister,
	thunderEye = thunderEye,
	thunderRain = thunderRain,
	thunderPillar = thunderPillar,
}
function Ult2.handles(data: any): boolean
	return HANDLERS[data.kind] ~= nil
end
function Ult2.run(data: any)
	local fn = HANDLERS[data.kind]
	if fn then
		fn(data)
	end
end

local _ = player
return Ult2
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="30">
          <Properties>
            <string name="Name">Ults</string>
            <string name="Source"><![CDATA[-- 권왕: 오의 연출 (권법마다 전혀 다른 종류)
--   혈마: 등 뒤로 솟는 거대한 악마의 허상     무영: 적마다 나타나는 그림자 분신
--   천룡: 땅을 뚫고 나와 날아다니는 진짜 용     금강: 내 몸이 금빛 거인이 된다
--   태허: 발밑이 호수가 되는 소용돌이와 물기둥   매화: 세상이 멈춘 듯한 일순의 베기
--   벽력: 몸이 번개가 되어 튀어 다닌다          취권: 불덩이가 되어 튕겨 다닌다
--   무극: 빛깔이 뒤집히고 하늘에 눈이 열린다     삼재: 모았다가 단 한 번의 주먹
--   천제: 하늘의 문과 빛의 검 비                파천: 하늘에 뜬 검은 해가 모두를 빨아올린다
--   풍신: 앞으로 나아가는 거대한 회오리          태초: 세상이 멈춰 별바다가 되고, 유리처럼 깨진다
--   일월: 하늘이 밤이 되고 해와 달이 떠서 겹친다 (일식), 검은 해의 빛살이 꿰뚫고 새벽처럼 터진다
local Debris = game:GetService("Debris")
local Lighting = game:GetService("Lighting")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local Config = require(ReplicatedStorage:WaitForChild("Config"))
local Fx = require(script.Parent:WaitForChild("Fx"))
local Anim = require(script.Parent:WaitForChild("Anim"))

local Ults = {}
local hooks: any = {}

function Ults.init(h: any)
	hooks = h
end

local folder = Instance.new("Folder")
folder.Name = "KwonUlts"
folder.Parent = workspace

local function piece(size: Vector3, color: Color3, material: Enum.Material?, shape: Enum.PartType?, transparency: number?): Part
	local p = Instance.new("Part")
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	p.Size = size
	p.Color = color
	p.Material = material or Enum.Material.Neon
	if shape then
		p.Shape = shape
	end
	p.Transparency = transparency or 0
	p.Parent = folder
	return p
end
local function tween(inst: Instance, time: number, goal: { [string]: any }, style: Enum.EasingStyle?, dir: Enum.EasingDirection?)
	local tw = TweenService:Create(inst, TweenInfo.new(time, style or Enum.EasingStyle.Quad, dir or Enum.EasingDirection.Out), goal)
	tw:Play()
	return tw
end
local function fade(p: Instance, after: number, life: number)
	task.delay(after, function()
		if p.Parent then
			tween(p, life, { Transparency = 1 })
		end
	end)
	Debris:AddItem(p, after + life + 0.05)
end
local function rootOf(m: Model?): BasePart?
	local r = m and m:FindFirstChild("HumanoidRootPart")
	return (r and r:IsA("BasePart")) and r or nil
end
local function flat(v: Vector3): Vector3
	local f = Vector3.new(v.X, 0, v.Z)
	return f.Magnitude > 1e-3 and f.Unit or Vector3.new(0, 0, -1)
end
local function styleColors(id: any): (Color3, Color3)
	local s = type(id) == "string" and Config.STYLE_BY_ID[id]
	return s and s.color or Color3.new(1, 1, 1), s and s.color2 or Color3.new(1, 1, 1)
end
local function near(at: Vector3, r: number): boolean
	local me = Players.LocalPlayer.Character
	local root = rootOf(me)
	return root ~= nil and (root.Position - at).Magnitude < r
end
-- 크게 흔들리는 순간: 불티·빛·흙먼지·돌 조각을 흔들림 세기만큼 (모든 오의가 함께 쓴다)
local function boom(at: Vector3, power: number)
	if power >= 1.1 then
		Fx.impact(at, Color3.fromRGB(255, 236, 205), math.clamp(power - 0.3, 0.8, 2.6))
	else
		Fx.burst("spark", at, Color3.fromRGB(255, 236, 205), 8, 1)
	end
end
-- 화면 빛깔을 잠깐 바꾼다 (흑백, 뒤집힘, 어둠)
local grade = Instance.new("ColorCorrectionEffect")
grade.Name = "KwonUltGrade"
grade.Parent = Lighting
local function colorGrade(sat: number, contrast: number, bright: number, tintColor: Color3, hold: number)
	grade.Saturation = sat
	grade.Contrast = contrast
	grade.Brightness = bright
	grade.TintColor = tintColor
	task.delay(hold, function()
		tween(grade, 0.4, { Saturation = 0, Contrast = 0, Brightness = 0, TintColor = Color3.new(1, 1, 1) })
	end)
end

------------------------------------------------------------------------
-- 허상 몸 (관절이 있어 몸동작을 그대로 쓴다)
------------------------------------------------------------------------
local RIG = {
	{ "LowerTorso", Vector3.new(2, 0.4, 1), Vector3.new(0, -0.8, 0), "HumanoidRootPart", "Root", Vector3.new(0, -0.8, 0) },
	{ "UpperTorso", Vector3.new(2, 1.6, 1), Vector3.new(0, 0.2, 0), "LowerTorso", "Waist", Vector3.new(0, -0.6, 0) },
	{ "Head", Vector3.new(1.2, 1.2, 1.2), Vector3.new(0, 1.6, 0), "UpperTorso", "Neck", Vector3.new(0, 1.0, 0) },
	{ "RightUpperArm", Vector3.new(1, 1.2, 1), Vector3.new(1.5, 0.4, 0), "UpperTorso", "RightShoulder", Vector3.new(1.5, 0.8, 0) },
	{ "RightLowerArm", Vector3.new(1, 0.95, 1), Vector3.new(1.5, -0.675, 0), "RightUpperArm", "RightElbow", Vector3.new(1.5, -0.2, 0) },
	{ "RightHand", Vector3.new(1, 0.3, 1), Vector3.new(1.5, -1.3, 0), "RightLowerArm", "RightWrist", Vector3.new(1.5, -1.15, 0) },
	{ "LeftUpperArm", Vector3.new(1, 1.2, 1), Vector3.new(-1.5, 0.4, 0), "UpperTorso", "LeftShoulder", Vector3.new(-1.5, 0.8, 0) },
	{ "LeftLowerArm", Vector3.new(1, 0.95, 1), Vector3.new(-1.5, -0.675, 0), "LeftUpperArm", "LeftElbow", Vector3.new(-1.5, -0.2, 0) },
	{ "LeftHand", Vector3.new(1, 0.3, 1), Vector3.new(-1.5, -1.3, 0), "LeftLowerArm", "LeftWrist", Vector3.new(-1.5, -1.15, 0) },
	{ "RightUpperLeg", Vector3.new(1, 1.1, 1), Vector3.new(0.5, -1.55, 0), "LowerTorso", "RightHip", Vector3.new(0.5, -1.0, 0) },
	{ "RightLowerLeg", Vector3.new(1, 0.7, 1), Vector3.new(0.5, -2.45, 0), "RightUpperLeg", "RightKnee", Vector3.new(0.5, -2.1, 0) },
	{ "RightFoot", Vector3.new(1, 0.2, 1.1), Vector3.new(0.5, -2.9, -0.05), "RightLowerLeg", "RightAnkle", Vector3.new(0.5, -2.8, 0) },
	{ "LeftUpperLeg", Vector3.new(1, 1.1, 1), Vector3.new(-0.5, -1.55, 0), "LowerTorso", "LeftHip", Vector3.new(-0.5, -1.0, 0) },
	{ "LeftLowerLeg", Vector3.new(1, 0.7, 1), Vector3.new(-0.5, -2.45, 0), "LeftUpperLeg", "LeftKnee", Vector3.new(-0.5, -2.1, 0) },
	{ "LeftFoot", Vector3.new(1, 0.2, 1.1), Vector3.new(-0.5, -2.9, -0.05), "LeftLowerLeg", "LeftAnkle", Vector3.new(-0.5, -2.8, 0) },
}

-- 허상 하나: s배 크기, 빛깔과 재질, 붙은 장식(뿔·날개·눈 ...)은 add로
local function spirit(s: number, color: Color3, material: Enum.Material, trans: number, styleId: string, cf: CFrame): Model
	local model = Instance.new("Model")
	model.Name = "KwonSpirit"
	local root = Instance.new("Part")
	root.Name = "HumanoidRootPart"
	root.Size = Vector3.new(2, 2, 1) * s
	root.Transparency = 1
	root.Anchored = true
	root.CanCollide = false
	root.CanQuery = false
	root.Parent = model
	model.PrimaryPart = root
	local parts: { [string]: BasePart } = { HumanoidRootPart = root }
	for _, r in ipairs(RIG) do
		local name, size, center, parentName, jointName, joint = r[1], r[2], r[3], r[4], r[5], r[6]
		local p = Instance.new("Part")
		p.Name = name
		p.Size = size * s
		p.CFrame = CFrame.new(center * s)
		p.Color = color
		p.Material = material
		p.Transparency = trans
		p.CanCollide = false
		p.CanQuery = false
		p.CanTouch = false
		p.CastShadow = false
		p.Massless = true
		if name == "Head" then
			p.Shape = Enum.PartType.Ball
		end
		p.Parent = model
		parts[name] = p
		local parent = parts[parentName]
		local m = Instance.new("Motor6D")
		m.Name = jointName
		m.Part0 = parent
		m.Part1 = p
		local j = joint * s
		m.C0 = CFrame.new(j - parent.Position)
		m.C1 = CFrame.new(j - center * s)
		m.Parent = p
	end
	model:SetAttribute("Style", styleId)
	model:SetAttribute("Master", true) -- 가만히 있어도 딴짓하지 않게
	model:PivotTo(cf)
	model.Parent = folder
	return model
end
-- 허상에 장식 붙이기 (몸 부위에 용접)
local function attach(model: Model, partName: string, size: Vector3, offset: CFrame, color: Color3, material: Enum.Material?, shape: Enum.PartType?, trans: number?): Part?
	local base = model:FindFirstChild(partName)
	if not base or not base:IsA("BasePart") then
		return nil
	end
	local p = Instance.new("Part")
	p.Size = size
	p.Color = color
	p.Material = material or Enum.Material.Neon
	if shape then
		p.Shape = shape
	end
	p.Transparency = trans or 0
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	p.Massless = true
	p.CFrame = base.CFrame * offset
	local w = Instance.new("WeldConstraint")
	w.Part0 = base
	w.Part1 = p
	w.Parent = p
	p.Parent = model
	return p
end
local function vanish(model: Model, after: number, life: number)
	task.delay(after, function()
		for _, d in ipairs(model:GetDescendants()) do
			if d:IsA("BasePart") and d.Name ~= "HumanoidRootPart" then
				tween(d, life, { Transparency = 1 })
			end
		end
	end)
	Debris:AddItem(model, after + life + 0.1)
end
local function rise(model: Model, from: CFrame, to: CFrame, time: number)
	local root = model.PrimaryPart
	if not root then
		return
	end
	local start = os.clock()
	local conn: RBXScriptConnection
	conn = RunService.RenderStepped:Connect(function()
		local k = math.clamp((os.clock() - start) / time, 0, 1)
		k = 1 - (1 - k) ^ 3
		if model.Parent then
			model:PivotTo(from:Lerp(to, k))
		end
		if k >= 1 or not model.Parent then
			conn:Disconnect()
		end
	end)
end

------------------------------------------------------------------------
-- 혈마의 허상: 뿔, 날개, 빛나는 눈, 손톱. 등 뒤에서 솟아 적을 찢는다
------------------------------------------------------------------------
local demons: { [Model]: Model } = {}
local function demonSummon(caster: Model, dur: number, styleId: string, scale: number?)
	local r = rootOf(caster)
	if not r then
		return
	end
	local look = flat(r.CFrame.LookVector)
	local s = 4.4 * (scale or 1)
	local base = r.Position - look * 8
	local to = CFrame.lookAt(base + Vector3.new(0, 2.6 * s - 2.5, 0), base + Vector3.new(0, 2.6 * s - 2.5, 0) + look)
	local from = to - Vector3.new(0, 3 * s, 0)
	local d = spirit(s, (styleColors(styleId)):Lerp(Color3.new(0, 0, 0), 0.5), Enum.Material.Neon, 0.35, styleId, from)
	local red, gold = Color3.fromRGB(255, 40, 40), Color3.fromRGB(255, 220, 90)
	for _, x in ipairs({ -1, 1 }) do
		-- 휘어진 뿔 두 마디
		attach(d, "Head", Vector3.new(0.5, 1.6, 0.5) * s * 0.5, CFrame.new(x * 0.35 * s, 0.55 * s, 0) * CFrame.Angles(0, 0, x * math.rad(-35)), Color3.fromRGB(30, 0, 0), Enum.Material.SmoothPlastic)
		attach(d, "Head", Vector3.new(0.35, 1.2, 0.35) * s * 0.5, CFrame.new(x * 0.62 * s, 1.0 * s, 0.1 * s) * CFrame.Angles(math.rad(20), 0, x * math.rad(-5)), Color3.fromRGB(30, 0, 0), Enum.Material.SmoothPlastic)
		-- 빛나는 눈
		attach(d, "Head", Vector3.new(0.22, 0.1, 0.05) * s, CFrame.new(x * 0.2 * s, 0.08 * s, -0.55 * s), gold, Enum.Material.Neon)
		-- 박쥐 날개 (세 겹)
		for k = 0, 2 do
			attach(d, "UpperTorso", Vector3.new(0.1, 1.6 - k * 0.3, 3.2 - k * 0.6) * s, CFrame.new(x * (1.3 + k * 0.9) * s, (0.6 - k * 0.35) * s, 0.7 * s) * CFrame.Angles(math.rad(10), x * math.rad(70 - k * 8), x * math.rad(-20 - k * 10)), Color3.fromRGB(60, 0, 5), Enum.Material.Neon, nil, 0.3)
		end
	end
	for _, side in ipairs({ "RightHand", "LeftHand" }) do
		for k = -1, 1 do
			attach(d, side, Vector3.new(0.15, 1.1, 0.15) * s, CFrame.new(k * 0.3 * s, -0.55 * s, -0.2 * s) * CFrame.Angles(math.rad(-20), 0, 0), red, Enum.Material.Neon)
		end
	end
	local core = attach(d, "UpperTorso", Vector3.new(0.6, 0.6, 0.6) * s, CFrame.new(0, 0.2 * s, -0.45 * s), red, Enum.Material.Neon, Enum.PartType.Ball)
	if core then
		local l = Instance.new("PointLight")
		l.Color = red
		l.Range = 40
		l.Brightness = 4
		l.Parent = core
	end
	rise(d, from, to, 0.6)
	Fx.ring(base - Vector3.new(0, 2.4, 0), red, 4, 46, 0.7)
	Fx.text(base + Vector3.new(0, 3 * s, 0), "혈마 강림", red, 44, 1.2)
	task.delay(0.65, function()
		Anim.play(d, "blood_spread", 0.8)
	end)
	demons[caster] = d
	-- 솟은 뒤에는 주인의 등 뒤를 따라다닌다
	local following = false
	task.delay(0.65, function()
		following = true
	end)
	local followConn: RBXScriptConnection
	followConn = RunService.RenderStepped:Connect(function(dt)
		local rr = rootOf(caster)
		if not d.Parent or not rr or demons[caster] ~= d then
			followConn:Disconnect()
			return
		end
		if not following then
			return
		end
		local cur = d:GetPivot()
		local want = rr.Position - flat(rr.CFrame.LookVector) * 8 + Vector3.new(0, 2.6 * s - 2.5, 0)
		d:PivotTo(cur.Rotation + cur.Position:Lerp(want, math.clamp(dt * 5, 0, 1)))
	end)
	task.delay(dur, function()
		if demons[caster] == d then
			demons[caster] = nil
		end
		Anim.play(d, "ult_blood", 0.8)
		local now = d:GetPivot()
		rise(d, now, now - Vector3.new(0, 3 * s, 0), 0.8)
	end)
	vanish(d, dur + 0.3, 0.5)
	if hooks.shake and near(base, 80) then
		hooks.shake(1.4)
		boom(base, 1.4)
	end
end
local function demonStrike(caster: Model, data: any)
	local d = demons[caster]
	local spots = data.at or {}
	local red = Color3.fromRGB(255, 40, 40)
	if d and d.PrimaryPart and spots[1] then
		local p = d.PrimaryPart.Position
		d:PivotTo(CFrame.lookAt(p, Vector3.new(spots[1].X, p.Y, spots[1].Z)))
		Anim.play(d, data.last and "blood_spread" or (data.idx % 2 == 1 and "blood_claw_r" or "blood_claw_l"), 0.55)
	end
	for _, at in ipairs(spots) do
		local g = at - Vector3.new(0, 2.4, 0)
		if data.last then
			-- 포효: 핏빛 충격파가 둘레를 쓸어 낸다
			for k = 0, 3 do
				task.delay(k * 0.07, function()
					Fx.ring(g + Vector3.new(0, 0.5 + k, 0), k % 2 == 0 and red or Color3.fromRGB(80, 0, 0), 4, (data.radius or 20) * 2.4, 0.6)
				end)
			end
			if hooks.flash and near(at, 70) then
				hooks.flash(Color3.fromRGB(255, 30, 30), 0.35)
			end
		else
			-- 거대한 손톱 세 줄이 하늘에서 비스듬히 그어진다
			for i = -1, 1 do
				local bar = piece(Vector3.new(0.9, 0.9, 30), i == 0 and Color3.fromRGB(255, 160, 160) or red, Enum.Material.Neon, nil, 0)
				local top = at + Vector3.new(i * 2, 18, -6)
				bar.CFrame = CFrame.lookAt(top, at + Vector3.new(i * 2, -3, 6))
				tween(bar, 0.35, { Size = Vector3.new(0.1, 0.1, 34), Transparency = 1 })
				Debris:AddItem(bar, 0.4)
			end
			Fx.ring(g + Vector3.new(0, 0.3, 0), red, 2, (data.radius or 8) * 2.2, 0.4)
			Fx.spark(at, red, 2.4, 12)
		end
	end
	if hooks.shake and spots[1] and near(spots[1], 70) then
		hooks.shake(data.last and 1.6 or 0.9)
		boom(spots[1], data.last and 1.6 or 0.9)
	end
end

------------------------------------------------------------------------
-- 진룡: 마디마디 이어진 용이 땅에서 솟아 날아다닌다
------------------------------------------------------------------------
local dragons: { [Model]: any } = {}
local function dragonSummon(caster: Model, dur: number, styleId: string, scale: number?)
	local r = rootOf(caster)
	if not r then
		return
	end
	local c, c2 = styleColors(styleId)
	local look = flat(r.CFrame.LookVector)
	local right = Vector3.new(-look.Z, 0, look.X)
	local base = r.Position - Vector3.new(0, 2.5, 0)
	local segs = {}
	local N = 26
	for i = 1, N do
		local sz = 5.5 * (scale or 1) * (1 - i / N * 0.75)
		local seg = piece(Vector3.new(sz, sz, sz), c:Lerp(c2, (i % 4) / 4), Enum.Material.Neon, Enum.PartType.Ball, 0.1)
		seg.Position = base - Vector3.new(0, 20, 0)
		table.insert(segs, seg)
		-- 등지느러미
		if i % 3 == 0 and i < N - 3 then
			local fin = piece(Vector3.new(0.4, sz * 0.9, sz * 0.6), c2, Enum.Material.Neon, nil, 0.2)
			fin.Position = seg.Position
			table.insert(segs, fin)
			fin:SetAttribute("FinOf", i)
		end
	end
	local head = piece(Vector3.new(6, 5, 9), c, Enum.Material.Neon, nil, 0)
	local jaw = piece(Vector3.new(5, 1.4, 7), c2, Enum.Material.Neon, nil, 0)
	local horns = { piece(Vector3.new(0.8, 0.8, 7), Color3.fromRGB(255, 230, 150), Enum.Material.Neon), piece(Vector3.new(0.8, 0.8, 7), Color3.fromRGB(255, 230, 150), Enum.Material.Neon) }
	local eyes = { piece(Vector3.new(1, 1, 1), Color3.fromRGB(255, 255, 200), Enum.Material.Neon, Enum.PartType.Ball), piece(Vector3.new(1, 1, 1), Color3.fromRGB(255, 255, 200), Enum.Material.Neon, Enum.PartType.Ball) }
	local light = Instance.new("PointLight")
	light.Color = c
	light.Range = 50
	light.Brightness = 3
	light.Parent = head
	local d: any = {
		fast = false,
		open = false,
		target = base + right * 14 + Vector3.new(0, 26, 0),
		pos = base - Vector3.new(0, 10, 0),
		trail = {},
		lookAt = base + look * 20,
	}
	dragons[caster] = d
	-- 땅을 뚫고 솟는 순간
	Fx.ring(base + right * 10, c, 4, 30, 0.6)
	Fx.dust(base + right * 10, 6)
	local start = os.clock()
	local conn: RBXScriptConnection
	conn = RunService.RenderStepped:Connect(function(dt: number)
		local t = os.clock() - start
		-- 머리가 목표를 향해 굽이치며 날아간다
		local wob = Vector3.new(math.sin(t * 3) * 3, math.cos(t * 4) * 2, 0)
		d.pos = d.pos:Lerp(d.target + wob, math.min(1, dt * (d.fast and 14 or 4)))
		table.insert(d.trail, 1, d.pos)
		if #d.trail > N * 4 then
			table.remove(d.trail)
		end
		local face = d.lookAt - d.pos
		local hcf = CFrame.lookAt(d.pos, d.pos + (face.Magnitude > 0.1 and face or Vector3.new(0, 0, -1)))
		head.CFrame = hcf
		jaw.CFrame = hcf * CFrame.new(0, -2.6, -1) * CFrame.Angles(math.rad(d.open and 25 or 8), 0, 0)
		horns[1].CFrame = hcf * CFrame.new(1.8, 2.6, 3) * CFrame.Angles(math.rad(30), math.rad(15), 0)
		horns[2].CFrame = hcf * CFrame.new(-1.8, 2.6, 3) * CFrame.Angles(math.rad(30), math.rad(-15), 0)
		eyes[1].CFrame = hcf * CFrame.new(1.6, 1, -3)
		eyes[2].CFrame = hcf * CFrame.new(-1.6, 1, -3)
		local k = 0
		for _, seg in ipairs(segs) do
			local fin = seg:GetAttribute("FinOf")
			if fin then
				local p = d.trail[math.min(#d.trail, fin * 4)] or d.pos
				seg.CFrame = CFrame.new(p + Vector3.new(0, seg.Size.Y * 0.6, 0))
			else
				k += 1
				seg.Position = d.trail[math.min(#d.trail, k * 4)] or d.pos
			end
		end
		if t > dur + 0.8 then
			conn:Disconnect()
			for _, p in ipairs(segs) do
				tween(p, 0.3, { Transparency = 1 })
				Debris:AddItem(p, 0.35)
			end
			for _, p in ipairs({ head, jaw, horns[1], horns[2], eyes[1], eyes[2] }) do
				tween(p, 0.3, { Transparency = 1 })
				Debris:AddItem(p, 0.35)
			end
		end
	end)
	task.delay(dur, function()
		-- 하늘로 솟아 사라진다
		d.fast = false
		d.target = d.pos + Vector3.new(0, 80, 0)
		d.lookAt = d.target + Vector3.new(0, 10, 0)
	end)
	Fx.text(base + Vector3.new(0, 14, 0), "진룡 강림", c, 44, 1.2)
end
local function dragonStrike(caster: Model, data: any)
	local d = dragons[caster]
	local c, c2 = styleColors(data.style)
	local at = (data.at or {})[1]
	if not d or not at then
		return
	end
	if data.last then
		-- 용의 숨: 앞으로 불기둥을 뿜는다
		local r = rootOf(caster)
		local from = r and r.Position + Vector3.new(0, 18, 0) or at + Vector3.new(0, 18, 0)
		d.target = from
		d.lookAt = at
		d.open = true
		for k = 0, 14 do
			task.delay(k * 0.03, function()
				local ball = piece(Vector3.new(3, 3, 3), k % 2 == 0 and c2 or Color3.fromRGB(255, 240, 200), Enum.Material.Neon, Enum.PartType.Ball, 0.1)
				ball.Position = d.pos
				tween(ball, 0.35, { Position = at + Vector3.new(math.random(-4, 4), math.random(-1, 3), math.random(-4, 4)), Size = Vector3.new(9, 9, 9), Transparency = 1 })
				Debris:AddItem(ball, 0.4)
			end)
		end
		task.delay(0.35, function()
			Fx.ring(at - Vector3.new(0, 2.2, 0), c, 4, (data.radius or 16) * 2.4, 0.6)
			Fx.dust(at - Vector3.new(0, 2.4, 0), 6)
			d.open = false
		end)
	else
		-- 하늘로 솟았다가 적에게 내리꽂힌다
		d.fast = true
		d.target = at
		d.lookAt = at - Vector3.new(0, 10, 0)
		task.delay(0.18, function()
			Fx.ring(at - Vector3.new(0, 2.2, 0), c, 3, (data.radius or 9) * 2.4, 0.45)
			Fx.spark(at, c2, 2.4, 14)
			Fx.dust(at - Vector3.new(0, 2.4, 0), 5)
			Fx.sound("heavy", 0.9, 0.7, at)
			d.fast = false
			d.target = at + Vector3.new(math.random(-14, 14), 24, math.random(-14, 14))
			d.lookAt = d.target + Vector3.new(0, 6, 0)
		end)
	end
	if hooks.shake and near(at, 70) then
		hooks.shake(1.1)
		boom(at, 1.1)
	end
end

------------------------------------------------------------------------
-- 무영 분신: 적마다 등 뒤에 검은 그림자가 나타나 세 번 찬다
------------------------------------------------------------------------
local function clones(data: any)
	local shadow = Color3.fromRGB(25, 15, 40)
	local c = styleColors(data.style)
	local kicks = { "side_kick", "tornado_kick", "shadow_heel" }
	for i, m in ipairs(data.targets or {}) do
		task.delay((data.delay or 0.4) + (i - 1) * (data.every or 0.08), function()
			local tr = rootOf(m)
			if not tr then
				return
			end
			local a = i * 2.3
			local at = tr.Position + Vector3.new(math.cos(a), 0, math.sin(a)) * 4
			local cl = spirit(1, shadow, Enum.Material.Neon, 0.15, "muyeong", CFrame.lookAt(at, Vector3.new(tr.Position.X, at.Y, tr.Position.Z)))
			for _, x in ipairs({ -1, 1 }) do
				attach(cl, "Head", Vector3.new(0.25, 0.1, 0.05), CFrame.new(x * 0.2, 0.1, -0.6), Color3.fromRGB(190, 120, 255), Enum.Material.Neon)
			end
			Fx.ring(at - Vector3.new(0, 2.4, 0), c, 1, 8, 0.3)
			Fx.afterimage(cl, c, 0.3)
			for k = 0, 2 do
				task.delay(k * 0.25, function()
					if cl.Parent then
						Anim.play(cl, kicks[k + 1], 0.3)
						Fx.swing("muyeong", cl, k == 2)
					end
				end)
			end
			task.delay(0.8, function()
				for _ = 1, 5 do
					local smoke = piece(Vector3.new(2, 2, 2), shadow, Enum.Material.SmoothPlastic, Enum.PartType.Ball, 0.3)
					smoke.Position = at + Vector3.new(math.random(-1, 1), math.random(0, 2), math.random(-1, 1))
					tween(smoke, 0.5, { Size = Vector3.new(5, 5, 5), Transparency = 1 })
					Debris:AddItem(smoke, 0.55)
				end
			end)
			vanish(cl, 0.8, 0.25)
		end)
	end
end

------------------------------------------------------------------------
-- 금강 법신: 내 몸에 금빛이 덮이고 커진다 (Giant 속성을 따라)
------------------------------------------------------------------------
local giants: { [Model]: Instance } = {}
function Ults.watchGiant(m: Model)
	local on = m:GetAttribute("Giant") == true
	local hl = giants[m]
	if on and not hl then
		local h = Instance.new("Highlight")
		h.FillColor = Color3.fromRGB(255, 200, 70)
		h.FillTransparency = 0.35
		h.OutlineColor = Color3.fromRGB(255, 250, 200)
		h.OutlineTransparency = 0
		h.Parent = m
		giants[m] = h
		local r = rootOf(m)
		if r then
			local halo = piece(Vector3.new(0.4, 14, 14), Color3.fromRGB(255, 210, 90), Enum.Material.Neon, Enum.PartType.Cylinder, 0.35)
			local start = os.clock()
			local conn: RBXScriptConnection
			conn = RunService.RenderStepped:Connect(function()
				local rr = rootOf(m)
				if not rr or not giants[m] then
					conn:Disconnect()
					halo:Destroy()
					return
				end
				local look = flat(rr.CFrame.LookVector)
				halo.CFrame = CFrame.lookAt(rr.Position + Vector3.new(0, 7, 0) - look * 3, rr.Position + Vector3.new(0, 7, 0) - look * 4) * CFrame.Angles(0, math.rad(90), (os.clock() - start))
			end)
		end
	elseif not on and hl then
		giants[m] = nil
		hl:Destroy()
	end
end
-- 번개·일순 베기 동안 몸이 보이지 않는다
function Ults.watchVanish(m: Model)
	local on = m:GetAttribute("Vanish") == true
	for _, d in ipairs(m:GetDescendants()) do
		if d:IsA("BasePart") and d.Name ~= "HumanoidRootPart" then
			d.LocalTransparencyModifier = on and 1 or 0
		end
	end
end

------------------------------------------------------------------------
-- 종류별 연출
------------------------------------------------------------------------
local H: { [string]: (any) -> () } = {}

function H.avatar(data: any)
	if data.look == "demon" then
		demonSummon(data.m, data.dur, data.style, data.scale)
	elseif data.look == "dragon" then
		dragonSummon(data.m, data.dur, data.style, data.scale)
	end
end
function H.avatarStrike(data: any)
	if data.look == "demon" then
		demonStrike(data.m, data)
	elseif data.look == "dragon" then
		dragonStrike(data.m, data)
	end
end
H.clones = clones

function H.stomp(data: any)
	local g = data.at - Vector3.new(0, 2.4, 0)
	local gold = Color3.fromRGB(255, 205, 80)
	Fx.ring(g + Vector3.new(0, 0.3, 0), gold, 4, (data.radius or 16) * 2.6, 0.6)
	Fx.ring(g + Vector3.new(0, 0.5, 0), Color3.new(1, 1, 1), 3, (data.radius or 16) * 1.6, 0.5)
	Fx.dust(g, 9)
	for k = 0, 9 do
		local a = k / 10 * math.pi * 2
		local rock = piece(Vector3.new(2, 2, 2), Color3.fromRGB(120, 100, 80), Enum.Material.Slate, nil, 0)
		rock.Position = g
		tween(rock, 0.6, { Position = g + Vector3.new(math.cos(a) * 14, 8, math.sin(a) * 14), Transparency = 1 })
		Debris:AddItem(rock, 0.65)
	end
	Fx.text(data.at + Vector3.new(0, 10, 0), "금강 법신", gold, 44, 1.2)
	if hooks.shake and near(data.at, 80) then
		hooks.shake(1.8)
		boom(data.at, 1.8)
	end
end
function H.aftershock(data: any)
	Fx.ring(data.at - Vector3.new(0, 2.2, 0), Color3.fromRGB(255, 205, 80), 2, 18, 0.35)
	Fx.dust(data.at - Vector3.new(0, 2.4, 0), 3)
end

function H.lake(data: any)
	local at, r, dur = data.at, data.radius, data.dur
	local c, c2 = styleColors(data.style)
	local g = Vector3.new(at.X, at.Y - 2.3, at.Z)
	local water = piece(Vector3.new(0.4, 4, 4), Color3.fromRGB(70, 150, 220), Enum.Material.Glass, Enum.PartType.Cylinder, 0.35)
	water.CFrame = CFrame.new(g) * CFrame.Angles(0, 0, math.rad(90))
	tween(water, 0.5, { Size = Vector3.new(0.4, r * 2, r * 2) })
	fade(water, dur + 0.4, 0.5)
	-- 가운데로 빨려드는 물살
	local bits = {}
	for i = 1, 40 do
		local b = piece(Vector3.new(1.4, 0.4, 3), i % 2 == 0 and c2 or Color3.fromRGB(200, 240, 255), Enum.Material.Glass, nil, 0.2)
		table.insert(bits, b)
	end
	local start = os.clock()
	local conn: RBXScriptConnection
	conn = RunService.RenderStepped:Connect(function()
		local t = os.clock() - start
		for i, b in ipairs(bits) do
			local k = (i / #bits + t * 0.4) % 1
			local rr = r * (1 - k)
			local a = i * 1.7 + t * 4 + k * 6
			local p = g + Vector3.new(math.cos(a) * rr, 0.3 - k * 1.5, math.sin(a) * rr)
			b.CFrame = CFrame.lookAt(p, p + Vector3.new(-math.sin(a), 0, math.cos(a)))
		end
		if t > dur then
			conn:Disconnect()
			for _, b in ipairs(bits) do
				tween(b, 0.3, { Transparency = 1 })
				Debris:AddItem(b, 0.35)
			end
		end
	end)
	for k = 0, math.floor(dur / 0.5) do
		task.delay(k * 0.5, function()
			Fx.ring(g + Vector3.new(0, 0.4, 0), c2, r * 2, 2, 0.5)
		end)
	end
	Fx.text(at + Vector3.new(0, 6, 0), "만류귀해", c, 40, 1.2)
end
function H.geyser(data: any)
	local at, r = data.at, data.radius or 12
	local c, c2 = styleColors(data.style)
	local g = at - Vector3.new(0, 2.4, 0)
	local col = piece(Vector3.new(4, r * 1.6, r * 1.6), Color3.fromRGB(150, 210, 255), Enum.Material.Glass, Enum.PartType.Cylinder, 0.25)
	col.CFrame = CFrame.new(g) * CFrame.Angles(0, 0, math.rad(90))
	tween(col, 0.3, { Size = Vector3.new(90, r * 1.6, r * 1.6), CFrame = CFrame.new(g + Vector3.new(0, 45, 0)) * CFrame.Angles(0, 0, math.rad(90)) })
	fade(col, 0.6, 0.6)
	for _ = 1, 40 do
		local drop = piece(Vector3.new(1.2, 1.2, 1.2), math.random() < 0.5 and c2 or Color3.new(1, 1, 1), Enum.Material.Glass, Enum.PartType.Ball, 0.1)
		drop.Position = g + Vector3.new(0, math.random(10, 70), 0)
		local a = math.random() * math.pi * 2
		tween(drop, 0.9, { Position = g + Vector3.new(math.cos(a) * math.random(10, 30), math.random(0, 20), math.sin(a) * math.random(10, 30)), Transparency = 1 })
		Debris:AddItem(drop, 0.95)
	end
	Fx.ring(g + Vector3.new(0, 0.4, 0), c, 4, r * 4, 0.6)
	if hooks.shake and near(at, 80) then
		hooks.shake(1.6)
		boom(at, 1.6)
	end
end

-- 매화 일순천참
local flashLines: { Part } = {}
function H.flashStart(data: any)
	local r = rootOf(data.m)
	if r and near(r.Position, 90) then
		colorGrade(-1, 0.35, 0.05, Color3.fromRGB(255, 225, 235), data.dur)
	end
	if r then
		Fx.text(r.Position + Vector3.new(0, 6, 0), "일순천참", Color3.fromRGB(255, 150, 200), 44, 1)
	end
end
function H.flashCut(data: any)
	local c, c2 = styleColors(data.style)
	local from, to = data.from, data.to
	if (to - from).Magnitude < 0.5 then
		return
	end
	local line = piece(Vector3.new(0.25, 0.25, (to - from).Magnitude), Color3.new(1, 1, 1), Enum.Material.Neon, nil, 0)
	line.CFrame = CFrame.lookAt((from + to) / 2, to)
	table.insert(flashLines, line)
	local glow = piece(Vector3.new(0.9, 0.9, (to - from).Magnitude), c, Enum.Material.Neon, nil, 0.6)
	glow.CFrame = line.CFrame
	table.insert(flashLines, glow)
	Fx.sound("swing", 0.5, 1.6, to)
	local _ = c2
end
function H.flashBurst(data: any)
	local c, c2 = styleColors(data.style)
	for _, l in ipairs(flashLines) do
		tween(l, 0.35, { Size = Vector3.new(2.5, 2.5, l.Size.Z), Transparency = 1 })
		Debris:AddItem(l, 0.4)
	end
	flashLines = {}
	for _, m in ipairs(data.targets or {}) do
		local tr = rootOf(m)
		if tr then
			-- 한꺼번에 베인 자리: X자와 꽃잎
			for _, sgn in ipairs({ 1, -1 }) do
				local bar = piece(Vector3.new(0.4, 0.4, 14), Color3.new(1, 1, 1), Enum.Material.Neon, nil, 0)
				bar.CFrame = CFrame.new(tr.Position) * CFrame.Angles(0, math.rad(45 * sgn), math.rad(30 * sgn))
				tween(bar, 0.4, { Size = Vector3.new(0.05, 0.05, 20), Transparency = 1 })
				Debris:AddItem(bar, 0.45)
			end
			Fx.bloom(tr.Position - Vector3.new(0, 1.5, 0), 7)
			Fx.spark(tr.Position, c2, 2, 10)
		end
	end
	local p = data.points and data.points[#data.points]
	if p and hooks.flash and near(p, 90) then
		hooks.flash(Color3.fromRGB(255, 220, 235), 0.4)
	end
	if p and hooks.shake and near(p, 90) then
		hooks.shake(1.3)
		boom(p, 1.3)
	end
	local _ = c
end

-- 벽력 뇌신화
function H.boltStart(data: any)
	local r = rootOf(data.m)
	if r and near(r.Position, 100) then
		colorGrade(-0.3, 0.25, -0.15, Color3.fromRGB(170, 185, 255), data.dur)
	end
	if r then
		Fx.text(r.Position + Vector3.new(0, 6, 0), "뇌신화", Color3.fromRGB(255, 240, 140), 44, 1)
		local cloud = piece(Vector3.new(4, 80, 80), Color3.fromRGB(35, 35, 55), Enum.Material.SmoothPlastic, Enum.PartType.Cylinder, 0.35)
		cloud.CFrame = CFrame.new(r.Position + Vector3.new(0, 60, 0)) * CFrame.Angles(0, 0, math.rad(90))
		fade(cloud, data.dur, 0.5)
	end
end
function H.boltJump(data: any)
	local c, c2 = styleColors(data.style)
	Fx.lightning(data.from + Vector3.new(0, 1, 0), data.to + Vector3.new(0, 1, 0), c2, 1.4)
	Fx.lightning(data.from + Vector3.new(0, 1, 0), data.to + Vector3.new(0, 1, 0), c, 0.6)
	local g = data.at - Vector3.new(0, 2.4, 0)
	Fx.lightning(g + Vector3.new(math.random(-5, 5), 70, math.random(-5, 5)), g, Color3.new(1, 1, 1), 1.6)
	Fx.ring(g + Vector3.new(0, 0.3, 0), c, 2, 16, 0.35)
	Fx.sound("heavy", 0.6, 1.4, data.at)
	if hooks.shake and near(data.at, 60) then
		hooks.shake(0.7)
		boom(data.at, 0.7)
	end
end

-- 취권 불덩이
function H.fireball(data: any)
	local m = data.m
	local ball = piece(Vector3.new(7, 7, 7), Color3.fromRGB(255, 120, 30), Enum.Material.Neon, Enum.PartType.Ball, 0.3)
	local core = piece(Vector3.new(4, 4, 4), Color3.fromRGB(255, 230, 140), Enum.Material.Neon, Enum.PartType.Ball, 0.1)
	local fire = Instance.new("Fire")
	fire.Size = 10
	fire.Heat = 15
	fire.Parent = ball
	local start = os.clock()
	local last = nil :: Vector3?
	local conn: RBXScriptConnection
	conn = RunService.RenderStepped:Connect(function()
		local r = rootOf(m)
		local t = os.clock() - start
		if not r or t > data.dur then
			conn:Disconnect()
			tween(ball, 0.3, { Transparency = 1, Size = Vector3.new(12, 12, 12) })
			tween(core, 0.3, { Transparency = 1 })
			Debris:AddItem(ball, 0.35)
			Debris:AddItem(core, 0.35)
			return
		end
		ball.CFrame = CFrame.new(r.Position) * CFrame.Angles(t * 12, t * 7, 0)
		core.Position = r.Position
		-- 굴러간 자리에 불길
		if not last or (r.Position - last).Magnitude > 3 then
			last = r.Position
			local fl = piece(Vector3.new(2.5, 2.5, 2.5), Color3.fromRGB(255, 150, 50), Enum.Material.Neon, Enum.PartType.Ball, 0.2)
			fl.Position = r.Position - Vector3.new(0, 2, 0)
			tween(fl, 0.5, { Size = Vector3.new(0.4, 0.4, 0.4), Position = fl.Position + Vector3.new(0, 3, 0), Transparency = 1 })
			Debris:AddItem(fl, 0.55)
		end
	end)
	local r = rootOf(m)
	if r then
		Fx.text(r.Position + Vector3.new(0, 6, 0), "취선굴렁쇠", Color3.fromRGB(255, 170, 70), 40, 1)
	end
end
function H.burst(data: any)
	local at, r = data.at, data.radius or 7
	local g = at - Vector3.new(0, 2, 0)
	local big = data.big == true
	for _ = 1, big and 22 or 10 do
		local b = piece(Vector3.new(2, 2, 2), math.random() < 0.5 and Color3.fromRGB(255, 140, 40) or Color3.fromRGB(255, 220, 120), Enum.Material.Neon, Enum.PartType.Ball, 0.1)
		b.Position = g + Vector3.new(0, 1, 0)
		local a = math.random() * math.pi * 2
		tween(b, 0.45, { Position = g + Vector3.new(math.cos(a) * r, math.random(1, big and 10 or 5), math.sin(a) * r), Size = Vector3.new(5, 5, 5), Transparency = 1 })
		Debris:AddItem(b, 0.5)
	end
	Fx.ring(g + Vector3.new(0, 0.3, 0), Color3.fromRGB(255, 140, 40), 2, r * 2.6, 0.45)
	Fx.sound("heavy", big and 1 or 0.6, 0.8, at)
	if hooks.shake and near(at, 60) then
		hooks.shake(big and 1.4 or 0.6)
		boom(at, big and 1.4 or 0.6)
	end
end

-- 무극: 빛깔이 뒤집히고, 하늘의 눈이 열리고, 하늘의 손이 지운다
function H.freeze(data: any)
	Fx.mech(data)
	local at = data.at
	if near(at, 120) then
		colorGrade(-1, 0.6, 0, Color3.fromRGB(200, 205, 230), data.dur * 0.8)
	end
	local eyeC = at + Vector3.new(0, 70, 0)
	local white = piece(Vector3.new(6, 40, 80), Color3.new(1, 1, 1), Enum.Material.Neon, Enum.PartType.Ball, 0.1)
	white.CFrame = CFrame.new(eyeC) * CFrame.Angles(0, 0, 0)
	white.Size = Vector3.new(6, 2, 80)
	tween(white, 0.4, { Size = Vector3.new(6, 36, 80) })
	local iris = piece(Vector3.new(7, 26, 26), Color3.new(0, 0, 0), Enum.Material.SmoothPlastic, Enum.PartType.Ball, 0)
	iris.Position = eyeC
	iris.Size = Vector3.new(7, 1, 26)
	tween(iris, 0.4, { Size = Vector3.new(7, 26, 26) })
	fade(white, data.dur * 0.8, 0.4)
	fade(iris, data.dur * 0.8, 0.4)
	-- 하늘의 손 (다섯 손가락이 내려온다)
	local palm = piece(Vector3.new(30, 4, 26), Color3.fromRGB(20, 20, 25), Enum.Material.SmoothPlastic, nil, 0.15)
	palm.CFrame = CFrame.new(at + Vector3.new(0, 55, 0))
	local fingers = {}
	for i = -2, 2 do
		local fg = piece(Vector3.new(4.5, 3, 16), Color3.fromRGB(20, 20, 25), Enum.Material.SmoothPlastic, nil, 0.15)
		fg.CFrame = palm.CFrame * CFrame.new(i * 5.5, 0, -20)
		table.insert(fingers, fg)
	end
	task.delay(data.dur * 0.55, function()
		tween(palm, 0.18, { CFrame = CFrame.new(at + Vector3.new(0, -1, 0)) }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
		for i, fg in ipairs(fingers) do
			tween(fg, 0.18, { CFrame = CFrame.new(at + Vector3.new(0, -1, 0)) * CFrame.new((i - 3) * 5.5, 0, -20) }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
		end
		task.delay(0.2, function()
			Fx.ring(at - Vector3.new(0, 2, 0), Color3.new(1, 1, 1), 4, 70, 0.6)
			if hooks.shake and near(at, 100) then
				hooks.shake(2)
				boom(at, 2)
			end
		end)
	end)
	fade(palm, data.dur * 0.55 + 0.5, 0.4)
	for _, fg in ipairs(fingers) do
		fade(fg, data.dur * 0.55 + 0.5, 0.4)
	end
end

-- 삼재 천지인 일권
function H.charge(data: any)
	local m, time = data.m, data.time or 1
	local c, c2 = styleColors(data.style)
	local hand = m and m:FindFirstChild("RightHand")
	local r = rootOf(m)
	if not r then
		return
	end
	local orb = piece(Vector3.new(1, 1, 1), Color3.new(1, 1, 1), Enum.Material.Neon, Enum.PartType.Ball, 0.2)
	local start = os.clock()
	local conn: RBXScriptConnection
	conn = RunService.RenderStepped:Connect(function()
		local t = os.clock() - start
		local h = (hand and hand:IsA("BasePart")) and hand.Position or r.Position
		orb.Position = h
		orb.Size = Vector3.new(1, 1, 1) * (1 + t / time * 3.5)
		if t > time then
			conn:Disconnect()
			orb:Destroy()
		end
	end)
	-- 둘레의 바람과 빛이 주먹으로 빨려 든다
	for k = 0, 24 do
		task.delay(k * time / 25, function()
			local rr = rootOf(m)
			if not rr then
				return
			end
			local a = math.random() * math.pi * 2
			local from = rr.Position + Vector3.new(math.cos(a) * 24, math.random(-2, 10), math.sin(a) * 24)
			local mote = piece(Vector3.new(0.4, 0.4, 4), k % 2 == 0 and c or c2, Enum.Material.Neon, nil, 0.1)
			mote.CFrame = CFrame.lookAt(from, rr.Position)
			tween(mote, 0.3, { CFrame = CFrame.lookAt(rr.Position, rr.Position + (rr.Position - from)), Size = Vector3.new(0.1, 0.1, 1) }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
			Debris:AddItem(mote, 0.32)
		end)
	end
	for k = 0, 3 do
		task.delay(k * time / 4, function()
			Fx.ring(r.Position - Vector3.new(0, 2.4, 0), c, 30 - k * 6, 3, 0.35)
		end)
	end
	Fx.text(r.Position + Vector3.new(0, 6, 0), "천지인 일권", c, 44, 1.2)
end
function H.onepunch(data: any)
	local from, dir, range = data.from, data.dir, data.range or 44
	local c, c2 = styleColors(data.style)
	-- 하얗게 번쩍, 공기가 원뿔로 찢겨 나간다
	if near(from, 100) then
		if hooks.flash then
			hooks.flash(Color3.new(1, 1, 1), 0.6)
		end
		if hooks.shake then
			hooks.shake(2.4)
		end
	end
	for k = 1, 9 do
		task.delay(k * 0.025, function()
			local p = from + dir * (k * range / 9)
			Fx.ring(p, k % 2 == 0 and c2 or Color3.new(1, 1, 1), 2 + k, 6 + k * 3.2, 0.45, dir)
		end)
	end
	local cone = piece(Vector3.new(range * 0.6, range * 0.6, range), Color3.new(1, 1, 1), Enum.Material.Neon, nil, 0.5)
	cone.CFrame = CFrame.lookAt(from + dir * range / 2, from + dir * range)
	cone.Size = Vector3.new(2, 2, range)
	tween(cone, 0.25, { Size = Vector3.new(range * 0.55, range * 0.35, range), Transparency = 1 })
	Debris:AddItem(cone, 0.3)
	-- 땅이 갈라진다
	for k = 0, 10 do
		task.delay(k * 0.02, function()
			local p = from - Vector3.new(0, 2.4, 0) + dir * (4 + k * range / 11)
			local crack = piece(Vector3.new(1.2, 0.3, range / 11 + 1), Color3.fromRGB(40, 30, 25), Enum.Material.Slate, nil, 0)
			crack.CFrame = CFrame.lookAt(p, p + dir) * CFrame.Angles(0, math.rad(math.random(-15, 15)), 0)
			fade(crack, 1.5, 0.6)
			local glow = piece(Vector3.new(0.5, 0.4, range / 11), c, Enum.Material.Neon, nil, 0.2)
			glow.CFrame = crack.CFrame * CFrame.new(0, 0.1, 0)
			fade(glow, 0.8, 0.6)
		end)
	end
	Fx.dust(from - Vector3.new(0, 2.4, 0) + dir * 6, 8)
	Fx.sound("heavy", 1, 0.4, from)
end

-- 천제 하늘의 문과 빛의 검
function H.skygate(data: any)
	local r = rootOf(data.m)
	if not r then
		return
	end
	local c, c2 = styleColors(data.style)
	local center = r.Position + Vector3.new(0, 55, 0)
	local ring = piece(Vector3.new(1.5, 60, 60), c, Enum.Material.Neon, Enum.PartType.Cylinder, 0.35)
	ring.CFrame = CFrame.new(center) * CFrame.Angles(0, 0, math.rad(90))
	local inner = piece(Vector3.new(1.6, 50, 50), Color3.fromRGB(255, 250, 230), Enum.Material.Neon, Enum.PartType.Cylinder, 0.6)
	inner.CFrame = ring.CFrame
	fade(ring, data.dur, 0.5)
	fade(inner, data.dur, 0.5)
	-- 문에서 아래를 겨눈 검들
	for k = 0, 23 do
		local a = k / 24 * math.pi * 2
		local p = center + Vector3.new(math.cos(a) * 24, -3, math.sin(a) * 24)
		local blade = piece(Vector3.new(0.6, 9, 1.4), k % 2 == 0 and c2 or c, Enum.Material.Neon, nil, 0.2)
		blade.CFrame = CFrame.new(p)
		fade(blade, data.dur * 0.8, 0.4)
	end
	if near(r.Position, 100) then
		colorGrade(0.2, 0.15, 0.08, Color3.fromRGB(255, 245, 215), data.dur)
	end
	Fx.text(r.Position + Vector3.new(0, 7, 0), "만검천벌", c, 44, 1.2)
end
function H.sword(data: any)
	local at = data.at
	local c, c2 = styleColors(data.style)
	local big = data.big == true
	local s = big and 5 or 1
	local g = at - Vector3.new(0, 2.4, 0)
	local blade = piece(Vector3.new(0.8, 12, 2.2) * s, Color3.fromRGB(255, 252, 235), Enum.Material.Neon, nil, 0)
	local guard = piece(Vector3.new(0.9, 0.8, 6) * s, c, Enum.Material.Neon, nil, 0)
	local hilt = piece(Vector3.new(0.7, 3, 0.7) * s, c2, Enum.Material.Neon, nil, 0)
	local top = g + Vector3.new(0, 70 * (big and 1.6 or 1), 0)
	local function place(y: number)
		blade.CFrame = CFrame.new(g + Vector3.new(0, y + 6 * s, 0))
		guard.CFrame = CFrame.new(g + Vector3.new(0, y + 12.4 * s, 0))
		hilt.CFrame = CFrame.new(g + Vector3.new(0, y + 14.2 * s, 0))
	end
	place(top.Y - g.Y)
	local start = os.clock()
	local fall = big and 0.35 or 0.22
	local conn: RBXScriptConnection
	conn = RunService.RenderStepped:Connect(function()
		local k = math.clamp((os.clock() - start) / fall, 0, 1)
		place((top.Y - g.Y) * (1 - k * k) - 3 * s * k)
		if k >= 1 then
			conn:Disconnect()
		end
	end)
	task.delay(fall, function()
		Fx.ring(g + Vector3.new(0, 0.3, 0), c, 2, (data.radius or 6) * 2.4, 0.45)
		Fx.spark(g + Vector3.new(0, 2, 0), Color3.new(1, 1, 1), 2 * s, 10)
		Fx.sound("heavy", big and 1 or 0.5, big and 0.5 or 1.3, at)
		if big then
			-- 거대한 검이 꽂힌 뒤 빛으로 터진다
			task.delay(0.35, function()
				local beam = piece(Vector3.new(160, 22, 22), Color3.fromRGB(255, 250, 225), Enum.Material.Neon, Enum.PartType.Cylinder, 0.2)
				beam.CFrame = CFrame.new(g + Vector3.new(0, 80, 0)) * CFrame.Angles(0, 0, math.rad(90))
				tween(beam, 0.6, { Size = Vector3.new(160, 2, 2), Transparency = 1 })
				Debris:AddItem(beam, 0.65)
				for k = 0, 3 do
					task.delay(k * 0.07, function()
						Fx.ring(g + Vector3.new(0, 0.5 + k, 0), k % 2 == 0 and c or c2, 4, (data.radius or 16) * 3.2, 0.6)
					end)
				end
				if hooks.flash and near(at, 100) then
					hooks.flash(Color3.fromRGB(255, 245, 210), 0.45)
				end
				if hooks.shake and near(at, 100) then
					hooks.shake(2)
					boom(at, 2)
				end
			end)
		end
	end)
	for _, p in ipairs({ blade, guard, hilt }) do
		fade(p, fall + (big and 0.5 or 0.35), 0.3)
	end
end

-- 파천 흑일강림: 하늘이 찢기고 검은 해가 뜬다. 빛 고리가 돌고, 둘레의 빛이 빨려 들어간다
function H.blackhole(data: any)
	local c, c2 = styleColors(data.style)
	local at: Vector3 = data.at
	local sky = at + Vector3.new(0, data.height or 16, 0)
	local r = data.radius or 30
	local delay, dur = data.delay or 0.6, data.dur or 2.6
	local ground = at - Vector3.new(0, 2.4, 0)
	-- 하늘이 찢어진다: 보랏빛 금이 여러 갈래로
	for k = 0, 5 do
		local a = k / 6 * math.pi * 2
		local d = Vector3.new(math.cos(a), math.sin(a * 2) * 0.4, math.sin(a))
		local tear = piece(Vector3.new(0.4, 0.4, 0.1), k % 2 == 0 and c or c2, Enum.Material.Neon, nil, 0)
		tear.CFrame = CFrame.lookAt(sky, sky + d)
		tween(tear, delay * 0.8, { Size = Vector3.new(0.5, 0.5, 18), CFrame = CFrame.lookAt(sky + d * 9, sky + d * 18) })
		fade(tear, delay, 0.3)
	end
	colorGrade(-0.5, 0.25, -0.18, Color3.fromRGB(205, 185, 255), delay + dur)
	-- 바닥: 무게에 짓눌린 검은 원과 갈라진 금
	local floor = piece(Vector3.new(0.2, 2, 2), Color3.fromRGB(15, 5, 25), Enum.Material.SmoothPlastic, Enum.PartType.Cylinder, 0.25)
	floor.CFrame = CFrame.new(ground + Vector3.new(0, 0.12, 0)) * CFrame.Angles(0, 0, math.rad(90))
	tween(floor, 0.5, { Size = Vector3.new(0.2, r * 2, r * 2) })
	local edge = piece(Vector3.new(0.25, 2, 2), c, Enum.Material.Neon, Enum.PartType.Cylinder, 0.4)
	edge.CFrame = floor.CFrame
	tween(edge, 0.5, { Size = Vector3.new(0.25, r * 2 + 1.5, r * 2 + 1.5) })
	for k = 0, 9 do
		local a = k / 10 * math.pi * 2 + math.random() * 0.3
		local len = r * (0.6 + math.random() * 0.4)
		local crack = piece(Vector3.new(0.6, 0.15, 0.1), c, Enum.Material.Neon, nil, 0.1)
		local d = Vector3.new(math.cos(a), 0, math.sin(a))
		crack.CFrame = CFrame.lookAt(ground + Vector3.new(0, 0.3, 0), ground + Vector3.new(0, 0.3, 0) + d)
		tween(crack, 0.4, { Size = Vector3.new(0.6, 0.15, len), CFrame = CFrame.lookAt(ground + Vector3.new(0, 0.3, 0) + d * len / 2, ground + Vector3.new(0, 0.3, 0) + d * len) })
		fade(crack, delay + dur, 0.4)
	end
	fade(floor, delay + dur, 0.4)
	fade(edge, delay + dur, 0.4)
	-- 검은 해, 빛을 휘게 하는 유리 껍질, 두 겹의 빛 고리
	local core = piece(Vector3.new(0.5, 0.5, 0.5), Color3.new(0, 0, 0), Enum.Material.SmoothPlastic, Enum.PartType.Ball, 0)
	core.Position = sky
	local lens = piece(Vector3.new(0.6, 0.6, 0.6), c, Enum.Material.Glass, Enum.PartType.Ball, 0.55)
	lens.Position = sky
	local corona = piece(Vector3.new(0.6, 0.6, 0.6), c2, Enum.Material.Neon, Enum.PartType.Ball, 0.75)
	corona.Position = sky
	local size = math.clamp(r * 0.38, 7, 14)
	tween(core, delay, { Size = Vector3.new(size, size, size) }, Enum.EasingStyle.Back)
	tween(lens, delay, { Size = Vector3.new(size * 1.7, size * 1.7, size * 1.7) })
	tween(corona, delay, { Size = Vector3.new(size * 1.25, size * 1.25, size * 1.25) })
	local disks = {}
	for i = 1, 3 do
		local d = piece(Vector3.new(0.3, 0.5, 0.5), i == 2 and c2 or c, Enum.Material.Neon, Enum.PartType.Cylinder, 0.25 + i * 0.12)
		table.insert(disks, d)
		tween(d, delay, { Size = Vector3.new(0.3, size * (1.8 + i * 0.6), size * (1.8 + i * 0.6)) })
	end
	local light = Instance.new("PointLight")
	light.Color = c
	light.Range = 60
	light.Brightness = 5
	light.Parent = corona
	local start = os.clock()
	local lastSpawn = 0
	local conn: RBXScriptConnection
	conn = RunService.RenderStepped:Connect(function()
		local t = os.clock() - start
		for i, d in ipairs(disks) do
			d.CFrame = CFrame.new(sky) * CFrame.Angles(math.rad(70 + i * 8), t * (2 + i), math.rad(90 + i * 12)) * CFrame.Angles(t * (3 - i * 0.6), 0, 0)
		end
		local pulse = 1 + math.sin(t * 9) * 0.04
		corona.Size = Vector3.new(size, size, size) * 1.25 * pulse
		-- 둘레의 빛 조각이 빨려 들어간다
		if t > delay * 0.5 and t - lastSpawn > 0.04 and t < delay + dur then
			lastSpawn = t
			for _ = 1, 2 do
				local dir = Vector3.new(math.random() - 0.5, math.random() - 0.5, math.random() - 0.5)
				dir = dir.Magnitude > 0.01 and dir.Unit or Vector3.new(0, 1, 0)
				local from = sky + dir * (r * 0.8)
				local shard = piece(Vector3.new(0.3, 0.3, 2.4), math.random() < 0.5 and c or c2, Enum.Material.Neon, nil, 0.1)
				shard.CFrame = CFrame.lookAt(from, sky)
				tween(shard, 0.45, { CFrame = CFrame.lookAt(sky, sky + dir), Size = Vector3.new(0.1, 0.1, 0.6), Transparency = 0.8 }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
				Debris:AddItem(shard, 0.5)
			end
		end
		if t >= delay + dur then
			conn:Disconnect()
			-- 안으로 무너진다 (터지는 빛은 blackholeBurst)
			for _, p in ipairs({ core, lens, corona, table.unpack(disks) }) do
				tween(p, 0.15, { Size = Vector3.new(0.1, 0.1, 0.1) }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
				Debris:AddItem(p, 0.2)
			end
		end
	end)
	Fx.text(sky + Vector3.new(0, size + 4, 0), "흑일강림", c2, 46, 1.4)
	Fx.sound("heavy", 1, 0.3, sky)
	if hooks.shake and near(at, 90) then
		hooks.shake(1.2)
		boom(at, 1.2)
	end
end
function H.blackholeBurst(data: any)
	local c, c2 = styleColors(data.style)
	local at: Vector3 = data.at
	local r = data.radius or 30
	local flash = piece(Vector3.new(2, 2, 2), Color3.fromRGB(255, 250, 240), Enum.Material.Neon, Enum.PartType.Ball, 0)
	flash.Position = at
	tween(flash, 0.35, { Size = Vector3.new(r * 2.6, r * 2.6, r * 2.6), Transparency = 1 })
	Debris:AddItem(flash, 0.4)
	local shell = piece(Vector3.new(2, 2, 2), c, Enum.Material.ForceField, Enum.PartType.Ball, 0)
	shell.Position = at
	tween(shell, 0.6, { Size = Vector3.new(r * 3.2, r * 3.2, r * 3.2), Transparency = 1 })
	Debris:AddItem(shell, 0.65)
	for k = 0, 2 do
		task.delay(k * 0.06, function()
			Fx.ring(at, k % 2 == 0 and c or c2, 4, r * 3, 0.6)
			Fx.ring(at, c2, 4, r * 2.4, 0.6, Vector3.new(0, 1, 0):Cross(Vector3.new(1, 0, 0)))
		end)
	end
	local beam = piece(Vector3.new(200, 6, 6), c2, Enum.Material.Neon, Enum.PartType.Cylinder, 0.2)
	beam.CFrame = CFrame.new(at + Vector3.new(0, 90, 0)) * CFrame.Angles(0, 0, math.rad(90))
	tween(beam, 0.5, { Size = Vector3.new(200, 0.2, 0.2), Transparency = 1 })
	Debris:AddItem(beam, 0.55)
	Fx.spark(at, c2, 3, 26)
	if hooks.flash and near(at, 100) then
		hooks.flash(Color3.fromRGB(240, 225, 255), 0.45)
	end
	if hooks.shake and near(at, 110) then
		hooks.shake(2.6)
		boom(at, 2.6)
	end
	Fx.sound("heavy", 1, 0.25, at)
end

-- 태초 천지개벽: 세상이 멈추고 별바다가 된다 → 금이 간다 → 유리처럼 깨진다
function H.genesis(data: any)
	local c, c2 = styleColors(data.style)
	local at: Vector3 = data.at
	local R = math.min(data.radius or 60, 70)
	local dur = data.dur or 2.6
	local crackAt, breakAt = data.crackAt or 1.6, data.breakAt or 2.5
	local ground = at - Vector3.new(0, 2.4, 0)
	local parts: { BasePart } = {}
	-- 1) 세상이 멈춘다: 빛깔이 빠지고, 바닥이 별을 비추는 검푸른 거울이 된다
	colorGrade(-0.85, 0.3, -0.3, Color3.fromRGB(180, 195, 255), breakAt)
	local mirror = piece(Vector3.new(0.2, 2, 2), Color3.fromRGB(10, 14, 40), Enum.Material.Glass, Enum.PartType.Cylinder, 0.15)
	mirror.CFrame = CFrame.new(ground + Vector3.new(0, 0.15, 0)) * CFrame.Angles(0, 0, math.rad(90))
	tween(mirror, 0.5, { Size = Vector3.new(0.2, R * 2, R * 2) })
	table.insert(parts, mirror)
	-- 하늘의 별과 은하 (반구 위에 흩뿌린다)
	for i = 1, 90 do
		local a = math.random() * math.pi * 2
		local e = math.random() * 1.3 + 0.15
		local d = R * (0.75 + math.random() * 0.25)
		local p = at + Vector3.new(math.cos(a) * math.cos(e) * d, math.sin(e) * d * 0.7, math.sin(a) * math.cos(e) * d)
		local s = math.random() < 0.12 and 1.1 or 0.45
		local star = piece(Vector3.new(s, s, s), i % 7 == 0 and c2 or Color3.fromRGB(255, 252, 240), Enum.Material.Neon, Enum.PartType.Ball, 1)
		star.Position = p
		tween(star, 0.3 + math.random() * 0.4, { Transparency = 0.05 })
		table.insert(parts, star)
		-- 거울 바닥에 비친 별
		if i % 2 == 0 then
			local refl = piece(Vector3.new(0.3, 0.3, 0.3), star.Color, Enum.Material.Neon, Enum.PartType.Ball, 1)
			refl.Position = Vector3.new(p.X, ground.Y + 0.35, p.Z) + Vector3.new(0, 0, 0)
			tween(refl, 0.6, { Transparency = 0.3 })
			table.insert(parts, refl)
		end
	end
	for g = 0, 1 do
		local gc = at + Vector3.new((g == 0 and -1 or 1) * R * 0.4, R * 0.55, -R * 0.2)
		for k = 0, 23 do
			local a = k * 0.55
			local rr = 2 + k * 0.6
			local dot = piece(Vector3.new(0.7, 0.7, 0.7), g == 0 and c2 or c, Enum.Material.Neon, Enum.PartType.Ball, 1)
			dot.Position = gc + Vector3.new(math.cos(a) * rr, math.sin(a) * rr * 0.35, math.sin(a) * rr)
			tween(dot, 0.6, { Transparency = 0.15 })
			table.insert(parts, dot)
		end
	end
	-- 멈춘 적은 빛의 결정에 갇힌다
	for _, m in ipairs(data.targets or {}) do
		local tr = rootOf(m)
		if tr then
			local shell = piece(Vector3.new(1, 1, 1), c2, Enum.Material.Glass, Enum.PartType.Ball, 0.5)
			shell.Position = tr.Position
			tween(shell, 0.25, { Size = Vector3.new(7, 9, 7) })
			table.insert(parts, shell)
		end
	end
	-- 하늘에 떠오르는 내 별자리 (거대한 빛의 몸)
	local caster = data.m
	local cr = rootOf(caster)
	if cr then
		local look = flat(cr.CFrame.LookVector)
		local s = 6
		local base = cr.Position - look * 14 + Vector3.new(0, 2.6 * s - 2.5, 0)
		local cf = CFrame.lookAt(base, base + look)
		local ghost = spirit(s, c2, Enum.Material.ForceField, 0.2, data.style, cf - Vector3.new(0, 6, 0))
		rise(ghost, cf - Vector3.new(0, 6, 0), cf, 0.6)
		Anim.play(ghost, "ult_origin", breakAt + 0.3)
		vanish(ghost, breakAt + 0.3, 0.4)
	end
	Fx.text(at + Vector3.new(0, 12, 0), "천지개벽", Color3.fromRGB(255, 250, 230), 54, 1.6)
	Fx.sound("heavy", 0.8, 0.2, at)
	-- 2) 금이 간다: 하늘과 땅에 흰 금이 번진다
	task.delay(crackAt, function()
		for k = 0, 17 do
			local a = k / 18 * math.pi * 2 + math.random() * 0.25
			local d = Vector3.new(math.cos(a), (k % 3 - 1) * 0.35, math.sin(a)).Unit
			local from = at + Vector3.new(0, 4, 0) + d * 3
			local len = R * (0.5 + math.random() * 0.5)
			local crack = piece(Vector3.new(0.35, 0.35, 0.1), Color3.fromRGB(255, 255, 255), Enum.Material.Neon, nil, 0)
			crack.CFrame = CFrame.lookAt(from, from + d)
			tween(crack, 0.35, { Size = Vector3.new(0.35, 0.35, len), CFrame = CFrame.lookAt(from + d * len / 2, from + d * len) })
			table.insert(parts, crack)
			-- 갈래
			local d2 = (d + Vector3.new(math.random() - 0.5, math.random() - 0.5, math.random() - 0.5) * 0.8).Unit
			local mid = from + d * len * 0.5
			local twig = piece(Vector3.new(0.25, 0.25, 0.1), Color3.fromRGB(220, 235, 255), Enum.Material.Neon, nil, 0)
			twig.CFrame = CFrame.lookAt(mid, mid + d2)
			tween(twig, 0.3, { Size = Vector3.new(0.25, 0.25, len * 0.4), CFrame = CFrame.lookAt(mid + d2 * len * 0.2, mid + d2 * len * 0.4) })
			table.insert(parts, twig)
		end
		Fx.sound("hit", 1, 0.5, at)
		if hooks.shake and near(at, 90) then
			hooks.shake(0.6)
			boom(at, 0.6)
		end
	end)
	-- 3) 깨진다: 조각이 사방으로 흩어지고, 흰 빛이 세상을 덮는다
	task.delay(breakAt, function()
		-- 별바다와 금은 그 자리에서 빛을 잃는다 (날아가는 것은 아래의 유리 조각)
		-- 수백 개를 하나씩 트윈하지 않고, 몇 걸음에 걸쳐 한꺼번에 흐려 지운다
		local from: { number } = {}
		for i, p in ipairs(parts) do
			from[i] = p.Transparency
		end
		for step = 1, 4 do
			task.delay(step * 0.08, function()
				for i, p in ipairs(parts) do
					if p.Parent then
						if step == 4 then
							p:Destroy()
						else
							p.Transparency = from[i] + (1 - from[i]) * step / 4
						end
					end
				end
			end)
		end
		for _ = 1, 50 do
			local a = math.random() * math.pi * 2
			local e = math.random() * 1.2
			local d = Vector3.new(math.cos(a) * math.cos(e), math.sin(e), math.sin(a) * math.cos(e))
			local p0 = at + d * (R * (0.3 + math.random() * 0.6))
			local shard = piece(Vector3.new(math.random() * 3 + 1, 0.15, math.random() * 4 + 1.5), math.random() < 0.5 and Color3.fromRGB(230, 240, 255) or c2, Enum.Material.Glass, nil, 0.2)
			shard.CFrame = CFrame.new(p0) * CFrame.Angles(math.random() * 6, math.random() * 6, math.random() * 6)
			tween(shard, 0.8, { CFrame = CFrame.new(p0 + d * 30 + Vector3.new(0, -10, 0)) * CFrame.Angles(math.random() * 6, math.random() * 6, math.random() * 6), Transparency = 1 })
			Debris:AddItem(shard, 0.85)
		end
		local nova = piece(Vector3.new(4, 4, 4), Color3.fromRGB(255, 255, 250), Enum.Material.Neon, Enum.PartType.Ball, 0)
		nova.Position = at
		tween(nova, 0.4, { Size = Vector3.new(R * 2.4, R * 2.4, R * 2.4), Transparency = 1 })
		Debris:AddItem(nova, 0.45)
		for k = 0, 3 do
			task.delay(k * 0.07, function()
				Fx.ring(ground + Vector3.new(0, 0.5 + k, 0), k % 2 == 0 and c2 or Color3.fromRGB(255, 255, 255), 6, R * 2.6, 0.7)
			end)
		end
		if hooks.flash and near(at, 120) then
			hooks.flash(Color3.fromRGB(255, 255, 255), 0.6)
		end
		if hooks.shake and near(at, 120) then
			hooks.shake(3)
			boom(at, 3)
		end
		Fx.sound("heavy", 1, 0.2, at)
	end)
	local _ = dur
end

-- 일월동천: 밤이 내리고 → 해와 달이 뜨고 → 달빛이 벤다 → 해와 달이 겹쳐 일식 → 검은 해의 빛살 → 새벽의 폭발
local nightCount = 0
local exposureBase = 0
local function eclipseTop(at: Vector3): Vector3
	return at + Vector3.new(0, 48, 0)
end
-- 여러 조각을 몇 걸음에 걸쳐 한꺼번에 흐려 지운다 (조각마다 트윈을 걸지 않는다)
local function fadeAll(list: { BasePart }, steps: number, every: number)
	local from: { number } = {}
	for i, p in ipairs(list) do
		from[i] = p.Transparency
	end
	for step = 1, steps do
		task.delay(step * every, function()
			for i, p in ipairs(list) do
				if p.Parent then
					if step == steps then
						p:Destroy()
					else
						p.Transparency = from[i] + (1 - from[i]) * step / steps
					end
				end
			end
		end)
	end
end
function H.eclipse(data: any)
	local c, c2 = styleColors(data.style)
	local at: Vector3 = data.at
	local R = math.min(data.radius or 60, 70)
	local slashFrom, slashEvery, slashes = data.slashFrom or 0.6, data.slashEvery or 0.24, data.slashes or 5
	local eclipseAt, finalAt = data.eclipseAt or 2.0, data.finalAt or 3.2
	local ground = at - Vector3.new(0, 2.4, 0)
	local top = eclipseTop(at)
	local caster = rootOf(data.m)
	local look = caster and flat(caster.CFrame.LookVector) or Vector3.new(0, 0, -1)
	local right = Vector3.new(-look.Z, 0, look.X)
	local parts: { BasePart } = {}
	local function keep(p: BasePart): BasePart
		table.insert(parts, p)
		return p
	end
	local close = near(at, 170)
	-- 1) 밤이 내린다: 빛이 꺼지고 푸른 밤빛, 하늘에 별
	if close then
		colorGrade(-0.3, 0.25, -0.1, Color3.fromRGB(155, 170, 255), finalAt)
		if nightCount == 0 then
			pcall(function()
				exposureBase = Lighting.ExposureCompensation
			end)
		end
		nightCount += 1
		pcall(tween, Lighting, 0.6, { ExposureCompensation = exposureBase - 1.3 })
	end
	for i = 1, 36 do
		local a = math.random() * math.pi * 2
		local e = 0.35 + math.random() * 1.0
		local d = R * (0.8 + math.random() * 0.3)
		local star = keep(piece(Vector3.new(0.5, 0.5, 0.5) * (i % 6 == 0 and 2 or 1), i % 5 == 0 and c2 or Color3.fromRGB(255, 252, 240), Enum.Material.Neon, Enum.PartType.Ball, 1))
		star.Position = at + Vector3.new(math.cos(a) * math.cos(e) * d, 20 + math.sin(e) * d * 0.6, math.sin(a) * math.cos(e) * d)
		tween(star, 0.4 + math.random() * 0.5, { Transparency = 0.1 })
	end
	Fx.text(at + Vector3.new(0, 12, 0), "일월동천", Color3.fromRGB(255, 235, 190), 54, 1.6)
	Fx.sound("heavy", 0.7, 0.3, at)
	-- 2) 해와 달이 떠오른다 (해는 오른쪽, 달은 왼쪽)
	local sunAt = top + right * R * 0.42 - Vector3.new(0, 4, 0)
	local moonAt = top - right * R * 0.42 - Vector3.new(0, 4, 0)
	local sun = keep(piece(Vector3.new(15, 15, 15), c, Enum.Material.Neon, Enum.PartType.Ball, 0))
	sun.Position = ground + right * R * 0.8 + Vector3.new(0, 2, 0)
	local sunGlow = keep(piece(Vector3.new(22, 22, 22), Color3.fromRGB(255, 215, 130), Enum.Material.ForceField, Enum.PartType.Ball, 0.25))
	sunGlow.Position = sun.Position
	local light = Instance.new("PointLight")
	light.Color = c
	light.Range = 60
	light.Brightness = 6
	light.Shadows = false
	light.Parent = sun
	local moon = keep(piece(Vector3.new(13, 13, 13), c2, Enum.Material.Neon, Enum.PartType.Ball, 0))
	moon.Position = ground - right * R * 0.8 + Vector3.new(0, 2, 0)
	local moonShade = keep(piece(Vector3.new(12.4, 12.4, 12.4), Color3.fromRGB(14, 16, 34), Enum.Material.SmoothPlastic, Enum.PartType.Ball, 0))
	moonShade.Position = moon.Position
	tween(sun, 1.0, { Position = sunAt }, Enum.EasingStyle.Sine)
	tween(sunGlow, 1.0, { Position = sunAt }, Enum.EasingStyle.Sine)
	tween(moon, 1.0, { Position = moonAt }, Enum.EasingStyle.Sine)
	tween(moonShade, 1.0, { Position = moonAt - right * 3.6 + look * 1.5 }, Enum.EasingStyle.Sine)
	-- 해의 빛살: 해 둘레를 천천히 돈다 (일식 때는 검은 해 둘레로)
	local rays: { BasePart } = {}
	local rayDirs: { Vector3 } = {}
	for k = 1, 22 do
		local a = math.random() * math.pi * 2
		local e = (math.random() - 0.5) * 2.4
		local d = Vector3.new(math.cos(a) * math.cos(e), math.sin(e), math.sin(a) * math.cos(e)).Unit
		local ray = keep(piece(Vector3.new(0.5, 0.5, k % 3 == 0 and 22 or 13), k % 4 == 0 and Color3.fromRGB(255, 250, 225) or c, Enum.Material.Neon, nil, 0.25))
		table.insert(rays, ray)
		table.insert(rayDirs, d)
	end
	local start = os.clock()
	local conn: RBXScriptConnection
	conn = RunService.Heartbeat:Connect(function()
		local t = os.clock() - start
		if t > finalAt or not sun.Parent then
			conn:Disconnect()
			return
		end
		local spin = CFrame.Angles(0, t * 0.7, 0)
		local eclipsed = t >= eclipseAt
		local reach = eclipsed and 1.6 or 1
		for i, ray in ipairs(rays) do
			local d = spin:VectorToWorldSpace(rayDirs[i])
			local len = ray.Size.Z * reach
			local p = sun.Position + d * (9 + len / 2)
			ray.CFrame = CFrame.lookAt(p, p + d)
		end
	end)
	-- 3) 달빛이 둘레를 벤다: 은빛 초승달이 하늘의 달에서 내려와 땅을 가로지른다
	for i = 0, slashes - 1 do
		task.delay(slashFrom + i * slashEvery, function()
			local a = math.random() * math.pi * 2
			local dir = Vector3.new(math.cos(a), 0, math.sin(a))
			local cf = CFrame.lookAt(ground + Vector3.new(0, 3, 0) - dir * R * 0.7, ground + Vector3.new(0, 3, 0))
			local to = CFrame.lookAt(ground + Vector3.new(0, 3, 0) + dir * R * 0.7, ground + Vector3.new(0, 3, 0) + dir * R * 1.4)
			local rr = R * 0.32
			for k = 0, 8 do
				local b = math.rad(-80 + k * 20)
				local w = 1 - math.abs(k - 4) / 4
				local lp = CFrame.new(math.sin(b) * rr, 0, -math.cos(b) * rr) * CFrame.Angles(0, -b, 0)
				local seg = piece(Vector3.new(rr * 0.24, 0.35, 0.4 + w * 1.6), k % 4 == 0 and Color3.fromRGB(255, 255, 255) or c2, Enum.Material.Neon, nil, 0.05)
				seg.CFrame = cf * lp
				tween(seg, slashEvery * 1.6, { CFrame = to * lp }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
				task.delay(slashEvery * 1.2, function()
					if seg.Parent then
						tween(seg, 0.2, { Transparency = 1 })
					end
				end)
				Debris:AddItem(seg, slashEvery * 1.2 + 0.25)
			end
			-- 달에서 땅으로 내리긋는 은빛 줄기
			local from = moon.Position
			local land = ground + Vector3.new(0, 3, 0) - dir * R * 0.7
			local beam = piece(Vector3.new(0.6, 0.6, (land - from).Magnitude), c2, Enum.Material.Neon, nil, 0.2)
			beam.CFrame = CFrame.lookAt((from + land) / 2, land)
			tween(beam, 0.25, { Size = Vector3.new(0.05, 0.05, beam.Size.Z), Transparency = 1 })
			Debris:AddItem(beam, 0.3)
			Fx.sound("swing", 0.6, 1.4, at)
			Fx.burst("glitter", ground + Vector3.new(0, 2, 0), c2, 10, 1.2)
			if hooks.shake and close then
				hooks.shake(0.25)
			end
		end)
	end
	-- 4) 일식: 해와 달이 머리 위에서 겹친다. 달이 검게 물들고, 해는 그 뒤에서 불꽃 테가 된다
	task.delay(eclipseAt - 0.45, function()
		tween(sun, 0.45, { Position = top, Size = Vector3.new(19, 19, 19) }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
		tween(sunGlow, 0.45, { Position = top, Size = Vector3.new(30, 30, 30) }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
		local front = top - look * 7 -- 시전자 쪽에서 보아 해 앞에 달
		tween(moon, 0.45, { Position = front, Size = Vector3.new(17.5, 17.5, 17.5) }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
		tween(moonShade, 0.45, { Position = front - look * 0.6, Size = Vector3.new(17.2, 17.2, 17.2) }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
	end)
	task.delay(eclipseAt, function()
		if not sun.Parent then
			return
		end
		moon.Color = Color3.fromRGB(8, 6, 12)
		moon.Material = Enum.Material.SmoothPlastic
		light.Brightness = 10
		light.Range = 90
		local corona = keep(piece(Vector3.new(1.2, 24, 24), Color3.fromRGB(255, 240, 200), Enum.Material.Neon, Enum.PartType.Cylinder, 0.15))
		corona.CFrame = CFrame.lookAt(top - look * 7.5, top - look * 20) * CFrame.Angles(0, math.rad(90), 0)
		tween(corona, 0.3, { Size = Vector3.new(1.2, 30, 30) }, Enum.EasingStyle.Back)
		local bead = keep(piece(Vector3.new(3, 3, 3), Color3.fromRGB(255, 255, 255), Enum.Material.Neon, Enum.PartType.Ball, 0))
		bead.Position = top - look * 7.8 + right * 8.6 + Vector3.new(0, 1.5, 0)
		tween(bead, 0.5, { Size = Vector3.new(5, 5, 5) })
		if close then
			colorGrade(-0.6, 0.45, -0.18, Color3.fromRGB(255, 215, 170), finalAt - eclipseAt)
		end
		if hooks.flash and close then
			hooks.flash(Color3.fromRGB(255, 220, 150), 0.25)
		end
		Fx.ring(ground + Vector3.new(0, 0.5, 0), c, 4, R * 2.2, 0.6)
		Fx.sound("heavy", 1, 0.4, at)
		if hooks.shake and close then
			hooks.shake(1.2)
		end
	end)
	-- 5) 새벽: 일식이 터지고 빛이 돌아온다
	task.delay(finalAt, function()
		local nova = piece(Vector3.new(10, 10, 10), Color3.fromRGB(255, 245, 215), Enum.Material.Neon, Enum.PartType.Ball, 0)
		nova.Position = top
		tween(nova, 0.5, { Size = Vector3.new(R * 2.2, R * 2.2, R * 2.2), Transparency = 1 })
		Debris:AddItem(nova, 0.55)
		local dome = piece(Vector3.new(6, 6, 6), c, Enum.Material.ForceField, Enum.PartType.Ball, 0)
		dome.Position = ground
		tween(dome, 0.6, { Size = Vector3.new(R * 2.4, R * 1.2, R * 2.4), Transparency = 1 })
		Debris:AddItem(dome, 0.65)
		for k = 0, 4 do
			task.delay(k * 0.08, function()
				Fx.ring(ground + Vector3.new(0, 0.5 + k, 0), k % 2 == 0 and c or c2, 6, R * 2.8, 0.8)
			end)
		end
		Fx.burst("ember", top, c, 40, 2.2)
		Fx.burst("glitter", ground + Vector3.new(0, 3, 0), c2, 40, 2.2)
		Fx.flash(ground + Vector3.new(0, 6, 0), Color3.fromRGB(255, 230, 180), 60, 8, 0.9)
		fadeAll(parts, 4, 0.08)
		if close then
			-- 동이 트는 빛: 잠깐 따뜻하게 밝았다가 원래대로
			pcall(tween, Lighting, 0.25, { ExposureCompensation = exposureBase + 0.6 })
			colorGrade(0.15, 0.1, 0.12, Color3.fromRGB(255, 225, 190), 0.5)
			task.delay(0.35, function()
				nightCount = math.max(0, nightCount - 1)
				if nightCount == 0 then
					pcall(tween, Lighting, 1.2, { ExposureCompensation = exposureBase })
				end
			end)
		end
		if hooks.flash and near(at, 130) then
			hooks.flash(Color3.fromRGB(255, 250, 235), 0.7)
		end
		if hooks.shake and near(at, 130) then
			hooks.shake(3)
			boom(at, 3)
		end
		Fx.sound("heavy", 1, 0.2, at)
	end)
end

-- 일월동천의 빛살: 검은 해에서 적마다 금빛 빛기둥이 내리꽂힌다
function H.eclipseBeams(data: any)
	local c, c2 = styleColors(data.style)
	local top = eclipseTop(data.at)
	for i, spot in ipairs(data.spots or {}) do
		task.delay((i - 1) * 0.03, function()
			local d = (spot - top).Magnitude
			local beam = piece(Vector3.new(2.6, 2.6, d), Color3.fromRGB(255, 225, 150), Enum.Material.Neon, nil, 0.05)
			beam.CFrame = CFrame.lookAt((top + spot) / 2, spot)
			tween(beam, 0.35, { Size = Vector3.new(0.2, 0.2, d), Transparency = 1 })
			Debris:AddItem(beam, 0.4)
			local core = piece(Vector3.new(0.9, 0.9, d), Color3.fromRGB(255, 255, 255), Enum.Material.Neon, nil, 0)
			core.CFrame = beam.CFrame
			tween(core, 0.25, { Size = Vector3.new(0.1, 0.1, d), Transparency = 1 })
			Debris:AddItem(core, 0.3)
			Fx.ring(spot - Vector3.new(0, 2.3, 0), i % 2 == 0 and c2 or c, 1, 12, 0.35)
			Fx.burst("spark", spot, c, 10, 1.2)
		end)
	end
	Fx.flash(top, c, 60, 6, 0.4)
	Fx.sound("hit", 1, 0.7, data.at)
	if hooks.shake and near(data.at, 100) then
		hooks.shake(1.4)
		boom(data.at, 1.4)
	end
end

-- 창해일소: 하늘을 가리는 해일. 물의 벽(기둥 열둘)이 일어서서 앞으로 밀려가고, 꼭대기엔 하얀 물마루가 부서진다
function H.tsunami(data: any)
	local c, c2 = styleColors(data.style)
	local from: Vector3 = data.from
	local dir: Vector3 = data.dir
	local W = data.width or 50
	local speed, dur, delay = data.speed or 34, data.dur or 1.8, data.delay or 0.5
	local right = Vector3.new(-dir.Z, 0, dir.X)
	local ground = from - Vector3.new(0, 2.4, 0)
	local cols = 12
	local H0 = 18
	local body: { BasePart } = {}
	local crest: { BasePart } = {}
	for i = 0, cols - 1 do
		local u = (i + 0.5) / cols - 0.5
		local w = piece(Vector3.new(W / cols + 1.2, 1, 8), c:Lerp(Color3.fromRGB(10, 40, 90), 0.25), Enum.Material.Glass, nil, 0.2)
		local cr = piece(Vector3.new(W / cols + 1.4, 2.4, 5), c2, Enum.Material.SmoothPlastic, nil, 0.1)
		table.insert(body, w)
		table.insert(crest, cr)
		local _ = u
	end
	-- 바다가 등 뒤에서 일어선다: 시전자 뒤로 물이 솟구치는 연출
	Fx.burst("glitter", from + Vector3.new(0, 4, 0), c2, 30, 2)
	Fx.sound("heavy", 0.6, 0.6, from)
	local start = os.clock()
	local conn: RBXScriptConnection
	conn = RunService.Heartbeat:Connect(function()
		local t = os.clock() - start
		local moving = math.max(0, t - delay)
		if t > delay + dur then
			conn:Disconnect()
			for k, p in ipairs(body) do
				tween(p, 0.3, { Transparency = 1 })
				tween(crest[k], 0.3, { Transparency = 1 })
				Debris:AddItem(p, 0.35)
				Debris:AddItem(crest[k], 0.35)
			end
			return
		end
		local rise = math.min(1, t / math.max(0.1, delay))
		local h = H0 * (0.25 + 0.75 * rise)
		local front = ground + dir * (speed * moving)
		for i, p in ipairs(body) do
			local u = (i - 0.5) / cols - 0.5
			-- 가운데가 조금 앞서고 높다 (휘어진 물마루)
			local bow = (1 - (u * 2) ^ 2)
			local hh = h * (0.8 + 0.25 * bow) + math.sin(t * 9 + i) * 0.6
			local at = front + right * (u * W) + dir * (bow * 3)
			p.Size = Vector3.new(W / cols + 1.2, hh, 8)
			p.CFrame = CFrame.lookAt(at + Vector3.new(0, hh / 2, 0), at + Vector3.new(0, hh / 2, 0) + dir) * CFrame.Angles(math.rad(-8), 0, 0)
			local cr = crest[i]
			cr.CFrame = CFrame.lookAt(at + Vector3.new(0, hh + 0.6, 0) + dir * 2.4, at + Vector3.new(0, hh + 0.6, 0) + dir * 6) * CFrame.Angles(math.rad(-35), 0, 0)
		end
		if moving > 0 and math.random() < 0.35 then
			local u = math.random() - 0.5
			Fx.burst("glitter", front + right * (u * W) + Vector3.new(0, h, 0) + dir * 3, c2, 6, 1.4)
		end
	end)
	task.delay(delay, function()
		if hooks.shake and near(from, 120) then
			hooks.shake(1.2)
		end
		Fx.sound("heavy", 0.9, 0.5, from)
	end)
end

-- 해일이 부서진다: 큰 물보라 반구, 고리 셋, 남은 소용돌이가 1초 돈다
function H.tsunamiCrash(data: any)
	local c, c2 = styleColors(data.style)
	local at: Vector3 = data.at
	local r = data.radius or 22
	local ground = at - Vector3.new(0, 2.4, 0)
	local dome = piece(Vector3.new(6, 6, 6), c2, Enum.Material.Glass, Enum.PartType.Ball, 0.2)
	dome.Position = ground
	tween(dome, 0.45, { Size = Vector3.new(r * 2.4, r * 1.3, r * 2.4), Transparency = 1 })
	Debris:AddItem(dome, 0.5)
	for k = 0, 2 do
		task.delay(k * 0.07, function()
			Fx.ring(ground + Vector3.new(0, 0.5 + k, 0), k % 2 == 0 and c or c2, 4, r * (2.4 + k * 0.4), 0.6)
		end)
	end
	-- 소용돌이: 바닥의 둥근 물과 도는 물줄기
	local pool = piece(Vector3.new(0.3, r * 1.6, r * 1.6), c, Enum.Material.Glass, Enum.PartType.Cylinder, 0.3)
	pool.CFrame = CFrame.new(ground + Vector3.new(0, 0.2, 0)) * CFrame.Angles(0, 0, math.rad(90))
	fade(pool, 1.0, 0.4)
	local arms: { BasePart } = {}
	for k = 0, 5 do
		local arm = piece(Vector3.new(0.6, 0.5, r * 0.8), k % 2 == 0 and c2 or c, Enum.Material.Glass, nil, 0.2)
		table.insert(arms, arm)
	end
	local start = os.clock()
	local conn: RBXScriptConnection
	conn = RunService.Heartbeat:Connect(function()
		local t = os.clock() - start
		if t > 1.3 then
			conn:Disconnect()
			for _, a in ipairs(arms) do
				a:Destroy()
			end
			return
		end
		for k, a in ipairs(arms) do
			local ang = k / #arms * math.pi * 2 + t * 5
			local rr = r * 0.45 * (1 - t / 1.6)
			local p = ground + Vector3.new(math.cos(ang) * rr, 0.6, math.sin(ang) * rr)
			a.CFrame = CFrame.lookAt(p, p + Vector3.new(-math.sin(ang), 0, math.cos(ang)))
			a.Transparency = 0.2 + 0.8 * (t / 1.3)
		end
	end)
	Fx.burst("glitter", at, c2, 40, 2.2)
	Fx.flash(at, c, 50, 5, 0.5)
	Fx.sound("heavy", 1, 0.4, at)
	if hooks.shake and near(at, 110) then
		hooks.shake(2.2)
		boom(at, 2.2)
	end
end

-- 역행보: 지나온 길을 따라 시간이 거꾸로 감긴다 (푸른 빛줄기와 되감기는 잔상 셋)
function H.rewind(data: any)
	local c, c2 = styleColors(data.style)
	local from: Vector3, to: Vector3 = data.from, data.to
	local d = (to - from).Magnitude
	if d < 0.5 then
		return
	end
	local line = piece(Vector3.new(1.2, 1.2, d), c, Enum.Material.Neon, nil, 0.2)
	line.CFrame = CFrame.lookAt((from + to) / 2, to)
	tween(line, 0.35, { Size = Vector3.new(0.1, 0.1, d), Transparency = 1 })
	Debris:AddItem(line, 0.4)
	for k = 1, 3 do
		local p = from:Lerp(to, k / 4)
		local ghost = piece(Vector3.new(2, 5, 1), k % 2 == 0 and c2 or c, Enum.Material.ForceField, nil, 0.2)
		ghost.CFrame = CFrame.lookAt(p, p + (to - from))
		tween(ghost, 0.4, { Transparency = 1, Size = Vector3.new(0.5, 5, 0.5) })
		Debris:AddItem(ghost, 0.45)
	end
	for _, at in ipairs({ from, to }) do
		Fx.ring(at - Vector3.new(0, 2.3, 0), c2, 1, 10, 0.35)
	end
	Fx.burst("glitter", to, c2, 14, 1.2)
	Fx.sound("swing", 0.6, 0.6, to)
end

-- 만겁귀환: 하늘에 거대한 시계가 열린다. 열두 눈금, 거꾸로 도는 두 바늘, 종이 울릴 때마다 눈금이 하나씩 켜지고, 자정에 깨진다
function H.clock(data: any)
	local c, c2 = styleColors(data.style)
	local at: Vector3 = data.at
	local delay, bells, every = data.delay or 0.6, data.bells or 12, data.every or 0.17
	local caster = rootOf(data.m)
	local look = caster and flat(caster.CFrame.LookVector) or Vector3.new(0, 0, -1)
	local center = at + Vector3.new(0, 34, 0) - look * 6
	local face = CFrame.lookAt(center, center - look) -- 시전자 쪽을 바라보는 시계판
	local R = 22
	local close = near(at, 160)
	local parts: { BasePart } = {}
	local function keep(p: BasePart): BasePart
		table.insert(parts, p)
		return p
	end
	if close then
		colorGrade(-0.55, 0.3, -0.05, Color3.fromRGB(190, 215, 255), delay + bells * every + 0.3)
	end
	-- 시계판: 둥근 테 (마흔여덟 조각), 안쪽의 옅은 판
	local disc = keep(piece(Vector3.new(0.6, 1, 1), Color3.fromRGB(20, 30, 50), Enum.Material.Glass, Enum.PartType.Cylinder, 0.35))
	disc.CFrame = face * CFrame.Angles(0, math.rad(90), 0)
	tween(disc, 0.4, { Size = Vector3.new(0.6, R * 2, R * 2) }, Enum.EasingStyle.Back)
	for k = 0, 47 do
		local a = k / 48 * math.pi * 2
		local seg = keep(piece(Vector3.new(0.8, R * 2 * math.pi / 48 * 1.05, 0.8), c, Enum.Material.Neon, nil, 1))
		seg.CFrame = face * CFrame.new(math.cos(a) * R, math.sin(a) * R, 0) * CFrame.Angles(0, 0, a)
		task.delay(k * 0.006, function()
			if seg.Parent then
				tween(seg, 0.2, { Transparency = 0.05 })
			end
		end)
	end
	-- 열두 눈금 (종이 울릴 때마다 하나씩 금빛으로 켜진다)
	local marks: { BasePart } = {}
	for k = 0, 11 do
		local a = math.pi / 2 - k / 12 * math.pi * 2
		local m = keep(piece(Vector3.new(1.2, k % 3 == 0 and 4.5 or 3, 0.8), c, Enum.Material.Neon, nil, 0.2))
		m.CFrame = face * CFrame.new(math.cos(a) * (R - 3), math.sin(a) * (R - 3), 0) * CFrame.Angles(0, 0, a - math.pi / 2)
		table.insert(marks, m)
	end
	-- 두 바늘: 거꾸로 빠르게 돈다
	local hourH = keep(piece(Vector3.new(1.6, R * 0.55, 0.8), c2, Enum.Material.Neon, nil, 0))
	local minH = keep(piece(Vector3.new(1, R * 0.85, 0.8), Color3.fromRGB(255, 255, 255), Enum.Material.Neon, nil, 0))
	local hub = keep(piece(Vector3.new(3, 3, 3), c2, Enum.Material.Neon, Enum.PartType.Ball, 0))
	hub.CFrame = face
	local start = os.clock()
	local total = delay + bells * every + 0.25
	local conn: RBXScriptConnection
	conn = RunService.Heartbeat:Connect(function()
		local t = os.clock() - start
		if t > total or not hourH.Parent then
			conn:Disconnect()
			return
		end
		local spin = t < delay and -t * 8 or -(delay * 8) - (t - delay) * 2.2
		hourH.CFrame = face * CFrame.Angles(0, 0, spin * 0.25) * CFrame.new(0, R * 0.27, -0.6)
		minH.CFrame = face * CFrame.Angles(0, 0, spin) * CFrame.new(0, R * 0.42, -0.8)
	end)
	Fx.text(at + Vector3.new(0, 12, 0), "만겁귀환", c2, 54, 1.6)
	-- 종: 눈금이 하나씩 켜지고, 시계판에서 땅으로 빛이 울린다
	for i = 1, bells do
		task.delay(delay + (i - 1) * every, function()
			local m = marks[((i - 1) % 12) + 1]
			if m and m.Parent then
				m.Color = c2
				m.Size = m.Size * 1.3
			end
			Fx.ring(at - Vector3.new(0, 2.2, 0), i % 2 == 0 and c or c2, 4, (data.radius or 55) * 1.6, 0.3)
			Fx.sound("ping", 0.5, 0.8 + i * 0.03, at)
			if hooks.shake and close then
				hooks.shake(0.25)
			end
		end)
	end
	-- 자정: 시계가 깨지며 둘레에 빛이 쏟아진다
	task.delay(total, function()
		fadeAll(parts, 4, 0.06)
		local nova = piece(Vector3.new(6, 6, 6), Color3.fromRGB(235, 245, 255), Enum.Material.Neon, Enum.PartType.Ball, 0)
		nova.Position = center
		tween(nova, 0.45, { Size = Vector3.new(R * 4, R * 4, R * 4), Transparency = 1 })
		Debris:AddItem(nova, 0.5)
		for k = 0, 2 do
			task.delay(k * 0.07, function()
				Fx.ring(at - Vector3.new(0, 2.2 - k, 0), k % 2 == 0 and c or c2, 6, (data.radius or 55) * 2.4, 0.7)
			end)
		end
		Fx.burst("glitter", at, c2, 40, 2.2)
		if hooks.flash and close then
			hooks.flash(Color3.fromRGB(230, 240, 255), 0.6)
		end
		if hooks.shake and close then
			hooks.shake(3)
			boom(at, 3)
		end
		Fx.sound("heavy", 1, 0.3, at)
	end)
end

-- 열화천멸: 시전자에게서 적마다 용암 고랑이 땅을 가르며 뻗고, 적 발밑에서 불기둥이 솟는다. 마지막에 내 자리에서 화산이 터진다
function H.eruption(data: any)
	local c, c2 = styleColors(data.style)
	local at: Vector3 = data.at
	local ground = at - Vector3.new(0, 2.3, 0)
	local delay, stagger, finalAt = data.delay or 0.6, data.stagger or 0.08, data.finalAt or 1.7
	local LAVA = Color3.fromRGB(255, 110, 30)
	local close = near(at, 140)
	if close then
		colorGrade(0.1, 0.25, -0.05, Color3.fromRGB(255, 200, 170), finalAt + 0.3)
	end
	local cracks: { BasePart } = {}
	for i, spot in ipairs(data.spots or {}) do
		local g = Vector3.new(spot.X, ground.Y, spot.Z)
		local d = (g - ground).Magnitude
		if d > 1 then
			local crack = piece(Vector3.new(0.8, 0.25, 0.1), LAVA, Enum.Material.Neon, nil, 0)
			crack.CFrame = CFrame.lookAt(ground + Vector3.new(0, 0.15, 0), g + Vector3.new(0, 0.15, 0))
			tween(crack, delay * 0.8, { Size = Vector3.new(0.8, 0.25, d), CFrame = CFrame.lookAt((ground + g) / 2 + Vector3.new(0, 0.15, 0), g + Vector3.new(0, 0.15, 0)) })
			table.insert(cracks, crack)
		end
		task.delay(delay + (i - 1) * stagger, function()
			local col = piece(Vector3.new(30, 7, 7), LAVA, Enum.Material.Neon, Enum.PartType.Cylinder, 0.1)
			col.CFrame = CFrame.new(g + Vector3.new(0, 15, 0)) * CFrame.Angles(0, 0, math.rad(90))
			tween(col, 0.45, { Size = Vector3.new(34, 0.6, 0.6), Transparency = 1 })
			Debris:AddItem(col, 0.5)
			local core = piece(Vector3.new(30, 3, 3), c2, Enum.Material.Neon, Enum.PartType.Cylinder, 0)
			core.CFrame = col.CFrame
			tween(core, 0.3, { Size = Vector3.new(34, 0.2, 0.2), Transparency = 1 })
			Debris:AddItem(core, 0.35)
			Fx.ring(g + Vector3.new(0, 0.3, 0), c, 2, 16, 0.4)
			Fx.burst("ember", g + Vector3.new(0, 2, 0), c, 16, 1.4)
			Fx.debris(g, 5, 12, Color3.fromRGB(60, 45, 40))
		end)
	end
	-- 화산: 발밑이 붉게 끓다가 크게 터진다
	local pool = piece(Vector3.new(0.3, 2, 2), LAVA, Enum.Material.Neon, Enum.PartType.Cylinder, 0.2)
	pool.CFrame = CFrame.new(ground + Vector3.new(0, 0.2, 0)) * CFrame.Angles(0, 0, math.rad(90))
	tween(pool, finalAt, { Size = Vector3.new(0.3, (data.finalRadius or 18) * 2, (data.finalRadius or 18) * 2) })
	Fx.text(at + Vector3.new(0, 10, 0), "열화천멸", Color3.fromRGB(255, 200, 120), 50, 1.4)
	task.delay(finalAt, function()
		local r = data.finalRadius or 18
		local blast = piece(Vector3.new(60, r * 0.8, r * 0.8), LAVA, Enum.Material.Neon, Enum.PartType.Cylinder, 0)
		blast.CFrame = CFrame.new(ground + Vector3.new(0, 30, 0)) * CFrame.Angles(0, 0, math.rad(90))
		tween(blast, 0.6, { Size = Vector3.new(70, r * 2.2, r * 2.2), Transparency = 1 })
		Debris:AddItem(blast, 0.65)
		local dome = piece(Vector3.new(4, 4, 4), c2, Enum.Material.Neon, Enum.PartType.Ball, 0)
		dome.Position = ground
		tween(dome, 0.4, { Size = Vector3.new(r * 2.6, r * 1.6, r * 2.6), Transparency = 1, Color = LAVA })
		Debris:AddItem(dome, 0.45)
		for k = 0, 2 do
			task.delay(k * 0.07, function()
				Fx.ring(ground + Vector3.new(0, 0.5 + k, 0), k % 2 == 0 and c or c2, 4, r * (2.6 + k * 0.5), 0.6)
			end)
		end
		Fx.burst("ember", at, c, 50, 2.4)
		Fx.burst("smoke", at, Color3.fromRGB(70, 55, 50), 16, 2.2)
		Fx.debris(ground, 12, 26, Color3.fromRGB(60, 45, 40))
		Fx.flash(at, LAVA, 60, 8, 0.8)
		fade(pool, 0.2, 0.5)
		for _, cr in ipairs(cracks) do
			fade(cr, 0, 0.5)
		end
		if hooks.flash and close then
			hooks.flash(Color3.fromRGB(255, 200, 140), 0.5)
		end
		if hooks.shake and close then
			hooks.shake(3)
			boom(at, 3)
		end
		Fx.sound("heavy", 1, 0.35, at)
	end)
end

-- 성하 성하강림: 하늘이 짙푸르게 어두워지고, 머리 위에 세 팔 은하가 돌며 열린다.
-- 별이 나선 순서대로 하나씩 떨어져 땅에 꽂히고, 마지막에 은하의 심장이 내려와 터진다
function H.galaxy(data: any)
	local c, c2 = styleColors(data.style)
	local at: Vector3 = data.at
	local ground = at - Vector3.new(0, 2.4, 0)
	local R = data.radius or 32
	local delay, stagger, finalAt = data.delay or 0.8, data.stagger or 0.09, data.finalAt or 3.3
	local close = near(at, 160)
	if close then
		colorGrade(0.2, 0.3, -0.18, Color3.fromRGB(150, 165, 255), finalAt + 0.2)
	end
	local sky = at + Vector3.new(0, 42, 0)
	local arms: { BasePart } = {}
	local armInfo: { { a: number, r: number } } = {}
	for arm = 0, 2 do
		for k = 1, 16 do
			local t = k / 16
			local size = 2.6 - t * 1.6
			local p = piece(Vector3.new(size, size, size), c:Lerp(c2, t), Enum.Material.Neon, Enum.PartType.Ball, 0.1 + t * 0.4)
			p.Position = sky
			table.insert(arms, p)
			table.insert(armInfo, { a = arm * math.pi * 2 / 3 + t * 2.6, r = 3 + t * R * 0.9 })
		end
	end
	local core = piece(Vector3.new(2, 2, 2), Color3.fromRGB(255, 250, 230), Enum.Material.Neon, Enum.PartType.Ball, 0)
	core.Position = sky
	tween(core, delay, { Size = Vector3.new(9, 9, 9) })
	local halo = piece(Vector3.new(0.3, 2, 2), c2, Enum.Material.Neon, Enum.PartType.Cylinder, 0.5)
	halo.CFrame = CFrame.new(sky) * CFrame.Angles(0, 0, math.rad(90))
	tween(halo, delay, { Size = Vector3.new(0.3, R * 2.2, R * 2.2) })
	Fx.text(at + Vector3.new(0, 12, 0), "성하강림", c2, 56, 1.6)
	Fx.sound("heavy", 1, 0.45, at)
	local t0 = os.clock()
	local conn: RBXScriptConnection
	conn = RunService.RenderStepped:Connect(function()
		local t = os.clock() - t0
		-- 심장이 터지는 순간 멈춘다 (그 뒤로는 조각이 사라진다)
		if t >= finalAt or not halo.Parent then
			conn:Disconnect()
			return
		end
		local open = math.clamp(t / delay, 0, 1)
		for i, p in ipairs(arms) do
			local info = armInfo[i]
			local a = info.a + t * 0.9
			local r = info.r * open
			p.Position = sky + Vector3.new(math.cos(a) * r, math.sin(a * 2 + t) * 1.2, math.sin(a) * r)
		end
		halo.CFrame = CFrame.new(sky) * CFrame.Angles(0, t * 0.6, math.rad(90))
	end)
	-- 별이 하나씩 떨어진다
	for i, p in ipairs(data.points or {}) do
		task.delay(delay + (i - 1) * stagger, function()
			local g = Vector3.new(p.X, ground.Y, p.Z)
			local from = sky + Vector3.new((math.random() - 0.5) * 16, 0, (math.random() - 0.5) * 16)
			local star = piece(Vector3.new(1.6, 1.6, 1.6), c2, Enum.Material.Neon, Enum.PartType.Ball, 0)
			star.Position = from
			tween(star, 0.18, { Position = g + Vector3.new(0, 1, 0) }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
			task.delay(0.18, function()
				star:Destroy()
				Fx.ring(g + Vector3.new(0, 0.3, 0), i % 2 == 0 and c or c2, 1, 14, 0.35)
				Fx.burst("glitter", g + Vector3.new(0, 1, 0), c2, 8, 1)
				if i % 3 == 0 and hooks.shake and close then
					hooks.shake(0.5)
				end
			end)
			local trail = piece(Vector3.new(0.4, 0.4, 0.4), c, Enum.Material.Neon, nil, 0.2)
			local mid = (from + g) / 2
			trail.CFrame = CFrame.lookAt(mid, g)
			tween(trail, 0.18, { Size = Vector3.new(0.6, 0.6, (from - g).Magnitude) })
			fade(trail, 0.18, 0.2)
		end)
	end
	-- 은하의 심장이 내려와 터진다
	task.delay(finalAt - 0.35, function()
		tween(core, 0.35, { Position = ground + Vector3.new(0, 2, 0), Size = Vector3.new(5, 5, 5) }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
	end)
	task.delay(finalAt, function()
		core:Destroy()
		for _, p in ipairs(arms) do
			tween(p, 0.3, { Transparency = 1, Position = p.Position + Vector3.new(0, 10, 0) })
			Debris:AddItem(p, 0.35)
		end
		fade(halo, 0, 0.3)
		local fr = data.finalRadius or 20
		local nova = piece(Vector3.new(4, 4, 4), Color3.fromRGB(255, 250, 230), Enum.Material.Neon, Enum.PartType.Ball, 0)
		nova.Position = ground
		tween(nova, 0.45, { Size = Vector3.new(fr * 2.6, fr * 2.6, fr * 2.6), Transparency = 1, Color = c2 })
		Debris:AddItem(nova, 0.5)
		for k = 0, 2 do
			task.delay(k * 0.07, function()
				Fx.ring(ground + Vector3.new(0, 0.5 + k, 0), k % 2 == 0 and c2 or c, 4, fr * (2.4 + k * 0.5), 0.6)
			end)
		end
		Fx.burst("glitter", at, c2, 60, 2.4)
		Fx.flash(at, c2, 80, 9, 0.8)
		if hooks.flash and close then
			hooks.flash(Color3.fromRGB(255, 250, 230), 0.45)
		end
		if hooks.shake and close then
			hooks.shake(3.2)
			boom(at, 3.2)
		end
		Fx.sound("heavy", 1, 0.3, at)
	end)
end

-- 아공 아공간: 그 자리에 바깥과 끊긴 공간이 열린다 (10초). 검보랏빛 막, 바닥의 빛 격자, 도는 세 고리,
-- 떠다니는 유리 조각. 째깍일 때마다 공간이 베이고, 끝에 막이 오그라들며 터진다
function H.subspace(data: any)
	local c, c2 = styleColors(data.style)
	local at: Vector3 = data.at
	local ground = at - Vector3.new(0, 2.4, 0)
	local R = data.radius or 30
	local dur, every, delay = data.dur or 10, data.every or 0.4, data.delay or 0.6
	local close = near(at, R + 40)
	local parts: { BasePart } = {}
	local function keep(p: BasePart): BasePart
		table.insert(parts, p)
		return p
	end
	-- 막: 바깥 유리 + 안쪽 일렁이는 막
	local shell = keep(piece(Vector3.new(2, 2, 2), Color3.fromRGB(25, 10, 50), Enum.Material.Glass, Enum.PartType.Ball, 0.5))
	shell.Position = ground
	tween(shell, delay, { Size = Vector3.new(R * 2, R * 2, R * 2) }, Enum.EasingStyle.Back)
	local film = keep(piece(Vector3.new(2, 2, 2), c2, Enum.Material.ForceField, Enum.PartType.Ball, 0))
	film.Position = ground
	tween(film, delay, { Size = Vector3.new(R * 1.96, R * 1.96, R * 1.96) }, Enum.EasingStyle.Back)
	-- 바닥: 어두운 원판, 빛 격자 (방사선 여덟과 동심원 셋)
	local floor = keep(piece(Vector3.new(0.3, R * 2, R * 2), Color3.fromRGB(15, 5, 30), Enum.Material.SmoothPlastic, Enum.PartType.Cylinder, 0.15))
	floor.CFrame = CFrame.new(ground + Vector3.new(0, 0.1, 0)) * CFrame.Angles(0, 0, math.rad(90))
	for k = 0, 7 do
		local line = keep(piece(Vector3.new(0.25, 0.1, R * 2), c2, Enum.Material.Neon, nil, 0.2))
		line.CFrame = CFrame.new(ground + Vector3.new(0, 0.25, 0)) * CFrame.Angles(0, k * math.pi / 8, 0)
	end
	for k = 1, 3 do
		local ring = keep(piece(Vector3.new(0.2, R * 2 * k / 3.2, R * 2 * k / 3.2), c, Enum.Material.Neon, Enum.PartType.Cylinder, 0.55))
		ring.CFrame = CFrame.new(ground + Vector3.new(0, 0.2 + k * 0.02, 0)) * CFrame.Angles(0, 0, math.rad(90))
	end
	-- 도는 세 고리 (서로 다른 축)
	local rings: { { BasePart } } = {}
	for r = 1, 3 do
		local list = {}
		for k = 1, 18 do
			table.insert(list, keep(piece(Vector3.new(0.6, 0.6, 2.4), r == 2 and c2 or c, Enum.Material.Neon, nil, 0.1)))
		end
		table.insert(rings, list)
	end
	-- 떠다니는 유리 조각
	local cubes: { { p: BasePart, a: number, r: number, h: number, s: number } } = {}
	for k = 1, 16 do
		local size = 0.8 + math.random() * 2.2
		local p = keep(piece(Vector3.new(size, size, size), k % 2 == 0 and c or c2, Enum.Material.Glass, nil, 0.25))
		table.insert(cubes, { p = p, a = math.random() * math.pi * 2, r = R * (0.3 + math.random() * 0.6), h = 2 + math.random() * R * 0.6, s = (math.random() < 0.5 and -1 or 1) * (0.3 + math.random() * 0.5) })
	end
	if close then
		colorGrade(-0.55, 0.25, -0.05, Color3.fromRGB(205, 195, 255), dur)
		if hooks.flash then
			hooks.flash(c2, 0.3)
		end
	end
	Fx.text(at + Vector3.new(0, 12, 0), "아공간", c2, 56, 1.6)
	Fx.sound("heavy", 1, 0.4, at)
	local t0 = os.clock()
	local conn: RBXScriptConnection
	conn = RunService.RenderStepped:Connect(function()
		local t = os.clock() - t0
		local center = ground + Vector3.new(0, R * 0.45, 0)
		for r, list in ipairs(rings) do
			local axis = r == 1 and CFrame.Angles(t * 0.8, 0, 0) or (r == 2 and CFrame.Angles(0, 0, t * 0.6 + 1) or CFrame.Angles(t * 0.5, t * 0.7, 0))
			local rr = R * (0.55 + r * 0.12)
			for k, p in ipairs(list) do
				local a = k / #list * math.pi * 2 + t * (r % 2 == 0 and -0.9 or 0.9)
				local pos = (CFrame.new(center) * axis * CFrame.new(math.cos(a) * rr, 0, math.sin(a) * rr))
				p.CFrame = CFrame.lookAt(pos.Position, (CFrame.new(center) * axis * CFrame.new(math.cos(a + 0.1) * rr, 0, math.sin(a + 0.1) * rr)).Position)
			end
		end
		for _, cb in ipairs(cubes) do
			local a = cb.a + t * cb.s
			cb.p.CFrame = CFrame.new(ground + Vector3.new(math.cos(a) * cb.r, cb.h + math.sin(t * 1.3 + cb.a) * 1.5, math.sin(a) * cb.r)) * CFrame.Angles(t * cb.s, t, 0)
		end
		if t > dur then
			conn:Disconnect()
		end
	end)
	-- 째깍일 때마다: 공간을 가르는 빛줄기 (가끔 거울 조각이 깨진다)
	local n = math.floor((dur - delay) / every)
	for i = 0, n - 1 do
		task.delay(delay + i * every, function()
			local a = math.random() * math.pi * 2
			local d = Vector3.new(math.cos(a), (math.random() - 0.5) * 0.6, math.sin(a)).Unit
			local mid = ground + Vector3.new((math.random() - 0.5) * R * 0.8, 2 + math.random() * R * 0.4, (math.random() - 0.5) * R * 0.8)
			local slash = piece(Vector3.new(0.35, 0.35, 0.35), i % 3 == 0 and c or c2, Enum.Material.Neon, nil, 0)
			slash.CFrame = CFrame.lookAt(mid, mid + d)
			tween(slash, 0.08, { Size = Vector3.new(0.5, 0.12, R * 1.6) })
			fade(slash, 0.08, 0.18)
			Fx.burst("spark", mid, c2, 6, 1)
			if i % 4 == 0 then
				for _ = 1, 5 do
					local sh = piece(Vector3.new(0.6, 1.4, 0.1), c2, Enum.Material.Glass, nil, 0.2)
					sh.CFrame = CFrame.new(mid) * CFrame.Angles(math.random() * 6, math.random() * 6, 0)
					tween(sh, 0.35, { CFrame = sh.CFrame * CFrame.new(0, 0, -4 - math.random() * 4), Transparency = 1 })
					Debris:AddItem(sh, 0.4)
				end
				if hooks.shake and close then
					hooks.shake(0.6)
				end
			end
		end)
	end
	-- 닫힘: 막이 한 점으로 오그라들었다가 터진다
	task.delay(dur, function()
		tween(shell, 0.3, { Size = Vector3.new(1, 1, 1) }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
		tween(film, 0.3, { Size = Vector3.new(1, 1, 1) }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
		task.delay(0.3, function()
			for _, p in ipairs(parts) do
				if p.Parent then
					tween(p, 0.2, { Transparency = 1 })
					Debris:AddItem(p, 0.25)
				end
			end
			for k = 0, 2 do
				task.delay(k * 0.07, function()
					Fx.ring(ground + Vector3.new(0, 0.5 + k, 0), k % 2 == 0 and c or c2, 4, R * (2.2 + k * 0.4), 0.55)
				end)
			end
			Fx.burst("spark", at, c2, 50, 2.2)
			Fx.flash(at, c2, 70, 8, 0.7)
			if hooks.flash and close then
				hooks.flash(Color3.fromRGB(230, 255, 250), 0.4)
			end
			if hooks.shake and close then
				hooks.shake(3)
				boom(at, 3)
			end
			Fx.sound("heavy", 1, 0.3, at)
		end)
	end)
end

-- 무쌍 천하무쌍: 빛의 울타리가 솟아 둘레를 가두고, 한가운데에서 여덟 번 몰아친 뒤 하늘로 쳐올린다
function H.arena(data: any)
	local c, c2 = styleColors(data.style)
	local at: Vector3 = data.at
	local ground = at - Vector3.new(0, 2.3, 0)
	local r = data.radius or 26
	local delay, every, strikes, finalAt = data.delay or 0.5, data.every or 0.15, data.strikes or 8, data.finalAt or 1.9
	local close = near(at, 140)
	if close then
		colorGrade(-0.4, 0.3, -0.05, Color3.fromRGB(255, 225, 225), finalAt + 0.2)
	end
	-- 울타리: 둘레에 솟는 빛의 판과 바닥의 붉은 테
	local fence: { BasePart } = {}
	local n = 28
	for k = 0, n - 1 do
		local a = k / n * math.pi * 2
		local p = ground + Vector3.new(math.cos(a) * r, 0, math.sin(a) * r)
		local panel = piece(Vector3.new(2 * math.pi * r / n, 0.2, 0.3), k % 2 == 0 and c or c2, Enum.Material.Neon, nil, 0.45)
		panel.CFrame = CFrame.lookAt(p, Vector3.new(ground.X, p.Y, ground.Z)) * CFrame.Angles(0, math.rad(90), 0)
		task.delay(k * 0.008, function()
			if panel.Parent then
				tween(panel, 0.25, { Size = Vector3.new(2 * math.pi * r / n, 14, 0.3), CFrame = panel.CFrame * CFrame.new(0, 7, 0) })
			end
		end)
		table.insert(fence, panel)
	end
	local rim = piece(Vector3.new(0.3, r * 2, r * 2), c, Enum.Material.Neon, Enum.PartType.Cylinder, 0.5)
	rim.CFrame = CFrame.new(ground + Vector3.new(0, 0.1, 0)) * CFrame.Angles(0, 0, math.rad(90))
	table.insert(fence, rim)
	Fx.text(at + Vector3.new(0, 10, 0), "천하무쌍", c2, 50, 1.4)
	-- 몰아치기: 한가운데에서 엇갈리는 베기
	for i = 0, strikes - 1 do
		task.delay(delay + i * every, function()
			local a = math.random() * math.pi * 2
			local d = Vector3.new(math.cos(a), 0, math.sin(a))
			local mid = ground + Vector3.new(0, 3 + math.random() * 3, 0)
			local slash = piece(Vector3.new(0.4, 0.4, 0.4), i % 2 == 0 and c2 or c, Enum.Material.Neon, nil, 0)
			slash.CFrame = CFrame.lookAt(mid - d * 12, mid + d * 12) * CFrame.Angles(0, 0, math.random() * math.pi)
			slash.Position = mid
			tween(slash, 0.1, { Size = Vector3.new(0.5, 0.15, 28) })
			fade(slash, 0.1, 0.15)
			Fx.ring(mid, c, 2, 14, 0.2, d)
			Fx.burst("spark", mid, c2, 8, 1.2)
			if hooks.shake and close and i % 2 == 0 then
				hooks.shake(0.8)
			end
			Fx.sound("hit", 0.6, 1.1 + math.random() * 0.2, mid)
		end)
	end
	-- 마지막 한 주먹: 하늘로 솟는 붉은 기둥, 울타리가 산산이 흩어진다
	task.delay(finalAt, function()
		local col = piece(Vector3.new(90, 10, 10), c, Enum.Material.Neon, Enum.PartType.Cylinder, 0.05)
		col.CFrame = CFrame.new(ground + Vector3.new(0, 45, 0)) * CFrame.Angles(0, 0, math.rad(90))
		tween(col, 0.5, { Size = Vector3.new(100, 0.5, 0.5), Transparency = 1 })
		Debris:AddItem(col, 0.55)
		local core = piece(Vector3.new(90, 4, 4), c2, Enum.Material.Neon, Enum.PartType.Cylinder, 0)
		core.CFrame = col.CFrame
		tween(core, 0.35, { Size = Vector3.new(100, 0.2, 0.2), Transparency = 1 })
		Debris:AddItem(core, 0.4)
		for k = 0, 2 do
			task.delay(k * 0.06, function()
				Fx.ring(ground + Vector3.new(0, 0.5 + k, 0), k % 2 == 0 and c or c2, 4, r * (2 + k * 0.4), 0.5)
			end)
		end
		for _, panel in ipairs(fence) do
			tween(panel, 0.35, { Transparency = 1, CFrame = panel.CFrame * CFrame.new(0, 6, 0) })
			Debris:AddItem(panel, 0.4)
		end
		Fx.burst("spark", at, c2, 40, 2)
		Fx.flash(at, c, 60, 8, 0.6)
		if hooks.flash and close then
			hooks.flash(Color3.fromRGB(255, 235, 235), 0.35)
		end
		if hooks.shake and close then
			hooks.shake(2.6)
			boom(at, 2.6)
		end
		Fx.sound("heavy", 1, 0.5, at)
	end)
	Debris:AddItem(rim, finalAt + 0.5)
end

-- 파천 중압 / 태초 창세 / 일월: 정해진 수만큼 맞히면 상대 자리에서 터진다
local pulseFlip = false
function H.pulse(data: any)
	local c, c2 = styleColors(data.style)
	local at: Vector3 = data.at
	local r = data.radius or 12
	local delay = data.delay or 0.3
	if data.fx == "time" then
		-- 영겁 정지: 상대 둘레가 푸른 유리 구슬에 갇혀 시간이 멎었다가 깨진다
		local bubble = piece(Vector3.new(1, 1, 1), c, Enum.Material.Glass, Enum.PartType.Ball, 0.55)
		bubble.Position = at
		tween(bubble, delay, { Size = Vector3.new(r * 1.6, r * 1.6, r * 1.6) }, Enum.EasingStyle.Back)
		for k = 0, 11 do
			local a = k / 12 * math.pi * 2
			local tick = piece(Vector3.new(0.3, 1.4, 0.3), k % 3 == 0 and c2 or c, Enum.Material.Neon, nil, 0.1)
			tick.CFrame = CFrame.new(at - Vector3.new(0, 2.2, 0) + Vector3.new(math.cos(a) * r * 0.75, 0.7, math.sin(a) * r * 0.75))
			fade(tick, 1.3, 0.3)
		end
		task.delay(1.4, function()
			if bubble.Parent then
				tween(bubble, 0.2, { Size = bubble.Size * 1.3, Transparency = 1 })
				Debris:AddItem(bubble, 0.25)
			end
			Fx.burst("glitter", at, c2, 14, 1.4)
		end)
		Fx.text(at + Vector3.new(0, 5, 0), "◷", c2, 34, 0.8)
	elseif data.fx == "tide" then
		-- 창해 파도: 상대 자리에서 물기둥이 솟아 부서지며 둘레를 쓸어 낸다
		local g = at - Vector3.new(0, 2.4, 0)
		local col = piece(Vector3.new(2, r * 0.9, r * 0.9), c, Enum.Material.Glass, Enum.PartType.Cylinder, 0.2)
		col.CFrame = CFrame.new(g) * CFrame.Angles(0, 0, math.rad(90))
		tween(col, delay, { Size = Vector3.new(18, r * 0.9, r * 0.9), CFrame = CFrame.new(g + Vector3.new(0, 9, 0)) * CFrame.Angles(0, 0, math.rad(90)) }, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
		task.delay(delay, function()
			tween(col, 0.3, { Size = Vector3.new(4, r * 2.2, r * 2.2), CFrame = CFrame.new(g + Vector3.new(0, 1, 0)) * CFrame.Angles(0, 0, math.rad(90)), Transparency = 1 })
			Debris:AddItem(col, 0.35)
			Fx.ring(g + Vector3.new(0, 0.4, 0), c2, 2, r * 2.4, 0.4)
			Fx.burst("glitter", at, c2, 16, 1.4)
		end)
	elseif data.fx == "eclipse" then
		-- 일월: 해와 달이 번갈아 (해는 떨어져 터지고, 달은 가로질러 벤다)
		pulseFlip = not pulseFlip
		if pulseFlip then
			local sun = piece(Vector3.new(3, 3, 3), c, Enum.Material.Neon, Enum.PartType.Ball, 0)
			sun.Position = at + Vector3.new(0, 26, 0)
			tween(sun, delay, { Position = at }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
			Debris:AddItem(sun, delay + 0.05)
			task.delay(delay, function()
				local nova = piece(Vector3.new(2, 2, 2), Color3.fromRGB(255, 235, 170), Enum.Material.Neon, Enum.PartType.Ball, 0)
				nova.Position = at
				tween(nova, 0.3, { Size = Vector3.new(r * 1.6, r * 1.6, r * 1.6), Transparency = 1 })
				Debris:AddItem(nova, 0.35)
				Fx.ring(at - Vector3.new(0, 2.3, 0), c, 2, r * 2.2, 0.4)
				Fx.burst("ember", at, c, 14, 1.2)
				Fx.flash(at, c, 26, 4, 0.35)
			end)
			Fx.text(at + Vector3.new(0, 5, 0), "☀", c, 34, 0.8)
		else
			local dir = Vector3.new(math.cos(math.random() * 6.28), 0, math.sin(math.random() * 6.28))
			local cf = CFrame.lookAt(at, at + dir)
			for k = 0, 8 do
				local a = math.rad(-75 + k * 18.75)
				local w = 1 - math.abs(k - 4) / 4
				local seg = piece(Vector3.new(r * 0.24, 0.25, 0.3 + w * 1.1), c2, Enum.Material.Neon, nil, 0.05)
				local lp = Vector3.new(math.sin(a) * r * 0.8, 0, -math.cos(a) * r * 0.8)
				seg.CFrame = cf * CFrame.new(0, 0, r * 0.9) * CFrame.new(lp) * CFrame.Angles(0, -a, 0)
				task.delay(delay * 0.5, function()
					tween(seg, delay * 0.6, { CFrame = cf * CFrame.new(0, 0, -r * 0.9) * CFrame.new(lp) * CFrame.Angles(0, -a, 0), Transparency = 1 })
				end)
				Debris:AddItem(seg, delay * 1.2 + 0.05)
			end
			task.delay(delay, function()
				Fx.ring(at - Vector3.new(0, 2.3, 0), c2, 2, r * 2, 0.35)
				Fx.burst("glitter", at, c2, 14, 1.2)
			end)
			Fx.text(at + Vector3.new(0, 5, 0), "☾", c2, 34, 0.8)
		end
	elseif data.fx == "gravity" then
		-- 중력 우물: 검은 구가 맺히며 둘레의 고리가 안으로 조여든다
		local well = piece(Vector3.new(0.5, 0.5, 0.5), Color3.new(0, 0, 0), Enum.Material.SmoothPlastic, Enum.PartType.Ball, 0)
		well.Position = at
		tween(well, delay, { Size = Vector3.new(4, 4, 4) }, Enum.EasingStyle.Back)
		for k = 0, 2 do
			task.delay(k * delay / 3, function()
				Fx.ring(at - Vector3.new(0, 2, 0), k % 2 == 0 and c or c2, r * 2, 1, delay)
			end)
		end
		task.delay(delay, function()
			tween(well, 0.15, { Size = Vector3.new(0.1, 0.1, 0.1) })
			Debris:AddItem(well, 0.2)
			Fx.ring(at - Vector3.new(0, 2.3, 0), c, 2, r * 2.4, 0.4)
			Fx.spark(at, c, 2, 12)
			local crater = piece(Vector3.new(0.2, r * 1.6, r * 1.6), Color3.fromRGB(20, 10, 30), Enum.Material.SmoothPlastic, Enum.PartType.Cylinder, 0.3)
			crater.CFrame = CFrame.new(at - Vector3.new(0, 2.35, 0)) * CFrame.Angles(0, 0, math.rad(90))
			fade(crater, 0.6, 0.4)
			if hooks.shake and near(at, 50) then
				hooks.shake(0.7)
				boom(at, 0.7)
			end
		end)
		Fx.text(at + Vector3.new(0, 5, 0), "중압", c2, 30, 0.8)
	else
		-- 창세 결정: 바닥에서 빛의 결정이 꽃처럼 피어 터진다
		local shards = {}
		for k = 0, 6 do
			local a = k / 7 * math.pi * 2
			local d = k == 0 and Vector3.zero or Vector3.new(math.cos(a), 0, math.sin(a))
			local base = at - Vector3.new(0, 2.4, 0) + d * 2.5
			local h = k == 0 and 9 or 6
			local s = piece(Vector3.new(1.4, 0.3, 1.4), k % 2 == 0 and c2 or Color3.fromRGB(255, 252, 240), Enum.Material.Glass, nil, 0.1)
			s.CFrame = CFrame.new(base) * CFrame.Angles(d.Z * 0.5, a, -d.X * 0.5) * CFrame.Angles(0, math.rad(45), 0)
			tween(s, delay * 0.7, { Size = Vector3.new(1.4, h, 1.4), CFrame = s.CFrame * CFrame.new(0, h / 2, 0) })
			table.insert(shards, s)
		end
		task.delay(delay, function()
			for _, s in ipairs(shards) do
				tween(s, 0.25, { Size = s.Size * 1.6, Transparency = 1 })
				Debris:AddItem(s, 0.3)
			end
			Fx.spark(at, c2, 2.4, 18)
			Fx.ring(at - Vector3.new(0, 2.3, 0), c2, 2, r * 2.2, 0.35)
		end)
	end
end

-- 파천·태초 기술의 다른 빛깔: 중력의 우물·낙하, 빛의 결정 기둥
function Ults.variant(data: any): boolean
	local c, c2 = styleColors(data.style)
	if data.fx == "gravity" and data.kind == "zone" then
		local at: Vector3 = data.at
		local r = data.radius or 12
		local dur = data.dur or 1.2
		local ground = at - Vector3.new(0, 2.4, 0)
		local pit = piece(Vector3.new(0.2, 2, 2), Color3.fromRGB(15, 5, 25), Enum.Material.SmoothPlastic, Enum.PartType.Cylinder, 0.2)
		pit.CFrame = CFrame.new(ground + Vector3.new(0, 0.12, 0)) * CFrame.Angles(0, 0, math.rad(90))
		tween(pit, 0.25, { Size = Vector3.new(0.2, r * 2, r * 2) })
		local core = piece(Vector3.new(0.5, 0.5, 0.5), Color3.new(0, 0, 0), Enum.Material.SmoothPlastic, Enum.PartType.Ball, 0)
		core.Position = ground + Vector3.new(0, 3, 0)
		tween(core, 0.3, { Size = Vector3.new(3.5, 3.5, 3.5) })
		local start = os.clock()
		local conn: RBXScriptConnection
		conn = RunService.RenderStepped:Connect(function()
			local t = os.clock() - start
			if t > dur then
				conn:Disconnect()
				return
			end
			if math.random() < 0.5 then
				local a = math.random() * math.pi * 2
				local from = ground + Vector3.new(math.cos(a) * r, 0.4, math.sin(a) * r)
				local streak = piece(Vector3.new(0.3, 0.3, 2), math.random() < 0.5 and c or c2, Enum.Material.Neon, nil, 0.1)
				streak.CFrame = CFrame.lookAt(from, core.Position)
				tween(streak, 0.35, { CFrame = CFrame.lookAt(core.Position, core.Position + (core.Position - from)), Transparency = 1 }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
				Debris:AddItem(streak, 0.4)
			end
		end)
		for k = 0, math.floor(dur / 0.3) do
			task.delay(k * 0.3, function()
				Fx.ring(ground + Vector3.new(0, 0.4, 0), k % 2 == 0 and c or c2, r * 2, 2, 0.3)
			end)
		end
		fade(pit, dur, 0.3)
		fade(core, dur, 0.2)
		return true
	elseif data.fx == "gravity" and data.kind == "drop" then
		local at: Vector3 = data.at
		local r = data.radius or 13
		local ground = at - Vector3.new(0, 2.4, 0)
		local crater = piece(Vector3.new(0.2, r * 2, r * 2), Color3.fromRGB(20, 10, 30), Enum.Material.SmoothPlastic, Enum.PartType.Cylinder, 0.15)
		crater.CFrame = CFrame.new(ground + Vector3.new(0, 0.12, 0)) * CFrame.Angles(0, 0, math.rad(90))
		fade(crater, 1.2, 0.5)
		for k = 0, 11 do
			local a = k / 12 * math.pi * 2
			local d = Vector3.new(math.cos(a), 0, math.sin(a))
			local slab = piece(Vector3.new(r * 0.4, 1, 3), Color3.fromRGB(90, 80, 95), Enum.Material.Slate, nil, 0)
			slab.CFrame = CFrame.lookAt(ground + d * r * 0.85, ground + d * r * 2) * CFrame.Angles(math.rad(35), 0, 0)
			fade(slab, 1.0, 0.4)
		end
		Fx.ring(ground + Vector3.new(0, 0.5, 0), c, 2, r * 2.6, 0.45)
		Fx.ring(ground + Vector3.new(0, 1, 0), c2, 2, r * 2, 0.35)
		Fx.spark(at, c, 2.4, 16)
		Fx.sound("heavy", 1, 0.45, at)
		if hooks.shake and near(at, 70) then
			hooks.shake(1.6)
			boom(at, 1.6)
		end
		return true
	elseif data.fx == "time" and data.kind == "zone" then
		-- 정지된 시간: 바닥에 시계판, 도는 바늘, 째깍일 때마다 눈금이 번쩍
		local at: Vector3 = data.at
		local r = data.radius or 13
		local dur = data.dur or 2
		local g = at - Vector3.new(0, 2.3, 0)
		local plate = piece(Vector3.new(0.2, r * 2, r * 2), Color3.fromRGB(20, 30, 50), Enum.Material.Glass, Enum.PartType.Cylinder, 0.3)
		plate.CFrame = CFrame.new(g + Vector3.new(0, 0.12, 0)) * CFrame.Angles(0, 0, math.rad(90))
		fade(plate, dur, 0.3)
		local ticks: { BasePart } = {}
		for k = 0, 11 do
			local a = k / 12 * math.pi * 2
			local tk = piece(Vector3.new(0.5, 0.3, k % 3 == 0 and 3 or 1.8), k % 3 == 0 and c2 or c, Enum.Material.Neon, nil, 0.1)
			local p = g + Vector3.new(math.cos(a) * r * 0.85, 0.3, math.sin(a) * r * 0.85)
			tk.CFrame = CFrame.lookAt(p, g + Vector3.new(0, 0.3, 0))
			fade(tk, dur, 0.3)
			table.insert(ticks, tk)
		end
		local handP = piece(Vector3.new(0.6, 0.3, r * 0.8), c2, Enum.Material.Neon, nil, 0)
		local dome = piece(Vector3.new(r * 2, r * 1.2, r * 2), c, Enum.Material.ForceField, Enum.PartType.Ball, 0.4)
		dome.Position = g
		fade(dome, dur, 0.3)
		local start = os.clock()
		local conn: RBXScriptConnection
		conn = RunService.Heartbeat:Connect(function()
			local t = os.clock() - start
			if t > dur then
				conn:Disconnect()
				tween(handP, 0.2, { Transparency = 1 })
				Debris:AddItem(handP, 0.25)
				return
			end
			local a = t * 3
			local tip = Vector3.new(math.cos(a), 0, math.sin(a))
			handP.CFrame = CFrame.lookAt(g + Vector3.new(0, 0.5, 0) + tip * r * 0.4, g + Vector3.new(0, 0.5, 0) + tip * r)
		end)
		return true
	elseif data.fx == "tide" and data.kind == "pillar" then
		-- 해일벽: 물의 벽이 솟았다가 앞으로 무너진다
		local at: Vector3 = data.at
		local r = data.radius or 6
		local dir: Vector3 = data.dir or Vector3.new(0, 0, -1)
		local g = at - Vector3.new(0, 2.4, 0)
		local cf = CFrame.lookAt(g, g + dir)
		local wall = piece(Vector3.new(r * 2.4, 1, 3), c:Lerp(Color3.fromRGB(10, 40, 90), 0.2), Enum.Material.Glass, nil, 0.2)
		wall.CFrame = cf * CFrame.new(0, 0.5, 0)
		tween(wall, 0.15, { Size = Vector3.new(r * 2.4, 14, 3), CFrame = cf * CFrame.new(0, 7, 0) })
		local foam = piece(Vector3.new(r * 2.6, 1.4, 3.4), c2, Enum.Material.SmoothPlastic, nil, 0.1)
		foam.CFrame = cf * CFrame.new(0, 1, 0)
		tween(foam, 0.15, { CFrame = cf * CFrame.new(0, 14.5, 0) })
		task.delay(0.18, function()
			tween(wall, 0.3, { CFrame = cf * CFrame.new(0, 3, -6) * CFrame.Angles(math.rad(-70), 0, 0), Transparency = 1 })
			tween(foam, 0.3, { CFrame = cf * CFrame.new(0, 2, -12), Transparency = 1 })
			Fx.burst("glitter", at, c2, 10, 1.2)
		end)
		Debris:AddItem(wall, 0.55)
		Debris:AddItem(foam, 0.55)
		Fx.ring(g + Vector3.new(0, 0.4, 0), c2, 1, r * 2.2, 0.35)
		return true
	elseif data.fx == "sun" and data.kind == "strike" then
		-- 대일강림: 작은 해가 하늘에서 떨어져 불기둥이 되어 터진다
		local at: Vector3 = data.at
		local r = data.radius or 8
		local ground = at - Vector3.new(0, 2.4, 0)
		local sun = piece(Vector3.new(5, 5, 5), c, Enum.Material.Neon, Enum.PartType.Ball, 0)
		sun.Position = ground + Vector3.new(0, 60, 0)
		local halo = piece(Vector3.new(8, 8, 8), Color3.fromRGB(255, 220, 140), Enum.Material.ForceField, Enum.PartType.Ball, 0.2)
		halo.Position = sun.Position
		tween(sun, 0.18, { Position = ground + Vector3.new(0, 2, 0) }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
		tween(halo, 0.18, { Position = ground + Vector3.new(0, 2, 0) }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
		Debris:AddItem(sun, 0.2)
		Debris:AddItem(halo, 0.2)
		task.delay(0.18, function()
			local pillar = piece(Vector3.new(40, r * 1.3, r * 1.3), Color3.fromRGB(255, 160, 50), Enum.Material.Neon, Enum.PartType.Cylinder, 0.1)
			pillar.CFrame = CFrame.new(ground + Vector3.new(0, 20, 0)) * CFrame.Angles(0, 0, math.rad(90))
			tween(pillar, 0.5, { Size = Vector3.new(46, 0.5, 0.5), Transparency = 1 })
			Debris:AddItem(pillar, 0.55)
			local core = piece(Vector3.new(40, r * 0.5, r * 0.5), Color3.fromRGB(255, 245, 210), Enum.Material.Neon, Enum.PartType.Cylinder, 0)
			core.CFrame = pillar.CFrame
			tween(core, 0.35, { Size = Vector3.new(46, 0.2, 0.2), Transparency = 1 })
			Debris:AddItem(core, 0.4)
			local scorch = piece(Vector3.new(0.2, r * 2, r * 2), Color3.fromRGB(60, 25, 10), Enum.Material.SmoothPlastic, Enum.PartType.Cylinder, 0.2)
			scorch.CFrame = CFrame.new(ground + Vector3.new(0, 0.1, 0)) * CFrame.Angles(0, 0, math.rad(90))
			fade(scorch, 0.9, 0.5)
			Fx.ring(ground + Vector3.new(0, 0.5, 0), c, 2, r * 2.6, 0.45)
			Fx.burst("ember", at, c, 20, 1.4)
			Fx.burst("smoke", at, Color3.fromRGB(110, 80, 60), 6, 1.2)
			Fx.flash(at, c, 34, 5, 0.4)
			Fx.sound("heavy", 0.7, 0.9, at)
			if hooks.shake and near(at, 60) then
				hooks.shake(0.7)
				boom(at, 0.7)
			end
		end)
		return true
	elseif data.fx == "prism" and data.kind == "strike" then
		-- 창세주: 빛의 결정 기둥이 솟는다
		local at: Vector3 = data.at
		local r = data.radius or 7
		local ground = at - Vector3.new(0, 2.4, 0)
		for k = 0, 4 do
			local a = k / 5 * math.pi * 2
			local d = k == 0 and Vector3.zero or Vector3.new(math.cos(a), 0, math.sin(a))
			local h = k == 0 and 16 or 9
			local col = piece(Vector3.new(2.2, 0.3, 2.2), k == 0 and Color3.fromRGB(255, 252, 240) or c2, Enum.Material.Glass, nil, 0.05)
			col.CFrame = CFrame.new(ground + d * r * 0.45) * CFrame.Angles(d.Z * 0.35, 0, -d.X * 0.35) * CFrame.Angles(0, math.rad(45), 0)
			tween(col, 0.12, { Size = Vector3.new(2.2, h, 2.2), CFrame = col.CFrame * CFrame.new(0, h / 2, 0) })
			fade(col, 0.45, 0.35)
		end
		local beam = piece(Vector3.new(60, 1.5, 1.5), Color3.fromRGB(255, 250, 235), Enum.Material.Neon, Enum.PartType.Cylinder, 0.2)
		beam.CFrame = CFrame.new(ground + Vector3.new(0, 30, 0)) * CFrame.Angles(0, 0, math.rad(90))
		tween(beam, 0.4, { Size = Vector3.new(60, 0.1, 0.1), Transparency = 1 })
		Debris:AddItem(beam, 0.45)
		Fx.ring(ground + Vector3.new(0, 0.4, 0), c2, 1, r * 2.2, 0.35)
		Fx.spark(at, c, 2, 10)
		return true
	end
	return false
end

-- 풍신 회오리
function H.tornado(data: any)
	local c, c2 = styleColors(data.style)
	local from, dir, speed, dur, r = data.from, data.dir, data.speed, data.dur, data.radius or 13
	local rings = {}
	for i = 1, 12 do
		local sz = r * (0.35 + i * 0.14)
		local ring = piece(Vector3.new(1.2, sz * 2, sz * 2), i % 2 == 0 and c or c2, Enum.Material.Neon, Enum.PartType.Cylinder, 0.55)
		table.insert(rings, ring)
	end
	local debris = {}
	for i = 1, 16 do
		local d = piece(Vector3.new(1.5, 1.5, 1.5), Color3.fromRGB(130, 120, 100), Enum.Material.Slate, nil, 0)
		table.insert(debris, d)
		local _ = i
	end
	local start = os.clock()
	local conn: RBXScriptConnection
	conn = RunService.RenderStepped:Connect(function()
		local t = os.clock() - start
		local base = from - Vector3.new(0, 2.4, 0) + dir * (speed * math.min(t, dur))
		for i, ring in ipairs(rings) do
			local y = i * 4.5
			local sway = Vector3.new(math.sin(t * 3 + i * 0.5), 0, math.cos(t * 2.5 + i * 0.5)) * (i * 0.4)
			ring.CFrame = CFrame.new(base + Vector3.new(0, y, 0) + sway) * CFrame.Angles(0, t * 8 + i, math.rad(90))
		end
		for i, d in ipairs(debris) do
			local a = t * 6 + i * 0.8
			local h = (i * 3.7 + t * 12) % 50
			local rr = r * (0.4 + h / 50)
			d.CFrame = CFrame.new(base + Vector3.new(math.cos(a) * rr, h, math.sin(a) * rr)) * CFrame.Angles(a, a, 0)
		end
		if t > dur then
			conn:Disconnect()
			for _, p in ipairs(rings) do
				tween(p, 0.4, { Transparency = 1, Size = p.Size * 1.6 })
				Debris:AddItem(p, 0.45)
			end
			for _, p in ipairs(debris) do
				tween(p, 0.4, { Transparency = 1 })
				Debris:AddItem(p, 0.45)
			end
		end
	end)
	Fx.text(from + Vector3.new(0, 8, 0), "풍신강림", c, 44, 1.2)
	if hooks.shake and near(from, 80) then
		hooks.shake(0.8)
		boom(from, 0.8)
	end
end

-- 빛의 창 (천제의 창) / 하늘의 검 (천검강림·천위)
function Ults.spear(at: Vector3, dir: Vector3, styleId: any)
	local c, c2 = styleColors(styleId)
	local p = at + Vector3.new(0, 1.5, 0)
	local spear = piece(Vector3.new(0.6, 0.6, 11), Color3.fromRGB(255, 250, 230), Enum.Material.Neon, nil, 0)
	local tip = piece(Vector3.new(1.4, 1.4, 2.6), c, Enum.Material.Neon, nil, 0)
	local d = flat(dir)
	spear.CFrame = CFrame.lookAt(p - d * 12, p)
	tip.CFrame = spear.CFrame * CFrame.new(0, 0, -6)
	tween(spear, 0.1, { CFrame = CFrame.lookAt(p, p + d) })
	tween(tip, 0.1, { CFrame = CFrame.lookAt(p, p + d) * CFrame.new(0, 0, -6) })
	fade(spear, 0.25, 0.25)
	fade(tip, 0.25, 0.25)
	Fx.ring(p, c2, 1, 7, 0.3, d)
end

function Ults.handles(kind: string): boolean
	return H[kind] ~= nil
end
function Ults.run(data: any)
	local f = H[data.kind]
	if f then
		f(data)
	end
end
-- 오의를 쓰는 순간: 몸에서 빛기둥이 솟고, 빛이 모인다 (진짜 연출은 서버가 알려 준다)
function Ults.intro(styleId: any, model: Model)
	local r = rootOf(model)
	if not r then
		return
	end
	local c, c2 = styleColors(styleId)
	local col = piece(Vector3.new(60, 3, 3), c2, Enum.Material.Neon, Enum.PartType.Cylinder, 0.3)
	col.CFrame = CFrame.new(r.Position + Vector3.new(0, 30, 0)) * CFrame.Angles(0, 0, math.rad(90))
	tween(col, 0.5, { Size = Vector3.new(60, 0.3, 0.3), Transparency = 1 })
	Debris:AddItem(col, 0.55)
	Fx.ring(r.Position - Vector3.new(0, 2.4, 0), c, 14, 2, 0.4)
	-- 오의의 진: 발밑에 크게 펼쳐져 돈다
	Fx.sigil(r.Position - Vector3.new(0, 2.6, 0), 15, c, c2, 1.2)
	local st = type(styleId) == "string" and Config.STYLE_BY_ID[styleId]
	if st and st.awakenOf then
		-- 각성 권법의 오의: 진이 두 겹 (안쪽은 거꾸로), 머리 위에 거대한 眞, 하늘까지 닿는 빛기둥, 몸을 감는 번개
		Fx.sigil(r.Position - Vector3.new(0, 2.5, 0), 24, c2, c, 1.6)
		local anchor = piece(Vector3.new(0.2, 0.2, 0.2), c, Enum.Material.Neon, nil, 1)
		anchor.Position = r.Position + Vector3.new(0, 9, 0)
		local bb = Instance.new("BillboardGui")
		bb.Size = UDim2.new(0, 260, 0, 260)
		bb.AlwaysOnTop = true
		bb.LightInfluence = 0
		bb.MaxDistance = 260
		bb.Parent = anchor
		local glyph = Instance.new("TextLabel")
		glyph.Size = UDim2.fromScale(1, 1)
		glyph.BackgroundTransparency = 1
		glyph.Font = Enum.Font.GothamBlack
		glyph.TextScaled = true
		glyph.Text = "眞"
		glyph.TextColor3 = c2
		glyph.TextStrokeTransparency = 0.2
		glyph.TextStrokeColor3 = c
		glyph.Parent = bb
		tween(anchor, 1.2, { Position = r.Position + Vector3.new(0, 15, 0) })
		task.delay(0.7, function()
			if glyph.Parent then
				tween(glyph, 0.5, { TextTransparency = 1, TextStrokeTransparency = 1 })
			end
		end)
		Debris:AddItem(anchor, 1.3)
		local sky = piece(Vector3.new(200, 5, 5), c2, Enum.Material.Neon, Enum.PartType.Cylinder, 0.2)
		sky.CFrame = CFrame.new(r.Position + Vector3.new(0, 100, 0)) * CFrame.Angles(0, 0, math.rad(90))
		tween(sky, 0.8, { Size = Vector3.new(200, 0.3, 0.3), Transparency = 1 })
		Debris:AddItem(sky, 0.85)
		for k = 0, 5 do
			task.delay(k * 0.08, function()
				local a = k / 6 * math.pi * 2
				local from = r.Position + Vector3.new(math.cos(a) * 6, 10, math.sin(a) * 6)
				Fx.lightning(from, r.Position + Vector3.new(math.cos(a + 1) * 2, -1, math.sin(a + 1) * 2), c2, 0.35)
			end)
		end
		Fx.burst("ember", r.Position, c, 30, 1.8)
		if hooks.flash and near(r.Position, 80) then
			hooks.flash(c2, 0.25)
		end
	end
	Fx.afterimage(model, c, 0.4)
	-- 오의를 여는 순간: 빛 가루가 회오리치듯 솟고, 둘레가 크게 밝아지며 불씨가 흩날린다
	Fx.burst("glitter", r.Position, c2, 40, 1.4)
	Fx.burst("ember", r.Position, c, 18, 1.2)
	Fx.flash(r.Position, c, 40, 5, 0.8)
	local aura = piece(Vector3.new(5, 7, 5), c, Enum.Material.ForceField, Enum.PartType.Ball, 0)
	aura.CFrame = r.CFrame
	tween(aura, 0.6, { Size = Vector3.new(12, 15, 12), Transparency = 1 })
	Debris:AddItem(aura, 0.65)
end

return Ults
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
  <Item class="Workspace" referent="31">
    <Properties>
      <string name="Name">Workspace</string>
      <float name="Gravity">196.2</float>
      <bool name="NeedsPivotMigration">false</bool>
      <bool name="StreamingEnabled">false</bool>
    </Properties>
  </Item>
</roblox>
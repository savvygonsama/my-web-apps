	{ t = 1, j = { RS = { 70, 0, 8 }, RE = { 40, 0, 0 }, LS = { 70, 0, -8 }, LE = { 40, 0, 0 }, R = { 0, 0, 0, 0, -0.5, -0.4 } } },

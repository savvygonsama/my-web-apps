local TIGER = {
	B = 5.35,
	footH = 0.7,
	legs = {
		{ n = "LF", x = -0.75, hy = -2.3, hz = -1.6, a = 1.45, b = 1.4, front = true },
		{ n = "RF", x = 0.75, hy = -2.3, hz = -1.6, a = 1.45, b = 1.4, front = true },
		{ n = "LH", x = -0.75, hy = -2.15, hz = 1.75, a = 1.55, b = 1.45, front = false },
		{ n = "RH", x = 0.75, hy = -2.15, hz = 1.75, a = 1.55, b = 1.45, front = false },
	},
	walkOff = { LH = 0, LF = 0.25, RH = 0.5, RF = 0.75 },
	-- 달릴 때: 앞발 둘, 뒷발 둘이 거의 함께 (튀어 오르듯)
	runOff = { LH = 0, RH = 0.07, LF = 0.5, RF = 0.57 },
	dutyWalk = 0.6,
	dutyRun = 0.3,
	liftWalk = 0.45,
	liftRun = 1.0,
	maxTravel = 4.2,
	bobRun = 0.3,
	pitchRun = 4 * RAD,
	flexRun = 11 * RAD, -- 허리가 접혔다 펴진다
	curlFront = 1.0,
	curlHind = 0.9,
	stand = -0.05,
}

local function band(rig: Rig, bone: string, center: Vector3, size: Vector3, z: number, thick: number, color: Color3, tilt: number)
	local f = 1 - ((z - center.Z) / (size.Z / 2)) ^ 2
	if f <= 0.05 then
		return
	end
	local r = math.sqrt(f) * 1.03
	add(rig, bone, "ell", V(size.X * r, size.Y * r, thick), CF(center.X, center.Y, z) * ANG(tilt, 0, 0), color)
end

local function buildTiger(rig: Rig)
	local m = rig.m
	local c, stripe = m.color, m.mane
	local white = c:Lerp(WHITE, 0.6)
	local cloth = Color3.fromRGB(40, 60, 140)
	local gold = Color3.fromRGB(230, 190, 90)
	-- 몸: 앞(가슴·어깨)과 뒤(엉덩이·허벅지)로 나뉘어 허리가 접힌다
	local chestC, chestS = V(0, -1.35, -1.25), V(2.2, 2.3, 2.9)
	local rumpC, rumpS = V(0, -1.3, 1.3), V(2.1, 2.1, 2.9)
	add(rig, "front", "ell", chestS, CF(chestC), c)
	add(rig, "rear", "ell", rumpS, CF(rumpC), c)
	for _, s in ipairs({ -1, 1 }) do
		add(rig, "front", "ell", V(0.9, 1.8, 1.4), CF(s * 0.85, -1.55, -1.75), c)
		add(rig, "rear", "ell", V(0.95, 1.9, 1.6), CF(s * 0.85, -1.45, 1.75), c)
	end
	add(rig, "body", "ell", V(1.7, 1.0, 3.6), CF(0, -2.25, 0), white)
	add(rig, "front", "ell", V(1.5, 1.4, 1.0), CF(0, -2.0, -2.45), white)
	-- 줄무늬: 몸을 감는 검은 띠 (굵기와 기울기를 조금씩 다르게)
	for i, dz in ipairs({ -0.95, -0.35, 0.25, 0.85 }) do
		band(rig, "front", chestC, chestS, chestC.Z + dz, i % 2 == 0 and 0.14 or 0.2, stripe, (i % 2 == 0 and 1 or -1) * 0.18)
		band(rig, "rear", rumpC, rumpS, rumpC.Z + dz, i % 2 == 0 and 0.2 or 0.14, stripe, (i % 2 == 0 and -1 or 1) * 0.18)
	end
	-- 목
	add(rig, "front", "ell", V(1.65, 1.8, 1.6), CF(0, -1.05, -2.75), c)
	band(rig, "front", V(0, -1.05, -2.75), V(1.65, 1.8, 1.6), -2.65, 0.16, stripe, 0.2)
	-- 안장 대신 금빛 술이 달린 두툼한 천
	add(rig, "body", "block", V(2.0, 0.12, 2.2), CF(0, -0.12, 0), cloth, Enum.Material.Fabric)
	add(rig, "body", "block", V(2.1, 0.06, 2.3), CF(0, -0.18, 0), gold, Enum.Material.Fabric)
	add(rig, "body", "ell", V(1.5, 0.45, 1.8), CF(0, 0.04, 0), Color3.fromRGB(140, 30, 35))
	for _, x in ipairs({ -1, 1 }) do
		for _, z in ipairs({ -1, 1 }) do
			wave(add(rig, "body", "ell", V(0.15, 0.5, 0.15), CF(x * 1.0, -0.45, z * 1.05), gold, Enum.Material.Metal), 1, 0.08, 5, x + z, 0.2)
		end
	end
	-- 다리: 굵고 둥근 발, 허벅지의 줄무늬
	for _, L in ipairs(TIGER.legs) do
		buildLeg(rig, L, c, white, true)
		local a = L.a
		for _, frac in ipairs({ 0.35, 0.68 }) do
			local cy = -a / 2 + 0.15
			local h = (a + 0.6) / 2
			local y = -a * frac
			local f = 1 - ((y - cy) / h) ^ 2
			if f > 0.05 then
				local r = math.sqrt(f) * 1.04
				add(rig, L.n .. "u", "ell", V(1.0 * r, 0.13, 1.15 * r), CF(0, y, 0), stripe)
			end
		end
	end
	-- 머리 (-Z가 앞): 콧등이 곧게 내려와 넓적한 주둥이로, 눈꼬리가 올라간 매서운 눈과 찌푸린 눈썹, 드러난 송곳니
	add(rig, "head", "ell", V(1.75, 1.5, 1.55), CF(0, 0, 0), c)
	add(rig, "head", "ell", V(0.55, 0.42, 1.0), CF(0, 0.08, -0.62), c)
	add(rig, "head", "ell", V(0.1, 0.08, 0.75), CF(0, 0.73, -0.1), stripe)
	for _, s in ipairs({ -1, 1 }) do
		add(rig, "head", "ell", V(0.09, 0.07, 0.55), CF(s * 0.3, 0.67, -0.18) * ANG(0, -s * 0.35, 0), stripe)
		add(rig, "head", "ell", V(0.08, 0.06, 0.4), CF(s * 0.52, 0.58, -0.05) * ANG(0, -s * 0.5, s * 0.3), stripe)
	end
	add(rig, "head", "ell", V(0.4, 0.22, 0.26), CF(0, -0.06, -1.12), Color3.fromRGB(130, 70, 78))
	add(rig, "head", "ell", V(0.62, 0.34, 0.55), CF(0, -0.66, -0.62), white)
	add(rig, "head", "ell", V(0.62, 0.14, 0.45), CF(0, -0.55, -0.88), DARK)
	for _, s in ipairs({ -1, 1 }) do
		-- 주둥이의 두 볼록한 수염 자리, 송곳니, 수염
		add(rig, "head", "ell", V(0.6, 0.52, 0.62), CF(s * 0.25, -0.32, -0.85), white)
		add(rig, "head", "ell", V(0.09, 0.28, 0.09), CF(s * 0.2, -0.6, -1.02), WHITE)
		for j = 0, 2 do
			add(rig, "head", "block", V(0.03, 0.03, 0.95), CF(s * 0.88, -0.36 + j * 0.07, -0.85) * ANG(j * 0.1 - 0.1, s * 1.3, 0), WHITE)
		end
		-- 볼의 흰 털과 줄무늬 (뒤로 뻗는다)
		add(rig, "head", "ell", V(0.55, 0.85, 0.8), CF(s * 0.78, -0.32, 0.05) * ANG(0, 0, s * 0.25), white)
		add(rig, "head", "ell", V(0.07, 0.32, 0.45), CF(s * 1.04, -0.25, 0.05) * ANG(0, 0, s * 0.3), stripe)
		add(rig, "head", "ell", V(0.07, 0.26, 0.4), CF(s * 1.0, -0.55, 0.08) * ANG(0, 0, s * 0.15), stripe)
		-- 눈: 짙은 눈두덩 위에 빛나는 얼음빛 눈동자, 세로로 가는 동공. 눈꼬리는 바깥으로 올라가고 눈썹은 안쪽으로 내려온다
		local eye = CF(s * 0.42, 0.2, -0.68) * ANG(0, s * 0.35, s * 0.3)
		add(rig, "head", "ell", V(0.46, 0.22, 0.12), eye, stripe)
		add(rig, "head", "ell", V(0.3, 0.15, 0.08), eye * CF(0, 0, -0.05), Color3.fromRGB(140, 220, 255), Enum.Material.Neon)
		add(rig, "head", "ell", V(0.05, 0.14, 0.05), eye * CF(0, 0, -0.09), DARK)
		add(rig, "head", "ell", V(0.48, 0.09, 0.12), CF(s * 0.42, 0.36, -0.66) * ANG(0, s * 0.35, s * 0.45), stripe)
	end
	for _, ear in ipairs({ "earL", "earR" }) do
		add(rig, ear, "ell", V(0.5, 0.5, 0.2), CF(0, 0.2, 0), c)
		add(rig, ear, "ell", V(0.28, 0.3, 0.08), CF(0, 0.2, -0.08), WHITE)
		add(rig, ear, "ell", V(0.44, 0.44, 0.06), CF(0, 0.2, 0.09), stripe)
		add(rig, ear, "ell", V(0.16, 0.16, 0.04), CF(0, 0.22, 0.12), WHITE)
	end
	-- 꼬리 (아홉 마디): 뒤로 뻗었다가 끝이 위로 말린다. 마디마다 검은 고리
	for i = 1, 9 do
		local w = 0.42 - 0.02 * i
		add(rig, "t" .. i, "ell", V(w, 0.65, w), CF(0, -0.25, 0), i == 9 and stripe or c)
		if i % 2 == 1 and i < 9 then
			add(rig, "t" .. i, "ell", V(w * 1.05, 0.12, w * 1.05), CF(0, -0.42, 0), stripe)
		end
	end
	for _ = 1, 2 do
		local r = add(rig, "_dyn", "block", V(0.07, 0.07, 1), CF(), gold, Enum.Material.Metal)
		table.insert(rig.reins, r.p)
	end
end

------------------------------------------------------------------------
-- 네발짐승의 움직임 (말·범 공통)
------------------------------------------------------------------------
local function updateQuad(rig: Rig, yawCF: CFrame, groundLocal: number, t: number, speed: number, freq: number)
	local Q = rig.Q
	local k = rig.k
	local bones = rig.bones
	local m, run, A = rig.move, rig.run, rig.phase * TAU
	-- 몸: 걸을 땐 작게 두 번, 달릴 땐 크게 한 번 들썩이며 앞뒤로 흔들린다. 서 있으면 숨을 쉰다
	local bob = math.sin(A * 2) * 0.05 * k * m * (1 - run) + math.sin(A) * Q.bobRun * k * run + math.sin(t * 1.6) * 0.035 * k * (1 - m)
	local pitch = math.sin(A + 1.2) * Q.pitchRun * run + math.sin(A * 2) * 0.012 * m * (1 - run)
	local rear = 0
	if Q.rear then
		local u = (t - rig.born) / 1.1
		if u < 1 then
			rear = math.sin(math.pi * u) ^ 1.5
		end
	end
	pitch += rear * (Q.rear or 0)
	local bodyLocal = CF(0, bob, 0) * ANG(pitch, 0, rig.bank)
	local flex = math.sin(A + 0.6) * Q.flexRun * run
	local frontLocal = bodyLocal * ANG(flex, 0, 0)
	local rearLocal = bodyLocal * ANG(-flex, 0, 0)
	bones.body = yawCF * bodyLocal
	bones.front = yawCF * frontLocal
	bones.rear = yawCF * rearLocal
	-- 다리: 땅에 닿아 있는 동안 발은 제자리 (몸이 지나간다), 떨어진 동안 앞으로 들어 옮긴다
	local cam = workspace.CurrentCamera
	local dustNear = cam ~= nil and (cam.CFrame.Position - yawCF.Position).Magnitude < 120
	local duty = lerp(Q.dutyWalk, Q.dutyRun, run)
	local travel = math.min(speed * duty / freq, Q.maxTravel * k)
	local lift = lerp(Q.liftWalk, Q.liftRun, run) * k
	for _, L in ipairs(Q.legs) do
		local half = L.front and frontLocal or rearLocal
		local hip = half * V(L.x * k, L.hy * k, L.hz * k)
		local rest = L.hz * k
		local off = lerp(Q.walkOff[L.n], Q.runOff[L.n], run)
		local u = (rig.phase + off) % 1
		-- 달릴 때 발이 땅을 박차는 순간 흙먼지
		local prevU = rig.lastU[L.n]
		rig.lastU[L.n] = u
		if prevU and u < prevU and run > 0.35 and dustNear then
			Fx.burst("smoke", yawCF * V(hip.X, groundLocal + 0.3, rest + travel * 0.5), Color3.fromRGB(205, 190, 165), 2, 0.55 * k)
		end
		local z, y, curl
		if u < duty then
			z = rest + travel * (u / duty - 0.5)
			y = 0
			curl = 0
		else
			local s = (u - duty) / (1 - duty)
			z = rest + travel * (0.5 - smooth(s))
			y = lift * math.sin(math.pi * s) * (L.front and 1.15 or 1)
			curl = math.sin(math.pi * s)
		end
		z = rest + (z - rest) * m
		y *= m
		curl *= m
		if L.front and rear > 0 then
			y += rear * 1.9 * k
			z -= rear * 0.9 * k
			curl = math.max(curl, rear)
		end
		local T = V(hip.X, groundLocal + Q.footH * k + y, z)
		local upper, lower, F = ik(hip, T, L.a * k, L.b * k, L.front)
		local pa = lerp(Q.stand, L.front and Q.curlFront or Q.curlHind, curl)
		bones[L.n .. "u"] = yawCF * upper
		bones[L.n .. "l"] = yawCF * lower
		bones[L.n .. "p"] = yawCF * CF(F) * ANG(-pa, 0, 0)
	end
	-- 귀: 가끔 쫑긋
	local twL = math.max(0, math.sin(t * 0.7)) ^ 14 * 0.6
	local twR = math.max(0, math.sin(t * 0.83 + 2)) ^ 14 * 0.6
	local look = math.sin(t * 0.37) * 0.14 * (1 - m) + math.clamp(rig.yawRate * 0.08, -0.3, 0.3)
	if rig.kind == "horse" then
		-- 목과 머리: 걸음에 맞춰 끄덕이고, 달리면 목을 앞으로 뻗는다. 도는 쪽을 먼저 본다
		local nod = math.sin(A * 2 + 0.5) * 0.05 * m * (1 - run) + math.sin(A + 2.2) * 0.12 * run
		local e = lerp(52, 34, run) * RAD + rear * 0.5 + nod * 0.5
		local cf = bones.front * CF(0, -1.05 * k, -2.95 * k) * ANG(e, look * 0.5, 0)
		for i = 1, 3 do
			bones["n" .. i] = cf
			cf = cf * CF(0, 0, -0.95 * k) * ANG(-9 * RAD, look * 0.25, 0)
		end
		local head = cf * ANG(-78 * RAD + nod - rear * 0.3, look * 0.3, 0)
		bones.head = head
		bones.earL = head * CF(-0.3 * k, 0.5 * k, -0.1 * k) * ANG(-0.25 - twL, 0, 0.3)
		bones.earR = head * CF(0.3 * k, 0.5 * k, -0.1 * k) * ANG(-0.25 - twR, 0, -0.3)
		-- 꼬리: 서 있으면 느리게 휘휘, 달리면 뒤로 흩날린다
		local th = lerp(28, 70, run) * RAD - rear * 0.2
		local tc = bones.rear * CF(0, -0.2 * k, 3.7 * k) * ANG(-th, 0, 0)
		for i = 1, 6 do
			bones["t" .. i] = tc
			local sway = math.sin(t * 2.1 - i * 0.7) * 7 * RAD * (0.4 + i * 0.25) * (1 - run * 0.5) + math.sin(t * 11 - i * 0.9) * 5 * RAD * run
			tc = tc * CF(0, -0.6 * k, 0) * ANG(lerp(9, 2, run) * RAD, 0, sway)
		end
	else
		-- 범: 고개를 낮게 들고, 달리면 더 숙인다
		local nod = math.sin(A * 2) * 0.04 * m * (1 - run) + math.sin(A + 1.8) * 0.08 * run
		local head = bones.front * CF(0, -0.85 * k, -3.35 * k) * ANG(-0.12 + nod - run * 0.15, look, 0)
		bones.head = head
		bones.earL = head * CF(-0.6 * k, 0.62 * k, 0.25 * k) * ANG(-twL, 0, 0.35)
		bones.earR = head * CF(0.6 * k, 0.62 * k, 0.25 * k) * ANG(-twR, 0, -0.35)
		-- 꼬리: 뒤로 뻗었다가 끝이 위로 말리고, 물결치듯 흔들린다
		local tc = bones.rear * CF(0, -0.75 * k, 2.75 * k) * ANG(-lerp(100, 92, run) * RAD, 0, 0)
		for i = 1, 9 do
			bones["t" .. i] = tc
			local bend = (i <= 4 and 10 or -16) * RAD * (1 - run * 0.5)
			local sway = math.sin(t * 1.8 - i * 0.6) * 9 * RAD * (0.5 + i * 0.15) + math.sin(t * 9 - i) * 4 * RAD * run
			tc = tc * CF(0, -0.5 * k, 0) * ANG(bend, 0, sway)
		end
	end
end

------------------------------------------------------------------------
-- 날개구름: 탄 사람은 구름 위에 선다. 뭉치마다 따로 둥실거리고, 뒤로 작은 구름이 흩어진다
------------------------------------------------------------------------
local CLOUD = { B = 6.05 }
local function buildCloud(rig: Rig)
	local m = rig.m
	local spots = {
		{ 0, -1.2, 0, 3.0 }, { 1.3, -1.1, -0.9, 2.2 }, { -1.3, -1.1, -0.9, 2.2 }, { 1.4, -1.15, 1.0, 2.3 }, { -1.4, -1.15, 1.0, 2.3 },
		{ 0, -1.05, -1.9, 2.1 }, { 0, -1.1, 1.9, 2.2 }, { 0.8, -0.55, 0.3, 1.5 }, { -0.8, -0.55, 0.3, 1.5 }, { 0, -1.8, 0, 2.4 },
		{ 2.2, -1.3, 0, 1.6 }, { -2.2, -1.3, 0, 1.6 },
	}
	for i, sp in ipairs(spots) do
		local col = m.color:Lerp(Color3.fromRGB(225, 230, 245), (i % 3) * 0.08)
		local e = add(rig, "body", "ball", V(sp[4], sp[4], sp[4]), CF(sp[1], sp[2], sp[3]), col)
		e.bob = { 0.12, 1.4 + (i % 4) * 0.35, i * 1.3 }
		-- 바깥의 옅은 솜털 (부드러운 가장자리)
		local o = add(rig, "body", "ball", V(sp[4], sp[4], sp[4]) * 1.22, CF(sp[1], sp[2] - 0.05, sp[3]), col:Lerp(m.mane, 0.08), nil, 0.6)
		o.bob = { 0.15, 1.1 + (i % 3) * 0.3, i * 0.7 }
	end
	local glow = add(rig, "body", "cyl", V(0.25, 5.2, 5.2), CF(0, -2.75, 0) * ANG(0, 0, math.rad(90)), m.mane, Enum.Material.Neon, 0.5).p
	local light = Instance.new("PointLight")
	light.Color = m.mane
	light.Range = 16
	light.Brightness = 1.6
	light.Parent = glow
	emitter(glow, TEX_SPARK, m.mane, 0.4, 20, 1.0, 2, 60)
	local mist = emitter(glow, TEX_SMOKE, WHITE, 2.2, 6, 1.4, 1, 40)
	mist.Transparency = NumberSequence.new(0.6, 1)
	mist.LightEmission = 0.2
	-- 뒤로 흩어지는 꼬리 구름
	for i = 1, 6 do
		local sz = 2.0 - i * 0.24
		local e = add(rig, "_trail", "ball", V(sz, sz, sz), CF(), m.color, nil, 0.1 + i * 0.12)
		table.insert(rig.trail, e)
	end
end

------------------------------------------------------------------------
-- 청룡 (로벅스 상품): 스물두 마디의 비늘 몸이 머리가 지나간 길을 그대로 따라 흐른다.
-- 빛나는 등줄기, 금빛 등지느러미, 몸을 감도는 영기의 불꽃, 꼬리 끝에서 흐르는 금빛 띠,
-- 크게 벌린 입과 송곳니, 가지 뿔, 흐르는 수염, 빛을 끌며 도는 눈, 여의주. 가끔 고개를 들고 포효한다
------------------------------------------------------------------------
local DRAGON = { B = 4.8, N = 22, gap = 1.05, legs = { 5, 14 }, H = 1.25 } -- B가 작을수록 크게, H = 머리 크기
local TEX_FIRE = "rbxasset://textures/particles/fire_main.dds"
local function segW(i: number): number
	if i < 3 then
		return 1.8 + 0.17 * i
	end
	return 2.3 - 1.75 * ((i - 3) / (DRAGON.N - 4))
end
local function trailOn(part: BasePart, a: Vector3, b: Vector3, c0: Color3, c1: Color3, life: number)
	local a0 = Instance.new("Attachment")
	a0.Position = a
	a0.Parent = part
	local a1 = Instance.new("Attachment")
	a1.Position = b
	a1.Parent = part
	local tr = Instance.new("Trail")
	tr.Attachment0 = a0
	tr.Attachment1 = a1
	tr.Color = ColorSequence.new(c0, c1)
	tr.Transparency = NumberSequence.new(0.15, 1)
	tr.LightEmission = 1
	tr.Lifetime = life
	tr.MinLength = 0.05
	tr.FaceCamera = true
	tr.Parent = part
end
local function buildDragon(rig: Rig)
	local m = rig.m
	local k = rig.k
	local c, gold = m.color, m.mane
	local deep = Color3.fromRGB(18, 66, 104)
	local belly = Color3.fromRGB(242, 226, 168)
	local glowGold = Color3.fromRGB(255, 232, 150)
	local spirit = Color3.fromRGB(120, 255, 220)
	local N = DRAGON.N
	for i = 0, N - 1 do
		local w = segW(i)
		local b = "s" .. i
		-- 머리 쪽 비취빛에서 꼬리 쪽 짙은 바닷빛으로
		local col = c:Lerp(deep, i / (N - 1) * 0.55)
		local sheen = col:Lerp(Color3.fromRGB(130, 230, 210), 0.3)
		local body = add(rig, b, "ell", V(w, w * 0.92, 1.85), CF(), col)
		body.p.Reflectance = 0.12
		add(rig, b, "ell", V(w * 0.74, w * 0.42, 1.6), CF(0, -w * 0.32, 0), belly)
		add(rig, b, "ell", V(w * 0.6, 0.12, 0.35), CF(0, -w * 0.48, -0.6), belly:Lerp(gold, 0.45))
		-- 등의 비늘 두 줄 (겹쳐 얹은 비늘판)
		for _, sd in ipairs({ -1, 1 }) do
			local sc = add(rig, b, "ell", V(w * 0.55, w * 0.22, 0.95), CF(sd * w * 0.2, w * 0.36, -0.15) * ANG(0.2, 0, sd * 0.35), sheen)
			sc.p.Reflectance = 0.25
		end
		-- 빛나는 등줄기와 금빛 등지느러미 (끝은 빛난다)
		add(rig, b, "ell", V(0.13, 0.13, 1.5), CF(0, w * 0.47, 0), glowGold, Enum.Material.Neon, 0.1)
		wave(add(rig, b, "ell", V(0.12, w * 0.7, 0.95), CF(0, w * 0.56, 0.15) * ANG(-0.5, 0, 0), gold, Enum.Material.Metal), 1, 0.05, 4, i * 0.6, 0.12)
		wave(add(rig, b, "ell", V(0.07, w * 0.36, 0.5), CF(0, w * 0.86, 0.42) * ANG(-0.6, 0, 0), glowGold, Enum.Material.Neon, 0.2), 1, 0.05, 4, i * 0.6, 0.12)
		if i % 2 == 0 then
			for _, sd in ipairs({ -1, 1 }) do
				add(rig, b, "ell", V(0.1, w * 0.3, 1.25), CF(sd * w * 0.46, w * 0.05, 0), col:Lerp(DARK, 0.35))
			end
		end
		-- 옆구리의 금빛 불꽃 털 (세 마디마다, 뒤로 흩날린다)
		if i % 3 == 1 and i > 3 then
			for _, sd in ipairs({ -1, 1 }) do
				wave(add(rig, b, "ell", V(0.12, w * 0.65, 0.95), CF(sd * w * 0.5, w * 0.1, 0.3) * ANG(-0.9, 0, sd * 1.0), gold), 3, 0.12, 5, i + sd, 0.25)
			end
		end
	end
	-- 몸을 감도는 영기의 불꽃과 금빛 가루, 몸 아래로 흩어지는 구름
	for _, si in ipairs({ 3, 8, 13, 18 }) do
		local holder = add(rig, "s" .. si, "ball", V(0.1, 0.1, 0.1), CF(0, segW(si) * 0.3, 0), WHITE, nil, 1).p
		local fl = emitter(holder, TEX_FIRE, spirit, 1.8 * k, 14, 0.7, 1.2, 40)
		fl.Color = ColorSequence.new(spirit, gold)
		fl.LightEmission = 1
		fl.Acceleration = V(0, 4, 0)
		emitter(holder, TEX_SPARK, glowGold, 0.45 * k, 10, 1.2, 1.5, 180)
	end
	for _, si in ipairs({ 6, 12, 18 }) do
		local holder = add(rig, "s" .. si, "ball", V(0.1, 0.1, 0.1), CF(0, -segW(si) * 0.4, 0), WHITE, nil, 1).p
		local mist = emitter(holder, TEX_SMOKE, Color3.fromRGB(240, 245, 255), 3.4 * k, 7, 1.8, 0.6, 50)
		mist.Transparency = NumberSequence.new(0.55, 1)
		mist.LightEmission = 0.15
	end
	local bodyLight = Instance.new("PointLight")
	bodyLight.Color = spirit
	bodyLight.Range = 18
	bodyLight.Brightness = 1.1
	bodyLight.Parent = rig.parts[#rig.parts].p
	-- 꼬리 끝: 다섯 갈래 금빛 부채 지느러미 (가장자리는 빛난다)와 흐르는 금빛 띠
	local tailB = "s" .. (N - 1)
	for j = -2, 2 do
		local th = math.rad(90 + j * 24)
		local off = CF(0, math.cos(th) * 1.0, math.sin(th) * 1.0) * ANG(th, 0, 0)
		wave(add(rig, tailB, "ell", V(0.1, 2.0, 1.1), off, gold, Enum.Material.Metal), 3, 0.12, 3, j, 0.15)
		wave(add(rig, tailB, "ell", V(0.06, 2.1, 0.45), off * CF(0, 0.15, 0.35), glowGold, Enum.Material.Neon, 0.25), 3, 0.12, 3, j, 0.15)
	end
	local tailPart = add(rig, tailB, "ball", V(0.1, 0.1, 0.1), CF(0, 0, 1.6), WHITE, nil, 1).p
	trailOn(tailPart, V(0, 0.7 * k, 0), V(0, -0.7 * k, 0), glowGold, spirit, 0.8)
	-- 다리 넷: 비늘 다리, 팔꿈치의 불꽃 털, 금빛 발톱 넷
	for _, si in ipairs(DRAGON.legs) do
		local ls = segW(si) / 2
		for _, side in ipairs({ "L", "R" }) do
			local nm = "d" .. si .. side
			local col = c:Lerp(deep, si / (N - 1) * 0.55)
			add(rig, nm .. "u", "ell", V(0.6, 1.35, 0.6) * ls, CF(0, -0.6 * ls, 0), col)
			add(rig, nm .. "l", "ell", V(0.45, 1.05, 0.45) * ls, CF(0, -0.45 * ls, 0), col)
			wave(add(rig, nm .. "l", "ell", V(0.12, 0.9, 0.5) * ls, CF(0, 0.1 * ls, 0.3 * ls) * ANG(-1.2, 0, 0), gold), 1, 0.15, 5, si, 0.2)
			add(rig, nm .. "f", "ell", V(0.55, 0.3, 0.6) * ls, CF(0, -0.1 * ls, -0.1 * ls), col)
			for _, x in ipairs({ -0.2, -0.07, 0.07, 0.2 }) do
				add(rig, nm .. "f", "ell", V(0.12, 0.12, 0.55) * ls, CF(x * ls, -0.2 * ls, -0.45 * ls) * ANG(-0.5, x * 0.6, 0), gold, Enum.Material.Metal)
			end
		end
	end
	-- 머리 (-Z가 앞, H배 크게)
	local H = DRAGON.H
	local function hd(bone: string, shape: string, size: Vector3, pos: Vector3, rot: CFrame?, color: Color3, mat: Enum.Material?, alpha: number?): Piece
		return add(rig, bone, shape, size * H, CF(pos * H) * (rot or CFrame.identity), color, mat, alpha)
	end
	local darkC = c:Lerp(DARK, 0.35)
	local mouth = Color3.fromRGB(90, 20, 26)
	hd("head", "ell", V(1.6, 1.25, 1.8), V(0, 0.1, 0), nil, c)
	hd("head", "ell", V(1.2, 0.7, 1.2), V(0, 0.55, 0.1), nil, c)
	hd("head", "ell", V(1.15, 0.75, 2.1), V(0, -0.02, -1.5), nil, c)
	hd("head", "ell", V(1.0, 0.6, 0.7), V(0, 0.15, -2.45), nil, c)
	hd("head", "ell", V(0.85, 0.25, 1.7), V(0, -0.33, -1.25), nil, mouth)
	for _, s in ipairs({ -1, 1 }) do
		-- 젖혀진 윗입술, 말린 콧구멍
		hd("head", "ell", V(0.35, 0.35, 1.5), V(s * 0.5, -0.25, -1.6), ANG(0, -s * 0.12, 0), belly)
		hd("head", "ell", V(0.28, 0.28, 0.2), V(s * 0.3, 0.32, -2.72), nil, darkC)
		hd("head", "ball", V(0.14, 0.14, 0.14), V(s * 0.3, 0.32, -2.8), nil, DARK)
		-- 매서운 눈썹 뼈와 빛나는 금빛 눈 (세로 동공), 눈에서 끌리는 빛
		hd("head", "ell", V(0.5, 0.32, 1.0), V(s * 0.45, 0.58, -0.35), ANG(0, -s * 0.15, s * 0.25), darkC)
		local eyeRot = ANG(0, s * 0.5, s * 0.25)
		hd("head", "ell", V(0.42, 0.3, 0.2), V(s * 0.58, 0.36, -0.6), eyeRot, DARK)
		local iris = hd("head", "ell", V(0.34, 0.24, 0.14), V(s * 0.62, 0.36, -0.62), eyeRot, Color3.fromRGB(255, 225, 90), Enum.Material.Neon).p
		hd("head", "ell", V(0.06, 0.22, 0.08), V(s * 0.68, 0.36, -0.64), eyeRot, DARK)
		trailOn(iris, V(0, 0.06 * k, 0), V(0, -0.06 * k, 0), Color3.fromRGB(255, 230, 120), spirit, 0.35)
		-- 윗니와 송곳니
		for _, z in ipairs({ -0.9, -1.3, -1.7, -2.1 }) do
			hd("head", "ell", V(0.1, 0.2, 0.1), V(s * 0.42, -0.38, z), nil, WHITE)
		end
		hd("head", "ell", V(0.13, 0.42, 0.13), V(s * 0.36, -0.5, -2.2), nil, WHITE)
		-- 가지 뿔: 굵은 밑동 → 휘어 오르는 줄기 → 빛나는 끝, 옆으로 뻗는 곁가지
		hd("head", "ell", V(0.3, 0.3, 1.7), V(s * 0.45, 0.75, 0.65), ANG(0.55, s * 0.28, 0), gold, Enum.Material.Metal)
		hd("head", "ell", V(0.22, 0.22, 1.3), V(s * 0.6, 1.3, 1.5), ANG(0.95, s * 0.35, 0), gold, Enum.Material.Metal)
		hd("head", "ell", V(0.14, 0.14, 0.8), V(s * 0.68, 1.75, 2.1), ANG(1.25, s * 0.4, 0), glowGold, Enum.Material.Neon)
		hd("head", "ell", V(0.15, 0.15, 0.8), V(s * 0.7, 1.05, 1.0), ANG(-0.1, s * 0.7, 0), gold, Enum.Material.Metal)
		hd("head", "ell", V(0.1, 0.1, 0.45), V(s * 0.95, 1.1, 1.25), ANG(-0.1, s * 0.75, 0), glowGold, Enum.Material.Neon)
		-- 볼 뒤의 부채 가시 셋
		for j = 0, 2 do
			wave(hd("head", "ell", V(0.08, 1.0, 0.55), V(s * 0.78, -0.25 + j * 0.25, 0.35), ANG(0.9 - j * 0.25, 0, s * (0.7 + j * 0.2)), gold, Enum.Material.Metal), 3, 0.06, 3, j + s, 0.1)
		end
		-- 수염 (여섯 마디), 눈썹 수염 (네 마디)
		local tag = s < 0 and "L" or "R"
		for j = 1, 6 do
			add(rig, "w" .. tag .. j, "ell", V(0.12 - j * 0.012, 0.12 - j * 0.012, 0.85), CF(0, 0, 0.4), glowGold, Enum.Material.Neon)
		end
		for j = 1, 4 do
			add(rig, "b" .. tag .. j, "ell", V(0.08, 0.08, 0.7), CF(0, 0, 0.33), gold, Enum.Material.Neon, 0.1)
		end
	end
	-- 뒤통수의 금빛 갈기 (달리면 흩날린다)
	for j = 0, 5 do
		local sd = j % 2 == 0 and 1 or -1
		wave(hd("head", "ell", V(0.16, 1.1, 0.6), V(sd * 0.25, 0.65, 0.5 + j * 0.3), ANG(-0.75, 0, sd * 0.35), gold), 3, 0.1, 4, j, 0.25)
	end
	-- 아래턱: 이빨과 송곳니, 붉은 혀, 금빛 턱수염
	hd("jaw", "ell", V(1.05, 0.36, 2.0), V(0, -0.05, -1.05), nil, belly)
	hd("jaw", "ell", V(0.45, 0.12, 1.4), V(0, 0.1, -1.1), nil, Color3.fromRGB(200, 50, 62))
	for _, s in ipairs({ -1, 1 }) do
		for _, z in ipairs({ -1.0, -1.4, -1.8 }) do
			hd("jaw", "ell", V(0.1, 0.18, 0.1), V(s * 0.4, 0.17, z), nil, WHITE)
		end
		hd("jaw", "ell", V(0.12, 0.34, 0.12), V(s * 0.34, 0.25, -1.95), nil, WHITE)
	end
	for _, x in ipairs({ -0.2, 0, 0.2 }) do
		wave(hd("jaw", "ell", V(0.3, 0.9, 0.28), V(x, -0.45, -0.7 + math.abs(x)), ANG(0.35, 0, x), gold), 3, 0.08, 3, x * 5, 0.2)
	end
	-- 여의주: 빛나는 구슬, 둘레를 도는 빛 여섯, 푸른 금빛 불꽃
	local pearl = add(rig, "pearl", "ball", V(1.3, 1.3, 1.3), CF(), Color3.fromRGB(255, 248, 220), Enum.Material.Neon).p
	local pl = Instance.new("PointLight")
	pl.Color = gold
	pl.Range = 22
	pl.Brightness = 2.2
	pl.Parent = pearl
	emitter(pearl, TEX_SPARK, gold, 0.4 * k, 18, 0.9, 1.5, 180)
	local pf = emitter(pearl, TEX_FIRE, spirit, 1.6 * k, 16, 0.5, 0.8, 180)
	pf.Color = ColorSequence.new(spirit, gold)
	pf.LightEmission = 1
	for j = 0, 5 do
		local a = j / 6 * TAU
		add(rig, "pearlSpin", "ball", V(0.22, 0.22, 0.22), CF(math.cos(a) * 1.25, 0, math.sin(a) * 1.25), j % 2 == 0 and glowGold or spirit, Enum.Material.Neon)
	end
	local glowHolder = add(rig, "head", "ball", V(0.1, 0.1, 0.1), CF(0, 0.2, -0.4), gold, Enum.Material.Neon, 1).p
	emitter(glowHolder, TEX_SPARK, gold, 0.45 * k, 22, 1.3, 1.2, 180)
	local headLight = Instance.new("PointLight")
	headLight.Color = glowGold
	headLight.Range = 18
	headLight.Brightness = 1.5
	headLight.Parent = glowHolder
end

-- 지나온 길 (머리 쪽이 1번). 너무 멀리 뛰면 (순간이동) 새로 시작한다
local function pushHist(rig: Rig, p: Vector3, maxLen: number)
	local h = rig.hist
	if #h == 0 or (p - h[1]).Magnitude > 40 then
		table.clear(h)
		table.insert(h, p)
		return
	end
	if (p - h[1]).Magnitude > 0.3 then
		table.insert(h, 1, p)
	else
		h[1] = p
	end
	local total = 0
	for i = 2, #h do
		total += (h[i] - h[i - 1]).Magnitude
		if total > maxLen then
			for _ = #h, i + 1, -1 do
				table.remove(h)
			end
			break
		end
	end
end
-- 길 위에서 머리부터 일정한 간격의 자리들 (길이 모자라면 뒤로 곧게 늘인다)
local function samplePath(h: { Vector3 }, back: Vector3, gap: number, n: number, start: number): { Vector3 }
	local out = {}
	local idx, acc = 1, 0
	for i = 0, n - 1 do
		local want = start + i * gap
		while idx < #h and acc + (h[idx + 1] - h[idx]).Magnitude < want do
			acc += (h[idx + 1] - h[idx]).Magnitude
			idx += 1
		end
		if idx < #h then
			local seg = h[idx + 1] - h[idx]
			local L = seg.Magnitude
			out[i + 1] = h[idx] + seg * (L > 1e-4 and math.clamp((want - acc) / L, 0, 1) or 0)
		else
			local dir = #h >= 2 and (h[#h] - h[#h - 1]) or back
			if dir.Magnitude < 1e-4 then
				dir = back
			end
			out[i + 1] = h[#h] + dir.Unit * (want - acc)
		end
	end
	return out
end

------------------------------------------------------------------------
-- 만들기·지우기
------------------------------------------------------------------------
local function poof(model: Model, color: Color3, big: boolean?)
	local root = model:FindFirstChild("HumanoidRootPart")
	if root and root:IsA("BasePart") then
		local cam = workspace.CurrentCamera
		if cam and (cam.CFrame.Position - root.Position).Magnitude > 200 then
			return
		end
		Fx.burst("smoke", root.Position - V(0, 2, 0), Color3.fromRGB(235, 230, 220), 10, 1.4)
		Fx.burst("glitter", root.Position, color, 10, 1)
		if big then
			-- 청룡이 나타날 때: 금빛 기운이 크게 터지고 고리가 퍼진다
			Fx.burst("glitter", root.Position, color, 40, 2.2)
			Fx.burst("spark", root.Position, Color3.fromRGB(120, 255, 220), 24, 1.8)
			Fx.ring(root.Position - V(0, 5, 0), color, 4, 44, 0.8)
			Fx.flash(root.Position, color, 50, 4, 0.5)
		end
	end
end

local function build(model: Model, id: string)
	local m = Config.MOUNT_BY_ID[id]
	if not m then
		return
	end
	local Q = m.kind == "tiger" and TIGER or m.kind == "cloud" and CLOUD or m.kind == "dragon" and DRAGON or HORSE
	-- 크기: 탄 사람이 들린 높이에 맞춘다 (서버의 Config.MOUNT_HIP)
	local hum = model:FindFirstChildOfClass("Humanoid")
	local hip = Config.MOUNT_HIP[m.kind] or 3
	local back = hip + 1.85
	if hum and hum.HipHeight > hip + 0.5 then
		back = hum.HipHeight - 0.15
	end
	local rig: Rig = {
		kind = m.kind,
		m = m,
		model = model,
		k = math.clamp(back / Q.B, 0.75, 1.8),
		Q = Q,
		parts = {},
		bones = {},
		phase = 0,
		move = 0,
		run = 0,
		yaw = nil,
		yawRate = 0,
		bank = 0,
		born = os.clock(),
		shown = false,
		hist = {},
		trail = {},
		reins = {},
		straps = {},
		irons = {},
		skip = 0,
		lastU = {},
	}
	if m.kind == "cloud" then
		buildCloud(rig)
	elseif m.kind == "dragon" then
		buildDragon(rig)
	elseif m.kind == "tiger" then
		buildTiger(rig)
	else
		buildHorse(rig)
	end
	rigs[model] = rig
	poof(model, m.mane, m.kind == "dragon")
end

local function clear(model: Model, fx: boolean?)
	local rig = rigs[model]
	if rig then
		for _, e in ipairs(rig.parts) do
			e.p:Destroy()
		end
		rigs[model] = nil
		if fx then
			poof(model, rig.m.mane)
		end
	end
end

function Mount.watch(model: Model)
	local function refresh()
		local had = rigs[model] ~= nil
		clear(model, had)
		local id = model:GetAttribute("Mount")
		if type(id) == "string" then
			build(model, id)
		end
	end
	model:GetAttributeChangedSignal("Mount"):Connect(refresh)
	model.AncestryChanged:Connect(function()
		if not model.Parent then
			clear(model)
		end
	end)
	refresh()
end

------------------------------------------------------------------------
-- 매 화면
------------------------------------------------------------------------
local function update(rig: Rig, root: BasePart, hum: Humanoid, dt: number, t: number)
	local k = rig.k
	local bones = rig.bones
	local vel = root.AssemblyLinearVelocity
	local speed = V(vel.X, 0, vel.Z).Magnitude
	local look = root.CFrame.LookVector
	local flat = V(look.X, 0, look.Z)
	if flat.Magnitude < 1e-3 then
		flat = V(0, 0, -1)
	end
	flat = flat.Unit
	-- 방향은 살짝 늦게 따라오고, 도는 만큼 안쪽으로 기운다
	local yawT = math.atan2(-flat.X, -flat.Z)
	if not rig.yaw then
		rig.yaw = yawT
	end
	local yaw = rig.yaw :: number
	local d = (yawT - yaw + math.pi) % TAU - math.pi
	yaw += d * math.min(1, dt * 9)
	rig.yaw = yaw
	rig.yawRate += (d * 9 - rig.yawRate) * math.min(1, dt * 6)
	rig.move += ((speed > 1.2 and 1 or 0) - rig.move) * math.min(1, dt * 5)
	rig.run += (math.clamp((speed - 9) / 12, 0, 1) - rig.run) * math.min(1, dt * 3)
	rig.bank += (math.clamp(rig.yawRate * 0.07, -0.3, 0.3) * (0.25 + 0.75 * rig.move) - rig.bank) * math.min(1, dt * 6)
	local freq = (0.75 + speed * 0.062) / math.sqrt(k) -- 큰 짐승일수록 보폭이 길고 걸음이 느긋하다
	rig.phase = (rig.phase + dt * freq) % 1
	local pos = root.Position
	local rootBottom = pos.Y - root.Size.Y / 2
	local seatY = rootBottom - 0.3
	local groundY = rootBottom - hum.HipHeight
	local turn = ANG(0, yaw, 0)

	if rig.kind == "horse" or rig.kind == "tiger" then
		local yawCF = CF(pos.X, seatY, pos.Z) * turn
		updateQuad(rig, yawCF, groundY - seatY, t, speed, freq)
	elseif rig.kind == "cloud" then
		local baseHip = math.max(0.5, hum.HipHeight - (Config.MOUNT_HIP.cloud or 2.6))
		local feetY = rootBottom - baseHip
		local body = CF(pos.X, feetY + 0.15, pos.Z) * turn * CF(0, math.sin(t * 1.9) * 0.1 * k, 0) * ANG(-7 * RAD * rig.move, 0, rig.bank * 1.4)
		bones.body = body
		pushHist(rig, body.Position, 14 * k)
		local pts = samplePath(rig.hist, -flat, 1.3 * k, #rig.trail, 2.4 * k)
		for i, e in ipairs(rig.trail) do
			local p = pts[i] + V(math.sin(t * 2 + i) * 0.25, -1.2 * k + math.sin(t * 1.5 + i * 0.8) * 0.2, 0)
			e.p.CFrame = CF(p)
		end
	else
		-- 청룡: 머리는 탄 사람 앞, 몸은 지나온 길을 따라 흐르며 옆과 위아래로 물결친다
		local N, gap = DRAGON.N, DRAGON.gap * k
		local anchor = V(pos.X, seatY - 0.95 * k, pos.Z) + flat * 2.2 * k + V(0, math.sin(t * 1.5) * 0.12 * k, 0)
		pushHist(rig, anchor, N * gap + 6)
		local pts = samplePath(rig.hist, -flat, gap, N, 0)
		local up = V(0, 1, 0)
		for i = 0, N - 1 do
			local w = i / (N - 1)
			local here = pts[i + 1]
			local ahead = i == 0 and (here + flat) or pts[i]
			local tan = ahead - here
			if tan.Magnitude < 1e-3 then
				tan = flat
			end
			local right = tan.Unit:Cross(up)
			if right.Magnitude < 1e-3 then
				right = V(1, 0, 0)
			end
			local calm = i <= 2 and 0 or 1
			-- 탄 사람 아래의 앞 마디는 곧게 (돌 때 몸이 사람에게서 비껴 나지 않게)
			local rigid = math.clamp((4 - i) / 2, 0, 1)
			if rigid > 0 then
				local line = V(anchor.X, here.Y, anchor.Z) - flat * i * gap
				here = here:Lerp(line, rigid)
			end
			local lat = math.sin(t * 2.4 - i * 0.5) * k * math.max(0, i - 2) / (N - 3) * (0.6 + 0.6 * rig.move) * 1.1
			local vert = math.sin(t * 1.7 - i * 0.42) * k * (0.15 + 0.55 * w) * (1 - 0.4 * rig.move) * calm
			pts[i + 1] = here + right.Unit * lat * calm + up * vert
		end
		for i = 0, N - 1 do
			local here = pts[i + 1]
			local ahead = i == 0 and (here + flat * gap) or pts[i]
			if (ahead - here).Magnitude < 1e-3 then
				ahead = here + flat
			end
			bones["s" .. i] = CFrame.lookAt(here, ahead)
		end
		-- 다리: 헤엄치듯 천천히 젓는다 (발목이 따라 접힌다)
		for _, si in ipairs(DRAGON.legs) do
			local seg = bones["s" .. si]
			local w = segW(si)
			local ls = w / 2
			for _, side in ipairs({ -1, 1 }) do
				local paddle = math.sin(t * (2 + 3 * rig.move) + side + si) * 0.5
				local u = seg * CF(side * 0.5 * w * k, -0.35 * w * k, 0) * ANG(paddle, 0, side * 0.7)
				local name = "d" .. si .. (side < 0 and "L" or "R")
				bones[name .. "u"] = u
				local l = u * CF(0, -1.1 * ls * k, 0) * ANG(-0.9 - paddle * 0.4, 0, 0)
				bones[name .. "l"] = l
				bones[name .. "f"] = l * CF(0, -0.95 * ls * k, 0) * ANG(0.5 + paddle * 0.4, 0, 0)
			end
		end
		-- 포효: 아홉 초마다 고개를 들고 입을 크게 벌린다 (금빛 기운이 터진다)
		local H = DRAGON.H
		local rt = t % 9
		local roar = rt < 1.4 and math.sin(math.pi * rt / 1.4) or 0
		local nod = math.sin(t * 1.3) * 0.08 + roar * 0.28
		local look2 = math.clamp(rig.yawRate * 0.12, -0.4, 0.4)
		local head = CF(pts[1] + flat * 1.0 * k * H + V(0, 0.35 * k, 0)) * turn * ANG(nod, look2, 0)
		bones.head = head
		bones.jaw = head * CF(0, -0.38 * k * H, -0.3 * k * H) * ANG(-(0.12 + 0.05 * math.sin(t * 1.3) + roar * 0.55), 0, 0)
		local pearl = head * CF(math.sin(t * 1.1) * 0.5 * k, 0.4 * k + math.sin(t * 2) * 0.3 * k, -4.2 * k * H)
		bones.pearl = pearl
		bones.pearlSpin = pearl * ANG(0.5, t * 2.2, 0)
		if rt < (rig.roarT or 0) then
			local cam = workspace.CurrentCamera
			if cam and (cam.CFrame.Position - head.Position).Magnitude < 160 then
				local mouthAt = (head * CF(0, -0.2 * k * H, -2.6 * k * H)).Position
				Fx.burst("glitter", mouthAt, rig.m.mane, 22, 1.6)
				Fx.burst("spark", mouthAt, Color3.fromRGB(120, 255, 220), 14, 1.3)
				Fx.flash(mouthAt, rig.m.mane, 30, 3, 0.4)
			end
		end
		rig.roarT = rt
		for _, s in ipairs({ -1, 1 }) do
			local tag = s < 0 and "L" or "R"
			local cf = head * CF(s * 0.5 * k * H, -0.05 * k * H, -2.2 * k * H) * ANG(0, s * 0.9, 0)
			for j = 1, 6 do
				bones["w" .. tag .. j] = cf
				cf = cf * CF(0, 0, 0.8 * k) * ANG(math.sin(t * 3 - j * 0.8) * (0.22 + 0.1 * rig.run), s * 0.1, 0)
			end
			local bc = head * CF(s * 0.55 * k * H, 0.8 * k * H, -0.3 * k * H) * ANG(0.5, s * 0.5, 0)
			for j = 1, 4 do
				bones["b" .. tag .. j] = bc
				bc = bc * CF(0, 0, 0.66 * k) * ANG(math.sin(t * 2.5 - j) * 0.2 - 0.05, s * 0.08, 0)
			end
		end
	end

	-- 조각을 뼈에 붙인다
	local run = rig.run
	for _, e in ipairs(rig.parts) do
		local b = bones[e.bone]
		if b then
			local cf = b
			local bob = e.bob
			if bob then
				cf = cf * CF(0, math.sin(t * bob[2] + bob[3]) * bob[1] * k, 0)
			end
			cf = cf * e.off
			local w = e.w
			if w then
				local a = math.sin(t * w[3] + w[4]) * (w[2] + w[5] * run)
				if w[1] == 1 then
					cf = cf * ANG(a, 0, 0)
				elseif w[1] == 2 then
					cf = cf * ANG(0, a, 0)
				else
					cf = cf * ANG(0, 0, a)
				end
			end
			e.p.CFrame = cf
		end
	end

	-- 고삐 (재갈 → 손), 등자 (안장 옆 → 발)
	local model = rig.model
	if #rig.reins > 0 and bones.head then
		local bitOff = rig.kind == "horse" and V(0.45, -0.5, -1.95) or V(0.55, -0.45, -0.75)
		for i, side in ipairs({ -1, 1 }) do
			local hand = model:FindFirstChild(side < 0 and "LeftHand" or "RightHand")
			local rein = rig.reins[i]
			if hand and hand:IsA("BasePart") and rein then
				local bit = bones.head * V(bitOff.X * side * k, bitOff.Y * k, bitOff.Z * k)
				span(rein, bit, hand.Position, 0.07 * k)
			end
		end
	end
	if #rig.straps > 0 and bones.body then
		for i, side in ipairs({ -1, 1 }) do
			local foot = model:FindFirstChild(side < 0 and "LeftFoot" or "RightFoot")
			local strap, iron = rig.straps[i], rig.irons[i]
			if foot and foot:IsA("BasePart") and strap and iron then
				local top = bones.body * V(side * 1.2 * k, -0.25 * k, -0.15 * k)
				local fp = foot.Position - V(0, foot.Size.Y / 2 + 0.05, 0)
				span(strap, top, fp, 0.08 * k)
				iron.CFrame = CF(fp) * turn
			end
		end
	end

	-- 나타날 때 0.3초에 걸쳐 짙어진다
	if not rig.shown then
		local prog = math.clamp((t - rig.born) / 0.3, 0, 1)
		for _, e in ipairs(rig.parts) do
			e.p.Transparency = lerp(1, e.alpha, prog)
		end
		if prog >= 1 then
			rig.shown = true
		end
	end
end

local warned = false
RunService.RenderStepped:Connect(function(dt: number)
	local t = os.clock()
	local cam = workspace.CurrentCamera
	for model, rig in pairs(rigs) do
		local root = model:FindFirstChild("HumanoidRootPart")
		local hum = model:FindFirstChildOfClass("Humanoid")
		if not root or not root:IsA("BasePart") or not hum or not model.Parent then
			clear(model)
			continue
		end
		-- 멀리 있는 탈것은 세 화면에 한 번만
		if cam and (cam.CFrame.Position - root.Position).Magnitude > 260 then
			rig.skip += 1
			if rig.skip % 3 ~= 0 then
				continue
			end
		end
		local ok, err = pcall(update, rig, root, hum, dt, t)
		if not ok then
			if not warned then
				warned = true
				warn("[권왕] 탈것 오류:", err)
			end
			clear(model)
		end
	end
end)

return Mount
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="23">
          <Properties>
            <string name="Name">Music</string>
            <string name="Source"><![CDATA[-- 권왕: 배경 음악. 있는 곳에 따라 바꾸고, 바뀔 때 천천히 겹쳐 넘긴다 (Config.MUSIC의 번호가 0이면 조용하다)
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local SoundService = game:GetService("SoundService")
local TweenService = game:GetService("TweenService")

local Config = require(ReplicatedStorage:WaitForChild("Config"))

local Music = {}
local current: Sound? = nil
local currentKey = ""
local muted = false

local function idOf(key: string): number
	local id = tonumber(Config.MUSIC[key]) or 0
	if id == 0 and key ~= "default" then
		return tonumber(Config.MUSIC.default) or 0
	end
	return id
end

-- key: village / default / boss / tower / 지역 id (snow, cult ...)
function Music.set(key: string)
	local id = idOf(key)
	local resolved = id == 0 and "" or tostring(id)
	if resolved == currentKey then
		return
	end
	currentKey = resolved
	local old = current
	current = nil
	if old then
		local o = old
		TweenService:Create(o, TweenInfo.new(1.5), { Volume = 0 }):Play()
		task.delay(1.6, function()
			o:Destroy()
		end)
	end
	if id == 0 then
		return
	end
	local s = Instance.new("Sound")
	s.Name = "KwonMusic"
	s.SoundId = "rbxassetid://" .. id
	s.Looped = true
	s.Volume = 0
	s.Parent = SoundService
	s:Play()
	current = s
	TweenService:Create(s, TweenInfo.new(2), { Volume = muted and 0 or Config.MUSIC.volume }):Play()
end

function Music.toggleMute(): boolean
	muted = not muted
	if current then
		current.Volume = muted and 0 or Config.MUSIC.volume
	end
	return muted
end

return Music
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="24">
          <Properties>
            <string name="Name">Polish</string>
            <string name="Source"><![CDATA[-- 권왕 1.7: 모든 권법의 기술 연출 보완 (수치는 그대로, 보이는 것만)
-- 권법마다 '속성의 서명'을 하나씩 둔다: 불은 불씨와 불혀, 물은 물방울 왕관, 번개는 잔 번개, 바람은 휘감는 바람결 …
--   (1.8판: 기술을 쓸 때 몸 앞에 피던 서명은 뺐다. 모든 기술이 비슷해 보였다. 쓸 때의 모양은 SkillFx가 기술마다 다르게)
--   · 기술로 맞힐 때마다 맞은 자리에 서명이 터진다 (타격 연출이 비어 있던 불·바다·일월·바람·취권은 평타에도)
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local Config = require(ReplicatedStorage:WaitForChild("Config"))
local Fx = require(script.Parent:WaitForChild("Fx"))

local Polish = {}

local folder = Instance.new("Folder")
folder.Name = "KwonPolish"
folder.Parent = workspace

local WHITE = Color3.new(1, 1, 1)
local live = 0
local MAX_LIVE = 500 -- 한꺼번에 떠 있는 조각 한도 (넘으면 새 서명은 줄여서)

local function tween(inst: Instance, time: number, goal: { [string]: any }, style: Enum.EasingStyle?, dir: Enum.EasingDirection?)
	TweenService:Create(inst, TweenInfo.new(time, style or Enum.EasingStyle.Quad, dir or Enum.EasingDirection.Out), goal):Play()
end
local function near(pos: Vector3, d: number): boolean
	local cam = workspace.CurrentCamera
	return cam ~= nil and (cam.CFrame.Position - pos).Magnitude < d
end
local function bit(size: Vector3, color: Color3, mat: Enum.Material?, alpha: number?, ball: boolean?, life: number?): Part
	local p = Instance.new("Part")
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	p.Size = size
	p.Color = color
	p.Material = mat or Enum.Material.Neon
	p.Transparency = alpha or 0
	if ball then
		local m = Instance.new("SpecialMesh")
		m.MeshType = Enum.MeshType.Sphere
		m.Parent = p
	end
	p.Parent = folder
	live += 1
	local l = life or 0.6
	task.delay(l + 0.05, function()
		live -= 1
		p:Destroy()
	end)
	return p
end
local function rnd(a: number, b: number): number
	return a + math.random() * (b - a)
end
local function randDir(upBias: number?): Vector3
	local v = Vector3.new(rnd(-1, 1), rnd(-0.3, 1) + (upBias or 0), rnd(-1, 1))
	return v.Magnitude > 0.01 and v.Unit or Vector3.new(0, 1, 0)
end

------------------------------------------------------------------------
-- 속성마다의 서명 (pos = 피어나는 자리, look = 앞 방향, s = 크기)
------------------------------------------------------------------------
local SIG: { [string]: (Vector3, Vector3, number, Color3, Color3) -> () } = {}

-- 불: 위로 튀는 불씨와, 사방으로 날름거리는 불혀
SIG.fire = function(pos, look, s, c, c2)
	Fx.burst("ember", pos, Color3.fromRGB(255, 150, 50), math.floor(10 * s), s)
	for k = 0, 5 do
		local d = (look * 0.6 + randDir(0.4)).Unit
		local t = bit(Vector3.new(0.5, 0.5, 2.2) * s, k % 2 == 0 and Color3.fromRGB(255, 120, 30) or Color3.fromRGB(255, 210, 90), Enum.Material.Neon, 0.1, false, 0.3)
		t.CFrame = CFrame.lookAt(pos, pos + d)
		tween(t, 0.28, { CFrame = CFrame.lookAt(pos + d * 4 * s, pos + d * 5 * s), Size = Vector3.new(0.1, 0.1, 3.6) * s, Transparency = 1 })
	end
	Fx.flash(pos, Color3.fromRGB(255, 140, 50), 16 * s, 2.5, 0.3)
end
-- 물: 물방울 왕관 (솟았다 떨어지는 물기둥 여덟 줄기)과 물결 고리
SIG.water = function(pos, look, s, c, c2)
	Fx.ring(pos - Vector3.new(0, 1.5, 0), c2, 1, 10 * s, 0.4)
	for k = 0, 7 do
		local a = k / 8 * math.pi * 2
		local d = Vector3.new(math.cos(a), 0, math.sin(a))
		local drop = bit(Vector3.new(0.45, 0.45, 0.45) * s, k % 2 == 0 and c2 or WHITE, Enum.Material.Glass, 0.15, true, 0.5)
		drop.Position = pos
		tween(drop, 0.22, { Position = pos + d * 2.4 * s + Vector3.new(0, 2.6 * s, 0) }, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
		task.delay(0.22, function()
			tween(drop, 0.25, { Position = pos + d * 3.6 * s - Vector3.new(0, 1.5, 0), Transparency = 1 }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
		end)
	end
end
SIG.ocean = function(pos, look, s, c, c2)
	SIG.water(pos, look, s, c, c2)
	-- 흰 물보라 띠가 앞으로 휘어 나간다
	for i = -3, 3 do
		local a = i / 3 * 0.9
		local d = (CFrame.lookAt(Vector3.zero, look) * CFrame.Angles(0, a, 0)).LookVector
		local f = bit(Vector3.new(1.2, 0.3, 1.2) * s, WHITE, Enum.Material.SmoothPlastic, 0.2, true, 0.4)
		f.Position = pos
		tween(f, 0.35, { Position = pos + d * 5 * s + Vector3.new(0, 1, 0), Size = Vector3.new(2.6, 0.2, 2.6) * s, Transparency = 1 })
	end
end
-- 번개: 맞은 자리에서 사방으로 튀는 잔 번개
SIG.lightning = function(pos, look, s, c, c2)
	for _ = 1, 3 do
		Fx.lightning(pos, pos + randDir(0.3) * rnd(4, 7) * s, c2, 0.4)
	end
	Fx.flash(pos, c, 18 * s, 3, 0.2)
end
-- 바람: 휘감아 도는 흰 바람결 여섯 줄
SIG.wind = function(pos, look, s, c, c2)
	for k = 0, 5 do
		local a0 = k / 6 * math.pi * 2
		local streak = bit(Vector3.new(0.12, 0.12, 3) * s, k % 2 == 0 and WHITE or c2, Enum.Material.Neon, 0.25, false, 0.4)
		local r = 2.2 * s
		local function at(a: number, y: number): CFrame
			local p = pos + Vector3.new(math.cos(a) * r, y, math.sin(a) * r)
			return CFrame.lookAt(p, p + Vector3.new(-math.sin(a), 0.2, math.cos(a)))
		end
		streak.CFrame = at(a0, -0.6)
		tween(streak, 0.35, { CFrame = at(a0 + 2.4, 1.6 * s), Transparency = 1 })
	end
	Fx.burst("dust", pos - Vector3.new(0, 1.5, 0), Color3.fromRGB(230, 235, 230), math.floor(6 * s), s)
end
-- 공허·아공·중력: 검은 구슬이 안으로 짓눌리며 둘레의 빛이 빨려 든다
local function implode(pos: Vector3, s: number, c: Color3, c2: Color3, dark: Color3)
	local ball = bit(Vector3.one * 4 * s, dark, Enum.Material.Neon, 0.2, true, 0.35)
	ball.Position = pos
	tween(ball, 0.3, { Size = Vector3.one * 0.3, Transparency = 0.6 }, Enum.EasingStyle.Back, Enum.EasingDirection.In)
	for k = 0, 7 do
		local d = randDir(0)
		local st = bit(Vector3.new(0.15, 0.15, 2) * s, k % 2 == 0 and c or c2, Enum.Material.Neon, 0.1, false, 0.3)
		st.CFrame = CFrame.lookAt(pos + d * 5 * s, pos)
		tween(st, 0.25, { CFrame = CFrame.lookAt(pos + d * 0.5, pos), Transparency = 1 }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
	end
end
SIG.void = function(pos, look, s, c, c2)
	implode(pos, s, c, c2, Color3.fromRGB(20, 15, 30))
end
SIG.subspace = function(pos, look, s, c, c2)
	implode(pos, s, c, c2, Color3.fromRGB(40, 10, 70))
	-- 어긋난 공간 조각 (네모가 흩어지며 사라진다)
	for _ = 1, 5 do
		local q = bit(Vector3.one * rnd(0.4, 1) * s, c2, Enum.Material.Glass, 0.3, false, 0.45)
		q.CFrame = CFrame.new(pos + randDir(0) * rnd(1, 3) * s) * CFrame.Angles(rnd(0, 6), rnd(0, 6), 0)
		tween(q, 0.4, { CFrame = q.CFrame * CFrame.new(0, 1, 0) * CFrame.Angles(1, 1, 0), Transparency = 1 })
	end
end
SIG.gravity = function(pos, look, s, c, c2)
	implode(pos, s, c, c2, Color3.fromRGB(30, 20, 50))
	Fx.ring(pos - Vector3.new(0, 1.8, 0), c, 12 * s, 1, 0.3)
end
-- 피: 붉은 안개와 핏방울
SIG.blood = function(pos, look, s, c, c2)
	Fx.burst("smoke", pos, Color3.fromRGB(150, 10, 20), math.floor(5 * s), 0.7 * s)
	for _ = 1, 7 do
		local d = bit(Vector3.one * 0.35 * s, Color3.fromRGB(190, 15, 25), Enum.Material.Neon, 0.1, true, 0.45)
		d.Position = pos
		local v = randDir(0.3) * rnd(2, 5) * s
		tween(d, 0.4, { Position = pos + v - Vector3.new(0, 2, 0), Transparency = 1 }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
	end
end
-- 꽃잎
SIG.petal = function(pos, look, s, c, c2)
	for _ = 1, math.floor(9 * s) do
		local p = bit(Vector3.new(0.7, 0.07, 0.5) * s, math.random() < 0.5 and c or c2, Enum.Material.SmoothPlastic, 0, true, 0.9)
		p.CFrame = CFrame.new(pos) * CFrame.Angles(rnd(0, 6), rnd(0, 6), rnd(0, 6))
		tween(p, 0.85, { CFrame = CFrame.new(pos + randDir(0.2) * rnd(2, 5) * s - Vector3.new(0, 1, 0)) * CFrame.Angles(rnd(0, 12), rnd(0, 12), rnd(0, 12)), Transparency = 1 }, Enum.EasingStyle.Sine)
	end
end
-- 용: 금빛 비늘이 나선으로 솟는다
SIG.dragon = function(pos, look, s, c, c2)
	for k = 0, 9 do
		local a = k / 10 * math.pi * 4
		local sc = bit(Vector3.new(0.7, 0.12, 0.5) * s, k % 2 == 0 and c or c2, Enum.Material.Neon, 0.1, false, 0.5)
		local p0 = pos + Vector3.new(math.cos(a) * 1.4 * s, -1 + k * 0.2, math.sin(a) * 1.4 * s)
		sc.CFrame = CFrame.lookAt(p0, pos)
		tween(sc, 0.45, { CFrame = CFrame.lookAt(p0 + Vector3.new(math.cos(a) * 2, 3 * s, math.sin(a) * 2), pos + Vector3.new(0, 4 * s, 0)), Transparency = 1 })
	end
end
-- 금강: 세로로 선 금빛 광륜
SIG.gold = function(pos, look, s, c, c2)
	local halo = bit(Vector3.new(0.3, 2, 2) * s, c, Enum.Material.Neon, 0.2, false, 0.4)
	halo.Shape = Enum.PartType.Cylinder
	halo.CFrame = CFrame.lookAt(pos, pos + look) * CFrame.Angles(0, math.rad(90), 0)
	tween(halo, 0.35, { Size = Vector3.new(0.1, 9, 9) * s, Transparency = 1 })
	Fx.burst("glitter", pos, c2, math.floor(8 * s), s)
end
-- 그림자: 검은 연기와 흩어지는 그림자 조각
SIG.shadow = function(pos, look, s, c, c2)
	Fx.burst("smoke", pos, Color3.fromRGB(25, 20, 35), math.floor(5 * s), 0.8 * s)
	for _ = 1, 5 do
		local q = bit(Vector3.new(0.9, 0.9, 0.1) * s, Color3.fromRGB(30, 25, 45), Enum.Material.SmoothPlastic, 0.2, false, 0.4)
		q.CFrame = CFrame.new(pos) * CFrame.Angles(rnd(0, 6), rnd(0, 6), 0)
		tween(q, 0.35, { CFrame = CFrame.new(pos + randDir(0) * 3 * s), Transparency = 1 })
	end
end
-- 별 (천상·은하·성하): 반짝 별빛 여섯이 켜졌다 꺼진다
local function stars(pos: Vector3, s: number, c: Color3, c2: Color3)
	for k = 0, 5 do
		local st = bit(Vector3.new(0.2, 1.6, 0.2) * s, k % 2 == 0 and WHITE or c2, Enum.Material.Neon, 0, false, 0.45)
		local at = pos + randDir(0.2) * rnd(1.2, 3.2) * s
		st.CFrame = CFrame.new(at) * CFrame.Angles(0, 0, math.rad(45 * (k % 2)))
		local st2 = bit(Vector3.new(0.2, 1.6, 0.2) * s, k % 2 == 0 and WHITE or c2, Enum.Material.Neon, 0, false, 0.45)
		st2.CFrame = st.CFrame * CFrame.Angles(0, 0, math.rad(90))
		for _, x in ipairs({ st, st2 }) do
			tween(x, 0.4, { Size = Vector3.new(0.05, 0.1, 0.05), Transparency = 1 }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
		end
	end
	Fx.burst("glitter", pos, c, math.floor(6 * s), s)
end
SIG.celestial = function(pos, look, s, c, c2)
	stars(pos, s, c, c2)
end
SIG.galaxy = function(pos, look, s, c, c2)
	stars(pos, s, c, c2)
	Fx.ring(pos, c, 1, 9 * s, 0.4, look)
end
SIG.cosmic = SIG.galaxy
-- 구름: 하얀 구름 뭉치가 부풀며 흩어진다
SIG.cloud = function(pos, look, s, c, c2)
	for _ = 1, 6 do
		local puff = bit(Vector3.one * rnd(1.2, 2.2) * s, Color3.fromRGB(250, 250, 255), Enum.Material.SmoothPlastic, 0.15, true, 0.6)
		puff.Position = pos + randDir(0) * s
		tween(puff, 0.55, { Position = puff.Position + randDir(0.4) * 2.5 * s, Size = puff.Size * 2.2, Transparency = 1 })
	end
end
-- 시간: 시계판 고리와 바늘 둘이 한 바퀴 돈다
SIG.time = function(pos, look, s, c, c2)
	local cf = CFrame.lookAt(pos, pos + look)
	Fx.ring(pos, c, 2 * s, 6 * s, 0.45, look)
	for i, len in ipairs({ 2.2, 1.4 }) do
		local hand = bit(Vector3.new(0.18, len * s, 0.1), i == 1 and c2 or WHITE, Enum.Material.Neon, 0.05, false, 0.45)
		local t0 = os.clock()
		local conn
		conn = RunService.Heartbeat:Connect(function()
			local t = os.clock() - t0
			if t > 0.4 or not hand.Parent then
				conn:Disconnect()
				return
			end
			local a = -t * (i == 1 and 14 or 5)
			hand.CFrame = cf * CFrame.Angles(0, 0, a) * CFrame.new(0, len * s / 2, 0)
			hand.Transparency = t / 0.4
		end)
	end
	for k = 0, 11 do
		local a = k / 12 * math.pi * 2
		local mark = bit(Vector3.new(0.12, 0.4, 0.1) * s, c2, Enum.Material.Neon, 0.1, false, 0.4)
		mark.CFrame = cf * CFrame.Angles(0, 0, a) * CFrame.new(0, 2.6 * s, 0)
		tween(mark, 0.4, { Transparency = 1 })
	end
end
-- 태초: 하얀 빛살 여덟 줄기
SIG.origin = function(pos, look, s, c, c2)
	for k = 0, 7 do
		local a = k / 8 * math.pi * 2
		local d = (CFrame.lookAt(Vector3.zero, look) * CFrame.Angles(0, 0, a)).UpVector
		local ray = bit(Vector3.new(0.18, 0.18, 0.5) * s, k % 2 == 0 and WHITE or c2, Enum.Material.Neon, 0, false, 0.3)
		ray.CFrame = CFrame.lookAt(pos, pos + d)
		tween(ray, 0.25, { CFrame = CFrame.lookAt(pos + d * 2.5 * s, pos + d * 3 * s), Size = Vector3.new(0.05, 0.05, 5 * s), Transparency = 1 })
	end
	Fx.flash(pos, WHITE, 18 * s, 3, 0.25)
end
-- 일월: 검은 해와 금빛 테 (일식의 코로나)
SIG.eclipse = function(pos, look, s, c, c2)
	local disc = bit(Vector3.new(0.2, 3, 3) * s, Color3.fromRGB(15, 10, 20), Enum.Material.SmoothPlastic, 0, false, 0.45)
	disc.Shape = Enum.PartType.Cylinder
	disc.CFrame = CFrame.lookAt(pos, pos + look) * CFrame.Angles(0, math.rad(90), 0)
	local rim = bit(Vector3.new(0.15, 3.6, 3.6) * s, Color3.fromRGB(255, 200, 90), Enum.Material.Neon, 0.1, false, 0.45)
	rim.Shape = Enum.PartType.Cylinder
	rim.CFrame = disc.CFrame * CFrame.new(-0.05, 0, 0)
	tween(disc, 0.4, { Size = Vector3.new(0.2, 4.5, 4.5) * s, Transparency = 1 })
	tween(rim, 0.4, { Size = Vector3.new(0.1, 7, 7) * s, Transparency = 1 })
end
-- 결투 (무쌍): 엇갈린 쇳빛 섬광
SIG.duel = function(pos, look, s, c, c2)
	local cf = CFrame.lookAt(pos, pos + look)
	for _, a in ipairs({ math.rad(40), math.rad(-40) }) do
		local l = bit(Vector3.new(0.15, 5 * s, 0.15), WHITE, Enum.Material.Neon, 0, false, 0.25)
		l.CFrame = cf * CFrame.Angles(0, 0, a)
		tween(l, 0.22, { Size = Vector3.new(0.05, 7 * s, 0.05), Transparency = 1 })
	end
	Fx.spark(pos, c, 1.2 * s, 8)
end
-- 삼재: 흙먼지와 작은 충격 고리
SIG.basic = function(pos, look, s, c, c2)
	Fx.burst("dust", pos - Vector3.new(0, 1.5, 0), Color3.fromRGB(200, 185, 160), math.floor(5 * s), s)
	Fx.ring(pos, c, 1, 7 * s, 0.25, look)
end
-- 취권: 술 방울 (초록빛 도는 투명한 알갱이)
SIG.drunk = function(pos, look, s, c, c2)
	for _ = 1, 7 do
		local d = bit(Vector3.one * 0.35 * s, Color3.fromRGB(215, 245, 225), Enum.Material.Glass, 0.25, true, 0.5)
		d.Position = pos
		tween(d, 0.45, { Position = pos + randDir(0.5) * rnd(2, 4) * s - Vector3.new(0, 1.5, 0), Transparency = 1 }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
	end
	Fx.flash(pos, c, 12 * s, 2, 0.2)
end

local function styleOf(id: any): any
	return type(id) == "string" and Config.STYLE_BY_ID[id] or nil
end
local function sig(style: any, pos: Vector3, look: Vector3, s: number)
	if not near(pos, 180) then
		return
	end
	if live > MAX_LIVE then
		s *= 0.5
		if live > MAX_LIVE * 1.4 then
			return
		end
	end
	local fn = SIG[style.fx] or SIG.basic
	fn(pos, look, s, style.color, style.color2)
end

------------------------------------------------------------------------
-- 맞힐 때 (handlers.hit에서): 기술이면 맞은 자리에 서명이 터진다
------------------------------------------------------------------------
local HIT_EMPTY: { [string]: boolean } = { fire = true, ocean = true, eclipse = true, wind = true, drunk = true }
function Polish.hit(styleId: any, pos: Vector3, heavy: boolean, skill: boolean, dir: Vector3?)
	local style = styleOf(styleId)
	if not style or not pos then
		return
	end
	local look = dir or Vector3.new(0, 0, -1)
	if skill then
		sig(style, pos, look, heavy and 1.4 or 1)
	elseif HIT_EMPTY[style.fx] then
		sig(style, pos, look, heavy and 0.9 or 0.6)
	end
end

return Polish
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="25">
          <Properties>
            <string name="Name">Reaper</string>
            <string name="Source"><![CDATA[-- 권왕 1.9판: 초월 권법 초·혈마신수의 화면
-- 오른손에 피처럼 붉은 큰 낫 (자루는 검붉고, 날은 핏빛으로 빛나며 끝에서 피가 떨어진다), 왼손엔 붉은 손톱
-- 몸짓마다 핏빛 초승달이 남고, 오의는 하늘만 한 피의 낫, 초 오의는 붉은 달과 하늘을 가르는 낫질
local Lighting = game:GetService("Lighting")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local Config = require(ReplicatedStorage:WaitForChild("Config"))
local Fx = require(script.Parent:WaitForChild("Fx"))
local Demon = require(script.Parent:WaitForChild("Demon"))

local Reaper = {}
local player = Players.LocalPlayer

local RED = Color3.fromRGB(220, 20, 40)
local BLOOD = Color3.fromRGB(150, 0, 18)
local PALE = Color3.fromRGB(255, 170, 170)
local SHAFT = Color3.fromRGB(38, 10, 14)
local WHITE = Color3.new(1, 1, 1)
local TEX_SPARK = "rbxasset://textures/particles/sparkles_main.dds"

local folder = Instance.new("Folder")
folder.Name = "KwonReaper"
folder.Parent = workspace

local function tween(inst: Instance, time: number, goal: { [string]: any }, style: Enum.EasingStyle?, dir: Enum.EasingDirection?)
	local tw = TweenService:Create(inst, TweenInfo.new(time, style or Enum.EasingStyle.Quad, dir or Enum.EasingDirection.Out), goal)
	tw:Play()
	return tw
end
local function rootOf(m: Instance?): BasePart?
	local r = m and m:FindFirstChild("HumanoidRootPart")
	return (r and r:IsA("BasePart")) and r or nil
end
local function near(pos: Vector3, d: number): boolean
	local cam = workspace.CurrentCamera
	return cam ~= nil and (cam.CFrame.Position - pos).Magnitude < d
end
local function flat(v: Vector3): Vector3
	local f = Vector3.new(v.X, 0, v.Z)
	return f.Magnitude > 1e-3 and f.Unit or Vector3.new(0, 0, -1)
end
local function part(size: Vector3, color: Color3, material: Enum.Material?, alpha: number?, shape: string?): Part
	local p = Instance.new("Part")
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	p.Size = size
	p.Color = color
	p.Material = material or Enum.Material.Neon
	p.Transparency = alpha or 0
	if shape == "ball" then
		p.Shape = Enum.PartType.Ball
	elseif shape == "cyl" then
		p.Shape = Enum.PartType.Cylinder
	end
	p.Parent = folder
	return p
end
local function fadeOut(p: BasePart, time: number, goal: { [string]: any }?)
	local g = goal or {}
	g.Transparency = 1
	tween(p, time, g)
	task.delay(time + 0.05, function()
		p:Destroy()
	end)
end
local function ground(at: Vector3): Vector3
	return Vector3.new(at.X, at.Y - 2.7, at.Z)
end

local opts: any = {}
function Reaper.init(o: any)
	opts = o or {}
end
local function shakeNear(pos: Vector3, amount: number, range: number)
	if opts.shake and near(pos, range) then
		opts.shake(amount)
	end
end

------------------------------------------------------------------------
-- 큰 낫 (오른손). 손 기준: 자루는 주먹을 꿰뚫는 Z 축, +Z 끝에 날, -Z 끝에 붉은 물미
------------------------------------------------------------------------
local function attach(p: BasePart, to: BasePart, cf: CFrame, holder: Instance, list: { Instance })
	p.Massless = true
	p.Anchored = false
	p.CFrame = to.CFrame * cf
	local w = Instance.new("WeldConstraint")
	w.Part0 = to
	w.Part1 = p
	w.Parent = p
	p.Parent = holder
	table.insert(list, p)
end
local AXIS_Z = CFrame.Angles(0, math.rad(90), 0) -- 원기둥의 축(X)을 손의 Z로
local SHAFT_BACK, SHAFT_FRONT = 2.0, 4.6
-- 날 머리를 자루 둘레로 돌린 각도 (1.9.3판: 옆으로 뻗던 날을 90도 돌려, 치켜든 자세에서 날이 앞으로 드리우게)
local HEAD_ROLL = -90
local HEAD = CFrame.Angles(0, 0, math.rad(HEAD_ROLL))
local function buildScythe(hand: BasePart, holder: Instance, list: { Instance })
	local len = SHAFT_BACK + SHAFT_FRONT
	local mid = (SHAFT_FRONT - SHAFT_BACK) / 2
	-- 자루: 검붉은 나무, 붉은 천을 감은 띠 셋
	attach(part(Vector3.new(len, 0.34, 0.34), SHAFT, Enum.Material.Wood, 0, "cyl"), hand, CFrame.new(0, 0, mid) * AXIS_Z, holder, list)
	for _, z in ipairs({ -1.2, 1.6, 3.4 }) do
		attach(part(Vector3.new(0.32, 0.4, 0.4), BLOOD, Enum.Material.Fabric, 0, "cyl"), hand, CFrame.new(0, 0, z) * AXIS_Z, holder, list)
	end
	-- 물미: 붉게 빛나는 뾰족한 끝
	local butt = part(Vector3.new(0.3, 0.3, 0.9), RED, Enum.Material.Neon, 0)
	attach(butt, hand, CFrame.new(0, 0, -SHAFT_BACK - 0.35), holder, list)
	-- 날 머리: 검은 쇠 고리 + 붉은 눈 (빛)
	local head = part(Vector3.new(0.5, 0.55, 0.55), Color3.fromRGB(25, 20, 22), Enum.Material.Metal, 0)
	attach(head, hand, HEAD * CFrame.new(0, 0, SHAFT_FRONT), holder, list)
	local eye = part(Vector3.new(0.28, 0.28, 0.28), RED, Enum.Material.Neon, 0, "ball")
	eye.Name = "ReaperEye"
	attach(eye, hand, HEAD * CFrame.new(0, 0.3, SHAFT_FRONT), holder, list)
	local glow = Instance.new("PointLight")
	glow.Color = RED
	glow.Range = 8
	glow.Brightness = 1.2
	glow.Parent = eye
	-- 날: 자루에서 옆(-X)으로 뻗다가 자루 쪽(-Z)으로 휘어 내려간다. 날 끝으로 갈수록 가늘어진다
	local p = Vector3.new(0, 0, SHAFT_FRONT + 0.15)
	local dir = Vector3.new(-1, 0, 0)
	local n = 8
	for k = 1, n do
		local segLen = 0.85
		local width = 0.95 - (k - 1) * 0.1
		local c = p + dir * (segLen / 2)
		local cf = CFrame.lookAt(c, c + dir, Vector3.new(0, 1, 0))
		-- 등 (검붉은 쇠)과 날 (핏빛으로 빛나는 가장자리)
		attach(part(Vector3.new(width, 0.12, segLen * 1.08), Color3.fromRGB(110, 8, 20), Enum.Material.Metal, 0), hand, HEAD * cf * CFrame.new(-width * 0.15, 0, 0), holder, list)
		local edge = part(Vector3.new(0.14, 0.13, segLen * 1.1), RED, Enum.Material.Neon, 0)
		attach(edge, hand, HEAD * cf * CFrame.new(width * 0.38, 0, 0), holder, list)
		if k == n then
			edge.Name = "ReaperTip"
		end
		p += dir * segLen
		dir = (CFrame.Angles(0, math.rad(-11), 0) * CFrame.new(dir)).Position
		dir = dir.Unit
	end
	-- 머리에서 늘어진 짧은 쇠사슬
	for k = 1, 4 do
		attach(part(Vector3.new(0.22, 0.32, 0.22), Color3.fromRGB(60, 50, 55), Enum.Material.Metal, 0, "ball"), hand, HEAD * CFrame.new(0.15, -0.3 - k * 0.3, SHAFT_FRONT - 0.2), holder, list)
	end
end
-- 왼손: 붉은 손톱 셋
local function buildClaws(hand: BasePart, holder: Instance, list: { Instance })
	for i = -1, 1 do
		local c = part(Vector3.new(0.12, 0.75, 0.12), RED, Enum.Material.Neon, 0.1)
		attach(c, hand, CFrame.new(i * 0.18, -hand.Size.Y / 2 - 0.3, -0.1) * CFrame.Angles(math.rad(-20), 0, math.rad(i * 8)), holder, list)
	end
end

local tips: { [Model]: BasePart } = {}
-- 몸 하나에 낫과 손톱을 만든다 (Sakura가 부채와 같은 자리에서 부른다)
function Reaper.build(model: Model): { Instance }
	local out: { Instance } = {}
	local holder = Instance.new("Folder")
	holder.Name = "Reaper_" .. model.Name
	holder.Parent = folder
	table.insert(out, holder)
	local hand = model:FindFirstChild("RightHand")
	if hand and hand:IsA("BasePart") then
		buildScythe(hand, holder, out)
	end
	local lh = model:FindFirstChild("LeftHand")
	if lh and lh:IsA("BasePart") then
		buildClaws(lh, holder, out)
	end
	for _, p in ipairs(out) do
		if p.Name == "ReaperTip" and p:IsA("BasePart") then
			tips[model] = p
			-- 날 끝에서 피가 똑똑 떨어진다
			local a = Instance.new("Attachment")
			a.Parent = p
			local e = Instance.new("ParticleEmitter")
			e.Texture = TEX_SPARK
			e.Color = ColorSequence.new(RED, BLOOD)
			e.LightEmission = 0.4
			e.Rate = 6
			e.Lifetime = NumberRange.new(0.5, 0.9)
			e.Speed = NumberRange.new(0, 1)
			e.Acceleration = Vector3.new(0, -30, 0)
			e.Size = NumberSequence.new(0.22, 0.05)
			e.Transparency = NumberSequence.new(0, 0.4)
			e.Parent = a
		end
	end
	return out
end
function Reaper.tipOf(model: Model): Vector3?
	local p = tips[model]
	return (p and p.Parent) and p.Position or nil
end
RunService.Heartbeat:Connect(function()
	for m, p in pairs(tips) do
		if not p.Parent or not m.Parent then
			tips[m] = nil
		end
	end
end)

------------------------------------------------------------------------
-- 핏빛 초승달 (몸짓의 궤적): 몸 둘레에 기울어진 호를 조각으로 그린다
------------------------------------------------------------------------
local function crescent(center: CFrame, radius: number, from: number, to: number, thick: number, life: number, color: Color3?, segs: number?)
	local n = segs or math.clamp(math.floor(math.abs(to - from) / 12), 6, 30)
	for i = 0, n - 1 do
		local a0 = math.rad(from + (to - from) * i / n)
		local a1 = math.rad(from + (to - from) * (i + 1) / n)
		local p0 = center * Vector3.new(math.sin(a0) * radius, 0, -math.cos(a0) * radius)
		local p1 = center * Vector3.new(math.sin(a1) * radius, 0, -math.cos(a1) * radius)
		-- 가운데가 가장 두껍고 양 끝이 가늘다
		local u = (i + 0.5) / n
		local w = thick * math.sin(u * math.pi) + 0.08
		local seg = part(Vector3.new(w, 0.12, (p1 - p0).Magnitude * 1.15), (color or RED):Lerp(WHITE, (1 - math.sin(u * math.pi)) * 0.3), Enum.Material.Neon, 0.05)
		seg.CFrame = CFrame.lookAt((p0 + p1) / 2, p1, center.UpVector)
		task.delay(i * 0.006, function()
			fadeOut(seg, life, { Size = Vector3.new(w * 0.3, 0.05, seg.Size.Z) })
		end)
	end
end
-- 그 몸짓의 호: 기울기(tilt, 0 = 수평), 시작·끝 각도
local ARCS: { [string]: { tilt: number, from: number, to: number, at: number, r: number } } = {
	["1"] = { tilt = 55, from = -100, to = 80, at = 0.42, r = 6 },
	["2"] = { tilt = -55, from = 90, to = -90, at = 0.42, r = 6 },
	["3"] = { tilt = 4, from = 0, to = 720, at = 0.2, r = 7.5 },
	["4"] = { tilt = 90, from = -60, to = 120, at = 0.5, r = 7 },
	H = { tilt = 6, from = 0, to = 720, at = 0.3, r = 9 },
	F = { tilt = 90, from = 140, to = -40, at = 0.4, r = 6.5 },
}
function Reaper.cast(styleId: any, slot: any, model: Model, dur: number)
	local st = type(styleId) == "string" and Config.STYLE_BY_ID[styleId] or nil
	if not st or not st.scythe then
		return
	end
	local arc = ARCS[tostring(slot)]
	local r = rootOf(model)
	if not arc or not r or not near(r.Position, 160) then
		return
	end
	task.delay(dur * arc.at, function()
		local rr = rootOf(model)
		if not rr then
			return
		end
		local look = flat(rr.CFrame.LookVector)
		local base = CFrame.lookAt(rr.Position + Vector3.new(0, 0.6, 0), rr.Position + Vector3.new(0, 0.6, 0) + look)
		local cf = base * CFrame.Angles(0, 0, math.rad(arc.tilt))
		local spin = math.abs(arc.to - arc.from) > 360
		crescent(cf, arc.r, arc.from, spin and arc.from + 340 or arc.to, slot == "H" and 1.4 or 1.0, spin and 0.35 or 0.28)
		if spin then
			task.delay(dur * 0.3, function()
				crescent(cf * CFrame.Angles(0, math.rad(20), 0), arc.r * 1.1, arc.from, arc.from + 340, 1.0, 0.3, PALE)
			end)
		end
		Fx.burst("spark", rr.Position + look * 3, RED, 8, 1.1)
		if slot == "H" or slot == 4 or slot == "4" then
			Fx.ring(ground(rr.Position) + look * 3 + Vector3.new(0, 0.3, 0), RED, 2, 16, 0.4)
		end
		Fx.sound("swing", 0.7, 0.75, rr.Position)
	end)
end

------------------------------------------------------------------------
-- 혈사슬: 낫이 사슬을 끌고 날아가 적을 낚아 끌어온다. 끌려오는 동안 사슬이 팽팽하다
------------------------------------------------------------------------
local function chainBetween(a: Vector3, b: Vector3, links: { BasePart })
	local n = #links
	for i, l in ipairs(links) do
		local p = a:Lerp(b, (i - 0.5) / n)
		l.CFrame = CFrame.lookAt(p, b) * CFrame.Angles(0, 0, (i % 2) * math.rad(90))
	end
end
local function reapHook(data: any)
	local m: Model? = data.m
	local r0 = rootOf(m)
	if not r0 then
		return
	end
	local root = r0 :: BasePart
	local targets: { Model } = data.targets or {}
	local delay = data.delay or 0.2
	local pull = data.pull or 0.3
	Fx.sound("deflect", 0.8, 0.6, root.Position)
	for _, t in ipairs(targets) do
		local tr = rootOf(t)
		if tr then
			local troot = tr :: BasePart
			local links: { BasePart } = {}
			for _ = 1, 14 do
				table.insert(links, part(Vector3.new(0.18, 0.4, 0.75), Color3.fromRGB(70, 55, 60), Enum.Material.Metal, 0))
			end
			-- 날아가는 낫 머리
			local hook = part(Vector3.new(0.4, 2.2, 1.6), RED, Enum.Material.Neon, 0)
			local t0 = os.clock()
			local conn: RBXScriptConnection
			conn = RunService.RenderStepped:Connect(function()
				local t = os.clock() - t0
				local hand = m and m:FindFirstChild("RightHand")
				local from = (hand and hand:IsA("BasePart")) and hand.Position or root.Position
				local to = troot.Parent and troot.Position or from
				local reach = math.clamp(t / delay, 0, 1)
				local head = from:Lerp(to, reach)
				if t > delay + pull + 0.15 or not troot.Parent then
					conn:Disconnect()
					for _, l in ipairs(links) do
						fadeOut(l, 0.15)
					end
					fadeOut(hook, 0.15)
					return
				end
				chainBetween(from, head, links)
				hook.CFrame = CFrame.lookAt(head, head + (head - from).Unit) * CFrame.Angles(0, 0, t * 20)
			end)
			task.delay(delay, function()
				if troot.Parent then
					Fx.burst("spark", troot.Position, RED, 14, 1.2)
					local splat = part(Vector3.new(1, 1, 1), BLOOD, Enum.Material.Neon, 0.2, "ball")
					splat.CFrame = CFrame.new(troot.Position)
					fadeOut(splat, 0.3, { Size = Vector3.new(5, 5, 5) })
					Fx.sound("hit", 0.7, 0.8, troot.Position)
				end
			end)
		end
	end
end
-- 한 바퀴 돌며 베기 (혈사슬의 끝)
local function reapSpin(data: any)
	local r = rootOf(data.m)
	if not r then
		return
	end
	local rad = data.radius or 9
	local base = CFrame.new(r.Position + Vector3.new(0, 0.5, 0))
	crescent(base, rad * 0.8, 0, 340, 1.5, 0.35)
	crescent(base * CFrame.Angles(0, math.rad(25), 0), rad * 0.95, 0, 340, 0.9, 0.4, PALE)
	Fx.ring(ground(r.Position) + Vector3.new(0, 0.3, 0), RED, 2, rad * 2.2, 0.45)
	Fx.burst("spark", r.Position, RED, 20, 1.4)
	Fx.sound("swing", 1, 0.6, r.Position)
	shakeNear(r.Position, 0.5, 40)
end

------------------------------------------------------------------------
-- 혈월낙참: 앞의 땅에 새겨지는 핏빛 초승달 자국, 한 박자 뒤 터진다
------------------------------------------------------------------------
local function reapScar(data: any)
	local at: Vector3 = data.at
	local dir: Vector3 = data.dir or Vector3.new(0, 0, -1)
	local len = data.length or 22
	local width = data.width or 8
	local g = ground(at) + Vector3.new(0, 0.15, 0)
	-- 초승달: 길게 휜 호를 땅에 눕힌다
	local base = CFrame.lookAt(g, g + dir) * CFrame.new(0, 0, len * 0.35)
	local segs: { BasePart } = {}
	local n = 16
	local R = len * 0.75
	for i = 0, n - 1 do
		local u0, u1 = i / n, (i + 1) / n
		local a0 = math.rad(-40 + 80 * u0)
		local a1 = math.rad(-40 + 80 * u1)
		local p0 = base * Vector3.new(math.sin(a0) * R, 0, -math.cos(a0) * R + R * 0.7)
		local p1 = base * Vector3.new(math.sin(a1) * R, 0, -math.cos(a1) * R + R * 0.7)
		local w = width * 0.55 * math.sin((u0 + u1) / 2 * math.pi) + 0.3
		local s = part(Vector3.new(w, 0.2, (p1 - p0).Magnitude * 1.1), RED, Enum.Material.Neon, 0.1)
		s.CFrame = CFrame.lookAt((p0 + p1) / 2, p1)
		table.insert(segs, s)
	end
	-- 내리꽂힌 자리 (가운데 앞)
	Fx.ring(g + dir * 2, RED, 2, width * 2.5, 0.4)
	Fx.burst("dust", g + dir * 2 + Vector3.new(0, 0.5, 0), Color3.fromRGB(110, 60, 60), 18, 1.6)
	Fx.debris(g + dir * 2, 5, 20, Color3.fromRGB(90, 50, 50))
	Fx.sound("heavy", 1, 0.7, at)
	shakeNear(at, 1.0, 60)
	task.delay(data.burst or 0.45, function()
		-- 자국을 따라 피의 기둥이 솟는다
		for i, s in ipairs(segs) do
			if i % 2 == 1 then
				local col = part(Vector3.new(14, 1.8, 1.8), RED, Enum.Material.Neon, 0.1, "cyl")
				col.CFrame = CFrame.new(s.Position + Vector3.new(0, 7, 0)) * CFrame.Angles(0, 0, math.rad(90))
				fadeOut(col, 0.45, { Size = Vector3.new(18, 0.3, 0.3) })
			end
			fadeOut(s, 0.5)
		end
		Fx.burst("spark", at + Vector3.new(0, 2, 0), RED, 30, 2)
		Fx.flash(at, RED, 40, 4, 0.5)
		Fx.sound("splash", 0.8, 0.6, at)
		shakeNear(at, 0.8, 60)
	end)
end

------------------------------------------------------------------------
-- 혈마수확: 등 뒤로 하늘만 한 피의 낫이 솟아 둘레를 휩쓴다
------------------------------------------------------------------------
local function bigScythe(scale: number): Model
	local m = Instance.new("Model")
	m.Name = "BloodScythe"
	local function add(p: BasePart, cf: CFrame)
		p.CFrame = cf
		p.Parent = m
	end
	-- 원점 = 자루 아래 끝 (Y 위로 자루, 꼭대기에서 날이 -X로 뻗어 아래로 휜다)
	local h = 30 * scale
	local shaft = part(Vector3.new(h, 1.4 * scale, 1.4 * scale), Color3.fromRGB(60, 0, 10), Enum.Material.Neon, 0.25, "cyl")
	add(shaft, CFrame.new(0, h / 2, 0) * CFrame.Angles(0, 0, math.rad(90)))
	local p = Vector3.new(0, h, 0)
	local dir = Vector3.new(-1, 0.1, 0).Unit
	for k = 1, 10 do
		local segLen = 2.6 * scale
		local width = (3.2 - k * 0.26) * scale
		local c = p + dir * (segLen / 2)
		local cf = CFrame.lookAt(c, c + dir, Vector3.new(0, 0, 1))
		add(part(Vector3.new(width, 0.4 * scale, segLen * 1.1), RED, Enum.Material.Neon, 0.15), cf)
		add(part(Vector3.new(0.4 * scale, 0.45 * scale, segLen * 1.12), WHITE, Enum.Material.Neon, 0.2), cf * CFrame.new(width * 0.45, 0, 0))
		p += dir * segLen
		dir = (CFrame.Angles(0, 0, math.rad(11)) * CFrame.new(dir)).Position.Unit
	end
	m.WorldPivot = CFrame.new()
	m.Parent = folder
	return m
end
local function harvest(data: any)
	local mdl: Model? = data.m
	local r0 = rootOf(mdl)
	if not r0 then
		return
	end
	local root = r0 :: BasePart
	local R = data.radius or 26
	local delay = data.delay or 0.45
	local sweeps = data.sweeps or 2
	local sweepTime = data.sweepTime or 0.55
	local scale = R / 26
	local sc = bigScythe(scale)
	local g = ground(root.Position)
	-- 땅에서 솟는다 (등 뒤)
	local look = flat(root.CFrame.LookVector)
	local yaw0 = math.atan2(-look.X, -look.Z)
	local t0 = os.clock()
	local rim = part(Vector3.new(0.2, R * 2, R * 2), BLOOD, Enum.Material.Neon, 0.6, "cyl")
	rim.CFrame = CFrame.new(g + Vector3.new(0, 0.1, 0)) * CFrame.Angles(0, 0, math.rad(90))
	Fx.sound("deflect", 1, 0.4, root.Position)
	if opts.tint and near(root.Position, 90) then
		opts.tint(Color3.fromRGB(140, 0, 20), 0.3, delay + sweeps * sweepTime)
	end
	local conn: RBXScriptConnection
	conn = RunService.RenderStepped:Connect(function()
		local t = os.clock() - t0
		local c = root.Parent and ground(root.Position) or g
		local cf: CFrame
		if t < delay then
			-- 등 뒤에서 땅을 뚫고 솟는다
			local u = t / delay
			cf = CFrame.new(c) * CFrame.Angles(0, yaw0, 0) * CFrame.new(0, -30 * scale * (1 - u), R * 0.3) * CFrame.Angles(math.rad(-15), 0, 0)
		else
			-- 둘레를 휩쓴다: 자루가 기울어 날이 땅을 스치듯 돈다
			local u = math.clamp((t - delay) / (sweeps * sweepTime), 0, 1)
			local yaw = yaw0 - u * sweeps * math.pi * 2
			cf = CFrame.new(c) * CFrame.Angles(0, yaw, 0) * CFrame.new(0, 0, 0) * CFrame.Angles(0, 0, math.rad(62)) * CFrame.new(0, -2 * scale, 0)
		end
		sc:PivotTo(cf)
		if t > delay + sweeps * sweepTime then
			conn:Disconnect()
			-- 땅에 꽂는다
			sc:PivotTo(CFrame.new(c) * CFrame.Angles(0, yaw0, 0) * CFrame.new(0, -4 * scale, R * 0.5) * CFrame.Angles(math.rad(-25), 0, 0))
			for _, p in ipairs(sc:GetChildren()) do
				if p:IsA("BasePart") then
					fadeOut(p, 0.9)
				end
			end
			task.delay(1, function()
				sc:Destroy()
			end)
			fadeOut(rim, 0.6)
			Fx.ring(c + Vector3.new(0, 0.3, 0), RED, 4, R * 2.2, 0.6)
			Fx.burst("dust", c + Vector3.new(0, 0.5, 0), Color3.fromRGB(110, 50, 50), 30, 2.4)
			Fx.sound("heavy", 1, 0.5, c)
			shakeNear(c, 1.6, 80)
		end
	end)
	-- 휩쓸 때마다 핏빛 호
	for k = 1, sweeps do
		task.delay(delay + (k - 1) * sweepTime, function()
			if root.Parent then
				crescent(CFrame.new(root.Position + Vector3.new(0, 0.3, 0)), R * 0.85, 0, 350, 2.2, sweepTime, k % 2 == 0 and PALE or RED)
				Fx.sound("swing", 1, 0.45, root.Position)
			end
		end)
	end
end
-- 낙인이 한꺼번에 터진다 (베인 적마다 핏빛 폭발)
local function harvestBurst(data: any)
	for _, t in ipairs(data.targets or {}) do
		local tr = rootOf(t)
		if tr then
			local p = tr.Position
			local b = part(Vector3.new(1, 1, 1), RED, Enum.Material.Neon, 0.1, "ball")
			b.CFrame = CFrame.new(p)
			fadeOut(b, 0.4, { Size = Vector3.new(11, 11, 11) })
			local col = part(Vector3.new(16, 2, 2), BLOOD, Enum.Material.Neon, 0.1, "cyl")
			col.CFrame = CFrame.new(p + Vector3.new(0, 6, 0)) * CFrame.Angles(0, 0, math.rad(90))
			fadeOut(col, 0.5, { Size = Vector3.new(22, 0.3, 0.3) })
			Fx.burst("spark", p, RED, 20, 1.6)
		end
	end
	if data.at then
		Fx.flash(data.at, RED, 60, 6, 0.7)
		shakeNear(data.at, 1.4, 80)
	end
	Fx.sound("splash", 1, 0.5, data.at)
end

------------------------------------------------------------------------
-- 혈월만겸 (초 오의): 붉은 달이 뜨고, 핏빛 초승달이 쏟아지고, 마지막에 하늘과 땅과 화면을 가른다
------------------------------------------------------------------------
local moonState: { cc: ColorCorrectionEffect?, moon: BasePart?, untilT: number } = { untilT = 0 }
-- 2.1판: 혈월의 우두머리 악마 (쓴 사람마다 하나). 낫을 머리 뒤로 치켜들고 있다가 휘두른다
type Alpha = { h: Demon.Handle, swingAt: number, swingDur: number, swingTo: number, slam: boolean }
local alphas: { [Instance]: Alpha } = {}
local RAISED = 3.5 -- 머리 뒤로 치켜든 팔
local function alphaArm(a: Alpha, t: number): number
	local u = (os.clock() - a.swingAt) / a.swingDur
	if u < 0 or u > 2.2 then
		return RAISED + math.sin(t * 2) * 0.08
	end
	if u <= 1 then
		-- 내리찍기 (빠르게)
		return RAISED + (a.swingTo - RAISED) * (u * u)
	end
	-- 다시 치켜든다 (천천히). 마지막 일격은 내리찍은 채로 머문다
	if a.slam then
		return a.swingTo
	end
	local k = (u - 1) / 1.2
	return a.swingTo + (RAISED - a.swingTo) * (1 - (1 - k) ^ 2)
end
local function alphaSwing(m: Instance?, to: number, dur: number, slam: boolean)
	local a = m and alphas[m]
	if not a then
		return
	end
	local busy = (os.clock() - a.swingAt) < a.swingDur * 2.2
	if busy and not slam then
		return
	end
	a.swingAt = os.clock()
	a.swingDur = dur
	a.swingTo = to
	a.slam = slam
end
local function alphaRise(m: Model, r: BasePart)
	local old = alphas[m]
	if old then
		Demon.remove(old.h, 0.2)
	end
	local look = flat(r.CFrame.LookVector)
	local back = r.Position - look * 24
	local g = ground(back)
	local base = CFrame.lookAt(g, g + look)
	local sc = 4.2
	local dm = Demon.spawn(base * CFrame.new(0, -11 * sc, 0), sc, { scythe = true, wings = true })
	local a: Alpha = { h = dm, swingAt = -100, swingDur = 0.3, swingTo = 1, slam = false }
	alphas[m] = a
	dm.armR = RAISED
	dm.anim = function(t: number)
		local rise = math.clamp(t / 1.1, 0, 1)
		rise = 1 - (1 - rise) ^ 3
		dm.root = base * CFrame.new(0, -11 * sc * (1 - rise) + math.sin(t * 1.6) * 0.35 * sc, 0) * CFrame.Angles(math.rad(-6), 0, 0)
		dm.armR = alphaArm(a, t)
		-- 왼팔은 앞으로 벌려 손톱을 세운다
		dm.armL = 1.0 + math.sin(t * 2.4) * 0.15
	end
	-- 피의 원에서 솟는다
	Fx.ring(g + Vector3.new(0, 0.3, 0), RED, 6, 50, 0.9)
	Fx.burst("spark", g + Vector3.new(0, 4, 0), RED, 40, 3)
	Fx.sound("heavy", 1, 0.35, g)
	-- 끝내 마지막 일격이 오지 않아도 사라진다
	task.delay(12, function()
		if alphas[m] == a then
			alphas[m] = nil
			Demon.remove(dm, 0.8)
		end
	end)
end
local function moonRise(data: any)
	local r = rootOf(data.m)
	if not r or not near(r.Position, 220) then
		return
	end
	local dur = data.dur or 3.4
	moonState.untilT = math.max(moonState.untilT, os.clock() + dur)
	alphaRise(data.m, r)
	-- 하늘이 핏빛으로 (보는 사람 화면만)
	local cc = moonState.cc
	if not cc or not cc.Parent then
		local e = Instance.new("ColorCorrectionEffect")
		e.Name = "KwonBloodMoon"
		e.Parent = Lighting
		moonState.cc = e
		cc = e
	end
	local ccx = cc :: ColorCorrectionEffect
	tween(ccx, 0.5, { TintColor = Color3.fromRGB(255, 150, 150), Saturation = 0.3, Contrast = 0.25, Brightness = -0.08 })
	-- 붉은 달: 쓴 사람 뒤 하늘 높이
	local look = flat(r.CFrame.LookVector)
	local moonAt = r.Position - look * 120 + Vector3.new(0, 90, 0)
	local moon = part(Vector3.new(1, 1, 1), Color3.fromRGB(200, 20, 30), Enum.Material.Neon, 0.05, "ball")
	moon.CFrame = CFrame.new(moonAt)
	tween(moon, 0.8, { Size = Vector3.new(70, 70, 70) }, Enum.EasingStyle.Back)
	local halo = part(Vector3.new(1, 1, 1), Color3.fromRGB(255, 80, 80), Enum.Material.ForceField, 0.3, "ball")
	halo.CFrame = CFrame.new(moonAt)
	tween(halo, 1.0, { Size = Vector3.new(100, 100, 100) })
	local l = Instance.new("PointLight")
	l.Color = RED
	l.Range = 60
	l.Brightness = 2
	l.Parent = moon
	-- 발밑의 붉은 원
	local g = ground(r.Position)
	local rim = part(Vector3.new(0.2, 1, 1), BLOOD, Enum.Material.Neon, 0.4, "cyl")
	rim.CFrame = CFrame.new(g + Vector3.new(0, 0.1, 0)) * CFrame.Angles(0, 0, math.rad(90))
	tween(rim, 0.6, { Size = Vector3.new(0.2, (data.range or 40) * 2, (data.range or 40) * 2) })
	Fx.sound("deflect", 1, 0.3, r.Position)
	task.delay(dur, function()
		fadeOut(moon, 0.8)
		fadeOut(halo, 0.6)
		fadeOut(rim, 0.6)
		task.delay(0.1, function()
			if os.clock() >= moonState.untilT - 0.05 and moonState.cc then
				local c2 = moonState.cc :: ColorCorrectionEffect
				tween(c2, 0.8, { TintColor = WHITE, Saturation = 0, Contrast = 0, Brightness = 0 })
				task.delay(0.85, function()
					if os.clock() >= moonState.untilT and moonState.cc == c2 then
						c2:Destroy()
						moonState.cc = nil
					end
				end)
			end
		end)
	end)
	moonState.moon = moon
end
-- 하늘에서 떨어지는 핏빛 초승달 하나하나
local function moonSlash(data: any)
	-- 우두머리 악마가 초승달마다 낫을 한 번씩 휘두른다 (휘두르는 중이면 건너뛴다)
	alphaSwing(data.m, 1.3, 0.22, false)
	for _, at in ipairs(data.spots or {}) do
		if near(at, 200) then
			local g = ground(at) + Vector3.new(0, 0.2, 0)
			local yaw = math.random() * math.pi * 2
			local cf = CFrame.new(at + Vector3.new(0, 1, 0)) * CFrame.Angles(0, yaw, 0) * CFrame.Angles(0, 0, math.rad(math.random(50, 90)))
			crescent(cf, (data.radius or 6) * 0.9, -70, 70, 0.9, 0.22, math.random() < 0.3 and PALE or RED, 6)
			local mark = part(Vector3.new(0.15, 3, 3), BLOOD, Enum.Material.Neon, 0.3, "cyl")
			mark.CFrame = CFrame.new(g) * CFrame.Angles(0, 0, math.rad(90))
			fadeOut(mark, 0.35, { Size = Vector3.new(0.1, 7, 7) })
		end
	end
	if math.random() < 0.4 then
		local first = (data.spots or {})[1]
		if first then
			Fx.sound("swing", 0.5, 0.9 + math.random() * 0.3, first)
		end
	end
end
-- 마지막 낫질: 달에서 땅까지 한 줄기 붉은 칼날, 화면이 비스듬히 갈라진다
local function screenCut()
	local pg = player:FindFirstChild("PlayerGui")
	if not pg then
		return
	end
	local g = Instance.new("ScreenGui")
	g.Name = "KwonMoonCut"
	g.IgnoreGuiInset = true
	g.ResetOnSpawn = false
	g.DisplayOrder = 86
	g.Parent = pg
	local angle = -18
	-- 갈라지는 두 쪽 (붉게 물든 반투명 판이 서로 반대쪽으로 밀려난다)
	local halves: { Frame } = {}
	for i, sgn in ipairs({ -1, 1 }) do
		local h = Instance.new("Frame")
		h.AnchorPoint = Vector2.new(0.5, sgn < 0 and 1 or 0)
		h.Position = UDim2.fromScale(0.5, 0.5)
		h.Size = UDim2.fromScale(2.4, 1.6)
		h.Rotation = angle
		h.BackgroundColor3 = Color3.fromRGB(90, 0, 10)
		h.BackgroundTransparency = 0.55
		h.BorderSizePixel = 0
		h.Parent = g
		halves[i] = h
	end
	local line = Instance.new("Frame")
	line.AnchorPoint = Vector2.new(0.5, 0.5)
	line.Position = UDim2.fromScale(0.5, 0.5)
	line.Size = UDim2.new(0, 0, 0, 6)
	line.Rotation = angle
	line.BackgroundColor3 = Color3.fromRGB(255, 230, 230)
	line.BorderSizePixel = 0
	line.ZIndex = 3
	line.Parent = g
	local glowL = Instance.new("UIStroke")
	glowL.Color = RED
	glowL.Thickness = 5
	glowL.Parent = line
	tween(line, 0.12, { Size = UDim2.new(2.2, 0, 0, 6) }, Enum.EasingStyle.Quad)
	task.delay(0.16, function()
		local rad = math.rad(angle + 90)
		local off = Vector2.new(math.cos(rad), math.sin(rad)) * 0.035
		tween(halves[1], 0.35, { Position = UDim2.fromScale(0.5 - off.X, 0.5 - off.Y), BackgroundTransparency = 1 })
		tween(halves[2], 0.35, { Position = UDim2.fromScale(0.5 + off.X, 0.5 + off.Y), BackgroundTransparency = 1 })
		tween(line, 0.4, { BackgroundTransparency = 1, Size = UDim2.new(2.2, 0, 0, 18) })
		tween(glowL, 0.4, { Transparency = 1 })
	end)
	task.delay(0.7, function()
		g:Destroy()
	end)
end
local function moonCleave(data: any)
	local at: Vector3 = data.at
	local dir: Vector3 = data.dir or Vector3.new(0, 0, -1)
	local R = data.radius or 26
	local g = ground(at)
	-- 우두머리 악마의 마지막 내리찍기: 낫이 땅에 박힌 채 잠시 머물다 사라진다
	local m = data.m
	local a = m and alphas[m]
	if a then
		alphaSwing(m, 0.55, 0.14, true)
		task.delay(1.1, function()
			if alphas[m] == a then
				alphas[m] = nil
				Demon.remove(a.h, 0.9)
			end
		end)
	end
	-- 하늘에서 땅까지 세로로 선 거대한 칼날 (얇은 판)
	local blade = part(Vector3.new(0.6, 200, R * 2.4), RED, Enum.Material.Neon, 0.05)
	blade.CFrame = CFrame.lookAt(g + Vector3.new(0, 100, 0), g + Vector3.new(0, 100, 0) + dir)
	local core = part(Vector3.new(0.3, 200, R * 2.4), WHITE, Enum.Material.Neon, 0)
	core.CFrame = blade.CFrame
	blade.Size = Vector3.new(0.6, 200, 0.5)
	core.Size = Vector3.new(0.3, 200, 0.3)
	tween(blade, 0.1, { Size = Vector3.new(0.6, 200, R * 2.4) })
	tween(core, 0.1, { Size = Vector3.new(0.3, 200, R * 2.4) })
	task.delay(0.15, function()
		fadeOut(blade, 0.5, { Size = Vector3.new(4, 200, R * 2.6) })
		fadeOut(core, 0.3)
	end)
	-- 땅이 한 줄로 갈라지고 피가 솟는다
	local scar = part(Vector3.new(1.2, 0.25, R * 2.4), RED, Enum.Material.Neon, 0)
	scar.CFrame = CFrame.lookAt(g + Vector3.new(0, 0.15, 0), g + Vector3.new(0, 0.15, 0) + dir)
	task.delay(1.2, function()
		fadeOut(scar, 1)
	end)
	for i = 0, 3 do
		task.delay(i * 0.07, function()
			Fx.ring(g + Vector3.new(0, 0.3, 0), i % 2 == 0 and RED or PALE, 4, R * 2.6 + i * 8, 0.8)
		end)
	end
	Fx.burst("spark", at + Vector3.new(0, 3, 0), RED, 60, 2.6)
	Fx.burst("dust", g + Vector3.new(0, 0.5, 0), Color3.fromRGB(110, 50, 50), 40, 3)
	Fx.debris(g, 12, 40, Color3.fromRGB(90, 40, 40))
	Fx.flash(at, RED, 60, 8, 1)
	Fx.sound("shatter", 0.8, 0.6, at)
	Fx.sound("heavy", 1, 0.4, at)
	shakeNear(at, 2.6, 120)
	if near(at, 120) then
		screenCut()
	end
end

local HANDLERS: { [string]: (any) -> () } = {
	reapHook = reapHook,
	reapSpin = reapSpin,
	reapScar = reapScar,
	harvest = harvest,
	harvestBurst = harvestBurst,
	moonRise = moonRise,
	moonSlash = moonSlash,
	moonCleave = moonCleave,
}
function Reaper.handles(data: any): boolean
	return HANDLERS[data.kind] ~= nil
end
function Reaper.run(data: any)
	local fn = HANDLERS[data.kind]
	if fn then
		fn(data)
	end
end

------------------------------------------------------------------------
-- 초 오의 혈월만겸의 컷씬 (쓴 사람 화면에서만, 대사 없이): 무릎 꿇은 몸을 낮게 올려다보다가,
-- 일어서며 낫을 달로 치켜드는 순간 카메라가 뒤로 빠져 붉은 달과 함께 잡는다
------------------------------------------------------------------------
local cutActive = false
function Reaper.superCut(model: Model, dur: number, name: string, shake: ((number) -> ())?)
	local cam = workspace.CurrentCamera
	local r = rootOf(model)
	if not cam or not r or cutActive then
		return
	end
	cutActive = true
	local pg = player:WaitForChild("PlayerGui")
	local g = Instance.new("ScreenGui")
	g.Name = "KwonReaperCut"
	g.IgnoreGuiInset = true
	g.ResetOnSpawn = false
	g.DisplayOrder = 85
	g.Parent = pg
	-- 붉게 물드는 가장자리
	local tintF = Instance.new("Frame")
	tintF.Size = UDim2.fromScale(1, 1)
	tintF.BackgroundColor3 = Color3.fromRGB(90, 0, 12)
	tintF.BackgroundTransparency = 1
	tintF.BorderSizePixel = 0
	tintF.Parent = g
	local grad = Instance.new("UIGradient")
	grad.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.1), NumberSequenceKeypoint.new(0.35, 1), NumberSequenceKeypoint.new(0.65, 1), NumberSequenceKeypoint.new(1, 0.1) })
	grad.Rotation = 90
	grad.Parent = tintF
	tween(tintF, 0.3, { BackgroundTransparency = 0.35 })
	-- 위아래 검은 띠와 이름
	local bars: { Frame } = {}
	for i, y in ipairs({ 0, 1 }) do
		local b = Instance.new("Frame")
		b.AnchorPoint = Vector2.new(0, y)
		b.Position = UDim2.fromScale(0, y)
		b.Size = UDim2.new(1, 0, 0, 0)
		b.BackgroundColor3 = Color3.new(0, 0, 0)
		b.BorderSizePixel = 0
		b.ZIndex = 5
		b.Parent = g
		tween(b, 0.15, { Size = UDim2.new(1, 0, 0.14, 0) })
		bars[i] = b
	end
	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.AnchorPoint = Vector2.new(1, 0.5)
	label.Position = UDim2.new(1, -30, 0.5, 0)
	label.Size = UDim2.new(0.5, 0, 0.45, 0)
	label.Font = Enum.Font.GothamBlack
	label.TextScaled = true
	label.TextXAlignment = Enum.TextXAlignment.Right
	label.Text = "초 오의 · " .. name
	label.TextColor3 = PALE
	label.TextStrokeColor3 = RED
	label.TextStrokeTransparency = 0.2
	label.TextTransparency = 1
	label.ZIndex = 6
	label.Parent = bars[2]
	tween(label, 0.25, { TextTransparency = 0 })
	-- 핏방울이 화면 위에서 흘러내린다
	local drops: { Frame } = {}
	for i = 1, 12 do
		local d = Instance.new("Frame")
		d.AnchorPoint = Vector2.new(0.5, 0)
		d.Position = UDim2.fromScale((i - 0.5) / 12 + (math.random() - 0.5) * 0.05, 0.1)
		d.Size = UDim2.new(0, 3 + math.random(0, 3), 0, 0)
		d.BackgroundColor3 = BLOOD
		d.BorderSizePixel = 0
		d.ZIndex = 4
		d.Parent = g
		table.insert(drops, d)
		tween(d, dur * (0.6 + math.random() * 0.4), { Size = UDim2.new(0, d.Size.X.Offset, 0.2 + math.random() * 0.35, 0) }, Enum.EasingStyle.Sine)
	end

	local oldType = cam.CameraType
	local oldFov = cam.FieldOfView
	local look = flat(r.CFrame.LookVector)
	local side = Vector3.new(-look.Z, 0, look.X)
	cam.CameraType = Enum.CameraType.Scriptable
	local t0 = os.clock()
	local focus = r.Position
	local finished = false
	local function restore()
		if finished then
			return
		end
		finished = true
		RunService:UnbindFromRenderStep("KwonReaperCut")
		cam.CameraType = oldType == Enum.CameraType.Scriptable and Enum.CameraType.Custom or oldType
		cam.FieldOfView = oldFov
		cutActive = false
		-- 1.9.3판: 컷씬이 끝나면 카메라를 내 등 뒤 조금 높은 곳으로 (앞에서 터지는 기술이 잘 보이게)
		local function behind()
			if r.Parent then
				local lk = flat(r.CFrame.LookVector)
				cam.CFrame = CFrame.lookAt(r.Position - lk * 15 + Vector3.new(0, 6, 0), r.Position + lk * 6 + Vector3.new(0, 1, 0))
			end
		end
		behind()
		task.defer(behind)
	end
	RunService:BindToRenderStep("KwonReaperCut", Enum.RenderPriority.Camera.Value, function(dt: number)
		if finished then
			return
		end
		local t = os.clock() - t0
		local u = math.clamp(t / dur, 0, 1)
		if not r.Parent then
			restore()
			return
		end
		focus = focus:Lerp(r.Position, math.min(1, dt * 10))
		local e = u * u * (3 - 2 * u)
		-- 처음엔 앞쪽 낮은 곳에서 얼굴을 올려다보고, 끝으로 갈수록 뒤로 크게 빠지며 달까지 담는다
		local pos = focus + look * (5 - 15 * e) + side * (2 + 4 * e) + Vector3.new(0, -1.2 + 5 * e, 0)
		local target = focus + Vector3.new(0, 1.2 + 6 * e, 0) - look * (40 * e)
		cam.CFrame = CFrame.lookAt(pos, target)
		cam.FieldOfView = oldFov - 22 + 26 * e
		if shake and u > 0.6 then
			shake(0.1 + (u - 0.6) * 0.8)
		end
	end)
	task.delay(dur, function()
		restore()
		for _, b in ipairs(bars) do
			tween(b, 0.18, { Size = UDim2.new(1, 0, 0, 0) })
		end
		tween(label, 0.15, { TextTransparency = 1, TextStrokeTransparency = 1 })
		for _, d in ipairs(drops) do
			tween(d, 0.25, { BackgroundTransparency = 1 })
		end
		grad:Destroy()
		tintF.BackgroundColor3 = Color3.fromRGB(255, 200, 200)
		tintF.BackgroundTransparency = 0.25
		tween(tintF, 0.35, { BackgroundTransparency = 1 })
		if shake then
			shake(1.4)
		end
		task.delay(0.5, function()
			g:Destroy()
		end)
	end)
end

return Reaper
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="26">
          <Properties>
            <string name="Name">Sakura</string>
            <string name="Source"><![CDATA[-- 권왕: 초월 권법 초·매화난무권의 화면 (벚꽃 부채, 흩날리는 꽃잎, 천본앵, 초 오의 만앵참월)
-- 벚꽃이 늘 앞에 서도록: 부채에서 꽃잎이 끊임없이 흘러내리고, 모든 기술이 꽃잎의 궤적을 남긴다
local Lighting = game:GetService("Lighting")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local Debris = game:GetService("Debris")

local Config = require(ReplicatedStorage:WaitForChild("Config"))
local Fx = require(script.Parent:WaitForChild("Fx"))
local Drunk = require(script.Parent:WaitForChild("Drunk"))
local Reaper = require(script.Parent:WaitForChild("Reaper"))
local Ult2 = require(script.Parent:WaitForChild("Ult2"))

local Sakura = {}
local player = Players.LocalPlayer

local PINKS = {
	Color3.fromRGB(255, 168, 204),
	Color3.fromRGB(255, 196, 222),
	Color3.fromRGB(255, 224, 238),
	Color3.fromRGB(255, 140, 188),
	Color3.fromRGB(255, 246, 250),
}
local PINK = Color3.fromRGB(255, 150, 200)
local PINK_DEEP = Color3.fromRGB(240, 90, 150)
local WHITE = Color3.new(1, 1, 1)
local TEX_SPARK = "rbxasset://textures/particles/sparkles_main.dds"

local folder = Instance.new("Folder")
folder.Name = "KwonSakura"
folder.Parent = workspace

local function tween(inst: Instance, time: number, goal: { [string]: any }, style: Enum.EasingStyle?, dir: Enum.EasingDirection?)
	local tw = TweenService:Create(inst, TweenInfo.new(time, style or Enum.EasingStyle.Quad, dir or Enum.EasingDirection.Out), goal)
	tw:Play()
	return tw
end
local function rootOf(m: Instance?): BasePart?
	local r = m and m:FindFirstChild("HumanoidRootPart")
	return (r and r:IsA("BasePart")) and r or nil
end
local function near(pos: Vector3, d: number): boolean
	local cam = workspace.CurrentCamera
	return cam ~= nil and (cam.CFrame.Position - pos).Magnitude < d
end
local function pinkAt(i: number?): Color3
	return PINKS[((i or math.random(1, 99)) % #PINKS) + 1]
end

-- 떠다니는 조각 (물리 없음)
local function part(size: Vector3, color: Color3, material: Enum.Material?, alpha: number?, ell: boolean?): Part
	local p = Instance.new("Part")
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	p.Size = size
	p.Color = color
	p.Material = material or Enum.Material.SmoothPlastic
	p.Transparency = alpha or 0
	if ell then
		local mesh = Instance.new("SpecialMesh")
		mesh.MeshType = Enum.MeshType.Sphere
		mesh.Parent = p
	end
	p.Parent = folder
	return p
end

------------------------------------------------------------------------
-- 꽃잎: 납작한 타원 조각이 팔랑이며 흩날린다 (한꺼번에 너무 많지 않게)
------------------------------------------------------------------------
local live = 0
local MAX_PETALS = 420
function Sakura.petals(pos: Vector3, n: number, spread: number, life: number, push: Vector3?, size: number?)
	local k = size or 1
	for _ = 1, n do
		if live >= MAX_PETALS then
			return
		end
		live += 1
		local p = part(Vector3.new(0.8, 0.07, 0.55) * k, pinkAt(), Enum.Material.SmoothPlastic, 0, true)
		local from = pos + Vector3.new(math.random() - 0.5, math.random() - 0.5, math.random() - 0.5) * spread * 0.4
		p.CFrame = CFrame.new(from) * CFrame.Angles(math.random() * 6, math.random() * 6, math.random() * 6)
		local drift = (push or Vector3.zero) + Vector3.new(math.random() - 0.5, math.random() * 0.6 - 0.1, math.random() - 0.5) * spread
		local l = life * (0.7 + math.random() * 0.6)
		tween(p, l, { CFrame = CFrame.new(from + drift - Vector3.new(0, l * 1.2, 0)) * CFrame.Angles(math.random() * 12, math.random() * 12, math.random() * 12), Transparency = 1 }, Enum.EasingStyle.Sine)
		task.delay(l, function()
			live -= 1
			p:Destroy()
		end)
	end
end
-- 꽃잎 입자 (가볍게 많이)
local function petalEmitter(parent: Instance, rate: number, size: number, speed: number, life: number): ParticleEmitter
	local pe = Instance.new("ParticleEmitter")
	pe.Texture = TEX_SPARK
	pe.Color = ColorSequence.new({ ColorSequenceKeypoint.new(0, PINKS[3]), ColorSequenceKeypoint.new(0.5, PINKS[1]), ColorSequenceKeypoint.new(1, PINKS[4]) })
	pe.LightEmission = 0.4
	pe.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, size), NumberSequenceKeypoint.new(1, size * 0.6) })
	pe.Squash = NumberSequence.new(0.5)
	pe.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.1), NumberSequenceKeypoint.new(0.8, 0.3), NumberSequenceKeypoint.new(1, 1) })
	pe.Lifetime = NumberRange.new(life * 0.7, life)
	pe.Rate = rate
	pe.Speed = NumberRange.new(speed * 0.4, speed)
	pe.SpreadAngle = Vector2.new(180, 180)
	pe.Rotation = NumberRange.new(0, 360)
	pe.RotSpeed = NumberRange.new(-180, 180)
	pe.Acceleration = Vector3.new(0, -2, 0)
	pe.Drag = 1.5
	pe.Parent = parent
	return pe
end

------------------------------------------------------------------------
-- 벚꽃 부채: 손에 쥔 손잡이에서 열한 개의 살이 퍼지고, 살 사이에 분홍 부채 면, 면 위에 다섯 잎 꽃
------------------------------------------------------------------------
local fans: { [Model]: { Instance } } = {}
local function weldTo(p: BasePart, hand: BasePart, cf: CFrame)
	p.Massless = true
	p.CFrame = hand.CFrame * cf
	local w = Instance.new("WeldConstraint")
	w.Part0 = hand
	w.Part1 = p
	w.Parent = p
	p.Anchored = false
end
local function buildFan(model: Model, hand: BasePart, side: number): { Instance }
	local out: { Instance } = {}
	local s = 1.0
	local base = CFrame.new(0, -0.35, 0) * CFrame.Angles(0, side * math.rad(12), 0)
	-- 부채 조각은 몸 밖의 폴더에 둔다 (몸의 조각을 도는 다른 효과가 부채까지 건드리지 않게). 용접으로 손을 따라간다
	local holder = Instance.new("Folder")
	holder.Name = "Fan_" .. model.Name
	holder.Parent = folder
	table.insert(out, holder)
	local function add(size: Vector3, cf: CFrame, color: Color3, mat: Enum.Material?, alpha: number?, ell: boolean?): Part
		local p = part(size * s, color, mat, alpha, ell)
		weldTo(p, hand, base * cf)
		p.Parent = holder
		table.insert(out, p)
		return p
	end
	local wood = Color3.fromRGB(70, 40, 30)
	local gold = Color3.fromRGB(240, 200, 120)
	add(Vector3.new(0.22, 0.4, 0.22), CFrame.new(0, 0.05, 0), wood, Enum.Material.Wood)
	add(Vector3.new(0.18, 0.18, 0.18), CFrame.new(0, 0.28, 0), gold, Enum.Material.Metal, 0, true)
	local R0, R1, L = 0.5, 2.2, 2.3
	local n = 11
	local spanA = math.rad(150)
	for i = 0, n - 1 do
		local th = -spanA / 2 + spanA * i / (n - 1)
		add(Vector3.new(0.06, L, 0.05), CFrame.Angles(0, 0, th) * CFrame.new(0, -L / 2, 0), wood, Enum.Material.Wood)
		if i < n - 1 then
			local tm = th + spanA / (n - 1) / 2
			local rm = (R0 + R1) / 2
			local w = 2 * rm * math.sin(spanA / (n - 1) / 2) * 1.12
			local col = PINKS[(i % 3) + 1]:Lerp(WHITE, (i % 2) * 0.15)
			add(Vector3.new(w, R1 - R0, 0.03), CFrame.Angles(0, 0, tm) * CFrame.new(0, -rm, 0.02), col, Enum.Material.SmoothPlastic)
			-- 바깥 테 (짙은 분홍)
			add(Vector3.new(w * 1.05, 0.12, 0.04), CFrame.Angles(0, 0, tm) * CFrame.new(0, -R1, 0.02), PINK_DEEP, Enum.Material.SmoothPlastic)
		end
	end
	-- 부채 면 위의 벚꽃 세 송이 (다섯 잎 + 금빛 꽃술)
	for k, at in ipairs({ { -0.5, 1.55 }, { 0.55, 1.35 }, { 0.05, 1.9 } }) do
		local c = CFrame.Angles(0, 0, at[1]) * CFrame.new(0, -at[2], 0.06)
		for j = 0, 4 do
			local a = j / 5 * math.pi * 2
			add(Vector3.new(0.26, 0.2, 0.02), c * CFrame.Angles(0, 0, a) * CFrame.new(0, 0.13, 0), k == 2 and WHITE or PINKS[4], Enum.Material.SmoothPlastic, 0, true)
		end
		add(Vector3.new(0.09, 0.09, 0.03), c, gold, Enum.Material.Neon, 0, true)
	end
	-- 부채 끝에서 꽃잎이 끊임없이 흘러내린다
	local tip = add(Vector3.new(0.1, 0.1, 0.1), CFrame.new(0, -R1, 0), WHITE, nil, 1)
	petalEmitter(tip, 9, 0.35, 1.5, 1.6)
	local glow = Instance.new("PointLight")
	glow.Color = PINK
	glow.Range = 7
	glow.Brightness = 0.6
	glow.Parent = tip
	return out
end
local function clearFans(model: Model)
	local list = fans[model]
	if list then
		for _, p in ipairs(list) do
			p:Destroy()
		end
		fans[model] = nil
	end
end
local builtFor: { [Model]: string } = {}
local waiting: { [Model]: boolean } = {}
local tryFans: (Model) -> ()
local function refreshFans(model: Model)
	local id = model:GetAttribute("Style")
	local st = type(id) == "string" and Config.STYLE_BY_ID[id] or nil
	if not st or not (st.fans or st.soju or st.scythe or st.gauntlets) then
		clearFans(model)
		builtFor[model] = nil
		return
	end
	-- 같은 권법이면 다시 만들지 않는다
	if builtFor[model] == st.id and fans[model] then
		return
	end
	clearFans(model)
	builtFor[model] = st.id
	-- 먼저 자리를 잡아 둔다 (같은 몸을 두 번 만들지 않게)
	local list: { Instance } = {}
	fans[model] = list
	-- 초·취팔선권은 부채 대신 술병과 넥타이
	if st.soju then
		for _, p in ipairs(Drunk.build(model)) do
			table.insert(list, p)
		end
		return
	end
	-- 초·벽력신권은 두 팔의 뇌전 토시
	if st.gauntlets then
		for _, p in ipairs(Ult2.buildGauntlets(model)) do
			table.insert(list, p)
		end
		return
	end
	-- 초·혈마신수는 붉은 큰 낫과 손톱
	if st.scythe then
		for _, p in ipairs(Reaper.build(model)) do
			table.insert(list, p)
		end
		return
	end
	for _, pair in ipairs({ { "RightHand", 1 }, { "LeftHand", -1 } }) do
		local hand = model:FindFirstChild(pair[1])
		if hand and hand:IsA("BasePart") then
			for _, p in ipairs(buildFan(model, hand, pair[2])) do
				table.insert(list, p)
			end
		end
	end
end
-- 부채 권법일 때만 손이 생기기를 기다렸다가 만든다 (다른 몸은 기다리지 않는다)
function tryFans(model: Model)
	local id = model:GetAttribute("Style")
	local st = type(id) == "string" and Config.STYLE_BY_ID[id] or nil
	if not st or not (st.fans or st.soju or st.scythe or st.gauntlets) then
		refreshFans(model)
		return
	end
	if builtFor[model] == st.id and fans[model] or waiting[model] then
		return
	end
	waiting[model] = true
	task.spawn(function()
		model:WaitForChild("RightHand", 10)
		model:WaitForChild(st.soju and "Head" or "LeftHand", 10)
		waiting[model] = nil
		refreshFans(model)
	end)
end
local watched: { [Model]: boolean } = {}
function Sakura.watch(model: Model)
	if watched[model] then
		return
	end
	watched[model] = true
	tryFans(model)
	model:GetAttributeChangedSignal("Style"):Connect(function()
		tryFans(model)
	end)
	-- 사라지는 기술 (만앵참월 등) 동안 부채도 감춘다
	model:GetAttributeChangedSignal("Vanish"):Connect(function()
		local hide = model:GetAttribute("Vanish") == true
		for _, p in ipairs(fans[model] or {}) do
			if p:IsA("BasePart") then
				p.LocalTransparencyModifier = hide and 1 or 0
			end
		end
	end)
	model.AncestryChanged:Connect(function()
		if not model.Parent then
			clearFans(model)
			watched[model] = nil
			builtFor[model] = nil
		end
	end)
end
-- 폴더 안의 모든 몸 (사부·적)
function Sakura.watchFolder(f: Instance)
	for _, m in ipairs(f:GetChildren()) do
		if m:IsA("Model") then
			Sakura.watch(m)
		end
	end
	f.ChildAdded:Connect(function(m)
		if m:IsA("Model") then
			Sakura.watch(m)
		end
	end)
end

-- 부채를 든 사람은 걸을 때마다 발밑에 꽃잎이 흩날린다
local walkAcc = 0
RunService.Heartbeat:Connect(function(dt)
	walkAcc += dt
	if walkAcc < 0.25 then
		return
	end
	walkAcc = 0
	for model in pairs(fans) do
		local r = rootOf(model)
		local sid = model:GetAttribute("Style")
		local st = type(sid) == "string" and Config.STYLE_BY_ID[sid] or nil
		if st and st.fans and r and near(r.Position, 110) and model:GetAttribute("Vanish") ~= true then
			local v = r.AssemblyLinearVelocity
			local moving = Vector3.new(v.X, 0, v.Z).Magnitude > 3
			Sakura.petals(r.Position + Vector3.new(0, moving and -1.5 or 1, 0), moving and 4 or 1, moving and 4 or 3, moving and 1.2 or 1.8, moving and -v * 0.15 or nil)
		end
	end
end)

------------------------------------------------------------------------
-- 기술마다 꽃잎의 궤적: 부채가 지나간 반달 모양 칼자국과 그 길을 따라 흩어지는 꽃잎
------------------------------------------------------------------------
local function crescent(cf: CFrame, radius: number, color: Color3, life: number, thick: number?)
	local segs = 9
	for i = 0, segs - 1 do
		local a = -1.1 + 2.2 * i / (segs - 1)
		local pos = cf * Vector3.new(math.sin(a) * radius, 0, -math.cos(a) * radius)
		local nxt = cf * Vector3.new(math.sin(a + 0.25) * radius, 0, -math.cos(a + 0.25) * radius)
		local w = (1 - math.abs(a) / 1.2) * (thick or 0.5) + 0.05
		local p = part(Vector3.new(w, w * 0.3, (nxt - pos).Magnitude * 1.2), i % 2 == 0 and color or WHITE, Enum.Material.Neon, 0.15, true)
		p.CFrame = CFrame.lookAt(pos, nxt)
		tween(p, life, { Transparency = 1, Size = p.Size * Vector3.new(0.3, 0.3, 1.3) })
		Debris:AddItem(p, life + 0.05)
	end
end
function Sakura.cast(styleId: any, slot: any, model: Model, dur: number)
	local st = type(styleId) == "string" and Config.STYLE_BY_ID[styleId] or nil
	if not st or not st.fans then
		return
	end
	local r = rootOf(model)
	if not r or not near(r.Position, 160) then
		return
	end
	local look = r.CFrame
	if type(slot) == "number" or slot == "H" or slot == "F" then
		-- 연타·강타: 앞쪽으로 반달 칼자국 하나 (강타는 크게), 꽃잎이 그 길을 따라
		local big = slot == "H"
		task.delay(math.min(0.12, dur * 0.35), function()
			local cf = look * CFrame.new(0, 0.6, -1) * CFrame.Angles(0, 0, (type(slot) == "number" and slot % 2 == 0) and 0.5 or -0.5)
			crescent(cf, big and 7 or 4.5, PINK, big and 0.4 or 0.28, big and 0.9 or 0.5)
			Sakura.petals((look * CFrame.new(0, 0.5, -3)).Position, big and 18 or 8, big and 8 or 5, 1.1, look.LookVector * (big and 10 or 5))
		end)
	elseif slot == "E" then
		Sakura.petals(r.Position, 30, 10, 1.6)
		for i = 0, 2 do
			task.delay(i * 0.18, function()
				crescent(r.CFrame * CFrame.Angles(0, i * 2.1, 0), 6, PINKS[i + 1], 0.35, 0.6)
			end)
		end
	elseif slot == "R" then
		Sakura.petals(r.Position, 24, 6, 1.4)
	elseif slot == "G" or slot == "X" then
		Sakura.petals(r.Position + Vector3.new(0, 2, 0), 50, 14, 2.2)
		Fx.ring(r.Position - Vector3.new(0, 2.4, 0), PINK, 2, 30, 0.7)
	end
end

------------------------------------------------------------------------
-- 천본앵 (G): 둘레가 벚꽃 칼바람의 소용돌이. 세 겹의 꽃잎 고리가 돌며 좁아지고, 끝에 한가운데로 모여 터진다
------------------------------------------------------------------------
local storms: { [any]: any } = {}
local function stormRun(data: any)
	local m = data.m
	local r = rootOf(m)
	local center0 = data.at or (r and r.Position) or Vector3.zero
	if not near(center0, 300) then
		return
	end
	local radius = data.radius or 30
	local dur = data.dur or 3.5
	local rings = {}
	local blades = {}
	-- 세 겹의 꽃잎 고리 (안쪽일수록 빠르다)
	for ring = 1, 3 do
		local list = {}
		local count = 26 - ring * 4
		for i = 1, count do
			local p = part(Vector3.new(1.6, 0.1, 1.0) * (1.25 - ring * 0.12), pinkAt(i + ring), Enum.Material.SmoothPlastic, 0, true)
			table.insert(list, { p = p, a = i / count * math.pi * 2, h = (ring - 2) * 4 + math.random() * 2, spin = math.random() * 6 })
		end
		table.insert(rings, { list = list, r = radius * (0.35 + ring * 0.2), speed = (4.2 - ring) * 1.1 })
	end
	-- 칼날 같은 빛의 꽃잎 (길고 빛난다)
	for i = 1, 10 do
		local p = part(Vector3.new(0.35, 0.12, 4.2), i % 2 == 0 and WHITE or PINK, Enum.Material.Neon, 0.2, true)
		table.insert(blades, { p = p, a = i / 10 * math.pi * 2, h = math.random() * 6 - 1 })
	end
	-- 발밑의 꽃 진과 기둥처럼 솟는 꽃잎 회오리
	local disc = part(Vector3.new(0.2, radius * 2, radius * 2), PINK, Enum.Material.Neon, 0.75)
	disc.Shape = Enum.PartType.Cylinder
	disc.CFrame = CFrame.new(center0 - Vector3.new(0, 2.6, 0)) * CFrame.Angles(0, 0, math.rad(90))
	local column = part(Vector3.new(2, 2, 2), WHITE, nil, 1)
	column.Position = center0
	local pe = petalEmitter(column, 90, 0.7, 18, 2.2)
	pe.SpreadAngle = Vector2.new(25, 25)
	pe.Acceleration = Vector3.new(0, 10, 0)
	local light = Instance.new("PointLight")
	light.Color = PINK
	light.Range = 40
	light.Brightness = 2
	light.Parent = column
	Fx.sound("ping", 0.6, 0.6, center0)
	local t0 = os.clock()
	local key = {}
	storms[m or key] = { rings = rings, blades = blades, disc = disc, column = column }
	local conn
	conn = RunService.RenderStepped:Connect(function()
		local t = os.clock() - t0
		local rr = rootOf(m)
		local c = rr and rr.Position or center0
		local shrink = 1 - math.clamp(t / dur, 0, 1) * 0.35
		for _, ring in ipairs(rings) do
			for _, e in ipairs(ring.list) do
				local a = e.a + t * ring.speed
				local pos = c + Vector3.new(math.cos(a) * ring.r * shrink, e.h + math.sin(t * 3 + e.a) * 0.8, math.sin(a) * ring.r * shrink)
				e.p.CFrame = CFrame.new(pos) * CFrame.Angles(t * 4 + e.spin, a, t * 3)
			end
		end
		for _, b in ipairs(blades) do
			local a = b.a - t * 5
			local rad = radius * 0.55 * shrink
			local pos = c + Vector3.new(math.cos(a) * rad, b.h, math.sin(a) * rad)
			b.p.CFrame = CFrame.lookAt(pos, pos + Vector3.new(-math.sin(a), 0, math.cos(a)))
		end
		disc.CFrame = CFrame.new(c - Vector3.new(0, 2.6, 0)) * CFrame.Angles(0, t * 0.8, math.rad(90))
		column.Position = c
		if t > dur + 0.6 then
			conn:Disconnect()
		end
	end)
	task.delay(dur + 0.7, function()
		local s = storms[m or key]
		if s then
			for _, ring in ipairs(s.rings) do
				for _, e in ipairs(ring.list) do
					e.p:Destroy()
				end
			end
			for _, b in ipairs(s.blades) do
				b.p:Destroy()
			end
			s.disc:Destroy()
			s.column:Destroy()
			storms[m or key] = nil
		end
	end)
end
local function stormBurst(data: any)
	local at = data.at
	if not at or not near(at, 300) then
		return
	end
	local radius = data.radius or 30
	-- 고리들이 한가운데로 모여든 뒤 꽃처럼 터진다
	for _, s in pairs(storms) do
		for _, ring in ipairs(s.rings) do
			for _, e in ipairs(ring.list) do
				tween(e.p, 0.22, { CFrame = CFrame.new(at + Vector3.new(0, 1, 0)), Transparency = 0.6 }, Enum.EasingStyle.Quint, Enum.EasingDirection.In)
			end
		end
	end
	task.delay(0.22, function()
		Fx.blast(at, PINK, WHITE, 3)
		Fx.flash(at, PINK, 80, 5, 0.6)
		Fx.ring(at - Vector3.new(0, 2.3, 0), PINK, 4, radius * 2.4, 0.6)
		Fx.ring(at + Vector3.new(0, 1, 0), WHITE, 2, radius * 1.6, 0.45)
		Sakura.petals(at + Vector3.new(0, 2, 0), 90, radius * 1.4, 2.4)
		-- 하늘로 솟는 꽃잎 기둥
		local col = part(Vector3.new(radius * 0.7, 60, radius * 0.7), PINKS[3], Enum.Material.Neon, 0.3)
		col.Shape = Enum.PartType.Cylinder
		col.Size = Vector3.new(60, radius * 0.7, radius * 0.7)
		col.CFrame = CFrame.new(at + Vector3.new(0, 28, 0)) * CFrame.Angles(0, 0, math.rad(90))
		tween(col, 0.7, { Size = Vector3.new(70, 0.5, 0.5), Transparency = 1 })
		Debris:AddItem(col, 0.75)
	end)
end

------------------------------------------------------------------------
-- 만앵참월 (X, 초 오의)
------------------------------------------------------------------------
local cuts: { [any]: { BasePart } } = {}
local grey: ColorCorrectionEffect? = nil
local function mineOrNear(data: any, d: number): boolean
	local me = player.Character
	if data.m and data.m == me then
		return true
	end
	local r = rootOf(me)
	return r ~= nil and data.at ~= nil and (r.Position - data.at).Magnitude < d
end
local function setGrey(on: boolean, time: number)
	if not grey then
		local cc = Instance.new("ColorCorrectionEffect")
		cc.Name = "KwonSakuraGrey"
		cc.Parent = Lighting
		grey = cc
	end
	local cc = grey :: ColorCorrectionEffect
	tween(cc, time, { Saturation = on and -1 or 0, Contrast = on and 0.25 or 0, Brightness = on and -0.06 or 0, TintColor = on and Color3.fromRGB(235, 235, 240) or WHITE })
end

-- 화면 위의 큰 글자와 칼자국 (내 화면에서만)
local function screenGui(): ScreenGui
	local pg = player:WaitForChild("PlayerGui")
	local g = Instance.new("ScreenGui")
	g.Name = "KwonSever"
	g.IgnoreGuiInset = true
	g.ResetOnSpawn = false
	g.DisplayOrder = 80
	g.Parent = pg
	return g
end
local function bigName(name: string, life: number)
	local g = screenGui()
	local t = Instance.new("TextLabel")
	t.BackgroundTransparency = 1
	t.AnchorPoint = Vector2.new(0.5, 0.5)
	t.Position = UDim2.fromScale(0.5, 0.42)
	t.Size = UDim2.fromScale(0.8, 0.16)
	t.Font = Enum.Font.GothamBlack
	t.TextScaled = true
	t.Text = name
	t.TextColor3 = Color3.fromRGB(255, 236, 246)
	t.TextTransparency = 1
	t.TextStrokeColor3 = PINK_DEEP
	t.TextStrokeTransparency = 1
	t.Parent = g
	tween(t, 0.25, { TextTransparency = 0, TextStrokeTransparency = 0.2 })
	task.delay(life, function()
		tween(t, 0.3, { TextTransparency = 1, TextStrokeTransparency = 1 })
		Debris:AddItem(g, 0.35)
	end)
end
-- 세 점을 잇는 삼각형 (쐐기 두 개)을 카메라 기준 좌표로 만든다
local function triangle(a: Vector3, b: Vector3, c: Vector3, color: Color3, alpha: number): { { p: BasePart, cf: CFrame } }
	local ab, ac, bc = b - a, c - a, c - b
	local abd, acd, bcd = ab:Dot(ab), ac:Dot(ac), bc:Dot(bc)
	if abd > acd and abd > bcd then
		c, a = a, c
	elseif acd > bcd and acd > abd then
		a, b = b, a
	end
	ab, ac, bc = b - a, c - a, c - b
	local right = ac:Cross(ab).Unit
	local up = bc:Cross(right).Unit
	local back = bc.Unit
	local height = math.abs(ab:Dot(up))
	local out = {}
	for i, side in ipairs({ { (a + b) / 2, right, math.abs(ab:Dot(back)), back }, { (a + c) / 2, -right, math.abs(ac:Dot(back)), -back } }) do
		local w = Instance.new("WedgePart")
		w.Anchored = true
		w.CanCollide = false
		w.CanQuery = false
		w.CanTouch = false
		w.CastShadow = false
		w.Material = Enum.Material.Glass
		w.Color = color
		w.Reflectance = 0.25
		w.Transparency = alpha
		w.Size = Vector3.new(0.02, math.max(height, 0.01), math.max(side[3], 0.01))
		w.Parent = folder
		out[i] = { p = w, cf = CFrame.fromMatrix(side[1], side[2], up, side[4]) }
	end
	return out
end

-- 갈라진 화면이 유리처럼 산산이 깨져 흩어진다 (내 화면에서만)
local function screenShatter(g: ScreenGui, angle: number, onBreak: (() -> ())?)
	local cam = workspace.CurrentCamera
	if not cam then
		if onBreak then
			onBreak()
		end
		return
	end
	local vp = cam.ViewportSize
	local W, H = math.max(vp.X, 1), math.max(vp.Y, 1)
	local cx, cy = W * 0.5 + math.random(-30, 30), H * 0.5
	-- 칼자국 위의 한 점에서 사방으로 조각이 나뉜다: 칼자국 방향 두 줄 + 무작위 줄기
	local rays: { number } = { math.rad(angle), math.rad(angle) + math.pi }
	local N = 14
	for i = 1, N - 2 do
		table.insert(rays, (i / (N - 2)) * math.pi * 2 + math.random() * 0.35)
	end
	table.sort(rays)
	local diag = math.sqrt(W * W + H * H)
	local radii = { diag * (0.07 + math.random() * 0.04), diag * (0.2 + math.random() * 0.08), diag * 0.8 }
	-- rings[k][i]: k번째 고리, i번째 줄기의 점 (화면 픽셀)
	local rings: { { Vector2 } } = {}
	for k, r in ipairs(radii) do
		rings[k] = {}
		for i, a in ipairs(rays) do
			local rr = k < #radii and r * (0.75 + math.random() * 0.5) or r
			rings[k][i] = Vector2.new(cx + math.cos(a) * rr, cy + math.sin(a) * rr)
		end
	end
	local center = Vector2.new(cx, cy)

	-- 2) 화면 앞에 깔린 유리 조각들
	local depth = 2
	local h = depth * math.tan(math.rad(cam.FieldOfView) * 0.5)
	local function toCam(v: Vector2): Vector3
		return Vector3.new((v.X - W * 0.5) / (H * 0.5) * h, -(v.Y - H * 0.5) / (H * 0.5) * h, -depth)
	end
	local tris: { { Vector2 } } = {}
	for i = 1, #rays do
		local j = i % #rays + 1
		table.insert(tris, { center, rings[1][i], rings[1][j] })
		for k = 1, #radii - 1 do
			table.insert(tris, { rings[k][i], rings[k + 1][i], rings[k + 1][j] })
			table.insert(tris, { rings[k][i], rings[k + 1][j], rings[k][j] })
		end
	end
	type Shard = { parts: { { p: BasePart, cf: CFrame } }, mid: Vector3, vel: Vector3, spin: Vector3, cf: CFrame }
	local shards: { Shard } = {}
	for n, t in ipairs(tris) do
		local a, b, c = toCam(t[1]), toCam(t[2]), toCam(t[3])
		local mid = (a + b + c) / 3
		local tint = n % 3 == 0 and Color3.fromRGB(255, 205, 228) or Color3.fromRGB(236, 236, 244)
		local parts = triangle(a - mid, b - mid, c - mid, tint, 0.82)
		local outward = Vector3.new(mid.X, mid.Y, 0)
		outward = outward.Magnitude > 0.001 and outward.Unit or Vector3.new(0, 1, 0)
		local close = 1 - math.clamp(Vector3.new(mid.X, mid.Y, 0).Magnitude / (h * 2), 0, 1)
		table.insert(shards, {
			parts = parts,
			mid = mid,
			vel = outward * (1.2 + close * 2.6 + math.random() * 1.2) + Vector3.new(0, 0.6 + math.random() * 0.8, -(0.8 + math.random() * 1.6)),
			spin = Vector3.new(math.random() - 0.5, math.random() - 0.5, math.random() - 0.5) * 9,
			cf = CFrame.new(),
		})
	end
	local function place()
		local base = cam.CFrame
		for _, s in ipairs(shards) do
			local cf = base * CFrame.new(s.mid) * s.cf
			for _, w in ipairs(s.parts) do
				w.p.CFrame = cf * w.cf
			end
		end
	end
	local holdConn = RunService.RenderStepped:Connect(place)
	place()

	-- 3) 깨진다: 조각이 사방으로 튀며 떨어지고, 잿빛이 풀린다
	task.delay(0.2, function()
		holdConn:Disconnect()
		Fx.sound("shatter", 1, 1)
		Fx.sound("block", 0.8, 0.7)
		if onBreak then
			onBreak()
		end
		local flash = Instance.new("Frame")
		flash.Size = UDim2.fromScale(1, 1)
		flash.BorderSizePixel = 0
		flash.BackgroundColor3 = Color3.fromRGB(255, 235, 245)
		flash.BackgroundTransparency = 0.25
		flash.ZIndex = 7
		flash.Parent = g
		tween(flash, 0.35, { BackgroundTransparency = 1 })
		for _, s in ipairs(shards) do
			for _, w in ipairs(s.parts) do
				w.p.Transparency = 0.45
				w.p.Material = Enum.Material.Glass
				tween(w.p, 1.1, { Transparency = 1 }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
			end
		end
		local t0 = os.clock()
		local conn
		conn = RunService.RenderStepped:Connect(function(dt)
			local t = os.clock() - t0
			if t > 1.15 then
				conn:Disconnect()
				for _, s in ipairs(shards) do
					for _, w in ipairs(s.parts) do
						w.p:Destroy()
					end
				end
				return
			end
			for _, s in ipairs(shards) do
				s.vel += Vector3.new(0, -9 * dt, 0)
				s.mid += s.vel * dt
				s.cf *= CFrame.Angles(s.spin.X * dt, s.spin.Y * dt, s.spin.Z * dt)
			end
			place()
		end)
		-- 화면 가장자리로 튀는 꽃잎 조각
		Sakura.petals(cam.CFrame.Position + cam.CFrame.LookVector * 6, 40, 5, 1.4)
	end)
end

-- 화면을 비스듬히 한칼에 가르고, 두 쪽이 갈라지며 빛이 새어 나온 뒤 산산이 깨진다
local function screenSplit(onBreak: (() -> ())?)
	local g = screenGui()
	local angle = -26
	local holder = Instance.new("Frame")
	holder.BackgroundTransparency = 1
	holder.Size = UDim2.fromScale(1, 1)
	holder.Parent = g
	local function band(color: Color3, alpha: number, thick: number, z: number): Frame
		local f = Instance.new("Frame")
		f.AnchorPoint = Vector2.new(0.5, 0.5)
		f.Position = UDim2.fromScale(0.5, 0.5)
		f.Size = UDim2.new(0, 0, 0, thick)
		f.Rotation = angle
		f.BorderSizePixel = 0
		f.BackgroundColor3 = color
		f.BackgroundTransparency = alpha
		f.ZIndex = z
		f.Parent = holder
		local gr = Instance.new("UIGradient")
		gr.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.15, 0), NumberSequenceKeypoint.new(0.85, 0), NumberSequenceKeypoint.new(1, 1) })
		gr.Parent = f
		return f
	end
	-- 두 쪽 (위·아래): 어둡게 비치는 큰 판이 칼자국을 따라 갈라진다
	local halves: { Frame } = {}
	for _, s in ipairs({ -1, 1 }) do
		local f = Instance.new("Frame")
		f.AnchorPoint = Vector2.new(0.5, s < 0 and 1 or 0)
		f.Position = UDim2.fromScale(0.5, 0.5)
		f.Size = UDim2.fromScale(3, 3)
		f.Rotation = angle
		f.BorderSizePixel = 0
		f.BackgroundColor3 = Color3.fromRGB(20, 10, 16)
		f.BackgroundTransparency = 1
		f.ZIndex = 2
		f.Parent = holder
		table.insert(halves, f)
	end
	local glow = band(Color3.fromRGB(255, 120, 180), 0.2, 26, 3)
	local core = band(WHITE, 0, 6, 4)
	-- 1) 한 줄기 칼날이 화면을 가로지른다
	tween(glow, 0.09, { Size = UDim2.new(2.6, 0, 0, 26) }, Enum.EasingStyle.Quint)
	tween(core, 0.09, { Size = UDim2.new(2.6, 0, 0, 6) }, Enum.EasingStyle.Quint)
	task.delay(0.1, function()
		-- 2) 두 쪽이 갈라지며 틈으로 빛이 새어 나온다
		local rad = math.rad(angle)
		local nx, ny = -math.sin(rad), math.cos(rad)
		for i, f in ipairs(halves) do
			local s = i == 1 and -1 or 1
			f.BackgroundTransparency = 0.82
			tween(f, 0.28, { Position = UDim2.new(0.5, nx * 46 * s, 0.5, ny * 46 * s) }, Enum.EasingStyle.Back)
		end
		tween(glow, 0.28, { Size = UDim2.new(2.6, 0, 0, 120), BackgroundTransparency = 0.35 }, Enum.EasingStyle.Back)
		tween(core, 0.28, { Size = UDim2.new(2.6, 0, 0, 40) }, Enum.EasingStyle.Back)
	end)
	task.delay(0.5, function()
		-- 3) 갈라진 화면이 유리처럼 깨진다
		screenShatter(g, angle, function()
			for _, f in ipairs(halves) do
				tween(f, 0.25, { BackgroundTransparency = 1 })
			end
			tween(glow, 0.3, { Size = UDim2.new(2.6, 0, 0, 260), BackgroundTransparency = 1 })
			tween(core, 0.2, { Size = UDim2.new(2.6, 0, 0, 0), BackgroundTransparency = 1 })
			if onBreak then
				onBreak()
			end
		end)
		Debris:AddItem(g, 1.8)
	end)
end

local function severCut(data: any)
	local from, to = data.from, data.to
	if not from or not to or not near(to, 300) then
		return
	end
	-- 지나간 길보다 길게, 가슴 높이에 비스듬히 남는 하늘의 칼자국
	local dir = to - from
	if dir.Magnitude < 0.5 then
		dir = Vector3.new(0, 0, -1)
	end
	local mid = (from + to) / 2 + Vector3.new(0, 1.5, 0)
	local len = dir.Magnitude + 14
	local cf = CFrame.lookAt(mid, mid + dir) * CFrame.Angles(0, 0, (math.random() - 0.5) * 1.6)
	local glow = part(Vector3.new(1.6, 0.25, len), PINK, Enum.Material.Neon, 0.35, true)
	glow.CFrame = cf
	local core = part(Vector3.new(0.45, 0.12, len * 0.98), WHITE, Enum.Material.Neon, 0, true)
	core.CFrame = cf
	glow.Size = Vector3.new(1.6, 0.25, 0.5)
	core.Size = Vector3.new(0.45, 0.12, 0.5)
	tween(glow, 0.08, { Size = Vector3.new(1.6, 0.25, len) })
	tween(core, 0.08, { Size = Vector3.new(0.45, 0.12, len * 0.98) })
	local key = data.style or "x"
	cuts[key] = cuts[key] or {}
	table.insert(cuts[key], glow)
	table.insert(cuts[key], core)
	Sakura.petals(data.at or to, 14, 5, 1.2, dir.Unit * 8)
	Fx.burst("spark", data.at or to, WHITE, 8, 1)
	Fx.sound("ping", 0.4, 1.8 + (data.i or 0) * 0.05, to)
	-- 오래 남지 않게 (끝을 못 보면 스스로 사라진다)
	Debris:AddItem(glow, 6)
	Debris:AddItem(core, 6)
end

local function severStill(data: any)
	if mineOrNear(data, 160) then
		setGrey(true, 0.12)
		if data.m == player.Character then
			bigName("만앵참월", (data.dur or 0.9) + 1.0)
		end
	end
	-- 멈춘 세상에서 칼자국만 숨 쉬듯 빛난다
	for _, list in pairs(cuts) do
		for _, p in ipairs(list) do
			if p.Parent then
				tween(p, 0.4, { Transparency = 0 }, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut)
			end
		end
	end
	Fx.sound("ping", 0.7, 0.45, data.at)
end

local function severWind(data: any)
	local dur = data.dur or 1.3
	for _, m in ipairs(data.targets or {}) do
		local r = rootOf(m)
		if r and near(r.Position, 260) then
			-- 적마다 칼바람의 회오리: 도는 초승달 칼날 여섯, 솟구치는 꽃잎과 흰 바람
			local blades = {}
			for i = 1, 6 do
				local p = part(Vector3.new(0.3, 0.1, 3.6), i % 2 == 0 and WHITE or PINK, Enum.Material.Neon, 0.15, true)
				table.insert(blades, { p = p, a = i / 6 * math.pi * 2, h = (i % 3) * 1.4 - 1 })
			end
			local holder = part(Vector3.new(1, 1, 1), WHITE, nil, 1)
			holder.Position = r.Position
			local pe = petalEmitter(holder, 60, 0.55, 14, 1.0)
			pe.SpreadAngle = Vector2.new(30, 30)
			pe.Acceleration = Vector3.new(0, 18, 0)
			local t0 = os.clock()
			local conn
			conn = RunService.RenderStepped:Connect(function()
				local t = os.clock() - t0
				local rr = rootOf(m)
				local c = rr and rr.Position or holder.Position
				holder.Position = c
				for _, b in ipairs(blades) do
					local a = b.a + t * 9
					local rad = 3.2 + math.sin(t * 6 + b.a) * 0.6
					local pos = c + Vector3.new(math.cos(a) * rad, b.h + t * 1.2, math.sin(a) * rad)
					b.p.CFrame = CFrame.lookAt(pos, pos + Vector3.new(-math.sin(a), 0.3, math.cos(a)))
				end
				if t > dur then
					conn:Disconnect()
					for _, b in ipairs(blades) do
						b.p:Destroy()
					end
					pe.Enabled = false
					Debris:AddItem(holder, 1.2)
				end
			end)
		end
	end
end

------------------------------------------------------------------------
-- 2.3판: 초 오의 만앵참월에 거대한 벚꽃나무. 쓴 사람 뒤 땅에서 솟아 가지를 펴고 꽃을 피운다.
-- 꽃이 쏟아지는 동안 서 있다가, 마지막 일격에 꽃잎이 한꺼번에 흩어지며 사라진다
------------------------------------------------------------------------
type Tree = { trunk: { BasePart }, blooms: { BasePart }, base: Vector3 }
local trees: { [Instance]: Tree } = {}
local BARK = Color3.fromRGB(86, 52, 44)
local function limb(a: Vector3, b: Vector3, w: number): Part
	local p = part(Vector3.new(w, w, math.max(0.2, (b - a).Magnitude + w * 0.4)), BARK, Enum.Material.Wood, 0)
	p.CFrame = CFrame.lookAt((a + b) / 2, b)
	return p
end
local function growTree(m: Instance, r: BasePart)
	local old = trees[m]
	if old then
		for _, p in ipairs(old.trunk) do
			p:Destroy()
		end
		for _, p in ipairs(old.blooms) do
			p:Destroy()
		end
	end
	local look = Vector3.new(r.CFrame.LookVector.X, 0, r.CFrame.LookVector.Z)
	look = look.Magnitude > 1e-3 and look.Unit or Vector3.new(0, 0, -1)
	local right = Vector3.new(-look.Z, 0, look.X)
	local base = r.Position - look * 16 - Vector3.new(0, 2.6, 0)
	local t: Tree = { trunk = {}, blooms = {}, base = base }
	trees[m] = t
	-- 줄기: 다섯 마디가 조금씩 휘며 오른다
	local pts = { base }
	local p = base
	for i = 1, 5 do
		p = p + Vector3.new(0, 5.2, 0) + right * math.sin(i * 1.3) * 1.2 - look * 0.4
		table.insert(pts, p)
	end
	for i = 1, 5 do
		table.insert(t.trunk, limb(pts[i], pts[i + 1], 3.4 - i * 0.4))
	end
	-- 뿌리 셋
	for k = 0, 2 do
		local a = k * math.pi * 2 / 3 + 0.4
		local d = look * math.cos(a) + right * math.sin(a)
		table.insert(t.trunk, limb(base + Vector3.new(0, 1, 0), base + d * 5 - Vector3.new(0, 0.5, 0), 1.6))
	end
	-- 가지 일곱과 그 끝의 꽃송이
	local ends = {}
	for k = 1, 7 do
		local from = pts[3 + (k % 3)]
		local a = k * 2.4
		local d = (look * math.cos(a) + right * math.sin(a)) * (6 + (k % 3) * 2.5) + Vector3.new(0, 4 + (k % 2) * 3, 0)
		local mid = from + d * 0.55 + Vector3.new(0, 1.2, 0)
		table.insert(t.trunk, limb(from, mid, 1.3))
		table.insert(t.trunk, limb(mid, from + d, 0.8))
		table.insert(ends, from + d)
	end
	table.insert(ends, pts[6] + Vector3.new(0, 2, 0))
	for i, e in ipairs(ends) do
		for j = 0, 2 do
			local sz = 7 + ((i + j) % 3) * 2.2
			local b = part(Vector3.new(sz, sz * 0.7, sz), pinkAt(i + j), Enum.Material.SmoothPlastic, 0.05, true)
			b.CFrame = CFrame.new(e + Vector3.new((j - 1) * 2.6, (j % 2) * 1.6, ((i + j) % 2 - 0.5) * 2.4))
			table.insert(t.blooms, b)
		end
	end
	-- 땅에서 솟는다: 나무 전체를 아래에서 끌어올리고, 꽃송이는 0에서 피어난다
	local sink = Vector3.new(0, -30, 0)
	for _, q in ipairs(t.trunk) do
		local cf = q.CFrame
		q.CFrame = cf + sink
		tween(q, 0.7, { CFrame = cf }, Enum.EasingStyle.Back)
	end
	for i, b in ipairs(t.blooms) do
		local full = b.Size
		b.Size = Vector3.new(0.2, 0.2, 0.2)
		task.delay(0.55 + (i % 6) * 0.04, function()
			if b.Parent then
				tween(b, 0.4, { Size = full }, Enum.EasingStyle.Back)
			end
		end)
		if i % 3 == 0 then
			local a = Instance.new("Attachment")
			a.Parent = b
			petalEmitter(a, 14, 0.5, 4, 2.6)
		end
	end
	Fx.dust(base + Vector3.new(0, 1, 0), 10)
	Fx.sound("heavy", 0.8, 0.6, base)
end
local function treeFall(m: Instance)
	local t = trees[m]
	if not t then
		return
	end
	trees[m] = nil
	for _, b in ipairs(t.blooms) do
		if b.Parent then
			Sakura.petals(b.CFrame.Position, 14, b.Size.X, 2.4, Vector3.new(0, 2, 0))
			tween(b, 0.35, { Size = b.Size * 1.4, Transparency = 1 })
			Debris:AddItem(b, 0.4)
		end
	end
	for _, q in ipairs(t.trunk) do
		tween(q, 1.2, { Transparency = 1 })
		Debris:AddItem(q, 1.25)
	end
end

local function severEnd(data: any)
	treeFall(data.m)
	local at = data.at
	for _, m in ipairs(data.targets or {}) do
		local r = rootOf(m)
		if r and near(r.Position, 300) then
			Fx.blast(r.Position, PINK, WHITE, 2.6)
			Fx.flash(r.Position, PINK, 40, 4, 0.4)
			Sakura.petals(r.Position, 26, 12, 1.8)
		end
	end
	if at and near(at, 300) then
		Fx.ring(at - Vector3.new(0, 2.3, 0), PINK, 4, (data.radius or 22) * 2.6, 0.6)
		Fx.flash(at, WHITE, 90, 5, 0.5)
	end
	-- 하늘의 칼자국이 꽃잎으로 부서진다
	for key, list in pairs(cuts) do
		for _, p in ipairs(list) do
			if p.Parent then
				local pos = p.Position
				tween(p, 0.25, { Size = p.Size * Vector3.new(3, 3, 1.1), Transparency = 1 })
				Debris:AddItem(p, 0.3)
				Sakura.petals(pos, 8, p.Size.Z * 0.5, 1.6)
			end
		end
		cuts[key] = nil
	end
	if mineOrNear(data, 160) then
		-- 화면을 한칼에 가르고, 잿빛이 풀리며 분홍빛이 번진다
		screenSplit(function()
			setGrey(false, 0.35)
		end)
	end
	Fx.sound("ping", 1, 0.35, at)
end

local function severStart(data: any)
	local r = rootOf(data.m)
	if r and near(r.Position, 300) then
		Sakura.petals(r.Position, 40, 6, 1.4)
		Fx.flash(r.Position, WHITE, 30, 3, 0.25)
		growTree(data.m, r)
	end
	-- 마지막 일격을 못 받더라도 나무는 스스로 진다
	local m = data.m
	task.delay((data.dur or 4) + 1.2, function()
		treeFall(m)
	end)
	-- 끝을 못 받더라도 잿빛은 스스로 풀린다
	task.delay((data.dur or 4) + 1.5, function()
		if grey and grey.Saturation < -0.1 then
			setGrey(false, 0.4)
		end
	end)
end

local HANDLERS: { [string]: (any) -> () } = {
	sakuraStorm = stormRun,
	sakuraBurst = stormBurst,
	severStart = severStart,
	severCut = severCut,
	severStill = severStill,
	severWind = severWind,
	severEnd = severEnd,
}
function Sakura.handles(kind: any): boolean
	return type(kind) == "string" and HANDLERS[kind] ~= nil
end
function Sakura.run(data: any)
	local h = HANDLERS[data.kind]
	if h then
		h(data)
	end
end

-- 초 오의를 펼칠 때 (내 화면): 화면 가장자리가 벚꽃빛으로 물들고, 꽃잎이 화면 가득 쏟아진다
function Sakura.superIntro(model: Model)
	local r = rootOf(model)
	if r then
		Sakura.petals(r.Position + Vector3.new(0, 3, 0), 60, 16, 2.4)
		Fx.sigil(r.Position - Vector3.new(0, 2.6, 0), 20, PINK, WHITE, 1.4)
	end
	local g = screenGui()
	local edge = Instance.new("Frame")
	edge.Size = UDim2.fromScale(1, 1)
	edge.BackgroundTransparency = 1
	edge.Parent = g
	local st = Instance.new("UIStroke")
	st.Color = PINK
	st.Thickness = 60
	st.Transparency = 0.2
	st.Parent = edge
	tween(st, 1.2, { Transparency = 1, Thickness = 10 })
	-- 화면 위로 흩날리는 꽃잎 (글자 대신 둥근 판)
	for i = 1, 26 do
		local p = Instance.new("Frame")
		p.AnchorPoint = Vector2.new(0.5, 0.5)
		p.Position = UDim2.fromScale(math.random(), -0.05)
		local s = math.random(10, 22)
		p.Size = UDim2.fromOffset(s, s * 0.65)
		p.Rotation = math.random(0, 360)
		p.BackgroundColor3 = pinkAt(i)
		p.BorderSizePixel = 0
		p.Parent = g
		local cr = Instance.new("UICorner")
		cr.CornerRadius = UDim.new(1, 0)
		cr.Parent = p
		tween(p, 1.4 + math.random(), { Position = UDim2.fromScale(math.random(), 1.05), Rotation = p.Rotation + math.random(-360, 360), BackgroundTransparency = 0.6 }, Enum.EasingStyle.Sine)
	end
	Debris:AddItem(g, 2.6)
end

return Sakura
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="27">
          <Properties>
            <string name="Name">SkillFx</string>
            <string name="Source"><![CDATA[-- 권왕 1.8: 기술마다 다른 이펙트 (수치·연출은 그대로, 보이는 모양만)
-- 예전엔 모든 기술에 같은 틀 (발밑 진·고리·초승달) 이 붙어 다 비슷해 보였다. 그 틀을 없애고,
-- Fx.cast 에 따로 만든 이펙트가 없던 (속성·칸) 마다 서로 다른 모양을 하나씩 준다.
--   pillar  앞에서 솟는 기둥        wave   앞으로 밀려가는 휜 벽     spiral 몸을 감고 오르는 두 줄 나선
--   spikes  앞으로 한 줄로 솟는 가시  orbit  몸 둘레를 도는 구슬       beam   앞으로 꿰뚫는 빛줄기
--   nova    몸에서 부풀어 터지는 구   rain   앞쪽에 쏟아지는 빗줄기     vortex 앞의 한 점으로 말려드는 고리
--   cross   앞을 엇갈려 가르는 두 칼  fan    앞으로 펼쳐지는 부챗살     dome   몸을 덮는 반구
--   comet   날아가 터지는 불덩이      tunnel 앞으로 미끄러지는 세 겹 고리  crack  발밑에서 사방으로 갈라지는 땅
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local Config = require(ReplicatedStorage:WaitForChild("Config"))
local Fx = require(script.Parent:WaitForChild("Fx"))

local SkillFx = {}

local folder = Instance.new("Folder")
folder.Name = "KwonSkillFx"
folder.Parent = workspace

local WHITE = Color3.new(1, 1, 1)

local function tween(inst: Instance, time: number, goal: { [string]: any }, style: Enum.EasingStyle?, dir: Enum.EasingDirection?)
	TweenService:Create(inst, TweenInfo.new(time, style or Enum.EasingStyle.Quad, dir or Enum.EasingDirection.Out), goal):Play()
end
local function bit(size: Vector3, color: Color3, mat: Enum.Material, alpha: number, life: number, shape: string?): Part
	local p = Instance.new("Part")
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	p.Size = size
	p.Color = color
	p.Material = mat
	p.Transparency = alpha
	if shape == "ball" then
		local m = Instance.new("SpecialMesh")
		m.MeshType = Enum.MeshType.Sphere
		m.Parent = p
	elseif shape == "cyl" then
		p.Shape = Enum.PartType.Cylinder
	end
	p.Parent = folder
	task.delay(life + 0.05, function()
		p:Destroy()
	end)
	return p
end
local function rootOf(m: Instance?): BasePart?
	local r = m and m:FindFirstChild("HumanoidRootPart")
	return (r and r:IsA("BasePart")) and r or nil
end
local function near(pos: Vector3, d: number): boolean
	local cam = workspace.CurrentCamera
	return cam ~= nil and (cam.CFrame.Position - pos).Magnitude < d
end

type Look = { c: Color3, c2: Color3, mat: Enum.Material, s: number }

------------------------------------------------------------------------
-- 모양들 (cf = 몸 가운데, 앞이 -Z)
------------------------------------------------------------------------
local P: { [string]: (CFrame, Look, Model, number) -> () } = {}

P.pillar = function(cf, L, _m, _dur)
	local at = (cf * CFrame.new(0, -2.5, -5 * L.s)).Position
	local col = bit(Vector3.new(1, 4 * L.s, 4 * L.s), L.c, L.mat, 0.15, 0.45, "cyl")
	col.CFrame = CFrame.new(at) * CFrame.Angles(0, 0, math.rad(90))
	tween(col, 0.3, { Size = Vector3.new(26 * L.s, 2 * L.s, 2 * L.s), CFrame = CFrame.new(at + Vector3.new(0, 13 * L.s, 0)) * CFrame.Angles(0, 0, math.rad(90)) })
	task.delay(0.3, function()
		tween(col, 0.15, { Transparency = 1 })
	end)
	for k = 0, 2 do
		task.delay(k * 0.07, function()
			Fx.ring(at + Vector3.new(0, 1 + k * 5 * L.s, 0), k == 1 and L.c2 or L.c, 2, (12 - k * 3) * L.s, 0.35)
		end)
	end
	Fx.dust(at, 2 * L.s)
end
P.wave = function(cf, L, _m, _dur)
	for k = -5, 5 do
		local a = k / 5 * 0.9
		local seg = bit(Vector3.new(2.2 * L.s, 5 * L.s * (1 - math.abs(k) / 8), 0.5), k % 2 == 0 and L.c or L.c2, L.mat, 0.1, 0.5)
		local lp = CFrame.Angles(0, a, 0) * CFrame.new(0, 0, -3)
		seg.CFrame = cf * lp
		tween(seg, 0.45, { CFrame = cf * CFrame.Angles(0, a, 0) * CFrame.new(0, 0.5, -16 * L.s), Transparency = 1 })
	end
end
P.spiral = function(cf, L, m, dur)
	local list = {}
	for i = 1, 16 do
		list[i] = bit(Vector3.one * 0.8 * L.s, i % 2 == 0 and L.c or L.c2, L.mat, 0.1, math.min(1.4, dur + 0.3), "ball")
	end
	local t0 = os.clock()
	local conn
	conn = RunService.Heartbeat:Connect(function()
		local t = os.clock() - t0
		local r = rootOf(m)
		if t > math.min(1.3, dur + 0.2) or not r then
			conn:Disconnect()
			return
		end
		for i, b in ipairs(list) do
			local strand = i % 2 == 0 and math.pi or 0
			local k = (i - 1) // 2
			local a = t * 9 + k * 0.8 + strand
			local y = -2.4 + ((k / 8 + t * 1.4) % 1) * 6 * L.s
			b.Position = r.Position + Vector3.new(math.cos(a) * 2.6 * L.s, y, math.sin(a) * 2.6 * L.s)
			b.Transparency = math.clamp(t / 1.3, 0.1, 1)
		end
	end)
end
P.spikes = function(cf, L, _m, _dur)
	for k = 1, 6 do
		task.delay(k * 0.05, function()
			local at = (cf * CFrame.new((k % 2 == 0 and 1 or -1) * 0.8, -2.6, -2.5 - k * 2.6 * L.s)).Position
			local sp = bit(Vector3.new(1.2, 0.4, 1.2) * L.s, k % 2 == 0 and L.c or L.c2, L.mat, 0.05, 0.6)
			sp.CFrame = CFrame.new(at) * CFrame.Angles(math.rad(10), k, math.rad(-10))
			tween(sp, 0.12, { Size = Vector3.new(1.4 * L.s, (4 + k * 0.6) * L.s, 1.4 * L.s), CFrame = sp.CFrame * CFrame.new(0, (2 + k * 0.3) * L.s, 0) })
			task.delay(0.35, function()
				tween(sp, 0.2, { Transparency = 1, Size = sp.Size * Vector3.new(0.5, 0.2, 0.5) })
			end)
		end)
	end
end
P.orbit = function(cf, L, m, dur)
	local n = 6
	local list = {}
	for i = 1, n do
		list[i] = bit(Vector3.one * 1.3 * L.s, i % 2 == 0 and L.c or L.c2, L.mat, 0.05, math.min(1.6, dur + 0.4), "ball")
	end
	local t0 = os.clock()
	local conn
	conn = RunService.Heartbeat:Connect(function()
		local t = os.clock() - t0
		local r = rootOf(m)
		local life = math.min(1.5, dur + 0.3)
		if t > life or not r then
			conn:Disconnect()
			return
		end
		local rad = (3 + t * 2) * L.s
		for i, b in ipairs(list) do
			local a = t * 6 + i / n * math.pi * 2
			b.Position = r.Position + Vector3.new(math.cos(a) * rad, math.sin(a * 2) * 0.6, math.sin(a) * rad)
			b.Transparency = math.clamp((t / life) ^ 2, 0.05, 1)
		end
	end)
end
P.beam = function(cf, L, _m, _dur)
	local len = 30 * L.s
	local mid = cf * CFrame.new(0, 0.3, -len / 2 - 1)
	local b = bit(Vector3.new(len, 0.4, 0.4), L.c2, Enum.Material.Neon, 0, 0.4, "cyl")
	b.CFrame = mid * CFrame.Angles(0, math.rad(90), 0)
	local glow = bit(Vector3.new(len, 1.6 * L.s, 1.6 * L.s), L.c, L.mat, 0.4, 0.4, "cyl")
	glow.CFrame = b.CFrame
	tween(b, 0.35, { Size = Vector3.new(len, 0.05, 0.05), Transparency = 1 })
	tween(glow, 0.35, { Size = Vector3.new(len, 3.2 * L.s, 3.2 * L.s), Transparency = 1 })
	Fx.ring((cf * CFrame.new(0, 0.3, -2)).Position, L.c, 1, 7 * L.s, 0.3, cf.LookVector)
end
P.nova = function(cf, L, _m, _dur)
	local shell = bit(Vector3.one * 2, L.c, L.mat, 0.35, 0.45, "ball")
	shell.Position = cf.Position
	tween(shell, 0.4, { Size = Vector3.one * 18 * L.s, Transparency = 1 })
	local core = bit(Vector3.one * 1, WHITE, Enum.Material.Neon, 0, 0.25, "ball")
	core.Position = cf.Position
	tween(core, 0.2, { Size = Vector3.one * 7 * L.s, Transparency = 1 })
end
P.rain = function(cf, L, _m, _dur)
	local center = (cf * CFrame.new(0, -2.5, -9 * L.s)).Position
	for k = 0, 11 do
		task.delay(k * 0.04, function()
			local at = center + Vector3.new(math.random(-6, 6) * L.s, 0, math.random(-6, 6) * L.s)
			local d = bit(Vector3.new(0.3, 6, 0.3), k % 2 == 0 and L.c or L.c2, Enum.Material.Neon, 0.1, 0.3)
			d.Position = at + Vector3.new(0, 26, 0)
			tween(d, 0.18, { Position = at + Vector3.new(0, 3, 0) }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
			task.delay(0.18, function()
				d.Transparency = 1
				Fx.ring(at + Vector3.new(0, 0.3, 0), L.c, 0.5, 4 * L.s, 0.25)
			end)
		end)
	end
end
P.vortex = function(cf, L, _m, _dur)
	local at = (cf * CFrame.new(0, 0, -6 * L.s)).Position
	for k = 0, 13 do
		local a0 = k / 14 * math.pi * 2
		local seg = bit(Vector3.new(0.3, 0.3, 2.4 * L.s), k % 2 == 0 and L.c or L.c2, L.mat, 0.1, 0.5)
		local t0 = os.clock()
		local conn
		conn = RunService.Heartbeat:Connect(function()
			local t = os.clock() - t0
			if t > 0.45 or not seg.Parent then
				conn:Disconnect()
				return
			end
			local u = t / 0.45
			local a = a0 + u * 5
			local r = (9 - 8.5 * u) * L.s
			local p = at + Vector3.new(math.cos(a) * r, math.sin(a * 3) * 0.6, math.sin(a) * r)
			seg.CFrame = CFrame.lookAt(p, p + Vector3.new(-math.sin(a), 0, math.cos(a)))
			seg.Transparency = u
		end)
	end
	task.delay(0.45, function()
		local pop = bit(Vector3.one, WHITE, Enum.Material.Neon, 0, 0.25, "ball")
		pop.Position = at
		tween(pop, 0.22, { Size = Vector3.one * 6 * L.s, Transparency = 1 })
	end)
end
P.cross = function(cf, L, _m, _dur)
	local at = cf * CFrame.new(0, 0.5, -5 * L.s)
	for i, a in ipairs({ math.rad(45), math.rad(-45) }) do
		task.delay((i - 1) * 0.08, function()
			local blade = bit(Vector3.new(0.3, 0.3, 0.6), i == 1 and L.c2 or L.c, Enum.Material.Neon, 0, 0.35)
			blade.CFrame = at * CFrame.Angles(0, 0, a) * CFrame.Angles(0, math.rad(90), 0)
			tween(blade, 0.12, { Size = Vector3.new(0.25, 0.25, 14 * L.s) })
			task.delay(0.14, function()
				tween(blade, 0.2, { Size = Vector3.new(0.05, 1.6 * L.s, 15 * L.s), Transparency = 1 })
			end)
		end)
	end
	Fx.spark(at.Position, L.c, 1.2 * L.s, 10)
end
P.fan = function(cf, L, _m, _dur)
	for k = -6, 6 do
		local a = k / 6 * 1.1
		local ray = bit(Vector3.new(0.25, 0.25, 0.5), k % 2 == 0 and L.c or L.c2, Enum.Material.Neon, 0, 0.35)
		local base = cf * CFrame.Angles(0, a, 0)
		ray.CFrame = base * CFrame.new(0, 0.6, -1.5)
		tween(ray, 0.3, { CFrame = base * CFrame.new(0, 0.6, -7 * L.s), Size = Vector3.new(0.1, 0.1, 9 * L.s), Transparency = 1 })
	end
end
P.dome = function(cf, L, _m, dur)
	local life = math.clamp(dur, 0.5, 1.2)
	local d = bit(Vector3.one * 2, L.c, L.mat, 0.5, life + 0.1, "ball")
	d.Position = cf.Position - Vector3.new(0, 2, 0)
	tween(d, 0.2, { Size = Vector3.new(12, 9, 12) * L.s })
	task.delay(life - 0.25, function()
		tween(d, 0.25, { Size = Vector3.new(15, 11, 15) * L.s, Transparency = 1 })
	end)
	Fx.ring(cf.Position - Vector3.new(0, 2.4, 0), L.c2, 6 * L.s, 13 * L.s, life)
end
P.comet = function(cf, L, _m, _dur)
	local from = (cf * CFrame.new(0.8, 0.5, -1.5)).Position
	local to = (cf * CFrame.new(0, -1.5, -18 * L.s)).Position
	local ball = bit(Vector3.one * 2.2 * L.s, L.c, Enum.Material.Neon, 0, 0.4, "ball")
	ball.Position = from
	local trail = bit(Vector3.new(0.6, 0.6, 1), L.c2, Enum.Material.Neon, 0.3, 0.4)
	trail.CFrame = CFrame.lookAt(from, to)
	tween(ball, 0.25, { Position = to }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
	tween(trail, 0.25, { CFrame = CFrame.lookAt((from + to) / 2, to), Size = Vector3.new(0.2, 0.2, (to - from).Magnitude), Transparency = 0.8 })
	task.delay(0.25, function()
		ball.Transparency = 1
		trail.Transparency = 1
		Fx.blast(to, L.c, L.c2, 1.3 * L.s)
		Fx.ring(to - Vector3.new(0, 0.8, 0), L.c2, 1, 12 * L.s, 0.35)
	end)
end
P.tunnel = function(cf, L, _m, _dur)
	for k = 0, 2 do
		task.delay(k * 0.07, function()
			local ring = bit(Vector3.new(0.3, 4 * L.s, 4 * L.s), k == 1 and L.c2 or L.c, L.mat, 0.2, 0.45, "cyl")
			ring.CFrame = cf * CFrame.new(0, 0.3, -2) * CFrame.Angles(0, math.rad(90), 0)
			tween(ring, 0.4, { CFrame = cf * CFrame.new(0, 0.3, -14 * L.s) * CFrame.Angles(0, math.rad(90), 0), Size = Vector3.new(0.1, 8 * L.s, 8 * L.s), Transparency = 1 })
		end)
	end
end
P.crack = function(cf, L, _m, _dur)
	local at = cf.Position - Vector3.new(0, 2.5, 0)
	for k = 0, 9 do
		local a = k / 10 * math.pi * 2 + math.random() * 0.3
		local len = (6 + math.random() * 5) * L.s
		local c = bit(Vector3.new(0.5, 0.2, 0.2), k % 2 == 0 and L.c or L.c2, Enum.Material.Neon, 0, 0.7)
		local base = CFrame.new(at) * CFrame.Angles(0, a, 0)
		c.CFrame = base * CFrame.new(0, 0, -0.5)
		tween(c, 0.15, { CFrame = base * CFrame.new(0, 0, -len / 2), Size = Vector3.new(0.45, 0.2, len) })
		task.delay(0.4, function()
			tween(c, 0.3, { Transparency = 1 })
		end)
	end
	Fx.dust(at, 2.5 * L.s)
end

------------------------------------------------------------------------
-- 속성마다 강타 (H) · E · R 의 모양과 재질 (한 권법 안에서 셋이 서로 다르다)
------------------------------------------------------------------------
local PLAN: { [string]: { [string]: string } } = {
	celestial = { E = "fan", R = "comet" },
	cloud = { H = "nova", E = "orbit", R = "wave" },
	duel = { H = "cross", E = "spikes", R = "tunnel" },
	eclipse = { H = "dome", E = "orbit", R = "beam" },
	fire = { H = "pillar", E = "wave", R = "comet" },
	galaxy = { H = "vortex", E = "spiral", R = "rain" },
	gravity = { H = "crack", E = "vortex", R = "dome" },
	ocean = { H = "wave", E = "spiral", R = "tunnel" },
	origin = { H = "beam", E = "fan", R = "pillar" },
	subspace = { H = "cross", E = "nova", R = "tunnel" },
	time = { H = "crack", E = "orbit", R = "rain" },
	wind = { R = "spiral" },
}
-- 1.9판: 권법마다 따로 (같은 속성이라도 각성 권법은 모양이 다르다)
local PLAN_STYLE: { [string]: { [string]: string } } = {
	geumgang2 = { H = "crack", E = "dome", R = "spikes" },
	muyeong2 = { H = "fan", E = "cross", R = "vortex" },
	taeheo2 = { H = "nova", E = "wave", R = "spiral" },
	yeolhwa2 = { H = "comet", E = "spikes", R = "pillar" },
	changhae2 = { H = "tunnel", E = "wave", R = "spiral" },
	pungsin2 = { H = "fan", E = "cross", R = "spiral" },
	chobyeok = { H = "cross", E = "beam", R = "rain" },
}
local MAT: { [string]: Enum.Material } = {
	cloud = Enum.Material.SmoothPlastic,
	ocean = Enum.Material.Glass,
	subspace = Enum.Material.Glass,
	duel = Enum.Material.Metal,
	gravity = Enum.Material.Neon,
	geumgang2 = Enum.Material.Foil,
	taeheo2 = Enum.Material.Glass,
}

function SkillFx.cast(styleId: any, slot: any, model: Model, dur: number)
	local style = type(styleId) == "string" and Config.STYLE_BY_ID[styleId] or nil
	if not style or (slot ~= "H" and slot ~= "E" and slot ~= "R") then
		return
	end
	local plan = PLAN_STYLE[style.id] or PLAN[style.fx]
	local shape = plan and plan[slot]
	local fn = shape and P[shape]
	local r = rootOf(model)
	if not fn or not r or not near(r.Position, 180) then
		return
	end
	local L: Look = { c = style.color, c2 = style.color2, mat = MAT[style.id] or MAT[style.fx] or Enum.Material.Neon, s = slot == "H" and 0.9 or 1.15 }
	task.delay(math.min(0.15, dur * 0.3), function()
		local rr = rootOf(model)
		if not rr then
			return
		end
		local look = Vector3.new(rr.CFrame.LookVector.X, 0, rr.CFrame.LookVector.Z)
		look = look.Magnitude > 0.01 and look.Unit or Vector3.new(0, 0, -1)
		fn(CFrame.lookAt(rr.Position, rr.Position + look), L, model, dur)
	end)
end

return SkillFx
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="28">
          <Properties>
            <string name="Name">UI</string>
            <string name="Source"><![CDATA[-- 권왕: 화면 (체력·균형·내공 막대, 기술 칸, 창, 수련 놀이, 알림)
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")

local Config = require(ReplicatedStorage:WaitForChild("Config"))

local UI = {}

local player = Players.LocalPlayer
local Request: RemoteEvent

local C = {
	bg = Color3.fromRGB(22, 16, 14),
	panel = Color3.fromRGB(40, 28, 24),
	panel2 = Color3.fromRGB(64, 44, 34),
	line = Color3.fromRGB(190, 150, 90),
	gold = Color3.fromRGB(255, 210, 120),
	text = Color3.fromRGB(250, 240, 225),
	dim = Color3.fromRGB(200, 185, 165),
	red = Color3.fromRGB(220, 60, 50),
	hp = Color3.fromRGB(215, 50, 45),
	posture = Color3.fromRGB(255, 180, 60),
	chi = Color3.fromRGB(80, 170, 255),
	green = Color3.fromRGB(90, 200, 120),
}
UI.C = C

local function new(class: string, props: { [string]: any }?, children: { Instance }?): any
	local inst = Instance.new(class)
	if props then
		for k, v in pairs(props) do
			if k ~= "Parent" then
				(inst :: any)[k] = v
			end
		end
	end
	for _, c in ipairs(children or {}) do
		c.Parent = inst
	end
	if props and props.Parent then
		inst.Parent = props.Parent
	end
	return inst
end
local function corner(r: number?): UICorner
	return new("UICorner", { CornerRadius = UDim.new(0, r or 10) })
end
local function stroke(color: Color3?, t: number?): UIStroke
	return new("UIStroke", { Color = color or C.line, Thickness = t or 1.5, ApplyStrokeMode = Enum.ApplyStrokeMode.Border })
end
local function text(props: { [string]: any }): TextLabel
	local base = { BackgroundTransparency = 1, Font = Enum.Font.GothamBold, TextColor3 = C.text, TextSize = 16, TextWrapped = true, TextXAlignment = Enum.TextXAlignment.Left }
	for k, v in pairs(props) do
		base[k] = v
	end
	return new("TextLabel", base)
end
local function button(props: { [string]: any }, onClick: () -> ()): TextButton
	local base = { BackgroundColor3 = C.panel2, Font = Enum.Font.GothamBlack, TextColor3 = C.text, TextSize = 16, AutoButtonColor = true, Text = "" }
	for k, v in pairs(props) do
		base[k] = v
	end
	local b = new("TextButton", base, { corner(8) })
	b.Activated:Connect(onClick)
	return b
end
UI.new, UI.corner, UI.stroke, UI.text, UI.button = new, corner, stroke, text, button

local gui: ScreenGui
local uiScale = 1
local windowScale = 1

-- 화면 크기에 맞춘 확대. 게임 시작 직후엔 화면 크기가 1×1로 잡힐 때가 있어
-- (그때 재면 창이 안 보일 만큼 작아진다) 크기가 바뀔 때마다 다시 재고, 너무 작으면 무시한다
local scales: { { s: UIScale, kind: string } } = {}
local function scaleFor(kind: string): number
	if kind == "window" then
		return windowScale
	elseif kind == "map" then
		return math.min(uiScale * 0.9, windowScale)
	end
	return uiScale
end
local function scaled(parent: Instance, kind: string?): UIScale
	local k = kind or "ui"
	local sc = Instance.new("UIScale")
	sc.Scale = scaleFor(k)
	sc.Parent = parent
	table.insert(scales, { s = sc, kind = k })
	return sc
end
local function measure()
	local cam = workspace.CurrentCamera
	local vp = cam and cam.ViewportSize or Vector2.new(1280, 720)
	if vp.X < 320 or vp.Y < 240 then
		vp = Vector2.new(1280, 720) -- 아직 화면이 안 잡혔다
	end
	uiScale = math.clamp(vp.Y / 720, 0.75, 1.7)
	windowScale = math.clamp(math.min(uiScale, vp.Y * 0.9 / 600, vp.X * 0.95 / 900), 0.5, 1.7)
	for _, e in ipairs(scales) do
		if e.s.Parent then
			e.s.Scale = scaleFor(e.kind)
		end
	end
end

------------------------------------------------------------------------
-- 알림과 큰 글자
------------------------------------------------------------------------
local toastBox: Frame
function UI.toast(msg: string)
	if not toastBox then
		return
	end
	local l = text({ Size = UDim2.new(1, 0, 0, 34), Text = msg, TextSize = 21, TextXAlignment = Enum.TextXAlignment.Center, TextStrokeTransparency = 0.3, Parent = toastBox })
	task.delay(3, function()
		if not l.Parent then
			return
		end
		TweenService:Create(l, TweenInfo.new(0.4), { TextTransparency = 1, TextStrokeTransparency = 1 }):Play()
		task.delay(0.45, function()
			l:Destroy()
		end)
	end)
	local kids = toastBox:GetChildren()
	if #kids > 6 then
		for i = 1, #kids - 6 do
			if kids[i]:IsA("TextLabel") then
				kids[i]:Destroy()
			end
		end
	end
end

function UI.banner(title: string, sub: string?, color: Color3?)
	local f = new("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0.5, 0, 0.3, 0), Size = UDim2.new(0, 760, 0, 110), BackgroundTransparency = 1, ZIndex = 20, Parent = gui })
	local sc = new("UIScale", { Scale = uiScale * 1.6, Parent = f })
	local t = text({ Size = UDim2.new(1, 0, 0, 64), Text = title, TextSize = 50, Font = Enum.Font.GothamBlack, TextColor3 = color or C.gold, TextXAlignment = Enum.TextXAlignment.Center, TextStrokeTransparency = 0, Parent = f })
	local s = text({ Position = UDim2.new(0, 0, 0, 66), Size = UDim2.new(1, 0, 0, 34), Text = sub or "", TextSize = 22, TextXAlignment = Enum.TextXAlignment.Center, TextStrokeTransparency = 0.3, Parent = f })
	TweenService:Create(sc, TweenInfo.new(0.25, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = uiScale }):Play()
	task.delay(2.2, function()
		TweenService:Create(t, TweenInfo.new(0.4), { TextTransparency = 1, TextStrokeTransparency = 1 }):Play()
		TweenService:Create(s, TweenInfo.new(0.4), { TextTransparency = 1, TextStrokeTransparency = 1 }):Play()
		task.delay(0.45, function()
			f:Destroy()
		end)
	end)
end

-- 화면 번쩍임
local flash: Frame
function UI.flash(color: Color3, strength: number)
	flash.BackgroundColor3 = color
	flash.BackgroundTransparency = 1 - math.clamp(strength, 0, 0.7)
	TweenService:Create(flash, TweenInfo.new(0.3), { BackgroundTransparency = 1 }):Play()
end

-- 오의: 위아래 검은 띠와 기술 이름
local bars: { Frame } = {}
-- 오의 화면 연출: 검은 섬광 한 번, 가운데로 몰려드는 집중선, 권법 빛깔의 테두리
function UI.ultFrame(color: Color3, color2: Color3)
	local layer = new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, ZIndex = 35, Active = false, Parent = gui })
	local inv = new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(0, 0, 0), BackgroundTransparency = 0.15, ZIndex = 35, Parent = layer })
	task.delay(0.05, function()
		inv.BackgroundColor3 = color2
		TweenService:Create(inv, TweenInfo.new(0.25), { BackgroundTransparency = 1 }):Play()
	end)
	-- 줄마다 가운데를 향하게 놓는다 (프레임은 제 가운데를 축으로 돌므로 자리는 각도로 따로 잡는다)
	local cam = workspace.CurrentCamera
	local vp = cam and cam.ViewportSize or Vector2.new(1280, 720)
	local reach = vp.Magnitude * 0.5
	for i = 1, 30 do
		local a = i / 30 * 360 + math.random() * 8
		local dir = Vector2.new(math.cos(math.rad(a)), math.sin(math.rad(a)))
		local len = reach * (0.45 + math.random() * 0.2)
		local function at(r: number): UDim2
			return UDim2.new(0.5, dir.X * r, 0.5, dir.Y * r)
		end
		local line = new("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = at(reach * 0.95), Size = UDim2.fromOffset(len, math.random(2, 6)), Rotation = a,
			BackgroundColor3 = i % 3 == 0 and color or Color3.new(1, 1, 1), BackgroundTransparency = 0.2, BorderSizePixel = 0, ZIndex = 36, Parent = layer })
		-- 가운데 쪽 끝은 흐리게
		new("UIGradient", { Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.5, 0.6), NumberSequenceKeypoint.new(1, 0) }), Parent = line })
		-- 바깥에서 가운데로 몰려든다
		TweenService:Create(line, TweenInfo.new(0.5, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Position = at(reach * 0.55), Size = UDim2.fromOffset(len * 0.6, 1), BackgroundTransparency = 1 }):Play()
	end
	-- 테두리는 프레임 바깥으로 그려지므로 안쪽으로 당겨 둔다
	local rim = new("Frame", { Position = UDim2.fromOffset(24, 24), Size = UDim2.new(1, -48, 1, -48), BackgroundTransparency = 1, ZIndex = 36, Parent = layer }, { new("UIStroke", { Color = color, Thickness = 40, Transparency = 0.2 }) })
	local st = rim:FindFirstChildOfClass("UIStroke")
	if st then
		TweenService:Create(st, TweenInfo.new(0.7), { Transparency = 1, Thickness = 8 }):Play()
	end
	task.delay(0.75, function()
		layer:Destroy()
	end)
end

function UI.cinematic(name: string, color: Color3, dur: number)
	for _, b in ipairs(bars) do
		TweenService:Create(b, TweenInfo.new(0.2), { Size = UDim2.new(1, 0, 0.1, 0) }):Play()
	end
	UI.banner("오의 · " .. name, nil, color)
	task.delay(dur, function()
		for _, b in ipairs(bars) do
			TweenService:Create(b, TweenInfo.new(0.3), { Size = UDim2.new(1, 0, 0, 0) }):Play()
		end
	end)
end

------------------------------------------------------------------------
-- 내 막대 (아래 가운데)
------------------------------------------------------------------------
local HUD: any = {}

-- 위가 밝고 아래가 어두운 빛 (막대·칸에 입힌다)
local function sheen(parent: Instance, top: number?, bottom: number?)
	new("UIGradient", { Rotation = 90, Color = ColorSequence.new(Color3.new(1, 1, 1):Lerp(Color3.new(1, 1, 1), 0), Color3.fromRGB(150, 150, 150)), Transparency = NumberSequence.new(top or 0, bottom or 0), Parent = parent })
end
UI.sheen = sheen
local meterTrails: { [Frame]: Frame } = {}
local function meter(parent: Instance, pos: UDim2, size: UDim2, color: Color3, label: string): (Frame, TextLabel)
	local back = new("Frame", { Position = pos, Size = size, BackgroundColor3 = Color3.fromRGB(16, 11, 10), BackgroundTransparency = 0.1, Parent = parent }, { corner(6), stroke(Color3.fromRGB(150, 115, 70), 1.4) })
	-- 깎인 만큼 잠깐 남는 흰 띠 (맞은 양이 보인다)
	local trail = new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.fromRGB(255, 240, 220), BackgroundTransparency = 0.25, Parent = back }, { corner(6) })
	local fill = new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = color, ZIndex = 2, Parent = back }, { corner(6) })
	sheen(fill)
	meterTrails[fill] = trail
	local l = text({ Size = UDim2.fromScale(1, 1), Text = label, TextSize = 16, Font = Enum.Font.GothamBold, TextXAlignment = Enum.TextXAlignment.Center, TextStrokeTransparency = 0.3, ZIndex = 3, Parent = back })
	return fill, l
end
-- 흰 띠가 천천히 따라 내려온다
local function trailTo(fill: Frame, r: number)
	fill.Size = UDim2.fromScale(r, 1)
	local trail = meterTrails[fill]
	if trail then
		local cur = trail.Size.X.Scale
		trail.Size = UDim2.fromScale(r > cur and r or cur + (r - cur) * 0.06, 1)
	end
end

local function buildHud()
	local hud = new("Frame", { AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -14), Size = UDim2.new(0, 660, 0, 176), BackgroundTransparency = 1, Parent = gui })
	scaled(hud)
	-- 막대 뒤의 어두운 판과 금빛 테
	local plate = new("Frame", { Position = UDim2.new(0, -14, 0, 48), Size = UDim2.new(1, 28, 0, 76), BackgroundColor3 = Color3.fromRGB(14, 10, 9), BackgroundTransparency = 0.35, ZIndex = 0, Parent = hud }, { corner(12), stroke(Color3.fromRGB(150, 115, 70), 1) })
	new("UIGradient", { Rotation = 90, Transparency = NumberSequence.new(0.2, 0.6), Parent = plate })
	HUD.style = text({ Size = UDim2.new(1, 0, 0, 28), TextSize = 22, Font = Enum.Font.GothamBlack, TextXAlignment = Enum.TextXAlignment.Center, TextStrokeTransparency = 0.3, Parent = hud })
	HUD.stacks = text({ Position = UDim2.new(0, 0, 0, 27), Size = UDim2.new(1, 0, 0, 22), TextSize = 18, TextColor3 = C.gold, TextXAlignment = Enum.TextXAlignment.Center, TextStrokeTransparency = 0.3, Parent = hud })
	-- 균형: 가운데에서 양옆으로 차오른다 (꽉 차면 파훼)
	local pBack = new("Frame", { Position = UDim2.new(0.15, 0, 0, 54), Size = UDim2.new(0.7, 0, 0, 12), BackgroundColor3 = Color3.fromRGB(20, 14, 12), BackgroundTransparency = 0.3, Parent = hud }, { corner(5) })
	HUD.posture = new("Frame", { AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.fromScale(0.5, 0), Size = UDim2.fromScale(0, 1), BackgroundColor3 = C.posture, Parent = pBack }, { corner(5) })
	HUD.hp, HUD.hpText = meter(hud, UDim2.new(0, 0, 0, 72), UDim2.new(1, 0, 0, 26), C.hp, "")
	HUD.chi, HUD.chiText = meter(hud, UDim2.new(0.15, 0, 0, 102), UDim2.new(0.7, 0, 0, 16), C.chi, "")
	-- 기술 칸
	local row = new("Frame", { Position = UDim2.new(0, 0, 0, 124), Size = UDim2.new(1, 0, 0, 50), BackgroundTransparency = 1, Parent = hud }, {
		new("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, HorizontalAlignment = Enum.HorizontalAlignment.Center, Padding = UDim.new(0, 6) }),
	})
	HUD.slots = {}
	for _, s in ipairs({ { "M1", "클릭" }, { "H", "Z 강타" }, { "E", "E" }, { "R", "R" }, { "G", "G 오의" }, { "X", "X 초 오의" }, { "Q", "Q 대시" }, { "F", "F 막기" }, { "P", "H 약" } }) do
		local cell = new("Frame", { Size = UDim2.new(0, 76, 1, 0), BackgroundColor3 = C.panel, BackgroundTransparency = 0.1, Parent = row }, { corner(8) })
		local st = stroke(C.line, 1.2)
		st.Parent = cell
		sheen(cell, 0, 0)
		-- 위의 빛깔 띠 (쓰는 권법의 빛)
		local stripe = new("Frame", { Size = UDim2.new(1, -8, 0, 3), Position = UDim2.new(0, 4, 0, 2), BackgroundColor3 = C.gold, BorderSizePixel = 0, ZIndex = 3, Parent = cell }, { corner(2) })
		local name = text({ Size = UDim2.new(1, -4, 0.62, 0), Position = UDim2.new(0, 2, 0, 2), TextSize = 14, Font = Enum.Font.GothamBold, TextXAlignment = Enum.TextXAlignment.Center, ZIndex = 3, Parent = cell })
		local key = text({ Position = UDim2.new(0, 0, 0.6, 0), Size = UDim2.new(1, 0, 0.4, 0), Text = s[2], TextSize = 12, TextColor3 = C.dim, TextXAlignment = Enum.TextXAlignment.Center, ZIndex = 3, Parent = cell })
		local cd = new("Frame", { AnchorPoint = Vector2.new(0, 1), Position = UDim2.fromScale(0, 1), Size = UDim2.fromScale(1, 0), BackgroundColor3 = Color3.new(0, 0, 0), BackgroundTransparency = 0.35, ZIndex = 4, Parent = cell }, { corner(8) })
		local _ = key
		HUD.slots[s[1]] = { cell = cell, name = name, cd = cd, stripe = stripe, stroke = st }
	end
end

-- 매 순간 내 막대
function UI.bars(hp: number, maxHp: number, posture: number, postureMax: number, chi: number, chiMax: number?)
	if not HUD.hp then
		return
	end
	trailTo(HUD.hp, math.clamp(hp / math.max(1, maxHp), 0, 1))
	HUD.hpText.Text = string.format("❤ %d / %d", math.floor(hp), maxHp)
	local pr = math.clamp(posture / math.max(1, postureMax), 0, 1)
	HUD.posture.Size = UDim2.fromScale(pr, 1)
	HUD.posture.BackgroundColor3 = pr > 0.75 and C.red or C.posture
	local cm = chiMax or Config.CHI_MAX
	HUD.chi.Size = UDim2.fromScale(math.clamp(chi / cm, 0, 1), 1)
	HUD.chiText.Text = string.format("🌀 내공 %d / %d", math.floor(chi), cm)
end

-- 기술 칸 (이름, 잠김, 대기 시간 비율)
function UI.slots(info: { [string]: { name: string, locked: boolean?, cd: number? } })
	if not HUD.slots then
		return
	end
	for key, s in pairs(HUD.slots) do
		local i = info[key]
		-- 초 오의 칸은 초월 권법일 때만
		if key == "X" then
			s.cell.Visible = i ~= nil
		end
		if i then
			s.name.Text = (i.locked and "🔒 " or "") .. i.name
			s.name.TextColor3 = i.locked and C.dim or C.text
			local cdr = math.clamp(i.cd or 0, 0, 1)
			s.cd.Size = UDim2.fromScale(1, cdr)
			-- 쓸 수 있는 기술은 테가 권법 빛으로 빛난다
			if s.stripe and HUD.styleColor then
				s.stripe.BackgroundColor3 = HUD.styleColor
				s.stroke.Color = (cdr <= 0 and not i.locked and (key == "E" or key == "R" or key == "G" or key == "X")) and HUD.styleColor or C.line
				s.stroke.Thickness = (cdr <= 0 and not i.locked and (key == "G" or key == "X")) and (key == "X" and 3.5 or 2.5) or 1.2
			end
		end
	end
end

function UI.styleLine(t: string, color: Color3, stacks: string)
	if HUD.style then
		HUD.style.Text = t
		HUD.style.TextColor3 = color
		HUD.styleColor = color
		HUD.stacks.Text = stacks
	end
end

------------------------------------------------------------------------
-- 보스 막대 (위 가운데)
------------------------------------------------------------------------
local bossFrame: Frame
local bossFill: Frame
local bossPosture: Frame
local bossName: TextLabel
local bossSub: TextLabel
local bossHpText: TextLabel
local bossModel: Model? = nil
function UI.setBoss(model: Model?)
	bossModel = model
	bossFrame.Visible = model ~= nil
	if model then
		local label = model:GetAttribute("Label")
		bossName.Text = "👹 " .. (type(label) == "string" and label or "보스")
		UI.bossPhase(tonumber(model:GetAttribute("BossPhase")) or 1)
	end
end
function UI.bossPhase(ph: number)
	if bossSub and bossModel then
		local lv = bossModel:GetAttribute("Level")
		local power = bossModel:GetAttribute("Power")
		bossSub.Text = string.format("Lv.%s  ·  %d단계 / 3  ·  ⚔ 전투력 %s", tostring(lv or "?"), ph, Config.formatNumber(tonumber(power) or 0))
		bossSub.TextColor3 = ph >= 3 and Color3.fromRGB(255, 90, 70) or (ph == 2 and Color3.fromRGB(255, 170, 90) or C.dim)
	end
end

------------------------------------------------------------------------
-- 적 머리 위 이름표 (이름, 체력, 균형)
------------------------------------------------------------------------
function UI.enemyTag(model: Model)
	local head = model:WaitForChild("Head", 5)
	if not head or not head:IsA("BasePart") or head:FindFirstChild("EnemyTag") then
		return
	end
	local isBoss = model:GetAttribute("Boss") == true
	local w = isBoss and 300 or 230
	local bb = new("BillboardGui", { Name = "EnemyTag", Size = UDim2.new(0, w, 0, 76), StudsOffset = Vector3.new(0, 3.2, 0), AlwaysOnTop = true, LightInfluence = 0, MaxDistance = isBoss and 200 or 130, Parent = head })
	local label = model:GetAttribute("Label")
	local lv = model:GetAttribute("Level")
	local lvText = type(lv) == "number" and string.format("Lv.%d ", lv) or ""
	local name = text({ Size = UDim2.new(1, 0, 0, 26), Text = (isBoss and "👹 " or "⚔ ") .. lvText .. (type(label) == "string" and label or "적"), TextSize = isBoss and 23 or 20, Font = Enum.Font.GothamBlack, TextColor3 = isBoss and C.gold or (type(lv) == "number" and lv >= 7 and Color3.fromRGB(255, 110, 90) or Color3.fromRGB(255, 200, 190)), TextXAlignment = Enum.TextXAlignment.Center, TextStrokeTransparency = 0.1, Parent = bb })
	local _ = name
	local back = new("Frame", { Position = UDim2.new(0, 0, 0, 29), Size = UDim2.new(1, 0, 0, 12), BackgroundColor3 = Color3.fromRGB(20, 10, 10), Parent = bb }, { corner(4), stroke(Color3.fromRGB(0, 0, 0), 1) })
	local fill = new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = C.hp, Parent = back }, { corner(4) })
	local pback = new("Frame", { Position = UDim2.new(0.15, 0, 0, 45), Size = UDim2.new(0.7, 0, 0, 7), BackgroundColor3 = Color3.fromRGB(20, 10, 10), BackgroundTransparency = 0.3, Parent = bb }, { corner(3) })
	local pfill = new("Frame", { AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.fromScale(0.5, 0), Size = UDim2.fromScale(0, 1), BackgroundColor3 = C.posture, Parent = pback }, { corner(3) })
	-- 전투력 견주기: 차이가 크면 그 적의 공격은 나에게 통하지 않는다
	local powerLabel = text({ Position = UDim2.new(0, 0, 0, 55), Size = UDim2.new(1, 0, 0, 20), TextSize = 15, Font = Enum.Font.GothamBold, TextXAlignment = Enum.TextXAlignment.Center, TextStrokeTransparency = 0.2, Parent = bb })
	local function refreshPower()
		if model:GetAttribute("Dummy") == true then
			local dps = tonumber(model:GetAttribute("Dps")) or 0
			local best = tonumber(model:GetAttribute("Best")) or 0
			powerLabel.Text = "🎯 초당 피해 " .. Config.formatNumber(dps) .. " · 가장 센 한 방 " .. Config.formatNumber(best)
			powerLabel.TextColor3 = Color3.fromRGB(255, 225, 150)
			return
		end
		local ep = model:GetAttribute("Power")
		local char = player.Character
		local mp = char and char:GetAttribute("Power")
		if type(ep) ~= "number" then
			powerLabel.Text = ""
			return
		end
		local tagText, col = "", Color3.fromRGB(230, 220, 200)
		if type(mp) == "number" then
			local r = mp / math.max(1, ep)
			local G = Config.POWER_GAP
			if r >= G.immune then
				tagText, col = " · 호신강기 (통하지 않음)", Color3.fromRGB(150, 150, 150)
			elseif r >= G.steady then
				tagText, col = " · 한참 약함", Color3.fromRGB(170, 200, 170)
			elseif r >= G.soft then
				tagText, col = " · 약함", Color3.fromRGB(180, 230, 180)
			elseif r >= 0.8 then
				tagText, col = " · 비슷", Color3.fromRGB(255, 230, 160)
			elseif r >= 0.5 then
				tagText, col = " · 강함", Color3.fromRGB(255, 150, 100)
			else
				tagText, col = " · 아주 강함", Color3.fromRGB(255, 80, 70)
			end
		end
		powerLabel.Text = "⚔ 전투력 " .. Config.formatNumber(ep) .. tagText
		powerLabel.TextColor3 = col
	end
	refreshPower()
	model:GetAttributeChangedSignal("Power"):Connect(refreshPower)
	model:GetAttributeChangedSignal("Dps"):Connect(refreshPower)
	-- 내 전투력이 바뀌면 다시 견준다 (적이 사라지면 그만)
	task.spawn(function()
		while true do
			task.wait(2)
			if not model.Parent or not bb.Parent then
				break
			end
			if not pcall(refreshPower) then
				break
			end
		end
	end)
	local function refresh()
		local hp = model:GetAttribute("Hp")
		local mx = model:GetAttribute("MaxHp")
		local po = model:GetAttribute("Posture")
		local pm = model:GetAttribute("PostureMax")
		if type(hp) == "number" and type(mx) == "number" then
			fill.Size = UDim2.fromScale(math.clamp(hp / math.max(1, mx), 0, 1), 1)
		end
		if type(po) == "number" and type(pm) == "number" then
			local r = math.clamp(po / math.max(1, pm), 0, 1)
			pfill.Size = UDim2.fromScale(r, 1)
			pfill.BackgroundColor3 = r > 0.75 and C.red or C.posture
		end
		bb.Enabled = model:GetAttribute("Dead") ~= true
	end
	refresh()
	model:GetAttributeChangedSignal("Hp"):Connect(refresh)
	model:GetAttributeChangedSignal("Posture"):Connect(refresh)
	model:GetAttributeChangedSignal("Dead"):Connect(refresh)
end

------------------------------------------------------------------------
-- 창
------------------------------------------------------------------------
local window: Frame
local windowTitle: TextLabel
local pages: { [string]: Frame } = {}
local refreshers: { [string]: (boolean?) -> () } = {}
local current = ""
local state: any = nil
local TITLES = { styles = "🥋 권법", stats = "📊 능력치와 경지", shop = "🧪 만물상", help = "📜 도움말", test = "🧪 테스트", manuals = "📜 심법 (내공 수련서)", skyshop = "💠 천상 상점", ach = "🏆 업적과 칭호" }

local function makePage(name: string): Frame
	local f = new("Frame", { Position = UDim2.new(0, 16, 0, 56), Size = UDim2.new(1, -32, 1, -68), BackgroundTransparency = 1, Visible = false, Parent = window })
	pages[name] = f
	return f
end

local function scroller(parent: Instance, size: UDim2, pos: UDim2?): ScrollingFrame
	return new("ScrollingFrame", { Position = pos or UDim2.new(), Size = size, BackgroundTransparency = 1, BorderSizePixel = 0, ScrollBarThickness = 8, ScrollBarImageColor3 = C.line, AutomaticCanvasSize = Enum.AutomaticSize.Y, CanvasSize = UDim2.new(), Parent = parent })
end

local pageOpt: any = nil
function UI.openPage(name: string, opt: any?)
	pageOpt = opt
	if window.Visible and current == name and not opt then
		window.Visible = false
		return
	end
	current = name
	for n, f in pairs(pages) do
		f.Visible = n == name
	end
	windowTitle.Text = TITLES[name] or name
	window.Visible = true
	local r = refreshers[name]
	if r then
		r(true)
	end
end

function UI.closeWindow()
	window.Visible = false
end

function UI.windowOpen(): boolean
	return window.Visible
end

-- 내 몸이 지금 어디 있나
local function myPos(): Vector3?
	local char = player.Character
	local root = char and char:FindFirstChild("HumanoidRootPart")
	return (root and root:IsA("BasePart")) and root.Position or nil
end

-- 여기서 그곳까지 방향 (북 = -Z)과 거리
local DIRS = { "북", "북동", "동", "남동", "남", "남서", "서", "북서" }
local function bearing(from: Vector3, to: Vector3): (string, number)
	local d = Vector3.new(to.X - from.X, 0, to.Z - from.Z)
	local ang = math.deg(math.atan2(d.X, -d.Z)) % 360
	return DIRS[math.floor((ang + 22.5) / 45) % 8 + 1], d.Magnitude
end
UI.bearing = bearing

local function nearMaster(id: string): boolean
	local m = Config.MASTERS[id]
	local pos = myPos()
	if not m or not pos then
		return false
	end
	return Vector3.new(pos.X - m.at.X, 0, pos.Z - m.at.Z).Magnitude <= Config.MASTER_RANGE
end

local function buildStyles()
	local page = makePage("styles")
	local list = scroller(page, UDim2.new(0.4, -8, 1, 0))
	new("UIListLayout", { Padding = UDim.new(0, 6), Parent = list })
	local detail = new("Frame", { Position = UDim2.new(0.4, 4, 0, 0), Size = UDim2.new(0.6, -4, 1, 0), BackgroundColor3 = C.panel, Parent = page }, { corner(12), stroke(C.line, 1.5) })
	local dTitle = text({ Position = UDim2.new(0, 14, 0, 8), Size = UDim2.new(1, -28, 0, 36), TextSize = 28, Font = Enum.Font.GothamBlack, Parent = detail })
	local dHanja = text({ Position = UDim2.new(0, 14, 0, 44), Size = UDim2.new(1, -28, 0, 22), TextSize = 17, TextColor3 = C.dim, Parent = detail })
	local dMaster = text({ Position = UDim2.new(0, 14, 0, 68), Size = UDim2.new(1, -28, 0, 24), TextSize = 17, TextColor3 = C.gold, RichText = true, Parent = detail })
	local bodyScroll = scroller(detail, UDim2.new(1, -20, 1, -170), UDim2.new(0, 14, 0, 96))
	local dBody = text({ Size = UDim2.new(1, -12, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, TextSize = 17, RichText = true, TextYAlignment = Enum.TextYAlignment.Top, Parent = bodyScroll })
	local selected = Config.Styles[1].id
	local action = "learn"
	local dBtn = button({ AnchorPoint = Vector2.new(0, 1), Position = UDim2.new(0, 14, 1, -12), Size = UDim2.new(0.62, -20, 0, 56), TextSize = 21, BackgroundColor3 = C.red, Parent = detail }, function()
		if action == "learn" then
			Request:FireServer("learn", selected)
		elseif action == "break" then
			Request:FireServer("breakthrough", selected)
		elseif action == "awaken" then
			Request:FireServer("awaken", selected)
			window.Visible = false
		elseif action == "guide" then
			UI.setGuide(selected)
			window.Visible = false
		end
	end)
	local guideBtn = button({ AnchorPoint = Vector2.new(1, 1), Position = UDim2.new(1, -14, 1, -12), Size = UDim2.new(0.38, -14, 0, 56), Text = "📍 길 안내", TextSize = 20, BackgroundColor3 = C.panel2, Parent = detail }, function()
		if state and state.found and state.found[selected] then
			UI.setGuide(selected)
			window.Visible = false
		end
	end)
	local cards: { [string]: TextButton } = {}
	local function show(id: string)
		selected = id
		local s = Config.STYLE_BY_ID[id]
		local owned = state and table.find(state.styles, id) ~= nil
		local found = state and state.found and state.found[id]
		local passed = state and state.trials and state.trials[id]
		local ups = (state and state.gradeUp and state.gradeUp[id]) or 0
		local gradeNow = Config.styleGrade(s, ups)
		local gradeColor = Config.GRADE_COLOR[gradeNow] or C.dim
		local gradeTag = string.format('<font color="#%02X%02X%02X">[%s%s]</font>', math.floor(gradeColor.R * 255), math.floor(gradeColor.G * 255), math.floor(gradeColor.B * 255), gradeNow, ups > 0 and string.rep("⬆", ups) or "")
		for sid, card in pairs(cards) do
			local st = card:FindFirstChildOfClass("UIStroke")
			if st then
				st.Thickness = sid == id and 3 or 1
			end
		end
		guideBtn.Visible = found == true and not owned
		-- 숨은 권법은 얻기 전엔 이름도 모른다
		if s.hidden and not owned and not (s.secret and found) then
			dTitle.Text = "❓ 숨겨진 권법"
			dTitle.TextColor3 = C.dim
			dHanja.Text = "???"
			dMaster.Text = gradeTag .. "  전해지는 이야기만 남아 있다"
			dBody.Text = "🔒 " .. (s.unlockHint or "") .. (s.secret and "\n\n지도에 나오지 않는 숨은 사부가 있다." or "\n\n이 권법은 사부에게 배울 수 없다. 강호를 누비며 길을 찾아라.")
			dBtn.Text = "🔒 조건을 채워야 익힌다"
			dBtn.BackgroundColor3 = C.panel
			action = "none"
			return
		end
		dTitle.Text = s.icon .. " " .. s.name
		dTitle.TextColor3 = s.color
		dHanja.Text = s.hanja
		local master = Config.MASTERS[id]
		local pos = myPos()
		if master and not found and not owned then
			dMaster.Text = gradeTag .. '  <font color="#C8B8A0">❓ 사부의 행방을 모른다 · 소문: ' .. (master.rumor or "") .. "</font>"
		elseif master then
			local where = ""
			if pos then
				local dir, dist = bearing(pos, master.at)
				where = dist <= Config.MASTER_RANGE and "  ·  <b>바로 곁</b>" or string.format("  ·  %s쪽 %d칸", dir, math.floor(dist))
			end
			dMaster.Text = string.format("%s  📍 사부 %s · %s%s", gradeTag, master.name, master.region, where)
		else
			dMaster.Text = gradeTag .. (s.starter and "  청운 장로에게 받은 기본 권법" or "")
		end
		local lines = { s.desc, "", "<b>고유 장치</b>  " .. s.gimmick, "", "<b>연타 (클릭)</b>" }
		local names = {}
		for _, m in ipairs(s.combo) do
			table.insert(names, m.name)
		end
		table.insert(lines, table.concat(names, " → "))
		table.insert(lines, "<b>Z 강타</b>  " .. s.heavy.name)
		local m = state and state.mastery and state.mastery[id]
		local lv = m and m.lv or 0
		for _, slot in ipairs({ "E", "R", "G", "X" }) do
			local sk = s.skills[slot]
			if sk then
				local need = Config.SKILL_UNLOCK[slot]
				local lockTxt = lv >= need and "" or string.format(' <font color="#AA9988">(숙련 %d)</font>', need)
				local label = slot == "G" and "오의 G" or (slot == "X" and '<font color="#FF9AC8">초 오의 X</font>' or slot)
				table.insert(lines, string.format("<b>%s %s</b>%s  %s", label, sk.name, lockTxt, sk.desc))
			end
		end
		-- 각성
		local A1, A2 = Config.AWAKEN[1], Config.AWAKEN[2]
		local function tag(need: number): string
			return lv >= need and ' <font color="#FFD25A">(열림)</font>' or string.format(' <font color="#AA9988">(숙련 %d)</font>', need)
		end
		table.insert(lines, "")
		table.insert(lines, string.format("<b>%s %s</b>%s  기술(Z·E·R·G) 피해 ×%.2f, 대기 -%d%%, 연타 다섯 번째 <b>%s</b> (상대를 하늘로 띄운다)", A1.mark, A1.name, tag(A1.lv), A1.dmg, math.floor((1 - A1.cd) * 100 + 0.5), s.finisher and s.finisher.name or ""))
		table.insert(lines, string.format("<b>%s %s</b>%s  모든 기술 ×%.2f, 대기 -%d%%, 그림자 메아리가 기술을 한 번 더 (절반 위력), 몸에 각성의 기운", A2.mark, A2.name, tag(A2.lv), A2.dmg, math.floor((1 - A2.cd) * 100 + 0.5)))
		if m then
			table.insert(lines, "")
			table.insert(lines, string.format("숙련도 %d / %d  (%d / %d)", m.lv, Config.MASTERY_MAX, math.floor(m.xp), m.need))
		end
		if master and not passed and not owned then
			table.insert(lines, "")
			local kind, need = Config.trialNeed(s.id)
			local K = Config.TRIAL_KINDS[kind]
			if K then
				table.insert(lines, string.format('<font color="#FFB070"><b>사부의 시험 · %s %s</b>  %s</font>', K.icon, K.title, string.format(K.ask, need)))
			else
				table.insert(lines, '<font color="#FFB070"><b>사부의 시험</b>  사부와 겨뤄 이겨야 제자로 받아 준다. 마구 휘두르면 막히고 되받아친다.</font>')
			end
		end
		if s.realmReq then
			table.insert(lines, "")
			table.insert(lines, string.format('<font color="#FFE8A0"><b>경지 제한</b>  %s에 올라야 사부가 시험을 허락한다</font>', Config.Realms[s.realmReq].name))
		end
		local req = s.styleReq and Config.STYLE_BY_ID[s.styleReq]
		if req then
			table.insert(lines, string.format('<font color="#FFE8A0"><b>먼저 익힐 권법</b>  %s</font>', req.name))
		end
		-- 승급 (깨달음)
		if owned then
			local step = Config.BREAKTHROUGH[ups + 1]
			table.insert(lines, "")
			if step then
				table.insert(lines, string.format("<b>⬆ 권법 승급 (%s)</b>  숙련 %d · %s 이상 · 💰 %s → [%s] (피해 ×%.2f → ×%.2f)", step.name, Config.MASTERY_MAX, Config.Realms[step.realm].name, Config.formatNumber(step.coins), Config.styleGrade(s, ups + 1), Config.GRADES[gradeNow], Config.GRADES[Config.styleGrade(s, ups + 1)]))
			else
				table.insert(lines, string.format("<b>⬆ 권법 승급</b>  모든 깨달음을 얻었다 [%s]", gradeNow))
			end
		end
		-- 각성 권법이 있는 권법: 각성 조건
		for _, sd in ipairs(Config.Styles) do
			if sd.awakenOf == id and owned then
				local A = Config.AWAKEN_STYLE
				table.insert(lines, "")
				table.insert(lines, string.format('<font color="#FF8A9A"><b>🔥 각성: %s</b>  숙련 %d · 깨달음 %d번 · %s 이상%s · 💰 %s → 각성 시련 (각성선인 곁에서)</font>', sd.name, Config.MASTERY_MAX, #Config.BREAKTHROUGH, Config.Realms[A.realm].name, sd.rebirthReq and string.format(" · ♻ 환생 %d번", sd.rebirthReq) or "", Config.formatNumber(A.coins)))
			end
		end
		dBody.Text = table.concat(lines, "\n")
		local cost = state and state.learnCost or 0
		local canBreak = owned and Config.BREAKTHROUGH[ups + 1] ~= nil and lv >= Config.MASTERY_MAX
		-- 각성 (진 권법): 깨달음을 모두 얻은 원래 권법에서
		local v2 = nil
		for _, sd in ipairs(Config.Styles) do
			if sd.awakenOf == id then
				v2 = sd
			end
		end
		local canAwaken = owned and v2 ~= nil and not (state and table.find(state.styles, v2.id)) and ups >= #Config.BREAKTHROUGH and lv >= Config.MASTERY_MAX
		if canAwaken and v2 then
			local A = Config.AWAKEN_STYLE
			dBtn.Text = string.format("🔥 각성 시련 → %s  💰 %s", v2.name, Config.formatNumber(A.coins))
			dBtn.BackgroundColor3 = (state and state.coins >= A.coins and state.realm >= A.realm) and Color3.fromRGB(200, 40, 60) or C.panel
			action = "awaken"
		elseif s.awakenOf and not owned then
			dBtn.Text = "🔥 원래 권법에서 각성한다"
			dBtn.BackgroundColor3 = C.panel
			action = "none"
		elseif canBreak then
			local step = Config.BREAKTHROUGH[ups + 1]
			dBtn.Text = string.format("⬆ 승급  💰 %s", Config.formatNumber(step.coins))
			dBtn.BackgroundColor3 = (state and state.coins >= step.coins and state.realm >= step.realm) and Color3.fromRGB(200, 150, 40) or C.panel
			action = "break"
		elseif state and state.style == id then
			dBtn.Text = "✔ 쓰는 중"
			dBtn.BackgroundColor3 = C.green
			action = "none"
		elseif owned then
			dBtn.Text = "이 권법으로 바꾸기"
			dBtn.BackgroundColor3 = C.panel2
			action = "learn"
		elseif not master then
			dBtn.Text = "청운 장로에게 받는다"
			dBtn.BackgroundColor3 = C.panel
			action = "none"
		elseif not found then
			dBtn.Text = "❓ 먼저 사부를 찾아라"
			dBtn.BackgroundColor3 = C.panel
			action = "none"
		elseif not passed then
			local near = nearMaster(id)
			dBtn.Text = near and "⚔ 시험 받기" or "사부에게 가서 시험 받기"
			dBtn.BackgroundColor3 = near and C.red or Color3.fromRGB(150, 110, 50)
			action = near and "learn" or "guide"
		elseif nearMaster(id) then
			dBtn.Text = string.format("배우기  💰 %s", Config.formatNumber(cost))
			dBtn.BackgroundColor3 = (state and state.coins >= cost) and C.red or C.panel
			action = "learn"
		else
			dBtn.Text = string.format("사부에게 가기 (💰 %s)", Config.formatNumber(cost))
			dBtn.BackgroundColor3 = Color3.fromRGB(150, 110, 50)
			action = "guide"
		end
	end
	for _, s in ipairs(Config.Styles) do
		local card = button({ Size = UDim2.new(1, -10, 0, 64), BackgroundColor3 = C.panel2, Text = "", Parent = list }, function()
			show(s.id)
		end)
		new("UIStroke", { Color = s.color, Thickness = 1, Parent = card })
		text({ Name = "Title", Position = UDim2.new(0, 10, 0, 4), Size = UDim2.new(1, -20, 0, 30), Text = s.hidden and "❓ 숨겨진 권법" or (s.icon .. " " .. s.name), TextSize = 20, Font = Enum.Font.GothamBlack, TextColor3 = s.hidden and C.dim or s.color, Parent = card })
		local sub = text({ Name = "Sub", Position = UDim2.new(0, 10, 0, 34), Size = UDim2.new(1, -20, 0, 24), TextSize = 15, TextColor3 = C.dim, Parent = card })
		sub.Text = s.hidden and "???" or s.hanja
		cards[s.id] = card
	end
	refreshers.styles = function(reset: boolean?)
		for id, card in pairs(cards) do
			local sub = card:FindFirstChild("Sub") :: TextLabel?
			if sub and state then
				local m = state.mastery and state.mastery[id]
				local s = Config.STYLE_BY_ID[id]
				local owned = table.find(state.styles, id) ~= nil
				local title = card:FindFirstChild("Title") :: TextLabel?
				local found = state.found and state.found[id]
				local ups = (state.gradeUp and state.gradeUp[id]) or 0
				if s.hidden and not owned and not (s.secret and found) then
					sub.Text = "[" .. s.grade .. "]  ???"
					if title then
						title.Text = "❓ 숨겨진 권법"
						title.TextColor3 = C.dim
					end
				else
					local mark = owned and "" or ((state.trials and state.trials[id]) and "  · 시험 통과" or ((state.found and state.found[id]) and "  · 사부 찾음" or (Config.MASTERS[id] and "  · ❓" or "")))
					sub.Text = "[" .. Config.styleGrade(s, ups) .. string.rep("⬆", ups) .. "] " .. s.hanja .. (m and string.format("  ·  숙련 %d", m.lv) or "") .. mark .. (state.style == id and "  ✔" or "")
					if title then
						title.Text = s.icon .. " " .. s.name
						title.TextColor3 = s.color
					end
				end
				sub.TextColor3 = Config.GRADE_COLOR[Config.styleGrade(s, ups)] or C.dim
			end
		end
		if reset then
			selected = pageOpt and pageOpt.style or (state and state.style ~= "" and state.style) or selected
		end
		show(selected)
	end
end

local function buildStats()
	local page = makePage("stats")
	local info = text({ Size = UDim2.new(1, 0, 1, 0), TextSize = 18, RichText = true, TextYAlignment = Enum.TextYAlignment.Top, Parent = page })
	-- 경지의 관문: 능력치가 닿으면 열린다 (수호자를 꺾어야 경지가 오른다)
	local gateBtn = button({ AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -8, 0, 4), Size = UDim2.new(0, 300, 0, 58), Text = "⛩ 관문 도전", TextSize = 20, BackgroundColor3 = Color3.fromRGB(170, 120, 40), Visible = false, ZIndex = 3, Parent = page }, function()
		Request:FireServer("gate")
		window.Visible = false
	end)
	-- 1.9판 환생: 열린 끝 경지에 오르면 보인다. 두 번 눌러야 한다 (실수로 누르지 않게)
	local rebirthArmed = 0
	local rebirthBtn: TextButton
	rebirthBtn = button({ AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -8, 0, 68), Size = UDim2.new(0, 300, 0, 58), Text = "♻ 환생", TextSize = 20, BackgroundColor3 = Color3.fromRGB(170, 60, 140), Visible = false, ZIndex = 3, Parent = page }, function()
		if os.clock() - rebirthArmed > 4 then
			rebirthArmed = os.clock()
			rebirthBtn.Text = "♻ 정말 환생? 한 번 더 누르기"
			task.delay(4, function()
				if os.clock() - rebirthArmed >= 3.9 and refreshers.stats then
					refreshers.stats()
				end
			end)
			return
		end
		rebirthArmed = 0
		Request:FireServer("rebirth")
		window.Visible = false
	end)
	refreshers.stats = function()
		if not state then
			return
		end
		local rb = state.rebirth or 0
		local cap = state.realmCap or 16
		local canRebirth = rb < Config.REBIRTH.max and state.realm >= cap
		rebirthBtn.Visible = canRebirth
		if canRebirth and os.clock() - rebirthArmed > 4 then
			rebirthBtn.Text = string.format("♻ %s (%d번째 환생)", Config.REBIRTH.names[rb + 1] or "환생", rb + 1)
		end
		gateBtn.Visible = state.gateNext ~= nil
		if state.gateNext then
			local r = Config.Realms[state.gateNext]
			gateBtn.Text = "⛩ " .. (r and r.name or "") .. "의 관문 도전"
		end
		local lines = {}
		local idx = state.realm
		local realm = Config.Realms[idx]
		local nextRealm = Config.Realms[idx + 1]
		local locked = nextRealm and (nextRealm.rebirth or 0) > rb
		table.insert(lines, string.format("<b>경지: %s%s</b>  (능력치 합 %s%s)", rb > 0 and ((Config.REBIRTH.names[rb] or "") .. " · ") or "", realm.name, Config.formatNumber(state.total),
			nextRealm and string.format(" / 다음 %s는 %s%s", nextRealm.name, Config.formatNumber(nextRealm.need), locked and ' <font color="#FF9AD8">(환생해야 열림)</font>' or "") or ""))
		table.insert(lines, string.format("경지 배율 ×%.2f (사경까지 경지마다 ×1.22, 그 위로는 ×1.38씩 겹으로, 수련 효과 +%d%%) · 경지는 스무 단계 (천외천 너머 넷은 환생해야 열린다)", Config.realmPower(idx), math.floor(Config.TRAIN_REALM_BONUS * 100)))
		if rb > 0 then
			table.insert(lines, string.format('<font color="#FF9AD8">♻ 환생 %d번: 주는 피해·체력 ×%.2f · 얻는 능력치 ×%.1f · %s까지 열림</font>', rb, Config.rebirthPower(rb), Config.rebirthGain(rb), Config.Realms[cap].name))
		end
		if canRebirth then
			table.insert(lines, string.format('<font color="#FF9AD8"><b>♻ 환생할 수 있다!</b> 능력치를 모두 내려놓고 삼류로 돌아간다 (권법·숙련·심법·은자·관문은 그대로). 피해·체력 ×%.2f, 얻는 능력치 ×%.1f, %s의 경지가 열린다</font>', Config.rebirthPower(rb + 1), Config.rebirthGain(rb + 1), (Config.Realms[Config.realmCap(rb + 1)] or realm).name))
		elseif rb < Config.REBIRTH.max then
			table.insert(lines, string.format("♻ 환생: %s에 오르면 할 수 있다 (지금 %d / %d번)", Config.Realms[cap].name, rb, Config.REBIRTH.max))
		end
		table.insert(lines, string.format("⛩ %s부터는 능력치가 닿아도 <b>관문 수호자</b>를 꺾어야 경지가 오른다%s", Config.Realms[Config.GATE.from].name, state.gateNext and string.format(' <font color="#FFD25A">(지금 %s의 관문이 열려 있다)</font>', Config.Realms[state.gateNext].name) or ""))
		table.insert(lines, "")
		for _, s in ipairs(Config.Stats) do
			local v = state.stats[s.id] or 0
			table.insert(lines, string.format("%s <b>%s %s</b>  — %s ×%.2f", s.icon, s.name, Config.formatNumber(v), s.desc, Config.statMult(v)))
		end
		table.insert(lines, "")
		table.insert(lines, "<b>수련하는 곳</b>")
		for _, t in pairs(Config.Training) do
			local stat = nil
			for _, s in ipairs(Config.Stats) do
				if s.id == t.stat then
					stat = s
				end
			end
			local need = t.realm and t.realm > 1 and string.format(' <font color="#FFD25A">[%s부터]</font>', Config.Realms[t.realm].name) or ""
			table.insert(lines, string.format("%s %s%s → %s  (%s)", t.icon, t.name, need, t.fight and "모든 능력치" or ((stat and stat.icon or "") .. " " .. (stat and stat.name or "")), t.desc))
		end
		table.insert(lines, "")
		table.insert(lines, string.format("💰 은자 %s   ⚔ 쓰러뜨린 적 %d   🏆 비무대 승리 %d   🧪 금창약 %d", Config.formatNumber(state.coins), state.kills, state.pvpWins, state.potions))
		if state.elixirLeft > 0 then
			table.insert(lines, string.format("💊 소환단: %d초 남음 (수련 2배)", state.elixirLeft))
		end
		info.Text = table.concat(lines, "\n")
	end
end

------------------------------------------------------------------------
-- 1.9판: 업적과 칭호
------------------------------------------------------------------------
local function buildAch()
	local page = makePage("ach")
	local head = text({ Size = UDim2.new(1, -330, 0, 52), TextSize = 17, RichText = true, Parent = page })
	button({ AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -8, 0, 4), Size = UDim2.new(0, 150, 0, 44), Text = "칭호 떼기", TextSize = 16, Parent = page }, function()
		Request:FireServer("title", "")
	end)
	local list = scroller(page, UDim2.new(1, 0, 1, -60), UDim2.new(0, 0, 0, 60))
	new("UIListLayout", { Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder, Parent = list })
	local rows: { [string]: any } = {}
	for i, a in ipairs(Config.ACHIEVEMENTS) do
		local card = new("Frame", { Size = UDim2.new(1, -12, 0, 64), BackgroundColor3 = C.panel, LayoutOrder = i, Parent = list }, { corner(10) })
		local st = stroke(C.line, 1.5)
		st.Parent = card
		text({ Position = UDim2.new(0, 8, 0, 0), Size = UDim2.new(0, 50, 1, 0), Text = a.icon, TextSize = 30, TextXAlignment = Enum.TextXAlignment.Center, Parent = card })
		local name = text({ Position = UDim2.new(0, 64, 0, 6), Size = UDim2.new(1, -260, 0, 24), Text = a.name, TextSize = 19, Font = Enum.Font.GothamBlack, RichText = true, Parent = card })
		local rewards = {}
		if a.coins then
			table.insert(rewards, "💰 " .. Config.formatNumber(a.coins))
		end
		if a.gems then
			table.insert(rewards, "💎 " .. Config.formatNumber(a.gems))
		end
		if a.scrolls then
			table.insert(rewards, "📜 " .. a.scrolls)
		end
		if a.title then
			table.insert(rewards, "칭호 「" .. a.title .. "」")
		end
		local sub = text({ Position = UDim2.new(0, 64, 0, 32), Size = UDim2.new(1, -260, 0, 26), Text = a.desc .. "   ·   " .. table.concat(rewards, "  "), TextSize = 14, TextColor3 = C.dim, Parent = card })
		local bar = new("Frame", { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -12, 0.5, 0), Size = UDim2.new(0, 170, 0, 30), BackgroundColor3 = Color3.fromRGB(25, 18, 16), Parent = card }, { corner(8) })
		local fill = new("Frame", { Size = UDim2.fromScale(0, 1), BackgroundColor3 = C.green, Parent = bar }, { corner(8) })
		local label = text({ Size = UDim2.fromScale(1, 1), TextSize = 14, TextXAlignment = Enum.TextXAlignment.Center, ZIndex = 2, Parent = bar })
		local equip = button({ Size = UDim2.fromScale(1, 1), Text = "", BackgroundTransparency = 1, ZIndex = 3, Visible = false, Parent = bar }, function()
			Request:FireServer("title", a.id)
		end)
		rows[a.id] = { card = card, stroke = st, name = name, sub = sub, fill = fill, label = label, equip = equip }
	end
	refreshers.ach = function()
		if not state then
			return
		end
		local done, total = 0, #Config.ACHIEVEMENTS
		local ach = state.ach or {}
		local prog = state.achProg or {}
		for _, a in ipairs(Config.ACHIEVEMENTS) do
			local r = rows[a.id]
			local ok = ach[a.id] == true
			if ok then
				done += 1
			end
			local v = prog[a.id] or 0
			r.fill.Size = UDim2.fromScale(ok and 1 or math.clamp(v / a.n, 0, 1), 1)
			r.fill.BackgroundColor3 = ok and C.gold or C.green
			local col = Config.ACH_COLOR[a.kind] or C.gold
			r.stroke.Color = ok and col or C.line
			r.card.BackgroundColor3 = ok and Color3.fromRGB(56, 40, 26) or C.panel
			r.name.TextColor3 = ok and col or C.text
			local wearing = state.title == a.id
			if ok and a.title then
				r.label.Text = wearing and "✔ 달고 있음" or "칭호 달기"
				r.fill.BackgroundColor3 = wearing and C.green or C.gold
				r.equip.Visible = not wearing
			else
				r.label.Text = ok and "✔ 이룸" or string.format("%s / %s", Config.formatNumber(v), Config.formatNumber(a.n))
				r.equip.Visible = false
			end
		end
		local t = state.title and Config.ACH_BY_ID[state.title]
		head.Text = string.format("<b>이룬 업적 %d / %d</b>\n칭호: %s", done, total, t and ("「" .. t.title .. "」") or "없음 (칭호가 붙은 업적을 이루면 달 수 있다)")
	end
end

local function buildShop()
	local page = makePage("shop")
	local list = scroller(page, UDim2.fromScale(1, 1))
	new("UIListLayout", { Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder, Parent = list })
	-- 💎 로벅스 상품: 금빛 카드 (큰 그림, 이름표, 좋은 점 세 줄, 값)
	local premiumBtns: { [string]: TextButton } = {}
	-- 자동 수련 카드: 켜기·끄기 + 올릴 능력치 고르기 (가진 카드에만 보인다)
	local autoBtns: { [string]: { toggle: TextButton, stat: TextButton } } = {}
	text({ Size = UDim2.new(1, -12, 0, 26), Text = "💎 로벅스 상품", TextSize = 20, Font = Enum.Font.GothamBlack, TextColor3 = C.gold, LayoutOrder = 0, Parent = list })
	for i, it in ipairs(Config.Premium) do
		local card = new("Frame", { Size = UDim2.new(1, -12, 0, 150), BackgroundColor3 = it.best and Color3.fromRGB(50, 26, 80) or (it.toggle and Color3.fromRGB(20, 50, 70) or Color3.fromRGB(70, 24, 14)), LayoutOrder = i, Parent = list }, { corner(14), stroke(Color3.fromRGB(255, 200, 90), 2) })
		new("UIGradient", { Rotation = 20, Color = ColorSequence.new(Color3.fromRGB(255, 255, 255), Color3.fromRGB(150, 120, 90)), Parent = card })
		local badge = new("Frame", { Position = UDim2.new(0, 14, 0.5, -55), Size = UDim2.new(0, 110, 0, 110), BackgroundColor3 = Color3.fromRGB(30, 20, 10), Parent = card }, { corner(16), stroke(Color3.fromRGB(255, 220, 120), 2) })
		new("UIGradient", { Rotation = 90, Color = ColorSequence.new(Color3.fromRGB(255, 220, 120), Color3.fromRGB(120, 70, 20)), Transparency = NumberSequence.new(0.55, 0.85), Parent = badge })
		text({ Size = UDim2.fromScale(1, 1), Text = it.icon, TextSize = 64, TextXAlignment = Enum.TextXAlignment.Center, Parent = badge })
		text({ Position = UDim2.new(0, 138, 0, 10), Size = UDim2.new(1, -330, 0, 32), Text = it.name, TextSize = 26, Font = Enum.Font.GothamBlack, TextColor3 = Color3.fromRGB(255, 225, 140), Parent = card })
		local chip = new("Frame", { Position = UDim2.new(0, 138, 0, 44), Size = UDim2.new(0, 70, 0, 22), BackgroundColor3 = it.best and Color3.fromRGB(150, 90, 230) or (it.toggle and Color3.fromRGB(40, 140, 200) or Color3.fromRGB(200, 70, 40)), Parent = card }, { corner(11) })
		text({ Size = UDim2.fromScale(1, 1), Text = it.tag, TextSize = 13, Font = Enum.Font.GothamBlack, TextXAlignment = Enum.TextXAlignment.Center, Parent = chip })
		text({ Position = UDim2.new(0, 138, 0, 72), Size = UDim2.new(1, -330, 0, 72), Text = "✦ " .. table.concat(it.lines, "\n✦ "), TextSize = 14, TextColor3 = Color3.fromRGB(240, 225, 200), TextYAlignment = Enum.TextYAlignment.Top, Parent = card })
		premiumBtns[it.id] = button({ AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -14, 0, 20), Size = UDim2.new(0, 170, 0, 52), Text = "R$ " .. tostring(it.price) .. "  구매", TextSize = 20, BackgroundColor3 = Color3.fromRGB(40, 170, 80), Parent = card }, function()
			Request:FireServer("premiumBuy", it.id)
		end)
		if it.toggle then
			local tg = button({ AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -14, 0, 80), Size = UDim2.new(0, 82, 0, 40), Text = "켜기", TextSize = 16, BackgroundColor3 = C.panel2, Visible = false, Parent = card }, function()
				Request:FireServer("autoToggle")
			end)
			local sb = button({ AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -102, 0, 80), Size = UDim2.new(0, 82, 0, 40), Text = "골고루", TextSize = 15, BackgroundColor3 = C.panel2, Visible = false, Parent = card }, function()
				Request:FireServer("autoStat")
			end)
			autoBtns[it.id] = { toggle = tg, stat = sb }
		end
	end
	-- 🐎 탈것: V로 타고 내린다
	text({ Size = UDim2.new(1, -12, 0, 26), Text = "🐎 탈것 (V로 타기·내리기)", TextSize = 20, Font = Enum.Font.GothamBlack, TextColor3 = C.gold, LayoutOrder = 10, Parent = list })
	local mountBtns: { [string]: TextButton } = {}
	for k, m in ipairs(Config.MOUNTS) do
		local row = new("Frame", { Size = UDim2.new(1, -12, 0, 64), BackgroundColor3 = C.panel2, LayoutOrder = 10 + k, Parent = list }, { corner(10), stroke(C.line, 1) })
		text({ Position = UDim2.new(0, 14, 0, 4), Size = UDim2.new(1, -200, 0, 28), Text = string.format("%s %s  ·  빠르기 ×%.2f", m.icon, m.name, m.speed), TextSize = 19, Font = Enum.Font.GothamBlack, Parent = row })
		text({ Position = UDim2.new(0, 14, 0, 34), Size = UDim2.new(1, -200, 0, 24), Text = m.desc, TextSize = 14, TextColor3 = C.dim, Parent = row })
		mountBtns[m.id] = button({ AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -12, 0.5, 0), Size = UDim2.new(0, 160, 0, 44), Text = "", TextSize = 17, Parent = row }, function()
			local owned = state and ((state.mounts and state.mounts[m.id]) or (m.premium and state.premium and state.premium[m.premium]))
			Request:FireServer(owned and "mountSelect" or "mountBuy", m.id)
		end)
	end
	text({ Size = UDim2.new(1, -12, 0, 26), Text = "💰 은자로 사는 것", TextSize = 20, Font = Enum.Font.GothamBlack, TextColor3 = C.gold, LayoutOrder = 20, Parent = list })
	local labels = {}
	for k, item in ipairs(Config.Shop) do
		local row = new("Frame", { Size = UDim2.new(1, -12, 0, 70), BackgroundColor3 = C.panel2, LayoutOrder = 20 + k, Parent = list }, { corner(10), stroke(C.line, 1) })
		text({ Position = UDim2.new(0, 14, 0, 6), Size = UDim2.new(1, -200, 0, 28), Text = item.icon .. " " .. item.name, TextSize = 20, Font = Enum.Font.GothamBlack, Parent = row })
		text({ Position = UDim2.new(0, 14, 0, 36), Size = UDim2.new(1, -200, 0, 26), Text = item.desc, TextSize = 14, TextColor3 = C.dim, Parent = row })
		labels[item.id] = button({ AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -12, 0.5, 0), Size = UDim2.new(0, 160, 0, 46), Text = "💰 " .. Config.formatNumber(item.cost), TextSize = 18, BackgroundColor3 = C.red, Parent = row }, function()
			Request:FireServer("buy", item.id)
		end)
	end
	refreshers.shop = function()
		for _, m in ipairs(Config.MOUNTS) do
			local b = mountBtns[m.id]
			local owned = state and ((state.mounts and state.mounts[m.id]) or (m.premium and state.premium and state.premium[m.premium]))
			local sel = state and state.mountSel == m.id
			local price = m.premium and ("R$ " .. tostring(Config.PREMIUM_BY_ID[m.premium].price)) or ("💰 " .. Config.formatNumber(m.cost))
			b.Text = sel and "✅ 고름" or (owned and "고르기" or price)
			b.BackgroundColor3 = sel and Color3.fromRGB(60, 120, 70) or (owned and C.panel or ((state and state.coins >= m.cost) and C.red or C.panel))
		end
		for _, item in ipairs(Config.Shop) do
			local can = state and state.coins >= item.cost
			labels[item.id].BackgroundColor3 = can and C.red or C.panel
		end
		local owned = state and state.premium or {}
		for id, b in pairs(premiumBtns) do
			local has = owned[id] == true
			b.Text = has and "✅ 가지고 있음" or ("R$ " .. tostring(Config.PREMIUM_BY_ID[id].price) .. "  구매")
			b.BackgroundColor3 = has and Color3.fromRGB(60, 70, 60) or Color3.fromRGB(40, 170, 80)
			b.AutoButtonColor = not has
		end
		local statLabel = { all = "골고루", str = "💪 근골", vit = "❤ 체력", agi = "🍃 경공", chi = "🌀 내공" }
		for id, ab in pairs(autoBtns) do
			local has = owned[id] == true
			local on = state and state.autoOn == true
			ab.toggle.Visible = has
			ab.stat.Visible = false -- 자동 수련은 지금 하는 수련을 대신 누른다 (능력치 고르기 없음)
			ab.toggle.Text = on and "🟢 켜짐" or "⚪ 꺼짐"
			ab.toggle.BackgroundColor3 = on and Color3.fromRGB(40, 140, 70) or C.panel2
			ab.stat.Text = statLabel[state and state.autoStat or "all"] or "골고루"
		end
	end
end

------------------------------------------------------------------------
-- 심법 (내공 수련서): 뽑기, 세 칸에 끼우기
------------------------------------------------------------------------
local function hex(c: Color3): string
	return string.format("#%02X%02X%02X", math.floor(c.R * 255), math.floor(c.G * 255), math.floor(c.B * 255))
end
local function manualLine(id: string, r: number): string
	local m = Config.MANUAL_BY_ID[id]
	local R = Config.MANUAL_RARITY[r]
	if not m or not R then
		return ""
	end
	return string.format('%s <font color="%s"><b>[%s] %s</b></font>  %s %.1f%%', m.icon, hex(R.color), R.name, m.name, m.desc, Config.manualValue(id, r) * 100)
end
local function buildManuals()
	local page = makePage("manuals")
	local D = Config.MANUAL_DRAW
	local head = text({ Size = UDim2.new(1, -330, 0, 52), TextSize = 16, RichText = true, TextYAlignment = Enum.TextYAlignment.Top, Parent = page })
	button({ AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -168, 0, 0), Size = UDim2.new(0, 156, 0, 48), Text = "📜 1번 뽑기", TextSize = 18, BackgroundColor3 = Color3.fromRGB(150, 100, 40) }, function()
		Request:FireServer("manualDraw", 1)
	end).Parent = page
	button({ AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -4, 0, 0), Size = UDim2.new(0, 156, 0, 48), Text = "📜 10번 뽑기", TextSize = 18, BackgroundColor3 = Color3.fromRGB(190, 120, 30) }, function()
		Request:FireServer("manualDraw", 10)
	end).Parent = page
	-- 끼운 세 칸
	local slotRow = new("Frame", { Position = UDim2.new(0, 0, 0, 58), Size = UDim2.new(1, 0, 0, 74), BackgroundTransparency = 1, Parent = page })
	new("UIGridLayout", { CellSize = UDim2.new(0.333, -8, 1, 0), CellPadding = UDim2.new(0, 8, 0, 0), Parent = slotRow })
	local slots = {}
	for i = 1, D.slots do
		local card = new("Frame", { BackgroundColor3 = C.panel2, Parent = slotRow }, { corner(10), stroke(C.line, 1.5) })
		local l = text({ Position = UDim2.new(0, 10, 0, 4), Size = UDim2.new(1, -20, 1, -8), TextSize = 15, RichText = true, Text = "", Parent = card })
		local b = button({ AnchorPoint = Vector2.new(1, 1), Position = UDim2.new(1, -6, 1, -6), Size = UDim2.new(0, 60, 0, 26), Text = "빼기", TextSize = 13, BackgroundColor3 = C.panel, Parent = card }, function()
			local id = state and state.equip and state.equip[i]
			if id then
				Request:FireServer("manualUnequip", id)
			end
		end)
		slots[i] = { card = card, label = l, btn = b }
	end
	local list = scroller(page, UDim2.new(1, 0, 1, -172), UDim2.new(0, 0, 0, 142))
	new("UIListLayout", { Padding = UDim.new(0, 6), Parent = list })
	local rows = {}
	for _, m in ipairs(Config.MANUALS) do
		local row = new("Frame", { Size = UDim2.new(1, -12, 0, 44), BackgroundColor3 = C.panel, Parent = list }, { corner(8), stroke(C.line, 1) })
		local l = text({ Position = UDim2.new(0, 12, 0, 0), Size = UDim2.new(1, -130, 1, 0), TextSize = 15, RichText = true, Parent = row })
		local b = button({ AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -8, 0.5, 0), Size = UDim2.new(0, 100, 0, 32), Text = "끼우기", TextSize = 14, Parent = row }, function()
			if not state or not state.manuals or not state.manuals[m.id] then
				return
			end
			Request:FireServer(table.find(state.equip or {}, m.id) and "manualUnequip" or "manualEquip", m.id)
		end)
		rows[m.id] = { label = l, btn = b }
	end
	local rates = {}
	for _, R in ipairs(Config.MANUAL_RARITY) do
		table.insert(rates, string.format('<font color="%s">%s %g%%</font>', hex(R.color), R.name, R.rate * 100))
	end
	text({ AnchorPoint = Vector2.new(0, 1), Position = UDim2.new(0, 0, 1, 0), Size = UDim2.new(1, 0, 0, 22), TextSize = 13, RichText = true, TextColor3 = C.dim, Text = "확률: " .. table.concat(rates, " · ") .. string.format("  ·  %d번 안에 전설 이상이 한 번은 나온다", D.pity), Parent = page })
	refreshers.manuals = function()
		if not state then
			return
		end
		head.Text = string.format("📜 두루마리 <b>%d</b>개\n<font color=\"#FFD25A\">전설 보장까지 %d번</font>  <font color=\"#C8B9A5\">(두루마리가 없으면 한 번에 💰 %s)</font>", state.scrolls or 0, math.max(1, D.pity - (state.pity or 0)), Config.formatNumber(D.coins))
		local equip = state.equip or {}
		for i, sl in ipairs(slots) do
			local id = equip[i]
			local r = id and state.manuals and state.manuals[id]
			sl.label.Text = (id and r) and (string.format("<b>%d칸</b>\n", i) .. manualLine(id, r)) or string.format('<b>%d칸</b>\n<font color="#9A8C7A">비어 있음 (아래에서 끼우기)</font>', i)
			sl.btn.Visible = id ~= nil
		end
		for _, m in ipairs(Config.MANUALS) do
			local row = rows[m.id]
			local r = state.manuals and state.manuals[m.id]
			if r then
				row.label.Text = manualLine(m.id, r)
				local on = table.find(equip, m.id) ~= nil
				row.btn.Visible = true
				row.btn.Text = on and "✅ 빼기" or "끼우기"
				row.btn.BackgroundColor3 = on and Color3.fromRGB(60, 120, 70) or C.panel2
			else
				row.label.Text = string.format('<font color="#8A7C6A">%s %s · %s (아직 없음)</font>', m.icon, m.name, m.desc)
				row.btn.Visible = false
			end
		end
	end
end

-- 뽑기 결과: 연출 (두루마리가 터지고 카드가 뒤집힌다) 뒤에 심법 창으로
local Gacha: any = nil
function UI.manualReveal(results: { any })
	Gacha = Gacha or require(script.Parent:WaitForChild("Gacha"))
	window.Visible = false
	Gacha.play(results, function()
		UI.openPage("manuals")
	end)
end

------------------------------------------------------------------------
-- 천상 상점: 천궁에서만 열린다 (천정으로 산다)
------------------------------------------------------------------------
local function buildSkyShop()
	local page = makePage("skyshop")
	local head = text({ Size = UDim2.new(1, 0, 0, 30), TextSize = 19, Font = Enum.Font.GothamBlack, TextColor3 = Color3.fromRGB(150, 230, 255), Parent = page })
	local list = scroller(page, UDim2.new(1, 0, 1, -40), UDim2.new(0, 0, 0, 38))
	new("UIListLayout", { Padding = UDim.new(0, 8), Parent = list })
	local btns: { [string]: TextButton } = {}
	for _, it in ipairs(Config.SKY_SHOP) do
		local row = new("Frame", { Size = UDim2.new(1, -12, 0, 70), BackgroundColor3 = Color3.fromRGB(30, 36, 60), Parent = list }, { corner(10), stroke(Color3.fromRGB(150, 230, 255), 1) })
		text({ Position = UDim2.new(0, 14, 0, 6), Size = UDim2.new(1, -200, 0, 28), Text = it.icon .. " " .. it.name, TextSize = 20, Font = Enum.Font.GothamBlack, Parent = row })
		text({ Position = UDim2.new(0, 14, 0, 36), Size = UDim2.new(1, -200, 0, 26), Text = it.desc, TextSize = 14, TextColor3 = C.dim, Parent = row })
		btns[it.id] = button({ AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -12, 0.5, 0), Size = UDim2.new(0, 160, 0, 46), Text = "💠 " .. it.cost, TextSize = 18, BackgroundColor3 = Color3.fromRGB(60, 120, 200), Parent = row }, function()
			Request:FireServer("skyBuy", it.id)
		end)
	end
	refreshers.skyshop = function()
		local g = state and state.skyGems or 0
		head.Text = string.format("💠 천정 %s  ·  천상계의 적·보스·운석 수호수가 떨어뜨린다%s", Config.formatNumber(g), (state and (state.skyBuffLeft or 0) > 0) and string.format("  ·  ✨ 영약 %d초", state.skyBuffLeft) or "")
		for _, it in ipairs(Config.SKY_SHOP) do
			btns[it.id].BackgroundColor3 = g >= it.cost and Color3.fromRGB(60, 120, 200) or C.panel
		end
	end
end

------------------------------------------------------------------------
-- 천층탑: 지금 층과 나가기
------------------------------------------------------------------------
local towerFrame: Frame? = nil
local towerLabel: TextLabel? = nil
UI.towerActive = false
function UI.setTower(data: any?)
	UI.towerActive = data ~= nil
	if not towerFrame then
		local f = new("Frame", { AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 132), Size = UDim2.new(0, 420, 0, 46), BackgroundColor3 = Color3.fromRGB(20, 14, 10), BackgroundTransparency = 0.2, Visible = false, Parent = gui }, { corner(10), stroke(C.gold, 1.5) })
		scaled(f)
		towerLabel = text({ Position = UDim2.new(0, 14, 0, 0), Size = UDim2.new(1, -120, 1, 0), TextSize = 19, Font = Enum.Font.GothamBlack, TextColor3 = C.gold, Parent = f })
		button({ AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -8, 0.5, 0), Size = UDim2.new(0, 96, 0, 32), Text = "🚪 나가기", TextSize = 15, BackgroundColor3 = C.red, Parent = f }, function()
			Request:FireServer("towerLeave")
		end)
		towerFrame = f
	end
	local f = towerFrame :: Frame
	f.Visible = data ~= nil
	if data and towerLabel then
		towerLabel.Text = string.format("🗼 천층탑 %d층%s  ·  최고 %d층", data.floor or 1, data.boss and " 👹" or "", data.best or 0)
	end
end

-- 1.7판 구름 미궁 진행 (가운데 위): 몇 번째 방 · 방 이름 · 나가기
local mazeFrame: Frame? = nil
local mazeLabel: TextLabel? = nil
function UI.setMaze(data: any?)
	UI.mazeActive = data ~= nil
	if not mazeFrame then
		local f = new("Frame", { AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 132), Size = UDim2.new(0, 480, 0, 46), BackgroundColor3 = Color3.fromRGB(14, 18, 30), BackgroundTransparency = 0.2, Visible = false, Parent = gui }, { corner(10), stroke(Color3.fromRGB(190, 225, 255), 1.5) })
		scaled(f)
		mazeLabel = text({ Position = UDim2.new(0, 14, 0, 0), Size = UDim2.new(1, -120, 1, 0), TextSize = 18, Font = Enum.Font.GothamBlack, TextColor3 = Color3.fromRGB(205, 230, 255), Parent = f })
		button({ AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -8, 0.5, 0), Size = UDim2.new(0, 96, 0, 32), Text = "🚪 나가기", TextSize = 15, BackgroundColor3 = C.red, Parent = f }, function()
			Request:FireServer("mazeLeave")
		end)
		mazeFrame = f
	end
	local f = mazeFrame :: Frame
	f.Visible = data ~= nil
	if data and mazeLabel then
		local icon = ({ wave = "⚔", trap = "⚡", elite = "🛡", treasure = "🎁", boss = "👹" })[data.kind] or "🌀"
		mazeLabel.Text = string.format("🌀 구름 미궁 %d / %d  ·  %s %s%s", data.room or 1, data.total or 7, icon, tostring(data.name or ""), data.cleared and "  ✓ 다음 방으로" or "")
	end
end

-- 1.7판 천상 레이드 현황 (오른쪽 위): 보스 체력, 남은 시간, 내 기여와 순위, 상위 셋
local raidFrame: Frame? = nil
local raidTitle: TextLabel? = nil
local raidBar: Frame? = nil
local raidInfo: TextLabel? = nil
local raidTop: TextLabel? = nil
function UI.setRaid(data: any?)
	if not raidFrame then
		local f = new("Frame", { AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -16, 0, 420), Size = UDim2.new(0, 300, 0, 132), BackgroundColor3 = Color3.fromRGB(24, 10, 30), BackgroundTransparency = 0.15, Visible = false, Parent = gui }, { corner(10), stroke(Color3.fromRGB(200, 110, 255), 1.6) })
		scaled(f)
		raidTitle = text({ Position = UDim2.new(0, 10, 0, 4), Size = UDim2.new(1, -20, 0, 24), TextSize = 18, Font = Enum.Font.GothamBlack, TextColor3 = Color3.fromRGB(230, 180, 255), Parent = f })
		local back = new("Frame", { Position = UDim2.new(0, 10, 0, 32), Size = UDim2.new(1, -20, 0, 14), BackgroundColor3 = Color3.fromRGB(30, 15, 35), Parent = f }, { corner(5) })
		raidBar = new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.fromRGB(190, 70, 255), Parent = back }, { corner(5) })
		raidInfo = text({ Position = UDim2.new(0, 10, 0, 50), Size = UDim2.new(1, -20, 0, 22), TextSize = 15, Font = Enum.Font.GothamBold, TextColor3 = C.text, Parent = f })
		raidTop = text({ Position = UDim2.new(0, 10, 0, 74), Size = UDim2.new(1, -20, 0, 54), TextSize = 14, TextColor3 = C.dim, TextYAlignment = Enum.TextYAlignment.Top, TextWrapped = true, Parent = f })
		raidFrame = f
	end
	local f = raidFrame :: Frame
	f.Visible = data ~= nil
	if not data then
		return
	end
	local frac = math.clamp((data.hp or 0) / math.max(1, data.maxHp or 1), 0, 1)
	;(raidTitle :: TextLabel).Text = "⚔ 레이드 · " .. tostring(data.name or "")
	;(raidBar :: Frame).Size = UDim2.fromScale(frac, 1)
	local left = math.max(0, math.floor(data.left or 0))
	;(raidInfo :: TextLabel).Text = string.format("체력 %d%%  ·  남은 %d:%02d  ·  내 기여 %.1f%%%s", math.floor(frac * 100 + 0.5), left // 60, left % 60, (data.mine or 0) * 100, (data.rank or 0) > 0 and string.format(" (%d위)", data.rank) or "")
	local lines = {}
	for i, t in ipairs(data.top or {}) do
		table.insert(lines, string.format("%d. %s  %.1f%%", i, tostring(t.name), (t.share or 0) * 100))
	end
	;(raidTop :: TextLabel).Text = #lines > 0 and table.concat(lines, "\n") or "아직 아무도 치지 않았다"
end

-- 사부의 시험 진행 (흘리기 3/6 · 남은 시간)
local trialFrame: Frame? = nil
local trialLabel: TextLabel? = nil
local trialBar: Frame? = nil
local trialData: any = nil
local trialEnd = 0
function UI.setTrial(data: any?)
	trialData = data
	if not trialFrame then
		local f = new("Frame", { AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 132), Size = UDim2.new(0, 460, 0, 54), BackgroundColor3 = Color3.fromRGB(20, 14, 10), BackgroundTransparency = 0.2, Visible = false, Parent = gui }, { corner(10), stroke(C.gold, 1.5) })
		scaled(f)
		trialLabel = text({ Position = UDim2.new(0, 14, 0, 2), Size = UDim2.new(1, -28, 0, 32), TextSize = 18, Font = Enum.Font.GothamBlack, TextColor3 = C.gold, Parent = f })
		local track = new("Frame", { Position = UDim2.new(0, 14, 1, -16), Size = UDim2.new(1, -28, 0, 8), BackgroundColor3 = Color3.fromRGB(60, 50, 40), Parent = f }, { corner(4) })
		trialBar = new("Frame", { Size = UDim2.fromScale(0, 1), BackgroundColor3 = C.gold, Parent = track }, { corner(4) })
		trialFrame = f
		RunService.Heartbeat:Connect(function()
			local d = trialData
			if d and trialLabel then
				local left = math.max(0, trialEnd - os.clock())
				local prog = d.kind == "survive" and string.format("%d / %d초", d.done or 0, d.need or 0) or string.format("%d / %d", d.done or 0, d.need or 0)
				trialLabel.Text = string.format("%s  ·  %s  ·  %s  ·  ⏱ %d초", d.title or "", d.goal or "", prog, math.ceil(left))
			end
		end)
	end
	local f = trialFrame :: Frame
	f.Visible = data ~= nil
	if data then
		trialEnd = os.clock() + (data.left or 0)
		if trialBar then
			TweenService:Create(trialBar, TweenInfo.new(0.2), { Size = UDim2.fromScale(math.clamp((data.done or 0) / math.max(1, data.need or 1), 0, 1), 1) }):Play()
		end
	end
end

local function buildHelp()
	local page = makePage("help")
	-- 처음 조작법 안내를 다시 본다
	button({ AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -8, 0, 0), Size = UDim2.new(0, 200, 0, 40), Text = "🎮 조작법 다시 보기", TextSize = 16, BackgroundColor3 = Color3.fromRGB(170, 120, 40), ZIndex = 3, Parent = page }, function()
		window.Visible = false
		local Cutscene = require(script.Parent:WaitForChild("Cutscene")) :: any
		Cutscene.controls(nil)
	end)
	local scroll = scroller(page, UDim2.fromScale(1, 1))
	text({
		Size = UDim2.new(1, -14, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		TextSize = 17,
		RichText = true,
		TextYAlignment = Enum.TextYAlignment.Top,
		Parent = scroll,
		Text = table.concat({
			"<b>🥋 맨손 하나로 강호를 꺾어라</b>",
			"",
			"<b>조작</b>",
			"• 클릭: 연타 (네 번까지 이어진다) · Z: 강타 (강한 한 방) (천룡장은 누르고 있다 놓기)",
			"• E · R: 기술 · G: 오의 (내공 100) · Q: 대시 (잠깐 무적) · 공중에서 Space: 두 번 뛰기",
			"• F: 막기. <b>맞기 직전에 누르면 흘리기</b> — 피해 없이 흘려 내고 상대가 휘청인다",
			"• H: 금창약 · T(가까이): 사부·수련·상점 · Tab: 능력치 · M: 지도 · Shift: 달리기",
			"",
			"<b>연타는 박자</b>",
			"• 앞 동작이 끝나 갈 즈음 눌러야 이어진다. 딱 맞으면 <b>정타</b> (피해 +15%, 세 번 이으면 연속 정타 +30%)",
			"• 너무 일찍 마구 누르면 <b>흐트러진다</b>: 연타가 끊기고 적이 읽어서 막고 흘린다",
			"• 숙련 6 각성: 연타 다섯 번째 마무리가 상대를 하늘로 띄운다 → 두 번 뛰고 공중에서 클릭 = 공중 연격 (세 번)",
			"• 맞기 직전에 대시로 피하면 <b>간파</b>: 상대가 굳고, 곧바로 클릭하면 반격",
			"",
			"<b>몸놀림</b>",
			"• 대시 바로 뒤 클릭: <b>돌진 일격</b> · 공중에서 클릭: <b>낙하격</b> (내리꽂아 주변을 친다)",
			"• 흘리기 바로 뒤 클릭: <b>반격</b> (크게 아프고 균형을 많이 깎는다)",
			"• 뒤로 대시하면 공중제비, 옆으로 대시하면 구르기",
			"",
			"<b>합을 겨루는 법</b>",
			"• 🟧 균형 막대: 막을 때마다 차오른다. 꽉 차면 <b>파훼</b> — 무릎이 꺾여 큰 피해를 받는다",
			"• 흘리기를 당한 쪽도 균형이 크게 깎인다. 흘리고, 흘리고, 무너뜨려라",
			"• 서로 같은 순간에 치면 <b>격돌</b>: 주먹이 부딪혀 둘 다 튕겨 난다",
			"• 적의 무기가 반짝이면 곧 휘두른다 — 흘릴 때다",
			"• <b>붉게 빛나는 공격</b>은 막을 수 없다. 대시로 피해라",
			"",
			"<b>강해지기</b>",
			"• 수련: 바위 들기(근골) · 목인장(체력·경공) · 폭포 명상(내공). 박자를 맞추면 2배",
			"• 능력치는 천천히 오른다 (로그). 오래 수련한 쪽이 조금 유리할 뿐, 흘리기를 잘하면 이긴다",
			"• 숙련도: 그 권법으로 맞힐수록 오른다. 숙련 3에 R, 5에 오의가 열린다",
			"• 경지: 능력치 합으로 삼류 → 이류 → 일류 → 절정 → 초절정 → 화경 → 현경 → 생사경",
			"",
			"<b>일곱 사부</b>",
			"• 첫 권법은 어디서든 공짜. 그다음 권법은 <b>그 사부를 찾아가</b> T를 누르고 배운다",
			"• 권법 창의 📍 길 안내를 누르면 화면과 지도에 길잡이가 뜬다. 하늘로 솟은 빛기둥이 사부의 자리",
			"• 태허호(남서) · 금강사(북동) · 매화원(북서) · 천룡봉(먼 동쪽) · 무영곡(먼 서쪽) · 뇌운 고원(남동) · 취선 주막(남쪽)",
			"",
			"<b>강호</b>",
			"• 청운 마을 (안전): 사부 안내판, 만물상, 비무대, 수련터",
			"• 남쪽 청운 들판: 무뢰배 (처음 싸워 보기 좋다)",
			"• 적은 마을에서 멀수록 세다 (Lv). 아주 먼 곳엔 철갑 무사·흑영 자객과 두목이 있다",
			"• 먼 북쪽 흑호채: 두목 흑호 · 먼 남동쪽 혈월곡 (핏빛 달 아래): 우두머리 혈랑",
			"• 서쪽 대나무 숲: 산적 도객, 창병 · 동쪽 비류 폭포 계곡: 산적, 쌍도 자객",
			"• 볼거리: 거신상 · 하늘 고리 · 옛 투기장 · 수정 들판 · 천년 고목",
			"• ⚔ 비무대: 올라선 사람끼리 1대1로 겨룬다",
		}, "\n"),
	})
end

-- 수련마다 하는 법 (수련 창 아래와 수련 안내 창에 나온다)
local TRAIN_GUIDE: { [string]: string } = {
	rock = "① 금빛 고리가 줄어든다  ② 고리가 가운데 흰 원에 겹칠 때 Space  ③ 딱 맞으면 완벽 (두 배)",
	waterfall = "① 파란 원이 커졌다 작아졌다 한다  ② 가장 커졌을 때 Space  ③ 숨 쉬듯 천천히",
	bamboo = "① 화살표를 따라 빛나는 고리로 달린다  ② 고리를 지나면 저절로 오른다  ③ Shift로 달리면 빠르다",
	dummy = "① 나무팔이 들어오며 원이 밝아진다  ② 가장 밝게 번쩍일 때 Space  ③ 실전의 흘리기 박자와 같다",
	mabo = "① 흰 바늘을 초록 칸 안에 붙잡는다  ② 누르면 오른쪽, 놓으면 왼쪽  ③ 짧게 톡톡 누르는 게 요령",
	ironpalm = "① 쇠모래가 번쩍일 때 Space  ② 바위 들기보다 조금 빠르다  ③ 근골이 크게 오른다",
	breathing = "① 기가 몸을 돌며 커진다  ② 가장 커졌을 때 Space  ③ 내공과 체력이 함께 오른다",
	simma = "마음속 마귀와 싸운다. 마구 치지 말고 F로 흘린 뒤 받아치자",
}

-- 수련 안내: 무엇을, 어디서, 어떻게
local function buildTrainGuide()
	local page = makePage("train")
	local scroll = scroller(page, UDim2.fromScale(1, 1))
	local statName = {}
	for _, s in ipairs(Config.Stats) do
		statName[s.id] = s.icon .. " " .. s.name
	end
	local lines = {
		"<b>🧘 수련 안내</b>",
		"",
		"• 수련터에 가서 T를 누르면 시작한다. 움직이면 끝난다",
		"• 박자가 맞으면 <b>좋음</b>, 딱 맞으면 <b>완벽</b> (두 배). 놓쳐도 잃는 것은 없다",
		"• 기력 같은 것은 없다. 얼마든지 수련할 수 있다",
		string.format("• 이류부터 <b>🔥 강화 수련</b> (바위에서): 박자가 빠르지만 오르는 능력치가 %d배", Config.HARD_TRAIN.mult),
		"• 경지가 오를수록 한 번에 오르는 능력치가 커진다",
		"",
	}
	local order = { "rock", "dummy", "waterfall", "mabo", "ironpalm", "breathing", "simma" }
	for _, id in ipairs(order) do
		local t = Config.Training[id]
		if t then
			local gains = {}
			if t.gains then
				for sid, n in pairs(t.gains) do
					table.insert(gains, string.format("%s +%d", statName[sid] or sid, n))
				end
			else
				table.insert(gains, statName[t.stat] or t.stat)
			end
			local realm = t.realm and Config.Realms[t.realm]
			table.insert(lines, string.format("<b>%s %s</b>  ·  %s%s", t.icon, t.name, table.concat(gains, ", "), realm and string.format("  ·  %s부터", realm.name) or ""))
			table.insert(lines, "   " .. (TRAIN_GUIDE[id] or t.desc))
			table.insert(lines, "")
		end
	end
	text({ Size = UDim2.new(1, -14, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, TextSize = 17, RichText = true, TextWrapped = true, TextYAlignment = Enum.TextYAlignment.Top, Parent = scroll, Text = table.concat(lines, "\n") })
end

local function buildTest()
	local page = makePage("test")
	local list = scroller(page, UDim2.fromScale(1, 1))
	new("UIListLayout", { Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder, Parent = list })
	local order = 0
	local function section(title: string, items: { any })
		order += 1
		text({ Size = UDim2.new(1, -12, 0, 26), Text = title, TextSize = 19, Font = Enum.Font.GothamBlack, TextColor3 = C.gold, LayoutOrder = order, Parent = list })
		order += 1
		local rows = math.ceil(#items / 3)
		local grid = new("Frame", { Size = UDim2.new(1, -12, 0, rows * 52), BackgroundTransparency = 1, LayoutOrder = order, Parent = list })
		new("UIGridLayout", { CellSize = UDim2.new(0.333, -8, 0, 44), CellPadding = UDim2.new(0, 8, 0, 8), Parent = grid })
		for _, item in ipairs(items) do
			local b = button({ Text = item[1], TextSize = 16, BackgroundColor3 = item.color or C.panel2 }, function()
				-- 길잡이는 화면에서만 (숨은 사부 자리를 따라간다)
				if string.sub(item[2], 1, 6) == "guide:" then
					UI.setGuide(string.sub(item[2], 7))
					window.Visible = false
					return
				end
				Request:FireServer(item[2], item[3])
			end)
			b.Parent = grid
		end
	end
	section("기본", {
		{ "💰 은자 +5000", "testCoins", 5000 }, { "📊 능력치 +200", "testStats", 200 }, { "📈 능력치 +5000", "testStats", 5000 },
		{ "🥋 숙련 최대", "testMastery" }, { "🌀 내공 무한·쿨 없음 (켜기·끄기)", "testChi" }, { "❤ 회복", "testHeal" },
		{ "🌀 다음 사부에게", "testTp" }, { "📜 이야기 다음 장", "testStory" }, { "⚔ 사부 시험 모두 통과", "testTrial" },
		{ "⛩ 관문 기록 지우기", "testGateReset" }, { "↺ 처음으로", "testReset", color = C.red },
	})
	section("♻ 1.9판: 환생·업적·각성·초·혈마신수", {
		{ "♻ 환생 조건 채우기 (열린 끝 경지까지)", "testRebirthReady" }, { "♻ 환생하기", "rebirth" }, { "♻ 환생·업적 기록 지우기", "testRebirthReset" },

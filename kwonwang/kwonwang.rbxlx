-- 고꾸라질 듯 앞으로 쏠리며 어깨로 들이받는다
A.soju_lurch = {
	{ t = 0, j = { W = { 15, 30, 0 }, N = { -10, -20, 15 }, RS = { 140, 0, 30 }, RE = { 60, 0, 0 }, LS = { -20, 0, -30 }, LE = { 20, 0, 0 }, R = { -15, 0, 10, 0, -0.6, 0.3 } } },
	{ t = 0.5, e = "snap", j = { W = { 25, -40, 0 }, N = { 20, 30, 0 }, RS = { 160, 0, 50 }, RE = { 40, 0, 0 }, LS = { 30, 0, 40 }, LE = { 120, 0, 0 }, RH = { -40, 0, 0 }, RK = { -20, 0, 0 }, LH = { 60, 0, 0 }, LK = { -60, 0, 0 }, R = { -38, -20, 0, 0, -1.1, -1.6 } } },
	{ t = 1, j = SOJU_END },
}
-- 취화방사: 술병을 앞으로 내밀어 흔들며 불길을 뿜는다 (왼손은 불똥을 튀긴다)
A.soju_spray = {
	{ t = 0, j = { W = { 0, 20, 0 }, RS = { 140, 0, 20 }, RE = { 90, 0, 0 }, LS = { 60, 0, 20 }, LE = { 90, 0, 0 }, R = { 0, 0, 8, 0, -0.5, 0 } } },
	{ t = 0.3, e = "snap", j = { W = { -5, 25, 0 }, N = { 0, -15, 0 }, RS = { 88, 0, -10 }, RE = { 15, 0, 0 }, LS = { 80, 0, 30 }, LE = { 60, 0, 0 }, RH = { 20, 0, 0 }, RK = { -30, 0, 0 }, LH = { -20, 0, 0 }, R = { -4, 0, 4, 0, -0.6, -0.3 } } },
	{ t = 0.5, j = { W = { -5, 22, 3 }, RS = { 92, 0, -6 }, RE = { 10, 0, 0 }, LS = { 75, 0, 34 }, LE = { 65, 0, 0 }, R = { -4, 0, 8, 0.1, -0.6, -0.3 } } },
	{ t = 0.7, j = { W = { -5, 28, -3 }, RS = { 86, 0, -14 }, RE = { 18, 0, 0 }, LS = { 82, 0, 28 }, LE = { 58, 0, 0 }, R = { -4, 0, 0, -0.1, -0.6, -0.3 } } },
	{ t = 1, j = SOJU_END },
}
-- 팔선취보: 갈지자로 비틀비틀 (몸이 좌우로 크게 쏠린다)
A.soju_stagger = {
	{ t = 0, j = { RS = { 150, 0, 40 }, RE = { 40, 0, 0 }, LS = { 40, 0, -60 }, LE = { 20, 0, 0 }, R = { -10, 0, 0, 0, -0.5, 0 } } },
}
for i = 1, 8 do
	local sd = i % 2 == 1 and 1 or -1
	table.insert(A.soju_stagger, { t = i / 9, e = "snap", j = { W = { 10, 30 * sd, -25 * sd }, N = { 0, -20 * sd, 25 * sd }, RS = { 150, 0, 40 + 30 * sd }, RE = { 30, 0, 0 }, LS = { 50, 0, -60 + 20 * sd }, LE = { 20, 0, 0 }, RH = { 30 * sd, 0, 10 }, RK = { -40, 0, 0 }, LH = { -30 * sd, 0, -10 }, LK = { -40, 0, 0 }, R = { -15, 20 * sd, 25 * sd, 0.4 * sd, -0.7, 0 } } })
end
table.insert(A.soju_stagger, { t = 1, j = SOJU_END })
-- 취몽팔선진: 술병을 하늘 높이 던지고, 두 팔을 벌려 비를 맞는다
A.soju_throw = {
	{ t = 0, j = { W = { 20, 0, 0 }, RS = { 30, 0, 20 }, RE = { 60, 0, 0 }, R = { -10, 0, 0, 0, -1.0, 0 } } },
	{ t = 0.3, e = "snap", j = { W = { -25, 0, 0 }, N = { -40, 0, 0 }, RS = { 178, 0, 5 }, RE = { 0, 0, 0 }, LS = { 60, 0, -40 }, LE = { 20, 0, 0 }, R = { 12, 0, 0, 0, 0.4, 0 } } },
	{ t = 0.6, j = { W = { -20, 0, 0 }, N = { -35, 0, 0 }, RS = { 120, 0, 90 }, RE = { 10, 0, 0 }, LS = { 120, 0, -90 }, LE = { 10, 0, 0 }, R = { 10, 0, 6, 0, -0.2, 0 } } },
	{ t = 0.85, j = { W = { -15, 0, 8 }, N = { -30, 0, 20 }, RS = { 125, 0, 95 }, RE = { 10, 0, 0 }, LS = { 115, 0, -85 }, LE = { 10, 0, 0 }, R = { 8, 0, 12, 0.2, -0.3, 0 } } },
	{ t = 1, j = SOJU_END },
}
-- 취선만권 (초 오의): 점점 빨라지는 앞구르기 다섯 바퀴 → 와다다다 주먹 → 술병 내려찍기
-- 앞 47% (= 컷씬 1.6초 / 전체 3.4초) 동안 일곱 바퀴 구른다. 구른 각도는 -2520도로 남아 있어야 거꾸로 풀리지 않는다
A.soju_rolls = {
	{ t = 0, j = { W = { 20, 0, 0 }, N = { 20, 0, 0 }, RS = { 60, 0, 20 }, RE = { 120, 0, 0 }, LS = { 60, 0, -20 }, LE = { 120, 0, 0 }, RH = { 60, 0, 0 }, RK = { -100, 0, 0 }, LH = { 60, 0, 0 }, LK = { -100, 0, 0 }, R = { -20, 0, 0, 0, -1.4, 0 } } },
}
do
	local CUT = 1.6 / 3.4
	local TUCK = { W = { -40, 0, 0 }, N = { -40, 0, 0 }, RS = { 120, 0, 30 }, RE = { 70, 0, 0 }, LS = { 120, 0, -30 }, LE = { 70, 0, 0 }, RH = { 110, 0, 0 }, RK = { -135, 0, 0 }, LH = { 110, 0, 0 }, LK = { -135, 0, 0 } }
	for k = 1, 14 do
		-- 각도가 시간의 제곱으로 늘어난다 (갈수록 빨라진다)
		local j = table.clone(TUCK)
		j.R = { -180 * k, 0, 0, 0, -1.5, 0 }
		table.insert(A.soju_rolls, { t = CUT * math.sqrt(k / 14), j = j })
	end
	local spin = -2520
	-- 벌떡 일어나 주먹을 퍼붓는다 (좌우 번갈아 스무 번, 몸은 비틀비틀)
	local n = 20
	for i = 1, n do
		local r = i % 2 == 1
		local t = CUT + 0.02 + (0.94 - CUT - 0.02) * (i - 1) / (n - 1)
		local sway = math.sin(i * 1.3) * 12
		table.insert(A.soju_rolls, { t = t, e = "snap", j = {
			W = { 0, r and 40 or -40, sway * 0.5 }, N = { 0, r and -25 or 25, sway },
			RS = r and { 92, 0, 0 } or { 140, 0, 20 }, RE = r and { 0, 0, 0 } or { 70, 0, 0 },
			LS = r and { 40, 0, -20 } or { 92, 0, 0 }, LE = r and { 100, 0, 0 } or { 0, 0, 0 },
			RH = { 25, 0, 10 }, RK = { -35, 0, 0 }, LH = { -20, 0, -10 }, LK = { -25, 0, 0 },
			R = { spin - 6, r and 6 or -6, sway, 0, -0.55, r and -0.4 or -0.2 },
		} })
	end
	table.insert(A.soju_rolls, { t = 0.96, j = { W = { -25, 0, 0 }, N = { -25, 0, 0 }, RS = { 178, 0, 10 }, RE = { 20, 0, 0 }, LS = { 100, 0, -40 }, LE = { 30, 0, 0 }, R = { spin + 10, 0, 0, 0, 0.1, 0 } } })
	table.insert(A.soju_rolls, { t = 0.99, e = "snap", j = { W = { 45, 0, 0 }, N = { 20, 0, 0 }, RS = { 40, 0, 0 }, RE = { 0, 0, 0 }, LS = { 30, 0, -50 }, LE = { 20, 0, 0 }, RH = { 40, 0, 10 }, RK = { -80, 0, 0 }, LK = { -70, 0, 0 }, R = { spin - 20, 0, 0, 0, -1.6, -1.0 } } })
	table.insert(A.soju_rolls, { t = 1, j = { W = { 45, 0, 0 }, N = { 20, 0, 0 }, RS = { 40, 0, 0 }, RE = { 0, 0, 0 }, LS = { 30, 0, -50 }, LE = { 20, 0, 0 }, RH = { 40, 0, 10 }, RK = { -80, 0, 0 }, LK = { -70, 0, 0 }, R = { spin - 20, 0, 0, 0, -1.6, -1.0 } } })
end
-- 취선승천권: 술병째 올려 치며 한 바퀴 솟는다
A.soju_rise = {
	{ t = 0, j = { W = { 15, -30, 0 }, RS = { 20, 0, 30 }, RE = { 60, 0, 0 }, LS = { 40, 0, -40 }, LE = { 40, 0, 0 }, RK = { -60, 0, 0 }, LK = { -50, 0, 0 }, R = { -10, 0, 10, 0, -1.0, 0 } } },
	{ t = 0.4, e = "snap", j = { W = { -15, 40, 0 }, N = { -20, 0, 0 }, RS = { 178, 0, 10 }, RE = { 0, 0, 0 }, LS = { 50, 0, -80 }, LE = { 10, 0, 0 }, RH = { 60, 0, 0 }, RK = { -70, 0, 0 }, R = { 10, -200, -10, 0, 1.0, 0 } } },
	{ t = 1, j = { W = { 5, 15, -16 }, N = { 12, -10, 24 }, RS = { 128, 0, 8 }, RE = { 78, 0, 0 }, LS = { 18, 0, -28 }, LE = { 38, 0, 0 }, R = { 0, -352, 14, 0.3, -0.45, 0 } } },
}

------------------------------------------------------------------------
-- 1.9판 초·혈마신수 (오른손에 큰 낫)
------------------------------------------------------------------------
local REAP_UP = { W = { -20, -25, 0 }, N = { 18, 25, 0 }, RS = { 150, 0, 35 }, RE = { 70, 0, 0 }, LS = { 55, 0, -40 }, LE = { 50, 0, 0 }, RH = { -25, 0, 18 }, LH = { 35, 0, -16 }, RK = { -50, 0, 0 }, LK = { -60, 0, 0 } }
-- 끝 자세 (돈 만큼 몸 방향을 남겨 둔다: 거꾸로 풀리지 않게)
local function reapEnd(yaw: number?): Joints
	local j = table.clone(REAP_UP)
	j.R = { -10, yaw or 0, 0, 0, -1.1, 0 }
	return j
end
-- 높은 오른쪽에서 낮은 왼쪽으로 크게 내려 벤다 (몸이 낫을 따라 비튼다)
A.reap_slash_r = {
	{ t = 0, j = { W = { -15, -45, 0 }, N = { 10, 40, 0 }, RS = { 175, 0, 45 }, RE = { 30, 0, 0 }, LS = { 60, 0, -40 }, LE = { 40, 0, 0 }, R = { -5, 0, 0, 0, -0.9, 0 } } },
	{ t = 0.42, e = "snap", j = { W = { 20, 55, 0 }, N = { 10, -35, 0 }, RS = { 70, 0, -50 }, RE = { 5, 0, 0 }, LS = { 30, 0, -70 }, LE = { 30, 0, 0 }, RH = { 35, 0, 10 }, RK = { -40, 0, 0 }, LH = { -20, 0, -12 }, LK = { -50, 0, 0 }, R = { -18, 0, 0, 0, -1.2, -0.8 } } },
	{ t = 1, j = reapEnd() },
}
-- 낮은 왼쪽에서 높은 오른쪽으로 거꾸로 올려 벤다
A.reap_slash_l = {
	{ t = 0, j = { W = { 15, 50, 0 }, N = { 5, -30, 0 }, RS = { 40, 0, -55 }, RE = { 25, 0, 0 }, LS = { 40, 0, -30 }, LE = { 60, 0, 0 }, R = { -15, 0, 0, 0, -1.3, 0 } } },
	{ t = 0.42, e = "snap", j = { W = { -20, -50, 0 }, N = { -10, 40, 0 }, RS = { 170, 0, 70 }, RE = { 15, 0, 0 }, LS = { 70, 0, -60 }, LE = { 20, 0, 0 }, RH = { -20, 0, 15 }, LH = { 40, 0, -10 }, R = { -5, 0, 0, 0, -0.6, -0.6 } } },
	{ t = 1, j = reapEnd() },
}
-- 낫을 옆으로 쭉 뻗고 두 바퀴 돈다
local SPIN_ARM = { W = { -10, -30, 0 }, N = { 0, 20, 0 }, RS = { 95, 0, 80 }, RE = { 5, 0, 0 }, LS = { 40, 0, -60 }, LE = { 30, 0, 0 }, RH = { -20, 0, 14 }, LH = { 25, 0, -14 }, RK = { -45, 0, 0 }, LK = { -45, 0, 0 } }
local function spinJ(yaw: number, fwd: number?): Joints
	local j = table.clone(SPIN_ARM)
	j.R = { -8, yaw, 0, 0, -1.0, fwd or 0 }
	return j
end
A.reap_spin = {
	{ t = 0, j = spinJ(30) },
	{ t = 0.34, e = "snap", j = spinJ(-330) },
	{ t = 0.72, e = "snap", j = spinJ(-690) },
	{ t = 1, j = reapEnd(-720) },
}
-- 뛰어올라 머리 위에서 온몸으로 내리찍는다 (참수)
A.reap_overhead = {
	{ t = 0, j = { W = { -30, 0, 0 }, N = { -20, 0, 0 }, RS = { 178, 0, 10 }, RE = { 40, 0, 0 }, LS = { 150, 0, -20 }, LE = { 50, 0, 0 }, R = { 10, 0, 0, 0, 0.2, 0.3 } } },
	{ t = 0.5, e = "snap", j = { W = { 45, 0, 0 }, N = { 20, 0, 0 }, RS = { 45, 0, 0 }, RE = { 0, 0, 0 }, LS = { 40, 0, -20 }, LE = { 20, 0, 0 }, RH = { 45, 0, 10 }, RK = { -85, 0, 0 }, LH = { -25, 0, 0 }, LK = { -70, 0, 0 }, R = { -22, 0, 0, 0, -1.6, -1.2 } } },
	{ t = 1, j = reapEnd() },
}
-- 혈월 회선참 (강타): 몸을 감았다가 앞으로 미끄러지며 두 바퀴 휘두른다
A.reap_wave = {
	{ t = 0, j = { W = { -5, 60, 0 }, N = { 0, -40, 0 }, RS = { 90, 0, -40 }, RE = { 20, 0, 0 }, LS = { 50, 0, -30 }, LE = { 60, 0, 0 }, RK = { -60, 0, 0 }, LK = { -50, 0, 0 }, R = { -15, 0, 0, 0, -1.2, 0 } } },
	{ t = 0.36, e = "snap", j = spinJ(-360, -1.5) },
	{ t = 0.66, e = "snap", j = spinJ(-720, -2.4) },
	{ t = 1, j = reapEnd(-720) },
}
-- 혈사슬: 낫을 앞으로 던졌다가 (팔을 쭉) 확 잡아당기고, 한 바퀴 돌며 벤다
A.reap_hook = {
	{ t = 0, j = { W = { -10, -40, 0 }, N = { 0, 30, 0 }, RS = { 160, 0, 30 }, RE = { 60, 0, 0 }, LS = { 50, 0, -40 }, LE = { 50, 0, 0 }, R = { -5, 0, 0, 0, -0.9, 0 } } },
	{ t = 0.28, e = "snap", j = { W = { 10, 30, 0 }, N = { 0, -20, 0 }, RS = { 95, 0, -5 }, RE = { 0, 0, 0 }, LS = { 40, 0, -40 }, LE = { 40, 0, 0 }, RH = { 30, 0, 10 }, RK = { -40, 0, 0 }, R = { -15, 0, 0, 0, -1.0, -0.6 } } },
	{ t = 0.55, e = "snap", j = { W = { -10, -30, 0 }, N = { 0, 25, 0 }, RS = { 60, 0, 60 }, RE = { 110, 0, 0 }, LS = { 70, 0, -50 }, LE = { 30, 0, 0 }, LH = { 30, 0, -10 }, LK = { -55, 0, 0 }, R = { 0, 0, 0, 0, -1.1, 0.4 } } },
	{ t = 0.82, e = "snap", j = spinJ(-360) },
	{ t = 1, j = reapEnd(-360) },
}
-- 혈월낙참: 몸을 말아 솟구쳤다가 낫을 거꾸로 쥐고 땅에 내리꽂는다
A.reap_leap = {
	{ t = 0, j = { W = { -25, 0, 0 }, N = { -25, 0, 0 }, RS = { 178, 0, 15 }, RE = { 60, 0, 0 }, LS = { 160, 0, -15 }, LE = { 60, 0, 0 }, RH = { 70, 0, 0 }, RK = { -110, 0, 0 }, LH = { 40, 0, 0 }, LK = { -100, 0, 0 }, R = { 20, 0, 0, 0, 0, 0 } } },
	{ t = 0.45, j = { W = { -30, 0, 0 }, N = { -30, 0, 0 }, RS = { 178, 0, 10 }, RE = { 30, 0, 0 }, LS = { 170, 0, -10 }, LE = { 30, 0, 0 }, RH = { 80, 0, 0 }, RK = { -120, 0, 0 }, LH = { 60, 0, 0 }, LK = { -110, 0, 0 }, R = { -40, 0, 0, 0, 0.4, 0 } } },
	{ t = 0.62, e = "snap", j = { W = { 50, 0, 0 }, N = { 25, 0, 0 }, RS = { 30, 0, 0 }, RE = { 0, 0, 0 }, LS = { 20, 0, -20 }, LE = { 10, 0, 0 }, RH = { 50, 0, 10 }, RK = { -90, 0, 0 }, LH = { -30, 0, 0 }, LK = { -70, 0, 0 }, R = { -25, 0, 0, 0, -1.7, -1.0 } } },
	{ t = 1, j = reapEnd() },
}
-- 혈마수확 (오의): 낫을 하늘로 치켜들어 피의 낫을 부르고, 두 바퀴 휩쓴 뒤 땅에 꽂는다
A.ult_reap = {
	{ t = 0, j = { W = { -25, 0, 0 }, N = { -30, 0, 0 }, RS = { 178, 0, 20 }, RE = { 10, 0, 0 }, LS = { 120, 0, -60 }, LE = { 10, 0, 0 }, RK = { -20, 0, 0 }, LK = { -20, 0, 0 }, R = { 5, 0, 0, 0, 0, 0 } } },
	{ t = 0.28, j = { W = { -30, 0, 0 }, N = { -35, 0, 0 }, RS = { 178, 0, 25 }, RE = { 5, 0, 0 }, LS = { 130, 0, -70 }, LE = { 5, 0, 0 }, RK = { -25, 0, 0 }, LK = { -25, 0, 0 }, R = { 8, 0, 0, 0, 0.1, 0 } } },
	{ t = 0.5, e = "snap", j = spinJ(-360) },
	{ t = 0.72, e = "snap", j = spinJ(-720) },
	{ t = 0.86, e = "snap", j = { W = { 45, 0, 0 }, N = { 20, 0, 0 }, RS = { 40, 0, 0 }, RE = { 0, 0, 0 }, LS = { 30, 0, -30 }, LE = { 20, 0, 0 }, RH = { 45, 0, 10 }, RK = { -85, 0, 0 }, LH = { -25, 0, 0 }, LK = { -70, 0, 0 }, R = { -20, -720, 0, 0, -1.6, -0.8 } } },
	{ t = 1, j = reapEnd(-720) },
}
-- 혈월만겸 (초 오의): 무릎 꿇었다가 일어나며 낫을 달로 치켜들고 (컷씬), 미친 듯 베어 대다가, 마지막에 하늘에서 땅까지 한 줄기로 내려 가른다
A.reap_moon = {
	{ t = 0, j = { W = { 30, 0, 0 }, N = { 20, 0, 0 }, RS = { 40, 0, 30 }, RE = { 90, 0, 0 }, LS = { 30, 0, -30 }, LE = { 90, 0, 0 }, RH = { 80, 0, 0 }, RK = { -130, 0, 0 }, LH = { -10, 0, 0 }, LK = { -100, 0, 0 }, R = { -10, 0, 0, 0, -2.0, 0 } } },
	{ t = 0.25, j = { W = { -30, 0, 0 }, N = { -40, 0, 0 }, RS = { 178, 0, 10 }, RE = { 0, 0, 0 }, LS = { 140, 0, -70 }, LE = { 0, 0, 0 }, RH = { -5, 0, 0 }, RK = { -10, 0, 0 }, LH = { 5, 0, 0 }, LK = { -10, 0, 0 }, R = { 8, 0, 0, 0, 0, 0 } } },
	{ t = 0.44, j = { W = { -32, 0, 0 }, N = { -42, 0, 0 }, RS = { 178, 0, 12 }, RE = { 0, 0, 0 }, LS = { 145, 0, -72 }, LE = { 0, 0, 0 }, RH = { -5, 0, 0 }, RK = { -10, 0, 0 }, LH = { 5, 0, 0 }, LK = { -10, 0, 0 }, R = { 8, 0, 0, 0, 0.1, 0 } } },
}
do
	local A1 = A.reap_slash_r[2].j
	local B1 = A.reap_slash_l[2].j
	for k = 1, 8 do
		table.insert(A.reap_moon, { t = 0.44 + k * 0.05, e = "snap", j = k % 2 == 1 and A1 or B1 })
	end
	table.insert(A.reap_moon, { t = 0.9, e = "snap", j = { W = { -35, 0, 0 }, N = { -30, 0, 0 }, RS = { 178, 0, 8 }, RE = { 10, 0, 0 }, LS = { 160, 0, -20 }, LE = { 20, 0, 0 }, R = { 10, 0, 0, 0, 0.4, 0.3 } } })
	table.insert(A.reap_moon, { t = 0.95, e = "snap", j = { W = { 55, 0, 0 }, N = { 25, 0, 0 }, RS = { 30, 0, 0 }, RE = { 0, 0, 0 }, LS = { 30, 0, -30 }, LE = { 10, 0, 0 }, RH = { 50, 0, 10 }, RK = { -90, 0, 0 }, LH = { -30, 0, 0 }, LK = { -70, 0, 0 }, R = { -25, 0, 0, 0, -1.7, -1.4 } } })
	table.insert(A.reap_moon, { t = 1, j = reapEnd() })
end
-- 혈겸승천 (각성 마무리): 낫으로 올려 베며 한 바퀴 솟는다
A.reap_rise = {
	{ t = 0, j = { W = { 10, 40, 0 }, RS = { 30, 0, -40 }, RE = { 30, 0, 0 }, LS = { 40, 0, -40 }, LE = { 40, 0, 0 }, RK = { -60, 0, 0 }, LK = { -50, 0, 0 }, R = { -15, 0, 0, 0, -1.3, 0 } } },
	{ t = 0.4, e = "snap", j = { W = { -25, -30, 0 }, N = { -20, 0, 0 }, RS = { 178, 0, 30 }, RE = { 0, 0, 0 }, LS = { 60, 0, -80 }, LE = { 10, 0, 0 }, RH = { 60, 0, 0 }, RK = { -60, 0, 0 }, R = { 0, -180, 0, 0, 0.9, 0 } } },
	{ t = 1, j = reapEnd(-360) },
}

Poses.anims = A


	{ t = 0.6, e = "snap", j = { W = { -20, 0, 0 }, N = { 20, 0, 0 }, RS = { 160, 0, 60 }, RE = { 20, 0, 0 }, LS = { 30, 0, -80 }, LE = { 10, 0, 0 }, RH = { 30, 0, 0 }, RK = { -60, 0, 0 }, LH = { 120, 0, 0 }, LK = { 0, 0, 0 }, R = { 50, 0, 0, 0, -1.5, 0.5 } } },
	{ t = 1, j = SOJU_END },
}
-- 술병을 머리 위로 치켜들었다가 온몸으로 내려찍는다
A.soju_smash = {
	{ t = 0, j = { W = { -25, 0, -5 }, N = { -25, 0, 0 }, RS = { 178, 0, 10 }, RE = { 25, 0, 0 }, LS = { 120, 0, -40 }, LE = { 30, 0, 0 }, R = { 10, 0, -6, 0, 0.2, 0.3 } } },
	{ t = 0.5, e = "snap", j = { W = { 45, 0, 5 }, N = { 20, 0, 10 }, RS = { 40, 0, 0 }, RE = { 0, 0, 0 }, LS = { 30, 0, -50 }, LE = { 20, 0, 0 }, RH = { 40, 0, 10 }, RK = { -80, 0, 0 }, LH = { -20, 0, 0 }, LK = { -70, 0, 0 }, R = { -20, 0, 10, 0.2, -1.6, -1.0 } } },

Config.AWAKEN = {
	{ lv = 6, name = "각성", mark = "✦", dmg = 1.25, cd = 0.85 },
	{ lv = 10, name = "완전 각성", mark = "✦✦", dmg = 1.55, cd = 0.7, echo = 0.5, echoDelay = 0.3 },
}
function Config.awakenTier(lv: number): number
	if lv >= Config.AWAKEN[2].lv then
		return 2
	elseif lv >= Config.AWAKEN[1].lv then
		return 1
	end
	return 0
end

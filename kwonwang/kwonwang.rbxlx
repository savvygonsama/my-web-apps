local A: { [string]: { Key } } = {}

-- 오른손 장 (손바닥 지르기)
A.palm_r = {
	{ t = 0, j = { W = { 0, -20, 0 }, RS = { 40, 0, 15 }, RE = { 95, 0, 0 }, LS = { 55, 0, -8 }, LE = { 80, 0, 0 }, R = { 0, 0, 0, 0, -0.4, 0.2 } } },

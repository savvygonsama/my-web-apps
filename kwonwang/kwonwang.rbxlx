	stance_base = { W = { 0, -15, 0 }, N = { 0, 15, 0 }, RS = { 50, 0, 10 }, RE = { 100, 0, 0 }, LS = { 60, 0, -10 }, LE = { 105, 0, 0 } },
	-- 태허: 손바닥을 펴고 낮게, 물 흐르듯
	stance_taeheo = { W = { 0, -20, 0 }, N = { 0, 20, 0 }, RS = { 35, 0, 18 }, RE = { 70, 0, 0 }, LS = { 55, 0, -8 }, LE = { 80, 0, 0 } },

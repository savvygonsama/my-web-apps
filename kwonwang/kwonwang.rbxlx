-- 먼 땅의 적: 기존 적을 바탕으로 이름·빛깔·세기만 바꾼다
local function variant(base: any, over: { [string]: any }): any
	local v = table.clone(base)
	for k, x in pairs(over) do
		v[k] = x
	end
	return v
end

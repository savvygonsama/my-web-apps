-- 천상계 오르내리기
local function toSky(player: Player)
	local p = profiles[player]
	local f = Combat.fighterOfPlayer(player)
	if not p or not f or f.dead then
		return
	end
	if Calc.realm(p) < Config.SKY.realm then
		toast(player, string.format("☁ 천상계는 %s의 경지부터 오를 수 있어요", Config.Realms[Config.SKY.realm].name))
		return
	end
	if f.combatUntil > os.clock() then
		toast(player, "싸우는 중에는 오를 수 없어요")
		return
	end
	Train.stop(player)
	Combat.dismount(f)
	local char = player.Character
	if char then
		local at = Config.SKY.islands[1].at + Vector3.new(0, 5, 30)
		char:PivotTo(CFrame.lookAt(at, at + Vector3.new(0, 0, -1)))
	end
	if not cutscene(player, "sky_first", { at = Config.SKY.islands[1].at }) then
		toast(player, "☁ 천상계 · 천궁")
	end
end
if W.skyUp then
	W.skyUp.Triggered:Connect(toSky)
end
if W.skyDown then
	W.skyDown.Triggered:Connect(function(player: Player)
		local char = player.Character
		local f = Combat.fighterOfPlayer(player)
		if char and f and not f.dead then
			Combat.dismount(f)
			char:PivotTo(CFrame.new(Config.SKY.portal + Vector3.new(10, 5, 10)))
			toast(player, "⬇ 강호로 내려왔어요")
		end
	end)
end

-- 천상계에서 떨어지면: 사람은 천궁으로 되돌리고, 적은 쓰러뜨린 것으로 친다 (땅으로 떨어지지 않게)
task.spawn(function()
	local Y = Config.SKY.y
	while true do
		task.wait(0.5)
		for player in pairs(profiles) do
			local f = Combat.fighterOfPlayer(player)
			if f and not f.dead then
				local y = f.root.Position.Y
				if y < Y - 60 and y > Y - 1600 then
					f.root.AssemblyLinearVelocity = Vector3.zero
					f.root.CFrame = CFrame.new(Config.SKY.islands[1].at + Vector3.new(0, 5, 30))
					toast(player, "☁ 구름 아래로 떨어져 천궁으로 돌아왔어요")
				end
			end
		end
		local fallen = {}
		for _, e in ipairs(Npc.list) do
			local ef = e.f
			if e.region == "sky" and not ef.dead and ef.root.Parent and ef.root.Position.Y < Y - 60 then
				table.insert(fallen, ef)
			end
		end
		for _, ef in ipairs(fallen) do
			Combat.kill(ef, nil)
		end
	end
end)

-- 강호 순위표: 1분마다. 저장소(정렬 저장소)가 되면 모든 서버의 기록, 안 되면 이 서버 사람만
local Board = {}
local boardStores: { [string]: any } = {}
local nameCache: { [number]: string } = {}
local boardSent: { [string]: number } = {} -- 같은 값은 다시 보내지 않는다
local BOARD_VALUE = {
	realm = function(p: Profile): number
		return math.floor(Calc.total(p))
	end,
	pvp = function(p: Profile): number
		return p.pvpWins
	end,
	tower = function(p: Profile): number
		return p.towerBest
	end,
}

function Board.store(key: string): any
	if boardStores[key] == nil then
		local ok, ds = pcall(function()
			return DataStoreService:GetOrderedDataStore("Kwonwang_lb_" .. key)
		end)
		boardStores[key] = ok and ds or false
	end
	return boardStores[key] or nil
end

function Board.name(userId: number): string
	if nameCache[userId] then
		return nameCache[userId]
	end
	local pl = Players:GetPlayerByUserId(userId)
	if pl then
		nameCache[userId] = pl.DisplayName
		return pl.DisplayName
	end
	local ok, name = pcall(function()
		return Players:GetNameFromUserIdAsync(userId)
	end)
	nameCache[userId] = ok and name or ("#" .. userId)
	return nameCache[userId]
end

function Board.update()
	local boards = W.boards
	if not boards then
		return
	end
	for key, valueOf in pairs(BOARD_VALUE) do
		local gui = boards[key]
		if gui then
			local rows: { { string } } = {}
			local ds = Board.store(key)
			local okStore = false
			if ds then
				for player, p in pairs(profiles) do
					local st = states[player]
					local v = valueOf(p)
					local sentKey = key .. player.UserId
					if st and st.canSave and not st.tester and boardSent[sentKey] ~= v then
						local ok = pcall(function()
							ds:SetAsync(tostring(player.UserId), v)
						end)
						if ok then
							boardSent[sentKey] = v
						end
					end
				end
				local ok, page = pcall(function()
					return ds:GetSortedAsync(false, 10):GetCurrentPage()
				end)
				if ok and type(page) == "table" and #page > 0 then
					okStore = true
					for _, entry in ipairs(page) do
						table.insert(rows, { Board.name(tonumber(entry.key) or 0), Config.formatNumber(entry.value) })
					end
				end
			end
			if not okStore then
				local list = {}
				for player, p in pairs(profiles) do
					table.insert(list, { player.DisplayName, valueOf(p) })
				end
				table.sort(list, function(a, b)
					return a[2] > b[2]
				end)
				for i = 1, math.min(10, #list) do
					table.insert(rows, { list[i][1], Config.formatNumber(list[i][2]) })
				end
			end
			for r = 1, 10 do
				local label = gui:FindFirstChild("Row" .. r)
				if label and label:IsA("TextLabel") then
					local row = rows[r]
					label.Text = row and string.format("%d. %s  ·  %s", r, row[1], row[2]) or ""
				end
			end
		end
	end
end

task.spawn(function()
	task.wait(8)
	while true do
		local ok, err = pcall(Board.update)
		if not ok then
			warn("[권왕] 순위표 오류:", err)
		end
		task.wait(60)
	end
end)
-- 천상 상점·객잔
if W.skyShop then
	W.skyShop.Triggered:Connect(function(player: Player)
		Push:FireClient(player, "open", { page = "skyshop" })
	end)
end
if W.skyInn then
	W.skyInn.Triggered:Connect(function(player: Player)
		local f = Combat.fighterOfPlayer(player)
		if f and not f.dead then
			f.hp = f.maxHp
			f.posture = 0
			f.chi = (f :: any).chiMax or Config.CHI_MAX
			Combat.sync(f)
		end
		toast(player, "🛏 구름 이불에서 쉬었다. 체력과 내공이 가득 찼다")
	end)
end

-- 운석 낙하: 천상계에 사람이 있으면 몇 분마다, 천궁이 아닌 섬 어딘가에 운석이 떨어지고 운석 수호수가 나타난다
task.spawn(function()
	local M = Config.METEOR
	local nextAt = os.clock() + M.first
	while true do
		task.wait(1)
		local skyPlayers = {}
		for player in pairs(profiles) do
			local f = Combat.fighterOfPlayer(player)
			if f and f.root.Position.Y > Config.SKY.y - 300 then
				table.insert(skyPlayers, player)
			end
		end
		if (os.clock() >= nextAt or _G.KwonMeteorNow) and #skyPlayers > 0 then
			_G.KwonMeteorNow = nil
			nextAt = os.clock() + M.every
			local choices = {}
			for _, isl in ipairs(Config.SKY.islands) do
				if not isl.safe and not isl.hidden and not isl.raid then
					table.insert(choices, isl)
				end
			end
			local isl = choices[math.random(#choices)]
			local a, r = math.random() * math.pi * 2, isl.radius * 0.5 * math.random()
			local at = isl.at + Vector3.new(math.cos(a) * r, 0, math.sin(a) * r)
			for _, player in ipairs(skyPlayers) do
				Push:FireClient(player, "meteor", { at = at, warn = M.warn, island = isl.name })
			end
			task.delay(M.warn, function()
				local ok, e = pcall(Npc.spawn, "meteorguard", false, at, "summon")
				if ok and e then
					local ef = e.f :: any
					ef.meteor = true
					ef.model:SetAttribute("Label", "☄ 운석 수호수")
					task.delay(M.life, function()
						if not ef.dead and ef.model.Parent then
							Npc.despawn(ef)
						end
					end)
				end
			end)
		end
	end
end)

------------------------------------------------------------------------
-- 1.7판 천상 레이드: 천공 투기장에 정해진 때마다 천겁이 내려온다
-- 그때 천상계에 있는 사람 수만큼 체력이 늘고, 체력의 1% 이상 친 사람은 친 만큼 나눠 받는다
------------------------------------------------------------------------
Raid.cur = nil :: any
local function playersInSky(): { Player }
	local out = {}
	for player in pairs(profiles) do
		local f = Combat.fighterOfPlayer(player)
		if f and f.root.Position.Y > Config.SKY.y - 300 then
			table.insert(out, player)
		end
	end
	return out
end
-- 천상계에 오를 수 있는 사람 모두에게 알린다
local function raidTell(kind: string, data: any)
	for player, p in pairs(profiles) do
		if Calc.realm(p) >= Config.SKY.realm then
			Push:FireClient(player, kind, data)
		end
	end
end
function Raid.onHit(player: Player, f: any, dmg: number)
	local c = Raid.cur
	if c and c.f == f then
		c.dmg[player] = (c.dmg[player] or 0) + dmg
	end
end
local function raidRanking(c: any): { { player: Player, dmg: number } }
	local list = {}
	for player, d in pairs(c.dmg) do
		table.insert(list, { player = player, dmg = d })
	end
	table.sort(list, function(a, b)
		return a.dmg > b.dmg
	end)
	return list
end
function Raid.spawn()
	local R = Config.RAID
	local isl = Config.SKY_BY_ID[R.island]
	if Raid.cur or not isl then
		return
	end
	local n = math.max(1, #playersInSky())
	local ok, e = pcall(Npc.spawn, R.boss, true, isl.at + Vector3.new(0, 0, 10), "summon")
	if not ok or not e then
		warn("[권왕] 레이드 보스 만들기 오류:", e)
		return
	end
	local ef = e.f :: any
	ef.raid = true
	ef.maxHp = math.floor(ef.maxHp * (1 + R.hpPer * (n - 1)))
	ef.hp = ef.maxHp
	ef.model:SetAttribute("Label", "⚔ 레이드 · " .. ef.name)
	ef.model:SetAttribute("Raid", true)
	Combat.sync(ef)
	local c = { f = ef, dmg = {}, endsAt = os.clock() + R.life, n = n }
	Raid.cur = c
	raidTell("raidAlert", { stage = "on", name = ef.name, n = n, life = R.life })
	-- 남은 시간 안에 못 쓰러뜨리면 하늘로 돌아간다
	task.delay(R.life, function()
		if Raid.cur == c and not ef.dead then
			Raid.cur = nil
			Npc.despawn(ef)
			raidTell("raidAlert", { stage = "fail", name = ef.name })
			for _, player in ipairs(playersInSky()) do
				Push:FireClient(player, "raid", nil)
			end
		end
	end)
	-- 투기장 둘레 사람에게 1초마다 형편을 알린다 (체력·남은 시간·내 기여·순위)
	task.spawn(function()
		while Raid.cur == c and not ef.dead do
			local rank = raidRanking(c)
			local top = {}
			for i = 1, math.min(3, #rank) do
				top[i] = { name = rank[i].player.DisplayName, share = rank[i].dmg / ef.maxHp }
			end
			for _, player in ipairs(playersInSky()) do
				local pf = Combat.fighterOfPlayer(player)
				if pf and Vector3.new(pf.root.Position.X - isl.at.X, 0, pf.root.Position.Z - isl.at.Z).Magnitude < isl.radius + 60 then
					local myRank = 0
					for i, r in ipairs(rank) do
						if r.player == player then
							myRank = i
						end
					end
					Push:FireClient(player, "raid", { name = ef.name, hp = ef.hp, maxHp = ef.maxHp, left = c.endsAt - os.clock(), mine = (c.dmg[player] or 0) / ef.maxHp, rank = myRank, top = top })
				else
					Push:FireClient(player, "raid", nil)
				end
			end
			task.wait(1)
		end
	end)
end
function Raid.killed(f: any)
	local c = Raid.cur
	if not c or c.f ~= f then
		return
	end
	Raid.cur = nil
	local R = Config.RAID
	local rank = raidRanking(c)
	local names = {}
	for i = 1, math.min(3, #rank) do
		table.insert(names, string.format("%d. %s %d%%", i, rank[i].player.DisplayName, math.floor(rank[i].dmg / f.maxHp * 100 + 0.5)))
	end
	raidTell("raidAlert", { stage = "win", name = f.name, top = names })
	for i, r in ipairs(rank) do
		local player = r.player
		local p, st = profiles[player], states[player]
		local share = math.clamp(r.dmg / f.maxHp, 0, 1)
		if p and st and share >= R.minShare then
			local k = 0.4 + share
			local gems = math.floor(R.gems * k)
			local coins = math.floor(R.coins * k)
			local scrolls = R.scrolls + (i == 1 and 1 or 0)
			p.skyGems += gems
			p.coins += coins
			p.scrolls += scrolls
			-- 능력치는 내 전투력의 적을 statKills 마리 쓰러뜨린 몫 × (0.3 + 기여) (보스가 아주 세도 터무니없이 커지지 않게)
			local each = math.max(1, math.floor(Config.killGain(rewardPower(player)) * R.statKills * (0.3 + share) * gainMult(p) / #Config.Stats))
			p.counts.raid = (p.counts.raid or 0) + 1
			for _, sd in ipairs(Config.Stats) do
				p.stats[sd.id] += each
			end
			st.dirty = true
			refreshFighter(player)
			Story.check(player)
			Push:FireClient(player, "raidReward", { rank = i, share = share, gems = gems, coins = coins, scrolls = scrolls, stats = each * #Config.Stats })
			pushState(player)
		end
	end
	for _, player in ipairs(playersInSky()) do
		Push:FireClient(player, "raid", nil)
	end
end
-- 때가 되면 알리고, 잠시 뒤 내려온다 (천상계에 아무도 없으면 미룬다)
task.spawn(function()
	local R = Config.RAID
	local nextAt = os.clock() + R.first
	while true do
		task.wait(1)
		if not Raid.cur and (os.clock() >= nextAt or _G.KwonRaidNow) and #playersInSky() > 0 then
			local now = _G.KwonRaidNow
			_G.KwonRaidNow = nil
			nextAt = os.clock() + R.every
			local warnFor = now and 3 or R.warn
			raidTell("raidAlert", { stage = "warn", name = (Config.Bosses[R.boss] or {}).name, warn = warnFor })
			task.wait(warnFor)
			Raid.spawn()
		end
	end
end)
-- 천궁의 투기장 문: 투기장 가장자리로 (싸우는 중에는 안 된다)
if W.raidGate then
	W.raidGate.Triggered:Connect(function(player: Player)
		local f = Combat.fighterOfPlayer(player)
		local isl = Config.SKY_BY_ID[Config.RAID.island]
		if not f or f.dead or not isl then
			return
		end
		if f.combatUntil > os.clock() then
			toast(player, "싸우는 중에는 이동할 수 없어요")
			return
		end
		Combat.dismount(f)
		local char = player.Character
		if char then
			local d = Vector3.new(Config.SKY.islands[1].at.X - isl.at.X, 0, Config.SKY.islands[1].at.Z - isl.at.Z).Unit
			local at = isl.at + d * (isl.radius * 0.6) + Vector3.new(0, 5, 0)
			char:PivotTo(CFrame.lookAt(at, Vector3.new(isl.at.X, at.Y, isl.at.Z)))
		end
		toast(player, Raid.cur and "⚔ 천공 투기장 · 천겁과 싸우는 중!" or "⚔ 천공 투기장 · 천겁이 내려오면 알려 드려요")
	end)
end

if W.inn then
	W.inn.Triggered:Connect(function(player: Player)
		local p = profiles[player]
		if not p then
			return
		end
		local f = Combat.fighterOfPlayer(player)
		if f and not f.dead then
			f.hp = f.maxHp
			f.posture = 0
			f.chi = (f :: any).chiMax or Config.CHI_MAX
			Combat.sync(f)
		end
		toast(player, "🛏 푹 쉬었다. 체력과 내공이 가득 찼다")
	end)
end
-- 비급 조각 줍기 (다섯을 모으면 무극신권)
for i, frag in ipairs(W.fragments or {}) do
	frag.Triggered:Connect(function(player: Player)
		local p = profiles[player]
		if not p or p.fragments[tostring(i)] then
			return
		end
		p.fragments[tostring(i)] = true
		local n = countKeys(p.fragments)
		Push:FireClient(player, "fragment", { n = n, total = #Config.Fragments })
		if n >= #Config.Fragments then
			grantStyle(player, "mugeuk", true)
		end
		states[player].dirty = true
		Story.event(player, "fragment")
		pushState(player)
	end)
end
for _, info in ipairs(W.train or {}) do
	info.prompt.Triggered:Connect(function(player: Player)
		Train.start(player, info)
	end)
	if info.hard then
		info.hard.Triggered:Connect(function(player: Player)
			Train.start(player, info, true)
		end)
	end
end

------------------------------------------------------------------------
-- 들어오고 나가기
------------------------------------------------------------------------
------------------------------------------------------------------------
-- 로벅스 상품 (게임패스)
------------------------------------------------------------------------
Premium = {}
local Marketplace: any = nil
pcall(function()
	Marketplace = game:GetService("MarketplaceService")
end)

function Premium.owns(player: Player, id: string): boolean
	local st = states[player]
	return st ~= nil and st.owned ~= nil and st.owned[id] == true
end

function Premium.grant(player: Player, id: string)
	local st = states[player]
	if not st then
		return
	end
	st.owned = st.owned or {}
	st.owned[id] = true
	-- 자동 수련을 처음 얻으면 바로 켠다
	local p = profiles[player]
	if p and (id == "autoTrain" or id == "autoTrain2") and p.autoOn == nil then
		p.autoOn = true
	end
	-- 청룡을 사면 바로 고른다
	if p and id == "dragon" then
		p.mountSel = "dragon"
		toast(player, "🐉 청룡을 얻었어요! V로 타기")
	end
	pushState(player)
end

-- 들어올 때 가진 게임패스를 확인한다
function Premium.load(player: Player)
	if not Marketplace then
		return
	end
	for _, it in ipairs(Config.Premium) do
		if it.gamepass > 0 then
			local ok, has = pcall(function()
				return Marketplace:UserOwnsGamePassAsync(player.UserId, it.gamepass)
			end)
			if ok and has then
				Premium.grant(player, it.id)
			end
		end
	end
end

function Premium.prompt(player: Player, id: string)
	local it = Config.PREMIUM_BY_ID[id]
	if not it then
		return
	end
	if Premium.owns(player, id) then
		toast(player, "이미 가지고 있어요")
		return
	end
	if it.gamepass <= 0 or not Marketplace then
		toast(player, "아직 판매 준비 중이에요 (게임패스 번호를 넣어야 해요)")
		return
	end
	pcall(function()
		Marketplace:PromptGamePassPurchase(player, it.gamepass)
	end)
end

if Marketplace then
	pcall(function()
		Marketplace.PromptGamePassPurchaseFinished:Connect(function(player: Player, passId: number, bought: boolean)
			if not bought then
				return
			end
			for _, it in ipairs(Config.Premium) do
				if it.gamepass == passId then
					Premium.grant(player, it.id)
					toast(player, "💎 " .. it.name .. "을(를) 얻었어요! 고마워요")
					Push:FireClient(player, "premium", { id = it.id })
				end
			end
		end)
	end)
end

-- 자동 수련: 수련 화면 안에서만. 박자가 돌아올 때마다 대신 눌러 준다 (보통 '좋음', 고급 '완벽').
-- 사람이 박자를 맞춰 누르는 것보다 빠르지 않다 (손이 편해질 뿐, 더 세지지 않는다)
task.spawn(function()
	while true do
		task.wait(0.2)
		local now = os.clock()
		for player, st in pairs(states) do
			local p = profiles[player]
			local tr = st.training
			if p and p.autoOn and tr and tr.kind ~= "simma" then
				local adv = Premium.owns(player, "autoTrain2")
				if adv or Premium.owns(player, "autoTrain") then
					local info = Config.Training[tr.kind]
					local period = (info and info.period) or Config.TRAIN_JUDGE.period
					if tr.hard then
						period = Config.HARD_TRAIN.period
					end
					if now >= ((st.autoAt or 0) :: number) then
						st.autoAt = now + period
						Train.hit(player, adv and "perfect" or "good", nil)
					end
				end
			end
		end
	end
end)

local function setupCharacter(player: Player, char: Model)
	local hum = char:WaitForChild("Humanoid", 10)
	local root = char:WaitForChild("HumanoidRootPart", 10)
	if not hum or not root or not hum:IsA("Humanoid") then
		return
	end
	hum.BreakJointsOnDeath = false
	hum.MaxHealth = 1e9
	hum.Health = 1e9
	hum.JumpPower = 55
	hum.UseJumpPower = true
	local p = profiles[player]
	if not p then
		return
	end
	local f = Combat.register(char, { player = player, name = player.DisplayName, hp = Config.maxHp(p.stats.vit), style = p.style })
	if TEST_INF[player] then
		char:SetAttribute("TestInf", true)
	end
	char:SetAttribute("PvpOff", p.pvpOff == true)
	f.iframeUntil = os.clock() + 2
	refreshFighter(player)
	char.AncestryChanged:Connect(function()
		if not char.Parent then
			Combat.unregister(char)
		end
	end)
	local st = states[player]
	if st then
		st.training = nil
	end
end

local function onPlayerAdded(player: Player)
	local st: State = { canSave = false, dirty = false, tester = false, reqWindow = 0, reqCount = 0, training = nil, trainAt = 0, ringIdx = 1, potionAt = 0 }
	states[player] = st
	local ls = Instance.new("Folder")
	ls.Name = "leaderstats"
	local realmValue = Instance.new("StringValue")
	realmValue.Name = "경지"
	realmValue.Value = "삼류"
	realmValue.Parent = ls
	local coinValue = Instance.new("StringValue")
	coinValue.Name = "은자"
	coinValue.Value = "0"
	coinValue.Parent = ls
	ls.Parent = player
	local profile, ok
	if isTester(player) then
		profile, ok = defaultProfile(), false
		st.tester = true
	else
		profile, ok = loadProfile(player)
	end
	if not player.Parent then
		return
	end
	-- 누구나 삼재권 하나는 몸에 지니고 시작한다
	if not profile.styles.samjae then
		profile.styles.samjae = true
	end
	if profile.style == "" then
		profile.style = "samjae"
	end
	profiles[player] = profile
	st.canSave = ok
	player.CharacterAdded:Connect(function(char)
		setupCharacter(player, char)
	end)
	if player.Character then
		task.spawn(setupCharacter, player, player.Character)
	end
	pushState(player)
	task.spawn(Premium.load, player)
end

local function onPlayerRemoving(player: Player)
	Tower.ended(player, "left")
	Maze.ended(player, "left")
	-- 시험 중에 나가면 시험의 상대를 거둔다 (쓰러지지 않는 사부가 남지 않게)
	pcall(Trial.ended, player, false)
	saveProfile(player)
	profiles[player] = nil
	states[player] = nil
	TEST_INF[player] = nil
end

Players.PlayerAdded:Connect(onPlayerAdded)
Players.PlayerRemoving:Connect(onPlayerRemoving)
for _, player in ipairs(Players:GetPlayers()) do
	task.spawn(onPlayerAdded, player)
end

task.spawn(function()
	while true do
		task.wait(SAVE_INTERVAL)
		for player, st in pairs(states) do
			if st.dirty then
				task.spawn(saveProfile, player)
			end
		end
	end
end)

-- 서버가 닫힐 때: 모두 저장하고, 저장이 끝날 때까지 (최대 25초) 기다린다
game:BindToClose(function()
	for player in pairs(profiles) do
		task.spawn(saveProfile, player)
	end
	local t0 = os.clock()
	task.wait(0.5)
	while saving > 0 and os.clock() - t0 < 25 do
		task.wait(0.25)
	end
end)

------------------------------------------------------------------------
-- 사부와 적 (몸 만들기는 시간이 걸릴 수 있어 맨 나중에, 따로)
------------------------------------------------------------------------
task.spawn(function()
	local ok, err = pcall(Npc.spawnMasters, function(player: Player, styleId: string)
		local p = profiles[player]
		if not p then
			return
		end
		if not p.found[styleId] then
			p.found[styleId] = true
			Story.event(player, "found")
		end
		local m = Config.MASTERS[styleId]
		local sdef = Config.STYLE_BY_ID[styleId]
		if sdef and sdef.realmReq and not p.styles[styleId] and Calc.realm(p) < sdef.realmReq then
			Push:FireClient(player, "dialog", { who = m.name, title = "「" .. m.quote .. "」", text = string.format("...아직 이르다. 네 안의 하늘이 열리지 않았다. %s에 이르거든 다시 오너라.", Config.Realms[sdef.realmReq].name) })
			return
		end
		local req = sdef and sdef.styleReq and Config.STYLE_BY_ID[sdef.styleReq]
		if req and not p.styles[styleId] and not p.styles[req.id] then
			Push:FireClient(player, "dialog", { who = m.name, title = "「" .. m.quote .. "」", text = string.format("...해와 달을 쥐려면 먼저 세상의 처음을 알아야 한다. %s을(를) 익히고 다시 오너라.", req.name) })
			return
		end
		if not p.styles[styleId] and not p.trials[styleId] then
			-- 아직 시험을 안 넘었다: 사부가 시험을 낸다
			Push:FireClient(player, "dialog", { who = m.name, title = "「" .. m.quote .. "」", text = (function()
				local kind, need = Config.trialNeed(styleId)
				local K = Config.TRIAL_KINDS[kind]
				local what = K and (K.icon .. " " .. K.title .. ": " .. string.format(K.ask, need)) or "먼저 내 분신을 꺾어라."
				return "제자가 되고 싶다면 시험을 넘어라. " .. what .. " 준비가 되면 다시 말을 걸어라. (다시 T를 누르면 시험이 시작된다)"
			end)(), trial = styleId })
			local st = states[player]
			if st and (st :: any).trialAsk == styleId then
				(st :: any).trialAsk = nil
				Trial.start(player, styleId)
			elseif st then
				(st :: any).trialAsk = styleId
			end
			return
		end
		Push:FireClient(player, "open", { page = "styles", style = styleId, master = true })
	end)
	if not ok then
		warn("[권왕] 사부 만들기 오류:", err)
	end
	ok, err = pcall(Npc.spawnElder, function(player: Player)
		Story.talk(player)
	end)
	if not ok then
		warn("[권왕] 장로 만들기 오류:", err)
	end
	ok, err = pcall(Npc.populate)
	if not ok then
		warn("[권왕] 적 만들기 오류:", err)
	end
	Npc.start()
end)

-- 사부를 찾았는가 (사부가 사는 지역에 한 번 들어가면 찾은 것, 숨은 사부는 가까이 가야)
local masterRegion: { [string]: any } = {}
for _, r in ipairs(Config.Regions) do
	if r.master then
		masterRegion[r.master] = r
	end
end
local function visited(pos: Vector3, id: string, m: any): boolean
	local r = masterRegion[id]
	if r and not m.secret and math.abs(pos.X - r.center.X) <= r.size.X / 2 and math.abs(pos.Z - r.center.Z) <= r.size.Z / 2 and pos.Y < Config.SKY.y - 200 then
		return true
	end
	return (pos - m.at).Magnitude < 50
end
task.spawn(function()
	while true do
		task.wait(1)
		for player, p in pairs(profiles) do
			local f = Combat.fighterOfPlayer(player)
			if f and not f.dead then
				for id, m in pairs(Config.MASTERS) do
					if not p.found[id] and visited(f.root.Position, id, m) then
						p.found[id] = true
						states[player].dirty = true
						Push:FireClient(player, "found", { style = id, master = m.name, region = m.region })
						Story.event(player, "found")
						pushState(player)
					end
				end
			end
		end
	end
end)
]]></string>
      </Properties>
      <Item class="ModuleScript" referent="7">
        <Properties>
          <string name="Name">Combat</string>
          <string name="Source"><![CDATA[-- 권왕: 싸움 판정 (서버). 사람과 적을 똑같이 '무인'으로 다룬다
-- 사람의 맞힘은 화면이 먼저 알려 주고(바로 반응하게), 서버가 거리·시간을 확인해 정한다
-- 적의 맞힘은 서버가 직접 정한다
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage:WaitForChild("Config"))

local Combat = {}

export type Act = {
	move: any,
	slot: any,
	seq: number,
	start: number,
	dur: number,
	speed: number,
	done: { [string]: boolean }, -- "맞힘번호:대상" 한 번씩만
	swung: { [number]: boolean },
	charge: number,
	bloom: boolean,
	enemy: boolean,
}

export type Fighter = {
	model: Model,
	root: BasePart,
	hum: Humanoid,
	player: Player?,
	npc: any?, -- 적이면 적 정보
	name: string,
	hp: number,
	maxHp: number,
	posture: number,
	postureMax: number,
	chi: number,
	style: string,
	act: Act?,
	stunUntil: number,
	brokenUntil: number,
	iframeUntil: number,
	guarding: boolean,
	guardStart: number,
	counterUntil: number,
	buffs: { [string]: number },
	lastHurtAt: number,
	lastSwingAt: number,
	cds: { [string]: number },
	stacks: { flow: number, petal: number, petalAt: number, charge: number },
	dead: boolean,
	combatUntil: number,
	dmgMult: number,
	skillMult: number,
	walk: number,
	lastAttacker: Fighter?,
	dashAt: number,
	dashUsed: number,
}

Combat.fighters = {} :: { [Model]: Fighter }
Combat.projectiles = {} :: { any }
local Push: RemoteEvent
local hooks: { [string]: any } = {}
-- 불타는 상대 (열화신권 연소)
local burning: { [any]: boolean } = {}

function Combat.init(push: RemoteEvent, h: { [string]: any })
	Push = push
	hooks = h
end

local function now(): number
	return os.clock()
end

-- 강호의 낮 (6시~18시): 일월신권이 해의 힘을 쓴다
local Lighting = game:GetService("Lighting")
local function isDay(): boolean
	local h = Lighting.ClockTime
	return h >= 6 and h < 18
end

local function flat(v: Vector3): Vector3
	local f = Vector3.new(v.X, 0, v.Z)
	if f.Magnitude < 1e-4 then
		return Vector3.new(0, 0, -1)
	end
	return f.Unit
end

function Combat.look(f: Fighter): Vector3
	return flat(f.root.CFrame.LookVector)
end

function Combat.styleOf(f: Fighter): any
	return Config.STYLE_BY_ID[f.style]
end

-- 비무대 위인지
function Combat.onRing(pos: Vector3): boolean
	local R = Config.RING
	return math.abs(pos.X - R.center.X) <= R.size / 2 and math.abs(pos.Z - R.center.Z) <= R.size / 2 and pos.Y > R.height - 1
end

-- 탈것: 타기 (탄 사람을 들어 올리고 빨라진다) / 내리기
function Combat.mount(f: Fighter, id: string)
	local m = Config.MOUNT_BY_ID[id]
	if not m or not f.hum then
		return
	end
	local fa = f :: any
	if not fa.mountMult then
		fa.baseHip = f.hum.HipHeight
	end
	fa.mountMult = m.speed
	f.hum.HipHeight = (fa.baseHip or f.hum.HipHeight) + (Config.MOUNT_HIP[m.kind] or 2)
	f.model:SetAttribute("Mount", id)
end
function Combat.dismount(f: Fighter)
	local fa = f :: any
	if not fa.mountMult then
		return
	end
	fa.mountMult = nil
	if f.hum and fa.baseHip then
		f.hum.HipHeight = fa.baseHip
	end
	f.model:SetAttribute("Mount", nil)
end

-- 서로 때릴 수 있는 사이인지
function Combat.hostile(a: Fighter, b: Fighter): boolean
	if a == b or a.dead or b.dead then
		return false
	end
	if a.player and b.player then
		local pa, pb = a.root.Position, b.root.Position
		if Combat.onRing(pa) and Combat.onRing(pb) then
			return true
		end
		-- 들판 PvP: 안전한 곳 밖에서는 사람끼리도 싸운다 (PvP를 끈 사람은 빼고)
		if Config.inSafe(pa) or Config.inSafe(pb) then
			return false
		end
		return a.model:GetAttribute("PvpOff") ~= true and b.model:GetAttribute("PvpOff") ~= true
	end
	if not a.player and not b.player then
		return false
	end
	return true
end

function Combat.register(model: Model, info: any): Fighter
	local root = model:FindFirstChild("HumanoidRootPart") :: BasePart
	local hum = model:FindFirstChildOfClass("Humanoid") :: Humanoid
	local f: Fighter = {
		model = model,
		root = root,
		hum = hum,
		player = info.player,
		npc = info.npc,
		name = info.name or model.Name,
		hp = info.hp,
		maxHp = info.hp,
		posture = 0,
		postureMax = info.postureMax or Config.POSTURE_MAX,
		chi = 0,
		style = info.style or "",
		act = nil,
		stunUntil = 0,
		brokenUntil = 0,
		iframeUntil = 0,
		guarding = false,
		guardStart = 0,
		counterUntil = 0,
		buffs = {},
		lastHurtAt = 0,
		lastSwingAt = -10,
		cds = {},
		stacks = { flow = 0, petal = 0, petalAt = 0, charge = 0 },
		dead = false,
		combatUntil = 0,
		dmgMult = info.dmgMult or 1,
		skillMult = info.skillMult or 1,
		walk = info.walk or Config.WALK_SPEED,
		lastAttacker = nil,
		dashAt = 0,
		dashUsed = 0,
	}
	Combat.fighters[model] = f
	Combat.sync(f)
	return f
end

function Combat.unregister(model: Model)
	Combat.fighters[model] = nil
end

-- 화면이 읽는 값 (모델 속성)
function Combat.sync(f: Fighter)
	local m = f.model
	m:SetAttribute("Hp", math.max(0, math.floor(f.hp + 0.5)))
	m:SetAttribute("MaxHp", f.maxHp)
	m:SetAttribute("Posture", math.floor(f.posture + 0.5))
	m:SetAttribute("PostureMax", f.postureMax)
	m:SetAttribute("Chi", math.floor(f.chi))
	m:SetAttribute("Style", f.style)
	m:SetAttribute("Guard", f.guarding)
	m:SetAttribute("Flow", f.stacks.flow)
	m:SetAttribute("Petal", f.stacks.petal)
	m:SetAttribute("Charge", f.stacks.charge)
	m:SetAttribute("Dead", f.dead)
end

function Combat.stunned(f: Fighter): boolean
	return now() < f.stunUntil or f.dead
end

-- 지금 무엇에도 밀리지 않는지 (기술의 armor, 철포삼, 금강체)
local function armored(f: Fighter): boolean
	local t = now()
	if (f.buffs.ironshirt or 0) > t or (f.buffs.giant or 0) > t then
		return true
	end
	local act = f.act
	if act and t < act.start + act.dur then
		if act.move.armor then
			return true
		end
		local style = Combat.styleOf(f)
		if style and style.armorWhileAttacking and not act.enemy then
			return true
		end
	end
	return false
end

-- 받는 피해 배율
local function defense(f: Fighter): number
	local t = now()
	local m = 1
	if (f.buffs.ironshirt or 0) > t then
		m *= 0.5
	end
	if (f.buffs.giant or 0) > t then
		m *= 0.5
	end
	local style = Combat.styleOf(f)
	local act = f.act
	if style and style.armorWhileAttacking and act and t < act.start + act.dur then
		m *= style.armorWhileAttacking
	end
	-- 진 금강불괴: 늘 덜 아프다
	if style and style.hurtTaken then
		m *= style.hurtTaken
	end
	-- 심법: 금강호체공
	m *= 1 - ((f :: any).mDef or 0)
	return m
end

local function interrupt(f: Fighter)
	if f.act then
		f.act = nil
		Push:FireAllClients("interrupt", f.model)
	end
end

-- 안전 지대 (마을, 사부의 자리)
local function inSafe(pos: Vector3): boolean
	return Config.inSafe(pos)
end

local function knock(f: Fighter, vel: Vector3, stun: number)
	if f.player then
		Push:FireClient(f.player, "knock", vel, stun)
	elseif f.root and f.root.Parent and not f.root.Anchored then
		f.root.AssemblyLinearVelocity = vel
	end
end

-- 흘리기: 친 쪽은 헛힘에 앞으로 지나쳐 옆으로 흘러가고, 흘린 쪽은 반대로 살짝 비켜선다
local function redirect(tgt: Fighter, att: Fighter): number
	local right = tgt.root.CFrame.RightVector
	local rel = att.root.Position - tgt.root.Position
	local side = right:Dot(rel) >= 0 and 1 or -1
	local attLook = att.root.CFrame.LookVector
	knock(att, Vector3.new(attLook.X, 0, attLook.Z) * 18 + Vector3.new(right.X, 0, right.Z) * side * 16, 0)
	knock(tgt, -Vector3.new(right.X, 0, right.Z) * side * 7, 0)
	return side
end

function Combat.stun(f: Fighter, dur: number)
	f.stunUntil = math.max(f.stunUntil, now() + dur)
	interrupt(f)
	f.guarding = false
end

local function addChi(f: Fighter, amount: number)
	if f.player then
		f.chi = math.clamp(f.chi + amount, 0, (f :: any).chiMax or Config.CHI_MAX)
	end
end

local function addPosture(f: Fighter, amount: number): boolean
	-- 사람은 균형이 쉽게 무너지지 않는다 (사자후 같은 막기 깨기는 그대로)
	if f.player and amount < f.postureMax then
		amount *= Config.PLAYER_POSTURE_TAKEN
	end
	f.posture += amount
	f.lastHurtAt = now()
	if f.posture >= f.postureMax then
		-- 파훼
		f.posture = f.postureMax
		f.brokenUntil = now() + Config.BREAK_STUN
		Combat.stun(f, Config.BREAK_STUN)
		Push:FireAllClients("broken", f.model, Config.BREAK_STUN)
		return true
	end
	return false
end

-- 막기를 깨부순다 (사자후): 균형을 가득 채워 파훼
function Combat.breakGuard(f: Fighter)
	if f.dead then
		return
	end
	f.guarding = false
	addPosture(f, f.postureMax)
end

function Combat.kill(f: Fighter, by: Fighter?)
	if f.dead then
		return
	end
	-- 수련 목인은 쓰러지지 않는다 (다시 가득 찬다)
	-- 시험의 사부 (흘리기·버티기)도 쓰러지지 않는다
	if f.npc and ((f.npc :: any).dummy or (f :: any).trialImmortal) then
		f.hp = f.maxHp
		Combat.sync(f)
		return
	end
	Combat.dismount(f)
	f.dead = true
	f.hp = 0
	f.act = nil
	f.guarding = false
	Combat.sync(f)
	Push:FireAllClients("ko", f.model, by and by.model or nil)
	-- 무쌍신권: 쓰러뜨릴 때마다 숨이 돌아온다
	local bStyle = by and Combat.styleOf(by)
	if by and bStyle and bStyle.killHeal and by.player and not by.dead then
		by.hp = math.min(by.maxHp, by.hp + by.maxHp * bStyle.killHeal)
		by.chi = math.min((by :: any).chiMax or Config.CHI_MAX, by.chi + 20)
		Combat.sync(by)
	end
	-- 2.0판 진 열화 업화: 불타던 적이 쓰러지면 그 자리에서 터져 둘레를 태운다
	local fb = f :: any
	local burner = fb.burnBy
	if burner and (fb.burnUntil or 0) > now() and not burner.dead then
		local bs = Combat.styleOf(burner)
		local bb = bs and bs.burnBurst
		if bb then
			local at = f.root.Position
			Push:FireAllClients("skillfx", { kind = "ignite", at = at, radius = bb.radius, style = burner.style })
			task.defer(function()
				for _, other in pairs(Combat.fighters) do
					if other ~= f and Combat.hostile(burner, other) and not other.dead and (other.root.Position - at).Magnitude <= bb.radius then
						Combat.applyHit(burner, other, { dmg = bb.dmg, posture = bb.posture, stun = 0.5, kb = 26, up = 10 }, { chain = true, isSkill = true, move = { name = "업화 폭렬" } })
					end
				end
			end)
		end
	end
	if hooks.onKill then
		hooks.onKill(f, by)
	end
end

-- 피해 숫자 (공격자 쪽 배율)
local function damageOf(att: Fighter, hit: any, move: any, isSkill: boolean, act: Act?): number
	local d = hit.dmg * att.dmgMult
	-- 금강 법신: 거인이 된 동안 모든 주먹이 1.6배
	if (att.buffs.giant or 0) > now() then
		d *= 1.6
	end
	if isSkill then
		d *= att.skillMult
	end
	-- 1.9판 초·혈마 피의 계약: 체력이 깎일수록 더 깊이 벤다
	local pact = Combat.styleOf(att)
	if pact and pact.bloodPact and att.maxHp > 0 then
		d *= 1 + pact.bloodPact * (1 - math.clamp(att.hp / att.maxHp, 0, 1))
	end
	if act and act.charge > 0 and move.chargeMult then
		local style = Combat.styleOf(att)
		local k = math.clamp(act.charge / (style and style.charge or 1.5), 0, 1)
		d *= 1 + (move.chargeMult - 1) * k
	end
	return d
end

-- 1.9판 진 금강불괴: 맞은 횟수가 쌓이면 몸에서 진동이 터져 둘레를 날린다
local function hurtPulse(tgt: Fighter, style: any)
	local hp = style and style.hurtPulse
	if not hp or tgt.dead then
		return
	end
	local ft = tgt :: any
	ft.hurtN = (ft.hurtN or 0) + 1
	tgt.model:SetAttribute("HurtN", ft.hurtN)
	if ft.hurtN < hp.every then
		return
	end
	ft.hurtN = 0
	tgt.model:SetAttribute("HurtN", 0)
	local at = tgt.root.Position
	Push:FireAllClients("skillfx", { kind = "vajraQuake", m = tgt.model, at = at, radius = hp.radius, style = tgt.style })
	task.defer(function()
		for _, other in pairs(Combat.fighters) do
			if Combat.hostile(tgt, other) and not other.dead and (other.root.Position - at).Magnitude <= hp.radius then
				Combat.applyHit(tgt, other, { dmg = hp.dmg, posture = hp.posture, stun = hp.stun, kb = hp.kb, up = hp.up }, { chain = true, isSkill = true, move = { name = hp.name } })
			end
		end
	end)
end

------------------------------------------------------------------------
-- 한 번 맞히기. kind를 돌려준다: hit / block / deflect / guardbreak / clash / dodge / counter / miss
-- opt = { move, act, isSkill, unblockable, slotKey, chain }
------------------------------------------------------------------------
function Combat.applyHit(att: Fighter, tgt: Fighter, hit: any, opt: any): string
	if not Combat.hostile(att, tgt) then
		return "miss"
	end
	local t = now()
	if t < tgt.iframeUntil then
		-- 見切り: 맞기 직전에 대시로 피했다 → 상대가 잠깐 굳고, 곧바로 클릭하면 반격
		local fa = tgt :: any
		if tgt.player and t - tgt.dashAt < 0.4 and t - (fa.pdodgeAt or 0) > 0.6 then
			fa.pdodgeAt = t
			fa.deflectAt = t
			att.stunUntil = math.max(att.stunUntil, t + 0.45)
			interrupt(att)
			Push:FireAllClients("pdodge", { m = tgt.model, a = att.model })
		else
			Push:FireAllClients("hit", { a = att.model, t = tgt.model, kind = "dodge", pos = tgt.root.Position })
		end
		return "dodge"
	end
	local move = opt.move or {}
	local toAtt = flat(att.root.Position - tgt.root.Position)
	local facing = Combat.look(tgt):Dot(toAtt)
	local pos = tgt.root.Position:Lerp(att.root.Position, 0.35) + Vector3.new(0, 1, 0)
	att.combatUntil = t + Config.COMBAT_TAG
	tgt.combatUntil = t + Config.COMBAT_TAG
	tgt.lastAttacker = att

	-- 전투력 차이: 훨씬 약한 적의 공격은 덜 아프거나, 끄떡없거나, 호신강기에 튕겨 나간다 (붉은 공격도)
	local gapMul, steady = 1, false
	if att.npc and tgt.player then
		local pa, pt = (att :: any).power or 100, (tgt :: any).power or 100
		local immune
		gapMul, steady, immune = Config.powerGap(pt / math.max(1, pa))
		if immune then
			att.stunUntil = math.max(att.stunUntil, t + 0.45)
			interrupt(att)
			knock(att, toAtt * 22 + Vector3.new(0, 8, 0), 0.45)
			Push:FireAllClients("hit", { a = att.model, t = tgt.model, kind = "aura", pos = pos })
			return "immune"
		end
	end

	-- 격돌: 상대도 같은 순간 나를 향해 휘둘렀다
	if not opt.chain and not opt.proj and math.abs(tgt.lastSwingAt - t) <= Config.CLASH_WINDOW and facing > 0.5 and tgt.act and not move.aoe then
		-- 둘 다 서로 반대쪽으로 튕겨 난다
		knock(att, toAtt * 18 + Vector3.new(0, 6, 0), 0.3)
		knock(tgt, -toAtt * 18 + Vector3.new(0, 6, 0), 0.3)
		addPosture(att, 10)
		addPosture(tgt, 10)
		interrupt(att)
		interrupt(tgt)
		att.stunUntil = math.max(att.stunUntil, t + 0.3)
		tgt.stunUntil = math.max(tgt.stunUntil, t + 0.3)
		Push:FireAllClients("hit", { a = att.model, t = tgt.model, kind = "clash", pos = pos })
		return "clash"
	end

	-- 만류귀종: 잠깐 모든 공격을 저절로 흘려 되받아친다 (막을 수 없는 공격도)
	local ta = tgt :: any
	if t < (ta.reflectUntil or 0) and not opt.chain then
		att.stunUntil = math.max(att.stunUntil, t + 0.6)
		interrupt(att)
		local side = redirect(tgt, att)
		Push:FireAllClients("hit", { a = att.model, t = tgt.model, kind = "deflect", pos = pos, counter = true, side = side })
		local rh = ta.reflectHit
		if rh then
			task.defer(function()
				if not tgt.dead and not att.dead then
					Combat.applyHit(tgt, att, rh, { move = { name = "되흘림" }, isSkill = true, chain = true })
				end
			end)
		end
		return "counter"
	end

	local tStyle = Combat.styleOf(tgt)
	-- 취권: 비틀거려 저절로 피한다
	if tStyle and tStyle.dodgeChance and not opt.unblockable then
		local chance = 0
		if (tgt.buffs.sway or 0) > t then
			chance = 0.6
		elseif tgt.act or tgt.root.AssemblyLinearVelocity.Magnitude > 4 then
			chance = tStyle.dodgeChance
		end
		if chance > 0 and math.random() < chance then
			Push:FireAllClients("hit", { a = att.model, t = tgt.model, kind = "dodge", pos = pos, drunk = true })
			if (tgt.buffs.sway or 0) > t then
				-- 취보 중엔 피하면서 되받아친다
				task.defer(function()
					Combat.applyHit(tgt, att, { dmg = 6, posture = 10, stun = 0.4, kb = 10 }, { chain = true })
				end)
			end
			return "dodge"
		end
	end

	-- 태허 유수회선: 받아넘기고 되받아친다
	if t < tgt.counterUntil and not opt.unblockable and facing > -0.2 then
		tgt.counterUntil = 0
		addPosture(att, (hit.posture or 10) * Config.DEFLECT_POSTURE)
		att.stunUntil = math.max(att.stunUntil, t + Config.DEFLECT_STAGGER)
		interrupt(att)
		tgt.stacks.flow = math.min(3, tgt.stacks.flow + 1)
		local side = redirect(tgt, att)
		Push:FireAllClients("hit", { a = att.model, t = tgt.model, kind = "deflect", pos = pos, counter = true, side = side })
		;(tgt :: any).deflectAt = now()
		local style = Combat.styleOf(tgt)
		local ch = style and style.skills.E.counterHit
		if ch then
			Push:FireAllClients("act", { m = tgt.model, style = tgt.style, pose = ch.pose, dur = 0.5, seq = -1 })
			task.delay(0.12, function()
				if not tgt.dead and not att.dead then
					Combat.applyHit(tgt, att, ch.hit, { move = { name = "되받아치기" }, isSkill = true, chain = true })
				end
			end)
		end
		Combat.sync(tgt)
		return "counter"
	end

	local postureDmg = (hit.posture or 0)
	local aStyle0 = Combat.styleOf(att)
	if aStyle0 and aStyle0.postureMult then
		postureDmg *= aStyle0.postureMult
	end
	-- 막기·흘리기 (앞에서 온 것만, 막을 수 없는 공격은 안 된다)
	if tgt.guarding and facing > 0.2 and not opt.unblockable and not opt.chain then
		local window = (tStyle and tStyle.deflect or Config.DEFLECT_WINDOW) * ((tgt :: any).deflectMul or 1) + 0.06 -- 0.06 = 통신 늦음 여유
		if t - tgt.guardStart <= window then
			-- 흘리기 성공
			local broke = addPosture(att, postureDmg * Config.DEFLECT_POSTURE + 6)
			if not broke then
				att.stunUntil = math.max(att.stunUntil, t + Config.DEFLECT_STAGGER)
				interrupt(att)
			end
			tgt.posture = math.max(0, tgt.posture - 6)
			addChi(tgt, Config.CHI_ON_DEFLECT)
			if tStyle and tStyle.id == "taeheo" then
				tgt.stacks.flow = math.min(3, tgt.stacks.flow + 1)
			end
			Combat.sync(tgt)
			Combat.sync(att)
			local side = redirect(tgt, att)
			Push:FireAllClients("hit", { a = att.model, t = tgt.model, kind = "deflect", pos = pos, side = side })
			;(tgt :: any).deflectAt = now()
			-- 1.9판 진 태허: 흘려 낸 힘이 물결이 되어 둘레로 터진다
			local dw = tStyle and tStyle.deflectWave
			if dw and t - ((tgt :: any).waveAt or 0) > 0.35 then
				(tgt :: any).waveAt = t
				local at = tgt.root.Position
				Push:FireAllClients("skillfx", { kind = "flowWave", m = tgt.model, at = at, radius = dw.radius, style = tgt.style })
				task.defer(function()
					for _, other in pairs(Combat.fighters) do
						if Combat.hostile(tgt, other) and not other.dead and (other.root.Position - at).Magnitude <= dw.radius then
							Combat.applyHit(tgt, other, { dmg = dw.dmg, posture = dw.posture, stun = dw.stun, kb = dw.kb, up = dw.up }, { chain = true, isSkill = true, move = { name = "역류" } })
						end
					end
				end)
			end
			if hooks.onDeflect then
				hooks.onDeflect(tgt, att)
			end
			return "deflect"
		end
		-- 그냥 막기 (만취한 권법은 막지 못하고 그대로 맞는다)
	end
	if tgt.guarding and facing > 0.2 and not opt.unblockable and not opt.chain and not (tStyle and tStyle.noBlock) then
		local d = damageOf(att, hit, move, opt.isSkill, opt.act) * Config.BLOCK_DAMAGE * (tStyle and tStyle.weakBlock or 1) * defense(tgt) * gapMul
		tgt.hp -= d
		local broke = (not steady) and addPosture(tgt, postureDmg * Config.BLOCK_POSTURE)
		if not steady then
			knock(tgt, -toAtt * math.min(20, (hit.kb or 0) * 0.4 + 4), 0)
		end
		addChi(tgt, d * Config.CHI_ON_HURT)
		Combat.sync(tgt)
		Push:FireAllClients("hit", { a = att.model, t = tgt.model, kind = broke and "guardbreak" or "block", pos = pos, dmg = d })
		if tgt.hp <= 0 then
			Combat.kill(tgt, att)
		else
			hurtPulse(tgt, tStyle)
		end
		return broke and "guardbreak" or "block"
	end

	-- 맞았다
	local d = damageOf(att, hit, move, opt.isSkill, opt.act) * defense(tgt) * gapMul
	local crit = false
	local aStyle = Combat.styleOf(att)
	if aStyle and aStyle.backstab and facing < -0.3 then
		d *= aStyle.backstab
		crit = true
	end
	-- 일월: 낮에는 해의 주먹 (주는 피해 증가), 밤에는 달의 몸 (받는 피해 감소)
	if aStyle and aStyle.sunMoon and isDay() then
		d *= aStyle.sunMoon.day
	end
	if tStyle and tStyle.sunMoon and not isDay() then
		d *= tStyle.sunMoon.night
	end
	-- 무쌍신권: 사람을 상대로 더 세다
	if aStyle and aStyle.pvpDmg and tgt.player and att.player then
		d *= aStyle.pvpDmg
	end
	if opt.teleport then
		crit = true
	end
	-- 카운터: 적이 휘두르려고 멈칫한 사이에 먼저 꽂으면 1.5배, 그 공격이 끊긴다
	local counterHit = false
	if tgt.npc and tgt.act and tgt.act.move and t < tgt.act.start + (tgt.act.move.windup or 0) then
		d *= 1.5
		crit = true
		counterHit = true
		interrupt(tgt)
	end
	local wasBroken = t < tgt.brokenUntil
	if wasBroken then
		d *= Config.BROKEN_MULT
		tgt.brokenUntil = 0
		tgt.posture = 0
		crit = true
	end
	tgt.hp -= d
	if tgt.player then
		Combat.dismount(tgt)
	end
	-- 흡혈 (혈마신수)
	-- 한 대에도, 1초에도 되찾는 양에 한도가 있다
	local function steal(amount: number, secCap: number)
		local a = att :: any
		if t - (a.stealAt or 0) >= 1 then
			a.stealAt = t
			a.stealSum = 0
		end
		local room = math.max(0, att.maxHp * secCap - (a.stealSum or 0))
		local heal = math.min(amount, att.maxHp * Config.LIFESTEAL_HIT_CAP, room)
		a.stealSum = (a.stealSum or 0) + heal
		att.hp = math.min(att.maxHp, att.hp + heal)
	end
	if aStyle and aStyle.lifesteal and att.player and not att.dead then
		steal(d * aStyle.lifesteal * ((att.buffs.frenzy or 0) > t and Config.LIFESTEAL_FRENZY or 1), aStyle.id == "hyeolma2" and 0.05 or Config.LIFESTEAL_SEC_CAP)
		att.model:SetAttribute("Hp", math.floor(att.hp + 0.5))
	end
	-- 심법: 혈기공 (모든 권법에서 조금씩)
	local mSteal = (att :: any).mSteal or 0
	if mSteal > 0 and att.player and not att.dead then
		steal(d * mSteal, Config.LIFESTEAL_SEC_CAP)
		att.model:SetAttribute("Hp", math.floor(att.hp + 0.5))
	end
	if not steady then
		addPosture(tgt, postureDmg * 0.4)
	end
	local heavy = not steady and ((hit.kb or 0) >= 20 or (hit.stun or 0) >= 0.6 or wasBroken)
	if not armored(tgt) and not steady then
		local stun = hit.stun or 0.3
		local fa = tgt :: any
		if tgt.npc then
			-- 적은 경직이 짧고, 2.5초 안에 너무 오래 묶이면 잠깐 버티며 곧바로 되받아친다 (무한 경직 방지)
			stun *= 0.6
			if t - (fa.poiseAt or 0) > 2.5 then
				fa.poiseAt = t
				fa.poiseSum = 0
			end
			fa.poiseSum = (fa.poiseSum or 0) + stun
			if fa.poiseSum > 1.2 and t >= (fa.poiseUntil or 0) then
				fa.poiseSum = 0
				fa.poiseUntil = t + 1.5
				fa.retaliate = true
				tgt.model:SetAttribute("Poise", true)
				Push:FireAllClients("poise", tgt.model)
				task.delay(1.5, function()
					if tgt.model.Parent then
						tgt.model:SetAttribute("Poise", nil)
					end
				end)
			end
			if t < (fa.poiseUntil or 0) and not heavy and not wasBroken then
				stun = 0
			end
		end
		if stun > 0 then
			if (hit.up or 0) >= 25 then
				tgt.model:SetAttribute("LaunchedAt", t)
			end
			Combat.stun(tgt, stun)
			local dir = flat(tgt.root.Position - att.root.Position)
			local kb = (hit.kb or 0) * (wasBroken and 1.5 or 1) * (aStyle and aStyle.kbMult or 1)
			knock(tgt, dir * kb + Vector3.new(0, (hit.up or 0) + (kb > 25 and 12 or 0), 0), stun)
		end
	end
	addChi(att, d * Config.CHI_ON_HIT)
	addChi(tgt, d * Config.CHI_ON_HURT)

	-- 공격한 쪽 권법 장치: 꽃잎, 전하
	local chain = false
	local star = false
	local pulse: any = nil
	if aStyle and not opt.chain then
		if aStyle.starEvery then
			-- 개천: 다섯 번 맞힐 때마다 별이 떨어진다
			local fa = att :: any
			fa.starN = (fa.starN or 0) + 1
			if fa.starN >= aStyle.starEvery then
				fa.starN = 0
				star = true
			end
		end
		if aStyle.pulse then
			-- 파천 중압·태초 창세: 정해진 수만큼 맞히면 상대 자리에서 터진다
			local fa = att :: any
			fa.pulseN = (fa.pulseN or 0) + 1
			if fa.pulseN >= aStyle.pulse.every then
				fa.pulseN = 0
				pulse = aStyle.pulse
			end
			att.model:SetAttribute("Pulse", fa.pulseN)
		end
		if aStyle.id == "maehwa" or aStyle.petals then
			att.stacks.petal = math.min(aStyle.petalMax or 20, att.stacks.petal + 1)
			att.stacks.petalAt = t
		elseif aStyle.chargeEvery then
			att.stacks.charge += 1
			if att.stacks.charge >= aStyle.chargeEvery then
				att.stacks.charge = 0
				chain = true
			end
		end
	end
	Combat.sync(att)
	Combat.sync(tgt)
	Push:FireAllClients("hit", {
		a = att.model,
		t = tgt.model,
		kind = "hit",
		pos = pos,
		dmg = d,
		heavy = heavy,
		crit = crit,
		style = att.style,
		skill = opt.isSkill == true,
		strike = move.strike == true,
		pose = move.pose,
		broken = wasBroken,
		counter = counterHit,
		steady = steady,
	})
	if hooks.onHit then
		hooks.onHit(att, tgt, d, opt)
	end
	-- 열화 연소: 맞은 적에게 불이 붙는다 (계속 타며 피해)
	if aStyle and aStyle.burn and not opt.chain and tgt.hp > 0 then
		local b = aStyle.burn
		local fb = tgt :: any
		fb.burnUntil = t + b.dur
		fb.burnBy = att
		fb.burnDmg = b.dmg
		fb.burnEvery = b.every
		fb.burnNext = fb.burnNext and math.min(fb.burnNext, t + b.every) or t + b.every
		if not burning[tgt] then
			burning[tgt] = true
			tgt.model:SetAttribute("Burning", true)
		end
	end
	-- 폭염: 불타는 적에게 강타를 꽂으면 터져 둘레까지 태운다
	if move.ignite and not opt.chain and ((tgt :: any).burnUntil or 0) > t then
		local at = tgt.root.Position
		local ig = move.ignite
		Push:FireAllClients("skillfx", { kind = "ignite", at = at, radius = ig.radius, style = att.style })
		for _, other in pairs(Combat.fighters) do
			if Combat.hostile(att, other) and not other.dead and (other.root.Position - at).Magnitude <= ig.radius then
				Combat.applyHit(att, other, { dmg = ig.dmg, posture = ig.posture or 20, stun = 0.6, kb = 30, up = 10 }, { chain = true, isSkill = true, move = { name = "폭염" } })
			end
		end
	end
	if tgt.hp <= 0 then
		Combat.kill(tgt, att)
	else
		hurtPulse(tgt, tStyle)
	end
	-- 1.9판 진 무영: 그림자가 한 박자 뒤 같은 자리를 한 번 더 찬다 (연타·강타만)
	if aStyle and aStyle.shadowEcho and not opt.chain and not opt.isSkill and not opt.proj and not tgt.dead then
		local k = aStyle.shadowEcho
		task.delay(0.16, function()
			if att.dead or tgt.dead or not tgt.root.Parent then
				return
			end
			Push:FireAllClients("skillfx", { kind = "shadowEcho", a = att.model, t = tgt.model, pose = move.pose, style = att.style })
			Combat.applyHit(att, tgt, { dmg = (hit.dmg or 0) * k, posture = (hit.posture or 0) * k, stun = 0.2, kb = (hit.kb or 0) * 0.5, up = hit.up }, { chain = true, move = { name = "영각" } })
		end)
	end
	-- 벽력: 연쇄 번개
	if chain then
		local victims = {}
		for _, other in pairs(Combat.fighters) do
			if other ~= tgt and Combat.hostile(att, other) and (other.root.Position - tgt.root.Position).Magnitude <= (aStyle and aStyle.chainRange or 16) then
				table.insert(victims, other)
			end
		end
		Push:FireAllClients("chain", { from = tgt.model, to = (function()
			local list = {}
			for _, v in ipairs(victims) do
				table.insert(list, v.model)
			end
			return list
		end)() })
		for _, v in ipairs(victims) do
			Combat.applyHit(att, v, { dmg = aStyle and aStyle.chainDmg or 9, posture = 12, stun = 1.0, kb = 4 }, { chain = true, move = { strike = true } })
		end
		if not tgt.dead then
			Combat.stun(tgt, 1.0)
		end
	end
	-- 금강 법신: 거인의 주먹은 맞은 자리 둘레까지 울린다
	if (att.buffs.giant or 0) > t and not opt.chain then
		local at = tgt.root.Position
		Push:FireAllClients("skillfx", { kind = "aftershock", at = at, style = att.style })
		for _, other in pairs(Combat.fighters) do
			if other ~= tgt and Combat.hostile(att, other) and not other.dead and (other.root.Position - at).Magnitude <= 9 then
				Combat.applyHit(att, other, { dmg = (hit.dmg or 0) * 0.5, posture = (hit.posture or 0) * 0.5, stun = 0.4, kb = 20 }, { chain = true, isSkill = true, move = { name = "여진" } })
			end
		end
	end
	if pulse then
		local at = tgt.root.Position
		Push:FireAllClients("skillfx", { kind = "pulse", fx = pulse.kind, at = at, radius = pulse.radius, delay = pulse.delay, style = att.style })
		task.delay(pulse.delay, function()
			if att.dead then
				return
			end
			for _, other in pairs(Combat.fighters) do
				if Combat.hostile(att, other) and not other.dead and (other.root.Position - at).Magnitude <= pulse.radius then
					if pulse.pull and not other.player and not other.root.Anchored then
						local d = at - other.root.Position
						other.root.AssemblyLinearVelocity = Vector3.new(d.X, 0, d.Z) * (pulse.pull / math.max(4, d.Magnitude)) + Vector3.new(0, -20, 0)
					end
					Combat.applyHit(att, other, { dmg = pulse.dmg, posture = pulse.posture, stun = pulse.stun, kb = pulse.kb, up = pulse.up }, { chain = true, isSkill = true, move = { name = pulse.name } })
				end
			end
		end)
	end
	if star then
		local at = tgt.root.Position
		Push:FireAllClients("star", { at = at, style = att.style })
		task.delay(0.35, function()
			if att.dead then
				return
			end
			for _, other in pairs(Combat.fighters) do
				if Combat.hostile(att, other) and not other.dead and (other.root.Position - at).Magnitude <= 14 then
					Combat.applyHit(att, other, { dmg = 22, posture = 25, stun = 0.6, kb = 18, up = 8 }, { chain = true, isSkill = true, move = { name = "낙성" } })
				end
			end
		end)
	end
	return "hit"
end

------------------------------------------------------------------------
-- 기술 시작 (사람과 적 공통). 화면들에게 동작을 알린다
------------------------------------------------------------------------
function Combat.begin(f: Fighter, move: any, slot: any, seq: number, opt: any?): Act
	local o = opt or {}
	local speed = o.speed or 1
	local act: Act = {
		move = move,
		slot = slot,
		seq = seq,
		start = now(),
		dur = move.dur / speed,
		speed = speed,
		done = {},
		swung = {},
		charge = o.charge or 0,
		bloom = o.bloom == true,
		enemy = o.enemy == true,
	}
	f.act = act
	f.guarding = false
	if move.iframes then
		f.iframeUntil = math.max(f.iframeUntil, now() + move.iframes)
	end
	Push:FireAllClients("act", {
		m = f.model,
		style = f.style,
		slot = slot,
		pose = move.pose,
		dur = act.dur,
		align = o.align,
		seq = seq,
		id = move.id,
		charge = act.charge,
		bloom = act.bloom,
		unblockable = move.unblockable,
		windup = move.windup and move.windup / speed or nil,
	})
	return act
end

-- 기술이 끝났는지
function Combat.busy(f: Fighter): boolean
	local act = f.act
	return act ~= nil and now() < act.start + act.dur
end

-- 앞쪽 상자 안의 상대들 (서버 판정용)
function Combat.query(att: Fighter, hit: any, from: Vector3?): { Fighter }
	local origin = from or att.root.Position
	local look = Combat.look(att)
	local center = hit.aoe and origin or origin + look * (hit.range * 0.55)
	local list = {}
	for _, f in pairs(Combat.fighters) do
		if Combat.hostile(att, f) then
			local dist = Vector3.new(f.root.Position.X - center.X, 0, f.root.Position.Z - center.Z).Magnitude
			local reach = hit.aoe and hit.radius or (hit.range * 0.55 + hit.radius)
			if dist <= reach + 1.5 and math.abs(f.root.Position.Y - origin.Y) < 9 then
				table.insert(list, f)
			end
		end
	end
	return list
end

-- 화면이 알려 준 맞힘이 믿을 만한지 (거리)
function Combat.plausible(att: Fighter, tgt: Fighter, hit: any): boolean
	local d = Vector3.new(tgt.root.Position.X - att.root.Position.X, 0, tgt.root.Position.Z - att.root.Position.Z).Magnitude
	local reach = hit.aoe and hit.radius or (hit.range + hit.radius)
	return d <= reach + Config.HIT_TOLERANCE + 3 and math.abs(tgt.root.Position.Y - att.root.Position.Y) < 14
end

------------------------------------------------------------------------
-- 장풍
------------------------------------------------------------------------
function Combat.fire(owner: Fighter, proj: any, scale: number, opt: any)
	local look = Combat.look(owner)
	local pos = owner.root.Position + look * 2.5 + Vector3.new(0, 0.8, 0)
	local p = {
		owner = owner,
		pos = pos,
		dir = look,
		speed = proj.speed,
		life = proj.life,
		radius = proj.radius * scale,
		hit = { dmg = proj.dmg * scale, posture = proj.posture * scale, stun = proj.stun, kb = proj.kb * math.sqrt(scale), range = 0, radius = proj.radius * scale },
		pierce = proj.pierce == true,
		hitSet = {},
		opt = opt,
	}
	table.insert(Combat.projectiles, p)
	Push:FireAllClients("proj", { m = owner.model, pos = pos, dir = look, speed = proj.speed, life = proj.life, size = (proj.size or 3) * scale, style = owner.style })
end

function Combat.stepProjectiles(dt: number)
	for i = #Combat.projectiles, 1, -1 do
		local p = Combat.projectiles[i]
		p.life -= dt
		local step = p.dir * p.speed * dt
		local from = p.pos
		p.pos += step
		local stop = p.life <= 0 or p.owner.dead
		if not stop then
			for _, f in pairs(Combat.fighters) do
				if not p.hitSet[f] and Combat.hostile(p.owner, f) then
					-- 지나온 선분과 거리
					local v = f.root.Position - from
					local seg = step.Magnitude > 0 and step.Unit or p.dir
					local along = math.clamp(v:Dot(seg), 0, step.Magnitude)
					local closest = from + seg * along
					local dist = Vector3.new(f.root.Position.X - closest.X, 0, f.root.Position.Z - closest.Z).Magnitude
					if dist <= p.radius + 1.5 and math.abs(f.root.Position.Y - closest.Y) < 6 then
						p.hitSet[f] = true
						Combat.applyHit(p.owner, f, p.hit, { move = p.opt.move, isSkill = p.opt.isSkill, proj = true })
						if not p.pierce then
							stop = true
							break
						end
					end
				end
			end
		end
		if stop then
			table.remove(Combat.projectiles, i)
		end
	end
end

------------------------------------------------------------------------
-- 매 순간: 균형·내공 회복, 걷는 속도 (기절·막기)
------------------------------------------------------------------------
function Combat.tick(dt: number)
	local t = now()
	for _, f in pairs(Combat.fighters) do
		if not f.dead then
			local changed = false
			if f.posture > 0 and t - f.lastHurtAt > Config.POSTURE_REGEN_DELAY and t > f.brokenUntil then
				f.posture = math.max(0, f.posture - Config.POSTURE_REGEN * dt)
				changed = true
			end
			-- 자연 회복 (맞은 지 오래면 체력이 조금씩 찬다. 적은 싸움을 멈추고 8초 뒤부터)
			if not f.dead and f.hp < f.maxHp then
				local delay = f.npc and 8 or Config.REGEN_DELAY
				if t - f.lastHurtAt > delay and t > f.stunUntil then
					local rate = f.npc and 0.04 or (inSafe(f.root.Position) and Config.REGEN_SAFE_RATE or Config.REGEN_RATE)
					f.hp = math.min(f.maxHp, f.hp + f.maxHp * rate * dt)
					f.model:SetAttribute("Hp", math.floor(f.hp + 0.5))
				end
			end
			-- 꽃잎은 때리지 않아도 한동안 남아 있다가 (다 모이면 더 오래) 한 잎씩 진다
			if f.stacks.petal > 0 then
				local ps = Config.STYLE_BY_ID[f.style]
				local full = f.stacks.petal >= ((ps and ps.petalMax) or 20)
				if t - f.stacks.petalAt > (full and Config.PETAL_KEEP_FULL or Config.PETAL_KEEP) then
					f.stacks.petal -= 1
					f.stacks.petalAt = t - (full and Config.PETAL_KEEP_FULL or Config.PETAL_KEEP) + 1 / Config.PETAL_DRAIN
					f.model:SetAttribute("Petal", f.stacks.petal)
				end
			end
			local cmax = (f :: any).chiMax or Config.CHI_MAX
			if f.player and f.chi < cmax and f.model:GetAttribute("TestInf") == true then
				f.chi = cmax
				changed = true
			elseif f.player and f.chi < cmax then
				f.chi = math.min(cmax, f.chi + Config.CHI_REGEN * dt * (f.skillMult or 1) * math.sqrt(cmax / Config.CHI_MAX) * (1 + ((f :: any).mChi or 0)))
				changed = true
			end
			if f.act and t > f.act.start + f.act.dur then
				f.act = nil
			end
			local speed = f.walk
			if t < f.stunUntil then
				speed = 0
			elseif f.guarding then
				speed = f.walk * 0.4
			elseif t < ((f :: any).slowUntil or 0) then
				-- 술비에 젖어 굼뜨다
				speed = f.walk * ((f :: any).slowMul or 0.5)
			elseif f.act and not f.npc then
				speed = f.walk * 0.35
			elseif (f :: any).mountMult then
				speed = f.walk * (f :: any).mountMult
			elseif (f :: any).sprint then
				speed = f.walk * 1.45
			end
			if f.hum and math.abs(f.hum.WalkSpeed - speed) > 0.1 then
				f.hum.WalkSpeed = speed
			end
			if changed then
				-- 자주 바뀌는 값은 반올림해서 보낸다 (속성은 바뀔 때만 전달된다)
				f.model:SetAttribute("Posture", math.floor(f.posture + 0.5))
				f.model:SetAttribute("Chi", math.floor(f.chi))
			end
		end
	end
	Combat.stepProjectiles(dt)
end

function Combat.fighterOfPlayer(player: Player): Fighter?
	local char = player.Character
	return char and Combat.fighters[char] or nil
end

local _ = Players
-- 연소: 불타는 상대는 정해진 간격마다 피해를 입는다
task.spawn(function()
	while true do
		task.wait(0.1)
		local t = now()
		for f in pairs(burning) do
			local fb = f :: any
			if f.dead or not f.model.Parent or t > (fb.burnUntil or 0) then
				burning[f] = nil
				if f.model.Parent then
					f.model:SetAttribute("Burning", nil)
				end
			elseif t >= (fb.burnNext or 0) then
				fb.burnNext = t + (fb.burnEvery or 0.5)
				local by = fb.burnBy
				if by and not by.dead then
					Combat.applyHit(by, f, { dmg = fb.burnDmg or 5, posture = 2, stun = 0, kb = 0 }, { chain = true, isSkill = true, unblockable = true, move = { name = "연소" } })
				end
			end
		end
	end
end)

return Combat
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="8">
        <Properties>
          <string name="Name">Npc</string>
          <string name="Source"><![CDATA[-- 권왕: 무기를 든 적과 보스 (서버가 움직인다)
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage:WaitForChild("Config"))
local Combat = require(script.Parent:WaitForChild("Combat"))

local Npc = {}

type Enemy = {
	f: any,
	def: any,
	kind: string, -- "enemy" / "boss"
	typeId: string,
	home: Vector3,
	target: any?,
	nextAttack: number,
	guardUntil: number,
	strafe: number,
	phase2: boolean,
	seq: number,
	region: string,
	engaged: { [Player]: boolean },
	level: number,
	attackingUntil: number,
	nextPattern: number?,
}

Npc.list = {} :: { Enemy }
local folder: Folder
local Push: RemoteEvent
local SKIN = Color3.fromRGB(234, 184, 146)
-- 적의 살빛 (여러 가지)
local SKIN_TONES = { Color3.fromRGB(226, 172, 132), Color3.fromRGB(205, 150, 110), Color3.fromRGB(184, 128, 92), Color3.fromRGB(160, 110, 78), Color3.fromRGB(236, 190, 155) }

function Npc.init(push: RemoteEvent)
	Push = push
	folder = Instance.new("Folder")
	folder.Name = "Enemies"
	folder.Parent = workspace
end

------------------------------------------------------------------------
-- 몸과 무기
------------------------------------------------------------------------
local function weaponPart(name: string, size: Vector3, color: Color3, material: Enum.Material, parent: Instance): Part
	local p = Instance.new("Part")
	p.Name = name
	p.Size = size
	p.Color = color
	p.Material = material
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.Massless = true
	p.Parent = parent
	return p
end

-- 손에 무기를 붙인다. 날은 손의 앞(-Z)으로 뻗는다
local function attachWeapon(model: Model, kind: string)
	local w = Config.Weapons[kind]
	if not w then
		return
	end
	local function onHand(handName: string)
		local hand = model:FindFirstChild(handName)
		if not hand or not hand:IsA("BasePart") then
			return
		end
		local L = w.length
		local wf = Instance.new("Model")
		wf.Name = "Weapon"
		wf.Parent = model
		local grip = weaponPart("Grip", Vector3.new(0.35, 0.35, kind == "spear" and L or 1.1), w.handle, Enum.Material.Wood, wf)
		local blade: Part
		if kind == "spear" then
			blade = weaponPart("Blade", Vector3.new(0.25, 0.6, 1.4), w.color, Enum.Material.Metal, wf)
		elseif kind == "club" then
			blade = weaponPart("Blade", Vector3.new(0.75, 0.75, L), w.color, Enum.Material.Wood, wf)
		elseif kind == "staff" then
			blade = weaponPart("Blade", Vector3.new(0.4, 0.4, L), w.color, Enum.Material.Wood, wf)
		else
			blade = weaponPart("Blade", Vector3.new(0.12, kind == "greatsword" and 0.9 or 0.45, L), w.color, Enum.Material.Metal, wf)
		end
		local guard = weaponPart("Guard", Vector3.new(0.3, 0.9, 0.2), Color3.fromRGB(160, 130, 60), Enum.Material.Metal, wf)
		local base = hand.CFrame * CFrame.new(0, -0.25, 0)
		if kind == "spear" then
			grip.CFrame = base
			blade.CFrame = base * CFrame.new(0, 0, -L / 2 - 0.6)
			guard.CFrame = base * CFrame.new(0, 0, -L / 2 + 0.1)
		else
			grip.CFrame = base * CFrame.new(0, 0, 0.3)
			guard.CFrame = base * CFrame.new(0, 0, -0.3)
			blade.CFrame = base * CFrame.new(0, 0, -0.3 - L / 2)
		end
		for _, p in ipairs({ grip, blade, guard }) do
			local weld = Instance.new("WeldConstraint")
			weld.Part0 = hand
			weld.Part1 = p
			weld.Parent = p
		end
	end
	onHand("RightHand")
	if kind == "dual" then
		onHand("LeftHand")
	end
end

-- 몸을 직접 짠다 (R15 관절 이름 그대로). 로블록스 기본 몸 만들기가 안 될 때 쓴다
-- 관절 자리 J를 기준으로 C0·C1을 맞춘다. 발바닥이 HumanoidRootPart 중심에서 3칸 아래
local RIG: { { any } } = {
	-- 이름, 크기, 중심, 부모, 관절 이름, 관절 자리
	{ "LowerTorso", Vector3.new(2, 0.4, 1), Vector3.new(0, -0.8, 0), "HumanoidRootPart", "Root", Vector3.new(0, -0.8, 0) },
	{ "UpperTorso", Vector3.new(2, 1.6, 1), Vector3.new(0, 0.2, 0), "LowerTorso", "Waist", Vector3.new(0, -0.6, 0) },
	{ "Head", Vector3.new(1.2, 1.2, 1.2), Vector3.new(0, 1.6, 0), "UpperTorso", "Neck", Vector3.new(0, 1.0, 0) },
	{ "RightUpperArm", Vector3.new(1, 1.2, 1), Vector3.new(1.5, 0.4, 0), "UpperTorso", "RightShoulder", Vector3.new(1.5, 0.8, 0) },
	{ "RightLowerArm", Vector3.new(1, 0.95, 1), Vector3.new(1.5, -0.675, 0), "RightUpperArm", "RightElbow", Vector3.new(1.5, -0.2, 0) },
	{ "RightHand", Vector3.new(1, 0.3, 1), Vector3.new(1.5, -1.3, 0), "RightLowerArm", "RightWrist", Vector3.new(1.5, -1.15, 0) },
	{ "LeftUpperArm", Vector3.new(1, 1.2, 1), Vector3.new(-1.5, 0.4, 0), "UpperTorso", "LeftShoulder", Vector3.new(-1.5, 0.8, 0) },
	{ "LeftLowerArm", Vector3.new(1, 0.95, 1), Vector3.new(-1.5, -0.675, 0), "LeftUpperArm", "LeftElbow", Vector3.new(-1.5, -0.2, 0) },
	{ "LeftHand", Vector3.new(1, 0.3, 1), Vector3.new(-1.5, -1.3, 0), "LeftLowerArm", "LeftWrist", Vector3.new(-1.5, -1.15, 0) },
	{ "RightUpperLeg", Vector3.new(1, 1.1, 1), Vector3.new(0.5, -1.55, 0), "LowerTorso", "RightHip", Vector3.new(0.5, -1.0, 0) },
	{ "RightLowerLeg", Vector3.new(1, 0.7, 1), Vector3.new(0.5, -2.45, 0), "RightUpperLeg", "RightKnee", Vector3.new(0.5, -2.1, 0) },
	{ "RightFoot", Vector3.new(1, 0.2, 1.1), Vector3.new(0.5, -2.9, -0.05), "RightLowerLeg", "RightAnkle", Vector3.new(0.5, -2.8, 0) },
	{ "LeftUpperLeg", Vector3.new(1, 1.1, 1), Vector3.new(-0.5, -1.55, 0), "LowerTorso", "LeftHip", Vector3.new(-0.5, -1.0, 0) },
	{ "LeftLowerLeg", Vector3.new(1, 0.7, 1), Vector3.new(-0.5, -2.45, 0), "LeftUpperLeg", "LeftKnee", Vector3.new(-0.5, -2.1, 0) },
	{ "LeftFoot", Vector3.new(1, 0.2, 1.1), Vector3.new(-0.5, -2.9, -0.05), "LeftLowerLeg", "LeftAnkle", Vector3.new(-0.5, -2.8, 0) },
}

local function manualRig(colors: { head: Color3, torso: Color3, arms: Color3, legs: Color3 }, s: number): Model
	local model = Instance.new("Model")
	local root = Instance.new("Part")
	root.Name = "HumanoidRootPart"
	root.Size = Vector3.new(2, 2, 1) * s
	root.Transparency = 1
	root.CanCollide = false
	root.Parent = model
	model.PrimaryPart = root
	local parts: { [string]: BasePart } = { HumanoidRootPart = root }
	for _, r in ipairs(RIG) do
		local name, size, center, parentName, jointName, joint = r[1], r[2], r[3], r[4], r[5], r[6]
		local p = Instance.new("Part")
		p.Name = name
		p.Size = size * s
		p.CFrame = CFrame.new(center * s)
		p.TopSurface = Enum.SurfaceType.Smooth
		p.BottomSurface = Enum.SurfaceType.Smooth
		p.CanCollide = name == "UpperTorso" or name == "LowerTorso" or name == "Head"
		p.Material = Enum.Material.SmoothPlastic
		if name == "Head" then
			p.Color = colors.head
			local mesh = Instance.new("SpecialMesh")
			mesh.MeshType = Enum.MeshType.Head
			mesh.Scale = Vector3.new(1.25, 1.25, 1.25)
			mesh.Parent = p
			local face = Instance.new("Decal")
			face.Name = "face"
			face.Texture = "rbxasset://textures/face.png"
			face.Face = Enum.NormalId.Front
			face.Parent = p
		elseif string.find(name, "Torso") then
			p.Color = colors.torso
		elseif string.find(name, "Arm") or string.find(name, "Hand") then
			p.Color = colors.arms
		else
			p.Color = colors.legs
		end
		p.Parent = model
		parts[name] = p
		local parent = parts[parentName]
		local m = Instance.new("Motor6D")
		m.Name = jointName
		m.Part0 = parent
		m.Part1 = p
		local j = joint * s
		m.C0 = CFrame.new(j - parent.Position)
		m.C1 = CFrame.new(j - center * s)
		m.Parent = p
	end
	local hum = Instance.new("Humanoid")
	hum.RigType = Enum.HumanoidRigType.R15
	hum.HipHeight = 2 * s
	hum.AutomaticScalingEnabled = false
	hum.Parent = model
	return model
end

-- 사람 몸 하나 (로블록스 기본 몸, 안 되면 직접 짠 몸)
-- build = { h = 키, w = 품, head = 머리 } 배율 (적마다 체격이 다르다. 머리를 조금 작게 해 어른 몸으로)
local function body(colors: { head: Color3, torso: Color3, arms: Color3, legs: Color3 }, s: number, build: any?): Model
	local bd = build or {}
	local ok, model = pcall(function()
		local desc = Instance.new("HumanoidDescription")
		desc.HeadColor = colors.head
		desc.LeftArmColor = colors.arms
		desc.RightArmColor = colors.arms
		desc.TorsoColor = colors.torso
		desc.LeftLegColor = colors.legs
		desc.RightLegColor = colors.legs
		desc.HeightScale = s * (bd.h or 1)
		desc.WidthScale = s * (bd.w or 1)
		desc.DepthScale = s * (bd.w or 1)
		desc.HeadScale = s * (bd.head or 1)
		return Players:CreateHumanoidModelFromDescription(desc, Enum.HumanoidRigType.R15)
	end)
	if ok and typeof(model) == "Instance" and model:IsA("Model") and model:FindFirstChild("HumanoidRootPart") and model:FindFirstChild("LowerTorso") then
		-- 기본 걷기 스크립트는 쓰지 않는다 (몸동작은 화면이 그린다)
		local animate = model:FindFirstChild("Animate")
		if animate then
			animate:Destroy()
		end
		return model
	end
	if not ok then
		warn("[권왕] 기본 몸 만들기 실패, 직접 짠 몸을 씁니다:", model)
	end
	return manualRig(colors, s)
end
Npc.body = body

local dressEnemy: (Model, string, any, boolean) -> ()
local lookOf: (string, boolean) -> any

local function buildRig(def: any, label: string, isBoss: boolean, typeId: string?): Model
	local s = def.scale or 1
	local look = lookOf(typeId or "", isBoss)
	local skin = look.skin or SKIN_TONES[math.random(#SKIN_TONES)]
	local model = body({ head = skin, torso = def.shirt, arms = look.bareArms == false and def.shirt or skin, legs = def.pants }, s, look.build or { head = 0.9 })
	model.Name = label
	local hum = model:FindFirstChildOfClass("Humanoid")
	if hum then
		hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
		hum.BreakJointsOnDeath = false
		hum.MaxHealth = 1e9
		hum.Health = 1e9
		hum.WalkSpeed = def.speed
	end
	-- 적마다 다른 차림 (머리쓰개, 얼굴, 옷). 실패해도 몸은 그대로 쓴다
	if not def.dummy then
		local ok, err = pcall(dressEnemy, model, typeId or "", def, isBoss)
		if not ok then
			warn("[권왕] 적 차림 오류:", typeId, err)
		end
	end
	attachWeapon(model, def.weapon)
	model:SetAttribute("NPC", true)
	model:SetAttribute("Boss", isBoss)
	model:SetAttribute("Label", label)
	model:SetAttribute("Scale", def.scale or 1)
	model:SetAttribute("Weapon", def.weapon)
	if def.dummy then
		model:SetAttribute("Dummy", true)
	end
	return model
end

------------------------------------------------------------------------
-- 나타나기
------------------------------------------------------------------------
function Npc.spawn(typeId: string, isBoss: boolean, at: Vector3, region: string): Enemy?
	local def = isBoss and Config.Bosses[typeId] or Config.Enemies[typeId]
	if not def then
		return nil
	end
	local model = buildRig(def, def.name, isBoss, typeId)
	local pos = at + Vector3.new(math.random(-8, 8), 4 * (def.scale or 1), math.random(-8, 8))
	model:PivotTo(CFrame.new(pos))
	model.Parent = folder
	local root = model:FindFirstChild("HumanoidRootPart")
	if root and root:IsA("BasePart") then
		pcall(function()
			root:SetNetworkOwner(nil)
		end)
	end
	-- 마을에서 멀수록 단계가 높다: 체력·균형·피해·보상이 함께 오른다
	local lv = Config.enemyLevel(at)
	model:SetAttribute("Level", lv)
	-- mult: 허공 균열 같은 후반 땅의 적은 체력·피해가 겹으로 세다
	local mult = def.mult or 1
	local f = Combat.register(model, {
		npc = def,
		name = def.name,
		-- 체력은 넉넉하게 (보스는 조금 덜 곱한다: 이미 크다), 피해는 후반일수록 덜 오른다
		hp = def.dummy and def.hp or math.floor(def.hp * (isBoss and Config.ENEMY_BOSS_HP or Config.ENEMY_HP) * (1 + Config.ENEMY_HP_LEVEL * (lv - 1)) * mult),
		postureMax = math.floor(def.posture * (1 + 0.1 * (lv - 1)) * math.sqrt(mult)),
		walk = def.speed * (isBoss and Config.BOSS_SPEED or 1),
		style = def.style or "",
		dmgMult = Config.ENEMY_DMG * (1 + Config.ENEMY_DMG_LEVEL * (lv - 1)) * mult ^ Config.ENEMY_DMG_MULT_POW * (isBoss and (def.late and Config.LATE_BOSS_DMG or Config.BOSS_DMG) or 1),
	})
	;(f :: any).rewardMult = (1 + 0.25 * (lv - 1)) * math.sqrt(mult)
	-- 초반 적은 흘리기 판정이 좁다 (막아도 잘 흘리지 못한다)
	if not isBoss and not def.elite and not def.duel and lv <= 4 then
		(f :: any).deflectMul = 0.45
	end
	;(f :: any).typeId = typeId
	model:SetAttribute("TypeId", typeId)
	local cp = Config.enemyPower(f.dmgMult, f.maxHp, isBoss)
	;(f :: any).power = cp
	model:SetAttribute("Power", cp)
	local e: Enemy = {
		f = f,
		def = def,
		kind = isBoss and "boss" or "enemy",
		typeId = typeId,
		home = at,
		target = nil,
		nextAttack = os.clock() + 1,
		guardUntil = 0,
		strafe = math.random() < 0.5 and 1 or -1,
		phase2 = false,
		seq = 0,
		region = region,
		engaged = {},
		level = lv,
		attackingUntil = 0,
	}
	table.insert(Npc.list, e)
	return e
end

-- 지역마다 적과 보스를 놓는다
function Npc.populate()
	for _, region in ipairs(Config.Regions) do
		for _, camp in ipairs(region.camps or {}) do
			for _ = 1, camp.count do
				local ok, err = pcall(Npc.spawn, camp.enemy, false, camp.at, region.id)
				if not ok then
					warn("[권왕] 적 만들기 오류:", camp.enemy, err)
				end
			end
		end
		if region.boss then
			local ok, err = pcall(Npc.spawn, region.boss.id, true, region.boss.at, region.id)
			if not ok then
				warn("[권왕] 보스 만들기 오류:", region.boss.id, err)
			end
		end
	end
	-- 천상계의 섬들
	for _, isl in ipairs(Config.SKY.islands) do
		for _, camp in ipairs(isl.camps or {}) do
			for _ = 1, camp.count do
				local ok, err = pcall(Npc.spawn, camp.enemy, false, camp.at, "sky")
				if not ok then
					warn("[권왕] 천상계 적 만들기 오류:", camp.enemy, err)
				end
			end
		end
		if isl.boss then
			local ok, err = pcall(Npc.spawn, isl.boss.id, true, isl.boss.at, "sky")
			if not ok then
				warn("[권왕] 천상계 보스 만들기 오류:", isl.boss.id, err)
			end
		end
	end
	pcall(Npc.publishPower)
end

-- 1.5판: 지역마다 권장 전투력 (그 땅 적들의 가운데 전투력보다 조금 높게). 보스는 따로. 화면의 지도와 지역 알림이 쓴다
function Npc.publishPower()
	local groups: { [string]: { number } } = {}
	local bosses: { [string]: number } = {}
	for _, e in ipairs(Npc.list) do
		local key = e.region
		if key == "sky" then
			local isl = Config.skyIslandAt(e.f.root.Position)
			key = isl and ("sky_" .. isl.id) or "sky"
		end
		if key ~= "trial" and key ~= "test" and key ~= "summon" and key ~= "simma" and key ~= "wilds" then
			local pw = (e.f :: any).power or 0
			if e.kind == "boss" then
				bosses[key] = math.max(bosses[key] or 0, pw)
			else
				groups[key] = groups[key] or {}
				table.insert(groups[key], pw)
			end
		end
	end
	local folder = ReplicatedStorage:FindFirstChild("KwonRegionPower") or Instance.new("Folder")
	folder.Name = "KwonRegionPower"
	for key, list in pairs(groups) do
		table.sort(list)
		local mid = list[math.max(1, math.ceil(#list / 2))]
		folder:SetAttribute(key, math.floor(mid * 1.15))
	end
	for key, pw in pairs(bosses) do
		folder:SetAttribute(key .. "_boss", math.floor(pw))
	end
	folder.Parent = ReplicatedStorage
end

------------------------------------------------------------------------
-- 일곱 사부 (싸우지 않는다. 가까이 가서 T를 누르면 권법을 배운다)
------------------------------------------------------------------------
local function masterTag(head: BasePart, name: string, style: any)
	local g = Instance.new("BillboardGui")
	g.Name = "MasterTag"
	g.Size = UDim2.new(0, 320, 0, 74)
	g.StudsOffset = Vector3.new(0, 3.2, 0)
	g.AlwaysOnTop = true
	g.LightInfluence = 0
	g.MaxDistance = 160
	-- 장로는 이름 한 줄만 (말 걸기는 가까이 가면 뜨는 T 안내로)
	local lines = style.elder and { { name, Color3.fromRGB(255, 225, 150), 0.52 } } or { { "사부 · " .. name, Color3.fromRGB(255, 225, 150), 0.52 }, { style.icon .. " " .. style.name .. "  (T)", style.color, 0.48 } }
	for i, line in ipairs(lines) do
		local l = Instance.new("TextLabel")
		l.BackgroundTransparency = 1
		l.Position = UDim2.fromScale(0, i == 1 and 0 or 0.52)
		l.Size = UDim2.fromScale(1, line[3])
		l.Font = Enum.Font.GothamBlack
		l.TextScaled = true
		l.TextColor3 = line[2]
		l.TextStrokeTransparency = 0.2
		l.Text = line[1]
		l.Parent = g
	end
	g.Parent = head
end

-- 사부 차림: 몸 부위에 붙는 장식 (기본 몸이든 직접 짠 몸이든 부위 이름은 같다)
local function wear(model: Model, partName: string, name: string, size: Vector3, offset: CFrame, color: Color3, material: Enum.Material?, shape: Enum.PartType?): Part?
	local base = model:FindFirstChild(partName)
	if not base or not base:IsA("BasePart") then
		return nil
	end
	local p = Instance.new("Part")
	p.Name = name
	if shape then
		p.Shape = shape
	end
	p.Size = size
	p.Color = color
	p.Material = material or Enum.Material.Fabric
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.Massless = true
	p.CFrame = base.CFrame * offset
	p.Parent = model
	local w = Instance.new("WeldConstraint")
	w.Part0 = base
	w.Part1 = p
	w.Parent = p
	return p
end

local GOLD = Color3.fromRGB(235, 190, 80)
local WHITE_HAIR = Color3.fromRGB(240, 240, 235)

------------------------------------------------------------------------
-- 적의 차림: 머리쓰개 (삿갓·두건·투구·복면·뿔·관), 매서운 얼굴, 체격, 옷
-- 머리에 붙이는 것은 모두 머리 크기에 맞춘 둥근 모양 (머리를 뚫고 나오지 않게)
------------------------------------------------------------------------
local DARK_HAIR = Color3.fromRGB(30, 24, 20)
local STRAW = Color3.fromRGB(200, 170, 110)
local IRON = Color3.fromRGB(110, 112, 120)
local C3 = Color3.fromRGB
local LOOKS: { [string]: any } = {
	thug = { head = "bald", beard = "stubble", build = { w = 1.1, head = 0.9 } },
	bandit = { head = "bandana", cloth = C3(140, 40, 35), beard = "full", build = { head = 0.9 } },
	spearman = { head = "straw", build = { h = 1.04, head = 0.88 }, belt = true },
	brute = { head = "bald", beard = "full", build = { w = 1.38, h = 1.08, head = 0.85 }, scar = true },
	assassin = { head = "hood", cloth = C3(40, 40, 50), mask = C3(30, 30, 36), build = { w = 0.88, h = 1.05, head = 0.86 } },

		local gate = W.mazeGate.Parent
		local back = (gate and gate:IsA("BasePart")) and (gate.Position + Vector3.new(0, 3, 0) + Vector3.new(-gate.Position.X, 0, -gate.Position.Z).Unit * 8) or nil
		Maze.start(player, back)
	end)

		{ id = "crater", name = "화산 분지", desc = "용암이 흐르는 분화구 안의 두 층 단. 높은 곳을 잡아라" },
		{ id = "cloud", name = "운상 누각", desc = "구름 위에 뜬 누각 셋과 다리. 떨어지면 쓰러진다" },

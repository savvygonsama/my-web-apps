		local sun = wear(model, "UpperTorso", "SunDisc", Vector3.new(0.2, 4.2, 4.2), CFrame.new(0, 1.4, 1.1) * CFrame.Angles(0, math.rad(90), 0), style.color, Enum.Material.Neon, Enum.PartType.Cylinder)
		if sun then
			sun.Transparency = 0.15
		end
		for k = 0, 11 do
			local a = k / 12 * math.pi * 2
			wear(model, "UpperTorso", "SunRay", Vector3.new(0.18, 0.18, 1.3), CFrame.new(math.cos(a) * 2.75, 1.4 + math.sin(a) * 2.75, 1.15) * CFrame.Angles(0, math.rad(90), 0) * CFrame.Angles(0, 0, a) * CFrame.Angles(0, math.rad(90), 0), style.color, Enum.Material.Neon)
		end
		for k = 0, 6 do
			local a = math.rad(-70 + k * 23)
			wear(model, "LeftUpperArm", "MoonArc", Vector3.new(0.25, 0.25, 0.7), CFrame.new(math.cos(a) * 1.1, 1.6 + math.sin(a) * 1.1, 0) * CFrame.Angles(0, 0, a), style.color2, Enum.Material.Neon)
		end
		wear(model, "LowerTorso", "SunSash", Vector3.new(1.05, 0.3, 1.05), CFrame.new(0.5, 0.1, 0), style.color, Enum.Material.Neon)
		wear(model, "LowerTorso", "MoonSash", Vector3.new(1.05, 0.3, 1.05), CFrame.new(-0.5, 0.1, 0), style.color2, Enum.Material.Neon)
		for _, side in ipairs({ "RightHand", "LeftHand" }) do
			local hand = model:FindFirstChild(side)
			if hand and hand:IsA("BasePart") then
				local e = Instance.new("ParticleEmitter")
				e.Rate = 12
				e.Color = ColorSequence.new(side == "RightHand" and style.color or style.color2)
				e.LightEmission = 1
				e.Size = NumberSequence.new(0.35, 0)
				e.Lifetime = NumberRange.new(0.4, 0.8)
				e.Speed = NumberRange.new(1, 3)
				e.SpreadAngle = Vector2.new(180, 180)
				e.Parent = hand
			end
		end
	elseif id == "gaecheon" then
		-- 무명 노인: 땅에 끌리는 흰 수염, 별을 박은 관, 둘레를 도는 별빛
		beard(WHITE_HAIR)
		wear(model, "Head", "LongBeard", Vector3.new(hs.X * 0.5, hs.Y * 2.4, 0.3), CFrame.new(0, -hs.Y * 1.5, -hs.Z * 0.45), WHITE_HAIR)
		wear(model, "Head", "StarCrown", Vector3.new(hs.X * 1.05, 0.25, hs.Z * 1.05), CFrame.new(0, hs.Y * 0.55, 0), Color3.fromRGB(230, 235, 255), Enum.Material.Neon)
		for k = 0, 4 do
			local a = k / 5 * math.pi * 2
			wear(model, "Head", "CrownStar", Vector3.new(0.3, 0.3, 0.3), CFrame.new(math.cos(a) * hs.X * 0.5, hs.Y * 0.75, math.sin(a) * hs.Z * 0.5), style.color2, Enum.Material.Neon, Enum.PartType.Ball)
		end
		local headPart = model:FindFirstChild("Head")
		if headPart and headPart:IsA("BasePart") then
			local e = Instance.new("ParticleEmitter")
			e.Rate = 10
			e.Color = ColorSequence.new(style.color, style.color2)
			e.LightEmission = 1
			e.Size = NumberSequence.new(0.35, 0)
			e.Lifetime = NumberRange.new(1, 2)
			e.Speed = NumberRange.new(1, 3)
			e.SpreadAngle = Vector2.new(180, 180)
			e.Parent = headPart
		end
	elseif id == "pungsin" then
		-- 풍백: 바람에 날리는 긴 띠 두 줄과 깃털 머리 장식
		for _, x in ipairs({ -1, 1 }) do
			wear(model, "UpperTorso", "WindScarf", Vector3.new(0.4, 0.15, 5), CFrame.new(x * 0.6, 0.7, 2.6) * CFrame.Angles(math.rad(-15), x * math.rad(12), 0), style.color2)
			wear(model, "Head", "Feather", Vector3.new(0.15, 1.6, 0.5), CFrame.new(x * hs.X * 0.4, hs.Y * 0.8, 0.2) * CFrame.Angles(0, 0, x * math.rad(-20)), style.color, Enum.Material.Neon)
		end
		wear(model, "Head", "WindBand", Vector3.new(hs.X * 1.04, 0.2, hs.Z * 1.04), CFrame.new(0, hs.Y * 0.28, 0), style.color, Enum.Material.Neon)
	elseif id == "chwi" then
		-- 취선옹: 넓은 삿갓, 허리의 술 호리병, 붉은 뺨
		beard(Color3.fromRGB(170, 170, 165))
		wear(model, "Head", "StrawHat", Vector3.new(0.25, 3.4, 3.4), CFrame.new(0, hs.Y * 0.62, 0) * CFrame.Angles(0, 0, math.rad(90)), Color3.fromRGB(205, 175, 110), Enum.Material.Fabric, Enum.PartType.Cylinder)
		wear(model, "Head", "HatTop", Vector3.new(1.2, 0.8, 1.2), CFrame.new(0, hs.Y * 0.85, 0), Color3.fromRGB(190, 160, 95), Enum.Material.Fabric, Enum.PartType.Ball)
		wear(model, "LowerTorso", "GourdLow", Vector3.new(0.9, 0.9, 0.9), CFrame.new(1.25, -0.4, 0.2), Color3.fromRGB(200, 120, 40), Enum.Material.SmoothPlastic, Enum.PartType.Ball)
		wear(model, "LowerTorso", "GourdTop", Vector3.new(0.6, 0.6, 0.6), CFrame.new(1.25, 0.25, 0.2), Color3.fromRGB(200, 120, 40), Enum.Material.SmoothPlastic, Enum.PartType.Ball)
		for _, x in ipairs({ -1, 1 }) do
			wear(model, "Head", "Cheek", Vector3.new(0.25, 0.14, 0.05), CFrame.new(x * hs.X * 0.28, -hs.Y * 0.05, -hs.Z * 0.51), Color3.fromRGB(240, 110, 110), Enum.Material.SmoothPlastic)
		end
	elseif id == "chochanghae" then
		-- 고경선: 바닷바람에 센 흰 수염과 상투, 진주 목걸이, 손에 쥔 고래 뼈 지팡이 (끝에 진주)
		beard(WHITE_HAIR)
		wear(model, "Head", "Topknot", Vector3.new(0.6, 0.6, 0.6), CFrame.new(0, hs.Y * 0.62, 0.05), WHITE_HAIR, Enum.Material.SmoothPlastic, Enum.PartType.Ball)
		for k = 0, 10 do
			local a2 = (k / 10 - 0.5) * math.pi * 0.8
			wear(model, "UpperTorso", "Pearl", Vector3.new(0.22, 0.22, 0.22), CFrame.new(math.sin(a2) * 0.6, 0.66 - math.cos(a2) * 0.25, -0.53), Color3.fromRGB(240, 244, 250), Enum.Material.SmoothPlastic, Enum.PartType.Ball)
		end
		wear(model, "RightHand", "BoneStaff", Vector3.new(0.35, 6.8, 0.35), CFrame.new(0, 1.3, 0) * CFrame.Angles(0, 0, math.rad(4)), Color3.fromRGB(222, 214, 196), Enum.Material.Limestone)
		wear(model, "RightHand", "BoneStaffHook", Vector3.new(0.3, 1.4, 0.3), CFrame.new(0.4, 4.7, 0) * CFrame.Angles(0, 0, math.rad(-40)), Color3.fromRGB(222, 214, 196), Enum.Material.Limestone)
		wear(model, "RightHand", "StaffPearl", Vector3.new(0.7, 0.7, 0.7), CFrame.new(0.9, 5.2, 0), Color3.fromRGB(200, 240, 255), Enum.Material.Glass, Enum.PartType.Ball)
	elseif id == "gongbaek" then
		-- 이름 없는 자: 얼굴이 검게 지워졌고, 흰 점 둘만 보인다. 가슴을 가로지르는 붉은 잡음 줄
		wear(model, "Head", "VoidMask", Vector3.new(hs.X * 1.08, hs.Y * 1.08, hs.Z * 1.08), CFrame.new(0, 0, 0), Color3.fromRGB(10, 10, 14), Enum.Material.SmoothPlastic)
		for _, x in ipairs({ -1, 1 }) do
			wear(model, "Head", "VoidEye", Vector3.new(0.14, 0.14, 0.05), CFrame.new(x * hs.X * 0.18, hs.Y * 0.08, -hs.Z * 0.56), Color3.fromRGB(245, 245, 250), Enum.Material.Neon)
		end
		wear(model, "UpperTorso", "GlitchLine", Vector3.new(2.2, 0.12, 1.2), CFrame.new(0.2, 0.1, 0) * CFrame.Angles(0, 0, math.rad(-8)), Color3.fromRGB(230, 40, 60), Enum.Material.Neon)
	elseif id == "hojeop" then
		-- 몽선: 흰 수염의 졸린 노인, 남색 잠꼬깔 (끝에 별 방울), 등 뒤의 창백한 초승달, 손에 든 작은 달 등불
		beard(WHITE_HAIR)
		local NIGHT = Color3.fromRGB(46, 50, 120)
		local MOONC = Color3.fromRGB(255, 236, 180)
		wear(model, "Head", "NightCap", Vector3.new(hs.X * 1.05, hs.Y * 0.45, hs.Z * 1.05), CFrame.new(0, hs.Y * 0.55, 0), NIGHT, Enum.Material.Fabric)
		wear(model, "Head", "NightCapTip", Vector3.new(hs.X * 0.6, hs.Y * 0.7, hs.Z * 0.6), CFrame.new(hs.X * 0.25, hs.Y * 0.95, 0.1) * CFrame.Angles(0, 0, math.rad(-35)), NIGHT, Enum.Material.Fabric)
		wear(model, "Head", "NightCapStar", Vector3.new(0.4, 0.4, 0.4), CFrame.new(hs.X * 0.6, hs.Y * 1.05, 0.15), MOONC, Enum.Material.Neon, Enum.PartType.Ball)
		for k = 0, 5 do
			local a = math.rad(-75 + k * 30)
			wear(model, "UpperTorso", "DreamMoon", Vector3.new(0.35, 0.75 - math.abs(k - 2.5) * 0.08, 0.15), CFrame.new(math.sin(a) * 1.3, 1.1 + math.cos(a) * 1.3 - 0.9, 0.9) * CFrame.Angles(0, 0, -a), MOONC, Enum.Material.Neon)
		end
		wear(model, "LeftHand", "MoonLamp", Vector3.new(0.7, 0.7, 0.7), CFrame.new(0, -0.6, 0), MOONC, Enum.Material.Neon, Enum.PartType.Ball)
		wear(model, "LeftHand", "MoonLampCap", Vector3.new(0.75, 0.15, 0.75), CFrame.new(0, -0.2, 0), NIGHT, Enum.Material.Metal)
	elseif id == "chosengha" then
		-- 천성선: 흰 수염, 별을 수놓은 남색 높은 관, 어깨의 금빛 별 둘, 손에 쥔 별 지팡이
		beard(WHITE_HAIR)
		wear(model, "Head", "StarCrown", Vector3.new(hs.X * 0.8, hs.Y * 0.9, hs.Z * 0.8), CFrame.new(0, hs.Y * 0.85, 0), Color3.fromRGB(40, 40, 120), Enum.Material.Fabric)
		wear(model, "Head", "CrownStar", Vector3.new(0.45, 0.45, 0.45), CFrame.new(0, hs.Y * 1.35, 0), style.color2, Enum.Material.Neon, Enum.PartType.Ball)
		for _, x in ipairs({ -1, 1 }) do
			wear(model, "UpperTorso", "ShoulderStar", Vector3.new(0.35, 0.35, 0.35), CFrame.new(x * 0.9, 0.85, -0.2), style.color2, Enum.Material.Neon, Enum.PartType.Ball)
		end
		wear(model, "RightHand", "StarStaff", Vector3.new(0.3, 6.6, 0.3), CFrame.new(0, 1.2, 0), Color3.fromRGB(46, 36, 70), Enum.Material.Wood)
		wear(model, "RightHand", "StarStaffRing", Vector3.new(0.2, 1.6, 1.6), CFrame.new(0, 4.7, 0) * CFrame.Angles(0, math.rad(90), 0), Color3.fromRGB(214, 176, 92), Enum.Material.Metal, Enum.PartType.Cylinder)
		wear(model, "RightHand", "StarStaffGem", Vector3.new(0.9, 0.9, 0.9), CFrame.new(0, 4.7, 0), style.color2, Enum.Material.Neon, Enum.PartType.Ball)
	end
end

-- 청운 장로: 이야기를 들려주는 노인 (마을)
function Npc.spawnElder(onTalk: (Player) -> ())
	local mf = workspace:FindFirstChild("Masters") or Instance.new("Folder")
	mf.Name = "Masters"
	mf.Parent = workspace
	local robe = Color3.fromRGB(120, 95, 70)
	local model = body({ head = SKIN, torso = robe, arms = Color3.fromRGB(150, 125, 95), legs = Color3.fromRGB(80, 65, 50) }, 1.05)
	model.Name = "Elder"
	local hum = model:FindFirstChildOfClass("Humanoid")
	if hum then
		hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
		hum.WalkSpeed = 0
	end
	local head = model:FindFirstChild("Head") :: BasePart?
	local hs = head and head.Size or Vector3.new(1.2, 1.2, 1.2)
	wear(model, "Head", "Beard", Vector3.new(hs.X * 0.55, hs.Y * 1.2, 0.35), CFrame.new(0, -hs.Y * 0.65, -hs.Z * 0.42), Color3.fromRGB(240, 240, 235))
	wear(model, "Head", "Topknot", Vector3.new(0.6, 0.6, 0.6), CFrame.new(0, hs.Y * 0.62, 0.05), Color3.fromRGB(235, 235, 230), Enum.Material.SmoothPlastic, Enum.PartType.Ball)
	for _, z in ipairs({ -1, 1 }) do
		wear(model, "LowerTorso", "RobePanel", Vector3.new(2.1, 2.4, 0.18), CFrame.new(0, -1.35, z * 0.55), robe)
	end
	wear(model, "RightHand", "Staff", Vector3.new(0.3, 6.5, 0.3), CFrame.new(0, 1.2, 0), Color3.fromRGB(100, 70, 45), Enum.Material.Wood)
	local root = model:FindFirstChild("HumanoidRootPart") :: BasePart
	local up = (hum and hum.HipHeight or 2) + root.Size.Y / 2
	local at = Config.ELDER_AT
	model:PivotTo(CFrame.lookAt(at + Vector3.new(0, up, 0), at + Vector3.new(0, up, 10)))
	root.Anchored = true
	model:SetAttribute("NPC", true)
	model:SetAttribute("Master", true)
	model:SetAttribute("Label", "청운 장로")
	if head then
		masterTag(head, "청운 장로", { icon = "📜", name = "이야기 (T)", color = Color3.fromRGB(255, 225, 150), elder = true })
	end
	local pp = Instance.new("ProximityPrompt")
	pp.Name = "Elder"
	pp.ActionText = "이야기"
	pp.ObjectText = "청운 장로"
	pp.HoldDuration = 0
	pp.MaxActivationDistance = 14
	pp.RequiresLineOfSight = false
	pp.KeyboardKeyCode = Enum.KeyCode.T
	pp.Parent = root
	pp.Triggered:Connect(onTalk)
	model.Parent = mf
end

function Npc.spawnMasters(onTrigger: (Player, string) -> ())
	local mf = Instance.new("Folder")
	mf.Name = "Masters"
	mf.Parent = workspace
	for _, style in ipairs(Config.Styles) do
		local info = Config.MASTERS[style.id]
		if info then
			local ok, err = pcall(function()
				local s = 1.2
				local model = body({ head = SKIN, torso = style.color:Lerp(Color3.new(1, 1, 1), 0.1), arms = style.color:Lerp(Color3.new(1, 1, 1), 0.25), legs = style.color:Lerp(Color3.new(0, 0, 0), 0.55) }, s)
				model.Name = "Master_" .. style.id
				local hum = model:FindFirstChildOfClass("Humanoid")
				local root = model:FindFirstChild("HumanoidRootPart") :: BasePart
				if hum then
					hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
					hum.WalkSpeed = 0
					hum.JumpPower = 0
				end
				-- 허리띠 (권법의 둘째 빛깔)
				local lower = model:FindFirstChild("LowerTorso")
				if lower and lower:IsA("BasePart") then
					local sash = Instance.new("Part")
					sash.Name = "Sash"
					sash.Size = Vector3.new(lower.Size.X * 1.08, 0.35, lower.Size.Z * 1.15)
					sash.Color = style.color2
					sash.Material = Enum.Material.Fabric
					sash.CanCollide = false
					sash.CanQuery = false
					sash.Massless = true
					sash.CFrame = lower.CFrame * CFrame.new(0, 0.1, 0)
					sash.Parent = model
					local weld = Instance.new("WeldConstraint")
					weld.Part0 = lower
					weld.Part1 = sash
					weld.Parent = sash
				end
				pcall(dressMaster, model, style)
				local up = (hum and hum.HipHeight or 2 * s) + root.Size.Y / 2
				local at = info.at
				local face = Vector3.new(0, at.Y, 0) - at
				face = Vector3.new(face.X, 0, face.Z)
				local pos = at + Vector3.new(0, up, 0)
				model:PivotTo(CFrame.lookAt(pos, pos + (face.Magnitude > 1 and face.Unit or Vector3.new(0, 0, 1))))
				root.Anchored = true
				model:SetAttribute("NPC", true)
				model:SetAttribute("Master", true)
				model:SetAttribute("Awaken", 2)
				model:SetAttribute("Quote", info.quote)
				-- 발밑의 빛나는 진
				for i, r in ipairs({ 5, 3.2 }) do
					local sig = Instance.new("Part")
					sig.Name = "MasterSigil"
					sig.Anchored = true
					sig.CanCollide = false
					sig.CanQuery = false
					sig.Shape = Enum.PartType.Cylinder
					sig.Size = Vector3.new(0.1, r * 2, r * 2)
					sig.CFrame = CFrame.new(at + Vector3.new(0, 0.08 + i * 0.02, 0)) * CFrame.Angles(0, 0, math.rad(90))
					sig.Color = i == 1 and style.color or style.color2
					sig.Material = Enum.Material.Neon
					sig.Transparency = i == 1 and 0.55 or 0.7
					sig.Parent = mf
				end
				model:SetAttribute("Style", style.id)
				model:SetAttribute("Label", info.name)
				local head = model:FindFirstChild("Head")
				if head and head:IsA("BasePart") then
					masterTag(head, info.name, style)
				end
				local pp = Instance.new("ProximityPrompt")
				pp.Name = "Master"
				pp.ActionText = "권법 배우기"
				pp.ObjectText = info.name
				pp.HoldDuration = 0
				pp.MaxActivationDistance = 16
				pp.RequiresLineOfSight = false
				pp.KeyboardKeyCode = Enum.KeyCode.T
				pp.Parent = root
				pp.Triggered:Connect(function(player: Player)
					onTrigger(player, style.id)
				end)
				model.Parent = mf
			end)
			if not ok then
				warn("[권왕] 사부 만들기 오류:", style.id, err)
			end
		end
	end
end

-- 싸움 없이 치운다 (시험이 끝났을 때)
function Npc.despawn(f: any)
	for i, e in ipairs(Npc.list) do
		if e.f == f then
			table.remove(Npc.list, i)
			for player in pairs(e.engaged) do
				Push:FireClient(player, "boss", nil)
			end
			break
		end
	end
	Combat.unregister(f.model)
	f.model:Destroy()
end

-- 쓰러진 사람: 보스와 맞붙은 기록을 지우고 체력 막대를 걷는다
function Npc.forget(player: Player)
	for _, e in ipairs(Npc.list) do
		e.engaged[player] = nil
		if e.target and e.target.player == player then
			e.target = nil
		end
	end
	Push:FireClient(player, "boss", nil)
end

function Npc.find(model: Model): Enemy?
	for _, e in ipairs(Npc.list) do
		if e.f.model == model then
			return e
		end
	end
	return nil
end

-- 쓰러진 적: 잠시 뒤 치우고, 정해진 시간 뒤 다시 나타난다
function Npc.onDeath(f: any)
	for i, e in ipairs(Npc.list) do
		if e.f == f then
			table.remove(Npc.list, i)
			for player in pairs(e.engaged) do
				Push:FireClient(player, "boss", nil)
			end
			task.delay(2.5, function()
				Combat.unregister(f.model)
				f.model:Destroy()
			end)
			local wait = e.kind == "boss" and (e.def.respawn or 120) or Config.ENEMY_RESPAWN
			if e.region == "simma" or e.region == "trial" or e.region == "summon" or e.region == "test" then
				return -- 심마는 다시 나타나지 않는다
			end
			task.delay(wait, function()
				local ok, err = pcall(Npc.spawn, e.typeId, e.kind == "boss", e.home, e.region)
				if not ok then
					warn("[권왕] 적 다시 만들기 오류:", e.typeId, err)
				end
			end)
			return
		end
	end
end

------------------------------------------------------------------------
-- 생각하기 (0.1초마다)
------------------------------------------------------------------------
-- 2.1판: 높이가 크게 다르면 (지상과 천상) 아주 먼 것으로 친다. 천상의 적이 바로 아래 땅의 사람을 쫓지 않게
local function flatDist(a: Vector3, b: Vector3): number
	if math.abs(a.Y - b.Y) > 600 then
		return math.huge
	end
	return Vector3.new(a.X - b.X, 0, a.Z - b.Z).Magnitude
end

local function inSafe(pos: Vector3): boolean
	return Config.inSafe(pos)
end

local function faceTo(e: Enemy, pos: Vector3)
	local root = e.f.root
	local p = root.Position
	local dir = Vector3.new(pos.X - p.X, 0, pos.Z - p.Z)
	if dir.Magnitude > 0.1 then
		root.CFrame = CFrame.lookAt(p, p + dir)
	end
end

local function nearestPlayer(e: Enemy, radius: number): any?
	local best, bestD = nil, radius
	local pos = e.f.root.Position
	for _, player in ipairs(Players:GetPlayers()) do
		local pf = Combat.fighterOfPlayer(player)
		if pf and not pf.dead and not inSafe(pf.root.Position) then
			local d = flatDist(pf.root.Position, pos)
			if d < bestD then
				best, bestD = pf, d
			end
		end
	end
	return best
end

local function attack(e: Enemy, move: any)
	local f = e.f
	local tgt = e.target
	if not tgt then
		return
	end
	e.seq += 1
	local speed = (e.phase2 and e.def.phase2 and e.def.phase2.speed) or 1
	faceTo(e, tgt.root.Position)
	local act = Combat.begin(f, move, move.id, e.seq, { enemy = true, speed = speed, align = move.windup / speed })
	f.hum:MoveTo(f.root.Position)
	-- 2.1판: 흘리기 시험의 사부는 주먹이 닿기 직전을 머리 위의 F로 알려 준다
	if (f :: any).deflectCue and tgt.player and move.hits[1] then
		Push:FireClient(tgt.player, "deflectCue", { m = f.model, t = move.hits[1].t / speed })
	end
	-- 순간이동 (보스): 멈칫이 끝나기 직전 상대 등 뒤로
	if move.teleport then
		task.delay(math.max(0, move.windup / speed - 0.12), function()
			if f.act == act and not f.dead and not tgt.dead then
				local behind = tgt.root.Position - Combat.look(tgt) * 4
				f.root.CFrame = CFrame.lookAt(behind, Vector3.new(tgt.root.Position.X, behind.Y, tgt.root.Position.Z))
				Push:FireAllClients("blink", f.model, behind)
			end
		end)
	end
	-- 앞으로 내딛기
	if move.lunge then
		task.delay(math.max(0, move.windup / speed - 0.08), function()
			if f.act == act and not f.dead then
				if e.target then
					faceTo(e, e.target.root.Position)
				end
				f.root.AssemblyLinearVelocity = Combat.look(f) * (move.lunge / 0.22) + Vector3.new(0, 2, 0)
			end
		end)
	end
	for i, h in ipairs(move.hits) do
		task.delay(h.t / speed, function()
			if f.act ~= act or f.dead then
				return
			end
			f.lastSwingAt = os.clock()
			-- 큰 보스는 팔이 길다
			local hh = h
			if e.def.reach then
				hh = table.clone(h)
				hh.range *= e.def.reach
				hh.radius *= e.def.reach
			end
			for _, victim in ipairs(Combat.query(f, hh)) do
				Combat.applyHit(f, victim, hh, { move = move, act = act, unblockable = move.unblockable, slotKey = i })
			end
		end)
	end
	local recover = (0.55 + math.random() * 0.7) / speed
	if e.kind == "boss" then
		recover *= 0.7
	end
	e.nextAttack = os.clock() + act.dur + recover
	e.attackingUntil = os.clock() + act.dur + 0.25
end

------------------------------------------------------------------------
-- 보스 패턴: 바닥에 붉은 표시가 먼저 뜨고, 잠시 뒤 터진다 (대시로 피하거나 표시 밖으로)
--   quake  보스 둘레가 울린다            leap   표적 자리로 뛰어올라 내려찍는다
--   charge 표적 쪽으로 한 줄 돌진         rain   표적 둘레 여러 곳에 벼락·얼음·피
--   donut  보스에서 떨어진 고리가 터진다 (보스 품으로 파고들면 안전)
--   summon 부하를 부른다
------------------------------------------------------------------------
local BOSS_RED = Color3.fromRGB(255, 60, 40)
local function playersNear(f: any, center: Vector3, r0: number, r1: number): { any }
	local out = {}
	for _, o in pairs(Combat.fighters) do
		if Combat.hostile(f, o) and not o.dead then
			local d = Vector3.new(o.root.Position.X - center.X, 0, o.root.Position.Z - center.Z).Magnitude
			if d >= r0 and d <= r1 then
				table.insert(out, o)
			end
		end
	end
	return out
end

local function bossHit(e: Enemy, victims: { any }, h: any, name: string)
	for _, o in ipairs(victims) do
		Combat.applyHit(e.f, o, h, { move = { name = name }, unblockable = true })
	end
end

local function telegraph(at: Vector3, radius: number, time: number, color: Color3?)
	Push:FireAllClients("skillfx", { kind = "telegraph", at = at, radius = radius, time = time, color = color or BOSS_RED })
end

local function runPattern(e: Enemy, tgt: any, pat: any, phase: number)
	local f = e.f
	local sp = 1 + 0.15 * (phase - 1) -- 단계가 오를수록 빨라진다
	local warn = (pat.warn or 1.0) / sp
	local h = pat.hit
	local kind = pat.kind
	-- 몸짓 (멈칫하며 기를 모은다)
	local act = Combat.begin(f, { id = "bp_" .. kind, name = pat.name, pose = pat.pose or "w_overhead", dur = warn + 0.5, hits = {} }, "pat", e.seq + 1, { enemy = true })
	e.seq += 1
	f.hum:MoveTo(f.root.Position)
	faceTo(e, tgt.root.Position)
	Push:FireAllClients("bossCall", { m = f.model, name = pat.name })
	local function later(sec: number, fn: () -> ())
		task.delay(sec, function()
			if not f.dead and f.root.Parent then
				fn()
			end
		end)
	end
	if kind == "quake" then
		local at = f.root.Position
		telegraph(at, pat.radius, warn)
		later(warn, function()
			Push:FireAllClients("skillfx", { kind = "wave", at = at, radius = pat.radius, color = BOSS_RED })
			bossHit(e, playersNear(f, at, 0, pat.radius), h, pat.name)
		end)
	elseif kind == "leap" then
		local at = tgt.root.Position
		telegraph(at, pat.radius, warn)
		later(warn * 0.55, function()
			-- 뛰어오른다 (보이게 높이)
			f.root.AssemblyLinearVelocity = Vector3.new(0, 70, 0)
		end)
		later(warn, function()
			f.root.CFrame = CFrame.new(at + Vector3.new(0, 4 * (e.def.scale or 1), 0)) * (f.root.CFrame - f.root.Position)
			Push:FireAllClients("skillfx", { kind = "drop", at = at, radius = pat.radius, color = BOSS_RED })
			bossHit(e, playersNear(f, at, 0, pat.radius), h, pat.name)
		end)
	elseif kind == "charge" then
		local from = f.root.Position
		local dir = Vector3.new(tgt.root.Position.X - from.X, 0, tgt.root.Position.Z - from.Z)
		dir = dir.Magnitude > 0.1 and dir.Unit or Vector3.new(0, 0, -1)
		local len = pat.length or 40
		local times = pat.times or 1
		for k = 0, times - 1 do
			later(k * (warn + 0.35), function()
				local start = f.root.Position
				if k > 0 and e.target then
					local d2 = Vector3.new(e.target.root.Position.X - start.X, 0, e.target.root.Position.Z - start.Z)
					dir = d2.Magnitude > 0.1 and d2.Unit or dir
				end
				Push:FireAllClients("skillfx", { kind = "lineTele", from = start, to = start + dir * len, width = pat.width or 8, time = warn, color = BOSS_RED })
				later(warn, function()
					local p0 = f.root.Position
					f.root.CFrame = CFrame.lookAt(p0, p0 + dir)
					f.root.AssemblyLinearVelocity = dir * (len / 0.35)
					Push:FireAllClients("afterimage", f.model)
					local hitSet = {}
					for s = 1, 5 do
						later(s * 0.07, function()
							for _, o in ipairs(playersNear(f, f.root.Position, 0, (pat.width or 8) * 0.6 + 2)) do
								if not hitSet[o] then
									hitSet[o] = true
									bossHit(e, { o }, h, pat.name)
								end
							end
						end)
					end
				end)
			end)
		end
	elseif kind == "rain" then
		local n = (pat.count or 5) + (phase - 1) * 2
		for i = 1, n do
			local base = tgt.root.Position
			local a = math.random() * math.pi * 2
			local at = i == 1 and base or base + Vector3.new(math.cos(a), 0, math.sin(a)) * math.random(4, pat.spread or 18)
			later((i - 1) * 0.12, function()
				telegraph(at, pat.radius, warn, pat.color)
				later(warn, function()
					Push:FireAllClients("skillfx", { kind = "strike", at = at, radius = pat.radius, fx = pat.fx or "lightning", color = pat.color or BOSS_RED })
					bossHit(e, playersNear(f, at, 0, pat.radius), h, pat.name)
				end)
			end)
		end
	elseif kind == "donut" then
		local at = f.root.Position
		Push:FireAllClients("skillfx", { kind = "donut", at = at, inner = pat.inner, outer = pat.outer, time = warn, color = BOSS_RED })
		later(warn, function()
			Push:FireAllClients("skillfx", { kind = "wave", at = at, radius = pat.outer, color = BOSS_RED })
			bossHit(e, playersNear(f, at, pat.inner, pat.outer), h, pat.name)
		end)
	elseif kind == "summon" then
		local alive = 0
		for _, o in ipairs(Npc.list) do
			if (o :: any).summoner == e and not o.f.dead then
				alive += 1
			end
		end
		for i = 1, math.max(0, math.min(pat.count or 3, (pat.max or 6) - alive)) do
			local a = i / 3 * math.pi * 2
			local at = f.root.Position + Vector3.new(math.cos(a) * 10, 0, math.sin(a) * 10)
			Push:FireAllClients("skillfx", { kind = "mark", at = at, radius = 4, time = warn, color = BOSS_RED })
			later(warn, function()
				local m = Npc.spawn(pat.enemy, false, at, "summon")
				if m then
					(m :: any).summoner = e
					m.target = tgt
				end
			end)
		end
	end
	local cd = (pat.cd or 7) / sp
	e.nextPattern = os.clock() + warn + cd
	e.nextAttack = os.clock() + warn + 0.8
	e.attackingUntil = os.clock() + warn + 0.5
	local _ = act
end

-- 보스 단계: 체력 2/3, 1/3에서 다음 단계로 (빨라지고 패턴이 늘어난다)
local function bossPhase(e: Enemy): number
	local f = e.f
	local r = f.hp / math.max(1, f.maxHp)
	local ph = r > 0.66 and 1 or (r > 0.33 and 2 or 3)
	local old = (e :: any).phase or 1
	if ph > old then
		(e :: any).phase = ph
		f.model:SetAttribute("BossPhase", ph)
		f.walk = e.def.speed * Config.BOSS_SPEED * (1 + Config.BOSS_PHASE_SPEED * (ph - 1))
		Push:FireAllClients("bossPhase", f.model, e.def.name, ph)
		-- 단계가 바뀌면 곧바로 큰 패턴
		e.nextPattern = os.clock() + 0.6
	end
	return ph
end

local function think(e: Enemy, t: number)
	local f = e.f
	if f.dead or not f.root.Parent then
		return
	end
	local pos = f.root.Position
	-- 수련 목인: 맞은 피해만 센다. 3초 동안 안 맞으면 다시 가득
	if (e.def :: any).dummy then
		local ea = e :: any
		ea.hits = ea.hits or {}
		local lost = (ea.lastHp or f.maxHp) - f.hp
		if lost > 0 then
			table.insert(ea.hits, { t = t, d = lost })
			ea.best = math.max(ea.best or 0, lost)
			ea.lastHitAt = t
		end
		while ea.hits[1] and t - ea.hits[1].t > 5 do
			table.remove(ea.hits, 1)
		end
		local sum = 0
		for _, h in ipairs(ea.hits) do
			sum += h.d
		end
		local span = #ea.hits > 0 and math.max(1, t - ea.hits[1].t) or 1
		f.model:SetAttribute("Dps", math.floor(sum / span + 0.5))
		f.model:SetAttribute("Best", math.floor((ea.best or 0) + 0.5))
		if t - (ea.lastHitAt or 0) > 3 and f.hp < f.maxHp then
			f.hp = f.maxHp
			ea.best = 0
			Combat.sync(f)
		end
		ea.lastHp = f.hp
		-- 밀려나도 1초 뒤 제자리로
		ea.spot = ea.spot or pos
		if flatDist(pos, ea.spot) > 4 and t - (ea.lastHitAt or 0) > 1 then
			f.model:PivotTo(CFrame.new(ea.spot) * f.root.CFrame.Rotation)
		end
		f.hum:MoveTo(f.root.Position)
		return
	end
	-- 버티기에 들어가면 곧바로 되받아친다
	if (f :: any).retaliate then
		(f :: any).retaliate = nil
		e.nextAttack = math.min(e.nextAttack, t)
	end
	-- 2.1판: 천상의 섬에서 떨어져 땅까지 내려온 적 (또는 그 반대)은 곧바로 제자리로 돌아간다
	if math.abs(pos.Y - e.home.Y) > 600 then
		e.target = nil
		f.root.AssemblyLinearVelocity = Vector3.zero
		f.model:PivotTo(CFrame.new(e.home + Vector3.new(0, 3, 0)) * f.root.CFrame.Rotation)
		return
	end
	-- 근처에 사람이 없으면 쉰다
	local anyone = false
	for _, player in ipairs(Players:GetPlayers()) do
		local pf = Combat.fighterOfPlayer(player)
		if pf and flatDist(pf.root.Position, pos) < (e.kind == "boss" and Config.BOSS_CHASE + 30 or Config.ENEMY_ACTIVE_RANGE) then
			anyone = true
			break
		end
	end
	if not anyone then
		e.target = nil
		return
	end
	-- 너무 멀리 끌려 나오면 집으로 (보스는 훨씬 멀리까지 쫓아온다)
	if flatDist(pos, e.home) > (e.kind == "boss" and Config.BOSS_LEASH or 150) then
		e.target = nil
	end
	if Combat.stunned(f) then
		f.hum:MoveTo(pos)
		return
	end
	if f.guarding and t > e.guardUntil then
		f.guarding = false
		f.model:SetAttribute("Guard", false)
	end
	-- 보스 단계 (세 단계)
	local phase = 1
	if e.kind == "boss" then
		phase = bossPhase(e)
		e.phase2 = phase >= 2
	end
	if Combat.busy(f) then
		if e.target and not (f.act and f.act.move.lunge) then
			faceTo(e, e.target.root.Position)
		end
		return
	end
	-- 상대 고르기
	local tgt = e.target
	-- 사부의 분신은 시험을 청한 사람하고만 겨룬다 (사부의 자리 안에서도)
	local owner = (f :: any).trialOwner
	if owner then
		tgt = Combat.fighterOfPlayer(owner)
	end
	if tgt and (tgt.dead or not tgt.root.Parent or (inSafe(tgt.root.Position) and not e.def.duel) or flatDist(tgt.root.Position, pos) > (e.kind == "boss" and math.max(e.def.aggro * 1.6, Config.BOSS_CHASE) or e.def.aggro * 1.6)) then
		tgt = nil
	end
	if not tgt and not owner then
		tgt = nearestPlayer(e, e.def.aggro)
	end
	-- 처음 상대를 잡으면 둘레의 동료도 함께 덤빈다
	if tgt and not e.target then
		for _, o in ipairs(Npc.list) do
			if o ~= e and not o.target and not o.f.dead and flatDist(o.f.root.Position, pos) < 45 then
				o.target = tgt
			end
		end
	end
	e.target = tgt
	if not tgt then
		if flatDist(pos, e.home) > 10 then
			f.hum:MoveTo(e.home)
		end
		return
	end
	-- 보스: 싸우는 사람 화면에 체력 막대. 멀어지거나 쓰러진 사람의 막대는 걷는다 (다시 맞붙으면 다시 뜬다)
	if e.kind == "boss" then
		for p in pairs(e.engaged) do
			local pf = Combat.fighterOfPlayer(p)
			if not pf or pf.dead or flatDist(pf.root.Position, pos) > 170 then
				e.engaged[p] = nil
				Push:FireClient(p, "boss", nil)
			end
		end
	end
	if e.kind == "boss" and tgt.player and not e.engaged[tgt.player] then
		e.engaged[tgt.player] = true
		Push:FireClient(tgt.player, "boss", f.model)
		-- 2.3판: 후반 보스는 훨씬 센 상대를 만나면 힘을 끌어올린다 (상대 전투력의 LATE_BOSS_MATCH배까지). 한 방에 쓰러지지도, 손도 못 대는 일도 없게
		local fa = f :: any
		local want = ((tgt :: any).power or 0) * Config.LATE_BOSS_MATCH
		if e.def.late and want > (fa.power or 0) then
			local k = want / math.max(1, fa.power or 1)
			fa.basePower = fa.basePower or fa.power
			local frac = f.hp / math.max(1, f.maxHp)
			f.maxHp = math.floor(f.maxHp * k)
			f.hp = math.floor(f.maxHp * frac)
			f.dmgMult *= k
			f.postureMax = math.floor(f.postureMax * math.sqrt(k))
			fa.power = math.floor(want)
			f.model:SetAttribute("Power", fa.power)
			Combat.sync(f)
			Push:FireAllClients("bossCall", { m = f.model, name = "힘을 끌어올린다!" })
		end
	end
	local d = flatDist(tgt.root.Position, pos)
	-- 보스 패턴 (단계마다 쓸 수 있는 것이 늘어난다)
	if e.kind == "boss" and e.def.patterns then
		local ea = e :: any
		if not ea.nextPattern then
			ea.nextPattern = t + 3
		end
		if t >= ea.nextPattern and d < 50 then
			local pool = {}
			for _, pat in ipairs(e.def.patterns) do
				if (pat.phase or 1) <= phase then
					table.insert(pool, pat)
				end
			end
			if #pool > 0 then
				runPattern(e, tgt, pool[math.random(1, #pool)], phase)
				return
			end
		end
	end
	-- 상대가 막 치기 시작하면 가끔 막는다 (보스는 더 자주)
	local tact = tgt.act
	if tact and t - tact.start < 0.18 and d < 11 and not f.guarding and not (tact :: any).perfect then
		-- 마구 누르는 연타는 읽혀서 막히고 흘려진다. 박자를 맞춘 일격(連)은 읽지 못한다
		local sloppy = (tgt :: any).sloppy or 0
		-- 초반 적 (단계 4 이하, 정예 아님)은 덜 막는다
		local early = e.kind ~= "boss" and not e.def.elite and not e.def.duel and e.level <= 4
		local chance = (e.kind == "boss" and 0.4 or (early and 0.1 or 0.22)) + math.min(early and 0.2 or 0.5, sloppy * (early and 0.05 or 0.09))
		if math.random() < chance then
			f.guarding = true
			f.guardStart = t
			e.guardUntil = t + 0.7
			f.model:SetAttribute("Guard", true)
			faceTo(e, tgt.root.Position)
			f.hum:MoveTo(pos)
			return
		end
	end
	if f.guarding then
		faceTo(e, tgt.root.Position)
		return
	end
	-- 공격 사이엔 자주 막기 자세를 잡는다: 마구 치면 막히고, 막 잡은 막기엔 흘려진다
	-- (상대가 칠 때를 기다려 흘리고 파고들거나, 균형을 깨거나, 뒤를 잡아야 한다)
	local earlyIdle = e.kind ~= "boss" and not e.def.elite and not e.def.duel and e.level <= 4
	if d < 8 and t < e.nextAttack and math.random() < (e.kind == "boss" and 0.22 or (e.def.elite and 0.18 or (earlyIdle and 0.05 or 0.12))) then
		f.guarding = true
		f.guardStart = t
		e.guardUntil = t + 0.6 + math.random() * 0.7
		f.model:SetAttribute("Guard", true)
		faceTo(e, tgt.root.Position)
		f.hum:MoveTo(pos)
		return
	end
	-- 한 사람을 한꺼번에 치는 적은 둘까지: 나머지는 둘레를 돌며 차례를 기다린다 (보스와 분신은 예외)
	local waiting = false
	if e.kind ~= "boss" and not e.def.duel then
		local busy = 0
		for _, o in ipairs(Npc.list) do
			if o ~= e and o.target == tgt and not o.f.dead and (o.attackingUntil > t or o.kind == "boss") and flatDist(o.f.root.Position, tgt.root.Position) < 20 then
				busy += 1
			end
		end
		waiting = busy >= Config.MAX_ATTACKERS
	end
	if waiting and t >= e.nextAttack then
		e.nextAttack = t + 0.3 + math.random() * 0.5
	end
	-- 칠 수 있으면 친다
	if t >= e.nextAttack then
		local weak = e.kind ~= "boss" and not e.def.elite and not e.def.duel and e.level <= Config.NO_RED_LEVEL
		local moves = {}
		for _, m in ipairs(e.def.moves) do
			-- 약한 적은 붉은 공격(막을 수 없는 공격)을 쓰지 않는다
			if d <= m.range * (e.def.reach or 1) + 1 and not (weak and m.unblockable) then
				table.insert(moves, m)
			end
		end
		if e.phase2 and e.def.phase2 and e.def.phase2.extra and d <= e.def.phase2.extra.range + 1 then
			table.insert(moves, e.def.phase2.extra)
		end
		if #moves > 0 then
			attack(e, moves[math.random(1, #moves)])
			return
		end
	end
	-- 거리 맞추기: 멀면 다가가고, 가까우면 옆으로 돈다
	local keep = (e.def.keep or 5) + (waiting and 5 or 0)
	local to = tgt.root.Position - pos
	local flatTo = Vector3.new(to.X, 0, to.Z)
	local dir = flatTo.Magnitude > 0.1 and flatTo.Unit or Vector3.new(0, 0, 1)
	-- 동료끼리 겹치지 않게 서로 밀어낸다 (한 덩어리로 뭉치지 않고 둘레로 퍼진다)
	local apart = Vector3.zero
	for _, o in ipairs(Npc.list) do
		if o ~= e and not o.f.dead and o.f.root.Parent then
			local off = pos - o.f.root.Position
			local od = Vector3.new(off.X, 0, off.Z).Magnitude
			if od < 6 and od > 0.05 then
				apart += Vector3.new(off.X, 0, off.Z).Unit * (6 - od)
			end
		end
	end
	if d > keep + 2 then
		f.hum:MoveTo(tgt.root.Position - dir * keep + apart)
	elseif d < keep - 2 then
		f.hum:MoveTo(pos - dir * 4 + apart)
	else
		if math.random() < 0.05 then
			e.strafe = -e.strafe
		end
		local side = Vector3.new(-dir.Z, 0, dir.X) * e.strafe
		f.hum:MoveTo(pos + side * 5 + apart)
		faceTo(e, tgt.root.Position)
	end
end

function Npc.start()
	task.spawn(function()
		while true do
			task.wait(0.1)
			local t = os.clock()
			for _, e in ipairs(Npc.list) do
				local ok, err = pcall(think, e, t)
				if not ok then
					warn("[권왕] 적 생각 오류:", err)
				end
			end
		end
	end)
end

return Npc
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="14">
        <Properties>
          <string name="Name">Skills</string>
          <string name="Source"><![CDATA[-- 권왕: 권법마다 다른 기술 장치 (서버)
-- 기술 정의의 mech = { kind = ... } 를 읽어 그 권법만의 방식으로 친다
--   zone     정해진 자리에 오래 남아 끌어당기거나 피를 빨아들이는 소용돌이
--   reflect  잠깐 모든 공격을 저절로 흘려 되받아치고, 끝에 큰 물결
--   cone     앞쪽 부채꼴 (사자후: 막기를 깬다 / 취화: 불길이 이어진다)
--   drop     가까운 적 자리에 붉은 원이 뜨고, 잠시 뒤 하늘에서 내리찍는다
--   line     앞으로 한 줄로 차례차례 솟는 기둥
--   chainTp  적들 사이를 순간이동하며 차례로 찬다
--   targets  둘레의 적 몇을 골라 그 머리 위로 내리꽂는다 (번개, 별)
--   storm    한동안 둘레 아무 데나 벼락이 쏟아진다
--   freeze   둘레의 시간이 멈추고, 멈춘 적을 한 번에 지운다
--   launch   둘레의 적을 모두 하늘로 띄웠다가 빛으로 내리친다
--   moving   내 몸을 따라다니며 계속 베는 꽃잎 폭풍
--   trail    돌진한 길에 남은 향기가 잠시 뒤 터진다
--   blackhole 하늘에 검은 해가 떠서 둘레의 적을 끌어올려 짓이기고, 끝에 안으로 무너지며 터진다
--   genesis  세상이 멈추고 별바다로 바뀐 뒤, 금이 가고, 유리처럼 깨지며 둘레의 모든 적이 함께 부서진다
--   rewind   지나간 뒤 시간이 거꾸로 돌아 제자리로 돌아오며 지나온 길을 다시 벤다
--   clock    하늘에 해시계, 둘레의 시간이 멎고 열두 번의 종마다 베이며 자정에 깨진다
--   eruption 적마다 발밑에서 불기둥이 솟고, 마지막에 내 자리에서 화산이 터진다
--   shock    기술의 마지막 타격 뒤 앞쪽에 충격파가 터진다 (맨 타격뿐인 기술을 보완)
--   tsunami  하늘을 가리는 해일이 앞으로 밀려가며 적을 휩쓸어 끌고 가고, 끝에서 부서진다
--   eclipse  하늘이 밤이 되고 해와 달이 뜬다. 달빛이 베고, 해와 달이 겹쳐 일식이 되면 빛살이 꿰뚫고, 새벽처럼 터진다
--   sakuraStorm  (초·매화 천본앵) 내 둘레가 벚꽃 칼바람의 소용돌이가 되어 끌어당기며 베고, 한가운데로 모여 터진다
--   sakuraSever  (초·매화 만앵참월, 초 오의) 보이지 않게 적들을 베고 지나가 칼자국을 남기고 → 세상이 잿빛으로 멈추고 →
--                칼바람이 적들을 휘감고 → 마지막에 터지며 화면까지 한칼에 가른다
--   zigzag   (초·취 팔선취보) 갈지자로 비틀비틀 여덟 걸음, 걸음마다 둘레를 후려친다 (그동안 무적)
--   sojuRain (초·취 취몽팔선진) 하늘로 던진 술병이 깨져 술비가 쏟아지고 (적이 굼떠진다), 불이 붙으며 여덟 취선의 그림자가 덮친다
--   drunkRush (초·취 취선만권, 초 오의) 점점 빨라지는 앞구르기 (무적) → 적에서 적으로 옮겨 다니며 와다다다 → 술병을 깨뜨려 터뜨린다
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Combat = require(script.Parent:WaitForChild("Combat"))
local Config = require(ReplicatedStorage:WaitForChild("Config"))

local Skills = {}
local Push: RemoteEvent

function Skills.init(push: RemoteEvent)
	Push = push
end

local function flat(v: Vector3): Vector3
	local f = Vector3.new(v.X, 0, v.Z)
	return f.Magnitude > 1e-3 and f.Unit or Vector3.new(0, 0, -1)
end

local function hostilesNear(f: any, center: Vector3, radius: number): { any }
	local out = {}
	for _, o in pairs(Combat.fighters) do
		if Combat.hostile(f, o) and not o.dead then
			local d = Vector3.new(o.root.Position.X - center.X, 0, o.root.Position.Z - center.Z).Magnitude
			if d <= radius and math.abs(o.root.Position.Y - center.Y) < 30 then
				table.insert(out, o)
			end
		end
	end
	return out
end

local function nearestList(f: any, range: number, n: number): { any }
	local list = hostilesNear(f, f.root.Position, range)
	table.sort(list, function(a, b)
		return (a.root.Position - f.root.Position).Magnitude < (b.root.Position - f.root.Position).Magnitude
	end)
	local out = {}
	for i = 1, math.min(n, #list) do
		out[i] = list[i]
	end
	return out
end

local function scaled(h: any, k: number): any
	local c = table.clone(h)
	c.dmg = (c.dmg or 0) * k
	c.posture = (c.posture or 0) * k
	return c
end

local function strike(f: any, tgt: any, h: any, move: any)
	if tgt.dead or f.dead then
		return
	end
	Combat.applyHit(f, tgt, h, { move = move, isSkill = true, chain = true })
end

local function pullTo(o: any, center: Vector3, power: number)
	local dir = Vector3.new(center.X - o.root.Position.X, 0, center.Z - o.root.Position.Z)
	if dir.Magnitude < 1.5 then
		return
	end
	local vel = dir.Unit * math.min(power, dir.Magnitude * 6)
	if o.player then
		Push:FireClient(o.player, "knock", vel, 0)
	elseif not o.root.Anchored then
		o.root.AssemblyLinearVelocity = vel + Vector3.new(0, o.root.AssemblyLinearVelocity.Y, 0)
	end
end

local function moveTo(f: any, cf: CFrame)
	if f.player and f.player.Character then
		f.player.Character:PivotTo(cf)
	else
		f.root.CFrame = cf
	end
end

local function modelsOf(list: { any }): { Model }
	local out = {}
	for _, o in ipairs(list) do
		if not o.dead and o.root.Parent then
			table.insert(out, o.model)
		end
	end
	return out
end

-- 2.2판: 점에서 (평면) 선분까지의 거리, 선분 둘레의 적, 체력 되찾기, 오른쪽
local function segDist(p: Vector3, a: Vector3, b: Vector3): number
	local ab = Vector3.new(b.X - a.X, 0, b.Z - a.Z)
	local ap = Vector3.new(p.X - a.X, 0, p.Z - a.Z)
	local len2 = ab:Dot(ab)
	local t = len2 > 1e-6 and math.clamp(ap:Dot(ab) / len2, 0, 1) or 0
	return (ap - ab * t).Magnitude
end
local function hostilesOnSeg(f: any, a: Vector3, b: Vector3, width: number): { any }
	local out = {}
	for _, o in pairs(Combat.fighters) do
		if Combat.hostile(f, o) and not o.dead and math.abs(o.root.Position.Y - a.Y) < 30 and segDist(o.root.Position, a, b) <= width then
			table.insert(out, o)
		end
	end
	return out
end
local function heal(f: any, frac: number)
	f.hp = math.min(f.maxHp, f.hp + f.maxHp * frac)
	Combat.sync(f)
end
local function rightOf(v: Vector3): Vector3
	return Vector3.new(-v.Z, 0, v.X)
end

-- 기술 하나의 장치를 돌린다. ctx = { scale, speed }
function Skills.run(f: any, move: any, ctx: any)
	local m = move.mech
	if not m then
		return
	end
	local sp = ctx.speed or 1
	-- 오의(G)는 모두 한층 더 세다. 초 오의(X)는 그보다 더
	local tail = type(move.id) == "string" and string.sub(move.id, -1) or ""
	local isUlt = tail == "G" or tail == "X"
	local sc = (ctx.scale or 1) * (isUlt and Config.ULT_MULT * (1 + (f.mUlt or 0)) or 1) * (tail == "X" and Config.SUPER_ULT_MULT or 1)
	local look = flat(Combat.look(f))
	local style = f.style
	local function alive(): boolean
		return not f.dead and f.root.Parent ~= nil
	end
	local function after(sec: number, fn: () -> ())
		task.delay(sec / sp, function()
			if alive() then
				fn()
			end
		end)
	end
	local hit = m.hit and scaled(m.hit, sc) or nil
	local kind = m.kind

	if kind == "zone" then
		local center = m.at == "self" and f.root.Position or f.root.Position + look * (m.dist or 8)
		Push:FireAllClients("skillfx", { kind = "zone", at = center, radius = m.radius, dur = m.dur / sp, style = style, fx = m.fx })
		local n = math.floor(m.dur / m.every)
		for i = 0, n - 1 do
			after((m.delay or 0) + i * m.every, function()
				local victims = hostilesNear(f, center, m.radius)
				for _, o in ipairs(victims) do
					if m.pull then
						pullTo(o, center, m.pull)
					end
					if hit then
						strike(f, o, hit, move)
					end
				end
				-- 혈해: 적 하나 벨 때마다 체력을 되찾는다
				if m.heal and #victims > 0 then
					f.hp = math.min(f.maxHp, f.hp + f.maxHp * m.heal * #victims)
					Combat.sync(f)
				end
			end)
		end
	elseif kind == "reflect" then
		f.reflectUntil = os.clock() + m.dur / sp
		f.reflectHit = hit
		Push:FireAllClients("skillfx", { kind = "reflect", m = f.model, dur = m.dur / sp, style = style })
		after(m.dur, function()
			Push:FireAllClients("skillfx", { kind = "wave", at = f.root.Position, radius = m.radius, style = style })
			for _, o in ipairs(hostilesNear(f, f.root.Position, m.radius)) do
				strike(f, o, scaled(m.wave, sc), move)
			end
		end)
	elseif kind == "cone" then
		local ticks = m.dur and math.max(1, math.floor(m.dur / m.every)) or 1
		Push:FireAllClients("skillfx", { kind = "cone", m = f.model, range = m.range, angle = m.angle, dur = (m.dur or 0.4) / sp, delay = (m.delay or 0) / sp, style = style, fx = m.fx })
		for i = 0, ticks - 1 do
			after((m.delay or 0) + i * (m.every or 0), function()
				local fwd = flat(Combat.look(f))
				local cosA = math.cos(math.rad(m.angle / 2))
				for _, o in ipairs(hostilesNear(f, f.root.Position, m.range)) do
					local to = flat(o.root.Position - f.root.Position)
					if fwd:Dot(to) >= cosA then
						strike(f, o, hit, move)
						-- 사자후: 막기를 깨부순다
						if m.guardBreak and not o.dead then
							Combat.breakGuard(o)
						end
					end
				end
			end)
		end
	elseif kind == "drop" then
		local tgt = nearestList(f, m.range or 26, 1)[1]
		local at = tgt and tgt.root.Position or f.root.Position + look * (m.dist or 10)
		at = Vector3.new(at.X, f.root.Position.Y, at.Z)
		Push:FireAllClients("skillfx", { kind = "telegraph", at = at, radius = m.radius, time = m.delay / sp, style = style })
		after(m.delay, function()
			Push:FireAllClients("skillfx", { kind = "drop", at = at, radius = m.radius, style = style, fx = m.fx })
			for _, o in ipairs(hostilesNear(f, at, m.radius)) do
				strike(f, o, hit, move)
			end
		end)
	elseif kind == "line" then
		local origin = f.root.Position
		for i = 1, m.count do
			after(m.delay + (i - 1) * m.step, function()
				local p = origin + look * (m.start + (i - 1) * m.spacing)
				Push:FireAllClients("skillfx", { kind = "pillar", at = p, radius = m.radius, style = style, i = i, fx = m.fx, dir = look })
				for _, o in ipairs(hostilesNear(f, p, m.radius)) do
					strike(f, o, hit, move)
				end
			end)
		end
	elseif kind == "chainTp" then
		local list = nearestList(f, m.range, m.n)
		if #list == 0 then
			return
		end
		f.iframeUntil = math.max(f.iframeUntil, os.clock() + (m.delay + #list * m.every + 0.3) / sp)
		for i = 1, m.n do
			local tgt = list[((i - 1) % #list) + 1]
			after(m.delay + (i - 1) * m.every, function()
				if tgt.dead or not tgt.root.Parent then
					return
				end
				-- 상대 등 뒤로 (돌 때마다 다른 쪽으로)
				local a = i * 2.1
				local off = Vector3.new(math.cos(a), 0, math.sin(a)) * 3.5
				local at = tgt.root.Position + off
				local cf = CFrame.lookAt(at + Vector3.new(0, 0.5, 0), Vector3.new(tgt.root.Position.X, at.Y + 0.5, tgt.root.Position.Z))
				if f.player and f.player.Character then
					f.player.Character:PivotTo(cf)
				else
					f.root.CFrame = cf
				end
				Push:FireAllClients("blink", f.model, at)
				Push:FireAllClients("skillfx", { kind = "slash", m = f.model, t = tgt.model, style = style, i = i })
				strike(f, tgt, hit, move)
			end)
		end
	elseif kind == "targets" then
		local list = nearestList(f, m.range, m.n)
		if #list == 0 then
			-- 아무도 없으면 앞에
			Push:FireAllClients("skillfx", { kind = "strike", at = f.root.Position + look * 10, radius = m.radius, style = style, fx = m.fx, delay = m.delay / sp })
			return
		end
		for i, tgt in ipairs(list) do
			local at = tgt.root.Position
			Push:FireAllClients("skillfx", { kind = "mark", at = at, radius = m.radius, time = (m.delay + (i - 1) * (m.stagger or 0)) / sp, style = style })
			after(m.delay + (i - 1) * (m.stagger or 0), function()
				local now = tgt.root.Parent and tgt.root.Position or at
				Push:FireAllClients("skillfx", { kind = "strike", at = now, radius = m.radius, style = style, fx = m.fx })
				for _, o in ipairs(hostilesNear(f, now, m.radius)) do
					strike(f, o, hit, move)
				end
			end)
		end
	elseif kind == "storm" then
		local n = math.floor(m.dur / m.every)
		Push:FireAllClients("skillfx", { kind = "stormcloud", m = f.model, dur = m.dur / sp, radius = m.range, style = style })
		for i = 0, n - 1 do
			after((m.delay or 0) + i * m.every, function()
				local list = hostilesNear(f, f.root.Position, m.range)
				local at
				if #list > 0 then
					at = list[math.random(1, #list)].root.Position
				else
					local a = math.random() * math.pi * 2
					at = f.root.Position + Vector3.new(math.cos(a), 0, math.sin(a)) * math.random(4, m.range)
				end
				Push:FireAllClients("skillfx", { kind = "strike", at = at, radius = m.radius, style = style, fx = "lightning", small = true })
				for _, o in ipairs(hostilesNear(f, at, m.radius)) do
					strike(f, o, hit, move)
				end
			end)
		end
		after((m.delay or 0) + m.dur, function()
			Push:FireAllClients("skillfx", { kind = "strike", at = f.root.Position + look * 4, radius = m.finalRadius, style = style, fx = "lightning" })
			for _, o in ipairs(hostilesNear(f, f.root.Position, m.finalRadius)) do
				strike(f, o, scaled(m.final, sc), move)
			end
		end)
	elseif kind == "freeze" then
		after(m.delay, function()
			local victims = hostilesNear(f, f.root.Position, m.radius)
			local models = {}
			for _, o in ipairs(victims) do
				Combat.stun(o, m.dur)
				o.model:SetAttribute("Frozen", true)
				table.insert(models, o.model)
			end
			Push:FireAllClients("skillfx", { kind = "freeze", at = f.root.Position, radius = m.radius, targets = models, dur = m.dur / sp, style = style })
			after(m.hitAt, function()
				for _, o in ipairs(victims) do
					if o.model.Parent then
						o.model:SetAttribute("Frozen", nil)
					end
					Push:FireAllClients("skillfx", { kind = "erase", t = o.model, style = style })
					strike(f, o, hit, move)
				end
			end)
			task.delay((m.dur + 0.2) / sp, function()
				for _, o in ipairs(victims) do
					if o.model.Parent then
						o.model:SetAttribute("Frozen", nil)
					end
				end
			end)
		end)
	elseif kind == "launch" then
		after(m.delay, function()
			local victims = hostilesNear(f, f.root.Position, m.radius)
			for _, o in ipairs(victims) do
				Combat.stun(o, m.stun or 1.5)
				o.model:SetAttribute("LaunchedAt", os.clock())
				if o.player then
					Push:FireClient(o.player, "knock", Vector3.new(0, m.up, 0), m.stun or 1.5)
				elseif not o.root.Anchored then
					o.root.AssemblyLinearVelocity = Vector3.new(0, m.up, 0)
				end
			end
			Push:FireAllClients("skillfx", { kind = "launch", at = f.root.Position, radius = m.radius, style = style })
			after(m.hitAt, function()
				Push:FireAllClients("skillfx", { kind = "beam", at = f.root.Position, radius = m.radius, style = style })
				for _, o in ipairs(victims) do
					strike(f, o, hit, move)
				end
			end)
		end)
	elseif kind == "moving" then
		Push:FireAllClients("skillfx", { kind = "moving", m = f.model, radius = m.radius, dur = m.dur / sp, style = style })
		local n = math.floor(m.dur / m.every)
		for i = 0, n - 1 do
			after((m.delay or 0) + i * m.every, function()
				for _, o in ipairs(hostilesNear(f, f.root.Position, m.radius)) do
					strike(f, o, hit, move)
				end
			end)
		end
	elseif kind == "avatar" then
		-- 허상 소환 (혈마의 악마, 천룡의 용): 허상이 정해진 순간마다 내리친다
		Push:FireAllClients("skillfx", { kind = "avatar", look = m.look, m = f.model, dur = m.dur / sp, style = style, scale = m.scale })
		for idx, st in ipairs(m.strikes) do
			after(st.t, function()
				local spots = {}
				if st.at == "targets" then
					for _, o in ipairs(nearestList(f, st.range or 30, st.n or 1)) do
						table.insert(spots, o.root.Position)
					end
					if #spots == 0 then
						table.insert(spots, f.root.Position + flat(Combat.look(f)) * 10)
					end
				elseif st.at == "front" then
					table.insert(spots, f.root.Position + flat(Combat.look(f)) * (st.dist or 10))
				else
					table.insert(spots, f.root.Position)
				end
				Push:FireAllClients("skillfx", { kind = "avatarStrike", look = m.look, m = f.model, idx = idx, at = spots, radius = st.radius, style = style, last = idx == #m.strikes })
				local done = {}
				for _, p in ipairs(spots) do
					for _, o in ipairs(hostilesNear(f, p, st.radius)) do
						if not done[o] then
							done[o] = true
							strike(f, o, scaled(st.hit, sc), move)
						end
					end
				end
			end)
		end
	elseif kind == "blackhole" then
		-- 흑일강림: 앞 하늘에 검은 해. 둘레의 적이 끌려 올라가 매달린 채 짓이겨진다
		local center = f.root.Position + look * (m.dist or 12)
		local sky = center + Vector3.new(0, m.height or 16, 0)
		Push:FireAllClients("skillfx", { kind = "blackhole", at = center, height = m.height or 16, radius = m.radius, dur = m.dur / sp, delay = (m.delay or 0) / sp, style = style })
		local n = math.max(1, math.floor(m.dur / m.every))
		for i = 0, n - 1 do
			after((m.delay or 0) + i * m.every, function()
				for _, o in ipairs(hostilesNear(f, center, m.radius)) do
					if not o.player and not o.root.Anchored then
						local d = sky - o.root.Position
						o.root.AssemblyLinearVelocity = d.Magnitude > 1 and d.Unit * math.min(70, d.Magnitude * 5) or Vector3.zero
					elseif o.player then
						pullTo(o, center, 30)
					end
					Combat.stun(o, m.every + 0.25)
					if hit then
						strike(f, o, hit, move)
					end
				end
			end)
		end
		after((m.delay or 0) + m.dur, function()
			Push:FireAllClients("skillfx", { kind = "blackholeBurst", at = sky, radius = m.radius, style = style })
			for _, o in ipairs(hostilesNear(f, center, m.radius + 6)) do
				strike(f, o, scaled(m.final, sc), move)
			end
		end)
	elseif kind == "genesis" then
		-- 천지개벽: 둘레의 시간이 멈추고(모두 묶인다), 세상에 금이 가고, 깨진다
		local center = f.root.Position
		local list = hostilesNear(f, center, m.radius)
		local models = {}
		for _, o in ipairs(list) do
			Combat.stun(o, m.freeze / sp)
			if not o.player and not o.root.Anchored then
				o.root.AssemblyLinearVelocity = Vector3.zero
			end
			table.insert(models, o.model)
		end
		f.iframeUntil = math.max(f.iframeUntil, os.clock() + m.breakAt / sp + 0.3)
		Push:FireAllClients("skillfx", { kind = "genesis", m = f.model, at = center, radius = m.radius, targets = models, dur = m.freeze / sp, crackAt = m.crackAt / sp, breakAt = m.breakAt / sp, style = style })
		after(m.breakAt, function()
			for _, o in ipairs(hostilesNear(f, center, m.radius)) do
				strike(f, o, scaled(m.final, sc), move)
			end
		end)
	elseif kind == "rewind" then
		local start = f.root.Position
		after(m.delay, function()
			local now = f.root.Position
			Push:FireAllClients("skillfx", { kind = "rewind", m = f.model, from = now, to = start, radius = m.radius, style = style })
			local rot = f.root.CFrame - f.root.CFrame.Position
			if f.player and f.player.Character then
				f.player.Character:PivotTo(CFrame.new(start) * rot)
			else
				f.root.CFrame = CFrame.new(start) * rot
			end
			f.iframeUntil = math.max(f.iframeUntil, os.clock() + 0.3)
			-- 지나온 길 (선분) 가까이의 적을 다시 벤다
			local seg = now - start
			local len = seg.Magnitude
			for _, o in ipairs(hostilesNear(f, (start + now) / 2, len / 2 + m.radius)) do
				local p = o.root.Position - start
				local k = len > 0.1 and math.clamp(p:Dot(seg) / (len * len), 0, 1) or 0
				if (p - seg * k).Magnitude <= m.radius + 1 then
					strike(f, o, hit, move)
				end
			end
		end)
	elseif kind == "clock" then
		-- 만겁귀환: 둘레의 시간이 멎고 (모두 묶인다) 열두 번의 종, 자정에 깨진다
		local center = f.root.Position
		local total = m.delay + m.bells * m.every + 0.25
		f.iframeUntil = math.max(f.iframeUntil, os.clock() + total / sp + 0.2)
		for _, o in ipairs(hostilesNear(f, center, m.radius)) do
			Combat.stun(o, total / sp + 0.4)
			if not o.player and not o.root.Anchored then
				o.root.AssemblyLinearVelocity = Vector3.zero
			end
		end
		Push:FireAllClients("skillfx", { kind = "clock", m = f.model, at = center, radius = m.radius, delay = m.delay / sp, bells = m.bells, every = m.every / sp, style = style })
		for i = 1, m.bells do
			after(m.delay + (i - 1) * m.every, function()
				for _, o in ipairs(hostilesNear(f, center, m.radius)) do
					strike(f, o, hit, move)
				end
			end)
		end
		after(total, function()
			for _, o in ipairs(hostilesNear(f, center, m.radius)) do
				strike(f, o, scaled(m.final, sc), move)
			end
		end)
	elseif kind == "eruption" then
		-- 열화천멸: 적마다 발밑에서 불기둥, 마지막에 내 자리에서 화산
		local center = f.root.Position
		local list = hostilesNear(f, center, m.radius)
		local spots = {}
		for _, o in ipairs(list) do
			table.insert(spots, o.root.Position)
		end
		Push:FireAllClients("skillfx", { kind = "eruption", m = f.model, at = center, spots = spots, delay = m.delay / sp, stagger = m.stagger / sp, finalAt = m.finalAt / sp, finalRadius = m.finalRadius, style = style })
		local pillar = scaled(m.pillar, sc)
		for i, o in ipairs(list) do
			after(m.delay + (i - 1) * m.stagger, function()
				if not o.dead then
					strike(f, o, pillar, move)
				end
			end)
		end
		after(m.finalAt, function()
			for _, o in ipairs(hostilesNear(f, center, m.finalRadius)) do
				strike(f, o, scaled(m.final, sc), move)
			end
		end)
	elseif kind == "shock" then
		after(m.delay or 0.2, function()
			local at = f.root.Position + flat(Combat.look(f)) * (m.dist or 4)
			Push:FireAllClients("skillfx", { kind = "shock", at = at, radius = m.radius, style = style })
			for _, o in ipairs(hostilesNear(f, at, m.radius)) do
				strike(f, o, hit, move)
			end
		end)
	elseif kind == "tsunami" then
		-- 창해일소: 너비 width의 물의 벽이 앞으로 speed로 밀려간다. 벽 안의 적은 함께 끌려가며 계속 맞는다
		local origin = f.root.Position
		local right = Vector3.new(-look.Z, 0, look.X)
		local from = origin + look * m.start
		Push:FireAllClients("skillfx", { kind = "tsunami", from = from, dir = look, width = m.width, speed = m.speed * sp, dur = m.dur / sp, delay = m.delay / sp, style = style })
		local n = math.max(1, math.floor(m.dur / m.every))
		for i = 0, n - 1 do
			after(m.delay + i * m.every, function()
				local front = from + look * (m.speed * i * m.every)
				for _, o in ipairs(hostilesNear(f, front, m.width / 2 + m.depth)) do
					local rel = o.root.Position - front
					local along, side = rel:Dot(look), rel:Dot(right)
					if math.abs(side) <= m.width / 2 and along >= -m.depth and along <= m.depth then
						if o.player then
							Push:FireClient(o.player, "knock", look * m.speed + Vector3.new(0, 6, 0), 0.3)
						elseif not o.root.Anchored then
							o.root.AssemblyLinearVelocity = look * (m.speed * 1.15) + Vector3.new(0, 8, 0)
						end
						Combat.stun(o, m.every + 0.2)
						strike(f, o, hit, move)
					end
				end
			end)
		end
		after(m.delay + m.dur, function()
			local at = from + look * (m.speed * m.dur)
			Push:FireAllClients("skillfx", { kind = "tsunamiCrash", at = at, radius = m.finalRadius, style = style })
			for _, o in ipairs(hostilesNear(f, at, m.finalRadius)) do
				strike(f, o, scaled(m.final, sc), move)
			end
		end)
	elseif kind == "eclipse" then
		-- 일월동천: 달빛 베기 → 일식 (모두 묶인다) → 검은 해의 빛살 → 새벽의 폭발
		local center = f.root.Position
		local R = m.radius
		f.iframeUntil = math.max(f.iframeUntil, os.clock() + m.finalAt / sp + 0.3)
		Push:FireAllClients("skillfx", { kind = "eclipse", m = f.model, at = center, radius = R, style = style,
			slashes = m.slashes, slashFrom = m.slashFrom / sp, slashEvery = m.slashEvery / sp,
			eclipseAt = m.eclipseAt / sp, beamAt = m.beamAt / sp, finalAt = m.finalAt / sp })
		for i = 0, m.slashes - 1 do
			after(m.slashFrom + i * m.slashEvery, function()
				for _, o in ipairs(hostilesNear(f, center, R)) do
					strike(f, o, scaled(m.slash, sc), move)
				end
			end)
		end
		after(m.bindAt, function()
			for _, o in ipairs(hostilesNear(f, center, R)) do
				Combat.stun(o, (m.finalAt - m.bindAt) / sp + 0.4)
				if not o.player and not o.root.Anchored then
					o.root.AssemblyLinearVelocity = Vector3.zero
				end
			end
		end)
		after(m.beamAt, function()
			local spots = {}
			local list = hostilesNear(f, center, R)
			for _, o in ipairs(list) do
				table.insert(spots, o.root.Position)
			end
			Push:FireAllClients("skillfx", { kind = "eclipseBeams", at = center, spots = spots, style = style })
			for _, o in ipairs(list) do
				strike(f, o, scaled(m.beam, sc), move)
			end
		end)
		after(m.finalAt, function()
			for _, o in ipairs(hostilesNear(f, center, R + 6)) do
				strike(f, o, scaled(m.final, sc), move)
			end
		end)
	elseif kind == "clones" then
		-- 그림자 분신: 둘레의 적마다 분신이 하나씩 나타나 동시에 찬다 (나는 그 자리에)
		local list = nearestList(f, m.range, m.n)
		local models = {}
		for _, o in ipairs(list) do
			table.insert(models, o.model)
		end
		Push:FireAllClients("skillfx", { kind = "clones", m = f.model, targets = models, style = style, every = m.every / sp, delay = m.delay / sp })
		for i, o in ipairs(list) do
			for k = 0, (m.hitsEach or 2) - 1 do
				after(m.delay + (i - 1) * m.every + k * 0.25, function()
					strike(f, o, hit, move)
				end)
			end
		end
	elseif kind == "giant" then
		-- 금강 법신: 내 몸이 금빛 거인이 된다 (안 밀리고, 받는 피해 절반, 주먹 1.6배 + 여진)
		local dur = m.dur
		f.buffs.giant = os.clock() + dur
		f.model:SetAttribute("Giant", true)
		local char = f.player and f.player.Character
		pcall(function()
			(char :: any):ScaleTo(m.scale or 2.4)
		end)
		after(m.delay or 0.4, function()
			Push:FireAllClients("skillfx", { kind = "stomp", at = f.root.Position, radius = m.radius, style = style })
			for _, o in ipairs(hostilesNear(f, f.root.Position, m.radius)) do
				strike(f, o, hit, move)
			end
		end)
		task.delay(dur, function()
			if f.model.Parent then
				f.model:SetAttribute("Giant", nil)
			end
			pcall(function()
				(char :: any):ScaleTo(1)
			end)
		end)
	elseif kind == "lake" then
		-- 태허: 발밑이 호수가 되어 소용돌이가 모두 삼키고, 마지막에 물기둥이 솟는다
		local center = f.root.Position
		Push:FireAllClients("skillfx", { kind = "lake", at = center, radius = m.radius, dur = m.dur / sp, style = style })
		local n = math.floor(m.dur / m.every)
		for i = 0, n - 1 do
			after(0.2 + i * m.every, function()
				for _, o in ipairs(hostilesNear(f, center, m.radius)) do
					pullTo(o, center, m.pull)
					strike(f, o, hit, move)
				end
			end)
		end
		after(0.2 + m.dur, function()
			Push:FireAllClients("skillfx", { kind = "geyser", at = center, radius = m.geyserRadius, style = style })
			for _, o in ipairs(hostilesNear(f, center, m.geyserRadius)) do
				Combat.stun(o, 1.4)
				o.model:SetAttribute("LaunchedAt", os.clock())
				if o.player then
					Push:FireClient(o.player, "knock", Vector3.new(0, 80, 0), 1.4)
				elseif not o.root.Anchored then
					o.root.AssemblyLinearVelocity = Vector3.new(0, 80, 0)
				end
				strike(f, o, scaled(m.geyser, sc), move)
			end
		end)
	elseif kind == "sakuraStorm" then
		Push:FireAllClients("skillfx", { kind = "sakuraStorm", m = f.model, at = f.root.Position, radius = m.radius, dur = (m.delay + m.dur) / sp, style = style })
		local n = math.floor(m.dur / m.every)
		for i = 0, n - 1 do
			after(m.delay + i * m.every, function()
				local c = f.root.Position
				for _, o in ipairs(hostilesNear(f, c, m.radius)) do
					pullTo(o, c, m.pull)
					strike(f, o, hit, move)
				end
			end)
		end
		after(m.delay + m.dur, function()
			local c = f.root.Position
			Push:FireAllClients("skillfx", { kind = "sakuraBurst", at = c, radius = m.radius, style = style })
			for _, o in ipairs(hostilesNear(f, c, m.radius + 4)) do
				strike(f, o, scaled(m.final, sc), move)
			end
		end)
	elseif kind == "sakuraSever" then
		local list = nearestList(f, m.range, m.n)
		local start = f.root.Position
		local pass = m.delay + math.max(1, #list) * m.every
		local total = pass + m.still + m.wind + 0.5
		f.iframeUntil = math.max(f.iframeUntil, os.clock() + total / sp)
		f.model:SetAttribute("Vanish", true)
		Push:FireAllClients("skillfx", { kind = "severStart", m = f.model, at = start, dur = total / sp, style = style })
		-- 도중에 쓰러져도 모습은 돌아온다
		task.delay(pass / sp + 0.2, function()
			if f.model.Parent then
				f.model:SetAttribute("Vanish", nil)
			end
		end)
		-- 1) 보이지 않게 베고 지나간다 (하늘에 칼자국)
		local points = { start }
		for i, o in ipairs(list) do
			after(m.delay + (i - 1) * m.every, function()
				local from = f.root.Position
				local tp = o.root.Parent and o.root.Position or from
				local dir = flat(tp - from)
				local land = tp + dir * 5
				local cf = CFrame.lookAt(land, land + dir)
				if f.player and f.player.Character then
					f.player.Character:PivotTo(cf)
				else
					f.root.CFrame = cf
				end
				table.insert(points, land)
				Push:FireAllClients("skillfx", { kind = "severCut", from = from, to = land, at = tp, style = style, i = i })
				strike(f, o, scaled(m.cut, sc), move)
			end)
		end
		local function targetModels(): { Model }
			local out = {}
			for _, o in ipairs(list) do
				if not o.dead and o.root.Parent then
					table.insert(out, o.model)
				end
			end
			return out
		end
		-- 2) 세상이 잿빛으로 멈춘다
		after(pass, function()
			f.model:SetAttribute("Vanish", nil)
			Push:FireAllClients("skillfx", { kind = "severStill", m = f.model, at = f.root.Position, dur = m.still / sp, points = points, style = style })
			for _, o in ipairs(list) do
				if not o.dead then
					o.stunUntil = math.max(o.stunUntil, os.clock() + (m.still + m.wind + 0.4) / sp)
				end
			end
		end)
		-- 3) 칼바람이 일어 적들을 휘감는다
		after(pass + m.still, function()
			Push:FireAllClients("skillfx", { kind = "severWind", m = f.model, at = f.root.Position, targets = targetModels(), dur = m.wind / sp, style = style })
			local n = math.floor(m.wind / m.windEvery)
			for i = 0, n - 1 do
				after(i * m.windEvery, function()
					for _, o in ipairs(list) do
						if not o.dead and o.root.Parent then
							strike(f, o, scaled(m.windHit, sc), move)
						end
					end
				end)
			end
		end)
		-- 4) 터지며 한칼에 가른다
		after(pass + m.still + m.wind, function()
			local c = f.root.Position
			Push:FireAllClients("skillfx", { kind = "severEnd", m = f.model, at = c, targets = targetModels(), radius = m.finalRadius, style = style })
			local hitSet = {}
			for _, o in ipairs(list) do
				if not o.dead and o.root.Parent then
					hitSet[o] = true
					strike(f, o, scaled(m.final, sc), move)
				end
			end
			for _, o in ipairs(hostilesNear(f, c, m.finalRadius)) do
				if not hitSet[o] then
					strike(f, o, scaled(m.final, sc * 0.6), move)
				end
			end
		end)
	elseif kind == "zigzag" then
		local start = f.root.Position
		local right = Vector3.new(-look.Z, 0, look.X)
		local total = m.delay + m.n * m.every
		f.iframeUntil = math.max(f.iframeUntil, os.clock() + (total + 0.15) / sp)
		Push:FireAllClients("skillfx", { kind = "zigzagStart", m = f.model, dur = total / sp, style = style })
		for i = 1, m.n do
			after(m.delay + (i - 1) * m.every, function()
				local from = f.root.Position
				local side = i % 2 == 1 and 1 or -1
				local to = start + look * (m.step * i) + right * (side * m.side * (0.6 + math.random() * 0.5))
				to = Vector3.new(to.X, from.Y, to.Z)
				moveTo(f, CFrame.lookAt(to, to + flat(to - from)))
				Push:FireAllClients("skillfx", { kind = "zigzagStep", m = f.model, from = from, to = to, style = style, i = i })
				for _, o in ipairs(hostilesNear(f, to, m.radius)) do
					strike(f, o, hit, move)
				end
			end)
		end
	elseif kind == "sojuRain" then
		local c = f.root.Position
		Push:FireAllClients("skillfx", { kind = "sojuThrow", m = f.model, at = c, radius = m.radius, delay = m.delay / sp, rain = m.rain / sp, style = style })
		local n = math.floor(m.rain / m.every)
		for i = 0, n - 1 do
			after(m.delay + i * m.every, function()
				for _, o in ipairs(hostilesNear(f, c, m.radius)) do
					o.slowUntil = os.clock() + 1
					o.slowMul = m.slow
					strike(f, o, hit, move)
				end
			end)
		end
		after(m.delay + m.rain, function()
			local list = hostilesNear(f, c, m.radius + 2)
			Push:FireAllClients("skillfx", { kind = "sojuIgnite", m = f.model, at = c, radius = m.radius, ghosts = m.ghosts, targets = modelsOf(list), style = style })
			after(0.35, function()
				for _, o in ipairs(list) do
					if not o.dead and o.root.Parent then
						strike(f, o, scaled(m.final, sc), move)
					end
				end
			end)
		end)
	elseif kind == "drunkRush" then
		local start = f.root.Position
		f.iframeUntil = math.max(f.iframeUntil, os.clock() + (m.cut + 0.15) / sp)
		Push:FireAllClients("skillfx", { kind = "rushCut", m = f.model, dur = m.cut / sp, style = style })
		-- 1) 점점 빨라지는 앞구르기 (컷씬, 무적)
		local steps = 12
		for k = 1, steps do
			after(m.cut * k / steps, function()
				local u = k / steps
				local p = start + look * (m.roll * u * u)
				local at = Vector3.new(p.X, f.root.Position.Y, p.Z)
				moveTo(f, CFrame.lookAt(at, at + look))
			end)
		end
		-- 2) 와다다다: 적에서 적으로 옮겨 다니며 주먹을 퍼붓는다
		after(m.cut, function()
			local list = nearestList(f, m.range, m.n)
			Push:FireAllClients("skillfx", { kind = "rushFlurry", m = f.model, dur = m.rush / sp, targets = modelsOf(list), style = style })
			local ticks = math.floor(m.rush / m.every)
			local hopEvery = math.max(1, math.floor(m.hop / m.every))
			local idx = 0
			for i = 0, ticks - 1 do
				after(i * m.every, function()
					if i % hopEvery == 0 and #list > 0 then
						for _ = 1, #list do
							idx = idx % #list + 1
							local tgt = list[idx]
							if not tgt.dead and tgt.root.Parent then
								local tp = tgt.root.Position
								local dir = flat(tp - f.root.Position)
								local at = Vector3.new(tp.X, f.root.Position.Y, tp.Z) - dir * 3.2
								moveTo(f, CFrame.lookAt(at, at + dir))
								Push:FireAllClients("blink", f.model, at)
								break
							end
						end
					end
					local fwd = flat(Combat.look(f))
					for _, o in ipairs(hostilesNear(f, f.root.Position + fwd * 3, m.reach)) do
						o.stunUntil = math.max(o.stunUntil, os.clock() + 0.25)
						strike(f, o, hit, move)
					end
				end)
			end
		end)
		-- 3) 술병을 깨뜨려 터뜨린다
		after(m.cut + m.rush, function()
			local c = f.root.Position + flat(Combat.look(f)) * 3
			Push:FireAllClients("skillfx", { kind = "rushEnd", m = f.model, at = c, radius = m.finalRadius, style = style })
			for _, o in ipairs(hostilesNear(f, c, m.finalRadius)) do
				strike(f, o, scaled(m.final, sc), move)
			end
		end)
	elseif kind == "flash" or kind == "bolt" then
		-- 매화 일순천참: 보이지 않게 모두를 꿰뚫고 지나간 뒤, 한 박자 늦게 한꺼번에 베인다
		-- 벽력 뇌신화: 번개가 되어 적에서 적으로 튀며, 닿는 순간마다 벼락
		local list = nearestList(f, m.range, m.n)
		if #list == 0 then
			return
		end
		local start = f.root.Position
		local total = m.delay + #list * m.every
		f.iframeUntil = math.max(f.iframeUntil, os.clock() + (total + 0.4) / sp)
		f.model:SetAttribute("Vanish", true)
		Push:FireAllClients("skillfx", { kind = kind == "flash" and "flashStart" or "boltStart", m = f.model, dur = (total + 0.5) / sp, style = style })
		local points = { start }
		for i, o in ipairs(list) do
			after(m.delay + (i - 1) * m.every, function()
				local from = f.root.Position
				local tp = o.root.Parent and o.root.Position or from
				local dir = flat(tp - from)
				local land = tp + dir * 4
				local cf = CFrame.lookAt(land, land + dir)
				if f.player and f.player.Character then
					f.player.Character:PivotTo(cf)
				else
					f.root.CFrame = cf
				end
				table.insert(points, land)
				Push:FireAllClients("skillfx", { kind = kind == "flash" and "flashCut" or "boltJump", from = from, to = land, at = tp, style = style, i = i })
				if kind == "bolt" then
					for _, v in ipairs(hostilesNear(f, tp, m.radius or 6)) do
						strike(f, v, hit, move)
					end
				end
			end)
		end
		after(total + (kind == "flash" and 0.45 or 0.1), function()
			f.model:SetAttribute("Vanish", nil)
			if kind == "flash" then
				Push:FireAllClients("skillfx", { kind = "flashBurst", points = points, targets = (function()
					local out = {}
					for _, o in ipairs(list) do
						table.insert(out, o.model)
					end
					return out
				end)(), style = style })
				for _, o in ipairs(list) do
					strike(f, o, hit, move)
				end
			else
				Push:FireAllClients("skillfx", { kind = "strike", at = f.root.Position, radius = m.finalRadius, style = style, fx = "lightning" })
				for _, o in ipairs(hostilesNear(f, f.root.Position, m.finalRadius)) do
					strike(f, o, scaled(m.final, sc), move)
				end
			end
		end)
	elseif kind == "pinball" then
		-- 취선 굴렁쇠: 불덩이가 되어 적에서 적으로 튕겨 다니며 터진다
		local list = nearestList(f, m.range, m.n)
		Push:FireAllClients("skillfx", { kind = "fireball", m = f.model, dur = (m.delay + m.n * m.every + 0.3) / sp, style = style })
		f.iframeUntil = math.max(f.iframeUntil, os.clock() + (m.delay + m.n * m.every) / sp)
		for i = 1, m.n do
			local o = list[((i - 1) % math.max(1, #list)) + 1]
			after(m.delay + (i - 1) * m.every, function()
				local from = f.root.Position
				local to = o and o.root.Parent and o.root.Position or from + flat(Combat.look(f)) * 12
				-- 굴러가는 길을 몇 토막으로 나눠 움직인다
				for k = 1, 4 do
					task.delay(k * m.every / 5 / sp, function()
						if f.dead then
							return
						end
						local p = from:Lerp(to, k / 4)
						local dir = flat(to - from)
						local cf = CFrame.lookAt(p, p + dir)
						if f.player and f.player.Character then
							f.player.Character:PivotTo(cf)
						else
							f.root.CFrame = cf
						end
					end)
				end
				task.delay(m.every * 0.8 / sp, function()
					Push:FireAllClients("skillfx", { kind = "burst", at = to, radius = m.radius, style = style, i = i })
					for _, v in ipairs(hostilesNear(f, to, m.radius)) do
						strike(f, v, hit, move)
					end
				end)
			end)
		end
		after(m.delay + m.n * m.every + 0.1, function()
			Push:FireAllClients("skillfx", { kind = "burst", at = f.root.Position, radius = m.finalRadius, style = style, big = true })
			for _, v in ipairs(hostilesNear(f, f.root.Position, m.finalRadius)) do
				strike(f, v, scaled(m.final, sc), move)
			end
		end)
	elseif kind == "onepunch" then
		-- 삼재 일권: 모든 것을 한 주먹에 모았다가, 앞으로 단 한 번
		Push:FireAllClients("skillfx", { kind = "charge", m = f.model, time = m.delay / sp, style = style })
		after(m.delay, function()
			local fwd = flat(Combat.look(f))
			Push:FireAllClients("skillfx", { kind = "onepunch", m = f.model, from = f.root.Position, dir = fwd, range = m.range, style = style })
			local cosA = math.cos(math.rad(m.angle / 2))
			for _, o in ipairs(hostilesNear(f, f.root.Position, m.range)) do
				if fwd:Dot(flat(o.root.Position - f.root.Position)) >= cosA then
					strike(f, o, hit, move)
				end
			end
		end)
	elseif kind == "swords" then
		-- 천제 만검: 하늘의 문에서 빛의 검이 적마다 떨어지고, 마지막에 거대한 검이 꽂혀 터진다
		Push:FireAllClients("skillfx", { kind = "skygate", m = f.model, dur = m.dur / sp, style = style })
		local list = nearestList(f, m.range, m.n)
		for i = 1, m.n do
			local o = list[((i - 1) % math.max(1, #list)) + 1]
			after(m.delay + (i - 1) * m.stagger, function()
				local at
				if o and o.root.Parent then
					at = o.root.Position
				else
					local a = math.random() * math.pi * 2
					at = f.root.Position + Vector3.new(math.cos(a), 0, math.sin(a)) * math.random(4, 16)
				end
				Push:FireAllClients("skillfx", { kind = "sword", at = at, radius = m.radius, style = style })
				task.delay(0.22 / sp, function()
					for _, v in ipairs(hostilesNear(f, at, m.radius)) do
						strike(f, v, hit, move)
					end
				end)
			end)
		end
		after(m.bigAt, function()
			local tgt = nearestList(f, m.range, 1)[1]
			local at = tgt and tgt.root.Position or f.root.Position + flat(Combat.look(f)) * 12
			Push:FireAllClients("skillfx", { kind = "telegraph", at = at, radius = m.bigRadius, time = 0.5 / sp, style = style })
			after(0.5, function()
				Push:FireAllClients("skillfx", { kind = "sword", at = at, radius = m.bigRadius, style = style, big = true })
				task.delay(0.25 / sp, function()
					for _, v in ipairs(hostilesNear(f, at, m.bigRadius)) do
						strike(f, v, scaled(m.big, sc), move)
					end
				end)
			end)
		end)
	elseif kind == "tornado" then
		-- 풍신: 거대한 회오리가 앞으로 나아가며 모두 빨아올렸다가 사방으로 내던진다
		local dir = flat(Combat.look(f))
		local from = f.root.Position + dir * (m.dist or 8)
		Push:FireAllClients("skillfx", { kind = "tornado", from = from, dir = dir, speed = m.speed * sp, dur = m.dur / sp, radius = m.radius, style = style })
		local n = math.floor(m.dur / m.every)
		local caught = {}
		for i = 0, n - 1 do
			after(i * m.every, function()
				local c = from + dir * (m.speed * i * m.every)
				for _, o in ipairs(hostilesNear(f, c, m.radius)) do
					caught[o] = true
					pullTo(o, c, 30)
					if not o.player and not o.root.Anchored then
						o.root.AssemblyLinearVelocity += Vector3.new(0, 16, 0)
					end
					Combat.stun(o, 0.4)
					strike(f, o, hit, move)
				end
			end)
		end
		after(m.dur, function()
			local c = from + dir * (m.speed * m.dur)
			Push:FireAllClients("skillfx", { kind = "wave", at = c, radius = m.radius * 1.6, style = style })
			for o in pairs(caught) do
				if not o.dead then
					local out = flat(o.root.Position - c)
					if o.player then
						Push:FireClient(o.player, "knock", out * 60 + Vector3.new(0, 30, 0), 1)
					elseif not o.root.Anchored then
						o.root.AssemblyLinearVelocity = out * 60 + Vector3.new(0, 30, 0)
					end
					strike(f, o, scaled(m.final, sc), move)
				end
			end
		end)
	elseif kind == "arena" then
		-- 천하무쌍: 빛의 울타리 안에 가두고 한가운데로 끌어당겨 여러 번 몰아친 뒤, 마지막 한 주먹
		local center = f.root.Position
		Push:FireAllClients("skillfx", { kind = "arena", m = f.model, at = center, radius = m.radius, delay = m.delay / sp, strikes = m.strikeCount, every = m.every / sp, finalAt = m.finalAt / sp, style = style })
		after(m.delay * 0.5, function()
			for _, o in ipairs(hostilesNear(f, center, m.radius)) do
				pullTo(o, center + look * 4, 110)
			end
		end)
		for i = 0, m.strikeCount - 1 do
			after(m.delay + i * m.every, function()
				for _, o in ipairs(hostilesNear(f, center, m.strikeRadius)) do
					strike(f, o, hit, move)
				end
			end)
		end
		after(m.finalAt, function()
			for _, o in ipairs(hostilesNear(f, center, m.strikeRadius + 4)) do
				strike(f, o, scaled(m.final, sc), move)
			end
		end)
	elseif kind == "galaxy" then
		-- 성하강림: 머리 위에 은하가 열리고, 별이 안에서 밖으로 나선을 그리며 떨어진 뒤, 한가운데에서 별이 터진다
		local center = f.root.Position
		local pts = {}
		for i = 1, m.count do
			local a = i * 0.95
			local r = m.radius * (0.15 + 0.85 * i / m.count)
			table.insert(pts, center + Vector3.new(math.cos(a) * r, 0, math.sin(a) * r))
		end
		Push:FireAllClients("skillfx", { kind = "galaxy", m = f.model, at = center, radius = m.radius, points = pts, delay = m.delay / sp, stagger = m.stagger / sp, finalAt = m.finalAt / sp, finalRadius = m.finalRadius, style = style })
		-- 처음에 둘레의 적을 가운데로 끌어당긴다
		for _, o in ipairs(hostilesNear(f, center, m.radius)) do
			pullTo(o, center, 60)
		end
		for i, p in ipairs(pts) do
			after(m.delay + (i - 1) * m.stagger, function()
				for _, o in ipairs(hostilesNear(f, p, m.strikeRadius)) do
					strike(f, o, hit, move)
				end
			end)
		end
		after(m.finalAt, function()
			for _, o in ipairs(hostilesNear(f, center, m.finalRadius)) do
				strike(f, o, scaled(m.final, sc), move)
			end
		end)
	elseif kind == "subspace" then
		-- 아공간: 그 자리에 바깥과 끊긴 공간을 연다. 안의 적은 빠져나가지 못하고 (가장자리에서 끌려 들어온다), 사방에서 베인다
		local center = f.root.Position
		local R = m.radius
		local delay = m.delay or 0
		Push:FireAllClients("skillfx", { kind = "subspace", m = f.model, at = center, radius = R, dur = m.dur / sp, delay = delay / sp, every = m.every / sp, style = style })
		local n = math.floor((m.dur - delay) / m.every)
		for i = 0, n - 1 do
			after(delay + i * m.every, function()
				for _, o in ipairs(hostilesNear(f, center, R * 1.15)) do
					local off = o.root.Position - center
					if Vector3.new(off.X, 0, off.Z).Magnitude > R * 0.75 then
						pullTo(o, center, 70)
					end
					strike(f, o, hit, move)
				end
			end)
		end
		after(m.dur, function()
			for _, o in ipairs(hostilesNear(f, center, R * 1.2)) do
				strike(f, o, scaled(m.final, sc), move)
			end
		end)
	elseif kind == "trail" then
		local from = f.root.Position
		after(m.delay, function()
			local to = f.root.Position
			local pts = {}
			for k = 0, m.count - 1 do
				table.insert(pts, from:Lerp(to, (k + 0.5) / m.count))
			end
			Push:FireAllClients("skillfx", { kind = "trail", points = pts, radius = m.radius, style = style, fx = m.fx })
			local done = {}
			for _, p in ipairs(pts) do
				for _, o in ipairs(hostilesNear(f, p, m.radius)) do
					if not done[o] then
						done[o] = true
						strike(f, o, hit, move)
					end
				end
			end
		end)
	elseif kind == "palm" then
		-- 1.9판 만불조종: 하늘에서 산만 한 금빛 손바닥이 내려와 둘레를 누르고, 땅이 몇 번 더 울린다
		local center = f.root.Position
		Push:FireAllClients("skillfx", { kind = "buddhaPalm", at = center, radius = m.radius, delay = m.delay / sp, quakes = m.quakes, every = m.every / sp, style = style })
		f.iframeUntil = math.max(f.iframeUntil, os.clock() + (m.delay + 0.3) / sp)
		after(m.delay, function()
			for _, o in ipairs(hostilesNear(f, center, m.radius)) do
				strike(f, o, hit, move)
				if not o.dead then
					Combat.stun(o, 1.6)
				end
			end
			for q = 1, m.quakes do
				after(q * m.every, function()
					for _, o in ipairs(hostilesNear(f, center, m.radius * (1 + q * 0.15))) do
						strike(f, o, scaled(m.quake, sc), move)
					end
				end)
			end
		end)
	elseif kind == "parade" then
		-- 1.9판 백귀야행: 그림자들이 둘레를 엇갈려 가로지르며 짓밟고, 마지막에 한가운데로 모여 걷어찬다
		local center = f.root.Position
		local total = m.delay + m.passes * m.every + 0.5
		f.iframeUntil = math.max(f.iframeUntil, os.clock() + total / sp)
		Push:FireAllClients("skillfx", { kind = "paradeStart", m = f.model, at = center, radius = m.radius, ghosts = m.ghosts, dur = total / sp, style = style })
		for i = 1, m.passes do
			after(m.delay + (i - 1) * m.every, function()
				local list = hostilesNear(f, center, m.radius)
				local through = #list > 0 and list[math.random(1, #list)].root.Position or center
				local a = math.random() * math.pi * 2
				local dir = Vector3.new(math.cos(a), 0, math.sin(a))
				local from = through - dir * m.radius
				local to = through + dir * m.radius
				Push:FireAllClients("skillfx", { kind = "paradePass", from = from, to = to, dur = m.every * 1.6 / sp, style = style, i = i })
				for _, o in ipairs(list) do
					local rel = o.root.Position - from
					local along = rel:Dot(dir)
					local side = rel - dir * along
					if along >= -2 and along <= m.radius * 2 + 2 and Vector3.new(side.X, 0, side.Z).Magnitude <= m.width then
						strike(f, o, hit, move)
					end
				end
			end)
		end
		after(m.delay + m.passes * m.every + 0.15, function()
			Push:FireAllClients("skillfx", { kind = "paradeEnd", at = center, radius = m.finalRadius, style = style })
			for _, o in ipairs(hostilesNear(f, center, m.finalRadius)) do
				strike(f, o, scaled(m.final, sc), move)
			end
		end)
	elseif kind == "waterDragons" then
		-- 1.9판 천하수류: 물의 용들이 몸을 감아 돌며 둘레를 휩쓸고, 마지막에 하나로 엉겨 앞으로 덮친다
		Push:FireAllClients("skillfx", { kind = "waterDragons", m = f.model, n = m.n, radius = m.radius, dur = m.dur / sp, delay = m.delay / sp, style = style })
		local ticks = math.floor(m.dur / m.every)
		for i = 0, ticks - 1 do
			after(m.delay + i * m.every, function()
				for _, o in ipairs(hostilesNear(f, f.root.Position, m.radius)) do
					strike(f, o, hit, move)
				end
			end)
		end
		after(m.delay + m.dur, function()
			local fwd = flat(Combat.look(f))
			local at = f.root.Position + fwd * m.finalDist
			Push:FireAllClients("skillfx", { kind = "dragonWave", at = at, from = f.root.Position, dir = fwd, radius = m.finalRadius, style = style })
			for _, o in ipairs(hostilesNear(f, at, m.finalRadius)) do
				strike(f, o, scaled(m.final, sc), move)
			end
		end)
	elseif kind == "reapHook" then
		-- 1.9판 혈사슬: 사슬 낫으로 둘레의 적을 낚아 내 앞으로 끌어온 뒤, 한 바퀴 돌며 벤다
		local list = nearestList(f, m.range, m.n)
		Push:FireAllClients("skillfx", { kind = "reapHook", m = f.model, targets = modelsOf(list), delay = m.delay / sp, pull = m.pull / sp, style = style })
		after(m.delay, function()
			for _, o in ipairs(list) do
				if not o.dead and o.root.Parent then
					strike(f, o, hit, move)
					o.stunUntil = math.max(o.stunUntil, os.clock() + 0.9)
				end
			end
		end)
		after(m.delay + m.pull, function()
			local fwd = flat(Combat.look(f))
			for i, o in ipairs(list) do
				if not o.dead and o.root.Parent and not o.root.Anchored then
					local a = (i - (#list + 1) / 2) * 0.7
					local side = Vector3.new(fwd.Z, 0, -fwd.X)
					local at = f.root.Position + fwd * 4 + side * a * 3
					if o.player then
						Push:FireClient(o.player, "knock", (at - o.root.Position) * 4, 0.4)
					else
						o.root.CFrame = CFrame.lookAt(Vector3.new(at.X, o.root.Position.Y, at.Z), f.root.Position)
					end
				end
			end
		end)
		after(m.delay + m.pull + 0.12, function()
			Push:FireAllClients("skillfx", { kind = "reapSpin", m = f.model, radius = m.radius, style = style })
			for _, o in ipairs(hostilesNear(f, f.root.Position, m.radius)) do
				strike(f, o, scaled(m.slash, sc), move)
			end
		end)
	elseif kind == "reapCleave" then
		-- 1.9판 혈월낙참: 내리꽂은 낫이 앞의 땅에 핏빛 초승달 자국을 새기고, 한 박자 뒤 자국이 터진다
		after(m.delay, function()
			local fwd = flat(Combat.look(f))
			local from = f.root.Position + fwd * 2
			local mid = from + fwd * (m.length / 2)
			Push:FireAllClients("skillfx", { kind = "reapScar", at = mid, dir = fwd, length = m.length, width = m.width, burst = m.burst / sp, style = style })
			local function inStrip(o: any): boolean
				local rel = o.root.Position - from
				local along = rel:Dot(fwd)
				local side = rel - fwd * along
				return along >= -2 and along <= m.length and Vector3.new(side.X, 0, side.Z).Magnitude <= m.width
			end
			for _, o in ipairs(hostilesNear(f, mid, m.length)) do
				if inStrip(o) then
					strike(f, o, hit, move)
				end
			end
			after(m.burst, function()
				for _, o in ipairs(hostilesNear(f, mid, m.length)) do
					if inStrip(o) then
						strike(f, o, scaled(m.burstHit, sc), move)
					end
				end
			end)
		end)
	elseif kind == "harvest" then
		-- 1.9판 혈마수확: 하늘만 한 피의 낫이 둘레를 휩쓴다. 베인 적에 낙인, 낫이 꽂히면 낙인이 한꺼번에 터진다
		local marked: { [any]: boolean } = {}
		local total = m.delay + m.sweeps * m.sweepTime
		Push:FireAllClients("skillfx", { kind = "harvest", m = f.model, radius = m.radius, delay = m.delay / sp, sweeps = m.sweeps, sweepTime = m.sweepTime / sp, mark = m.mark / sp, style = style })
		for k = 1, m.sweeps do
			-- 한 바퀴를 넷으로 나눠 친다 (낫이 지나가는 쪽부터)
			for q = 0, 3 do
				after(m.delay + (k - 1) * m.sweepTime + q * m.sweepTime / 4, function()
					local victims = hostilesNear(f, f.root.Position, m.radius)
					local n = 0
					for _, o in ipairs(victims) do
						local rel = flat(o.root.Position - f.root.Position)
						local ang = (math.atan2(rel.X, rel.Z) / (math.pi * 2)) % 1
						if math.floor(ang * 4) == q then
							strike(f, o, hit, move)
							marked[o] = true
							n += 1
						end
					end
					if m.heal and n > 0 then
						f.hp = math.min(f.maxHp, f.hp + f.maxHp * m.heal * n)
						Combat.sync(f)
					end
				end)
			end
		end
		after(total + m.mark, function()
			local list = {}
			for o in pairs(marked) do
				if not o.dead and o.root.Parent then
					table.insert(list, o)
				end
			end
			Push:FireAllClients("skillfx", { kind = "harvestBurst", m = f.model, targets = modelsOf(list), at = f.root.Position, radius = m.radius, style = style })
			for _, o in ipairs(list) do
				strike(f, o, scaled(m.burst, sc), move)
			end
		end)
	elseif kind == "bloodMoon" then
		-- 1.9판 혈월만겸 (초 오의): 핏빛 하늘과 붉은 달 (컷씬, 무적) → 핏빛 초승달이 쏟아진다 → 하늘과 땅을 가르는 마지막 낫질
		f.iframeUntil = math.max(f.iframeUntil, os.clock() + (m.cut + m.rain + 0.4) / sp)
		local center = f.root.Position
		Push:FireAllClients("skillfx", { kind = "moonRise", m = f.model, at = center, dur = (m.cut + m.rain + 0.6) / sp, cut = m.cut / sp, range = m.range, style = style })
		local ticks = math.floor(m.rain / m.every)
		for i = 0, ticks - 1 do
			after(m.cut + i * m.every, function()
				local list = hostilesNear(f, center, m.range)
				local spots = {}
				for _ = 1, m.n do
					local at
					if #list > 0 and math.random() < 0.7 then
						at = list[math.random(1, #list)].root.Position
					else
						local a = math.random() * math.pi * 2
						at = center + Vector3.new(math.cos(a), 0, math.sin(a)) * math.random(4, math.floor(m.range))
					end
					table.insert(spots, at)
				end
				Push:FireAllClients("skillfx", { kind = "moonSlash", m = f.model, spots = spots, radius = m.radius, style = style })
				local done = {}
				for _, at in ipairs(spots) do
					for _, o in ipairs(hostilesNear(f, at, m.radius)) do
						if not done[o] then
							done[o] = true
							o.stunUntil = math.max(o.stunUntil, os.clock() + 0.2)
							strike(f, o, hit, move)
						end
					end
				end
			end)
		end
		after(m.cut + m.rain + 0.15, function()
			local fwd = flat(Combat.look(f))
			local c = f.root.Position + fwd * 6
			Push:FireAllClients("skillfx", { kind = "moonCleave", m = f.model, at = c, dir = fwd, radius = m.finalRadius, style = style })
			for _, o in ipairs(hostilesNear(f, c, m.finalRadius)) do
				strike(f, o, scaled(m.final, sc), move)
			end
		end)
	------------------------------------------------------------------------
	-- 2.0판: 새 오의들 (각성 권법 아홉 · 초·벽력신권)
	------------------------------------------------------------------------
	elseif kind == "bloodSea" then
		-- 진 혈마신수 혈해만마: 발밑이 피의 바다가 되고, 피에서 마수의 손톱이 연달아 솟는다. 마지막에 바다가 소용돌이 기둥으로 솟아 터진다
		local center = f.root.Position
		local total = m.delay + m.claws * m.every
		Push:FireAllClients("skillfx", { kind = "bloodSea", at = center, radius = m.radius, dur = (total + 0.6) / sp, style = style })
		for i = 1, m.claws do
			after(m.delay + (i - 1) * m.every, function()
				local list = hostilesNear(f, center, m.radius)
				local at
				if #list > 0 then
					at = list[(i - 1) % #list + 1].root.Position
				else
					local a = math.random() * math.pi * 2
					at = center + Vector3.new(math.cos(a), 0, math.sin(a)) * math.random(4, math.floor(m.radius))
				end
				Push:FireAllClients("skillfx", { kind = "bloodClaw", at = at, radius = m.clawRadius, style = style, i = i })
				local n = 0
				for _, o in ipairs(hostilesNear(f, at, m.clawRadius)) do
					strike(f, o, hit, move)
					n += 1
				end
				if n > 0 and m.heal then
					f.hp = math.min(f.maxHp, f.hp + f.maxHp * m.heal * n)
					Combat.sync(f)
				end
			end)
		end
		after(total + 0.2, function()
			Push:FireAllClients("skillfx", { kind = "bloodVortex", at = center, radius = m.radius, style = style })
			for _, o in ipairs(hostilesNear(f, center, m.radius)) do
				strike(f, o, scaled(m.final, sc), move)
			end
		end)
	elseif kind == "nineDragons" or kind == "fireDragon" or kind == "thunderDragon" then
		-- 용 오의 셋: 구룡승천 (금룡 아홉) · 화룡천멸 (불의 용 하나) · 뇌룡승천 (번개의 용)
		-- 1) 용이 솟는다 (둘레를 친다) 2) 하늘에서 적들에게 차례로 내리꽂힌다 3) 마지막에 한가운데가 터진다
		local center = f.root.Position
		local n = m.n or 1
		Push:FireAllClients("skillfx", { kind = "dragonsRise", m = f.model, at = center, n = n, radius = m.ringRadius or 10, rise = m.rise / sp, look = kind, style = style })
		after(0.25, function()
			for _, o in ipairs(hostilesNear(f, center, (m.ringRadius or 10) + 6)) do
				strike(f, o, scaled(m.riseHit, sc), move)
			end
		end)
		local list = nearestList(f, m.range, m.dives)
		for i = 1, m.dives do
			after(m.rise + (i - 1) * m.every, function()
				local tgt = list[#list > 0 and ((i - 1) % #list + 1) or 1]
				local at
				if tgt and not tgt.dead and tgt.root.Parent then
					at = tgt.root.Position
				else
					local a = math.random() * math.pi * 2
					at = f.root.Position + Vector3.new(math.cos(a), 0, math.sin(a)) * math.random(6, 18)
				end
				Push:FireAllClients("skillfx", { kind = "dragonDive", at = at, radius = m.diveRadius, look = kind, style = style, i = i, from = f.root.Position })
				for _, o in ipairs(hostilesNear(f, at, m.diveRadius)) do
					strike(f, o, hit, move)
				end
			end)
		end
		after(m.rise + m.dives * m.every + 0.25, function()
			local c = f.root.Position
			Push:FireAllClients("skillfx", { kind = "dragonsEnd", at = c, radius = m.finalRadius, look = kind, style = style })
			for _, o in ipairs(hostilesNear(f, c, m.finalRadius)) do
				strike(f, o, scaled(m.final, sc), move)
			end
			-- 화룡: 떨어진 자리가 용암이 되어 몇 번 더 터진다
			for q = 1, m.lava or 0 do
				after(q * 0.45, function()
					Push:FireAllClients("skillfx", { kind = "lavaBurst", at = c, radius = m.finalRadius, style = style, i = q })
					for _, o in ipairs(hostilesNear(f, c, m.finalRadius)) do
						strike(f, o, scaled(m.lavaHit, sc), move)
					end
				end)
			end
		end)
	elseif kind == "thunderNet" then
		-- 진 벽력신권 뇌정천망: 둘레의 적을 모두 번개 그물로 잇는다. 그물이 몇 번 고동치고, 마지막에 적마다 벼락이 떨어진다
		local list = nearestList(f, m.range, m.n)
		Push:FireAllClients("skillfx", { kind = "netStart", m = f.model, targets = modelsOf(list), dur = (m.delay + m.pulses * m.every) / sp, style = style })
		for i = 1, m.pulses do
			after(m.delay + (i - 1) * m.every, function()
				Push:FireAllClients("skillfx", { kind = "netPulse", m = f.model, targets = modelsOf(list), style = style, i = i })
				for _, o in ipairs(list) do
					if not o.dead then
						o.stunUntil = math.max(o.stunUntil, os.clock() + m.every + 0.1)
						strike(f, o, hit, move)
					end
				end
			end)
		end
		after(m.delay + m.pulses * m.every + 0.1, function()
			Push:FireAllClients("skillfx", { kind = "netEnd", m = f.model, targets = modelsOf(list), style = style })
			for _, o in ipairs(list) do
				for _, v in ipairs(hostilesNear(f, o.root.Position, m.finalRadius)) do
					strike(f, v, scaled(m.final, sc), move)
				end
			end
		end)
	elseif kind == "thousandArms" then
		-- 진 금강불괴신공 천수여래: 등 뒤로 거대한 금빛 여래가 솟아 여러 팔로 적들을 차례로 내리치고, 마지막에 하늘의 손바닥이 땅을 누른다
		local center = f.root.Position
		local list = nearestList(f, m.range, m.count)
		Push:FireAllClients("skillfx", { kind = "armsStart", m = f.model, dur = (m.delay + m.count * m.every + m.palmDelay + 0.6) / sp, style = style })
		f.iframeUntil = math.max(f.iframeUntil, os.clock() + (m.delay + m.count * m.every + 0.3) / sp)
		for i = 1, m.count do
			after(m.delay + (i - 1) * m.every, function()
				local tgt = list[#list > 0 and ((i - 1) % #list + 1) or 1]
				local at = (tgt and not tgt.dead and tgt.root.Parent) and tgt.root.Position or (f.root.Position + look * (6 + i))
				Push:FireAllClients("skillfx", { kind = "armStrike", m = f.model, at = at, radius = m.armRadius, style = style, i = i })
				for _, o in ipairs(hostilesNear(f, at, m.armRadius)) do
					strike(f, o, hit, move)
				end
			end)
		end
		local palmAt = m.delay + m.count * m.every
		after(palmAt, function()
			Push:FireAllClients("skillfx", { kind = "buddhaPalm", at = center, radius = m.radius, delay = m.palmDelay / sp, quakes = 2, every = 0.35 / sp, style = style })
		end)
		after(palmAt + m.palmDelay, function()
			for _, o in ipairs(hostilesNear(f, center, m.radius)) do
				strike(f, o, scaled(m.final, sc), move)
				if not o.dead then
					Combat.stun(o, 1.4)
				end
			end
		end)
	elseif kind == "shadowKill" then
		-- 진 무영귀각 무영천살: 세상이 어두워지고 몸이 사라진다. 적들에게 붉은 표식이 하나씩 새겨지고, 한꺼번에 터진 뒤 하늘에서 그림자의 발이 짓밟는다
		local list = nearestList(f, m.range, m.n)
		local total = m.delay + #list * m.every + m.hold
		f.iframeUntil = math.max(f.iframeUntil, os.clock() + (total + 0.6) / sp)
		f.model:SetAttribute("Vanish", true)
		Push:FireAllClients("skillfx", { kind = "darkStart", m = f.model, at = f.root.Position, dur = (total + 0.6) / sp, radius = m.range, style = style })
		for i, o in ipairs(list) do
			after(m.delay + (i - 1) * m.every, function()
				if not o.dead and o.root.Parent then
					o.stunUntil = math.max(o.stunUntil, os.clock() + total)
					Push:FireAllClients("skillfx", { kind = "killMark", t = o.model, style = style, i = i })
				end
			end)
		end
		after(total, function()
			f.model:SetAttribute("Vanish", nil)
			Push:FireAllClients("skillfx", { kind = "killBurst", targets = modelsOf(list), style = style })
			for _, o in ipairs(list) do
				strike(f, o, hit, move)
			end
		end)
		after(total + 0.35, function()
			local c = f.root.Position + look * 6
			Push:FireAllClients("skillfx", { kind = "shadowStomp", at = c, radius = m.finalRadius, style = style })
			for _, o in ipairs(hostilesNear(f, c, m.finalRadius)) do
				strike(f, o, scaled(m.final, sc), move)
			end
		end)
		task.delay((total + 0.8) / sp, function()
			if f.model.Parent then
				f.model:SetAttribute("Vanish", nil)
			end
		end)
	elseif kind == "maelstrom" or kind == "abyss" then
		-- 진 태허유수장 창해만류: 큰 소용돌이가 적을 가운데로 빨아들이고, 둘레에 솟은 물의 벽이 안쪽으로 무너진다
		-- 진 창해신권 심해강림: 땅이 깊은 바다가 되어 적이 가라앉고 (묶인다), 한가운데서 거대한 물기둥이 솟아 하늘로 쳐올린다
		local center = f.root.Position + look * (m.dist or 0)
		Push:FireAllClients("skillfx", { kind = kind, at = center, radius = m.radius, dur = m.dur / sp, style = style })
		local n = math.floor(m.dur / m.every)
		for i = 0, n - 1 do
			after(m.delay + i * m.every, function()
				for _, o in ipairs(hostilesNear(f, center, m.radius)) do
					if m.pull then
						pullTo(o, center, m.pull)
					end
					if kind == "abyss" then
						o.stunUntil = math.max(o.stunUntil, os.clock() + m.every + 0.15)
					end
					strike(f, o, hit, move)
				end
			end)
		end
		after(m.delay + m.dur, function()
			Push:FireAllClients("skillfx", { kind = kind .. "End", at = center, radius = m.radius, style = style })
			for _, o in ipairs(hostilesNear(f, center, m.radius)) do
				strike(f, o, scaled(m.final, sc), move)
				if kind == "abyss" and not o.dead then
					o.model:SetAttribute("LaunchedAt", os.clock())
					if o.player then
						Push:FireClient(o.player, "knock", Vector3.new(0, 70, 0), 1.2)
					elseif not o.root.Anchored then
						o.root.AssemblyLinearVelocity = Vector3.new(0, 70, 0)
					end
				end
			end
		end)
	elseif kind == "galeBlades" then
		-- 진 풍신각 천풍만검: 바람의 칼날이 몸을 돌다가 사방으로 쏘아지고, 마지막에 한가운데 회오리가 모두 들어 올려 내던진다
		Push:FireAllClients("skillfx", { kind = "galeBlades", m = f.model, n = m.blades, radius = m.orbit, spin = m.spin / sp, style = style })
		local ticks = math.floor(m.spin / m.every)
		for i = 0, ticks - 1 do
			after(m.delay + i * m.every, function()
				for _, o in ipairs(hostilesNear(f, f.root.Position, m.orbit + 3)) do
					strike(f, o, hit, move)
				end
			end)
		end
		after(m.delay + m.spin, function()
			local c = f.root.Position
			Push:FireAllClients("skillfx", { kind = "galeShoot", at = c, n = m.blades, range = m.range, style = style })
			for _, o in ipairs(hostilesNear(f, c, m.range)) do
				strike(f, o, scaled(m.shoot, sc), move)
			end
		end)
		after(m.delay + m.spin + 0.5, function()
			local c = f.root.Position + look * 8
			Push:FireAllClients("skillfx", { kind = "galeTwister", at = c, radius = m.finalRadius, style = style })
			for _, o in ipairs(hostilesNear(f, c, m.finalRadius)) do
				strike(f, o, scaled(m.final, sc), move)
			end
		end)
	elseif kind == "heavenThunder" then
		-- 초·벽력신권 구천뇌정 (초 오의): 하늘이 갈라지고 천둥의 눈이 뜬다 (컷씬, 무적)
		-- 2.2판: 눈이 둘레의 적을 하나하나 겨누고 (조준 고리), 겨눈 차례대로 심판의 벼락이 내리꽂힌다 → 마지막에 하늘에서 땅까지 벼락 기둥
		local total = m.cut + m.rain
		f.iframeUntil = math.max(f.iframeUntil, os.clock() + (total + 0.4) / sp)
		local center = f.root.Position
		Push:FireAllClients("skillfx", { kind = "thunderEye", m = f.model, at = center, dur = (total + 0.5) / sp, range = m.range, style = style })
		after(m.cut - 0.1, function()
			local list = nearestList(f, m.range, m.n)
			Push:FireAllClients("skillfx", { kind = "lockOn", targets = modelsOf(list), dur = (m.rain + 0.2) / sp, style = style })
			local strikes = math.floor(m.rain / m.every)
			for i = 1, strikes do
				after(0.2 + (i - 1) * m.every, function()
					local tgt = #list > 0 and list[(i - 1) % #list + 1] or nil
					local at
					if tgt and not tgt.dead and tgt.root.Parent then
						at = tgt.root.Position
					else
						local a = math.random() * math.pi * 2
						at = center + Vector3.new(math.cos(a), 0, math.sin(a)) * math.random(4, math.max(5, math.floor(m.range * 0.6)))
					end
					Push:FireAllClients("skillfx", { kind = "judgeBolt", at = at, radius = m.radius, i = i, style = style })
					for _, o in ipairs(hostilesNear(f, at, m.radius)) do
						o.stunUntil = math.max(o.stunUntil, os.clock() + 0.35)
						strike(f, o, hit, move)
					end
				end)
			end
		end)
		after(total + 0.15, function()
			local c = f.root.Position + flat(Combat.look(f)) * 5
			Push:FireAllClients("skillfx", { kind = "thunderPillar", at = c, radius = m.finalRadius, style = style })
			for _, o in ipairs(hostilesNear(f, c, m.finalRadius)) do
				strike(f, o, scaled(m.final, sc), move)
			end
		end)

	------------------------------------------------------------------------
	-- 2.2판: 각성 권법 아홉의 새 E·R, 진 열화·진 창해의 새 오의, 초·벽력신권의 새 R·오의
	------------------------------------------------------------------------
	elseif kind == "thunderDrums" then
		-- 초·벽력신권 뇌고천무 (초 오의, 2.3판): 등 뒤 하늘에 뇌고 여덟이 둥글게 뜬다 (컷씬, 무적).
		-- 북을 열여섯 번 친다 (점점 빨라진다). 칠 때마다 그 북에서 적에게 벼락이 꽂히고, 네 번째마다 둘레로 천둥이 울린다.
		-- 마지막에 북이 모두 한가운데로 모여 하나의 뇌구가 되어 앞의 땅에 내리꽂힌다
		local gaps = {}
		local sum = 0
		for i = 1, m.beats do
			local u = (i - 1) / math.max(1, m.beats - 1)
			gaps[i] = m.first + (m.last - m.first) * u
			sum += gaps[i]
		end
		local total = m.cut + sum + m.finaleDelay
		f.iframeUntil = math.max(f.iframeUntil, os.clock() + (total + 0.3) / sp)
		Push:FireAllClients("skillfx", { kind = "drumRing", m = f.model, n = m.drums, dur = (total + 0.4) / sp, style = style })
		local list = nearestList(f, m.range, m.n)
		local tAt = m.cut
		for i = 1, m.beats do
			tAt += gaps[i]
			after(tAt, function()
				local tgt = #list > 0 and list[(i - 1) % #list + 1] or nil
				local at
				if tgt and not tgt.dead and tgt.root.Parent then
					at = tgt.root.Position
				else
					local a = math.random() * math.pi * 2
					at = f.root.Position + Vector3.new(math.cos(a), 0, math.sin(a)) * math.random(5, 16)
				end
				local shock = i % 4 == 0
				Push:FireAllClients("skillfx", { kind = "drumBeat", m = f.model, drum = (i - 1) % m.drums + 1, at = at, radius = m.radius, i = i, shock = shock, shockRadius = m.shockRadius, style = style })
				for _, o in ipairs(hostilesNear(f, at, m.radius)) do
					o.stunUntil = math.max(o.stunUntil, os.clock() + 0.3)
					strike(f, o, hit, move)
				end
				if shock then
					for _, o in ipairs(hostilesNear(f, f.root.Position, m.shockRadius)) do
						strike(f, o, scaled(m.shock, sc), move)
					end
				end
			end)
		end
		after(total, function()
			local c = f.root.Position + flat(Combat.look(f)) * m.finaleDist
			Push:FireAllClients("skillfx", { kind = "drumFinale", m = f.model, at = c, radius = m.finalRadius, fall = 0.3 / sp, style = style })
			after(0.3, function()
				for _, o in ipairs(hostilesNear(f, c, m.finalRadius)) do
					strike(f, o, scaled(m.final, sc), move)
					if not o.dead then
						Combat.stun(o, 1.5)
					end
				end
			end)
		end)
	elseif kind == "seedBurst" then
		-- 만목신권 종자탄: 씨앗 다섯을 부채꼴로 튕긴다 (가까운 적이 있으면 그 몸에 박힌다). 잠시 뒤 가시덤불로 터져 묶는다
		local from = f.root.Position
		local half = math.rad(m.spread / 2)
		local enemies = hostilesNear(f, from, m.range)
		local spots = {}
		for i = 1, m.n do
			local a = -half + (2 * half) * (i - 1) / math.max(1, m.n - 1)
			local d = (CFrame.Angles(0, a, 0) * CFrame.new(look)).Position
			local at = from + d * m.dist
			local best, bd = nil, 8
			for _, o in ipairs(enemies) do
				local dd = (o.root.Position - at).Magnitude
				if dd < bd then
					best, bd = o, dd
				end
			end
			spots[i] = best and best.root.Position or at
		end
		Push:FireAllClients("skillfx", { kind = "seedShot", from = from, spots = spots, delay = m.delay / sp, sprout = m.sprout / sp, style = style })
		after(m.delay + 0.15, function()
			local done = {}
			for _, at in ipairs(spots) do
				for _, o in ipairs(hostilesNear(f, at, 2.5)) do
					if not done[o] then
						done[o] = true
						strike(f, o, hit, move)
					end
				end
			end
		end)
		-- 남은 가시덤불이 한동안 찌른다
		for i = 1, math.floor((m.linger or 0) / (m.every or 0.3)) do
			after(m.delay + m.sprout + i * m.every, function()
				local done = {}
				for _, at in ipairs(spots) do
					for _, o in ipairs(hostilesNear(f, at, m.radius)) do
						if not done[o] then
							done[o] = true
							strike(f, o, scaled(m.tick, sc), move)
						end
					end
				end
			end)
		end
		after(m.delay + m.sprout, function()
			Push:FireAllClients("skillfx", { kind = "thornSprout", spots = spots, radius = m.radius, linger = (m.linger or 0) / sp, style = style })
			local done = {}
			for _, at in ipairs(spots) do
				for _, o in ipairs(hostilesNear(f, at, m.radius)) do
					if not done[o] then
						done[o] = true
						strike(f, o, scaled(m.burst, sc), move)
						if not o.dead then
							Combat.stun(o, m.root)
						end
					end
				end
			end
		end)
	elseif kind == "bloomBud" then
		-- 만목신권 개화: 앞의 땅에서 거대한 꽃봉오리가 솟고, 활짝 피며 꽃가루가 터진다 (적은 잠들고 나는 체력을 되찾는다)
		local at = f.root.Position + look * m.dist
		Push:FireAllClients("skillfx", { kind = "budRise", at = at, radius = m.radius, delay = m.delay / sp, sleep = m.sleep / sp, style = style })
		after(m.delay, function()
			Push:FireAllClients("skillfx", { kind = "budBloom", at = at, radius = m.radius, sleep = m.sleep / sp, style = style })
			for _, o in ipairs(hostilesNear(f, at, m.radius)) do
				strike(f, o, hit, move)
				if not o.dead then
					Combat.stun(o, m.sleep)
				end
			end
			heal(f, m.heal)
		end)
		-- 꽃잎 회오리: 핀 꽃에서 꽃잎이 둘레로 휘몰아쳐 한 번 더 친다
		if m.wave then
			after(m.delay + m.wave, function()
				Push:FireAllClients("skillfx", { kind = "budPetals", at = at, radius = m.waveRadius, style = style })
				for _, o in ipairs(hostilesNear(f, at, m.waveRadius)) do
					strike(f, o, scaled(m.waveHit, sc), move)
				end
			end)
		end
	elseif kind == "treant" then
		-- 만목신권 목령강림 (오의): 등 뒤에서 거대한 나무 정령이 솟아 앞을 내리치고, 팔로 휩쓸고, 땅 곳곳에서 뿌리가 솟는다
		local base = f.root.Position
		local lk = look
		f.iframeUntil = math.max(f.iframeUntil, os.clock() + m.rise / sp)
		Push:FireAllClients("skillfx", { kind = "treantRise", m = f.model, at = base, dir = lk, rise = m.rise / sp, sweep = m.sweepAt / sp, roots = m.rootsAt / sp, dur = (m.rootsAt + 0.9) / sp, style = style })
		after(m.rise, function()
			local at = base + lk * m.slamDist
			Push:FireAllClients("skillfx", { kind = "treantSlam", at = at, radius = m.slamRadius, style = style })
			for _, o in ipairs(hostilesNear(f, at, m.slamRadius)) do
				strike(f, o, scaled(m.slam, sc), move)
			end
		end)
		after(m.sweepAt, function()
			local cosA = math.cos(math.rad(m.sweepAngle / 2))
			Push:FireAllClients("skillfx", { kind = "treantSweep", at = base, dir = lk, range = m.sweepRange, angle = m.sweepAngle, style = style })
			for _, o in ipairs(hostilesNear(f, base, m.sweepRange)) do
				if flat(o.root.Position - base):Dot(lk) >= cosA or (o.root.Position - base).Magnitude < 5 then
					strike(f, o, scaled(m.sweep, sc), move)
				end
			end
		end)
		-- 잎 폭풍: 휩쓴 뒤 나무 정령의 잎이 둘레에 쏟아진다
		if m.leafTicks then
			local gap = (m.rootsAt - m.sweepAt - 0.3) / m.leafTicks
			after(m.sweepAt + 0.2, function()
				Push:FireAllClients("skillfx", { kind = "leafStorm", at = base, radius = m.leafRadius, dur = (gap * m.leafTicks) / sp, style = style })
			end)
			for i = 1, m.leafTicks do
				after(m.sweepAt + 0.2 + i * gap, function()
					for _, o in ipairs(hostilesNear(f, base, m.leafRadius)) do
						strike(f, o, scaled(m.leaf, sc), move)
					end
				end)
			end
		end
		after(m.rootsAt, function()
			local list = nearestList(f, m.rootRange, m.roots)
			local spots = {}
			for i = 1, m.roots do
				local o = list[i]
				if o and o.root.Parent then
					spots[i] = o.root.Position
				else
					local a = math.random() * math.pi * 2
					spots[i] = base + Vector3.new(math.cos(a), 0, math.sin(a)) * math.random(6, math.max(7, math.floor(m.rootRange)))
				end
			end
			Push:FireAllClients("skillfx", { kind = "treantRoots", spots = spots, radius = m.rootRadius, style = style })
			local done = {}
			for _, at in ipairs(spots) do
				for _, o in ipairs(hostilesNear(f, at, m.rootRadius)) do
					if not done[o] then
						done[o] = true
						strike(f, o, scaled(m.root, sc), move)
					end
				end
			end
			heal(f, m.heal)
		end)
	elseif kind == "bloodNeedles" then
		-- 진 혈마 혈침: 피의 바늘을 적들에게 꽂고, 잠시 뒤 바늘이 몸속에서 터지며 체력을 빨아온다
		local list = nearestList(f, m.range, m.n)
		Push:FireAllClients("skillfx", { kind = "needleShot", m = f.model, targets = modelsOf(list), delay = m.delay / sp, mark = m.mark / sp, style = style })
		after(m.delay + 0.12, function()
			for _, o in ipairs(list) do
				strike(f, o, hit, move)
			end
		end)
		after(m.delay + m.mark, function()
			local spots = {}
			local n = 0
			for _, o in ipairs(list) do
				if o.root.Parent then
					local at = o.root.Position
					table.insert(spots, at)
					for _, v in ipairs(hostilesNear(f, at, m.radius)) do
						strike(f, v, scaled(m.burst, sc), move)
						n += 1
					end
				end
			end
			Push:FireAllClients("skillfx", { kind = "needleBurst", spots = spots, radius = m.radius, style = style })
			if n > 0 then
				heal(f, m.heal * math.min(n, 6))
			end
		end)
	elseif kind == "bloodGrip" then
		-- 진 혈마 혈마수인: 앞의 땅에서 피의 손이 솟아 움켜쥐고, 쥐어짜고, 내리꽂는다
		local at = f.root.Position + look * m.dist
		Push:FireAllClients("skillfx", { kind = "gripRise", at = at, radius = m.radius, dur = (m.delay + (m.squeezes + 1) * m.every + 0.4) / sp, delay = m.delay / sp, style = style })
		local caught: { any } = {}
		after(m.delay, function()
			caught = hostilesNear(f, at, m.radius)
			for _, o in ipairs(caught) do
				Combat.stun(o, (m.squeezes * m.every + 0.4) / sp)
				strike(f, o, hit, move)
			end
		end)
		for i = 1, m.squeezes do
			after(m.delay + i * m.every, function()
				Push:FireAllClients("skillfx", { kind = "gripSqueeze", at = at, radius = m.radius, i = i, style = style })
				for _, o in ipairs(caught) do
					strike(f, o, scaled(m.squeeze, sc), move)
				end
			end)
		end
		after(m.delay + (m.squeezes + 1) * m.every, function()
			Push:FireAllClients("skillfx", { kind = "gripSlam", at = at, radius = m.radius, style = style })
			for _, o in ipairs(hostilesNear(f, at, m.radius + 2)) do
				strike(f, o, scaled(m.final, sc), move)
			end
		end)
	elseif kind == "dragonRoar" then
		-- 진 천룡 용음: 앞쪽 부채꼴로 금룡의 울음. 멀리 날리고 몸을 굳힌다
		local origin = f.root.Position
		local cosA = math.cos(math.rad(m.angle / 2))
		Push:FireAllClients("skillfx", { kind = "dragonRoar", m = f.model, at = origin, dir = look, range = m.range, angle = m.angle, style = style })
		after(m.delay, function()
			for _, o in ipairs(hostilesNear(f, origin, m.range)) do
				local d = flat(o.root.Position - origin)
				if d:Dot(look) >= cosA or (o.root.Position - origin).Magnitude < 4 then
					strike(f, o, hit, move)
					if not o.dead then
						Combat.stun(o, m.stun)
					end
				end
			end
		end)
	elseif kind == "dragonPalm" then
		-- 진 천룡 항룡장: 금룡 머리 모양의 장력이 앞으로 뻗어 꿰뚫고, 끝에서 터진다
		local from = f.root.Position + look * 2
		local travel = m.length / m.speed
		Push:FireAllClients("skillfx", { kind = "palmWave", from = from, dir = look, length = m.length, time = travel / sp, delay = m.delay / sp, width = m.width, style = style })
		local done = {}
		local steps = math.max(1, math.floor(travel / 0.05))
		for i = 1, steps do
			after(m.delay + i * travel / steps, function()
				local a = from + look * (m.length * (i - 1) / steps)
				local b = from + look * (m.length * i / steps)
				for _, o in ipairs(hostilesOnSeg(f, a, b, m.width)) do
					if not done[o] then
						done[o] = true
						strike(f, o, hit, move)
					end
				end
			end)
		end
		after(m.delay + travel, function()
			local endAt = from + look * m.length
			Push:FireAllClients("skillfx", { kind = "palmBurst", at = endAt, radius = m.finalRadius, style = style })
			for _, o in ipairs(hostilesNear(f, endAt, m.finalRadius)) do
				strike(f, o, scaled(m.final, sc), move)
			end
		end)
	elseif kind == "sigils" then
		-- 진 벽력 뇌인진: 둘레 네 곳에 뇌인을 새긴다. 적이 밟으면 벼락 (뇌인마다 두 번), 끝에 모두 터진다
		local c = f.root.Position
		local right = rightOf(look)
		local spots = {}
		for k = 0, m.n - 1 do
			local a = (k / m.n) * math.pi * 2 + math.pi / 4
			table.insert(spots, c + (look * math.cos(a) + right * math.sin(a)) * m.dist)
		end
		Push:FireAllClients("skillfx", { kind = "sigilsPlace", spots = spots, radius = m.radius, dur = (m.delay + m.dur) / sp, style = style })
		local left = {}
		for i = 1, #spots do
			left[i] = m.charges
		end
		local ticks = math.floor(m.dur / m.every)
		for t = 1, ticks do
			after(m.delay + t * m.every, function()
				for i, at in ipairs(spots) do
					if left[i] > 0 then
						local list = hostilesNear(f, at, m.radius)
						if #list > 0 then
							left[i] -= 1
							Push:FireAllClients("skillfx", { kind = "sigilBolt", at = at, radius = m.radius, style = style })
							for _, o in ipairs(list) do
								strike(f, o, hit, move)
							end
						end
					end
				end
			end)
		end
		after(m.delay + m.dur + 0.05, function()
			for _, at in ipairs(spots) do
				Push:FireAllClients("skillfx", { kind = "sigilBolt", at = at, radius = m.finalRadius, big = true, style = style })
				for _, o in ipairs(hostilesNear(f, at, m.finalRadius)) do
					strike(f, o, scaled(m.final, sc), move)
				end
			end
		end)
	elseif kind == "railBeam" then
		-- 진 벽력 섬뢰포: 주먹에 뇌전을 모았다가 앞으로 곧게 쏜다. 지나간 줄이 한동안 지지직 지진다
		Push:FireAllClients("skillfx", { kind = "railCharge", m = f.model, time = m.delay / sp, style = style })
		after(m.delay, function()
			local a = f.root.Position
			local dir = flat(Combat.look(f))
			local b = a + dir * m.length
			Push:FireAllClients("skillfx", { kind = "railFire", from = a, to = b, width = m.width, dur = m.linger / sp, style = style })
			for _, o in ipairs(hostilesOnSeg(f, a, b, m.width)) do
				strike(f, o, hit, move)
			end
			local ticks = math.floor(m.linger / m.every)
			for i = 1, ticks do
				after(i * m.every, function()
					for _, o in ipairs(hostilesOnSeg(f, a, b, m.width)) do
						o.stunUntil = math.max(o.stunUntil, os.clock() + 0.3)
						strike(f, o, scaled(m.tick, sc), move)
					end
				end)
			end
		end)
	elseif kind == "goldenBell" then
		-- 진 금강 금강종: 하늘에서 금빛 큰 종이 떨어져 나를 덮는다 (무적). 종이 세 번 울릴 때마다 둘레를 밀어낸다
		f.iframeUntil = math.max(f.iframeUntil, os.clock() + m.dur / sp)
		Push:FireAllClients("skillfx", { kind = "bellDrop", m = f.model, dur = m.dur / sp, delay = m.delay / sp, rings = m.rings, every = m.every / sp, style = style })
		for i = 1, m.rings do
			after(m.delay + (i - 1) * m.every, function()
				local c = f.root.Position
				Push:FireAllClients("skillfx", { kind = "bellRing", at = c, radius = m.radius, i = i, last = i == m.rings, style = style })
				for _, o in ipairs(hostilesNear(f, c, m.radius)) do
					strike(f, o, i == m.rings and scaled(m.final, sc) or hit, move)
				end
			end)
		end
	elseif kind == "vajra" then
		-- 진 금강 항마저: 금강저를 던진다. 앞으로 날아갔다가 손으로 되돌아오며, 가는 길과 오는 길에 한 번씩 친다
		local from = f.root.Position
		local dir = look
		local tip = from + dir * m.dist
		Push:FireAllClients("skillfx", { kind = "vajraThrow", m = f.model, from = from, dir = dir, dist = m.dist, time = m.time / sp, delay = m.delay / sp, style = style })
		local outSeen, backSeen = {}, {}
		local steps = 10
		for i = 1, steps * 2 do
			after(m.delay + i * m.time / steps, function()
				local pos
				if i <= steps then
					pos = from + dir * (m.dist * i / steps)
				else
					pos = tip:Lerp(f.root.Position, (i - steps) / steps)
				end
				local seen = i <= steps and outSeen or backSeen
				for _, o in ipairs(hostilesNear(f, pos, m.radius)) do
					if not seen[o] then
						seen[o] = true
						strike(f, o, hit, move)
					end
				end
			end)
		end
	elseif kind == "shadowClones" then
		-- 진 무영 분영: 양옆에 그림자 분신 둘이 떨어져 나와, 저마다 가까운 적에게 세 번 덮쳐 찬다
		local c = f.root.Position
		local right = rightOf(look)
		local spots = { c + right * m.side - look * 2, c - right * m.side - look * 2 }
		Push:FireAllClients("skillfx", { kind = "cloneSpawn", m = f.model, spots = spots, dur = (m.delay + m.waves * m.every + 0.3) / sp, style = style })
		for s = 1, m.waves do
			after(m.delay + (s - 1) * m.every, function()
				for ci = 1, #spots do
					local at = spots[ci]
					local list = hostilesNear(f, at, m.range)
					table.sort(list, function(a, b)
						return (a.root.Position - at).Magnitude < (b.root.Position - at).Magnitude
					end)
					local tgt = list[1]
					local to = tgt and tgt.root.Position or (at + look * 8)
					Push:FireAllClients("skillfx", { kind = "cloneStrike", from = at, to = to, radius = m.radius, i = ci, last = s == m.waves, style = style })
					for _, o in ipairs(hostilesNear(f, to, m.radius)) do
						strike(f, o, hit, move)
					end
					spots[ci] = to
				end
			end)
		end
	elseif kind == "shadowStep" then
		-- 진 무영 그림자 밟기: 내 그림자만 앞으로 미끄러져 나가며 밟은 적의 그림자를 땅에 꿰맨다. 그림자 끝으로 몸이 옮겨 가 되돌아 걷어찬다
		local from = f.root.Position
		local dir = look
		local to = from + dir * m.dist
		Push:FireAllClients("skillfx", { kind = "shadowSlide", m = f.model, from = from, to = to, time = m.slide / sp, style = style })
		local pinned = {}
		local steps = 8
		for i = 1, steps do
			after(i * m.slide / steps, function()
				local a = from + dir * (m.dist * (i - 1) / steps)
				local b = from + dir * (m.dist * i / steps)
				for _, o in ipairs(hostilesOnSeg(f, a, b, m.width)) do
					if not pinned[o] then
						pinned[o] = true
						Combat.stun(o, m.pin / sp)
						strike(f, o, hit, move)
					end
				end
			end)
		end
		after(m.slide + 0.1, function()
			f.iframeUntil = math.max(f.iframeUntil, os.clock() + 0.5)
			moveTo(f, CFrame.lookAt(to + Vector3.new(0, 3, 0), to + Vector3.new(0, 3, 0) - dir))
			Push:FireAllClients("skillfx", { kind = "shadowKick", at = to, from = from, style = style })
			for o in pairs(pinned) do
				strike(f, o, scaled(m.final, sc), move)
			end
		end)
	elseif kind == "waterOrbit" then
		-- 진 태허 회류환: 물방울 셋이 몸을 감아 돌며 닿는 적을 친다. 끝에 물결로 퍼진다
		Push:FireAllClients("skillfx", { kind = "orbitStart", m = f.model, n = m.n, radius = m.radius, dur = m.dur / sp, style = style })
		local lastHit = {}
		local ticks = math.floor(m.dur / m.every)
		for i = 1, ticks do
			after(i * m.every, function()
				local c = f.root.Position
				for _, o in ipairs(hostilesNear(f, c, m.radius + 3)) do
					if (lastHit[o] or 0) + m.gap / sp < os.clock() then
						lastHit[o] = os.clock()
						strike(f, o, hit, move)
					end
				end
			end)
		end
		after(m.dur, function()
			local c = f.root.Position
			Push:FireAllClients("skillfx", { kind = "orbitBurst", at = c, radius = m.radius + 4, style = style })
			for _, o in ipairs(hostilesNear(f, c, m.radius + 4)) do
				strike(f, o, scaled(m.final, sc), move)
			end
		end)
	elseif kind == "geysers" then
		-- 진 태허 간헐천: 가까운 적의 발밑마다 차례로 뜨거운 물기둥이 솟아 하늘로 쳐올린다
		local list = nearestList(f, m.range, m.n)
		for i = 1, m.n do
			after(m.delay + (i - 1) * m.every, function()
				local tgt = list[i]
				local at = (tgt and tgt.root.Parent) and tgt.root.Position or (f.root.Position + look * (5 + i * 5))
				Push:FireAllClients("skillfx", { kind = "hotGeyser", at = at, radius = m.radius, i = i, style = style })
				for _, o in ipairs(hostilesNear(f, at, m.radius)) do
					strike(f, o, hit, move)
				end
			end)
		end
	elseif kind == "fireWheel" then
		-- 진 열화 화륜: 불의 바퀴를 굴린다. 닿는 적을 치고, 지나간 길이 한동안 불탄다
		local from = f.root.Position + look * 2
		local dir = look
		Push:FireAllClients("skillfx", { kind = "wheelRoll", from = from, dir = dir, dist = m.dist, time = m.time / sp, burn = m.burn / sp, style = style })
		local done = {}
		local steps = 12
		for i = 1, steps do
			after(i * m.time / steps, function()
				local a = from + dir * (m.dist * (i - 1) / steps)
				local b = from + dir * (m.dist * i / steps)
				for _, o in ipairs(hostilesOnSeg(f, a, b, m.radius)) do
					if not done[o] then
						done[o] = true
						strike(f, o, hit, move)
					end
				end
			end)
		end
		local ticks = math.floor(m.burn / m.every)
		for i = 1, ticks do
			after(m.time + i * m.every, function()
				for _, o in ipairs(hostilesOnSeg(f, from, from + dir * m.dist, m.trail)) do
					strike(f, o, scaled(m.tick, sc), move)
				end
			end)
		end
	elseif kind == "flameRing" then
		-- 진 열화 폭염륜: 솟았다가 내려앉으며 둘레로 불의 고리가 퍼져 나간다 (고리가 지나가는 순간 맞는다)
		after(m.delay, function()
			local c = f.root.Position
			Push:FireAllClients("skillfx", { kind = "flameRing", at = c, radius = m.radius, time = m.expand / sp, style = style })
			local done = {}
			local steps = 8
			for i = 1, steps do
				after(i * m.expand / steps, function()
					for _, o in ipairs(hostilesNear(f, c, m.radius * i / steps)) do
						if not done[o] then
							done[o] = true
							strike(f, o, hit, move)
						end
					end
				end)
			end
		end)
	elseif kind == "volcano" then
		-- 진 열화 화산천붕 (오의): 앞의 땅이 부풀어 오르고, 적의 발밑마다 용암이 뿜어진 뒤, 한가운데 화산이 터져 불덩이가 쏟아진다
		local c = f.root.Position + look * m.dist
		local mainAt = m.delay + m.vents * m.every + m.mainDelay
		local total = mainAt + 0.3 + m.meteors * m.meteorEvery + 0.4
		Push:FireAllClients("skillfx", { kind = "volcanoRise", at = c, radius = m.radius, dur = total / sp, style = style })
		local list = nearestList(f, m.range, m.vents)
		for i = 1, m.vents do
			after(m.delay + (i - 1) * m.every, function()
				local tgt = list[(i - 1) % math.max(1, #list) + 1]
				local at = (tgt and tgt.root.Parent) and tgt.root.Position or (c + Vector3.new(math.random(-12, 12), 0, math.random(-12, 12)))
				Push:FireAllClients("skillfx", { kind = "vent", at = at, radius = m.ventRadius, style = style })
				for _, o in ipairs(hostilesNear(f, at, m.ventRadius)) do
					strike(f, o, hit, move)
				end
			end)
		end
		after(mainAt, function()
			Push:FireAllClients("skillfx", { kind = "eruptMain", at = c, radius = m.mainRadius, style = style })
			for _, o in ipairs(hostilesNear(f, c, m.mainRadius)) do
				strike(f, o, scaled(m.main, sc), move)
			end
		end)
		for i = 1, m.meteors do
			after(mainAt + 0.3 + (i - 1) * m.meteorEvery, function()
				local enemies = hostilesNear(f, c, m.radius)
				local at
				if #enemies > 0 and math.random() < 0.6 then
					at = enemies[math.random(1, #enemies)].root.Position
				else
					local a = math.random() * math.pi * 2
					at = c + Vector3.new(math.cos(a), 0, math.sin(a)) * math.random(3, math.max(4, math.floor(m.radius)))
				end
				Push:FireAllClients("skillfx", { kind = "meteorDrop", at = at, radius = m.meteorRadius, fall = 0.35 / sp, style = style })
				after(0.35, function()
					for _, o in ipairs(hostilesNear(f, at, m.meteorRadius)) do
						strike(f, o, scaled(m.meteor, sc), move)
					end
				end)
			end)
		end
	elseif kind == "bubbles" then
		-- 진 창해 수포옥: 가까운 적 셋을 물방울 감옥에 가둬 띄운다. 갇힌 동안 지지고, 끝에 펑 터진다
		local list = nearestList(f, m.range, m.n)
		Push:FireAllClients("skillfx", { kind = "bubbleTrap", targets = modelsOf(list), dur = m.dur / sp, delay = m.delay / sp, style = style })
		after(m.delay, function()
			for _, o in ipairs(list) do
				Combat.stun(o, m.dur / sp)
				strike(f, o, hit, move)
			end
		end)
		local ticks = math.floor(m.dur / m.every)
		for i = 1, ticks - 1 do
			after(m.delay + i * m.every, function()
				for _, o in ipairs(list) do
					strike(f, o, scaled(m.tick, sc), move)
				end
			end)
		end
		after(m.delay + m.dur, function()
			local spots = {}
			for _, o in ipairs(list) do
				if o.root.Parent then
					table.insert(spots, o.root.Position)
					for _, v in ipairs(hostilesNear(f, o.root.Position, m.radius)) do
						strike(f, v, scaled(m.final, sc), move)
					end
				end
			end
			Push:FireAllClients("skillfx", { kind = "bubblePop", spots = spots, radius = m.radius, style = style })
		end)
	elseif kind == "waterSpears" then
		-- 진 창해 해룡창: 하늘에서 물의 창이 적들에게 차례로 내리꽂힌다 (적이 없으면 앞으로 한 줄)
		local c = f.root.Position
		local list = nearestList(f, m.range, m.count)
		for i = 1, m.count do
			after(m.delay + (i - 1) * m.every, function()
				local tgt = list[i]
				local at = (tgt and not tgt.dead and tgt.root.Parent) and tgt.root.Position or (c + look * (m.start + (i - 1) * m.spacing))
				Push:FireAllClients("skillfx", { kind = "waterSpear", at = at, radius = m.radius, fall = 0.18 / sp, i = i, style = style })
				after(0.18, function()
					for _, o in ipairs(hostilesNear(f, at, m.radius)) do
						strike(f, o, hit, move)
						if not o.dead then
							Combat.stun(o, 0.5)
						end
					end
				end)
			end)
		end
	elseif kind == "whaleBreach" then
		-- 진 창해 고래강림 (오의): 발밑에서 거대한 물의 고래가 솟구쳐 앞으로 크게 뛰어올랐다가 땅을 덮치며 떨어진다
		local from = f.root.Position + look * 3
		local to = f.root.Position + look * m.dist
		f.iframeUntil = math.max(f.iframeUntil, os.clock() + (m.delay + 0.3) / sp)
		Push:FireAllClients("skillfx", { kind = "whale", from = from, to = to, delay = m.delay / sp, flight = m.flight / sp, radius = m.radius, style = style })
		after(m.delay, function()
			for _, o in ipairs(hostilesNear(f, from, m.launchRadius)) do
				strike(f, o, scaled(m.launch, sc), move)
			end
		end)
		local steps = 5
		for i = 1, steps - 1 do
			after(m.delay + m.flight * i / steps, function()
				local at = from:Lerp(to, i / steps)
				for _, o in ipairs(hostilesNear(f, at, 7)) do
					strike(f, o, hit, move)
				end
			end)
		end
		after(m.delay + m.flight, function()
			for _, o in ipairs(hostilesNear(f, to, m.radius)) do
				strike(f, o, scaled(m.final, sc), move)
				if not o.dead then
					Combat.stun(o, 1.2)
				end
			end
		end)
	elseif kind == "wanderTornado" then
		-- 진 풍신 회풍: 작은 회오리가 3초 동안 가까운 적을 쫓아다니며 들어 올린다
		local id = math.random(1, 1000000000)
		local pos = f.root.Position + look * 6
		Push:FireAllClients("skillfx", { kind = "twisterStart", id = id, at = pos, radius = m.radius, dur = m.dur / sp, style = style })
		local lastHit = {}
		local ticks = math.floor(m.dur / m.every)
		for i = 1, ticks do
			after(i * m.every, function()
				local list = hostilesNear(f, pos, m.seek)
				local here = pos
				table.sort(list, function(a, b)
					return (a.root.Position - here).Magnitude < (b.root.Position - here).Magnitude
				end)
				local tgt = list[1]
				if tgt then
					local d = Vector3.new(tgt.root.Position.X - pos.X, 0, tgt.root.Position.Z - pos.Z)
					if d.Magnitude > 0.5 then
						pos += d.Unit * math.min(d.Magnitude, m.speed * m.every)
					end
				else
					pos += look * m.speed * m.every * 0.5
				end
				if i % 2 == 0 then
					Push:FireAllClients("skillfx", { kind = "twisterMove", id = id, at = pos, time = (m.every * 2) / sp })
				end
				for _, o in ipairs(hostilesNear(f, pos, m.radius)) do
					if (lastHit[o] or 0) + m.gap / sp < os.clock() then
						lastHit[o] = os.clock()
						strike(f, o, hit, move)
					end
				end
			end)
		end
		after(m.dur + 0.05, function()
			Push:FireAllClients("skillfx", { kind = "twisterEnd", id = id, at = pos, radius = m.radius + 3, style = style })
			for _, o in ipairs(hostilesNear(f, pos, m.radius + 3)) do
				strike(f, o, scaled(m.final, sc), move)
			end
		end)
	elseif kind == "downdraft" then
		-- 진 풍신 풍압: 솟구친 뒤 하늘의 바람을 끌어내려 둘레의 적을 땅에 짓누른다 (먼저 가운데로 빨아들인다)
		Push:FireAllClients("skillfx", { kind = "downdraftWarn", m = f.model, time = m.delay / sp, radius = m.radius, style = style })
		after(m.delay * 0.5, function()
			for _, o in ipairs(hostilesNear(f, f.root.Position, m.radius + 4)) do
				pullTo(o, f.root.Position, 40)
			end
		end)
		after(m.delay, function()
			local c = f.root.Position
			Push:FireAllClients("skillfx", { kind = "downdraft", at = c, radius = m.radius, style = style })
			for _, o in ipairs(hostilesNear(f, c, m.radius)) do
				strike(f, o, hit, move)
				if not o.dead then
					Combat.stun(o, m.stun)
				end
			end
		end)
	elseif kind == "thunderDive" then
		-- 초·벽력 뇌신낙: 하늘로 솟았다가 벼락이 되어 적에게 내리꽂힌다. 떨어진 자리에서 네 갈래로 땅이 갈라지며 번개가 달린다
		f.iframeUntil = math.max(f.iframeUntil, os.clock() + (m.delay + 0.25) / sp)
		local list = nearestList(f, m.range, 1)
		local first = list[1]
		local markAt = first and first.root.Position or (f.root.Position + look * 12)
		Push:FireAllClients("skillfx", { kind = "diveMark", at = markAt, radius = m.radius, time = m.delay / sp, style = style })
		after(m.delay, function()
			local at = (first and not first.dead and first.root.Parent) and first.root.Position or markAt
			local top = f.root.Position + Vector3.new(0, 10, 0)
			local dir = flat(at - f.root.Position)
			moveTo(f, CFrame.lookAt(at + Vector3.new(0, 3, 0) - dir * 2, at + Vector3.new(0, 3, 0) + dir))
			Push:FireAllClients("skillfx", { kind = "diveImpact", from = top, at = at, radius = m.radius, dir = dir, length = m.length, delay = m.crackDelay / sp, style = style })
			for _, o in ipairs(hostilesNear(f, at, m.radius)) do
				strike(f, o, hit, move)
			end
			after(m.crackDelay, function()
				local right = rightOf(dir)
				local done = {}
				for _, d in ipairs({ dir, -dir, right, -right }) do
					for _, o in ipairs(hostilesOnSeg(f, at, at + d * m.length, m.width)) do
						if not done[o] then
							done[o] = true
							strike(f, o, scaled(m.crack, sc), move)
						end
					end
				end
			end)
		end)
	elseif kind == "ballLightning" then
		-- 초·벽력 천뢰구 (오의): 커다란 구슬 번개를 앞으로 천천히 굴린다. 둘레의 적을 번개로 끌어당기며 지지다가 끝에 터진다
		local id = math.random(1, 1000000000)
		local from = f.root.Position + look * 4 + Vector3.new(0, 3, 0)
		local dir = look
		Push:FireAllClients("skillfx", { kind = "ballStart", id = id, from = from, dir = dir, speed = m.speed * sp, dur = m.dur / sp, delay = m.delay / sp, radius = m.radius, style = style })
		local ticks = math.floor(m.dur / m.every)
		for i = 1, ticks do
			after(m.delay + i * m.every, function()
				local pos = from + dir * (m.speed * i * m.every)
				local list = hostilesNear(f, pos, m.radius)
				Push:FireAllClients("skillfx", { kind = "ballArc", from = pos, targets = modelsOf(list), style = style })
				for _, o in ipairs(list) do
					pullTo(o, pos, m.pull)
					strike(f, o, hit, move)
				end
			end)
		end
		after(m.delay + m.dur + 0.05, function()
			local pos = from + dir * (m.speed * m.dur)
			Push:FireAllClients("skillfx", { kind = "ballBurst", at = pos, radius = m.finalRadius, style = style })
			for _, o in ipairs(hostilesNear(f, pos, m.finalRadius)) do
				strike(f, o, scaled(m.final, sc), move)
			end
		end)
	elseif kind == "yinyangShot" then
		-- 2.6판 무극 음양탄 (E): 검은 구슬과 흰 구슬이 서로 감아 돌며 앞으로 날아간다. 지나는 길의 적을 치고,
		-- 끝에서 둘이 부딪쳐 그 자리로 적을 빨아들이며 터진다
		local from = f.root.Position + look * 2
		local to = from + look * m.length
		Push:FireAllClients("skillfx", { kind = "yyShot", from = from, dir = look, length = m.length, travel = m.travel / sp, delay = m.delay / sp, radius = m.radius, style = style })
		after(m.delay + m.travel * 0.5, function()
			for _, o in ipairs(hostilesOnSeg(f, from, to, m.width)) do
				strike(f, o, hit, move)
			end
		end)
		after(m.delay + m.travel, function()
			for _, o in ipairs(hostilesNear(f, to, m.radius)) do
				pullTo(o, to, m.pull)
				strike(f, o, scaled(m.burst, sc), move)
			end
		end)
	elseif kind == "taijiOrbit" then
		-- 2.6판 무극 태극선회 (R): 검은 구슬과 흰 구슬이 나를 축으로 소용돌이치며 멀리 퍼졌다가 되돌아온다.
		-- 구슬에 닿은 적을 치고 (한 번에 한 번), 돌아올 때 둘레의 적을 내 앞으로 끌어 모아 한 번 더 친다
		local center = f.root.Position
		Push:FireAllClients("skillfx", { kind = "yyOrbit", at = center, radius = m.radius, dur = m.dur / sp, delay = m.delay / sp, turns = m.turns, style = style })
		local ticks = math.floor(m.dur / m.every)
		for k = 1, ticks do
			after(m.delay + k * m.every, function()
				local u = k / ticks
				local r = m.radius * math.sin(u * math.pi)
				local a = u * m.turns * math.pi * 2
				local hitOnce = {}
				for side = 0, 1 do
					local aa = a + side * math.pi
					local op = center + Vector3.new(math.cos(aa) * r, 0, math.sin(aa) * r)
					for _, o in ipairs(hostilesNear(f, op, m.orbRadius)) do
						if not hitOnce[o] then
							hitOnce[o] = true
							strike(f, o, hit, move)
						end
					end
				end
			end)
		end
		after(m.delay + m.dur, function()
			local at = center + look * 3
			for _, o in ipairs(hostilesNear(f, center, m.radius)) do
				pullTo(o, at, m.pull)
				strike(f, o, scaled(m.final, sc), move)
			end
		end)
	elseif kind == "taijiSeal" then
		-- 2.6판 무극 태극인 (오의): 세상의 빛깔이 빠지고 발밑에 거대한 태극이 그려진다. 그 위의 적은 모두 멈춘다.
		-- 태극이 돌며 땅에서 떠올라 하늘에서 뒤집힌 뒤, 도장처럼 내리찍는다. 이어 흑과 백의 물결이 한 번 더 지나간다
		local center = f.root.Position
		Push:FireAllClients("skillfx", { kind = "taijiSeal", at = center, radius = m.radius, delay = m.delay / sp, liftAt = m.liftAt / sp, hitAt = m.hitAt / sp, style = style })
		after(m.delay, function()
			local victims = hostilesNear(f, center, m.radius)
			for _, o in ipairs(victims) do
				Combat.stun(o, (m.hitAt - m.delay) / sp + 0.3)
				o.model:SetAttribute("Frozen", true)
			end
			after(m.hitAt - m.delay, function()
				for _, o in ipairs(victims) do
					if o.model.Parent then
						o.model:SetAttribute("Frozen", nil)
					end
				end
				for _, o in ipairs(hostilesNear(f, center, m.radius)) do
					strike(f, o, hit, move)
				end
				after(m.waveAt, function()
					for _, o in ipairs(hostilesNear(f, center, m.radius + 6)) do
						strike(f, o, scaled(m.wave, sc), move)
					end
				end)
			end)
			-- 혹시 중간에 끊겨도 멈춤은 풀린다
			task.delay((m.hitAt - m.delay) / sp + 0.6, function()
				for _, o in ipairs(victims) do
					if o.model.Parent then
						o.model:SetAttribute("Frozen", nil)
					end
				end
			end)
		end)
	elseif kind == "inkSlash" then
		-- 2.7판 진 무극 일획 (E): 허공에 먹으로 한 획을 긋는다. 지나간 적을 베고, 잠시 뒤 획이 금빛으로 타오르며 터진다
		local from = f.root.Position + look * 2
		local to = from + look * m.length
		local seed = math.random(1, 1000)
		Push:FireAllClients("skillfx", { kind = "inkSlash", from = from, to = to, delay = m.delay / sp, burstAt = m.burstAt / sp, width = m.width, seed = seed, style = style })
		local hitList = {}
		after(m.delay, function()
			for _, o in ipairs(hostilesOnSeg(f, from, to, m.width)) do
				table.insert(hitList, o)
				strike(f, o, hit, move)
			end
		end)
		after(m.delay + m.burstAt, function()
			for _, o in ipairs(hostilesOnSeg(f, from, to, m.width + 1)) do
				strike(f, o, scaled(m.burst, sc), move)
			end
		end)
	elseif kind == "enso" then
		-- 2.7판 진 무극 원상 (R): 발밑에 먹 원을 그린다. 원 안의 적은 먹에 붙잡히고, 다 그리면 먹 벽이 솟았다가 금빛으로 무너진다
		local center = f.root.Position
		Push:FireAllClients("skillfx", { kind = "enso", at = center, radius = m.radius, draw = m.draw / sp, burstAt = m.burstAt / sp, style = style })
		after(m.draw, function()
			for _, o in ipairs(hostilesNear(f, center, m.radius)) do
				Combat.stun(o, m.hold / sp)
				strike(f, o, hit, move)
			end
		end)
		after(m.draw + m.burstAt, function()
			for _, o in ipairs(hostilesNear(f, center, m.radius + 3)) do
				strike(f, o, scaled(m.burst, sc), move)
			end
		end)
	elseif kind == "plumBranch" then
		-- 2.9판 진 매화 설중매 (E): 땅을 따라 매화 가지가 뻗고, 마디마다 차례로 꽃이 피며 벤다. 잠시 뒤 가지의 꽃이 한꺼번에 터진다
		local from = f.root.Position
		local right = rightOf(look)
		local nodes = {}
		for i = 1, m.nodes do
			local u = i / m.nodes
			local sway = math.sin(i * 1.7) * 2.2 * (0.4 + u)
			table.insert(nodes, from + look * (m.length * u) + right * sway)
		end
		Push:FireAllClients("skillfx", { kind = "plumBranch", from = from, nodes = nodes, delay = m.delay / sp, step = m.step / sp, burstAt = m.burstAt / sp, radius = m.radius, style = style })
		local done = {}
		for i, pt in ipairs(nodes) do
			after(m.delay + (i - 1) * m.step, function()
				for _, o in ipairs(hostilesNear(f, pt, m.radius)) do
					if not done[o] then
						done[o] = true
						strike(f, o, hit, move)
					end
				end
			end)
		end
		after(m.delay + (#nodes - 1) * m.step + m.burstAt, function()
			local burst = scaled(m.burst, sc)
			local hitSet = {}
			for _, pt in ipairs(nodes) do
				for _, o in ipairs(hostilesNear(f, pt, m.radius)) do
					if not hitSet[o] then
						hitSet[o] = true
						strike(f, o, burst, move)
					end
				end
			end
		end)
	elseif kind == "plumRing" then
		-- 2.9판 진 매화 한매오판 (R): 둘레 다섯 곳에 큰 매화가 피어 둘레의 적을 꽃술로 끌어당긴 뒤 눈보라와 함께 터진다
		local center = f.root.Position
		local rot = math.random() * math.pi * 2
		local spots = {}
		for i = 1, m.flowers do
			local a = rot + (i - 1) / m.flowers * math.pi * 2
			table.insert(spots, center + Vector3.new(math.cos(a), 0, math.sin(a)) * m.radius)
		end
		Push:FireAllClients("skillfx", { kind = "plumRing", at = center, spots = spots, delay = m.delay / sp, hold = m.hold / sp, style = style })
		local n = math.floor(m.hold / m.every)
		for k = 0, n - 1 do
			after(m.delay + k * m.every, function()
				for _, pt in ipairs(spots) do
					for _, o in ipairs(hostilesNear(f, pt, 7)) do
						pullTo(o, pt, m.pull)
						if k == 0 then
							strike(f, o, hit, move)
						end
					end
				end
			end)
		end
		after(m.delay + m.hold, function()
			local burst = scaled(m.burst, sc)
			local hitSet = {}
			for _, pt in ipairs(spots) do
				for _, o in ipairs(hostilesNear(f, pt, 8)) do
					if not hitSet[o] then
						hitSet[o] = true
						o.slowUntil = os.clock() + m.slow
						o.slowMul = 0.5
						strike(f, o, burst, move)
					end
				end
			end
		end)
	elseif kind == "plumSnow" then
		-- 2.9판 진 매화 설중매화 (오의): 둘레에 함박눈과 붉은 꽃잎이 휘몰아쳐 계속 베고, 마지막에 하늘의 거대한 매화에서 꽃잎이 쏟아진다
		local center = f.root.Position
		Push:FireAllClients("skillfx", { kind = "plumSnow", m = f.model, at = center, radius = m.radius, delay = m.delay / sp, dur = m.dur / sp, style = style })
		local n = math.floor(m.dur / m.every)
		for i = 1, n do
			after(m.delay + i * m.every, function()
				for _, o in ipairs(hostilesNear(f, center, m.radius)) do
					o.slowUntil = os.clock() + 0.5
					o.slowMul = 0.6
					strike(f, o, hit, move)
				end
			end)
		end
		after(m.delay + m.dur, function()
			for _, o in ipairs(hostilesNear(f, center, m.finalRadius)) do
				strike(f, o, scaled(m.final, sc), move)
			end
		end)
	elseif kind == "drunkZig" then
		-- 2.9판 진 취팔선 취월삼보 (E): 좌우로 크게 휘청이며 세 번 뛰어든다 (무적). 내려설 때마다 둘레를 걷어찬다
		f.iframeUntil = math.max(f.iframeUntil, os.clock() + (m.hops * m.every + 0.2) / sp)
		local right = rightOf(look)
		local pos = f.root.Position
		local hops = {}
		for i = 1, m.hops do
			local side = (i % 2 == 1) and 1 or -1
			local d = (look * 0.8 + right * side * 0.6).Unit
			pos = pos + d * m.dist
			table.insert(hops, pos)
		end
		Push:FireAllClients("skillfx", { kind = "drunkZig", m = f.model, hops = hops, every = m.every / sp, style = style })
		for i, at in ipairs(hops) do
			after(i * m.every, function()
				local y = f.root.Position.Y
				local p = Vector3.new(at.X, y, at.Z)
				moveTo(f, CFrame.lookAt(p, p + look))
				for _, o in ipairs(hostilesNear(f, p, m.radius)) do
					strike(f, o, hit, move)
				end
			end)
		end
	elseif kind == "wineRiver" then
		-- 2.9판 진 취팔선 주천강 (R): 호리병의 술이 앞으로 강이 되어 흐른다. 강 위의 적은 굼뜨고, 마지막에 강에 불이 붙는다
		local from = f.root.Position + look * 2
		local to = from + look * m.length
		Push:FireAllClients("skillfx", { kind = "wineRiver", m = f.model, from = from, to = to, width = m.width, delay = m.delay / sp, dur = m.dur / sp, style = style })
		local n = math.floor(m.dur / m.every)
		for i = 0, n - 1 do
			after(m.delay + i * m.every, function()
				for _, o in ipairs(hostilesOnSeg(f, from, to, m.width / 2 + 1)) do
					o.slowUntil = os.clock() + 0.6
					o.slowMul = 0.45
					strike(f, o, hit, move)
				end
			end)
		end
		after(m.delay + m.dur, function()
			for _, o in ipairs(hostilesOnSeg(f, from, to, m.width / 2 + 2)) do
				strike(f, o, scaled(m.burst, sc), move)
			end
		end)
	elseif kind == "eightImmortals" then
		-- 2.9판 진 취팔선 팔선강림 (오의): 여덟 신선의 그림자가 둘레에 나타나 차례로 가까운 적에게 덮쳐 들고, 하늘에서 거대한 호리병이 내리꽂힌다
		local center = f.root.Position
		local spots = {}
		for i = 1, m.n do
			local a = (i - 1) / m.n * math.pi * 2
			table.insert(spots, center + Vector3.new(math.cos(a), 0, math.sin(a)) * m.radius)
		end
		local list = nearestList(f, m.range, m.n)
		local targets = {}
		for i = 1, m.n do
			local t = #list > 0 and list[(i - 1) % #list + 1] or nil
			targets[i] = t and t.model or false
		end
		Push:FireAllClients("skillfx", { kind = "eightImmortals", m = f.model, at = center, spots = spots, targets = targets, delay = m.delay / sp, every = m.every / sp, finalAt = m.finalAt / sp, finalRadius = m.finalRadius, style = style })
		for i = 1, m.n do
			after(m.delay + (i - 1) * m.every + 0.15, function()
				local t = #list > 0 and list[(i - 1) % #list + 1] or nil
				if t and not t.dead and t.root.Parent then
					strike(f, t, hit, move)
				else
					for _, o in ipairs(hostilesNear(f, spots[i], 6)) do
						strike(f, o, hit, move)
					end
				end
			end)
		end
		after(m.delay + (m.n - 1) * m.every + m.finalAt, function()
			for _, o in ipairs(hostilesNear(f, center, m.finalRadius)) do
				strike(f, o, scaled(m.final, sc), move)
			end
		end)
	-- 3.2판 환생 권법 (E·R·G 새로, 초 오의 X) ------------------------------------------------
	elseif kind == "rinneTriWheel" then
		-- 윤회권 윤회삼륜 (E): 금빛 바퀴와 지난 삶의 쪽빛 바퀴 둘이 부채꼴로 구르며 나갔다가 되돌아온다
		-- 바퀴 k의 자리 = 던진 자리 + 방향k × dist × sin(πu). 방향k = look을 (k-2)×spread 도 돌린 것. 양옆 바퀴는 lag 늦게 출발 (화면도 같은 식)
		local from = f.root.Position
		Push:FireAllClients("skillfx", { kind = "rinneTriWheel", m = f.model, from = from, dir = look, dist = m.dist, time = m.time / sp, spread = m.spread, lag = m.lag / sp, style = style })
		local eh = scaled(m.echo, sc)
		local n = math.floor(m.time / m.every)
		for k = 1, 3 do
			local dk = CFrame.Angles(0, math.rad((k - 2) * m.spread), 0):VectorToWorldSpace(look)
			local start = k == 2 and 0 or m.lag
			local last: { [any]: number } = {}
			for i = 1, n do
				after(start + i * m.every, function()
					local pos = from + dk * (m.dist * math.sin(i / n * math.pi))
					local now = os.clock()
					for _, o in ipairs(hostilesNear(f, pos, m.radius)) do
						if not last[o] or now - last[o] > 0.25 then
							last[o] = now
							strike(f, o, k == 2 and hit or eh, move)
						end
					end
				end)
			end
		end
	elseif kind == "threeLives" then
		-- 윤회권 삼생보 (R): 미끄러지며 베면, 지난 세 삶의 그림자가 같은 길을 차례로 다시 내달리고, 끝에서 하나로 모여 터진다
		local a = f.root.Position
		local b = a + look * m.dist
		Push:FireAllClients("skillfx", { kind = "threeLives", m = f.model, from = a, to = b, delay = m.delay / sp, gap = m.gap / sp, merge = m.merge / sp, style = style })
		after(0.15, function()
			for _, o in ipairs(hostilesOnSeg(f, a, b, m.width)) do
				strike(f, o, hit, move)
			end
		end)
		local echo = scaled(m.echo, sc)
		for k = 1, 3 do
			after(m.delay + (k - 1) * m.gap + 0.12, function()
				for _, o in ipairs(hostilesOnSeg(f, a, b, m.width)) do
					strike(f, o, echo, move)
				end
			end)
		end
		after(m.merge, function()
			for _, o in ipairs(hostilesNear(f, b, m.burstRadius)) do
				strike(f, o, scaled(m.burst, sc), move)
			end
		end)
	elseif kind == "sixRealms" then
		-- 윤회권 육도윤회 (오의, 3.2판): 하늘로 오른 큰 바퀴의 여섯 구슬이 적 둘레 여섯 자리에 꽂혀 빛기둥이 되고 육각별로 이어진다.
		-- 바퀴가 누워 내려와 별 위를 갈며 돌다가 내리박혀 터진다
		local from = f.root.Position
		local c = from + look * m.dist
		local rot = math.atan2(look.Z, look.X)
		local spots = {}
		for i = 1, 6 do
			local a = rot + (i - 1) / 6 * math.pi * 2
			spots[i] = c + Vector3.new(math.cos(a), 0, math.sin(a)) * m.hexR
		end
		local T1 = m.rise + 6 * m.every
		local T2 = T1 + m.link
		Push:FireAllClients("skillfx", { kind = "sixRealms", m = f.model, from = from, at = c, dir = look, spots = spots, rise = m.rise / sp, every = m.every / sp, fly = m.fly / sp,
			link = m.link / sp, grind = m.grind / sp, hexR = m.hexR, radius = m.finalRadius, style = style })
		for i = 1, 6 do
			after(m.rise + (i - 1) * m.every + m.fly, function()
				for _, o in ipairs(hostilesNear(f, spots[i], m.radius)) do
					strike(f, o, hit, move)
				end
			end)
		end
		local gh = scaled(m.grindHit, sc)
		for i = 1, math.floor(m.grind / m.grindEvery) do
			after(T2 + i * m.grindEvery, function()
				for _, o in ipairs(hostilesNear(f, c, m.hexR + 4)) do
					pullTo(o, c, m.pull)
					strike(f, o, gh, move)
				end
			end)
		end
		after(T2 + m.grind, function()
			for _, o in ipairs(hostilesNear(f, c, m.finalRadius)) do
				strike(f, o, scaled(m.final, sc), move)
			end
		end)
	elseif kind == "rebirthCycle" then
		-- 윤회권 윤회전생 (초 오의): 컷씬 동안 하늘에 거대한 윤회륜이 걸리고 지난 네 삶이 일어선다 (그동안 무적).
		-- 전생의 군세가 적에게 번갈아 덮치고 → 바퀴가 땅에 누워 둘레를 가두고 갈며 끌어당기고 → 모두 하나로 모여 다시 태어나며 터진다
		local C = f.root.Position
		local T1 = m.cut
		local T2 = T1 + m.army
		local T3 = T2 + m.cage
		local T4 = T3 + m.merge
		f.iframeUntil = math.max(f.iframeUntil, os.clock() + T4 / sp + 0.2)
		Push:FireAllClients("skillfx", { kind = "rebirthCycle", m = f.model, at = C, dir = look, cut = T1 / sp, army = m.army / sp, cage = m.cage / sp, merge = m.merge / sp, cageR = m.cageR, radius = m.finalRadius, style = style })
		local sh = scaled(m.strike, sc)
		for i = 1, math.floor(m.army / m.every) do
			after(T1 + i * m.every, function()
				local list = hostilesNear(f, C, m.range)
				local ats = {}
				for _ = 1, math.min(m.n, #list) do
					local o = list[math.random(1, #list)]
					table.insert(ats, o.root.Position)
					strike(f, o, sh, move)
				end
				if #ats > 0 then
					Push:FireAllClients("skillfx", { kind = "rebirthStrike", m = f.model, at = C, ats = ats, k = (i % 4) + 1, style = style })
				end
			end)
		end
		local gh = scaled(m.grind, sc)
		for i = 1, math.floor(m.cage / m.cageEvery) do
			after(T2 + i * m.cageEvery, function()
				for _, o in ipairs(hostilesNear(f, C, m.cageR)) do
					pullTo(o, C, m.pull)
					strike(f, o, gh, move)
				end
			end)
		end
		after(T4, function()
			for _, o in ipairs(hostilesNear(f, C, m.finalRadius)) do
				strike(f, o, scaled(m.final, sc), move)
			end
		end)
	elseif kind == "karmaChains" then
		-- 업화권 업화쇄 (E): 두 팔의 달군 사슬이 가까운 적 셋에게 날아가 걸리고, 검은 불이 사슬을 타고 번지며 끌어온 뒤 적 발밑에서 터진다
		local list = nearestList(f, m.range, m.n)
		local to = f.root.Position + look * 14
		Push:FireAllClients("skillfx", { kind = "karmaChains", m = f.model, targets = modelsOf(list), to = to, hook = m.hook / sp, hold = m.hold / sp, style = style })
		local bh = scaled(m.burst, sc)
		for _, o in ipairs(list) do
			after(m.hook, function()
				if not o.dead then
					strike(f, o, hit, move)
					pullTo(o, f.root.Position + look * 3, m.pull)
				end
			end)
			after(m.hook + m.hold, function()
				if o.root.Parent then
					for _, q in ipairs(hostilesNear(f, o.root.Position, m.burstRadius)) do
						strike(f, q, bh, move)
					end
				end
			end)
		end
		if #list == 0 then
			after(m.hook + m.hold, function()
				for _, q in ipairs(hostilesNear(f, to, m.burstRadius)) do
					strike(f, q, bh, move)
				end
			end)
		end
	elseif kind == "hellDash" then
		-- 업화권 겁화질주 (R): 검은 불꽃이 되어 내달리면 지난 길이 용암 틈으로 갈라져 타고, 도화선처럼 불기둥이 차례로 치솟아 끝에서 크게 터진다
		local a = f.root.Position
		local b = a + look * m.dist
		Push:FireAllClients("skillfx", { kind = "hellDash", m = f.model, from = a, to = b, burn = m.burn / sp, erupt = m.erupt / sp, pillars = m.pillars, step = m.step / sp, style = style })
		after(0.12, function()
			for _, o in ipairs(hostilesOnSeg(f, a, b, m.width)) do
				strike(f, o, hit, move)
			end
		end)
		local bh = scaled(m.burnHit, sc)
		for i = 1, math.floor(m.burn / m.every) do
			after(0.2 + i * m.every, function()
				for _, o in ipairs(hostilesOnSeg(f, a, b, m.width)) do
					strike(f, o, bh, move)
				end
			end)
		end
		local ph = scaled(m.pillar, sc)
		for i = 1, m.pillars do
			after(m.erupt + (i - 1) * m.step, function()
				for _, o in ipairs(hostilesNear(f, a:Lerp(b, i / m.pillars), m.pillarRadius)) do
					strike(f, o, ph, move)
				end
			end)
		end
		after(m.erupt + m.pillars * m.step + 0.1, function()
			for _, o in ipairs(hostilesNear(f, b, m.finalRadius)) do
				strike(f, o, scaled(m.final, sc), move)
			end
		end)
	elseif kind == "hellGate" then
		-- 업화권 업화지옥문 (오의): 앞의 땅에서 거대한 지옥문이 솟아 열리고, 문 안에서 뻗은 사슬이 둘레의 적을 문 앞으로 끌고 간다.
		-- 문이 쾅 닫히고, 땅속으로 가라앉으며 지옥불 고리로 터진다
		local from = f.root.Position
		local c = from + look * m.dist
		local T2 = m.rise + m.open
		local T3 = T2 + m.drag
		local T4 = T3 + m.shut
		Push:FireAllClients("skillfx", { kind = "hellGate", m = f.model, from = from, at = c, dir = look, rise = m.rise / sp, open = m.open / sp, drag = m.drag / sp, shut = m.shut / sp, sink = m.sink / sp, dragR = m.dragR, radius = m.finalRadius, style = style })
		for i = 1, math.floor(m.drag / m.every) do
			after(T2 + i * m.every, function()
				local ats = {}
				for _, o in ipairs(hostilesNear(f, c, m.dragR)) do
					pullTo(o, c, m.pull)
					strike(f, o, hit, move)
					table.insert(ats, o.root.Position)
				end
				if #ats > 0 and i % 2 == 1 then
					Push:FireAllClients("skillfx", { kind = "gateChain", at = c, ats = ats, style = style })
				end
			end)
		end
		after(T4, function()
			for _, o in ipairs(hostilesNear(f, c, m.shutR)) do
				strike(f, o, scaled(m.shutHit, sc), move)
			end
		end)
		after(T4 + m.sink, function()
			for _, o in ipairs(hostilesNear(f, c, m.finalRadius)) do
				strike(f, o, scaled(m.final, sc), move)
			end
		end)
	elseif kind == "eightHells" then
		-- 업화권 팔열지옥 (초 오의): 컷씬 동안 하늘이 핏빛이 되고 둘레에 검은 불기둥 여덟이 솟는다 (그동안 무적).
		-- 기둥이 하나씩 적에게 지옥불을 내리꽂고 → 땅에서 솟은 거대한 두 손이 가운데를 맞잡아 짓누르고 → 기둥들이 모여 검은 해가 되어 내리꽂힌다
		local C = f.root.Position
		local T1 = m.cut
		local T2 = T1 + 8 * m.every
		local T3 = T2 + m.hands
		local T4 = T3 + m.sun
		f.iframeUntil = math.max(f.iframeUntil, os.clock() + T4 / sp + 0.2)
		Push:FireAllClients("skillfx", { kind = "eightHells", m = f.model, at = C, dir = look, cut = T1 / sp, every = m.every / sp, hands = m.hands / sp, sun = m.sun / sp, ringR = m.ringR, radius = m.finalRadius, style = style })
		local rot = math.atan2(look.Z, look.X)
		for i = 1, 8 do
			after(T1 + (i - 1) * m.every, function()
				local a = rot + (i - 1) / 8 * math.pi * 2
				local src = C + Vector3.new(math.cos(a), 0, math.sin(a)) * m.ringR
				local list = hostilesNear(f, C, m.range)
				local at = #list > 0 and list[math.random(1, #list)].root.Position or (C + (src - C) * 0.45)
				Push:FireAllClients("skillfx", { kind = "hellStrike", m = f.model, at = at, from = src, idx = i, style = style })
				task.delay(0.18 / sp, function()
					if alive() then
						for _, o in ipairs(hostilesNear(f, at, m.radius)) do
							strike(f, o, hit, move)
						end
					end
				end)
			end)
		end
		for i = 0, math.floor(m.hands / 0.2) - 1 do
			after(T2 + i * 0.2, function()
				for _, o in ipairs(hostilesNear(f, C, m.range)) do
					pullTo(o, C, m.pull)
				end
			end)
		end
		after(T2 + m.hands * 0.85, function()
			for _, o in ipairs(hostilesNear(f, C, m.clapR)) do
				strike(f, o, scaled(m.clap, sc), move)
			end
		end)
		after(T4, function()
			for _, o in ipairs(hostilesNear(f, C, m.finalRadius)) do
				strike(f, o, scaled(m.final, sc), move)
			end
		end)
	elseif kind == "phantomRush" then
		-- 무상권 무상섬 (E): 안개가 되어 가까운 적 다섯의 등 뒤로 차례로 나타나며 친다 (그동안 무적).
		-- 지나간 자리마다 남은 잔상이 마지막에 한꺼번에 다시 베고 안개로 흩어진다
		local list = nearestList(f, m.range, m.n)
		local tEnd = m.delay + math.max(1, #list) * m.every
		f.iframeUntil = math.max(f.iframeUntil, os.clock() + (tEnd + 0.3) / sp)
		Push:FireAllClients("skillfx", { kind = "phantomRush", m = f.model, from = f.root.Position, dir = look, targets = modelsOf(list), delay = m.delay / sp, every = m.every / sp, echo = m.echoAt / sp, style = style })
		if #list == 0 then
			after(m.delay, function()
				local p = f.root.Position + look * 12
				moveTo(f, CFrame.lookAt(p, p + look))
				for _, o in ipairs(hostilesNear(f, p, 6)) do
					strike(f, o, hit, move)
				end
			end)
		end
		for i, t in ipairs(list) do
			after(m.delay + (i - 1) * m.every, function()
				if t.dead or not t.root.Parent then
					return
				end
				local tp = t.root.Position
				local d = flat(tp - f.root.Position)
				local p = Vector3.new(tp.X, f.root.Position.Y, tp.Z) + d * 3.2
				moveTo(f, CFrame.lookAt(p, Vector3.new(tp.X, p.Y, tp.Z)))
				for _, o in ipairs(hostilesNear(f, tp, 5)) do
					strike(f, o, hit, move)
				end
			end)
		end
		local eh = scaled(m.echo, sc)
		after(tEnd + m.echoAt, function()
			for _, t in ipairs(list) do
				if not t.dead and t.root.Parent then
					strike(f, t, eh, move)
				end
			end
		end)
	elseif kind == "mistStar" then
		-- 무상권 허실분신 (R): 몸이 흩어져 (보이지 않는다) 안개 분신 다섯이 별처럼 사방으로 뻗어 베고,
		-- 서로 엇갈려 되돌아오며 오각별을 긋고, 가운데에서 내가 다시 나타나며 터진다
		local C = f.root.Position
		local rot = math.atan2(look.Z, look.X)
		local pts = {}
		for k = 1, 5 do
			local a = rot + (k - 1) / 5 * math.pi * 2
			pts[k] = C + Vector3.new(math.cos(a), 0, math.sin(a)) * m.radius
		end
		f.model:SetAttribute("Vanish", true)
		f.iframeUntil = math.max(f.iframeUntil, os.clock() + (m.back + 0.2) / sp)
		Push:FireAllClients("skillfx", { kind = "mistStar", m = f.model, at = C, pts = pts, out = m.out / sp, cross = m.cross / sp, back = m.back / sp, style = style })
		local model = f.model
		task.delay(m.back / sp, function()
			model:SetAttribute("Vanish", nil)
		end)
		after(m.out, function()
			for k = 1, 5 do
				for _, o in ipairs(hostilesOnSeg(f, C, pts[k], m.width)) do
					strike(f, o, hit, move)
				end
			end
		end)
		local ch = scaled(m.crossHit, sc)
		after(m.cross + 0.1, function()
			for k = 1, 5 do
				for _, o in ipairs(hostilesOnSeg(f, pts[k], pts[(k + 1) % 5 + 1], m.width)) do
					strike(f, o, ch, move)
				end
			end
		end)
		after(m.back, function()
			for _, o in ipairs(hostilesNear(f, C, m.burstRadius)) do
				strike(f, o, scaled(m.burst, sc), move)
			end
		end)
	elseif kind == "mistSea" then
		-- 무상권 무상해 (오의): 발밑에서 잿빛 안개의 바다가 퍼지고 세상의 빛깔이 빠진다. 안개에서 넋의 손이 솟아 적을 붙잡고,
		-- 손뼉 한 번에 안개가 가운데로 빨려 들어 기둥이 되었다가 사방으로 베며 흩어진다
		local C = f.root.Position
		local list = nearestList(f, m.radius, 8)
		Push:FireAllClients("skillfx", { kind = "mistSea", m = f.model, at = C, targets = modelsOf(list), spread = m.spread / sp, hold = m.hold / sp, implode = m.implode / sp, radius = m.radius, style = style })
		for i = 1, math.floor(m.hold / m.every) do
			after(m.spread + i * m.every, function()
				for _, o in ipairs(hostilesNear(f, C, m.radius)) do
					o.slowUntil = os.clock() + 0.4
					o.slowMul = 0.5
					strike(f, o, hit, move)
				end
			end)
		end
		for i = 0, 2 do
			after(m.spread + m.hold + i * 0.1, function()
				for _, o in ipairs(hostilesNear(f, C, m.radius + 4)) do
					pullTo(o, C, m.pull)
				end
			end)
		end
		after(m.spread + m.hold + m.implode, function()
			for _, o in ipairs(hostilesNear(f, C, m.finalRadius)) do
				strike(f, o, scaled(m.final, sc), move)
			end
		end)
	elseif kind == "allReturn" then
		-- 무상권 만상귀무 (초 오의): 컷씬 동안 세상이 잿빛이 되고 몸이 안개로 흩어진다 (그동안 무적, 보이지 않음).
		-- 안개가 거대한 나의 그림자로 일어서 넋의 칼로 둘레를 세 번 크게 베고 → 시간이 멈춰 적마다 푸른 봉인이 찍히고
		-- → 그림자가 내 자리로 흩어져 모이는 순간 빛깔이 돌아오며 봉인이 한꺼번에 깨진다
		local C = f.root.Position
		local T2 = m.cut + m.rise
		local T3 = T2 + m.sweeps * m.sweepEvery
		local T4 = T3 + m.freeze
		f.model:SetAttribute("Vanish", true)
		f.iframeUntil = math.max(f.iframeUntil, os.clock() + T4 / sp + 0.3)
		Push:FireAllClients("skillfx", { kind = "allReturn", m = f.model, at = C, dir = look, cut = m.cut / sp, rise = m.rise / sp, sweeps = m.sweeps, sweepEvery = m.sweepEvery / sp, sweepT = m.sweepT / sp, freeze = m.freeze / sp, range = m.range, radius = m.finalRadius, style = style })
		local model = f.model
		task.delay(T4 / sp, function()
			model:SetAttribute("Vanish", nil)
		end)
		local sw = scaled(m.sweep, sc)
		for k = 1, m.sweeps do
			after(T2 + (k - 1) * m.sweepEvery + m.sweepT, function()
				for _, o in ipairs(hostilesNear(f, C, m.range)) do
					strike(f, o, sw, move)
				end
			end)
		end
		after(T3, function()
			local ats = {}
			for _, o in ipairs(hostilesNear(f, C, m.range)) do
				table.insert(ats, o.root.Position)
			end
			Push:FireAllClients("skillfx", { kind = "voidSeals", m = f.model, at = C, ats = ats, freeze = m.freeze / sp, style = style })
		end)
		after(T4, function()
			for _, o in ipairs(hostilesNear(f, C, m.finalRadius)) do
				strike(f, o, scaled(m.final, sc), move)
			end
		end)
	elseif kind == "kingBarrage" then
		-- 권왕신권 왕권천타 (E): 등 뒤에 금빛 주먹 여섯이 부채꼴로 나타나 차례로 앞으로 내지르고, 마지막에 큰 주먹이 가운데를 꿰뚫는다
		-- k번째 주먹의 줄 = 옆으로 (짝수 +, 홀수 -) × ceil(k/2) × 1.6 (화면도 같은 식)
		local from = f.root.Position
		local right = rightOf(look)
		Push:FireAllClients("skillfx", { kind = "kingBarrage", m = f.model, from = from, dir = look, n = m.n, every = m.every / sp, delay = m.delay / sp, finalAt = m.finalAt / sp, length = m.length, style = style })
		for k = 1, m.n do
			local off = right * ((k % 2 == 0 and 1 or -1) * math.ceil(k / 2) * 1.6)
			after(m.delay + (k - 1) * m.every + 0.07, function()
				for _, o in ipairs(hostilesOnSeg(f, from + off, from + off + look * m.length, m.width)) do
					strike(f, o, hit, move)
				end
			end)
		end
		after(m.delay + m.n * m.every + m.finalAt, function()
			for _, o in ipairs(hostilesOnSeg(f, from, from + look * (m.length + 6), m.width * 1.8)) do
				strike(f, o, scaled(m.final, sc), move)
			end
		end)
	elseif kind == "kingLeap" then
		-- 권왕신권 왕도강림 (R): 붉은 길이 깔리고 그 위로 크게 뛰어올라 내려앉으면, 왕관의 가시 여덟이 둘레에서 솟았다가 안으로 무너지며 터진다
		local a = f.root.Position
		local b = a + look * m.dist
		Push:FireAllClients("skillfx", { kind = "kingLeap", m = f.model, from = a, to = b, land = m.land / sp, style = style })
		after(m.land, function()
			local p = f.root.Position
			Push:FireAllClients("skillfx", { kind = "kingLand", m = f.model, at = p, collapse = m.collapse / sp, spikeR = m.spikeR, style = style })
			for _, o in ipairs(hostilesNear(f, p, m.landR)) do
				strike(f, o, hit, move)
			end
			task.delay(m.collapse / sp, function()
				if alive() then
					for _, o in ipairs(hostilesNear(f, p, m.spikeR + 2)) do
						strike(f, o, scaled(m.burst, sc), move)
					end
				end
			end)
		end)
	elseif kind == "crownCage" then
		-- 권왕신권 만인지상 (오의): 하늘에서 거대한 금빛 왕관이 내려와 적들을 가두고, 돌며 조여 들고, 보석이 빛줄기를 쏘고,
		-- 한 번 더 내리박혀 금빛으로 터진다
		local from = f.root.Position
		local c = from + look * m.dist
		Push:FireAllClients("skillfx", { kind = "crownCage", m = f.model, from = from, at = c, dir = look, descend = m.descend / sp, squeeze = m.squeeze / sp, slam = m.slam / sp, R = m.R, radius = m.finalRadius, style = style })
		after(m.descend, function()
			for _, o in ipairs(hostilesNear(f, c, m.R)) do
				strike(f, o, scaled(m.drop, sc), move)
			end
		end)
		for i = 1, math.floor(m.squeeze / m.every) do
			after(m.descend + i * m.every, function()
				for _, o in ipairs(hostilesNear(f, c, m.R + 2)) do
					pullTo(o, c, m.pull)
					strike(f, o, hit, move)
				end
			end)
		end
		after(m.descend + m.squeeze + m.slam, function()
			for _, o in ipairs(hostilesNear(f, c, m.finalRadius)) do
				strike(f, o, scaled(m.final, sc), move)
			end
		end)
	elseif kind == "kingOfHeaven" then
		-- 권왕신권 천하제일권 (초 오의): 컷씬 동안 금빛 구름이 갈라지고 등 뒤에 거대한 금빛 왕이 일어선다 (그동안 무적).
		-- 왕이 앞의 땅에 금빛 주먹비를 쏟고 → 왕과 내가 함께 주먹을 당겨 힘을 모으고 → 함께 내지르면 거대한 주먹이 80칸을 꿰뚫고 끝에서 터진다
		local C = f.root.Position
		local right = rightOf(look)
		local T1 = m.cut
		local T2 = T1 + m.rain
		local T3 = T2 + m.charge
		local T4 = T3 + m.punch
		local T5 = T4 + m.endAt
		f.iframeUntil = math.max(f.iframeUntil, os.clock() + T5 / sp + 0.2)
		Push:FireAllClients("skillfx", { kind = "kingOfHeaven", m = f.model, at = C, dir = look, cut = T1 / sp, rain = m.rain / sp, charge = m.charge / sp, punch = m.punch / sp, endAt = m.endAt / sp, length = m.length, width = m.width, style = style })
		local rh = scaled(m.rainHit, sc)
		for i = 1, math.floor(m.rain / m.every) do
			after(T1 + i * m.every, function()
				local list = hostilesNear(f, C + look * m.length * 0.3, m.range)
				local at
				if #list > 0 and math.random() < 0.75 then
					at = list[math.random(1, #list)].root.Position
				else
					at = C + look * (8 + math.random() * 30) + right * (math.random() - 0.5) * 36
				end
				Push:FireAllClients("skillfx", { kind = "kingRain", m = f.model, at = at, from = C - look * 10 + Vector3.new(0, 34, 0), fall = m.fall / sp, style = style })
				task.delay(m.fall / sp, function()
					if alive() then
						for _, o in ipairs(hostilesNear(f, at, m.rainR)) do
							strike(f, o, rh, move)
						end
					end
				end)
			end)
		end
		after(T4, function()
			for _, o in ipairs(hostilesOnSeg(f, C, C + look * m.length, m.width)) do
				strike(f, o, scaled(m.final, sc), move)
			end
		end)
		after(T5, function()
			for _, o in ipairs(hostilesNear(f, C + look * m.length, m.endR)) do
				strike(f, o, scaled(m.endHit, sc), move)
			end
		end)
	-- 3.1판 극 일월신권 ------------------------------------------------
	elseif kind == "twinDiscs" then
		-- 일월쌍륜 (E): 해와 달의 원반이 엇갈리는 활을 그리며 날아가 앞에서 만나 터진다
		-- 원반 자리 = 시작점 + 앞으로 dist·u + 옆으로 (해 +1, 달 -1) swing·sin(πu) (화면도 같은 식)
		local from = f.root.Position
		local right = rightOf(look)
		Push:FireAllClients("skillfx", { kind = "twinDiscs", m = f.model, from = from, dir = look, dist = m.dist, swing = m.swing, time = m.time / sp, style = style })
		local hitBy: { [string]: { [any]: boolean } } = { sun = {}, moon = {} }
		local n = math.floor(m.time / m.every)
		for i = 1, n do
			after(i * m.every, function()
				local u = i / n
				for _, side in ipairs({ 1, -1 }) do
					local key = side == 1 and "sun" or "moon"
					local pos = from + look * (m.dist * u) + right * (side * m.swing * math.sin(u * math.pi))
					for _, o in ipairs(hostilesNear(f, pos, m.radius)) do
						if not hitBy[key][o] then
							hitBy[key][o] = true
							strike(f, o, hit, move)
						end
					end
				end
			end)
		end
		after(m.time, function()
			for _, o in ipairs(hostilesNear(f, from + look * m.dist, m.burstRadius)) do
				strike(f, o, scaled(m.burst, sc), move)
			end
		end)
	elseif kind == "solarLunarStep" then
		-- 일월환보 (R): 제자리에 해가 터지고, 지나간 길을 달빛이 베고, 내려선 자리에서 초승달이 터진다
		local a = f.root.Position
		local b = a + look * m.dist
		Push:FireAllClients("skillfx", { kind = "solarLunarStep", m = f.model, from = a, to = b, style = style })
		after(0.05, function()
			for _, o in ipairs(hostilesNear(f, a, m.sunRadius)) do
				strike(f, o, scaled(m.sun, sc), move)
			end
		end)
		after(0.3, function()
			for _, o in ipairs(hostilesOnSeg(f, a, b, m.width)) do
				strike(f, o, scaled(m.moon, sc), move)
			end
		end)
		after(0.45, function()
			for _, o in ipairs(hostilesNear(f, b, m.landRadius)) do
				strike(f, o, scaled(m.land, sc), move)
			end
		end)
	elseif kind == "sunMoonFall" then
		-- 대일월천 (오의, 3.1.1판): 등 뒤에 해와 달이 떠오르고, 해의 빛줄기가 앞의 땅을 앞뒤로 쓸고, 달의 초승달 셋이 내리꽂히고,
		-- 둘이 적 위에서 부딪쳐 일식이 되어 땅에 박히며 터진다
		local from = f.root.Position
		local c = from + look * m.dist
		local slamAt = m.summon + 0.15
		Push:FireAllClients("skillfx", { kind = "sunMoonFall", m = f.model, at = c, from = from, dir = look, summon = m.summon / sp, beam = m.beam / sp, sweep = m.sweep,
			slams = m.slams, slamAt = slamAt / sp, slamEvery = m.slamEvery / sp, travel = m.travel / sp, merge = m.merge / sp, radius = m.finalRadius, style = style })
		local n = math.floor(m.beam / m.every)
		for i = 0, n - 1 do
			after(m.summon + i * m.every, function()
				for _, o in ipairs(hostilesOnSeg(f, c - look * (m.sweep + 2), c + look * (m.sweep + 2), m.width)) do
					strike(f, o, hit, move)
				end
			end)
		end
		local sh = scaled(m.slam, sc)
		for i = 1, m.slams do
			after(slamAt + (i - 1) * m.slamEvery + m.travel, function()
				for _, o in ipairs(hostilesNear(f, c, m.slamRadius)) do
					strike(f, o, sh, move)
				end
			end)
		end
		after(m.summon + m.beam + m.merge, function()
			for _, o in ipairs(hostilesNear(f, c, m.finalRadius)) do
				strike(f, o, scaled(m.final, sc), move)
			end
		end)
	elseif kind == "eclipseGenesis" then
		-- 일월개벽 (초 오의, 3.1.1판): 컷씬 동안 등 뒤 지평선에서 해와 달이 솟고 (그동안 무적),
		-- 둘이 나를 두고 점점 빨리 돌며 번갈아 적을 친다 → 머리 위에서 부딪쳐 일식 → 일식의 빛살 → 일식이 깨지며 새벽빛으로 터진다
		local center = f.root.Position
		local T1 = m.cut
		local T2 = T1 + m.orbit
		local T3 = T2 + m.collide
		local T4 = T3 + m.rays
		local T5 = T4 + m.finalAt
		f.iframeUntil = math.max(f.iframeUntil, os.clock() + T5 / sp + 0.2)
		Push:FireAllClients("skillfx", { kind = "eclipseGenesis", m = f.model, at = center, dir = look, cut = T1 / sp, orbit = m.orbit / sp, collide = m.collide / sp, rays = m.rays / sp,
			finalAt = m.finalAt / sp, orbitR = m.orbitR, range = m.range, radius = m.finalRadius, style = style })
		local oh = scaled(m.orbitHit, sc)
		local no = math.floor(m.orbit / m.orbitEvery)
		for i = 1, no do
			after(T1 + i * m.orbitEvery, function()
				local list = hostilesNear(f, center, m.range)
				local ats = {}
				for _ = 1, math.min(m.orbitN, #list) do
					local o = list[math.random(1, #list)]
					table.insert(ats, o.root.Position)
					strike(f, o, oh, move)
				end
				if #ats > 0 then
					Push:FireAllClients("skillfx", { kind = "eclipseStrike", m = f.model, ats = ats, who = (i % 2 == 0) and "moon" or "sun", style = style })
				end
			end)
		end
		local n = math.floor(m.rays / m.every)
		for i = 0, n - 1 do
			after(T3 + i * m.every, function()
				local list = hostilesNear(f, center, m.range)
				local ats = {}
				for _ = 1, math.min(m.n, #list) do
					local o = list[math.random(1, #list)]
					table.insert(ats, o.root.Position)
					for _, q in ipairs(hostilesNear(f, o.root.Position, m.radius)) do
						strike(f, q, hit, move)
					end
				end
				if #ats > 0 then
					Push:FireAllClients("skillfx", { kind = "eclipseRay", ats = ats, from = center + Vector3.new(0, 40, 0), style = style })
				end
			end)
		end
		after(T5, function()
			for _, o in ipairs(hostilesNear(f, center, m.finalRadius)) do
				strike(f, o, scaled(m.final, sc), move)
			end
		end)
	elseif kind == "duskFan" then
		-- 황혼참 (황혼 E): 노을빛 초승달 다섯이 부채꼴로 날아갔다가 되돌아온다. 오갈 때 한 번씩 벤다
		local from = f.root.Position
		local dirs = {}
		for i = 1, m.n do
			local ang = math.rad(-m.spread / 2 + (i - 1) * m.spread / math.max(1, m.n - 1))
			local d = (CFrame.fromAxisAngle(Vector3.new(0, 1, 0), ang) * look)
			table.insert(dirs, Vector3.new(d.X, 0, d.Z).Unit)
		end
		Push:FireAllClients("skillfx", { kind = "duskFan", m = f.model, from = from, dirs = dirs, dist = m.dist, time = m.time / sp, style = style })
		local out: { [any]: boolean } = {}
		local back: { [any]: boolean } = {}
		local n = math.floor(m.time / m.every)
		for i = 1, n do
			after(i * m.every, function()
				local u = i / n
				local reach = m.dist * math.sin(u * math.pi)
				local set = u < 0.5 and out or back
				for _, d in ipairs(dirs) do
					local pos = from:Lerp(f.root.Position, u) + d * reach
					for _, o in ipairs(hostilesNear(f, pos, m.radius)) do
						if not set[o] then
							set[o] = true
							strike(f, o, hit, move)
						end
					end
				end
			end)
		end
	elseif kind == "duskChain" then
		-- 석양보 (황혼 R): 노을이 되어 적들의 등 뒤로 차례로 나타나며 베고, 지나간 노을빛 줄이 한꺼번에 터진다
		local list = nearestList(f, m.range, m.n)
		local start = f.root.Position
		f.iframeUntil = math.max(f.iframeUntil, os.clock() + (m.delay + math.max(1, #list) * m.every + m.burstAt + 0.2) / sp)
		Push:FireAllClients("skillfx", { kind = "duskChain", m = f.model, from = start, targets = modelsOf(list), delay = m.delay / sp, every = m.every / sp, burstAt = m.burstAt / sp, style = style })
		local path = { start }
		for i, t in ipairs(list) do
			after(m.delay + (i - 1) * m.every, function()
				if t.dead or not t.root.Parent then
					return
				end
				local tp = t.root.Position
				local d = flat(tp - f.root.Position)
				local p = Vector3.new(tp.X, f.root.Position.Y, tp.Z) + d * 3.2
				table.insert(path, p)
				moveTo(f, CFrame.lookAt(p, Vector3.new(tp.X, p.Y, tp.Z)))
				strike(f, t, hit, move)
			end)
		end
		after(m.delay + math.max(1, #list) * m.every + m.burstAt, function()
			local done = {}
			local burst = scaled(m.burst, sc)
			for i = 1, #path - 1 do
				for _, o in ipairs(hostilesOnSeg(f, path[i], path[i + 1], m.width)) do
					if not done[o] then
						done[o] = true
						strike(f, o, burst, move)
					end
				end
			end
		end)
	elseif kind == "sunsetSea" then
		-- 황혼낙일 (황혼 G, 3.1.1판): 거대한 석양이 내려와 앞의 땅으로 가라앉는다. 바다 위의 적은 타며 굼뜨고, 노을 물결 넷이 퍼지고,
		-- 달빛 기둥이 솟는다. 다 잠기면 잠깐 고요하다가 바다가 노을 불꽃의 왕관으로 솟구친다
		local c = f.root.Position + look * m.dist
		local beams = {}
		for _ = 1, m.beams do
			local a = math.random() * math.pi * 2
			local r = math.random() * m.radius * 0.85
			table.insert(beams, c + Vector3.new(math.cos(a) * r, 0, math.sin(a) * r))
		end
		Push:FireAllClients("skillfx", { kind = "sunsetSea", m = f.model, at = c, dir = look, descend = m.descend / sp, sink = m.sink / sp, dark = m.dark / sp, waves = m.waves, radius = m.radius, beams = beams, style = style })
		local n = math.floor(m.sink / m.every)
		for i = 0, n - 1 do
			after(m.descend + i * m.every, function()
				for _, o in ipairs(hostilesNear(f, c, m.radius)) do
					o.slowUntil = os.clock() + 0.4
					o.slowMul = 0.55
					strike(f, o, hit, move)
				end
			end)
		end
		local wh = scaled(m.wave, sc)
		for i = 1, m.waves do
			after(m.descend + (i - 0.5) * m.sink / m.waves, function()
				for _, o in ipairs(hostilesNear(f, c, m.radius * 1.2)) do
					strike(f, o, wh, move)
				end
			end)
		end
		local bh = scaled(m.beam, sc)
		for i, pt in ipairs(beams) do
			after(m.descend + (i - 0.5) * m.sink / m.beams, function()
				for _, o in ipairs(hostilesNear(f, pt, m.beamRadius)) do
					strike(f, o, bh, move)
				end
			end)
		end
		after(m.descend + m.sink + m.dark, function()
			for _, o in ipairs(hostilesNear(f, c, m.finalRadius)) do
				strike(f, o, scaled(m.final, sc), move)
			end
		end)
	elseif kind == "twilightCollapse" then
		-- 일월동귀 (황혼 X, 3.1.1판): 컷씬 동안 석양과 달이 내려와 (그동안 무적) 내 두 손에 맺히고, 발밑 진의 테두리를 서로 반대로 내달려
		-- 불의 원을 그린다. 앞에서 만나 황혼의 구슬이 되어 둘레를 빨아들이다가 한 점으로 줄어들고, 노을빛으로 하얗게 터진다
		local center = f.root.Position
		local T1 = m.cut
		local T2 = T1 + m.gather
		local T3 = T2 + m.circle
		local T4 = T3 + m.fuse
		local T5 = T4 + m.collapse
		f.iframeUntil = math.max(f.iframeUntil, os.clock() + T5 / sp + 0.2)
		Push:FireAllClients("skillfx", { kind = "twilightCollapse", m = f.model, at = center, dir = look, cut = T1 / sp, gather = m.gather / sp, circle = m.circle / sp, fuse = m.fuse / sp,
			collapse = m.collapse / sp, rim = m.rim, radius = m.finalRadius, style = style })
		local rh = scaled(m.rimHit, sc)
		local n = math.floor(m.circle / m.every)
		for i = 1, n do
			after(T2 + i * m.every, function()
				for _, o in ipairs(hostilesNear(f, center, m.rim + 6)) do
					strike(f, o, rh, move)
				end
			end)
		end
		local np = math.floor(m.fuse / 0.15)
		for i = 0, np do
			after(T3 + i * 0.15, function()
				for _, o in ipairs(hostilesNear(f, center, m.rim * 1.6)) do
					pullTo(o, center, m.pull)
				end
			end)
		end
		after(T5, function()
			for _, o in ipairs(hostilesNear(f, center, m.finalRadius)) do
				strike(f, o, scaled(m.final, sc), move)
			end
		end)
	elseif kind == "inkFlower" then
		-- 2.7판 진 무극 무극필 (오의): 하늘의 붓이 땅에 소용돌이치는 먹 획 여덟을 차례로 긋고, 둘레에 원을 둘러 금빛으로 터뜨린다.
		-- 획의 모양은 화면과 같은 식으로 (가운데에서 바깥으로 휘어 나가는 나선)
		local center = f.root.Position + look * 2
		local rot = math.random() * math.pi * 2
		Push:FireAllClients("skillfx", { kind = "inkFlower", at = center, radius = m.radius, strokes = m.strokes, delay = m.delay / sp, every = m.every / sp, ringAt = m.ringAt / sp, finalAt = m.finalAt / sp, rot = rot, style = style })
		local order = { 1, 5, 3, 7, 2, 6, 4, 8 }
		for i = 1, m.strokes do
			after(m.delay + (i - 1) * m.every, function()
				local a0 = rot + ((order[i] or i) - 1) / m.strokes * math.pi * 2
				local hitSet = {}
				local prev = center
				for k = 1, 5 do
					local r = 3 + (m.radius - 3) * k / 5
					local a = a0 + 0.75 * k / 5
					local pt = center + Vector3.new(math.cos(a) * r, 0, math.sin(a) * r)
					for _, o in ipairs(hostilesOnSeg(f, prev, pt, m.width)) do
						if not hitSet[o] then
							hitSet[o] = true
							strike(f, o, hit, move)
						end
					end
					prev = pt
				end
			end)
		end
		local tEnd = m.delay + (m.strokes - 1) * m.every + m.ringAt + m.finalAt
		after(tEnd, function()
			for _, o in ipairs(hostilesNear(f, center, m.finalRadius)) do
				strike(f, o, scaled(m.final, sc), move)
			end
		end)
	elseif kind == "fanBoomerang" then
		-- 2.7판 초·매화 선풍낙화 (E): 두 부채가 양옆으로 둥글게 날아갔다 되돌아온다. 가는 길과 오는 길에 한 번씩 벤다
		local from = f.root.Position
		local right = Vector3.new(-look.Z, 0, look.X)
		Push:FireAllClients("skillfx", { kind = "fanBoomerang", m = f.model, from = from, dir = look, dist = m.dist, width = m.width, time = m.time / sp, style = style })
		local ticks = math.floor(m.time / m.every)
		local hits: { [any]: number } = {}
		for k = 1, ticks do
			after(k * m.every, function()
				local u = k * m.every / m.time
				local half = u < 0.5 and 1 or 2
				for _, side in ipairs({ -1, 1 }) do
					local pos = from + look * (m.dist * (1 - math.cos(2 * math.pi * u)) / 2) + right * side * (m.width * math.sin(2 * math.pi * u))
					for _, o in ipairs(hostilesNear(f, pos, m.radius)) do
						local key = (hits[o] or 0)
						-- 가는 길에 한 번, 오는 길에 한 번
						if key < half then
							hits[o] = half
							strike(f, o, hit, move)
						end
					end
				end
			end)
		end
	elseif kind == "petalShadow" then
		-- 2.7판 초·매화 화영보 (R): 앞으로 미끄러지며 지나간 길에 꽃 그림자 셋을 남긴다. 그림자가 차례로 베고, 마지막에 모두 꽃잎으로 터진다
		local from = f.root.Position
		local spots = {}
		for i = 1, m.n do
			spots[i] = from + look * (m.gap * i - 2)
		end
		Push:FireAllClients("skillfx", { kind = "petalShadow", m = f.model, spots = spots, dir = look, delay = m.delay / sp, every = m.every / sp, burstAt = m.burstAt / sp, radius = m.radius, style = style })
		for i, at in ipairs(spots) do
			after(m.delay + (i - 1) * m.every, function()
				for _, o in ipairs(hostilesNear(f, at, m.radius)) do
					strike(f, o, hit, move)
				end
			end)
		end
		after(m.delay + (m.n - 1) * m.every + m.burstAt, function()
			local done = {}
			for _, at in ipairs(spots) do
				for _, o in ipairs(hostilesNear(f, at, m.radius)) do
					if not done[o] then
						done[o] = true
						strike(f, o, scaled(m.burst, sc), move)
					end
				end
			end
		end)
	elseif kind == "skyFan" then
		-- 2.7판 초·매화 만화천선 (오의): 하늘에 큰 부채가 펼쳐져 앞의 땅을 두 번 쓸고, 접히며 꽃잎 폭풍을 일으킨다
		local center = f.root.Position
		Push:FireAllClients("skillfx", { kind = "skyFan", m = f.model, at = center, dir = look, open = m.open / sp, sweeps = m.sweeps, sweepTime = m.sweepTime / sp, range = m.range, angle = m.angle, closeAt = m.closeAt / sp, closeRadius = m.closeRadius, style = style })
		local half = math.cos(math.rad(m.angle / 2))
		for k = 1, m.sweeps do
			after(m.open + (k - 1) * (m.sweepTime + 0.05) + m.sweepTime * 0.5, function()
				for _, o in ipairs(hostilesNear(f, center, m.range)) do
					local d = Vector3.new(o.root.Position.X - center.X, 0, o.root.Position.Z - center.Z)
					if d.Magnitude < 3 or d.Unit:Dot(look) >= half then
						strike(f, o, hit, move)
					end
				end
			end)
		end
		after(m.open + m.sweeps * (m.sweepTime + 0.05) + m.closeAt, function()
			for _, o in ipairs(hostilesNear(f, center, m.closeRadius)) do
				strike(f, o, scaled(m.final, sc), move)
			end
		end)
	elseif kind == "tideSpear" then
		-- 2.7판 초·창해 조류창 (E): 소용돌이치는 물의 창이 앞을 꿰뚫고, 끝에서 소용돌이가 되어 끌어당기다 터진다
		local from = f.root.Position + look * 2
		local to = from + look * m.length
		Push:FireAllClients("skillfx", { kind = "tideSpear", from = from, to = to, delay = m.delay / sp, travel = m.travel / sp, vortex = m.vortexDur / sp, radius = m.radius, style = style })
		after(m.delay + m.travel * 0.6, function()
			for _, o in ipairs(hostilesOnSeg(f, from, to, m.width)) do
				strike(f, o, hit, move)
			end
		end)
		local ticks = math.floor(m.vortexDur / m.every)
		for i = 1, ticks do
			after(m.delay + m.travel + i * m.every, function()
				for _, o in ipairs(hostilesNear(f, to, m.radius)) do
					pullTo(o, to, m.pull)
					strike(f, o, scaled(m.tick, sc), move)
				end
			end)
		end
		after(m.delay + m.travel + m.vortexDur, function()
			for _, o in ipairs(hostilesNear(f, to, m.radius + 1)) do
				strike(f, o, scaled(m.burst, sc), move)
			end
		end)
	elseif kind == "whaleSong" then
		-- 2.7판 초·창해 경음 (R): 고래의 울음이 물의 고리 셋이 되어 퍼진다. 고리마다 그 너비 안의 적을 한 번씩, 맞으면 굼뜨다
		local center = f.root.Position
		Push:FireAllClients("skillfx", { kind = "whaleSong", at = center, rings = m.rings, gap = m.gap / sp, delay = m.delay / sp, radius = m.radius, style = style })
		for r = 1, m.rings do
			after(m.delay + (r - 1) * m.gap, function()
				local outer = m.radius * r / m.rings
				local inner = r == 1 and 0 or m.radius * (r - 1) / m.rings - 2
				for _, o in ipairs(hostilesNear(f, center, outer)) do
					local d = Vector3.new(o.root.Position.X - center.X, 0, o.root.Position.Z - center.Z).Magnitude
					if d >= inner then
						o.slowUntil = os.clock() + m.slow / sp
						o.slowMul = 0.5
						strike(f, o, hit, move)
					end
				end
			end)
		end
	elseif kind == "fourWaves" then
		-- 2.7판 초·창해 만경창파 (오의): 둘레가 바다가 되고 사방의 파도 넷이 가운데로 밀려와 쓸어 모은다. 마지막에 소용돌이
		local center = f.root.Position
		local right = Vector3.new(-look.Z, 0, look.X)
		local dirs = { look, right, -look, -right }
		Push:FireAllClients("skillfx", { kind = "fourWaves", at = center, dir = look, radius = m.radius, waves = m.waves, travel = m.travel / sp, gap = m.gap / sp, delay = m.delay / sp, style = style })
		for w = 1, m.waves do
			local from = dirs[(w - 1) % 4 + 1]
			after(m.delay + (w - 1) * m.gap + m.travel * 0.5, function()
				-- 그 파도가 지나가는 반쪽 (그 방향의 적)을 가운데로 쓸어 온다
				for _, o in ipairs(hostilesNear(f, center, m.radius)) do
					local d = Vector3.new(o.root.Position.X - center.X, 0, o.root.Position.Z - center.Z)
					if d.Magnitude < 3 or d.Unit:Dot(from) > -0.2 then
						pullTo(o, center, m.pull)
						strike(f, o, hit, move)
					end
				end
			end)
		end
		after(m.delay + (m.waves - 1) * m.gap + m.travel + 0.15, function()
			Push:FireAllClients("skillfx", { kind = "maelstrom", at = center, radius = m.radius * 0.6, style = style })
			for _, o in ipairs(hostilesNear(f, center, m.radius * 0.7)) do
				strike(f, o, scaled(m.final, sc), move)
			end
		end)
	elseif kind == "ancientWhale" then
		-- 2.7판 초·창해 고경승천 (초 오의): 땅이 바다가 되고 (컷씬, 무적) 고대의 고래가 뒤에서 솟구쳐 머리 위를 지나 앞으로 뛰어든다.
		-- 고래 그림자 아래의 적은 떠오르고, 앞의 바다에 떨어질 때 해일이 둘레를 덮친다
		local center = f.root.Position
		-- 2.7.7판: 자동 타깃. 쓰는 순간 둘레에서 가장 가까운 적 (보스가 있으면 보스)을 골라 그쪽으로 뛰어든다 (뒤쫓지는 않는다)
		local ahead = m.ahead
		local pick, pickD = nil, math.huge
		for _, o in ipairs(hostilesNear(f, center, m.targetRange or 110)) do
			local d = Vector3.new(o.root.Position.X - center.X, 0, o.root.Position.Z - center.Z).Magnitude
			if o.model:GetAttribute("Boss") == true then
				d -= 1000
			end
			if d < pickD then
				pick, pickD = o, d
			end
		end
		if pick then
			local d = Vector3.new(pick.root.Position.X - center.X, 0, pick.root.Position.Z - center.Z)
			if d.Magnitude > 1 then
				look = d.Unit
				ahead = math.clamp(d.Magnitude, 24, m.ahead + 30)
				-- 나도 그쪽을 본다
				pcall(function()
					f.model:PivotTo(CFrame.lookAt(center, center + look))
				end)
			end
		end
		local from = center - look * m.behind
		local to = center + look * ahead
		local total = m.cut + m.flight + m.waveAt + 0.3
		f.iframeUntil = math.max(f.iframeUntil, os.clock() + total / sp)
		local wid = math.random(1, 1000000000)
		Push:FireAllClients("skillfx", { kind = "ancientSea", id = wid, m = f.model, at = center, dir = look, from = from, to = to, cut = m.cut / sp, dur = total / sp, style = style })
		after(m.cut, function()
			Push:FireAllClients("skillfx", { kind = "ancientLeap", id = wid, from = from, to = to, flight = m.flight / sp, height = m.height, scale = m.scale, style = style })
		end)
		local done = {}
		local ticks = math.floor(m.flight / m.every)
		for k = 1, ticks do
			after(m.cut + k * m.every, function()
				local u = k * m.every / m.flight
				local pos = from:Lerp(to, u)
				for _, o in ipairs(hostilesNear(f, pos, m.width)) do
					if not done[o] or os.clock() - done[o] > 0.6 then
						done[o] = os.clock()
						strike(f, o, hit, move)
					end
				end
			end)
		end
		after(m.cut + m.flight, function()
			Push:FireAllClients("skillfx", { kind = "ancientCrash", id = wid, at = to, center = center, radius = m.finalRadius, waveAt = m.waveAt / sp, waveRadius = m.waveRadius, style = style })
			for _, o in ipairs(hostilesNear(f, to, m.finalRadius)) do
				strike(f, o, scaled(m.final, sc), move)
			end
		end)
		after(m.cut + m.flight + m.waveAt, function()
			for _, o in ipairs(hostilesNear(f, center, m.waveRadius)) do
				strike(f, o, scaled(m.wave, sc), move)
			end
		end)
	elseif kind == "starVolley" then
		-- 3.4판 초·성하 별똥 화살 (E): 지팡이 끝의 마법진에서 별 다섯이 차례로 날아가 둘레의 적을 쫓아 꽂힌다 (적이 적으면 같은 적에게 여럿, 없으면 앞으로 부채꼴)
		local list = nearestList(f, m.range, m.n)
		local origin = f.root.Position + look * 2.5 + Vector3.new(0, 1.5, 0)
		local right = rightOf(look)
		local aims = {}
		local targets = {}
		for i = 1, m.n do
			local o = #list > 0 and list[(i - 1) % #list + 1] or nil
			targets[i] = o
			local at = o and o.root.Position or (f.root.Position + look * (m.range * 0.6) + right * (i - (m.n + 1) / 2) * 5)
			aims[i] = { m = o and o.model or nil, at = at }
		end
		Push:FireAllClients("skillfx", { kind = "starVolley", m = f.model, from = origin, aims = aims, delay = m.delay / sp, every = m.every / sp, travel = m.travel / sp, radius = m.radius, style = style })
		for i = 1, m.n do
			after(m.delay + (i - 1) * m.every + m.travel, function()
				local o = targets[i]
				local at = (o and not o.dead and o.root.Parent) and o.root.Position or aims[i].at
				for _, v in ipairs(hostilesNear(f, at, m.radius)) do
					strike(f, v, hit, move)
				end
			end)
		end
	elseif kind == "starSeal" then
		-- 3.4판 초·성하 성좌진 (R): 앞의 땅에 마법진. 별이 하나씩 떠올라 선으로 이어지는 동안 끌어모으고, 별자리가 다 그려지면 별빛 기둥
		local center = f.root.Position + look * m.dist
		Push:FireAllClients("skillfx", { kind = "starSeal", at = center, dir = look, radius = m.radius, stars = m.stars, delay = m.delay / sp, link = m.link / sp, style = style })
		for i = 1, m.stars do
			after(m.delay + i * m.link, function()
				for _, o in ipairs(hostilesNear(f, center, m.radius)) do
					pullTo(o, center, m.pull)
					strike(f, o, scaled(m.tick, sc), move)
				end
			end)
		end
		after(m.delay + (m.stars + 1) * m.link + 0.1, function()
			for _, o in ipairs(hostilesNear(f, center, m.radius + 1)) do
				strike(f, o, scaled(m.burst, sc), move)
			end
		end)
	elseif kind == "galaxyStaff" then
		-- 3.4판 초·성하 은하수 (오의): 지팡이가 커져 땅에 꽂히고, 세 빛 안개 속에서 별이 소용돌이친다. 끌어들이며 치다가 은하가 가운데로 모여 터진다
		local center = f.root.Position + look * m.dist
		Push:FireAllClients("skillfx", { kind = "galaxyStaff", m = f.model, at = center, radius = m.radius, delay = m.delay / sp, dur = m.dur / sp, style = style })
		local ticks = math.floor(m.dur / m.every)
		for i = 1, ticks do
			after(m.delay + i * m.every, function()
				for _, o in ipairs(hostilesNear(f, center, m.radius)) do
					pullTo(o, center, m.pull)
					strike(f, o, scaled(m.tick, sc), move)
				end
			end)
		end
		after(m.delay + m.dur, function()
			for _, o in ipairs(hostilesNear(f, center, m.radius)) do
				strike(f, o, scaled(m.final, sc), move)
			end
		end)
	elseif kind == "starDome" then
		-- 3.4판 초·성하 성천궁 (초 오의): 컷씬 (무적) 뒤 남색 돔이 내려앉는다. 돔 안 곳곳의 마법진에서 별이 쏟아지고 메테오가 떨어진다.
		-- 마지막에 돔 표면에 별자리가 그려지고 한꺼번에 터진다
		local center = f.root.Position
		local total = m.cut + m.rain + m.draw + 0.4
		f.iframeUntil = math.max(f.iframeUntil, os.clock() + total / sp)
		local did = math.random(1, 1000000000)
		Push:FireAllClients("skillfx", { kind = "starDomeOpen", id = did, m = f.model, at = center, radius = m.radius, cut = m.cut / sp, rain = m.rain / sp, draw = m.draw / sp, style = style })
		local ticks = math.floor(m.rain / m.every)
		for k = 1, ticks do
			after(m.cut + k * m.every, function()
				local list = hostilesNear(f, center, m.radius)
				local pts = {}
				for j = 1, m.n do
					if #list > 0 then
						local o = list[math.random(1, #list)]
						strike(f, o, hit, move)
						pts[j] = o.root.Position
					else
						local a, r = math.random() * math.pi * 2, math.sqrt(math.random()) * m.radius * 0.8
						pts[j] = center + Vector3.new(math.cos(a) * r, 0, math.sin(a) * r)
					end
				end
				Push:FireAllClients("skillfx", { kind = "domeStars", id = did, at = center, pts = pts, style = style })
				if k % m.meteorEvery == 0 then
					local at: Vector3
					if #list > 0 then
						at = list[math.random(1, #list)].root.Position
					else
						local a, r = math.random() * math.pi * 2, math.sqrt(math.random()) * m.radius * 0.7
						at = center + Vector3.new(math.cos(a) * r, 0, math.sin(a) * r)
					end
					Push:FireAllClients("skillfx", { kind = "domeMeteor", id = did, at = at, radius = m.meteorRadius, fall = 0.35 / sp, style = style })
					after(0.35, function()
						for _, o in ipairs(hostilesNear(f, at, m.meteorRadius)) do
							strike(f, o, scaled(m.meteor, sc), move)
						end
					end)
				end
			end)
		end
		after(m.cut + m.rain, function()
			Push:FireAllClients("skillfx", { kind = "domeDraw", id = did, at = center, radius = m.radius, draw = m.draw / sp, style = style })
		end)
		after(m.cut + m.rain + m.draw, function()
			for _, o in ipairs(hostilesNear(f, center, m.radius)) do
				strike(f, o, scaled(m.final, sc), move)
			end
		end)
	elseif kind == "ashStatues" then
		-- 3.6판 무상 잔영멸 (E): 재가 되어 스치고, 지나간 자리의 재 조각상 다섯이 차례로 무너지며 친다
		local from = f.root.Position
		local to = from + look * m.dist
		Push:FireAllClients("skillfx", { kind = "ashStatues", m = f.model, from = from, to = to, n = m.n, crumble = m.crumble / sp, step = m.step / sp, radius = m.radius, style = style })
		after(0.15, function()
			for _, o in ipairs(hostilesOnSeg(f, from, to, m.width)) do
				strike(f, o, hit, move)
			end
		end)
		for i = 1, m.n do
			local pos = from:Lerp(to, (i - 0.5) / m.n)
			after(m.crumble + (i - 1) * m.step, function()
				for _, o in ipairs(hostilesNear(f, pos, m.radius)) do
					strike(f, o, scaled(m.burst, sc), move)
				end
			end)
		end
	elseif kind == "witherBloom" then
		-- 3.6판 무상 화무십일 (R): 잿빛 꽃이 피어 꽃잎이 감싸 끌어들이다가, 시들어 재로 무너지며 터진다
		local center = f.root.Position + look * m.dist
		Push:FireAllClients("skillfx", { kind = "witherBloom", at = center, radius = m.radius, bloom = m.bloom / sp, hold = m.hold / sp, style = style })
		local ticks = math.floor(m.hold / m.every)
		for i = 1, ticks do
			after(m.bloom + (i - 1) * m.every, function()
				for _, o in ipairs(hostilesNear(f, center, m.radius)) do
					pullTo(o, center, m.pull)
					strike(f, o, scaled(m.tick, sc), move)
				end
			end)
		end
		after(m.bloom + m.hold + 0.1, function()
			for _, o in ipairs(hostilesNear(f, center, m.radius + 1)) do
				strike(f, o, scaled(m.burst, sc), move)
			end
		end)
	elseif kind == "hourglass" then
		-- 3.6판 무상 제행무상 (오의): 모래시계가 내려서고, 모래가 흐르는 동안 굼뜨고 재의 비. 다 흐르면 깨지며 터진다
		local center = f.root.Position
		Push:FireAllClients("skillfx", { kind = "hourglass", at = center, radius = m.radius, descend = m.descend / sp, run = m.run / sp, crack = m.crack / sp, style = style })
		local ticks = math.floor(m.run / m.every)
		for i = 1, ticks do
			after(m.descend + (i - 1) * m.every, function()
				for _, o in ipairs(hostilesNear(f, center, m.radius)) do
					o.slowUntil = os.clock() + (m.every + 0.2) / sp
					o.slowMul = m.slow
					strike(f, o, scaled(m.tick, sc), move)
				end
			end)
		end
		after(m.descend + m.run + m.crack, function()
			for _, o in ipairs(hostilesNear(f, center, m.radius)) do
				strike(f, o, scaled(m.final, sc), move)
			end
		end)
	elseif kind == "eraseBox" then
		-- 3.8판 공백 소거 (E): 앞에 흰 선택 상자, 안이 검게 지워졌다가 화소 조각으로 부서진다
		local from = f.root.Position + look * m.dist
		local to = from + look * m.length
		Push:FireAllClients("skillfx", { kind = "eraseBox", from = from, to = to, width = m.width, delay = m.delay / sp, shardAt = m.shardAt / sp, style = style })
		after(m.delay, function()
			for _, o in ipairs(hostilesOnSeg(f, from, to, m.width / 2)) do
				strike(f, o, hit, move)
			end
		end)
		after(m.delay + m.shardAt, function()
			for _, o in ipairs(hostilesOnSeg(f, from, to, m.width / 2 + 1)) do
				strike(f, o, scaled(m.shard, sc), move)
			end
		end)
	elseif kind == "glitchBlink" then
		-- 3.8판 공백 끊김 (R): 둘레의 적 넷 사이를 끊기듯 옮겨 다니며 친다. 마지막 적의 등 뒤에 나타난다
		local list = nearestList(f, m.range, m.n)
		Push:FireAllClients("skillfx", { kind = "glitchBlink", m = f.model, from = f.root.Position, targets = modelsOf(list), delay = m.delay / sp, every = m.every / sp, style = style })
		for i, o in ipairs(list) do
			after(m.delay + (i - 1) * m.every, function()
				strike(f, o, hit, move)
			end)
		end
		if #list > 0 then
			after(m.delay + #list * m.every, function()
				local last = list[#list]
				if last.dead or not last.root.Parent then
					return
				end
				local back = last.root.Position - flat(last.root.CFrame.LookVector) * 3.5
				moveTo(f, CFrame.lookAt(back, Vector3.new(last.root.Position.X, back.Y, last.root.Position.Z)))
			end)
		end
	elseif kind == "voidGrid" then
		-- 3.8판 공백 허공 격자 (오의): 둘레가 흰 격자의 검은 허공이 되어 끌어 지우다가, 한 점으로 오그라들어 흰 잡음으로 터진다
		local center = f.root.Position
		Push:FireAllClients("skillfx", { kind = "voidGrid", at = center, radius = m.radius, delay = m.delay / sp, dur = m.dur / sp, collapse = m.collapse / sp, style = style })
		local ticks = math.floor(m.dur / m.every)
		for i = 1, ticks do
			after(m.delay + (i - 1) * m.every, function()
				for _, o in ipairs(hostilesNear(f, center, m.radius)) do
					pullTo(o, center, m.pull)
					strike(f, o, scaled(m.tick, sc), move)
				end
			end)
		end
		after(m.delay + m.dur + m.collapse, function()
			for _, o in ipairs(hostilesNear(f, center, m.radius)) do
				strike(f, o, scaled(m.final, sc), move)
			end
		end)
	elseif kind == "nullOut" then
		-- 3.8판 공백 존재소거 (초 오의): 컷씬 (무적) 뒤 화면 균열, 하늘에서 빈칸 상자들이 떨어지고, 멈췄다가, 화소 조각으로 무너진다
		local center = f.root.Position
		local total = m.cut + m.rain + m.freeze + 0.4
		f.iframeUntil = math.max(f.iframeUntil, os.clock() + total / sp)
		local nid = math.random(1, 1000000000)
		Push:FireAllClients("skillfx", { kind = "nullOpen", id = nid, m = f.model, at = center, range = m.range, cut = m.cut / sp, rain = m.rain / sp, freeze = m.freeze / sp, style = style })
		local ticks = math.floor(m.rain / m.every)
		for k = 1, ticks do
			after(m.cut + (k - 1) * m.every, function()
				local list = hostilesNear(f, center, m.range)
				local pts = {}
				for j = 1, m.n do
					if #list > 0 then
						pts[j] = list[math.random(1, #list)].root.Position
					else
						local a, r = math.random() * math.pi * 2, math.sqrt(math.random()) * m.range * 0.8
						pts[j] = center + Vector3.new(math.cos(a) * r, 0, math.sin(a) * r)
					end
				end
				Push:FireAllClients("skillfx", { kind = "nullCubes", id = nid, pts = pts, fall = 0.25 / sp, style = style })
				after(0.25, function()
					for _, pt in ipairs(pts) do
						for _, o in ipairs(hostilesNear(f, pt, m.cubeRadius)) do
							strike(f, o, hit, move)
						end
					end
				end)
			end)
		end
		after(m.cut + m.rain + m.freeze, function()
			for _, o in ipairs(hostilesNear(f, center, m.finalRadius)) do
				strike(f, o, scaled(m.final, sc), move)
			end
		end)
	elseif kind == "mirrorWorld" then
		-- 3.10판 무상 경화수월 (초 오의): 컷씬 (무적) 뒤 거울 열둘이 솟고, 거울 속 잿빛 그림자가 제 주인을 친다. 금이 가고 한가운데로 깨져 쏟아진다
		local center = f.root.Position
		local total = m.cut + m.rise + m.echo + m.crack + 0.4
		f.iframeUntil = math.max(f.iframeUntil, os.clock() + total / sp)
		local mid = math.random(1, 1000000000)
		Push:FireAllClients("skillfx", { kind = "mirrorOpen", id = mid, m = f.model, at = center, radius = m.radius, cut = m.cut / sp, rise = m.rise / sp, echo = m.echo / sp, crack = m.crack / sp, style = style })
		local ticks = math.floor(m.echo / m.every)
		for i = 1, ticks do
			after(m.cut + m.rise + (i - 1) * m.every, function()
				local list = hostilesNear(f, center, m.radius)
				if i == 1 then
					Push:FireAllClients("skillfx", { kind = "mirrorEcho", id = mid, targets = modelsOf(list), every = m.every / sp, n = ticks, style = style })
				end
				for _, o in ipairs(list) do
					strike(f, o, hit, move)
				end
			end)
		end
		after(m.cut + m.rise + m.echo + m.crack, function()
			for _, o in ipairs(hostilesNear(f, center, m.radius)) do
				strike(f, o, scaled(m.final, sc), move)
			end
		end)
	elseif kind == "kingArena" then
		-- 3.10판 권왕 패왕난무 (오의): 금빛 기둥 여덟의 투기장, 기둥마다 거대한 주먹이 차례로 한가운데를 내지르고, 땅속 주먹이 올려친다
		local center = f.root.Position
		Push:FireAllClients("skillfx", { kind = "kingArena", m = f.model, at = center, radius = m.radius, rise = m.rise / sp, fists = m.fists, every = m.every / sp, upper = m.upper / sp, style = style })
		after(m.rise * 0.5, function()
			for _, o in ipairs(hostilesNear(f, center, m.radius + 6)) do
				pullTo(o, center, m.pull)
			end
		end)
		for k = 1, m.fists do
			local a = (k - 1) / m.fists * math.pi * 2
			local from = center + Vector3.new(math.cos(a), 0, math.sin(a)) * m.radius
			after(m.rise + (k - 1) * m.every, function()
				for _, o in ipairs(hostilesOnSeg(f, from, center, m.width)) do
					strike(f, o, hit, move)
				end
			end)
		end
		after(m.rise + m.fists * m.every + m.upper, function()
			for _, o in ipairs(hostilesNear(f, center, m.radius * 0.6)) do
				strike(f, o, scaled(m.final, sc), move)
			end
		end)
	elseif kind == "kingAvatar" then
		-- 3.10판 권왕 천하제일권 (초 오의): 컷씬 (무적) 뒤 등 뒤에 하늘만 한 금빛 왕 (나의 모습)이 일어서서 가장 강한 적에게 한 방.
		-- 충격파 세 겹, 십자로 내달리는 빛기둥 넷, 내려오는 빛의 왕관
		local center = f.root.Position
		local pick, pickD = nil, math.huge
		for _, o in ipairs(hostilesNear(f, center, m.range)) do
			local d = (o.root.Position - center).Magnitude
			if o.model:GetAttribute("Boss") == true then
				d -= 1000
			end
			if d < pickD then
				pick, pickD = o, d
			end
		end
		local to = pick and pick.root.Position or center + look * 18
		local impact = m.cut + m.rise + m.charge + m.punch
		local total = impact + 0.2 + m.cross + m.crownAt + 0.4
		f.iframeUntil = math.max(f.iframeUntil, os.clock() + total / sp)
		local aid = math.random(1, 1000000000)
		Push:FireAllClients("skillfx", { kind = "kingAvatar", id = aid, m = f.model, at = center, to = to, cut = m.cut / sp, rise = m.rise / sp, charge = m.charge / sp, punch = m.punch / sp, style = style })
		after(impact, function()
			Push:FireAllClients("skillfx", { kind = "kingImpact", id = aid, at = to, dir = look, radius = m.fistR, rings = m.rings, ringEvery = m.ringEvery / sp, cross = m.cross / sp, crossLen = m.crossLen, crownAt = m.crownAt / sp, finalRadius = m.finalRadius, style = style })
			for _, o in ipairs(hostilesNear(f, to, m.fistR)) do
				strike(f, o, scaled(m.fist, sc), move)
			end
		end)
		for k = 1, m.rings do
			local R0, R1 = m.fistR * (0.5 + (k - 1) * 0.6), m.fistR * (0.5 + k * 0.6)
			after(impact + k * m.ringEvery, function()
				for _, o in ipairs(hostilesNear(f, to, R1)) do
					local d = Vector3.new(o.root.Position.X - to.X, 0, o.root.Position.Z - to.Z).Magnitude
					if d >= R0 - 2 then
						strike(f, o, scaled(m.ringHit, sc), move)
					end
				end
			end)
		end
		local right = rightOf(look)
		local arms = { look, right, -look, -right }
		local steps = 6
		local crossHit: { [any]: boolean } = {}
		for k = 1, steps do
			after(impact + 0.2 + (k - 1) * m.cross / steps, function()
				for _, dir in ipairs(arms) do
					local a = to + dir * (m.crossLen * (k - 1) / steps)
					local b = to + dir * (m.crossLen * k / steps)
					for _, o in ipairs(hostilesOnSeg(f, a, b, m.crossW)) do
						if not crossHit[o] then
							crossHit[o] = true
							strike(f, o, scaled(m.crossHit, sc), move)
						end
					end
				end
			end)
		end
		after(impact + 0.2 + m.cross + m.crownAt, function()
			for _, o in ipairs(hostilesNear(f, to, m.finalRadius)) do
				strike(f, o, scaled(m.final, sc), move)
			end
		end)
	elseif kind == "dreamWalk" then
		-- 3.10.1판 몽유 꿈길 걸음 (E): 눈을 감고 앞으로 걷는다. 달빛 디딤돌 길 위의 적은 잠이 들고 (기절),
		-- 길 끝에 닿으면 디딤돌이 별가루로 터지며 잠든 적을 깨운다 (한 번 더 친다)
		local from = f.root.Position
		local dir = look
		local to = from + dir * m.dist
		f.iframeUntil = math.max(f.iframeUntil, os.clock() + (m.slide + 0.4) / sp)
		Push:FireAllClients("skillfx", { kind = "dreamWalk", m = f.model, from = from, to = to, time = m.slide / sp, style = style })
		local slept = {}
		local steps = 7
		for i = 1, steps do
			after(i * m.slide / steps, function()
				local a = from + dir * (m.dist * (i - 1) / steps)
				local b = from + dir * (m.dist * i / steps)
				for _, o in ipairs(hostilesOnSeg(f, a, b, m.width)) do
					if not slept[o] then
						slept[o] = true
						Combat.stun(o, m.sleep / sp)
						strike(f, o, hit, move)
					end
				end
			end)
		end
		after(m.slide, function()
			moveTo(f, CFrame.lookAt(to + Vector3.new(0, 3, 0), to + Vector3.new(0, 3, 0) + dir))
		end)
		after(m.slide + 0.1 + 0.15, function()
			for o in pairs(slept) do
				strike(f, o, scaled(m.final, sc), move)
			end
		end)
	elseif kind == "upsideDown" then
		-- 3.10판 몽유 거꾸로 꿈 (R): 앞의 땅이 밤하늘이 되고 중력이 뒤집힌다. 떠올랐다가 꿈이 바로 서면 내리꽂힌다
		local center = f.root.Position + look * m.dist
		Push:FireAllClients("skillfx", { kind = "upsideDown", at = center, radius = m.radius, delay = m.delay / sp, hold = m.hold / sp, style = style })
		local ticks = math.floor(m.hold / m.every)
		for i = 1, ticks do
			after(m.delay + (i - 1) * m.every, function()
				for _, o in ipairs(hostilesNear(f, center, m.radius)) do
					strike(f, o, scaled(m.tick, sc), move)
				end
			end)
		end
		after(m.delay + m.hold, function()
			for _, o in ipairs(hostilesNear(f, center, m.radius + 1)) do
				strike(f, o, scaled(m.slam, sc), move)
			end
		end)
	elseif kind == "dreamIsles" then
		-- 3.10판 몽유 몽중몽 (오의): 둘레가 꿈속이 된다 (달, 떠다니는 섬·계단·문). 문이 열리고 닫힐 때마다 베이고, 마지막에 모두 떨어지며 깬다
		local center = f.root.Position
		Push:FireAllClients("skillfx", { kind = "dreamIsles", at = center, radius = m.radius, delay = m.delay / sp, dur = m.dur / sp, style = style })
		local ticks = math.floor(m.dur / m.every)
		for i = 1, ticks do
			after(m.delay + (i - 1) * m.every, function()
				for _, o in ipairs(hostilesNear(f, center, m.radius)) do
					o.slowUntil = os.clock() + (m.every + 0.2) / sp
					o.slowMul = m.slow
					strike(f, o, scaled(m.tick, sc), move)
				end
			end)
		end
		after(m.delay + m.dur, function()
			for _, o in ipairs(hostilesNear(f, center, m.radius)) do
				strike(f, o, scaled(m.final, sc), move)
			end
		end)
	elseif kind == "moonDream" then
		-- 3.10판 몽유 월하몽 (초 오의): 컷씬 (무적) 뒤 보름달과 밤 호수. 적은 잠든 듯 떠올라 별의 소용돌이에 감기고, 달이 내려와 호수에 닿으면 터진다
		local center = f.root.Position
		local total = m.cut + m.rise + m.drift + m.descend + 0.4
		f.iframeUntil = math.max(f.iframeUntil, os.clock() + total / sp)
		Push:FireAllClients("skillfx", { kind = "moonDream", m = f.model, at = center, dir = look, cut = m.cut / sp, rise = m.rise / sp, drift = m.drift / sp, descend = m.descend / sp, range = m.range, finalRadius = m.finalRadius, style = style })
		local ticks = math.floor(m.drift / m.every)
		for i = 1, ticks do
			after(m.cut + m.rise + (i - 1) * m.every, function()
				for _, o in ipairs(hostilesNear(f, center, m.range)) do
					strike(f, o, hit, move)
				end
			end)
		end
		after(m.cut + m.rise + m.drift + m.descend, function()
			for _, o in ipairs(hostilesNear(f, center, m.finalRadius)) do
				strike(f, o, scaled(m.final, sc), move)
			end
		end)
	elseif kind == "bambooLine" then
		-- 2.7판 만목 죽림창 (E): 앞으로 곧게 대나무가 차례로 창처럼 솟는다. 적은 한 번만 맞는다
		local from = f.root.Position
		Push:FireAllClients("skillfx", { kind = "bambooLine", from = from, dir = look, n = m.n, start = m.start, gap = m.gap, delay = m.delay / sp, step = m.step / sp, stand = m.stand / sp, style = style })
		local done = {}
		for i = 1, m.n do
			after(m.delay + (i - 1) * m.step, function()
				local pos = from + look * (m.start + (i - 1) * m.gap)
				for _, o in ipairs(hostilesNear(f, pos, m.radius)) do
					if not done[o] then
						done[o] = true
						strike(f, o, hit, move)
					end
				end
			end)
		end
	elseif kind == "leafVolley" then
		-- 2.7판 만목 천엽비수 (R): 잎이 둘레에서 소용돌이친 뒤 가까운 적 여럿에게 줄지어 날아가 벤다
		Push:FireAllClients("skillfx", { kind = "leafGather", m = f.model, dur = m.gather / sp, style = style })
		after(m.gather, function()
			local list = nearestList(f, m.range, m.n)
			Push:FireAllClients("skillfx", { kind = "leafVolley", m = f.model, targets = modelsOf(list), waves = m.waves, every = m.every / sp, travel = m.travel / sp, style = style })
			heal(f, m.heal)
			for w = 0, m.waves - 1 do
				after(m.travel + w * m.every, function()
					for _, o in ipairs(list) do
						strike(f, o, hit, move)
					end
				end)
			end
		end)
	elseif kind == "worldTree" then
		-- 2.7판 만목 신목강림 (오의): 등 뒤에 천 년 은행나무가 솟고 금빛 잎이 쏟아진다. 끝에 잎이 사방으로 휘몰아친다
		local center = f.root.Position
		local at = center - look * m.back
		local id = math.random(1, 1000000000)
		Push:FireAllClients("skillfx", { kind = "treeRise", id = id, at = at, center = center, dir = look, rise = m.rise / sp, dur = m.dur / sp, radius = m.radius, style = style })
		after(m.rise, function()
			heal(f, m.heal)
		end)
		local ticks = math.floor(m.dur / m.every)
		for i = 1, ticks do
			after(m.rise + i * m.every, function()
				for _, o in ipairs(hostilesNear(f, center, m.radius)) do
					strike(f, o, hit, move)
				end
			end)
		end
		after(m.rise + m.dur, function()
			Push:FireAllClients("skillfx", { kind = "treeBurst", id = id, at = at, center = center, radius = m.finalRadius, style = style })
			for _, o in ipairs(hostilesNear(f, center, m.finalRadius)) do
				strike(f, o, scaled(m.final, sc), move)
			end
		end)
	elseif kind == "thunderStar" then
		-- 2.6판 초·벽력 뇌성강림 (오의): 머리 위로 띄운 뇌성(천둥별)에서 작은 별 여섯이 떨어져 나와 둘레를 돈다.
		-- 별마다 가까운 적을 골라 번개 줄기를 쏘고 (한 번에 한 적은 한 줄기만 맞는다), 끝에 모두 다시 하나로 모여 땅에 떨어진다
		local id = math.random(1, 1000000000)
		local center = f.root.Position + look * (m.dist or 4)
		local n = m.n
		local t0 = m.delay + m.spread
		Push:FireAllClients("skillfx", { kind = "starStart", id = id, at = center, n = n, orbit = m.orbit, height = m.height, spin = m.spin * sp, spread = m.spread / sp, dur = m.dur / sp, delay = m.delay / sp, converge = m.converge / sp, style = style })
		local function orbPos(i: number, t: number): Vector3
			local a = (i - 1) / n * math.pi * 2 + t * m.spin
			return center + Vector3.new(math.cos(a) * m.orbit, m.height, math.sin(a) * m.orbit)
		end
		local ticks = math.floor(m.dur / m.every)
		for k = 0, ticks - 1 do
			local t = k * m.every
			after(t0 + t, function()
				local taken = {}
				local list = hostilesNear(f, center, m.orbit + m.beamRange)
				for i = 1, n do
					local op = orbPos(i, t)
					local best, bd = nil, m.beamRange
					for _, o in ipairs(list) do
						local d = Vector3.new(o.root.Position.X - op.X, 0, o.root.Position.Z - op.Z).Magnitude
						if not taken[o] and d < bd then
							best, bd = o, d
						end
					end
					if best then
						taken[best] = true
						Push:FireAllClients("skillfx", { kind = "starBeam", id = id, i = i, to = best.root.Position, style = style })
						strike(f, best, hit, move)
					elseif (k + i) % 3 == 0 then
						-- 겨눌 적이 없으면 땅을 때린다 (보이기만)
						Push:FireAllClients("skillfx", { kind = "starBeam", id = id, i = i, to = Vector3.new(op.X, center.Y, op.Z), style = style })
					end
				end
			end)
		end
		after(t0 + m.dur + m.converge, function()
			Push:FireAllClients("skillfx", { kind = "starCrash", id = id, at = center, radius = m.finalRadius, style = style })
			for _, o in ipairs(hostilesNear(f, center, m.finalRadius)) do
				strike(f, o, scaled(m.final, sc), move)
			end
		end)
	end
end

return Skills
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="15">
        <Properties>
          <string name="Name">World</string>
          <string name="Source"><![CDATA[-- 권왕: 강호 (오픈 월드). 가운데 청운 마을, 서쪽 대나무 숲, 북쪽 흑호채, 동쪽 비류 폭포 계곡, 남쪽 들판
-- 그리고 강호 곳곳에 흩어진 일곱 사부의 자리
local Lighting = game:GetService("Lighting")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage:WaitForChild("Config"))

local World = {}

local folder: Folder
local rng = Random.new(1337)

local function part(props: { [string]: any }): Part
	local p = Instance.new("Part")
	p.Anchored = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	for k, v in pairs(props) do
		if k ~= "Parent" then
			(p :: any)[k] = v
		end
	end
	if p.CanCollide == false then
		p.CanQuery = false
	end
	p.Parent = props.Parent or folder
	return p
end

local function sign(target: BasePart, face: Enum.NormalId, lines: { { any } })
	local gui = Instance.new("SurfaceGui")
	gui.Face = face
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 20
	gui.LightInfluence = 0.3
	gui.Parent = target
	local list = Instance.new("UIListLayout")
	list.VerticalAlignment = Enum.VerticalAlignment.Center
	list.Parent = gui
	for _, line in ipairs(lines) do
		local l = Instance.new("TextLabel")
		l.BackgroundTransparency = 1
		l.Size = UDim2.fromScale(1, line[3] or 0.5)
		l.Font = Enum.Font.GothamBlack
		l.TextScaled = true
		l.TextColor3 = line[2]
		l.TextStrokeTransparency = 0.4
		l.Text = line[1]
		l.Parent = gui
	end
end

local function prompt(target: BasePart, action: string, object: string, name: string): ProximityPrompt
	local pp = Instance.new("ProximityPrompt")
	pp.Name = name
	pp.ActionText = action
	pp.ObjectText = object
	pp.HoldDuration = 0
	pp.MaxActivationDistance = 12
	pp.RequiresLineOfSight = false
	pp.KeyboardKeyCode = Enum.KeyCode.T
	pp.Parent = target
	return pp
end


-- 낮과 밤의 시계 (테스트에서 바꾸거나 멈출 수 있다)
-- 3.0판: 한 바퀴 16분 그대로, 낮(6시~19시)이 10분 · 밤이 6분 (예전엔 반반 8분씩)
-- 3.2.5판: 밤은 2분으로 (어두워서 눈이 아프다). 한 바퀴 12분
local DAY_PART, NIGHT_PART = 10 * 60, 2 * 60
local DAY = DAY_PART + NIGHT_PART
local function phaseOf(hour: number): number
	local h = (hour - 6) % 24
	if h < 13 then
		return h / 13 * DAY_PART
	end
	return DAY_PART + (h - 13) / 11 * NIGHT_PART
end
local clockT0 = os.clock() - phaseOf(16.2)
local clockFrozen: number? = nil
function World.clockHour(): number
	if clockFrozen then
		return clockFrozen
	end
	local t = (os.clock() - clockT0) % DAY
	if t < DAY_PART then
		return (6 + 13 * t / DAY_PART) % 24
	end
	return (19 + 11 * (t - DAY_PART) / NIGHT_PART) % 24
end
function World.setClock(hour: number)
	hour = hour % 24
	if clockFrozen then
		clockFrozen = hour
	end
	clockT0 = os.clock() - phaseOf(hour)
	Lighting.ClockTime = hour
end
-- 3.1판 일월극변: cut 초 동안은 화면이 해와 달을 번갈아 띄우고 (서버는 시각을 건드리지 않는다), 그 뒤 dur 초 동안 세상이 황혼에 멈춘다
local twilightCut, twilightFrom, twilightUntil = 0, 0, 0
function World.twilight(cut: number, dur: number)
	local now = os.clock()
	if now >= twilightUntil then
		twilightCut = now
		twilightFrom = now + cut
	end
	twilightUntil = math.max(twilightUntil, now + cut + dur)
end
function World.twilightOn(): boolean
	return os.clock() < twilightUntil
end
-- 멈추면 지금 시각에 머문다. 다시 누르면 흐른다
function World.toggleClockFreeze(): boolean
	if clockFrozen then
		local h = clockFrozen
		clockFrozen = nil
		World.setClock(h)
		return false
	end
	clockFrozen = World.clockHour()
	return true
end

function World.setupLighting()
	Lighting.ClockTime = 16.2
	Lighting.Brightness = 2.3
	Lighting.Ambient = Color3.fromRGB(110, 100, 95)
	Lighting.OutdoorAmbient = Color3.fromRGB(150, 140, 130)
	Lighting.EnvironmentDiffuseScale = 0.5
	Lighting.EnvironmentSpecularScale = 0.5
	local atmo = Lighting:FindFirstChildOfClass("Atmosphere") or Instance.new("Atmosphere")
	atmo.Density = 0.24
	atmo.Haze = 1.1
	atmo.Color = Color3.fromRGB(240, 215, 190)
	atmo.Decay = Color3.fromRGB(150, 110, 90)
	atmo.Parent = Lighting
	local bloom = Lighting:FindFirstChildOfClass("BloomEffect") or Instance.new("BloomEffect")
	bloom.Intensity = 0.8
	bloom.Size = 32
	bloom.Threshold = 1.12
	bloom.Parent = Lighting
	-- 햇살 줄기 (빛이 구름·나무 사이로 새어 든다)
	local rays = Lighting:FindFirstChildOfClass("SunRaysEffect") or Instance.new("SunRaysEffect")
	rays.Intensity = 0.07
	rays.Spread = 0.75
	rays.Parent = Lighting
	local cc = Lighting:FindFirstChildOfClass("ColorCorrectionEffect") or Instance.new("ColorCorrectionEffect")
	cc.Name = "Mood"
	cc.Saturation = 0.1
	cc.Contrast = 0.1
	cc.TintColor = Color3.fromRGB(255, 245, 232)
	cc.Parent = Lighting
	-- 낮과 밤: 한 바퀴 16분 (낮 10분 · 밤 6분). 밤에도 길이 보이게 바깥 빛을 조금 남긴다
	local baseAtmo, baseDecay, baseTint = atmo.Color, atmo.Decay, cc.TintColor
	local wasTwilight = false
	task.spawn(function()
		while true do
			local now = os.clock()
			if now < twilightUntil then
				-- 일월극변: 컷씬 동안은 낮·밤을 번갈아, 그 뒤엔 황혼에 멈춘다
				if now < twilightFrom then
					-- 컷씬: 낮과 밤이 점점 빨라지며 번갈아 (화면의 해·달과 같은 박자)
					local u = math.clamp((now - twilightCut) / math.max(0.1, twilightFrom - twilightCut), 0, 1)
					local beat = math.floor((u * u) * 12 * 1.6)
					Lighting.ClockTime = beat % 2 == 0 and 12.5 or 0.5
					task.wait(0.05)
					continue
				else
					wasTwilight = true
					Lighting.ClockTime = 18.25
					Lighting.OutdoorAmbient = Color3.fromRGB(190, 120, 150)
					Lighting.Brightness = 1.9
					atmo.Color = Color3.fromRGB(255, 165, 120)
					atmo.Decay = Color3.fromRGB(150, 70, 120)
					cc.TintColor = Color3.fromRGB(255, 214, 196)
				end
				task.wait(0.25)
				continue
			end
			if wasTwilight then
				wasTwilight = false
				atmo.Color = baseAtmo
				atmo.Decay = baseDecay
				cc.TintColor = baseTint
			end
			local h = World.clockHour()
			Lighting.ClockTime = h
			local night = (h < 6.5 or h > 18.5) and 1 or 0
			local dusk = math.clamp(1 - math.abs(h - 18.5) / 1.5, 0, 1) + math.clamp(1 - math.abs(h - 6.5) / 1.5, 0, 1)
			local k = math.max(night, dusk * 0.6)
			Lighting.OutdoorAmbient = Color3.fromRGB(150, 140, 130):Lerp(Color3.fromRGB(95, 105, 150), k)
			Lighting.Brightness = 2.3 - k * 0.9
			task.wait(1)
		end
	end)
end

------------------------------------------------------------------------
-- 건축 (특정 나라 양식이 아닌 판타지풍: 흰 돌, 금빛 테, 빛나는 수정, 깃발)
------------------------------------------------------------------------
local ROOF = Color3.fromRGB(60, 72, 100) -- 짙은 청석 지붕
local WOOD = Color3.fromRGB(95, 65, 45)
local STONE = Color3.fromRGB(205, 198, 182) -- 밝은 돌
local STONE_DARK = Color3.fromRGB(95, 92, 98)
local GOLD = Color3.fromRGB(235, 190, 80)
local WARM = Color3.fromRGB(255, 200, 120) -- 창과 등의 따뜻한 빛
local IRON = Color3.fromRGB(45, 45, 50)

local function light(target: BasePart, color: Color3, range: number, brightness: number?)
	local l = Instance.new("PointLight")
	l.Color = color
	l.Range = range
	l.Brightness = brightness or 1.5
	l.Parent = target
end

local function wedge(props: { [string]: any }): WedgePart
	local w = Instance.new("WedgePart")
	w.Anchored = true
	for k, v in pairs(props) do
		if k ~= "Parent" then
			(w :: any)[k] = v
		end
	end
	w.Parent = props.Parent or folder
	return w
end

local function disc(name: string, at: Vector3, radius: number, height: number, color: Color3, material: Enum.Material, parent: Instance, collide: boolean?): Part
	return part({ Name = name, Shape = Enum.PartType.Cylinder, Size = Vector3.new(height, radius * 2, radius * 2), CFrame = CFrame.new(at) * CFrame.Angles(0, 0, math.rad(90)), Color = color, Material = material, CanCollide = collide ~= false, Parent = parent })
end

-- 떠 있는 수정 (마름모꼴로 세워 빛낸다)
local function crystal(at: Vector3, size: number, color: Color3, parent: Instance): Part
	local c = part({ Name = "Crystal", Size = Vector3.new(size, size * 1.6, size), CFrame = CFrame.new(at) * CFrame.Angles(0, math.rad(45), 0) * CFrame.Angles(math.rad(45), 0, math.rad(45)), Color = color, Material = Enum.Material.Neon, CanCollide = false, Parent = parent })
	light(c, color, size * 8, 2)
	return c
end

-- 석등: 돌 받침, 기둥, 빛나는 등 칸, 두 겹 돌 갓
local STONE_LAMP = Color3.fromRGB(170, 165, 155)
local function stoneLantern(at: Vector3, parent: Instance, lit: boolean)
	part({ Name = "LampBase", Size = Vector3.new(2.6, 0.8, 2.6), Position = at + Vector3.new(0, 0.4, 0), Color = STONE_DARK, Material = Enum.Material.Granite, Parent = parent })
	part({ Name = "LampPillar", Size = Vector3.new(1, 4, 1), Position = at + Vector3.new(0, 2.8, 0), Color = STONE_LAMP, Material = Enum.Material.Granite, Parent = parent })
	part({ Name = "LampShelf", Size = Vector3.new(2.4, 0.4, 2.4), Position = at + Vector3.new(0, 4.9, 0), Color = STONE_LAMP, Material = Enum.Material.Granite, Parent = parent })
	local box = part({ Name = "LampLight", Size = Vector3.new(1.6, 1.5, 1.6), Position = at + Vector3.new(0, 5.85, 0), Color = WARM, Material = Enum.Material.Neon, CanCollide = false, Parent = parent })
	part({ Name = "LampCap", Size = Vector3.new(3, 0.5, 3), Position = at + Vector3.new(0, 6.85, 0), Color = STONE_DARK, Material = Enum.Material.Granite, Parent = parent })
	part({ Name = "LampCap2", Size = Vector3.new(1.6, 0.5, 1.6), Position = at + Vector3.new(0, 7.35, 0), Color = STONE_DARK, Material = Enum.Material.Granite, Parent = parent })
	if lit then
		light(box, WARM, 20, 1.3)
	end
end

-- 붉은 칠 나무 (문루·종루 기둥)
local GATE_RED = Color3.fromRGB(140, 45, 38)

-- 깃발 (장대 + 천)
local function banner(at: Vector3, h: number, color: Color3, parent: Instance)
	part({ Name = "BannerPole", Size = Vector3.new(0.6, h, 0.6), Position = at + Vector3.new(0, h / 2, 0), Color = IRON, Material = Enum.Material.Metal, Parent = parent })
	part({ Name = "BannerCloth", Size = Vector3.new(3.4, h * 0.45, 0.15), Position = at + Vector3.new(1.9, h * 0.72, 0), Color = color, Material = Enum.Material.Fabric, CanCollide = false, Parent = parent })
	part({ Name = "BannerTip", Shape = Enum.PartType.Ball, Size = Vector3.new(1, 1, 1), Position = at + Vector3.new(0, h + 0.4, 0), Color = GOLD, Material = Enum.Material.Metal, CanCollide = false, Parent = parent })
end

-- 화로 (돌 받침 + 불)
local function brazier(at: Vector3, s: number, parent: Instance)
	part({ Name = "BrazierStand", Size = Vector3.new(1.4, 4, 1.4) * s, Position = at + Vector3.new(0, 2 * s, 0), Color = STONE_DARK, Material = Enum.Material.Granite, Parent = parent })
	local bowl = disc("BrazierBowl", at + Vector3.new(0, 4.4 * s, 0), 1.6 * s, 0.9 * s, GOLD, Enum.Material.Metal, parent)
	local fire = Instance.new("Fire")
	fire.Size = 5 * s
	fire.Heat = 7
	fire.Parent = bowl
	light(bowl, Color3.fromRGB(255, 160, 80), 18 * s, 1.6)
end

-- 맞배지붕: cf = 처마 높이의 가운데, w×d 위를 덮는다
local function roof(cf: CFrame, w: number, d: number, color: Color3, wallColor: Color3, parent: Instance): number
	local over = 1.8
	local hd = d / 2 + over
	local a = math.rad(32)
	local H = hd * math.tan(a)
	local L = hd / math.cos(a)
	local W = w + over * 2
	for _, side in ipairs({ -1, 1 }) do
		part({ Name = "Roof", Size = Vector3.new(W, 0.8, L), CFrame = cf * CFrame.new(0, H / 2, side * hd / 2) * CFrame.Angles(side * a, 0, 0), Color = color, Material = Enum.Material.Slate, Parent = parent })
	end
	for _, sx in ipairs({ -1, 1 }) do
		local x = sx * (w / 2 - 0.2)
		wedge({ Name = "Gable", Size = Vector3.new(0.6, H, hd - over), CFrame = cf * CFrame.new(x, H / 2 - 0.3, -(hd - over) / 2), Color = wallColor, Material = Enum.Material.Plaster, Parent = parent })
		wedge({ Name = "Gable", Size = Vector3.new(0.6, H, hd - over), CFrame = cf * CFrame.new(x, H / 2 - 0.3, (hd - over) / 2) * CFrame.Angles(0, math.pi, 0), Color = wallColor, Material = Enum.Material.Plaster, Parent = parent })
	end
	part({ Name = "Ridge", Size = Vector3.new(W + 0.4, 0.9, 1.2), CFrame = cf * CFrame.new(0, H + 0.25, 0), Color = color:Lerp(Color3.new(0, 0, 0), 0.3), Material = Enum.Material.Slate, Parent = parent })
	return H
end

-- 집 한 채: 돌 기단, 벽, 나무 뼈대, 빛나는 창, 지붕. 앞은 -Z (tiers = 2면 이층)
local WALLS = { Color3.fromRGB(225, 212, 188), Color3.fromRGB(210, 196, 170), Color3.fromRGB(190, 180, 168), Color3.fromRGB(220, 205, 175) }
local ROOFS = { ROOF, Color3.fromRGB(150, 75, 55), Color3.fromRGB(80, 100, 72), Color3.fromRGB(70, 66, 78) }
local function building(at: Vector3, w: number, d: number, rotY: number, parent: Instance, opt: any?)
	local o = opt or {}
	local cf = CFrame.new(at) * CFrame.Angles(0, rotY, 0)
	local h = o.h or 10
	local t = o.terrace or 1
	local wall = o.wall or WALLS[rng:NextInteger(1, #WALLS)]
	local roofColor = o.roof or ROOFS[rng:NextInteger(1, #ROOFS)]
	part({ Name = "Plinth", Size = Vector3.new(w + 2, t, d + 2), CFrame = cf * CFrame.new(0, t / 2, 0), Color = STONE_DARK, Material = Enum.Material.Cobblestone, Parent = parent })
	local base = cf * CFrame.new(0, t, 0)
	local function storey(b: CFrame, sw: number, sd: number, sh: number, withDoor: boolean)
		part({ Name = "Wall", Size = Vector3.new(sw, sh, sd), CFrame = b * CFrame.new(0, sh / 2, 0), Color = wall, Material = Enum.Material.Plaster, Parent = parent })
		-- 나무 뼈대 (모서리 기둥, 위아래 띠)
		for _, sx in ipairs({ -1, 1 }) do
			for _, sz in ipairs({ -1, 1 }) do
				part({ Name = "Post", Size = Vector3.new(1, sh, 1), CFrame = b * CFrame.new(sx * sw / 2, sh / 2, sz * sd / 2), Color = WOOD, Material = Enum.Material.Wood, Parent = parent })
			end
		end
		part({ Name = "Beam", Size = Vector3.new(sw + 0.6, 0.8, sd + 0.6), CFrame = b * CFrame.new(0, sh - 0.4, 0), Color = WOOD, Material = Enum.Material.Wood, Parent = parent })
		-- 창 (앞뒤로, 따뜻하게 빛난다)
		local nWin = math.max(1, math.floor(sw / 7))
		for i = 1, nWin do
			local x = -sw / 2 + i * sw / (nWin + 1)
			if not (withDoor and math.abs(x) < 3) then
				for _, sz in ipairs({ -1, 1 }) do
					part({ Name = "Window", Size = Vector3.new(2, 2.6, 0.2), CFrame = b * CFrame.new(x, sh * 0.58, sz * (sd / 2 + 0.05)), Color = WARM, Material = Enum.Material.Neon, Transparency = 0.25, CanCollide = false, Parent = parent })
					part({ Name = "Sill", Size = Vector3.new(2.6, 0.3, 0.5), CFrame = b * CFrame.new(x, sh * 0.58 - 1.45, sz * (sd / 2 + 0.2)), Color = WOOD, Material = Enum.Material.Wood, CanCollide = false, Parent = parent })
				end
			end
		end
		if withDoor then
			part({ Name = "Door", Size = Vector3.new(3.6, 6.4, 0.3), CFrame = b * CFrame.new(0, 3.2, -sd / 2 - 0.1), Color = WOOD, Material = Enum.Material.WoodPlanks, Parent = parent })
			part({ Name = "DoorArch", Size = Vector3.new(5, 0.9, 0.6), CFrame = b * CFrame.new(0, 6.8, -sd / 2 - 0.2), Color = STONE, Material = Enum.Material.Marble, Parent = parent })
		end
	end
	storey(base, w, d, h, true)
	local top = base * CFrame.new(0, h, 0)
	local rw, rd = w, d
	if o.tiers == 2 then
		-- 이층은 살짝 내밀어 짓는다
		local w2, d2, h2 = w + 1.2, d + 1.2, h * 0.75
		storey(top, w2, d2, h2, false)
		top = top * CFrame.new(0, h2, 0)
		rw, rd = w2, d2
	end
	roof(top, rw, rd, roofColor, wall, parent)
	-- 차양과 벽등
	if o.awning ~= false then
		local aw = part({ Name = "Awning", Size = Vector3.new(math.min(w * 0.5, 10), 0.3, 3), CFrame = base * CFrame.new(0, 7.6, -d / 2 - 1.5) * CFrame.Angles(math.rad(-18), 0, 0), Color = o.awningColor or Color3.fromRGB(150, 50, 45):Lerp(Color3.fromRGB(50, 80, 140), rng:NextNumber()), Material = Enum.Material.Fabric, CanCollide = false, Parent = parent })
		local _ = aw
	end
	local lamp = part({ Name = "WallLamp", Size = Vector3.new(0.9, 1.3, 0.9), CFrame = base * CFrame.new(w / 2 - 1.6, 6, -d / 2 - 0.8), Color = WARM, Material = Enum.Material.Neon, CanCollide = false, Parent = parent })
	light(lamp, WARM, 14, 1.2)
	if o.sign then
		local board = part({ Name = "Signboard", Size = Vector3.new(math.min(w * 0.6, 14), 2.6, 0.4), CFrame = base * CFrame.new(0, h - 1.4, -d / 2 - 0.5), Color = Color3.fromRGB(40, 30, 25), Material = Enum.Material.Wood, CanCollide = false, Parent = parent })
		sign(board, Enum.NormalId.Front, { { o.sign, GOLD, 1 } })
	end
end
local function house(at: Vector3, w: number, d: number, rotY: number, parent: Instance)
	building(at, w, d, rotY, parent, { tiers = rng:NextNumber() < 0.4 and 2 or 1 })
end

-- 첨탑: 가늘어지는 돌 원통을 쌓고 금빛 테를 두른 뒤 꼭대기에 수정
local function spire(at: Vector3, levels: number, r0: number, glow: Color3, parent: Instance)
	disc("SpireBase", at + Vector3.new(0, 1.2, 0), r0 + 4, 2.4, STONE_DARK, Enum.Material.Granite, parent)
	local y = 2.4
	local r = r0
	for i = 1, levels do
		local h = i == 1 and 14 or 9
		disc("SpireBody", at + Vector3.new(0, y + h / 2, 0), r, h, STONE, Enum.Material.Marble, parent)
		disc("SpireRing", at + Vector3.new(0, y + h, 0), r + 0.9, 1.1, GOLD, Enum.Material.Metal, parent)
		-- 층마다 빛나는 좁은 창
		for k = 0, 3 do
			local a = k / 4 * math.pi * 2 + i * 0.4
			part({ Name = "SpireWindow", Size = Vector3.new(1.1, h * 0.45, 0.3), CFrame = CFrame.lookAt(at + Vector3.new(math.cos(a) * r, y + h * 0.55, math.sin(a) * r), at + Vector3.new(0, y + h * 0.55, 0)), Color = glow, Material = Enum.Material.Neon, CanCollide = false, Parent = parent })
		end
		y += h + 1.1
		r *= 0.8
	end
	for k = 1, 4 do
		disc("SpireCap", at + Vector3.new(0, y + k * 1.2, 0), r * (1 - k * 0.2), 1.2, STONE, Enum.Material.Marble, parent)
	end
	crystal(at + Vector3.new(0, y + 10, 0), 3.2, glow, parent)
end

-- 큰 돌문: 두 기둥 + 위를 가로지르는 들보, 문장(빛나는 고리), 양쪽 깃발
local function monumentGate(center: Vector3, yaw: number, parent: Instance, title: string, accent: Color3)
	local cf = CFrame.new(center) * CFrame.Angles(0, yaw, 0)
	for _, sx in ipairs({ -1, 1 }) do
		local x = sx * 13
		part({ Name = "GateFoot", Size = Vector3.new(7, 3, 7), CFrame = cf * CFrame.new(x, 1.5, 0), Color = STONE_DARK, Material = Enum.Material.Granite, Parent = parent })
		part({ Name = "GatePylon", Size = Vector3.new(5, 26, 5), CFrame = cf * CFrame.new(x, 16, 0), Color = STONE, Material = Enum.Material.Marble, Parent = parent })
		part({ Name = "GateBand", Size = Vector3.new(5.6, 0.8, 5.6), CFrame = cf * CFrame.new(x, 9, 0), Color = GOLD, Material = Enum.Material.Metal, Parent = parent })
		part({ Name = "GateCap", Size = Vector3.new(6.4, 1.6, 6.4), CFrame = cf * CFrame.new(x, 29.8, 0), Color = GOLD, Material = Enum.Material.Metal, Parent = parent })
		crystal((cf * CFrame.new(x, 34, 0)).Position, 2.4, accent, parent)
		-- 기둥 앞뒤로 늘어진 깃발
		for _, sz in ipairs({ -1, 1 }) do
			part({ Name = "GateBanner", Size = Vector3.new(3.6, 12, 0.15), CFrame = cf * CFrame.new(x, 19, sz * 2.6), Color = accent, Material = Enum.Material.Fabric, CanCollide = false, Parent = parent })
			part({ Name = "GateBannerTrim", Size = Vector3.new(3.8, 0.5, 0.2), CFrame = cf * CFrame.new(x, 13, sz * 2.62), Color = GOLD, Material = Enum.Material.Metal, CanCollide = false, Parent = parent })
		end
	end
	-- 문 바깥 양쪽 화로
	for _, sx in ipairs({ -1, 1 }) do
		brazier((cf * CFrame.new(sx * 20, 0, -5)).Position, 1, parent)
	end
	part({ Name = "GateLintel", Size = Vector3.new(34, 4, 5.4), CFrame = cf * CFrame.new(0, 27, 0), Color = STONE, Material = Enum.Material.Marble, Parent = parent })
	part({ Name = "GateLintelGold", Size = Vector3.new(34.4, 0.6, 5.8), CFrame = cf * CFrame.new(0, 25.1, 0), Color = GOLD, Material = Enum.Material.Metal, CanCollide = false, Parent = parent })
	-- 가운데 문장: 금빛 고리 안의 빛
	local ring = part({ Name = "GateEmblem", Shape = Enum.PartType.Cylinder, Size = Vector3.new(1, 7, 7), CFrame = cf * CFrame.new(0, 31.5, 0) * CFrame.Angles(0, math.rad(90), 0), Color = GOLD, Material = Enum.Material.Metal, CanCollide = false, Parent = parent })
	local _ = ring
	local core = part({ Name = "GateEmblemCore", Shape = Enum.PartType.Cylinder, Size = Vector3.new(1.2, 4.6, 4.6), CFrame = cf * CFrame.new(0, 31.5, 0) * CFrame.Angles(0, math.rad(90), 0), Color = accent, Material = Enum.Material.Neon, CanCollide = false, Parent = parent })
	light(core, accent, 24, 2)
	for _, sz in ipairs({ -1, 1 }) do
		local board = part({ Name = "GateTitle", Size = Vector3.new(20, 3, 0.3), CFrame = cf * CFrame.new(0, 27, sz * 2.86) * CFrame.Angles(0, sz > 0 and math.pi or 0, 0), Color = STONE, Material = Enum.Material.Marble, CanCollide = false, Transparency = 1, Parent = parent })
		sign(board, Enum.NormalId.Front, { { title, GOLD, 1 } })
	end
end

-- 원형 정자: 돌기둥, 둥근 띠, 층층이 줄어드는 둥근 지붕, 꼭대기 수정
local function pavilion(center: Vector3, r: number, n: number, h: number, roofColor: Color3, parent: Instance, glow: Color3?)
	for k = 0, n - 1 do
		local a = (k + 0.5) / n * math.pi * 2
		local p = center + Vector3.new(math.cos(a) * r, 0, math.sin(a) * r)
		part({ Name = "PavilionColumn", Shape = Enum.PartType.Cylinder, Size = Vector3.new(h, 1.5, 1.5), CFrame = CFrame.new(p + Vector3.new(0, h / 2, 0)) * CFrame.Angles(0, 0, math.rad(90)), Color = STONE, Material = Enum.Material.Marble, Parent = parent })
		part({ Name = "ColumnCap", Size = Vector3.new(2, 0.6, 2), Position = p + Vector3.new(0, h - 0.3, 0), Color = GOLD, Material = Enum.Material.Metal, Parent = parent })
	end
	disc("PavilionRing", center + Vector3.new(0, h + 0.7, 0), r + 1.2, 1.4, STONE, Enum.Material.Marble, parent)
	disc("PavilionGold", center + Vector3.new(0, h + 0.05, 0), r + 1.4, 0.3, GOLD, Enum.Material.Metal, parent, false)
	for k = 1, 5 do
		local rr = (r + 1.5) * math.cos(math.rad(k * 16))
		disc("PavilionDome", center + Vector3.new(0, h + 1.4 + k * 1.1, 0), rr, 1.2, roofColor, Enum.Material.Slate, parent)
	end
	crystal(center + Vector3.new(0, h + 1.4 + 5 * 1.1 + 4.5, 0), 2.2, glow or GOLD, parent)
end

------------------------------------------------------------------------
-- 작은 것들 (집, 나무, 바위, 대나무)
------------------------------------------------------------------------
-- 나무 (1.8판에 다듬음): 아래가 굵은 두 토막 줄기, 비스듬히 뻗은 가지 둘, 짙고 옅은 잎 덩이 다섯
local function tree(at: Vector3, s: number, parent: Instance, blossom: boolean?)
	local bark = Color3.fromRGB(90, 60, 40)
	local lean = rng:NextNumber(-0.08, 0.08)
	part({ Name = "Trunk", Shape = Enum.PartType.Cylinder, Size = Vector3.new(6 * s, 1.9 * s, 1.9 * s), CFrame = CFrame.new(at + Vector3.new(0, 3 * s, 0)) * CFrame.Angles(lean, 0, math.rad(90)), Color = bark, Material = Enum.Material.Wood, Parent = parent })
	part({ Name = "Trunk", Shape = Enum.PartType.Cylinder, Size = Vector3.new(5.5 * s, 1.3 * s, 1.3 * s), CFrame = CFrame.new(at + Vector3.new(0, 8 * s, lean * 4 * s)) * CFrame.Angles(lean * 2, 0, math.rad(90)), Color = bark, Material = Enum.Material.Wood, Parent = parent })
	-- 매화는 짙은 홍매와 흰 백매를 섞는다
	local leaf = blossom and (rng:NextNumber() < 0.6 and Color3.fromRGB(215, 55, 85) or Color3.fromRGB(250, 236, 240)) or Color3.fromRGB(70, 120, 60):Lerp(Color3.fromRGB(100, 150, 70), rng:NextNumber())
	local top = at + Vector3.new(0, 10 * s, 0)
	for k = 0, 1 do
		local a = rng:NextNumber(0, 6.28) + k * math.pi
		local to = top + Vector3.new(math.cos(a) * 3.5 * s, -1 * s, math.sin(a) * 3.5 * s)
		local from = at + Vector3.new(0, 7 * s, 0)
		part({ Name = "Branch", Size = Vector3.new(0.6 * s, 0.6 * s, (to - from).Magnitude), CFrame = CFrame.lookAt((from + to) / 2, to), Color = bark, Material = Enum.Material.Wood, CanCollide = false, Parent = parent })
		part({ Name = "Leaves", Shape = Enum.PartType.Ball, Size = Vector3.one * rng:NextNumber(4.5, 6) * s, Position = to + Vector3.new(0, 1.2 * s, 0), Color = leaf:Lerp(Color3.new(0, 0, 0), 0.12), Material = Enum.Material.LeafyGrass, CanCollide = false, Parent = parent })
	end
	for i = 1, 3 do
		part({
			Name = "Leaves",
			Shape = Enum.PartType.Ball,
			Size = Vector3.new(1, 0.85, 1) * (6 + i) * s,
			CFrame = CFrame.new(top + Vector3.new(rng:NextNumber(-2, 2) * s, (i - 1) * 1.8 * s, rng:NextNumber(-2, 2) * s)),
			Color = leaf:Lerp(Color3.new(1, 1, 1), (i - 1) * 0.06 + rng:NextNumber(0, 0.08)),
			Material = Enum.Material.LeafyGrass,
			CanCollide = false,
			Parent = parent,
		})
	end
end

-- 바위 (1.8판에 다듬음): 큰 돌에 작은 돌이 기대고, 윗면엔 가끔 이끼
local function rock(at: Vector3, s: number, parent: Instance, color: Color3?)
	local c = color or Color3.fromRGB(120, 115, 110)
	local main = part({
		Name = "Rock",
		Size = Vector3.new(rng:NextNumber(0.8, 1.3), rng:NextNumber(0.5, 0.9), rng:NextNumber(0.8, 1.3)) * s,
		CFrame = CFrame.new(at + Vector3.new(0, s * 0.3, 0)) * CFrame.Angles(rng:NextNumber(-0.3, 0.3), rng:NextNumber(0, 6), rng:NextNumber(-0.3, 0.3)),
		Color = c,
		Material = Enum.Material.Slate,
		Parent = parent,
	})
	part({ Name = "Rock", Size = main.Size * 0.5, CFrame = CFrame.new(at + Vector3.new(main.Size.X * 0.5, s * 0.15, rng:NextNumber(-0.3, 0.3) * s)) * CFrame.Angles(rng:NextNumber(-0.4, 0.4), rng:NextNumber(0, 6), rng:NextNumber(-0.4, 0.4)), Color = c:Lerp(Color3.new(0, 0, 0), 0.1), Material = Enum.Material.Slate, Parent = parent })
	if s > 2.5 and rng:NextNumber() < 0.5 then
		part({ Name = "Moss", Size = Vector3.new(main.Size.X * 0.8, 0.25, main.Size.Z * 0.8), CFrame = main.CFrame * CFrame.new(0, main.Size.Y / 2, 0), Color = Color3.fromRGB(85, 120, 60), Material = Enum.Material.Grass, CanCollide = false, Parent = parent })
	end
end

local function bamboo(at: Vector3, parent: Instance)
	local h = rng:NextNumber(22, 38)
	part({ Name = "Bamboo", Shape = Enum.PartType.Cylinder, Size = Vector3.new(h, 1, 1), CFrame = CFrame.new(at + Vector3.new(0, h / 2, 0)) * CFrame.Angles(rng:NextNumber(-0.05, 0.05), 0, math.rad(90) + rng:NextNumber(-0.05, 0.05)), Color = Color3.fromRGB(110, 160, 70):Lerp(Color3.fromRGB(170, 190, 90), rng:NextNumber()), Material = Enum.Material.SmoothPlastic, Parent = parent })
	part({ Name = "BambooLeaf", Size = Vector3.new(6, 0.3, 2.5), CFrame = CFrame.new(at + Vector3.new(1.5, h - 2, 0)) * CFrame.Angles(0, rng:NextNumber(0, 6), 0.4), Color = Color3.fromRGB(90, 150, 60), Material = Enum.Material.Grass, CanCollide = false, Parent = parent })
end

------------------------------------------------------------------------
-- 길
------------------------------------------------------------------------
-- 점 p가 어느 길에서 margin칸 안인가 (나무·대나무를 길 위에 심지 않게)
local function nearRoad(p: Vector3, margin: number): boolean
	local q = Vector3.new(p.X, 0, p.Z)
	for _, road in ipairs(Config.Roads) do
		for i = 1, #road - 1 do
			local a, b = road[i], road[i + 1]
			local ab = b - a
			local len2 = ab:Dot(ab)
			local t = len2 > 0 and math.clamp((q - a):Dot(ab) / len2, 0, 1) or 0
			if (q - (a + ab * t)).Magnitude < margin then
				return true
			end
		end
	end
	return false
end
World.nearRoad = nearRoad

local function roads()
	for k, road in ipairs(Config.Roads) do
		for i = 1, #road - 1 do
			local a, b = road[i], road[i + 1]
			local len = (b - a).Magnitude
			if len > 0.5 then
				-- 길마다 살짝 다른 높이 (겹치는 곳이 깜빡이지 않게). 자갈 가장자리 위에 돌을 깐 가운데 길
				local y = -0.08 + k * 0.02
				local mid = (a + b) / 2 + Vector3.new(0, y, 0)
				local cf = CFrame.lookAt(mid, mid + (b - a))
				part({ Name = "RoadEdge", Size = Vector3.new(22, 1, len + 22), CFrame = cf, Color = Color3.fromRGB(150, 136, 112), Material = Enum.Material.Pebble, Parent = folder })
				part({ Name = "Road", Size = Vector3.new(14, 1, len + 14), CFrame = cf + Vector3.new(0, 0.01, 0), Color = Color3.fromRGB(188, 172, 140), Material = Enum.Material.Cobblestone, Parent = folder })
			end
		end
	end
end

------------------------------------------------------------------------
-- 땅
------------------------------------------------------------------------
local function ground()
	-- 바탕 풀밭 (2048 넘지 않게 4×4 조각)
	local W = Config.WORLD_HALF
	local n = math.ceil(W * 2 / 2000)
	local tile = W * 2 / n
	for i = 0, n - 1 do
		for j = 0, n - 1 do
			part({ Name = "BaseGround", Size = Vector3.new(tile, 6, tile), Position = Vector3.new(-W + tile * (i + 0.5), -3, -W + tile * (j + 0.5)), Color = Color3.fromRGB(105, 135, 80), Material = Enum.Material.Grass, Parent = folder })
		end
	end
	-- 지역 바닥 (조금 두껍게 깔아 겹쳐 깜빡이지 않게)
	for k, r in ipairs(Config.Regions) do
		if not r.noGround then
			part({ Name = "RegionGround", Size = Vector3.new(r.size.X, 1, r.size.Z), Position = r.center + Vector3.new(0, -0.35 + k * 0.01, 0), Color = r.ground, Material = r.material, Parent = folder })
		end
	end
	roads()
	-- 세상 끝 (보이지 않는 벽)
	-- (한 조각이 2048을 넘지 않게 여러 토막)
	local pieces = math.ceil(W * 2 / 1600)
	local seg = W * 2 / pieces
	for _, d in ipairs({ { 1, 0 }, { -1, 0 }, { 0, 1 }, { 0, -1 } }) do
		for k = 0, pieces - 1 do
			local along = -W + seg * (k + 0.5)
			local size = d[1] ~= 0 and Vector3.new(40, 400, seg) or Vector3.new(seg, 400, 40)
			local pos = d[1] ~= 0 and Vector3.new(d[1] * (W - 20), 200, along) or Vector3.new(along, 200, d[2] * (W - 20))
			part({ Name = "WorldWall", Size = size, Position = pos, Transparency = 1, Parent = folder })
		end
	end
	-- 멀리 둘러싼 산 (배경)
	for i = 0, 31 do
		local a = i / 32 * math.pi * 2
		local dist = Config.WORLD_HALF + 260 + rng:NextNumber(-60, 60)
		local h = rng:NextNumber(260, 520)
		local cap = rng:NextNumber(0.18, 0.28)
		part({
			Name = "SnowCap",
			Size = Vector3.new(160, h * cap, 130),
			CFrame = CFrame.new(math.cos(a) * dist, h - 20 - h * cap / 2 + 2, math.sin(a) * dist) * CFrame.Angles(0, -a, 0),
			Color = Color3.fromRGB(240, 244, 250),
			Material = Enum.Material.Snow,
			CanCollide = false,
			Parent = folder,
		})
		part({
			Name = "FarMountain",
			Size = Vector3.new(rng:NextNumber(260, 420), h, rng:NextNumber(200, 300)),
			CFrame = CFrame.new(math.cos(a) * dist, h / 2 - 20, math.sin(a) * dist) * CFrame.Angles(0, -a, 0) * CFrame.Angles(0, 0, rng:NextNumber(-0.1, 0.1)),
			Color = Color3.fromRGB(95, 110, 120):Lerp(Color3.fromRGB(140, 150, 160), rng:NextNumber()),
			Material = Enum.Material.Rock,
			CanCollide = false,
			Parent = folder,
		})
	end
end

------------------------------------------------------------------------
-- 청운 마을
------------------------------------------------------------------------
local function village(out: any)
	local f = Instance.new("Folder")
	f.Name = "Village"
	f.Parent = folder
	-- 마을 성벽 (높은 흰 돌담, 돌 갓, 성가퀴) 네 방향 입구
	local R = 235
	for _, side in ipairs({ { 1, 0 }, { -1, 0 }, { 0, 1 }, { 0, -1 } }) do
		for _, seg in ipairs({ -1, 1 }) do
			local len = R - 14
			local along = seg * (14 + len / 2)
			local alongX = side[1] == 0
			local function at(y: number, out: number): Vector3
				return alongX and Vector3.new(along, y, side[2] * (R + out)) or Vector3.new(side[1] * (R + out), y, along)
			end
			local function sz(l: number, h: number, t: number): Vector3
				return alongX and Vector3.new(l, h, t) or Vector3.new(t, h, l)
			end
			part({ Name = "VillageWall", Size = sz(len, 12, 4), Position = at(6, 0), Color = STONE, Material = Enum.Material.Cobblestone, Parent = f })
			part({ Name = "WallTrim", Size = sz(len + 0.2, 0.6, 4.6), Position = at(2, 0), Color = STONE_DARK, Material = Enum.Material.Granite, Parent = f })
			part({ Name = "WallCap", Size = sz(len + 0.2, 0.9, 5.4), Position = at(12.45, 0), Color = Color3.fromRGB(225, 220, 205), Material = Enum.Material.Marble, Parent = f })
			local count = math.floor(len / 7)
			for k = 0, count - 1 do
				local off = -len / 2 + (k + 0.5) * (len / count)
				local pos = alongX and Vector3.new(along + off, 14, side[2] * (R + 2.2)) or Vector3.new(side[1] * (R + 2.2), 14, along + off)
				part({ Name = "Merlon", Size = sz(3, 2.4, 1.2), Position = pos, Color = STONE, Material = Enum.Material.Cobblestone, Parent = f })
			end
			-- 성벽 바깥에 드리운 깃발
			for _, off in ipairs({ -len * 0.25, len * 0.25 }) do
				local pos = alongX and Vector3.new(along + off, 7.5, side[2] * (R + 2.15)) or Vector3.new(side[1] * (R + 2.15), 7.5, along + off)
				part({ Name = "WallBanner", Size = sz(4, 9, 0.15), Position = pos, Color = Color3.fromRGB(40, 70, 140), Material = Enum.Material.Fabric, CanCollide = false, Parent = f })
				part({ Name = "WallBannerTrim", Size = sz(4.2, 0.5, 0.2), Position = pos + Vector3.new(0, 4.5, 0), Color = GOLD, Material = Enum.Material.Metal, CanCollide = false, Parent = f })
			end
		end
	end
	-- 네 모서리 둥근 망루 (꼭대기에 수정)
	for _, cx in ipairs({ -1, 1 }) do
		for _, cz in ipairs({ -1, 1 }) do
			local c = Vector3.new(cx * R, 0, cz * R)
			disc("CornerTower", c + Vector3.new(0, 11, 0), 9, 22, STONE, Enum.Material.Cobblestone, f)
			disc("CornerTowerRing", c + Vector3.new(0, 22.4, 0), 10, 1, GOLD, Enum.Material.Metal, f)
			disc("CornerTowerTop", c + Vector3.new(0, 23.6, 0), 10.5, 1.4, Color3.fromRGB(225, 220, 205), Enum.Material.Marble, f)
			for k = 0, 9 do
				local a = k / 10 * math.pi * 2
				part({ Name = "TowerMerlon", Size = Vector3.new(2.4, 2.4, 1.2), CFrame = CFrame.lookAt(c + Vector3.new(math.cos(a) * 9.8, 25.5, math.sin(a) * 9.8), c + Vector3.new(0, 25.5, 0)), Color = STONE, Material = Enum.Material.Cobblestone, Parent = f })
			end
			crystal(c + Vector3.new(0, 31, 0), 3, Color3.fromRGB(120, 200, 255), f)
		end
	end
	-- 큰 돌문 네 개 (성벽 바깥에 선다)
	for _, g in ipairs({ { Vector3.new(0, 0, -R - 9), 0 }, { Vector3.new(0, 0, R + 9), 0 }, { Vector3.new(-R - 9, 0, 0), math.rad(90) }, { Vector3.new(R + 9, 0, 0), math.rad(90) } }) do
		monumentGate(g[1], g[2], f, "청운 마을", Color3.fromRGB(110, 190, 255))
	end
	-- 북쪽 길 양옆의 높은 첨탑 둘
	for _, sx in ipairs({ -1, 1 }) do
		spire(Vector3.new(sx * 110, 0, -95), 5, 9, Color3.fromRGB(120, 200, 255), f)
	end
	-- 마을 한가운데 분수: 둥근 못과 떠오른 큰 수정
	local fc = Vector3.new(0, 0, -62)
	disc("FountainRim", fc + Vector3.new(0, 1, 0), 11, 2, STONE, Enum.Material.Marble, f)
	disc("FountainWater", fc + Vector3.new(0, 1.9, 0), 10, 0.4, Color3.fromRGB(90, 170, 220), Enum.Material.Glass, f, false).Transparency = 0.3
	disc("FountainPillar", fc + Vector3.new(0, 4.5, 0), 1.6, 9, STONE, Enum.Material.Marble, f)
	disc("FountainGold", fc + Vector3.new(0, 9.2, 0), 2.4, 0.6, GOLD, Enum.Material.Metal, f)
	crystal(fc + Vector3.new(0, 14, 0), 4, Color3.fromRGB(120, 200, 255), f)
	local spray = part({ Name = "FountainSpray", Size = Vector3.new(2, 1, 2), Position = fc + Vector3.new(0, 9, 0), Transparency = 1, CanCollide = false, Parent = f })
	local e = Instance.new("ParticleEmitter")
	e.Rate = 40
	e.Color = ColorSequence.new(Color3.fromRGB(200, 235, 255))
	e.Size = NumberSequence.new(0.4, 0.1)
	e.Transparency = NumberSequence.new(0.3, 1)
	e.Speed = NumberRange.new(8, 12)
	e.SpreadAngle = Vector2.new(30, 30)
	e.Acceleration = Vector3.new(0, -25, 0)
	e.Lifetime = NumberRange.new(0.8, 1.2)
	e.Parent = spray
	-- 큰길의 쇠 등기둥 (따뜻한 빛)
	for _, z in ipairs({ -215, -185, -160, -135, -85, -40, 20, 140, 160, 190, 215 }) do
		for _, sx in ipairs({ -1, 1 }) do
			local p = Vector3.new(sx * 13, 0, z)
			part({ Name = "LampPost", Size = Vector3.new(0.6, 10, 0.6), Position = p + Vector3.new(0, 5, 0), Color = IRON, Material = Enum.Material.Metal, Parent = f })
			part({ Name = "LampFoot", Size = Vector3.new(1.6, 0.8, 1.6), Position = p + Vector3.new(0, 0.4, 0), Color = STONE_DARK, Material = Enum.Material.Granite, Parent = f })
			local lamp = part({ Name = "StreetLamp", Size = Vector3.new(1.4, 1.8, 1.4), Position = p + Vector3.new(0, 10.6, 0), Color = WARM, Material = Enum.Material.Neon, CanCollide = false, Parent = f })
			part({ Name = "LampCap", Size = Vector3.new(2, 0.5, 2), Position = p + Vector3.new(0, 11.7, 0), Color = IRON, Material = Enum.Material.Metal, CanCollide = false, Parent = f })
			light(lamp, WARM, 18, 1.3)
		end
	end
	-- 집들 (둘레)
	local spots = {
		{ -130, -140 }, { -90, -150 }, { 90, -150 }, { 130, -140 },
		{ -145, -60 }, { -145, 40 }, { -145, 120 }, { 145, -60 }, { 145, 40 }, { 145, 120 },
		{ -100, 150 }, { -50, 155 }, { 50, 155 }, { 100, 150 },
		-- 넓힌 마을의 바깥 둘레
		{ -205, -40 }, { -205, 50 }, { -205, 140 }, { 205, -40 }, { 205, 50 }, { 205, 140 },
		{ -120, 205 }, { -60, 210 }, { 60, 210 }, { 120, 205 },
	}
	for _, s in ipairs(spots) do
		local x, z = s[1], s[2]
		local rot = math.abs(x) > 130 and (x > 0 and math.rad(-90) or math.rad(90)) or (z > 0 and math.rad(180) or 0)
		house(Vector3.new(x, 0, z), rng:NextNumber(18, 26), rng:NextNumber(14, 18), rot, f)
	end
	-- 매화나무
	for _, s in ipairs({ { -40, -60 }, { 40, -60 }, { -110, 70 }, { 110, 70 }, { -60, 40 }, { 60, 40 } }) do
		tree(Vector3.new(s[1], 0, s[2]), 1.1, f)
	end

	-- 3.3판: 비무대 자리에 배틀그라운드의 문 (메인 월드에서는 사람끼리 싸우지 않는다). 돌 단 위의 붉은 문과 빛의 막
	local ring = Config.RING
	local c = ring.center
	part({ Name = "BattleBase", Size = Vector3.new(30, 1.6, 18), Position = c + Vector3.new(0, 0.8, 0), Color = Color3.fromRGB(150, 140, 125), Material = Enum.Material.Granite, Parent = f })
	for i = 1, 2 do
		part({ Name = "BattleStep", Size = Vector3.new(16, 0.8, 3), Position = c + Vector3.new(0, 0.4 * i - 0.4 + 0.4, -10.5 - (2 - i) * 2.2), Color = Color3.fromRGB(135, 126, 112), Material = Enum.Material.Granite, Parent = f })
	end
	for _, x in ipairs({ -1, 1 }) do
		part({ Name = "BattlePost", Size = Vector3.new(2.4, 18, 2.4), Position = c + Vector3.new(x * 8, 10.6, 0), Color = GATE_RED, Material = Enum.Material.Wood, Parent = f })
		part({ Name = "BattlePostFoot", Size = Vector3.new(3.4, 1.4, 3.4), Position = c + Vector3.new(x * 8, 2.3, 0), Color = Color3.fromRGB(60, 50, 40), Material = Enum.Material.Slate, Parent = f })
	end
	part({ Name = "BattleBeam", Size = Vector3.new(22, 1.8, 3), Position = c + Vector3.new(0, 20.2, 0), Color = GATE_RED, Material = Enum.Material.Wood, Parent = f })
	part({ Name = "BattleBeam2", Size = Vector3.new(18, 1, 2), Position = c + Vector3.new(0, 17.4, 0), Color = Color3.fromRGB(60, 40, 30), Material = Enum.Material.Wood, Parent = f })
	local veil = part({ Name = "BattleVeil", Size = Vector3.new(13.6, 15, 0.4), Position = c + Vector3.new(0, 9.4, 0), Color = Color3.fromRGB(255, 120, 80), Material = Enum.Material.Neon, Transparency = 0.55, CanCollide = false, Parent = f })
	local glow = Instance.new("PointLight")
	glow.Range = 22
	glow.Brightness = 1.6
	glow.Color = Color3.fromRGB(255, 130, 90)
	glow.Parent = veil
	out.battle = prompt(veil, "들어가기", "⚔ 배틀그라운드 (사람끼리 겨룬다)", "BattleGate")
	out.battle.MaxActivationDistance = 16
	local board = part({ Name = "BattleSign", Size = Vector3.new(16, 5, 1), Position = c + Vector3.new(0, 24.4, 0), Color = Color3.fromRGB(40, 25, 20), Material = Enum.Material.Wood, CanCollide = false, Parent = f })
	sign(board, Enum.NormalId.Front, { { "⚔ 배틀그라운드", Color3.fromRGB(255, 220, 140), 0.6 }, { "체력 200 · 모두 같은 힘", Color3.fromRGB(255, 255, 255), 0.4 } })
	sign(board, Enum.NormalId.Back, { { "⚔ 배틀그라운드", Color3.fromRGB(255, 220, 140), 0.6 }, { "체력 200 · 모두 같은 힘", Color3.fromRGB(255, 255, 255), 0.4 } })

	-- 강호 안내판: 일곱 사부가 어디 있는지 (양옆에 일곱 권법의 깃발)
	local boardAt = Vector3.new(0, 0, -110)
	for i, style in ipairs(Config.Styles) do
		local sx = i % 2 == 0 and 1 or -1
		banner(boardAt + Vector3.new(sx * (22 + math.floor((i - 1) / 2) * 5), 0, 0), 14, style.color, f)
	end
	for _, x in ipairs({ -1, 1 }) do
		part({ Name = "BoardPost", Size = Vector3.new(1.4, 16, 1.4), Position = boardAt + Vector3.new(x * 17, 8, 0), Color = WOOD, Material = Enum.Material.Wood, Parent = f })
	end
	part({ Name = "BoardRoof", Size = Vector3.new(40, 1, 5), Position = boardAt + Vector3.new(0, 16.5, 0), Color = ROOF, Material = Enum.Material.Slate, Parent = f })
	local mboard = part({ Name = "MasterBoard", Size = Vector3.new(32, 13, 0.6), Position = boardAt + Vector3.new(0, 9, 0), Color = Color3.fromRGB(35, 25, 18), Material = Enum.Material.Wood, CanCollide = false, Parent = f })
	-- 사부의 자리는 알려 주지 않는다. 떠도는 소문만
	local lines: { { any } } = { { "강호에 떠도는 소문", Color3.fromRGB(255, 215, 120), 0.16 } }
	for _, style in ipairs(Config.Styles) do
		local m = Config.MASTERS[style.id]
		if m then
			table.insert(lines, { "· " .. m.rumor, Color3.fromRGB(235, 225, 205), 0.11 })
		end
	end
	table.insert(lines, { "찾아낸 사부만 지도에 나온다", Color3.fromRGB(200, 190, 170), 0.1 })
	sign(mboard, Enum.NormalId.Front, lines)
	sign(mboard, Enum.NormalId.Back, lines)

	-- 상점 (객잔 앞 좌판)
	local stall = part({ Name = "Shop", Size = Vector3.new(14, 4, 7), Position = Vector3.new(-75, 2, 25), Color = Color3.fromRGB(130, 85, 50), Material = Enum.Material.Wood, Parent = f })
	part({ Name = "ShopRoof", Size = Vector3.new(17, 0.8, 10), CFrame = CFrame.new(-75, 10, 25) * CFrame.Angles(math.rad(-10), 0, 0), Color = Color3.fromRGB(200, 60, 50), Material = Enum.Material.Fabric, Parent = f })
	for _, x in ipairs({ -1, 1 }) do
		part({ Name = "ShopPole", Size = Vector3.new(0.6, 9, 0.6), Position = Vector3.new(-75 + x * 7.5, 5, 28.5), Color = WOOD, Material = Enum.Material.Wood, Parent = f })
	end
	local shopSign = part({ Name = "ShopSign", Size = Vector3.new(12, 3, 0.4), Position = Vector3.new(-75, 7, 21.2), Color = Color3.fromRGB(30, 20, 18), Material = Enum.Material.Wood, CanCollide = false, Parent = f })
	sign(shopSign, Enum.NormalId.Front, { { "🧪 만물상", Color3.fromRGB(255, 220, 140), 1 } })
	out.shop = prompt(stall, "물건 보기", "만물상", "Shop")
	-- 객잔: 쉬면 체력과 내공이 가득 찬다
	building(Config.INN_AT, 18, 14, math.rad(90), f, { tiers = 2, sign = "객잔", awningColor = Color3.fromRGB(150, 60, 40) })
	local innDesk = part({ Name = "InnDesk", Size = Vector3.new(3, 3.2, 6), Position = Config.INN_AT + Vector3.new(-11, 1.6, 0), Color = Color3.fromRGB(110, 75, 50), Material = Enum.Material.Wood, Parent = f })
	out.inn = prompt(innDesk, "쉬기", "객잔 · 체력·내공 채우기", "Inn")

	-- 천층탑 입구 (북서쪽 모퉁이): 층마다 좁아지는 칠층 탑, 문은 마을 가운데를 본다
	local tAt = Config.TOWER.enter
	local tcf = CFrame.lookAt(tAt, Vector3.new(0, 0, 0))
	part({ Name = "TowerPlinth", Size = Vector3.new(30, 2, 30), CFrame = tcf * CFrame.new(0, 1, 0), Color = STONE_DARK, Material = Enum.Material.Cobblestone, Parent = f })
	local y, w = 2, 22
	for i = 1, 7 do
		local h = i == 1 and 12 or 8
		part({ Name = "TowerStorey", Size = Vector3.new(w, h, w), CFrame = tcf * CFrame.new(0, y + h / 2, 0), Color = Color3.fromRGB(225, 215, 195), Material = Enum.Material.Plaster, Parent = f })
		for _, sx in ipairs({ -1, 1 }) do
			for _, sz in ipairs({ -1, 1 }) do
				part({ Name = "TowerPost", Size = Vector3.new(1.2, h, 1.2), CFrame = tcf * CFrame.new(sx * w / 2, y + h / 2, sz * w / 2), Color = GATE_RED, Material = Enum.Material.Wood, Parent = f })
			end
		end
		-- 층마다 빛나는 창과 내민 처마
		for k = 0, 3 do
			part({ Name = "TowerWindow", Size = Vector3.new(2.4, h * 0.45, 0.3), CFrame = tcf * CFrame.Angles(0, k * math.pi / 2, 0) * CFrame.new(0, y + h * 0.55, -w / 2 - 0.1), Color = Color3.fromRGB(255, 200, 120), Material = Enum.Material.Neon, CanCollide = false, Parent = f })
		end
		part({ Name = "TowerEave", Size = Vector3.new(w + 6, 1, w + 6), CFrame = tcf * CFrame.new(0, y + h + 0.5, 0), Color = ROOF, Material = Enum.Material.Slate, Parent = f })
		part({ Name = "TowerEaveTrim", Size = Vector3.new(w + 6.4, 0.4, w + 6.4), CFrame = tcf * CFrame.new(0, y + h, 0), Color = GOLD, Material = Enum.Material.Metal, CanCollide = false, Parent = f })
		y += h + 1
		w -= 2.4
	end
	disc("TowerFinial", tAt + Vector3.new(0, y + 4, 0), 0.6, 8, GOLD, Enum.Material.Metal, f)
	crystal(tAt + Vector3.new(0, y + 10, 0), 3, Color3.fromRGB(255, 190, 90), f)
	local tDoor = part({ Name = "TowerDoor", Size = Vector3.new(6, 9, 0.6), CFrame = tcf * CFrame.new(0, 6.5, -11.2), Color = Color3.fromRGB(60, 35, 25), Material = Enum.Material.WoodPlanks, Parent = f })
	local tBoard = part({ Name = "TowerSign", Size = Vector3.new(12, 3, 0.4), CFrame = tcf * CFrame.new(0, 12.5, -11.5), Color = Color3.fromRGB(40, 25, 20), Material = Enum.Material.Wood, CanCollide = false, Parent = f })
	sign(tBoard, Enum.NormalId.Front, { { "🗼 천층탑", GOLD, 1 } })
	for _, sx in ipairs({ -1, 1 }) do
		brazier((tcf * CFrame.new(sx * 6, 2, -15)).Position, 1, f)
	end
	out.tower = prompt(tDoor, "탑에 오르기", "천층탑", "TowerEnter")

	-- 강호 순위표 (북동쪽 모퉁이): 세 개의 큰 판
	local bAt = Vector3.new(185, 0, -185)
	local toC = Vector3.new(-bAt.X, 0, -bAt.Z).Unit
	local side = Vector3.new(-toC.Z, 0, toC.X)
	part({ Name = "BoardPlinth", Size = Vector3.new(50, 1.2, 12), CFrame = CFrame.lookAt(bAt, bAt + toC) * CFrame.new(0, 0.6, 0), Color = STONE_DARK, Material = Enum.Material.Cobblestone, Parent = f })
	out.boards = {}
	for i, b in ipairs({ { "realm", "🏯 강호 고수", "총 능력치" }, { "pvp", "⚔ 배틀 처치", "배틀그라운드에서 쓰러뜨린 수" }, { "tower", "🗼 천층탑", "오른 가장 높은 층" } }) do
		local at = bAt + side * ((i - 2) * 16) + Vector3.new(0, 11, 0)
		local cf = CFrame.lookAt(at, at + toC)
		for _, sx in ipairs({ -1, 1 }) do
			part({ Name = "BoardPost", Size = Vector3.new(1.2, 21, 1.2), CFrame = cf * CFrame.new(sx * 7.2, -0.5, 0.4), Color = GATE_RED, Material = Enum.Material.Wood, Parent = f })
		end
		part({ Name = "BoardRoof", Size = Vector3.new(17, 0.8, 3.4), CFrame = cf * CFrame.new(0, 10.3, 0.4), Color = ROOF, Material = Enum.Material.Slate, Parent = f })
		local lboard = part({ Name = "Leaderboard", Size = Vector3.new(14, 18, 0.6), CFrame = cf, Color = Color3.fromRGB(30, 22, 18), Material = Enum.Material.Wood, Parent = f })
		local gui = Instance.new("SurfaceGui")
		gui.Name = "Board"
		gui.Face = Enum.NormalId.Front
		gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
		gui.PixelsPerStud = 30
		gui.LightInfluence = 0.2
		gui.Parent = lboard
		local list = Instance.new("UIListLayout")
		list.SortOrder = Enum.SortOrder.LayoutOrder
		list.Parent = gui
		local function row(name: string, text: string, h: number, color: Color3, order: number)
			local l = Instance.new("TextLabel")
			l.Name = name
			l.LayoutOrder = order
			l.BackgroundTransparency = 1
			l.Size = UDim2.fromScale(1, h)
			l.Font = Enum.Font.GothamBold
			l.TextScaled = true
			l.TextColor3 = color
			l.TextStrokeTransparency = 0.5
			l.Text = text
			l.Parent = gui
		end
		row("Title", b[2], 0.1, GOLD, 0)
		row("Sub", b[3], 0.05, Color3.fromRGB(200, 190, 170), 1)
		for r = 1, 10 do
			row("Row" .. r, "", 0.085, r == 1 and Color3.fromRGB(255, 215, 90) or r <= 3 and Color3.fromRGB(230, 230, 240) or Color3.fromRGB(210, 200, 185), 1 + r)
		end
		out.boards[b[1]] = gui
	end
end

------------------------------------------------------------------------
-- 수련 자리
------------------------------------------------------------------------
local function trainingSpots(out: any)
	local f = Instance.new("Folder")
	f.Name = "Training"
	f.Parent = folder
	out.train = {}
	for i, spot in ipairs(Config.TrainingSpots) do
		local at = spot.at
		local target: BasePart
		if spot.kind == "rock" then
			rock(at + Vector3.new(4, 0, 4), 9, f)
			target = part({ Name = "LiftRock", Shape = Enum.PartType.Ball, Size = Vector3.new(4.5, 4.5, 4.5), Position = at + Vector3.new(0, 2.2, 0), Color = Color3.fromRGB(130, 125, 115), Material = Enum.Material.Slate, Parent = f })
		elseif spot.kind == "dummy" then
			target = part({ Name = "Mook", Shape = Enum.PartType.Cylinder, Size = Vector3.new(7, 2.4, 2.4), CFrame = CFrame.new(at + Vector3.new(0, 3.5, 0)) * CFrame.Angles(0, 0, math.rad(90)), Color = Color3.fromRGB(140, 95, 55), Material = Enum.Material.Wood, Parent = f })
			for k, h in ipairs({ 5.2, 4.6, 3.0 }) do
				part({ Name = "MookArm", Size = Vector3.new(0.5, 0.5, 3), CFrame = CFrame.new(at + Vector3.new((k - 2) * 0.6, h, -1.6)) * CFrame.Angles(math.rad(k == 3 and -20 or 10), math.rad((k - 2) * 25), 0), Color = Color3.fromRGB(120, 80, 45), Material = Enum.Material.Wood, Parent = f })
			end
			part({ Name = "MookBase", Size = Vector3.new(5, 1, 5), Position = at + Vector3.new(0, 0.5, 0), Color = Color3.fromRGB(90, 60, 40), Material = Enum.Material.Wood, Parent = f })
		elseif spot.kind == "mabo" then
			-- 마보 참장: 세 개의 말뚝 위에서 버틴다
			part({ Name = "MaboBase", Size = Vector3.new(8, 0.8, 8), Position = at + Vector3.new(0, 0.4, 0), Color = Color3.fromRGB(110, 85, 60), Material = Enum.Material.WoodPlanks, Parent = f })
			for k = -1, 1 do
				part({ Name = "MaboPost", Shape = Enum.PartType.Cylinder, Size = Vector3.new(2.6, 1.2, 1.2), CFrame = CFrame.new(at + Vector3.new(k * 2.4, 2.1, 0)) * CFrame.Angles(0, 0, math.rad(90)), Color = Color3.fromRGB(130, 95, 60), Material = Enum.Material.Wood, Parent = f })
			end
			target = part({ Name = "MaboStake", Size = Vector3.new(1.2, 3.4, 1.2), Position = at + Vector3.new(0, 1.7, 2.6), Color = Color3.fromRGB(150, 110, 70), Material = Enum.Material.Wood, Parent = f })
		elseif spot.kind == "ironpalm" then
			-- 철사장: 화로 위의 달군 쇠모래 솥
			part({ Name = "CauldronStand", Size = Vector3.new(4.5, 2.4, 4.5), Position = at + Vector3.new(0, 1.2, 0), Color = Color3.fromRGB(70, 65, 65), Material = Enum.Material.Slate, Parent = f })
			target = part({ Name = "IronCauldron", Shape = Enum.PartType.Cylinder, Size = Vector3.new(2.2, 5, 5), CFrame = CFrame.new(at + Vector3.new(0, 3.5, 0)) * CFrame.Angles(0, 0, math.rad(90)), Color = Color3.fromRGB(55, 50, 50), Material = Enum.Material.Metal, Parent = f })
			local sand = part({ Name = "HotSand", Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.3, 4.2, 4.2), CFrame = CFrame.new(at + Vector3.new(0, 4.6, 0)) * CFrame.Angles(0, 0, math.rad(90)), Color = Color3.fromRGB(255, 120, 40), Material = Enum.Material.Neon, CanCollide = false, Parent = f })
			light(sand, Color3.fromRGB(255, 130, 60), 14, 1.6)
			local smoke = Instance.new("Smoke")
			smoke.Color = Color3.fromRGB(120, 110, 100)
			smoke.Opacity = 0.08
			smoke.RiseVelocity = 3
			smoke.Size = 1.5
			smoke.Parent = sand
		elseif spot.kind == "breathing" then
			-- 운기조식: 하늘 고리 아래의 방석, 둘레에 작은 수정
			target = part({ Name = "MeditationCushion", Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.8, 4, 4), CFrame = CFrame.new(at + Vector3.new(0, 0.6, 0)) * CFrame.Angles(0, 0, math.rad(90)), Color = Color3.fromRGB(120, 60, 140), Material = Enum.Material.Fabric, Parent = f })
			for k = 0, 2 do
				local a = k / 3 * math.pi * 2
				crystal(at + Vector3.new(math.cos(a) * 3.5, 2.2, math.sin(a) * 3.5), 0.9, Color3.fromRGB(150, 230, 255), f)
			end
		elseif spot.kind == "simma" then
			-- 심마 대련: 옛 투기장 한가운데의 검은 제단
			target = part({ Name = "SimmaAltar", Shape = Enum.PartType.Cylinder, Size = Vector3.new(1.4, 9, 9), CFrame = CFrame.new(at + Vector3.new(0, 0.7, 0)) * CFrame.Angles(0, 0, math.rad(90)), Color = Color3.fromRGB(30, 20, 35), Material = Enum.Material.Slate, Parent = f })
			for k = 0, 3 do
				local a = k / 4 * math.pi * 2 + math.rad(45)
				local p = at + Vector3.new(math.cos(a) * 5.5, 0, math.sin(a) * 5.5)
				part({ Name = "SimmaPillar", Size = Vector3.new(1, 7, 1), Position = p + Vector3.new(0, 3.5, 0), Color = Color3.fromRGB(40, 30, 45), Material = Enum.Material.Slate, Parent = f })
				crystal(p + Vector3.new(0, 8.5, 0), 1.2, Color3.fromRGB(190, 70, 255), f)
			end
			local eye = part({ Name = "SimmaEye", Shape = Enum.PartType.Ball, Size = Vector3.new(2, 2, 2), Position = at + Vector3.new(0, 6, 0), Color = Color3.fromRGB(200, 60, 255), Material = Enum.Material.Neon, CanCollide = false, Parent = f })
			light(eye, Color3.fromRGB(200, 60, 255), 24, 2)
		elseif spot.kind == "geumjong" then
			-- 금종조: 나무 틀에 매단 큰 청동 종
			for _, x in ipairs({ -1, 1 }) do
				part({ Name = "BellFramePost", Size = Vector3.new(1, 11, 1), Position = at + Vector3.new(x * 4.2, 5.5, 0), Color = GATE_RED, Material = Enum.Material.Wood, Parent = f })
			end
			part({ Name = "BellFrameBeam", Size = Vector3.new(10, 1, 1.2), Position = at + Vector3.new(0, 11.2, 0), Color = GATE_RED, Material = Enum.Material.Wood, Parent = f })
			target = part({ Name = "BronzeBell", Shape = Enum.PartType.Cylinder, Size = Vector3.new(4.5, 4.6, 4.6), CFrame = CFrame.new(at + Vector3.new(0, 8.2, 0)) * CFrame.Angles(0, 0, math.rad(90)), Color = Color3.fromRGB(160, 120, 60), Material = Enum.Material.Metal, Parent = f })
			disc("BellLip", at + Vector3.new(0, 5.9, 0), 2.7, 0.4, Color3.fromRGB(190, 150, 80), Enum.Material.Metal, f)
			part({ Name = "BellTop", Shape = Enum.PartType.Ball, Size = Vector3.new(3.4, 3.4, 3.4), Position = at + Vector3.new(0, 10.2, 0), Color = Color3.fromRGB(150, 110, 55), Material = Enum.Material.Metal, Parent = f })
			disc("BellMat", at + Vector3.new(0, 0.2, 0), 3.5, 0.4, Color3.fromRGB(120, 60, 50), Enum.Material.Fabric, f)
		elseif spot.kind == "cheongeun" then
			-- 천근추: 돌 받침 위의 거대한 쇳덩이와 손잡이
			part({ Name = "WeightBase", Size = Vector3.new(7, 0.8, 7), Position = at + Vector3.new(0, 0.4, 0), Color = STONE_DARK, Material = Enum.Material.Granite, Parent = f })
			target = part({ Name = "IronWeight", Shape = Enum.PartType.Cylinder, Size = Vector3.new(3.4, 5, 5), CFrame = CFrame.new(at + Vector3.new(0, 2.5, 0)) * CFrame.Angles(0, 0, math.rad(90)), Color = Color3.fromRGB(45, 45, 50), Material = Enum.Material.Metal, Parent = f })
			part({ Name = "WeightHandle", Size = Vector3.new(3.6, 0.6, 0.6), Position = at + Vector3.new(0, 5.2, 0), Color = Color3.fromRGB(80, 80, 90), Material = Enum.Material.Metal, Parent = f })
			for _, x in ipairs({ -1, 1 }) do
				part({ Name = "WeightHandlePost", Size = Vector3.new(0.6, 1.2, 0.6), Position = at + Vector3.new(x * 1.5, 4.6, 0), Color = Color3.fromRGB(80, 80, 90), Material = Enum.Material.Metal, Parent = f })
			end
			sign(part({ Name = "WeightMark", Size = Vector3.new(2.4, 1.2, 0.1), Position = at + Vector3.new(0, 2.5, -2.55), Color = Color3.fromRGB(45, 45, 50), Material = Enum.Material.Metal, CanCollide = false, Parent = f }), Enum.NormalId.Front, { { "千斤", GOLD, 1 } })
		elseif spot.kind == "jucheon" then
			-- 주천 운기: 태극 진 위의 방석, 머리 위에 도는 금빛 고리
			disc("TaegeukDisc", at + Vector3.new(0, 0.15, 0), 5, 0.3, Color3.fromRGB(240, 235, 225), Enum.Material.Marble, f)
			disc("TaegeukInner", at + Vector3.new(0, 0.2, 0), 4.2, 0.3, Color3.fromRGB(40, 35, 40), Enum.Material.Marble, f)
			target = part({ Name = "MeditationCushion", Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.8, 4, 4), CFrame = CFrame.new(at + Vector3.new(0, 0.7, 0)) * CFrame.Angles(0, 0, math.rad(90)), Color = Color3.fromRGB(200, 160, 60), Material = Enum.Material.Fabric, Parent = f })
			local ring = disc("ChiRing", at + Vector3.new(0, 8, 0), 3.4, 0.25, GOLD, Enum.Material.Neon, f, false)
			ring.Transparency = 0.3
			light(ring, GOLD, 16, 1.2)
		elseif spot.kind == "heogong" then
			-- 허공답보: 바닥에 둥근 받침, 그 위로 차례로 떠오르는 디딤돌 셋
			target = part({ Name = "StepBase", Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.8, 6, 6), CFrame = CFrame.new(at + Vector3.new(0, 0.4, 0)) * CFrame.Angles(0, 0, math.rad(90)), Color = STONE, Material = Enum.Material.Marble, Parent = f })
			for k = 1, 3 do
				local st = disc("FloatingStep", at + Vector3.new(math.cos(k * 2.1) * 3, 2 + k * 2.2, math.sin(k * 2.1) * 3), 1.4, 0.5, Color3.fromRGB(190, 200, 210), Enum.Material.Marble, f, false)
				local glow = disc("FloatingStepGlow", st.Position - Vector3.new(0, 0.3, 0), 1.5, 0.1, Color3.fromRGB(150, 220, 255), Enum.Material.Neon, f, false)
				glow.Transparency = 0.4
			end
		elseif spot.kind == "cheonsang" then
			-- 천상 수련: 구름 연꽃 받침과 떠 있는 수정
			for k = 0, 7 do
				local a = k / 8 * math.pi * 2
				part({ Name = "LotusPetal", Size = Vector3.new(2.2, 0.4, 3.4), CFrame = CFrame.new(at + Vector3.new(math.cos(a) * 3, 0.5, math.sin(a) * 3)) * CFrame.Angles(0, -a + math.pi / 2, math.rad(-20)), Color = Color3.fromRGB(255, 235, 245), Material = Enum.Material.SmoothPlastic, Parent = f })
			end
			target = part({ Name = "LotusSeat", Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.8, 4, 4), CFrame = CFrame.new(at + Vector3.new(0, 0.7, 0)) * CFrame.Angles(0, 0, math.rad(90)), Color = Color3.fromRGB(250, 250, 255), Material = Enum.Material.SmoothPlastic, Parent = f })
			crystal(at + Vector3.new(0, 9, 0), 1.8, Color3.fromRGB(150, 220, 255), f)
		elseif spot.kind == "waterfall" then
			target = part({ Name = "MeditationStone", Size = Vector3.new(8, 1.2, 8), Position = at + Vector3.new(0, 0.6, 0), Color = Color3.fromRGB(110, 120, 120), Material = Enum.Material.Slate, Parent = f })
		else
			target = part({ Name = "BambooPost", Size = Vector3.new(3, 8, 3), Position = at + Vector3.new(0, 4, 0), Color = Color3.fromRGB(150, 180, 80), Material = Enum.Material.Wood, Parent = f })
			local s = part({ Name = "BambooSign", Size = Vector3.new(10, 3, 0.4), Position = at + Vector3.new(0, 10, 0), Color = Color3.fromRGB(30, 25, 18), Material = Enum.Material.Wood, CanCollide = false, Parent = f })
			sign(s, Enum.NormalId.Front, { { "🎋 경공 수련", Color3.fromRGB(200, 255, 160), 1 } })
		end
		local info = Config.Training[spot.kind]
		-- 강화 수련: 같은 자리, Y키. 빠르고 까다롭지만 세 배 (싸우는 수련엔 없다)
		local hard: ProximityPrompt? = nil
		if not info.fight then
			hard = prompt(target, "강화 수련 (이류부터)", "🔥 " .. info.name, "TrainHard")
			;(hard :: ProximityPrompt).KeyboardKeyCode = Enum.KeyCode.Y
			;(hard :: ProximityPrompt).UIOffset = Vector2.new(0, 70)
		end
		local action = info.fight and "심마 불러내기" or "수련하기"
		local need = info.realm and info.realm > 1 and (" (" .. Config.Realms[info.realm].name .. "부터)") or ""
		table.insert(out.train, { prompt = prompt(target, action .. need, info.icon .. " " .. info.name, "Train"), hard = hard, kind = spot.kind, index = i, pos = at })
	end
	-- (경공 수련 고리는 없앴다)
	out.rings = {}
	-- 상급 수련장: 둘레의 깃발과 석등, 들어오는 문의 현판
	local dojo = Vector3.new(330, 0, -330)
	for k = 0, 7 do
		local a = k / 8 * math.pi * 2 + math.pi / 8
		banner(dojo + Vector3.new(math.cos(a) * 80, 0, math.sin(a) * 80), 14, k % 2 == 0 and Color3.fromRGB(170, 40, 35) or Color3.fromRGB(40, 70, 140), f)
		stoneLantern(dojo + Vector3.new(math.cos(a + 0.2) * 72, 0, math.sin(a + 0.2) * 72), f, true)
	end
	local toVillage = Vector3.new(-dojo.X, 0, -dojo.Z).Unit
	local gateAt = dojo + toVillage * 82
	local gcf = CFrame.lookAt(gateAt, gateAt + toVillage)
	for _, x in ipairs({ -1, 1 }) do
		part({ Name = "DojoGatePost", Size = Vector3.new(1.6, 14, 1.6), CFrame = gcf * CFrame.new(x * 8, 7, 0), Color = GATE_RED, Material = Enum.Material.Wood, Parent = f })
	end
	part({ Name = "DojoGateBeam", Size = Vector3.new(20, 1.4, 2), CFrame = gcf * CFrame.new(0, 14.5, 0), Color = GATE_RED, Material = Enum.Material.Wood, Parent = f })
	part({ Name = "DojoGateRoof", Size = Vector3.new(23, 1, 4), CFrame = gcf * CFrame.new(0, 15.7, 0), Color = ROOF, Material = Enum.Material.Slate, Parent = f })
	local plaque = part({ Name = "DojoPlaque", Size = Vector3.new(12, 3, 0.4), CFrame = gcf * CFrame.new(0, 12, -0.4), Color = Color3.fromRGB(30, 22, 18), Material = Enum.Material.Wood, CanCollide = false, Parent = f })
	sign(plaque, Enum.NormalId.Front, { { "🏯 상급 수련장", GOLD, 1 } })
	sign(plaque, Enum.NormalId.Back, { { "🏯 상급 수련장", GOLD, 1 } })
end

------------------------------------------------------------------------
-- 대나무 숲, 흑호채, 폭포 계곡
------------------------------------------------------------------------
local function regions()
	-- 대나무 숲
	local bf = Instance.new("Folder")
	bf.Name = "Bamboo"
	bf.Parent = folder
	local B = Config.Regions[2]
	for _ = 1, 140 do
		local x = B.center.X + rng:NextNumber(-B.size.X / 2 + 10, B.size.X / 2 - 10)
		local z = B.center.Z + rng:NextNumber(-B.size.Z / 2 + 10, B.size.Z / 2 - 10)
		-- 길은 비워 둔다
		if math.abs(z) > 14 and not nearRoad(Vector3.new(x, 0, z), 14) then
			bamboo(Vector3.new(x, 0, z), bf)
		end
	end
	-- 흑호채: 나무 울타리, 망루, 천막
	local ff = Instance.new("Folder")
	ff.Name = "Fort"
	ff.Parent = folder
	local F = Config.Regions[3]
	local fx, fz = F.center.X, F.center.Z
	local fw, fd = 300, 340
	for _, side in ipairs({ { 1, 0 }, { -1, 0 }, { 0, -1 }, { 0, 1 } }) do
		local count = 30
		for k = 0, count - 1 do
			local along = -0.5 + (k + 0.5) / count
			local gateGap = side[2] == 1 and math.abs(along) < 0.08
			if not gateGap then
				local pos = side[1] ~= 0 and Vector3.new(fx + side[1] * fw / 2, 0, fz + along * fd) or Vector3.new(fx + along * fw, 0, fz + side[2] * fd / 2)
				local h = rng:NextNumber(11, 14)
				part({ Name = "Palisade", Size = Vector3.new(1.6, h, 1.6), CFrame = CFrame.new(pos + Vector3.new(0, h / 2, 0)) * CFrame.Angles(0, rng:NextNumber(0, 3), 0), Color = Color3.fromRGB(100, 70, 45), Material = Enum.Material.Wood, Parent = ff })
				if side[1] ~= 0 then
					part({ Name = "PalisadeFill", Size = Vector3.new(1.2, 10, fd / count + 0.4), Position = pos + Vector3.new(0, 5, 0), Color = Color3.fromRGB(90, 62, 40), Material = Enum.Material.Wood, Parent = ff })
				else
					part({ Name = "PalisadeFill", Size = Vector3.new(fw / count + 0.4, 10, 1.2), Position = pos + Vector3.new(0, 5, 0), Color = Color3.fromRGB(90, 62, 40), Material = Enum.Material.Wood, Parent = ff })
				end
			end
		end
	end
	for _, c in ipairs({ { -1, 1 }, { 1, 1 }, { -1, -1 }, { 1, -1 } }) do
		local pos = Vector3.new(fx + c[1] * (fw / 2 - 6), 0, fz + c[2] * (fd / 2 - 6))
		for _, dx in ipairs({ -1, 1 }) do
			for _, dz in ipairs({ -1, 1 }) do
				part({ Name = "TowerLeg", Size = Vector3.new(1, 22, 1), Position = pos + Vector3.new(dx * 3, 11, dz * 3), Color = Color3.fromRGB(90, 62, 40), Material = Enum.Material.Wood, Parent = ff })
			end
		end
		part({ Name = "TowerDeck", Size = Vector3.new(9, 1, 9), Position = pos + Vector3.new(0, 22, 0), Color = Color3.fromRGB(110, 75, 50), Material = Enum.Material.WoodPlanks, Parent = ff })
		part({ Name = "TowerRoof", Size = Vector3.new(11, 1, 11), CFrame = CFrame.new(pos + Vector3.new(0, 28, 0)) * CFrame.Angles(0, math.rad(45), 0), Color = Color3.fromRGB(60, 45, 35), Material = Enum.Material.Wood, Parent = ff })
	end
	for _ = 1, 10 do
		local pos = Vector3.new(fx + rng:NextNumber(-110, 110), 0, fz + rng:NextNumber(-60, 140))
		part({ Name = "Tent", Size = Vector3.new(12, 8, 10), CFrame = CFrame.new(pos + Vector3.new(0, 3, 0)) * CFrame.Angles(0, rng:NextNumber(0, 3), math.rad(45)), Color = Color3.fromRGB(150, 130, 100), Material = Enum.Material.Fabric, Parent = ff })
	end
	-- 두목의 단 (깃발과 화톳불)
	local bossAt = Config.Regions[3].boss.at
	part({ Name = "BossFloor", Shape = Enum.PartType.Cylinder, Size = Vector3.new(1, 70, 70), CFrame = CFrame.new(bossAt + Vector3.new(0, 0.3, 0)) * CFrame.Angles(0, 0, math.rad(90)), Color = Color3.fromRGB(80, 60, 50), Material = Enum.Material.Cobblestone, Parent = ff })
	for k = 0, 5 do
		local a = k / 6 * math.pi * 2
		local p = bossAt + Vector3.new(math.cos(a) * 33, 0, math.sin(a) * 33)
		part({ Name = "BrazierPole", Size = Vector3.new(1, 6, 1), Position = p + Vector3.new(0, 3, 0), Color = Color3.fromRGB(60, 50, 45), Material = Enum.Material.Metal, Parent = ff })
		local fire = part({ Name = "Brazier", Shape = Enum.PartType.Ball, Size = Vector3.new(2.4, 2.4, 2.4), Position = p + Vector3.new(0, 6.8, 0), Color = Color3.fromRGB(255, 140, 50), Material = Enum.Material.Neon, CanCollide = false, Parent = ff })
		local flame = Instance.new("Fire")
		flame.Size = 6
		flame.Heat = 8
		flame.Parent = fire
	end
	local banner = part({ Name = "FortBanner", Size = Vector3.new(16, 22, 0.4), Position = bossAt + Vector3.new(0, 18, -38), Color = Color3.fromRGB(30, 25, 25), Material = Enum.Material.Fabric, CanCollide = false, Parent = ff })
	sign(banner, Enum.NormalId.Front, { { "흑호", Color3.fromRGB(230, 60, 40), 0.7 }, { "흑호채", Color3.fromRGB(255, 220, 160), 0.3 } })
	sign(banner, Enum.NormalId.Back, { { "흑호", Color3.fromRGB(230, 60, 40), 0.7 }, { "흑호채", Color3.fromRGB(255, 220, 160), 0.3 } })

	-- 비류 폭포 계곡: 동쪽 절벽, 폭포, 연못, 나무와 바위
	local vf = Instance.new("Folder")
	vf.Name = "Valley"
	vf.Parent = folder
	local V = Config.Regions[4]
	local cliffX = V.center.X + V.size.X / 2 - 15
	for k = -5, 5 do
		local h = rng:NextNumber(90, 140)
		part({ Name = "Cliff", Size = Vector3.new(40, h, 46), CFrame = CFrame.new(cliffX + rng:NextNumber(-6, 6), h / 2 - 5, k * 40) * CFrame.Angles(0, rng:NextNumber(-0.15, 0.15), 0), Color = Color3.fromRGB(105, 100, 95), Material = Enum.Material.Rock, Parent = vf })
	end
	local fallX = cliffX - 22
	local fall = part({ Name = "Waterfall", Size = Vector3.new(3, 110, 30), Position = Vector3.new(fallX, 55, 0), Color = Color3.fromRGB(170, 220, 255), Material = Enum.Material.Glass, Transparency = 0.35, CanCollide = false, Parent = vf })
	local mist = Instance.new("ParticleEmitter")
	mist.Rate = 40
	mist.Lifetime = NumberRange.new(1.5, 3)
	mist.Speed = NumberRange.new(-30, -50)
	mist.SpreadAngle = Vector2.new(10, 10)
	mist.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 2), NumberSequenceKeypoint.new(1, 6) })
	mist.Transparency = NumberSequence.new(0.6, 1)
	mist.Color = ColorSequence.new(Color3.fromRGB(230, 245, 255))
	mist.EmissionDirection = Enum.NormalId.Bottom
	mist.Parent = fall
	part({ Name = "Pond", Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.6, 90, 90), CFrame = CFrame.new(fallX - 35, 0.15, 0) * CFrame.Angles(0, 0, math.rad(90)), Color = Color3.fromRGB(70, 140, 180), Material = Enum.Material.Glass, Transparency = 0.25, CanCollide = false, Parent = vf })
	for _ = 1, 26 do
		local x = V.center.X + rng:NextNumber(-V.size.X / 2 + 20, V.size.X / 2 - 70)
		local z = V.center.Z + rng:NextNumber(-V.size.Z / 2 + 20, V.size.Z / 2 - 20)
		if math.abs(z) > 30 and not nearRoad(Vector3.new(x, 0, z), 16) then
			tree(Vector3.new(x, 0, z), rng:NextNumber(1, 1.6), vf)
		end
	end
	for _ = 1, 30 do
		local at = Vector3.new(V.center.X + rng:NextNumber(-200, 160), 0, V.center.Z + rng:NextNumber(-200, 200))
		if not nearRoad(at, 16) then
			rock(at, rng:NextNumber(3, 9), vf)
		end
	end
	-- (들판의 나무는 흩뿌리지 않는다: 길가의 가로수와 몇 군데의 작은 숲으로 - roadside)
end

------------------------------------------------------------------------
-- 일곱 사부의 자리
------------------------------------------------------------------------

local function cyl(name: string, at: Vector3, radius: number, height: number, color: Color3, material: Enum.Material, parent: Instance, collide: boolean?): Part
	return part({ Name = name, Shape = Enum.PartType.Cylinder, Size = Vector3.new(height, radius * 2, radius * 2), CFrame = CFrame.new(at) * CFrame.Angles(0, 0, math.rad(90)), Color = color, Material = material, CanCollide = collide ~= false, Parent = parent })
end

local function emitter(target: BasePart, color: Color3, rate: number, size: number, speed: number, life: number)
	local e = Instance.new("ParticleEmitter")
	e.Rate = rate
	e.Color = ColorSequence.new(color)
	e.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, size), NumberSequenceKeypoint.new(1, 0) })
	e.Transparency = NumberSequence.new(0.2, 1)
	e.Speed = NumberRange.new(speed * 0.5, speed)
	e.Lifetime = NumberRange.new(life * 0.6, life)
	e.SpreadAngle = Vector2.new(180, 180)
	e.LightEmission = 0.6
	e.Parent = target
end

local SITES: { [string]: (r: any, at: Vector3, color: Color3, f: Instance) -> () } = {}

-- 태허호: 맑은 호수 한가운데 정자, 다리로 건너간다
function SITES.taeheo(r: any, at: Vector3, color: Color3, f: Instance)
	local c = r.center
	cyl("Lake", c + Vector3.new(0, 0.3, 0), 75, 0.6, Color3.fromRGB(80, 150, 200), Enum.Material.Glass, f, false).Transparency = 0.3
	cyl("Island", c + Vector3.new(0, at.Y / 2, 0), 15, at.Y, Color3.fromRGB(150, 140, 120), Enum.Material.Cobblestone, f)
	pavilion(c + Vector3.new(0, at.Y, 0), 10, 8, 11, Color3.fromRGB(70, 110, 150), f, color)
	-- 다리 (길이 오는 쪽으로)
	local dir = Vector3.new(1, 0, -1).Unit
	local from = c + dir * 13
	local to = c + dir * 82
	local mid = (from + to) / 2 + Vector3.new(0, at.Y - 0.4, 0)
	part({ Name = "Bridge", Size = Vector3.new(6, 0.8, (to - from).Magnitude), CFrame = CFrame.lookAt(mid, mid + dir), Color = Color3.fromRGB(130, 90, 55), Material = Enum.Material.WoodPlanks, Parent = f })
	for _, side in ipairs({ -1, 1 }) do
		local off = Vector3.new(-dir.Z, 0, dir.X) * side * 2.8
		part({ Name = "BridgeRail", Size = Vector3.new(0.4, 0.4, (to - from).Magnitude), CFrame = CFrame.lookAt(mid + off + Vector3.new(0, 2.2, 0), mid + off + Vector3.new(0, 2.2, 0) + dir), Color = GOLD, Material = Enum.Material.Metal, CanCollide = false, Parent = f })
	end
	for _ = 1, 18 do
		local a, d = rng:NextNumber(0, math.pi * 2), rng:NextNumber(22, 70)
		cyl("LilyPad", c + Vector3.new(math.cos(a) * d, 0.62, math.sin(a) * d), rng:NextNumber(1, 2), 0.1, Color3.fromRGB(80, 150, 70), Enum.Material.Grass, f, false)
	end
	for _ = 1, 14 do
		local a = rng:NextNumber(0, math.pi * 2)
		local p = c + Vector3.new(math.cos(a), 0, math.sin(a)) * rng:NextNumber(90, 135)
		if not nearRoad(p, 16) then
			tree(p, rng:NextNumber(1.1, 1.6), f)
		end
	end
end

-- 금강사: 돌 기단 위의 절, 큰 종과 향로
-- 염화단: 검은 현무암 단 위의 꺼지지 않는 불. 용암 고랑이 둘레를 돌고, 흑요석 기둥마다 불꽃
function SITES.yeolhwa(r: any, at: Vector3, color: Color3, f: Instance)
	local d = Vector3.new(at.X, 0, at.Z)
	local LAVA = Color3.fromRGB(255, 110, 30)
	cyl("FireDais", d + Vector3.new(0, at.Y / 2, 0), 18, at.Y, Color3.fromRGB(50, 40, 40), Enum.Material.Basalt, f)
	cyl("FireDaisRim", d + Vector3.new(0, at.Y + 0.05, 0), 16, 0.1, LAVA, Enum.Material.Neon, f, false).Transparency = 0.4
	-- 둘레의 용암 고랑 (둥근 띠)
	for k = 0, 31 do
		local a = k / 32 * math.pi * 2
		local p = d + Vector3.new(math.cos(a) * 30, 0.25, math.sin(a) * 30)
		part({ Name = "LavaMoat", Size = Vector3.new(3.4, 0.4, 6.4), CFrame = CFrame.lookAt(p, d + Vector3.new(0, 0.25, 0)) * CFrame.Angles(0, math.rad(90), 0), Color = LAVA, Material = Enum.Material.Neon, CanCollide = false, Parent = f })
	end
	-- 흑요석 기둥 여섯과 꼭대기 불꽃
	for k = 0, 5 do
		local a = k / 6 * math.pi * 2
		local p = d + Vector3.new(math.cos(a) * 22, 0, math.sin(a) * 22)
		part({ Name = "ObsidianPillar", Size = Vector3.new(3, 16, 3), CFrame = CFrame.new(p + Vector3.new(0, 8, 0)) * CFrame.Angles(0, a, 0), Color = Color3.fromRGB(25, 20, 28), Material = Enum.Material.Glass, Parent = f })
		local bowl = cyl("PillarFire", p + Vector3.new(0, 16.6, 0), 1.8, 1, Color3.fromRGB(60, 50, 50), Enum.Material.Basalt, f)
		local fire = Instance.new("Fire")
		fire.Size = 7
		fire.Heat = 10
		fire.Color = LAVA
		fire.SecondaryColor = Color3.fromRGB(255, 220, 120)
		fire.Parent = bowl
		light(bowl, LAVA, 22, 2)
	end
	-- 가운데 뒤편의 큰 불 (꺼지지 않는 불)
	local core = part({ Name = "EternalFlame", Shape = Enum.PartType.Ball, Size = Vector3.new(5, 5, 5), Position = d + Vector3.new(0, at.Y + 9, -10), Color = LAVA, Material = Enum.Material.Neon, Transparency = 0.2, CanCollide = false, Parent = f })
	local big = Instance.new("Fire")
	big.Size = 14
	big.Heat = 14
	big.Color = LAVA
	big.SecondaryColor = Color3.fromRGB(255, 230, 140)
	big.Parent = core
	light(core, LAVA, 50, 3)
	emitter(core, Color3.fromRGB(255, 160, 70), 16, 1.2, 6, 2)
	-- 검은 바위와 붉은 수정
	for k = 0, 11 do
		local a = k * 2.3
		local p = d + Vector3.new(math.cos(a) * (40 + (k % 4) * 12), 0, math.sin(a) * (40 + (k % 4) * 12))
		rock(p, 4 + (k % 3) * 2, f, Color3.fromRGB(45, 38, 38))
		if k % 3 == 0 then
			crystal(p + Vector3.new(0, 4, 0), 1.4, LAVA, f)
		end
	end
end

-- 창해각: 바닷가 사당. 둥근 조수 웅덩이, 파도 무늬 기둥 여덟, 푸른 석등, 산호 바위와 조개
function SITES.changhae(r: any, at: Vector3, color: Color3, f: Instance)
	local c = r.center
	local SEA = Color3.fromRGB(50, 130, 200)
	local pool = c + Vector3.new(-70, 0, 0)
	cyl("TidePool", pool + Vector3.new(0, 0.35, 0), 42, 0.5, SEA, Enum.Material.Glass, f, false).Transparency = 0.25
	cyl("TidePoolBed", pool + Vector3.new(0, 0.1, 0), 42, 0.3, Color3.fromRGB(30, 60, 90), Enum.Material.Slate, f, false)
	for k = 0, 23 do
		local a = k / 24 * math.pi * 2
		local p = pool + Vector3.new(math.cos(a) * 44, 0.8, math.sin(a) * 44)
		part({ Name = "PoolRim", Size = Vector3.new(4, 1.6, 12), CFrame = CFrame.lookAt(p, pool + Vector3.new(0, 0.8, 0)) * CFrame.Angles(0, math.rad(90), 0), Color = Color3.fromRGB(175, 170, 150), Material = Enum.Material.Sandstone, Parent = f })
	end
	-- 사부의 단: 둥근 돌단과 파도 무늬 기둥
	local d = Vector3.new(at.X, 0, at.Z)
	cyl("ShrineDais", d + Vector3.new(0, at.Y / 2, 0), 16, at.Y, Color3.fromRGB(200, 195, 175), Enum.Material.Marble, f)
	cyl("ShrineWave", d + Vector3.new(0, at.Y + 0.06, 0), 13, 0.1, Color3.fromRGB(120, 200, 255), Enum.Material.Neon, f, false).Transparency = 0.35
	for k = 0, 7 do
		local a = k / 8 * math.pi * 2 + math.pi / 8
		local p = d + Vector3.new(math.cos(a) * 15, 0, math.sin(a) * 15)
		part({ Name = "WavePillar", Size = Vector3.new(2.4, 14, 2.4), Position = p + Vector3.new(0, at.Y + 7, 0), Color = Color3.fromRGB(225, 225, 215), Material = Enum.Material.Marble, Parent = f })
		for j = 0, 2 do
			part({ Name = "WaveBand", Size = Vector3.new(2.7, 0.4, 2.7), CFrame = CFrame.new(p + Vector3.new(0, at.Y + 3 + j * 4, 0)) * CFrame.Angles(0, 0, math.rad(12 * (j % 2 == 0 and 1 or -1))), Color = SEA, Material = Enum.Material.Neon, CanCollide = false, Parent = f })
		end
		crystal(p + Vector3.new(0, at.Y + 16.5, 0), 1.2, Color3.fromRGB(120, 210, 255), f)
	end
	-- 지붕 없는 둥근 띠 (기둥을 잇는다)
	for k = 0, 15 do
		local a = k / 16 * math.pi * 2
		local p = d + Vector3.new(math.cos(a) * 15, at.Y + 14.4, math.sin(a) * 15)
		part({ Name = "ShrineRing", Size = Vector3.new(1.2, 1, 6.2), CFrame = CFrame.lookAt(p, d + Vector3.new(0, at.Y + 14.4, 0)) * CFrame.Angles(0, math.rad(90), 0), Color = Color3.fromRGB(225, 225, 215), Material = Enum.Material.Marble, Parent = f })
	end
	-- 산호 바위와 조개
	for k = 0, 13 do
		local a = k * 2.4
		local p = c + Vector3.new(math.cos(a) * (50 + k * 4), 0, math.sin(a) * (50 + k * 4))
		if (p - pool).Magnitude > 50 then
			local h = 3 + (k % 4) * 1.5
			part({ Name = "Coral", Size = Vector3.new(1.4, h, 1.4), CFrame = CFrame.new(p + Vector3.new(0, h / 2, 0)) * CFrame.Angles(0.2 * (k % 3 - 1), k, 0.2), Color = k % 2 == 0 and Color3.fromRGB(255, 120, 110) or Color3.fromRGB(255, 180, 130), Material = Enum.Material.SmoothPlastic, Parent = f })
			part({ Name = "Shell", Shape = Enum.PartType.Ball, Size = Vector3.new(1.4, 0.7, 1.4), Position = p + Vector3.new(2, 0.3, 1), Color = Color3.fromRGB(250, 235, 225), Material = Enum.Material.SmoothPlastic, Parent = f })
		end
	end
	for k = 0, 5 do
		local a = k / 6 * math.pi * 2
		stoneLantern(d + Vector3.new(math.cos(a) * 26, 0, math.sin(a) * 26), f, k % 2 == 0)
	end
end

function SITES.geumgang(r: any, at: Vector3, color: Color3, f: Instance)
	local base = Vector3.new(at.X, 0, at.Z - 10)
	part({ Name = "TempleBase", Size = Vector3.new(80, at.Y, 56), Position = base + Vector3.new(0, at.Y / 2, 0), Color = Color3.fromRGB(165, 155, 140), Material = Enum.Material.Granite, Parent = f })
	for i = 1, 5 do
		local h = at.Y * i / 5
		part({ Name = "TempleStep", Size = Vector3.new(26, h, 3), Position = base + Vector3.new(0, h / 2, 28 + (5 - i) * 3 + 1.5), Color = Color3.fromRGB(150, 140, 125), Material = Enum.Material.Granite, Parent = f })
	end
	building(base + Vector3.new(0, at.Y, -12), 44, 22, math.pi, f, { tiers = 2, h = 13, wall = STONE, roof = Color3.fromRGB(190, 150, 60), sign = "금강사", awning = false })
	spire(Vector3.new(at.X + 60, 0, at.Z - 14), 4, 7, color, f)
	local bellFrame = base + Vector3.new(-28, at.Y, 12)
	for _, x in ipairs({ -1, 1 }) do
		part({ Name = "BellPost", Size = Vector3.new(1, 12, 1), Position = bellFrame + Vector3.new(x * 4, 6, 0), Color = WOOD, Material = Enum.Material.Wood, Parent = f })
	end
	part({ Name = "BellBeam", Size = Vector3.new(10, 1, 1.2), Position = bellFrame + Vector3.new(0, 12, 0), Color = WOOD, Material = Enum.Material.Wood, Parent = f })
	cyl("Bell", bellFrame + Vector3.new(0, 8.5, 0), 2.4, 5, Color3.fromRGB(200, 160, 70), Enum.Material.Metal, f)
	local burner = cyl("Incense", Vector3.new(at.X, at.Y + 1.5, at.Z + 10), 2, 3, Color3.fromRGB(70, 60, 50), Enum.Material.Metal, f)
	local smoke = Instance.new("Smoke")
	smoke.Color = Color3.fromRGB(230, 225, 215)
	smoke.Opacity = 0.12
	smoke.RiseVelocity = 3
	smoke.Size = 1
	smoke.Parent = burner
	for _, x in ipairs({ -1, 1 }) do
		local lamp = part({ Name = "StoneLantern", Size = Vector3.new(2.4, 5, 2.4), Position = Vector3.new(at.X + x * 16, at.Y + 2.5, at.Z + 14), Color = Color3.fromRGB(140, 135, 125), Material = Enum.Material.Granite, Parent = f })
		light(lamp, Color3.fromRGB(255, 200, 120), 16)
	end
	for _ = 1, 12 do
		local p = r.center + Vector3.new(rng:NextNumber(-140, 140), 0, rng:NextNumber(-140, 140))
		if (p - base).Magnitude > 60 and not nearRoad(p, 16) then
			tree(p, rng:NextNumber(1.2, 1.8), f)
		end
	end
end

-- 매화원: 꽃잎이 흩날리는 매화나무 숲과 둥근 달문
function SITES.maehwa(r: any, at: Vector3, color: Color3, f: Instance)
	local c = r.center
	tree(Vector3.new(at.X, 0, at.Z - 14), 2.6, f, true)
	for _ = 1, 42 do
		local p = c + Vector3.new(rng:NextNumber(-140, 140), 0, rng:NextNumber(-140, 140))
		if (p - Vector3.new(at.X, 0, at.Z)).Magnitude > 28 and not nearRoad(p, 14) then
			tree(p, rng:NextNumber(1.1, 1.7), f, true)
		end
	end
	-- 달문 (길이 들어오는 쪽)
	local gate = Vector3.new(c.X, 0, c.Z + 92)
	for k = 0, 23 do
		local a = k / 24 * math.pi * 2
		if 10 + math.sin(a) * 10 < 3 then
			continue
		end
		part({ Name = "MoonGate", Size = Vector3.new(2.6, 2.6, 2), Position = gate + Vector3.new(math.cos(a) * 10, 10 + math.sin(a) * 10, 0), Color = STONE, Material = Enum.Material.Marble, Parent = f })
	end
	crystal(gate + Vector3.new(0, 23, 0), 2.6, color, f)
	pavilion(Vector3.new(at.X - 28, 0, at.Z + 4), 6, 6, 8, Color3.fromRGB(150, 80, 100), f, color)
	-- 꽃잎 바람
	local sky = part({ Name = "PetalSky", Size = Vector3.new(120, 1, 120), Position = Vector3.new(at.X, 34, at.Z), Transparency = 1, CanCollide = false, Parent = f })
	local e = Instance.new("ParticleEmitter")
	e.Rate = 30
	e.Color = ColorSequence.new(Color3.fromRGB(255, 190, 215))
	e.Size = NumberSequence.new(0.35)
	e.Lifetime = NumberRange.new(6, 9)
	e.Speed = NumberRange.new(3, 6)
	e.Acceleration = Vector3.new(1.5, -1.2, 0.8)
	e.EmissionDirection = Enum.NormalId.Bottom
	e.RotSpeed = NumberRange.new(-120, 120)
	e.Parent = sky
	part({ Name = "PlumPath", Size = Vector3.new(6, 0.4, 70), Position = Vector3.new(at.X, 0.25, at.Z + 45), Color = Color3.fromRGB(200, 190, 175), Material = Enum.Material.Cobblestone, Parent = f })
end

-- 천룡봉: 비탈길로 오르는 바위 봉우리, 금빛 용이 기둥을 감는다
function SITES.cheonryong(r: any, at: Vector3, color: Color3, f: Instance)
	local top = at.Y
	part({ Name = "PeakRock", Size = Vector3.new(56, top, 56), Position = Vector3.new(at.X, top / 2, at.Z), Color = Color3.fromRGB(115, 110, 105), Material = Enum.Material.Rock, Parent = f })
	local rampC = Vector3.new(at.X - 28 - 22, top / 2, at.Z)
	local ramp = Instance.new("WedgePart")
	ramp.Name = "PeakRamp"
	ramp.Anchored = true
	ramp.Size = Vector3.new(14, top, 44)
	ramp.CFrame = CFrame.lookAt(rampC, rampC - Vector3.xAxis)
	ramp.Color = Color3.fromRGB(125, 118, 110)
	ramp.Material = Enum.Material.Slate
	ramp.Parent = f
	local pillar = part({ Name = "DragonPillar", Size = Vector3.new(4, 34, 4), Position = Vector3.new(at.X + 18, top + 17, at.Z), Color = STONE, Material = Enum.Material.Marble, Parent = f })
	pavilion(Vector3.new(at.X, top, at.Z), 10, 8, 11, ROOF, f, GOLD)
	local _ = pillar
	for k = 0, 40 do
		local u = k / 40
		local a = u * math.pi * 5
		local p = Vector3.new(at.X + 18 + math.cos(a) * 4.5, top + 2 + u * 34, at.Z + math.sin(a) * 4.5)
		local ball = part({ Name = "DragonBody", Shape = Enum.PartType.Ball, Size = Vector3.new(1, 1, 1) * (2.6 - u * 1.2), Position = p, Color = Color3.fromRGB(255, 200, 80), Material = Enum.Material.Neon, CanCollide = false, Parent = f })
		if k == 40 then
			ball.Size = Vector3.new(4, 4, 4)
			light(ball, Color3.fromRGB(255, 200, 90), 30, 2)
		end
	end
	for _ = 1, 26 do
		local p = r.center + Vector3.new(rng:NextNumber(-140, 140), 0, rng:NextNumber(-140, 140))
		if (p - Vector3.new(at.X, 0, at.Z)).Magnitude > 50 and not nearRoad(p, 16) then
			rock(p, rng:NextNumber(5, 14), f, Color3.fromRGB(110, 105, 100))
		end
	end
end

-- 무영곡: 높은 검은 절벽 사이 무너진 사당, 보랏빛 등
function SITES.muyeong(r: any, at: Vector3, color: Color3, f: Instance)
	local c = r.center
	for _, side in ipairs({ -1, 1 }) do
		for k = -3, 3 do
			local h = rng:NextNumber(60, 110)
			part({ Name = "DarkCliff", Size = Vector3.new(46, h, 30), CFrame = CFrame.new(c.X + k * 42, h / 2 - 4, c.Z + side * rng:NextNumber(70, 90)) * CFrame.Angles(0, rng:NextNumber(-0.2, 0.2), 0), Color = Color3.fromRGB(45, 42, 52), Material = Enum.Material.Rock, Parent = f })
		end
	end
	part({ Name = "ShrineBase", Size = Vector3.new(34, at.Y, 34), Position = Vector3.new(at.X, at.Y / 2, at.Z), Color = Color3.fromRGB(70, 65, 75), Material = Enum.Material.Slate, Parent = f })
	for k = 0, 5 do
		local a = k / 6 * math.pi * 2
		local h = rng:NextNumber(4, 14)
		part({ Name = "BrokenPillar", Size = Vector3.new(2, h, 2), CFrame = CFrame.new(at.X + math.cos(a) * 14, at.Y + h / 2, at.Z + math.sin(a) * 14) * CFrame.Angles(rng:NextNumber(-0.15, 0.15), 0, rng:NextNumber(-0.15, 0.15)), Color = Color3.fromRGB(90, 80, 95), Material = Enum.Material.Slate, Parent = f })
	end
	for k = 0, 5 do
		local p = Vector3.new(c.X + 80 - k * 22, 0, c.Z + (k % 2 == 0 and -14 or 14))
		part({ Name = "LanternPole", Size = Vector3.new(0.6, 7, 0.6), Position = p + Vector3.new(0, 3.5, 0), Color = Color3.fromRGB(40, 35, 45), Material = Enum.Material.Wood, Parent = f })
		local lamp = part({ Name = "ShadowLantern", Shape = Enum.PartType.Ball, Size = Vector3.new(1.6, 1.6, 1.6), Position = p + Vector3.new(0, 7.5, 0), Color = color, Material = Enum.Material.Neon, CanCollide = false, Parent = f })
		light(lamp, color, 18, 2)
	end
end

-- 뇌운 고원: 돌 원단과 번개 받는 쇠기둥
function SITES.byeokryeok(r: any, at: Vector3, color: Color3, f: Instance)
	cyl("ThunderRing", Vector3.new(at.X, at.Y / 2, at.Z), 24, at.Y, Color3.fromRGB(110, 110, 120), Enum.Material.Granite, f)
	cyl("ThunderMark", Vector3.new(at.X, at.Y + 0.05, at.Z), 10, 0.1, Color3.fromRGB(255, 230, 120), Enum.Material.Neon, f, false).Transparency = 0.5
	for k = 0, 7 do
		local a = k / 8 * math.pi * 2
		local p = Vector3.new(at.X + math.cos(a) * 40, 0, at.Z + math.sin(a) * 40)
		part({ Name = "LightningRod", Size = Vector3.new(1.4, 28, 1.4), Position = p + Vector3.new(0, 14, 0), Color = Color3.fromRGB(70, 70, 80), Material = Enum.Material.Metal, Parent = f })
		local tip = part({ Name = "RodTip", Shape = Enum.PartType.Ball, Size = Vector3.new(2.4, 2.4, 2.4), Position = p + Vector3.new(0, 29, 0), Color = color, Material = Enum.Material.Neon, CanCollide = false, Parent = f })
		light(tip, color, 22, 2)
		emitter(tip, Color3.fromRGB(200, 230, 255), 6, 0.5, 8, 0.25)
	end
	for _ = 1, 20 do
		local p = r.center + Vector3.new(rng:NextNumber(-140, 140), 0, rng:NextNumber(-140, 140))
		if (p - Vector3.new(at.X, 0, at.Z)).Magnitude > 50 and not nearRoad(p, 16) then
			rock(p, rng:NextNumber(4, 10), f, Color3.fromRGB(70, 68, 72))
		end
	end
end

-- 풍신대: 둥근 언덕 위 돌 단, 바람을 받는 높은 깃대와 도는 바람 고리
function SITES.pungsin(r: any, at: Vector3, color: Color3, f: Instance)
	cyl("WindMound", Vector3.new(at.X, at.Y / 2, at.Z), 34, at.Y, Color3.fromRGB(110, 150, 100), Enum.Material.Grass, f)
	cyl("WindDais", Vector3.new(at.X, at.Y + 0.4, at.Z), 14, 0.8, Color3.fromRGB(205, 210, 200), Enum.Material.Marble, f)
	cyl("WindMark", Vector3.new(at.X, at.Y + 0.85, at.Z), 9, 0.1, color, Enum.Material.Neon, f, false).Transparency = 0.5
	for k = 0, 5 do
		local a = k / 6 * math.pi * 2
		local p = Vector3.new(at.X + math.cos(a) * 30, at.Y, at.Z + math.sin(a) * 30)
		part({ Name = "WindPole", Size = Vector3.new(1, 32, 1), Position = p + Vector3.new(0, 16, 0), Color = Color3.fromRGB(220, 220, 215), Material = Enum.Material.Marble, Parent = f })
		for j = 0, 2 do
			part({ Name = "WindRibbon", Size = Vector3.new(0.15, 1.2, 9 - j * 2), CFrame = CFrame.new(p + Vector3.new(0, 30 - j * 3, 0)) * CFrame.Angles(0, a + j * 0.4, 0) * CFrame.new(0, 0, (9 - j * 2) / 2), Color = j % 2 == 0 and color or Color3.fromRGB(245, 255, 250), Material = Enum.Material.Fabric, CanCollide = false, Parent = f })
		end
	end
	-- 하늘에 떠서 도는 바람 고리 셋
	for j = 0, 2 do
		local c = Vector3.new(at.X, at.Y + 26 + j * 9, at.Z)
		local ring = part({ Name = "WindRing", Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.6, 30 - j * 7, 30 - j * 7), CFrame = CFrame.new(c) * CFrame.Angles(math.rad(10 + j * 25), j, math.rad(90)), Color = color, Material = Enum.Material.Neon, Transparency = 0.55, CanCollide = false, Parent = f })
		local _ = ring
	end
	for _ = 1, 18 do
		local p = r.center + Vector3.new(rng:NextNumber(-120, 120), 0, rng:NextNumber(-120, 120))
		if (p - Vector3.new(at.X, 0, at.Z)).Magnitude > 44 and not nearRoad(p, 14) then
			rock(p, rng:NextNumber(3, 8), f, Color3.fromRGB(150, 160, 150))
		end
	end
end

-- 취선 주막: 술독과 탁자, '酒' 깃발
function SITES.chwi(r: any, at: Vector3, color: Color3, f: Instance)
	building(Vector3.new(at.X, 0, at.Z + 36), 34, 18, 0, f, { tiers = 2, sign = "취선 주막", awningColor = Color3.fromRGB(170, 60, 40) })
	for _, x in ipairs({ -16, 16 }) do
		part({ Name = "Table", Size = Vector3.new(7, 0.6, 4), Position = Vector3.new(at.X + x, 3, at.Z + 4), Color = Color3.fromRGB(120, 80, 50), Material = Enum.Material.Wood, Parent = f })
		part({ Name = "TableLeg", Size = Vector3.new(5, 2.7, 2), Position = Vector3.new(at.X + x, 1.35, at.Z + 4), Color = Color3.fromRGB(90, 60, 40), Material = Enum.Material.Wood, Parent = f })
		for _, dz in ipairs({ -3.5, 3.5 }) do
			cyl("Stool", Vector3.new(at.X + x, 0.9, at.Z + 4 + dz), 1, 1.8, Color3.fromRGB(110, 75, 45), Enum.Material.Wood, f)
		end
	end
	for k = 1, 9 do
		local p = Vector3.new(at.X + 24 + (k % 3) * 3.4, 0, at.Z + 20 + math.floor((k - 1) / 3) * 3.4)
		cyl("WineJar", p + Vector3.new(0, 1.6, 0), 1.5, 3.2, Color3.fromRGB(110, 70, 45), Enum.Material.Slate, f)
	end
	local pole = part({ Name = "FlagPole", Size = Vector3.new(0.8, 20, 0.8), Position = Vector3.new(at.X - 26, 10, at.Z + 22), Color = WOOD, Material = Enum.Material.Wood, Parent = f })
	local _ = pole
	local flag = part({ Name = "WineFlag", Size = Vector3.new(6, 9, 0.2), Position = Vector3.new(at.X - 22.6, 14, at.Z + 22), Color = Color3.fromRGB(200, 50, 40), Material = Enum.Material.Fabric, CanCollide = false, Parent = f })
	sign(flag, Enum.NormalId.Front, { { "주막", Color3.fromRGB(255, 240, 220), 1 } })
	sign(flag, Enum.NormalId.Back, { { "주막", Color3.fromRGB(255, 240, 220), 1 } })
end

local function masterSites()
	for _, r in ipairs(Config.Regions) do
		local styleId = r.master
		local style = styleId and Config.STYLE_BY_ID[styleId]
		if style then
			local f = Instance.new("Folder")
			f.Name = "Master_" .. r.id
			f.Parent = folder
			local builder = SITES[style.id]
			if builder then
				local ok, err = pcall(builder, r, r.masterAt, style.color, f)
				if not ok then
					warn("[권왕] 사부 자리 만들기 오류:", r.id, err)
				end
			end
			-- 길이 들어오는 자리에 큰 돌문
			local ok2, err2 = pcall(function()
				for _, road in ipairs(Config.Roads) do
					local a, b = road[#road - 1], road[#road]
					local inside = math.abs(b.X - r.center.X) < r.size.X / 2 and math.abs(b.Z - r.center.Z) < r.size.Z / 2
					if inside then
						local dir = (b - a).Unit
						local p = a
						for k = 0, 400 do
							p = a + dir * (k * 2)
							if math.abs(p.X - r.center.X) < r.size.X / 2 - 8 and math.abs(p.Z - r.center.Z) < r.size.Z / 2 - 8 then
								break
							end
						end
						monumentGate(Vector3.new(p.X, 0, p.Z), math.atan2(-dir.X, -dir.Z), f, string.split(r.name, " (")[1], style.color)
					end
				end
			end)
			if not ok2 then
				warn("[권왕] 사부 자리 문 오류:", r.id, err2)
			end
			-- (빛기둥은 사부를 찾은 사람의 화면에만 그린다)
		end
	end
end

------------------------------------------------------------------------
-- 큰 볼거리 (멀리서도 보이는 랜드마크)
------------------------------------------------------------------------
local LANDMARK: { [string]: (at: Vector3, f: Instance) -> () } = {}

-- 거신상: 주먹을 손바닥에 모아 예를 갖춘 거대한 돌 무인
function LANDMARK.colossus(at: Vector3, f: Instance)
	local face = (Vector3.new(0, 0, 0) - at)
	face = Vector3.new(face.X, 0, face.Z).Unit
	local cf = CFrame.lookAt(at, at + face)
	local function blk(name: string, size: Vector3, off: Vector3, color: Color3?, mat: Enum.Material?, rot: CFrame?)
		part({ Name = name, Size = size, CFrame = cf * CFrame.new(off) * (rot or CFrame.identity), Color = color or Color3.fromRGB(160, 155, 145), Material = mat or Enum.Material.Granite, Parent = f })
	end
	blk("ColossusBase", Vector3.new(34, 6, 30), Vector3.new(0, 3, 0), STONE_DARK, Enum.Material.Cobblestone)
	blk("ColossusBase2", Vector3.new(26, 4, 22), Vector3.new(0, 8, 0), STONE, Enum.Material.Marble)
	for i = 1, 4 do
		blk("ColossusStep", Vector3.new(14, i * 2.5, 3), Vector3.new(0, i * 1.25, -15 - (5 - i) * 3), STONE, Enum.Material.Marble)
	end
	local y = 10
	-- 다리 (말 타듯 벌려 선 자세)
	for _, sx in ipairs({ -1, 1 }) do
		blk("ColossusLeg", Vector3.new(5.5, 20, 6), Vector3.new(sx * 6, y + 10, 0), nil, nil, CFrame.Angles(0, 0, sx * math.rad(12)))
		blk("ColossusFoot", Vector3.new(7, 2.5, 9), Vector3.new(sx * 8, y + 1.25, -1))
	end
	blk("ColossusHip", Vector3.new(16, 6, 8), Vector3.new(0, y + 21, 0))
	blk("ColossusSash", Vector3.new(16.6, 2, 8.6), Vector3.new(0, y + 23, 0), GOLD, Enum.Material.Metal)
	blk("ColossusTorso", Vector3.new(18, 18, 9), Vector3.new(0, y + 33, 0))
	blk("ColossusHead", Vector3.new(8, 9, 8), Vector3.new(0, y + 47, 0))
	for _, sx in ipairs({ -1, 1 }) do
		part({ Name = "ColossusEye", Size = Vector3.new(1.4, 0.8, 0.4), CFrame = cf * CFrame.new(sx * 1.8, y + 48, -4.1), Color = Color3.fromRGB(120, 220, 255), Material = Enum.Material.Neon, CanCollide = false, Parent = f })
		-- 어깨에서 가슴 앞으로 모은 팔
		blk("ColossusUpperArm", Vector3.new(5, 12, 5), Vector3.new(sx * 11.5, y + 36, -3), nil, nil, CFrame.Angles(math.rad(-40), 0, sx * math.rad(20)))
		blk("ColossusForearm", Vector3.new(4.5, 11, 4.5), Vector3.new(sx * 6, y + 32, -10), nil, nil, CFrame.Angles(math.rad(-90), sx * math.rad(-55), 0))
	end
	part({ Name = "ColossusFist", Shape = Enum.PartType.Ball, Size = Vector3.new(6, 6, 6), CFrame = cf * CFrame.new(-1.2, y + 33, -14), Color = Color3.fromRGB(160, 155, 145), Material = Enum.Material.Granite, Parent = f })
	blk("ColossusPalm", Vector3.new(1.5, 7, 6), Vector3.new(2.2, y + 33, -14))
	crystal((cf * CFrame.new(0, y + 62, 0)).Position, 4, Color3.fromRGB(120, 220, 255), f)
	for _, sx in ipairs({ -1, 1 }) do
		brazier((cf * CFrame.new(sx * 15, 10, -9)).Position, 1.3, f)
	end
end

-- 하늘 고리: 공중에 선 거대한 돌 고리와 그 안에 떠 있는 수정들
function LANDMARK.skyring(at: Vector3, f: Instance)
	local face = Vector3.new(-at.X, 0, -at.Z).Unit
	local c = at + Vector3.new(0, 60, 0)
	local cf = CFrame.lookAt(c, c + face)
	local R = 30
	for k = 0, 39 do
		local a = k / 40 * math.pi * 2
		part({ Name = "SkyRingStone", Size = Vector3.new(5.4, 5.4, 4), CFrame = cf * CFrame.new(math.cos(a) * R, math.sin(a) * R, 0) * CFrame.Angles(0, 0, a), Color = k % 5 == 0 and GOLD or STONE, Material = k % 5 == 0 and Enum.Material.Metal or Enum.Material.Marble, CanCollide = false, Parent = f })
	end
	crystal(c, 6, Color3.fromRGB(150, 230, 255), f)
	for k = 0, 5 do
		local a = k / 6 * math.pi * 2
		crystal((cf * CFrame.new(math.cos(a) * 14, math.sin(a) * 14, 0)).Position, 2.2, Color3.fromRGB(200, 170, 255), f)
	end
	-- 땅의 둥근 돌 터와 하늘로 이어진 빛
	disc("SkyRingFloor", at + Vector3.new(0, 0.4, 0), 26, 0.8, STONE, Enum.Material.Marble, f)
	disc("SkyRingRune", at + Vector3.new(0, 0.85, 0), 18, 0.1, Color3.fromRGB(150, 230, 255), Enum.Material.Neon, f, false).Transparency = 0.5
	part({ Name = "SkyRingBeam", Size = Vector3.new(1.6, 30, 1.6), Position = at + Vector3.new(0, 15, 0), Color = Color3.fromRGB(150, 230, 255), Material = Enum.Material.Neon, Transparency = 0.5, CanCollide = false, CastShadow = false, Parent = f })
	for k = 0, 7 do
		local a = k / 8 * math.pi * 2
		local p = at + Vector3.new(math.cos(a) * 24, 0, math.sin(a) * 24)
		part({ Name = "SkyRingObelisk", Size = Vector3.new(2.4, 12, 2.4), Position = p + Vector3.new(0, 6, 0), Color = STONE, Material = Enum.Material.Marble, Parent = f })
		part({ Name = "ObeliskTip", Size = Vector3.new(1.2, 1.2, 1.2), CFrame = CFrame.new(p + Vector3.new(0, 12.8, 0)) * CFrame.Angles(math.rad(45), 0, math.rad(45)), Color = Color3.fromRGB(150, 230, 255), Material = Enum.Material.Neon, CanCollide = false, Parent = f })
	end
end

-- 옛 투기장: 무너진 둥근 기둥 벽, 모래 바닥, 몇 개 남은 아치
function LANDMARK.colosseum(at: Vector3, f: Instance)
	disc("ArenaSand", at + Vector3.new(0, 0.3, 0), 36, 0.6, Color3.fromRGB(205, 185, 140), Enum.Material.Sand, f)
	disc("ArenaCircle", at + Vector3.new(0, 0.65, 0), 14, 0.1, Color3.fromRGB(150, 60, 50), Enum.Material.Slate, f, false)
	local n = 28
	local heights = {}
	for k = 0, n - 1 do
		local a = k / n * math.pi * 2
		local h = (k % 7 == 3) and 0 or (rng:NextNumber() < 0.3 and rng:NextNumber(5, 12) or 22)
		heights[k] = h
		if h > 0 then
			local p = at + Vector3.new(math.cos(a) * 42, 0, math.sin(a) * 42)
			part({ Name = "ArenaPillar", Size = Vector3.new(4, h, 4), CFrame = CFrame.lookAt(p + Vector3.new(0, h / 2, 0), at + Vector3.new(0, h / 2, 0)), Color = Color3.fromRGB(190, 180, 160), Material = Enum.Material.Cobblestone, Parent = f })
		end
	end
	-- 온전한 기둥 둘 사이엔 아치 들보
	for k = 0, n - 1 do
		local k2 = (k + 1) % n
		if heights[k] == 22 and heights[k2] == 22 then
			local a = (k + 0.5) / n * math.pi * 2
			local p = at + Vector3.new(math.cos(a) * 42, 23, math.sin(a) * 42)
			part({ Name = "ArenaLintel", Size = Vector3.new(10, 2.4, 4.4), CFrame = CFrame.lookAt(p, at + Vector3.new(0, 23, 0)) * CFrame.Angles(0, math.rad(90), 0), Color = Color3.fromRGB(180, 170, 150), Material = Enum.Material.Cobblestone, Parent = f })
		end
	end
	-- 계단식 관중석 (바깥 둘레)
	for i = 1, 3 do
		local r = 46 + i * 4
		for k = 0, 35 do
			if k % 9 ~= 0 then
				local a = k / 36 * math.pi * 2
				local p = at + Vector3.new(math.cos(a) * r, i * 1.5, math.sin(a) * r)
				part({ Name = "ArenaSeat", Size = Vector3.new(4, i * 3, 9.2), CFrame = CFrame.lookAt(p, Vector3.new(at.X, p.Y, at.Z)) * CFrame.Angles(0, math.rad(90), 0), Color = Color3.fromRGB(170, 160, 140), Material = Enum.Material.Cobblestone, Parent = f })
			end
		end
	end
	for k = 0, 3 do
		local a = k / 4 * math.pi * 2 + 0.4
		banner(at + Vector3.new(math.cos(a) * 34, 0, math.sin(a) * 34), 16, Color3.fromRGB(150, 40, 35), f)
	end
end

-- 수정 들판: 땅에서 솟은 거대한 수정 무리
function LANDMARK.crystals(at: Vector3, f: Instance)
	disc("CrystalGlow", at + Vector3.new(0, 0.2, 0), 70, 0.4, Color3.fromRGB(70, 60, 110), Enum.Material.Slate, f)
	for k = 1, 26 do
		local a = rng:NextNumber(0, math.pi * 2)
		local d = rng:NextNumber(0, 62)
		local h = rng:NextNumber(6, 26) * (d < 20 and 1.6 or 1)
		local w = h * rng:NextNumber(0.22, 0.35)
		local p = at + Vector3.new(math.cos(a) * d, h * 0.4, math.sin(a) * d)
		local color = k % 3 == 0 and Color3.fromRGB(200, 140, 255) or Color3.fromRGB(110, 220, 255)
		local cr = part({ Name = "GiantCrystal", Size = Vector3.new(w, h, w), CFrame = CFrame.new(p) * CFrame.Angles(rng:NextNumber(-0.35, 0.35), rng:NextNumber(0, 6), rng:NextNumber(-0.35, 0.35)), Color = color, Material = Enum.Material.Neon, Transparency = 0.15, Parent = f })
		if k % 4 == 0 then
			light(cr, color, 30, 1.5)
		end
	end
	crystal(at + Vector3.new(0, 48, 0), 7, Color3.fromRGB(180, 150, 255), f)
end

-- 천년 고목: 하늘을 덮는 거대한 나무와 뿌리 사이의 돌 제단
function LANDMARK.worldtree(at: Vector3, f: Instance)
	local bark = Color3.fromRGB(85, 62, 45)
	disc("TreeTrunk", at + Vector3.new(0, 40, 0), 9, 80, bark, Enum.Material.Wood, f)
	for k = 0, 7 do
		local a = k / 8 * math.pi * 2
		local p = at + Vector3.new(math.cos(a) * 12, 3, math.sin(a) * 12)
		part({ Name = "TreeRoot", Size = Vector3.new(4, 4, 18), CFrame = CFrame.lookAt(p, at + Vector3.new(0, 8, 0)), Color = bark, Material = Enum.Material.Wood, Parent = f })
	end
	for k = 0, 5 do
		local a = k / 6 * math.pi * 2 + 0.3
		local from = at + Vector3.new(0, 55 + (k % 3) * 8, 0)
		local to = from + Vector3.new(math.cos(a) * 32, 14, math.sin(a) * 32)
		part({ Name = "TreeBranch", Size = Vector3.new(3.5, 3.5, (to - from).Magnitude), CFrame = CFrame.lookAt((from + to) / 2, to), Color = bark, Material = Enum.Material.Wood, Parent = f })
		part({ Name = "TreeCanopy", Shape = Enum.PartType.Ball, Size = Vector3.new(1, 1, 1) * rng:NextNumber(26, 36), Position = to + Vector3.new(0, 6, 0), Color = Color3.fromRGB(60, 120, 60):Lerp(Color3.fromRGB(110, 160, 80), rng:NextNumber()), Material = Enum.Material.Grass, CanCollide = false, Parent = f })
	end
	part({ Name = "TreeCrown", Shape = Enum.PartType.Ball, Size = Vector3.new(50, 50, 50), Position = at + Vector3.new(0, 92, 0), Color = Color3.fromRGB(75, 135, 65), Material = Enum.Material.Grass, CanCollide = false, Parent = f })
	-- 반딧불
	local glow = part({ Name = "Fireflies", Size = Vector3.new(80, 30, 80), Position = at + Vector3.new(0, 25, 0), Transparency = 1, CanCollide = false, Parent = f })
	local e = Instance.new("ParticleEmitter")
	e.Rate = 25
	e.Color = ColorSequence.new(Color3.fromRGB(230, 255, 150))
	e.LightEmission = 1
	e.Size = NumberSequence.new(0.3)
	e.Lifetime = NumberRange.new(3, 6)
	e.Speed = NumberRange.new(0.5, 2)
	e.SpreadAngle = Vector2.new(180, 180)
	e.Parent = glow
	-- 뿌리 앞 제단
	local face = Vector3.new(-at.X, 0, -at.Z).Unit
	local altar = at + face * 18
	disc("TreeAltar", altar + Vector3.new(0, 0.8, 0), 6, 1.6, STONE, Enum.Material.Marble, f)
	crystal(altar + Vector3.new(0, 5, 0), 2.4, Color3.fromRGB(170, 255, 140), f)
end

-- 핏빛 달: 혈월곡 하늘에 걸린 붉은 달 (어디서든 보인다)
function LANDMARK.moon(at: Vector3, f: Instance)
	local moon = part({ Name = "BloodMoon", Shape = Enum.PartType.Ball, Size = Vector3.new(80, 80, 80), Position = at + Vector3.new(0, 300, 0), Color = Color3.fromRGB(200, 40, 40), Material = Enum.Material.Neon, CanCollide = false, CastShadow = false, Parent = f })
	light(moon, Color3.fromRGB(255, 60, 50), 60, 1)
end

-- 만검총: 수백 자루의 검이 꽂힌 무덤, 한가운데 하늘까지 닿는 거대한 검
function LANDMARK.swordtomb(at: Vector3, f: Instance)
	local STEEL = Color3.fromRGB(190, 195, 205)
	local RUNE = Color3.fromRGB(120, 200, 255)
	cyl("SwordMound", at + Vector3.new(0, 3, 0), 60, 6, Color3.fromRGB(110, 100, 90), Enum.Material.Ground, f)
	cyl("SwordMound2", at + Vector3.new(0, 8, 0), 38, 6, Color3.fromRGB(100, 92, 85), Enum.Material.Ground, f)
	-- 둘레에 꽂힌 검들 (기울기가 제각각)
	for _ = 1, 70 do
		local a = rng:NextNumber(0, math.pi * 2)
		local d = rng:NextNumber(12, 60)
		local base = at + Vector3.new(math.cos(a) * d, d < 38 and 11 or 6, math.sin(a) * d)
		local tilt = CFrame.Angles(rng:NextNumber(-0.35, 0.35), rng:NextNumber(0, 6.28), rng:NextNumber(-0.35, 0.35))
		local len = rng:NextNumber(5, 9)
		local cf = CFrame.new(base) * tilt
		part({ Name = "TombBlade", Size = Vector3.new(0.25, len, 0.9), CFrame = cf * CFrame.new(0, len / 2 - 1.5, 0), Color = STEEL, Material = Enum.Material.Metal, CanCollide = false, Parent = f })
		part({ Name = "TombGuard", Size = Vector3.new(0.5, 0.35, 2.4), CFrame = cf * CFrame.new(0, len - 1.4, 0), Color = rng:NextNumber() < 0.2 and GOLD or IRON, Material = Enum.Material.Metal, CanCollide = false, Parent = f })
	end
	-- 한가운데의 거대한 검 (땅에 비스듬히 박혀 있다)
	local cf = CFrame.new(at + Vector3.new(0, 11, 0)) * CFrame.Angles(math.rad(8), math.rad(30), math.rad(-6))
	part({ Name = "GiantBlade", Size = Vector3.new(2.5, 90, 11), CFrame = cf * CFrame.new(0, 38, 0), Color = STEEL, Material = Enum.Material.Metal, Parent = f })
	part({ Name = "GiantEdge", Size = Vector3.new(0.6, 88, 1.2), CFrame = cf * CFrame.new(0, 38, 5.8), Color = Color3.fromRGB(235, 240, 250), Material = Enum.Material.Neon, CanCollide = false, Parent = f })
	part({ Name = "GiantFuller", Size = Vector3.new(2.7, 70, 1.4), CFrame = cf * CFrame.new(0, 34, 0), Color = RUNE, Material = Enum.Material.Neon, CanCollide = false, Parent = f })
	part({ Name = "GiantGuard", Size = Vector3.new(5, 5, 34), CFrame = cf * CFrame.new(0, 84, 0), Color = GOLD, Material = Enum.Material.Metal, Parent = f })
	part({ Name = "GiantGrip", Size = Vector3.new(4, 22, 4), CFrame = cf * CFrame.new(0, 97, 0), Color = Color3.fromRGB(60, 40, 30), Material = Enum.Material.Fabric, Parent = f })
	local pommel = part({ Name = "GiantPommel", Shape = Enum.PartType.Ball, Size = Vector3.new(8, 8, 8), CFrame = cf * CFrame.new(0, 110, 0), Color = RUNE, Material = Enum.Material.Neon, CanCollide = false, Parent = f })
	light(pommel, RUNE, 60, 3)
	-- 검을 휘감은 사슬과 떠도는 빛
	for k = 0, 9 do
		local a = k / 10 * math.pi * 2
		part({ Name = "SwordChain", Size = Vector3.new(0.6, 0.6, 14), CFrame = cf * CFrame.new(math.cos(a) * 7, 20 + k * 5, math.sin(a) * 7) * CFrame.Angles(0, a, 0.6), Color = IRON, Material = Enum.Material.Metal, CanCollide = false, Parent = f })
	end
	emitter(pommel, RUNE, 12, 0.8, 3, 3)
end

-- 끊어진 하늘다리: 땅에서 하늘로 솟다가 허공에서 뚝 끊긴 돌다리. 끊긴 끝에서 조각들이 떠 있다
function LANDMARK.skybridge(at: Vector3, f: Instance)
	local dir = Vector3.new(-1, 0, -1).Unit
	local side = Vector3.new(-dir.Z, 0, dir.X)
	local N = 34
	for i = 0, N - 1 do
		local k = i / N
		local p = at + dir * (i * 9) + Vector3.new(0, 4 + math.sin(k * math.pi * 0.62) * 150, 0)
		local q = at + dir * ((i + 1) * 9) + Vector3.new(0, 4 + math.sin((i + 1) / N * math.pi * 0.62) * 150, 0)
		local cf = CFrame.lookAt((p + q) / 2, q)
		part({ Name = "BridgeDeck", Size = Vector3.new(16, 2.5, (q - p).Magnitude + 0.4), CFrame = cf, Color = STONE, Material = Enum.Material.Marble, Parent = f })
		for _, sx in ipairs({ -1, 1 }) do
			part({ Name = "BridgeRail", Size = Vector3.new(1.2, 3, (q - p).Magnitude + 0.4), CFrame = cf * CFrame.new(sx * 7.5, 2.6, 0), Color = STONE_DARK, Material = Enum.Material.Marble, Parent = f })
		end
		if i % 6 == 0 and p.Y > 20 then
			-- 다리를 받친 높은 기둥
			part({ Name = "BridgePier", Size = Vector3.new(7, p.Y, 7), Position = Vector3.new(p.X, p.Y / 2, p.Z), Color = STONE, Material = Enum.Material.Marble, Parent = f })
			part({ Name = "BridgeLamp", Size = Vector3.new(2, 2, 2), Position = p + side * 8 + Vector3.new(0, 5, 0), Color = WARM, Material = Enum.Material.Neon, CanCollide = false, Parent = f })
		end
	end
	-- 끊긴 끝: 허공에 떠 있는 부서진 조각
	local tip = at + dir * (N * 9) + Vector3.new(0, 4 + math.sin(math.pi * 0.62) * 150, 0)
	for k = 1, 14 do
		local p = tip + dir * (k * 5) + Vector3.new(rng:NextNumber(-10, 10), rng:NextNumber(-8, 12) - k * 1.5, rng:NextNumber(-10, 10))
		local s = rng:NextNumber(3, 9)
		part({ Name = "BridgeShard", Size = Vector3.new(s, s * 0.35, s * 0.8), CFrame = CFrame.new(p) * CFrame.Angles(rng:NextNumber(0, 6), rng:NextNumber(0, 6), rng:NextNumber(0, 6)), Color = STONE, Material = Enum.Material.Marble, Parent = f })
	end
	local glow = part({ Name = "BridgeEndGlow", Shape = Enum.PartType.Ball, Size = Vector3.new(6, 6, 6), Position = tip + Vector3.new(0, 4, 0), Color = Color3.fromRGB(190, 230, 255), Material = Enum.Material.Neon, CanCollide = false, Parent = f })
	light(glow, Color3.fromRGB(190, 230, 255), 70, 3)
	emitter(glow, Color3.fromRGB(220, 240, 255), 8, 1, 2, 4)
end

-- 용의 무덤: 땅에 반쯤 묻힌 거대한 용의 뼈. 갈비뼈 사이로 길이 난다
function LANDMARK.dragonbones(at: Vector3, f: Instance)
	local BONE = Color3.fromRGB(225, 215, 190)
	local face = Vector3.new(1, 0, 0.35).Unit
	local side = Vector3.new(-face.Z, 0, face.X)
	-- 등뼈: 물결치며 이어지는 마디
	local spine = {}
	for i = 0, 30 do
		local p = at + face * (i * 6 - 90) + side * math.sin(i * 0.3) * 10 + Vector3.new(0, 10 + math.sin(i * 0.22) * 6, 0)
		table.insert(spine, p)
		part({ Name = "Vertebra", Size = Vector3.new(4.5, 5, 4.5), CFrame = CFrame.lookAt(p, p + face) * CFrame.Angles(0, 0, math.rad(45)), Color = BONE, Material = Enum.Material.Limestone, Parent = f })
		part({ Name = "SpineFin", Size = Vector3.new(1, 5 + (i % 3) * 1.5, 2.5), CFrame = CFrame.new(p + Vector3.new(0, 4, 0)), Color = BONE, Material = Enum.Material.Limestone, CanCollide = false, Parent = f })
	end
	-- 갈비뼈: 마디마다 양쪽으로 휜 두 토막
	for i = 6, 20, 2 do
		local p = spine[i]
		local len = 22 - math.abs(i - 13) * 1.2
		for _, sx in ipairs({ -1, 1 }) do
			local mid = p + side * sx * len * 0.55 + Vector3.new(0, -2, 0)
			local foot = p + side * sx * len * 0.9 + Vector3.new(0, -p.Y + 1, 0)
			part({ Name = "Rib", Size = Vector3.new(1.6, 1.6, (mid - p).Magnitude), CFrame = CFrame.lookAt((p + mid) / 2, mid), Color = BONE, Material = Enum.Material.Limestone, Parent = f })
			part({ Name = "Rib", Size = Vector3.new(1.5, 1.5, (foot - mid).Magnitude), CFrame = CFrame.lookAt((mid + foot) / 2, foot), Color = BONE, Material = Enum.Material.Limestone, Parent = f })
		end
	end
	-- 머리뼈: 길게 뻗은 주둥이, 이빨, 뿔, 빈 눈구멍의 푸른 불
	local head = spine[#spine] + face * 12
	local hcf = CFrame.lookAt(head, head + face) * CFrame.Angles(math.rad(-12), 0, 0)
	part({ Name = "Skull", Size = Vector3.new(12, 9, 14), CFrame = hcf, Color = BONE, Material = Enum.Material.Limestone, Parent = f })
	part({ Name = "Snout", Size = Vector3.new(8, 5, 16), CFrame = hcf * CFrame.new(0, -1.5, -14), Color = BONE, Material = Enum.Material.Limestone, Parent = f })
	part({ Name = "Jaw", Size = Vector3.new(7, 2.5, 18), CFrame = hcf * CFrame.new(0, -7, -10) * CFrame.Angles(math.rad(18), 0, 0), Color = BONE, Material = Enum.Material.Limestone, Parent = f })
	for k = 0, 5 do
		for _, sx in ipairs({ -1, 1 }) do
			part({ Name = "Fang", Size = Vector3.new(0.8, 2.6, 0.8), CFrame = hcf * CFrame.new(sx * 3.2, -4.6, -8 - k * 2.6), Color = Color3.fromRGB(245, 240, 225), Material = Enum.Material.Limestone, CanCollide = false, Parent = f })
		end
	end
	for _, sx in ipairs({ -1, 1 }) do
		part({ Name = "Horn", Size = Vector3.new(2, 2, 18), CFrame = hcf * CFrame.new(sx * 4.5, 5, 7) * CFrame.Angles(math.rad(30), sx * math.rad(20), 0), Color = Color3.fromRGB(70, 60, 55), Material = Enum.Material.Slate, Parent = f })
		local eye = part({ Name = "SoulFire", Shape = Enum.PartType.Ball, Size = Vector3.new(2.4, 2.4, 2.4), CFrame = hcf * CFrame.new(sx * 3.4, 1.5, -6.6), Color = Color3.fromRGB(90, 200, 255), Material = Enum.Material.Neon, CanCollide = false, Parent = f })
		emitter(eye, Color3.fromRGB(120, 220, 255), 10, 0.8, 2, 1.2)
	end
	-- 둘레에 떨어진 비늘 같은 돌
	for _ = 1, 16 do
		local p = at + Vector3.new(rng:NextNumber(-110, 110), 0, rng:NextNumber(-80, 80))
		rock(p, rng:NextNumber(2, 6), f, Color3.fromRGB(120, 110, 100))
	end
end

-- 불의 산: 꼭대기 분화구에서 연기와 불빛이 솟는 화산. 비탈로 용암 줄기가 흘러내린다
function LANDMARK.volcano(at: Vector3, f: Instance)
	local ROCK = Color3.fromRGB(55, 42, 38)
	local LAVA = Color3.fromRGB(255, 110, 30)
	local layers = 11
	for i = 0, layers - 1 do
		local r = 170 - i * 12.5
		cyl("VolcanoSlope", at + Vector3.new(0, 9 + i * 18, 0), r, 18.5, ROCK:Lerp(Color3.fromRGB(35, 28, 26), i / layers), Enum.Material.Basalt, f)
	end
	local top = at + Vector3.new(0, layers * 18, 0)
	local crater = cyl("Crater", top + Vector3.new(0, 0.4, 0), 30, 1, LAVA, Enum.Material.Neon, f, false)
	light(crater, LAVA, 120, 5)
	emitter(crater, Color3.fromRGB(70, 60, 60), 30, 12, 14, 6)
	local sparks = cyl("CraterSparks", top + Vector3.new(0, 1, 0), 26, 0.5, LAVA, Enum.Material.Neon, f, false)
	sparks.Transparency = 1
	emitter(sparks, LAVA, 20, 1.2, 30, 2)
	-- 흘러내리는 용암 줄기
	for k = 0, 5 do
		local a = k / 6 * math.pi * 2 + 0.3
		local d = Vector3.new(math.cos(a), 0, math.sin(a))
		for i = 0, layers - 2 do
			local r = 170 - i * 12.5
			local p = at + d * (r - 4) + Vector3.new(0, 18 + i * 18, 0)
			part({ Name = "LavaFlow", Size = Vector3.new(5 + (layers - i) * 0.5, 0.6, 14), CFrame = CFrame.lookAt(p, p + d) * CFrame.Angles(math.rad(-50), 0, 0), Color = LAVA, Material = Enum.Material.Neon, CanCollide = false, Parent = f })
		end
	end
	-- 발치의 용암 웅덩이
	for k = 0, 7 do
		local a = k / 8 * math.pi * 2
		local p = at + Vector3.new(math.cos(a) * 200, 0, math.sin(a) * 200)
		disc("LavaPool", p + Vector3.new(0, 0.15, 0), rng:NextNumber(8, 16), 0.3, LAVA, Enum.Material.Neon, f, false)
	end
end

-- 사왕의 무덤: 모래 위의 계단식 거대한 무덤. 꼭대기에 금빛 머릿돌, 앞에 반쯤 묻힌 왕의 얼굴
function LANDMARK.pyramid(at: Vector3, f: Instance)
	local SAND = Color3.fromRGB(205, 175, 115)
	local n = 12
	for i = 0, n - 1 do
		local w = 200 - i * 15
		part({ Name = "TombStep", Size = Vector3.new(w, 9, w), Position = at + Vector3.new(0, 4.5 + i * 9, 0), Color = SAND:Lerp(Color3.fromRGB(170, 140, 90), (i % 2) * 0.4), Material = Enum.Material.Sandstone, Parent = f })
	end
	local cap = part({ Name = "TombCap", Size = Vector3.new(18, 14, 18), CFrame = CFrame.new(at + Vector3.new(0, n * 9 + 7, 0)) * CFrame.Angles(0, math.rad(45), 0), Color = GOLD, Material = Enum.Material.Neon, Parent = f })
	light(cap, GOLD, 90, 3)
	-- 앞 (마을 쪽) 계단과 문
	local front = Vector3.new(0, 0, -1)
	for i = 0, 10 do
		part({ Name = "TombStair", Size = Vector3.new(26, 2, 6), Position = at + front * (100 + 30 - i * 3) + Vector3.new(0, 1 + i * 2, 0), Color = SAND, Material = Enum.Material.Sandstone, Parent = f })
	end
	monumentGate(at + front * 135, 0, f, "사왕릉", GOLD)
	-- 반쯤 묻힌 왕의 얼굴
	local hp = at + front * 175 + Vector3.new(60, 0, 0)
	local hcf = CFrame.lookAt(hp + Vector3.new(0, 10, 0), hp + Vector3.new(0, 10, 0) + front) * CFrame.Angles(math.rad(-10), 0, math.rad(8))
	part({ Name = "KingFace", Size = Vector3.new(22, 26, 20), CFrame = hcf, Color = SAND, Material = Enum.Material.Sandstone, Parent = f })
	part({ Name = "KingCrown", Size = Vector3.new(24, 7, 22), CFrame = hcf * CFrame.new(0, 16, 0), Color = GOLD, Material = Enum.Material.Metal, Parent = f })
	for k = -2, 2 do
		part({ Name = "CrownSpike", Size = Vector3.new(2.5, 7, 2.5), CFrame = hcf * CFrame.new(k * 4.5, 22, -10), Color = GOLD, Material = Enum.Material.Metal, Parent = f })
	end
	for _, sx in ipairs({ -1, 1 }) do
		part({ Name = "KingEye", Size = Vector3.new(4, 1.6, 0.6), CFrame = hcf * CFrame.new(sx * 5, 4, -10.2), Color = Color3.fromRGB(60, 200, 190), Material = Enum.Material.Neon, CanCollide = false, Parent = f })
	end
	part({ Name = "KingNose", Size = Vector3.new(3.5, 7, 3), CFrame = hcf * CFrame.new(0, -1, -11), Color = SAND, Material = Enum.Material.Sandstone, Parent = f })
	-- 무덤을 둘러싼 돌 기둥
	for k = 0, 7 do
		local a = k / 8 * math.pi * 2
		local p = at + Vector3.new(math.cos(a) * 150, 0, math.sin(a) * 150)
		part({ Name = "TombObelisk", Size = Vector3.new(6, 46, 6), Position = p + Vector3.new(0, 23, 0), Color = SAND:Lerp(Color3.new(0, 0, 0), 0.15), Material = Enum.Material.Sandstone, Parent = f })
		part({ Name = "ObeliskTip", Size = Vector3.new(4, 4, 4), CFrame = CFrame.new(p + Vector3.new(0, 48, 0)) * CFrame.Angles(0, math.rad(45), math.rad(45)), Color = GOLD, Material = Enum.Material.Metal, Parent = f })
	end
end

-- 천외봉: 구름바다 위로 하늘에 닿는 흰 봉우리. 둘레에 떠도는 고리와 섬, 꼭대기에서 하늘로 빛기둥. 발치에 시원자의 단
-- 천년 종루: 세 층 누각 꼭대기에 커다란 청동 종. 층마다 빛나는 창과 처마
function LANDMARK.belltower(at: Vector3, f: Instance)
	local BRONZE = Color3.fromRGB(160, 110, 60)
	part({ Name = "BellBase", Size = Vector3.new(40, 4, 40), Position = at + Vector3.new(0, 2, 0), Color = STONE_DARK, Material = Enum.Material.Granite, Parent = f })
	part({ Name = "BellBase2", Size = Vector3.new(34, 3, 34), Position = at + Vector3.new(0, 5.5, 0), Color = STONE, Material = Enum.Material.Marble, Parent = f })
	for i = 0, 3 do
		part({ Name = "BellStep", Size = Vector3.new(14, (i + 1) * 1.75, 3), Position = at + Vector3.new(0, (i + 1) * 0.875, -21.5 - (3 - i) * 3), Color = STONE, Material = Enum.Material.Marble, Parent = f })
	end
	local y = 7
	local w = 26
	for tier = 1, 3 do
		local h = 14 - tier * 2
		part({ Name = "BellWall", Size = Vector3.new(w, h, w), Position = at + Vector3.new(0, y + h / 2, 0), Color = WALLS[1], Material = Enum.Material.Plaster, Parent = f })
		for _, sx in ipairs({ -1, 1 }) do
			for _, sz in ipairs({ -1, 1 }) do
				part({ Name = "BellPillar", Size = Vector3.new(2, h, 2), Position = at + Vector3.new(sx * w / 2, y + h / 2, sz * w / 2), Color = GATE_RED, Material = Enum.Material.Wood, Parent = f })
			end
		end
		for k = 0, 3 do
			local yaw = k * math.pi / 2
			local cf = CFrame.new(at + Vector3.new(0, y + h * 0.55, 0)) * CFrame.Angles(0, yaw, 0) * CFrame.new(0, 0, -w / 2 - 0.05)
			part({ Name = "BellWindow", Size = Vector3.new(w * 0.4, h * 0.4, 0.2), CFrame = cf, Color = WARM, Material = Enum.Material.Neon, CanCollide = false, Parent = f })
		end
		-- 처마: 사방으로 뻗은 기와 판
		local ey = y + h
		part({ Name = "BellEave", Size = Vector3.new(w + 10, 1, w + 10), Position = at + Vector3.new(0, ey + 0.5, 0), Color = ROOF, Material = Enum.Material.Slate, Parent = f })
		part({ Name = "BellEave2", Size = Vector3.new(w + 6, 1, w + 6), Position = at + Vector3.new(0, ey + 1.5, 0), Color = ROOF:Lerp(Color3.new(0, 0, 0), 0.2), Material = Enum.Material.Slate, Parent = f })
		for _, sx in ipairs({ -1, 1 }) do
			for _, sz in ipairs({ -1, 1 }) do
				part({ Name = "EaveTip", Size = Vector3.new(1, 1.4, 1), CFrame = CFrame.new(at + Vector3.new(sx * (w / 2 + 5), ey + 1.3, sz * (w / 2 + 5))) * CFrame.Angles(0, 0, sx * math.rad(-30)), Color = GOLD, Material = Enum.Material.Metal, CanCollide = false, Parent = f })
			end
		end
		y = ey + 2
		w -= 6
	end
	-- 꼭대기 종각: 기둥 넷 위 지붕, 그 아래 매달린 큰 종
	local top = at + Vector3.new(0, y, 0)
	for _, sx in ipairs({ -1, 1 }) do
		for _, sz in ipairs({ -1, 1 }) do
			part({ Name = "BellFrame", Size = Vector3.new(1.6, 16, 1.6), Position = top + Vector3.new(sx * 6, 8, sz * 6), Color = GATE_RED, Material = Enum.Material.Wood, Parent = f })
		end
	end
	part({ Name = "BellRoof", Size = Vector3.new(18, 1.2, 18), Position = top + Vector3.new(0, 16.6, 0), Color = ROOF, Material = Enum.Material.Slate, Parent = f })
	part({ Name = "BellRoof2", Size = Vector3.new(11, 2, 11), Position = top + Vector3.new(0, 18.2, 0), Color = ROOF, Material = Enum.Material.Slate, Parent = f })
	crystal(top + Vector3.new(0, 22, 0), 2.4, GOLD, f)
	disc("BellBody", top + Vector3.new(0, 8, 0), 4.4, 8, BRONZE, Enum.Material.Metal, f, false)
	part({ Name = "BellCrown", Shape = Enum.PartType.Ball, Size = Vector3.new(7.6, 7.6, 7.6), Position = top + Vector3.new(0, 12, 0), Color = BRONZE, Material = Enum.Material.Metal, CanCollide = false, Parent = f })
	disc("BellLip", top + Vector3.new(0, 4.2, 0), 4.9, 0.8, BRONZE:Lerp(GOLD, 0.4), Enum.Material.Metal, f, false)
	disc("BellBand", top + Vector3.new(0, 9.5, 0), 4.6, 0.5, GOLD, Enum.Material.Metal, f, false)
	part({ Name = "BellStriker", Shape = Enum.PartType.Cylinder, Size = Vector3.new(9, 1.2, 1.2), Position = top + Vector3.new(0, 8, -7.5), Color = WOOD, Material = Enum.Material.Wood, CanCollide = false, Parent = f })
	local glow = part({ Name = "BellGlow", Shape = Enum.PartType.Ball, Size = Vector3.new(2, 2, 2), Position = top + Vector3.new(0, 6, 0), Color = WARM, Material = Enum.Material.Neon, Transparency = 0.4, CanCollide = false, Parent = f })
	light(glow, WARM, 40, 2)
	for k = 0, 3 do
		local a = k / 4 * math.pi * 2 + math.pi / 4
		brazier(at + Vector3.new(math.cos(a) * 26, 0, math.sin(a) * 26), 1.2, f)
	end
end

-- 거울 호수: 하늘을 비추는 둥근 호수. 디딤돌이 가운데 섬의 정자로 이어지고, 연잎이 떠 있다
function LANDMARK.mirrorlake(at: Vector3, f: Instance)
	local R = 72
	for k = 0, 47 do
		local a = k / 48 * math.pi * 2
		local p = at + Vector3.new(math.cos(a) * (R + 2), 0.6, math.sin(a) * (R + 2))
		part({ Name = "LakeRim", Size = Vector3.new(3.4, 1.4, R * 0.14), CFrame = CFrame.lookAt(p, at + Vector3.new(0, 0.6, 0)) * CFrame.Angles(0, math.rad(90), 0), Color = STONE, Material = Enum.Material.Granite, Parent = f })
	end
	local water = disc("MirrorWater", at + Vector3.new(0, 0.55, 0), R, 0.3, Color3.fromRGB(120, 165, 205), Enum.Material.Glass, f, false)
	water.Transparency = 0.05
	water.Reflectance = 0.55
	disc("LakeBed", at + Vector3.new(0, 0.2, 0), R, 0.3, Color3.fromRGB(40, 60, 80), Enum.Material.Slate, f, false)
	-- 가운데 섬과 정자
	disc("Isle", at + Vector3.new(0, 1, 0), 14, 1.4, Color3.fromRGB(110, 150, 95), Enum.Material.Grass, f)
	pavilion(at + Vector3.new(0, 1.7, 0), 8, 8, 11, Color3.fromRGB(60, 72, 100), f, Color3.fromRGB(170, 220, 255))
	-- 남쪽 기슭에서 섬까지 디딤돌
	for i = 0, 11 do
		local d = R + 4 - i * 5.2
		if d > 14 then
			local wob = math.sin(i * 1.3) * 3
			disc("SteppingStone", at + Vector3.new(wob, 0.9, d), 2.2, 0.8, Color3.fromRGB(160, 155, 145), Enum.Material.Slate, f)
		end
	end
	-- 연잎과 연꽃
	for k = 0, 21 do
		local a = k * 2.399
		local d = 22 + (k * 13 % 45)
		local p = at + Vector3.new(math.cos(a) * d, 0.75, math.sin(a) * d)
		if math.abs(p.X - at.X) > 6 or p.Z < at.Z then
			disc("LotusPad", p, 1.6 + (k % 3) * 0.4, 0.15, Color3.fromRGB(70, 140, 70), Enum.Material.Grass, f, false)
			if k % 3 == 0 then
				part({ Name = "Lotus", Shape = Enum.PartType.Ball, Size = Vector3.new(1.1, 0.9, 1.1), Position = p + Vector3.new(0.4, 0.5, 0), Color = Color3.fromRGB(255, 160, 200), Material = Enum.Material.Neon, CanCollide = false, Parent = f })
			end
		end
	end
	for k = 0, 7 do
		local a = k / 8 * math.pi * 2 + math.pi / 8
		local p = at + Vector3.new(math.cos(a) * (R + 10), 0, math.sin(a) * (R + 10))
		stoneLantern(p, f, k % 2 == 0)
		tree(at + Vector3.new(math.cos(a + 0.2) * (R + 22), 0, math.sin(a + 0.2) * (R + 22)), 1.6, f, k % 3 == 0)
	end
end

-- 거신의 손: 땅에서 솟은 거대한 돌손이 빛나는 구슬을 받쳐 든다. 둘레는 갈라진 바위
function LANDMARK.gianthand(at: Vector3, f: Instance)
	local ROCKC = Color3.fromRGB(150, 145, 140)
	local cf = CFrame.new(at) * CFrame.Angles(0, math.rad(30), 0)
	local function blk(name: string, size: Vector3, c: CFrame)
		part({ Name = name, Size = size, CFrame = cf * c, Color = ROCKC, Material = Enum.Material.Granite, Parent = f })
	end
	blk("HandWrist", Vector3.new(16, 30, 12), CFrame.new(0, 12, 0) * CFrame.Angles(math.rad(-8), 0, 0))
	blk("HandPalm", Vector3.new(20, 18, 10), CFrame.new(0, 34, -3) * CFrame.Angles(math.rad(-25), 0, 0))
	for i, x in ipairs({ -7.2, -2.4, 2.4, 7.2 }) do
		local len = (i == 2 or i == 3) and 12 or 10
		local base = CFrame.new(x, 44, -7) * CFrame.Angles(math.rad(-40), 0, 0)
		blk("Finger", Vector3.new(4.2, len, 4.2), base * CFrame.new(0, len / 2, 0))
		blk("FingerTip", Vector3.new(3.8, len * 0.8, 3.8), base * CFrame.new(0, len, 0) * CFrame.Angles(math.rad(-35), 0, 0) * CFrame.new(0, len * 0.4, 0))
	end
	blk("Thumb", Vector3.new(5, 12, 5), CFrame.new(-11, 32, -6) * CFrame.Angles(math.rad(-30), 0, math.rad(50)))
	local orb = part({ Name = "HandOrb", Shape = Enum.PartType.Ball, Size = Vector3.new(11, 11, 11), Position = (cf * CFrame.new(0, 47, -14)).Position, Color = Color3.fromRGB(140, 220, 255), Material = Enum.Material.Neon, CanCollide = false, Parent = f })
	light(orb, Color3.fromRGB(140, 220, 255), 70, 3)
	emitter(orb, Color3.fromRGB(190, 240, 255), 16, 1.6, 6, 2)
	-- 갈라진 땅: 둘레로 기울어 솟은 바위판
	for k = 0, 13 do
		local a = k / 14 * math.pi * 2
		local p = at + Vector3.new(math.cos(a) * 26, 0, math.sin(a) * 26)
		part({ Name = "CrackSlab", Size = Vector3.new(10, 2, 7), CFrame = CFrame.lookAt(p, at) * CFrame.Angles(math.rad(-22), 0, 0) + Vector3.new(0, 1, 0), Color = Color3.fromRGB(110, 105, 100), Material = Enum.Material.Slate, Parent = f })
	end
	for k = 0, 5 do
		local a = k / 6 * math.pi * 2 + 0.3
		crystal(at + Vector3.new(math.cos(a) * 38, 4, math.sin(a) * 38), 2, Color3.fromRGB(140, 220, 255), f)
	end
end

-- 별똥 분화구: 솟은 바위 테 안의 검게 탄 바닥, 한가운데 금이 간 운석이 아직 빛난다
function LANDMARK.crater(at: Vector3, f: Instance)
	local R = 60
	disc("CraterFloor", at + Vector3.new(0, 0.3, 0), R, 0.4, Color3.fromRGB(45, 38, 40), Enum.Material.Basalt, f)
	for k = 0, 35 do
		local a = k / 36 * math.pi * 2
		local p = at + Vector3.new(math.cos(a) * R, 0, math.sin(a) * R)
		local h = 6 + (k * 7 % 5)
		part({ Name = "CraterRim", Size = Vector3.new(12, h, 9), CFrame = CFrame.lookAt(p + Vector3.new(0, h / 2 - 1, 0), at + Vector3.new(0, h / 2 - 1, 0)) * CFrame.Angles(math.rad(25), 0, 0), Color = Color3.fromRGB(95, 85, 82), Material = Enum.Material.Rock, Parent = f })
	end
	local meteor = part({ Name = "Meteor", Shape = Enum.PartType.Ball, Size = Vector3.new(22, 22, 22), Position = at + Vector3.new(0, 7, 0), Color = Color3.fromRGB(40, 32, 36), Material = Enum.Material.Basalt, Parent = f })
	local _ = meteor
	for k = 0, 9 do
		local a = k * 0.63
		local d = Vector3.new(math.cos(a), math.sin(k * 1.7) * 0.6, math.sin(a)).Unit
		part({ Name = "MeteorCrack", Size = Vector3.new(0.6, 0.6, 9), CFrame = CFrame.lookAt(at + Vector3.new(0, 7, 0) + d * 10.6, at + Vector3.new(0, 7, 0) + d * 10.6 + Vector3.new(-d.Z, 0.3, d.X)), Color = Color3.fromRGB(255, 120, 60), Material = Enum.Material.Neon, CanCollide = false, Parent = f })
	end
	local core = part({ Name = "MeteorGlow", Shape = Enum.PartType.Ball, Size = Vector3.new(4, 4, 4), Position = at + Vector3.new(0, 19, 0), Color = Color3.fromRGB(255, 140, 70), Material = Enum.Material.Neon, Transparency = 0.6, CanCollide = false, Parent = f })
	light(core, Color3.fromRGB(255, 130, 60), 60, 3)
	emitter(core, Color3.fromRGB(255, 160, 80), 10, 1.2, 5, 2.5)
	for k = 0, 15 do
		local a = k * 2.2
		local d = 18 + (k * 11 % 34)
		crystal(at + Vector3.new(math.cos(a) * d, 1.6, math.sin(a) * d), 1 + (k % 3) * 0.4, k % 2 == 0 and Color3.fromRGB(255, 150, 80) or Color3.fromRGB(190, 140, 255), f)
	end
end

-- 천 개의 계단: 구름 위 떠 있는 문까지 곧게 오르는 긴 돌계단, 계단참마다 석등
function LANDMARK.thousandsteps(at: Vector3, f: Instance)
	local face = Vector3.new(-at.X, 0, -at.Z).Unit -- 마을 쪽에서 오른다
	local cf = CFrame.lookAt(at, at - face)
	local steps = 44
	for i = 0, steps - 1 do
		local y = i * 1.4
		part({ Name = "Step", Size = Vector3.new(16, 1.4, 3.2), CFrame = cf * CFrame.new(0, y + 0.7, -i * 3.2), Color = i % 11 == 10 and STONE_DARK or STONE, Material = Enum.Material.Marble, Parent = f })
		if i % 11 == 10 then
			for _, sx in ipairs({ -1, 1 }) do
				stoneLantern((cf * CFrame.new(sx * 9.5, y + 1.4, -i * 3.2)).Position, f, sx == 1)
			end
		end
	end
	-- 계단 양옆의 난간
	local L = steps * 3.2
	local H = steps * 1.4
	for _, sx in ipairs({ -1, 1 }) do
		local p0 = cf * CFrame.new(sx * 8.6, 1.5, 0)
		local p1 = cf * CFrame.new(sx * 8.6, H + 1.5, -L)
		local mid = (p0.Position + p1.Position) / 2
		part({ Name = "StepRail", Size = Vector3.new(1.2, 1.4, (p1.Position - p0.Position).Magnitude), CFrame = CFrame.lookAt(mid, p1.Position), Color = STONE_DARK, Material = Enum.Material.Granite, Parent = f })
	end
	-- 꼭대기 단과 떠 있는 문
	local topCf = cf * CFrame.new(0, H, -L - 12)
	part({ Name = "StepTop", Size = Vector3.new(30, 2, 24), CFrame = topCf * CFrame.new(0, 0, 0), Color = STONE, Material = Enum.Material.Marble, Parent = f })
	for _, sx in ipairs({ -1, 1 }) do
		part({ Name = "SkyGatePost", Size = Vector3.new(2.4, 22, 2.4), CFrame = topCf * CFrame.new(sx * 9, 13, 0), Color = Color3.fromRGB(235, 235, 245), Material = Enum.Material.Marble, Parent = f })
		crystal((topCf * CFrame.new(sx * 9, 26, 0)).Position, 1.8, Color3.fromRGB(190, 220, 255), f)
	end
	part({ Name = "SkyGateBeam", Size = Vector3.new(26, 2, 3), CFrame = topCf * CFrame.new(0, 23, 0), Color = Color3.fromRGB(235, 235, 245), Material = Enum.Material.Marble, Parent = f })
	local veil = part({ Name = "SkyGateVeil", Size = Vector3.new(15.6, 20, 0.3), CFrame = topCf * CFrame.new(0, 12, 0), Color = Color3.fromRGB(190, 220, 255), Material = Enum.Material.ForceField, Transparency = 0.2, CanCollide = false, Parent = f })
	light(veil, Color3.fromRGB(190, 220, 255), 50, 2.5)
	-- 꼭대기 둘레의 구름
	for k = 0, 9 do
		local a = k / 10 * math.pi * 2
		local p = (topCf * CFrame.new(math.cos(a) * 26, -4 + (k % 3) * 2, math.sin(a) * 20)).Position
		part({ Name = "StepCloud", Shape = Enum.PartType.Ball, Size = Vector3.new(14, 7, 14), Position = p, Color = Color3.fromRGB(245, 247, 252), Material = Enum.Material.SmoothPlastic, Transparency = 0.25, CanCollide = false, Parent = f })
	end
end

-- 일월대: 해와 달의 단. 동쪽엔 금빛 해의 탑, 서쪽엔 은빛 달의 탑, 가운데 반은 금빛·반은 은빛인 단 위에 권존이 선다
function LANDMARK.sunmoon(at: Vector3, f: Instance)
	local m = Config.MASTERS.ilwol
	local center = m and Vector3.new(m.at.X, 0, m.at.Z) or at
	local top = m and m.at.Y or 6
	local DARK = Color3.fromRGB(58, 52, 66)
	local SUN = Color3.fromRGB(255, 190, 70)
	local MOON = Color3.fromRGB(205, 220, 255)
	cyl("SunMoonDais", center + Vector3.new(0, top / 2, 0), 32, top, DARK, Enum.Material.Slate, f)
	cyl("SunMoonDais2", center + Vector3.new(0, top + 0.05, 0), 24, 0.1, Color3.fromRGB(30, 26, 36), Enum.Material.Marble, f, false)
	-- 둘레 띠: 동쪽 반은 해, 서쪽 반은 달
	for k = 0, 35 do
		local a = k / 36 * math.pi * 2
		local p = center + Vector3.new(math.cos(a) * 28, top + 0.12, math.sin(a) * 28)
		part({ Name = "SunMoonRim", Size = Vector3.new(1.2, 0.2, 5.2), CFrame = CFrame.lookAt(p, center + Vector3.new(0, top + 0.12, 0)) * CFrame.Angles(0, math.rad(90), 0), Color = math.cos(a) >= 0 and SUN or MOON, Material = Enum.Material.Neon, CanCollide = false, Parent = f })
	end
	-- 바닥 무늬: 해 쪽 빛살, 달 쪽 초승달
	for k = 0, 7 do
		local a = math.rad(-70 + k * 20)
		local p = center + Vector3.new(math.cos(a) * 12, top + 0.15, math.sin(a) * 12)
		part({ Name = "SunInlay", Size = Vector3.new(0.6, 0.1, 7), CFrame = CFrame.lookAt(p, center + Vector3.new(0, top + 0.15, 0)), Color = SUN, Material = Enum.Material.Neon, CanCollide = false, Parent = f })
		local b = math.rad(110 + k * 20)
		local q = center + Vector3.new(math.cos(b) * 12, top + 0.15, math.sin(b) * 12)
		part({ Name = "MoonInlay", Size = Vector3.new(4, 0.1, 0.8), CFrame = CFrame.lookAt(q, center + Vector3.new(0, top + 0.15, 0)) * CFrame.Angles(0, math.rad(90), 0), Color = MOON, Material = Enum.Material.Neon, CanCollide = false, Parent = f })
	end
	-- 오르는 계단 (남쪽)
	for i = 0, 3 do
		part({ Name = "SunMoonStep", Size = Vector3.new(18, (i + 1) * top / 4, 4), Position = center + Vector3.new(0, (i + 1) * top / 8, 44 - i * 4), Color = DARK, Material = Enum.Material.Slate, Parent = f })
	end
	-- 해의 탑 (동쪽)
	local sunAt = center + Vector3.new(70, 0, 0)
	part({ Name = "SunTower", Size = Vector3.new(9, 64, 9), Position = sunAt + Vector3.new(0, 32, 0), Color = DARK, Material = Enum.Material.Slate, Parent = f })
	cyl("SunTowerBand", sunAt + Vector3.new(0, 62, 0), 7, 2, SUN, Enum.Material.Neon, f, false)
	local sunBall = part({ Name = "SunOrb", Shape = Enum.PartType.Ball, Size = Vector3.new(22, 22, 22), Position = sunAt + Vector3.new(0, 80, 0), Color = SUN, Material = Enum.Material.Neon, CanCollide = false, Parent = f })
	light(sunBall, SUN, 90, 4)
	emitter(sunBall, Color3.fromRGB(255, 220, 140), 18, 2.2, 10, 1.4)
	for k = 0, 15 do
		local a = k / 16 * math.pi * 2
		local p = sunAt + Vector3.new(0, 80, 0) + Vector3.new(0, math.sin(a), math.cos(a)) * 17
		part({ Name = "SunRay", Size = Vector3.new(1, 1, k % 2 == 0 and 9 or 5), CFrame = CFrame.lookAt(p, sunAt + Vector3.new(0, 80, 0)), Color = Color3.fromRGB(255, 225, 150), Material = Enum.Material.Neon, CanCollide = false, Parent = f })
	end
	-- 달의 탑 (서쪽): 은빛 초승달
	local moonAt = center + Vector3.new(-70, 0, 0)
	part({ Name = "MoonTower", Size = Vector3.new(9, 64, 9), Position = moonAt + Vector3.new(0, 32, 0), Color = DARK, Material = Enum.Material.Slate, Parent = f })
	cyl("MoonTowerBand", moonAt + Vector3.new(0, 62, 0), 7, 2, MOON, Enum.Material.Neon, f, false)
	local mc = moonAt + Vector3.new(0, 80, 0)
	for k = 0, 17 do
		local a = math.rad(-120 + k * 13.5)
		local p = mc + Vector3.new(0, math.sin(a), math.cos(a)) * 12
		local thick = 1.2 + 3.2 * (1 - math.abs(k - 8.5) / 8.5) -- 가운데가 가장 두껍다
		part({ Name = "MoonArc", Size = Vector3.new(2.5, math.max(1.2, thick), 4.6), CFrame = CFrame.lookAt(p, mc) * CFrame.Angles(math.rad(90), 0, 0), Color = MOON, Material = Enum.Material.Neon, CanCollide = false, Parent = f })
	end
	local moonGlow = part({ Name = "MoonGlow", Shape = Enum.PartType.Ball, Size = Vector3.new(3, 3, 3), Position = mc, Color = MOON, Material = Enum.Material.Neon, Transparency = 1, CanCollide = false, Parent = f })
	light(moonGlow, MOON, 90, 3)
	-- 두 탑을 잇는 빛줄기 (단 위 하늘에서 만난다)
	for _, from in ipairs({ sunAt, moonAt }) do
		local a0 = from + Vector3.new(0, 80, 0)
		local b0 = center + Vector3.new(0, 70, 0)
		part({ Name = "SunMoonLink", Size = Vector3.new(0.6, 0.6, (b0 - a0).Magnitude), CFrame = CFrame.lookAt((a0 + b0) / 2, b0), Color = from == sunAt and SUN or MOON, Material = Enum.Material.Neon, Transparency = 0.4, CanCollide = false, Parent = f })
	end
	local meet = part({ Name = "EclipseOrb", Shape = Enum.PartType.Ball, Size = Vector3.new(10, 10, 10), Position = center + Vector3.new(0, 70, 0), Color = Color3.fromRGB(12, 8, 16), Material = Enum.Material.SmoothPlastic, CanCollide = false, Parent = f })
	local corona = cyl("EclipseCorona", center + Vector3.new(0, 70, 0), 7.5, 0.4, Color3.fromRGB(255, 235, 180), Enum.Material.Neon, f, false)
	corona.CFrame = CFrame.new(center + Vector3.new(0, 70, 0)) * CFrame.Angles(0, math.rad(90), 0)
	local _ = meet
	-- 단 둘레의 화로 여덟 (반은 금불, 반은 푸른 불)
	for k = 0, 7 do
		local a = k / 8 * math.pi * 2 + math.pi / 8
		local p = center + Vector3.new(math.cos(a) * 40, 0, math.sin(a) * 40)
		part({ Name = "SunMoonPost", Size = Vector3.new(2.5, 9, 2.5), Position = p + Vector3.new(0, 4.5, 0), Color = DARK, Material = Enum.Material.Slate, Parent = f })
		crystal(p + Vector3.new(0, 11, 0), 1.4, math.cos(a) >= 0 and SUN or MOON, f)
	end
end

function LANDMARK.skyspire(at: Vector3, f: Instance)
	local MARBLE = Color3.fromRGB(240, 242, 250)
	local STAR = Color3.fromRGB(150, 205, 255)
	local h = 0
	for i = 0, 13 do
		local r = 40 - i * 2.5
		local seg = 30
		cyl("SpireTier", at + Vector3.new(0, h + seg / 2, 0), r, seg, MARBLE:Lerp(Color3.fromRGB(210, 220, 245), i / 14), Enum.Material.Marble, f)
		cyl("SpireBand", at + Vector3.new(0, h + seg, 0), r + 1.2, 1.4, i % 3 == 0 and GOLD or STAR, Enum.Material.Neon, f, false)
		h += seg
	end
	local crown = part({ Name = "SpireStar", Shape = Enum.PartType.Ball, Size = Vector3.new(16, 16, 16), Position = at + Vector3.new(0, h + 10, 0), Color = Color3.fromRGB(255, 250, 230), Material = Enum.Material.Neon, CanCollide = false, Parent = f })
	light(crown, Color3.fromRGB(255, 245, 220), 120, 5)
	part({ Name = "SkyBeam", Size = Vector3.new(6, 900, 6), Position = at + Vector3.new(0, h + 460, 0), Color = Color3.fromRGB(230, 240, 255), Material = Enum.Material.Neon, Transparency = 0.5, CanCollide = false, Parent = f })
	-- 봉우리를 도는 기운 고리 셋
	for j = 0, 2 do
		local c = at + Vector3.new(0, 120 + j * 110, 0)
		local rr = 90 - j * 20
		for k = 0, 31 do
			local a = k / 32 * math.pi * 2
			part({ Name = "SpireRing", Size = Vector3.new(2, 2, rr * 0.22), CFrame = CFrame.lookAt(c + Vector3.new(math.cos(a) * rr, math.sin(a * 2 + j) * 6, math.sin(a) * rr), c) * CFrame.Angles(0, math.rad(90), 0), Color = k % 4 == 0 and GOLD or STAR, Material = Enum.Material.Neon, CanCollide = false, Parent = f })
		end
	end
	-- 떠 있는 섬들
	for k = 0, 9 do
		local a = k / 10 * math.pi * 2 + 0.2
		local d = rng:NextNumber(150, 300)
		local p = at + Vector3.new(math.cos(a) * d, rng:NextNumber(60, 220), math.sin(a) * d)
		local s = rng:NextNumber(14, 30)
		part({ Name = "IsleRock", Size = Vector3.new(s, s * 0.8, s), CFrame = CFrame.new(p - Vector3.new(0, s * 0.4, 0)) * CFrame.Angles(math.rad(180), rng:NextNumber(0, 6), 0), Color = Color3.fromRGB(150, 145, 160), Material = Enum.Material.Slate, Parent = f })
		part({ Name = "IsleTop", Size = Vector3.new(s * 1.05, 1.5, s * 1.05), Position = p, Color = Color3.fromRGB(150, 200, 140), Material = Enum.Material.Grass, Parent = f })
		crystal(p + Vector3.new(0, 4, 0), 1.6, STAR, f)
	end
	-- 시원자의 단 (남쪽 앞)
	local m = Config.MASTERS.taecho
	if m then
		local d = Vector3.new(m.at.X, 0, m.at.Z)
		cyl("OriginDais", d + Vector3.new(0, m.at.Y / 2, 0), 34, m.at.Y, MARBLE, Enum.Material.Marble, f)
		cyl("OriginRing", d + Vector3.new(0, m.at.Y + 0.06, 0), 26, 0.1, GOLD, Enum.Material.Neon, f, false).Transparency = 0.3
		cyl("OriginStar", d + Vector3.new(0, m.at.Y + 0.08, 0), 14, 0.1, STAR, Enum.Material.Neon, f, false).Transparency = 0.4
		for k = 0, 11 do
			local a = k / 12 * math.pi * 2
			local p = d + Vector3.new(math.cos(a) * 30, 0, math.sin(a) * 30)
			part({ Name = "OriginPillar", Size = Vector3.new(3, 16, 3), Position = p + Vector3.new(0, m.at.Y + 8, 0), Color = MARBLE, Material = Enum.Material.Marble, Parent = f })
			crystal(p + Vector3.new(0, m.at.Y + 18, 0), 1.2, k % 2 == 0 and GOLD or STAR, f)
		end
		for i = 0, 3 do
			part({ Name = "DaisStep", Size = Vector3.new(16, (i + 1) * m.at.Y / 4, 4), Position = d + Vector3.new(0, (i + 1) * m.at.Y / 8, 38 - i * 4), Color = MARBLE, Material = Enum.Material.Marble, Parent = f })
		end
	end
end

-- 혈월곡: 붉은 바위 가시, 핏빛 수정, 두목의 단
local function lair(r: any, f: Instance)
	local c = r.center
	for k = 0, 23 do
		local a = k / 24 * math.pi * 2 + rng:NextNumber(-0.08, 0.08)
		local d = rng:NextNumber(150, 175)
		local h = rng:NextNumber(30, 70)
		local p = Vector3.new(c.X + math.cos(a) * d, h / 2 - 2, c.Z + math.sin(a) * d)
		if not nearRoad(p, 20) then
			part({ Name = "LairSpire", Size = Vector3.new(rng:NextNumber(8, 14), h, rng:NextNumber(8, 14)), CFrame = CFrame.new(p) * CFrame.Angles(rng:NextNumber(-0.2, 0.2), rng:NextNumber(0, 6), rng:NextNumber(-0.2, 0.2)), Color = Color3.fromRGB(70, 35, 38), Material = Enum.Material.Rock, Parent = f })
		end
	end
	local bossAt = r.boss.at
	disc("LairArena", bossAt + Vector3.new(0, 0.6, 0), 34, 1.2, Color3.fromRGB(60, 40, 42), Enum.Material.Slate, f)
	disc("LairRune", bossAt + Vector3.new(0, 1.25, 0), 26, 0.1, Color3.fromRGB(200, 40, 40), Enum.Material.Neon, f, false).Transparency = 0.5
	for k = 0, 5 do
		local a = k / 6 * math.pi * 2
		local p = bossAt + Vector3.new(math.cos(a) * 30, 0, math.sin(a) * 30)
		part({ Name = "LairPillar", Size = Vector3.new(3, 16, 3), Position = p + Vector3.new(0, 8, 0), Color = Color3.fromRGB(50, 30, 32), Material = Enum.Material.Slate, Parent = f })
		crystal(p + Vector3.new(0, 20, 0), 2.6, Color3.fromRGB(255, 50, 50), f)
		banner(p + Vector3.new(4, 0, 0), 12, Color3.fromRGB(140, 20, 25), f)
	end
	for _ = 1, 14 do
		local p = c + Vector3.new(rng:NextNumber(-150, 150), 0, rng:NextNumber(-150, 150))
		if (p - bossAt).Magnitude > 45 and not nearRoad(p, 14) then
			local h = rng:NextNumber(4, 12)
			part({ Name = "BloodCrystal", Size = Vector3.new(h * 0.3, h, h * 0.3), CFrame = CFrame.new(p + Vector3.new(0, h * 0.4, 0)) * CFrame.Angles(rng:NextNumber(-0.3, 0.3), rng:NextNumber(0, 6), rng:NextNumber(-0.3, 0.3)), Color = Color3.fromRGB(220, 40, 50), Material = Enum.Material.Neon, Transparency = 0.15, Parent = f })
		end
	end
end

local function landmarks()
	for _, lm in ipairs(Config.Landmarks) do
		local builder = LANDMARK[lm.id]
		if builder then
			local f = Instance.new("Folder")
			f.Name = "Landmark_" .. lm.id
			f.Parent = folder
			local ok, err = pcall(builder, lm.at, f)
			if not ok then
				warn("[권왕] 랜드마크 오류:", lm.id, err)
			end
		end
	end
	for _, r in ipairs(Config.Regions) do
		if r.id == "lair" then
			local f = Instance.new("Folder")
			f.Name = "Lair"
			f.Parent = folder
			local ok, err = pcall(lair, r, f)
			if not ok then
				warn("[권왕] 혈월곡 오류:", err)
			end
		end
	end
end

------------------------------------------------------------------------
-- 바깥 다섯 땅 (설산, 늪, 황야, 해안, 혈교 본산)
------------------------------------------------------------------------
local function regionById(id: string): any
	for _, r in ipairs(Config.Regions) do
		if r.id == id then
			return r
		end
	end
	return nil
end

local function randIn(r: any, margin: number): Vector3
	return r.center + Vector3.new(rng:NextNumber(-r.size.X / 2 + margin, r.size.X / 2 - margin), 0, rng:NextNumber(-r.size.Z / 2 + margin, r.size.Z / 2 - margin))
end

local function clearOf(p: Vector3, r: any): boolean
	if nearRoad(p, 18) then
		return false
	end
	for _, camp in ipairs(r.camps or {}) do
		if (p - camp.at).Magnitude < 35 then
			return false
		end
	end
	if r.boss and (p - r.boss.at).Magnitude < 60 then
		return false
	end
	return true
end

-- 눈 덮인 침엽수 (층층이 줄어드는 가지)
local function pine(at: Vector3, s: number, parent: Instance, snowy: boolean)
	part({ Name = "PineTrunk", Size = Vector3.new(1.4, 8, 1.4) * s, Position = at + Vector3.new(0, 4 * s, 0), Color = Color3.fromRGB(80, 55, 40), Material = Enum.Material.Wood, Parent = parent })
	for i = 0, 3 do
		local w = (9 - i * 2) * s
		part({ Name = "PineLayer", Size = Vector3.new(w, 2.6 * s, w), CFrame = CFrame.new(at + Vector3.new(0, (5 + i * 2.6) * s, 0)) * CFrame.Angles(0, math.rad(i * 25), 0), Color = Color3.fromRGB(40, 85, 55), Material = Enum.Material.Grass, CanCollide = false, Parent = parent })
		if snowy then
			part({ Name = "PineSnow", Size = Vector3.new(w * 0.9, 0.5 * s, w * 0.9), CFrame = CFrame.new(at + Vector3.new(0, (6.4 + i * 2.6) * s, 0)) * CFrame.Angles(0, math.rad(i * 25), 0), Color = Color3.fromRGB(245, 248, 252), Material = Enum.Material.Snow, CanCollide = false, Parent = parent })
		end
	end
end

local function deadTree(at: Vector3, s: number, parent: Instance)
	part({ Name = "DeadTrunk", Size = Vector3.new(1.2, 12, 1.2) * s, CFrame = CFrame.new(at + Vector3.new(0, 6 * s, 0)) * CFrame.Angles(rng:NextNumber(-0.15, 0.15), 0, rng:NextNumber(-0.15, 0.15)), Color = Color3.fromRGB(60, 55, 45), Material = Enum.Material.Wood, Parent = parent })
	for k = 1, 3 do
		local a = rng:NextNumber(0, math.pi * 2)
		local from = at + Vector3.new(0, (6 + k * 2) * s, 0)
		local to = from + Vector3.new(math.cos(a) * 5 * s, 2.5 * s, math.sin(a) * 5 * s)
		part({ Name = "DeadBranch", Size = Vector3.new(0.5 * s, 0.5 * s, (to - from).Magnitude), CFrame = CFrame.lookAt((from + to) / 2, to), Color = Color3.fromRGB(60, 55, 45), Material = Enum.Material.Wood, CanCollide = false, Parent = parent })
	end
end

local OUTER: { [string]: (r: any, f: Instance) -> () } = {}

function OUTER.snow(r: any, f: Instance)
	for _ = 1, 70 do
		local p = randIn(r, 20)
		if clearOf(p, r) then
			pine(p, rng:NextNumber(1.2, 2.2), f, true)
		end
	end
	for _ = 1, 22 do
		local p = randIn(r, 20)
		if clearOf(p, r) then
			local h = rng:NextNumber(6, 18)
			part({ Name = "IceSpike", Size = Vector3.new(h * 0.3, h, h * 0.3), CFrame = CFrame.new(p + Vector3.new(0, h * 0.4, 0)) * CFrame.Angles(rng:NextNumber(-0.25, 0.25), rng:NextNumber(0, 6), rng:NextNumber(-0.25, 0.25)), Color = Color3.fromRGB(170, 220, 245), Material = Enum.Material.Glass, Transparency = 0.25, Parent = f })
		end
	end
	disc("FrozenLake", Vector3.new(r.center.X + 300, 0.3, r.center.Z + 120), 70, 0.4, Color3.fromRGB(190, 225, 245), Enum.Material.Ice, f)
	-- 빙마의 얼음 옥좌
	local b = r.boss.at
	disc("IceThrone", b + Vector3.new(0, 0.6, 0), 34, 1.2, Color3.fromRGB(200, 230, 250), Enum.Material.Ice, f)
	for k = 0, 7 do
		local a = k / 8 * math.pi * 2
		local p = b + Vector3.new(math.cos(a) * 30, 0, math.sin(a) * 30)
		part({ Name = "IcePillar", Size = Vector3.new(3, 18, 3), CFrame = CFrame.new(p + Vector3.new(0, 9, 0)) * CFrame.Angles(0, a, 0.1), Color = Color3.fromRGB(170, 215, 245), Material = Enum.Material.Glass, Transparency = 0.2, Parent = f })
	end
	crystal(b + Vector3.new(0, 26, 0), 5, Color3.fromRGB(160, 220, 255), f)
end

function OUTER.swamp(r: any, f: Instance)
	for _ = 1, 26 do
		local p = randIn(r, 30)
		if clearOf(p, r) then
			disc("BogPool", p + Vector3.new(0, 0.35, 0), rng:NextNumber(10, 26), 0.3, Color3.fromRGB(45, 70, 50), Enum.Material.Glass, f, false).Transparency = 0.2
		end
	end
	for _ = 1, 55 do
		local p = randIn(r, 20)
		if clearOf(p, r) then
			deadTree(p, rng:NextNumber(1, 1.8), f)
		end
	end
	-- 자욱한 독안개
	for _ = 1, 8 do
		local fog = part({ Name = "SwampFog", Size = Vector3.new(120, 4, 120), Position = randIn(r, 60) + Vector3.new(0, 3, 0), Transparency = 1, CanCollide = false, Parent = f })
		local e = Instance.new("ParticleEmitter")
		e.Rate = 6
		e.Color = ColorSequence.new(Color3.fromRGB(140, 180, 110))
		e.Size = NumberSequence.new(14, 22)
		e.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.5, 0.8), NumberSequenceKeypoint.new(1, 1) })
		e.Lifetime = NumberRange.new(8, 12)
		e.Speed = NumberRange.new(0.5, 1.5)
		e.Parent = fog
	end
	-- 무너진 사당 (비급 조각이 있다)
	local ruin = Vector3.new(320, 0, 1700)
	part({ Name = "RuinBase", Size = Vector3.new(26, 1.2, 26), Position = ruin + Vector3.new(0, 0.6, 0), Color = Color3.fromRGB(90, 95, 80), Material = Enum.Material.Cobblestone, Parent = f })
	for k = 0, 3 do
		local a = k / 4 * math.pi * 2 + 0.6
		local h = rng:NextNumber(5, 12)
		part({ Name = "RuinPillar", Size = Vector3.new(2, h, 2), Position = ruin + Vector3.new(math.cos(a) * 10, h / 2, math.sin(a) * 10), Color = Color3.fromRGB(100, 105, 90), Material = Enum.Material.Cobblestone, Parent = f })
	end
end

function OUTER.badlands(r: any, f: Instance)
	for _ = 1, 18 do
		local p = randIn(r, 50)
		if clearOf(p, r) then
			local h = rng:NextNumber(25, 70)
			local w = rng:NextNumber(30, 60)
			part({ Name = "Mesa", Size = Vector3.new(w, h, w * rng:NextNumber(0.7, 1.3)), CFrame = CFrame.new(p + Vector3.new(0, h / 2, 0)) * CFrame.Angles(0, rng:NextNumber(0, 3), 0), Color = Color3.fromRGB(175, 95, 60):Lerp(Color3.fromRGB(210, 140, 90), rng:NextNumber()), Material = Enum.Material.Sand, Parent = f })
			part({ Name = "MesaTop", Size = Vector3.new(w * 1.05, 3, w * 1.05), Position = p + Vector3.new(0, h + 1.5, 0), Color = Color3.fromRGB(150, 80, 50), Material = Enum.Material.Slate, Parent = f })
		end
	end
	for _ = 1, 40 do
		local p = randIn(r, 20)
		if clearOf(p, r) then
			local h = rng:NextNumber(4, 12)
			part({ Name = "RockPillar", Size = Vector3.new(h * 0.35, h, h * 0.35), CFrame = CFrame.new(p + Vector3.new(0, h / 2, 0)) * CFrame.Angles(0, rng:NextNumber(0, 3), rng:NextNumber(-0.15, 0.15)), Color = Color3.fromRGB(160, 90, 55), Material = Enum.Material.Rock, Parent = f })
		end
	end
end

function OUTER.coast(r: any, f: Instance)
	-- 서쪽은 바다
	local W = Config.WORLD_HALF
	local seaX = r.center.X - r.size.X / 2 - 160
	for k = -2, 2 do
		part({ Name = "Sea", Size = Vector3.new(320, 1, 960), Position = Vector3.new(seaX, -0.4, k * 960), Color = Color3.fromRGB(40, 100, 150), Material = Enum.Material.Glass, Transparency = 0.15, CanCollide = false, Parent = f })
	end
	local _ = W
	-- 바다 쪽 벼랑
	for k = -12, 12 do
		local h = rng:NextNumber(18, 40)
		part({ Name = "SeaCliff", Size = Vector3.new(30, h, 52), CFrame = CFrame.new(r.center.X - r.size.X / 2 + 10, h / 2 - 8, k * 48) * CFrame.Angles(0, rng:NextNumber(-0.1, 0.1), 0), Color = Color3.fromRGB(120, 115, 105), Material = Enum.Material.Rock, Parent = f })
	end
	-- 난파선
	local wreck = Vector3.new(-1880, 0, -60)
	part({ Name = "WreckHull", Size = Vector3.new(14, 8, 50), CFrame = CFrame.new(wreck + Vector3.new(0, 3, 0)) * CFrame.Angles(0, 0.4, math.rad(18)), Color = Color3.fromRGB(90, 60, 40), Material = Enum.Material.WoodPlanks, Parent = f })
	part({ Name = "WreckMast", Size = Vector3.new(1.6, 30, 1.6), CFrame = CFrame.new(wreck + Vector3.new(2, 14, 4)) * CFrame.Angles(0.2, 0, 0.5), Color = Color3.fromRGB(80, 55, 35), Material = Enum.Material.Wood, Parent = f })
	part({ Name = "WreckSail", Size = Vector3.new(0.2, 14, 16), CFrame = CFrame.new(wreck + Vector3.new(6, 18, 4)) * CFrame.Angles(0.2, 0, 0.5), Color = Color3.fromRGB(200, 190, 160), Material = Enum.Material.Fabric, CanCollide = false, Parent = f })
	for _ = 1, 30 do
		local p = randIn(r, 30)
		if clearOf(p, r) and p.X > r.center.X - r.size.X / 2 + 50 then
			rock(p, rng:NextNumber(3, 9), f, Color3.fromRGB(140, 135, 120))
		end
	end
end

function OUTER.cult(r: any, f: Instance)
	local c = r.center
	local half = 260
	-- 붉은 성벽과 정문
	for _, side in ipairs({ { 1, 0 }, { -1, 0 }, { 0, 1 }, { 0, -1 } }) do
		for _, seg in ipairs({ -1, 1 }) do
			local len = half - 16
			local along = seg * (16 + len / 2)
			local pos = side[1] ~= 0 and Vector3.new(c.X + side[1] * half, 9, c.Z + along) or Vector3.new(c.X + along, 9, c.Z + side[2] * half)
			local size = side[1] ~= 0 and Vector3.new(6, 18, len) or Vector3.new(len, 18, 6)
			part({ Name = "CultWall", Size = size, Position = pos, Color = Color3.fromRGB(70, 25, 28), Material = Enum.Material.Slate, Parent = f })
			part({ Name = "CultWallTrim", Size = size + Vector3.new(0.4, -16, 0.4), Position = pos + Vector3.new(0, 9.5, 0), Color = Color3.fromRGB(160, 30, 40), Material = Enum.Material.Neon, Transparency = 0.3, CanCollide = false, Parent = f })
		end
	end
	for _, sx in ipairs({ -1, 1 }) do
		for _, sz in ipairs({ -1, 1 }) do
			spire(Vector3.new(c.X + sx * half, 0, c.Z + sz * half), 3, 7, Color3.fromRGB(255, 50, 60), f)
		end
	end
	monumentGate(Vector3.new(c.X, 0, c.Z + half + 10), 0, f, "혈교 본산", Color3.fromRGB(230, 40, 50))
	-- 혈마의 제단
	local b = r.boss.at
	disc("BloodAltar", b + Vector3.new(0, 1, 0), 38, 2, Color3.fromRGB(50, 20, 22), Enum.Material.Slate, f)
	disc("BloodRune", b + Vector3.new(0, 2.05, 0), 28, 0.1, Color3.fromRGB(220, 30, 40), Enum.Material.Neon, f, false).Transparency = 0.4
	for k = 0, 5 do
		local a = k / 6 * math.pi * 2
		local p = b + Vector3.new(math.cos(a) * 34, 0, math.sin(a) * 34)
		brazier(p, 1.6, f)
		banner(p + Vector3.new(3, 0, 0), 16, Color3.fromRGB(140, 15, 25), f)
	end
	for _ = 1, 20 do
		local p = randIn(r, 40)
		if clearOf(p, r) then
			local h = rng:NextNumber(5, 14)
			part({ Name = "BloodCrystal", Size = Vector3.new(h * 0.3, h, h * 0.3), CFrame = CFrame.new(p + Vector3.new(0, h * 0.4, 0)) * CFrame.Angles(rng:NextNumber(-0.3, 0.3), rng:NextNumber(0, 6), rng:NextNumber(-0.3, 0.3)), Color = Color3.fromRGB(220, 40, 50), Material = Enum.Material.Neon, Transparency = 0.15, Parent = f })
		end
	end
end

-- 허공 균열: 갈라진 땅, 떠 있는 바위, 보랏빛 균열, 천마의 제단
function OUTER.rift(r: any, f: Instance)
	local c = r.center
	local VOID = Color3.fromRGB(150, 90, 255)
	-- 땅을 가르는 빛나는 균열
	for _ = 1, 14 do
		local p = randIn(r, 30)
		if clearOf(p, r) then
			local len = rng:NextNumber(30, 90)
			part({ Name = "RiftCrack", Size = Vector3.new(rng:NextNumber(1.5, 4), 0.3, len), CFrame = CFrame.new(p + Vector3.new(0, 0.2, 0)) * CFrame.Angles(0, rng:NextNumber(0, math.pi), 0), Color = VOID, Material = Enum.Material.Neon, CanCollide = false, Parent = f })
		end
	end
	-- 하늘에 뜬 부서진 바위
	for _ = 1, 26 do
		local p = randIn(r, 20)
		local s = rng:NextNumber(6, 22)
		part({ Name = "FloatingRock", Size = Vector3.new(s, s * 0.7, s * 0.9), CFrame = CFrame.new(p + Vector3.new(0, rng:NextNumber(40, 120), 0)) * CFrame.Angles(rng:NextNumber(0, 6), rng:NextNumber(0, 6), rng:NextNumber(0, 6)), Color = Color3.fromRGB(60, 50, 75), Material = Enum.Material.Slate, Parent = f })
	end
	-- 보랏빛 수정 기둥
	for _ = 1, 18 do
		local p = randIn(r, 40)
		if clearOf(p, r) then
			local h = rng:NextNumber(8, 26)
			part({ Name = "VoidCrystal", Size = Vector3.new(h * 0.25, h, h * 0.25), CFrame = CFrame.new(p + Vector3.new(0, h * 0.4, 0)) * CFrame.Angles(rng:NextNumber(-0.4, 0.4), rng:NextNumber(0, 6), rng:NextNumber(-0.4, 0.4)), Color = VOID, Material = Enum.Material.Neon, Transparency = 0.2, Parent = f })
		end
	end
	for _, sx in ipairs({ -1, 1 }) do
		for _, sz in ipairs({ -1, 1 }) do
			spire(Vector3.new(c.X + sx * 270, 0, c.Z + sz * 270), 4, 7, VOID, f)
		end
	end
	monumentGate(Vector3.new(c.X + 360, 0, c.Z), math.rad(90), f, "허공 균열", VOID)
	-- 천마의 제단: 하늘로 열린 검은 고리
	local b = r.boss.at
	disc("RiftAltar", b + Vector3.new(0, 1, 0), 40, 2, Color3.fromRGB(30, 20, 45), Enum.Material.Slate, f)
	disc("RiftRune", b + Vector3.new(0, 2.05, 0), 30, 0.1, VOID, Enum.Material.Neon, f, false).Transparency = 0.35
	local ringC = b + Vector3.new(0, 70, 0)
	for k = 0, 23 do
		local a = k / 24 * math.pi * 2
		part({ Name = "SkyRiftRing", Size = Vector3.new(4, 4, 9), CFrame = CFrame.lookAt(ringC + Vector3.new(math.cos(a) * 34, 0, math.sin(a) * 34), ringC) , Color = k % 2 == 0 and VOID or Color3.fromRGB(20, 10, 30), Material = Enum.Material.Neon, CanCollide = false, Parent = f })
	end
	local hole = part({ Name = "SkyRiftCore", Shape = Enum.PartType.Ball, Size = Vector3.new(40, 40, 40), Position = ringC, Color = Color3.new(0, 0, 0), Material = Enum.Material.SmoothPlastic, CanCollide = false, Parent = f })
	light(hole, VOID, 80, 3)
	for k = 0, 7 do
		local a = k / 8 * math.pi * 2
		brazier(b + Vector3.new(math.cos(a) * 36, 0, math.sin(a) * 36), 1.6, f)
	end
end

-- 화염산: 검은 현무암, 갈라진 용암 틈, 타 버린 나무, 연기 나는 구멍. 염제의 흑요석 제단
function OUTER.volcano(r: any, f: Instance)
	local LAVA = Color3.fromRGB(255, 110, 30)
	for _ = 1, 16 do
		local p = randIn(r, 30)
		if clearOf(p, r) then
			part({ Name = "LavaCrack", Size = Vector3.new(rng:NextNumber(1.5, 3.5), 0.3, rng:NextNumber(25, 70)), CFrame = CFrame.new(p + Vector3.new(0, 0.2, 0)) * CFrame.Angles(0, rng:NextNumber(0, math.pi), 0), Color = LAVA, Material = Enum.Material.Neon, CanCollide = false, Parent = f })
		end
	end
	for _ = 1, 30 do
		local p = randIn(r, 20)
		if clearOf(p, r) then
			rock(p, rng:NextNumber(4, 12), f, Color3.fromRGB(45, 38, 36))
		end
	end
	for _ = 1, 20 do
		local p = randIn(r, 20)
		if clearOf(p, r) then
			deadTree(p, rng:NextNumber(1, 1.8), f)
		end
	end
	for _ = 1, 8 do
		local p = randIn(r, 40)
		if clearOf(p, r) then
			local vent = cyl("SmokeVent", p + Vector3.new(0, 1, 0), 3, 2, Color3.fromRGB(40, 32, 30), Enum.Material.Basalt, f)
			emitter(vent, Color3.fromRGB(80, 75, 75), 6, 5, 8, 4)
		end
	end
	local b = r.boss.at
	disc("ObsidianAltar", b + Vector3.new(0, 1, 0), 42, 2, Color3.fromRGB(25, 20, 28), Enum.Material.Glass, f)
	disc("FireRune", b + Vector3.new(0, 2.05, 0), 32, 0.1, LAVA, Enum.Material.Neon, f, false).Transparency = 0.35
	for k = 0, 7 do
		local a = k / 8 * math.pi * 2
		brazier(b + Vector3.new(math.cos(a) * 38, 0, math.sin(a) * 38), 1.8, f)
	end
	monumentGate(Vector3.new(r.center.X - r.size.X / 2 + 30, 0, r.center.Z + 100), math.rad(90), f, "화염산", LAVA)
end

-- 사왕릉: 모래 언덕, 무너진 기둥과 벽, 반쯤 묻힌 석상. 사왕의 뜰
function OUTER.tomb(r: any, f: Instance)
	local SAND = Color3.fromRGB(210, 182, 128)
	for _ = 1, 26 do
		local p = randIn(r, 30)
		if clearOf(p, r) then
			local s = rng:NextNumber(30, 70)
			part({ Name = "Dune", Shape = Enum.PartType.Ball, Size = Vector3.new(s, s * 0.35, s * 1.4), CFrame = CFrame.new(p - Vector3.new(0, s * 0.1, 0)) * CFrame.Angles(0, rng:NextNumber(0, 6), 0), Color = SAND, Material = Enum.Material.Sand, Parent = f })
		end
	end
	for _ = 1, 26 do
		local p = randIn(r, 30)
		if clearOf(p, r) then
			local h = rng:NextNumber(6, 22)
			part({ Name = "RuinColumn", Size = Vector3.new(3.5, h, 3.5), CFrame = CFrame.new(p + Vector3.new(0, h / 2 - 1, 0)) * CFrame.Angles(rng:NextNumber(-0.12, 0.12), 0, rng:NextNumber(-0.12, 0.12)), Color = Color3.fromRGB(200, 175, 125), Material = Enum.Material.Sandstone, Parent = f })
			if rng:NextNumber() < 0.4 then
				part({ Name = "FallenDrum", Size = Vector3.new(3.4, 3.4, 6), CFrame = CFrame.new(p + Vector3.new(4, 1.5, 3)) * CFrame.Angles(0, rng:NextNumber(0, 6), 0), Color = Color3.fromRGB(195, 170, 120), Material = Enum.Material.Sandstone, Parent = f })
			end
		end
	end
	for _ = 1, 8 do
		local p = randIn(r, 40)
		if clearOf(p, r) then
			local w = rng:NextNumber(14, 30)
			part({ Name = "RuinWall", Size = Vector3.new(w, rng:NextNumber(5, 12), 2.5), CFrame = CFrame.new(p + Vector3.new(0, 3, 0)) * CFrame.Angles(0, rng:NextNumber(0, 6), 0), Color = Color3.fromRGB(190, 165, 115), Material = Enum.Material.Sandstone, Parent = f })
		end
	end
	local b = r.boss.at
	disc("RoyalCourt", b + Vector3.new(0, 0.8, 0), 44, 1.6, Color3.fromRGB(220, 195, 140), Enum.Material.Sandstone, f)
	disc("RoyalSeal", b + Vector3.new(0, 1.65, 0), 30, 0.1, GOLD, Enum.Material.Neon, f, false).Transparency = 0.45
	for k = 0, 9 do
		local a = k / 10 * math.pi * 2
		local p = b + Vector3.new(math.cos(a) * 46, 0, math.sin(a) * 46)
		part({ Name = "CourtPillar", Size = Vector3.new(4, 20, 4), Position = p + Vector3.new(0, 10, 0), Color = Color3.fromRGB(215, 190, 135), Material = Enum.Material.Sandstone, Parent = f })
		part({ Name = "PillarGold", Size = Vector3.new(4.6, 1.2, 4.6), Position = p + Vector3.new(0, 20.6, 0), Color = GOLD, Material = Enum.Material.Metal, Parent = f })
	end
end

-- 천외봉 운해: 발밑까지 내려온 구름, 흰 대리석 폐허, 빛의 기둥과 별 수정. 천문장의 하늘 문
function OUTER.skysea(r: any, f: Instance)
	local STAR = Color3.fromRGB(150, 205, 255)
	for _ = 1, 60 do
		local p = randIn(r, 10)
		if clearOf(p, r) then
			local s = rng:NextNumber(10, 26)
			part({ Name = "CloudPuff", Shape = Enum.PartType.Ball, Size = Vector3.new(s, s * 0.5, s), Position = p + Vector3.new(0, rng:NextNumber(-1, 3), 0), Color = Color3.fromRGB(250, 252, 255), Material = Enum.Material.SmoothPlastic, Transparency = 0.2, CanCollide = false, Parent = f })
		end
	end
	for _ = 1, 22 do
		local p = randIn(r, 30)
		if clearOf(p, r) then
			local h = rng:NextNumber(10, 28)
			part({ Name = "SkyColumn", Size = Vector3.new(3.5, h, 3.5), Position = p + Vector3.new(0, h / 2, 0), Color = Color3.fromRGB(240, 242, 250), Material = Enum.Material.Marble, Parent = f })
			part({ Name = "SkyCapital", Size = Vector3.new(5, 1.4, 5), Position = p + Vector3.new(0, h + 0.7, 0), Color = GOLD, Material = Enum.Material.Metal, Parent = f })
		end
	end
	for _ = 1, 16 do
		local p = randIn(r, 40)
		if clearOf(p, r) then
			crystal(p + Vector3.new(0, rng:NextNumber(3, 8), 0), rng:NextNumber(1.2, 2.4), STAR, f)
		end
	end
	for _ = 1, 6 do
		local p = randIn(r, 60)
		if clearOf(p, r) then
			part({ Name = "LightPillar", Size = Vector3.new(3, 140, 3), Position = p + Vector3.new(0, 70, 0), Color = Color3.fromRGB(235, 245, 255), Material = Enum.Material.Neon, Transparency = 0.6, CanCollide = false, Parent = f })
		end
	end
	local b = r.boss.at
	disc("HeavenCourt", b + Vector3.new(0, 1, 0), 46, 2, Color3.fromRGB(245, 246, 252), Enum.Material.Marble, f)
	disc("HeavenRune", b + Vector3.new(0, 2.05, 0), 34, 0.1, STAR, Enum.Material.Neon, f, false).Transparency = 0.35
	monumentGate(b + Vector3.new(0, 0, 60), 0, f, "천외봉", STAR)
end

-- 숨은 사부의 자리: 세상 끝 구석, 구름이 땅에 닿는 작은 절벽 (표지도, 지도도 없다)
local function secretSite()
	local sm = Config.SECRET_MASTER
	if not sm then
		return
	end
	local f = Instance.new("Folder")
	f.Name = "SecretSite"
	f.Parent = folder
	local at = Vector3.new(sm.at.X, 0, sm.at.Z)
	local STAR = Color3.fromRGB(180, 215, 255)
	disc("CloudFloor", at + Vector3.new(0, 0.6, 0), 34, 1.2, Color3.fromRGB(235, 240, 250), Enum.Material.SmoothPlastic, f)
	disc("StarCircle", at + Vector3.new(0, 1.25, 0), 12, 0.1, STAR, Enum.Material.Neon, f, false).Transparency = 0.4
	-- 구름 (흰 공을 겹쳐 둥실)
	for _ = 1, 40 do
		local a = rng:NextNumber(0, math.pi * 2)
		local d = rng:NextNumber(18, 60)
		local s = rng:NextNumber(8, 18)
		part({ Name = "Cloud", Shape = Enum.PartType.Ball, Size = Vector3.new(s, s * 0.6, s), Position = at + Vector3.new(math.cos(a) * d, rng:NextNumber(0, 6), math.sin(a) * d), Color = Color3.fromRGB(245, 248, 255), Material = Enum.Material.SmoothPlastic, Transparency = 0.25, CanCollide = false, Parent = f })
	end
	-- 별을 매단 고목 하나
	part({ Name = "OldTree", Size = Vector3.new(3, 22, 3), Position = at + Vector3.new(14, 11, 6), Color = Color3.fromRGB(90, 70, 55), Material = Enum.Material.Wood, Parent = f })
	for k = 1, 9 do
		crystal(at + Vector3.new(14 + rng:NextNumber(-8, 8), 18 + rng:NextNumber(0, 10), 6 + rng:NextNumber(-8, 8)), 0.8, STAR, f)
		local _ = k
	end
	-- 노인이 앉는 바위
	part({ Name = "SitRock", Size = Vector3.new(6, 1.6, 6), Position = at + Vector3.new(0, 1.2, 0), Color = Color3.fromRGB(120, 120, 130), Material = Enum.Material.Slate, Parent = f })
end

local function outerLands()
	for id, builder in pairs(OUTER) do
		local r = regionById(id)
		if r then
			local f = Instance.new("Folder")
			f.Name = "Land_" .. id
			f.Parent = folder
			local ok, err = pcall(builder, r, f)
			if not ok then
				warn("[권왕] 바깥 땅 오류:", id, err)
			end
		end
	end
end

------------------------------------------------------------------------
-- 적의 진: 모닥불, 천막, 상자 (적이 뜬금없이 서 있지 않게)
------------------------------------------------------------------------
local function camps()
	local f = Instance.new("Folder")
	f.Name = "Camps"
	f.Parent = folder
	for _, r in ipairs(Config.Regions) do
		for _, camp in ipairs(r.camps or {}) do
			local c = camp.at
			local fire = part({ Name = "Campfire", Shape = Enum.PartType.Ball, Size = Vector3.new(1.6, 1.6, 1.6), Position = c + Vector3.new(0, 0.8, 0), Color = Color3.fromRGB(255, 140, 50), Material = Enum.Material.Neon, CanCollide = false, Parent = f })
			local flame = Instance.new("Fire")
			flame.Size = 5
			flame.Heat = 6
			flame.Parent = fire
			light(fire, Color3.fromRGB(255, 150, 70), 20, 1.5)
			for k = 0, 5 do
				local a = k / 6 * math.pi * 2
				part({ Name = "FireStone", Size = Vector3.new(1.2, 0.8, 1.2), Position = c + Vector3.new(math.cos(a) * 2, 0.4, math.sin(a) * 2), Color = Color3.fromRGB(110, 105, 100), Material = Enum.Material.Slate, Parent = f })
			end
			for k = 0, 1 do
				local a = rng:NextNumber(0, math.pi * 2)
				local p = c + Vector3.new(math.cos(a), 0, math.sin(a)) * 14
				if not nearRoad(p, 12) then
					part({ Name = "CampTent", Size = Vector3.new(9, 6.5, 8), CFrame = CFrame.new(p + Vector3.new(0, 2.4, 0)) * CFrame.Angles(0, a, math.rad(45)), Color = Color3.fromRGB(130, 110, 85):Lerp(Color3.fromRGB(90, 60, 50), k * 0.5), Material = Enum.Material.Fabric, Parent = f })
				end
				local q = c + Vector3.new(math.cos(a + 1.5), 0, math.sin(a + 1.5)) * 8
				part({ Name = "Crate", Size = Vector3.new(2.6, 2.6, 2.6), CFrame = CFrame.new(q + Vector3.new(0, 1.3, 0)) * CFrame.Angles(0, rng:NextNumber(0, 1.5), 0), Color = Color3.fromRGB(120, 85, 50), Material = Enum.Material.WoodPlanks, Parent = f })
			end
		end
	end
end

------------------------------------------------------------------------
-- 비급 조각 (외진 곳에 숨은 빛나는 두루마리)
------------------------------------------------------------------------
local function fragments(out: any)
	local f = Instance.new("Folder")
	f.Name = "Fragments"
	f.Parent = folder
	out.fragments = {}
	for i, frag in ipairs(Config.Fragments) do
		local at = frag.at
		local stand = part({ Name = "FragmentStand", Size = Vector3.new(2.4, 2, 2.4), Position = at + Vector3.new(0, 1, 0), Color = STONE_DARK, Material = Enum.Material.Granite, Parent = f })
		local scroll = disc("FragmentScroll", at + Vector3.new(0, 2.6, 0), 0.5, 2.2, Color3.fromRGB(255, 225, 140), Enum.Material.Neon, f, false)
		light(scroll, Color3.fromRGB(255, 220, 140), 14, 1.5)
		local e = Instance.new("ParticleEmitter")
		e.Rate = 6
		e.Color = ColorSequence.new(Color3.fromRGB(255, 230, 150))
		e.LightEmission = 1
		e.Size = NumberSequence.new(0.3, 0)
		e.Speed = NumberRange.new(1, 3)
		e.Lifetime = NumberRange.new(1, 2)
		e.Parent = scroll
		table.insert(out.fragments, prompt(stand, "줍기", "비급 조각 " .. i, "Fragment"))
	end
end

------------------------------------------------------------------------
-- 땅의 높낮이 (로블록스 지형): 세상 끝을 두른 산맥과 들판의 언덕
------------------------------------------------------------------------
local function terrainHills()
	local terrain = workspace:FindFirstChildOfClass("Terrain")
	if not terrain then
		return
	end
	local W = Config.WORLD_HALF
	local function inRegion(p: Vector3, pad: number): boolean
		for _, r in ipairs(Config.Regions) do
			if not r.noGround and math.abs(p.X - r.center.X) < r.size.X / 2 + pad and math.abs(p.Z - r.center.Z) < r.size.Z / 2 + pad then
				return true
			end
		end
		for _, lm in ipairs(Config.Landmarks) do
			if (p - lm.at).Magnitude < 120 then
				return true
			end
		end
		local sm = Config.SECRET_MASTER
		if sm and Vector3.new(p.X - sm.at.X, 0, p.Z - sm.at.Z).Magnitude < 160 + pad then
			return true
		end
		return false
	end
	-- 세상 끝 산맥 (북쪽은 눈, 동쪽은 붉은 바위, 서쪽은 바다라 낮게)
	for k = 0, 59 do
		local a = k / 60 * math.pi * 2
		local p = Vector3.new(math.cos(a) * (W - 60), 0, math.sin(a) * (W - 60))
		-- 구석의 땅 (혈교 본산, 허공 균열, 숨은 사부)으로 가는 길은 산을 비운다
		local open = inRegion(p, 200)
		for _, corner in ipairs({ Vector3.new(1750, 0, -1750), Vector3.new(-1750, 0, -1750), Config.SECRET_MASTER and Config.SECRET_MASTER.at or Vector3.zero }) do
			if Vector3.new(p.X - corner.X, 0, p.Z - corner.Z).Magnitude < 700 then
				open = true
			end
		end
		if p.X > -W + 400 and not open then
			local rad = rng:NextNumber(140, 260)
			local mat = p.Z < -W * 0.5 and Enum.Material.Snow or (p.X > W * 0.5 and Enum.Material.Sandstone or Enum.Material.Rock)
			pcall(function()
				terrain:FillBall(p - Vector3.new(0, rad * 0.35, 0), rad, mat)
			end)
		end
	end
	-- 들판의 완만한 언덕
	local made = 0
	for _ = 1, 160 do
		if made >= 75 then
			break
		end
		local p = Vector3.new(rng:NextNumber(-W + 300, W - 300), 0, rng:NextNumber(-W + 300, W - 300))
		local rad = rng:NextNumber(40, 90)
		if not inRegion(p, rad + 20) and not nearRoad(p, rad + 25) then
			made += 1
			pcall(function()
				terrain:FillBall(p - Vector3.new(0, rad * 0.7, 0), rad, Enum.Material.Grass)
			end)
		end
	end
end

------------------------------------------------------------------------
-- 지역 이름 표지
------------------------------------------------------------------------
------------------------------------------------------------------------
-- 정갈한 강호: 길가의 석등과 가로수, 지역마다 낮은 돌테두리와 길이 드는 곳의 문루
------------------------------------------------------------------------
local VILLAGE_PAD = 260 -- 마을 성벽 둘레는 마을 것으로 둔다
local function inAnyRegion(p: Vector3, pad: number): boolean
	if math.abs(p.X) < VILLAGE_PAD + pad and math.abs(p.Z) < VILLAGE_PAD + pad then
		return true
	end
	for _, r in ipairs(Config.Regions) do
		if not r.noGround and math.abs(p.X - r.center.X) < r.size.X / 2 + pad and math.abs(p.Z - r.center.Z) < r.size.Z / 2 + pad then
			return true
		end
	end
	return false
end
local function nearFeature(p: Vector3, d: number): boolean
	for _, lm in ipairs(Config.Landmarks) do
		if (Vector3.new(p.X, 0, p.Z) - Vector3.new(lm.at.X, 0, lm.at.Z)).Magnitude < 90 + d then
			return true
		end
	end
	for _, r in ipairs(Config.Regions) do
		for _, camp in ipairs(r.camps or {}) do
			if (Vector3.new(p.X, 0, p.Z) - camp.at).Magnitude < 34 + d then
				return true
			end
		end
	end
	for _, m in pairs(Config.MASTERS) do
		if (Vector3.new(p.X, 0, p.Z) - Vector3.new(m.at.X, 0, m.at.Z)).Magnitude < 50 + d then
			return true
		end
	end
	for _, fr in ipairs(Config.Fragments) do
		if (Vector3.new(p.X, 0, p.Z) - Vector3.new(fr.at.X, 0, fr.at.Z)).Magnitude < 16 + d then
			return true
		end
	end
	return false
end

-- 길가: 70칸마다 석등 (양쪽 번갈아), 길 양쪽으로 가로수
local function roadside()
	local f = Instance.new("Folder")
	f.Name = "Roadside"
	f.Parent = folder
	local lit = 0
	for _, road in ipairs(Config.Roads) do
		for i = 1, #road - 1 do
			local a, b = road[i], road[i + 1]
			local len = (b - a).Magnitude
			if len > 40 then
				local dir = (b - a).Unit
				local perp = Vector3.new(-dir.Z, 0, dir.X)
				local n = math.max(1, math.floor(len / 70))
				for j = 1, n - 1 do
					local p = a + (b - a) * (j / n)
					local side = j % 2 == 0 and 1 or -1
					local lp = p + perp * 14 * side
					if not inAnyRegion(lp, 6) and not nearFeature(lp, 0) and not nearRoad(lp, 12) then
						lit += 1
						stoneLantern(lp, f, lit % 2 == 0 and lit <= 240)
					end
					-- 가로수: 석등과 엇갈려 길 양쪽에
					for _, sd in ipairs({ -1, 1 }) do
						local tp = p + dir * 35 + perp * 27 * sd
						if (tp - a):Dot(dir) < len - 20 and not inAnyRegion(tp, 10) and not nearFeature(tp, 10) and not nearRoad(tp, 22) then
							tree(tp, 1.45, f)
						end
					end
				end
			end
		end
	end
	-- 들판의 작은 숲 (흩뿌리지 않고, 몇 군데에 모아 심는다)
	local groves = {
		Vector3.new(-760, 0, 760), Vector3.new(760, 0, -760), Vector3.new(-1300, 0, 450), Vector3.new(1250, 0, -420),
		Vector3.new(700, 0, 1200), Vector3.new(-700, 0, -1200), Vector3.new(1100, 0, 1950), Vector3.new(-1900, 0, 1300),
		Vector3.new(2300, 0, 1500), Vector3.new(-2300, 0, -900), Vector3.new(950, 0, -1500), Vector3.new(-1000, 0, 1700),
		Vector3.new(2900, 0, 400), Vector3.new(-2800, 0, 600), Vector3.new(1500, 0, 2600), Vector3.new(-2500, 0, -1800),
	}
	for gi, c in ipairs(groves) do
		if not inAnyRegion(c, 40) and not nearFeature(c, 30) and not nearRoad(c, 40) then
			local n = 6 + gi % 3
			for k = 0, n - 1 do
				local a = k / n * math.pi * 2 + gi
				local p = c + Vector3.new(math.cos(a), 0, math.sin(a)) * (12 + (k % 2) * 8)
				tree(p, 1.3 + (k % 3) * 0.2, f, gi % 4 == 0)
			end
			tree(c, 2.1, f)
			rock(c + Vector3.new(9, 0, -6), 5, f)
		end
	end
end

-- 문루: 길이 지역으로 드는 곳. 붉은 칠 나무 기둥 둘, 두 겹 들보, 기와 지붕, 이름 현판, 석등 한 쌍
local function regionGate(at: Vector3, dir: Vector3, title: string, accent: Color3, parent: Instance)
	local cf = CFrame.lookAt(at, at + dir)
	for _, sx in ipairs({ -1, 1 }) do
		part({ Name = "GateStone", Size = Vector3.new(3.4, 1.4, 3.4), CFrame = cf * CFrame.new(sx * 12.5, 0.7, 0), Color = STONE_DARK, Material = Enum.Material.Granite, Parent = parent })
		part({ Name = "GatePost", Size = Vector3.new(2, 15, 2), CFrame = cf * CFrame.new(sx * 12.5, 8.4, 0), Color = GATE_RED, Material = Enum.Material.Wood, Parent = parent })
		part({ Name = "GatePostBand", Size = Vector3.new(2.3, 0.5, 2.3), CFrame = cf * CFrame.new(sx * 12.5, 3, 0), Color = GOLD, Material = Enum.Material.Metal, CanCollide = false, Parent = parent })
		stoneLantern((cf * CFrame.new(sx * 17, 0, -5)).Position, parent, true)
	end
	part({ Name = "GateBeam", Size = Vector3.new(30, 1.8, 2.4), CFrame = cf * CFrame.new(0, 15.6, 0), Color = GATE_RED, Material = Enum.Material.Wood, Parent = parent })
	part({ Name = "GateBeam2", Size = Vector3.new(26, 1, 1.6), CFrame = cf * CFrame.new(0, 12.6, 0), Color = GATE_RED, Material = Enum.Material.Wood, Parent = parent })
	part({ Name = "GateBeamTrim", Size = Vector3.new(30.2, 0.3, 2.6), CFrame = cf * CFrame.new(0, 14.6, 0), Color = accent, Material = Enum.Material.Neon, CanCollide = false, Parent = parent })
	for _, sz in ipairs({ -1, 1 }) do
		part({ Name = "GateRoof", Size = Vector3.new(34, 0.7, 3.4), CFrame = cf * CFrame.new(0, 17.3, sz * 1.25) * CFrame.Angles(sz * math.rad(24), 0, 0), Color = ROOF, Material = Enum.Material.Slate, Parent = parent })
	end
	part({ Name = "GateRidge", Size = Vector3.new(35, 0.8, 0.9), CFrame = cf * CFrame.new(0, 18.1, 0), Color = ROOF:Lerp(Color3.new(0, 0, 0), 0.3), Material = Enum.Material.Slate, Parent = parent })
	for _, sx in ipairs({ -1, 1 }) do
		part({ Name = "GateRidgeEnd", Size = Vector3.new(1, 1.6, 1), CFrame = cf * CFrame.new(sx * 17.3, 18.6, 0) * CFrame.Angles(0, 0, sx * math.rad(-25)), Color = GOLD, Material = Enum.Material.Metal, CanCollide = false, Parent = parent })
	end
	local plate = part({ Name = "GatePlate", Size = Vector3.new(12, 2.6, 0.4), CFrame = cf * CFrame.new(0, 10.6, 0), Color = Color3.fromRGB(30, 22, 16), Material = Enum.Material.Wood, CanCollide = false, Parent = parent })
	sign(plate, Enum.NormalId.Front, { { title, Color3.fromRGB(255, 220, 140), 1 } })
	sign(plate, Enum.NormalId.Back, { { title, Color3.fromRGB(255, 220, 140), 1 } })
end


------------------------------------------------------------------------
-- 1.0판: 지역의 경계를 자연스럽게. 낮은 돌 턱 대신 그 땅의 생김새를 따른다
-- (풀밭은 낮은 언덕과 나무숲, 대숲은 대나무, 산적 소굴은 목책, 설산은 눈 둔덕과 전나무, 황야는 붉은 바위기둥 ...).
-- 길이 드는 곳과 군데군데 자연스러운 틈은 비워 두고, 이웃한 지역끼리는 덤불 정도로만 가른다
------------------------------------------------------------------------
local BORDER_THEME: { [string]: string } = {
	bamboo = "bamboo", fort = "fort", valley = "grass", field = "grass", windhill = "grass", lake = "grass", plum = "blossom", tavern = "fence",
	dojo = "garden", temple = "garden", lair = "crag", peak = "crag", ravine = "crag", sunmoon = "crag", cult = "cult", rift = "rift",
	snow = "snow", swamp = "swamp", badlands = "sand", tomb = "sand", coast = "coast", seashrine = "coast", volcano = "volcano",
	fireshrine = "volcano", skysea = "cloud", plateau = "rocky",
}
local RIDGE_MAT: { [string]: Enum.Material } = {
	grass = Enum.Material.Grass, bamboo = Enum.Material.Grass, blossom = Enum.Material.Grass, fence = Enum.Material.Grass, fort = Enum.Material.Mud,
	crag = Enum.Material.Slate, cult = Enum.Material.Slate, rift = Enum.Material.Slate, snow = Enum.Material.Snow, swamp = Enum.Material.Mud,
	sand = Enum.Material.Sandstone, coast = Enum.Material.Rock, volcano = Enum.Material.Basalt, rocky = Enum.Material.Rock,
}
local LEAF = Color3.fromRGB(70, 120, 60)

-- 이웃한 다른 지역 (또는 마을) 안인가
local function insideOther(p: Vector3, r: any, pad: number): boolean
	if math.abs(p.X) < VILLAGE_PAD + pad and math.abs(p.Z) < VILLAGE_PAD + pad then
		return true
	end
	for _, o in ipairs(Config.Regions) do
		if o ~= r and not o.noGround and math.abs(p.X - o.center.X) < o.size.X / 2 + pad and math.abs(p.Z - o.center.Z) < o.size.Z / 2 + pad then
			return true
		end
	end
	return false
end

local function bush(at: Vector3, s: number, color: Color3, f: Instance)
	for i = 1, 2 do
		local sz = (3.2 + i * 0.8 + rng:NextNumber(0, 1.2)) * s
		part({ Name = "Bush", Shape = Enum.PartType.Ball, Size = Vector3.one * sz, Position = at + Vector3.new(rng:NextNumber(-1.5, 1.5) * s, sz * 0.32, rng:NextNumber(-1.5, 1.5) * s),
			Color = color:Lerp(Color3.new(1, 1, 1), rng:NextNumber(0, 0.12)), Material = Enum.Material.Grass, CanCollide = false, Parent = f })
	end
end
-- 뾰족한 바위 (기울어진 큰 돌 + 끝돌)
local function crag(at: Vector3, s: number, color: Color3, f: Instance)
	local h = rng:NextNumber(7, 14) * s
	part({ Name = "Crag", Size = Vector3.new(rng:NextNumber(3, 5) * s, h, rng:NextNumber(3, 5) * s), CFrame = CFrame.new(at + Vector3.new(0, h * 0.42, 0)) * CFrame.Angles(rng:NextNumber(-0.2, 0.2), rng:NextNumber(0, 6), rng:NextNumber(-0.2, 0.2)),
		Color = color, Material = Enum.Material.Slate, Parent = f })
	part({ Name = "CragTip", Size = Vector3.new(2, h * 0.45, 2) * Vector3.new(s, 1, s), CFrame = CFrame.new(at + Vector3.new(rng:NextNumber(-1, 1) * s, h * 0.95, rng:NextNumber(-1, 1) * s)) * CFrame.Angles(rng:NextNumber(-0.3, 0.3), rng:NextNumber(0, 6), rng:NextNumber(-0.3, 0.3)),
		Color = color:Lerp(Color3.new(0, 0, 0), 0.15), Material = Enum.Material.Slate, Parent = f })
end
-- 붉은 모래 바위기둥 (세 덩이를 어긋나게 쌓는다)
local function hoodoo(at: Vector3, s: number, f: Instance)
	local y = 0
	for i = 1, 3 do
		local w = (5.5 - i * 1.2) * s
		local h = rng:NextNumber(3, 5) * s
		part({ Name = "Hoodoo", Size = Vector3.new(w * rng:NextNumber(0.9, 1.2), h, w), CFrame = CFrame.new(at + Vector3.new(rng:NextNumber(-0.5, 0.5) * s, y + h / 2, rng:NextNumber(-0.5, 0.5) * s)) * CFrame.Angles(0, rng:NextNumber(0, 6), rng:NextNumber(-0.06, 0.06)),
			Color = Color3.fromRGB(196, 140, 90):Lerp(Color3.fromRGB(225, 180, 125), rng:NextNumber()), Material = Enum.Material.Sandstone, Parent = f })
		y += h * 0.92
	end
end
local function reeds(at: Vector3, f: Instance)
	for _ = 1, 4 do
		local h = rng:NextNumber(4, 7)
		part({ Name = "Reed", Size = Vector3.new(0.25, h, 0.25), CFrame = CFrame.new(at + Vector3.new(rng:NextNumber(-1.5, 1.5), h / 2, rng:NextNumber(-1.5, 1.5))) * CFrame.Angles(rng:NextNumber(-0.15, 0.15), 0, rng:NextNumber(-0.15, 0.15)),
			Color = Color3.fromRGB(120, 130, 70), Material = Enum.Material.Grass, CanCollide = false, Parent = f })
	end
end

------------------------------------------------------------------------
-- 1.8판: 세상 끝 네 땅 (단풍산 · 석림 · 거균림 · 운무 차밭)
------------------------------------------------------------------------
-- 떨어지는 잎·포자·안개 같은 입자
local function drift(at: Vector3, size: Vector3, colors: { Color3 }, rate: number, psize: number, life: number, fall: number, f: Instance, glow: number?)
	local holder = part({ Name = "Drift", Size = size, Position = at, Transparency = 1, CanCollide = false, Parent = f })
	local pe = Instance.new("ParticleEmitter")
	pe.Texture = "rbxasset://textures/particles/sparkles_main.dds"
	local keys = {}
	for i, c in ipairs(colors) do
		table.insert(keys, ColorSequenceKeypoint.new(#colors == 1 and 0 or (i - 1) / (#colors - 1), c))
	end
	if #keys == 1 then
		table.insert(keys, ColorSequenceKeypoint.new(1, colors[1]))
	end
	pe.Color = ColorSequence.new(keys)
	pe.Size = NumberSequence.new(psize, psize * 0.6)
	pe.Squash = NumberSequence.new(0.4)
	pe.Lifetime = NumberRange.new(life * 0.7, life)
	pe.Rate = rate
	pe.Speed = NumberRange.new(0.5, 2)
	pe.SpreadAngle = Vector2.new(180, 180)
	pe.Acceleration = Vector3.new(0.8, -fall, 0.4)
	pe.Rotation = NumberRange.new(0, 360)
	pe.RotSpeed = NumberRange.new(-90, 90)
	pe.LightEmission = glow or 0.2
	pe.Shape = Enum.ParticleEmitterShape.Box
	pe.Parent = holder
end

-- 단풍나무: 굽은 줄기, 갈라진 가지, 붉고 노란 잎 덩이
local MAPLE = { Color3.fromRGB(205, 55, 35), Color3.fromRGB(235, 120, 40), Color3.fromRGB(240, 180, 60), Color3.fromRGB(180, 40, 45) }
local function mapleTree(at: Vector3, s: number, f: Instance)
	local lean = rng:NextNumber(-0.12, 0.12)
	local trunkH = 11 * s
	part({ Name = "MapleTrunk", Size = Vector3.new(1.5 * s, trunkH, 1.5 * s), CFrame = CFrame.new(at + Vector3.new(0, trunkH / 2, 0)) * CFrame.Angles(lean, rng:NextNumber(0, 6), -lean), Color = Color3.fromRGB(70, 45, 35), Material = Enum.Material.Wood, Parent = f })
	local top = at + Vector3.new(0, trunkH, 0)
	for k = 0, 2 do
		local a = k / 3 * math.pi * 2 + rng:NextNumber(0, 1)
		local to = top + Vector3.new(math.cos(a) * 4 * s, 2.5 * s, math.sin(a) * 4 * s)
		part({ Name = "MapleBranch", Size = Vector3.new(0.6 * s, 0.6 * s, (to - top).Magnitude), CFrame = CFrame.lookAt((top + to) / 2, to), Color = Color3.fromRGB(70, 45, 35), Material = Enum.Material.Wood, CanCollide = false, Parent = f })
		part({ Name = "MapleLeaves", Shape = Enum.PartType.Ball, Size = Vector3.one * rng:NextNumber(6, 8.5) * s, Position = to + Vector3.new(0, 1 * s, 0), Color = MAPLE[rng:NextInteger(1, #MAPLE)], Material = Enum.Material.LeafyGrass, CanCollide = false, Parent = f })
	end
	part({ Name = "MapleCrown", Shape = Enum.PartType.Ball, Size = Vector3.one * 9 * s, Position = top + Vector3.new(0, 4.5 * s, 0), Color = MAPLE[rng:NextInteger(1, #MAPLE)], Material = Enum.Material.LeafyGrass, CanCollide = false, Parent = f })
end

function OUTER.maple(r: any, f: Instance)
	for _ = 1, 60 do
		local p = randIn(r, 25)
		if clearOf(p, r) then
			mapleTree(p, rng:NextNumber(0.9, 1.5), f)
		end
	end
	-- 땅에 깔린 낙엽 (붉고 노란 얼룩)
	for _ = 1, 26 do
		local p = randIn(r, 30)
		disc("FallenLeaves", p + Vector3.new(0, 0.12, 0), rng:NextNumber(6, 14), 0.12, MAPLE[rng:NextInteger(1, #MAPLE)]:Lerp(Color3.fromRGB(120, 70, 40), 0.25), Enum.Material.LeafyGrass, f, false)
	end
	for _ = 1, 14 do
		local p = randIn(r, 30)
		if clearOf(p, r) then
			crag(p, rng:NextNumber(1, 1.8), Color3.fromRGB(120, 100, 85), f)
		end
	end
	-- 풍엽의 자리: 붉은 기둥의 정자와 돌계단, 둘레에 석등
	local b = r.boss.at
	disc("MapleDais", b + Vector3.new(0, 0.5, 0), 40, 1, Color3.fromRGB(150, 120, 95), Enum.Material.Cobblestone, f)
	for k = 0, 5 do
		local a = k / 6 * math.pi * 2
		local q = b + Vector3.new(math.cos(a) * 44, 0, math.sin(a) * 44)
		stoneLantern(q, f, true)
	end
	building(b + Vector3.new(0, 0, -60), 26, 18, 0, f, { tiers = 2, sign = "풍엽각", h = 11, wall = Color3.fromRGB(235, 220, 200), roof = Color3.fromRGB(150, 50, 35) })
	drift(r.center + Vector3.new(0, 30, 0), Vector3.new(r.size.X * 0.9, 4, r.size.Z * 0.9), { MAPLE[1], MAPLE[2], MAPLE[3] }, 60, 0.6, 9, 1.6, f)
end

-- 석림: 겹겹이 쌓인 회색 돌기둥, 꼭대기엔 이끼와 작은 소나무
function OUTER.stoneforest(r: any, f: Instance)
	local STONE_A = Color3.fromRGB(165, 165, 158)
	for _ = 1, 75 do
		local p = randIn(r, 25)
		if clearOf(p, r) then
			local y = 0
			local w = rng:NextNumber(8, 16)
			local n = rng:NextInteger(3, 6)
			for i = 1, n do
				local h = rng:NextNumber(7, 13)
				local ww = w * (1 - i * 0.1)
				part({ Name = "KarstStone", Size = Vector3.new(ww, h, ww * rng:NextNumber(0.8, 1.1)), CFrame = CFrame.new(p + Vector3.new(rng:NextNumber(-1, 1), y + h / 2, rng:NextNumber(-1, 1))) * CFrame.Angles(rng:NextNumber(-0.05, 0.05), rng:NextNumber(0, 6), rng:NextNumber(-0.05, 0.05)),
					Color = STONE_A:Lerp(Color3.fromRGB(120, 120, 115), rng:NextNumber()), Material = Enum.Material.Limestone, Parent = f })
				y += h * 0.95
			end
			if rng:NextNumber() < 0.6 then
				part({ Name = "KarstMoss", Shape = Enum.PartType.Ball, Size = Vector3.new(w * 0.7, w * 0.35, w * 0.7), Position = p + Vector3.new(0, y + 0.5, 0), Color = Color3.fromRGB(80, 120, 60), Material = Enum.Material.Grass, CanCollide = false, Parent = f })
			else
				pine(p + Vector3.new(0, y, 0), 0.6, f, false)
			end
		end
	end
	for _ = 1, 24 do
		local p = randIn(r, 20)
		if clearOf(p, r) then
			rock(p, rng:NextNumber(3, 7), f, Color3.fromRGB(150, 150, 142))
		end
	end
	-- 석왕의 돌 마당: 둘레에 선 일곱 돌기둥
	local b = r.boss.at
	disc("StoneCourt", b + Vector3.new(0, 0.4, 0), 42, 0.8, Color3.fromRGB(175, 172, 165), Enum.Material.Slate, f)
	for k = 0, 6 do
		local a = k / 7 * math.pi * 2
		part({ Name = "StoneMonolith", Size = Vector3.new(5, 26, 5), CFrame = CFrame.new(b + Vector3.new(math.cos(a) * 48, 13, math.sin(a) * 48)) * CFrame.Angles(0, a, 0), Color = Color3.fromRGB(140, 140, 132), Material = Enum.Material.Limestone, Parent = f })
	end
	drift(r.center + Vector3.new(0, 8, 0), Vector3.new(r.size.X * 0.9, 6, r.size.Z * 0.9), { Color3.fromRGB(235, 235, 235) }, 40, 6, 10, -0.05, f, 0)
end

-- 거균림: 집채만 한 버섯 (줄기, 점박이 갓, 빛나는 갓 밑), 바닥의 작은 빛 버섯, 떠도는 포자
local CAPS = { Color3.fromRGB(200, 50, 60), Color3.fromRGB(150, 80, 210), Color3.fromRGB(60, 170, 170), Color3.fromRGB(230, 140, 50) }
local function bigMushroom(at: Vector3, s: number, f: Instance)
	local h = rng:NextNumber(12, 26) * s
	local cap = CAPS[rng:NextInteger(1, #CAPS)]
	local tilt = rng:NextNumber(-0.12, 0.12)
	part({ Name = "MushStem", Shape = Enum.PartType.Cylinder, Size = Vector3.new(h, 3 * s, 3 * s), CFrame = CFrame.new(at + Vector3.new(0, h / 2, 0)) * CFrame.Angles(tilt, 0, math.rad(90)), Color = Color3.fromRGB(235, 225, 205), Material = Enum.Material.SmoothPlastic, Parent = f })
	local w = rng:NextNumber(14, 22) * s
	local top = at + Vector3.new(0, h, 0)
	local capPart = part({ Name = "MushCap", Shape = Enum.PartType.Ball, Size = Vector3.new(w, w * 0.45, w), Position = top + Vector3.new(0, w * 0.12, 0), Color = cap, Material = Enum.Material.SmoothPlastic, Parent = f })
	local under = part({ Name = "MushGill", Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.4, w * 0.8, w * 0.8), CFrame = CFrame.new(top - Vector3.new(0, 0.2, 0)) * CFrame.Angles(0, 0, math.rad(90)), Color = cap:Lerp(Color3.new(1, 1, 1), 0.5), Material = Enum.Material.Neon, Transparency = 0.2, CanCollide = false, Parent = f })
	light(under, cap:Lerp(Color3.new(1, 1, 1), 0.4), w, 0.8)
	for _ = 1, 5 do
		local a, rr = rng:NextNumber(0, 6.28), rng:NextNumber(0, w * 0.35)
		part({ Name = "MushSpot", Shape = Enum.PartType.Ball, Size = Vector3.new(1.6, 0.5, 1.6) * s, Position = capPart.Position + Vector3.new(math.cos(a) * rr, w * 0.2 - rr * 0.25, math.sin(a) * rr), Color = Color3.fromRGB(250, 245, 235), Material = Enum.Material.SmoothPlastic, CanCollide = false, Parent = f })
	end
end
function OUTER.mushroom(r: any, f: Instance)
	for _ = 1, 42 do
		local p = randIn(r, 30)
		if clearOf(p, r) then
			bigMushroom(p, rng:NextNumber(0.8, 1.4), f)
		end
	end
	for _ = 1, 40 do
		local p = randIn(r, 15)
		if clearOf(p, r) then
			for k = 1, 3 do
				local c = CAPS[rng:NextInteger(1, #CAPS)]
				local q = p + Vector3.new(rng:NextNumber(-2, 2), 0, rng:NextNumber(-2, 2))
				local hh = rng:NextNumber(1, 2.5)
				part({ Name = "SmallStem", Size = Vector3.new(0.4, hh, 0.4), Position = q + Vector3.new(0, hh / 2, 0), Color = Color3.fromRGB(235, 230, 215), Material = Enum.Material.SmoothPlastic, CanCollide = false, Parent = f })
				part({ Name = "SmallCap", Shape = Enum.PartType.Ball, Size = Vector3.new(1.6, 0.7, 1.6) * (0.7 + k * 0.2), Position = q + Vector3.new(0, hh, 0), Color = c, Material = Enum.Material.Neon, CanCollide = false, Parent = f })
			end
		end
	end
	-- 균왕의 자리: 버섯 고리
	local b = r.boss.at
	for k = 0, 9 do
		local a = k / 10 * math.pi * 2
		bigMushroom(b + Vector3.new(math.cos(a) * 52, 0, math.sin(a) * 52), 0.7, f)
	end
	drift(r.center + Vector3.new(0, 10, 0), Vector3.new(r.size.X * 0.9, 16, r.size.Z * 0.9), { Color3.fromRGB(200, 150, 255), Color3.fromRGB(150, 255, 230) }, 70, 0.35, 8, -0.2, f, 0.8)
end

-- 운무 차밭: 고랑을 따라 늘어선 차나무 줄, 돌담 수로, 정자, 연못, 낮게 깔린 안개
function OUTER.teafield(r: any, f: Instance)
	local TEA = Color3.fromRGB(60, 120, 55)
	local x0, x1 = r.center.X - r.size.X / 2 + 30, r.center.X + r.size.X / 2 - 30
	local z = r.center.Z - r.size.Z / 2 + 30
	local row = 0
	while z < r.center.Z + r.size.Z / 2 - 30 do
		local x = x0 + (row % 2) * 16
		while x < x1 do
			local len = 34
			local mid = Vector3.new(x + len / 2, 0, z)
			if clearOf(mid, r) and clearOf(mid + Vector3.new(len / 2, 0, 0), r) and clearOf(mid - Vector3.new(len / 2, 0, 0), r) then
				part({ Name = "TeaRow", Size = Vector3.new(len, 2.4, 3.4), Position = mid + Vector3.new(0, 1.2, 0), Color = TEA:Lerp(Color3.fromRGB(110, 170, 80), rng:NextNumber() * 0.5), Material = Enum.Material.LeafyGrass, Parent = f })
				part({ Name = "TeaTop", Size = Vector3.new(len - 1, 0.6, 2.6), Position = mid + Vector3.new(0, 2.6, 0), Color = Color3.fromRGB(120, 180, 90), Material = Enum.Material.LeafyGrass, CanCollide = false, Parent = f })
			end
			x += len + 14
		end
		z += 28
		row += 1
	end
	-- 다선의 정자와 연못
	local b = r.boss.at
	disc("TeaPond", b + Vector3.new(70, 0.2, 40), 26, 0.4, Color3.fromRGB(120, 175, 190), Enum.Material.Glass, f, false).Transparency = 0.2
	disc("TeaCourt", b + Vector3.new(0, 0.4, 0), 36, 0.8, Color3.fromRGB(190, 180, 160), Enum.Material.Cobblestone, f)
	building(b + Vector3.new(-60, 0, 0), 20, 16, math.rad(90), f, { sign = "운무다원", h = 10, wall = Color3.fromRGB(240, 235, 220), roof = Color3.fromRGB(70, 110, 80) })
	for k = 0, 3 do
		local a = k / 4 * math.pi * 2 + math.pi / 4
		stoneLantern(b + Vector3.new(math.cos(a) * 40, 0, math.sin(a) * 40), f, true)
	end
	drift(r.center + Vector3.new(0, 4, 0), Vector3.new(r.size.X * 0.9, 4, r.size.Z * 0.9), { Color3.fromRGB(240, 245, 240) }, 50, 8, 10, -0.03, f, 0)
end
local function cloudBank(at: Vector3, s: number, f: Instance)
	for _ = 1, 3 do
		local sz = rng:NextNumber(6, 10) * s
		part({ Name = "CloudBank", Shape = Enum.PartType.Ball, Size = Vector3.one * sz, Position = at + Vector3.new(rng:NextNumber(-4, 4) * s, sz * 0.25, rng:NextNumber(-4, 4) * s),
			Color = Color3.fromRGB(245, 247, 255), Material = Enum.Material.SmoothPlastic, Transparency = 0.15, CanCollide = false, Parent = f })
	end
end
-- 목책: 뾰족한 통나무를 촘촘히 박고 가로대 하나
local function palisade(p: Vector3, dir: Vector3, len: number, f: Instance)
	local n = math.max(2, math.floor(len / 2.2))
	for i = 0, n - 1 do
		local q = p + dir * (i * len / (n - 1))
		local h = rng:NextNumber(7, 9)
		part({ Name = "Stake", Size = Vector3.new(1.2, h, 1.2), CFrame = CFrame.new(q + Vector3.new(0, h / 2 - 0.3, 0)) * CFrame.Angles(rng:NextNumber(-0.06, 0.06), rng:NextNumber(0, 6), rng:NextNumber(-0.06, 0.06)),
			Color = Color3.fromRGB(98, 72, 50):Lerp(Color3.fromRGB(70, 52, 38), rng:NextNumber()), Material = Enum.Material.Wood, Parent = f })
	end
	local mid = p + dir * len / 2 + Vector3.new(0, 3, 0)
	part({ Name = "StakeRail", Size = Vector3.new(0.6, 0.6, len), CFrame = CFrame.lookAt(mid, mid + dir) * CFrame.new(0.7, 0, 0), Color = Color3.fromRGB(80, 60, 42), Material = Enum.Material.Wood, CanCollide = false, Parent = f })
end
-- 나무 울타리 (기둥 + 가로대 둘)
local function railFence(p: Vector3, dir: Vector3, len: number, f: Instance)
	local n = math.max(2, math.floor(len / 6) + 1)
	for i = 0, n - 1 do
		local q = p + dir * (i * len / (n - 1))
		part({ Name = "FencePost", Size = Vector3.new(0.8, 4.2, 0.8), Position = q + Vector3.new(0, 2.1, 0), Color = WOOD, Material = Enum.Material.Wood, Parent = f })
	end
	for _, y in ipairs({ 1.6, 3.2 }) do
		local mid = p + dir * len / 2 + Vector3.new(0, y, 0)
		part({ Name = "FenceRail", Size = Vector3.new(0.35, 0.45, len), CFrame = CFrame.lookAt(mid, mid + dir), Color = WOOD:Lerp(Color3.new(1, 1, 1), 0.1), Material = Enum.Material.Wood, Parent = f })
	end
end
-- 다듬은 생울타리 (정원·절)
local function hedge(p: Vector3, dir: Vector3, len: number, f: Instance)
	local mid = p + dir * len / 2
	part({ Name = "Hedge", Size = Vector3.new(2.8, 3.4, len), CFrame = CFrame.lookAt(mid + Vector3.new(0, 1.7, 0), mid + Vector3.new(0, 1.7, 0) + dir), Color = Color3.fromRGB(55, 100, 50), Material = Enum.Material.Grass, Parent = f })
	part({ Name = "HedgeTop", Size = Vector3.new(2.4, 0.8, math.max(1, len - 0.4)), CFrame = CFrame.lookAt(mid + Vector3.new(0, 3.6, 0), mid + Vector3.new(0, 3.6, 0) + dir), Color = Color3.fromRGB(80, 130, 65), Material = Enum.Material.Grass, CanCollide = false, Parent = f })
end

-- 한 변의 한 토막: 덩어리(숲·바위·둔덕)와 트인 틈이 번갈아 온다
local function borderSpan(r: any, theme: string, fixed: string, v: number, lo: number, hi: number, outward: Vector3, f: Instance, terrain: Terrain?)
	local small = math.max(r.size.X, r.size.Z) <= 300
	local along = fixed == "x" and Vector3.new(0, 0, 1) or Vector3.new(1, 0, 0)
	local step = small and 24 or 21
	local x = lo + rng:NextNumber(0, 8)
	local clump = rng:NextNumber() < 0.75
	local left = clump and rng:NextNumber(40, 120) or rng:NextNumber(15, 35)
	local count = 0
	while x < hi - 3 do
		if not clump then
			-- 트인 틈 (지나다닐 수 있게)
			x += left
			clump = true
			left = rng:NextNumber(small and 50 or 60, small and 110 or 170)
			continue
		end
		local p = fixed == "x" and Vector3.new(v, 0, x) or Vector3.new(x, 0, v)
		local len = math.min(step, hi - x)
		x += step
		left -= step
		if left <= 0 then
			clump = false
			left = rng:NextNumber(18, 45)
		end
		if nearRoad(p, 20) or nearFeature(p, 4) or insideOther(p, r, -2) then
			continue
		end
		count += 1
		-- 이웃 지역과 맞닿은 변: 덤불·작은 돌만 듬성듬성
		local shared = insideOther(p + outward * 26, r, 0)
		if shared then
			if count % 2 == 0 then
				if theme == "sand" or theme == "crag" or theme == "volcano" or theme == "rocky" or theme == "cult" or theme == "rift" or theme == "coast" then
					rock(p + along * rng:NextNumber(-4, 4), rng:NextNumber(3, 5), f)
				elseif theme == "snow" then
					rock(p, rng:NextNumber(3, 5), f, Color3.fromRGB(225, 232, 242))
				elseif theme ~= "cloud" then
					bush(p + along * rng:NextNumber(-4, 4), 0.9, theme == "blossom" and Color3.fromRGB(200, 120, 140) or LEAF, f)
				end
			end
			continue
		end
		-- 바깥쪽으로 낮은 둔덕 (지형). 안쪽 비탈 위에 소품을 얹는다
		local lift = 0
		local mat = RIDGE_MAT[theme]
		local q = p + outward * rng:NextNumber(3, 9) + along * rng:NextNumber(-4, 4)
		if terrain and mat and not small then
			local rad = rng:NextNumber(15, 24)
			local c = p + outward * rad * 0.5 + along * rng:NextNumber(-3, 3)
			if not nearRoad(c, rad + 8) and not nearFeature(c, rad * 0.6) then
				local ok = pcall(function()
					(terrain :: Terrain):FillBall(c - Vector3.new(0, rad * 0.5, 0), rad, mat)
				end)
				if ok then
					local d = Vector3.new(q.X - c.X, 0, q.Z - c.Z).Magnitude
					lift = math.max(0, math.sqrt(math.max(0, rad * rad - d * d)) - rad * 0.5 - 0.6)
				end
			end
		end
		local at = q + Vector3.new(0, lift, 0)
		local roll = rng:NextNumber()
		if theme == "grass" or theme == "blossom" then
			if roll < 0.55 then
				tree(at, rng:NextNumber(1.3, 1.8), f, theme == "blossom" and roll < 0.4)
			elseif roll < 0.85 then
				bush(at, rng:NextNumber(0.9, 1.3), theme == "blossom" and Color3.fromRGB(200, 120, 140) or LEAF, f)
			else
				rock(at, rng:NextNumber(4, 7), f)
			end
		elseif theme == "bamboo" then
			for _ = 1, 3 + (count % 3) do
				bamboo(at + Vector3.new(rng:NextNumber(-4, 4), 0, rng:NextNumber(-4, 4)), f)
			end
		elseif theme == "fence" then
			railFence(p, along, len - 2, f)
			if roll < 0.3 then
				tree(at + outward * 4, rng:NextNumber(1.2, 1.6), f)
			end
		elseif theme == "fort" then
			palisade(p, along, len - 1, f)
			if roll < 0.25 then
				rock(at + outward * 3, rng:NextNumber(4, 6), f, Color3.fromRGB(110, 100, 90))
			end
		elseif theme == "garden" then
			hedge(p, along, len - 3, f)
			if count % 3 == 0 then
				pine(p + outward * 5, 1.2, f, false)
			end
		elseif theme == "crag" or theme == "rocky" then
			local col = theme == "rocky" and Color3.fromRGB(140, 140, 135) or Color3.fromRGB(70, 66, 72)
			if roll < 0.6 then
				crag(at, rng:NextNumber(0.9, 1.5), col, f)
			else
				rock(at, rng:NextNumber(4, 7), f, col)
			end
		elseif theme == "cult" then
			crag(at, rng:NextNumber(0.9, 1.4), Color3.fromRGB(60, 30, 34), f)
			if count % 5 == 0 then
				banner(p - outward * 2, 12, Color3.fromRGB(150, 20, 30), f)
			end
		elseif theme == "rift" then
			crag(at, rng:NextNumber(0.9, 1.5), Color3.fromRGB(45, 32, 70), f)
			if count % 4 == 0 then
				crystal(at + Vector3.new(0, 14, 0), 2.4, Color3.fromRGB(170, 90, 255), f)
			end
		elseif theme == "snow" then
			if roll < 0.65 then
				pine(at, rng:NextNumber(1.3, 1.8), f, true)
			else
				rock(at, rng:NextNumber(4, 7), f, Color3.fromRGB(215, 225, 238))
			end
		elseif theme == "swamp" then
			if roll < 0.45 then
				deadTree(at, rng:NextNumber(1.0, 1.4), f)
			end
			reeds(at + along * 3, f)
		elseif theme == "sand" then
			if roll < 0.5 then
				hoodoo(at, rng:NextNumber(0.9, 1.4), f)
			elseif roll < 0.8 then
				rock(at, rng:NextNumber(4, 7), f, Color3.fromRGB(200, 150, 100))
			else
				deadTree(at, 0.8, f)
			end
		elseif theme == "coast" then
			if roll < 0.6 then
				rock(at, rng:NextNumber(6, 10), f, Color3.fromRGB(130, 128, 120))
			else
				pine(at, rng:NextNumber(1.2, 1.6), f, false)
			end
		elseif theme == "volcano" then
			crag(at, rng:NextNumber(0.9, 1.5), Color3.fromRGB(40, 34, 32), f)
			if count % 3 == 0 then
				local cp = p - outward * 3
				part({ Name = "LavaCrack", Size = Vector3.new(0.6, 0.2, len * 0.8), CFrame = CFrame.lookAt(cp + Vector3.new(0, 0.12, 0), cp + Vector3.new(0, 0.12, 0) + along) * CFrame.Angles(0, rng:NextNumber(-0.4, 0.4), 0),
					Color = Color3.fromRGB(255, 120, 40), Material = Enum.Material.Neon, CanCollide = false, Parent = f })
			end
		elseif theme == "cloud" then
			cloudBank(at, rng:NextNumber(1.0, 1.5), f)
		end
	end
end

-- 지역 테두리: 둘레를 그 땅에 맞는 자연스러운 경계로 (길이 지나는 곳은 비우고 문루)
local gatedRegions: { [string]: boolean } = {}
local function regionFrames()
	local f = Instance.new("Folder")
	f.Name = "RegionFrames"
	f.Parent = folder
	local gates: { Vector3 } = {}
	for _, r in ipairs(Config.Regions) do
		if r.id ~= "village" and not r.noGround then
			local x0, x1 = r.center.X - r.size.X / 2, r.center.X + r.size.X / 2
			local z0, z1 = r.center.Z - r.size.Z / 2, r.center.Z + r.size.Z / 2
			-- 네 변: { 고정축, 값, 범위 시작, 범위 끝 }
			local edges = { { "x", x0, z0, z1, Vector3.new(-1, 0, 0) }, { "x", x1, z0, z1, Vector3.new(1, 0, 0) }, { "z", z0, x0, x1, Vector3.new(0, 0, -1) }, { "z", z1, x0, x1, Vector3.new(0, 0, 1) } }
			local theme = BORDER_THEME[r.id] or "grass"
			local terrain = workspace:FindFirstChildOfClass("Terrain")
			local accent = r.ground:Lerp(Color3.new(1, 1, 1), 0.45)
			for _, e in ipairs(edges) do
				local fixed, v, lo, hi = e[1], e[2], e[3], e[4]
				local cuts: { number } = {}
				for _, road in ipairs(Config.Roads) do
					for i = 1, #road - 1 do
						local a, b = road[i], road[i + 1]
						local av = fixed == "x" and a.X or a.Z
						local bv = fixed == "x" and b.X or b.Z
						if (av - v) * (bv - v) < 0 then
							local t = (v - av) / (bv - av)
							local along = fixed == "x" and (a.Z + (b.Z - a.Z) * t) or (a.X + (b.X - a.X) * t)
							if along > lo + 4 and along < hi - 4 then
								table.insert(cuts, along)
								local pos = fixed == "x" and Vector3.new(v, 0, along) or Vector3.new(along, 0, v)
								local dupe = false
								for _, g in ipairs(gates) do
									if (g - pos).Magnitude < 60 then
										dupe = true
									end
								end
								local nearVillage = math.abs(pos.X) < VILLAGE_PAD + 40 and math.abs(pos.Z) < VILLAGE_PAD + 40
								if not dupe and not nearVillage then
									table.insert(gates, pos)
									gatedRegions[r.id] = true
									local inward = Vector3.new(r.center.X - pos.X, 0, r.center.Z - pos.Z)
									local rd = (b - a).Unit
									if rd:Dot(inward) < 0 then
										rd = -rd
									end
									pcall(regionGate, pos, rd, r.name, accent, f)
								end
							end
						end
					end
				end
				table.sort(cuts)
				-- 길이 지나는 자리(문루 둘레 폭 48)를 비우고 자연스러운 경계를 놓는다
				local from = lo
				local spans: { { number } } = {}
				for _, c in ipairs(cuts) do
					table.insert(spans, { from, c - 24 })
					from = c + 24
				end
				table.insert(spans, { from, hi })
				for _, sp in ipairs(spans) do
					if sp[2] - sp[1] > 6 then
						borderSpan(r, theme, fixed, v, sp[1], sp[2], e[5], f, terrain)
					end
				end
			end
		end
	end
end

-- 1.5판: 초월 권법의 사부 자리. 매화원 가장 깊은 곳, 철 모르고 벚꽃이 흩날리는 언덕 (돌 단, 거대한 벚나무, 떨어지는 꽃잎)
------------------------------------------------------------------------
-- 2.4판: 새 랜드마크 여섯 (허허벌판을 채운다)
------------------------------------------------------------------------
-- 만목원: 비틀린 고목 아홉이 둥글게 서서 가지로 지붕을 이룬 숲. 가운데 이끼 덮인 돌 좌대에 목선 (만목신권의 사부)
function LANDMARK.grove(at: Vector3, f: Instance)
	local bark = Color3.fromRGB(78, 58, 42)
	local moss = Color3.fromRGB(70, 120, 55)
	disc("GroveFloor", at + Vector3.new(0, 0.15, 0), 70, 0.3, Color3.fromRGB(70, 105, 50), Enum.Material.Grass, f, false)
	for k = 0, 8 do
		local a = k / 9 * math.pi * 2
		local base = at + Vector3.new(math.cos(a) * 46, 0, math.sin(a) * 46)
		-- 휘어 오르는 줄기 세 마디, 가운데 쪽으로 기운다
		local p = base
		for j = 1, 3 do
			local nxt = p + Vector3.new(0, 14, 0) + (at - base).Unit * (4 + j * 3) + Vector3.new(math.sin(k + j) * 2, 0, math.cos(k + j) * 2)
			part({ Name = "GroveTrunk", Size = Vector3.new(6 - j, 6 - j, (nxt - p).Magnitude + 2), CFrame = CFrame.lookAt((p + nxt) / 2, nxt), Color = bark, Material = Enum.Material.Wood, Parent = f })
			p = nxt
		end
		-- 가지가 가운데로 뻗어 지붕이 된다
		local tip = at + Vector3.new(math.cos(a) * 12, 52 + (k % 3) * 3, math.sin(a) * 12)
		part({ Name = "GroveBough", Size = Vector3.new(2.6, 2.6, (tip - p).Magnitude), CFrame = CFrame.lookAt((p + tip) / 2, tip), Color = bark, Material = Enum.Material.Wood, Parent = f })
		part({ Name = "GroveLeaves", Shape = Enum.PartType.Ball, Size = Vector3.new(1, 0.6, 1) * rng:NextNumber(24, 32), Position = p:Lerp(tip, 0.6) + Vector3.new(0, 5, 0), Color = moss:Lerp(Color3.fromRGB(120, 170, 80), rng:NextNumber()), Material = Enum.Material.Grass, CanCollide = false, Parent = f })
		-- 뿌리 둘
		for _, s in ipairs({ -1, 1 }) do
			local rp = base + Vector3.new(math.cos(a + s * 0.5) * 9, 0.8, math.sin(a + s * 0.5) * 9)
			part({ Name = "GroveRoot", Size = Vector3.new(2.4, 2, 12), CFrame = CFrame.lookAt(rp, base + Vector3.new(0, 3, 0)), Color = bark, Material = Enum.Material.Wood, Parent = f })
		end
		-- 늘어진 덩굴
		for v = 0, 1 do
			local hang = tip:Lerp(p, 0.3 + v * 0.3)
			part({ Name = "GroveVine", Size = Vector3.new(0.3, 14, 0.3), Position = hang - Vector3.new(0, 7, 0), Color = Color3.fromRGB(60, 110, 50), Material = Enum.Material.Grass, CanCollide = false, Parent = f })
		end
	end
	-- 가운데: 작은 못과 이끼 덮인 돌 좌대
	disc("GrovePond", at + Vector3.new(14, 0.25, 10), 8, 0.2, Color3.fromRGB(70, 140, 150), Enum.Material.Glass, f, false).Transparency = 0.2
	disc("GroveSeat", at + Vector3.new(0, 1.2, 0), 7, 2.4, Color3.fromRGB(120, 120, 110), Enum.Material.Slate, f)
	disc("GroveSeatMoss", at + Vector3.new(0, 2.45, 0), 6.4, 0.2, moss, Enum.Material.Grass, f, false)
	-- 빛나는 버섯과 반딧불
	for k = 0, 11 do
		local a = k / 12 * math.pi * 2 + 0.2
		local mp = at + Vector3.new(math.cos(a) * rng:NextNumber(16, 34), 0, math.sin(a) * rng:NextNumber(16, 34))
		part({ Name = "GroveShroomStem", Size = Vector3.new(0.5, 1.4, 0.5), Position = mp + Vector3.new(0, 0.7, 0), Color = Color3.fromRGB(230, 225, 210), Material = Enum.Material.SmoothPlastic, CanCollide = false, Parent = f })
		local cap = part({ Name = "GroveShroom", Shape = Enum.PartType.Ball, Size = Vector3.new(1.8, 0.8, 1.8), Position = mp + Vector3.new(0, 1.5, 0), Color = Color3.fromRGB(140, 255, 190), Material = Enum.Material.Neon, CanCollide = false, Parent = f })
		if k % 3 == 0 then
			light(cap, Color3.fromRGB(140, 255, 190), 10, 0.8)
		end
	end
	local flies = part({ Name = "GroveFireflies", Size = Vector3.new(90, 30, 90), Position = at + Vector3.new(0, 16, 0), Transparency = 1, CanCollide = false, Parent = f })
	emitter(flies, Color3.fromRGB(220, 255, 150), 18, 0.35, 1.5, 6)
	local board = part({ Name = "GroveSign", Size = Vector3.new(10, 2.6, 0.4), CFrame = CFrame.lookAt(at + Vector3.new(0, 4.5, 60), at + Vector3.new(0, 4.5, 90)), Color = Color3.fromRGB(60, 45, 30), Material = Enum.Material.Wood, CanCollide = false, Parent = f })
	sign(board, Enum.NormalId.Front, { { "만목원", Color3.fromRGB(200, 255, 170), 1 } })
	part({ Name = "GroveSignPost", Size = Vector3.new(0.6, 4, 0.6), Position = at + Vector3.new(0, 2, 60), Color = bark, Material = Enum.Material.Wood, Parent = f })
end

-- 잠든 석장: 옛 싸움에서 쓰러진 거대한 돌 장수. 누운 몸통, 떨어진 투구 머리, 땅에 꽂힌 부러진 칼, 둘레의 돌 조각
function LANDMARK.fallengiant(at: Vector3, f: Instance)
	local stone = Color3.fromRGB(150, 145, 135)
	local dark = Color3.fromRGB(110, 106, 98)
	local yaw = CFrame.Angles(0, math.rad(25), 0)
	local base = CFrame.new(at) * yaw
	-- 누운 몸통과 팔다리 (반쯤 땅에 묻혔다)
	part({ Name = "GiantChest", Size = Vector3.new(26, 12, 40), CFrame = base * CFrame.new(0, 4, 0) * CFrame.Angles(0, 0, math.rad(8)), Color = stone, Material = Enum.Material.Slate, Parent = f })
	part({ Name = "GiantPlate", Size = Vector3.new(22, 2, 30), CFrame = base * CFrame.new(-1, 10.5, 2) * CFrame.Angles(0, 0, math.rad(8)), Color = dark, Material = Enum.Material.Slate, Parent = f })
	for _, s in ipairs({ -1, 1 }) do
		part({ Name = "GiantArm", Size = Vector3.new(8, 7, 30), CFrame = base * CFrame.new(s * 18, 2.5, -6) * CFrame.Angles(0, s * math.rad(20), 0), Color = stone, Material = Enum.Material.Slate, Parent = f })
		part({ Name = "GiantLeg", Size = Vector3.new(9, 8, 34), CFrame = base * CFrame.new(s * 7, 2, 36) * CFrame.Angles(0, s * math.rad(6), 0), Color = dark, Material = Enum.Material.Slate, Parent = f })
	end
	-- 떨어져 굴러간 투구 머리
	local head = base * CFrame.new(-6, 7, -36)
	part({ Name = "GiantHead", Shape = Enum.PartType.Ball, Size = Vector3.new(15, 15, 15), CFrame = head, Color = stone, Material = Enum.Material.Slate, Parent = f })
	part({ Name = "GiantHelm", Size = Vector3.new(16, 6, 16), CFrame = head * CFrame.new(0, 5, 0) * CFrame.Angles(math.rad(20), 0, math.rad(-30)), Color = dark, Material = Enum.Material.Slate, Parent = f })
	for _, s in ipairs({ -1, 1 }) do
		part({ Name = "GiantEye", Size = Vector3.new(2, 1, 0.6), CFrame = head * CFrame.new(s * 3, 0, -7.4), Color = Color3.fromRGB(60, 58, 55), Material = Enum.Material.Slate, Parent = f })
	end
	-- 부러진 큰 칼 (땅에 비스듬히 꽂혔다)
	part({ Name = "GiantBlade", Size = Vector3.new(4, 46, 1.5), CFrame = base * CFrame.new(30, 18, 10) * CFrame.Angles(math.rad(15), 0, math.rad(-18)), Color = Color3.fromRGB(120, 125, 135), Material = Enum.Material.Metal, Parent = f })
	part({ Name = "GiantGuard", Size = Vector3.new(14, 2.4, 3), CFrame = base * CFrame.new(23.5, 39, 15.5) * CFrame.Angles(math.rad(15), 0, math.rad(-18)), Color = Color3.fromRGB(150, 120, 70), Material = Enum.Material.Metal, Parent = f })
	-- 둘레의 돌 조각과 풀
	for k = 0, 9 do
		local a = k / 10 * math.pi * 2
		rock(at + Vector3.new(math.cos(a) * rng:NextNumber(40, 60), 0, math.sin(a) * rng:NextNumber(40, 60)), rng:NextNumber(3, 7), f, stone)
	end
end

-- 별바위 고리: 열두 선돌이 둥글게 서 있고, 가운데 돌단 위에서 별빛이 피어오른다
function LANDMARK.stonecircle(at: Vector3, f: Instance)
	local stone = Color3.fromRGB(120, 118, 130)
	local glow = Color3.fromRGB(170, 200, 255)
	disc("CircleFloor", at + Vector3.new(0, 0.2, 0), 34, 0.4, Color3.fromRGB(105, 120, 90), Enum.Material.Grass, f, false)
	for k = 0, 11 do
		local a = k / 12 * math.pi * 2
		local p = at + Vector3.new(math.cos(a) * 28, 0, math.sin(a) * 28)
		local h = 14 + (k % 3) * 4
		part({ Name = "Menhir", Size = Vector3.new(4.5, h, 3), CFrame = CFrame.lookAt(p + Vector3.new(0, h / 2, 0), at + Vector3.new(0, h / 2, 0)) * CFrame.Angles(0, 0, math.rad((k % 2 == 0 and 1 or -1) * 3)), Color = stone:Lerp(Color3.new(0, 0, 0), (k % 3) * 0.06), Material = Enum.Material.Slate, Parent = f })
		-- 선돌 앞의 빛나는 문양
		part({ Name = "MenhirRune", Size = Vector3.new(1.4, 1.4, 0.2), CFrame = CFrame.lookAt(p + (at - p).Unit * 1.6 + Vector3.new(0, 6, 0), at + Vector3.new(0, 6, 0)), Color = glow, Material = Enum.Material.Neon, CanCollide = false, Parent = f })
		-- 셋마다 위에 돌 들보
		if k % 3 == 0 then
			local q = at + Vector3.new(math.cos(a + math.pi / 12) * 28, 0, math.sin(a + math.pi / 12) * 28)
			part({ Name = "Lintel", Size = Vector3.new(4, 3, 9), CFrame = CFrame.lookAt(q + Vector3.new(0, h + 1.5, 0), at + Vector3.new(0, h + 1.5, 0)) * CFrame.Angles(0, math.rad(90), 0), Color = stone, Material = Enum.Material.Slate, Parent = f })
		end
	end
	disc("CircleAltar", at + Vector3.new(0, 1, 0), 7, 2, stone, Enum.Material.Slate, f)
	disc("CircleAltarRing", at + Vector3.new(0, 2.05, 0), 5.5, 0.1, glow, Enum.Material.Neon, f, false).Transparency = 0.4
	local core = part({ Name = "CircleStar", Shape = Enum.PartType.Ball, Size = Vector3.new(2.4, 2.4, 2.4), Position = at + Vector3.new(0, 6, 0), Color = glow, Material = Enum.Material.Neon, CanCollide = false, Parent = f })
	light(core, glow, 30, 1.6)
	emitter(core, glow, 10, 0.5, 3, 3)
end

-- 옛 봉화대: 언덕 위 무너진 성벽 사이에 선 높은 돌탑. 꼭대기에 아직 꺼지지 않은 봉화
function LANDMARK.beacon(at: Vector3, f: Instance)
	local stone = Color3.fromRGB(140, 130, 115)
	disc("BeaconMound", at + Vector3.new(0, 1.5, 0), 32, 3, Color3.fromRGB(95, 110, 70), Enum.Material.Grass, f)
	for k = 0, 4 do
		local w = 12 - k * 1.4
		part({ Name = "BeaconTier", Size = Vector3.new(w, 8, w), Position = at + Vector3.new(0, 7 + k * 8, 0), Color = stone:Lerp(Color3.new(0, 0, 0), k * 0.04), Material = Enum.Material.Cobblestone, Parent = f })
	end
	part({ Name = "BeaconTop", Size = Vector3.new(9, 1.2, 9), Position = at + Vector3.new(0, 43.6, 0), Color = stone, Material = Enum.Material.Cobblestone, Parent = f })
	for _, c in ipairs({ Vector3.new(1, 0, 1), Vector3.new(-1, 0, 1), Vector3.new(1, 0, -1), Vector3.new(-1, 0, -1) }) do
		part({ Name = "BeaconMerlon", Size = Vector3.new(1.6, 2.4, 1.6), Position = at + c * 3.8 + Vector3.new(0, 45.4, 0), Color = stone, Material = Enum.Material.Cobblestone, Parent = f })
	end
	brazier(at + Vector3.new(0, 44.2, 0), 2, f)
	-- 무너진 성벽 조각들
	for k = 0, 7 do
		local a = k / 8 * math.pi * 2
		if k % 3 ~= 1 then
			local p = at + Vector3.new(math.cos(a) * 24, 0, math.sin(a) * 24)
			local h = rng:NextNumber(3, 9)
			part({ Name = "BeaconWall", Size = Vector3.new(12, h, 2.4), CFrame = CFrame.lookAt(p + Vector3.new(0, 3 + h / 2, 0), at + Vector3.new(0, 3 + h / 2, 0)) * CFrame.Angles(0, math.rad(90), 0), Color = stone, Material = Enum.Material.Cobblestone, Parent = f })
		end
	end
	banner(at + Vector3.new(8, 3, 8), 10, Color3.fromRGB(170, 50, 40), f)
end

-- 버려진 마을: 들판 가운데 오래전 비워진 집 다섯, 우물, 무너진 울타리, 묵은 밭
function LANDMARK.hamlet(at: Vector3, f: Instance)
	local spots = { { -24, -14, 0 }, { 18, -20, 90 }, { -20, 18, 180 }, { 24, 16, -90 }, { 0, 32, 180 } }
	for _, s in ipairs(spots) do
		house(at + Vector3.new(s[1], 0, s[2]), 14, 11, s[3], f)
	end
	-- 우물
	cyl("WellRing", at + Vector3.new(0, 1.4, 0), 3.2, 2.8, Color3.fromRGB(130, 125, 115), Enum.Material.Cobblestone, f)
	disc("WellWater", at + Vector3.new(0, 2.5, 0), 2.6, 0.1, Color3.fromRGB(50, 80, 90), Enum.Material.Glass, f, false)
	for _, x in ipairs({ -1, 1 }) do
		part({ Name = "WellPost", Size = Vector3.new(0.6, 6, 0.6), Position = at + Vector3.new(x * 3, 3, 0), Color = Color3.fromRGB(90, 65, 40), Material = Enum.Material.Wood, Parent = f })
	end
	part({ Name = "WellRoof", Size = Vector3.new(8, 0.5, 4), CFrame = CFrame.new(at + Vector3.new(0, 6.4, 0)) * CFrame.Angles(0, 0, 0), Color = Color3.fromRGB(80, 60, 45), Material = Enum.Material.Wood, Parent = f })
	-- 묵은 밭 (이랑)과 허수아비
	for k = 0, 5 do
		part({ Name = "FieldRow", Size = Vector3.new(26, 0.8, 1.6), Position = at + Vector3.new(-50, 0.4, -10 + k * 4), Color = Color3.fromRGB(110, 85, 55), Material = Enum.Material.Ground, CanCollide = false, Parent = f })
		if k % 2 == 0 then
			for j = 0, 4 do
				part({ Name = "FieldWeed", Size = Vector3.new(0.4, 1.4, 0.4), Position = at + Vector3.new(-60 + j * 5, 1.2, -10 + k * 4), Color = Color3.fromRGB(150, 140, 70), Material = Enum.Material.Grass, CanCollide = false, Parent = f })
			end
		end
	end
	part({ Name = "ScarecrowPost", Size = Vector3.new(0.5, 7, 0.5), Position = at + Vector3.new(-50, 3.5, 2), Color = Color3.fromRGB(100, 75, 45), Material = Enum.Material.Wood, Parent = f })
	part({ Name = "ScarecrowArms", Size = Vector3.new(6, 0.4, 0.4), Position = at + Vector3.new(-50, 5.5, 2), Color = Color3.fromRGB(100, 75, 45), Material = Enum.Material.Wood, Parent = f })
	part({ Name = "ScarecrowHat", Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.4, 3.6, 3.6), CFrame = CFrame.new(at + Vector3.new(-50, 7.3, 2)) * CFrame.Angles(0, 0, math.rad(90)), Color = Color3.fromRGB(200, 170, 110), Material = Enum.Material.Fabric, Parent = f })
	-- 무너진 울타리
	for k = 0, 9 do
		if k % 4 ~= 2 then
			local a = k / 10 * math.pi * 2
			local p = at + Vector3.new(math.cos(a) * 46, 0, math.sin(a) * 46)
			part({ Name = "OldFence", Size = Vector3.new(0.4, 2.6, 9), CFrame = CFrame.lookAt(p + Vector3.new(0, 1.3, 0), at + Vector3.new(0, 1.3, 0)) * CFrame.Angles(0, math.rad(90), math.rad((k % 3 - 1) * 8)), Color = Color3.fromRGB(95, 70, 45), Material = Enum.Material.Wood, Parent = f })
		end
	end
	tree(at + Vector3.new(30, 0, -36), 1.8, f)
	tree(at + Vector3.new(-36, 0, 34), 1.6, f)
end

-- 하늘 아치: 들판에 홀로 선 거대한 바위 아치. 위에서 덩굴과 작은 폭포가 흘러내린다
function LANDMARK.archway(at: Vector3, f: Instance)
	local rock2 = Color3.fromRGB(150, 115, 90)
	local n = 11
	for k = 0, n do
		local u = k / n
		local a = math.pi * u
		local p = at + Vector3.new(math.cos(a) * 34, math.sin(a) * 40, 0)
		local w = 14 - math.sin(a) * 5
		part({ Name = "ArchStone", Size = Vector3.new(w, 12, 12), CFrame = CFrame.new(p) * CFrame.Angles(0, 0, a + math.pi / 2) * CFrame.Angles(0, rng:NextNumber(-0.1, 0.1), 0), Color = rock2:Lerp(Color3.fromRGB(110, 85, 70), rng:NextNumber()), Material = Enum.Material.Sandstone, Parent = f })
	end
	-- 꼭대기의 풀과 늘어진 덩굴
	disc("ArchTopGrass", at + Vector3.new(0, 46.5, 0), 7, 0.6, Color3.fromRGB(90, 140, 60), Enum.Material.Grass, f, false)
	for k = -3, 3 do
		part({ Name = "ArchVine", Size = Vector3.new(0.35, 10 + (k % 2) * 6, 0.35), Position = at + Vector3.new(k * 2.6, 36 - (k % 2) * 3, rng:NextNumber(-3, 3)), Color = Color3.fromRGB(70, 120, 50), Material = Enum.Material.Grass, CanCollide = false, Parent = f })
	end
	-- 아치 아래로 흘러내리는 가는 폭포와 웅덩이
	local fall = part({ Name = "ArchFall", Size = Vector3.new(3, 30, 0.6), Position = at + Vector3.new(6, 20, 4), Color = Color3.fromRGB(170, 215, 240), Material = Enum.Material.Glass, CanCollide = false, Parent = f })
	fall.Transparency = 0.3
	emitter(fall, Color3.fromRGB(220, 240, 255), 14, 0.6, 2, 1)
	disc("ArchPool", at + Vector3.new(6, 0.25, 4), 9, 0.2, Color3.fromRGB(80, 150, 170), Enum.Material.Glass, f, false).Transparency = 0.2
	for k = 0, 5 do
		rock(at + Vector3.new(rng:NextNumber(-50, 50), 0, rng:NextNumber(-30, 30)), rng:NextNumber(3, 6), f, rock2)
	end
end

------------------------------------------------------------------------
-- 2.4판: 들판 채우기. 지역·길·랜드마크에서 떨어진 빈 땅에 작은 숲, 바위 무더기, 꽃밭, 덤불을 모아 놓는다 (늘 같은 자리)
------------------------------------------------------------------------
------------------------------------------------------------------------
-- 3.6판: 바깥 땅의 새 볼거리 열 곳 (빛깔은 돌·나무·기와의 차분한 색으로)
------------------------------------------------------------------------
local MOSS = Color3.fromRGB(88, 118, 66)
local WATER = Color3.fromRGB(88, 128, 140)
local TIMBER = Color3.fromRGB(78, 58, 42)
-- 가벼운 나무 (줄기 + 잎 뭉치 둘셋): 빈 들을 채우는 데 쓴다
local function lightTree(at: Vector3, s: number, leaf: Color3, f: Instance)
	local h = rng:NextNumber(7, 10) * s
	part({ Name = "LTrunk", Size = Vector3.new(1.1 * s, h, 1.1 * s), CFrame = CFrame.new(at + Vector3.new(0, h / 2, 0)) * CFrame.Angles(rng:NextNumber(-0.06, 0.06), rng:NextNumber(0, 6), rng:NextNumber(-0.06, 0.06)), Color = Color3.fromRGB(88, 62, 42), Material = Enum.Material.Wood, Parent = f })
	for i = 1, 2 do
		local sz = (6.5 - i) * s * rng:NextNumber(0.9, 1.2)
		part({ Name = "LLeaves", Shape = Enum.PartType.Ball, Size = Vector3.new(1, 0.8, 1) * sz, Position = at + Vector3.new(rng:NextNumber(-1, 1) * s, h + (i - 1) * 2.2 * s, rng:NextNumber(-1, 1) * s), Color = leaf:Lerp(Color3.new(1, 1, 1), (i - 1) * 0.06), Material = Enum.Material.LeafyGrass, CanCollide = false, Parent = f })
	end
end
-- 풀 무더기 (가는 쐐기 셋)
local function tuft(at: Vector3, s: number, color: Color3, f: Instance)
	for k = 0, 2 do
		part({ Name = "Tuft", Size = Vector3.new(0.2, 1.6 * s, 0.9 * s), CFrame = CFrame.new(at + Vector3.new(0, 0.8 * s, 0)) * CFrame.Angles(0, k * 2.1 + rng:NextNumber(0, 0.5), rng:NextNumber(-0.25, 0.25)), Color = color, Material = Enum.Material.Grass, CanCollide = false, Parent = f })
	end
end
-- 처마가 들린 지붕 판 (사방 끝에 작은 쐐기)
local function eave(center: Vector3, w: number, color: Color3, f: Instance)
	part({ Name = "Eave", Size = Vector3.new(w, 0.8, w), Position = center, Color = color, Material = Enum.Material.Slate, Parent = f })
	part({ Name = "Eave2", Size = Vector3.new(w - 2, 0.6, w - 2), Position = center + Vector3.new(0, 0.7, 0), Color = color:Lerp(Color3.new(0, 0, 0), 0.15), Material = Enum.Material.Slate, Parent = f })
	for _, sx in ipairs({ -1, 1 }) do
		for _, sz in ipairs({ -1, 1 }) do
			part({ Name = "EaveTip", Size = Vector3.new(0.6, 1.2, 1.8), CFrame = CFrame.lookAt(center + Vector3.new(sx * w / 2, 0.4, sz * w / 2), center + Vector3.new(sx * w, 2.5, sz * w)), Color = color, Material = Enum.Material.Slate, CanCollide = false, Parent = f })
		end
	end
end

-- 구층석탑: 낮은 언덕 위 아홉 층 돌탑, 오르는 돌계단과 석등, 둘레의 소나무
function LANDMARK.pagoda(at: Vector3, f: Instance)
	disc("PagodaHill", at + Vector3.new(0, 1, 0), 46, 2, Color3.fromRGB(112, 138, 84), Enum.Material.Grass, f)
	disc("PagodaHill2", at + Vector3.new(0, 3, 0), 32, 2, Color3.fromRGB(118, 142, 88), Enum.Material.Grass, f)
	disc("PagodaYard", at + Vector3.new(0, 4.2, 0), 18, 0.4, STONE, Enum.Material.Cobblestone, f)
	for i = 0, 5 do
		part({ Name = "PagodaStep", Size = Vector3.new(8, 0.8 + i * 0.7, 3), Position = at + Vector3.new(0, (0.8 + i * 0.7) / 2, 46 - i * 4), Color = STONE, Material = Enum.Material.Granite, Parent = f })
	end
	local y = 4.4
	local w = 13
	part({ Name = "PagodaBase", Size = Vector3.new(w + 4, 2, w + 4), Position = at + Vector3.new(0, y + 1, 0), Color = STONE_DARK, Material = Enum.Material.Granite, Parent = f })
	y += 2
	for tier = 1, 9 do
		local h = tier == 1 and 5 or 2.6
		part({ Name = "PagodaBody", Size = Vector3.new(w, h, w), Position = at + Vector3.new(0, y + h / 2, 0), Color = STONE:Lerp(STONE_DARK, 0.15), Material = Enum.Material.Granite, Parent = f })
		if tier == 1 then
			part({ Name = "PagodaDoor", Size = Vector3.new(3, 3.6, 0.3), Position = at + Vector3.new(0, y + 1.9, w / 2 + 0.05), Color = Color3.fromRGB(60, 55, 52), Material = Enum.Material.Slate, Parent = f })
		end
		y += h
		eave(at + Vector3.new(0, y + 0.4, 0), w + 4, Color3.fromRGB(110, 106, 104), f)
		y += 1.4
		w *= 0.88
	end
	-- 상륜: 둥근 고리 다섯과 구슬
	for k = 0, 4 do
		cyl("PagodaRing", at + Vector3.new(0, y + 0.6 + k * 1.1, 0), 1.3 - k * 0.12, 0.5, IRON, Enum.Material.Metal, f)
	end
	part({ Name = "PagodaJewel", Shape = Enum.PartType.Ball, Size = Vector3.new(1.6, 1.6, 1.6), Position = at + Vector3.new(0, y + 6.8, 0), Color = GOLD, Material = Enum.Material.Metal, Parent = f })
	for _, x in ipairs({ -1, 1 }) do
		stoneLantern(at + Vector3.new(x * 7, 4.4, 12), f, true)
	end
	for k = 0, 6 do
		local a = k / 7 * math.pi * 2 + 0.4
		pine(at + Vector3.new(math.cos(a) * 38, 1.5, math.sin(a) * 38), rng:NextNumber(1.3, 1.8), f, false)
	end
end

-- 연화정: 연못 한가운데 정자, 지그재그 나무다리, 연잎과 연꽃, 버드나무
function LANDMARK.lotuspond(at: Vector3, f: Instance)
	local R = 44
	disc("LotusBed", at + Vector3.new(0, 0.2, 0), R, 0.3, Color3.fromRGB(46, 62, 58), Enum.Material.Slate, f, false)
	local water = disc("LotusWater", at + Vector3.new(0, 0.5, 0), R, 0.3, WATER, Enum.Material.Glass, f, false)
	water.Transparency = 0.15
	water.Reflectance = 0.3
	for k = 0, 39 do
		local a = k / 40 * math.pi * 2
		rock(at + Vector3.new(math.cos(a) * (R + 1.5), 0, math.sin(a) * (R + 1.5)), rng:NextNumber(1.6, 2.6), f, Color3.fromRGB(130, 126, 118))
	end
	-- 정자 (기둥 여섯, 육각 지붕은 두 겹 판으로)
	disc("PavilionFloor", at + Vector3.new(0, 2, 0), 9, 1, Color3.fromRGB(120, 92, 64), Enum.Material.WoodPlanks, f)
	for k = 0, 5 do
		local a = k / 6 * math.pi * 2
		part({ Name = "PavilionPost", Size = Vector3.new(0.9, 9, 0.9), Position = at + Vector3.new(math.cos(a) * 7.5, 6.5, math.sin(a) * 7.5), Color = GATE_RED, Material = Enum.Material.Wood, Parent = f })
		part({ Name = "Stilt", Size = Vector3.new(0.8, 3, 0.8), Position = at + Vector3.new(math.cos(a) * 7, 0.8, math.sin(a) * 7), Color = TIMBER, Material = Enum.Material.Wood, Parent = f })
	end
	disc("PavilionRoof", at + Vector3.new(0, 11.4, 0), 11.5, 0.8, ROOF, Enum.Material.Slate, f)
	disc("PavilionRoof2", at + Vector3.new(0, 12.4, 0), 8, 1, ROOF:Lerp(Color3.new(0, 0, 0), 0.15), Enum.Material.Slate, f)
	disc("PavilionRoof3", at + Vector3.new(0, 13.4, 0), 4, 1, ROOF:Lerp(Color3.new(0, 0, 0), 0.25), Enum.Material.Slate, f)
	part({ Name = "PavilionFinial", Shape = Enum.PartType.Ball, Size = Vector3.new(1.4, 1.4, 1.4), Position = at + Vector3.new(0, 14.5, 0), Color = GOLD, Material = Enum.Material.Metal, Parent = f })
	-- 지그재그 다리 (정자에서 남쪽 물가로)
	local pts = { at + Vector3.new(0, 1.6, 9), at + Vector3.new(8, 1.6, 18), at + Vector3.new(-4, 1.6, 30), at + Vector3.new(2, 1.6, R + 4) }
	for i = 1, #pts - 1 do
		local a, b = pts[i], pts[i + 1]
		part({ Name = "Bridge", Size = Vector3.new(4, 0.6, (b - a).Magnitude + 2), CFrame = CFrame.lookAt((a + b) / 2, b), Color = Color3.fromRGB(128, 98, 68), Material = Enum.Material.WoodPlanks, Parent = f })
		for _, sx in ipairs({ -1, 1 }) do
			part({ Name = "BridgeRail", Size = Vector3.new(0.3, 0.3, (b - a).Magnitude + 2), CFrame = CFrame.lookAt((a + b) / 2, b) * CFrame.new(sx * 1.9, 1.4, 0), Color = TIMBER, Material = Enum.Material.Wood, CanCollide = false, Parent = f })
		end
	end
	-- 연잎과 연꽃
	for _ = 1, 30 do
		local a, r = rng:NextNumber(0, 6.28), rng:NextNumber(12, R - 4)
		local p = at + Vector3.new(math.cos(a) * r, 0.75, math.sin(a) * r)
		if (p - (at + Vector3.new(0, 0.75, 22))).Magnitude > 9 then
			part({ Name = "LotusPad", Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.12, rng:NextNumber(3, 5), rng:NextNumber(3, 5)), CFrame = CFrame.new(p) * CFrame.Angles(0, 0, math.rad(90)), Color = Color3.fromRGB(70, 118, 66), Material = Enum.Material.SmoothPlastic, CanCollide = false, Parent = f })
			if rng:NextNumber() < 0.35 then
				for k = 0, 4 do
					local pa = k / 5 * math.pi * 2
					part({ Name = "LotusPetal", Shape = Enum.PartType.Ball, Size = Vector3.new(0.7, 1.2, 0.4), CFrame = CFrame.new(p + Vector3.new(0, 0.8, 0)) * CFrame.Angles(0, pa, 0) * CFrame.new(0, 0, -0.4) * CFrame.Angles(math.rad(-25), 0, 0), Color = Color3.fromRGB(236, 176, 186), Material = Enum.Material.SmoothPlastic, CanCollide = false, Parent = f })
				end
			end
		end
	end
	for k = 0, 4 do
		local a = k / 5 * math.pi * 2 + 1
		tree(at + Vector3.new(math.cos(a) * (R + 10), 0, math.sin(a) * (R + 10)), rng:NextNumber(1.1, 1.4), f, false)
	end
end

-- 일검 바위: 칼로 벤 듯 반듯하게 갈라진 큰 바위. 벤 면은 매끈하고, 틈 사이로 지나갈 수 있다
function LANDMARK.splitrock(at: Vector3, f: Instance)
	local c = Color3.fromRGB(128, 124, 118)
	for _, sx in ipairs({ -1, 1 }) do
		local half = part({ Name = "SplitHalf", Size = Vector3.new(26, 34, 48), CFrame = CFrame.new(at + Vector3.new(sx * 19.5, 15, 0)) * CFrame.Angles(0, 0, sx * math.rad(-6)), Color = c, Material = Enum.Material.Slate, Parent = f })
		part({ Name = "SplitFace", Size = Vector3.new(0.4, 33, 47), CFrame = half.CFrame * CFrame.new(-sx * 13.1, 0, 0), Color = Color3.fromRGB(176, 170, 160), Material = Enum.Material.Marble, Parent = f })
		part({ Name = "SplitTop", Size = Vector3.new(20, 8, 30), CFrame = half.CFrame * CFrame.new(sx * 3, 18, rng:NextNumber(-6, 6)) * CFrame.Angles(rng:NextNumber(-0.2, 0.2), rng:NextNumber(0, 1), 0), Color = c:Lerp(Color3.new(0, 0, 0), 0.08), Material = Enum.Material.Slate, Parent = f })
		part({ Name = "SplitMoss", Size = Vector3.new(18, 1, 26), CFrame = half.CFrame * CFrame.new(sx * 3, 22.2, 0), Color = MOSS, Material = Enum.Material.Grass, CanCollide = false, Parent = f })
		pine(at + Vector3.new(sx * 20, 37, rng:NextNumber(-8, 8)), 0.9, f, false)
		for k = 0, 3 do
			rock(at + Vector3.new(sx * (32 + k * 3), 0, -18 + k * 12), rng:NextNumber(3, 5), f, c)
		end
	end
	-- 벤 면에 새긴 글
	local plate = part({ Name = "SplitWords", Size = Vector3.new(0.3, 10, 6), CFrame = CFrame.new(at + Vector3.new(-6.4, 14, 0)) * CFrame.Angles(0, 0, math.rad(6)), Color = Color3.fromRGB(176, 170, 160), Material = Enum.Material.Marble, CanCollide = false, Parent = f })
	sign(plate, Enum.NormalId.Right, { { "일 검", Color3.fromRGB(60, 52, 48), 1 }, { "한 번 베고 다시 베지 않았다", Color3.fromRGB(80, 70, 64), 0.4 } })
	part({ Name = "SplitPath", Size = Vector3.new(5, 0.3, 70), Position = at + Vector3.new(0, 0.15, 0), Color = Color3.fromRGB(150, 138, 118), Material = Enum.Material.Ground, CanCollide = false, Parent = f })
end

-- 천등 회랑: 곧은 돌길 양옆에 불 켠 석등이 줄지어 서고, 붉은 문 셋을 지나 작은 사당에 닿는다
function LANDMARK.lanternway(at: Vector3, f: Instance)
	local L = 130
	local from = at + Vector3.new(0, 0, L / 2)
	part({ Name = "LanternPath", Size = Vector3.new(10, 0.4, L), Position = at + Vector3.new(0, 0.2, 0), Color = STONE, Material = Enum.Material.Cobblestone, Parent = f })
	for k = 0, 10 do
		local z = L / 2 - 6 - k * 12
		for _, sx in ipairs({ -1, 1 }) do
			stoneLantern(at + Vector3.new(sx * 7.5, 0.4, z), f, k % 2 == 0)
		end
	end
	for k = 0, 2 do
		local z = L / 2 - 20 - k * 38
		for _, sx in ipairs({ -1, 1 }) do
			part({ Name = "GatePost", Size = Vector3.new(1.4, 14, 1.4), Position = at + Vector3.new(sx * 6, 7, z), Color = GATE_RED, Material = Enum.Material.Wood, Parent = f })
		end
		part({ Name = "GateBeam", Size = Vector3.new(16, 1.2, 1.6), Position = at + Vector3.new(0, 13.4, z), Color = GATE_RED, Material = Enum.Material.Wood, Parent = f })
		part({ Name = "GateBeam2", Size = Vector3.new(18, 0.8, 2.2), Position = at + Vector3.new(0, 14.6, z), Color = ROOF, Material = Enum.Material.Slate, Parent = f })
	end
	building(at + Vector3.new(0, 0, -L / 2 - 10), 16, 12, 0, f, { tiers = 1, h = 8, sign = "천등사" })
	local big = part({ Name = "GreatLantern", Size = Vector3.new(3, 4, 3), Position = at + Vector3.new(0, 6, -L / 2 + 4), Color = WARM, Material = Enum.Material.Neon, CanCollide = false, Parent = f })
	light(big, WARM, 30, 1.4)
	part({ Name = "GreatLanternCap", Size = Vector3.new(4.4, 0.8, 4.4), Position = at + Vector3.new(0, 8.4, -L / 2 + 4), Color = IRON, Material = Enum.Material.Metal, Parent = f })
	part({ Name = "GreatLanternPost", Size = Vector3.new(0.8, 4, 0.8), Position = at + Vector3.new(0, 2, -L / 2 + 4), Color = IRON, Material = Enum.Material.Metal, Parent = f })
	for k = 0, 5 do
		local z = L / 2 - 10 - k * 22
		for _, sx in ipairs({ -1, 1 }) do
			lightTree(from + Vector3.new(sx * 18, 0, z - L / 2), rng:NextNumber(0.9, 1.2), Color3.fromRGB(86, 122, 70), f)
		end
	end
end

-- 무너진 장성: 동서로 길게 이어지다 군데군데 무너진 성벽, 낮은 망루 하나, 무너진 돌 더미
function LANDMARK.oldwall(at: Vector3, f: Instance)
	local c = Color3.fromRGB(150, 144, 132)
	local L = 300
	local seg = 20
	for k = 0, L / seg - 1 do
		local x = -L / 2 + seg / 2 + k * seg
		local broken = (k == 4 or k == 9 or k == 10)
		local h = broken and rng:NextNumber(3, 6) or 14 + rng:NextNumber(-1.5, 1.5)
		part({ Name = "WallBlock", Size = Vector3.new(seg, h, 8), Position = at + Vector3.new(x, h / 2, 0), Color = c:Lerp(Color3.new(0, 0, 0), rng:NextNumber(0, 0.1)), Material = Enum.Material.Cobblestone, Parent = f })
		if not broken then
			for m = 0, 2 do
				part({ Name = "Merlon", Size = Vector3.new(3.4, 2.4, 8.2), Position = at + Vector3.new(x - 6 + m * 6, h + 1.2, 0), Color = c, Material = Enum.Material.Cobblestone, Parent = f })
			end
			if k % 3 == 1 then
				part({ Name = "WallMoss", Size = Vector3.new(seg * 0.7, 0.5, 8.4), Position = at + Vector3.new(x, h * 0.6, 0), Color = MOSS, Material = Enum.Material.Grass, CanCollide = false, Parent = f })
			end
		else
			for _ = 1, 4 do
				rock(at + Vector3.new(x + rng:NextNumber(-8, 8), 0, rng:NextNumber(-10, 10)), rng:NextNumber(2.5, 4.5), f, c)
			end
		end
	end
	-- 망루
	local tw = at + Vector3.new(L / 2 - 30, 0, 0)
	part({ Name = "Tower", Size = Vector3.new(16, 24, 16), Position = tw + Vector3.new(0, 12, 0), Color = c, Material = Enum.Material.Cobblestone, Parent = f })
	for _, sx in ipairs({ -1, 1 }) do
		for _, sz in ipairs({ -1, 1 }) do
			part({ Name = "TowerMerlon", Size = Vector3.new(3, 3, 3), Position = tw + Vector3.new(sx * 6.5, 25.5, sz * 6.5), Color = c, Material = Enum.Material.Cobblestone, Parent = f })
		end
	end
	part({ Name = "TowerWindow", Size = Vector3.new(2, 4, 0.3), Position = tw + Vector3.new(0, 16, 8.05), Color = Color3.fromRGB(30, 28, 30), Material = Enum.Material.Slate, Parent = f })
	for k = 0, 7 do
		tuft(at + Vector3.new(rng:NextNumber(-L / 2, L / 2), 0, rng:NextNumber(-14, 14)), 1.3, Color3.fromRGB(120, 140, 80), f)
	end
end

-- 학 연못: 얕은 연못에 돌로 깎은 학 셋, 갈대와 징검돌, 돌 의자
function LANDMARK.cranepond(at: Vector3, f: Instance)
	local R = 30
	disc("CraneBed", at + Vector3.new(0, 0.2, 0), R, 0.3, Color3.fromRGB(56, 70, 66), Enum.Material.Slate, f, false)
	local w = disc("CraneWater", at + Vector3.new(0, 0.45, 0), R, 0.3, WATER, Enum.Material.Glass, f, false)
	w.Transparency = 0.2
	local stone = Color3.fromRGB(214, 210, 200)
	for k, off in ipairs({ Vector3.new(-6, 0, -4), Vector3.new(5, 0, 2), Vector3.new(-1, 0, 9) }) do
		local p = at + off
		local yaw = k * 2.1
		local base = CFrame.new(p) * CFrame.Angles(0, yaw, 0)
		for _, lx in ipairs({ -0.5, 0.5 }) do
			part({ Name = "CraneLeg", Size = Vector3.new(0.3, 5, 0.3), CFrame = base * CFrame.new(lx, 2.5, 0), Color = Color3.fromRGB(70, 66, 62), Material = Enum.Material.Slate, Parent = f })
		end
		part({ Name = "CraneBody", Shape = Enum.PartType.Ball, Size = Vector3.new(3, 3.2, 5), CFrame = base * CFrame.new(0, 6.2, 0) * CFrame.Angles(math.rad(-12), 0, 0), Color = stone, Material = Enum.Material.Marble, Parent = f })
		part({ Name = "CraneTail", Size = Vector3.new(2, 0.6, 2), CFrame = base * CFrame.new(0, 6.4, 2.6) * CFrame.Angles(math.rad(20), 0, 0), Color = Color3.fromRGB(60, 58, 56), Material = Enum.Material.Slate, Parent = f })
		local neckLean = k == 2 and -50 or -10
		part({ Name = "CraneNeck", Size = Vector3.new(0.6, 5, 0.6), CFrame = base * CFrame.new(0, 9, -1.6) * CFrame.Angles(math.rad(neckLean), 0, 0), Color = stone, Material = Enum.Material.Marble, Parent = f })
		local head = base * CFrame.new(0, 11.4 + (k == 2 and -2 or 0), -2.4 + (k == 2 and -1.5 or 0))
		part({ Name = "CraneHead", Shape = Enum.PartType.Ball, Size = Vector3.new(1.1, 1.1, 1.4), CFrame = head, Color = stone, Material = Enum.Material.Marble, Parent = f })
		part({ Name = "CraneCrown", Shape = Enum.PartType.Ball, Size = Vector3.new(0.6, 0.4, 0.6), CFrame = head * CFrame.new(0, 0.5, 0), Color = Color3.fromRGB(170, 60, 55), Material = Enum.Material.SmoothPlastic, Parent = f })
		part({ Name = "CraneBeak", Size = Vector3.new(0.25, 0.25, 2), CFrame = head * CFrame.new(0, -0.1, -1.4), Color = Color3.fromRGB(70, 66, 62), Material = Enum.Material.Slate, Parent = f })
	end
	for k = 0, 5 do
		disc("SteppingStone", at + Vector3.new(14 - k * 2, 0.7, R - 3 - k * 4), 1.6, 0.6, Color3.fromRGB(150, 146, 138), Enum.Material.Slate, f)
	end
	for _ = 1, 14 do
		local a = rng:NextNumber(0, 6.28)
		local p = at + Vector3.new(math.cos(a) * (R - 2), 0, math.sin(a) * (R - 2))
		for m = 0, 3 do
			part({ Name = "Reed", Size = Vector3.new(0.2, rng:NextNumber(4, 6), 0.2), CFrame = CFrame.new(p + Vector3.new(m * 0.5, 2.5, rng:NextNumber(-0.5, 0.5))) * CFrame.Angles(rng:NextNumber(-0.12, 0.12), 0, rng:NextNumber(-0.12, 0.12)), Color = Color3.fromRGB(120, 130, 80), Material = Enum.Material.Grass, CanCollide = false, Parent = f })
		end
	end
	part({ Name = "StoneBench", Size = Vector3.new(7, 1, 2.4), Position = at + Vector3.new(R + 8, 2, 0), Color = Color3.fromRGB(150, 146, 138), Material = Enum.Material.Granite, Parent = f })
	for _, x in ipairs({ -2.6, 2.6 }) do
		part({ Name = "BenchLeg", Size = Vector3.new(1, 1.6, 2), Position = at + Vector3.new(R + 8 + x, 0.8, 0), Color = Color3.fromRGB(120, 116, 110), Material = Enum.Material.Granite, Parent = f })
	end
end

-- 귀부 비석: 큰 돌거북이 등에 비석을 지고 있다. 낮은 돌 난간이 두른다
function LANDMARK.turtlestele(at: Vector3, f: Instance)
	local c = Color3.fromRGB(122, 120, 116)
	part({ Name = "SteleYard", Size = Vector3.new(44, 1, 44), Position = at + Vector3.new(0, 0.5, 0), Color = STONE, Material = Enum.Material.Cobblestone, Parent = f })
	for k = 0, 15 do
		local a = k / 16 * math.pi * 2
		part({ Name = "Rail", Size = Vector3.new(1.2, 2.4, 7.5), CFrame = CFrame.new(at + Vector3.new(math.cos(a) * 21, 2, math.sin(a) * 21)) * CFrame.Angles(0, -a, 0), Color = STONE_DARK, Material = Enum.Material.Granite, Parent = f })
	end
	local body = at + Vector3.new(0, 1, 0)
	part({ Name = "Shell", Shape = Enum.PartType.Ball, Size = Vector3.new(22, 9, 26), Position = body + Vector3.new(0, 4, 0), Color = c, Material = Enum.Material.Slate, Parent = f })
	for k = 0, 5 do
		local a = k / 6 * math.pi * 2
		part({ Name = "ShellPlate", Size = Vector3.new(5, 0.6, 5), CFrame = CFrame.new(body + Vector3.new(math.cos(a) * 6, 7.4, math.sin(a) * 7)) * CFrame.Angles(math.cos(a) * 0.3, a, math.sin(a) * 0.3), Color = c:Lerp(Color3.new(0, 0, 0), 0.12), Material = Enum.Material.Slate, Parent = f })
	end
	part({ Name = "TurtleHead", Shape = Enum.PartType.Ball, Size = Vector3.new(5, 4.6, 6.5), Position = body + Vector3.new(0, 4, -15), Color = c, Material = Enum.Material.Slate, Parent = f })
	for _, sx in ipairs({ -1, 1 }) do
		part({ Name = "TurtleEye", Shape = Enum.PartType.Ball, Size = Vector3.new(0.8, 0.8, 0.8), Position = body + Vector3.new(sx * 1.6, 5.2, -17.6), Color = Color3.fromRGB(40, 38, 36), Material = Enum.Material.Slate, Parent = f })
		for _, sz in ipairs({ -1, 1 }) do
			part({ Name = "TurtleLeg", Shape = Enum.PartType.Ball, Size = Vector3.new(4.6, 3.4, 5.6), Position = body + Vector3.new(sx * 10, 1.4, sz * 9), Color = c, Material = Enum.Material.Slate, Parent = f })
		end
	end
	local stele = part({ Name = "Stele", Size = Vector3.new(9, 20, 2.4), Position = body + Vector3.new(0, 18, 0), Color = Color3.fromRGB(72, 70, 72), Material = Enum.Material.Slate, Parent = f })
	part({ Name = "SteleCap", Size = Vector3.new(11, 2.6, 3.4), Position = body + Vector3.new(0, 29.3, 0), Color = Color3.fromRGB(60, 58, 60), Material = Enum.Material.Slate, Parent = f })
	sign(stele, Enum.NormalId.Front, { { "강호를 지나간 이들의 이름은", Color3.fromRGB(225, 215, 190), 0.4 }, { "바람이 기억한다", Color3.fromRGB(225, 215, 190), 0.4 } })
	sign(stele, Enum.NormalId.Back, { { "일곱 돌탑을 쌓은 이에게", Color3.fromRGB(225, 215, 190), 0.4 }, { "길이 답한다", Color3.fromRGB(225, 215, 190), 0.4 } })
end

-- 버려진 광산: 바위 언덕의 나무 갱도 입구, 밖으로 이어진 레일과 수레, 상자, 광석 더미
function LANDMARK.oldmine(at: Vector3, f: Instance)
	local c = Color3.fromRGB(110, 98, 88)
	-- 뒤쪽 바위 언덕: 크기와 기울기가 다른 큰 바위 판 넷이 겹친다 (입구 앞은 비운다)
	for k, sp in ipairs({ { -14, 18, 30, 26, 14 }, { 12, 22, 26, 22, -10 }, { -2, 26, 22, 18, 4 }, { 22, 14, 18, 20, 22 } }) do
		part({ Name = "MineRock", Size = Vector3.new(sp[3], sp[2], sp[4]), CFrame = CFrame.new(at + Vector3.new(sp[1], sp[2] * 0.42, -24 - k * 2)) * CFrame.Angles(math.rad(rng:NextNumber(-6, 6)), math.rad(sp[5]), math.rad(rng:NextNumber(-5, 5))),
			Color = c:Lerp(Color3.new(0, 0, 0), k * 0.04), Material = Enum.Material.Slate, Parent = f })
	end
	for k = 0, 5 do
		local a = math.rad(200 + k * 28)
		crag(at + Vector3.new(math.cos(a) * 30, 0, math.sin(a) * 26 - 18), rng:NextNumber(1.8, 2.6), c, f)
	end
	part({ Name = "MineMoss", Size = Vector3.new(30, 0.6, 18), CFrame = CFrame.new(at + Vector3.new(-6, 21, -30)) * CFrame.Angles(math.rad(4), 0.2, 0), Color = MOSS, Material = Enum.Material.Grass, CanCollide = false, Parent = f })
	part({ Name = "MineMouth", Size = Vector3.new(10, 11, 1), Position = at + Vector3.new(0, 5.5, -10.6), Color = Color3.fromRGB(16, 14, 14), Material = Enum.Material.Slate, Parent = f })
	for _, sx in ipairs({ -1, 1 }) do
		part({ Name = "MinePost", Size = Vector3.new(1.4, 12, 1.4), Position = at + Vector3.new(sx * 5.6, 6, -10), Color = TIMBER, Material = Enum.Material.Wood, Parent = f })
	end
	part({ Name = "MineLintel", Size = Vector3.new(14, 1.6, 1.8), Position = at + Vector3.new(0, 12.4, -10), Color = TIMBER, Material = Enum.Material.Wood, Parent = f })
	-- 레일 (침목 위 두 줄)
	for k = 0, 16 do
		part({ Name = "Sleeper", Size = Vector3.new(5, 0.4, 1), Position = at + Vector3.new(0, 0.2, -8 + k * 3), Color = TIMBER, Material = Enum.Material.Wood, Parent = f })
	end
	for _, sx in ipairs({ -1, 1 }) do
		part({ Name = "Rail", Size = Vector3.new(0.35, 0.35, 52), Position = at + Vector3.new(sx * 1.6, 0.55, 16), Color = Color3.fromRGB(90, 80, 74), Material = Enum.Material.Metal, Parent = f })
	end
	for i, z in ipairs({ 10, 30 }) do
		local cart = at + Vector3.new(0, 0, z)
		part({ Name = "Cart", Size = Vector3.new(4.4, 2.6, 5.4), Position = cart + Vector3.new(0, 2.4, 0), Color = Color3.fromRGB(96, 76, 58), Material = Enum.Material.WoodPlanks, Parent = f })
		for _, sx in ipairs({ -1, 1 }) do
			for _, sz in ipairs({ -1, 1 }) do
				cyl("CartWheel", cart + Vector3.new(sx * 2.4, 1, sz * 1.8), 0.9, 0.4, IRON, Enum.Material.Metal, f).CFrame = CFrame.new(cart + Vector3.new(sx * 2.4, 1, sz * 1.8))
			end
		end
		if i == 1 then
			for _ = 1, 5 do
				part({ Name = "Ore", Size = Vector3.one * rng:NextNumber(0.8, 1.4), CFrame = CFrame.new(cart + Vector3.new(rng:NextNumber(-1.4, 1.4), 4, rng:NextNumber(-2, 2))) * CFrame.Angles(rng:NextNumber(0, 3), rng:NextNumber(0, 3), 0), Color = Color3.fromRGB(70, 66, 72), Material = Enum.Material.Slate, Parent = f })
			end
		end
	end
	for k = 0, 3 do
		part({ Name = "Crate", Size = Vector3.new(3, 3, 3), CFrame = CFrame.new(at + Vector3.new(8 + (k % 2) * 3.2, 1.5 + math.floor(k / 2) * 3, -4 + (k % 2))) * CFrame.Angles(0, rng:NextNumber(-0.2, 0.2), 0), Color = Color3.fromRGB(130, 100, 66), Material = Enum.Material.WoodPlanks, Parent = f })
	end
	part({ Name = "MineLampPost", Size = Vector3.new(0.6, 7, 0.6), Position = at + Vector3.new(-8, 3.5, -6), Color = TIMBER, Material = Enum.Material.Wood, Parent = f })
	local lamp = part({ Name = "MineLamp", Size = Vector3.new(1.2, 1.6, 1.2), Position = at + Vector3.new(-8, 7.6, -6), Color = WARM, Material = Enum.Material.Neon, CanCollide = false, Parent = f })
	light(lamp, WARM, 16, 1)
end

-- 선인송: 구름 위로 솟은 좁은 돌기둥 꼭대기의 늙은 소나무, 줄사다리, 기둥 아래 작은 움막
function LANDMARK.lonepine(at: Vector3, f: Instance)
	local c = Color3.fromRGB(120, 118, 112)
	local y = 0
	for k = 0, 5 do
		local w = 18 - k * 1.6
		local h = 9
		part({ Name = "Pillar", Size = Vector3.new(w, h, w * 0.9), CFrame = CFrame.new(at + Vector3.new(rng:NextNumber(-1, 1), y + h / 2, rng:NextNumber(-1, 1))) * CFrame.Angles(0, rng:NextNumber(0, 6), rng:NextNumber(-0.04, 0.04)), Color = c:Lerp(Color3.new(0, 0, 0), k * 0.02), Material = Enum.Material.Slate, Parent = f })
		y += h
	end
	-- 비틀린 줄기와 넓게 퍼진 가지 층
	local top = at + Vector3.new(0, y, 0)
	part({ Name = "OldPineTrunk", Size = Vector3.new(1.6, 9, 1.6), CFrame = CFrame.new(top + Vector3.new(1, 4, 0)) * CFrame.Angles(0, 0, math.rad(-20)), Color = Color3.fromRGB(86, 60, 44), Material = Enum.Material.Wood, Parent = f })
	for k = 0, 2 do
		local p = top + Vector3.new(3 + k * 2, 8 + k * 2, rng:NextNumber(-2, 2))
		part({ Name = "OldPineLayer", Size = Vector3.new(14 - k * 3, 2, 10 - k * 2), CFrame = CFrame.new(p) * CFrame.Angles(0, rng:NextNumber(-0.3, 0.3), math.rad(-6)), Color = Color3.fromRGB(46, 84, 58), Material = Enum.Material.Grass, CanCollide = false, Parent = f })
	end
	-- 허리에 걸린 옅은 구름 둘 (공 여럿을 겹쳐 모양이 고르지 않게)
	for k = 0, 1 do
		local a = k * math.pi + 0.6
		local cc = at + Vector3.new(math.cos(a) * 13, y * (0.55 + k * 0.15), math.sin(a) * 13)
		for m = 0, 3 do
			local cl = part({ Name = "PillarCloud", Shape = Enum.PartType.Ball, Size = Vector3.new(rng:NextNumber(7, 11), rng:NextNumber(2.5, 4), rng:NextNumber(5, 8)), Position = cc + Vector3.new((m - 1.5) * 4, rng:NextNumber(-0.6, 0.6), rng:NextNumber(-2, 2)), Color = Color3.fromRGB(240, 242, 246), Material = Enum.Material.SmoothPlastic, CanCollide = false, Parent = f })
			cl.Transparency = 0.55
		end
	end
	for k = 0, math.floor(y / 2) do
		part({ Name = "LadderRung", Size = Vector3.new(2, 0.2, 0.2), Position = at + Vector3.new(0, 1 + k * 2, 9.3), Color = TIMBER, Material = Enum.Material.Wood, CanCollide = false, Parent = f })
	end
	for _, sx in ipairs({ -1, 1 }) do
		part({ Name = "LadderRope", Size = Vector3.new(0.15, y, 0.15), Position = at + Vector3.new(sx, y / 2, 9.3), Color = Color3.fromRGB(150, 128, 92), Material = Enum.Material.Fabric, CanCollide = false, Parent = f })
	end
	building(at + Vector3.new(16, 0, 16), 8, 7, math.rad(-35), f, { tiers = 1, h = 5 })
end

-- 해시계 광장: 둥근 돌 광장, 둘레의 열두 시 돌, 가운데 비스듬한 해시계 바늘, 낮은 생울타리
function LANDMARK.sundial(at: Vector3, f: Instance)
	local R = 36
	disc("SundialPlaza", at + Vector3.new(0, 0.3, 0), R, 0.6, STONE, Enum.Material.Cobblestone, f)
	disc("SundialFace", at + Vector3.new(0, 0.7, 0), 14, 0.4, Color3.fromRGB(222, 214, 196), Enum.Material.Marble, f)
	for k = 0, 11 do
		local a = k / 12 * math.pi * 2
		part({ Name = "HourLine", Size = Vector3.new(0.3, 0.2, 12), CFrame = CFrame.new(at + Vector3.new(math.cos(a) * 7, 0.95, math.sin(a) * 7)) * CFrame.Angles(0, -a + math.pi / 2, 0), Color = Color3.fromRGB(90, 84, 78), Material = Enum.Material.Slate, CanCollide = false, Parent = f })
		part({ Name = "HourStone", Size = Vector3.new(2.4, 3 + (k % 3 == 0 and 2 or 0), 2.4), Position = at + Vector3.new(math.cos(a) * (R - 4), 1.8, math.sin(a) * (R - 4)), Color = STONE_DARK, Material = Enum.Material.Granite, Parent = f })
	end
	-- 해시계 바늘: 북쪽을 향해 비스듬히 선 청동 판
	part({ Name = "Gnomon", Size = Vector3.new(0.8, 14, 2.4), CFrame = CFrame.new(at + Vector3.new(0, 5.4, 3)) * CFrame.Angles(math.rad(-40), 0, 0), Color = Color3.fromRGB(150, 110, 60), Material = Enum.Material.Metal, Parent = f })
	part({ Name = "GnomonFoot", Size = Vector3.new(3, 1.2, 3), Position = at + Vector3.new(0, 1.3, 0), Color = Color3.fromRGB(120, 90, 54), Material = Enum.Material.Metal, Parent = f })
	for k = 0, 23 do
		local a = k / 24 * math.pi * 2
		if k % 6 ~= 0 then
			bush(at + Vector3.new(math.cos(a) * (R + 3), 0, math.sin(a) * (R + 3)), 0.9, Color3.fromRGB(70, 110, 58), f)
		end
	end
	for k = 0, 3 do
		local a = k / 4 * math.pi * 2 + math.pi / 4
		part({ Name = "PlazaBench", Size = Vector3.new(6, 1, 2), CFrame = CFrame.new(at + Vector3.new(math.cos(a) * 22, 1.6, math.sin(a) * 22)) * CFrame.Angles(0, -a + math.pi / 2, 0), Color = Color3.fromRGB(130, 98, 66), Material = Enum.Material.WoodPlanks, Parent = f })
		lightTree(at + Vector3.new(math.cos(a) * (R + 14), 0, math.sin(a) * (R + 14)), 1.2, Color3.fromRGB(84, 124, 70), f)
	end
end

------------------------------------------------------------------------
-- 3.6판: 빈 들 채우기. 230칸 격자마다 (조금 흔들어) 그 땅에 맞는 작은 풍경 하나와 바닥 무늬 하나
-- 가까운 땅을 따라 숲·눈·마른 들·늪·잿빛 들·바닷가·단풍으로 고른다 (번쩍이는 색은 쓰지 않는다)
------------------------------------------------------------------------
local BIOME_OF = { snow = "snow", sky = "snow", desert = "dry", badlands = "dry", swamp = "wet", cult = "ash", rift = "ash", volcano = "ash", coast = "coast", maple = "autumn", stone = "dry", mushroom = "wet", tea = "green" }
local function biomeAt(p: Vector3): string
	local best, bestD = "green", 650
	for _, r in ipairs(Config.Regions) do
		if r.ambient and not r.noGround then
			local dx = math.max(0, math.abs(p.X - r.center.X) - r.size.X / 2)
			local dz = math.max(0, math.abs(p.Z - r.center.Z) - r.size.Z / 2)
			local d = math.sqrt(dx * dx + dz * dz)
			if d < bestD then
				best, bestD = BIOME_OF[r.ambient] or "green", d
			end
		end
	end
	return best
end
local function nearEgg(p: Vector3, d: number): boolean
	for _, c in ipairs(Config.CAIRNS or {}) do
		if (Vector3.new(p.X, 0, p.Z) - c).Magnitude < d then
			return true
		end
	end
	for _, e in pairs(Config.EGGS or {}) do
		if typeof(e) == "table" and e.at and (Vector3.new(p.X, 0, p.Z) - Vector3.new(e.at.X, 0, e.at.Z)).Magnitude < d then
			return true
		end
	end
	return false
end
local function scatterFill()
	local f = Instance.new("Folder")
	f.Name = "Scatter"
	f.Parent = folder
	local R = Random.new(3606)
	local W = Config.WORLD_HALF
	local STEP = 250
	local made = 0
	for gx = -W + 200, W - 200, STEP do
		for gz = -W + 200, W - 200, STEP do
			local c = Vector3.new(gx + R:NextNumber(-70, 70), 0, gz + R:NextNumber(-70, 70))
			if not inAnyRegion(c, 50) and not nearFeature(c, 40) and not nearRoad(c, 24) and not nearEgg(c, 40) then
				made += 1
				local b = biomeAt(c)
				-- 3.9.1판: 바닥의 둥근 무늬는 반복돼 어색해서 걷어 냈다
				local roll = R:NextNumber()
				if b == "snow" then
					for k = 0, 1 + made % 2 do
						pine(c + Vector3.new(R:NextNumber(-12, 12), 0, R:NextNumber(-12, 12)), R:NextNumber(1.0, 1.6), f, true)
					end
					rock(c + Vector3.new(R:NextNumber(-10, 10), 0, R:NextNumber(-10, 10)), R:NextNumber(2.5, 4), f, Color3.fromRGB(160, 166, 176))
				elseif b == "dry" then
					if roll < 0.5 then
						deadTree(c, R:NextNumber(0.8, 1.2), f)
					end
					for k = 0, 2 do
						rock(c + Vector3.new(R:NextNumber(-12, 12), 0, R:NextNumber(-12, 12)), R:NextNumber(2, 4.5), f, Color3.fromRGB(176, 128, 90))
					end
					bush(c + Vector3.new(6, 0, -5), 0.8, Color3.fromRGB(140, 128, 80), f)
				elseif b == "wet" then
					deadTree(c, R:NextNumber(0.7, 1.0), f)
					local pond = part({ Name = "Puddle", Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.25, R:NextNumber(10, 16), R:NextNumber(10, 16)), CFrame = CFrame.new(c + Vector3.new(8, 0.15, 6)) * CFrame.Angles(0, 0, math.rad(90)), Color = Color3.fromRGB(60, 78, 70), Material = Enum.Material.Glass, CanCollide = false, Parent = f })
					pond.Transparency = 0.2
					for k = 0, 3 do
						tuft(c + Vector3.new(8 + R:NextNumber(-6, 6), 0, 6 + R:NextNumber(-6, 6)), 1.6, Color3.fromRGB(110, 120, 70), f)
					end
				elseif b == "ash" then
					crag(c, R:NextNumber(0.8, 1.3), Color3.fromRGB(70, 62, 62), f)
					if roll < 0.6 then
						deadTree(c + Vector3.new(10, 0, -6), R:NextNumber(0.7, 1.0), f)
					end
					rock(c + Vector3.new(-8, 0, 8), R:NextNumber(2, 3.5), f, Color3.fromRGB(64, 58, 58))
				elseif b == "coast" then
					for k = 0, 4 do
						tuft(c + Vector3.new(R:NextNumber(-12, 12), 0, R:NextNumber(-12, 12)), 1.2, Color3.fromRGB(150, 150, 96), f)
					end
					rock(c + Vector3.new(R:NextNumber(-6, 6), 0, R:NextNumber(-6, 6)), R:NextNumber(3, 5), f, Color3.fromRGB(140, 136, 126))
				elseif b == "autumn" then
					for k = 0, 2 do
						local leaf = ({ Color3.fromRGB(196, 96, 50), Color3.fromRGB(214, 150, 60), Color3.fromRGB(150, 60, 44) })[k + 1]
						lightTree(c + Vector3.new(R:NextNumber(-14, 14), 0, R:NextNumber(-14, 14)), R:NextNumber(1.0, 1.4), leaf, f)
					end
				else
					if roll < 0.4 then
						-- 작은 숲
						for k = 0, 2 do
							lightTree(c + Vector3.new(R:NextNumber(-14, 14), 0, R:NextNumber(-14, 14)), R:NextNumber(1.0, 1.5), Color3.fromRGB(76, 116, 62):Lerp(Color3.fromRGB(100, 140, 72), R:NextNumber()), f)
						end
						bush(c + Vector3.new(5, 0, 4), 1.1, Color3.fromRGB(72, 116, 56), f)
					elseif roll < 0.65 then
						-- 바위와 풀
						rock(c, R:NextNumber(3.5, 6), f)
						rock(c + Vector3.new(7, 0, -4), R:NextNumber(2, 3), f)
						for k = 0, 2 do
							tuft(c + Vector3.new(R:NextNumber(-9, 9), 0, R:NextNumber(-9, 9)), 1.3, Color3.fromRGB(96, 130, 70), f)
						end
					elseif roll < 0.85 then
						-- 들꽃 (차분한 빛깔 한 가지)
						local col = ({ Color3.fromRGB(236, 226, 196), Color3.fromRGB(196, 170, 214), Color3.fromRGB(226, 196, 120) })[made % 3 + 1]
						for k = 0, 7 do
							part({ Name = "WildFlower", Shape = Enum.PartType.Ball, Size = Vector3.new(0.9, 0.45, 0.9), Position = c + Vector3.new(R:NextNumber(-8, 8), 0.7, R:NextNumber(-8, 8)), Color = col, Material = Enum.Material.SmoothPlastic, CanCollide = false, Parent = f })
						end
						lightTree(c + Vector3.new(10, 0, 8), 1.1, Color3.fromRGB(86, 124, 66), f)
					else
						-- 길가의 작은 돌무더기와 쓰러진 통나무
						part({ Name = "Log", Shape = Enum.PartType.Cylinder, Size = Vector3.new(8, 1.4, 1.4), CFrame = CFrame.new(c + Vector3.new(0, 0.7, 0)) * CFrame.Angles(0, R:NextNumber(0, 3), 0), Color = Color3.fromRGB(96, 72, 50), Material = Enum.Material.Wood, Parent = f })
						bush(c + Vector3.new(-5, 0, 4), 1, Color3.fromRGB(76, 118, 58), f)
						rock(c + Vector3.new(6, 0, 6), 2.4, f)
					end
				end
			end
		end
	end
	return made
end

------------------------------------------------------------------------
-- 3.6판 숨은 것들: 돌탑 일곱, 낮잠 자는 고양이, 뽑히지 않는 검, 소원 우물, 오리 가족
------------------------------------------------------------------------
local function easterEggs(out: any)
	local f = Instance.new("Folder")
	f.Name = "Hidden"
	f.Parent = folder
	out.eggs = {}
	for i, at in ipairs(Config.CAIRNS or {}) do
		local y = 0
		local top: Part? = nil
		for k = 0, 5 do
			local w = 3.4 - k * 0.45
			local h = 0.9 - k * 0.05
			top = part({ Name = "Cairn", Size = Vector3.new(w, h, w * 0.85), CFrame = CFrame.new(at + Vector3.new(rng:NextNumber(-0.15, 0.15), y + h / 2, rng:NextNumber(-0.15, 0.15))) * CFrame.Angles(0, rng:NextNumber(0, 6), rng:NextNumber(-0.05, 0.05)), Color = Color3.fromRGB(150, 146, 138):Lerp(Color3.new(0, 0, 0), rng:NextNumber(0, 0.12)), Material = Enum.Material.Slate, Parent = f })
			y += h
		end
		for k = 0, 3 do
			tuft(at + Vector3.new(math.cos(k * 1.6) * 3, 0, math.sin(k * 1.6) * 3), 1, Color3.fromRGB(110, 130, 80), f)
		end
		if top then
			out.eggs["cairn" .. i] = prompt(top, "돌 하나 올리기", "돌탑", "EggCairn" .. i)
		end
	end
	-- 낮잠 자는 고양이 (천년 종루 아래 돌단 모서리, 몸을 둥글게 말았다)
	local E = Config.EGGS
	if E and E.cat then
		local p = E.cat.at + Vector3.new(0, 4, 0)
		local fur = Color3.fromRGB(196, 150, 96)
		local body = part({ Name = "CatBody", Shape = Enum.PartType.Ball, Size = Vector3.new(2.2, 1.1, 1.6), Position = p + Vector3.new(0, 0.55, 0), Color = fur, Material = Enum.Material.Fabric, Parent = f })
		part({ Name = "CatHead", Shape = Enum.PartType.Ball, Size = Vector3.new(0.95, 0.85, 0.95), Position = p + Vector3.new(-0.9, 0.6, -0.45), Color = fur, Material = Enum.Material.Fabric, Parent = f })
		for _, sz in ipairs({ -1, 1 }) do
			part({ Name = "CatEar", Size = Vector3.new(0.3, 0.35, 0.12), CFrame = CFrame.new(p + Vector3.new(-1, 1.05, -0.45 + sz * 0.26)) * CFrame.Angles(0, math.rad(90), 0), Color = fur:Lerp(Color3.new(0, 0, 0), 0.2), Material = Enum.Material.Fabric, Parent = f })
		end
		part({ Name = "CatTail", Size = Vector3.new(0.3, 0.3, 1.8), CFrame = CFrame.new(p + Vector3.new(0.4, 0.3, 0.7)) * CFrame.Angles(0, math.rad(-60), 0), Color = fur:Lerp(Color3.new(0, 0, 0), 0.1), Material = Enum.Material.Fabric, Parent = f })
		out.eggs.cat = prompt(body, "쓰다듬기", "낮잠 자는 고양이", "EggCat")
	end
	-- 세상 끝 바위에 박힌 검
	if E and E.sword then
		local at = E.sword.at
		rock(at, 9, f, Color3.fromRGB(116, 112, 106))
		part({ Name = "SwordStone", Size = Vector3.new(7, 4, 6), Position = at + Vector3.new(0, 5, 0), Color = Color3.fromRGB(126, 122, 116), Material = Enum.Material.Slate, Parent = f })
		part({ Name = "SwordBlade", Size = Vector3.new(0.3, 5, 0.9), CFrame = CFrame.new(at + Vector3.new(0, 8.6, 0)) * CFrame.Angles(0, 0, math.rad(4)), Color = Color3.fromRGB(196, 200, 206), Material = Enum.Material.Metal, Parent = f })
		part({ Name = "SwordGuard", Size = Vector3.new(0.5, 0.4, 3), CFrame = CFrame.new(at + Vector3.new(0.18, 11.2, 0)) * CFrame.Angles(0, 0, math.rad(4)), Color = Color3.fromRGB(150, 120, 70), Material = Enum.Material.Metal, Parent = f })
		local grip = part({ Name = "SwordGrip", Size = Vector3.new(0.45, 2, 0.45), CFrame = CFrame.new(at + Vector3.new(0.26, 12.4, 0)) * CFrame.Angles(0, 0, math.rad(4)), Color = Color3.fromRGB(60, 40, 34), Material = Enum.Material.Fabric, Parent = f })
		part({ Name = "SwordPommel", Shape = Enum.PartType.Ball, Size = Vector3.new(0.7, 0.7, 0.7), Position = at + Vector3.new(0.34, 13.5, 0), Color = Color3.fromRGB(150, 120, 70), Material = Enum.Material.Metal, Parent = f })
		local pp = prompt(grip, "뽑아 본다", "바위에 박힌 검", "EggSword")
		pp.MaxActivationDistance = 14
		out.eggs.sword = pp
	end
	-- 버려진 마을의 우물 (우물가에 보이지 않는 손잡이)
	if E and E.well then
		local h = part({ Name = "WellWish", Size = Vector3.new(2, 2, 2), Position = E.well.at + Vector3.new(0, 3, 0), Transparency = 1, CanCollide = false, Parent = f })
		out.eggs.well = prompt(h, "은자 " .. E.well.cost .. " 던지기", "소원 우물", "EggWell")
	end
	-- 거울 호수의 오리 가족 (어미 하나, 새끼 셋이 줄지어)
	if E and E.ducks then
		local at = E.ducks.at + Vector3.new(0, 0.9, 0)
		local mother: Part? = nil
		for k = 0, 3 do
			local s = k == 0 and 1 or 0.55
			local p = at + Vector3.new(k * 2.2, 0, k * 0.6)
			local b = part({ Name = "DuckBody", Shape = Enum.PartType.Ball, Size = Vector3.new(1.6, 1, 1.1) * s, Position = p, Color = k == 0 and Color3.fromRGB(150, 120, 90) or Color3.fromRGB(226, 206, 140), Material = Enum.Material.SmoothPlastic, Parent = f })
			part({ Name = "DuckHead", Shape = Enum.PartType.Ball, Size = Vector3.new(0.7, 0.7, 0.7) * s, Position = p + Vector3.new(-0.7, 0.6, 0) * s, Color = k == 0 and Color3.fromRGB(60, 90, 70) or Color3.fromRGB(226, 206, 140), Material = Enum.Material.SmoothPlastic, Parent = f })
			part({ Name = "DuckBill", Size = Vector3.new(0.5, 0.15, 0.3) * s, Position = p + Vector3.new(-1.15, 0.55, 0) * s, Color = Color3.fromRGB(214, 150, 60), Material = Enum.Material.SmoothPlastic, Parent = f })
			if k == 0 then
				mother = b
			end
		end
		if mother then
			out.eggs.ducks = prompt(mother, "꽥", "오리 가족", "EggDucks")
		end
	end
end

------------------------------------------------------------------------
-- 3.7판 사부의 부탁: 찾을 것 (빛나는 작은 것)과 차례로 짚을 돌 (높이나 빛깔로 차례를 안다)
------------------------------------------------------------------------
local function questProps(out: any)
	local f = Instance.new("Folder")
	f.Name = "QuestProps"
	f.Parent = folder
	out.mq = {}
	for sid, q in pairs(Config.MINIQUEST or {}) do
		local st = Config.STYLE_BY_ID[sid]
		local glow = st and st.color2 or GOLD
		for si, step in ipairs(q.steps) do
			if step.kind == "find" then
				for i, at in ipairs(step.items) do
					local base = at + Vector3.new(0, 0.2, 0)
					part({ Name = "QuestMound", Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.3, 3.2, 3.2), CFrame = CFrame.new(base) * CFrame.Angles(0, 0, math.rad(90)), Color = Color3.fromRGB(120, 110, 96), Material = Enum.Material.Slate, Parent = f })
					local gem = part({ Name = "QuestFind", Size = Vector3.new(0.9, 1.3, 0.9), CFrame = CFrame.new(base + Vector3.new(0, 1.2, 0)) * CFrame.Angles(math.rad(45), math.rad(i * 37), math.rad(45)), Color = glow, Material = Enum.Material.Neon, CanCollide = false, Parent = f })
					light(gem, glow, 10, 1)
					local a = Instance.new("Attachment")
					a.Parent = gem
					local e = Instance.new("ParticleEmitter")
					e.Texture = "rbxasset://textures/particles/sparkles_main.dds"
					e.Color = ColorSequence.new(glow)
					e.LightEmission = 0.8
					e.Rate = 3
					e.Lifetime = NumberRange.new(0.8, 1.4)
					e.Speed = NumberRange.new(0.5, 1.5)
					e.Size = NumberSequence.new(0.25, 0)
					e.Parent = a
					local pp = prompt(gem, "살펴보기", step.name or "빛나는 것", "MQFind")
					table.insert(out.mq, { sid = sid, step = si, idx = i, prompt = pp })
				end
			elseif step.kind == "order" then
				-- 놓는 자리는 섞지 않는다 (차례의 단서는 높이나 빛깔)
				for i, sd in ipairs(step.stones) do
					if sd.label then
						-- 3.8판 글자 상자: 떠 있는 검은 상자의 네 면에 흰 글자
						local box = part({ Name = "QuestGlyph", Size = Vector3.new(3, 3, 3), CFrame = CFrame.new(sd.at + Vector3.new(0, 3.2, 0)) * CFrame.Angles(0, math.rad(i * 23), 0), Color = Color3.fromRGB(18, 18, 22), Material = Enum.Material.SmoothPlastic, CanCollide = false, Parent = f })
						for _, face in ipairs({ Enum.NormalId.Front, Enum.NormalId.Back, Enum.NormalId.Left, Enum.NormalId.Right }) do
							sign(box, face, { { sd.label, Color3.fromRGB(240, 240, 245), 1 } })
						end
						local pp = prompt(box, "짚기", step.name or "상자", "MQOrder")
						table.insert(out.mq, { sid = sid, step = si, idx = i, prompt = pp })
						continue
					end
					local h = sd.h or 3
					local col = sd.color or glow
					cyl("QuestPillar", sd.at + Vector3.new(0, h / 2, 0), 0.9, h, STONE_DARK, Enum.Material.Granite, f)
					local lamp = part({ Name = "QuestLamp", Shape = Enum.PartType.Ball, Size = Vector3.new(1.3, 1.3, 1.3), Position = sd.at + Vector3.new(0, h + 0.7, 0), Color = col, Material = Enum.Material.Glass, CanCollide = false, Parent = f })
					lamp.Transparency = 0.25
					light(lamp, col, 8, 0.6)
					local pp = prompt(lamp, "짚기", step.name or "돌", "MQOrder")
					table.insert(out.mq, { sid = sid, step = si, idx = i, prompt = pp })
				end
			end
		end
	end
end

-- 3.8판 빈칸: 세상의 남동쪽 끝, 지도에 그려지지 않은 곳. 흰 격자의 검은 바닥, 떠 있는 '빠진 무늬' 상자 (자홍·검정 바둑판),
-- 붉은 테의 깨진 검은 판, 'null' 팻말. 이름 없는 자가 가운데 서 있다
local function nullSpot()
	local at = Config.NULL_SPOT
	if not at then
		return
	end
	local f = Instance.new("Folder")
	f.Name = "NullSpot"
	f.Parent = folder
	local BLACK = Color3.fromRGB(14, 14, 18)
	local MAGENTA = Color3.fromRGB(255, 0, 220)
	local RED = Color3.fromRGB(230, 40, 60)
	disc("NullFloor", at + Vector3.new(0, 0.2, 0), 24, 0.4, BLACK, Enum.Material.SmoothPlastic, f)
	for k = -4, 4 do
		local len = 2 * math.sqrt(math.max(0, 24 * 24 - (k * 5) ^ 2)) - 2
		part({ Name = "NullGridX", Size = Vector3.new(len, 0.05, 0.12), Position = at + Vector3.new(0, 0.43, k * 5), Color = Color3.fromRGB(235, 235, 240), Material = Enum.Material.Neon, CanCollide = false, Parent = f }).Transparency = 0.55
		part({ Name = "NullGridZ", Size = Vector3.new(0.12, 0.05, len), Position = at + Vector3.new(k * 5, 0.43, 0), Color = Color3.fromRGB(235, 235, 240), Material = Enum.Material.Neon, CanCollide = false, Parent = f }).Transparency = 0.55
	end
	-- 빠진 무늬 상자 (작은 상자 여덟이 바둑판으로)
	for k = 0, 4 do
		local a = k / 5 * math.pi * 2 + 0.3
		local c = at + Vector3.new(math.cos(a) * 17, 5 + (k % 3) * 3.5, math.sin(a) * 17)
		local rot = CFrame.Angles(k * 0.7, k * 1.1, k * 0.4)
		local s = 1.2 + (k % 2) * 0.4
		for x = 0, 1 do
			for y = 0, 1 do
				for z = 0, 1 do
					part({ Name = "MissingCube", Size = Vector3.new(s, s, s), CFrame = CFrame.new(c) * rot * CFrame.new((x - 0.5) * s, (y - 0.5) * s, (z - 0.5) * s), Color = ((x + y + z) % 2 == 0) and MAGENTA or BLACK, Material = Enum.Material.SmoothPlastic, CanCollide = false, Parent = f })
				end
			end
		end
	end
	-- 깨진 검은 판 (붉은 테)
	for k = 0, 5 do
		local a = k / 6 * math.pi * 2 + 0.8
		local c = at + Vector3.new(math.cos(a) * 26, 3 + (k % 2) * 2, math.sin(a) * 26)
		local cf = CFrame.lookAt(c, at + Vector3.new(0, c.Y - at.Y, 0)) * CFrame.Angles(0, 0, math.rad(-8 + k * 4))
		part({ Name = "BrokenPanel", Size = Vector3.new(4.5 + k % 3, 3 + k % 2, 0.2), CFrame = cf, Color = BLACK, Material = Enum.Material.SmoothPlastic, CanCollide = false, Parent = f })
		part({ Name = "BrokenEdge", Size = Vector3.new(4.6 + k % 3, 0.12, 0.22), CFrame = cf * CFrame.new(0, (3 + k % 2) / 2, 0), Color = RED, Material = Enum.Material.Neon, CanCollide = false, Parent = f })
	end
	local post = part({ Name = "NullPost", Size = Vector3.new(0.5, 4, 0.5), Position = at + Vector3.new(0, 2, 27), Color = BLACK, Material = Enum.Material.SmoothPlastic, Parent = f })
	local board = part({ Name = "NullSign", Size = Vector3.new(5, 2, 0.3), CFrame = CFrame.lookAt(at + Vector3.new(0, 4.4, 27), at + Vector3.new(0, 4.4, 40)), Color = BLACK, Material = Enum.Material.SmoothPlastic, CanCollide = false, Parent = f })
	sign(board, Enum.NormalId.Front, { { "null", Color3.fromRGB(240, 240, 245), 1 } })
	post.Transparency = 0
end

-- 3.9판 권법 시험장: 하늘 높이 떠 있는 큰 돌 마당 (한 변 340칸). 낮은 담, 바닥의 줄, 작은 목인 줄과 큰 목인 줄의 팻말,
-- 들어오는 자리와 돌아가는 문. 사람끼리는 싸우지 않는다 (Config.inSafe)
local function testRoom(out: any)
	local TR = Config.TEST_ROOM
	if not TR then
		return
	end
	local at = TR.at
	local H = TR.half
	local f = Instance.new("Folder")
	f.Name = "TestRoom"
	f.Parent = folder
	local floorC = Color3.fromRGB(96, 92, 100)
	local lineC = Color3.fromRGB(150, 144, 136)
	part({ Name = "TestFloor", Size = Vector3.new(H * 2, 2, H * 2), Position = at - Vector3.new(0, 1, 0), Color = floorC, Material = Enum.Material.Slate, Parent = f })
	for k = -H + 20, H - 20, 20 do
		part({ Name = "TestLineX", Size = Vector3.new(H * 2 - 8, 0.06, 0.3), Position = at + Vector3.new(0, 0.03, k), Color = lineC, Material = Enum.Material.SmoothPlastic, CanCollide = false, Parent = f })
		part({ Name = "TestLineZ", Size = Vector3.new(0.3, 0.06, H * 2 - 8), Position = at + Vector3.new(k, 0.03, 0), Color = lineC, Material = Enum.Material.SmoothPlastic, CanCollide = false, Parent = f })
	end
	-- 둘레 담 (낮은 돌담과 위의 기와 테)
	for _, side in ipairs({ { Vector3.new(0, 0, -H), Vector3.new(H * 2 + 8, 14, 4) }, { Vector3.new(0, 0, H), Vector3.new(H * 2 + 8, 14, 4) }, { Vector3.new(-H, 0, 0), Vector3.new(4, 14, H * 2) }, { Vector3.new(H, 0, 0), Vector3.new(4, 14, H * 2) } }) do
		part({ Name = "TestWall", Size = side[2], Position = at + side[1] + Vector3.new(0, 7, 0), Color = Color3.fromRGB(150, 140, 126), Material = Enum.Material.Cobblestone, Parent = f })
		part({ Name = "TestWallCap", Size = side[2] * Vector3.new(1, 0, 1) + Vector3.new(2, 1.2, 2), Position = at + side[1] + Vector3.new(0, 14.6, 0), Color = ROOF, Material = Enum.Material.Slate, Parent = f })
	end
	for _, sx in ipairs({ -1, 1 }) do
		for _, sz in ipairs({ -1, 1 }) do
			brazier(at + Vector3.new(sx * (H - 10), 0, sz * (H - 10)), 1.6, f)
		end
	end
	-- 줄 팻말
	for _, row in ipairs({ { -40, "작은 목인" }, { -110, "큰 목인" } }) do
		local board = part({ Name = "RowSign", Size = Vector3.new(14, 3, 0.4), CFrame = CFrame.lookAt(at + Vector3.new(-H + 30, 4, row[1]), at + Vector3.new(-H + 30, 4, row[1] + 10)), Color = Color3.fromRGB(60, 46, 36), Material = Enum.Material.Wood, CanCollide = false, Parent = f })
		sign(board, Enum.NormalId.Front, { { row[2], Color3.fromRGB(255, 226, 160), 1 } })
		part({ Name = "RowPost", Size = Vector3.new(0.6, 4, 0.6), Position = at + Vector3.new(-H + 30, 2, row[1]), Color = WOOD, Material = Enum.Material.Wood, Parent = f })
		part({ Name = "RowStrip", Size = Vector3.new(H * 1.6, 0.08, 6), Position = at + Vector3.new(0, 0.05, row[1]), Color = Color3.fromRGB(120, 106, 90), Material = Enum.Material.Cobblestone, CanCollide = false, Parent = f })
	end
	-- 들어오는 자리와 돌아가는 문
	disc("TestSpawnPad", at + Vector3.new(0, 0.1, H - 50), 8, 0.2, GOLD, Enum.Material.Marble, f, false)
	local gate = at + Vector3.new(0, 0, H - 22)
	for _, sx in ipairs({ -1, 1 }) do
		part({ Name = "ExitPost", Size = Vector3.new(1.6, 14, 1.6), Position = gate + Vector3.new(sx * 7, 7, 0), Color = GATE_RED, Material = Enum.Material.Wood, Parent = f })
	end
	part({ Name = "ExitBeam", Size = Vector3.new(18, 1.4, 2), Position = gate + Vector3.new(0, 13.8, 0), Color = GATE_RED, Material = Enum.Material.Wood, Parent = f })
	part({ Name = "ExitRoof", Size = Vector3.new(21, 1, 3), Position = gate + Vector3.new(0, 15, 0), Color = ROOF, Material = Enum.Material.Slate, Parent = f })
	local veil = part({ Name = "ExitVeil", Size = Vector3.new(12.4, 12, 0.4), Position = gate + Vector3.new(0, 6.5, 0), Color = Color3.fromRGB(255, 226, 160), Material = Enum.Material.Neon, CanCollide = false, Parent = f })
	veil.Transparency = 0.75
	local board = part({ Name = "TestSign", Size = Vector3.new(16, 3, 0.4), CFrame = CFrame.lookAt(gate + Vector3.new(0, 17.4, 0), gate + Vector3.new(0, 17.4, -10)), Color = Color3.fromRGB(60, 46, 36), Material = Enum.Material.Wood, CanCollide = false, Parent = f })
	sign(board, Enum.NormalId.Front, { { "권법 시험장", Color3.fromRGB(255, 226, 160), 1 } })
	out.testExit = prompt(veil, "마을로 돌아가기", "권법 시험장", "TestExit")
end

local function wilds()
	local f = Instance.new("Folder")
	f.Name = "Wilds"
	f.Parent = folder
	local R = Random.new(2404)
	local W = Config.WORLD_HALF
	local made = 0
	local flowers = { Color3.fromRGB(255, 220, 90), Color3.fromRGB(240, 120, 160), Color3.fromRGB(180, 140, 255), Color3.fromRGB(255, 255, 255) }
	for _ = 1, 500 do
		if made >= 120 then
			break
		end
		local c = Vector3.new(R:NextNumber(-W + 500, W - 500), 0, R:NextNumber(-W + 500, W - 500))
		if not inAnyRegion(c, 60) and not nearFeature(c, 60) and not nearRoad(c, 30) then
			made += 1
			local kind = made % 5
			if kind == 0 or kind == 1 then
				-- 작은 숲 (나무 셋~다섯, 덤불)
				local n = 3 + made % 3
				for k = 0, n - 1 do
					local a = k / n * math.pi * 2 + made
					local p = c + Vector3.new(math.cos(a), 0, math.sin(a)) * R:NextNumber(6, 16)
					if made % 7 == 0 then
						pine(p, R:NextNumber(1.1, 1.6), f, false)
					else
						tree(p, R:NextNumber(1.1, 1.7), f, made % 9 == 0)
					end
				end
				bush(c + Vector3.new(4, 0, 3), 2.4, Color3.fromRGB(70, 120, 50), f)
			elseif kind == 2 then
				-- 바위 무더기
				for k = 0, 3 do
					rock(c + Vector3.new(R:NextNumber(-8, 8), 0, R:NextNumber(-8, 8)), R:NextNumber(2.5, 6), f)
				end
				bush(c + Vector3.new(-5, 0, 5), 1.8, Color3.fromRGB(80, 115, 55), f)
			elseif kind == 3 then
				-- 꽃밭 (작은 꽃 열둘)
				local col = flowers[made % #flowers + 1]
				for k = 0, 11 do
					local p = c + Vector3.new(R:NextNumber(-9, 9), 0, R:NextNumber(-9, 9))
					part({ Name = "Flower", Shape = Enum.PartType.Ball, Size = Vector3.new(1, 0.5, 1), Position = p + Vector3.new(0, 0.6, 0), Color = col, Material = Enum.Material.SmoothPlastic, CanCollide = false, Parent = f })
					part({ Name = "FlowerStem", Size = Vector3.new(0.15, 0.6, 0.15), Position = p + Vector3.new(0, 0.3, 0), Color = Color3.fromRGB(70, 130, 50), Material = Enum.Material.Grass, CanCollide = false, Parent = f })
				end
			else
				-- 덤불과 쓰러진 통나무
				for k = 0, 2 do
					bush(c + Vector3.new(R:NextNumber(-7, 7), 0, R:NextNumber(-7, 7)), R:NextNumber(1.6, 2.8), Color3.fromRGB(75, 125, 55), f)
				end
				part({ Name = "Log", Shape = Enum.PartType.Cylinder, Size = Vector3.new(9, 1.6, 1.6), CFrame = CFrame.new(c + Vector3.new(0, 0.8, 0)) * CFrame.Angles(0, R:NextNumber(0, 3), 0), Color = Color3.fromRGB(95, 70, 45), Material = Enum.Material.Wood, Parent = f })
			end
		end
	end
end

local function sakuraHill()
	local at = Config.SAKURA_HILL
	if not at then
		return
	end
	local f = Instance.new("Folder")
	f.Name = "SakuraHill"
	f.Parent = folder
	local pink = Color3.fromRGB(255, 175, 210)
	-- 세 겹의 둥근 돌 단 (위로 갈수록 좁다)
	for i, r in ipairs({ 22, 17, 12 }) do
		disc("SakuraTerrace", at + Vector3.new(0, (i - 0.5) * 1.55, 0), r, 1.55, Color3.fromRGB(190, 180, 175):Lerp(Color3.fromRGB(230, 215, 215), i * 0.2), Enum.Material.Granite, f)
	end
	-- 오르는 돌계단 (남쪽)
	for k = 0, 5 do
		part({ Name = "SakuraStep", Size = Vector3.new(8, 0.8, 2.2), Position = at + Vector3.new(0, 0.4 + k * 0.78, 23 - k * 2.2), Color = Color3.fromRGB(200, 190, 185), Material = Enum.Material.Granite, Parent = f })
	end
	-- 거대한 벚나무: 굵은 줄기, 갈라진 가지, 분홍 꽃구름
	local base = at + Vector3.new(-6, 4.6, -6)
	part({ Name = "SakuraTrunk", Size = Vector3.new(3.4, 16, 3.4), CFrame = CFrame.new(base + Vector3.new(0, 8, 0)) * CFrame.Angles(0, 0, math.rad(6)), Color = Color3.fromRGB(80, 50, 45), Material = Enum.Material.Wood, Parent = f })
	for k = 0, 4 do
		local a = k / 5 * math.pi * 2
		local from = base + Vector3.new(0, 13, 0)
		local to = from + Vector3.new(math.cos(a) * 9, 5 + (k % 2) * 2, math.sin(a) * 9)
		part({ Name = "SakuraBranch", Size = Vector3.new(1.4, 1.4, (to - from).Magnitude), CFrame = CFrame.lookAt((from + to) / 2, to), Color = Color3.fromRGB(85, 55, 48), Material = Enum.Material.Wood, CanCollide = false, Parent = f })
		for j = 0, 2 do
			part({ Name = "SakuraBloom", Shape = Enum.PartType.Ball, Size = Vector3.one * (9 - j * 1.5), Position = to + Vector3.new(math.cos(a + j) * 2.5, j * 1.5 - 1, math.sin(a + j) * 2.5),
				Color = pink:Lerp(Color3.new(1, 1, 1), (j % 2) * 0.25 + (k % 2) * 0.1), Material = Enum.Material.Grass, CanCollide = false, Parent = f })
		end
	end
	local crown = part({ Name = "SakuraCrown", Shape = Enum.PartType.Ball, Size = Vector3.one * 14, Position = base + Vector3.new(0, 21, 0), Color = pink, Material = Enum.Material.Grass, CanCollide = false, Parent = f })
	-- 꽃잎이 언덕 가득 흩날린다
	local pe = Instance.new("ParticleEmitter")
	pe.Texture = "rbxasset://textures/particles/sparkles_main.dds"
	pe.Color = ColorSequence.new(Color3.fromRGB(255, 200, 225), Color3.fromRGB(255, 150, 195))
	pe.Size = NumberSequence.new(0.5, 0.3)
	pe.Squash = NumberSequence.new(0.5)
	pe.Lifetime = NumberRange.new(5, 8)
	pe.Rate = 40
	pe.Speed = NumberRange.new(1, 3)
	pe.SpreadAngle = Vector2.new(180, 180)
	pe.Acceleration = Vector3.new(1.2, -1.5, 0.6)
	pe.Rotation = NumberRange.new(0, 360)
	pe.RotSpeed = NumberRange.new(-120, 120)
	pe.LightEmission = 0.3
	pe.Parent = crown
	light(crown, pink, 40, 1.2)
	-- 땅에 깔린 꽃잎 (분홍 얼룩)
	for k = 0, 13 do
		local a = k / 14 * math.pi * 2
		disc("FallenPetals", at + Vector3.new(math.cos(a) * (26 + (k % 3) * 4), 0.05, math.sin(a) * (26 + (k % 3) * 4)), 3 + (k % 3), 0.1, pink:Lerp(Color3.new(1, 1, 1), 0.3), Enum.Material.SmoothPlastic, f, false)
	end
	for _, sx in ipairs({ -1, 1 }) do
		stoneLantern(at + Vector3.new(sx * 6, 0, 26), f, true)
	end
end

-- 술독 마루: 초·취팔선권의 만취선이 코를 고는 나무 마루. 둘레에 술독이 산처럼 쌓이고, 하나는 엎어져 웅덩이가 졌다
local function sojuHill()
	local at = Config.SOJU_HILL
	if not at then
		return
	end
	local f = Instance.new("Folder")
	f.Name = "SojuHill"
	f.Parent = folder
	local plank = Color3.fromRGB(120, 85, 55)
	local clay = Color3.fromRGB(125, 75, 45)
	local green = Color3.fromRGB(70, 170, 95)
	-- 두 겹의 둥근 나무 마루
	disc("SojuDeck", at + Vector3.new(0, 0.8, 0), 16, 1.6, plank, Enum.Material.WoodPlanks, f)
	disc("SojuDeck", at + Vector3.new(0, 2.4, 0), 11, 1.6, plank:Lerp(Color3.new(1, 1, 1), 0.08), Enum.Material.WoodPlanks, f)
	for k = 0, 2 do
		part({ Name = "SojuStep", Size = Vector3.new(7, 0.8, 2.2), Position = at + Vector3.new(0, 0.4 + k * 1.05, 18 - k * 2.4), Color = plank, Material = Enum.Material.Wood, Parent = f })
	end
	-- 술독: 배가 불룩한 항아리 (몸통 + 어깨 + 검은 뚜껑)
	local function jar(p: Vector3, size: number, tipped: boolean?)
		local cf = CFrame.new(p + Vector3.new(0, size * 0.7, 0))
		if tipped then
			cf = CFrame.new(p + Vector3.new(0, size * 0.75, 0)) * CFrame.Angles(0, math.random() * 6, math.rad(90))
		end
		part({ Name = "SojuJar", Shape = Enum.PartType.Ball, Size = Vector3.new(size * 1.5, size * 1.5, size * 1.5), CFrame = cf, Color = clay, Material = Enum.Material.Slate, Parent = f })
		part({ Name = "SojuJarNeck", Shape = Enum.PartType.Cylinder, Size = Vector3.new(size * 0.5, size * 0.9, size * 0.9), CFrame = cf * CFrame.new(0, size * 0.75, 0) * CFrame.Angles(0, 0, math.rad(90)), Color = clay:Lerp(Color3.new(0, 0, 0), 0.15), Material = Enum.Material.Slate, Parent = f })
		if not tipped then
			part({ Name = "SojuJarLid", Shape = Enum.PartType.Cylinder, Size = Vector3.new(size * 0.15, size * 1.0, size * 1.0), CFrame = cf * CFrame.new(0, size * 1.02, 0) * CFrame.Angles(0, 0, math.rad(90)), Color = Color3.fromRGB(40, 30, 25), Material = Enum.Material.Wood, Parent = f })
		end
	end
	for k = 0, 9 do
		local a = k / 10 * math.pi * 2 + 0.3
		if math.abs(a - math.pi / 2) > 0.45 then -- 계단 쪽(남)은 비운다
			local r = 20 + (k % 3) * 2
			local p = at + Vector3.new(math.cos(a) * r, 0, math.sin(a) * r)
			jar(p, 2.2 + (k % 3) * 0.5)
			if k % 2 == 0 then
				jar(p + Vector3.new(0, 3.2 + (k % 3) * 0.7, 0), 1.6)
			end
		end
	end
	-- 엎어진 큰 술독과 웅덩이
	local tip = at + Vector3.new(-12, 3.2, -4)
	jar(tip, 2.4, true)
	disc("SojuPuddle", at + Vector3.new(-12, 3.25, 1), 3.4, 0.05, Color3.fromRGB(190, 225, 200), Enum.Material.Glass, f, false).Transparency = 0.35
	-- 낮은 술상과 초록 병 몇 개 (상표 없는 빈 병)
	part({ Name = "SojuTable", Size = Vector3.new(5, 0.5, 3), Position = at + Vector3.new(5, 4.2, -3), Color = Color3.fromRGB(90, 55, 35), Material = Enum.Material.Wood, Parent = f })
	for _, o in ipairs({ { 3.6, 0 }, { 4.6, 0.6 }, { 6.2, -0.4 } }) do
		part({ Name = "SojuBottle", Shape = Enum.PartType.Cylinder, Size = Vector3.new(1.4, 0.55, 0.55), CFrame = CFrame.new(at + Vector3.new(o[1], 5.15, -3 + o[2])) * CFrame.Angles(0, 0, math.rad(90)), Color = green, Material = Enum.Material.Glass, Transparency = 0.2, CanCollide = false, Parent = f })
	end
	part({ Name = "SojuBottle", Shape = Enum.PartType.Cylinder, Size = Vector3.new(1.4, 0.55, 0.55), CFrame = CFrame.new(at + Vector3.new(3, 3.5, 4)) * CFrame.Angles(math.rad(90), 0.4, 0), Color = green, Material = Enum.Material.Glass, Transparency = 0.2, CanCollide = false, Parent = f })
	-- 붉은 종이 등 (마루 네 귀퉁이, 장대에 매달아)
	for k = 0, 3 do
		local a = k / 4 * math.pi * 2 + math.pi / 4
		local p = at + Vector3.new(math.cos(a) * 14, 0, math.sin(a) * 14)
		part({ Name = "SojuPole", Size = Vector3.new(0.6, 10, 0.6), Position = p + Vector3.new(0, 6.6, 0), Color = Color3.fromRGB(60, 40, 28), Material = Enum.Material.Wood, Parent = f })
		local lamp = part({ Name = "SojuLamp", Shape = Enum.PartType.Ball, Size = Vector3.new(2.2, 2.6, 2.2), Position = p + Vector3.new(0, 10.6, 0), Color = Color3.fromRGB(235, 70, 50), Material = Enum.Material.Neon, CanCollide = false, Parent = f })
		light(lamp, Color3.fromRGB(255, 140, 90), 22, 1.2)
	end
	local board = part({ Name = "SojuSign", Size = Vector3.new(10, 2.6, 0.4), CFrame = CFrame.lookAt(at + Vector3.new(0, 4.5, 21.5), at + Vector3.new(0, 4.5, 40)), Color = Color3.fromRGB(35, 25, 18), Material = Enum.Material.Wood, CanCollide = false, Parent = f })
	sign(board, Enum.NormalId.Front, { { "술독 마루", Color3.fromRGB(190, 255, 200), 1 } })
	part({ Name = "SojuSignPost", Size = Vector3.new(0.6, 4, 0.6), Position = at + Vector3.new(0, 2, 21.5), Color = Color3.fromRGB(60, 40, 28), Material = Enum.Material.Wood, Parent = f })
end

-- 1.9판: 초·혈마신수의 사부 혈월선이 있는 혈월 제단 (혈교 본산 성벽 밖 북동쪽 끝, 지도에 나오지 않는다)
-- 핏빛 돌단 위, 땅에 거꾸로 꽂힌 거대한 붉은 낫과 핏빛 달 모양의 둥근 문
local function reaperAltar()
	local at = Config.REAPER_ALTAR
	if not at then
		return
	end
	local f = Instance.new("Folder")
	f.Name = "ReaperAltar"
	f.Parent = folder
	local stone = Color3.fromRGB(45, 22, 24)
	local blood = Color3.fromRGB(200, 20, 35)
	disc("ReaperBase", at + Vector3.new(0, 0.8, 0), 22, 1.6, stone, Enum.Material.Slate, f)
	disc("ReaperBase", at + Vector3.new(0, 2.4, 0), 15, 1.6, stone:Lerp(Color3.new(0, 0, 0), 0.2), Enum.Material.Basalt, f)
	disc("ReaperRune", at + Vector3.new(0, 3.25, 0), 12, 0.1, blood, Enum.Material.Neon, f, false).Transparency = 0.35
	for k = 0, 2 do
		part({ Name = "ReaperStep", Size = Vector3.new(8, 0.8, 2.4), Position = at + Vector3.new(0, 0.4 + k * 1.05, 24 - k * 2.6), Color = stone, Material = Enum.Material.Slate, Parent = f })
	end
	-- 돌단을 두른 핏빛 돌기둥 여덟과 그 위의 불
	for k = 0, 7 do
		local a = k / 8 * math.pi * 2 + math.pi / 8
		if math.abs(a - math.pi / 2) > 0.3 then
			local p = at + Vector3.new(math.cos(a) * 19, 0, math.sin(a) * 19)
			local h = 9 + (k % 3) * 2
			part({ Name = "ReaperPillar", Size = Vector3.new(2.4, h, 2.4), CFrame = CFrame.new(p + Vector3.new(0, h / 2 + 1.6, 0)) * CFrame.Angles(0, a, math.rad((k % 2 == 0 and 1 or -1) * 4)), Color = stone, Material = Enum.Material.Basalt, Parent = f })
			local flame = part({ Name = "ReaperFlame", Shape = Enum.PartType.Ball, Size = Vector3.new(1.6, 1.6, 1.6), Position = p + Vector3.new(0, h + 2.6, 0), Color = blood, Material = Enum.Material.Neon, CanCollide = false, Parent = f })
			light(flame, Color3.fromRGB(255, 60, 60), 18, 1.2)
		end
	end
	-- 거꾸로 꽂힌 거대한 붉은 낫 (자루는 하늘로, 날은 돌단에 박혔다)
	local shaftCF = CFrame.new(at + Vector3.new(-6, 14, -6)) * CFrame.Angles(math.rad(8), math.rad(35), math.rad(-6))
	part({ Name = "ReaperShaft", Size = Vector3.new(1.1, 26, 1.1), CFrame = shaftCF, Color = Color3.fromRGB(30, 12, 14), Material = Enum.Material.Wood, Parent = f })
	for k = -2, 2 do
		part({ Name = "ReaperWrap", Size = Vector3.new(1.3, 0.5, 1.3), CFrame = shaftCF * CFrame.new(0, k * 4.5, 0), Color = Color3.fromRGB(120, 15, 25), Material = Enum.Material.Fabric, CanCollide = false, Parent = f })
	end
	local head = shaftCF * CFrame.new(0, -12.5, 0)
	for k = 0, 6 do
		local seg = part({ Name = "ReaperBlade", Size = Vector3.new(0.5, 2.2 - k * 0.22, 3.4), CFrame = head * CFrame.Angles(0, 0, math.rad(-12 * k)) * CFrame.new(0, -0.6, -2.6 - k * 2.8), Color = blood, Material = Enum.Material.Neon, CanCollide = false, Parent = f })
		seg.Transparency = 0.05
	end
	-- 핏빛 달 모양의 둥근 문 (돌단 뒤)
	local gateC = at + Vector3.new(0, 15, -14)
	local n = 22
	for k = 0, n - 1 do
		local a = k / n * math.pi * 2
		part({ Name = "ReaperMoon", Size = Vector3.new(2.6, 1.6, 2.2), CFrame = CFrame.new(gateC) * CFrame.Angles(0, 0, a) * CFrame.new(0, 10, 0), Color = k % 2 == 0 and Color3.fromRGB(150, 15, 25) or stone, Material = k % 2 == 0 and Enum.Material.Neon or Enum.Material.Slate, CanCollide = false, Parent = f })
	end
	local moon = part({ Name = "ReaperMoonCore", Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.2, 18, 18), CFrame = CFrame.new(gateC) * CFrame.Angles(0, math.rad(90), 0), Color = Color3.fromRGB(170, 20, 30), Material = Enum.Material.Neon, CanCollide = false, Parent = f })
	moon.Transparency = 0.55
	light(moon, Color3.fromRGB(255, 50, 50), 40, 1.5)
	local board = part({ Name = "ReaperSign", Size = Vector3.new(10, 2.6, 0.4), CFrame = CFrame.lookAt(at + Vector3.new(0, 4.5, 27), at + Vector3.new(0, 4.5, 50)), Color = Color3.fromRGB(30, 12, 14), Material = Enum.Material.Wood, CanCollide = false, Parent = f })
	sign(board, Enum.NormalId.Front, { { "혈월 제단", Color3.fromRGB(255, 120, 120), 1 } })
	part({ Name = "ReaperSignPost", Size = Vector3.new(0.6, 4, 0.6), Position = at + Vector3.new(0, 2, 27), Color = Color3.fromRGB(40, 20, 20), Material = Enum.Material.Wood, Parent = f })
end

-- 2.0판: 초·벽력신권의 사부 뇌천선이 있는 쇠기둥 봉우리 (뇌운 고원 동쪽 벼랑 끝, 지도에 나오지 않는다)
-- 바위 봉우리 위 둥근 쇠 단, 둘레에 피뢰침 쇠기둥, 가운데 높은 쇠탑 꼭대기에서 보랏빛 번개가 늘 튄다
local function thunderPeak()
	local at = Config.THUNDER_PEAK
	if not at then
		return
	end
	local f = Instance.new("Folder")
	f.Name = "ThunderPeak"
	f.Parent = folder
	local rock = Color3.fromRGB(80, 78, 92)
	local iron = Color3.fromRGB(55, 58, 70)
	local bolt = Color3.fromRGB(170, 140, 255)
	-- 층진 바위 봉우리
	for k = 0, 2 do
		disc("PeakRock", at + Vector3.new(0, 1 + k * 2, 0), 22 - k * 5, 2.2, rock:Lerp(Color3.new(0, 0, 0), k * 0.08), Enum.Material.Slate, f)
	end
	disc("PeakPlate", at + Vector3.new(0, 6.2, 0), 9, 0.4, iron, Enum.Material.DiamondPlate, f)
	disc("PeakRune", at + Vector3.new(0, 6.45, 0), 7, 0.1, bolt, Enum.Material.Neon, f, false).Transparency = 0.4
	-- 오르는 돌계단 (남쪽)
	for k = 0, 5 do
		part({ Name = "PeakStep", Size = Vector3.new(6, 1, 2.4), Position = at + Vector3.new(0, 0.5 + k * 1.05, 23 - k * 2.4), Color = rock, Material = Enum.Material.Slate, Parent = f })
	end
	-- 피뢰침 쇠기둥 여섯 (꼭대기에 빛)
	for k = 0, 5 do
		local a = k / 6 * math.pi * 2 + 0.3
		if math.abs(a - math.pi / 2) > 0.35 then
			local p = at + Vector3.new(math.cos(a) * 15, 0, math.sin(a) * 15)
			local h = 14 + (k % 2) * 4
			part({ Name = "PeakRod", Size = Vector3.new(0.9, h, 0.9), Position = p + Vector3.new(0, 4 + h / 2, 0), Color = iron, Material = Enum.Material.Metal, Parent = f })
			local tip = part({ Name = "PeakSpark", Shape = Enum.PartType.Ball, Size = Vector3.new(1.2, 1.2, 1.2), Position = p + Vector3.new(0, 4.6 + h, 0), Color = bolt, Material = Enum.Material.Neon, CanCollide = false, Parent = f })
			light(tip, bolt, 16, 1.4)
		end
	end
	-- 가운데 쇠탑 (뒤쪽)
	local tower = at + Vector3.new(0, 0, -6)
	for k = 0, 3 do
		part({ Name = "PeakTower", Size = Vector3.new(2.6 - k * 0.5, 7, 2.6 - k * 0.5), Position = tower + Vector3.new(0, 9.5 + k * 7, 0), Color = iron, Material = Enum.Material.Metal, Parent = f })
	end
	local orb = part({ Name = "PeakOrb", Shape = Enum.PartType.Ball, Size = Vector3.new(3.4, 3.4, 3.4), Position = tower + Vector3.new(0, 38, 0), Color = bolt, Material = Enum.Material.Neon, CanCollide = false, Parent = f })
	orb.Transparency = 0.1
	light(orb, bolt, 40, 2)
	local board = part({ Name = "PeakSign", Size = Vector3.new(10, 2.6, 0.4), CFrame = CFrame.lookAt(at + Vector3.new(0, 4.5, 26), at + Vector3.new(0, 4.5, 50)), Color = Color3.fromRGB(30, 28, 40), Material = Enum.Material.Wood, CanCollide = false, Parent = f })
	sign(board, Enum.NormalId.Front, { { "쇠기둥 봉우리", Color3.fromRGB(210, 190, 255), 1 } })
	part({ Name = "PeakSignPost", Size = Vector3.new(0.6, 4, 0.6), Position = at + Vector3.new(0, 2, 26), Color = iron, Material = Enum.Material.Metal, Parent = f })
end

-- 3.4판: 초·성하신권의 사부 천성선이 선 관성대 (천상계 성운원 남쪽 끝, 지도에 나오지 않는다)
-- 두 단의 둥근 돌 관측대, 남쪽 계단, 가장자리의 별 등 여덟, 금빛 고리 셋이 엇갈린 혼천의, 떠 있는 별 수정
local function starTerrace()
	local at = Config.STAR_TERRACE
	if not at then
		return
	end
	local f = Instance.new("Folder")
	f.Name = "StarTerrace"
	f.Parent = folder
	local stone = Color3.fromRGB(70, 66, 110)
	local stone2 = Color3.fromRGB(96, 90, 140)
	local brass = Color3.fromRGB(214, 176, 92)
	local star = Color3.fromRGB(255, 226, 120)
	local violet = Color3.fromRGB(170, 130, 255)
	disc("TerraceBase", at + Vector3.new(0, 0.7, 0), 16, 1.4, stone, Enum.Material.Slate, f)
	disc("TerraceTop", at + Vector3.new(0, 2.1, 0), 12, 1.4, stone2, Enum.Material.Marble, f)
	disc("TerraceInlay", at + Vector3.new(0, 2.82, 0), 9, 0.06, Color3.fromRGB(60, 50, 170), Enum.Material.Neon, f, false).Transparency = 0.4
	disc("TerraceInlayCore", at + Vector3.new(0, 2.84, 0), 3, 0.06, star, Enum.Material.Neon, f, false).Transparency = 0.2
	-- 남쪽 계단
	for k = 1, 3 do
		part({ Name = "TerraceStep", Size = Vector3.new(6, k * 0.95, 2.2), Position = at + Vector3.new(0, k * 0.475, 18.5 - k * 2.2), Color = stone, Material = Enum.Material.Slate, Parent = f })
	end
	-- 가장자리의 별 등 여덟
	for k = 0, 7 do
		local a = k / 8 * math.pi * 2 + math.pi / 8
		local p = at + Vector3.new(math.cos(a) * 14.5, 1.4, math.sin(a) * 14.5)
		part({ Name = "StarLampPost", Size = Vector3.new(0.6, 5, 0.6), Position = p + Vector3.new(0, 2.5, 0), Color = brass, Material = Enum.Material.Metal, Parent = f })
		local orb = part({ Name = "StarLamp", Shape = Enum.PartType.Ball, Size = Vector3.new(1.4, 1.4, 1.4), Position = p + Vector3.new(0, 5.6, 0), Color = k % 2 == 0 and star or violet, Material = Enum.Material.Neon, CanCollide = false, Parent = f })
		light(orb, orb.Color, 14, 1.2)
	end
	-- 혼천의: 받침 위에 엇갈린 금빛 고리 셋, 가운데 별 구슬
	local arm = at + Vector3.new(-6, 2.8, -5)
	part({ Name = "ArmillaryStand", Size = Vector3.new(1.2, 5, 1.2), Position = arm + Vector3.new(0, 2.5, 0), Color = brass, Material = Enum.Material.Metal, Parent = f })
	local center = arm + Vector3.new(0, 9, 0)
	for ri, tilt in ipairs({ CFrame.Angles(0, 0, 0), CFrame.Angles(math.rad(90), 0, 0), CFrame.Angles(math.rad(60), math.rad(45), math.rad(30)) }) do
		local R = 4 - ri * 0.4
		for k = 0, 23 do
			local a0, a1 = k / 24 * math.pi * 2, (k + 1) / 24 * math.pi * 2
			local p0 = Vector3.new(math.cos(a0) * R, 0, math.sin(a0) * R)
			local p1 = Vector3.new(math.cos(a1) * R, 0, math.sin(a1) * R)
			part({ Name = "ArmillaryRing", Size = Vector3.new(0.25, 0.25, (p1 - p0).Magnitude * 1.08), CFrame = CFrame.new(center) * tilt * CFrame.lookAt((p0 + p1) / 2, p1), Color = brass, Material = Enum.Material.Metal, CanCollide = false, Parent = f })
		end
	end
	local core = part({ Name = "ArmillaryStar", Shape = Enum.PartType.Ball, Size = Vector3.new(1.6, 1.6, 1.6), Position = center, Color = star, Material = Enum.Material.Neon, CanCollide = false, Parent = f })
	light(core, star, 24, 2)
	-- 떠 있는 별 수정
	for k = 0, 5 do
		local a = k / 6 * math.pi * 2
		crystal(at + Vector3.new(math.cos(a) * 22, 9 + (k % 2) * 4, math.sin(a) * 22), 1.6, k % 2 == 0 and star or violet, f)
	end
	local board = part({ Name = "TerraceSign", Size = Vector3.new(8, 2.2, 0.4), CFrame = CFrame.lookAt(at + Vector3.new(4.5, 4, 22), at + Vector3.new(4.5, 4, 40)), Color = Color3.fromRGB(30, 28, 50), Material = Enum.Material.Wood, CanCollide = false, Parent = f })
	sign(board, Enum.NormalId.Front, { { "관성대", star, 1 } })
	part({ Name = "TerraceSignPost", Size = Vector3.new(0.5, 3.4, 0.5), Position = at + Vector3.new(4.5, 1.7, 22), Color = brass, Material = Enum.Material.Metal, Parent = f })
end

-- 2.7판: 초·창해신권의 사부 고경선이 앉은 고래 뼈 바위 (서해 바닷가, 지도에 나오지 않는다)
-- 모래에 반쯤 묻힌 거대한 옛 고래의 머리뼈 (위가 평평해 사부가 앉는다), 앞으로 뻗은 두 턱뼈, 뒤로 이어진 등뼈와 갈비뼈 일곱 쌍,
-- 뼈 둘레의 물웅덩이와 따개비 바위, 머리뼈 위의 빛나는 진주
local function whaleRock()
	local at = Config.WHALE_ROCK
	if not at then
		return
	end
	local f = Instance.new("Folder")
	f.Name = "WhaleRock"
	f.Parent = folder
	local bone = Color3.fromRGB(222, 214, 196)
	local bone2 = Color3.fromRGB(196, 188, 170)
	local sand = Color3.fromRGB(214, 200, 160)
	local sea = Color3.fromRGB(60, 140, 200)
	-- 모래 둔덕
	for k = 0, 2 do
		disc("WhaleSand", at + Vector3.new(0, 0.3 + k * 0.5, 4), 34 - k * 8, 0.8, sand:Lerp(Color3.new(0, 0, 0), k * 0.04), Enum.Material.Sand, f)
	end
	-- 물웅덩이 둘 (뼈 둘레)
	disc("WhalePool", at + Vector3.new(14, 0.55, -10), 7, 0.2, sea, Enum.Material.Glass, f, false).Transparency = 0.3
	disc("WhalePool", at + Vector3.new(-12, 0.55, 14), 5, 0.2, sea, Enum.Material.Glass, f, false).Transparency = 0.3
	-- 머리뼈: 둥근 덩이 위에 평평한 판 (사부가 앉는 자리)
	part({ Name = "WhaleSkull", Shape = Enum.PartType.Ball, Size = Vector3.new(12, 8, 16), Position = at + Vector3.new(0, 3.4, -6), Color = bone, Material = Enum.Material.Limestone, Parent = f })
	part({ Name = "WhaleSkullTop", Size = Vector3.new(8, 1, 9), Position = at + Vector3.new(0, 6.9, -6), Color = bone, Material = Enum.Material.Limestone, Parent = f })
	for _, x in ipairs({ -1, 1 }) do
		-- 눈구멍과 턱뼈 (앞으로 휘어 뻗는다)
		part({ Name = "WhaleEyeHole", Shape = Enum.PartType.Ball, Size = Vector3.new(2.2, 2.2, 2.2), Position = at + Vector3.new(x * 5.4, 4.2, -9), Color = Color3.fromRGB(70, 66, 60), Material = Enum.Material.Slate, CanCollide = false, Parent = f })
		local cf = CFrame.new(at + Vector3.new(x * 4.4, 1.6, -11)) * CFrame.Angles(0, x * math.rad(-8), 0)
		for j = 0, 3 do
			part({ Name = "WhaleJaw", Size = Vector3.new(1.4 - j * 0.15, 1.2 - j * 0.12, 4.4), CFrame = cf * CFrame.new(0, 0, -2.2), Color = j % 2 == 0 and bone or bone2, Material = Enum.Material.Limestone, Parent = f })
			cf = cf * CFrame.new(0, 0, -4.2) * CFrame.Angles(math.rad(4), x * math.rad(7), 0)
		end
	end
	-- 등뼈와 갈비뼈 일곱 쌍 (모래에서 솟아 둥글게 휘어 오른다)
	for i = 0, 6 do
		local z = 4 + i * 4.2
		local h = 9 - i * 0.8
		part({ Name = "WhaleSpine", Size = Vector3.new(2.2 - i * 0.15, 1.8 - i * 0.12, 3.4), Position = at + Vector3.new(0, h, z), Color = bone2, Material = Enum.Material.Limestone, CanCollide = false, Parent = f })
		part({ Name = "WhaleSpineFin", Size = Vector3.new(0.6, 1.6 - i * 0.12, 1.2), Position = at + Vector3.new(0, h + 1.5, z), Color = bone, Material = Enum.Material.Limestone, CanCollide = false, Parent = f })
		for _, x in ipairs({ -1, 1 }) do
			local w = 9 - i * 0.7
			local n = 6
			for k = 0, n - 1 do
				local a0 = (k / n) * math.pi * 0.5
				local a1 = ((k + 1) / n) * math.pi * 0.5
				local p0 = at + Vector3.new(x * w * math.cos(a0), (h - 0.6) * math.sin(a0) + 0.6, z)
				local p1 = at + Vector3.new(x * w * math.cos(a1), (h - 0.6) * math.sin(a1) + 0.6, z)
				local len = (p1 - p0).Magnitude + 0.5
				part({ Name = "WhaleRib", Size = Vector3.new(0.9 - k * 0.06, 0.9 - k * 0.06, len), CFrame = CFrame.lookAt((p0 + p1) / 2, p1), Color = k % 2 == 0 and bone or bone2, Material = Enum.Material.Limestone, CanCollide = false, Parent = f })
			end
		end
	end
	-- 따개비 바위
	for k = 0, 5 do
		local a = k / 6 * math.pi * 2 + 0.4
		local p = at + Vector3.new(math.cos(a) * 22, 0.8, math.sin(a) * 22 + 4)
		part({ Name = "BarnacleRock", Shape = Enum.PartType.Ball, Size = Vector3.new(3 + k % 3, 2.2, 3 + (k + 1) % 3), Position = p, Color = Color3.fromRGB(96, 98, 100), Material = Enum.Material.Slate, Parent = f })
		for b = 0, 3 do
			part({ Name = "Barnacle", Shape = Enum.PartType.Ball, Size = Vector3.new(0.6, 0.5, 0.6), Position = p + Vector3.new(math.cos(b * 1.7) * 1.1, 1.0, math.sin(b * 1.7) * 1.1), Color = Color3.fromRGB(225, 222, 210), Material = Enum.Material.Slate, CanCollide = false, Parent = f })
		end
	end
	-- 머리뼈 위의 진주 (옅게 빛난다)
	local pearl = part({ Name = "WhalePearl", Shape = Enum.PartType.Ball, Size = Vector3.new(1.6, 1.6, 1.6), Position = at + Vector3.new(0, 8.2, -1.8), Color = Color3.fromRGB(230, 245, 255), Material = Enum.Material.Glass, CanCollide = false, Parent = f })
	light(pearl, Color3.fromRGB(140, 220, 255), 26, 1.6)
	local board = part({ Name = "WhaleSign", Size = Vector3.new(10, 2.6, 0.4), CFrame = CFrame.lookAt(at + Vector3.new(0, 3, -34), at + Vector3.new(0, 3, -60)), Color = Color3.fromRGB(110, 90, 70), Material = Enum.Material.Wood, CanCollide = false, Parent = f })
	sign(board, Enum.NormalId.Front, { { "고래 뼈 바위", Color3.fromRGB(200, 240, 255), 1 } })
	part({ Name = "WhaleSignPost", Size = Vector3.new(0.6, 3, 0.6), Position = at + Vector3.new(0, 1.5, -34), Color = Color3.fromRGB(90, 70, 50), Material = Enum.Material.Wood, Parent = f })
end

-- 2.0판: 각성 사부 각성선인의 자리 (상급 수련장 안). 연꽃 단 위에 앉은 금빛 노인, 둘레에 진 권법들의 깃발
local function awakenAltar(out: any)
	local A = Config.AWAKEN_MASTER
	if not A then
		return
	end
	local at = A.at
	local f = Instance.new("Folder")
	f.Name = "AwakenAltar"
	f.Parent = folder
	local stone = Color3.fromRGB(170, 160, 140)
	local gold = Color3.fromRGB(255, 200, 90)
	disc("AwakenBase", at + Vector3.new(0, 0.6, 0), 14, 1.2, stone, Enum.Material.Marble, f)
	disc("AwakenRing", at + Vector3.new(0, 1.25, 0), 11, 0.1, Color3.fromRGB(255, 120, 140), Enum.Material.Neon, f, false).Transparency = 0.45
	-- 연꽃 단 (꽃잎 열둘)
	for k = 0, 11 do
		local a = k / 12 * math.pi * 2
		part({ Name = "AwakenPetal", Size = Vector3.new(2.2, 0.6, 3.6), CFrame = CFrame.new(at + Vector3.new(math.cos(a) * 3.4, 1.6, math.sin(a) * 3.4)) * CFrame.Angles(0, -a + math.pi / 2, math.rad(-20)), Color = Color3.fromRGB(255, 170, 190), Material = Enum.Material.SmoothPlastic, CanCollide = false, Parent = f })
	end
	-- 앉은 금빛 노인 (조각): 몸 · 머리 · 무릎 · 합장한 두 손
	local body = part({ Name = "AwakenSage", Size = Vector3.new(3, 3.4, 2), Position = at + Vector3.new(0, 3.8, 0), Color = gold, Material = Enum.Material.Foil, Parent = f })
	part({ Name = "AwakenSage", Shape = Enum.PartType.Ball, Size = Vector3.new(1.9, 1.9, 1.9), Position = at + Vector3.new(0, 6.4, 0), Color = gold, Material = Enum.Material.Foil, Parent = f })
	part({ Name = "AwakenSage", Size = Vector3.new(4.4, 1.2, 3), Position = at + Vector3.new(0, 2.3, -0.6), Color = gold, Material = Enum.Material.Foil, Parent = f })
	part({ Name = "AwakenSage", Size = Vector3.new(0.8, 1.6, 0.6), Position = at + Vector3.new(0, 4.4, -1.3), Color = gold, Material = Enum.Material.Foil, Parent = f })
	local halo = part({ Name = "AwakenHalo", Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.2, 5, 5), CFrame = CFrame.new(at + Vector3.new(0, 6.6, 1.2)) * CFrame.Angles(0, math.rad(90), 0), Color = Color3.fromRGB(255, 235, 170), Material = Enum.Material.Neon, CanCollide = false, Parent = f })
	halo.Transparency = 0.35
	light(halo, Color3.fromRGB(255, 220, 150), 24, 1.2)
	-- 진 권법들의 깃발 (각성 권법 빛깔로)
	local n = 0
	for _, st in ipairs(Config.Styles) do
		if st.awakenOf then
			n += 1
		end
	end
	local k = 0
	for _, st in ipairs(Config.Styles) do
		if st.awakenOf then
			local a = k / math.max(1, n) * math.pi * 2
			banner(at + Vector3.new(math.cos(a) * 12, 0, math.sin(a) * 12), 9, st.color, f)
			k += 1
		end
	end
	local board = part({ Name = "AwakenSign", Size = Vector3.new(10, 2.6, 0.4), CFrame = CFrame.lookAt(at + Vector3.new(0, 4.5, 16), at + Vector3.new(0, 4.5, 40)), Color = Color3.fromRGB(40, 28, 20), Material = Enum.Material.Wood, CanCollide = false, Parent = f })
	sign(board, Enum.NormalId.Front, { { "각성선인", Color3.fromRGB(255, 220, 140), 1 } })
	out.awaken = prompt(body, "각성", A.name, "Awaken")
end

local function regionSigns()
	for _, r in ipairs(Config.Regions) do
		-- 문루가 선 지역은 문루의 현판이 이름표 (따로 팻말을 세우지 않는다)
		if r.id ~= "village" and not r.noGround and not gatedRegions[r.id] then
			local dir = Vector3.new(r.center.X, 0, r.center.Z).Unit
			local pos = r.center - dir * (math.max(r.size.X, r.size.Z) / 2 - 12)
			-- 길 옆 (길과 직각으로 비켜서)
			local side = Vector3.new(-dir.Z, 0, dir.X) * 16
			local post = part({ Name = "RegionPost", Size = Vector3.new(1.4, 10, 1.4), Position = pos + side + Vector3.new(0, 5, 0), Color = WOOD, Material = Enum.Material.Wood, Parent = folder })
			local board = part({ Name = "RegionSign", Size = Vector3.new(20, 5, 0.5), CFrame = CFrame.lookAt(pos + side + Vector3.new(0, 11, 0), pos + side + Vector3.new(0, 11, 0) - dir), Color = Color3.fromRGB(35, 25, 18), Material = Enum.Material.Wood, CanCollide = false, Parent = folder })
			sign(board, Enum.NormalId.Front, { { r.name, Color3.fromRGB(255, 225, 160), 1 } })
			local _ = post
		end
	end
end

------------------------------------------------------------------------
-- 천층탑 시련장: 하늘에 뜬 둥근 단 (사람마다 한 자리, 처음 쓸 때 짓는다). 단의 윗면 가운데를 돌려준다
------------------------------------------------------------------------
------------------------------------------------------------------------
-- 천상계 (세계 2): 높은 하늘의 섬들과 구름 다리. 땅과 섞이지 않는다
------------------------------------------------------------------------
-- 문: 빛나는 고리와 소용돌이 (prompt를 달 받침을 돌려준다)
local function portalGate(at: Vector3, yaw: number, color: Color3, parent: Instance, label: string): BasePart
	local cf = CFrame.new(at) * CFrame.Angles(0, yaw, 0)
	local n = 20
	for k = 0, n - 1 do
		local a = k / n * math.pi * 2
		local p = cf * CFrame.new(math.cos(a) * 7, 8 + math.sin(a) * 7, 0)
		part({ Name = "PortalRing", Size = Vector3.new(1, 2.4, 1), CFrame = CFrame.lookAt(p.Position, (cf * CFrame.new(0, 8, 0)).Position) * CFrame.Angles(0, 0, a), Color = color, Material = Enum.Material.Neon, CanCollide = false, Parent = parent })
	end
	local swirl = part({ Name = "PortalSwirl", Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.3, 13, 13), CFrame = cf * CFrame.new(0, 8, 0) * CFrame.Angles(0, math.rad(90), 0), Color = color:Lerp(Color3.new(1, 1, 1), 0.5), Material = Enum.Material.Glass, Transparency = 0.35, CanCollide = false, Parent = parent })
	light(swirl, color, 30, 2)
	part({ Name = "PortalBase", Size = Vector3.new(18, 1, 6), CFrame = cf * CFrame.new(0, 0.5, 0), Color = STONE, Material = Enum.Material.Marble, Parent = parent })
	local pedestal = part({ Name = "PortalPedestal", Size = Vector3.new(3, 3.2, 3), CFrame = cf * CFrame.new(0, 1.6, -5), Color = STONE, Material = Enum.Material.Marble, Parent = parent })
	local board = part({ Name = "PortalSign", Size = Vector3.new(12, 2.6, 0.4), CFrame = cf * CFrame.new(0, 17.5, 0), Color = Color3.fromRGB(30, 22, 18), Material = Enum.Material.Wood, CanCollide = false, Parent = parent })
	sign(board, Enum.NormalId.Front, { { label, GOLD, 1 } })
	sign(board, Enum.NormalId.Back, { { label, GOLD, 1 } })
	return pedestal
end

local function skyWorld(out: any)
	local SKY = Config.SKY
	local f = Instance.new("Folder")
	f.Name = "SkyWorld"
	f.Parent = folder
	-- 땅 마을의 천상 문
	local vf = folder:FindFirstChild("Village") or f
	out.skyUp = prompt(portalGate(SKY.portal, math.rad(45), Color3.fromRGB(150, 220, 255), vf, "☁ 천상 문"), "천상계로 오르기", "천상 문", "SkyUp")
	local CLOUD = Color3.fromRGB(250, 250, 255)
	-- 2.9판: 섬마다 다른 몸. 테두리·밑동·매달린 것·둘레 구름·떠도는 작은 섬을 섬마다 따로 짓는다
	-- (예전엔 모든 섬이 같은 금 테두리 원판이라 그 금빛이 섬 바닥 전체를 덮었다)
	local function rgb(r: number, g: number, b: number): Color3
		return Color3.fromRGB(r, g, b)
	end
	local ROCK = Enum.Material.Rock
	local SKY_BODY: { [string]: any } = {
		skytown = { depth = 0.3, rim = "gold", under = { rgb(150, 140, 130), ROCK }, drip = "rock", cloud = { CLOUD, 0.15, 1 }, islet = "rock" },
		cloudplain = { rim = "cloud", under = "cloud", cloud = { CLOUD, 0.05, 1.5 }, islet = "cloud" },
		thunder = { depth = 0.45, blocky = true, rim = "crag", rimColor = rgb(55, 60, 78), under = { rgb(48, 50, 64), Enum.Material.Slate }, vein = rgb(120, 170, 255), drip = "spike", dripColor = rgb(40, 42, 55), cloud = { rgb(92, 96, 112), 0.2, 1.25 }, islet = "rod", ledges = 6 },
		nebula = { depth = 0.22, core = "crystal", rim = "star", rimColor = rgb(200, 150, 255), under = { rgb(70, 50, 110), Enum.Material.Glass }, drip = "crystal", dripColor = rgb(170, 120, 255), cloud = { rgb(175, 135, 235), 0.4, 1 }, islet = "crystal" },
		throne = { rim = "rail", rimColor = rgb(250, 245, 235), under = "pyramid", cloud = { CLOUD, 0.15, 1 }, islet = "dais" },
		subspace = { depth = 0.4, blocky = true, rim = "none", under = { rgb(20, 12, 34), Enum.Material.Glass }, drip = "shard", dripColor = rgb(40, 20, 70) },
		frost = { depth = 0.38, rim = "ice", under = { rgb(185, 220, 245), Enum.Material.Glacier }, drip = "icicle", dripColor = rgb(200, 235, 255), cloud = { rgb(245, 250, 255), 0.05, 1.1 }, islet = "ice", ledges = 5 },
		phoenix = { depth = 0.42, blocky = true, rim = "lava", under = { rgb(62, 30, 24), Enum.Material.Basalt }, vein = rgb(255, 110, 30), drip = "lava", dripColor = rgb(55, 26, 20), cloud = { rgb(85, 62, 56), 0.3, 1.1 }, islet = "ember", ledges = 5 },
		raidarena = { depth = 0.25, rim = "banner", rimColor = rgb(150, 40, 45), under = { rgb(125, 115, 104), Enum.Material.Granite }, drip = "rock", cloud = { CLOUD, 0.15, 1 }, islet = "rock" },
		falls = { depth = 0.36, rim = "moss", under = { rgb(92, 108, 84), ROCK }, drip = "moss", dripColor = rgb(80, 96, 72), cloud = { rgb(235, 245, 250), 0.25, 1 }, islet = "moss", ledges = 6 },
		crane = { rim = "rail", rimColor = rgb(245, 245, 240), under = "peak", cloud = { CLOUD, 0.1, 1.3 }, islet = "pine" },
		bamboo = { depth = 0.32, rim = "fence", under = { rgb(112, 86, 60), Enum.Material.Ground }, drip = "root", dripColor = rgb(96, 70, 46), cloud = { rgb(236, 246, 236), 0.3, 1 }, islet = "bamboo", ledges = 4 },
		moonlake = { depth = 0.16, rim = "silver", under = { rgb(180, 186, 204), Enum.Material.Marble }, drip = "water", cloud = { rgb(210, 222, 246), 0.25, 1 }, islet = "lotus" },
		rinnedae = { depth = 0.36, bands = true, rim = "gold", under = { rgb(196, 186, 226), Enum.Material.Marble }, drip = "crystal", dripColor = rgb(180, 150, 255), cloud = { rgb(235, 230, 255), 0.2, 1.1 }, islet = "crystal" },
		goldtemple = { depth = 0.3, bands = true, rim = "goldbell", under = { rgb(200, 168, 118), Enum.Material.Sandstone }, drip = "gold", dripColor = rgb(190, 158, 108), cloud = { rgb(255, 236, 196), 0.2, 1 }, islet = "bell" },
	}
	-- 다리가 닿는 방향 (테두리 꾸밈은 그 자리를 비운다)
	local function bridgeGaps(isl: any): { { number } }
		local gaps = {}
		for _, b in ipairs(SKY.bridges) do
			local me = SKY.islands[b[1]] == isl and 1 or (SKY.islands[b[2]] == isl and 2 or nil)
			if me then
				local other = SKY.islands[b[me == 1 and 2 or 1]]
				local d = other.at - isl.at
				local w = b.hidden and 8 or 16
				table.insert(gaps, { math.atan2(d.Z, d.X), math.asin(math.clamp((w / 2 + 4) / isl.radius, 0, 1)) })
			end
		end
		return gaps
	end
	local function inGap(gaps: { { number } }, a: number, pad: number): boolean
		for _, g in ipairs(gaps) do
			if math.abs((a - g[1] + math.pi) % (2 * math.pi) - math.pi) < g[2] + pad then
				return true
			end
		end
		return false
	end
	-- 섬 둘레를 따라 도는 띠 (조각을 이어 붙인다. 원판으로 덮으면 섬 바닥까지 덮이니까)
	local function ringBand(name: string, c: Vector3, r: number, width: number, height: number, y: number, color: Color3, mat: Enum.Material, f: Instance, gaps: { { number } }?, transp: number?)
		local n = math.max(24, math.floor(2 * math.pi * r / 7))
		for k = 0, n - 1 do
			local a = (k + 0.5) / n * math.pi * 2
			if not (gaps and inGap(gaps, a, 0)) then
				local p = c + Vector3.new(math.cos(a) * r, y, math.sin(a) * r)
				part({ Name = name, Size = Vector3.new(2 * math.pi * r / n + 0.4, height, width), CFrame = CFrame.lookAt(p, Vector3.new(c.X, p.Y, c.Z)), Color = color, Material = mat, Transparency = transp or 0, CanCollide = false, Parent = f })
			end
		end
	end
	-- 테두리를 따라 같은 간격으로 무언가를 세운다
	local function alongRim(c: Vector3, r: number, step: number, gaps: { { number } }, fn: (Vector3, number, number) -> ())
		local n = math.max(8, math.floor(2 * math.pi * r / step))
		for k = 0, n - 1 do
			local a = k / n * math.pi * 2
			if not inGap(gaps, a, 0.02) then
				fn(c + Vector3.new(math.cos(a) * r, 0, math.sin(a) * r), a, 2 * math.pi * r / n)
			end
		end
	end

	local function skyIslandBody(isl: any, f: Instance)
		local c, R = isl.at, isl.radius
		local B = SKY_BODY[isl.id] or SKY_BODY.skytown
		local k1 = math.clamp(R / 180, 0.4, 1.3)
		local gaps = bridgeGaps(isl)
		local underCol = type(B.under) == "table" and B.under[1] or Color3.fromRGB(140, 135, 128)
		local underMat = type(B.under) == "table" and B.under[2] or ROCK
		------------------------------------------------ 밑동
		if B.under == "cloud" then
			-- 운해 평원: 바위 대신 큰 구름 둑이 들판을 받친다
			disc("SkyIslandUnder", c - Vector3.new(0, 9, 0), R * 0.92, 6, CLOUD, Enum.Material.SmoothPlastic, f)
			for k = 0, 21 do
				local a = k / 22 * math.pi * 2 + rng:NextNumber(0, 0.3)
				local rr = R * rng:NextNumber(0.2, 0.85)
				local sz = rng:NextNumber(40, 75) * k1
				part({ Name = "SkyCloudBank", Shape = Enum.PartType.Ball, Size = Vector3.new(sz, sz * 0.7, sz), Position = c + Vector3.new(math.cos(a) * rr, -16 - rng:NextNumber() * 18, math.sin(a) * rr), Color = CLOUD:Lerp(Color3.fromRGB(215, 224, 240), rng:NextNumber()), Material = Enum.Material.SmoothPlastic, CanCollide = false, Parent = f })
			end
		elseif B.under == "pyramid" then
			-- 옥좌대: 거꾸로 선 계단 피라미드 (층마다 금테), 맨 끝에 빛나는 구슬
			for i = 0, 5 do
				local w = R * 1.35 * (1 - i * 0.16)
				local y = -6 - i * 9
				local cf = CFrame.new(c + Vector3.new(0, y - 4.5, 0)) * CFrame.Angles(0, math.rad(45), 0)
				part({ Name = "ThroneUnder", Size = Vector3.new(w, 9, w), CFrame = cf, Color = Color3.fromRGB(240, 232, 212), Material = Enum.Material.Marble, CanCollide = false, Parent = f })
				part({ Name = "ThroneUnderTrim", Size = Vector3.new(w + 1.2, 1.2, w + 1.2), CFrame = cf * CFrame.new(0, -4.2, 0), Color = GOLD, Material = Enum.Material.Metal, CanCollide = false, Parent = f })
			end
			local orb = part({ Name = "ThroneUnderOrb", Shape = Enum.PartType.Ball, Size = Vector3.new(12, 12, 12), Position = c - Vector3.new(0, 66, 0), Color = Color3.fromRGB(255, 225, 140), Material = Enum.Material.Neon, CanCollide = false, Parent = f })
			light(orb, Color3.fromRGB(255, 220, 140), 50, 1.5)
		elseif B.under == "peak" then
			-- 청학봉: 거꾸로 선 높은 바위 봉우리. 끝이 구름 아래 멀리 내려간다
			disc("SkyIslandUnder", c - Vector3.new(0, 10, 0), R * 0.82, 8, Color3.fromRGB(150, 146, 138), ROCK, f)
			for i = 1, 8 do
				local w = R * 1.3 * (1 - i / 9)
				part({ Name = "CranePeak", Size = Vector3.new(w, 18, w * 0.9), CFrame = CFrame.new(c - Vector3.new(rng:NextNumber(-4, 4), 12 + i * 16, rng:NextNumber(-4, 4))) * CFrame.Angles(0, i * 0.7, 0),
					Color = Color3.fromRGB(150, 146, 138):Lerp(Color3.fromRGB(105, 102, 98), i / 8), Material = ROCK, CanCollide = false, Parent = f })
			end
			-- 봉우리 허리에 걸린 작은 소나무
			for k = 0, 3 do
				local a = k * math.pi / 2 + 0.4
				local y = 30 + k * 14
				local rr = R * 1.3 * (1 - (y / 16) / 9) / 2
				pine(c + Vector3.new(math.cos(a) * rr, -y + 9, math.sin(a) * rr), 0.7, f, false)
			end
		else
			-- 아래로 갈수록 좁아지는 바위 덩이 (섬마다 깊이와 결이 다르다: 뇌정봉은 각진 바위, 금운사는 금띠 두른 층)
			local depth = (B.depth or 0.3) * R
			local n = 5
			for i = 1, n do
				local rr = R * 0.82 * (1 - (i - 1) / (n + 0.8))
				local h = depth / n + 2
				local off = Vector3.new(rng:NextNumber(-1, 1), 0, rng:NextNumber(-1, 1)) * (R * 0.04 * i)
				local at = c + off + Vector3.new(0, -6 - (i - 0.5) * depth / n, 0)
				local col = underCol:Lerp(Color3.new(0, 0, 0), i * 0.035)
				if B.blocky then
					part({ Name = "SkyIslandUnder", Size = Vector3.new(rr * 1.45, h, rr * 1.45), CFrame = CFrame.new(at) * CFrame.Angles(rng:NextNumber(-0.05, 0.05), rng:NextNumber(0, 1.5), rng:NextNumber(-0.05, 0.05)), Color = col, Material = underMat, CanCollide = false, Parent = f })
				else
					disc("SkyIslandUnder", at, rr, h, col, underMat, f, false)
				end
				if B.bands then
					disc("SkyUnderBand", at + Vector3.new(0, h / 2 - 0.6, 0), rr + 1, 1.2, GOLD, Enum.Material.Metal, f, false)
				end
			end
			-- 성운원: 밑동 끝에서 커다란 수정 무리가 아래로 뻗는다
			if B.core == "crystal" then
				local tip = c - Vector3.new(0, 6 + depth, 0)
				for k = 0, 5 do
					local a = k / 6 * math.pi * 2
					local h = rng:NextNumber(40, 80) * k1
					local w = rng:NextNumber(10, 18) * k1
					local cf = CFrame.new(tip) * CFrame.Angles(0, a, 0) * CFrame.Angles(math.rad(rng:NextNumber(12, 30)), 0, 0) * CFrame.new(0, -h / 2 + 4, 0) * CFrame.Angles(0, math.rad(45), 0)
					part({ Name = "NebulaCrystal", Size = Vector3.new(w, h, w), CFrame = cf, Color = Color3.fromRGB(150, 100, 230):Lerp(Color3.fromRGB(110, 200, 255), rng:NextNumber()), Material = Enum.Material.Glass, Transparency = 0.12, CanCollide = false, Parent = f })
					part({ Name = "NebulaCrystalCore", Size = Vector3.new(w * 0.3, h * 0.8, w * 0.3), CFrame = cf, Color = Color3.fromRGB(235, 210, 255), Material = Enum.Material.Neon, CanCollide = false, Parent = f })
				end
				local big = part({ Name = "NebulaCrystal", Size = Vector3.new(20 * k1, 110 * k1, 20 * k1), CFrame = CFrame.new(tip - Vector3.new(0, 50 * k1, 0)) * CFrame.Angles(0, math.rad(45), 0), Color = Color3.fromRGB(170, 120, 255), Material = Enum.Material.Glass, Transparency = 0.1, CanCollide = false, Parent = f })
				light(big, Color3.fromRGB(190, 140, 255), 60, 1.2)
			end
		end
		-- 바위 결의 빛 줄기 (뇌정봉은 푸른 번개, 봉황대는 흐르는 용암)
		if B.vein then
			for k = 0, 11 do
				local a = k / 12 * math.pi * 2 + rng:NextNumber(0, 0.2)
				local rr = R * 0.75 + 0.1
				part({ Name = "SkyVein", Size = Vector3.new(0.6, rng:NextNumber(6, 9), 0.6), CFrame = CFrame.new(c + Vector3.new(math.cos(a) * rr, -10, math.sin(a) * rr)) * CFrame.Angles(0, 0, rng:NextNumber(-0.4, 0.4)), Color = B.vein, Material = Enum.Material.Neon, CanCollide = false, Parent = f })
			end
		end
		-- 둘레 아래쪽 바위 턱 (둥근 원판 모양을 깨뜨린다)
		for k = 1, B.ledges or 0 do
			local a = k / B.ledges * math.pi * 2 + rng:NextNumber(-0.3, 0.3)
			if not inGap(gaps, a, 0.15) then
				local lr = rng:NextNumber(18, 34) * k1
				disc("SkyLedge", c + Vector3.new(math.cos(a) * (R - lr * 0.3), -7 - rng:NextNumber(0, 5), math.sin(a) * (R - lr * 0.3)), lr, rng:NextNumber(6, 10), underCol:Lerp(isl.ground, 0.25), underMat, f, false)
			end
		end
		------------------------------------------------ 테두리
		local rim = B.rim
		local rimC = B.rimColor or GOLD
		if rim == "gold" then
			ringBand("SkyIslandEdge", c, R + 0.6, 1.6, 0.8, -0.1, GOLD, Enum.Material.Metal, f)
		elseif rim == "cloud" then
			alongRim(c, R - 1, 9, gaps, function(p)
				local sz = rng:NextNumber(9, 15)
				part({ Name = "CloudRim", Shape = Enum.PartType.Ball, Size = Vector3.new(sz, sz * 0.6, sz), Position = p + Vector3.new(0, 0.6, 0), Color = CLOUD, Material = Enum.Material.SmoothPlastic, Transparency = 0.05, CanCollide = false, Parent = f })
			end)
		elseif rim == "crag" then
			alongRim(c, R - 1.5, 13, gaps, function(p, a)
				local h = rng:NextNumber(5, 16)
				local w = rng:NextNumber(3, 7)
				part({ Name = "CragTooth", Size = Vector3.new(w, h, w * 1.3), CFrame = CFrame.new(p + Vector3.new(0, h * 0.35, 0)) * CFrame.Angles(0, -a, 0) * CFrame.Angles(rng:NextNumber(-0.3, 0.3), 0, rng:NextNumber(0.1, 0.45)), Color = rimC:Lerp(Color3.fromRGB(80, 84, 100), rng:NextNumber()), Material = Enum.Material.Slate, CanCollide = false, Parent = f })
			end)
		elseif rim == "star" then
			ringBand("StarRim", c, R + 0.2, 1, 0.3, 0.02, rimC, Enum.Material.Neon, f, nil, 0.35)
			for _ = 1, 18 do
				local a = rng:NextNumber() * math.pi * 2
				local d = R + rng:NextNumber(4, 14)
				local sz = rng:NextNumber(0.8, 2)
				part({ Name = "RimStar", Shape = Enum.PartType.Ball, Size = Vector3.new(sz, sz, sz), Position = c + Vector3.new(math.cos(a) * d, rng:NextNumber(-6, 12), math.sin(a) * d), Color = rimC:Lerp(Color3.new(1, 1, 1), 0.5), Material = Enum.Material.Neon, CanCollide = false, Parent = f })
			end
		elseif rim == "rail" then
			-- 대리석 난간: 기둥과 가로대
			alongRim(c, R - 0.8, 10, gaps, function(p, a, seg)
				part({ Name = "RailPost", Size = Vector3.new(1.2, 4, 1.2), CFrame = CFrame.new(p + Vector3.new(0, 2, 0)) * CFrame.Angles(0, -a, 0), Color = rimC, Material = Enum.Material.Marble, CanCollide = false, Parent = f })
				part({ Name = "RailCap", Shape = Enum.PartType.Ball, Size = Vector3.new(1.4, 1.4, 1.4), Position = p + Vector3.new(0, 4.4, 0), Color = GOLD, Material = Enum.Material.Metal, CanCollide = false, Parent = f })
				local tang = Vector3.new(-math.sin(a), 0, math.cos(a))
				local mid = p + tang * (seg / 2) + Vector3.new(0, 3.4, 0)
				part({ Name = "RailBar", Size = Vector3.new(0.8, 0.6, seg), CFrame = CFrame.lookAt(mid, mid + tang), Color = rimC, Material = Enum.Material.Marble, CanCollide = false, Parent = f })
			end)
		elseif rim == "ice" then
			ringBand("IceRim", c, R + 0.5, 2, 1, -0.2, Color3.fromRGB(200, 235, 255), Enum.Material.Ice, f)
			alongRim(c, R - 1, 22, gaps, function(p, a)
				local h = rng:NextNumber(6, 15)
				part({ Name = "RimIce", Size = Vector3.new(h * 0.3, h, h * 0.3), CFrame = CFrame.new(p + Vector3.new(0, h * 0.35, 0)) * CFrame.Angles(0, -a, 0) * CFrame.Angles(0, 0, rng:NextNumber(0.15, 0.5)), Color = Color3.fromRGB(180, 225, 255), Material = Enum.Material.Ice, Transparency = 0.2, CanCollide = false, Parent = f })
			end)
		elseif rim == "lava" then
			ringBand("LavaRimRock", c, R + 1.2, 3, 1.6, -0.4, Color3.fromRGB(50, 24, 18), Enum.Material.Basalt, f)
			ringBand("LavaRim", c, R - 0.6, 0.8, 0.2, 0.05, Color3.fromRGB(255, 120, 40), Enum.Material.Neon, f, gaps, 0.15)
		elseif rim == "banner" then
			ringBand("ArenaRim", c, R + 0.5, 1.6, 1, -0.2, rimC, Enum.Material.Wood, f)
			alongRim(c, R + 1.4, 26, gaps, function(p, a)
				part({ Name = "RimBanner", Size = Vector3.new(5, 16, 0.3), CFrame = CFrame.new(p - Vector3.new(0, 8, 0)) * CFrame.Angles(0, -a + math.pi / 2, 0), Color = rimC, Material = Enum.Material.Fabric, CanCollide = false, Parent = f })
				part({ Name = "RimBannerMark", Size = Vector3.new(2.4, 2.4, 0.35), CFrame = CFrame.new(p - Vector3.new(0, 5, 0)) * CFrame.Angles(0, -a + math.pi / 2, 0) * CFrame.Angles(0, 0, math.rad(45)), Color = GOLD, Material = Enum.Material.Metal, CanCollide = false, Parent = f })
			end)
		elseif rim == "moss" then
			alongRim(c, R - 0.5, 8, gaps, function(p)
				local sz = rng:NextNumber(4, 7)
				part({ Name = "MossRim", Shape = Enum.PartType.Ball, Size = Vector3.new(sz, sz * 0.6, sz), Position = p, Color = Color3.fromRGB(78, 120, 60):Lerp(Color3.fromRGB(110, 140, 70), rng:NextNumber()), Material = Enum.Material.Grass, CanCollide = false, Parent = f })
			end)
		elseif rim == "fence" then
			-- 대나무 울타리: 굵은 대 기둥과 두 줄 가로대
			alongRim(c, R - 1, 8, gaps, function(p, a, seg)
				part({ Name = "FencePost", Shape = Enum.PartType.Cylinder, Size = Vector3.new(4.5, 0.8, 0.8), CFrame = CFrame.new(p + Vector3.new(0, 2.2, 0)) * CFrame.Angles(0, 0, math.rad(90)), Color = Color3.fromRGB(150, 170, 80), Material = Enum.Material.Wood, CanCollide = false, Parent = f })
				local tang = Vector3.new(-math.sin(a), 0, math.cos(a))
				for _, y in ipairs({ 1.4, 3.2 }) do
					local mid = p + tang * (seg / 2) + Vector3.new(0, y, 0)
					part({ Name = "FenceRail", Shape = Enum.PartType.Cylinder, Size = Vector3.new(seg, 0.4, 0.4), CFrame = CFrame.lookAt(mid, mid + tang) * CFrame.Angles(0, math.rad(90), 0), Color = Color3.fromRGB(170, 185, 96), Material = Enum.Material.Wood, CanCollide = false, Parent = f })
				end
			end)
		elseif rim == "silver" then
			ringBand("SilverRim", c, R + 0.4, 1.2, 0.6, -0.1, Color3.fromRGB(215, 222, 236), Enum.Material.Metal, f)
		elseif rim == "goldbell" then
			ringBand("GoldRim", c, R + 0.6, 2, 0.8, -0.1, GOLD, Enum.Material.Metal, f)
			ringBand("GoldRim2", c, R + 1.6, 1, 1.6, -1.2, Color3.fromRGB(160, 50, 36), Enum.Material.Wood, f)
			alongRim(c, R + 1.4, 30, gaps, function(p)
				part({ Name = "RimBellChain", Size = Vector3.new(0.3, 4, 0.3), Position = p - Vector3.new(0, 4, 0), Color = GOLD, Material = Enum.Material.Metal, CanCollide = false, Parent = f })
				part({ Name = "RimBell", Shape = Enum.PartType.Ball, Size = Vector3.new(2.2, 2.6, 2.2), Position = p - Vector3.new(0, 7, 0), Color = Color3.fromRGB(210, 170, 70), Material = Enum.Material.Metal, CanCollide = false, Parent = f })
			end)
		end
		------------------------------------------------ 밑에 매달린 것
		local drip = B.drip
		local dc = B.dripColor or Color3.fromRGB(120, 110, 100)
		if drip == "moss" or drip == "water" then
			-- 테두리에서 늘어진 덩굴 / 흘러내리는 가는 물줄기
			alongRim(c, R + 0.3, drip == "moss" and 18 or 150, gaps, function(p, a)
				if drip == "moss" then
					local h = rng:NextNumber(8, 20)
					part({ Name = "RimVine", Size = Vector3.new(0.5, h, 0.5), CFrame = CFrame.new(p + Vector3.new(math.cos(a), -h / 2, math.sin(a)) * 1), Color = Color3.fromRGB(70, 110, 55), Material = Enum.Material.Grass, CanCollide = false, Parent = f })
				else
					local len = rng:NextNumber(25, 55)
					part({ Name = "RimWater", Size = Vector3.new(rng:NextNumber(8, 14), len, 0.6), CFrame = CFrame.new(p + Vector3.new(math.cos(a) * 1.2, -len / 2, math.sin(a) * 1.2)) * CFrame.Angles(0, -a + math.pi / 2, 0), Color = Color3.fromRGB(190, 215, 255), Material = Enum.Material.Glass, Transparency = 0.6, CanCollide = false, Parent = f })
					part({ Name = "RimWaterMist", Shape = Enum.PartType.Ball, Size = Vector3.new(16, 8, 16), Position = p + Vector3.new(math.cos(a) * 2, -len, math.sin(a) * 2), Color = Color3.fromRGB(235, 242, 255), Material = Enum.Material.SmoothPlastic, Transparency = 0.5, CanCollide = false, Parent = f })
				end
			end)
		end
		if drip and drip ~= "water" then
			local n = drip == "icicle" and 18 or (drip == "root" and 16 or 10)
			for k = 0, n - 1 do
				local a = k / n * math.pi * 2 + rng:NextNumber(0, 0.5)
				local rr = R * rng:NextNumber(0.15, 0.62)
				local h = rng:NextNumber(14, 34) * k1
				local w = rng:NextNumber(8, 16) * math.clamp(R / 180, 0.4, 1.2)
				local top = c + Vector3.new(math.cos(a) * rr, -22, math.sin(a) * rr)
				if drip == "icicle" then
					h *= 1.3
					w *= 0.4
					part({ Name = "Icicle", Size = Vector3.new(w, h, w), CFrame = CFrame.new(top - Vector3.new(0, h * 0.45, 0)) * CFrame.Angles(0, rng:NextNumber(0, 6), 0), Color = dc, Material = Enum.Material.Ice, Transparency = 0.15, CanCollide = false, Parent = f })
				elseif drip == "crystal" or drip == "shard" then
					part({ Name = "UnderCrystal", Size = Vector3.new(w * 0.6, h, w * 0.6), CFrame = CFrame.new(top - Vector3.new(0, h * 0.4, 0)) * CFrame.Angles(0, math.rad(45) + a, 0) * CFrame.Angles(rng:NextNumber(-0.25, 0.25), 0, rng:NextNumber(-0.25, 0.25)), Color = dc, Material = Enum.Material.Glass, Transparency = 0.1, CanCollide = false, Parent = f })
					if drip == "crystal" and k % 2 == 0 then
						part({ Name = "UnderCrystalCore", Size = Vector3.new(w * 0.2, h * 0.7, w * 0.2), CFrame = CFrame.new(top - Vector3.new(0, h * 0.4, 0)) * CFrame.Angles(0, math.rad(45) + a, 0), Color = Color3.fromRGB(230, 200, 255), Material = Enum.Material.Neon, CanCollide = false, Parent = f })
					end
				elseif drip == "root" then
					local len = rng:NextNumber(10, 26)
					part({ Name = "UnderRoot", Shape = Enum.PartType.Cylinder, Size = Vector3.new(len, rng:NextNumber(0.6, 1.4), rng:NextNumber(0.6, 1.4)), CFrame = CFrame.new(top + Vector3.new(0, 8, 0)) * CFrame.Angles(0, -a, 0) * CFrame.Angles(0, 0, math.rad(rng:NextNumber(-120, -60))) * CFrame.new(len / 2, 0, 0), Color = dc, Material = Enum.Material.Wood, CanCollide = false, Parent = f })
				else
					local rock = part({ Name = "SkyStalactite", Size = Vector3.new(w * (drip == "spike" and 0.55 or 1), h * (drip == "spike" and 1.4 or 1), w * (drip == "spike" and 0.55 or 1)), CFrame = CFrame.new(top - Vector3.new(0, h * 0.4, 0)) * CFrame.Angles(rng:NextNumber(-0.2, 0.2), rng:NextNumber(0, 6), rng:NextNumber(-0.2, 0.2)),
						Color = dc:Lerp(dc:Lerp(Color3.new(0, 0, 0), 0.25), rng:NextNumber()), Material = drip == "lava" and Enum.Material.Basalt or (drip == "gold" and Enum.Material.Sandstone or (drip == "spike" and Enum.Material.Slate or ROCK)), CanCollide = false, Parent = f })
					if drip == "lava" then
						part({ Name = "LavaDrop", Shape = Enum.PartType.Ball, Size = Vector3.new(w * 0.35, w * 0.5, w * 0.35), Position = rock.Position - Vector3.new(0, h * 0.5, 0), Color = Color3.fromRGB(255, 120, 40), Material = Enum.Material.Neon, CanCollide = false, Parent = f })
					elseif drip == "gold" then
						part({ Name = "GoldBand", Size = Vector3.new(w * 1.05, 1.2, w * 1.05), CFrame = rock.CFrame * CFrame.new(0, h * 0.2, 0), Color = GOLD, Material = Enum.Material.Metal, CanCollide = false, Parent = f })
					elseif drip == "moss" then
						part({ Name = "MossCap", Size = Vector3.new(w * 1.05, 2, w * 1.05), CFrame = rock.CFrame * CFrame.new(0, h * 0.4, 0), Color = Color3.fromRGB(80, 120, 60), Material = Enum.Material.Grass, CanCollide = false, Parent = f })
					end
				end
			end
		end
		------------------------------------------------ 둘레 구름 (아래쪽)
		if B.cloud then
			local col, tr, sc = B.cloud[1], B.cloud[2], B.cloud[3] or 1
			local n = math.max(8, math.floor(R / 14))
			for k = 0, n - 1 do
				local a = k / n * math.pi * 2 + rng:NextNumber() * 0.3
				local size = rng:NextNumber(18, 34) * sc
				part({ Name = "SkyCloud", Shape = Enum.PartType.Ball, Size = Vector3.new(size, size * 0.8, size), Position = c + Vector3.new(math.cos(a) * (R * 0.9), -9 - rng:NextNumber() * 6 * sc, math.sin(a) * (R * 0.9)), Color = col, Material = Enum.Material.SmoothPlastic, Transparency = tr, CanCollide = false, Parent = f })
			end
		end
		------------------------------------------------ 떠도는 작은 섬
		if isl.hidden or not B.islet then
			return
		end
		for k = 0, 3 do
			local a = k / 4 * math.pi * 2 + rng:NextNumber(0, 1)
			local d = R + rng:NextNumber(40, 90)
			local p = c + Vector3.new(math.cos(a) * d, rng:NextNumber(-30, 25), math.sin(a) * d)
			local w = rng:NextNumber(10, 22)
			local kind = B.islet
			if kind == "cloud" then
				for j = 0, 2 do
					local sz = w * (1 - j * 0.2)
					part({ Name = "IsletCloud", Shape = Enum.PartType.Ball, Size = Vector3.new(sz, sz * 0.6, sz), Position = p + Vector3.new((j - 1) * w * 0.5, j * 0.6, rng:NextNumber(-2, 2)), Color = CLOUD, Material = Enum.Material.SmoothPlastic, Transparency = 0.1, CanCollide = false, Parent = f })
				end
			elseif kind == "crystal" or kind == "ice" then
				local col = kind == "ice" and Color3.fromRGB(190, 230, 255) or Color3.fromRGB(190, 140, 255)
				for j = 0, 2 do
					local h = w * (1.2 - j * 0.3)
					part({ Name = kind == "ice" and "IsletIce" or "IsletCrystal", Size = Vector3.new(h * 0.4, h, h * 0.4), CFrame = CFrame.new(p + Vector3.new((j - 1) * 3, 0, rng:NextNumber(-2, 2))) * CFrame.Angles(rng:NextNumber(-0.4, 0.4), rng:NextNumber(0, 6), rng:NextNumber(-0.4, 0.4)),
						Color = col, Material = kind == "ice" and Enum.Material.Ice or Enum.Material.Glass, Transparency = 0.15, CanCollide = false, Parent = f })
				end
				if kind == "crystal" then
					part({ Name = "IsletCrystalCore", Size = Vector3.new(1, w * 0.7, 1), Position = p, Color = Color3.fromRGB(235, 210, 255), Material = Enum.Material.Neon, CanCollide = false, Parent = f })
				end
			elseif kind == "dais" then
				-- 금테 두른 대리석 단과 작은 기둥 (옥좌대)
				disc("IsletDais", p, w * 0.6, 2.4, Color3.fromRGB(245, 238, 220), Enum.Material.Marble, f, false)
				ringBand("IsletDaisTrim", p, w * 0.6, 0.6, 0.6, -1.4, GOLD, Enum.Material.Metal, f)
				part({ Name = "IsletDaisPillar", Size = Vector3.new(2, 10, 2), Position = p + Vector3.new(0, 6, 0), Color = Color3.fromRGB(250, 245, 235), Material = Enum.Material.Marble, CanCollide = false, Parent = f })
				brazier(p + Vector3.new(0, 11, 0), 0.9, f)
			else
				-- 바위섬 (밑은 뾰족, 위는 그 섬의 땅빛)
				local rockC = kind == "ember" and Color3.fromRGB(55, 28, 22) or (kind == "rod" and Color3.fromRGB(52, 55, 70) or (kind == "bell" and Color3.fromRGB(196, 165, 115) or Color3.fromRGB(130, 120, 110)))
				local mat = kind == "ember" and Enum.Material.Basalt or (kind == "rod" and Enum.Material.Slate or (kind == "bell" and Enum.Material.Sandstone or ROCK))
				part({ Name = "SkyIslet", Shape = Enum.PartType.Cylinder, Size = Vector3.new(w * 0.5, w, w), CFrame = CFrame.new(p) * CFrame.Angles(0, 0, math.rad(90)), Color = rockC, Material = mat, CanCollide = false, Parent = f })
				part({ Name = "SkyIsletTop", Shape = Enum.PartType.Cylinder, Size = Vector3.new(1, w * 1.02, w * 1.02), CFrame = CFrame.new(p + Vector3.new(0, w * 0.25, 0)) * CFrame.Angles(0, 0, math.rad(90)), Color = isl.ground, Material = isl.material, CanCollide = false, Parent = f })
				part({ Name = "SkyIsletRoot", Size = Vector3.new(w * 0.5, w * 0.8, w * 0.5), CFrame = CFrame.new(p - Vector3.new(0, w * 0.5, 0)) * CFrame.Angles(0, math.rad(45), 0), Color = rockC:Lerp(Color3.new(0, 0, 0), 0.15), Material = mat, CanCollide = false, Parent = f })
				local top = p + Vector3.new(0, w * 0.25 + 0.5, 0)
				if kind == "rod" then
					-- 피뢰침: 쇠 기둥 끝에 푸른 번개 구슬
					part({ Name = "IsletRod", Size = Vector3.new(0.6, 14, 0.6), Position = top + Vector3.new(0, 7, 0), Color = Color3.fromRGB(90, 95, 110), Material = Enum.Material.Metal, CanCollide = false, Parent = f })
					part({ Name = "IsletRodTip", Shape = Enum.PartType.Ball, Size = Vector3.new(1.8, 1.8, 1.8), Position = top + Vector3.new(0, 14.5, 0), Color = Color3.fromRGB(140, 190, 255), Material = Enum.Material.Neon, CanCollide = false, Parent = f })
				elseif kind == "ember" then
					part({ Name = "IsletEmber", Size = Vector3.new(w * 0.7, 0.3, 0.8), CFrame = CFrame.new(top) * CFrame.Angles(0, rng:NextNumber(0, 3), 0), Color = Color3.fromRGB(255, 120, 40), Material = Enum.Material.Neon, CanCollide = false, Parent = f })
				elseif kind == "moss" then
					for _ = 1, 4 do
						part({ Name = "IsletVine", Size = Vector3.new(0.4, rng:NextNumber(5, 10), 0.4), Position = p + Vector3.new(rng:NextNumber(-w, w) * 0.45, -4, rng:NextNumber(-w, w) * 0.45), Color = Color3.fromRGB(70, 110, 55), Material = Enum.Material.Grass, CanCollide = false, Parent = f })
					end
				elseif kind == "pine" then
					pine(top, 0.6, f, false)
				elseif kind == "bamboo" then
					for j = 0, 2 do
						local h = rng:NextNumber(10, 16)
						part({ Name = "IsletBamboo", Shape = Enum.PartType.Cylinder, Size = Vector3.new(h, 0.7, 0.7), CFrame = CFrame.new(top + Vector3.new((j - 1) * 1.6, h / 2, rng:NextNumber(-1, 1))) * CFrame.Angles(0, 0, math.rad(90 + rng:NextNumber(-6, 6))), Color = Color3.fromRGB(110, 165, 70), Material = Enum.Material.Wood, CanCollide = false, Parent = f })
					end
				elseif kind == "lotus" then
					part({ Name = "IsletLotus", Shape = Enum.PartType.Ball, Size = Vector3.new(3, 2, 3), Position = top + Vector3.new(0, 0.6, 0), Color = Color3.fromRGB(250, 200, 220), Material = Enum.Material.SmoothPlastic, CanCollide = false, Parent = f })
				elseif kind == "bell" then
					part({ Name = "IsletBellChain", Size = Vector3.new(0.3, 5, 0.3), Position = p - Vector3.new(0, w * 0.9 + 2.5, 0), Color = GOLD, Material = Enum.Material.Metal, CanCollide = false, Parent = f })
					part({ Name = "IsletBell", Shape = Enum.PartType.Cylinder, Size = Vector3.new(4, 3.4, 3.4), CFrame = CFrame.new(p - Vector3.new(0, w * 0.9 + 6.5, 0)) * CFrame.Angles(0, 0, math.rad(90)), Color = Color3.fromRGB(200, 160, 70), Material = Enum.Material.Metal, CanCollide = false, Parent = f })
				end
			end
		end
	end
	-- 섬
	for _, isl in ipairs(SKY.islands) do
		local c, R = isl.at, isl.radius
		disc("SkyIsland", c - Vector3.new(0, 3, 0), R, 6, isl.ground, isl.material, f)
		skyIslandBody(isl, f)
		-- 보이지 않는 난간 (떨어지지 않게). 다리가 이어지는 자리는 비워 둔다
		local gaps: { { number } } = {}
		for bi, b in ipairs(SKY.bridges) do
			local me = SKY.islands[b[1]] == isl and 1 or (SKY.islands[b[2]] == isl and 2 or nil)
			if me then
				local other = SKY.islands[b[me == 1 and 2 or 1]]
				local d = Vector3.new(other.at.X - c.X, 0, other.at.Z - c.Z)
				local w = b.hidden and 8 or 16
				table.insert(gaps, { math.atan2(d.Z, d.X), math.asin(math.clamp((w / 2 + 3) / R, 0, 1)) })
			end
			local _ = bi
		end
		local m = math.max(32, math.floor(R / 4))
		for k = 0, m - 1 do
			local a = k / m * math.pi * 2
			local open = false
			for _, g in ipairs(gaps) do
				local diff = math.abs((a - g[1] + math.pi) % (2 * math.pi) - math.pi)
				if diff < g[2] + math.pi / m then
					open = true
				end
			end
			if not open then
				local p = c + Vector3.new(math.cos(a) * (R + 0.5), 7, math.sin(a) * (R + 0.5))
				part({ Name = "SkyWall", Size = Vector3.new(2 * math.pi * R / m + 1, 14, 1), CFrame = CFrame.lookAt(p, Vector3.new(c.X, p.Y, c.Z)), Transparency = 1, CanCollide = true, Parent = f })
			end
		end
	end
	-- 다리 (구름 빛 돌길, 양옆에 보이지 않는 난간). 숨은 다리는 거의 투명하다
	for _, b in ipairs(SKY.bridges) do
		local A, B = SKY.islands[b[1]], SKY.islands[b[2]]
		local dir = Vector3.new(B.at.X - A.at.X, 0, B.at.Z - A.at.Z)
		local from = A.at + dir.Unit * (A.radius - 4)
		local to = B.at - dir.Unit * (B.radius - 4)
		local len = (to - from).Magnitude
		local mid = (from + to) / 2
		-- 3.1판: 높이가 다른 섬 사이 (윤회대) 는 비탈진 다리
		local cf = math.abs(to.Y - from.Y) > 0.5 and CFrame.lookAt(mid, to) or CFrame.lookAt(mid, mid + dir)
		local w = b.hidden and 8 or 16
		local deck = part({ Name = b.hidden and "HiddenBridge" or "SkyBridge", Size = Vector3.new(w, 1, len), CFrame = cf * CFrame.new(0, -0.5, 0), Color = b.hidden and Color3.fromRGB(200, 230, 255) or Color3.fromRGB(240, 238, 230), Material = b.hidden and Enum.Material.Glass or Enum.Material.Marble, Transparency = b.hidden and 0.88 or 0, Parent = f })
		local _ = deck
		for _, x in ipairs({ -1, 1 }) do
			part({ Name = "BridgeWall", Size = Vector3.new(1, 10, len), CFrame = cf * CFrame.new(x * (w / 2 + 0.5), 5, 0), Transparency = 1, CanCollide = true, Parent = f })
			if not b.hidden then
				part({ Name = "BridgeCurb", Size = Vector3.new(0.8, 1, len), CFrame = cf * CFrame.new(x * (w / 2 - 0.4), 0.5, 0), Color = GOLD, Material = Enum.Material.Metal, Parent = f })
				for k = 1, math.floor(len / 50) do
					stoneLantern((cf * CFrame.new(x * (w / 2 + 1.5), 0, -len / 2 + k * 50)).Position, f, true)
				end
			end
		end
	end
	-- 섬마다 꾸밈
	local I = Config.SKY_BY_ID
	-- 천궁 (천상계 마을): 네 갈래 큰길, 가운데 광장과 천주탑, 객잔·상점·정자·내려가는 문, 둘레의 집들
	local town = I.skytown.at
	local TR = I.skytown.radius
	local ROAD = Color3.fromRGB(250, 246, 235)
	for k = 0, 3 do
		local a = k * math.pi / 2
		local d = Vector3.new(math.cos(a), 0, math.sin(a))
		local mid = town + d * (TR / 2 + 10)
		part({ Name = "SkyRoad", Size = Vector3.new(14, 0.3, TR - 20), CFrame = CFrame.lookAt(mid, mid + d) * CFrame.new(0, 0.1, 0), Color = ROAD, Material = Enum.Material.Marble, Parent = f })
		for j = 1, 4 do
			for _, side in ipairs({ -1, 1 }) do
				local p = town + d * (30 + j * 38) + Vector3.new(-d.Z, 0, d.X) * side * 10
				stoneLantern(p, f, true)
			end
		end
	end
	disc("SkyPlaza", town + Vector3.new(0, 0.15, 0), 30, 0.3, Color3.fromRGB(245, 230, 190), Enum.Material.Marble, f)
	disc("SkyPlazaRing", town + Vector3.new(0, 0.2, 0), 31, 0.3, GOLD, Enum.Material.Metal, f)
	spire(town, 6, 8, Color3.fromRGB(150, 220, 255), f)
	crystal(town + Vector3.new(0, 70, 0), 7, Color3.fromRGB(150, 220, 255), f)
	-- 북동: 천상 객잔 (쉬면 체력·내공이 찬다)
	local innAt = town + Vector3.new(100, 0, -100)
	building(innAt, 30, 20, math.rad(135), f, { tiers = 2, sign = "천상 객잔", h = 11, wall = Color3.fromRGB(245, 240, 230), roof = Color3.fromRGB(70, 110, 170), awningColor = Color3.fromRGB(70, 110, 170) })
	local innDesk = part({ Name = "SkyInnDesk", Size = Vector3.new(6, 3.2, 3), CFrame = CFrame.lookAt(innAt, town) * CFrame.new(0, 1.6, -15), Color = Color3.fromRGB(150, 120, 90), Material = Enum.Material.Wood, Parent = f })
	out.skyInn = prompt(innDesk, "쉬기", "천상 객잔 · 체력·내공 채우기", "SkyInn")
	-- 남동: 천상 상점 (천정으로 산다)
	local shopAt = town + Vector3.new(100, 0, 100)
	building(shopAt, 26, 18, math.rad(45), f, { sign = "천상 상점", h = 11, wall = Color3.fromRGB(245, 240, 230), roof = Color3.fromRGB(150, 90, 200), awningColor = Color3.fromRGB(150, 90, 200) })
	local stall = part({ Name = "SkyShopStall", Size = Vector3.new(10, 3.4, 4), CFrame = CFrame.lookAt(shopAt, town) * CFrame.new(0, 1.7, -14), Color = Color3.fromRGB(120, 80, 160), Material = Enum.Material.Wood, Parent = f })
	part({ Name = "SkyShopGem", Size = Vector3.new(1.4, 2.2, 1.4), CFrame = CFrame.lookAt(shopAt, town) * CFrame.new(0, 4.6, -14) * CFrame.Angles(0, math.rad(45), 0), Color = Color3.fromRGB(150, 230, 255), Material = Enum.Material.Neon, CanCollide = false, Parent = f })
	out.skyShop = prompt(stall, "물건 보기", "천상 상점 (천정)", "SkyShop")
	-- 북서: 운류자의 정자 (기둥 넷과 지붕)
	local pav = Config.MASTERS.unryu.at - Vector3.new(0, Config.MASTERS.unryu.at.Y - town.Y, 0)
	part({ Name = "PavilionBase", Size = Vector3.new(22, 1.2, 22), Position = pav + Vector3.new(0, 0.6, 0), Color = STONE, Material = Enum.Material.Marble, Parent = f })
	for _, sx in ipairs({ -1, 1 }) do
		for _, sz in ipairs({ -1, 1 }) do
			part({ Name = "PavilionPost", Size = Vector3.new(1.4, 12, 1.4), Position = pav + Vector3.new(sx * 9, 7, sz * 9), Color = GATE_RED, Material = Enum.Material.Wood, Parent = f })
		end
	end
	part({ Name = "PavilionRoof", Size = Vector3.new(26, 1.2, 26), Position = pav + Vector3.new(0, 13.6, 0), Color = Color3.fromRGB(70, 110, 170), Material = Enum.Material.Slate, Parent = f })
	part({ Name = "PavilionRoof2", Size = Vector3.new(16, 1.2, 16), Position = pav + Vector3.new(0, 15, 0), Color = Color3.fromRGB(80, 125, 190), Material = Enum.Material.Slate, Parent = f })
	-- 남서: 땅으로 내려가는 문
	out.skyDown = prompt(portalGate(town + Vector3.new(-100, 0, 100), math.rad(45), Color3.fromRGB(255, 220, 140), f, "⬇ 땅으로"), "땅으로 내려가기", "천궁 문", "SkyDown")
	-- 1.7판: 광장 둘레의 세 문 (천층탑 · 구름 미궁 · 천공 투기장). 받침은 광장 쪽에
	local function plazaGate(off: Vector3, color: Color3, label: string, action: string, title: string, name: string): ProximityPrompt
		local yaw = math.atan2(off.X, off.Z)
		return prompt(portalGate(town + off, yaw, color, f, label), action, title, name)
	end
	out.towerGate = plazaGate(Vector3.new(72, 0, 34), Color3.fromRGB(255, 190, 110), "🗼 천층탑", "탑에 오르기", "천층탑 문", "TowerGate")
	out.mazeGate = plazaGate(Vector3.new(72, 0, -34), Color3.fromRGB(190, 230, 255), "🌀 구름 미궁", "미궁에 들어가기", "구름 미궁 문", "MazeGate")
	out.raidGate = plazaGate(Vector3.new(-78, 0, 30), Color3.fromRGB(255, 120, 120), "⚔ 천공 투기장", "투기장으로", "천공 투기장 문", "RaidGate")
	-- 둘레의 집들 (큰길 양옆)
	for k = 0, 3 do
		local base = k * math.pi / 2
		for _, off in ipairs({ -0.38, 0.38 }) do
			local a = base + off
			local p = town + Vector3.new(math.cos(a) * 165, 0, math.sin(a) * 165)
			local yaw = math.atan2(-(town.X - p.X), -(town.Z - p.Z))
			building(p, rng:NextNumber(18, 24), rng:NextNumber(14, 18), yaw, f, { tiers = rng:NextNumber() < 0.5 and 2 or 1, wall = Color3.fromRGB(245, 240, 230), roof = Color3.fromRGB(70, 110, 170):Lerp(Color3.fromRGB(150, 90, 200), rng:NextNumber()) })
		end
	end
	-- 바깥 네 모퉁이의 첨탑
	for k = 0, 3 do
		local a = math.pi / 4 + k * math.pi / 2
		spire(town + Vector3.new(math.cos(a) * 178, 0, math.sin(a) * 178), 4, 6, Color3.fromRGB(150, 220, 255), f)
	end
	-- 운해 평원: 구름 덤불과 정자
	local cp = I.cloudplain.at
	for _ = 1, 26 do
		local a, r = rng:NextNumber() * math.pi * 2, rng:NextNumber(30, 190)
		local size = rng:NextNumber(5, 11)
		part({ Name = "CloudBush", Shape = Enum.PartType.Ball, Size = Vector3.new(size, size, size), Position = cp + Vector3.new(math.cos(a) * r, size * 0.3, math.sin(a) * r), Color = CLOUD, Material = Enum.Material.SmoothPlastic, Transparency = 0.1, CanCollide = false, Parent = f })
	end
	for _, o in ipairs({ Vector3.new(-120, 0, 40), Vector3.new(120, 0, -20) }) do
		building(cp + o, 16, 16, rng:NextNumber() * 3, f, { wall = Color3.fromRGB(240, 235, 225), roof = Color3.fromRGB(80, 130, 180) })
	end
	-- 뇌정봉: 검은 봉우리와 푸른 번개 끝
	local th = I.thunder.at
	for k = 0, 6 do
		local a = k / 7 * math.pi * 2
		spire(th + Vector3.new(math.cos(a) * 120, 0, math.sin(a) * 120), 5, 6, Color3.fromRGB(120, 170, 255), f)
	end
	disc("ThunderArena", th + Vector3.new(100, 0.15, 0), 40, 0.3, Color3.fromRGB(110, 150, 255), Enum.Material.Neon, f, false).Transparency = 0.6
	-- 성운원: 보랏빛 수정 무리와 떠 있는 빛 구슬
	local nb = I.nebula.at
	for _ = 1, 18 do
		local a, r = rng:NextNumber() * math.pi * 2, rng:NextNumber(20, 170)
		crystal(nb + Vector3.new(math.cos(a) * r, rng:NextNumber(3, 14), math.sin(a) * r), rng:NextNumber(2, 5), Color3.fromRGB(200, 140, 255):Lerp(Color3.fromRGB(120, 220, 255), rng:NextNumber()), f)
	end
	-- 옥좌대: 금빛 계단과 옥좌, 기둥 둘레
	local tr = I.throne.at
	for k = 1, 5 do
		part({ Name = "ThroneStep", Size = Vector3.new(60 - k * 6, k * 1.2, 14), Position = tr + Vector3.new(0, k * 0.6, -110 + k * 3), Color = Color3.fromRGB(245, 230, 190), Material = Enum.Material.Marble, Parent = f })
	end
	part({ Name = "Throne", Size = Vector3.new(10, 14, 6), Position = tr + Vector3.new(0, 13, -112), Color = GOLD, Material = Enum.Material.Metal, Parent = f })
	for k = 0, 9 do
		local a = k / 10 * math.pi * 2
		local p = tr + Vector3.new(math.cos(a) * 130, 0, math.sin(a) * 130)
		part({ Name = "ThronePillar", Size = Vector3.new(5, 34, 5), Position = p + Vector3.new(0, 17, 0), Color = Color3.fromRGB(250, 245, 235), Material = Enum.Material.Marble, Parent = f })
		brazier(p + Vector3.new(0, 34, 0), 1.2, f)
	end
	-- 금 간 허공: 검은 유리 섬, 빛나는 금, 떠 있는 정육면체
	local sb = I.subspace.at
	for k = 0, 7 do
		local a = k / 8 * math.pi * 2
		part({ Name = "SpaceCrack", Size = Vector3.new(0.4, 0.2, rng:NextNumber(20, 40)), CFrame = CFrame.new(sb + Vector3.new(0, 0.12, 0)) * CFrame.Angles(0, a, 0) * CFrame.new(0, 0, -18), Color = Color3.fromRGB(140, 255, 230), Material = Enum.Material.Neon, CanCollide = false, Parent = f })
	end
	for _ = 1, 10 do
		local size = rng:NextNumber(1.5, 4)
		part({ Name = "SpaceCube", Size = Vector3.new(size, size, size), CFrame = CFrame.new(sb + Vector3.new(rng:NextNumber(-40, 40), rng:NextNumber(6, 22), rng:NextNumber(-40, 40))) * CFrame.Angles(rng:NextNumber() * 6, rng:NextNumber() * 6, 0), Color = Color3.fromRGB(70, 30, 140), Material = Enum.Material.Glass, Transparency = 0.3, CanCollide = false, Parent = f })
	end
	-- 1.7판 빙정궁: 얼음 첨탑과 수정 숲, 얼어붙은 궁 (빙제의 자리 앞엔 얼음 단)
	local fr = I.frost.at
	local ICE = Color3.fromRGB(170, 225, 255)
	for k = 0, 5 do
		local a = k / 6 * math.pi * 2 + 0.3
		spire(fr + Vector3.new(math.cos(a) * 135, 0, math.sin(a) * 135), 4, 5, ICE, f)
	end
	for _ = 1, 22 do
		local a, r = rng:NextNumber() * math.pi * 2, rng:NextNumber(30, 165)
		local h = rng:NextNumber(6, 18)
		part({ Name = "IceShard", Size = Vector3.new(h * 0.35, h, h * 0.35), CFrame = CFrame.new(fr + Vector3.new(math.cos(a) * r, h * 0.4, math.sin(a) * r)) * CFrame.Angles(rng:NextNumber(-0.3, 0.3), rng:NextNumber() * 6, rng:NextNumber(-0.3, 0.3)), Color = ICE:Lerp(Color3.new(1, 1, 1), rng:NextNumber() * 0.5), Material = Enum.Material.Ice, Transparency = 0.15, Parent = f })
	end
	building(fr + Vector3.new(-40, 0, 40), 34, 24, math.rad(225), f, { tiers = 2, sign = "빙정궁", h = 12, wall = Color3.fromRGB(225, 240, 255), roof = Color3.fromRGB(120, 180, 230) })
	disc("FrostDais", fr + Vector3.new(80, 0.4, -50), 26, 0.8, Color3.fromRGB(200, 235, 255), Enum.Material.Ice, f)
	for k = 0, 7 do
		local a = k / 8 * math.pi * 2
		crystal(fr + Vector3.new(80 + math.cos(a) * 24, 8, -50 + math.sin(a) * 24), 3, ICE, f)
	end
	-- 봉황대: 검붉은 현무암, 용암 갈라짐, 불꽃 화로, 가운데 날개 편 봉황 석상
	local ph = I.phoenix.at
	local EMBER = Color3.fromRGB(255, 120, 40)
	for k = 0, 11 do
		local a = k / 12 * math.pi * 2
		part({ Name = "LavaCrack", Size = Vector3.new(1.2, 0.2, rng:NextNumber(30, 70)), CFrame = CFrame.new(ph + Vector3.new(0, 0.12, 0)) * CFrame.Angles(0, a, 0) * CFrame.new(0, 0, -rng:NextNumber(40, 90)), Color = EMBER, Material = Enum.Material.Neon, CanCollide = false, Parent = f })
	end
	for k = 0, 7 do
		local a = k / 8 * math.pi * 2
		local p = ph + Vector3.new(math.cos(a) * 140, 0, math.sin(a) * 140)
		part({ Name = "PhoenixPillar", Size = Vector3.new(5, 26, 5), Position = p + Vector3.new(0, 13, 0), Color = Color3.fromRGB(90, 30, 20), Material = Enum.Material.Basalt, Parent = f })
		brazier(p + Vector3.new(0, 26, 0), 1.3, f)
	end
	-- 봉황 석상: 몸통, 목과 머리, 활짝 편 두 날개(깃털 판), 길게 늘어진 꼬리깃
	local st = ph + Vector3.new(0, 0, 40)
	part({ Name = "PhoenixPlinth", Size = Vector3.new(16, 4, 16), Position = st + Vector3.new(0, 2, 0), Color = Color3.fromRGB(70, 25, 18), Material = Enum.Material.Basalt, Parent = f })
	part({ Name = "PhoenixBody", Shape = Enum.PartType.Ball, Size = Vector3.new(8, 8, 8), Position = st + Vector3.new(0, 10, 0), Color = GOLD, Material = Enum.Material.Metal, Parent = f })
	part({ Name = "PhoenixNeck", Size = Vector3.new(2.4, 7, 2.4), CFrame = CFrame.new(st + Vector3.new(0, 15, 2)) * CFrame.Angles(math.rad(-20), 0, 0), Color = GOLD, Material = Enum.Material.Metal, Parent = f })
	part({ Name = "PhoenixHead", Shape = Enum.PartType.Ball, Size = Vector3.new(3.4, 3.4, 3.4), Position = st + Vector3.new(0, 19, 3.4), Color = GOLD, Material = Enum.Material.Metal, Parent = f })
	for _, sx in ipairs({ -1, 1 }) do
		for k = 0, 5 do
			local len = 14 - k * 1.4
			part({ Name = "PhoenixFeather", Size = Vector3.new(len, 0.6, 2.4), CFrame = CFrame.new(st + Vector3.new(sx * 4, 12, 0)) * CFrame.Angles(0, 0, sx * math.rad(20 + k * 13)) * CFrame.new(sx * len / 2, 0, -k * 0.3), Color = k % 2 == 0 and EMBER or GOLD, Material = Enum.Material.Neon, CanCollide = false, Parent = f })
		end
	end
	for k = 0, 4 do
		part({ Name = "PhoenixTail", Size = Vector3.new(1.4, 0.5, 18), CFrame = CFrame.new(st + Vector3.new(0, 7, -4)) * CFrame.Angles(math.rad(25), math.rad(-30 + k * 15), 0) * CFrame.new(0, 0, -9), Color = k % 2 == 0 and EMBER or GOLD, Material = Enum.Material.Neon, CanCollide = false, Parent = f })
	end
	light(part({ Name = "PhoenixGlow", Size = Vector3.new(1, 1, 1), Position = st + Vector3.new(0, 14, 0), Transparency = 1, CanCollide = false, Parent = f }), EMBER, 60, 3)
	-- 천공 투기장: 둥근 결투장과 계단식 관람석, 네 기둥과 큰 징
	local ra = I.raidarena.at
	disc("RaidFloor", ra + Vector3.new(0, 0.2, 0), 100, 0.4, Color3.fromRGB(180, 170, 155), Enum.Material.Slate, f)
	disc("RaidRing", ra + Vector3.new(0, 0.3, 0), 70, 0.4, Color3.fromRGB(150, 40, 45), Enum.Material.Fabric, f, false)
	disc("RaidCore", ra + Vector3.new(0, 0.35, 0), 66, 0.4, Color3.fromRGB(195, 185, 170), Enum.Material.Slate, f, false)
	for tier = 1, 3 do
		local r = 110 + tier * 9
		local n = 40
		for k = 0, n - 1 do
			local a = k / n * math.pi * 2
			-- 다리 쪽 (남동: 성운원으로) 은 비운다
			local toBridge = math.atan2(I.nebula.at.Z - ra.Z, I.nebula.at.X - ra.X)
			if math.abs((a - toBridge + math.pi) % (2 * math.pi) - math.pi) > 0.22 then
				local p = ra + Vector3.new(math.cos(a) * r, tier * 1.5, math.sin(a) * r)
				part({ Name = "RaidSeat", Size = Vector3.new(2 * math.pi * r / n + 0.3, tier * 3, 8), CFrame = CFrame.lookAt(p, Vector3.new(ra.X, p.Y, ra.Z)), Color = STONE:Lerp(Color3.fromRGB(120, 110, 100), tier * 0.15), Material = Enum.Material.Marble, Parent = f })
			end
		end
	end
	for k = 0, 3 do
		local a = math.pi / 4 + k * math.pi / 2
		local p = ra + Vector3.new(math.cos(a) * 92, 0, math.sin(a) * 92)
		part({ Name = "RaidPillar", Size = Vector3.new(6, 40, 6), Position = p + Vector3.new(0, 20, 0), Color = GATE_RED, Material = Enum.Material.Wood, Parent = f })
		brazier(p + Vector3.new(0, 40, 0), 1.6, f)
	end
	local gong = part({ Name = "RaidGong", Shape = Enum.PartType.Cylinder, Size = Vector3.new(1.2, 14, 14), CFrame = CFrame.new(ra + Vector3.new(0, 14, -104)) * CFrame.Angles(0, math.rad(90), 0), Color = GOLD, Material = Enum.Material.Metal, Parent = f })
	local _ = gong
	part({ Name = "RaidGongFrame", Size = Vector3.new(20, 1.4, 1.4), Position = ra + Vector3.new(0, 22, -104), Color = GATE_RED, Material = Enum.Material.Wood, Parent = f })
	for _, sx in ipairs({ -1, 1 }) do
		part({ Name = "RaidGongPost", Size = Vector3.new(1.4, 22, 1.4), Position = ra + Vector3.new(sx * 9.5, 11, -104), Color = GATE_RED, Material = Enum.Material.Wood, Parent = f })
	end
	-- 1.8판 비천폭: 섬 한가운데 바위산에서 쏟아지는 폭포가 섬 끝을 넘어 구름 아래로 떨어진다
	local fa = I.falls.at
	local cliff = fa + Vector3.new(0, 0, -60)
	for i = 1, 4 do
		part({ Name = "FallsCliff", Size = Vector3.new(70 - i * 12, 14, 40 - i * 6), CFrame = CFrame.new(cliff + Vector3.new(0, i * 13 - 6, 0)) * CFrame.Angles(0, rng:NextNumber(-0.2, 0.2), 0), Color = Color3.fromRGB(110, 120, 110), Material = Enum.Material.Rock, Parent = f })
	end
	local WATER = Color3.fromRGB(150, 210, 255)
	local fallTop = cliff + Vector3.new(0, 52, 16)
	local sheet = part({ Name = "Waterfall", Size = Vector3.new(16, 52, 2), Position = fallTop - Vector3.new(0, 26, 0), Color = WATER, Material = Enum.Material.Glass, Transparency = 0.25, CanCollide = false, Parent = f })
	local foam = Instance.new("ParticleEmitter")
	foam.Texture = "rbxasset://textures/particles/sparkles_main.dds"
	foam.Color = ColorSequence.new(Color3.fromRGB(235, 248, 255), WATER)
	foam.Size = NumberSequence.new(1.2, 0.4)
	foam.Lifetime = NumberRange.new(0.8, 1.2)
	foam.Rate = 60
	foam.Speed = NumberRange.new(20, 30)
	foam.EmissionDirection = Enum.NormalId.Bottom
	foam.SpreadAngle = Vector2.new(8, 8)
	foam.Shape = Enum.ParticleEmitterShape.Box
	foam.LightEmission = 0.4
	foam.Parent = sheet
	-- 폭포가 흘러 섬 끝까지 이어지는 물길과, 섬 끝에서 아래로 떨어지는 긴 물줄기
	local edge = fa + Vector3.new(0, 0, -I.falls.radius + 2)
	part({ Name = "FallsStream", Size = Vector3.new(14, 0.4, (cliff - edge).Magnitude), Position = (cliff + edge) / 2 + Vector3.new(0, 0.25, 8), Color = WATER, Material = Enum.Material.Glass, Transparency = 0.2, CanCollide = false, Parent = f })
	part({ Name = "FallsDrop", Size = Vector3.new(14, 160, 2), Position = edge + Vector3.new(0, -80, -2), Color = WATER, Material = Enum.Material.Glass, Transparency = 0.3, CanCollide = false, Parent = f })
	disc("FallsPool", cliff + Vector3.new(0, 0.3, 30), 22, 0.4, WATER, Enum.Material.Glass, f, false).Transparency = 0.2
	for _ = 1, 16 do
		local a, rr = rng:NextNumber() * math.pi * 2, rng:NextNumber(40, 150)
		tree(fa + Vector3.new(math.cos(a) * rr, 0, math.sin(a) * rr), rng:NextNumber(0.8, 1.3), f)
	end
	-- 청학봉: 흰 대리석 단과 학 둥지, 날개를 편 흰 학 석상 넷, 높은 소나무
	local cr = I.crane.at
	for i = 1, 3 do
		disc("CraneTier", cr + Vector3.new(0, i * 1.2 - 0.6, 60), 40 - i * 9, 1.2, Color3.fromRGB(245, 245, 240), Enum.Material.Marble, f)
	end
	for k = 0, 3 do
		local a = k / 4 * math.pi * 2 + math.pi / 4
		local base = cr + Vector3.new(math.cos(a) * 120, 0, math.sin(a) * 120)
		part({ Name = "CranePlinth", Size = Vector3.new(8, 4, 8), Position = base + Vector3.new(0, 2, 0), Color = STONE, Material = Enum.Material.Marble, Parent = f })
		part({ Name = "CraneBody", Shape = Enum.PartType.Ball, Size = Vector3.new(5, 4, 7), Position = base + Vector3.new(0, 8, 0), Color = Color3.fromRGB(250, 250, 250), Material = Enum.Material.Marble, Parent = f })
		part({ Name = "CraneNeck", Size = Vector3.new(0.8, 6, 0.8), CFrame = CFrame.new(base + Vector3.new(0, 12, -2.5)) * CFrame.Angles(math.rad(-15), 0, 0), Color = Color3.fromRGB(250, 250, 250), Material = Enum.Material.Marble, Parent = f })
		part({ Name = "CraneCrest", Shape = Enum.PartType.Ball, Size = Vector3.new(1.4, 1.4, 1.4), Position = base + Vector3.new(0, 15.2, -3.4), Color = Color3.fromRGB(220, 30, 40), Material = Enum.Material.SmoothPlastic, Parent = f })
		for _, sx in ipairs({ -1, 1 }) do
			part({ Name = "CraneWing", Size = Vector3.new(10, 0.5, 4), CFrame = CFrame.new(base + Vector3.new(sx * 6, 10, 0)) * CFrame.Angles(0, 0, sx * math.rad(25)), Color = Color3.fromRGB(245, 245, 245), Material = Enum.Material.Marble, Parent = f })
			part({ Name = "CraneWingTip", Size = Vector3.new(3, 0.55, 4.2), CFrame = CFrame.new(base + Vector3.new(sx * 11.5, 12.6, 0)) * CFrame.Angles(0, 0, sx * math.rad(25)), Color = Color3.fromRGB(30, 30, 35), Material = Enum.Material.SmoothPlastic, Parent = f })
		end
	end
	for _ = 1, 18 do
		local a, rr = rng:NextNumber() * math.pi * 2, rng:NextNumber(50, 165)
		pine(cr + Vector3.new(math.cos(a) * rr, 0, math.sin(a) * rr), rng:NextNumber(1.2, 2), f, false)
	end

	-- 2.7판 운무 죽림: 구름 속 대숲. 마디 있는 대나무 무리, 가운데를 지나는 돌길, 대나무 정자, 낮게 깔린 안개
	local bb = I.bamboo.at
	local BAMBOO_C = Color3.fromRGB(104, 160, 64)
	local function bambooStalk(p0: Vector3, h: number, d: number, lean: number, yaw: number)
		local cf = CFrame.new(p0) * CFrame.Angles(0, yaw, 0) * CFrame.Angles(lean, 0, 0)
		part({ Name = "Bamboo", Shape = Enum.PartType.Cylinder, Size = Vector3.new(h, d, d), CFrame = cf * CFrame.new(0, h / 2, 0) * CFrame.Angles(0, 0, math.rad(90)), Color = BAMBOO_C:Lerp(Color3.fromRGB(140, 184, 80), rng:NextNumber()), Material = Enum.Material.SmoothPlastic, CanCollide = false, Parent = f })
		for k = 1, math.floor(h / 4) do
			part({ Name = "BambooNode", Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.25, d * 1.15, d * 1.15), CFrame = cf * CFrame.new(0, k * 4, 0) * CFrame.Angles(0, 0, math.rad(90)), Color = Color3.fromRGB(176, 196, 112), Material = Enum.Material.SmoothPlastic, CanCollide = false, Parent = f })
		end
		for k = 0, 2 do
			local a = k * 2.1 + yaw
			part({ Name = "BambooLeaves", Shape = Enum.PartType.Ball, Size = Vector3.new(5, 1.6, 3), CFrame = cf * CFrame.new(math.cos(a) * 2, h - 1 - k * 1.5, math.sin(a) * 2) * CFrame.Angles(0, -a, math.rad(-15)), Color = Color3.fromRGB(80, 140, 58):Lerp(Color3.fromRGB(120, 176, 80), rng:NextNumber()), Material = Enum.Material.Grass, CanCollide = false, Parent = f })
		end
	end
	-- 돌길: 다리에서 가운데로, 가운데에서 서쪽 정자로
	local toCrane = (I.crane.at - bb) * Vector3.new(1, 0, 1)
	toCrane = toCrane.Unit
	for k = 0, 16 do
		local p = bb + toCrane * (170 - k * 10)
		part({ Name = "BambooPath", Size = Vector3.new(7, 0.3, 5), CFrame = CFrame.lookAt(p, p + toCrane) * CFrame.new(rng:NextNumber(-0.6, 0.6), 0.1, 0) * CFrame.Angles(0, rng:NextNumber(-0.1, 0.1), 0), Color = Color3.fromRGB(150, 150, 140), Material = Enum.Material.Slate, Parent = f })
	end
	for _ = 1, 46 do
		local a, rr = rng:NextNumber() * math.pi * 2, rng:NextNumber(36, 168)
		local p = bb + Vector3.new(math.cos(a) * rr, 0, math.sin(a) * rr)
		-- 길과 가운데 빈터는 비워 둔다
		local along = (p - bb):Dot(toCrane)
		local off = ((p - bb) - toCrane * along).Magnitude
		if not (along > 0 and off < 10) then
			for _ = 1, rng:NextInteger(3, 6) do
				bambooStalk(p + Vector3.new(rng:NextNumber(-3, 3), 0, rng:NextNumber(-3, 3)), rng:NextNumber(18, 32), rng:NextNumber(0.8, 1.3), rng:NextNumber(-0.08, 0.08), rng:NextNumber(0, 6))
			end
		end
	end
	-- 대나무 정자 (가운데 서쪽)
	local pv = bb + Vector3.new(-70, 0, 0)
	part({ Name = "BambooDeck", Size = Vector3.new(20, 1, 20), Position = pv + Vector3.new(0, 0.5, 0), Color = Color3.fromRGB(170, 150, 100), Material = Enum.Material.Wood, Parent = f })
	for _, sx in ipairs({ -1, 1 }) do
		for _, sz in ipairs({ -1, 1 }) do
			part({ Name = "BambooPost", Shape = Enum.PartType.Cylinder, Size = Vector3.new(11, 1.1, 1.1), CFrame = CFrame.new(pv + Vector3.new(sx * 8.5, 6.5, sz * 8.5)) * CFrame.Angles(0, 0, math.rad(90)), Color = BAMBOO_C, Material = Enum.Material.SmoothPlastic, Parent = f })
		end
	end
	part({ Name = "BambooRoof", Size = Vector3.new(24, 1.2, 24), Position = pv + Vector3.new(0, 12.4, 0), Color = Color3.fromRGB(180, 160, 100), Material = Enum.Material.Fabric, Parent = f })
	part({ Name = "BambooRoof2", Size = Vector3.new(14, 1.2, 14), Position = pv + Vector3.new(0, 13.8, 0), Color = Color3.fromRGB(160, 140, 90), Material = Enum.Material.Fabric, Parent = f })
	for k = 0, 9 do
		local a = k / 10 * math.pi * 2
		local p = bb + Vector3.new(math.cos(a) * rng:NextNumber(40, 150), 1.2, math.sin(a) * rng:NextNumber(40, 150))
		part({ Name = "BambooMist", Shape = Enum.PartType.Ball, Size = Vector3.new(rng:NextNumber(30, 50), 3, rng:NextNumber(30, 50)), Position = p, Color = Color3.fromRGB(245, 248, 250), Material = Enum.Material.SmoothPlastic, Transparency = 0.6, CanCollide = false, Parent = f })
	end

	-- 2.7판 월광 호수: 섬 북쪽의 넓은 호수, 호수에 비친 달, 한가운데 작은 섬의 흰 팔각정과 그리로 가는 돌다리, 연잎과 연꽃, 하늘의 큰 달
	local ml = I.moonlake.at
	local lakeC = ml + Vector3.new(0, 0, 30)
	disc("MoonLake", lakeC + Vector3.new(0, 0.3, 0), 95, 0.3, Color3.fromRGB(70, 110, 170), Enum.Material.Glass, f, false).Transparency = 0.15
	disc("MoonLakeEdge", lakeC + Vector3.new(0, 0.2, 0), 99, 0.3, Color3.fromRGB(220, 226, 236), Enum.Material.Marble, f, false)
	disc("MoonReflect", lakeC + Vector3.new(20, 0.5, 30), 14, 0.1, Color3.fromRGB(235, 242, 255), Enum.Material.Neon, f, false).Transparency = 0.35
	disc("MoonIsle", lakeC + Vector3.new(0, 0.6, 0), 22, 1.2, Color3.fromRGB(226, 230, 240), Enum.Material.Marble, f)
	-- 팔각정
	for k = 0, 7 do
		local a = k / 8 * math.pi * 2
		part({ Name = "MoonPavilionPost", Size = Vector3.new(1.2, 12, 1.2), Position = lakeC + Vector3.new(math.cos(a) * 12, 7.2, math.sin(a) * 12), Color = Color3.fromRGB(240, 242, 248), Material = Enum.Material.Marble, Parent = f })
	end
	disc("MoonPavilionRoof", lakeC + Vector3.new(0, 13.6, 0), 16, 1.2, Color3.fromRGB(70, 90, 140), Enum.Material.Slate, f)
	disc("MoonPavilionRoof2", lakeC + Vector3.new(0, 15, 0), 10, 1.2, Color3.fromRGB(80, 100, 155), Enum.Material.Slate, f)
	part({ Name = "MoonPavilionTop", Shape = Enum.PartType.Ball, Size = Vector3.new(2.4, 2.4, 2.4), Position = lakeC + Vector3.new(0, 16.5, 0), Color = Color3.fromRGB(230, 236, 255), Material = Enum.Material.Glass, Parent = f })
	-- 돌다리 (남쪽 물가에서 섬으로)
	for k = 0, 9 do
		part({ Name = "MoonBridge", Size = Vector3.new(6, 1, 8.4), Position = lakeC + Vector3.new(0, 0.8 + math.sin(k / 9 * math.pi) * 1.5, -96 + 22 + k * 7.4), Color = Color3.fromRGB(220, 224, 232), Material = Enum.Material.Marble, Parent = f })
	end
	-- 연잎과 연꽃
	for _ = 1, 30 do
		local a, rr = rng:NextNumber() * math.pi * 2, rng:NextNumber(28, 88)
		local p = lakeC + Vector3.new(math.cos(a) * rr, 0.5, math.sin(a) * rr)
		disc("LotusLeaf", p, rng:NextNumber(1.6, 3.2), 0.2, Color3.fromRGB(70, 130, 70), Enum.Material.SmoothPlastic, f, false)
		if rng:NextNumber() < 0.4 then
			part({ Name = "LotusFlower", Shape = Enum.PartType.Ball, Size = Vector3.new(1.4, 1.0, 1.4), Position = p + Vector3.new(0.5, 0.5, 0), Color = Color3.fromRGB(250, 200, 220), Material = Enum.Material.SmoothPlastic, CanCollide = false, Parent = f })
		end
	end
	for k = 0, 11 do
		local a = k / 12 * math.pi * 2
		stoneLantern(lakeC + Vector3.new(math.cos(a) * 104, 0, math.sin(a) * 104) - Vector3.new(0, 0, 0), f, true)
	end
	local moon = part({ Name = "SkyMoon", Shape = Enum.PartType.Ball, Size = Vector3.new(40, 40, 40), Position = lakeC + Vector3.new(60, 140, 120), Color = Color3.fromRGB(240, 244, 255), Material = Enum.Material.Neon, CanCollide = false, Parent = f })
	moon.Transparency = 0.1
	light(moon, Color3.fromRGB(200, 215, 255), 60, 1.2)

	-- 2.7판 금운사: 금빛 다섯 층 탑, 넓은 돌계단, 사자 석상 둘, 큰 종이 걸린 종각, 향로
	local gt = I.goldtemple.at
	local GOLDEN = Color3.fromRGB(232, 190, 90)
	local RED_WOOD = Color3.fromRGB(150, 50, 36)
	local pagoda = gt + Vector3.new(0, 0, -150)
	disc("TempleBase", pagoda + Vector3.new(0, 1, 0), 34, 2, Color3.fromRGB(236, 226, 200), Enum.Material.Marble, f)
	for i = 0, 4 do
		local w = 30 - i * 5
		local y = 2 + i * 11
		part({ Name = "PagodaFloor", Size = Vector3.new(w, 9, w), Position = pagoda + Vector3.new(0, y + 4.5, 0), Color = RED_WOOD, Material = Enum.Material.Wood, Parent = f })
		part({ Name = "PagodaRoof", Size = Vector3.new(w + 8, 1.6, w + 8), Position = pagoda + Vector3.new(0, y + 9.8, 0), Color = GOLDEN, Material = Enum.Material.Metal, Parent = f })
		for _, cx in ipairs({ -1, 1 }) do
			for _, cz in ipairs({ -1, 1 }) do
				part({ Name = "PagodaEave", Size = Vector3.new(3, 1.2, 3), CFrame = CFrame.new(pagoda + Vector3.new(cx * (w / 2 + 4), y + 10.6, cz * (w / 2 + 4))) * CFrame.Angles(cz * math.rad(18), 0, -cx * math.rad(18)), Color = GOLDEN, Material = Enum.Material.Metal, Parent = f })
			end
		end
	end
	local spireTop = part({ Name = "PagodaSpire", Size = Vector3.new(1.6, 14, 1.6), Position = pagoda + Vector3.new(0, 64, 0), Color = GOLDEN, Material = Enum.Material.Metal, Parent = f })
	local _ = spireTop
	local jewel = part({ Name = "PagodaJewel", Shape = Enum.PartType.Ball, Size = Vector3.new(3.4, 3.4, 3.4), Position = pagoda + Vector3.new(0, 72, 0), Color = Color3.fromRGB(255, 230, 150), Material = Enum.Material.Neon, CanCollide = false, Parent = f })
	light(jewel, Color3.fromRGB(255, 220, 140), 40, 1.6)
	-- 계단 (남쪽 다리에서 탑 쪽으로)
	for k = 0, 7 do
		part({ Name = "TempleStep", Size = Vector3.new(30, 1, 4), Position = gt + Vector3.new(0, 0.5 + k * 0.6, 40 - k * 4), Color = Color3.fromRGB(230, 222, 200), Material = Enum.Material.Marble, Parent = f })
	end
	-- 사자 석상 둘 (계단 양옆)
	for _, sx in ipairs({ -1, 1 }) do
		local base = gt + Vector3.new(sx * 22, 0, 44)
		part({ Name = "LionPlinth", Size = Vector3.new(7, 4, 9), Position = base + Vector3.new(0, 2, 0), Color = Color3.fromRGB(200, 190, 170), Material = Enum.Material.Granite, Parent = f })
		part({ Name = "LionBody", Size = Vector3.new(4.5, 4, 7), Position = base + Vector3.new(0, 6, 0.5), Color = GOLDEN, Material = Enum.Material.Metal, Parent = f })
		part({ Name = "LionHead", Shape = Enum.PartType.Ball, Size = Vector3.new(4.5, 4.5, 4.5), Position = base + Vector3.new(0, 9.4, -2.6), Color = GOLDEN, Material = Enum.Material.Metal, Parent = f })
		part({ Name = "LionMane", Shape = Enum.PartType.Ball, Size = Vector3.new(6, 6, 3.5), Position = base + Vector3.new(0, 9.4, -1.6), Color = Color3.fromRGB(200, 150, 60), Material = Enum.Material.Metal, Parent = f })
		part({ Name = "LionPaw", Shape = Enum.PartType.Ball, Size = Vector3.new(2, 1.6, 2), Position = base + Vector3.new(sx * -1.2, 4.6, -3.4), Color = GOLDEN, Material = Enum.Material.Metal, Parent = f })
	end
	-- 종각과 큰 종
	local bell = gt + Vector3.new(90, 0, -40)
	for _, sx in ipairs({ -1, 1 }) do
		for _, sz in ipairs({ -1, 1 }) do
			part({ Name = "BellPost", Size = Vector3.new(1.4, 16, 1.4), Position = bell + Vector3.new(sx * 7, 8, sz * 7), Color = RED_WOOD, Material = Enum.Material.Wood, Parent = f })
		end
	end
	part({ Name = "BellRoof", Size = Vector3.new(20, 1.4, 20), Position = bell + Vector3.new(0, 16.6, 0), Color = GOLDEN, Material = Enum.Material.Metal, Parent = f })
	part({ Name = "TempleBell", Shape = Enum.PartType.Cylinder, Size = Vector3.new(7, 6, 6), CFrame = CFrame.new(bell + Vector3.new(0, 11, 0)) * CFrame.Angles(0, 0, math.rad(90)), Color = Color3.fromRGB(140, 110, 70), Material = Enum.Material.Metal, Parent = f })
	part({ Name = "BellLip", Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.6, 6.6, 6.6), CFrame = CFrame.new(bell + Vector3.new(0, 7.6, 0)) * CFrame.Angles(0, 0, math.rad(90)), Color = Color3.fromRGB(160, 130, 80), Material = Enum.Material.Metal, Parent = f })
	-- 향로 (가운데)
	part({ Name = "Censer", Shape = Enum.PartType.Ball, Size = Vector3.new(5, 4, 5), Position = gt + Vector3.new(0, 3, -10), Color = Color3.fromRGB(150, 120, 70), Material = Enum.Material.Metal, Parent = f })
	part({ Name = "CenserLeg", Size = Vector3.new(4, 2, 4), Position = gt + Vector3.new(0, 1, -10), Color = Color3.fromRGB(120, 95, 60), Material = Enum.Material.Metal, Parent = f })
	local smoke = part({ Name = "CenserGlow", Shape = Enum.PartType.Ball, Size = Vector3.new(1.4, 1.4, 1.4), Position = gt + Vector3.new(0, 5.4, -10), Color = Color3.fromRGB(255, 200, 120), Material = Enum.Material.Neon, CanCollide = false, Parent = f })
	light(smoke, Color3.fromRGB(255, 200, 120), 20, 1)

	-- 3.1판 윤회대: 가운데 환생 제단 (세 겹 단, 금테, 여섯 빛깔 기둥), 뒤편 (서쪽) 의 거대한 윤회륜, 둘레를 도는 구름 소용돌이
	-- 윤회륜과 구름 소용돌이는 화면이 천천히 돌린다 (RinneWheel · RinneVortex)
	local rd = I.rinnedae.at
	local RINGOLD = Color3.fromRGB(255, 214, 110)
	local INDIGO = Color3.fromRGB(120, 90, 255)
	for i = 1, 3 do
		disc("RinneAltarTier", rd + Vector3.new(0, i * 1.2 - 0.6, 0), 34 - i * 8, 1.2, Color3.fromRGB(240, 236, 250), Enum.Material.Marble, f)
		disc("RinneAltarTrim", rd + Vector3.new(0, i * 1.2 - 1.15, 0), 34 - i * 8 + 0.6, 0.3, RINGOLD, Enum.Material.Metal, f, false)
	end
	local altarTop = rd + Vector3.new(0, 3.6, 0)
	local seal = disc("RinneSeal", altarTop + Vector3.new(0, 0.05, 0), 8, 0.2, INDIGO, Enum.Material.Neon, f, false)
	seal.Transparency = 0.35
	local altar = part({ Name = "RinneAltar", Size = Vector3.new(4, 3, 4), CFrame = CFrame.new(altarTop + Vector3.new(0, 1.5, 0)) * CFrame.Angles(0, math.rad(45), 0), Color = Color3.fromRGB(235, 230, 248), Material = Enum.Material.Marble, Parent = f })
	local orb = part({ Name = "RinneOrb", Shape = Enum.PartType.Ball, Size = Vector3.new(2.4, 2.4, 2.4), Position = altarTop + Vector3.new(0, 4.4, 0), Color = Color3.fromRGB(200, 180, 255), Material = Enum.Material.Neon, CanCollide = false, Parent = f })
	light(orb, Color3.fromRGB(190, 160, 255), 30, 1.5)
	out.rinneAltar = prompt(altar, "환생하기 (길게 누르기)", "윤회대 · 환생 제단", "RinneAltar")
	out.rinneAltar.HoldDuration = 2
	-- 여섯 갈래 세상의 기둥
	local REALM_C = { Color3.fromRGB(255, 255, 255), Color3.fromRGB(255, 214, 90), Color3.fromRGB(255, 80, 80), Color3.fromRGB(110, 230, 140), Color3.fromRGB(110, 170, 255), Color3.fromRGB(200, 120, 255) }
	for k = 1, 6 do
		local a = (k - 1) / 6 * math.pi * 2 + math.pi / 6
		local p = rd + Vector3.new(math.cos(a) * 48, 0, math.sin(a) * 48)
		part({ Name = "RinnePillar", Size = Vector3.new(4, 22, 4), Position = p + Vector3.new(0, 11, 0), Color = Color3.fromRGB(240, 236, 250), Material = Enum.Material.Marble, Parent = f })
		part({ Name = "RinnePillarBand", Size = Vector3.new(4.4, 1, 4.4), Position = p + Vector3.new(0, 20, 0), Color = RINGOLD, Material = Enum.Material.Metal, Parent = f })
		local gem = part({ Name = "RinnePillarGem", Shape = Enum.PartType.Ball, Size = Vector3.new(3, 3, 3), Position = p + Vector3.new(0, 24, 0), Color = REALM_C[k], Material = Enum.Material.Neon, CanCollide = false, Parent = f })
		light(gem, REALM_C[k], 16, 1)
	end
	-- 거대한 윤회륜 (서쪽, 세워져서 제단을 바라본다): 금 테 두 겹, 바퀴살 여덟, 굴대, 여섯 구슬
	local wf = Instance.new("Folder")
	wf.Name = "RinneWheel"
	wf.Parent = f
	local wc = rd + Vector3.new(-86, 34, 0)
	local hub = part({ Name = "RinneHub", Shape = Enum.PartType.Cylinder, Size = Vector3.new(3, 7, 7), CFrame = CFrame.new(wc), Color = RINGOLD, Material = Enum.Material.Metal, CanCollide = false, Parent = wf })
	local R = 26
	local function onWheel(name: string, size: Vector3, local_: CFrame, color: Color3, mat: Enum.Material, shape: Enum.PartType?)
		local p = part({ Name = name, Size = size, CFrame = CFrame.new(wc) * CFrame.Angles(0, math.rad(90), 0) * local_, Color = color, Material = mat, CanCollide = false, Parent = wf })
		if shape then
			p.Shape = shape
		end
		return p
	end
	local n = 40
	for i = 0, n - 1 do
		local a = (i + 0.5) / n * math.pi * 2
		onWheel("RinneRim", Vector3.new(2 * math.pi * R / n * 1.1, 2.2, 2), CFrame.Angles(0, 0, a) * CFrame.new(0, R, 0), RINGOLD, Enum.Material.Metal)
		if i % 2 == 0 then
			onWheel("RinneInner", Vector3.new(2 * math.pi * R * 0.7 / n * 2.2, 0.9, 0.9), CFrame.Angles(0, 0, a) * CFrame.new(0, R * 0.7, 0), INDIGO, Enum.Material.Neon)
		end
	end
	for k = 0, 7 do
		local a = k / 8 * math.pi * 2
		onWheel("RinneSpoke", Vector3.new(1.2, R * 0.95, 1.2), CFrame.Angles(0, 0, a) * CFrame.new(0, R * 0.5, 0), Color3.fromRGB(220, 160, 50), Enum.Material.Metal)
	end
	for k = 1, 6 do
		local a = (k - 1) / 6 * math.pi * 2
		local g = onWheel("RinneRealm", Vector3.new(4.4, 4.4, 4.4), CFrame.Angles(0, 0, a) * CFrame.new(0, R, 0), REALM_C[k], Enum.Material.Neon, Enum.PartType.Ball)
		light(g, REALM_C[k], 14, 0.8)
	end
	light(hub, RINGOLD, 60, 1.6)
	-- 바퀴를 받치는 두 기둥과 받침
	for _, z in ipairs({ -1, 1 }) do
		part({ Name = "RinneWheelPost", Size = Vector3.new(4, 36, 4), Position = rd + Vector3.new(-86, 18, z * 6), Color = Color3.fromRGB(235, 230, 248), Material = Enum.Material.Marble, Parent = f })
	end
	part({ Name = "RinneWheelBase", Size = Vector3.new(14, 2, 20), Position = rd + Vector3.new(-86, 1, 0), Color = Color3.fromRGB(225, 220, 240), Material = Enum.Material.Marble, Parent = f })
	-- 제단으로 이어지는 길 (다리 쪽, 동쪽에서)
	for k = 0, 8 do
		part({ Name = "RinnePath", Size = Vector3.new(8, 0.3, 6), Position = rd + Vector3.new(30 + k * 10, 0.15, 0), Color = Color3.fromRGB(240, 236, 250), Material = Enum.Material.Marble, Parent = f })
	end
	-- 둘레를 도는 구름 소용돌이 (세 갈래 나선)
	local vortex = Instance.new("Folder")
	vortex.Name = "RinneVortex"
	vortex.Parent = f
	for arm = 0, 2 do
		for k = 0, 13 do
			local a = arm / 3 * math.pi * 2 + k * 0.28
			local r = 150 + k * 6
			local sz = 26 - k * 0.9
			part({ Name = "RinneVortexCloud", Shape = Enum.PartType.Ball, Size = Vector3.new(sz * 1.4, sz * 0.5, sz), Position = rd + Vector3.new(math.cos(a) * r, -14 - k * 1.2, math.sin(a) * r), Color = Color3.fromRGB(240, 236, 255):Lerp(Color3.fromRGB(200, 180, 255), k / 14), Material = Enum.Material.SmoothPlastic, Transparency = 0.2 + k * 0.03, CanCollide = false, Parent = vortex })
		end
	end
end

local arenas: { [number]: Vector3 } = {}
function World.towerArena(slot: number): Vector3
	local T = Config.TOWER
	local center = T.arena + Vector3.new((slot - 1) * T.slotGap, 0, 0)
	if arenas[slot] then
		return center
	end
	local f = Instance.new("Folder")
	f.Name = "TowerArena" .. slot
	f.Parent = folder
	local R = T.radius
	disc("ArenaFloor", center - Vector3.new(0, 2, 0), R, 4, Color3.fromRGB(165, 155, 140), Enum.Material.Slate, f)
	disc("ArenaUnder", center - Vector3.new(0, 7, 0), R * 0.8, 6, STONE_DARK, Enum.Material.Granite, f)
	disc("ArenaUnder2", center - Vector3.new(0, 13, 0), R * 0.5, 6, STONE_DARK, Enum.Material.Granite, f)
	disc("ArenaRing", center + Vector3.new(0, 0.05, 0), R * 0.55, 0.2, Color3.fromRGB(200, 60, 50), Enum.Material.Fabric, f, false)
	disc("ArenaCore", center + Vector3.new(0, 0.1, 0), R * 0.5, 0.2, Color3.fromRGB(150, 140, 125), Enum.Material.Slate, f, false)
	disc("ArenaTrim", center - Vector3.new(0, 0.2, 0), R + 0.8, 0.6, GOLD, Enum.Material.Metal, f)
	-- 둘레의 낮은 난간과 여덟 기둥 (꼭대기에 불)
	local n = 24
	for k = 0, n - 1 do
		local a = k / n * math.pi * 2
		local p = center + Vector3.new(math.cos(a) * (R - 1), 1.5, math.sin(a) * (R - 1))
		part({ Name = "ArenaRail", Size = Vector3.new(2 * math.pi * R / n + 0.4, 3, 1.2), CFrame = CFrame.lookAt(p, Vector3.new(center.X, p.Y, center.Z)) * CFrame.Angles(0, math.rad(90), 0), Color = STONE, Material = Enum.Material.Marble, Parent = f })
	end
	for k = 0, 7 do
		local a = k / 8 * math.pi * 2
		local p = center + Vector3.new(math.cos(a) * (R + 2), 0, math.sin(a) * (R + 2))
		part({ Name = "ArenaPillar", Size = Vector3.new(3, 16, 3), Position = p + Vector3.new(0, 8, 0), Color = GATE_RED, Material = Enum.Material.Wood, Parent = f })
		brazier(p + Vector3.new(0, 16, 0), 1, f)
	end
	arenas[slot] = center
	return center
end

-- 1.7판 구름 미궁: 사람마다 한 줄. 일곱 방(둥근 구름 단)을 구름 다리로 잇고, 다리 입구마다 구름 문을 둔다
-- 돌려주는 것: { centers = 방 가운데들, gates = 다리마다 구름 문, chest = 보물방의 상자 (T) }
local mazes: { [number]: any } = {}
function World.mazeRooms(slot: number): any
	local M = Config.MAZE
	if mazes[slot] then
		return mazes[slot]
	end
	local base = M.arena + Vector3.new((slot - 1) * M.slotGap, 0, 0)
	local f = Instance.new("Folder")
	f.Name = "CloudMaze" .. slot
	f.Parent = folder
	local R = M.roomRadius
	local out = { centers = {}, gates = {}, chest = nil :: any }
	local n = #M.rooms
	for i, room in ipairs(M.rooms) do
		local c = base + Vector3.new(0, 0, (i - 1) * M.roomGap)
		out.centers[i] = c
		disc("MazeFloor", c - Vector3.new(0, 2, 0), R, 4, Color3.fromRGB(240, 242, 248), Enum.Material.Marble, f)
		disc("MazeTint", c + Vector3.new(0, 0.05, 0), R * 0.62, 0.2, room.color, Enum.Material.Neon, f, false).Transparency = 0.75
		disc("MazeTrim", c - Vector3.new(0, 0.2, 0), R + 0.8, 0.6, room.color, Enum.Material.Metal, f)
		disc("MazeUnder", c - Vector3.new(0, 8, 0), R * 0.7, 8, Color3.fromRGB(220, 225, 235), Enum.Material.SmoothPlastic, f)
		-- 아래쪽 구름 뭉치
		for k = 0, 7 do
			local a = k / 8 * math.pi * 2
			local size = 14 + (k % 3) * 5
			part({ Name = "MazeCloud", Shape = Enum.PartType.Ball, Size = Vector3.new(size, size, size), Position = c + Vector3.new(math.cos(a) * R * 0.85, -9 - (k % 2) * 4, math.sin(a) * R * 0.85), Color = Color3.fromRGB(250, 250, 255), Material = Enum.Material.SmoothPlastic, Transparency = 0.15, CanCollide = false, Parent = f })
		end
		-- 보이지 않는 둘레 벽 (앞뒤 다리 자리는 비운다)
		local m = 36
		for k = 0, m - 1 do
			local a = k / m * math.pi * 2
			local dz = math.sin(a)
			local toNext = i < n and dz > 0.97
			local toPrev = i > 1 and dz < -0.97
			if not toNext and not toPrev then
				local p = c + Vector3.new(math.cos(a) * (R + 0.5), 7, math.sin(a) * (R + 0.5))
				part({ Name = "MazeWall", Size = Vector3.new(2 * math.pi * R / m + 1, 14, 1), CFrame = CFrame.lookAt(p, Vector3.new(c.X, p.Y, c.Z)), Transparency = 1, Parent = f })
			end
		end
		-- 네 귀의 빛기둥 (방의 빛깔)
		for k = 0, 3 do
			local a = math.pi / 4 + k * math.pi / 2
			local p = c + Vector3.new(math.cos(a) * (R - 3), 0, math.sin(a) * (R - 3))
			part({ Name = "MazePost", Size = Vector3.new(2, 12, 2), Position = p + Vector3.new(0, 6, 0), Color = Color3.fromRGB(245, 245, 250), Material = Enum.Material.Marble, Parent = f })
			crystal(p + Vector3.new(0, 14, 0), 2, room.color, f)
		end
		if room.kind == "treasure" then
			local chest = part({ Name = "MazeChest", Size = Vector3.new(6, 4, 4), Position = c + Vector3.new(0, 2, 0), Color = Color3.fromRGB(130, 80, 40), Material = Enum.Material.Wood, Parent = f })
			part({ Name = "MazeChestLid", Size = Vector3.new(6.4, 1.2, 4.4), Position = c + Vector3.new(0, 4.6, 0), Color = GOLD, Material = Enum.Material.Metal, Parent = f })
			light(chest, Color3.fromRGB(255, 210, 120), 20, 1.5)
			out.chest = prompt(chest, "열기", "보물 상자", "MazeChest")
		end
		-- 다음 방으로 가는 구름 다리와 그 입구의 구름 문
		if i < n then
			local from = c + Vector3.new(0, 0, R - 2)
			local to = c + Vector3.new(0, 0, M.roomGap - R + 2)
			local len = (to - from).Magnitude
			local mid = (from + to) / 2
			part({ Name = "MazeBridge", Size = Vector3.new(12, 1, len), Position = mid - Vector3.new(0, 0.5, 0), Color = Color3.fromRGB(235, 240, 250), Material = Enum.Material.Marble, Parent = f })
			for _, x in ipairs({ -1, 1 }) do
				part({ Name = "MazeBridgeWall", Size = Vector3.new(1, 10, len), Position = mid + Vector3.new(x * 6.5, 5, 0), Transparency = 1, Parent = f })
				part({ Name = "MazeBridgeCurb", Size = Vector3.new(0.8, 1, len), Position = mid + Vector3.new(x * 5.6, 0.5, 0), Color = room.color, Material = Enum.Material.Neon, Parent = f })
			end
			local gate = part({ Name = "MazeGate", Size = Vector3.new(12, 14, 1.5), Position = c + Vector3.new(0, 7, R + 1), Color = Color3.fromRGB(230, 240, 255), Material = Enum.Material.ForceField, Transparency = 0.2, Parent = f })
			out.gates[i] = gate
		end
	end
	mazes[slot] = out
	return out
end

-- 구름 문을 닫거나 (true) 걷는다 (false)
function World.mazeGate(gate: BasePart, closed: boolean)
	gate.CanCollide = closed
	gate.Transparency = closed and 0.2 or 1
end

function World.build(): any
	folder = Instance.new("Folder")
	folder.Name = "Gangho"
	folder.Parent = workspace
	local old = workspace:FindFirstChild("Baseplate")
	if old then
		old:Destroy()
	end
	local out: any = { train = {}, rings = {} }
	-- 한 조각이 틀려도 나머지는 다 만든다
	for _, step in ipairs({
		{ "땅", ground },
		{ "마을", function()
			village(out)
		end },
		{ "수련터", function()
			trainingSpots(out)
		end },
		{ "지역", regions },
		{ "사부의 자리", masterSites },
		{ "랜드마크", landmarks },
		{ "바깥 땅", outerLands },
		{ "적의 진", camps },
		{ "비급 조각", function()
			fragments(out)
		end },
		{ "숨은 자리", secretSite },
		{ "지형", terrainHills },
		{ "지역 테두리", regionFrames },
		{ "길가", roadside },
		{ "표지", regionSigns },
		{ "벚꽃 언덕", sakuraHill },
		{ "술독 마루", sojuHill },
		{ "혈월 제단", reaperAltar },
		{ "쇠기둥 봉우리", thunderPeak },
		{ "고래 뼈 바위", whaleRock },
		{ "관성대", starTerrace },
		{ "빈 들 채우기", scatterFill },
		{ "숨은 것", function()
			easterEggs(out)
		end },
		{ "빈칸", nullSpot },
		{ "권법 시험장", function()
			testRoom(out)
		end },
		{ "사부의 부탁", function()
			questProps(out)
		end },
		{ "들판 채우기", wilds },
		{ "각성선인", function()
			awakenAltar(out)
		end },
		{ "천상계", function()
			skyWorld(out)
		end },
	}) do
		local ok, err = pcall(step[2] :: any)
		if not ok then
			warn("[권왕] 맵 만들기 오류 (" .. step[1] .. "):", err)
		end
	end
	local spawn = Instance.new("SpawnLocation")
	spawn.Name = "VillageSpawn"
	spawn.Anchored = true
	spawn.Size = Vector3.new(10, 1, 10)
	spawn.Position = Config.SPAWN - Vector3.new(0, 3.5, 0)
	spawn.Transparency = 1
	spawn.CanCollide = false
	spawn.Neutral = true
	spawn.Duration = 0
	spawn.Parent = folder
	return out
end

return World
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="StarterPlayer" referent="16">
    <Properties>
      <string name="Name">StarterPlayer</string>
      <float name="CameraMaxZoomDistance">120</float>
    </Properties>
    <Item class="StarterPlayerScripts" referent="17">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="LocalScript" referent="18">
        <Properties>
          <string name="Name">KwonClient</string>
          <string name="Source"><![CDATA[-- 권왕(拳王): 맨손의 강호 — 화면
-- 누르는 순간 내 몸이 먼저 움직이고(기다리지 않는다), 맞힌 상대는 서버에 알린다
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local Lighting = game:GetService("Lighting")
local TweenService = game:GetService("TweenService")

local Config = require(ReplicatedStorage:WaitForChild("Config"))
local Anim = require(script:WaitForChild("Anim"))
local Fx = require(script:WaitForChild("Fx"))
local UI = require(script:WaitForChild("UI"))
local Ults = require(script:WaitForChild("Ults"))
local Cutscene = require(script:WaitForChild("Cutscene"))
local Music = require(script:WaitForChild("Music"))
local Gacha = require(script:WaitForChild("Gacha"))
local Mount = require(script:WaitForChild("Mount"))
local Sakura = require(script:WaitForChild("Sakura"))
local Drunk = require(script:WaitForChild("Drunk"))
local Awake = require(script:WaitForChild("Awake"))
local Reaper = require(script:WaitForChild("Reaper"))
local Ult2 = require(script:WaitForChild("Ult2"))
local Awake3 = require(script:WaitForChild("Awake3"))
local Forest = require(script:WaitForChild("Forest"))
local Whale = require(script:WaitForChild("Whale"))
local Star = require(script:WaitForChild("Star"))
local Mujo = require(script:WaitForChild("Mujo"))
local Royal = require(script:WaitForChild("Royal"))
local Dream = require(script:WaitForChild("Dream"))
local Null = require(script:WaitForChild("Null"))
local Ink = require(script:WaitForChild("Ink"))
local Blossom = require(script:WaitForChild("Blossom"))
local Plum = require(script:WaitForChild("Plum"))
local Samsara = require(script:WaitForChild("Samsara"))
local Geuk = require(script:WaitForChild("Geuk"))
local Gourd = require(script:WaitForChild("Gourd"))
local Polish = require(script:WaitForChild("Polish"))
local SkillFx = require(script:WaitForChild("SkillFx"))

local player = Players.LocalPlayer
-- 판 표시: 화면 오른쪽 아래 구석의 작은 글씨 (게시한 판이 맞는지, 게임패스 번호가 들어갔는지 보려고)
task.spawn(function()
	local passes = 0
	for _, it in ipairs(Config.Premium or {}) do
		if (it.gamepass or 0) > 0 then
			passes += 1
		end
	end
	local gui = Instance.new("ScreenGui")
	gui.Name = "KwonVersion"
	gui.ResetOnSpawn = false
	gui.DisplayOrder = 1
	gui.Parent = player:WaitForChild("PlayerGui")
	local label = Instance.new("TextLabel")
	label.AnchorPoint = Vector2.new(1, 1)
	label.Position = UDim2.new(1, -6, 1, -4)
	label.Size = UDim2.new(0, 220, 0, 14)
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.Gotham
	label.TextSize = 11
	label.TextXAlignment = Enum.TextXAlignment.Right
	label.TextColor3 = Color3.fromRGB(220, 220, 220)
	label.TextTransparency = 0.45
	label.Text = string.format("권왕 %s · 게임패스 %d/%d", tostring(Config.VERSION), passes, #(Config.Premium or {}))
	label.Parent = gui
end)
-- 2.7.7판: 기술을 멀리서 보게 줌 아웃 120칸까지
pcall(function()
	player.CameraMaxZoomDistance = 120
end)
local remotes = ReplicatedStorage:WaitForChild("KwonRemotes")
local Request = remotes:WaitForChild("Request") :: RemoteEvent
local Push = remotes:WaitForChild("Push") :: RemoteEvent

UI.init(Request)
Fx.bindAnim(Anim)
Anim.start()

local state: any = nil
local launchedAt: { [Instance]: number } = {} -- 하늘로 띄운 적 (공중 연격 판단)
local function rootOfChar(): BasePart?
	local c = player.Character
	local r = c and c:FindFirstChild("HumanoidRootPart")
	return (r and r:IsA("BasePart")) and r or nil
end

------------------------------------------------------------------------
-- 무인 지켜보기 (사람과 적 모두 몸동작을 그린다)
------------------------------------------------------------------------
local function watchChar(char: Model)
	task.spawn(function()
		char:WaitForChild("HumanoidRootPart", 10)
		char:WaitForChild("Humanoid", 10)
		Anim.watch(char)
	end)
	-- 금강 법신 (금빛 거인), 번개·일순 베기 동안 사라짐
	char:GetAttributeChangedSignal("Giant"):Connect(function()
		Ults.watchGiant(char)
	end)
	-- 열화신권 연소: 불붙은 몸에 불꽃
	char:GetAttributeChangedSignal("Burning"):Connect(function()
		Fx.burning(char, char:GetAttribute("Burning") == true)
	end)
	char:GetAttributeChangedSignal("Vanish"):Connect(function()
		Ults.watchVanish(char)
	end)
	-- 초월 권법의 벚꽃 부채
	Sakura.watch(char)
	-- 탈것: 아래에 말·범·구름을 그리고, 탄 자세로
	Mount.watch(char)
	char:GetAttributeChangedSignal("Mount"):Connect(function()
		Anim.setLoop(char, char:GetAttribute("Mount") and "ride" or nil, 0.8)
	end)
end
local function watchPlayer(p: Player)
	local function add(char: Model)
		watchChar(char)
	end
	if p.Character then
		add(p.Character)
	end
	p.CharacterAdded:Connect(add)
end
for _, p in ipairs(Players:GetPlayers()) do
	watchPlayer(p)
end
Players.PlayerAdded:Connect(watchPlayer)
-- 사부와 적도 부채를 든다 (초월의 시련, 사부 자리)
task.spawn(function()
	for _, name in ipairs({ "Masters", "Enemies" }) do
		local f = workspace:WaitForChild(name, 60)
		if f then
			Sakura.watchFolder(f)
		end
	end
end)
task.spawn(function()
	local enemies = workspace:WaitForChild("Enemies")
	local function add(m: Instance)
		if m:IsA("Model") then
			watchChar(m)
			task.spawn(UI.enemyTag, m)
			m:GetAttributeChangedSignal("LaunchedAt"):Connect(function()
				launchedAt[m] = os.clock()
			end)
		end
	end
	for _, m in ipairs(enemies:GetChildren()) do
		add(m)
	end
	enemies.ChildAdded:Connect(add)
end)

-- 각성의 기운 (사람과 사부): 0.5초마다 단계에 맞춰 붙이고 뗀다
local handKey: { [Model]: string } = setmetatable({}, { __mode = "k" }) :: any
task.spawn(function()
	while true do
		task.wait(0.5)
		local list: { Model } = {}
		for _, p in ipairs(Players:GetPlayers()) do
			if p.Character then
				table.insert(list, p.Character)
			end
		end
		local mf = workspace:FindFirstChild("Masters")
		for _, m in ipairs(mf and mf:GetChildren() or {}) do
			if m:IsA("Model") then
				table.insert(list, m)
			end
		end
		for _, m in ipairs(list) do
			local style = Config.STYLE_BY_ID[tostring(m:GetAttribute("Style") or "")]
			local tier = tonumber(m:GetAttribute("Awaken")) or 0
			pcall(Fx.awakenAura, m, style and tier or 0, style and style.color or Color3.new(1, 1, 1))
		end
		-- 권법마다 손에 맺힌 기운 (사부의 분신도)
		local ef = workspace:FindFirstChild("Enemies")
		for _, m in ipairs(ef and ef:GetChildren() or {}) do
			if m:IsA("Model") and m:GetAttribute("Style") then
				table.insert(list, m)
			end
		end
		for _, m in ipairs(list) do
			local key = tostring(m:GetAttribute("Style") or "") .. ":" .. tostring(tonumber(m:GetAttribute("Awaken")) or 0)
			if handKey[m] ~= key then
				handKey[m] = key
				pcall(Fx.styleHands, m, m:GetAttribute("Style"), tonumber(m:GetAttribute("Awaken")) or 0)
			end
		end
	end
end)

-- 빠르게 움직이면 화면 가장자리에 바람 줄
RunService.RenderStepped:Connect(function()
	local root = rootOfChar()
	if root then
		local v = root.AssemblyLinearVelocity
		UI.setSpeed(math.clamp((Vector3.new(v.X, 0, v.Z).Magnitude - 27) / 35, 0, 1))
	end
end)

-- 사부: 권법 자세로 서 있다가, 가까이 오면 가끔 시범을 보인다
task.spawn(function()
	local masters = workspace:WaitForChild("Masters")
	local function add(m: Instance)
		if m:IsA("Model") then
			watchChar(m)
		end
	end
	for _, m in ipairs(masters:GetChildren()) do
		add(m)
	end
	masters.ChildAdded:Connect(add)
	local nextShow: { [Instance]: number } = {}
	local nextSpeak: { [Instance]: number } = {}
	-- 말풍선
	local function speak(m: Model, text: string, color: Color3)
		local head = m:FindFirstChild("Head")
		if text == "" or not head or not head:IsA("BasePart") then
			return
		end
		local bb = Instance.new("BillboardGui")
		bb.Size = UDim2.new(0, 360, 0, 70)
		bb.StudsOffset = Vector3.new(0, 6.2, 0)
		bb.AlwaysOnTop = true
		bb.LightInfluence = 0
		bb.MaxDistance = 80
		local frame = Instance.new("Frame")
		frame.Size = UDim2.fromScale(1, 1)
		frame.BackgroundColor3 = Color3.fromRGB(20, 16, 14)
		frame.BackgroundTransparency = 0.2
		frame.Parent = bb
		local corner = Instance.new("UICorner")
		corner.CornerRadius = UDim.new(0, 12)
		corner.Parent = frame
		local stroke = Instance.new("UIStroke")
		stroke.Color = color
		stroke.Thickness = 2
		stroke.Parent = frame
		local label = Instance.new("TextLabel")
		label.BackgroundTransparency = 1
		label.Size = UDim2.new(1, -16, 1, -8)
		label.Position = UDim2.new(0, 8, 0, 4)
		label.Font = Enum.Font.GothamBold
		label.TextScaled = true
		label.TextWrapped = true
		label.TextColor3 = Color3.fromRGB(255, 245, 225)
		label.Text = "「" .. text .. "」"
		label.Parent = frame
		bb.Parent = head
		task.delay(5, function()
			bb:Destroy()
		end)
	end
	-- 사부 둘레를 도는 기운의 구슬
	local orbs: { [Instance]: { Part } } = {}
	RunService.RenderStepped:Connect(function()
		local t = os.clock()
		local me = rootOfChar()
		for _, m in ipairs(masters:GetChildren()) do
			local root = m:FindFirstChild("HumanoidRootPart")
			local style = Config.STYLE_BY_ID[tostring(m:GetAttribute("Style") or "")]
			if root and root:IsA("BasePart") and style and me and (root.Position - me.Position).Magnitude < 140 then
				local list = orbs[m]
				if not list then
					list = {}
					for i = 1, 3 do
						local o = Instance.new("Part")
						o.Name = "MasterOrb"
						o.Shape = Enum.PartType.Ball
						o.Size = Vector3.new(0.7, 0.7, 0.7)
						o.Anchored = true
						o.CanCollide = false
						o.CanQuery = false
						o.CanTouch = false
						o.CastShadow = false
						o.Material = Enum.Material.Neon
						o.Color = i == 2 and style.color2 or style.color
						o.Parent = workspace
						local l = Instance.new("PointLight")
						l.Color = style.color
						l.Range = 8
						l.Brightness = 1.2
						l.Parent = o
						table.insert(list, o)
					end
					orbs[m] = list
				end
				for i, o in ipairs(list) do
					local a = t * 1.6 + i / 3 * math.pi * 2
					o.Position = root.Position + Vector3.new(math.cos(a) * 4, 0.5 + math.sin(t * 2 + i) * 1.2, math.sin(a) * 4)
				end
			elseif orbs[m] then
				for _, o in ipairs(orbs[m]) do
					o:Destroy()
				end
				orbs[m] = nil
			end
		end
	end)
	while true do
		task.wait(0.5)
		local char = player.Character
		local me = char and char:FindFirstChild("HumanoidRootPart")
		for _, m in ipairs(masters:GetChildren()) do
			local root = m:FindFirstChild("HumanoidRootPart")
			local style = Config.STYLE_BY_ID[m:GetAttribute("Style") :: any]
			if me and me:IsA("BasePart") and root and root:IsA("BasePart") and style and (root.Position - me.Position).Magnitude < 70 then
				local t = os.clock()
				local dist = (root.Position - me.Position).Magnitude
				-- 가까이 오면 한마디
				if dist < 32 and t >= (nextSpeak[m] or 0) then
					nextSpeak[m] = t + 30
					speak(m :: Model, tostring(m:GetAttribute("Quote") or ""), style.color)
				end
				if t >= (nextShow[m] or 0) and not Anim.playing(m :: Model) then
					-- 시범: 연타, 강타, 기술을 섞어 제대로 보여 준다
					local picks: { any } = { 1, 2, 3, 4, "H", "E", "R", "F" }
					local slot = picks[math.random(1, #picks)]
					local mv = Config.move(style.id, slot)
					if mv then
						Anim.play(m :: Model, mv.pose, mv.dur)
						Fx.limbTrails(m :: Model, mv.pose, mv.dur, style.color, style.color2)
						Fx.cast(style.id, slot, m :: Model, mv.dur)
						Sakura.cast(style.id, slot, m :: Model, mv.dur)
						Drunk.cast(style.id, slot, m :: Model, mv.dur)
						Reaper.cast(style.id, slot, m :: Model, mv.dur)
						SkillFx.cast(style.id, slot, m :: Model, mv.dur)
						for _, h in ipairs(mv.hits or {}) do
							task.delay(h.t, function()
								Fx.swing(style.id, m :: Model, (h.kb or 0) >= 20)
							end)
						end
					end
					nextShow[m] = t + math.random(30, 50) / 10
				end
			end
		end
	end
end)

------------------------------------------------------------------------
-- 내 몸
------------------------------------------------------------------------
local function myChar(): Model?
	return player.Character
end
local function myRoot(): BasePart?
	local c = player.Character
	local r = c and c:FindFirstChild("HumanoidRootPart")
	return (r and r:IsA("BasePart")) and r or nil
end
local function myHum(): Humanoid?
	local c = player.Character
	return c and c:FindFirstChildOfClass("Humanoid") or nil
end
local function myStyle(): any
	return state and state.style ~= "" and Config.STYLE_BY_ID[state.style] or nil
end
local function flat(v: Vector3): Vector3
	local f = Vector3.new(v.X, 0, v.Z)
	return f.Magnitude > 1e-4 and f.Unit or Vector3.new(0, 0, -1)
end

local seq = 0
local actSeq = -1
local actStart = 0
local actDur = 0
local buffered: any = nil
local guarding = false
local chargeStart: number? = nil
local stunUntil = 0
local dead = false
local dashAt = 0
local dashUsed = 0
local airJumped = false
local deflectAt = 0 -- 마지막으로 흘린 때 (곧바로 클릭하면 반격)
-- 연타 박자
local earlyPresses = 0 -- 지금 동작 중에 너무 일찍 누른 횟수
local comboBroken = false -- 흐트러졌다 (마구 눌렀다)
local nextPerfect = false -- 다음 동작이 박자를 맞췄는가
local perfectChain = 0
local lastComboSlot: any = nil
local airJ = 0
local airAttacked = false
local sprinting = false
local cds: { [string]: number } = {}
local cdLen: { [string]: number } = {}
local predictedAt: { [Model]: number } = {}
local training: string? = nil

------------------------------------------------------------------------
-- 카메라 흔들림
------------------------------------------------------------------------
-- 카메라가 순간 다가섰다 돌아온다 (흘리기·반격의 손맛)
local fovBase: number? = nil
local function fovPunch(delta: number, time: number)
	local cam = workspace.CurrentCamera
	if not cam then
		return
	end
	fovBase = fovBase or cam.FieldOfView
	local base = fovBase :: number
	cam.FieldOfView = base + delta
	game:GetService("TweenService"):Create(cam, TweenInfo.new(time, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { FieldOfView = base }):Play()
end

local shakeAmp = 0
local function shake(amount: number)
	shakeAmp = math.max(shakeAmp, amount)
end
RunService:BindToRenderStep("KwonShake", Enum.RenderPriority.Camera.Value + 1, function(dt: number)
	local cam = workspace.CurrentCamera
	if not cam then
		return
	end
	if shakeAmp > 0.01 then
		local a = shakeAmp
		cam.CFrame = cam.CFrame * CFrame.new((math.random() - 0.5) * a, (math.random() - 0.5) * a, 0) * CFrame.Angles((math.random() - 0.5) * a * 0.02, (math.random() - 0.5) * a * 0.02, 0)
		shakeAmp *= math.exp(-dt * 14)
	end
end)
local cc = Instance.new("ColorCorrectionEffect")
cc.Name = "KwonHitTint"
cc.Parent = Lighting
local function tint(color: Color3, strength: number, time: number)
	cc.TintColor = Color3.new(1, 1, 1):Lerp(color, strength)
	cc.Contrast = strength * 0.4
	task.delay(time, function()
		cc.TintColor = Color3.new(1, 1, 1)
		cc.Contrast = 0
	end)
end

------------------------------------------------------------------------
-- 맞힐 상대 찾기 (서버와 같은 상자)
------------------------------------------------------------------------
local function onRing(pos: Vector3): boolean
	local R = Config.RING
	return math.abs(pos.X - R.center.X) <= R.size / 2 and math.abs(pos.Z - R.center.Z) <= R.size / 2 and pos.Y > R.height - 1
end

local function foes(): { Model }
	local list = {}
	local enemies = workspace:FindFirstChild("Enemies")
	if enemies then
		for _, m in ipairs(enemies:GetChildren()) do
			if m:IsA("Model") and m:GetAttribute("Dead") ~= true then
				table.insert(list, m)
			end
		end
	end
	-- 사람: 비무대 위끼리, 또는 둘 다 안전한 곳 밖이고 PvP를 켠 사이
	local me = myRoot()
	local myChar0 = player.Character
	if me and myChar0 then
		local meRing = onRing(me.Position)
		local meField = not Config.inSafe(me.Position) and myChar0:GetAttribute("PvpOff") ~= true
		if meRing or meField then
			for _, p in ipairs(Players:GetPlayers()) do
				local c = p.Character
				local r = c and c:FindFirstChild("HumanoidRootPart")
				if p ~= player and c and r and r:IsA("BasePart") and c:GetAttribute("Dead") ~= true then
					local ok = (meRing and onRing(r.Position)) or (meField and not Config.inSafe(r.Position) and c:GetAttribute("PvpOff") ~= true)
					if ok then
						table.insert(list, c)
					end
				end
			end
		end
	end
	return list
end

local function rootOf(m: Model): BasePart?
	local r = m:FindFirstChild("HumanoidRootPart")
	return (r and r:IsA("BasePart")) and r or nil
end

local function query(hit: any): { Model }
	local root = myRoot()
	if not root then
		return {}
	end
	local look = flat(root.CFrame.LookVector)
	local origin = root.Position
	local center = hit.aoe and origin or origin + look * (hit.range * 0.55)
	local reach = hit.aoe and hit.radius or (hit.range * 0.55 + hit.radius)
	local out = {}
	for _, m in ipairs(foes()) do
		local r = rootOf(m)
		if r then
			local d = Vector3.new(r.Position.X - center.X, 0, r.Position.Z - center.Z).Magnitude
			if d <= reach + 1 and math.abs(r.Position.Y - origin.Y) < 9 then
				table.insert(out, m)
			end
		end
	end
	return out
end

-- 가까운 적 쪽으로 몸을 돌린다 (카메라 방향 75도 안, 14칸 안)
local function aim(): number?
	local root = myRoot()
	local cam = workspace.CurrentCamera
	if not root or not cam then
		return nil
	end
	local camDir = flat(cam.CFrame.LookVector)
	local best, bestScore = nil, math.huge
	for _, m in ipairs(foes()) do
		local r = rootOf(m)
		if r then
			local v = Vector3.new(r.Position.X - root.Position.X, 0, r.Position.Z - root.Position.Z)
			local d = v.Magnitude
			if d < 14 and d > 0.1 and v.Unit:Dot(camDir) > math.cos(math.rad(75)) then
				if d < bestScore then
					best, bestScore = r, d
				end
			end
		end
	end
	local dir = best and flat(best.Position - root.Position) or camDir
	root.CFrame = CFrame.lookAt(root.Position, root.Position + dir)
	return best and bestScore or nil
end

-- 잠깐 앞으로 미끄러지기 (내 몸은 내가 움직인다)
local function push(vel: Vector3, time: number)
	local root = myRoot()
	if not root then
		return
	end
	local start = os.clock()
	local conn: RBXScriptConnection
	conn = RunService.Heartbeat:Connect(function()
		if not root.Parent or os.clock() - start > time then
			conn:Disconnect()
			return
		end
		root.AssemblyLinearVelocity = Vector3.new(vel.X, math.max(root.AssemblyLinearVelocity.Y, vel.Y), vel.Z)
	end)
end

------------------------------------------------------------------------
-- 기술 쓰기
------------------------------------------------------------------------
local function busy(): boolean
	return os.clock() < actStart + actDur
end

local function canAct(): boolean
	return not dead and os.clock() >= stunUntil and not guarding and myChar() ~= nil and myStyle() ~= nil
end

local startMove: (any, number?) -> ()

local function unlocked(slot: string): boolean
	local need = Config.SKILL_UNLOCK[slot]
	if not need or not state then
		return true
	end
	local m = state.mastery and state.mastery[state.style]
	return (m and m.lv or 1) >= need
end

startMove = function(slot: any, charge: number?)
	local style = myStyle()
	local char = myChar()
	local root = myRoot()
	if not style or not char or not root then
		return
	end
	-- 3.1판: 극 권법의 황혼 동안은 바뀐 기술
	local move = Config.move(style.id, slot, char:GetAttribute("Twilight") == true)
	if not move then
		return
	end
	local now = os.clock()
	-- 앞 기술이 남아 있으면 줄 세운다 (끝날 때 바로 나간다)
	if busy() then
		if now >= actStart + actDur * (type(slot) == "number" and 0.7 or 0.85) then
			-- 이어 쓸 수 있는 순간
		else
			buffered = { slot = slot, charge = charge, at = now }
			return
		end
	end
	-- 강타는 연달아 못 쓴다
	if slot == "H" and now < (cds.H or 0) and char:GetAttribute("TestInf") ~= true then
		return
	end
	if slot == "H" then
		cds.H = now + Config.HEAVY_CD
		cdLen.H = Config.HEAVY_CD
	end
	if slot == "E" or slot == "R" or slot == "G" or slot == "X" then
		if not unlocked(slot) then
			UI.toast(string.format("🔒 %s: 숙련도 %d에 열려요", move.name, Config.SKILL_UNLOCK[slot]))
			return
		end
		local inf = char:GetAttribute("TestInf") == true
		if now < (cds[slot] or 0) and not inf then
			return
		end
		local chi = char:GetAttribute("Chi")
		if type(chi) == "number" and chi < (move.chi or 0) and not inf then
			UI.toast(string.format("내공이 부족해요 (🌀 %d 필요)", move.chi or 0))
			return
		end
		cds[slot] = inf and 0 or now + (move.cd or 0) * (style.cdMult or 1) * (1 - (state and state.manualCd or 0))
		cdLen[slot] = (move.cd or 1) * (style.cdMult or 1) * (1 - (state and state.manualCd or 0))
	end
	local speed = Config.actSpeed(style, state and state.gradeUp and state.gradeUp[style.id] or 0, char:GetAttribute("Buff") == "frenzy")
	local dur = move.dur / speed
	local gap = aim()
	seq += 1
	local mySeq = seq
	actSeq = mySeq
	actStart = now
	actDur = dur
	buffered = nil
	local first = move.hits and move.hits[1]
	Anim.play(char, move.pose, dur, { align = first and first.t / speed or nil })
	Fx.limbTrails(char, move.pose, dur, style.color, style.color2)
	Fx.cast(style.id, slot, char, dur)
	Sakura.cast(style.id, slot, char, dur)
	Drunk.cast(style.id, slot, char, dur)
	Reaper.cast(style.id, slot, char, dur)
	SkillFx.cast(style.id, slot, char, dur)
	local perfect = nextPerfect
	nextPerfect = false
	Request:FireServer("act", slot, mySeq, charge, perfect)
	if type(slot) == "number" or slot == "F" then
		earlyPresses = 0
		lastComboSlot = slot
		if perfect then
			perfectChain += 1
			local big = perfectChain >= Config.RHYTHM.chain
			Fx.text(root.Position + Vector3.new(0, 4.5, 0), big and string.format("연속 정타 ×%d", perfectChain) or "정타!", big and Color3.fromRGB(255, 200, 80) or Color3.fromRGB(255, 235, 170), big and 30 or 22, 0.8)
			Fx.ring(root.Position - Vector3.new(0, 2.5, 0), style.color, 2, big and 12 or 7, 0.3)
			Fx.sound("ping", 0.35, big and 1.6 or 1.3)
		elseif slot ~= 1 then
			perfectChain = 0
		end
	end
	if slot == "F" then
		-- 각성 마무리: 크게 휘둘러 하늘로 띄운다
		UI.flash(style.color, 0.25)
		fovPunch(-6, 0.4)
		Fx.text(root.Position + Vector3.new(0, 6, 0), "✦ " .. move.name, style.color, 34, 1.2)
	end
	if move.hover then
		-- 공중 연격: 나도 공중에 머문다
		root.AssemblyLinearVelocity = Vector3.new(root.AssemblyLinearVelocity.X * 0.3, move.hover, root.AssemblyLinearVelocity.Z * 0.3)
	end
	if slot == "C" then
		Fx.text(root.Position + Vector3.new(0, 5, 0), "반격!", Color3.fromRGB(255, 220, 120), 38)
		UI.flash(Color3.fromRGB(255, 230, 160), 0.2)
	elseif slot == "D" then
		Fx.afterimage(char, style.color, 0.35)
	end
	if move.dive then
		-- 잠깐 떠올랐다가 땅으로 내리꽂는다
		local diveStart = os.clock()
		local conn: RBXScriptConnection
		conn = RunService.Heartbeat:Connect(function()
			local t = os.clock() - diveStart
			if not root.Parent or t > dur then
				conn:Disconnect()
				return
			end
			local v = root.AssemblyLinearVelocity
			if t < 0.12 then
				root.AssemblyLinearVelocity = Vector3.new(v.X * 0.5, 10, v.Z * 0.5)
			else
				root.AssemblyLinearVelocity = Vector3.new(v.X * 0.3, -move.dive, v.Z * 0.3)
			end
		end)
		task.delay((first and first.t or 0.3) / speed, function()
			if actSeq == mySeq then
				local feet = root.Position - Vector3.new(0, 2.6, 0)
				Fx.ring(feet + Vector3.new(0, 0.3, 0), style.color, 3, 24, 0.45)
				Fx.ring(feet + Vector3.new(0, 0.4, 0), Color3.new(1, 1, 1), 2, 14, 0.3)
				Fx.dust(feet, 4)
				Fx.sound("heavy", 0.9, 0.55)
				shake(1)
			end
		end)
	end
	local look = flat(root.CFrame.LookVector)
	-- 상대가 조금 떨어져 있으면 한 걸음에 파고든다 (거리를 좁히며 친다)
	local close = 0
	if gap and gap > 4.5 and not move.teleport and not move.proj and move.hits and #move.hits > 0 then
		close = math.min(gap - 3.5, 7)
	end
	local lunge = (move.lunge or 0) + close
	if lunge > 0 and not move.teleport then
		push(look * (lunge / 0.16), 0.16)
		if close > 2 then
			Fx.afterimage(char, style.color, 0.25)
		end
	end
	if move.jump then
		root.AssemblyLinearVelocity = Vector3.new(root.AssemblyLinearVelocity.X, move.jump, root.AssemblyLinearVelocity.Z)
	end
	if slot == "X" and style.gauntlets then
		-- 구천뇌정: 하늘의 천둥 눈을 올려다보는 컷씬 (대사 없이, 무적), 걷히면 벼락이 쏟아진다
		Ult2.superCut(char, ((move.mech and move.mech.cut) or 1.3) / speed, move.name, shake)
	elseif slot == "X" and style.scythe then
		-- 혈월만겸: 붉은 달이 뜨는 컷씬 (대사 없이) 동안 무적, 컷씬이 걷히면 핏빛 초승달이 쏟아진다
		Reaper.superCut(char, ((move.mech and move.mech.cut) or 1.4) / speed, move.name, shake)
	elseif slot == "X" and style.starDome then
		-- 성천궁: 남색 밤하늘에 별이 뜨는 컷씬 (대사 없이, 무적), 걷히면 돔이 내려앉는다
		Star.superCut(char, ((move.mech and move.mech.cut) or 1.4) / speed, move.name, shake)
	elseif slot == "X" and style.whale then
		-- 고경승천: 바다 밑의 고래를 올려다보는 컷씬 (대사 없이, 무적), 걷히면 고래가 솟구친다
		Whale.superCut(char, ((move.mech and move.mech.cut) or 1.4) / speed, move.name, shake)
	elseif slot == "X" and style.soju then
		-- 취선만권: 1초 컷씬 (대사 없이) 동안 점점 빨라지는 앞구르기, 컷씬이 걷히면 와다다다
		Drunk.superCut(char, ((move.mech and move.mech.cut) or 1) / speed, move.name, shake)
		Fx.skillAura(char, style.color, style.color2, dur, true)
	elseif slot == "X" and style.nullCubes then
		-- 존재소거: 화면이 깨지고 장면이 끊겨 붙는 컷씬 (대사 없이, 무적)
		Null.superCut(char, ((move.mech and move.mech.cut) or 1.4) / speed, move.name, shake)
		Fx.skillAura(char, style.color, style.color2, dur, true)
	elseif slot == "X" and style.rebirthStyle then
		-- 환생 권법의 초 오의: 권법마다 다른 하늘을 보는 컷씬 (대사 없이, 무적), 걷히면 벌어진다
		Samsara.superCut(char, ((move.mech and move.mech.cut) or 1.4) / speed, move.name, shake, style.id)
		Fx.skillAura(char, style.color, style.color2, dur, true)
	elseif slot == "X" and style.sunMoonOrbs then
		-- 일월개벽·일월동귀: 해와 달이 솟는 (내려오는) 하늘을 보는 컷씬 (대사 없이, 무적), 걷히면 하늘에서 벌어진다
		Geuk.superCut(char, ((move.mech and move.mech.cut) or 1.4) / speed, move.name, shake, move.mech ~= nil and move.mech.kind == "twilightCollapse")
		Fx.skillAura(char, style.color, style.color2, dur, true)
	elseif slot == "G" or slot == "X" then
		UI.cinematic((slot == "X" and "초 오의 · " or "") .. move.name, style.color, dur)
		if slot == "X" and style.fans then
			Sakura.superIntro(char)
		end
		-- 오의: 화면이 한순간 뒤집히고 집중선이 몰려들며, 시야가 좁혀졌다가 터진다
		UI.ultFrame(style.color, style.color2)
		fovPunch(-10, 0.55)
		Fx.skillAura(char, style.color, style.color2, math.max(1.2, dur), true)
		if move.mech and slot == "X" then
			Fx.skillAura(char, style.color, style.color2, math.max(2, dur), true)
		elseif move.mech then
			Ults.intro(style.id, char)
		else
			Fx.ult(style.id, char, dur)
		end
		shake(1.2)
		tint(style.color, 0.25, dur)
		-- 오의: 화면이 확 좁아졌다가 (집중) 넓게 풀린다
		local cam = workspace.CurrentCamera
		if cam then
			local base = cam.FieldOfView
			pcall(function()
				local tw = TweenService:Create(cam, TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { FieldOfView = base - 12 })
				tw:Play()
				task.delay(0.22, function()
					TweenService:Create(cam, TweenInfo.new(0.6, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { FieldOfView = base }):Play()
				end)
			end)
		end
	end
	-- E·R·강타: 기술 이름이 크게 떠오른다
	if slot == "E" or slot == "R" or slot == "H" then
		Fx.text(root.Position + Vector3.new(0, 6, 0), move.name, style.color2, slot == "H" and 30 or 38, 1.1)
	end
	-- 휘두르는 소리와 맞힘 알리기
	for i, h in ipairs(move.hits or {}) do
		task.delay(h.t / speed, function()
			if actSeq ~= mySeq or dead then
				return
			end
			Fx.sound("swing", 0.35, 1.05 + math.random() * 0.25)
			Fx.swing(style.id, char, (h.kb or 0) >= 20)
			local targets = query(h)
			Request:FireServer("hit", mySeq, i, targets)
			-- 바로 반응 (서버가 정하기 전에): 멈칫과 불꽃
			for _, m in ipairs(targets) do
				local r = rootOf(m)
				if r and m:GetAttribute("Guard") ~= true then
					predictedAt[m] = os.clock()
					local heavy = (h.kb or 0) >= 20 or (h.stun or 0) >= 0.6
					Fx.hitstop({ char, m }, heavy and 0.1 or 0.05)
					if heavy then
						-- 큰 한 방: 순간 번쩍이는 임팩트 프레임과 카메라 당김
						UI.flash(Color3.new(1, 1, 1), 0.18)
						fovPunch(-4, 0.25)
					end
					Fx.styleHit(style.id, r.Position:Lerp(root.Position, 0.35) + Vector3.new(0, 1, 0), heavy, look)
					Fx.sound(heavy and "heavy" or "hit", heavy and 0.9 or 0.6, heavy and 0.6 or 0.85 + math.random() * 0.2)
					shake(heavy and 0.9 or 0.35)
					if m:GetAttribute("Poise") ~= true then
						Anim.play(m, (math.random() < 0.5) and "flinch_l" or "flinch_r", 0.3)
					end
				end
			end
		end)
	end
	if move.proj then
		task.delay(dur * 0.42, function()
			if actSeq == mySeq then
				Fx.sound("swing", 0.6, 0.7)
				shake(0.4)
			end
		end)
	end
end

-- 줄 세운 입력: 앞 기술이 끝나면 바로
RunService.Heartbeat:Connect(function()
	if buffered and not busy() and canAct() then
		local b = buffered
		buffered = nil
		if os.clock() - b.at < 0.5 then
			nextPerfect = b.perfect == true
			startMove(b.slot, b.charge)
		end
	elseif buffered and os.clock() >= actStart + actDur * 0.7 and canAct() and type(buffered.slot) == "number" then
		local b = buffered
		buffered = nil
		nextPerfect = b.perfect == true
		startMove(b.slot, b.charge)
	end
end)

local function attack()
	if training and training ~= "bamboo" then
		UI.trainPress()
		return
	end
	if not canAct() then
		return
	end
	local style = myStyle()
	if not style then
		UI.openPage("styles", { first = true })
		return
	end
	local now = os.clock()
	-- 몸놀림 기술: 흘리기 직후 = 반격, 공중 = 낙하격, 대시 직후 = 돌진 일격
	local hum = myHum()
	if now - deflectAt < Config.ACTION_WINDOW.C then
		deflectAt = 0
		startMove("C")
		return
	end
	if hum and hum.FloorMaterial == Enum.Material.Air and not busy() then
		-- 띄운 적이 가까이 있으면 공중 연격 (세 번까지), 아니면 내리꽂는 낙하격
		local root = myRoot()
		local near = false
		if root then
			for m, at in pairs(launchedAt) do
				local r = m.Parent and rootOf(m :: Model)
				if r and now - at < 1.6 and (r.Position - root.Position).Magnitude < 12 then
					near = true
				end
			end
		end
		if near and airJ < 3 then
			airJ += 1
			aim()
			startMove("J")
			return
		elseif not airAttacked then
			airAttacked = true
			startMove("A")
			return
		end
	end
	if now - dashAt < Config.ACTION_WINDOW.D and not busy() then
		dashAt = 0
		startMove("D")
		return
	end
	-- 연타는 박자다: 앞 동작이 끝나 갈 즈음 눌러야 이어지고(딱 맞으면 連), 너무 일찍 마구 누르면 흐트러진다
	local R = Config.RHYTHM
	local meChar = myChar()
	local tier = meChar and tonumber(meChar:GetAttribute("Awaken")) or 0
	local function nextSlot(): any
		if lastComboSlot == #style.combo and tier >= 1 then
			return "F"
		elseif type(lastComboSlot) == "number" and lastComboSlot < #style.combo then
			return lastComboSlot + 1
		end
		return 1
	end
	local root = myRoot()
	if busy() then
		local frac = (now - actStart) / math.max(0.05, actDur)
		if frac < R.early then
			earlyPresses += 1
			if earlyPresses >= (R.earlyLimit or 2) and not comboBroken then
				comboBroken = true
				if root then
					Fx.text(root.Position + Vector3.new(0, 4, 0), "흐트러짐", Color3.fromRGB(200, 190, 180), 22, 0.6)
				end
			end
			return
		end
		if comboBroken or type(lastComboSlot) ~= "number" and lastComboSlot ~= "F" then
			return
		end
		buffered = { slot = nextSlot(), at = now, perfect = frac >= R.perfectFrom }
		return
	end
	local ended = actStart + actDur
	if comboBroken then
		-- 흐트러지면 잠깐 숨을 고른 뒤 처음부터
		if now < ended + R.breakLock then
			return
		end
		comboBroken = false
		lastComboSlot = nil
		perfectChain = 0
	end
	local slot: any = 1
	if (type(lastComboSlot) == "number" or lastComboSlot == "F") and now - ended <= Config.COMBO_WINDOW and lastComboSlot ~= "F" then
		slot = nextSlot()
		nextPerfect = now - ended <= R.late
	end
	startMove(slot)
end

local function heavyDown()
	if not canAct() then
		return
	end
	local style = myStyle()
	if style and style.charge then
		chargeStart = os.clock()
		local char = myChar()
		if char then
			Anim.setLoop(char, "double_palm", 3)
			local root = myRoot()
			if root then
				Fx.ring(root.Position - Vector3.new(0, 2.5, 0), style.color, 2, 8, 0.5)
			end
		end
		return
	end
	startMove("H")
end

local function heavyUp()
	if not chargeStart then
		return
	end
	local style = myStyle()
	local held = os.clock() - (chargeStart :: number)
	chargeStart = nil
	local char = myChar()
	if char then
		Anim.setLoop(char, nil)
	end
	if style then
		startMove("H", math.clamp(held, 0, style.charge or 1.5))
	end
end

local function skill(slot: string)
	if canAct() then
		startMove(slot)
	end
end

local function guardDown()
	if training == "dummy" then
		UI.trainPress()
		return
	end
	if dead or os.clock() < stunUntil or busy() then
		return
	end
	guarding = true
	Request:FireServer("guard", true)
end
local function guardUp()
	if guarding then
		guarding = false
		Request:FireServer("guard", false)
	end
end

local function dash()
	local style = myStyle()
	local root = myRoot()
	local hum = myHum()
	local char = myChar()
	if not root or not hum or not char or dead or os.clock() < stunUntil then
		return
	end
	local now = os.clock()
	local cd = style and style.dashCd or Config.DASH_CD
	local charges = style and style.dashCharges or 1
	if now - dashAt > cd then
		dashUsed = 0
	end
	if dashUsed >= charges then
		return
	end
	dashUsed += 1
	dashAt = now
	guardUp()
	actSeq = -1
	actDur = 0
	local dir = hum.MoveDirection.Magnitude > 0.1 and flat(hum.MoveDirection) or flat(root.CFrame.LookVector)
	-- 카메라 기준으로 앞/뒤/옆을 가려 동작을 바꾼다 (뒤 = 공중제비, 옆 = 구르기)
	local cam = workspace.CurrentCamera
	local camLook = cam and flat(cam.CFrame.LookVector) or flat(root.CFrame.LookVector)
	local along = dir:Dot(camLook)
	local kind = "front"
	if hum.MoveDirection.Magnitude > 0.1 and along < -0.5 then
		kind = "back"
	elseif hum.MoveDirection.Magnitude > 0.1 and math.abs(along) <= 0.5 then
		kind = camLook:Cross(dir).Y < 0 and "right" or "left"
	end
	if kind == "front" then
		root.CFrame = CFrame.lookAt(root.Position, root.Position + dir)
	else
		root.CFrame = CFrame.lookAt(root.Position, root.Position + camLook)
	end
	-- 빠를수록 멀리 (걸음 빠르기에 맞춰, 너무 멀지는 않게)
	local fast = math.clamp(hum.WalkSpeed / Config.WALK_SPEED, 1, Config.DASH_SPEED_MAX)
	push(dir * Config.DASH_SPEED * fast + (kind == "back" and Vector3.new(0, 18, 0) or Vector3.zero), Config.DASH_TIME)
	local pose = kind == "back" and "backflip" or (kind == "right" and "side_roll_r" or (kind == "left" and "side_roll_l" or "dash"))
	Anim.play(char, pose, kind == "front" and 0.28 or 0.4)
	Fx.afterimage(char, style and style.color or Color3.new(1, 1, 1), 0.3)
	Fx.limbTrails(char, pose, 0.35, style and style.color or Color3.new(1, 1, 1), style and style.color2 or Color3.new(1, 1, 1))
	Fx.ring(root.Position - Vector3.new(0, 2.5, 0), style and style.color or Color3.new(1, 1, 1), 2, 8, 0.3)
	Fx.sound("swing", 0.4, 1.6)
	Request:FireServer("dash", kind)
end

local function doubleJump()
	local root = myRoot()
	local hum = myHum()
	local char = myChar()
	if not root or not hum or not char or dead or airJumped then
		return
	end
	if hum.FloorMaterial ~= Enum.Material.Air then
		return
	end
	airJumped = true
	root.AssemblyLinearVelocity = Vector3.new(root.AssemblyLinearVelocity.X, Config.DOUBLE_JUMP, root.AssemblyLinearVelocity.Z)
	Anim.play(char, "double_jump", 0.45)
	local style = myStyle()
	Fx.ring(root.Position - Vector3.new(0, 2.5, 0), style and style.color or Color3.new(1, 1, 1), 2, 9, 0.35)
	Fx.sound("jump", 0.5, 1.3)
	Request:FireServer("djump")
end

-- Shift를 누르고 있으면 달린다
local function setSprint(on: boolean)
	if sprinting == on then
		return
	end
	sprinting = on
	local char = myChar()
	if char then
		char:SetAttribute("Sprint", on or nil)
	end
	Request:FireServer("sprint", on)
end

local doEmote: (string) -> () = function(_id: string) end

------------------------------------------------------------------------
-- 입력
------------------------------------------------------------------------
UserInputService.InputBegan:Connect(function(input: InputObject, processed: boolean)
	if processed or Cutscene.active or Gacha.active then
		return
	end
	local t = input.UserInputType
	local k = input.KeyCode
	if t == Enum.UserInputType.MouseButton1 then
		attack()
	elseif k == Enum.KeyCode.Z then
		heavyDown()
	elseif k == Enum.KeyCode.E then
		skill("E")
	elseif k == Enum.KeyCode.R then
		skill("R")
	elseif k == Enum.KeyCode.G then
		skill("G")
	elseif k == Enum.KeyCode.X then
		-- 초 오의 (초월 권법만)
		local st = myStyle()
		if st and st.skills.X then
			skill("X")
		end
	elseif k == Enum.KeyCode.Q then
		dash()
	elseif k == Enum.KeyCode.F then
		guardDown()
	elseif k == Enum.KeyCode.H then
		Request:FireServer("potion")
	elseif k == Enum.KeyCode.Space then
		if training and training ~= "bamboo" then
			UI.trainPress()
		else
			doubleJump()
		end
	elseif k == Enum.KeyCode.Tab then
		UI.openPage("stats")
	elseif k == Enum.KeyCode.M then
		UI.toggleMap()
	elseif k == Enum.KeyCode.V then
		Request:FireServer("mount")
	elseif k == Enum.KeyCode.One or k == Enum.KeyCode.Two or k == Enum.KeyCode.Three or k == Enum.KeyCode.Four then
		-- 몸짓: 서서 할 수 있는 동작
		if not busy() and not dead and not guarding and not training then
			local id = ({ [Enum.KeyCode.One] = "salute", [Enum.KeyCode.Two] = "taunt", [Enum.KeyCode.Three] = "kata", [Enum.KeyCode.Four] = "meditate" })[k]
			if id then
				doEmote(id)
			end
		end
	elseif k == Enum.KeyCode.LeftShift or k == Enum.KeyCode.RightShift then
		setSprint(true)
	end
end)
UserInputService.InputEnded:Connect(function(input: InputObject)
	if input.KeyCode == Enum.KeyCode.Z then
		heavyUp()
	elseif input.KeyCode == Enum.KeyCode.F then
		guardUp()
	elseif input.KeyCode == Enum.KeyCode.LeftShift or input.KeyCode == Enum.KeyCode.RightShift then
		setSprint(false)
	end
end)
UI.mobile({
	attack = attack,
	heavyDown = heavyDown,
	heavyUp = heavyUp,
	guardDown = guardDown,
	guardUp = guardUp,
	dash = dash,
	E = function()
		skill("E")
	end,
	R = function()
		skill("R")
	end,
	G = function()
		skill("G")
	end,
	X = function()
		local st = myStyle()
		if st and st.skills.X then
			skill("X")
		end
	end,
	potion = function()
		Request:FireServer("potion")
	end,
	train = function()
		UI.trainPress()
	end,
	mount = function()
		Request:FireServer("mount")
	end,
})

-- 땅에 닿으면 두 번 뛰기·낙하격을 되살린다. 세게 떨어지면 내려앉는 자세
local fallSpeed = 0
RunService.Heartbeat:Connect(function()
	local hum = myHum()
	local root = myRoot()
	if not hum or not root then
		return
	end
	if hum.FloorMaterial ~= Enum.Material.Air then
		airJumped = false
		airAttacked = false
		airJ = 0
		if fallSpeed > 55 and not busy() and not dead then
			local char = myChar()
			if char then
				Anim.play(char, "land", 0.35)
				Fx.dust(root.Position - Vector3.new(0, 2.6, 0), 2.5)
				shake(0.3)
			end
		end
		fallSpeed = 0
	else
		fallSpeed = math.max(fallSpeed, -root.AssemblyLinearVelocity.Y)
	end
end)


------------------------------------------------------------------------
-- 서버 소식
------------------------------------------------------------------------
local handlers: { [string]: (...any) -> () } = {}

local function modelPos(m: Model?): Vector3?
	local r = m and rootOf(m)
	return r and r.Position or nil
end

-- 처음 들어온 사람: 조작 안내 한 번 (첫 컷씬이 끝난 뒤)
local controlsShown = false
local function maybeControls()
	if controlsShown or not state or (state.seen and state.seen.controls) then
		return
	end
	controlsShown = true
	Cutscene.controls(function()
		Request:FireServer("seen", "controls")
	end)
end
-- 2.7.6판: 일월신권은 밤이 되면 달의 테마로 (빛깔·표시·기술 이름). 낮과 밤은 온 세상이 같다
task.spawn(function()
	local Lighting = game:GetService("Lighting")
	local was: boolean? = nil
	while true do
		local night = Config.isNightClock(Lighting.ClockTime)
		if night ~= was then
			local first = was == nil
			was = night
			Config.setIlwolNight(night)
			if state then
				pcall(UI.setState, state)
				if not first and state.style == "ilwol" then
					UI.toast(night and "🌙 밤이 되었다. 일월신권이 달의 힘으로 바뀐다 (받는 피해 -15%)" or "☀ 해가 떴다. 일월신권이 해의 힘으로 바뀐다 (주는 피해 +15%)")
				end
			end
		end
		task.wait(0.5)
	end
end)
local firstState = true
function handlers.state(data: any)
	state = data
	UI.setState(data)
	if firstState then
		firstState = false
		task.delay(2.5, function()
			if not Cutscene.active then
				maybeControls()
			end
		end)
	end
end

-- 중요한 장면: 서버가 고른 컷씬 (처음 한 번만)
function handlers.cutscene(data: any)
	local scene = Config.CUTSCENES[data.id]
	if not scene then
		return
	end
	if state and state.seen then
		state.seen[data.id] = true
	end
	Cutscene.play(scene, { m = data.m, at = data.at }, data.id == "intro" and maybeControls or nil)
end

-- 천층탑
function handlers.tower(data: any?)
	UI.setTower(data)
	if data then
		local boss = data.boss == true
		UI.banner(string.format("🗼 %d층", data.floor), boss and "👹 이 층의 주인이 기다린다" or "모든 적을 쓰러뜨려라", boss and Color3.fromRGB(255, 90, 70) or Color3.fromRGB(255, 210, 120))
	end
end
function handlers.towerClear(data: any)
	local extra = (data.scrolls or 0) > 0 and string.format("  📜 +%d", data.scrolls) or ""
	if (data.stats or 0) > 0 then
		extra ..= string.format("  💪 +%s", Config.formatNumber(data.stats))
	end
	if (data.gems or 0) > 0 then
		extra ..= string.format("  💎 +%d", data.gems)
	end
	UI.banner(string.format("🗼 %d층 돌파!", data.floor), string.format("💰 +%s%s  ·  최고 %d층", Config.formatNumber(data.coins), extra, data.best), Color3.fromRGB(255, 210, 120))
	Fx.sound("ping", 0.8, 1.2)
end

-- 1.7판 구름 미궁
local lastMazeRoom = 0
function handlers.maze(data: any?)
	UI.setMaze(data)
	if not data then
		lastMazeRoom = 0
		return
	end
	if data.room ~= lastMazeRoom and not data.cleared then
		lastMazeRoom = data.room
		local sub = ({ wave = "모든 적을 쓰러뜨려라", trap = "차오르는 원을 피하며 적을 쓰러뜨려라", elite = "강한 수호자들이 지킨다", treasure = "보물 상자를 열어라 (T)", boss = "미궁의 주인이 기다린다" })[data.kind] or ""
		UI.banner(string.format("🌀 %d번째 방 · %s", data.room, tostring(data.name)), sub, Color3.fromRGB(190, 225, 255))
	end
end
function handlers.mazeClear(data: any)
	UI.banner("✓ " .. tostring(data.name) .. "을(를) 넘었다", "구름 문이 걷혔다 · 다리를 건너 다음 방으로", Color3.fromRGB(190, 255, 210))
	Fx.sound("ping", 0.7, 1.3)
end
function handlers.mazeDone(data: any)
	if data.first then
		UI.banner("🏆 구름 미궁을 다 넘었다!", string.format("💎 %s  💰 %s  📜 %d  📈 능력치 +%s", Config.formatNumber(data.gems or 0), Config.formatNumber(data.coins or 0), data.scrolls or 0, Config.formatNumber(data.stats or 0)), Color3.fromRGB(255, 220, 120))
	else
		UI.banner("🏆 구름 미궁을 다 넘었다!", string.format("다 넘은 보상은 %d분 뒤에 다시 받을 수 있어요", data.wait or 1), Color3.fromRGB(255, 220, 120))
	end
	Fx.sound("ping", 1, 1)
end

-- 1.7판 천상 레이드
function handlers.raid(data: any?)
	UI.setRaid(data)
end
function handlers.raidAlert(data: any)
	local purple = Color3.fromRGB(210, 130, 255)
	if data.stage == "warn" then
		UI.banner("⚔ 하늘이 갈라진다!", string.format("%d초 뒤 천공 투기장에 %s이(가) 내려온다 · 천궁의 ⚔ 문으로", data.warn or 0, tostring(data.name or "천겁")), purple)
		Fx.sound("heavy", 0.8, 0.5)
		shake(0.6)
	elseif data.stage == "on" then
		UI.banner("⚔ 레이드 · " .. tostring(data.name), string.format("함께 쓰러뜨려라 (체력 ×%.1f · %d분 안에)", 1 + Config.RAID.hpPer * ((data.n or 1) - 1), math.floor((data.life or 0) / 60)), purple)
		Fx.sound("heavy", 1, 0.4)
	elseif data.stage == "win" then
		UI.banner("🏆 천겁을 쓰러뜨렸다!", table.concat(data.top or {}, "   "), Color3.fromRGB(255, 220, 120))
	elseif data.stage == "fail" then
		UI.toast("☁ " .. tostring(data.name) .. "이(가) 하늘로 돌아갔다… 다음에 다시 내려온다")
	end
end
function handlers.raidReward(data: any)
	UI.toast(string.format("⚔ 레이드 보상 (%d위 · 기여 %.1f%%): 💎 %s  💰 %s  📜 %d  📈 능력치 +%s", data.rank or 0, (data.share or 0) * 100, Config.formatNumber(data.gems or 0), Config.formatNumber(data.coins or 0), data.scrolls or 0, Config.formatNumber(data.stats or 0)))
	Fx.sound("ping", 0.9, 1.1)
end

-- 운석 낙하: 하늘에서 불덩이가 떨어지고, 자리에 표시
function handlers.meteor(data: any)
	UI.banner("☄ 운석이 떨어진다!", data.island .. "에 운석 수호수가 나타난다", Color3.fromRGB(200, 150, 255))
	local at: Vector3 = data.at
	local warn = data.warn or 6
	Fx.ring(at - Vector3.new(0, 2.3, 0), Color3.fromRGB(200, 120, 255), 30, 2, warn)
	local ball = Instance.new("Part")
	ball.Anchored = true
	ball.CanCollide = false
	ball.CanQuery = false
	ball.Shape = Enum.PartType.Ball
	ball.Size = Vector3.new(14, 14, 14)
	ball.Material = Enum.Material.Neon
	ball.Color = Color3.fromRGB(255, 160, 90)
	ball.Position = at + Vector3.new(160, 500, -120)
	ball.Parent = workspace
	local fire = Instance.new("Fire")
	fire.Size = 25
	fire.Heat = 20
	fire.Parent = ball
	TweenService:Create(ball, TweenInfo.new(warn, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { Position = at }):Play()
	task.delay(warn, function()
		ball:Destroy()
		Fx.impact(at, Color3.fromRGB(255, 180, 120), 2.6)
		Fx.ring(at - Vector3.new(0, 2, 0), Color3.fromRGB(255, 160, 90), 4, 70, 0.7)
		Fx.debris(at, 16, 30, Color3.fromRGB(80, 60, 70))
		local r = rootOfChar()
		if r and (r.Position - at).Magnitude < 160 then
			shake(2.5)
		end
	end)
end

-- 심법 뽑기 결과
function handlers.manualDraw(results: any)
	UI.manualReveal(results)
	Fx.sound("ping", 0.9, 1.3)
end

-- 2.6판: 자동 뽑기 결과 (연출 없이)
function handlers.manualAuto(data: any)
	UI.manualAutoResult(data)
	if not data.stop then
		Fx.sound("ping", 0.4, 1.6)
	end
end

function handlers.toast(msg: string)
	UI.toast(msg)
end

function handlers.open(data: any)
	UI.openPage(data.page, data)
end

-- 몸짓 (1 포권, 2 도발, 3 권법 시연, 4 명상)
local EMOTES = { salute = { "salute", 1.2 }, taunt = { "taunt", 1.4 }, kata = { "kata", 2.0 }, meditate = { "meditate", 3.0 } }
function handlers.emote(m: Model, id: any, isLocal: boolean?)
	local e = EMOTES[tostring(id)]
	if not e or not m or not m.Parent or (m == myChar() and not isLocal) then
		return
	end
	Anim.play(m, e[1], e[2], { fadeOut = 0.3 })
	local style = Config.STYLE_BY_ID[tostring(m:GetAttribute("Style") or "")]
	local r = rootOf(m)
	if style and r then
		if id == "kata" then
			Fx.limbTrails(m, "kata", e[2], style.color, style.color2)
			for k = 0, 3 do
				task.delay(0.15 + k * 0.4, function()
					Fx.swing(style.id, m, k == 3)
				end)
			end
		elseif id == "meditate" then
			Fx.ring(r.Position - Vector3.new(0, 2.5, 0), style.color, 2, 12, 1.2)
		elseif id == "salute" then
			Fx.ring(r.Position + r.CFrame.LookVector * 1.5, style.color2, 1, 5, 0.4, r.CFrame.LookVector)
		end
	end
end

doEmote = function(id: string)
	local char = myChar()
	if char then
		handlers.emote(char, id, true)
		Request:FireServer("emote", id)
	end
end

-- 심마 대련
function handlers.simma(m: Model)
	local r = m and rootOf(m)
	if r then
		Fx.text(r.Position + Vector3.new(0, 6, 0), "👁 심마", Color3.fromRGB(200, 80, 255), 40, 1.5)
		Fx.ring(r.Position - Vector3.new(0, 2.5, 0), Color3.fromRGB(190, 60, 255), 3, 30, 0.8)
		Fx.afterimage(m, Color3.fromRGB(120, 40, 180), 0.8)
	end
	UI.banner("👁 심마 대련", "마음속의 마귀를 꺾어라", Color3.fromRGB(200, 90, 255))
	shake(0.8)
end
-- 사부의 시험: 사부의 분신이 나타난다
function handlers.trial(data: any)
	local m = data.m
	local s = Config.STYLE_BY_ID[data.style]
	local color = s and s.color or Color3.fromRGB(255, 220, 120)
	local r = m and rootOf(m)
	if r then
		Fx.text(r.Position + Vector3.new(0, 6, 0), data.kind == "duel" and "⚔ 분신" or ("⚔ " .. (data.title or "시험")), color, 40, 1.5)
		Fx.ring(r.Position - Vector3.new(0, 2.5, 0), color, 3, 30, 0.8)
		Fx.afterimage(m, color, 0.8)
	end
	local K = data.kind and Config.TRIAL_KINDS[data.kind]
	UI.banner("⚔ " .. data.name .. "의 " .. (K and K.title or "시험"), K and K.goal or "꺾어라 · 흘리고(F) 반격하라", color)
	shake(0.8)
end
-- 2.1판 흘리기 시험: 사부의 주먹이 닿기 직전, 사부 머리 위에 F가 떠올라 번쩍인다 (번쩍일 때 누르면 흘린다)
function handlers.deflectCue(data: any)
	local m = data and data.m
	local r = m and rootOf(m)
	if not r then
		return
	end
	local hitIn = tonumber(data.t) or 0.5
	local key = UserInputService.TouchEnabled and "🛡" or "F"
	task.delay(math.max(0, hitIn - 0.6), function()
		if not r.Parent then
			return
		end
		local bb = Instance.new("BillboardGui")
		bb.Size = UDim2.fromOffset(90, 90)
		bb.StudsOffsetWorldSpace = Vector3.new(0, 6.5, 0)
		bb.AlwaysOnTop = true
		bb.Adornee = r
		local ring = Instance.new("Frame")
		ring.AnchorPoint = Vector2.new(0.5, 0.5)
		ring.Position = UDim2.fromScale(0.5, 0.5)
		ring.Size = UDim2.fromScale(1, 1)
		ring.BackgroundTransparency = 1
		ring.Parent = bb
		local st = Instance.new("UIStroke")
		st.Thickness = 4
		st.Color = Color3.fromRGB(170, 230, 255)
		st.Parent = ring
		local c = Instance.new("UICorner")
		c.CornerRadius = UDim.new(0.5, 0)
		c.Parent = ring
		local l = Instance.new("TextLabel")
		l.AnchorPoint = Vector2.new(0.5, 0.5)
		l.Position = UDim2.fromScale(0.5, 0.5)
		l.Size = UDim2.fromScale(0.6, 0.6)
		l.BackgroundTransparency = 1
		l.Font = Enum.Font.GothamBlack
		l.Text = key
		l.TextScaled = true
		l.TextColor3 = Color3.fromRGB(200, 235, 255)
		l.TextStrokeTransparency = 0
		l.Parent = bb
		bb.Parent = r
		-- 고리가 좁혀 들어오다가, 눌러야 할 때 노랗게 번쩍
		local lead = math.min(0.6, hitIn)
		TweenService:Create(ring, TweenInfo.new(math.max(0.05, lead - 0.18)), { Size = UDim2.fromScale(0.62, 0.62) }):Play()
		task.delay(math.max(0, lead - 0.2), function()
			if not bb.Parent then
				return
			end
			l.TextColor3 = Color3.fromRGB(255, 240, 120)
			st.Color = Color3.fromRGB(255, 230, 90)
			l.Size = UDim2.fromScale(0.85, 0.85)
			TweenService:Create(l, TweenInfo.new(0.25), { Size = UDim2.fromScale(0.6, 0.6) }):Play()
		end)
		task.delay(lead + 0.15, function()
			bb:Destroy()
		end)
	end)
end
function handlers.trialProg(data: any?)
	UI.setTrial(data)
end
function handlers.simmaWin(data: any)
	UI.banner("👁 심마를 꺾었다!", string.format("모든 능력치 +%d", data.gain or 0), Color3.fromRGB(255, 220, 120))
	Fx.sound("ping", 0.9, 0.9)
end

-- 사부에게 가는 길잡이
function handlers.guide(data: any)
	UI.setGuide(data.style)
end

-- 누군가 기술을 쓴다
function handlers.act(data: any)
	local m: Model = data.m
	if not m or not m.Parent then
		return
	end
	if m == myChar() and data.seq ~= -1 then
		return -- 내 몸은 이미 움직였다
	end
	Anim.play(m, data.pose, data.dur, { align = data.align })
	local style = type(data.style) == "string" and Config.STYLE_BY_ID[data.style]
	if style and data.slot ~= nil then
		Fx.cast(style.id, data.slot, m, data.dur)
		Sakura.cast(style.id, data.slot, m, data.dur)
		Drunk.cast(style.id, data.slot, m, data.dur)
		Reaper.cast(style.id, data.slot, m, data.dur)
		SkillFx.cast(style.id, data.slot, m, data.dur)
		local mv = Config.move(style.id, data.slot, m:GetAttribute("Twilight") == true)
		for _, h in ipairs(mv and mv.hits or {}) do
			task.delay(h.t * (data.dur / math.max(0.05, mv.dur)), function()
				if m.Parent then
					Fx.swing(style.id, m, (h.kb or 0) >= 20)
				end
			end)
		end
	end
	local color = style and style.color or (data.unblockable and Color3.fromRGB(255, 60, 40) or Color3.fromRGB(235, 235, 245))
	Fx.limbTrails(m, data.pose, data.dur, color, style and style.color2 or Color3.new(1, 1, 1))
	local pos = modelPos(m)
	local me = myRoot()
	local near = pos and me and (pos - me.Position).Magnitude < 60
	-- 적이 휘두르기 직전: 무기가 반짝인다 (흘릴 때!), 붉으면 막을 수 없다
	if data.windup and pos then
		if data.unblockable then
			Fx.text(pos + Vector3.new(0, 5, 0), "⚠ 위험", Color3.fromRGB(255, 70, 50), 34, 1.5)
			Fx.ring(pos - Vector3.new(0, 2.5, 0), Color3.fromRGB(255, 50, 40), 3, 14, data.windup)
		end
		task.delay(math.max(0, data.windup - 0.14), function()
			local p2 = modelPos(m)
			if not p2 then
				return
			end
			local blade = nil
			for _, w in ipairs(m:GetChildren()) do
				if w.Name == "Weapon" then
					local b = w:FindFirstChild("Blade")
					if b and b:IsA("BasePart") then
						blade = b
					end
				end
			end
			local at = blade and blade.Position or (p2 + Vector3.new(0, 2, 0))
			Fx.spark(at, data.unblockable and Color3.fromRGB(255, 60, 40) or Color3.fromRGB(255, 255, 230), 0.8, 4)
			if near then
				Fx.sound("ping", 0.35, data.unblockable and 0.6 or 1.6)
			end
		end)
	end
	if type(data.id) == "string" and string.sub(data.id, -1) == "X" and style then
		-- 남의 초 오의: 벚꽃이 쏟아지고 크게 흔들린다
		local r = rootOf(m)
		if r and style.fans then
			Sakura.petals(r.Position + Vector3.new(0, 3, 0), 40, 14, 2.2)
		end
		if near then
			shake(1)
		end
	elseif type(data.id) == "string" and string.sub(data.id, -1) == "G" and style then
		local gm = style.skills and style.skills.G
		if gm and gm.mech then
			Ults.intro(style.id, m)
		else
			Fx.ult(style.id, m, data.dur)
		end
		if near then
			shake(0.8)
		end
	end
end

function handlers.interrupt(m: Model)
	if m == myChar() then
		actSeq = -1
		actDur = 0
		buffered = nil
	end
	Anim.stop(m)
end

-- 정타 반응: 맞힌 기술의 동작 이름으로 맞은 곳을 가늠한다 (차기는 머리·옆, 장·팔꿈치·무릎은 명치, 쓸기는 다리)
local reactTurn = 0
local function reactPose(pose: any, fromRight: boolean): string
	local name = type(pose) == "string" and pose or ""
	reactTurn += 1
	local side = fromRight and "_r" or "_l"
	if string.find(name, "low") or string.find(name, "sweep") or string.find(name, "flop") then
		return "hit_low"
	elseif string.find(name, "roundhouse") or string.find(name, "hook") or string.find(name, "spin") or string.find(name, "crescent") or string.find(name, "swing") then
		return "hit_spin" .. side
	elseif string.find(name, "kick") or string.find(name, "upper") or string.find(name, "snap") or string.find(name, "heel") then
		return "hit_head"
	elseif string.find(name, "palm") or string.find(name, "elbow") or string.find(name, "knee") or string.find(name, "push") or string.find(name, "fist") then
		return reactTurn % 3 == 0 and ("flinch" .. side) or "hit_gut"
	end
	-- 그 밖의 주먹: 머리·옆·몸을 돌아가며
	local k = reactTurn % 3
	return k == 0 and "hit_head" or (k == 1 and ("flinch" .. side) or "hit_gut")
end

-- 맞힘 결과
function handlers.hit(data: any)
	local a: Model, t: Model = data.a, data.t
	local pos: Vector3 = data.pos
	local me = myChar()
	local mine = a == me
	local hurt = t == me
	local aRoot, tRoot = a and rootOf(a), t and rootOf(t)
	local dir = (aRoot and tRoot) and flat(tRoot.Position - aRoot.Position) or Vector3.new(0, 0, -1)
	local kind = data.kind
	if kind == "hit" then
		Polish.hit(data.style, pos, data.heavy == true, data.skill == true, dir)
		local predicted = mine and predictedAt[t] and os.clock() - predictedAt[t] < 0.6
		if not predicted then
			local hs = data.broken and 0.16 or (data.heavy and 0.1 or 0.055)
			-- 기술로 맞히면 한층 묵직하게: 더 긴 멈칫, 권법 빛깔의 타격 섬광, 내 화면이 울린다
			if data.skill then
				hs = math.max(hs, 0.075)
			end
			Fx.hitstop({ a, t }, hs)
			Fx.styleHit(data.style, pos, data.heavy, dir)
			if data.skill then
				local st = Config.STYLE_BY_ID[data.style or ""]
				Fx.blast(pos, st and st.color or Color3.new(1, 1, 1), st and st.color2 or Color3.new(1, 1, 1), data.heavy and 1.5 or 1)
				if mine then
					shake(data.heavy and 0.9 or 0.45)
					fovPunch(-2, 0.12)
				end
			end
			Fx.sound(data.heavy and "heavy" or "hit", data.heavy and 0.9 or 0.6, data.heavy and 0.6 or 0.9, if mine or hurt then nil else pos)
			if t and t:GetAttribute("Poise") ~= true and not data.steady then
				local fromRight = (aRoot and tRoot) and tRoot.CFrame.RightVector:Dot(aRoot.Position - tRoot.Position) > 0 or false
				local pose = data.broken and "knockdown" or (data.heavy and "hit_heavy" or reactPose(data.pose, fromRight))
				Anim.play(t, pose, data.broken and 0.7 or (data.heavy and 0.5 or 0.3))
			end
		elseif data.heavy and t and t:GetAttribute("Poise") ~= true then
			Anim.play(t, data.broken and "knockdown" or "hit_heavy", data.broken and 0.7 or 0.5)
		end
		if data.counter then
			Fx.text(pos + Vector3.new(0, 5.5, 0), "카운터!", Color3.fromRGB(255, 140, 60), 38, 1)
			if mine then
				fovPunch(-5, 0.3)
				UI.flash(Color3.fromRGB(255, 200, 140), 0.18)
			end
		end
		if data.strike then
			Fx.lightning(pos + Vector3.new(math.random(-4, 4), 60, math.random(-4, 4)), pos, Color3.fromRGB(255, 245, 140), 0.7)
		end
		local skillStyle = data.skill and Config.STYLE_BY_ID[data.style or ""]
		local col = data.crit and Color3.fromRGB(255, 220, 80) or (hurt and Color3.fromRGB(255, 90, 80) or (skillStyle and skillStyle.color2:Lerp(Color3.new(1, 1, 1), 0.3) or Color3.new(1, 1, 1)))
		Fx.text(pos + Vector3.new(0, 2, 0), (data.crit and "치명 " or "") .. tostring(math.floor((data.dmg or 0) + 0.5)), col, data.crit and 34 or 26)
		if data.broken then
			Fx.text(pos + Vector3.new(0, 5, 0), "파훼!", Color3.fromRGB(255, 200, 80), 40)
			Fx.ring(pos, Color3.fromRGB(255, 200, 80), 2, 18, 0.45)
			if mine or hurt then
				shake(1.6)
				UI.flash(Color3.fromRGB(255, 220, 140), 0.35)
			end
		end
		if hurt and data.steady then
			-- 전투력 차이: 맞아도 끄떡없다
			Fx.text(pos + Vector3.new(0, 4, 0), "끄떡없다", Color3.fromRGB(200, 220, 255), 24, 0.8)
			shake(0.2)
		elseif hurt then
			shake(data.heavy and 1.4 or 0.6)
			UI.flash(Color3.fromRGB(255, 40, 30), data.heavy and 0.3 or 0.12)
		elseif mine and data.heavy and not predicted then
			shake(0.9)
		end
	elseif kind == "aura" then
		-- 호신강기: 전투력 차이가 너무 커서 약한 적의 공격이 몸에 닿기도 전에 튕겨 나간다
		local ts = t and Config.STYLE_BY_ID[tostring(t:GetAttribute("Style") or "")]
		local c = ts and ts.color or Color3.fromRGB(255, 230, 160)
		Fx.hitstop({ a }, 0.08)
		if tRoot then
			Fx.ring(tRoot.Position, c, 3, 11, 0.35, dir)
			Fx.ring(tRoot.Position - Vector3.new(0, 2.5, 0), Color3.new(1, 1, 1), 2, 9, 0.3)
		end
		Fx.spark(pos, c, 1.4, 8)
		Fx.sound("deflect", 0.5, 1.5)
		Fx.text(pos + Vector3.new(0, 4, 0), "호신강기", c, 30, 0.9)
		if a then
			Anim.play(a, "parried", 0.45)
		end
	elseif kind == "block" or kind == "guardbreak" then
		Fx.hitstop({ a, t }, 0.05)
		Fx.spark(pos, Color3.fromRGB(230, 230, 255), 1, 6)
		Fx.sound("block", 0.5, 0.75)
		if t then
			Anim.play(t, "block_hit", 0.3)
		end
		if kind == "guardbreak" then
			Fx.text(pos + Vector3.new(0, 4, 0), "막기가 깨졌다!", Color3.fromRGB(255, 200, 80), 32)
			Fx.ring(pos, Color3.fromRGB(255, 200, 80), 2, 16, 0.4)
			shake(1.2)
		else
			Fx.text(pos + Vector3.new(0, 2, 0), tostring(math.floor((data.dmg or 0) + 0.5)), Color3.fromRGB(190, 190, 210), 20)
		end
		if hurt then
			shake(0.35)
		end
	elseif kind == "deflect" then
		-- 흘리기: 모든 게 아주 잠깐 멈추고, 차가운 빛이 번쩍
		Fx.hitstop({ a, t }, 0.18)
		Fx.spark(pos, Color3.fromRGB(180, 230, 255), 1.6, 12)
		Fx.ring(pos, Color3.fromRGB(200, 240, 255), 1, 10, 0.3, dir)
		Fx.sound("deflect", 0.8, 1.2 + math.random() * 0.2)
		Fx.text(pos + Vector3.new(0, 4, 0), data.counter and "되받아치기!" or "흘리기!", Color3.fromRGB(170, 230, 255), 36)
		if t and t == myChar() then
			deflectAt = os.clock()
			Fx.text(pos + Vector3.new(0, 7, 0), "지금 클릭 → 반격", Color3.fromRGB(255, 220, 120), 26, 1)
		end
		-- 흘린 쪽은 몸을 돌려 바깥으로 쓸어 내고, 친 쪽은 헛힘에 지나쳐 휘청인다
		local side = (type(data.side) == "number" and data.side < 0) and -1 or 1
		if t then
			Anim.play(t, side > 0 and "parry_r" or "parry_l", 0.6, { fadeOut = 0.2 })
			local ts = Config.STYLE_BY_ID[tostring(t:GetAttribute("Style") or "")]
			Fx.parryArc(t, side, ts and ts.color or Color3.fromRGB(190, 235, 255))
			Fx.limbTrails(t, side > 0 and "parry_r" or "parry_l", 0.5, ts and ts.color or Color3.fromRGB(190, 235, 255), Color3.new(1, 1, 1))
		end
		if a then
			Anim.play(a, "parried", Config.DEFLECT_STAGGER + 0.3, { fadeOut = 0.2 })
		end
		if mine or hurt then
			shake(0.7)
			UI.flash(Color3.fromRGB(170, 220, 255), 0.25)
			tint(Color3.fromRGB(170, 210, 255), 0.35, 0.18)
			fovPunch(-8, 0.35)
		end
	elseif kind == "clash" then
		-- 격돌: 주먹과 주먹이 부딪힌다
		Fx.hitstop({ a, t }, 0.14)
		Fx.spark(pos, Color3.fromRGB(255, 240, 200), 2.4, 16)
		Fx.ring(pos, Color3.new(1, 1, 1), 2, 16, 0.4, dir)
		Fx.ring(pos - Vector3.new(0, 2, 0), Color3.fromRGB(255, 220, 160), 2, 22, 0.5)
		Fx.sound("heavy", 1, 0.45)
		Fx.text(pos + Vector3.new(0, 5, 0), "격돌!", Color3.fromRGB(255, 240, 200), 40)
		if mine or hurt then
			shake(1.5)
			UI.flash(Color3.new(1, 1, 1), 0.35)
		end
	elseif kind == "dodge" then
		if t then
			local tt = Config.STYLE_BY_ID[tostring(t:GetAttribute("Style") or "")]
			Fx.afterimage(t, tt and tt.color or Color3.fromRGB(200, 200, 255), 0.35)
		end
		Fx.text(pos + Vector3.new(0, 3, 0), data.drunk and "취보!" or "회피", Color3.fromRGB(220, 220, 255), 26)
	end
end

function handlers.broken(m: Model, secs: number)
	Anim.play(m, "broken", secs)
	local p = modelPos(m)
	if p then
		Fx.text(p + Vector3.new(0, 5, 0), "파훼!", Color3.fromRGB(255, 200, 80), 40)
	end
	if m == myChar() then
		stunUntil = os.clock() + secs
		actSeq = -1
		actDur = 0
	end
end

function handlers.ko(m: Model, _by: Model?)
	Anim.play(m, "knockdown", 1.2)
	local p = modelPos(m)
	if p then
		Fx.dust(p - Vector3.new(0, 2, 0), 3)
		Fx.sound("fall", 0.6, 0.8, p)
	end
	if m == myChar() then
		dead = true
		actSeq = -1
		guarding = false
		UI.setBoss(nil)
		UI.ko(true, Config.BATTLE_MODE and Config.BATTLE.respawn or Config.RESPAWN_TIME)
	end
end

function handlers.respawn()
	dead = false
	stunUntil = 0
	UI.ko(false)
end

function handlers.knock(vel: Vector3, stun: number)
	local root = myRoot()
	if root then
		push(vel, 0.12)
	end
	if stun and stun > 0 then
		stunUntil = math.max(stunUntil, os.clock() + stun)
		actSeq = -1
		actDur = 0
		buffered = nil
	end
end

function handlers.proj(data: any)
	Fx.projectile(data)
end

-- 적이 경직을 버텨 낸다 (곧 되받아친다)
function handlers.poise(m: Model)
	local r = m and m:FindFirstChild("HumanoidRootPart")
	if r and r:IsA("BasePart") then
		Fx.text(r.Position + Vector3.new(0, 5, 0), "버팀!", Color3.fromRGB(255, 160, 80), 30, 1.2)
		Fx.ring(r.Position - Vector3.new(0, 2.5, 0), Color3.fromRGB(255, 150, 70), 2, 12, 0.4)
	end
end

function handlers.dash(m: Model, kind: any)
	if m == myChar() then
		return
	end
	local pose = kind == "back" and "backflip" or (kind == "right" and "side_roll_r" or (kind == "left" and "side_roll_l" or "dash"))
	Anim.play(m, pose, kind == "front" and 0.28 or 0.4)
	local s = Config.STYLE_BY_ID[tostring(m:GetAttribute("Style") or "")]
	Fx.afterimage(m, s and s.color or Color3.new(1, 1, 1), 0.3)
end

function handlers.djump(m: Model)
	if m ~= myChar() then
		Anim.play(m, "double_jump", 0.45)
	end
end

function handlers.blink(m: Model, to: Vector3)
	local p = modelPos(m)
	if p then
		Fx.afterimage(m, Color3.fromRGB(60, 30, 100), 0.4)
	end
	Fx.ring(to - Vector3.new(0, 2.5, 0), Color3.fromRGB(150, 100, 255), 2, 10, 0.3)
	Fx.sound("swing", 0.6, 0.6, to)
end

function handlers.chain(data: any)
	local from = modelPos(data.from)
	if not from then
		return
	end
	for _, m in ipairs(data.to or {}) do
		local p = modelPos(m)
		if p then
			Fx.lightning(from, p, Color3.fromRGB(255, 245, 140), 0.45)
		end
	end
	Fx.text(from + Vector3.new(0, 5, 0), "⚡ 연쇄 번개!", Color3.fromRGB(255, 245, 140), 30)
end

function handlers.bloom(m: Model, radius: number)
	local p = modelPos(m)
	if p then
		Fx.bloom(p - Vector3.new(0, 2, 0), radius)
		Fx.text(p + Vector3.new(0, 5, 0), "🌸 만개!", Color3.fromRGB(255, 150, 200), 36)
		if m == myChar() then
			shake(1)
		end
	end
end

function handlers.heal(m: Model)
	local p = modelPos(m)
	if p then
		Fx.spark(p, Color3.fromRGB(120, 255, 140), 1.2, 8)
		Fx.text(p + Vector3.new(0, 3, 0), "+ 회복", Color3.fromRGB(120, 255, 140), 24)
	end
end

function handlers.trainPose(m: Model, kind0: string?)
	local ti = kind0 and Config.Training[kind0]
	local kind = ti and ti.ui or kind0
	if kind == "waterfall" or kind == "breathing" then
		Anim.setLoop(m, "meditate", 2)
	elseif kind == "mabo" then
		Anim.setLoop(m, "horse_stance", 2.4)
	elseif kind == "ironpalm" then
		Anim.setLoop(m, "palm_strike", 1.0)
	elseif kind == "rock" then
		Anim.setLoop(m, "lift", 1.4)
	else
		Anim.setLoop(m, nil)
	end
end

function handlers.train(data: any)
	if data then
		training = data.kind
		UI.trainStart(data.kind, data.rings, function(grade: string, idx: number?)
			Request:FireServer("trainHit", grade, idx)
		end, data.hard == true)
	else
		training = nil
		UI.trainStop()
	end
end

function handlers.trained(data: any)
	UI.trainResult(data)
	if data.gain > 0 then
		Fx.sound("ping", 0.4, data.grade == "perfect" and 1.8 or 1.3)
		local root = myRoot()
		if root and data.grade == "perfect" then
			local s = myStyle()
			Fx.ring(root.Position - Vector3.new(0, 2.5, 0), s and s.color or Color3.fromRGB(255, 220, 120), 2, 10, 0.4)
		end
	end
end

function handlers.learned(data: any)
	local s = Config.STYLE_BY_ID[data.style]
	if s then
		if data.hidden then
			-- 숨은 권법: 하늘이 갈라진다
			UI.cinematic("🔓 " .. s.name, s.color, 2.6)
			UI.banner("🔓 숨겨진 권법 " .. s.icon .. " " .. s.name, string.format("[%s] %s", s.grade, s.hanja), s.color)
			local char = myChar()
			if char then
				Fx.ult(s.id, char, 1.8)
			end
			shake(1.4)
			Fx.sound("ping", 1, 0.6)
		else
			UI.banner(s.icon .. " " .. s.name .. " 입문!", string.format("[%s] %s · 권법 창에서 바꿔 쓸 수 있다", s.grade, s.hanja), s.color)
		end
		UI.closeWindow()
		UI.setGuide(nil)
	end
end

-- 권법 승급 (깨달음)
function handlers.breakthrough(data: any)
	local s = Config.STYLE_BY_ID[data.style]
	if not s then
		return
	end
	UI.cinematic("⬆ " .. s.name .. " · " .. data.step, s.color, 2.2)
	UI.banner("⬆ " .. data.step .. "!", string.format("%s [%s] 피해가 ×%.2f로 올랐다", s.name, data.grade, data.mult or 1), Config.GRADE_COLOR[data.grade] or s.color)
	local char = myChar()
	if char then
		Fx.ult(s.id, char, 1.6)
	end
	shake(1.2)
	Fx.sound("ping", 1, 0.7)
end

-- 권법마다 다른 기술 장치의 연출
local ultsReady = false
function handlers.skillfx(data: any)
	if not ultsReady then
		ultsReady = true
		Ults.init({ shake = shake, flash = UI.flash, tint = tint })
		Awake.init({ shake = shake, tint = tint })
		Reaper.init({ shake = shake, tint = tint })
		Ult2.init({ shake = shake, tint = tint, flash = UI.flash })
		Awake3.init({ shake = shake, flash = UI.flash })
		Forest.init({ shake = shake })
		Whale.init({ shake = shake })
		Star.init({ shake = shake, flash = UI.flash })
		Mujo.init({ shake = shake, flash = UI.flash })
		Royal.init({ shake = shake, flash = UI.flash })
		Dream.init({ shake = shake, flash = UI.flash })
		Null.init({ shake = shake, flash = UI.flash })
		Ink.init({ shake = shake })
		Blossom.init({ shake = shake })
		Plum.init({ shake = shake, tint = tint })
		Gourd.init({ shake = shake, tint = tint })
		Samsara.init({ shake = shake, tint = tint })
		Geuk.init({ shake = shake, tint = tint, flash = UI.flash })
	end
	-- 3.1판 극 권법의 기술 (평소·황혼)
	if Geuk.handles(data) then
		Geuk.run(data)
		return
	end
	-- 3.6판 무상권 (전부 새로)과 권왕신권의 새 오의·초 오의
	-- 3.7판 사부의 부탁: 차례로 짚은 돌이 빛난다 (그 사람 화면에서만)
	if data.kind == "mqLight" then
		Fx.ring(data.at + Vector3.new(0, 0.5, 0), Color3.fromRGB(255, 236, 170), 2, 14, 0.5)
		Fx.flash(data.at + Vector3.new(0, 4, 0), Color3.fromRGB(255, 236, 170), 24, 3, 0.4)
		Fx.sound("ping", 0.5, 1.5, data.at)
		return
	end
	-- 3.8판 공백권
	if Null.handles(data) then
		Null.run(data)
		return
	end
	-- 3.7판 몽유권
	if Dream.handles(data) then
		Dream.run(data)
		return
	end
	if Mujo.handles(data) then
		Mujo.run(data)
		return
	end
	if Royal.handles(data) then
		Royal.run(data)
		return
	end
	-- 3.0판 환생 권법 넷의 기술과 연타 장치
	if Samsara.handles(data) then
		Samsara.run(data)
		return
	end
	-- 3.4판 초·성하신권의 기술과 별진
	if Star.handles(data) then
		Star.run(data)
		return
	end
	if (data.fx == "gravity" or data.fx == "prism" or data.fx == "sun" or data.fx == "tide" or data.fx == "time") and Ults.variant(data) then
		return
	elseif data.kind == "pulse" and data.fx == "bamboo" then
		Forest.run({ kind = "bambooShoot", at = data.at, radius = data.radius, delay = data.delay, style = data.style })
		return
	elseif Forest.handles(data) then
		Forest.run(data)
		return
	elseif Whale.handles(data) then
		Whale.run(data)
		return
	elseif data.kind == "pulse" and data.fx == "ink" then
		Ink.run({ kind = "inkPulse", at = data.at, radius = data.radius, delay = data.delay, style = data.style })
		return
	elseif Ink.handles(data) then
		Ink.run(data)
		return
	elseif data.kind == "pulse" and data.fx == "plum" then
		Plum.run({ kind = "plumPulse", at = data.at, radius = data.radius, delay = data.delay, style = data.style })
		return
	elseif data.kind == "pulse" and data.fx == "wine" then
		Gourd.run({ kind = "winePulse", at = data.at, radius = data.radius, delay = data.delay, style = data.style })
		return
	elseif Plum.handles(data) then
		Plum.run(data)
		return
	elseif Gourd.handles(data) then
		Gourd.run(data)
		return
	elseif Blossom.handles(data) then
		Blossom.run(data)
		return
	elseif data.kind == "pulse" and data.fx == "bloom" then
		Awake3.run({ kind = "thornPulse", at = data.at, radius = data.radius, delay = data.delay, style = data.style })
		return
	elseif data.kind == "strike" and data.fx == "sword" then
		Ults.run({ kind = "sword", at = data.at, radius = data.radius, style = data.style })
		return
	elseif data.kind == "pillar" and data.fx == "spear" then
		Ults.spear(data.at, data.dir or Vector3.new(0, 0, -1), data.style)
		return
	elseif Sakura.handles(data.kind) then
		Sakura.run(data)
		return
	elseif Drunk.handles(data) then
		Drunk.run(data)
		return
	elseif Awake.handles(data) then
		Awake.run(data)
		return
	elseif Reaper.handles(data) then
		Reaper.run(data)
		return
	elseif Awake3.handles(data) then
		Awake3.run(data)
		return
	elseif Ult2.handles(data) then
		Ult2.run(data)
		return
	elseif Ults.handles(data.kind) then
		Ults.run(data)
		return
	end
	Fx.mech(data)
	if data.kind == "drop" or data.kind == "beam" or data.kind == "freeze" then
		local r = myRoot()
		if r and data.at and (r.Position - data.at).Magnitude < 60 then
			shake(data.kind == "freeze" and 0.6 or 1.3)
		end
	end
end

-- 개천신권: 별이 떨어진다
function handlers.star(data: any)
	local s = Config.STYLE_BY_ID[tostring(data.style)]
	if s and s.fx == "celestial" then
		-- 천제신권 천위: 하늘에서 빛의 검
		Ults.run({ kind = "sword", at = data.at, radius = 7, style = data.style })
	else
		Fx.starfall(data.at, data.style)
	end
end

-- 이야기
function handlers.dialog(data: any)
	UI.dialog(data)
	Fx.sound("ping", 0.4, 1.2)
end

function handlers.storyDone(data: any)
	local parts = {}
	if data.coins and data.coins > 0 then
		table.insert(parts, "💰 +" .. Config.formatNumber(data.coins))
	end
	if data.stats and data.stats > 0 then
		table.insert(parts, string.format("모든 능력치 +%d", data.stats))
	end
	UI.banner("📜 " .. data.title .. " 완료", table.concat(parts, "  ") .. (data.next and ("  ·  다음: " .. data.next) or ""), Color3.fromRGB(255, 200, 110))
	Fx.sound("ping", 0.8, 1)
end

-- 다음 이야기가 왔다: 받으면 목표가 보인다
function handlers.storyOffer(data: any)
	task.delay(1.2, function()
		UI.dialog({ who = "📜 새 이야기 · " .. tostring(data.chapter) .. "장", title = data.title, text = data.text, accept = true })
	end)
end

-- 로벅스 상품을 샀다
function handlers.premium(data: any)
	local it = Config.PREMIUM_BY_ID[data.id]
	if it then
		UI.banner("💎 " .. it.name, "고마워요! 지금부터 바로 적용돼요", Color3.fromRGB(255, 210, 90))
		Fx.sound("ping", 0.9, 1.1)
	end
end

function handlers.storyProg(data: any)
	if state then
		state.prog = data.prog
		UI.refreshWorld(state)
	end
end

function handlers.found(data: any)
	local s = Config.STYLE_BY_ID[data.style]
	-- 사부를 처음 만나는 장면: 사부의 한마디
	local m = Config.MASTERS[data.style]
	if m and m.quote then
		Cutscene.play({ who = m.name, lines = { m.quote } }, { at = m.at })
	end
	UI.banner("🏯 사부를 찾았다: " .. data.master, (s and (s.icon .. " " .. s.name .. "의 주인 · ") or "") .. data.region .. " · 하늘로 빛기둥이 솟았다", s and s.color or nil)
	Fx.sound("ping", 0.7, 0.9)
end

function handlers.fragment(data: any)
	UI.banner(string.format("📖 비급 조각 %d / %d", data.n, data.total), data.n >= data.total and "조각이 하나로 모였다..." or "옛 고수의 글씨가 희미하게 빛난다", Color3.fromRGB(255, 230, 160))
	Fx.sound("ping", 0.8, 1.1)
end

function handlers.trialWin(data: any)
	local s = Config.STYLE_BY_ID[data.style]
	UI.cinematic("⚔ 시험 통과", s and s.color or Color3.fromRGB(255, 220, 120), 1.6)
	UI.banner("⚔ " .. data.master .. "의 시험 통과!", "사부 곁에서 T를 눌러 " .. (s and s.name or "") .. "을(를) 배워라", s and s.color or nil)
end

function handlers.mastery(data: any)
	local s = Config.STYLE_BY_ID[data.style]
	if data.awaken and s then
		-- 각성! 하늘로 빛이 솟고 화면이 갈라진다
		local a = Config.AWAKEN[data.awaken]
		UI.cinematic(a.mark .. " " .. s.name .. " " .. a.name, s.color, 2.2)
		UI.banner(a.mark .. " " .. a.name .. "!", data.awaken == 1 and "기술이 세지고, 연타 다섯 번째 '" .. s.finisher.name .. "'가 열렸다" or "모든 기술이 세지고, 그림자 메아리가 기술을 한 번 더 되풀이한다", s.color)
		local char = myChar()
		if char then
			Fx.ult(s.id, char, 1.6)
		end
		shake(1.2)
		Fx.sound("ping", 0.9, 0.8)
		return
	end
	UI.banner(string.format("%s 숙련 %d", s and s.name or "", data.lv), data.unlocked and ("새 기술: " .. data.unlocked) or nil, s and s.color or nil)
	Fx.sound("ping", 0.6, 1.5)
end

-- 완전 각성: 그림자 메아리가 같은 기술을 되풀이한다
function handlers.echo(data: any)
	local m = data.m
	if m and m.Parent then
		Fx.echo(m, data.style, data.slot, data.dur)
	end
end

-- 見切り: 맞기 직전에 피했다 (시간이 멈춘 듯)
function handlers.pdodge(data: any)
	local m, a = data.m, data.a
	local r = m and rootOf(m)
	if r then
		Fx.text(r.Position + Vector3.new(0, 5, 0), "간파!", Color3.fromRGB(180, 230, 255), 38, 1.2)
		Fx.ring(r.Position - Vector3.new(0, 2.5, 0), Color3.fromRGB(180, 230, 255), 2, 18, 0.5)
		Fx.afterimage(m, Color3.fromRGB(180, 230, 255), 0.5)
	end
	if a then
		Fx.hitstop({ a }, 0.35)
	end
	if m == myChar() then
		deflectAt = os.clock()
		fovPunch(-10, 0.5)
		tint(Color3.fromRGB(160, 200, 255), 0.4, 0.45)
		UI.flash(Color3.fromRGB(200, 230, 255), 0.2)
		Fx.sound("deflect", 0.8, 0.7)
	end
end

function handlers.reward(data: any)
	local st = (data.stats or 0) > 0 and ("  📈 능력치 +" .. Config.formatNumber(data.stats)) or ""
	UI.toast(string.format("%s 쓰러뜨림  💰 +%d  숙련 +%d%s%s", data.name, data.coins, data.xp, st, (data.gems or 0) > 0 and string.format("  💠 +%d", data.gems) or ""))
	if data.boss then
		UI.banner("🏆 " .. data.name .. " 격파!", string.format("💰 +%d%s", data.coins, st), Color3.fromRGB(255, 210, 120))
	end
end

local bossNow: Model? = nil
function handlers.boss(m: Model?)
	UI.setBoss(m)
	bossNow = m
	-- 그 보스와 처음 맞붙을 때: 짧은 컷씬 (보는 동안은 맞지 않는다)
	local id = m and m:GetAttribute("TypeId")
	local key = type(id) == "string" and ("boss_" .. id) or nil
	if m and key and Config.CUTSCENES[key] and state and state.seen and not state.seen[key] then
		state.seen[key] = true
		Request:FireServer("seen", key)
		Cutscene.play(Config.CUTSCENES[key], { m = m })
	end
end

-- 배경 음악: 탑 / 보스 / 있는 곳
task.spawn(function()
	while true do
		task.wait(1)
		pcall(function()
			local r = rootOfChar()
			local key = "default"
			if UI.towerActive then
				key = bossNow and bossNow.Parent and "boss" or "tower"
			elseif bossNow and bossNow.Parent and bossNow:GetAttribute("Dead") ~= true then
				key = "boss"
			elseif r and r.Position.Y > Config.SKY.y - 300 then
				key = "skyworld"
			elseif r then
				local reg = UI.regionAt(r.Position)
				key = reg and reg.id or "default"
			end
			Music.set(key)
		end)
	end
end)

function handlers.bossPhase(m: Model, name: string, phase: number?)
	local ph = phase or 2
	UI.cinematic("👹 " .. name .. " · " .. ph .. "단계", Color3.fromRGB(255, 60, 40), 1.6)
	UI.banner("👹 " .. name .. " · " .. ph .. "단계", ph >= 3 and "마지막 발악! 모든 패턴을 쓴다" or "분노했다! 빨라지고 새 패턴이 열린다", Color3.fromRGB(255, 80, 60))
	local r = m and rootOf(m)
	if r then
		Fx.ring(r.Position - Vector3.new(0, 2.5, 0), Color3.fromRGB(255, 60, 40), 4, 60, 0.7)
		Fx.afterimage(m, Color3.fromRGB(255, 40, 30), 0.8)
	end
	shake(1.4)
	UI.bossPhase(ph)
end

-- 보스가 패턴 이름을 외친다
function handlers.bossCall(data: any)
	local r = data.m and rootOf(data.m)
	if r then
		local scale = tonumber(data.m:GetAttribute("Scale")) or 2
		Fx.text(r.Position + Vector3.new(0, 6 + scale * 2, 0), "⚠ " .. data.name, Color3.fromRGB(255, 120, 90), 36, 1.2)
	end
end

function handlers.afterimage(m: Model)
	if m and m.Parent then
		Fx.afterimage(m, Color3.fromRGB(255, 50, 40), 0.5)
	end
end

-- 3.3판 배틀그라운드: 판 상태 (맵·남은 시간·순위), 쓰러뜨림 알림, 판 끝, 알림
function handlers.battle(data: any)
	UI.battleState(data, player.UserId)
end
function handlers.battleKill(data: any)
	local me = player.DisplayName
	local streak = (data.streak or 0) >= 3 and string.format("  🔥 %d연속", data.streak) or ""
	if data.killer then
		UI.toast(string.format("⚔ %s → %s%s", data.killer, data.victim, streak))
		if data.killer == me then
			UI.banner("⚔ 쓰러뜨렸다", data.victim .. streak, Color3.fromRGB(255, 200, 100))
		end
	else
		UI.toast(string.format("💀 %s 쓰러짐", data.victim))
	end
end
function handlers.battleRound(data: any)
	local who = data.winner and string.format("🏆 %s (%d명)", data.winner, data.kills or 0) or "이긴 사람 없음"
	UI.banner("⚔ " .. tostring(data.map) .. " 끝", who .. "  ·  다음: " .. tostring(data.next), Color3.fromRGB(255, 210, 120))
end
function handlers.battleNote(data: any)
	UI.toast(data.text)
end

function handlers.duel(data: any)
	UI.toast(string.format("⚔ %s: %s 승, %s 패", data.ring == false and "들판 PvP" or "비무대", data.winner, data.loser))
end

-- 1.9판: 업적을 이뤘다
function handlers.ach(data: any)
	local a = Config.ACH_BY_ID[data.id]
	if not a then
		return
	end
	local parts = {}
	if a.coins then
		table.insert(parts, "💰 +" .. Config.formatNumber(a.coins))
	end
	if a.gems then
		table.insert(parts, "💎 +" .. Config.formatNumber(a.gems))
	end
	if a.scrolls then
		table.insert(parts, "📜 +" .. a.scrolls)
	end
	if a.title then
		table.insert(parts, "칭호 「" .. a.title .. "」 (🏆 업적에서 달기)")
	end
	UI.banner("🏆 업적: " .. a.icon .. " " .. a.name, table.concat(parts, "  "), Config.ACH_COLOR[a.kind] or Color3.fromRGB(255, 220, 120))
	Fx.sound("ping", 0.9, 1.25)
end

-- 1.9판: 누군가 환생한다. 빛기둥이 솟고, 몸이 한순간 하얗게 비었다가 환생 빛깔로 다시 차오른다
function handlers.rebirth(data: any)
	local m: Model? = data.m
	local r = m and rootOf(m)
	if not r then
		return
	end
	local col = Config.REBIRTH.colors[data.n or 1] or Color3.new(1, 1, 1)
	local base = r.Position - Vector3.new(0, 2.8, 0)
	local pillar = Instance.new("Part")
	pillar.Anchored = true
	pillar.CanCollide = false
	pillar.CanQuery = false
	pillar.CanTouch = false
	pillar.Material = Enum.Material.Neon
	pillar.Color = col
	pillar.Shape = Enum.PartType.Cylinder
	pillar.Transparency = 0.15
	pillar.Size = Vector3.new(400, 1, 1)
	pillar.CFrame = CFrame.new(base + Vector3.new(0, 200, 0)) * CFrame.Angles(0, 0, math.rad(90))
	pillar.Parent = workspace
	TweenService:Create(pillar, TweenInfo.new(0.35, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Size = Vector3.new(400, 14, 14) }):Play()
	task.delay(0.5, function()
		TweenService:Create(pillar, TweenInfo.new(1.4, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { Size = Vector3.new(400, 0.2, 0.2), Transparency = 1 }):Play()
	end)
	task.delay(2.2, function()
		pillar:Destroy()
	end)
	for i = 0, 2 do
		task.delay(i * 0.25, function()
			Fx.ring(base + Vector3.new(0, 0.3, 0), col, 4, 40 + i * 14, 1.1)
		end)
	end
	Fx.burst("spark", r.Position, col, 50, 2.4)
	Fx.flash(r.Position, col, 50, 6, 1.6)
	Fx.sound("deflect", 1, 0.45, r.Position)
	if m ~= myChar() then
		UI.toast(string.format("♻ %s, %s 환생!", data.name or "", Config.REBIRTH.names[data.n or 1] or ""))
	end
end
-- 3.1판: 극 패시브 일월극변 (서버 전체 컷씬)
function handlers.geukTwilight(data: any)
	Geuk.init({ shake = shake, tint = tint, flash = UI.flash })
	UI.banner(string.format("🌗 일월극변 · %s", data.name or ""), "해와 달이 미쳐 날뛰다가 세상이 황혼에 멈춘다. 황혼 동안 그의 기술이 모두 바뀐다", Color3.fromRGB(255, 140, 80))
	Geuk.twilight(data)
end
-- 3.1판: 윤회대 제단의 환생 의식 (모두에게 보인다)
function handlers.rebirthRite(data: any)
	Samsara.init({ shake = shake, tint = tint })
	Samsara.rite(data)
end
function handlers.rebirthDone(data: any)
	UI.banner(string.format("♻ %s 환생", data.name or ""), string.format("삼류로 다시 태어났다 · 피해·체력 +%d%% · 얻는 능력치 +%d%% · %s의 경지가 열렸다 · 💰 +%s · 공덕 +%d (남은 공덕 %d)", data.power or 0, data.gain or 0, data.realm or "", Config.formatNumber(data.coins or 0), data.perks or 0, data.points or 0), Config.REBIRTH.colors[data.n or 1])
	shake(1.2)
end
-- 2.9판: 윤회의 시련. 그림자가 선 자리에 검보랏빛 바퀴가 돈다
function handlers.samsaraStart(data: any)
	local m = data.m
	local root = m and m:FindFirstChild("HumanoidRootPart")
	if not root then
		return
	end
	local col = Config.REBIRTH.colors[data.n or 1] or Color3.new(1, 1, 1)
	local at = root.Position - Vector3.new(0, 3, 0)
	Fx.ring(at, col, 4, 40, 1.2)
	Fx.ring(at, Color3.fromRGB(60, 20, 80), 2, 26, 1.6)
	Fx.burst("spark", root.Position, col, 40, 2)
	Fx.breakSound("boom", 0.8, 0.6, root.Position)
	shake(0.6)
end
function handlers.samsaraWon(data: any)
	local st = data.style and Config.STYLE_BY_ID[data.style]
	UI.banner(string.format("☯ 윤회의 시련 %d 통과", data.n or 1), string.format("지난 삶을 넘었다 · 공덕 +1 (남은 공덕 %d) · 💎 +%d · 📜 +%d · 💰 +%s%s", data.points or 0, data.gems or 0, data.scrolls or 0, Config.formatNumber(data.coins or 0), st and (" · 그림자가 " .. st.icon .. " " .. st.name .. "을(를) 남겼다") or ""), Config.REBIRTH.colors[data.n or 1])
	shake(1)
end

function handlers.realm(data: any)
	UI.banner(string.format("✨ %s, %s의 경지에 오르다", data.name, data.realm), nil, Color3.fromRGB(255, 220, 140))
end

Push.OnClientEvent:Connect(function(kind: string, ...)
	local f = handlers[kind]
	if f then
		local ok, err = pcall(f, ...)
		if not ok then
			warn("[권왕] 화면 처리 오류:", kind, err)
		end
	end
end)

------------------------------------------------------------------------
-- 매 순간 화면 (막대, 기술 칸)
------------------------------------------------------------------------
RunService.RenderStepped:Connect(function()
	local char = myChar()
	if not char then
		return
	end
	local hp = char:GetAttribute("Hp")
	local mx = char:GetAttribute("MaxHp")
	local po = char:GetAttribute("Posture")
	local pm = char:GetAttribute("PostureMax")
	local chi = char:GetAttribute("Chi")
	if type(hp) == "number" and type(mx) == "number" then
		local cmax = char:GetAttribute("ChiMax")
		UI.bars(hp, mx, type(po) == "number" and po or 0, type(pm) == "number" and pm or 100, type(chi) == "number" and chi or 0, type(cmax) == "number" and cmax or Config.CHI_MAX)
	end
	local style = myStyle()
	if not style then
		UI.styleLine("🥋 권법이 없다", Color3.fromRGB(230, 220, 200), "")
		return
	end
	local now = os.clock()
	local info: { [string]: any } = {
		M1 = { name = style.combo[1].name },
		H = { name = style.heavy.name, cd = math.max(0, ((cds.H or 0) - now) / Config.HEAVY_CD) },
		Q = { name = "대시", cd = math.max(0, (dashAt + (style.dashCd or Config.DASH_CD) - now) / (style.dashCd or Config.DASH_CD)) },
		F = { name = guarding and "막는 중" or "막기·흘리기" },
		P = { name = string.format("금창약 %d", state and state.potions or 0) },
	}
	local twilightNow = char:GetAttribute("Twilight") == true
	if twilightNow and style.twilight then
		info.H.name = style.twilight.heavy.name
	end
	for _, slot in ipairs({ "E", "R", "G", "X" }) do
		local sk = Config.move(style.id, slot, twilightNow)
		if sk then
			local left = (cds[slot] or 0) - now
			local need = sk.chi or 100
			info[slot] = { name = sk.name, locked = not unlocked(slot), cd = left > 0 and left / (cdLen[slot] or 1) or ((slot == "G" or slot == "X") and type(chi) == "number" and chi < need and 1 - chi / need or 0) }
		end
	end
	UI.slots(info)
	-- 권법 장치 표시
	local stacks = ""
	if style.geukGauge then
		-- 3.1판 극 패시브: 극 게이지 (가득 차면 일월극변), 황혼 동안은 표시가 바뀐다
		if twilightNow then
			stacks = "🌇 황혼 · 일월극변 (기술이 모두 바뀌었다)"
		else
			local g = math.clamp(tonumber(char:GetAttribute("Geuk")) or 0, 0, style.geukGauge.max)
			local k = math.floor(g / style.geukGauge.max * 10)
			stacks = string.format("극 %s%s %d", string.rep("▰", k), string.rep("▱", 10 - k), g)
		end
	elseif style.id == "taeheo" then
		stacks = "기류 " .. string.rep("●", tonumber(char:GetAttribute("Flow")) or 0) .. string.rep("○", 3 - (tonumber(char:GetAttribute("Flow")) or 0))
	elseif style.id == "maehwa" or style.petals then
		local n = tonumber(char:GetAttribute("Petal")) or 0
		local cap = style.petalMax or 20
		stacks = n >= cap and (style.petals and "🌸 천앵만개 준비! (Z)" or "🌸 만개 준비! (Z)") or string.format("%s %d / %d", style.petals and "벚꽃" or "꽃잎", n, cap)
	elseif style.noBlock then
		stacks = "🍾 만취 · 막기 ✕ · 흘리기만 ○"
	elseif style.bloodPact then
		local php, pmx = tonumber(char:GetAttribute("Hp")) or 0, tonumber(char:GetAttribute("MaxHp")) or 1
		local k = 1 + style.bloodPact * (1 - math.clamp(php / math.max(1, pmx), 0, 1))
		stacks = string.format("🩸 피의 계약 · 피해 ×%.2f", k)
	elseif style.hurtPulse then
		local n = math.clamp(tonumber(char:GetAttribute("HurtN")) or 0, 0, style.hurtPulse.every)
		stacks = string.format("🗿 불괴 %d / %d (맞으면 쌓인다)", n, style.hurtPulse.every)
	elseif style.shadowEcho then
		stacks = "👤 영각 · 그림자가 한 번 더 찬다"
	elseif style.deflectWave then
		stacks = "🌊 역류 · 흘리면 물결이 터진다"
	elseif style.chargeEvery then
		local n = math.clamp(tonumber(char:GetAttribute("Charge")) or 0, 0, style.chargeEvery)
		stacks = "전하 " .. string.rep("⚡", n) .. string.rep("·", style.chargeEvery - n)
	elseif style.pulse then
		local n = math.clamp(tonumber(char:GetAttribute("Pulse")) or 0, 0, style.pulse.every)
		local mark = ({ gravity = "◆", prism = "✦", eclipse = "☀", tide = "≈", time = "◷", bloom = "❀" })[style.pulse.kind] or "✦"
		stacks = (({ gravity = "중압 ", prism = "창세 ", eclipse = "일월 ", tide = "파도 ", time = "정지 ", bloom = "생장 " })[style.pulse.kind] or "") .. string.rep(mark, n) .. string.rep("·", style.pulse.every - n)
	elseif style.charge and chargeStart then
		stacks = string.format("용기 모으는 중 %d%%", math.floor(math.clamp((now - chargeStart) / (style.charge or 1.5), 0, 1) * 100))
	end
	local buff = char:GetAttribute("Buff")
	if buff == "ironshirt" then
		stacks ..= "  🔔 철포삼"
	elseif buff == "sway" then
		stacks ..= "  🍶 취보"
	end
	local tierNow = tonumber(char:GetAttribute("Awaken")) or 0
	if perfectChain >= 2 then
		stacks ..= string.format("  정타 ×%d", perfectChain)
	end
	if comboBroken then
		stacks ..= "  (흐트러짐)"
	end
	UI.styleLine((tierNow > 0 and (Config.AWAKEN[tierNow].mark .. " ") or "") .. style.icon .. " " .. style.name, style.color, stacks)
end)

-- 몸동작 점검: 내 몸의 관절을 몇 개 붙잡았는지 (못 붙잡으면 동작이 안 보인다)
task.delay(6, function()
	local char = player.Character
	if char then
		local n = Anim.jointCount(char)
		print(string.format("[권왕] 몸동작 관절 %d / 11개 연결", n))
		if n < 8 then
			UI.toast(string.format("⚠ 몸동작 관절을 %d개만 찾았어요. 동작이 제대로 안 보일 수 있어요", n))
		end
	end
end)

Request:FireServer("hello")
]]></string>
        </Properties>
        <Item class="ModuleScript" referent="19">
          <Properties>
            <string name="Name">Anim</string>
            <string name="Source"><![CDATA[-- 권왕: 관절을 직접 움직이는 몸동작 (모든 화면에서, 모든 무인에게)
-- 로블록스 기본 걷기 동작 위에 권법 자세를 얹고, 기술을 쓰면 온몸을 그 동작으로 덮는다
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage:WaitForChild("Config"))
local Poses = require(ReplicatedStorage:WaitForChild("Poses"))

local Anim = {}

type Track = {
	pose: string,
	keys: { any },
	start: number,
	dur: number,
	align: number?,
	alignFrac: number,
	paused: number, -- 멈춘 시간의 합 (히트스톱)
	freezeUntil: number,
	loop: boolean,
	fadeOut: number,
	weight: number,
}

type Rec = {
	model: Model,
	motors: { [string]: any }, -- Motor6D 또는 AnimationConstraint (둘 다 Transform이 있다)
	track: Track?,
	loop: Track?,
	walk: number,
	npc: boolean,
	guardW: number,
	stanceW: number,
	sprintW: number,
	moveW: number,
	airW: number,
	breath: number,
	idleT: number,
	idleNext: number,
	lastActAt: number,
	lastT: number,
	written: { [string]: CFrame }, -- 지난번에 내가 쓴 값 (기본 동작이 안 건드린 관절을 알아보려고)
}

local recs: { [Model]: Rec } = {}
local RAD = math.pi / 180
local ZERO3 = { 0, 0, 0 }
local ZERO6 = { 0, 0, 0, 0, 0, 0 }

------------------------------------------------------------------------
-- 키프레임 다듬기: 빠진 관절은 그 무인의 기본 자세로 채운다
------------------------------------------------------------------------
local filledCache: { [string]: { any } } = {}

local function basePose(stance: string?): { [string]: { number } }
	local base: { [string]: { number } } = {}
	for name in pairs(Poses.MOTORS) do
		base[name] = name == "R" and ZERO6 or ZERO3
	end
	if stance then
		local st = Poses.stances[stance]
		if st then
			for k, v in pairs(st) do
				base[k] = v
			end
		end
		local legs = Poses.stanceLegs[stance] or Poses.stanceLegs.default
		for k, v in pairs(legs) do
			base[k] = v
		end
	end
	return base
end

local function filled(pose: string, stance: string?): { any }?
	local key = pose .. "|" .. (stance or "")
	local cached = filledCache[key]
	if cached then
		return cached
	end
	local raw = Poses.anims[pose]
	if not raw then
		return nil
	end
	local base = basePose(stance)
	local out = {}
	for _, k in ipairs(raw) do
		local j = {}
		for name in pairs(Poses.MOTORS) do
			local v = k.j[name] or base[name]
			if name == "R" then
				j[name] = { v[1] or 0, v[2] or 0, v[3] or 0, v[4] or 0, v[5] or 0, v[6] or 0 }
			else
				j[name] = { v[1] or 0, v[2] or 0, v[3] or 0 }
			end
		end
		table.insert(out, { t = k.t, e = k.e, j = j })
	end
	filledCache[key] = out
	return out
end

local function firstSnap(keys: { any }): number
	for _, k in ipairs(keys) do
		if k.e == "snap" and k.t > 0 then
			return k.t
		end
	end
	return 0.4
end

local function ease(u: number, kind: string?): number
	if kind == "snap" then
		return 1 - (1 - u) ^ 3
	end
	return u * u * (3 - 2 * u)
end

-- 비율 p(0~1)에서의 관절 값
local function sample(keys: { any }, p: number): { [string]: { number } }
	if p <= keys[1].t or #keys == 1 then
		return keys[1].j
	end
	for i = 2, #keys do
		local b = keys[i]
		if p <= b.t then
			local a = keys[i - 1]
			local u = ease((p - a.t) / math.max(1e-4, b.t - a.t), b.e)
			local out = {}
			for name, va in pairs(a.j) do
				local vb = b.j[name]
				local v = {}
				for n = 1, #va do
					v[n] = va[n] + (vb[n] - va[n]) * u
				end
				out[name] = v
			end
			return out
		end
	end
	return keys[#keys].j
end

local function toCF(name: string, v: { number }): CFrame
	local rot = CFrame.fromEulerAnglesYXZ(v[1] * RAD, v[2] * RAD, v[3] * RAD)
	if name == "R" then
		return CFrame.new(v[4], v[5], v[6]) * rot
	end
	return rot
end

------------------------------------------------------------------------
-- 무인 등록
------------------------------------------------------------------------
-- 관절 찾기: 예전 몸은 Motor6D, 새 로블록스 몸(아바타 관절 업그레이드)은 AnimationConstraint.
-- 둘 다 Transform으로 움직이므로 이름만 맞으면 어느 쪽이든 쓴다
local function isJoint(x: Instance?): boolean
	return x ~= nil and (x:IsA("Motor6D") or x:IsA("AnimationConstraint"))
end
local function motorsOf(model: Model): { [string]: any }
	local m = {}
	for name, info in pairs(Poses.MOTORS) do
		local p = model:FindFirstChild(info[1])
		local motor = p and p:FindFirstChild(info[2])
		if not isJoint(motor) then
			-- 다른 곳에 붙어 있을 수도 있다 (몸 전체에서 같은 이름의 관절)
			motor = nil
			for _, d in ipairs(model:GetDescendants()) do
				if d.Name == info[2] and isJoint(d) then
					motor = d
					break
				end
			end
		end
		if motor then
			m[name] = motor
		end
	end
	return m
end

-- 몸동작이 붙은 관절 수 (화면 점검용)
function Anim.jointCount(model: Model): number
	local n = 0
	for _ in pairs(motorsOf(model)) do
		n += 1
	end
	return n
end

function Anim.watch(model: Model)
	if recs[model] then
		return
	end
	local motors = motorsOf(model)
	if not motors.R or not motors.W then
		-- 아직 몸이 다 안 들어왔다
		task.delay(0.5, function()
			if model.Parent and not recs[model] then
				Anim.watch(model)
			end
		end)
		return
	end
	recs[model] = {
		model = model,
		motors = motors,
		track = nil,
		loop = nil,
		walk = 0,
		npc = model:GetAttribute("NPC") == true,
		guardW = 0,
		stanceW = 0,
		sprintW = 0,
		moveW = 0,
		airW = 0,
		breath = math.random() * 6,
		idleT = 0,
		idleNext = 3 + math.random() * 4,
		lastActAt = 0,
		lastT = os.clock(),
		written = {},
	}
	-- 로블록스 기본 동작(Animate)이 관절을 함께 건드리면 손발이 떨린다: 사람 몸에서도 기본 동작을 끈다
	pcall(function()
		local animate = model:FindFirstChild("Animate")
		if animate and model == Players.LocalPlayer.Character and animate:IsA("LocalScript") then
			animate.Enabled = false
		end
		local hum = model:FindFirstChildOfClass("Humanoid")
		local function hook(animator: Instance)
			if animator:IsA("Animator") then
				for _, track in ipairs(animator:GetPlayingAnimationTracks()) do
					track:Stop(0)
				end
				animator.AnimationPlayed:Connect(function(track: AnimationTrack)
					track:Stop(0)
				end)
			end
		end
		if hum then
			local animator = hum:FindFirstChildOfClass("Animator")
			if animator then
				hook(animator)
			end
			hum.ChildAdded:Connect(hook)
		end
	end)
	-- 하늘로 띄워지면 허우적대며 한 바퀴
	model:GetAttributeChangedSignal("LaunchedAt"):Connect(function()
		Anim.play(model, "launched", 0.9)
	end)
end

local function stanceOf(model: Model): string?
	local weapon = model:GetAttribute("Weapon")
	if type(weapon) == "string" then
		return weapon == "spear" and "stance_spear" or "stance_weapon"
	end
	local styleId = model:GetAttribute("Style")
	local style = type(styleId) == "string" and Config.STYLE_BY_ID[styleId]
	return style and style.stance or nil
end

-- 기술 동작 재생. align = 첫 '꽂히는' 순간을 이 초에 맞춘다
function Anim.play(model: Model, pose: string, dur: number, opt: any?)
	Anim.watch(model)
	local rec = recs[model]
	if not rec then
		return
	end
	local keys = filled(pose, stanceOf(model))
	if not keys then
		return
	end
	local o = opt or {}
	if not o.idle then
		rec.lastActAt = os.clock()
	end
	rec.track = {
		pose = pose,
		keys = keys,
		start = os.clock(),
		dur = math.max(0.05, dur),
		align = o.align,
		alignFrac = firstSnap(keys),
		paused = 0,
		freezeUntil = 0,
		loop = false,
		fadeOut = o.fadeOut or 0.12,
		weight = 0,
	}
end

function Anim.stop(model: Model)
	local rec = recs[model]
	if rec then
		rec.track = nil
	end
end

-- 계속 되풀이하는 동작 (명상, 바위 들기). nil이면 끈다
function Anim.setLoop(model: Model, pose: string?, dur: number?)
	Anim.watch(model)
	local rec = recs[model]
	if not rec then
		return
	end
	if not pose then
		rec.loop = nil
		return
	end
	local keys = filled(pose :: string, stanceOf(model))
	if not keys then
		return
	end
	rec.loop = { pose = pose, keys = keys, start = os.clock(), dur = dur or 1.2, align = nil, alignFrac = 0.4, paused = 0, freezeUntil = 0, loop = true, fadeOut = 0, weight = 1 }
end

-- 히트스톱: 잠깐 동작이 멈춘다
function Anim.freeze(model: Model, secs: number)
	local rec = recs[model]
	local tr = rec and rec.track
	if tr then
		tr.freezeUntil = math.max(tr.freezeUntil, os.clock() + secs)
	end
end

function Anim.playing(model: Model): string?
	local rec = recs[model]
	local tr = rec and rec.track
	if tr and os.clock() - tr.start - tr.paused < tr.dur then
		return tr.pose
	end
	return nil
end

------------------------------------------------------------------------
-- 매 순간 (물리 계산 직전: 기본 걷기 동작이 들어간 뒤)
------------------------------------------------------------------------
local function trackPose(tr: Track, t: number, dt: number): ({ [string]: { number } }?, number)
	if t < tr.freezeUntil then
		tr.paused += dt
	end
	local elapsed = t - tr.start - tr.paused
	if tr.loop then
		local p = (elapsed / tr.dur) % 1
		return sample(tr.keys, p), 1
	end
	if elapsed >= tr.dur then
		return nil, 0
	end
	local p
	local a = tr.align
	if a and a > 0 and a < tr.dur then
		if elapsed < a then
			p = elapsed / a * tr.alignFrac
		else
			p = tr.alignFrac + (elapsed - a) / (tr.dur - a) * (1 - tr.alignFrac)
		end
	else
		p = elapsed / tr.dur
	end
	-- 처음엔 재빨리 들어오고, 끝에서 자세로 녹아 돌아간다
	local w = math.min(1, elapsed / 0.05)
	local left = tr.dur - elapsed
	if left < tr.fadeOut then
		w = math.min(w, left / tr.fadeOut)
	end
	return sample(tr.keys, math.clamp(p, 0, 1)), w
end

-- 기본 몸놀림 (사람·적 모두): 가만히 = 가볍게 들썩이는 무인의 호흡, 움직이면 = 걷기·달리기·옆걸음·뒷걸음,
-- 공중 = 오를 땐 무릎을 당기고 내려올 땐 다리를 편다. 관절마다 { X, Y, Z (도), 위치 } 값을 돌려준다
local IDLE: { [string]: { number } } = {
	R = { -2, 0, 0, 0, -0.05, 0 }, W = { 3, 0, 0 }, N = { -3, 0, 0 },
	RS = { 4, 0, 7 }, LS = { 4, 0, -7 }, RE = { 14, 0, 0 }, LE = { 14, 0, 0 },
	RH = { 3, 0, 2 }, LH = { 3, 0, -2 }, RK = { -6, 0, 0 }, LK = { -6, 0, 0 },
}
local function moveJ(name: string, s: number, c: number, f: number, sd: number, amt: number): { number }
	local stride = 40 * amt
	if name == "R" then
		local lean = -(4 + 8 * amt) * math.max(f, 0) + 6 * math.max(-f, 0)
		-- 달릴 때 몸이 좌우로 흔들리지 않게: 걸음마다 옆으로 기울이거나 비틀지 않는다 (옆걸음일 때만 살짝 기운다)
		return { lean, 0, -sd * 6 * amt, 0, -0.12 + math.abs(c) * 0.24 * amt, 0 }
	elseif name == "W" then
		return { 3 * amt, -s * 2 * amt * f, 0 }
	elseif name == "N" then
		return { -3 * amt, 0, sd * 4 }
	elseif name == "RS" then
		return { -s * 44 * amt * f, 0, 9 + math.abs(sd) * 8 }
	elseif name == "LS" then
		return { s * 44 * amt * f, 0, -9 - math.abs(sd) * 8 }
	elseif name == "RE" then
		return { 25 + 40 * amt, 0, 0 }
	elseif name == "LE" then
		return { 25 + 40 * amt, 0, 0 }
	elseif name == "RH" then
		return { s * stride * f, 0, -s * 18 * sd * amt + 3 }
	elseif name == "LH" then
		return { -s * stride * f, 0, s * 18 * sd * amt - 3 }
	elseif name == "RK" then
		return { -(8 + 62 * math.max(0, c)) * amt, 0, 0 }
	elseif name == "LK" then
		return { -(8 + 62 * math.max(0, -c)) * amt, 0, 0 }
	end
	return ZERO3
end
local AIR_UP: { [string]: { number } } = {
	R = { 6, 0, 0, 0, 0.2, 0 }, W = { -4, 0, 0 }, N = { 4, 0, 0 },
	RS = { 40, 0, 35 }, LS = { 40, 0, -35 }, RE = { 50, 0, 0 }, LE = { 50, 0, 0 },
	RH = { 60, 0, 6 }, LH = { 22, 0, -6 }, RK = { -85, 0, 0 }, LK = { -40, 0, 0 },
}
local AIR_DOWN: { [string]: { number } } = {
	R = { -6, 0, 0, 0, 0, 0 }, W = { 6, 0, 0 }, N = { -6, 0, 0 },
	RS = { 20, 0, 50 }, LS = { 20, 0, -50 }, RE = { 30, 0, 0 }, LE = { 30, 0, 0 },
	RH = { 22, 0, 8 }, LH = { -8, 0, -8 }, RK = { -30, 0, 0 }, LK = { -18, 0, 0 },
}

-- 탈것 위: 몸을 굳게 고정한다 (걷기·숨·몸짓·권법 자세 모두 끈다). 말·범·용은 걸터앉아 고삐를, 구름은 뒷짐 지고 선다
local RIDE_SIT: { [string]: { number } } = {
	R = { 0, 0, 0, 0, -0.15, 0 }, W = { 10, 0, 0 }, N = { -8, 0, 0 },
	RS = { 40, 0, 10 }, RE = { 62, 0, 0 }, LS = { 40, 0, -10 }, LE = { 62, 0, 0 },
	RH = { 72, 0, 32 }, RK = { -78, 0, 0 }, LH = { 72, 0, -32 }, LK = { -78, 0, 0 },
}
local RIDE_STAND: { [string]: { number } } = {
	R = { 0, 0, 0, 0, 0, 0 }, W = { 4, 0, 0 }, N = { 4, 0, 0 },
	RS = { -30, 0, -10 }, RE = { 90, 0, 0 }, LS = { -30, 0, 10 }, LE = { 90, 0, 0 },
	RH = { 0, 0, 7 }, RK = { -6, 0, 0 }, LH = { 0, 0, -7 }, LK = { -6, 0, 0 },
}
function Anim.ridePose(kind: string?): { [string]: { number } }?
	if kind == nil then
		return nil
	end
	return kind == "cloud" and RIDE_STAND or RIDE_SIT
end

local IDLE_HAND = { { "idle_shadow", 1.0 }, { "idle_stretch", 1.6 }, { "idle_crack", 1.4 }, { "idle_shift", 0.9 }, { "idle_look", 1.6 } }
local IDLE_WEAPON = { { "idle_weapon", 1.6 }, { "idle_look", 1.6 } }

local function step(dt: number)
	local t = os.clock()
	for model, rec in pairs(recs) do
		if not model.Parent then
			recs[model] = nil
			continue
		end
		local root = model:FindFirstChild("HumanoidRootPart")
		if not root or not root:IsA("BasePart") then
			continue
		end
		local motors = rec.motors
		local stance = stanceOf(model)
		local vel = root.AssemblyLinearVelocity
		local flatVel = Vector3.new(vel.X, 0, vel.Z)
		local flatSpeed = flatVel.Magnitude
		local moving = flatSpeed > 2
		local hum = model:FindFirstChildOfClass("Humanoid")
		local inAir = (hum and hum.FloorMaterial == Enum.Material.Air) or math.abs(vel.Y) > 8
		local airborne = inAir and math.abs(vel.Y) > 3
		local dead = model:GetAttribute("Dead") == true
		local guarding = model:GetAttribute("Guard") == true
		local mountId = model:GetAttribute("Mount")
		local mdef = type(mountId) == "string" and Config.MOUNT_BY_ID[mountId] or nil
		local ride = mdef and Anim.ridePose(mdef.kind) or nil

		-- 1) 기술 동작
		local actPose, actW = nil, 0
		local tr = rec.track
		if tr then
			actPose, actW = trackPose(tr, t, dt)
			if not actPose then
				rec.track = nil
			end
		end
		if dead and not actPose then
			-- 쓰러져 있다
			local keys = filled("knockdown", stance)
			if keys then
				actPose, actW = sample(keys, 0.5), 1
			end
		end
		-- 2) 되풀이 동작 (수련)
		local loopPose = nil
		if rec.loop and not actPose then
			loopPose = trackPose(rec.loop, t, dt)
		end

		-- 3) 기본 몸놀림의 무게 (부드럽게 넘어간다)
		local k = math.min(1, dt * 10)
		rec.moveW += (((moving and not airborne) and 1 or 0) - rec.moveW) * k
		rec.airW += ((airborne and 1 or 0) - rec.airW) * math.min(1, dt * 8)
		local amt = math.clamp(flatSpeed / 16, 0, 1.5)
		if moving then
			rec.walk += dt * (5 + flatSpeed * 0.45)
		end
		rec.breath += dt * (guarding and 3.2 or 2.3)
		local s, c = math.sin(rec.walk), math.cos(rec.walk)
		local local3 = root.CFrame:VectorToObjectSpace(flatVel)
		local f = moving and math.clamp(-local3.Z / flatSpeed, -1, 1) or 1
		local sd = moving and math.clamp(local3.X / flatSpeed, -1, 1) or 0
		local b = math.sin(rec.breath)
		local still = (1 - rec.moveW) * (1 - rec.airW)

		-- 4) 권법 자세, 막기, 달리기
		local guardTarget = (guarding and not actPose) and 1 or 0
		rec.guardW += (guardTarget - rec.guardW) * math.min(1, dt * 18)
		local stanceTarget = (stance and not dead) and 1 or 0
		rec.stanceW += (stanceTarget - rec.stanceW) * math.min(1, dt * 8)
		local stanceJ = stance and Poses.stances[stance]
		local legsJ = stance and (Poses.stanceLegs[stance] or Poses.stanceLegs.default)
		local blockJ = filled("block", stance)
		local blockPose = blockJ and blockJ[1].j
		local sprintTarget = (model:GetAttribute("Sprint") == true and moving and not actPose and not guarding and not dead) and 1 or 0
		rec.sprintW += (sprintTarget - rec.sprintW) * math.min(1, dt * 10)
		local sprintJ = Poses.anims.sprint_upper and Poses.anims.sprint_upper[1].j
		local airJ = vel.Y > 0 and AIR_UP or AIR_DOWN

		-- 가만히 서 있으면 가끔 몸짓 (그림자 주먹, 기지개, 손 풀기, 자세 바꾸기, 둘러보기)
		if still > 0.9 and not ride and not actPose and not loopPose and not guarding and not dead and t - rec.lastActAt > 4 and model:GetAttribute("Master") ~= true then
			rec.idleT += dt
			if rec.idleT > rec.idleNext then
				rec.idleT = 0
				rec.idleNext = 4 + math.random() * 5
				local ok = true
				if rec.npc then
					-- 적은 곁에 사람이 없을 때만 (싸우다 딴청 부리지 않게)
					local me = Players.LocalPlayer.Character
					local mr = me and me:FindFirstChild("HumanoidRootPart")
					ok = not (mr and mr:IsA("BasePart") and (mr.Position - root.Position).Magnitude < 30)
				end
				if ok then
					local list = model:GetAttribute("Weapon") and IDLE_WEAPON or IDLE_HAND
					local pick = list[math.random(1, #list)]
					Anim.play(model, pick[1], pick[2], { idle = true, fadeOut = 0.25 })
				end
			end
		else
			rec.idleT = 0
		end

		-- 탈것 위: 굳은 자세 하나만 (기술을 쓰면 서버가 내려 주므로 그때는 기술 동작으로)
		if ride and not dead then
			for name, motor in pairs(motors) do
				local out = toCF(name, ride[name] or (name == "R" and ZERO6 or ZERO3))
				if actPose and actW > 0 then
					out = out:Lerp(toCF(name, actPose[name]), actW)
				end
				motor.Transform = out
				rec.written[name] = out
			end
			continue
		end
		-- 초·취: 쓰러질 듯 크게 비틀거리고, 몇 초마다 한쪽으로 크게 휘청한다 (고개는 한 박자 늦게 따라간다)
		local wob = 0
		local sw, sw2, swN, lurch = 0, 0, 0, 0
		local wsid = model:GetAttribute("Style")
		local wst = type(wsid) == "string" and Config.STYLE_BY_ID[wsid] or nil
		if wst and wst.wobble and not dead then
			local wr = rec :: any
			wr.wobT = (wr.wobT or math.random() * 10) + dt
			wr.lurchT = (wr.lurchT or 0) + dt
			if wr.lurchT > (wr.lurchNext or 3) then
				wr.lurchT = 0
				wr.lurchNext = 2.5 + math.random() * 2.5
				wr.lurchDir = math.random() < 0.5 and -1 or 1
			end
			local lu = math.clamp(wr.lurchT / 0.9, 0, 1)
			lurch = math.sin(lu * math.pi) * (wr.lurchDir or 1) * ((wr.lurchNext and lu < 1) and 1 or 0)
			local wt = wr.wobT
			sw = math.sin(wt * 1.5)
			sw2 = math.sin(wt * 2.3 + 1)
			swN = math.sin(wt * 1.5 - 0.9)
			wob = (1 - (actPose and actW or 0)) * (1 - 0.35 * rec.moveW) * (1 - rec.airW)
		end
		for name, motor in pairs(motors) do
			-- 기본 몸놀림 층: 가만히 → 걷기 → 공중
			local out = toCF(name, IDLE[name] or (name == "R" and ZERO6 or ZERO3))
			if rec.moveW > 0.01 then
				out = out:Lerp(toCF(name, moveJ(name, s, c, f, sd, amt)), rec.moveW)
			end
			if rec.airW > 0.01 then
				out = out:Lerp(toCF(name, airJ[name] or (name == "R" and ZERO6 or ZERO3)), rec.airW)
			end
			-- 권법 자세 (윗몸은 늘, 움직일 땐 팔이 조금 풀린다 / 다리는 서 있을 때만)
			if rec.stanceW > 0.01 and stanceJ then
				local sv = stanceJ[name]
				if Poses.UPPER[name] and sv then
					out = out:Lerp(toCF(name, sv), rec.stanceW * (1 - 0.4 * rec.moveW) * (1 - 0.5 * rec.airW))
				elseif legsJ and legsJ[name] and still > 0.01 then
					out = out:Lerp(toCF(name, legsJ[name]), rec.stanceW * 0.9 * still)
				end
			end
			-- 숨: 서 있을 땐 가볍게 들썩인다 (무릎과 어깨가 함께)
			if still > 0.01 and not actPose then
				if name == "R" then
					out = CFrame.new(0, b * 0.07 * still, 0) * out
				elseif name == "RK" or name == "LK" then
					out = out * CFrame.Angles(-b * 4 * RAD * still, 0, 0)
				elseif name == "W" then
					out = out * CFrame.Angles(b * 1.6 * RAD * still, 0, 0)
				elseif name == "N" then
					out = out * CFrame.Angles(-b * 1.2 * RAD * still, 0, 0)
				end
				-- (어깨는 숨에 맞춰 흔들지 않는다: 손끝이 떨려 보인다)
			end
			if wob > 0.01 then
				if name == "R" then
					out = CFrame.new((0.35 * sw + 0.55 * lurch) * wob, -0.12 * math.abs(lurch) * wob, 0.15 * sw2 * wob) * out * CFrame.Angles(math.rad(5 * sw2) * wob, 0, math.rad(-(13 * sw + 20 * lurch)) * wob)
				elseif name == "W" then
					out = out * CFrame.Angles(math.rad(4 * sw2) * wob, math.rad(8 * sw2) * wob, math.rad(9 * sw + 12 * lurch) * wob)
				elseif name == "N" then
					out = out * CFrame.Angles(math.rad(7 * sw2) * wob, 0, math.rad(16 * swN + 10 * lurch) * wob)
				elseif name == "RK" then
					out = out * CFrame.Angles(math.rad(-10 * math.max(0, sw + lurch)) * wob, 0, 0)
				elseif name == "LK" then
					out = out * CFrame.Angles(math.rad(-10 * math.max(0, -sw - lurch)) * wob, 0, 0)
				elseif name == "RS" then
					out = out * CFrame.Angles(math.rad(7 * sw2) * wob, 0, math.rad(8 * lurch) * wob)
				elseif name == "LS" then
					out = out * CFrame.Angles(math.rad(12 * swN) * wob, 0, math.rad(-10 * math.abs(lurch)) * wob)
				end
			end
			if rec.sprintW > 0.01 and sprintJ and sprintJ[name] and (Poses.UPPER[name] or name == "R") then
				out = out:Lerp(toCF(name, sprintJ[name]), rec.sprintW * (name == "R" and 0.6 or 1))
			end
			if rec.guardW > 0.01 and blockPose and (Poses.UPPER[name] or (name == "R" and not moving)) then
				out = out:Lerp(toCF(name, blockPose[name]), rec.guardW)
			end
			if loopPose then
				out = toCF(name, loopPose[name])
			end
			if actPose and actW > 0 then
				out = out:Lerp(toCF(name, actPose[name]), actW)
			end
			motor.Transform = out
			rec.written[name] = out
		end
	end
end

function Anim.start()
	RunService.Stepped:Connect(function(_time: number, dt: number)
		local ok, err = pcall(step, dt)
		if not ok then
			warn("[권왕] 몸동작 오류:", err)
		end
	end)
end

return Anim
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="20">
          <Properties>
            <string name="Name">Awake</string>
            <string name="Source"><![CDATA[-- 권왕 1.9판: 새 각성 권법 셋의 화면 (진 금강불괴신공 · 진 무영귀각 · 진 태허유수장)
-- 고유 장치(불괴진동 · 영각 · 역류)와 오의(만불조종 · 백귀야행 · 천하수류)를 그린다
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local Config = require(ReplicatedStorage:WaitForChild("Config"))
local Fx = require(script.Parent:WaitForChild("Fx"))

local Awake = {}
local player = Players.LocalPlayer

local GOLD = Color3.fromRGB(255, 190, 60)
local GOLD_PALE = Color3.fromRGB(255, 245, 200)
local SHADOW = Color3.fromRGB(40, 18, 70)
local VIOLET = Color3.fromRGB(150, 90, 255)
local WATER = Color3.fromRGB(70, 200, 255)
local FOAM = Color3.fromRGB(225, 252, 255)

local folder = Instance.new("Folder")
folder.Name = "KwonAwake"
folder.Parent = workspace

local opts: any = {}
function Awake.init(o: any)
	opts = o or {}
end
local function shakeNear(pos: Vector3, amount: number, range: number)
	local cam = workspace.CurrentCamera
	if opts.shake and cam and (cam.CFrame.Position - pos).Magnitude < range then
		opts.shake(amount)
	end
end

local function tween(inst: Instance, time: number, goal: { [string]: any }, style: Enum.EasingStyle?, dir: Enum.EasingDirection?)
	local tw = TweenService:Create(inst, TweenInfo.new(time, style or Enum.EasingStyle.Quad, dir or Enum.EasingDirection.Out), goal)
	tw:Play()
	return tw
end
local function rootOf(m: Instance?): BasePart?
	local r = m and m:FindFirstChild("HumanoidRootPart")
	return (r and r:IsA("BasePart")) and r or nil
end
local function part(size: Vector3, color: Color3, material: Enum.Material?, alpha: number?, shape: string?): Part
	local p = Instance.new("Part")
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	p.Size = size
	p.Color = color
	p.Material = material or Enum.Material.Neon
	p.Transparency = alpha or 0
	if shape == "ball" then
		p.Shape = Enum.PartType.Ball
	elseif shape == "cyl" then
		p.Shape = Enum.PartType.Cylinder
	end
	p.Parent = folder
	return p
end
local function fadeOut(p: BasePart, time: number, goal: { [string]: any }?)
	local g = goal or {}
	g.Transparency = 1
	tween(p, time, g)
	task.delay(time + 0.05, function()
		p:Destroy()
	end)
end
-- 바닥 원반 (납작한 원기둥)
local function disc(at: Vector3, d: number, color: Color3, alpha: number): Part
	local p = part(Vector3.new(0.2, d, d), color, Enum.Material.Neon, alpha, "cyl")
	p.CFrame = CFrame.new(at) * CFrame.Angles(0, 0, math.rad(90))
	return p
end
local function ground(at: Vector3): Vector3
	return Vector3.new(at.X, at.Y - 2.7, at.Z)
end
-- 모델의 그림자 허상 (모든 몸 조각을 한 빛깔로 베낀다)
local function ghostOf(model: Model, at: CFrame, color: Color3, alpha: number): { BasePart }
	local r = rootOf(model)
	local out = {}
	if not r then
		return out
	end
	for _, d in ipairs(model:GetChildren()) do
		if d:IsA("BasePart") and d.Name ~= "HumanoidRootPart" and d.Transparency < 0.9 then
			local g = part(d.Size, color, Enum.Material.Neon, alpha)
			g.CFrame = at * r.CFrame:ToObjectSpace(d.CFrame)
			table.insert(out, g)
		end
	end
	return out
end

------------------------------------------------------------------------
-- 진 금강불괴: 불괴진동 (여덟 번 맞으면 몸에서 금빛 진동이 터진다)
------------------------------------------------------------------------
local function vajraQuake(data: any)
	local at: Vector3 = data.at
	local r = data.radius or 16
	local g = ground(at)
	-- 몸을 감싼 금빛 종이 한순간 부풀었다가 깨진다
	local bell = part(Vector3.new(6, 6, 6), GOLD, Enum.Material.ForceField, 0.1, "ball")
	bell.CFrame = CFrame.new(at)
	tween(bell, 0.18, { Size = Vector3.new(r * 1.2, r * 1.2, r * 1.2) }, Enum.EasingStyle.Back)
	task.delay(0.18, function()
		fadeOut(bell, 0.4, { Size = Vector3.new(r * 2, r * 2, r * 2) })
	end)
	for i = 0, 2 do
		task.delay(i * 0.09, function()
			Fx.ring(g + Vector3.new(0, 0.2, 0), i == 1 and GOLD_PALE or GOLD, 3, r * 2.1 + i * 4, 0.55)
		end)
	end
	-- 땅이 금빛으로 갈라진다
	for i = 1, 8 do
		local a = i / 8 * math.pi * 2 + math.random() * 0.3
		local len = r * (0.7 + math.random() * 0.4)
		local dir = Vector3.new(math.cos(a), 0, math.sin(a))
		local c = part(Vector3.new(0.5, 0.15, len), GOLD, Enum.Material.Neon, 0)
		c.CFrame = CFrame.lookAt(g + dir * len / 2 + Vector3.new(0, 0.15, 0), g + dir * len + Vector3.new(0, 0.15, 0))
		task.delay(0.25, function()
			fadeOut(c, 0.7)
		end)
	end
	Fx.burst("dust", g + Vector3.new(0, 0.5, 0), Color3.fromRGB(200, 175, 130), 24, 1.6)
	Fx.burst("spark", at, GOLD, 30, 1.6)
	Fx.debris(g, 6, 22, Color3.fromRGB(150, 130, 100))
	Fx.flash(at, GOLD, 40, 4, 0.5)
	Fx.sound("heavy", 1, 0.6, at)
	Fx.sound("block", 0.7, 0.5, at)
	shakeNear(at, 0.9, 50)
end

------------------------------------------------------------------------
-- 만불조종: 하늘이 갈라지고, 산만 한 금빛 손바닥이 내려와 둘레를 누른다
------------------------------------------------------------------------
local function buildPalm(size: number): Model
	local m = Instance.new("Model")
	m.Name = "BuddhaPalm"
	local skin = GOLD
	local function add(sz: Vector3, cf: CFrame, col: Color3?, mat: Enum.Material?)
		local p = part(sz, col or skin, mat or Enum.Material.Foil, 0)
		p.CFrame = cf
		p.Parent = m
		return p
	end
	local w, l, t = size, size * 1.05, size * 0.22
	-- 손바닥이 아래를 본다 (손끝은 -Z 쪽)
	local palm = add(Vector3.new(w, t, l), CFrame.new())
	m.PrimaryPart = palm
	-- 손바닥 가운데의 빛나는 문양 (만(卍) 대신 둥근 법륜)
	local wheel = add(Vector3.new(0.3, w * 0.55, w * 0.55), CFrame.new(0, -t / 2 - 0.1, 0) * CFrame.Angles(0, 0, math.rad(90)), GOLD_PALE, Enum.Material.Neon)
	wheel.Shape = Enum.PartType.Cylinder
	local fw = w / 4.6
	for i = 1, 4 do
		local x = -w / 2 + fw * 0.7 + (i - 1) * (w - fw * 1.4) / 3
		local fl = l * ({ 0.5, 0.66, 0.62, 0.5 })[i]
		add(Vector3.new(fw, t * 0.9, fl), CFrame.new(x, 0, -l / 2 - fl / 2 + fw * 0.3))
		-- 마디의 금빛 띠
		add(Vector3.new(fw * 1.04, t * 0.95, fw * 0.25), CFrame.new(x, 0, -l / 2 - fl * 0.45), GOLD_PALE, Enum.Material.Neon)
	end
	-- 엄지
	local th = add(Vector3.new(fw * 1.1, t * 0.9, l * 0.5), CFrame.new(w / 2 + fw * 0.2, 0, -l * 0.05) * CFrame.Angles(0, math.rad(-35), 0))
	th.Name = "Thumb"
	-- 손목과 소매 (위로 뻗는다)
	add(Vector3.new(w * 0.8, size * 1.6, l * 0.55), CFrame.new(0, size * 0.85, l * 0.45))
	add(Vector3.new(w * 1.05, size * 0.5, l * 0.75), CFrame.new(0, size * 1.6, l * 0.45), Color3.fromRGB(200, 70, 40), Enum.Material.Fabric)
	for _, d in ipairs(m:GetDescendants()) do
		if d:IsA("BasePart") then
			d.Parent = m
		end
	end
	m.Parent = folder
	return m
end
local function buddhaPalm(data: any)
	local at: Vector3 = data.at
	local r = data.radius or 26
	local delay = data.delay or 1
	local g = ground(at)
	-- 하늘의 틈: 금빛 빛기둥이 둘레를 비추고, 바닥에 큰 원이 그려진다
	local mark = disc(g + Vector3.new(0, 0.1, 0), r * 2, GOLD, 0.75)
	tween(mark, delay, { Transparency = 0.45 })
	local beam = part(Vector3.new(300, r * 1.6, r * 1.6), GOLD_PALE, Enum.Material.Neon, 0.92, "cyl")
	beam.CFrame = CFrame.new(g + Vector3.new(0, 150, 0)) * CFrame.Angles(0, 0, math.rad(90))
	tween(beam, delay, { Transparency = 0.7 })
	local hand = buildPalm(r * 0.95)
	local yaw = math.random() * math.pi * 2
	local fromCF = CFrame.new(g + Vector3.new(0, 170, 0)) * CFrame.Angles(0, yaw, 0)
	local toCF = CFrame.new(g + Vector3.new(0, r * 0.12, 0)) * CFrame.Angles(0, yaw, 0)
	hand:PivotTo(fromCF)
	local t0 = os.clock()
	local conn: RBXScriptConnection
	conn = RunService.RenderStepped:Connect(function()
		local k = math.clamp((os.clock() - t0) / delay, 0, 1)
		local e = k * k * k
		if hand.Parent then
			hand:PivotTo(fromCF:Lerp(toCF, e))
		end
		if k >= 1 then
			conn:Disconnect()
		end
	end)
	Fx.sound("deflect", 1, 0.35, at)
	task.delay(delay, function()
		if conn.Connected then
			conn:Disconnect()
		end
		hand:PivotTo(toCF)
		-- 땅이 눌린다
		for i = 0, 3 do
			task.delay(i * 0.07, function()
				Fx.ring(g + Vector3.new(0, 0.3, 0), i % 2 == 0 and GOLD or GOLD_PALE, r * 0.6, r * 2.4 + i * 10, 0.9)
			end)
		end
		local crater = disc(g + Vector3.new(0, 0.12, 0), r * 2.2, Color3.fromRGB(110, 80, 40), 0.2)
		crater.Material = Enum.Material.Slate
		task.delay(2.2, function()
			fadeOut(crater, 1.2)
		end)
		Fx.burst("dust", g + Vector3.new(0, 1, 0), Color3.fromRGB(205, 180, 135), 40, 3)
		Fx.burst("glitter", g + Vector3.new(0, 4, 0), GOLD, 50, 2.5)
		Fx.debris(g, 12, 40, Color3.fromRGB(140, 120, 90))
		Fx.flash(g + Vector3.new(0, 6, 0), GOLD, 60, 7, 1)
		Fx.sound("heavy", 1, 0.4, at)
		Fx.sound("fall", 0.8, 0.5, at)
		shakeNear(at, 2.4, 90)
		if opts.tint then
			local cam = workspace.CurrentCamera
			if cam and (cam.CFrame.Position - at).Magnitude < 90 then
				opts.tint(GOLD, 0.3, 0.35)
			end
		end
		-- 손바닥은 금빛 가루가 되어 흩어진다
		task.delay(0.9, function()
			for _, p in ipairs(hand:GetChildren()) do
				if p:IsA("BasePart") then
					fadeOut(p, 0.8, { Size = p.Size * 1.08 })
				end
			end
			Fx.burst("glitter", g + Vector3.new(0, r * 0.4, 0), GOLD_PALE, 40, 3)
			task.delay(0.9, function()
				hand:Destroy()
			end)
			fadeOut(beam, 0.6)
			fadeOut(mark, 0.6)
		end)
		-- 땅이 몇 번 더 울린다
		for q = 1, data.quakes or 3 do
			task.delay(q * (data.every or 0.35), function()
				Fx.ring(g + Vector3.new(0, 0.3, 0), GOLD, r * 0.4, r * (2 + q * 0.3), 0.6)
				Fx.burst("dust", g + Vector3.new(0, 0.5, 0), Color3.fromRGB(200, 175, 130), 14, 2)
				shakeNear(at, 0.8, 70)
			end)
		end
	end)
end

------------------------------------------------------------------------
-- 진 무영귀각: 영각 (그림자가 한 박자 뒤 같은 자리를 한 번 더 찬다)
------------------------------------------------------------------------
local function shadowEcho(data: any)
	local a: Model? = data.a
	local t: Model? = data.t
	local ar, tr = rootOf(a), rootOf(t)
	if not a or not ar or not tr then
		return
	end
	-- 상대 옆으로 비껴선 그림자 허상이 같은 발차기를 한다
	local side = (math.random() < 0.5 and -1 or 1)
	local toT = Vector3.new(tr.Position.X - ar.Position.X, 0, tr.Position.Z - ar.Position.Z)
	local dir = toT.Magnitude > 0.1 and toT.Unit or Vector3.new(0, 0, -1)
	local right = dir:Cross(Vector3.new(0, 1, 0))
	local at = tr.Position - dir * 3.2 + right * side * 2.4
	local cf = CFrame.lookAt(at, Vector3.new(tr.Position.X, at.Y, tr.Position.Z))
	local ghost = ghostOf(a :: Model, cf, SHADOW, 0.35)
	for _, g in ipairs(ghost) do
		tween(g, 0.12, { CFrame = g.CFrame + dir * 1.6 })
		task.delay(0.1, function()
			fadeOut(g, 0.3)
		end)
	end
	-- 맞은 자리에 보랏빛 발자국 같은 충격
	local hit = part(Vector3.new(1, 1, 1), VIOLET, Enum.Material.Neon, 0.2, "ball")
	hit.CFrame = CFrame.new(tr.Position)
	fadeOut(hit, 0.25, { Size = Vector3.new(6, 6, 6) })
	Fx.burst("smoke", tr.Position, SHADOW, 6, 0.8)
	Fx.burst("spark", tr.Position, VIOLET, 8, 0.9)
	Fx.sound("hit", 0.5, 0.7, tr.Position)
end

------------------------------------------------------------------------
-- 백귀야행: 그림자 여덟이 둘레의 땅에서 솟아 적들 사이를 엇갈려 가로지른다
------------------------------------------------------------------------
local function paradeStart(data: any)
	local at: Vector3 = data.at
	local r = data.radius or 24
	local dur = data.dur or 2.5
	local g = ground(at)
	-- 땅이 밤처럼 검게 물든다
	local dark = disc(g + Vector3.new(0, 0.08, 0), 2, SHADOW, 0.25)
	tween(dark, 0.4, { Size = Vector3.new(0.2, r * 2.3, r * 2.3) })
	task.delay(dur, function()
		fadeOut(dark, 0.6)
	end)
	local rim = disc(g + Vector3.new(0, 0.1, 0), r * 2.3, VIOLET, 0.6)
	rim.Size = Vector3.new(0.18, r * 2.3, r * 2.3)
	task.delay(dur, function()
		fadeOut(rim, 0.5)
	end)
	-- 검은 안개
	local fog = part(Vector3.new(r * 2, 6, r * 2), SHADOW, Enum.Material.SmoothPlastic, 1)
	fog.CFrame = CFrame.new(g + Vector3.new(0, 3, 0))
	local at0 = Instance.new("Attachment")
	at0.Parent = fog
	local pe = Instance.new("ParticleEmitter")
	pe.Texture = "rbxasset://textures/particles/smoke_main.dds"
	pe.Color = ColorSequence.new(SHADOW, Color3.fromRGB(80, 40, 120))
	pe.LightEmission = 0
	pe.Rate = 40
	pe.Lifetime = NumberRange.new(1, 1.8)
	pe.Speed = NumberRange.new(1, 3)
	pe.Size = NumberSequence.new(4, 9)
	pe.Transparency = NumberSequence.new(0.5, 1)
	pe.Shape = Enum.ParticleEmitterShape.Box
	pe.Parent = fog
	task.delay(dur, function()
		pe.Enabled = false
		task.delay(2, function()
			fog:Destroy()
		end)
	end)
	-- 둘레에 그림자 여덟이 솟는다 (쓴 사람의 모습을 베낀다)
	local m: Model? = data.m
	local n = data.ghosts or 8
	if m and rootOf(m) then
		for i = 1, n do
			local a = i / n * math.pi * 2
			local p = g + Vector3.new(math.cos(a), 0, math.sin(a)) * r * 0.9 + Vector3.new(0, 2.7, 0)
			local cf = CFrame.lookAt(p - Vector3.new(0, 5, 0), Vector3.new(at.X, p.Y - 5, at.Z))
			local ghost = ghostOf(m, cf, SHADOW, 0.3)
			for _, gp in ipairs(ghost) do
				tween(gp, 0.35, { CFrame = gp.CFrame + Vector3.new(0, 5, 0) }, Enum.EasingStyle.Back)
				task.delay(0.6 + i * 0.03, function()
					fadeOut(gp, 0.35)
				end)
			end
		end
	end
	Fx.sound("deflect", 0.8, 0.5, at)
	if opts.tint then
		local cam = workspace.CurrentCamera
		if cam and (cam.CFrame.Position - at).Magnitude < 80 then
			opts.tint(Color3.fromRGB(60, 20, 110), 0.35, dur)
		end
	end
end
-- 한 번 가로지르기: 검은 그림자가 꼬리를 끌며 줄을 긋는다
local function paradePass(data: any)
	local from: Vector3, to: Vector3 = data.from, data.to
	local dur = data.dur or 0.25
	local body = part(Vector3.new(1.6, 4.6, 1.2), SHADOW, Enum.Material.Neon, 0.2)
	local head = part(Vector3.new(1.3, 1.3, 1.3), SHADOW, Enum.Material.Neon, 0.2, "ball")
	local look = CFrame.lookAt(from, to)
	body.CFrame = look
	head.CFrame = look * CFrame.new(0, 3, 0)
	local a0 = Instance.new("Attachment")
	a0.Position = Vector3.new(0, 2, 0)
	a0.Parent = body
	local a1 = Instance.new("Attachment")
	a1.Position = Vector3.new(0, -2, 0)
	a1.Parent = body
	local tr = Instance.new("Trail")
	tr.Attachment0 = a0
	tr.Attachment1 = a1
	tr.Color = ColorSequence.new(VIOLET, SHADOW)
	tr.Transparency = NumberSequence.new(0.1, 1)
	tr.Lifetime = 0.35
	tr.LightEmission = 0.6
	tr.Parent = body
	local endCF = CFrame.lookAt(to, to + (to - from))
	tween(body, dur, { CFrame = endCF }, Enum.EasingStyle.Linear)
	tween(head, dur, { CFrame = endCF * CFrame.new(0, 3, 0) }, Enum.EasingStyle.Linear)
	task.delay(dur, function()
		fadeOut(body, 0.25)
		fadeOut(head, 0.25)
	end)
	-- 가운데쯤에서 발차기 초승달
	task.delay(dur * 0.5, function()
		local mid = from:Lerp(to, 0.5)
		local slash = part(Vector3.new(0.3, 0.3, 9), VIOLET, Enum.Material.Neon, 0)
		slash.CFrame = CFrame.lookAt(mid, mid + (to - from)) * CFrame.Angles(0, 0, math.rad(math.random(-60, 60)))
		fadeOut(slash, 0.3, { Size = Vector3.new(0.1, 0.1, 13) })
		Fx.burst("spark", mid, VIOLET, 6, 0.8)
		if (data.i or 1) % 3 == 0 then
			Fx.sound("swing", 0.6, 1.2, mid)
		end
	end)
end
local function paradeEnd(data: any)
	local at: Vector3 = data.at
	local r = data.radius or 18
	local g = ground(at)
	-- 그림자들이 모여 하늘로 걷어찬다: 보랏빛 기둥과 고리
	local pillar = part(Vector3.new(80, r * 0.6, r * 0.6), VIOLET, Enum.Material.Neon, 0.1, "cyl")
	pillar.CFrame = CFrame.new(g + Vector3.new(0, 40, 0)) * CFrame.Angles(0, 0, math.rad(90))
	fadeOut(pillar, 0.8, { Size = Vector3.new(120, r * 1.4, r * 1.4) })
	local core = part(Vector3.new(80, r * 0.25, r * 0.25), Color3.new(1, 1, 1), Enum.Material.Neon, 0, "cyl")
	core.CFrame = pillar.CFrame
	fadeOut(core, 0.5)
	for i = 0, 2 do
		task.delay(i * 0.08, function()
			Fx.ring(g + Vector3.new(0, 0.3, 0), i == 1 and Color3.new(1, 1, 1) or VIOLET, 3, r * 2.4 + i * 6, 0.7)
		end)
	end
	Fx.burst("smoke", g + Vector3.new(0, 2, 0), SHADOW, 30, 2.5)
	Fx.burst("spark", at, VIOLET, 40, 2)
	Fx.flash(at, VIOLET, 50, 5, 0.7)
	Fx.sound("heavy", 1, 0.7, at)
	shakeNear(at, 1.8, 80)
end

------------------------------------------------------------------------
-- 진 태허유수장: 역류 (흘려 낼 때마다 둘레로 물결이 터진다)
------------------------------------------------------------------------
local function flowWave(data: any)
	local at: Vector3 = data.at
	local r = data.radius or 14
	local g = ground(at)
	for i = 0, 2 do
		task.delay(i * 0.07, function()
			Fx.ring(g + Vector3.new(0, 0.4 + i * 0.4, 0), i == 1 and FOAM or WATER, 2, r * 2 + i * 3, 0.5)
		end)
	end
	-- 물의 벽이 둥글게 솟았다가 가라앉는다
	local wall = part(Vector3.new(3, 4, 4), WATER, Enum.Material.Glass, 0.35, "cyl")
	wall.CFrame = CFrame.new(g + Vector3.new(0, 1.5, 0)) * CFrame.Angles(0, 0, math.rad(90))
	fadeOut(wall, 0.45, { Size = Vector3.new(0.5, r * 2, r * 2) })
	Fx.burst("glitter", at, FOAM, 20, 1.2)
	Fx.burst("dust", g + Vector3.new(0, 0.5, 0), Color3.fromRGB(190, 230, 255), 12, 1.2)
	Fx.sound("splash", 0.9, 1.1, at)
	shakeNear(at, 0.4, 40)
end

------------------------------------------------------------------------
-- 천하수류: 물의 용 셋이 몸을 감아 돌며 휩쓴다 (마디마다 물방울 구슬, 머리엔 뿔)
------------------------------------------------------------------------
local function waterDragons(data: any)
	local m: Model? = data.m
	local r0 = rootOf(m)
	if not r0 then
		return
	end
	local root = r0 :: BasePart
	local n = data.n or 3
	local R = data.radius or 20
	local dur = (data.dur or 2.6) + (data.delay or 0.3)
	local SEG = 14
	local dragons = {}
	for d = 1, n do
		local segs = {}
		for k = 1, SEG do
			local s = 3.4 - k * 0.16
			local p = part(Vector3.new(s, s, s), k == 1 and FOAM or WATER, k == 1 and Enum.Material.Neon or Enum.Material.Glass, k == 1 and 0.05 or 0.25, "ball")
			table.insert(segs, p)
		end
		-- 뿔 둘
		local horns = {}
		for h = -1, 1, 2 do
			local horn = part(Vector3.new(0.35, 0.35, 2.4), FOAM, Enum.Material.Neon, 0.1)
			horn:SetAttribute("Side", h)
			table.insert(horns, horn)
		end
		local trailHost = segs[1]
		local a0 = Instance.new("Attachment")
		a0.Position = Vector3.new(0, 1, 0)
		a0.Parent = trailHost
		local a1 = Instance.new("Attachment")
		a1.Position = Vector3.new(0, -1, 0)
		a1.Parent = trailHost
		local tr = Instance.new("Trail")
		tr.Attachment0 = a0
		tr.Attachment1 = a1
		tr.Color = ColorSequence.new(FOAM, WATER)
		tr.Transparency = NumberSequence.new(0.3, 1)
		tr.Lifetime = 0.5
		tr.LightEmission = 0.5
		tr.Parent = trailHost
		table.insert(dragons, { segs = segs, horns = horns, phase = (d - 1) / n * math.pi * 2 })
	end
	local t0 = os.clock()
	local conn: RBXScriptConnection
	conn = RunService.RenderStepped:Connect(function()
		local t = os.clock() - t0
		if t > dur or not root.Parent then
			conn:Disconnect()
			return
		end
		local grow = math.clamp(t / 0.5, 0, 1)
		local c = root.Position
		for _, dr in ipairs(dragons) do
			-- 머리가 앞서고, 몸이 같은 길을 조금씩 늦게 따른다
			local function pos(tt: number): Vector3
				local ang = dr.phase + tt * 4.2
				local rad = (4 + (R - 4) * grow) * (0.75 + 0.25 * math.sin(tt * 2.3 + dr.phase))
				local y = 1 + 5 * math.sin(tt * 3.1 + dr.phase) + 2 * grow
				return c + Vector3.new(math.cos(ang) * rad, y, math.sin(ang) * rad)
			end
			for k, sgm in ipairs(dr.segs) do
				local p = pos(t - (k - 1) * 0.045)
				local q = pos(t - (k - 1) * 0.045 - 0.02)
				sgm.CFrame = CFrame.lookAt(p, p + (p - q))
			end
			local head = dr.segs[1]
			for _, horn in ipairs(dr.horns) do
				local side = horn:GetAttribute("Side") or 1
				horn.CFrame = head.CFrame * CFrame.new(side * 0.9, 1.1, 0.6) * CFrame.Angles(math.rad(-30), math.rad(side * 15), 0)
			end
		end
	end)
	Fx.sound("splash", 1, 0.7, root.Position)
	task.delay(dur, function()
		for _, dr in ipairs(dragons) do
			for _, sgm in ipairs(dr.segs) do
				fadeOut(sgm, 0.3)
			end
			for _, horn in ipairs(dr.horns) do
				fadeOut(horn, 0.3)
			end
		end
	end)
	-- 발밑에 소용돌이
	local g = ground(root.Position)
	local swirl = disc(g + Vector3.new(0, 0.1, 0), R * 2, WATER, 0.6)
	swirl.Material = Enum.Material.Glass
	task.delay(dur, function()
		fadeOut(swirl, 0.5)
	end)
end
-- 마지막: 용 셋이 하나로 엉겨 앞으로 덮치는 거대한 물결
local function dragonWave(data: any)
	local at: Vector3 = data.at
	local from: Vector3 = data.from or at
	local dir: Vector3 = data.dir or Vector3.new(0, 0, -1)
	local r = data.radius or 18
	local g0 = ground(from)
	local g1 = ground(at)
	local wave = part(Vector3.new(r * 2.2, 3, 4), WATER, Enum.Material.Glass, 0.2)
	wave.CFrame = CFrame.lookAt(g0 + Vector3.new(0, 1.5, 0), g0 + Vector3.new(0, 1.5, 0) + dir)
	local crest = part(Vector3.new(r * 2.2, 1.2, 2), FOAM, Enum.Material.Neon, 0.1)
	crest.CFrame = wave.CFrame * CFrame.new(0, 1.8, 0)
	local endCF = CFrame.lookAt(g1 + dir * r * 0.6 + Vector3.new(0, r * 0.45, 0), g1 + dir * r * 2 + Vector3.new(0, r * 0.45, 0))
	tween(wave, 0.4, { CFrame = endCF, Size = Vector3.new(r * 2.4, r * 0.9, 6) })
	tween(crest, 0.4, { CFrame = endCF * CFrame.new(0, r * 0.47, 0), Size = Vector3.new(r * 2.4, 1.5, 3) })
	task.delay(0.4, function()
		fadeOut(wave, 0.5, { CFrame = endCF * CFrame.new(0, -r * 0.4, -4), Size = Vector3.new(r * 2.6, 1, 8) })
		fadeOut(crest, 0.4)
		for i = 0, 2 do
			task.delay(i * 0.08, function()
				Fx.ring(g1 + Vector3.new(0, 0.4, 0), i == 1 and FOAM or WATER, 4, r * 2.4 + i * 6, 0.7)
			end)
		end
		Fx.burst("glitter", g1 + Vector3.new(0, 3, 0), FOAM, 50, 2.6)
		Fx.burst("dust", g1 + Vector3.new(0, 0.5, 0), Color3.fromRGB(190, 230, 255), 30, 2.4)
		Fx.flash(g1 + Vector3.new(0, 4, 0), WATER, 50, 5, 0.7)
		Fx.sound("splash", 1, 0.6, at)
		Fx.sound("heavy", 0.8, 0.8, at)
		shakeNear(at, 1.6, 80)
	end)
end

local HANDLERS: { [string]: (any) -> () } = {
	vajraQuake = vajraQuake,
	buddhaPalm = buddhaPalm,
	shadowEcho = shadowEcho,
	paradeStart = paradeStart,
	paradePass = paradePass,
	paradeEnd = paradeEnd,
	flowWave = flowWave,
	waterDragons = waterDragons,
	dragonWave = dragonWave,
}
function Awake.handles(data: any): boolean
	return HANDLERS[data.kind] ~= nil
end
function Awake.run(data: any)
	local fn = HANDLERS[data.kind]
	if fn then
		fn(data)
	end
end

-- (안 쓰는 경고 막기)
local _ = player
local _c = Config

return Awake
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="21">
          <Properties>
            <string name="Name">Awake3</string>
            <string name="Source"><![CDATA[-- 권왕 2.2판: 각성 권법 아홉의 새 E·R, 진 열화 화산천붕 · 진 창해 고래강림, 초·벽력신권의 뇌신낙 · 천뢰구 · 심판의 벼락 (화면)
-- 기술마다 생김새가 겹치지 않게: 바늘, 피의 손, 용의 울음, 용머리 장력, 뇌인, 뇌전포, 금빛 종, 금강저, 그림자 분신,
-- 미끄러지는 그림자, 감아 도는 물방울, 간헐천, 불의 바퀴, 불의 고리, 화산, 물방울 감옥, 물의 창, 고래, 떠도는 회오리,
-- 하늘의 바람, 벼락이 되어 떨어지기, 구슬 번개, 조준 고리, (2.6판) 천둥별과 작은 별 여섯
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local Config = require(ReplicatedStorage:WaitForChild("Config"))
local Fx = require(script.Parent:WaitForChild("Fx"))

local Awake3 = {}
local player = Players.LocalPlayer

local WHITE = Color3.new(1, 1, 1)
local folder = Instance.new("Folder")
folder.Name = "KwonAwake3"
folder.Parent = workspace

local opts: any = {}
function Awake3.init(o: any)
	opts = o or {}
end

local function tween(inst: Instance, time: number, goal: { [string]: any }, style: Enum.EasingStyle?, dir: Enum.EasingDirection?)
	local tw = TweenService:Create(inst, TweenInfo.new(math.max(0.01, time), style or Enum.EasingStyle.Quad, dir or Enum.EasingDirection.Out), goal)
	tw:Play()
	return tw
end
local function rootOf(m: Instance?): BasePart?
	local r = m and m:FindFirstChild("HumanoidRootPart")
	return (r and r:IsA("BasePart")) and r or nil
end
local function near(pos: Vector3, d: number): boolean
	local cam = workspace.CurrentCamera
	return cam ~= nil and (cam.CFrame.Position - pos).Magnitude < d
end
local function flat(v: Vector3): Vector3
	local f = Vector3.new(v.X, 0, v.Z)
	return f.Magnitude > 1e-3 and f.Unit or Vector3.new(0, 0, -1)
end
local function part(size: Vector3, color: Color3, material: Enum.Material?, alpha: number?, shape: string?): Part
	local p = Instance.new("Part")
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	p.Size = size
	p.Color = color
	p.Material = material or Enum.Material.Neon
	p.Transparency = alpha or 0
	if shape == "ball" then
		p.Shape = Enum.PartType.Ball
	elseif shape == "cyl" then
		p.Shape = Enum.PartType.Cylinder
	elseif shape == "wedge" then
		local w = Instance.new("WedgePart")
		w.Anchored = true
		w.CanCollide = false
		w.CanQuery = false
		w.CanTouch = false
		w.CastShadow = false
		w.Size = size
		w.Color = color
		w.Material = material or Enum.Material.Neon
		w.Transparency = alpha or 0
		w.Parent = folder
		p:Destroy()
		return w :: any
	end
	p.Parent = folder
	return p
end
local function fadeOut(p: BasePart, time: number, goal: { [string]: any }?)
	local g = goal or {}
	g.Transparency = 1
	tween(p, time, g)
	task.delay(time + 0.05, function()
		p:Destroy()
	end)
end
local function ground(at: Vector3): Vector3
	return Vector3.new(at.X, at.Y - 2.7, at.Z)
end
local function disc(at: Vector3, d: number, color: Color3, alpha: number, mat: Enum.Material?): Part
	local p = part(Vector3.new(0.2, d, d), color, mat or Enum.Material.Neon, alpha, "cyl")
	p.CFrame = CFrame.new(at) * CFrame.Angles(0, 0, math.rad(90))
	return p
end
local function column(base: Vector3, height: number, width: number, color: Color3, alpha: number?, mat: Enum.Material?): Part
	local c = part(Vector3.new(height, width, width), color, mat or Enum.Material.Neon, alpha or 0.1, "cyl")
	c.CFrame = CFrame.new(base + Vector3.new(0, height / 2, 0)) * CFrame.Angles(0, 0, math.rad(90))
	return c
end
local function colors(id: any): (Color3, Color3)
	local st = type(id) == "string" and Config.STYLE_BY_ID[id] or nil
	if st then
		return st.color, st.color2
	end
	return Color3.fromRGB(255, 200, 90), WHITE
end
local function shakeNear(pos: Vector3, amount: number, range: number)
	if opts.shake and near(pos, range) then
		opts.shake(amount)
	end
end
-- 땅에 닿는 곳의 공통 마무리 (고리 둘과 불티)
local function impact(at: Vector3, radius: number, c: Color3, c2: Color3, k: number?)
	local s = k or 1
	local g = ground(at)
	Fx.ring(g + Vector3.new(0, 0.3, 0), c, 2, radius * 2.2, 0.5)
	task.delay(0.06, function()
		Fx.ring(g + Vector3.new(0, 0.3, 0), c2, 2, radius * 1.6, 0.4)
	end)
	Fx.burst("spark", at, c, math.floor(16 * s), 1.3 * s)
	shakeNear(at, 0.4 * s, 60)
end
-- 한 점에서 다른 점까지 늘어선 막대 (방향을 따라)
local function beam(a: Vector3, b: Vector3, w: number, color: Color3, alpha: number?, mat: Enum.Material?): Part
	local len = math.max(0.1, (b - a).Magnitude)
	local p = part(Vector3.new(w, w, len), color, mat, alpha)
	p.CFrame = CFrame.lookAt((a + b) / 2, b)
	return p
end

------------------------------------------------------------------------
-- 진 혈마신수: 혈침 · 혈마수인
------------------------------------------------------------------------
local function needleShot(data: any)
	local r = rootOf(data.m)
	if not r or not near(r.Position, 200) then
		return
	end
	local c, c2 = colors(data.style)
	local delay = data.delay or 0.2
	for i, m in ipairs(data.targets or {}) do
		local tr = rootOf(m)
		if tr then
			task.delay(delay + (i - 1) * 0.04, function()
				local from = r.Position + Vector3.new(0, 1.5, 0)
				local to = tr.Position
				local n = part(Vector3.new(0.25, 0.25, 3), c, Enum.Material.Neon, 0)
				n.CFrame = CFrame.lookAt(from, to)
				tween(n, 0.12, { CFrame = CFrame.lookAt(to, to + (to - from).Unit) }, Enum.EasingStyle.Linear)
				-- 꽂힌 바늘이 몸에 붙어 맥박친다
				task.delay(0.12, function()
					if not tr.Parent then
						n:Destroy()
						return
					end
					local off = tr.CFrame:ToObjectSpace(n.CFrame)
					local glow = part(Vector3.new(1.2, 1.2, 1.2), c2, Enum.Material.Neon, 0.5, "ball")
					local t0 = os.clock()
					local conn: RBXScriptConnection
					conn = RunService.Heartbeat:Connect(function()
						if not tr.Parent or os.clock() - t0 > (data.mark or 1) then
							conn:Disconnect()
							n:Destroy()
							glow:Destroy()
							return
						end
						n.CFrame = tr.CFrame * off
						local k = 1 + math.sin((os.clock() - t0) * 18) * 0.35
						glow.Size = Vector3.new(k, k, k)
						glow.CFrame = n.CFrame
					end)
					Fx.burst("spark", to, c, 6, 0.6)
				end)
			end)
		end
	end
	Fx.sound("swing", 0.6, 1.4, r.Position)
end
local function needleBurst(data: any)
	local c, c2 = colors(data.style)
	for _, at in ipairs(data.spots or {}) do
		if near(at, 200) then
			for k = 1, 6 do
				local dir = Vector3.new(math.random() - 0.5, math.random() * 0.8, math.random() - 0.5).Unit
				local s = beam(at, at + dir * 4, 0.3, k % 2 == 0 and c2 or c, 0)
				fadeOut(s, 0.3, { Size = Vector3.new(0.1, 0.1, 7) })
			end
			local b = part(Vector3.new(1, 1, 1), c, Enum.Material.Neon, 0.2, "ball")
			b.CFrame = CFrame.new(at)
			fadeOut(b, 0.35, { Size = Vector3.new(1, 1, 1) * (data.radius or 5) * 2 })
			impact(at, data.radius or 5, c, c2, 0.8)
		end
	end
	local first = (data.spots or {})[1]
	if first then
		Fx.sound("hit", 0.8, 0.6, first)
	end
end
-- 피의 손: 손바닥과 다섯 손가락 (손가락이 오므라들며 쥔다)
type Hand = { parts: { { p: BasePart, f: number, j: number } }, base: CFrame, size: number, curl: number }
local hands: { [string]: Hand } = {}
local function keyOf(v: Vector3): string
	return string.format("%d_%d_%d", math.floor(v.X), math.floor(v.Y), math.floor(v.Z))
end
local function placeHand(h: Hand)
	local s = h.size
	for _, e in ipairs(h.parts) do
		if e.f == 0 then
			e.p.CFrame = h.base * CFrame.new(0, s * 0.5, 0)
		else
			-- 손가락 e.f (1~5)의 마디 e.j (1~3): 손바닥 둘레에 둥글게 서서 안쪽으로 굽는다
			local ang = (e.f - 1) / 5 * math.pi * 2
			local root = h.base * CFrame.Angles(0, ang, 0) * CFrame.new(0, s * 1.0, -s * 0.55)
			local cf = root
			for j = 1, e.j do
				cf = cf * CFrame.Angles(math.rad(h.curl * (j == 1 and 0.6 or 1)), 0, 0) * CFrame.new(0, s * 0.5, 0)
			end
			e.p.CFrame = cf * CFrame.new(0, -s * 0.25, 0)
		end
	end
end
local function gripRise(data: any)
	local at: Vector3 = data.at
	if not near(at, 200) then
		return
	end
	local c, c2 = colors(data.style)
	local R = data.radius or 10
	local g = ground(at)
	local s = R * 0.35
	local h: Hand = { parts = {}, base = CFrame.new(g - Vector3.new(0, s * 3, 0)), size = s, curl = -20 }
	local palm = part(Vector3.new(s, s * 2.2, s * 2.2), Color3.fromRGB(120, 0, 15), Enum.Material.SmoothPlastic, 0.1, "cyl")
	table.insert(h.parts, { p = palm, f = 0, j = 0 })
	for fi = 1, 5 do
		for j = 1, 3 do
			local w = s * (0.55 - j * 0.08)
			local p = part(Vector3.new(w, s * 0.55, w), j == 3 and c2 or Color3.fromRGB(150, 5, 25), j == 3 and Enum.Material.Neon or Enum.Material.SmoothPlastic, 0.05)
			table.insert(h.parts, { p = p, f = fi, j = j })
		end
	end
	local key = keyOf(at)
	hands[key] = h
	local pool = disc(g + Vector3.new(0, 0.1, 0), 1, Color3.fromRGB(120, 0, 15), 0.2, Enum.Material.Glass)
	tween(pool, 0.3, { Size = Vector3.new(0.2, R * 2.3, R * 2.3) })
	local t0 = os.clock()
	local delay = data.delay or 0.35
	local conn: RBXScriptConnection
	conn = RunService.Heartbeat:Connect(function()
		local t = os.clock() - t0
		if not hands[key] or t > (data.dur or 2) + 1 then
			conn:Disconnect()
			return
		end
		local rise = math.clamp(t / delay, 0, 1)
		rise = 1 - (1 - rise) ^ 3
		h.base = CFrame.new(g + Vector3.new(0, -s * 3 * (1 - rise), 0))
		placeHand(h)
		palm.CFrame = h.base * CFrame.new(0, s * 0.5, 0) * CFrame.Angles(0, 0, math.rad(90))
	end)
	task.delay(delay, function()
		h.curl = 55
		Fx.burst("spark", at, c, 20, 1.5)
		Fx.sound("heavy", 0.8, 0.7, at)
	end)
	task.delay((data.dur or 2), function()
		hands[key] = nil
		for _, e in ipairs(h.parts) do
			fadeOut(e.p, 0.4, { CFrame = e.p.CFrame * CFrame.new(0, -s * 2, 0) })
		end
		fadeOut(pool, 0.5)
	end)
end
local function gripSqueeze(data: any)
	local h = hands[keyOf(data.at)]
	local c, c2 = colors(data.style)
	if h then
		h.curl = 75
		task.delay(0.12, function()
			h.curl = 55
		end)
	end
	if near(data.at, 200) then
		Fx.burst("spark", data.at + Vector3.new(0, 2, 0), c, 14, 1.2)
		Fx.ring(ground(data.at) + Vector3.new(0, 0.3, 0), c2, 2, (data.radius or 10) * 1.6, 0.3)
		Fx.sound("hit", 0.7, 0.6 + (data.i or 1) * 0.08, data.at)
	end
end
local function gripSlam(data: any)
	local key = keyOf(data.at)
	local h = hands[key]
	local c, c2 = colors(data.style)
	if h then
		h.curl = 90
		-- 손이 쥔 채로 위로 솟았다가 땅에 내리꽂힌다
		local g = ground(data.at)
		local t0 = os.clock()
		local conn: RBXScriptConnection
		conn = RunService.Heartbeat:Connect(function()
			local t = os.clock() - t0
			if not hands[key] or t > 0.4 then
				conn:Disconnect()
				return
			end
			local y = t < 0.2 and (t / 0.2) * h.size * 2 or (1 - (t - 0.2) / 0.2) * h.size * 2
			h.base = CFrame.new(g + Vector3.new(0, y, 0))
		end)
	end
	task.delay(0.4, function()
		if near(data.at, 200) then
			impact(data.at, data.radius or 10, c, c2, 1.6)
			Fx.debris(ground(data.at), 10, 30, Color3.fromRGB(90, 20, 25))
			Fx.sound("heavy", 1, 0.5, data.at)
			shakeNear(data.at, 1.2, 80)
		end
	end)
end

------------------------------------------------------------------------
-- 진 천룡파천장: 용음 · 항룡장
------------------------------------------------------------------------
local function dragonRoar(data: any)
	local at: Vector3 = data.at
	if not near(at, 200) then
		return
	end
	local c, c2 = colors(data.style)
	local dir: Vector3 = data.dir or Vector3.new(0, 0, -1)
	local range = data.range or 22
	local half = math.rad((data.angle or 80) / 2)
	-- 부채꼴로 겹겹이 퍼지는 금빛 음파 (호 조각)
	for wave = 0, 3 do
		task.delay(0.18 + wave * 0.07, function()
			local segs = 9
			for k = 0, segs do
				local a = -half + (2 * half) * k / segs
				local d = (CFrame.Angles(0, a, 0) * CFrame.new(dir)).Position
				local p0 = at + d * 2
				local p1 = at + d * range
				local arc = part(Vector3.new(range * 0.18, 0.3, 1.2), wave % 2 == 0 and c or c2, Enum.Material.Neon, 0.2)
				arc.CFrame = CFrame.lookAt(p0, p0 + d) * CFrame.Angles(0, math.rad(90), 0)
				tween(arc, 0.35, { CFrame = CFrame.lookAt(p1, p1 + d) * CFrame.Angles(0, math.rad(90), 0), Size = Vector3.new(range * 0.32, 0.2, 2.5) }, Enum.EasingStyle.Quad)
				task.delay(0.25, function()
					fadeOut(arc, 0.15)
				end)
			end
		end)
	end
	-- 입 앞에 금룡의 머리 그림자가 잠깐 뜬다
	local head = part(Vector3.new(4, 3, 5), c, Enum.Material.Neon, 0.35, "wedge")
	head.CFrame = CFrame.lookAt(at + dir * 4 + Vector3.new(0, 2, 0), at + dir * 10 + Vector3.new(0, 2, 0)) * CFrame.Angles(0, math.rad(180), 0)
	fadeOut(head, 0.5, { Size = Vector3.new(7, 5, 8) })
	Fx.flash(at + dir * 4, c, 40, 4, 0.4)
	Fx.sound("deflect", 1, 0.4, at)
	shakeNear(at, 0.8, 60)
end
local function palmWave(data: any)
	local from: Vector3 = data.from
	if not near(from, 220) then
		return
	end
	local c, c2 = colors(data.style)
	local dir: Vector3 = data.dir or Vector3.new(0, 0, -1)
	local len = data.length or 34
	local w = data.width or 5
	task.delay(data.delay or 0.2, function()
		-- 용머리 (쐐기 둘 + 뿔 둘 + 눈)와 뒤로 늘어지는 금빛 장력
		local head = Instance.new("Model")
		head.Parent = folder
		local jawTop = part(Vector3.new(w * 1.2, w * 0.5, w * 1.4), c, Enum.Material.Neon, 0.1, "wedge")
		local jawBot = part(Vector3.new(w * 1.2, w * 0.4, w * 1.2), c2, Enum.Material.Neon, 0.2, "wedge")
		local horns = { part(Vector3.new(0.4, 0.4, w * 0.9), c2, Enum.Material.Neon, 0), part(Vector3.new(0.4, 0.4, w * 0.9), c2, Enum.Material.Neon, 0) }
		local trail = part(Vector3.new(w * 0.9, w * 0.5, 1), c, Enum.Material.Neon, 0.45)
		local t0 = os.clock()
		local time = data.time or 0.5
		local conn: RBXScriptConnection
		conn = RunService.Heartbeat:Connect(function()
			local t = math.clamp((os.clock() - t0) / time, 0, 1)
			local pos = from + dir * (len * t) + Vector3.new(0, 1, 0)
			local cf = CFrame.lookAt(pos, pos + dir)
			jawTop.CFrame = cf * CFrame.new(0, w * 0.25, 0) * CFrame.Angles(0, math.rad(180), 0)
			jawBot.CFrame = cf * CFrame.new(0, -w * 0.2, 0) * CFrame.Angles(0, math.rad(180), math.rad(180))
			horns[1].CFrame = cf * CFrame.new(w * 0.35, w * 0.55, w * 0.5) * CFrame.Angles(math.rad(25), 0, 0)
			horns[2].CFrame = cf * CFrame.new(-w * 0.35, w * 0.55, w * 0.5) * CFrame.Angles(math.rad(25), 0, 0)
			local back = from + Vector3.new(0, 1, 0)
			trail.Size = Vector3.new(w * 0.9, w * 0.5, math.max(1, (pos - back).Magnitude))
			trail.CFrame = CFrame.lookAt((pos + back) / 2, pos)
			if t >= 1 then
				conn:Disconnect()
				for _, p in ipairs({ jawTop, jawBot, horns[1], horns[2] }) do
					fadeOut(p, 0.25)
				end
				fadeOut(trail, 0.4, { Size = Vector3.new(0.2, 0.2, trail.Size.Z) })
				head:Destroy()
			end
		end)
		Fx.sound("swing", 1, 0.6, from)
	end)
end
local function palmBurst(data: any)
	if near(data.at, 200) then
		local c, c2 = colors(data.style)
		local col = column(ground(data.at), 26, (data.radius or 10) * 0.8, c, 0.2)
		fadeOut(col, 0.5, { Size = Vector3.new(34, 0.5, 0.5) })
		impact(data.at, data.radius or 10, c, c2, 1.2)
		Fx.sound("heavy", 0.8, 0.8, data.at)
	end
end

------------------------------------------------------------------------
-- 진 벽력신권: 뇌인진 · 섬뢰포
------------------------------------------------------------------------
local function sigilsPlace(data: any)
	local c, c2 = colors(data.style)
	for _, at in ipairs(data.spots or {}) do
		if near(at, 200) then
			local g = ground(at) + Vector3.new(0, 0.15, 0)
			local r = (data.radius or 4) * 2
			-- 뇌인: 겹친 네모 둘 (돌아간다) + 가운데 번개 꼴
			local a = part(Vector3.new(r, 0.15, r), c, Enum.Material.Neon, 0.35)
			local b = part(Vector3.new(r * 0.75, 0.16, r * 0.75), c2, Enum.Material.Neon, 0.4)
			local core = part(Vector3.new(0.5, 3, 0.5), c2, Enum.Material.Neon, 0.1)
			core.CFrame = CFrame.new(g + Vector3.new(0, 1.5, 0))
			local t0 = os.clock()
			local dur = data.dur or 2.8
			local conn: RBXScriptConnection
			conn = RunService.Heartbeat:Connect(function()
				local t = os.clock() - t0
				if t > dur then
					conn:Disconnect()
					fadeOut(a, 0.2)
					fadeOut(b, 0.2)
					fadeOut(core, 0.2)
					return
				end
				a.CFrame = CFrame.new(g) * CFrame.Angles(0, t * 2, 0)
				b.CFrame = CFrame.new(g + Vector3.new(0, 0.02, 0)) * CFrame.Angles(0, -t * 3 + math.rad(45), 0)
				core.Transparency = 0.1 + math.abs(math.sin(t * 10)) * 0.5
			end)
			Fx.burst("spark", g + Vector3.new(0, 1, 0), c, 8, 0.8)
		end
	end
	local first = (data.spots or {})[1]
	if first then
		Fx.sound("deflect", 0.7, 1.4, first)
	end
end
local function sigilBolt(data: any)
	local at: Vector3 = data.at
	if not near(at, 200) then
		return
	end
	local c, c2 = colors(data.style)
	local top = at + Vector3.new(math.random(-3, 3), 45, math.random(-3, 3))
	Fx.lightning(top, ground(at), c2, data.big and 1.2 or 0.7)
	Fx.lightning(top + Vector3.new(2, 0, 0), ground(at), c, 0.5)
	impact(at, data.radius or 4, c, c2, data.big and 1.3 or 0.8)
	Fx.flash(at, c, 30, 4, 0.25)
	Fx.sound("hit", 0.7, 1.3, at)
end
local function railCharge(data: any)
	local r = rootOf(data.m)
	if not r or not near(r.Position, 200) then
		return
	end
	local c, c2 = colors(data.style)
	local time = data.time or 0.4
	-- 앞으로 내민 주먹에 번개가 빨려 든다
	local orb = part(Vector3.new(0.5, 0.5, 0.5), c2, Enum.Material.Neon, 0, "ball")
	local t0 = os.clock()
	local conn: RBXScriptConnection
	conn = RunService.Heartbeat:Connect(function()
		local t = os.clock() - t0
		if t > time or not r.Parent then
			conn:Disconnect()
			orb:Destroy()
			return
		end
		local at = r.Position + flat(r.CFrame.LookVector) * 2.5 + Vector3.new(0, 0.6, 0)
		local k = 0.5 + 2.2 * (t / time)
		orb.Size = Vector3.new(k, k, k)
		orb.CFrame = CFrame.new(at)
		if math.random() < 0.5 then
			local d = Vector3.new(math.random() - 0.5, math.random() - 0.5, math.random() - 0.5).Unit * 5
			Fx.lightning(at + d, at, c, 0.25)
		end
	end)
	Fx.sound("deflect", 0.6, 1.8, r.Position)
end
local function railFire(data: any)
	local a: Vector3 = data.from
	local b: Vector3 = data.to
	if not near(a, 240) then
		return
	end
	local c, c2 = colors(data.style)
	local w = (data.width or 3) * 2
	local core = beam(a + Vector3.new(0, 0.6, 0), b + Vector3.new(0, 0.6, 0), w * 0.35, WHITE, 0)
	local glow = beam(a + Vector3.new(0, 0.6, 0), b + Vector3.new(0, 0.6, 0), w, c, 0.35)
	fadeOut(core, 0.25, { Size = Vector3.new(0.1, 0.1, core.Size.Z) })
	fadeOut(glow, 0.45, { Size = Vector3.new(w * 1.6, w * 1.6, glow.Size.Z) })
	-- 땅에 남은 지지직거리는 줄
	local scar = beam(ground(a) + Vector3.new(0, 0.12, 0), ground(b) + Vector3.new(0, 0.12, 0), 0.2, c2, 0.2)
	scar.Size = Vector3.new(w * 0.5, 0.2, scar.Size.Z)
	local dur = data.dur or 1.2
	local t0 = os.clock()
	local conn: RBXScriptConnection
	conn = RunService.Heartbeat:Connect(function()
		if os.clock() - t0 > dur then
			conn:Disconnect()
			fadeOut(scar, 0.3)
			return
		end
		if math.random() < 0.35 then
			local u = math.random()
			local p = a:Lerp(b, u)
			Fx.lightning(p + Vector3.new(0, 3, 0), ground(p), c, 0.2)
		end
	end)
	for k = 0, 4 do
		task.delay(k * 0.03, function()
			Fx.ring(a:Lerp(b, k / 4), c2, 1, w * 2, 0.3, (b - a).Unit)
		end)
	end
	Fx.flash(a, c, 50, 6, 0.3)
	Fx.breakSound("boom", 0.7, 1.4, a)
	shakeNear(a, 0.9, 80)
end

------------------------------------------------------------------------
-- 진 금강불괴신공: 금강종 · 항마저
------------------------------------------------------------------------
local bells: { [Instance]: { BasePart } } = {}
local function bellDrop(data: any)
	local m = data.m
	local r = rootOf(m)
	if not r or not near(r.Position, 200) then
		return
	end
	local c, c2 = colors(data.style)
	local g = ground(r.Position)
	-- 종: 몸통 (위로 좁아지는 원기둥 셋) + 입술 고리 + 꼭지
	local list: { BasePart } = {}
	local shapes = { { 7.6, 1.2, 0 }, { 7.0, 3.2, 1.6 }, { 6.0, 2.6, 4.4 }, { 4.6, 1.6, 6.4 }, { 2.0, 1.0, 7.6 } }
	for i, sh in ipairs(shapes) do
		local p = part(Vector3.new(sh[2], sh[1], sh[1]), i == 1 and c2 or c, i == 1 and Enum.Material.Neon or Enum.Material.Metal, i == 1 and 0.1 or 0.25, "cyl")
		table.insert(list, p)
	end
	bells[m] = list
	local t0 = os.clock()
	local drop = data.delay or 0.35
	local dur = data.dur or 1.4
	local conn: RBXScriptConnection
	conn = RunService.Heartbeat:Connect(function()
		local t = os.clock() - t0
		if t > dur or not r.Parent then
			conn:Disconnect()
			bells[m] = nil
			for _, p in ipairs(list) do
				fadeOut(p, 0.35, { CFrame = p.CFrame * CFrame.new(-6, 0, 0) })
			end
			return
		end
		local k = math.clamp(t / drop, 0, 1)
		local y = 30 * (1 - k * k)
		local base = ground(r.Position) + Vector3.new(0, y, 0)
		for i, sh in ipairs(shapes) do
			list[i].CFrame = CFrame.new(base + Vector3.new(0, sh[3] + sh[2] / 2, 0)) * CFrame.Angles(0, 0, math.rad(90))
		end
	end)
	task.delay(drop, function()
		Fx.debris(g, 8, 20, Color3.fromRGB(160, 140, 90))
		Fx.sound("heavy", 1, 0.6, g)
	end)
end
local function bellRing(data: any)
	local at: Vector3 = data.at
	if not near(at, 200) then
		return
	end
	local c, c2 = colors(data.style)
	local R = data.radius or 10
	local g = ground(at)
	for k = 0, (data.last and 3 or 1) do
		task.delay(k * 0.06, function()
			Fx.ring(g + Vector3.new(0, 0.4 + k * 1.5, 0), k % 2 == 0 and c or c2, 2, R * 2.4 + k * 4, 0.45)
		end)
	end
	Fx.flash(at + Vector3.new(0, 3, 0), c, 40, data.last and 6 or 3, 0.35)
	Fx.sound("deflect", 1, data.last and 0.35 or 0.5, at)
	shakeNear(at, data.last and 1.2 or 0.5, 70)
end
local function vajraThrow(data: any)
	local r = rootOf(data.m)
	local from: Vector3 = data.from
	if not near(from, 220) then
		return
	end
	local c, c2 = colors(data.style)
	local dir: Vector3 = data.dir or Vector3.new(0, 0, -1)
	local dist = data.dist or 26
	local time = data.time or 0.45
	task.delay(data.delay or 0.25, function()
		-- 금강저: 가운데 손잡이 + 양 끝의 갈퀴 (빙빙 돈다)
		local grip = part(Vector3.new(0.7, 3.6, 0.7), c, Enum.Material.Metal, 0, "cyl")
		local prongs: { BasePart } = {}
		for _ = 1, 6 do
			table.insert(prongs, part(Vector3.new(0.35, 1.8, 0.35), c2, Enum.Material.Neon, 0))
		end
		local t0 = os.clock()
		local tip = from + dir * dist
		local conn: RBXScriptConnection
		conn = RunService.Heartbeat:Connect(function()
			local t = os.clock() - t0
			local pos
			if t <= time then
				pos = from + dir * (dist * (t / time))
			else
				local back = (r and r.Parent) and r.Position or from
				pos = tip:Lerp(back, math.clamp((t - time) / time, 0, 1))
			end
			pos += Vector3.new(0, 1.2, 0)
			local spin = CFrame.new(pos) * CFrame.Angles(0, t * 30, math.rad(90))
			grip.CFrame = spin
			local i = 0
			for _, sgn in ipairs({ -1, 1 }) do
				for k = 0, 2 do
					i += 1
					prongs[i].CFrame = spin * CFrame.new(sgn * 2.4, 0, 0) * CFrame.Angles(0, k * math.rad(120), 0) * CFrame.new(0, 0, 0.45) * CFrame.Angles(0, 0, math.rad(90 + sgn * 20))
				end
			end
			if math.random() < 0.5 then
				Fx.burst("spark", pos, c2, 2, 0.5)
			end
			if t > time * 2 then
				conn:Disconnect()
				grip:Destroy()
				for _, p in ipairs(prongs) do
					p:Destroy()
				end
				Fx.burst("spark", pos, c, 10, 1)
			end
		end)
		Fx.sound("swing", 1, 0.7, from)
	end)
end

------------------------------------------------------------------------
-- 진 무영귀각: 분영 · 그림자 밟기
------------------------------------------------------------------------
local DARK = Color3.fromRGB(20, 14, 30)
-- 사람 꼴 그림자 하나 (몸통·머리·팔다리)
local function shade(cf: CFrame, c: Color3): { BasePart }
	local list: { BasePart } = {}
	local function add(size: Vector3, off: CFrame)
		local p = part(size, DARK, Enum.Material.SmoothPlastic, 0.25)
		p.CFrame = cf * off
		table.insert(list, p)
	end
	add(Vector3.new(2, 2, 1), CFrame.new(0, 0.6, 0))
	add(Vector3.new(1.2, 1.2, 1.2), CFrame.new(0, 2.3, 0))
	add(Vector3.new(0.9, 2, 0.9), CFrame.new(1.5, 0.5, 0) * CFrame.Angles(0, 0, math.rad(20)))
	add(Vector3.new(0.9, 2, 0.9), CFrame.new(-1.5, 0.5, 0) * CFrame.Angles(0, 0, math.rad(-20)))
	add(Vector3.new(0.9, 2, 0.9), CFrame.new(0.55, -1.5, 0))
	add(Vector3.new(0.9, 2, 0.9), CFrame.new(-0.55, -1.5, 0) * CFrame.Angles(math.rad(-60), 0, 0))
	-- 붉은 눈
	local e = part(Vector3.new(0.8, 0.15, 0.1), c, Enum.Material.Neon, 0)
	e.CFrame = cf * CFrame.new(0, 2.4, -0.62)
	table.insert(list, e)
	return list
end
local function moveShade(list: { BasePart }, from: CFrame, to: CFrame, time: number)
	for _, p in ipairs(list) do
		local off = from:ToObjectSpace(p.CFrame)
		tween(p, time, { CFrame = to * off }, Enum.EasingStyle.Quad)
	end
end
local clones: { [string]: { { BasePart } } } = {}
local function cloneSpawn(data: any)
	local r = rootOf(data.m)
	if not r or not near(r.Position, 200) then
		return
	end
	local c = colors(data.style)
	local list = {}
	for i, at in ipairs(data.spots or {}) do
		local cf = CFrame.lookAt(at, at + flat(r.CFrame.LookVector))
		local sh = shade(cf, c)
		for _, p in ipairs(sh) do
			p.CFrame = r.CFrame:Lerp(p.CFrame, 0.2)
			tween(p, 0.2, { CFrame = cf * cf:ToObjectSpace(p.CFrame) })
		end
		moveShade(sh, r.CFrame, cf, 0.2)
		list[i] = sh
		Fx.burst("dust", at, DARK, 10, 1)
	end
	local key = keyOf((data.spots or {})[1] or r.Position)
	clones[key] = list
	task.delay(data.dur or 1.6, function()
		for _, sh in ipairs(list) do
			for _, p in ipairs(sh) do
				fadeOut(p, 0.3)
			end
		end
		clones[key] = nil
	end)
	-- 다음 덮치기에서 찾을 수 있게 둘 다 기억
	for i, at in ipairs(data.spots or {}) do
		clones[keyOf(at) .. "#" .. i] = { list[i] }
	end
	Fx.sound("swing", 0.6, 0.6, r.Position)
end
local function cloneStrike(data: any)
	local from: Vector3 = data.from
	local to: Vector3 = data.to
	if not near(to, 200) then
		return
	end
	local c, c2 = colors(data.style)
	local key = keyOf(from) .. "#" .. tostring(data.i or 1)
	local entry = clones[key]
	local cfFrom = CFrame.lookAt(from, from + flat(to - from))
	local cfTo = CFrame.lookAt(to, to + flat(to - from))
	if entry and entry[1] then
		moveShade(entry[1], cfFrom, cfTo, 0.12)
		clones[key] = nil
		clones[keyOf(to) .. "#" .. tostring(data.i or 1)] = entry
	end
	local streak = beam(from, to, 0.5, DARK, 0.3, Enum.Material.SmoothPlastic)
	fadeOut(streak, 0.25)
	task.delay(0.12, function()
		Fx.ring(ground(to) + Vector3.new(0, 0.3, 0), c, 2, (data.radius or 6) * 2, 0.3)
		Fx.burst("spark", to, c2, 8, 0.8)
		Fx.sound("hit", 0.6, 1.1, to)
	end)
end
local function shadowSlide(data: any)
	local from: Vector3 = data.from
	local to: Vector3 = data.to
	if not near(from, 220) then
		return
	end
	local c = colors(data.style)
	local time = data.time or 0.45
	-- 땅 위를 미끄러지는 납작한 사람 그림자, 뒤로 검은 자국
	local blob = part(Vector3.new(3, 0.15, 6), DARK, Enum.Material.SmoothPlastic, 0.15)
	local eye = part(Vector3.new(1, 0.16, 0.3), c, Enum.Material.Neon, 0)
	local g0 = ground(from) + Vector3.new(0, 0.1, 0)
	local g1 = ground(to) + Vector3.new(0, 0.1, 0)
	local dir = flat(to - from)
	blob.CFrame = CFrame.lookAt(g0, g0 + dir)
	eye.CFrame = blob.CFrame * CFrame.new(0, 0.02, -2.4)
	tween(blob, time, { CFrame = CFrame.lookAt(g1, g1 + dir) }, Enum.EasingStyle.Linear)
	tween(eye, time, { CFrame = CFrame.lookAt(g1, g1 + dir) * CFrame.new(0, 0.02, -2.4) }, Enum.EasingStyle.Linear)
	local track = beam(g0, g0 + dir * 0.2, 0.1, DARK, 0.4, Enum.Material.SmoothPlastic)
	tween(track, time, { Size = Vector3.new(2.4, 0.1, (g1 - g0).Magnitude), CFrame = CFrame.lookAt((g0 + g1) / 2, g1) }, Enum.EasingStyle.Linear)
	task.delay(time + 0.6, function()
		fadeOut(blob, 0.2)
		fadeOut(eye, 0.2)
		fadeOut(track, 0.8)
	end)
	Fx.sound("swing", 0.5, 0.5, from)
end
local function shadowKick(data: any)
	local at: Vector3 = data.at
	if not near(at, 220) then
		return
	end
	local c, c2 = colors(data.style)
	local from: Vector3 = data.from or at
	-- 되돌아 걷어차는 검붉은 반달
	local dir = flat(from - at)
	for k = -3, 3 do
		local d = (CFrame.Angles(0, math.rad(k * 12), 0) * CFrame.new(dir)).Position
		local p = beam(at + Vector3.new(0, 1, 0), at + Vector3.new(0, 1, 0) + d * 14, 0.6, k == 0 and c2 or c, 0.2)
		fadeOut(p, 0.3, { Size = Vector3.new(0.1, 0.1, p.Size.Z * 1.4) })
	end
	Fx.flash(at, c, 40, 5, 0.3)
	Fx.sound("hit", 1, 0.6, at)
	shakeNear(at, 1, 70)
end

------------------------------------------------------------------------
-- 진 태허유수장: 회류환 · 간헐천
------------------------------------------------------------------------
local function orbitStart(data: any)
	local r = rootOf(data.m)
	if not r or not near(r.Position, 200) then
		return
	end
	local c, c2 = colors(data.style)
	local n = data.n or 3
	local R = data.radius or 8
	local dur = data.dur or 3
	local orbs: { BasePart } = {}
	local tails: { BasePart } = {}
	for i = 1, n do
		orbs[i] = part(Vector3.new(2.2, 2.2, 2.2), c2, Enum.Material.Glass, 0.25, "ball")
		tails[i] = part(Vector3.new(1.2, 1.2, 4), c, Enum.Material.Neon, 0.5)
	end
	local t0 = os.clock()
	local conn: RBXScriptConnection
	conn = RunService.Heartbeat:Connect(function()
		local t = os.clock() - t0
		if t > dur or not r.Parent then
			conn:Disconnect()
			for i = 1, n do
				fadeOut(orbs[i], 0.2)
				fadeOut(tails[i], 0.2)
			end
			return
		end
		for i = 1, n do
			local a = t * 5 + (i / n) * math.pi * 2
			local pos = r.Position + Vector3.new(math.cos(a) * R, 0.5 + math.sin(t * 3 + i) * 0.8, math.sin(a) * R)
			local tan = Vector3.new(-math.sin(a), 0, math.cos(a))
			orbs[i].CFrame = CFrame.new(pos)
			tails[i].CFrame = CFrame.lookAt(pos - tan * 2, pos)
		end
	end)
	Fx.sound("splash", 0.7, 1.1, r.Position)
end
local function orbitBurst(data: any)
	if near(data.at, 200) then
		local c, c2 = colors(data.style)
		local g = ground(data.at)
		for k = 0, 2 do
			task.delay(k * 0.08, function()
				Fx.ring(g + Vector3.new(0, 0.4, 0), k == 1 and c2 or c, 3, (data.radius or 12) * 2 + k * 5, 0.5)
			end)
		end
		Fx.burst("spark", data.at, c2, 24, 1.6)
		Fx.sound("splash", 1, 0.7, data.at)
	end
end
local function hotGeyser(data: any)
	local at: Vector3 = data.at
	if not near(at, 200) then
		return
	end
	local c, c2 = colors(data.style)
	local g = ground(at)
	local R = data.radius or 5
	-- 땅이 끓어오르다가 (0.1초) 물기둥이 솟고, 김이 퍼진다
	local boil = disc(g + Vector3.new(0, 0.1, 0), R * 1.6, c, 0.4)
	task.delay(0.1, function()
		fadeOut(boil, 0.3)
		local col = column(g, 2, R * 1.1, c2, 0.15, Enum.Material.Glass)
		tween(col, 0.15, { Size = Vector3.new(26, R * 1.1, R * 1.1), CFrame = CFrame.new(g + Vector3.new(0, 13, 0)) * CFrame.Angles(0, 0, math.rad(90)) })
		task.delay(0.35, function()
			fadeOut(col, 0.4, { Size = Vector3.new(30, R * 0.3, R * 0.3) })
		end)
		local cap = part(Vector3.new(1, 1, 1), c2, Enum.Material.Neon, 0.3, "ball")
		cap.CFrame = CFrame.new(g + Vector3.new(0, 26, 0))
		fadeOut(cap, 0.6, { Size = Vector3.new(R * 3, R * 1.4, R * 3) })
		Fx.burst("dust", g + Vector3.new(0, 1, 0), Color3.fromRGB(235, 245, 255), 14, 1.4)
		Fx.ring(g + Vector3.new(0, 0.3, 0), c, 2, R * 2.4, 0.4)
		Fx.sound("splash", 0.8, 0.9 + (data.i or 1) * 0.05, at)
	end)
end

------------------------------------------------------------------------
-- 진 열화신권: 화륜 · 폭염륜 · 화산천붕
------------------------------------------------------------------------
local FIRE = Color3.fromRGB(255, 110, 30)
local LAVA = Color3.fromRGB(255, 70, 10)
local ROCK = Color3.fromRGB(50, 30, 25)
local function wheelRoll(data: any)
	local from: Vector3 = data.from
	if not near(from, 220) then
		return
	end
	local c, c2 = colors(data.style)
	local dir: Vector3 = data.dir or Vector3.new(0, 0, -1)
	local dist = data.dist or 36
	local time = data.time or 0.8
	local rad = 2.6
	-- 불의 바퀴: 테 + 바큇살 넷 (구르며 돈다)
	local rim = part(Vector3.new(0.6, rad * 2, rad * 2), c, Enum.Material.Neon, 0.1, "cyl")
	local spokes: { BasePart } = {}
	for k = 1, 4 do
		spokes[k] = part(Vector3.new(0.4, rad * 1.9, 0.4), c2, Enum.Material.Neon, 0)
	end
	local right = Vector3.new(-dir.Z, 0, dir.X)
	local t0 = os.clock()
	local last = ground(from)
	local conn: RBXScriptConnection
	conn = RunService.Heartbeat:Connect(function()
		local t = math.clamp((os.clock() - t0) / time, 0, 1)
		local g = ground(from + dir * dist * t)
		local center = g + Vector3.new(0, rad, 0)
		local roll = -(dist * t) / rad
		local base = CFrame.fromMatrix(center, right, Vector3.yAxis) * CFrame.Angles(roll, 0, 0)
		rim.CFrame = CFrame.fromMatrix(center, right, Vector3.yAxis) * CFrame.Angles(roll, 0, 0)
		for k = 1, 4 do
			spokes[k].CFrame = base * CFrame.Angles(k * math.rad(45), 0, 0)
		end
		-- 바퀴 자국에 불이 남는다
		if (g - last).Magnitude > 2 then
			local seg = beam(last + Vector3.new(0, 0.15, 0), g + Vector3.new(0, 0.15, 0), 0.3, FIRE, 0.25)
			seg.Size = Vector3.new(2.2, 0.2, seg.Size.Z + 0.3)
			task.delay(data.burn or 2, function()
				fadeOut(seg, 0.4)
			end)
			Fx.burst("ember", g + Vector3.new(0, 0.5, 0), FIRE, 3, 0.7)
			last = g
		end
		if t >= 1 then
			conn:Disconnect()
			fadeOut(rim, 0.2)
			for k = 1, 4 do
				fadeOut(spokes[k], 0.2)
			end
			Fx.burst("ember", center, c, 16, 1.2)
		end
	end)
	Fx.sound("swing", 0.8, 0.8, from)
end
local function flameRing(data: any)
	local at: Vector3 = data.at
	if not near(at, 220) then
		return
	end
	local c, c2 = colors(data.style)
	local R = data.radius or 20
	local time = data.time or 0.55
	local g = ground(at)
	-- 퍼져 나가는 불의 벽 (둥글게 선 불꽃 조각들)
	local n = 28
	local flames: { BasePart } = {}
	for k = 1, n do
		flames[k] = part(Vector3.new(2.4, 3.6, 0.8), k % 2 == 0 and FIRE or c2, Enum.Material.Neon, 0.15)
	end
	local t0 = os.clock()
	local conn: RBXScriptConnection
	conn = RunService.Heartbeat:Connect(function()
		local t = math.clamp((os.clock() - t0) / time, 0, 1)
		local rr = 2 + (R - 2) * t
		for k = 1, n do
			local a = (k / n) * math.pi * 2
			local pos = g + Vector3.new(math.cos(a) * rr, 1.8 * (1 - t * 0.4), math.sin(a) * rr)
			flames[k].CFrame = CFrame.lookAt(pos, g + Vector3.new(0, pos.Y - g.Y, 0)) * CFrame.Angles(0, 0, math.sin(t * 20 + k) * 0.2)
			flames[k].Size = Vector3.new(2.4 + rr * 0.08, 3.6 * (1 - t * 0.5), 0.8)
		end
		if t >= 1 then
			conn:Disconnect()
			for k = 1, n do
				fadeOut(flames[k], 0.25)
			end
		end
	end)
	local scorch = disc(g + Vector3.new(0, 0.12, 0), 2, ROCK, 0.3, Enum.Material.Slate)
	tween(scorch, time, { Size = Vector3.new(0.2, R * 2, R * 2) })
	task.delay(time + 0.8, function()
		fadeOut(scorch, 0.6)
	end)
	Fx.burst("ember", g + Vector3.new(0, 1, 0), c, 30, 2)
	Fx.flash(at, c, 50, 5, 0.4)
	Fx.sound("heavy", 1, 0.8, at)
	shakeNear(at, 1.2, 80)
end
local volcanos: { [string]: { BasePart } } = {}
local function volcanoRise(data: any)
	local at: Vector3 = data.at
	if not near(at, 240) then
		return
	end
	local R = data.radius or 26
	local g = ground(at)
	-- 땅이 부풀어 오른다: 바위 원뿔 (겹친 원기둥) + 위의 용암 웅덩이 + 갈라진 금
	local list: { BasePart } = {}
	local layers = { { 14, 2.2 }, { 10, 2.4 }, { 7, 2.4 }, { 4.5, 1.8 } }
	local y = 0
	for _, L in ipairs(layers) do
		local p = part(Vector3.new(L[2], L[1], L[1]), ROCK, Enum.Material.Basalt, 0, "cyl")
		p.CFrame = CFrame.new(g + Vector3.new(0, y + L[2] / 2 - 10, 0)) * CFrame.Angles(0, 0, math.rad(90))
		tween(p, 0.5, { CFrame = CFrame.new(g + Vector3.new(0, y + L[2] / 2, 0)) * CFrame.Angles(0, 0, math.rad(90)) }, Enum.EasingStyle.Back)
		y += L[2]
		table.insert(list, p)
	end
	local pool = part(Vector3.new(0.3, 3.6, 3.6), LAVA, Enum.Material.Neon, 0, "cyl")
	pool.CFrame = CFrame.new(g + Vector3.new(0, y + 0.1, 0)) * CFrame.Angles(0, 0, math.rad(90))
	table.insert(list, pool)
	for k = 1, 6 do
		local a = (k / 6) * math.pi * 2
		local crack = beam(g + Vector3.new(0, 0.12, 0), g + Vector3.new(math.cos(a) * R * 0.9, 0.12, math.sin(a) * R * 0.9), 0.1, LAVA, 0.1)
		crack.Size = Vector3.new(0.8, 0.15, crack.Size.Z)
		table.insert(list, crack)
	end
	volcanos[keyOf(at)] = list
	Fx.sound("heavy", 1, 0.4, at)
	shakeNear(at, 1, 100)
	task.delay(data.dur or 3, function()
		volcanos[keyOf(at)] = nil
		for _, p in ipairs(list) do
			fadeOut(p, 0.8, { CFrame = p.CFrame * CFrame.new(-6, 0, 0) })
		end
	end)
end
local function vent(data: any)
	local at: Vector3 = data.at
	if not near(at, 220) then
		return
	end
	local g = ground(at)
	local R = data.radius or 6
	local col = column(g, 2, R, LAVA, 0.05)
	tween(col, 0.12, { Size = Vector3.new(20, R, R), CFrame = CFrame.new(g + Vector3.new(0, 10, 0)) * CFrame.Angles(0, 0, math.rad(90)) })
	task.delay(0.2, function()
		fadeOut(col, 0.35, { Size = Vector3.new(24, 0.4, 0.4) })
	end)
	local pool = disc(g + Vector3.new(0, 0.12, 0), R * 1.8, LAVA, 0.2)
	task.delay(0.8, function()
		fadeOut(pool, 0.5)
	end)
	Fx.burst("ember", g + Vector3.new(0, 2, 0), FIRE, 14, 1.3)
	Fx.debris(g, 5, 25, ROCK)
	Fx.sound("hit", 0.6, 0.6, at)
end
local function eruptMain(data: any)
	local at: Vector3 = data.at
	if not near(at, 260) then
		return
	end
	local c, c2 = colors(data.style)
	local R = data.radius or 16
	local g = ground(at) + Vector3.new(0, 9, 0)
	local col = column(g, 4, R * 0.6, LAVA, 0)
	tween(col, 0.2, { Size = Vector3.new(90, R * 0.7, R * 0.7), CFrame = CFrame.new(g + Vector3.new(0, 45, 0)) * CFrame.Angles(0, 0, math.rad(90)) })
	task.delay(0.5, function()
		fadeOut(col, 0.6, { Size = Vector3.new(100, R * 1.4, R * 1.4) })
	end)
	local smoke = part(Vector3.new(1, 1, 1), Color3.fromRGB(60, 50, 50), Enum.Material.SmoothPlastic, 0.3, "ball")
	smoke.CFrame = CFrame.new(g + Vector3.new(0, 80, 0))
	fadeOut(smoke, 2, { Size = Vector3.new(70, 30, 70) })
	for k = 0, 3 do
		task.delay(k * 0.07, function()
			Fx.ring(ground(at) + Vector3.new(0, 0.4, 0), k % 2 == 0 and c or c2, 4, R * 2.4 + k * 10, 0.7)
		end)
	end
	Fx.burst("ember", g + Vector3.new(0, 5, 0), FIRE, 60, 3)
	Fx.debris(ground(at), 16, 50, ROCK)
	Fx.flash(at, LAVA, 80, 8, 0.8)
	Fx.breakSound("rock", 0.8, 0.5, at)
	Fx.sound("heavy", 1, 0.35, at)
	shakeNear(at, 2.4, 120)
end
local function meteorDrop(data: any)
	local at: Vector3 = data.at
	if not near(at, 240) then
		return
	end
	local g = ground(at)
	local fall = data.fall or 0.35
	local R = data.radius or 6
	local mark = disc(g + Vector3.new(0, 0.15, 0), R * 2, LAVA, 0.6)
	local rock = part(Vector3.new(3, 3, 3), ROCK, Enum.Material.Basalt, 0, "ball")
	local glow = part(Vector3.new(3.8, 3.8, 3.8), FIRE, Enum.Material.Neon, 0.4, "ball")
	local from = g + Vector3.new(math.random(-14, 14), 70, math.random(-14, 14))
	rock.CFrame = CFrame.new(from)
	glow.CFrame = rock.CFrame
	tween(rock, fall, { CFrame = CFrame.new(g + Vector3.new(0, 1, 0)) }, Enum.EasingStyle.Linear)
	tween(glow, fall, { CFrame = CFrame.new(g + Vector3.new(0, 1, 0)) }, Enum.EasingStyle.Linear)
	local tail = beam(from, from + (from - g).Unit * 8, 1.6, FIRE, 0.35)
	tween(tail, fall, { CFrame = CFrame.lookAt(g + (from - g).Unit * 5, g) }, Enum.EasingStyle.Linear)
	task.delay(fall, function()
		rock:Destroy()
		glow:Destroy()
		tail:Destroy()
		fadeOut(mark, 0.3)
		Fx.ring(g + Vector3.new(0, 0.3, 0), FIRE, 2, R * 2.4, 0.4)
		Fx.burst("ember", g + Vector3.new(0, 1, 0), FIRE, 12, 1.2)
		Fx.debris(g, 4, 20, ROCK)
		if math.random() < 0.5 then
			Fx.sound("hit", 0.7, 0.5, at)
		end
		shakeNear(at, 0.4, 60)
	end)
end

------------------------------------------------------------------------
-- 진 창해신권: 수포옥 · 해룡창 · 고래강림
------------------------------------------------------------------------
local function bubbleTrap(data: any)
	local c, c2 = colors(data.style)
	local dur = (data.dur or 1.6) + 0.1
	task.delay(data.delay or 0.25, function()
		for _, m in ipairs(data.targets or {}) do
			local r = rootOf(m)
			if r and near(r.Position, 200) then
				local b = part(Vector3.new(1, 1, 1), c2, Enum.Material.Glass, 0.45, "ball")
				local shine = part(Vector3.new(1.2, 1.2, 0.2), WHITE, Enum.Material.Neon, 0.4, "ball")
				tween(b, 0.2, { Size = Vector3.new(8, 8, 8) }, Enum.EasingStyle.Back)
				local t0 = os.clock()
				local conn: RBXScriptConnection
				conn = RunService.Heartbeat:Connect(function()
					local t = os.clock() - t0
					if t > dur or not r.Parent then
						conn:Disconnect()
						b:Destroy()
						shine:Destroy()
						return
					end
					-- 갇힌 몸이 둥실 떠오르는 것처럼 보이게 물방울이 위로 일렁인다
					local pos = r.Position + Vector3.new(0, 0.5 + math.sin(t * 4) * 0.4, 0)
					local k = 8 + math.sin(t * 9) * 0.4
					b.Size = Vector3.new(k, k * 1.05, k)
					b.CFrame = CFrame.new(pos)
					shine.CFrame = CFrame.new(pos + Vector3.new(-2, 2, -2.5))
					if math.random() < 0.15 then
						Fx.burst("spark", pos + Vector3.new(0, 3, 0), c, 2, 0.4)
					end
				end)
			end
		end
		local first = rootOf((data.targets or {})[1])
		if first then
			Fx.sound("splash", 0.8, 1.4, first.Position)
		end
	end)
end
local function bubblePop(data: any)
	local c, c2 = colors(data.style)
	for _, at in ipairs(data.spots or {}) do
		if near(at, 200) then
			local b = part(Vector3.new(8, 8, 8), c2, Enum.Material.Glass, 0.4, "ball")
			b.CFrame = CFrame.new(at)
			fadeOut(b, 0.25, { Size = Vector3.new(14, 14, 14) })
			impact(at, data.radius or 7, c, c2, 1)
			Fx.burst("dust", at, Color3.fromRGB(220, 240, 255), 14, 1.4)
			Fx.sound("splash", 1, 1.2, at)
		end
	end
end
local function waterSpear(data: any)
	local at: Vector3 = data.at
	if not near(at, 220) then
		return
	end
	local c, c2 = colors(data.style)
	local g = ground(at)
	local fall = data.fall or 0.18
	local from = g + Vector3.new(math.random(-4, 4), 50, math.random(-4, 4))
	local shaft = beam(from, from + (g - from).Unit * 9, 0.8, c2, 0.1, Enum.Material.Glass)
	local head = part(Vector3.new(1.4, 1.4, 2.6), WHITE, Enum.Material.Neon, 0, "wedge")
	local dir = (g - from).Unit
	head.CFrame = CFrame.lookAt(from + dir * 10, from + dir * 11) * CFrame.Angles(math.rad(90), 0, 0)
	tween(shaft, fall, { CFrame = CFrame.lookAt(g - dir * 4.5, g) }, Enum.EasingStyle.Linear)
	tween(head, fall, { CFrame = CFrame.lookAt(g + dir * 0.5, g + dir * 1.5) * CFrame.Angles(math.rad(90), 0, 0) }, Enum.EasingStyle.Linear)
	task.delay(fall, function()
		task.delay(0.35, function()
			fadeOut(shaft, 0.3)
			fadeOut(head, 0.3)
		end)
		Fx.ring(g + Vector3.new(0, 0.3, 0), c, 1.5, (data.radius or 4.5) * 2.2, 0.35)
		Fx.burst("dust", g + Vector3.new(0, 0.5, 0), Color3.fromRGB(210, 235, 255), 10, 1)
		Fx.sound("splash", 0.6, 1 + (data.i or 1) * 0.05, at)
	end)
end
local function whale(data: any)
	local from: Vector3 = data.from
	local to: Vector3 = data.to
	if not near(from, 260) then
		return
	end
	local c, c2 = colors(data.style)
	local delay = data.delay or 0.35
	local flight = data.flight or 1.3
	local g0 = ground(from)
	local g1 = ground(to)
	local dir = flat(to - from)
	local S = 3.2
	-- 물의 고래: 둥근 몸 (공 셋), 아래턱, 꼬리지느러미 둘, 가슴지느러미 둘, 눈
	local body: { { p: BasePart, off: CFrame } } = {}
	local function add(size: Vector3, off: CFrame, color: Color3, mat: Enum.Material?, alpha: number?, shape: string?)
		local p = part(size * S, color, mat or Enum.Material.Glass, alpha or 0.25, shape)
		table.insert(body, { p = p, off = CFrame.new(off.Position * S) * off.Rotation })
	end
	add(Vector3.new(5, 4.4, 9), CFrame.new(0, 0, 0), c, Enum.Material.Glass, 0.2, "ball")
	add(Vector3.new(4.4, 3.8, 6), CFrame.new(0, 0.2, -3.6), c, Enum.Material.Glass, 0.2, "ball")
	add(Vector3.new(3, 2.6, 5), CFrame.new(0, 0, 4.6), c, Enum.Material.Glass, 0.25, "ball")
	add(Vector3.new(4, 1.4, 6), CFrame.new(0, -1.4, -2.6), c2, Enum.Material.Glass, 0.3, "ball")
	add(Vector3.new(4.2, 0.4, 2), CFrame.new(1.8, 0.2, 7.4) * CFrame.Angles(0, math.rad(-25), math.rad(-10)), c2, Enum.Material.Neon, 0.3)
	add(Vector3.new(4.2, 0.4, 2), CFrame.new(-1.8, 0.2, 7.4) * CFrame.Angles(0, math.rad(25), math.rad(10)), c2, Enum.Material.Neon, 0.3)
	add(Vector3.new(3, 0.3, 1.4), CFrame.new(3, -0.8, -1.5) * CFrame.Angles(0, math.rad(20), math.rad(-30)), c2, Enum.Material.Neon, 0.35)
	add(Vector3.new(3, 0.3, 1.4), CFrame.new(-3, -0.8, -1.5) * CFrame.Angles(0, math.rad(-20), math.rad(30)), c2, Enum.Material.Neon, 0.35)
	add(Vector3.new(0.5, 0.5, 0.5), CFrame.new(1.9, 0.6, -5), WHITE, Enum.Material.Neon, 0, "ball")
	add(Vector3.new(0.5, 0.5, 0.5), CFrame.new(-1.9, 0.6, -5), WHITE, Enum.Material.Neon, 0, "ball")
	local hidden = CFrame.new(g0 - Vector3.new(0, 40, 0))
	for _, e in ipairs(body) do
		e.p.CFrame = hidden
	end
	-- 솟구칠 자리의 물웅덩이
	local pool = disc(g0 + Vector3.new(0, 0.1, 0), 2, c, 0.25, Enum.Material.Glass)
	tween(pool, delay, { Size = Vector3.new(0.2, 26, 26) })
	local t0 = os.clock()
	local H = 34
	local conn: RBXScriptConnection
	conn = RunService.Heartbeat:Connect(function()
		local t = os.clock() - t0 - delay
		if t < 0 then
			return
		end
		local u = math.clamp(t / flight, 0, 1)
		-- 포물선: 앞으로 가며 솟았다 떨어진다. 머리가 가는 쪽을 본다
		local pos = g0:Lerp(g1, u) + Vector3.new(0, 4 * H * u * (1 - u) + 2, 0)
		local du = math.min(1, u + 0.02)
		local nxt = g0:Lerp(g1, du) + Vector3.new(0, 4 * H * du * (1 - du) + 2, 0)
		local look = (nxt - pos).Magnitude > 1e-3 and (nxt - pos).Unit or dir
		local cf = CFrame.lookAt(pos, pos + look) * CFrame.Angles(0, 0, math.sin(u * math.pi) * 0.3)
		for _, e in ipairs(body) do
			e.p.CFrame = cf * e.off
		end
		if math.random() < 0.5 then
			Fx.burst("dust", pos, Color3.fromRGB(220, 240, 255), 3, 1.2)
		end
		if u >= 1 then
			conn:Disconnect()
			for _, e in ipairs(body) do
				fadeOut(e.p, 0.35, { CFrame = e.p.CFrame * CFrame.new(0, -6, 0) })
			end
			fadeOut(pool, 0.4)
			-- 덮치는 물보라
			for k = 0, 3 do
				task.delay(k * 0.07, function()
					Fx.ring(g1 + Vector3.new(0, 0.4, 0), k % 2 == 0 and c or c2, 4, (data.radius or 20) * 2.2 + k * 8, 0.7)
				end)
			end
			local splash = column(g1, 4, 16, c2, 0.2, Enum.Material.Glass)
			tween(splash, 0.25, { Size = Vector3.new(30, 26, 26), CFrame = CFrame.new(g1 + Vector3.new(0, 15, 0)) * CFrame.Angles(0, 0, math.rad(90)) })
			task.delay(0.3, function()
				fadeOut(splash, 0.5)
			end)
			Fx.burst("dust", g1 + Vector3.new(0, 2, 0), Color3.fromRGB(220, 240, 255), 50, 3)
			Fx.flash(g1, c, 80, 6, 0.6)
			Fx.sound("splash", 1, 0.4, g1)
			Fx.sound("heavy", 1, 0.4, g1)
			shakeNear(g1, 2.4, 140)
		end
	end)
	task.delay(delay, function()
		Fx.burst("dust", g0 + Vector3.new(0, 2, 0), Color3.fromRGB(220, 240, 255), 40, 2.4)
		Fx.sound("splash", 1, 0.6, g0)
		shakeNear(g0, 1.2, 100)
	end)
end

------------------------------------------------------------------------
-- 진 풍신각: 회풍 · 풍압
------------------------------------------------------------------------
type Twister = { parts: { BasePart }, at: Vector3, from: Vector3, t0: number, time: number, born: number }
local twisters: { [number]: Twister } = {}
local function twisterStart(data: any)
	local at: Vector3 = data.at
	if not near(at, 220) then
		return
	end
	local c, c2 = colors(data.style)
	local R = data.radius or 5
	local tw: Twister = { parts = {}, at = at, from = at, t0 = os.clock(), time = 0.2, born = os.clock() }
	for k = 1, 7 do
		local w = R * (0.4 + k * 0.22)
		tw.parts[k] = part(Vector3.new(0.5, w, w), k % 2 == 0 and c or c2, Enum.Material.ForceField, 0.2, "cyl")
	end
	twisters[data.id] = tw
	local dur = data.dur or 3
	local conn: RBXScriptConnection
	conn = RunService.Heartbeat:Connect(function()
		local now = os.clock()
		if not twisters[data.id] or now - tw.born > dur + 0.5 then
			conn:Disconnect()
			return
		end
		local u = math.clamp((now - tw.t0) / tw.time, 0, 1)
		local pos = tw.from:Lerp(tw.at, u)
		local g = ground(pos)
		for k, p in ipairs(tw.parts) do
			local sway = Vector3.new(math.sin(now * 6 + k) * 0.5 * k * 0.3, 0, math.cos(now * 5 + k) * 0.5 * k * 0.3)
			p.CFrame = CFrame.new(g + Vector3.new(0, k * 1.6, 0) + sway) * CFrame.Angles(0, now * 12 + k, 0) * CFrame.Angles(0, 0, math.rad(90))
		end
		if math.random() < 0.3 then
			Fx.burst("dust", g + Vector3.new(0, 0.5, 0), Color3.fromRGB(200, 200, 190), 2, 0.8)
		end
	end)
	Fx.sound("swing", 0.7, 0.5, at)
end
local function twisterMove(data: any)
	local tw = twisters[data.id]
	if tw then
		local u = math.clamp((os.clock() - tw.t0) / tw.time, 0, 1)
		tw.from = tw.from:Lerp(tw.at, u)
		tw.at = data.at
		tw.t0 = os.clock()
		tw.time = data.time or 0.2
	end
end
local function twisterEnd(data: any)
	local tw = twisters[data.id]
	twisters[data.id] = nil
	local c, c2 = colors(data.style)
	if tw then
		for k, p in ipairs(tw.parts) do
			fadeOut(p, 0.3, { Size = p.Size * 1.8, CFrame = p.CFrame * CFrame.new(k * 0.5, 0, 0) })
		end
	end
	if near(data.at, 200) then
		impact(data.at, data.radius or 8, c, c2, 1)
		Fx.sound("swing", 1, 0.8, data.at)
	end
end
local function downdraftWarn(data: any)
	local r = rootOf(data.m)
	if not r or not near(r.Position, 200) then
		return
	end
	local c = colors(data.style)
	-- 하늘에 바람이 모여드는 고리 (위에서 소용돌이친다)
	local top = r.Position + Vector3.new(0, 30, 0)
	for k = 0, 2 do
		task.delay(k * 0.1, function()
			Fx.ring(top + Vector3.new(0, k * 2, 0), c, 3, (data.radius or 15) * 2.6, data.time or 0.5)
		end)
	end
	Fx.sound("swing", 0.6, 0.4, r.Position)
end
local function downdraft(data: any)
	local at: Vector3 = data.at
	if not near(at, 220) then
		return
	end
	local c, c2 = colors(data.style)
	local R = data.radius or 15
	local g = ground(at)
	-- 하늘에서 내리누르는 공기 기둥 (위에서 아래로 짧아지며 넓어진다)
	local col = column(g, 60, R * 1.4, c2, 0.6, Enum.Material.ForceField)
	tween(col, 0.2, { Size = Vector3.new(4, R * 2.2, R * 2.2), CFrame = CFrame.new(g + Vector3.new(0, 2, 0)) * CFrame.Angles(0, 0, math.rad(90)) }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
	task.delay(0.22, function()
		fadeOut(col, 0.3)
		for k = 0, 2 do
			task.delay(k * 0.06, function()
				Fx.ring(g + Vector3.new(0, 0.3, 0), k == 1 and c or c2, 2, R * 2.4 + k * 6, 0.5)
			end)
		end
		-- 땅에 눌린 자국 (풀이 눕듯 바깥으로 그어진 줄)
		for k = 1, 12 do
			local a = (k / 12) * math.pi * 2
			local line = beam(g + Vector3.new(math.cos(a) * 3, 0.15, math.sin(a) * 3), g + Vector3.new(math.cos(a) * R, 0.15, math.sin(a) * R), 0.2, c, 0.3)
			fadeOut(line, 0.6)
		end
		Fx.burst("dust", g + Vector3.new(0, 0.5, 0), Color3.fromRGB(200, 200, 190), 36, 2.4)
		Fx.sound("heavy", 1, 0.6, at)
		shakeNear(at, 1.6, 90)
	end)
end

------------------------------------------------------------------------
-- 초·벽력신권: 뇌신낙 · 천뢰구 · 심판의 벼락 (구천뇌정)
------------------------------------------------------------------------
local function diveMark(data: any)
	local at: Vector3 = data.at
	if not near(at, 220) then
		return
	end
	local c, c2 = colors(data.style)
	local g = ground(at) + Vector3.new(0, 0.15, 0)
	local R = (data.radius or 8) * 2
	local ring = disc(g, R, c, 0.5)
	local cross1 = part(Vector3.new(R, 0.16, 0.5), c2, Enum.Material.Neon, 0.3)
	local cross2 = part(Vector3.new(0.5, 0.16, R), c2, Enum.Material.Neon, 0.3)
	cross1.CFrame = CFrame.new(g)
	cross2.CFrame = CFrame.new(g)
	local time = data.time or 0.45
	tween(ring, time, { Size = Vector3.new(0.2, R * 0.3, R * 0.3), Transparency = 0.1 })
	task.delay(time, function()
		ring:Destroy()
		cross1:Destroy()
		cross2:Destroy()
	end)
end
local function diveImpact(data: any)
	local at: Vector3 = data.at
	if not near(at, 240) then
		return
	end
	local c, c2 = colors(data.style)
	local g = ground(at)
	local top = (data.from or at) + Vector3.new(0, 40, 0)
	-- 몸이 벼락이 되어 떨어진 길
	Fx.lightning(top, g, WHITE, 1.4)
	Fx.lightning(top + Vector3.new(3, 0, 0), g, c, 0.9)
	Fx.lightning(top - Vector3.new(3, 0, 0), g, c2, 0.9)
	local col = column(g, 40, 3, WHITE, 0)
	fadeOut(col, 0.3, { Size = Vector3.new(40, 0.3, 0.3) })
	impact(at, data.radius or 8, c, c2, 1.6)
	Fx.flash(at, c, 70, 8, 0.4)
	Fx.debris(g, 10, 35, Color3.fromRGB(80, 75, 90))
	Fx.breakSound("rock", 0.8, 1.2, at)
	shakeNear(at, 1.8, 100)
	-- 네 갈래로 달리는 땅의 금과 번개
	local dir: Vector3 = data.dir or Vector3.new(0, 0, -1)
	local right = Vector3.new(-dir.Z, 0, dir.X)
	local L = data.length or 18
	task.delay(data.delay or 0.2, function()
		for _, d in ipairs({ dir, -dir, right, -right }) do
			local steps = 6
			for k = 1, steps do
				task.delay(k * 0.025, function()
					local a = g + d * (L * (k - 1) / steps)
					local b = g + d * (L * k / steps)
					local crack = beam(a + Vector3.new(0, 0.15, 0), b + Vector3.new(0, 0.15, 0), 0.6, c2, 0)
					fadeOut(crack, 0.6)
					if k % 2 == 0 then
						Fx.lightning(b + Vector3.new(0, 5, 0), b, c, 0.4)
					end
				end)
			end
		end
		Fx.sound("hit", 0.9, 1.4, at)
	end)
end
type Ball = { core: BasePart, shell: BasePart, pos: Vector3 }
local balls: { [number]: Ball } = {}
local function ballStart(data: any)
	local from: Vector3 = data.from
	if not near(from, 240) then
		return
	end
	local c, c2 = colors(data.style)
	local dir: Vector3 = data.dir or Vector3.new(0, 0, -1)
	local speed = data.speed or 12
	local dur = data.dur or 2.4
	local delay = data.delay or 0.4
	local core = part(Vector3.new(1, 1, 1), WHITE, Enum.Material.Neon, 0, "ball")
	local shell = part(Vector3.new(1, 1, 1), c, Enum.Material.ForceField, 0.1, "ball")
	core.CFrame = CFrame.new(from)
	shell.CFrame = CFrame.new(from)
	tween(core, delay, { Size = Vector3.new(4, 4, 4) }, Enum.EasingStyle.Back)
	tween(shell, delay, { Size = Vector3.new(9, 9, 9) }, Enum.EasingStyle.Back)
	local b: Ball = { core = core, shell = shell, pos = from }
	balls[data.id] = b
	local t0 = os.clock()
	local conn: RBXScriptConnection
	conn = RunService.Heartbeat:Connect(function()
		local t = os.clock() - t0
		if not balls[data.id] or t > delay + dur + 1 then
			conn:Disconnect()
			return
		end
		local mv = math.max(0, t - delay)
		b.pos = from + dir * (speed * math.min(mv, dur))
		local wob = 1 + math.sin(t * 22) * 0.08
		core.CFrame = CFrame.new(b.pos)
		shell.CFrame = CFrame.new(b.pos) * CFrame.Angles(t * 3, t * 5, 0)
		shell.Size = Vector3.new(9, 9, 9) * wob
		-- 구슬 겉을 기어 다니는 작은 번개
		if math.random() < 0.6 then
			local d = Vector3.new(math.random() - 0.5, math.random() - 0.5, math.random() - 0.5).Unit
			Fx.lightning(b.pos + d * 1.5, b.pos + d * 5.5, math.random() < 0.5 and c or c2, 0.25)
		end
	end)
	Fx.sound("deflect", 0.8, 0.7, from)
end
local function ballArc(data: any)
	local from: Vector3 = data.from
	if not near(from, 240) then
		return
	end
	local c, c2 = colors(data.style)
	for i, m in ipairs(data.targets or {}) do
		local r = rootOf(m)
		if r and i <= 8 then
			Fx.lightning(from, r.Position, i % 2 == 0 and c or c2, 0.45)
			Fx.burst("spark", r.Position, c2, 4, 0.5)
		end
	end
	if math.random() < 0.4 then
		Fx.sound("hit", 0.4, 1.6, from)
	end
end
local function ballBurst(data: any)
	local at: Vector3 = data.at
	for id, b in pairs(balls) do
		if (b.pos - at).Magnitude < 8 then
			balls[id] = nil
			-- 안으로 줄어들었다가 터진다
			tween(b.core, 0.12, { Size = Vector3.new(1, 1, 1) })
			tween(b.shell, 0.12, { Size = Vector3.new(2, 2, 2) })
			task.delay(0.12, function()
				b.core:Destroy()
				b.shell:Destroy()
			end)
		end
	end
	if not near(at, 260) then
		return
	end
	local c, c2 = colors(data.style)
	local R = data.radius or 18
	task.delay(0.12, function()
		local s = part(Vector3.new(2, 2, 2), c2, Enum.Material.Neon, 0.1, "ball")
		s.CFrame = CFrame.new(at)
		fadeOut(s, 0.45, { Size = Vector3.new(1, 1, 1) * R * 2 })
		for k = 1, 10 do
			local a = (k / 10) * math.pi * 2
			Fx.lightning(at, ground(at) + Vector3.new(math.cos(a) * R, 0, math.sin(a) * R), k % 2 == 0 and c or c2, 0.7)
		end
		impact(at, R, c, c2, 2)
		Fx.flash(at, c, 90, 9, 0.6)
		Fx.breakSound("glass", 0.9, 0.9, at)
		shakeNear(at, 2.2, 120)
	end)
end
-- 2.6판 뇌성강림: 고리 둘이 도는 천둥별, 떨어져 나와 둘레를 도는 작은 별 여섯, 별마다 쏘는 번개 줄기, 다시 모여 떨어지는 별
type Star = { orb: (i: number) -> Vector3, starPos: () -> Vector3, parts: { BasePart }, done: boolean }
local stars: { [number]: Star } = {}
local function starStart(data: any)
	local center: Vector3 = data.at
	if not near(center, 260) then
		return
	end
	local c, c2 = colors(data.style)
	local n = data.n or 6
	local orbit, height, spin = data.orbit or 13, data.height or 11, data.spin or 1.1
	local delay, spread, dur, converge = data.delay or 0.45, data.spread or 0.4, data.dur or 2.4, data.converge or 0.4
	local t1 = delay + spread
	local t2 = t1 + dur
	local t3 = t2 + converge
	local top = center + Vector3.new(0, height + 4, 0)
	local parts: { BasePart } = {}
	local function keep(p: BasePart): BasePart
		table.insert(parts, p)
		return p
	end
	-- 천둥별: 흰 속, 푸른 껍질, 네 갈래 빛살, 고리 둘
	local core = keep(part(Vector3.new(0.5, 0.5, 0.5), WHITE, Enum.Material.Neon, 0, "ball"))
	local shell = keep(part(Vector3.new(0.5, 0.5, 0.5), c, Enum.Material.ForceField, 0.05, "ball"))
	local spikes: { BasePart } = {}
	for k = 1, 4 do
		spikes[k] = keep(part(Vector3.new(0.5, 0.5, 0.5), k % 2 == 0 and c2 or WHITE, Enum.Material.Neon, 0.1))
	end
	local rings: { { BasePart } } = { {}, {} }
	for r = 1, 2 do
		for k = 1, 18 do
			rings[r][k] = keep(part(Vector3.new(0.35, 0.35, 2.3), r == 1 and c2 or c, Enum.Material.Neon, 0.15))
		end
	end
	local orbs: { BasePart } = {}
	local halos: { BasePart } = {}
	for i = 1, n do
		orbs[i] = keep(part(Vector3.new(2, 2, 2), c2, Enum.Material.Neon, 1, "ball"))
		halos[i] = keep(part(Vector3.new(3.6, 3.6, 3.6), c, Enum.Material.ForceField, 1, "ball"))
	end
	-- 땅에 별이 도는 자리를 그린다
	local mark = keep(disc(ground(center) + Vector3.new(0, 0.15, 0), orbit * 2, c, 1))
	tween(mark, delay, { Transparency = 0.75 })
	local t0 = os.clock()
	local function ease(x: number): number
		x = math.clamp(x, 0, 1)
		return 1 - (1 - x) * (1 - x)
	end
	local function orbitPos(i: number, t: number): Vector3
		local a = (i - 1) / n * math.pi * 2 + t * spin
		return center + Vector3.new(math.cos(a) * orbit, height, math.sin(a) * orbit)
	end
	local S: Star
	local function starPos(): Vector3
		local t = os.clock() - t0
		if t <= t3 then
			return top + Vector3.new(0, math.sin(t * 3) * 0.4, 0)
		end
		-- 떨어진다
		local k = math.clamp((t - t3) / 0.12, 0, 1)
		return top:Lerp(ground(center) + Vector3.new(0, 2, 0), k * k)
	end
	local function orb(i: number): Vector3
		local t = os.clock() - t0
		if t < delay then
			return starPos()
		elseif t < t1 then
			return starPos():Lerp(orbitPos(i, 0), ease((t - delay) / spread))
		elseif t < t2 then
			return orbitPos(i, t - t1)
		end
		return orbitPos(i, dur):Lerp(starPos(), ease((t - t2) / converge))
	end
	S = { orb = orb, starPos = starPos, parts = parts, done = false }
	stars[data.id] = S
	local conn: RBXScriptConnection
	conn = RunService.Heartbeat:Connect(function()
		local t = os.clock() - t0
		if S.done or t > t3 + 1.5 then
			conn:Disconnect()
			for _, p in ipairs(parts) do
				if p.Parent then
					p:Destroy()
				end
			end
			stars[data.id] = nil
			return
		end
		local grow = ease(t / math.max(0.05, delay))
		-- 별들이 떨어져 나가면 조금 작아졌다가, 다시 모이면 크게 부푼다
		local mass = t < t1 and 1 or (t < t2 and 0.7 or 0.7 + 0.6 * ease((t - t2) / converge))
		local sp = starPos()
		local pulse = 1 + math.sin(t * 18) * 0.06
		core.Size = Vector3.new(1, 1, 1) * 4 * grow * mass * pulse
		shell.Size = Vector3.new(1, 1, 1) * 8 * grow * mass
		core.CFrame = CFrame.new(sp)
		shell.CFrame = CFrame.new(sp) * CFrame.Angles(t * 2, t * 3, 0)
		for k, sk in ipairs(spikes) do
			local len = (k % 2 == 0 and 12 or 16) * grow * mass * (1 + math.sin(t * 9 + k) * 0.1)
			sk.Size = Vector3.new(0.35, 0.35, len)
			-- 세운 판 위의 여덟 갈래 빛살 (천천히 돈다)
			sk.CFrame = CFrame.new(sp) * CFrame.Angles(0, t * 0.6, 0) * CFrame.Angles((k - 1) * math.pi / 4, 0, 0)
		end
		for r = 1, 2 do
			local rad = (r == 1 and 7 or 9) * grow * mass
			local tilt = r == 1 and CFrame.Angles(math.rad(70), t * 1.5, 0) or CFrame.Angles(math.rad(-60), 0, math.rad(40) + t * -1.2)
			for k, seg in ipairs(rings[r]) do
				local a = k / #rings[r] * math.pi * 2 + t * (r == 1 and 2.5 or -2)
				seg.CFrame = CFrame.new(sp) * tilt * CFrame.new(math.cos(a) * rad, 0, math.sin(a) * rad) * CFrame.Angles(0, -a, 0)
			end
		end
		for i = 1, n do
			local op = orb(i)
			local vis = t < delay and 1 or (t > t3 and 1 or 0)
			orbs[i].Transparency = vis
			halos[i].Transparency = vis == 1 and 1 or 0.2
			orbs[i].CFrame = CFrame.new(op)
			halos[i].CFrame = CFrame.new(op) * CFrame.Angles(t * 4, t * 3, 0)
			-- 별과 작은 별 사이를 잇는 번개 줄 (가끔)
			if vis == 0 and math.random() < 0.05 then
				Fx.lightning(sp, op, math.random() < 0.5 and c or c2, 0.25)
			end
		end
	end)
	Fx.sound("deflect", 0.9, 0.6, center)
	task.delay(delay, function()
		Fx.ring(top, c2, 4, 20, 0.4)
		Fx.breakSound("whoosh", 0.6, 1.4, center)
	end)
end
local function starBeam(data: any)
	local S = stars[data.id]
	local to: Vector3 = data.to
	if not S or not near(to, 260) then
		return
	end
	local c, c2 = colors(data.style)
	local from = S.orb(data.i or 1)
	local b = beam(from, to, 0.9, WHITE, 0)
	fadeOut(b, 0.22, { Size = Vector3.new(0.1, 0.1, b.Size.Z) })
	local b2 = beam(from, to, 2.2, c, 0.55)
	fadeOut(b2, 0.3)
	Fx.lightning(from, to, c2, 0.5)
	Fx.burst("spark", to, c2, 6, 0.8)
	Fx.ring(ground(to) + Vector3.new(0, 0.3, 0), c, 1, 7, 0.3)
	if math.random() < 0.35 then
		Fx.sound("hit", 0.45, 1.7, to)
	end
end
local function starCrash(data: any)
	local at: Vector3 = data.at
	local S = stars[data.id]
	if S then
		-- 떨어지는 걸 다 보이고 정리한다
		task.delay(0.15, function()
			S.done = true
		end)
	end
	if not near(at, 280) then
		return
	end
	local c, c2 = colors(data.style)
	local R = data.radius or 20
	task.delay(0.12, function()
		local g = ground(at)
		local s = part(Vector3.new(3, 3, 3), WHITE, Enum.Material.Neon, 0, "ball")
		s.CFrame = CFrame.new(g)
		fadeOut(s, 0.5, { Size = Vector3.new(1, 1, 1) * R * 1.6 })
		local s2 = part(Vector3.new(3, 3, 3), c, Enum.Material.ForceField, 0.1, "ball")
		s2.CFrame = CFrame.new(g)
		fadeOut(s2, 0.7, { Size = Vector3.new(1, 1, 1) * R * 2.3 })
		-- 하늘로 솟는 빛기둥과 땅을 달리는 번개 열둘
		local col = column(g, 60, 6, c2, 0.1)
		fadeOut(col, 0.6, { Size = Vector3.new(60, 0.5, 0.5) })
		for k = 1, 12 do
			local a = (k / 12) * math.pi * 2
			local e = g + Vector3.new(math.cos(a) * R, 0.3, math.sin(a) * R)
			Fx.lightning(g + Vector3.new(0, 0.5, 0), e, k % 2 == 0 and c or c2, 0.8)
			task.delay(0.05 * (k % 4), function()
				Fx.lightning(e + Vector3.new(0, 16, 0), e, c2, 0.5)
			end)
		end
		impact(at, R, c, c2, 2.4)
		Fx.flash(at, c2, 110, 10, 0.7)
		Fx.breakSound("rock", 1, 0.75, at)
		Fx.sound("heavy", 1, 0.6, at)
		shakeNear(at, 2.6, 140)
	end)
end
------------------------------------------------------------------------
-- 2.6판 무극신권: 음양탄 · 태극선회 · 태극인 (흑과 백)
------------------------------------------------------------------------
local INK = Color3.fromRGB(14, 14, 20)
local function yinOrb(black: boolean, d: number): (BasePart, BasePart)
	local core = part(Vector3.new(d, d, d), black and INK or WHITE, black and Enum.Material.SmoothPlastic or Enum.Material.Neon, 0, "ball")
	local halo = part(Vector3.new(d, d, d) * 1.7, black and WHITE or INK, Enum.Material.ForceField, 0.15, "ball")
	return core, halo
end
-- 지나간 자리에 남는 작은 흑백 점
local function dot(at: Vector3, black: boolean, d: number, life: number)
	local p = part(Vector3.new(d, d, d), black and INK or WHITE, black and Enum.Material.SmoothPlastic or Enum.Material.Neon, 0.1, "ball")
	p.CFrame = CFrame.new(at)
	fadeOut(p, life, { Size = Vector3.new(0.1, 0.1, 0.1) })
end
-- 태극 문양 (판의 위가 +Y). 흰 원 위에 왼쪽 반을 검게 덮고, 위 작은 원은 검게, 아래 작은 원은 희게, 눈 둘
-- 뒤집혀도 보이도록 아래쪽에도 같은 층을 거꾸로 쌓는다 (테두리는 얇게 사이에 끼운다)
type Piece = { p: BasePart, cf: CFrame }
local function buildTaiji(R: number, rim: Color3): { Piece }
	local out: { Piece } = {}
	local UP = CFrame.Angles(0, 0, math.rad(90))
	local function both(i: number, make: () -> BasePart, x: number, z: number, rot: CFrame)
		for _, sgn in ipairs({ 1, -1 }) do
			table.insert(out, { p = make(), cf = CFrame.new(x, sgn * 0.02 * i, z) * rot })
		end
	end
	local function circle(i: number, r: number, z: number, color: Color3, mat: Enum.Material)
		both(i, function()
			return part(Vector3.new(0.3, r * 2, r * 2), color, mat, 0, "cyl")
		end, 0, z, UP)
	end
	table.insert(out, { p = part(Vector3.new(0.2, (R + 0.8) * 2, (R + 0.8) * 2), rim, Enum.Material.Neon, 0, "cyl"), cf = UP })
	circle(1, R, 0, WHITE, Enum.Material.Neon)
	local strips = 14
	for k = 1, strips do
		local x0 = -R + (k - 1) * R / strips
		local w = R / strips
		local h = 2 * math.sqrt(math.max(0, R * R - x0 * x0))
		if h > 0.2 then
			both(2, function()
				return part(Vector3.new(w + 0.05, 0.3, h), INK, Enum.Material.SmoothPlastic, 0)
			end, x0 + w / 2, 0, CFrame.identity)
		end
	end
	circle(3, R / 2, R / 2, INK, Enum.Material.SmoothPlastic)
	circle(4, R / 2, -R / 2, WHITE, Enum.Material.Neon)
	circle(5, R / 8, R / 2, WHITE, Enum.Material.Neon)
	circle(5, R / 8, -R / 2, INK, Enum.Material.SmoothPlastic)
	return out
end
local function placeTaiji(pieces: { Piece }, cf: CFrame)
	for _, pc in ipairs(pieces) do
		pc.p.CFrame = cf * pc.cf
	end
end
local function dropTaiji(pieces: { Piece }, life: number)
	for _, pc in ipairs(pieces) do
		fadeOut(pc.p, life)
	end
end

local function yyShot(data: any)
	local from: Vector3 = data.from
	if not near(from, 220) then
		return
	end
	local c = colors(data.style)
	local dir: Vector3 = flat(data.dir or Vector3.new(0, 0, -1))
	local L = data.length or 30
	local travel = data.travel or 0.45
	local delay = data.delay or 0.15
	local right = dir:Cross(Vector3.new(0, 1, 0)).Unit
	local up = Vector3.new(0, 1, 0)
	local bk, bh = yinOrb(true, 1.6)
	local wk, wh = yinOrb(false, 1.6)
	local t0 = os.clock()
	local frame = 0
	local conn: RBXScriptConnection
	conn = RunService.Heartbeat:Connect(function()
		local t = os.clock() - t0
		local u = math.clamp((t - delay) / travel, 0, 1)
		local th = u * math.pi * 6 + t * 4
		local rad = 1.8 * (1 - u * 0.5)
		local axis = from + dir * (L * u)
		local off = right * math.cos(th) * rad + up * math.sin(th) * rad
		bk.CFrame, bh.CFrame = CFrame.new(axis + off), CFrame.new(axis + off)
		wk.CFrame, wh.CFrame = CFrame.new(axis - off), CFrame.new(axis - off)
		frame += 1
		if u > 0 and u < 1 and frame % 2 == 0 then
			dot(axis + off, true, 0.9, 0.35)
			dot(axis - off, false, 0.9, 0.35)
		end
		if u >= 1 then
			conn:Disconnect()
			for _, p in ipairs({ bk, bh, wk, wh }) do
				p:Destroy()
			end
			-- 부딪친다: 작은 태극이 빠르게 돌며 터지고, 흑백 고리가 안으로 조였다가 밖으로 퍼진다
			local at = axis
			local R = data.radius or 8
			local pieces = buildTaiji(2.2, c)
			local s0 = os.clock()
			local c2conn: RBXScriptConnection
			c2conn = RunService.Heartbeat:Connect(function()
				local k = os.clock() - s0
				if k > 0.5 then
					c2conn:Disconnect()
					return
				end
				placeTaiji(pieces, CFrame.lookAt(at, at - dir) * CFrame.Angles(math.rad(90), 0, 0) * CFrame.Angles(0, k * 30, 0))
			end)
			dropTaiji(pieces, 0.5)
			Fx.ring(ground(at) + Vector3.new(0, 0.3, 0), INK, R * 2.4, 2, 0.25)
			task.delay(0.2, function()
				Fx.ring(ground(at) + Vector3.new(0, 0.3, 0), WHITE, 2, R * 2.4, 0.4)
				Fx.ring(ground(at) + Vector3.new(0, 0.35, 0), INK, 2, R * 2, 0.45)
			end)
			Fx.burst("spark", at, WHITE, 10, 1)
			Fx.breakSound("whoosh", 0.6, 1.5, at)
			shakeNear(at, 0.5, 60)
		end
	end)
	Fx.sound("swing", 0.6, 0.7, from)
end

local function yyOrbit(data: any)
	local at: Vector3 = data.at
	if not near(at, 220) then
		return
	end
	local c = colors(data.style)
	local R = data.radius or 16
	local dur = data.dur or 1.1
	local delay = data.delay or 0.1
	local turns = data.turns or 1.5
	local bk, bh = yinOrb(true, 2.4)
	local wk, wh = yinOrb(false, 2.4)
	local t0 = os.clock()
	local frame = 0
	local conn: RBXScriptConnection
	conn = RunService.Heartbeat:Connect(function()
		local t = os.clock() - t0
		local u = math.clamp((t - delay) / dur, 0, 1)
		local r = R * math.sin(u * math.pi)
		local a = u * turns * math.pi * 2
		local bob = Vector3.new(0, math.sin(t * 8) * 0.6, 0)
		local pb = at + Vector3.new(math.cos(a) * r, 0, math.sin(a) * r) + bob
		local pw = at + Vector3.new(math.cos(a + math.pi) * r, 0, math.sin(a + math.pi) * r) - bob
		bk.CFrame, bh.CFrame = CFrame.new(pb), CFrame.new(pb)
		wk.CFrame, wh.CFrame = CFrame.new(pw), CFrame.new(pw)
		frame += 1
		if u > 0 and u < 1 then
			if frame % 2 == 0 then
				dot(pb, true, 1.4, 0.5)
				dot(pw, false, 1.4, 0.5)
			end
			-- 땅에 소용돌이 자국
			if frame % 3 == 0 then
				local g1 = part(Vector3.new(0.12, 1.6, 1.6), INK, Enum.Material.SmoothPlastic, 0.2, "cyl")
				g1.CFrame = CFrame.new(ground(pb) + Vector3.new(0, 0.12, 0)) * CFrame.Angles(0, 0, math.rad(90))
				fadeOut(g1, 0.9)
				local g2 = part(Vector3.new(0.12, 1.6, 1.6), WHITE, Enum.Material.Neon, 0.2, "cyl")
				g2.CFrame = CFrame.new(ground(pw) + Vector3.new(0, 0.12, 0)) * CFrame.Angles(0, 0, math.rad(90))
				fadeOut(g2, 0.9)
			end
		end
		if u >= 1 then
			conn:Disconnect()
			for _, p in ipairs({ bk, bh, wk, wh }) do
				p:Destroy()
			end
			-- 되돌아와 하나로: 고리가 안으로 조이고, 발밑에 태극이 번쩍인다
			Fx.ring(ground(at) + Vector3.new(0, 0.3, 0), WHITE, R * 2, 3, 0.3)
			Fx.ring(ground(at) + Vector3.new(0, 0.35, 0), INK, R * 1.8, 3, 0.35)
			local pieces = buildTaiji(5, c)
			placeTaiji(pieces, CFrame.new(ground(at) + Vector3.new(0, 0.2, 0)))
			dropTaiji(pieces, 0.6)
			Fx.burst("spark", at, c, 12, 1)
			Fx.sound("heavy", 0.7, 1.2, at)
			shakeNear(at, 0.6, 60)
		end
	end)
	Fx.sound("swing", 0.7, 0.6, at)
end

local function taijiSeal(data: any)
	local at: Vector3 = data.at
	if not near(at, 280) then
		return
	end
	local c = colors(data.style)
	local R = data.radius or 30
	local delay, liftAt, hitAt = data.delay or 0.35, data.liftAt or 1.1, data.hitAt or 1.75
	local base = ground(at) + Vector3.new(0, 0.2, 0)
	local pieces = buildTaiji(R, c)
	for _, pc in ipairs(pieces) do
		pc.p.Transparency = 1
		tween(pc.p, delay, { Transparency = 0 })
	end
	-- 세상의 빛깔이 빠진다 (가까이 있는 사람만)
	local cc: ColorCorrectionEffect? = nil
	if near(at, 160) then
		local e = Instance.new("ColorCorrectionEffect")
		e.Name = "KwonTaiji"
		e.Parent = game:GetService("Lighting")
		tween(e, delay, { Saturation = -1, Contrast = 0.25 })
		cc = e
	end
	Fx.ring(base, WHITE, 2, R * 2.2, delay + 0.1)
	Fx.sound("deflect", 0.9, 0.5, at)
	local t0 = os.clock()
	local slammed = false
	local conn: RBXScriptConnection
	conn = RunService.Heartbeat:Connect(function()
		local t = os.clock() - t0
		if t > hitAt + 0.8 then
			conn:Disconnect()
			return
		end
		local spin
		if t < liftAt then
			spin = t * 0.9
		else
			spin = liftAt * 0.9 + (t - liftAt) * (t - liftAt) * 9
		end
		local cf
		local fall = hitAt - 0.14
		if t < liftAt then
			cf = CFrame.new(base) * CFrame.Angles(0, spin, 0)
		elseif t < fall then
			-- 떠올라 뒤집힌다
			local k = (t - liftAt) / (fall - liftAt)
			local e = 1 - (1 - k) * (1 - k)
			cf = CFrame.new(base + Vector3.new(0, 26 * e, 0)) * CFrame.Angles(math.pi * e, spin, 0)
		elseif t < hitAt then
			local k = (t - fall) / 0.14
			cf = CFrame.new(base + Vector3.new(0, 26 * (1 - k * k), 0)) * CFrame.Angles(math.pi, spin, 0)
		else
			cf = CFrame.new(base) * CFrame.Angles(math.pi, spin, 0)
		end
		placeTaiji(pieces, cf)
		-- 태극에서 흑백 기운이 솟는다
		if t > delay and t < liftAt and math.random() < 0.5 then
			local a, r = math.random() * math.pi * 2, math.sqrt(math.random()) * R
			local p0 = base + Vector3.new(math.cos(a) * r, 0.5, math.sin(a) * r)
			local black = math.random() < 0.5
			local q = part(Vector3.new(0.7, 0.7, 0.7), black and INK or WHITE, black and Enum.Material.SmoothPlastic or Enum.Material.Neon, 0.1, "ball")
			q.CFrame = CFrame.new(p0)
			fadeOut(q, 0.8, { CFrame = CFrame.new(p0 + Vector3.new(0, 7, 0)), Size = Vector3.new(0.2, 0.2, 0.2) })
		end
		if t >= hitAt and not slammed then
			slammed = true
			-- 도장이 찍힌다
			Fx.ring(base + Vector3.new(0, 0.2, 0), WHITE, R * 1.4, R * 2.6, 0.45)
			Fx.ring(base + Vector3.new(0, 0.25, 0), INK, R * 1.2, R * 2.3, 0.5)
			local col = column(base, 70, 5, WHITE, 0.05)
			fadeOut(col, 0.5, { Size = Vector3.new(70, 0.4, 0.4) })
			Fx.burst("spark", at, WHITE, 24, 2)
			Fx.flash(at, WHITE, 120, 10, 0.5)
			Fx.breakSound("boom", 1, 0.6, at)
			Fx.sound("heavy", 1, 0.5, at)
			shakeNear(at, 2.8, 150)
			local e = cc
			if e then
				-- 한순간 흑백이 뒤집혔다가 빛깔이 돌아온다
				e.Contrast = 1
				e.Brightness = 0.3
				tween(e, 0.25, { Contrast = 0.25, Brightness = 0 })
				task.delay(0.6, function()
					tween(e, 0.8, { Saturation = 0, Contrast = 0 })
					task.delay(0.85, function()
						e:Destroy()
					end)
				end)
			end
			-- 흑과 백의 물결
			task.delay(0.3, function()
				for k = 0, 2 do
					task.delay(k * 0.08, function()
						Fx.ring(base + Vector3.new(0, 0.3, 0), k % 2 == 0 and INK or WHITE, R * 0.6, (R + 6) * 2, 0.5)
					end)
				end
			end)
			dropTaiji(pieces, 0.7)
		end
	end)
	-- 기술이 끊기면 빛깔만은 꼭 돌려놓는다
	task.delay(hitAt + 3, function()
		if cc and cc.Parent then
			cc:Destroy()
		end
		for _, pc in ipairs(pieces) do
			if pc.p.Parent then
				pc.p:Destroy()
			end
		end
	end)
end

-- 심판의 벼락: 겨눈 적마다 머리 위에 돌아가는 조준 고리
local function lockOn(data: any)
	local c, c2 = colors(data.style)
	local dur = data.dur or 2.6
	for _, m in ipairs(data.targets or {}) do
		local r = rootOf(m)
		if r and near(r.Position, 220) then
			local ring = part(Vector3.new(0.2, 7, 7), c2, Enum.Material.Neon, 0.35, "cyl")
			local inner = part(Vector3.new(0.21, 4, 4), c, Enum.Material.Neon, 0.6, "cyl")
			local bars: { BasePart } = {}
			for k = 1, 4 do
				bars[k] = part(Vector3.new(0.3, 0.3, 1.8), c2, Enum.Material.Neon, 0.1)
			end
			local t0 = os.clock()
			local conn: RBXScriptConnection
			conn = RunService.Heartbeat:Connect(function()
				local t = os.clock() - t0
				if t > dur or not r.Parent then
					conn:Disconnect()
					ring:Destroy()
					inner:Destroy()
					for _, b in ipairs(bars) do
						b:Destroy()
					end
					return
				end
				local g = ground(r.Position) + Vector3.new(0, 0.2, 0)
				ring.CFrame = CFrame.new(g) * CFrame.Angles(0, t * 2, math.rad(90))
				inner.CFrame = CFrame.new(g + Vector3.new(0, 0.01, 0)) * CFrame.Angles(0, -t * 3, math.rad(90))
				for k = 1, 4 do
					local a = t * 2 + k * math.pi / 2
					local p = g + Vector3.new(math.cos(a) * 4.3, 0, math.sin(a) * 4.3)
					bars[k].CFrame = CFrame.lookAt(p, g)
				end
			end)
		end
	end
end
local function judgeBolt(data: any)
	local at: Vector3 = data.at
	if not near(at, 240) then
		return
	end
	local c, c2 = colors(data.style)
	local g = ground(at)
	local R = data.radius or 7
	-- 하늘 끝에서 내려오는 굵은 벼락 기둥 (흰 심 + 보랏빛 겉)
	local core = column(g, 160, 1.6, WHITE, 0)
	local outer = column(g, 160, R * 0.9, c, 0.35)
	fadeOut(core, 0.25, { Size = Vector3.new(160, 0.2, 0.2) })
	fadeOut(outer, 0.4, { Size = Vector3.new(160, R * 1.6, R * 1.6) })
	Fx.lightning(g + Vector3.new(0, 120, 0), g, c2, 1)
	impact(at, R, c, c2, 1.2)
	Fx.flash(at, c2, 60, 6, 0.3)
	if (data.i or 1) % 2 == 1 then
		Fx.breakSound("boom", 0.6, 1.3, at)
	end
	shakeNear(at, 0.9, 100)
end

------------------------------------------------------------------------
-- 초·벽력신권 뇌고천무 (초 오의, 2.3판): 등 뒤 하늘의 뇌고 여덟, 칠 때마다 벼락, 마지막 뇌구
------------------------------------------------------------------------
type Drum = { body: BasePart, face: BasePart, rims: { BasePart }, sigil: { BasePart }, pulse: number }
type DrumSet = { drums: { Drum }, links: { BasePart }, core: BasePart, r: BasePart, born: number, gather: number?, spin: number }
local drumSets: { [Instance]: DrumSet } = {}
local function drumCenter(ds: DrumSet): (Vector3, Vector3, Vector3)
	local look = flat(ds.r.CFrame.LookVector)
	local right = Vector3.new(-look.Z, 0, look.X)
	return ds.r.Position - look * 7 + Vector3.new(0, 15, 0), look, right
end
local function drumPos(ds: DrumSet, i: number): (Vector3, Vector3)
	local c, look, right = drumCenter(ds)
	local n = #ds.drums
	local R = 13 * (1 - (ds.gather or 0))
	local a = (i - 1) / n * math.pi * 2 + ds.spin
	return c + (right * math.cos(a) + Vector3.yAxis * math.sin(a)) * R, look
end
local function drumRing(data: any)
	local m = data.m
	local r = rootOf(m)
	if not r or not near(r.Position, 260) then
		return
	end
	local old = drumSets[m]
	if old then
		drumSets[m] = nil
		for _, d in ipairs(old.drums) do
			d.body:Destroy()
			d.face:Destroy()
		end
	end
	local c, c2 = colors(data.style)
	local ds: DrumSet = { drums = {}, links = {}, core = part(Vector3.new(1, 1, 1), WHITE, Enum.Material.Neon, 0.1, "ball"), r = r, born = os.clock(), gather = nil, spin = 0 }
	local n = data.n or 8
	local WOOD = Color3.fromRGB(105, 35, 40)
	local GOLD = Color3.fromRGB(255, 220, 120)
	for _ = 1, n do
		local d: Drum = {
			body = part(Vector3.new(2.4, 4.6, 4.6), WOOD, Enum.Material.Wood, 0, "cyl"),
			face = part(Vector3.new(0.2, 4.2, 4.2), c2, Enum.Material.Neon, 0.35, "cyl"),
			rims = { part(Vector3.new(0.3, 4.9, 4.9), GOLD, Enum.Material.Metal, 0, "cyl"), part(Vector3.new(0.3, 4.9, 4.9), GOLD, Enum.Material.Metal, 0, "cyl") },
			sigil = { part(Vector3.new(0.1, 1.6, 0.35), c, Enum.Material.Neon, 0), part(Vector3.new(0.1, 1.6, 0.35), c, Enum.Material.Neon, 0), part(Vector3.new(0.1, 1.6, 0.35), c, Enum.Material.Neon, 0) },
			pulse = 0,
		}
		table.insert(ds.drums, d)
		table.insert(ds.links, part(Vector3.new(0.3, 0.3, 1), c, Enum.Material.Neon, 0.3))
	end
	drumSets[m] = ds
	local dur = data.dur or 5
	local conn: RBXScriptConnection
	conn = RunService.Heartbeat:Connect(function(dt: number)
		local t = os.clock() - ds.born
		if drumSets[m] ~= ds or t > dur + 1.5 or not r.Parent then
			conn:Disconnect()
			if drumSets[m] == ds then
				drumSets[m] = nil
			end
			for _, d in ipairs(ds.drums) do
				for _, p in ipairs({ d.body, d.face, d.rims[1], d.rims[2], d.sigil[1], d.sigil[2], d.sigil[3] }) do
					fadeOut(p, 0.3)
				end
			end
			for _, l in ipairs(ds.links) do
				fadeOut(l, 0.3)
			end
			fadeOut(ds.core, 0.3)
			return
		end
		ds.spin += dt * (ds.gather and 6 or 0.35)
		local appear = math.clamp(t / 0.6, 0, 1)
		local cen, look = drumCenter(ds)
		ds.core.CFrame = CFrame.new(cen)
		local cs = 2 + (ds.gather or 0) * 7 + math.sin(t * 12) * 0.3
		ds.core.Size = Vector3.new(cs, cs, cs)
		for i, d in ipairs(ds.drums) do
			local pos = drumPos(ds, i)
			pos = cen:Lerp(pos, appear)
			d.pulse = math.max(0, d.pulse - dt * 5)
			local k = 1 + d.pulse * 0.35
			-- 북은 쓴 사람이 보는 쪽을 향한다 (원기둥 축 = 앞뒤)
			local cf = CFrame.lookAt(pos, pos + look) * CFrame.Angles(0, math.rad(90), 0)
			d.body.Size = Vector3.new(2.4, 4.6 * k, 4.6 * k)
			d.body.CFrame = cf
			d.face.Size = Vector3.new(0.2, 4.2 * k, 4.2 * k)
			d.face.CFrame = cf * CFrame.new(-1.25, 0, 0)
			d.face.Transparency = 0.35 - d.pulse * 0.35
			d.face.Color = d.pulse > 0.5 and WHITE or c2
			d.rims[1].CFrame = cf * CFrame.new(-1.1, 0, 0)
			d.rims[2].CFrame = cf * CFrame.new(1.1, 0, 0)
			d.rims[1].Size = Vector3.new(0.3, 4.9 * k, 4.9 * k)
			d.rims[2].Size = d.rims[1].Size
			-- 앞면의 번개 무늬 (갈지자 셋)
			for j, sp in ipairs(d.sigil) do
				sp.CFrame = cf * CFrame.new(-1.38, (j - 2) * 1.1 * k, 0) * CFrame.Angles(math.rad(j == 2 and -30 or 30), 0, 0)
			end
			-- 이웃 북을 잇는 번개 줄
			local nxt = drumPos(ds, i % #ds.drums + 1)
			nxt = cen:Lerp(nxt, appear)
			local l = ds.links[i]
			l.Size = Vector3.new(0.3, 0.3, math.max(0.2, (nxt - pos).Magnitude))
			l.CFrame = CFrame.lookAt((pos + nxt) / 2, nxt)
			l.Transparency = 0.25 + math.random() * 0.4
		end
		if math.random() < 0.15 then
			local i = math.random(1, #ds.drums)
			Fx.lightning(cen, drumPos(ds, i), c, 0.3)
		end
	end)
	Fx.sound("deflect", 1, 0.3, r.Position)
end
local function drumBeat(data: any)
	local ds = drumSets[data.m]
	local c, c2 = colors(data.style)
	local at: Vector3 = data.at
	local from = at + Vector3.new(0, 40, 0)
	if ds then
		local d = ds.drums[data.drum or 1]
		if d then
			d.pulse = 1
			from = d.face.CFrame.Position
			Fx.ring(d.face.CFrame.Position, c2, 2, 12, 0.3, flat(ds.r.CFrame.LookVector))
		end
	end
	if not near(at, 260) then
		return
	end
	local g = ground(at)
	-- 북에서 적까지 벼락, 땅에 닿는 자리에 짧은 기둥
	Fx.lightning(from, g, WHITE, 0.8)
	Fx.lightning(from, g, c, 0.5)
	local col = column(g, 14, 2, c2, 0.1)
	fadeOut(col, 0.25, { Size = Vector3.new(14, 0.3, 0.3) })
	impact(at, data.radius or 7, c, c2, 0.9)
	-- 북소리: 낮게 둥, 박자가 오를수록 조금씩 높게
	Fx.sound("heavy", 0.9, 0.45 + (data.i or 1) * 0.02, at)
	shakeNear(at, 0.5 + (data.i or 1) * 0.03, 90)
	if data.shock and ds then
		local rg = ground(ds.r.Position)
		for k = 0, 2 do
			task.delay(k * 0.05, function()
				Fx.ring(rg + Vector3.new(0, 0.4 + k, 0), k == 1 and c2 or c, 3, (data.shockRadius or 13) * 2.2 + k * 4, 0.45)
			end)
		end
		if opts.flash then
			opts.flash(Color3.fromRGB(235, 225, 255), 0.25)
		end
		Fx.breakSound("boom", 0.6, 1.1, at)
	end
end
local function drumFinale(data: any)
	local ds = drumSets[data.m]
	local c, c2 = colors(data.style)
	local at: Vector3 = data.at
	local fall = data.fall or 0.3
	local from = at + Vector3.new(0, 30, 0)
	if ds then
		-- 북이 모두 한가운데로 모이며 빠르게 돈다
		ds.gather = 0
		local t0 = os.clock()
		local conn: RBXScriptConnection
		conn = RunService.Heartbeat:Connect(function()
			local u = math.clamp((os.clock() - t0) / (fall * 0.8), 0, 1)
			ds.gather = u
			for _, d in ipairs(ds.drums) do
				d.pulse = 1
			end
			if u >= 1 then
				conn:Disconnect()
			end
		end)
		from = (drumCenter(ds))
		task.delay(fall * 0.8, function()
			if drumSets[data.m] == ds then
				drumSets[data.m] = nil
			end
		end)
	end
	if not near(at, 300) then
		return
	end
	-- 뇌구가 하늘에서 땅으로 떨어진다
	local orb = part(Vector3.new(9, 9, 9), WHITE, Enum.Material.Neon, 0, "ball")
	local shell = part(Vector3.new(14, 14, 14), c, Enum.Material.ForceField, 0.1, "ball")
	orb.CFrame = CFrame.new(from)
	shell.CFrame = CFrame.new(from)
	local g = ground(at)
	task.delay(fall * 0.6, function()
		tween(orb, fall * 0.4, { CFrame = CFrame.new(g + Vector3.new(0, 2, 0)) }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
		tween(shell, fall * 0.4, { CFrame = CFrame.new(g + Vector3.new(0, 2, 0)) }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
	end)
	task.delay(fall, function()
		orb:Destroy()
		shell:Destroy()
		local R = data.radius or 26
		local core = column(g, 200, 5, WHITE, 0)
		local outer = column(g, 200, R * 0.8, c, 0.3)
		fadeOut(core, 0.4, { Size = Vector3.new(200, 0.4, 0.4) })
		fadeOut(outer, 0.7, { Size = Vector3.new(200, R * 1.6, R * 1.6) })
		local dome = part(Vector3.new(4, 4, 4), c2, Enum.Material.Neon, 0.2, "ball")
		dome.CFrame = CFrame.new(g)
		fadeOut(dome, 0.6, { Size = Vector3.new(R * 2.4, R * 1.4, R * 2.4) })
		for k = 0, 4 do
			task.delay(k * 0.06, function()
				Fx.ring(g + Vector3.new(0, 0.4, 0), k % 2 == 0 and c or c2, 4, R * 2.4 + k * 10, 0.8)
			end)
		end
		for k = 1, 12 do
			local a = (k / 12) * math.pi * 2
			Fx.lightning(g + Vector3.new(0, 3, 0), g + Vector3.new(math.cos(a) * R * 1.1, 0, math.sin(a) * R * 1.1), k % 2 == 0 and c or c2, 0.8)
		end
		Fx.debris(g, 16, 50, Color3.fromRGB(80, 75, 95))
		Fx.flash(at, c2, 120, 10, 0.8)
		if opts.flash then
			opts.flash(WHITE, 0.5)
		end
		Fx.breakSound("boom", 1, 0.6, at)
		Fx.sound("heavy", 1, 0.3, at)
		shakeNear(at, 3, 160)
	end)
end

------------------------------------------------------------------------
-- 만목신권 (2.4판): 씨앗·가시덤불, 거대한 꽃봉오리, 나무 정령
------------------------------------------------------------------------
local BARK = Color3.fromRGB(92, 66, 44)
local LEAF = Color3.fromRGB(80, 170, 70)
local function thornBush(at: Vector3, radius: number, c: Color3, c2: Color3, linger: number?)
	local g = ground(at)
	local hold = 0.9 + (linger or 0)
	-- 가시 여덟이 땅에서 비스듬히 솟는다
	for k = 1, 8 do
		local a = k / 8 * math.pi * 2 + math.random() * 0.4
		local d = Vector3.new(math.cos(a), 0, math.sin(a))
		local tip = g + d * radius * 0.7 + Vector3.new(0, radius * 0.9, 0)
		local thorn = beam(g + d * 0.5, g + d * 0.5 + Vector3.new(0, 0.1, 0), 0.6, BARK, 0, Enum.Material.Wood)
		tween(thorn, 0.12, { Size = Vector3.new(0.6, 0.6, (tip - g).Magnitude), CFrame = CFrame.lookAt((g + tip) / 2, tip) }, Enum.EasingStyle.Back)
		local point = part(Vector3.new(0.3, 0.3, 1.2), c2, Enum.Material.Neon, 0)
		point.CFrame = CFrame.lookAt(tip, tip + (tip - g).Unit)
		task.delay(hold, function()
			fadeOut(thorn, 0.4, { CFrame = thorn.CFrame * CFrame.new(0, 0, (tip - g).Magnitude * 0.3) })
			fadeOut(point, 0.3)
		end)
	end
	local leaves = part(Vector3.new(1, 1, 1), c, Enum.Material.Grass, 0.1, "ball")
	leaves.CFrame = CFrame.new(g + Vector3.new(0, 0.8, 0))
	tween(leaves, 0.15, { Size = Vector3.new(radius * 1.3, radius * 0.6, radius * 1.3) }, Enum.EasingStyle.Back)
	-- 덤불 위로 작은 꽃 셋
	for k = 1, 3 do
		local fl = part(Vector3.new(0.8, 0.8, 0.8), k == 2 and Color3.fromRGB(255, 240, 120) or Color3.fromRGB(255, 170, 210), Enum.Material.Neon, 0, "ball")
		fl.CFrame = CFrame.new(g + Vector3.new(math.cos(k * 2.1) * radius * 0.35, radius * 0.55, math.sin(k * 2.1) * radius * 0.35))
		task.delay(hold, function()
			fadeOut(fl, 0.3)
		end)
	end
	task.delay(hold, function()
		fadeOut(leaves, 0.4)
	end)
	Fx.burst("spark", at, c, 10, 1)
end
local function seedShot(data: any)
	local from: Vector3 = data.from
	if not near(from, 220) then
		return
	end
	local _, c2 = colors(data.style)
	task.delay(data.delay or 0.18, function()
		for i, at in ipairs(data.spots or {}) do
			local seed = part(Vector3.new(0.7, 0.7, 0.9), Color3.fromRGB(150, 110, 60), Enum.Material.Wood, 0, "ball")
			local glow = part(Vector3.new(1.1, 1.1, 1.1), c2, Enum.Material.Neon, 0.6, "ball")
			seed.CFrame = CFrame.new(from + Vector3.new(0, 1.5, 0))
			glow.CFrame = seed.CFrame
			local to = ground(at) + Vector3.new(0, 0.4, 0)
			tween(seed, 0.15 + i * 0.01, { CFrame = CFrame.new(to) }, Enum.EasingStyle.Linear)
			tween(glow, 0.15 + i * 0.01, { CFrame = CFrame.new(to) }, Enum.EasingStyle.Linear)
			task.delay((data.sprout or 0.5) - 0.02, function()
				seed:Destroy()
				glow:Destroy()
			end)
		end
		Fx.sound("swing", 0.5, 1.6, from)
	end)
end
local function thornSprout(data: any)
	local c, c2 = colors(data.style)
	for _, at in ipairs(data.spots or {}) do
		if near(at, 200) then
			thornBush(at, data.radius or 6, c, c2, data.linger)
		end
	end
	local first = (data.spots or {})[1]
	if first then
		Fx.sound("hit", 0.7, 0.8, first)
	end
end
-- 거대한 꽃봉오리: 줄기와 잎 둘이 솟고, 꽃잎 여섯이 닫혀 있다가 활짝 펴진다
local buds: { [string]: { stem: BasePart, petals: { BasePart }, core: BasePart, leaves: { BasePart }, g: Vector3, R: number } } = {}
local PETAL = Color3.fromRGB(255, 170, 210)
local function petalCF(g: Vector3, R: number, k: number, open: number): CFrame
	local a = k / 6 * math.pi * 2
	local center = g + Vector3.new(0, R * 0.9, 0)
	-- open 0 = 위로 모여 닫힘, 1 = 바깥으로 눕도록 활짝
	local tilt = math.rad(10 + 75 * open)
	return CFrame.new(center) * CFrame.Angles(0, a, 0) * CFrame.Angles(-tilt, 0, 0) * CFrame.new(0, R * 0.32, 0)
end
local function budRise(data: any)
	local at: Vector3 = data.at
	if not near(at, 220) then
		return
	end
	local c, c2 = colors(data.style)
	local R = (data.radius or 16) * 0.65
	local g = ground(at)
	local key = keyOf(at)
	local stem = part(Vector3.new(R * 0.9, 1.2, 1.2), Color3.fromRGB(70, 140, 60), Enum.Material.SmoothPlastic, 0, "cyl")
	stem.CFrame = CFrame.new(g + Vector3.new(0, R * 0.45, 0)) * CFrame.Angles(0, 0, math.rad(90))
	local leaves = {}
	for _, x in ipairs({ -1, 1 }) do
		local l = part(Vector3.new(R * 0.7, 0.2, R * 0.3), LEAF, Enum.Material.SmoothPlastic, 0, "ball")
		l.CFrame = CFrame.new(g + Vector3.new(x * R * 0.35, R * 0.25, 0)) * CFrame.Angles(0, 0, x * math.rad(-25))
		table.insert(leaves, l)
	end
	local petals = {}
	for k = 1, 6 do
		local p = part(Vector3.new(R * 0.55, R * 0.75, 0.3), k % 2 == 0 and PETAL or c2:Lerp(PETAL, 0.5), Enum.Material.SmoothPlastic, 0, "ball")
		p.CFrame = petalCF(g, R, k, 0)
		table.insert(petals, p)
	end
	local core = part(Vector3.new(R * 0.4, R * 0.4, R * 0.4), Color3.fromRGB(255, 230, 120), Enum.Material.Neon, 0, "ball")
	core.CFrame = CFrame.new(g + Vector3.new(0, R * 0.95, 0))
	buds[key] = { stem = stem, petals = petals, core = core, leaves = leaves, g = g, R = R }
	-- 땅에서 솟아오른다
	local all = { stem, core }
	for _, p in ipairs(petals) do
		table.insert(all, p)
	end
	for _, p in ipairs(leaves) do
		table.insert(all, p)
	end
	for _, p in ipairs(all) do
		local cf = p.CFrame
		p.CFrame = cf - Vector3.new(0, R * 1.4, 0)
		tween(p, (data.delay or 0.7) * 0.6, { CFrame = cf }, Enum.EasingStyle.Back)
	end
	Fx.burst("dust", g + Vector3.new(0, 0.5, 0), Color3.fromRGB(140, 120, 90), 14, 1.4)
	Fx.sound("heavy", 0.6, 0.9, at)
	local _ = c
end
local function budBloom(data: any)
	local key = keyOf(data.at)
	local b = buds[key]
	local c, c2 = colors(data.style)
	if b then
		buds[key] = nil
		local t0 = os.clock()
		local conn: RBXScriptConnection
		conn = RunService.Heartbeat:Connect(function()
			local u = math.clamp((os.clock() - t0) / 0.25, 0, 1)
			for k, p in ipairs(b.petals) do
				p.CFrame = petalCF(b.g, b.R, k, 1 - (1 - u) ^ 2)
			end
			if u >= 1 then
				conn:Disconnect()
			end
		end)
		task.delay((data.sleep or 2) * 0.6, function()
			for _, p in ipairs(b.petals) do
				fadeOut(p, 0.6)
			end
			for _, p in ipairs(b.leaves) do
				fadeOut(p, 0.6)
			end
			fadeOut(b.stem, 0.6)
			fadeOut(b.core, 0.4)
		end)
	end
	if not near(data.at, 220) then
		return
	end
	-- 꽃가루 구름 (노란 빛 가루가 둘레로 퍼진다) + 잠든 적 위의 'z'
	local R = data.radius or 14
	local g = ground(data.at)
	local cloud = part(Vector3.new(2, 2, 2), Color3.fromRGB(255, 240, 150), Enum.Material.ForceField, 0.2, "ball")
	cloud.CFrame = CFrame.new(g + Vector3.new(0, 3, 0))
	fadeOut(cloud, 0.9, { Size = Vector3.new(R * 2.2, R * 0.8, R * 2.2) })
	for k = 0, 2 do
		task.delay(k * 0.08, function()
			Fx.ring(g + Vector3.new(0, 0.4, 0), k == 1 and c2 or Color3.fromRGB(255, 240, 150), 2, R * 2.2 + k * 4, 0.6)
		end)
	end
	Fx.burst("glitter", g + Vector3.new(0, 4, 0), Color3.fromRGB(255, 240, 150), 40, 2.4)
	Fx.text(g + Vector3.new(0, 10, 0), "Zzz", Color3.fromRGB(200, 220, 255), 34, 1.6)
	Fx.sound("ping", 0.8, 1.2, data.at)
	local _ = c
end
-- 나무 정령: 그루터기 다리, 줄기 몸, 옹이 얼굴의 초록 눈, 머리와 어깨의 잎 덤불, 가지 뿔, 굵은 팔과 주먹
type TPiece = { p: BasePart, limb: string, off: CFrame }
local function treantRise(data: any)
	local at: Vector3 = data.at
	if not near(at, 260) then
		return
	end
	local c, c2 = colors(data.style)
	local dir: Vector3 = data.dir or Vector3.new(0, 0, -1)
	local S = 3.6
	local g = ground(at) - dir * 14
	local face = CFrame.lookAt(g, g + dir)
	local pieces: { TPiece } = {}
	local function add(limb: string, size: Vector3, off: CFrame, color: Color3, mat: Enum.Material?, alpha: number?, shape: string?)
		local p = part(size * S, color, mat or Enum.Material.Wood, alpha or 0, shape)
		table.insert(pieces, { p = p, limb = limb, off = CFrame.new(off.Position * S) * off.Rotation })
	end
	local dark = BARK:Lerp(Color3.new(0, 0, 0), 0.25)
	for _, x in ipairs({ -1, 1 }) do
		add("B", Vector3.new(1.7, 3.2, 1.7), CFrame.new(x * 1.2, 1.5, 0) * CFrame.Angles(0, 0, x * math.rad(8)), dark)
		add("B", Vector3.new(0.6, 0.6, 2.4), CFrame.new(x * 1.8, 0.3, -0.8) * CFrame.Angles(math.rad(-20), x * math.rad(25), 0), dark)
	end
	add("B", Vector3.new(3.2, 5.2, 2.6), CFrame.new(0, 5.4, 0) * CFrame.Angles(math.rad(-6), 0, 0), BARK)
	add("B", Vector3.new(2.4, 2.2, 2.2), CFrame.new(0, 9.0, -0.3), dark)
	for _, x in ipairs({ -1, 1 }) do
		add("B", Vector3.new(0.45, 0.35, 0.12), CFrame.new(x * 0.5, 9.2, -1.42), c2, Enum.Material.Neon)
		add("B", Vector3.new(0.35, 2.6, 0.35), CFrame.new(x * 0.8, 11, 0.1) * CFrame.Angles(math.rad(-15), 0, x * math.rad(-30)), BARK)
		add("B", Vector3.new(3.2, 2.4, 3.2), CFrame.new(x * 2.4, 8.4, 0.4), LEAF:Lerp(c, 0.3), Enum.Material.Grass, 0, "ball")
	end
	add("B", Vector3.new(0.8, 0.2, 0.12), CFrame.new(0, 8.5, -1.42), Color3.fromRGB(30, 20, 15), Enum.Material.SmoothPlastic)
	add("B", Vector3.new(4.4, 3.2, 4.0), CFrame.new(0, 11.2, 0.5), LEAF, Enum.Material.Grass, 0, "ball")
	add("B", Vector3.new(1.4, 1.4, 1.4), CFrame.new(0, 5.8, -1.35), c2, Enum.Material.Neon, 0.3, "ball")
	for _, limb in ipairs({ "R", "L" }) do
		add(limb, Vector3.new(1.2, 3.2, 1.2), CFrame.new(0, -1.6, 0), BARK)
		add(limb, Vector3.new(1.1, 3.0, 1.1), CFrame.new(0, -4.4, -0.2), dark)
		add(limb, Vector3.new(2.0, 1.7, 2.0), CFrame.new(0, -6.3, -0.3), BARK)
		for k = -1, 1 do
			add(limb, Vector3.new(0.3, 1.2, 0.3), CFrame.new(k * 0.6, -7.4, -0.5) * CFrame.Angles(math.rad(20), 0, 0), dark)
		end
		add(limb, Vector3.new(1.6, 1.2, 1.6), CFrame.new(0, 0.2, 0.2), LEAF, Enum.Material.Grass, 0, "ball")
	end
	local SH = { R = Vector3.new(2.6, 7.6, 0), L = Vector3.new(-2.6, 7.6, 0) }
	local rise = data.rise or 0.9
	local sweep = data.sweep or 1.6
	local roots = data.roots or 2.4
	local dur = data.dur or 3.3
	local t0 = os.clock()
	local conn: RBXScriptConnection
	conn = RunService.Heartbeat:Connect(function()
		local t = os.clock() - t0
		if t > dur + 0.8 then
			conn:Disconnect()
			for _, pc in ipairs(pieces) do
				pc.p:Destroy()
			end
			return
		end
		-- 솟아오르기 · 가라앉기
		local up = 1 - (1 - math.clamp(t / rise, 0, 1)) ^ 3
		local down = math.clamp((t - dur) / 0.8, 0, 1)
		local y = -13 * S * (1 - up) - 13 * S * down
		-- 휩쓸기: 몸을 크게 돌린다
		local yaw = 0
		if t > sweep - 0.3 and t < sweep + 0.25 then
			local u = math.clamp((t - (sweep - 0.3)) / 0.45, 0, 1)
			yaw = -1.1 + 2.2 * u * u
		elseif t >= sweep + 0.25 then
			yaw = 1.1 * math.max(0, 1 - (t - sweep - 0.25) / 0.4)
		end
		local root = face * CFrame.new(0, y, 0) * CFrame.Angles(0, yaw, 0)
		-- 팔: 오른팔을 치켜들었다 내리치고, 휩쓸 때는 앞으로 뻗고, 뿌리 때는 두 팔을 치켜들었다 땅을 친다
		local aR, aL = 0.4, 0.4
		if t < rise - 0.18 then
			aR = 0.4 + 2.5 * math.clamp(t / (rise - 0.18), 0, 1)
		elseif t < rise then
			aR = 2.9 - 2.0 * ((t - (rise - 0.18)) / 0.18)
		elseif t < sweep - 0.3 then
			aR, aL = 0.9 + 0.7 * math.clamp((t - rise) / 0.3, 0, 1), 1.6 * math.clamp((t - rise) / 0.3, 0, 1)
		elseif t < roots - 0.35 then
			aR, aL = 1.6, 1.6
			if t > sweep + 0.25 then
				local u = math.clamp((t - sweep - 0.25) / 0.3, 0, 1)
				aR, aL = 1.6 + 1.3 * u, 1.6 + 1.3 * u
			end
		elseif t < roots then
			local u = (t - (roots - 0.35)) / 0.35
			aR, aL = 2.9 - 2.4 * u * u, 2.9 - 2.4 * u * u
		else
			aR, aL = 0.5, 0.5
		end
		local sR = root * CFrame.new(SH.R * S) * CFrame.Angles(aR, 0, 0)
		local sL = root * CFrame.new(SH.L * S) * CFrame.Angles(aL, 0, 0)
		for _, pc in ipairs(pieces) do
			local b = pc.limb == "R" and sR or (pc.limb == "L" and sL or root)
			pc.p.CFrame = b * pc.off
		end
	end)
	Fx.burst("dust", g + Vector3.new(0, 2, 0), Color3.fromRGB(120, 100, 70), 40, 3)
	Fx.debris(g, 12, 30, BARK)
	Fx.sound("heavy", 1, 0.35, g)
	shakeNear(g, 1.4, 120)
end
local function treantSlam(data: any)
	if near(data.at, 240) then
		local c, c2 = colors(data.style)
		impact(data.at, data.radius or 15, c, c2, 1.8)
		Fx.debris(ground(data.at), 14, 40, Color3.fromRGB(100, 80, 55))
		Fx.sound("heavy", 1, 0.45, data.at)
		shakeNear(data.at, 2, 120)
	end
end
local function treantSweep(data: any)
	local at: Vector3 = data.at
	if not near(at, 240) then
		return
	end
	local c, c2 = colors(data.style)
	local dir: Vector3 = data.dir or Vector3.new(0, 0, -1)
	local range = data.range or 30
	local half = math.rad((data.angle or 140) / 2)
	-- 휩쓴 자리에 흩날리는 잎 (부채꼴로)
	for k = 0, 10 do
		local a = -half + 2 * half * k / 10
		local d = (CFrame.Angles(0, a, 0) * CFrame.new(dir)).Position
		local p = at + d * range * 0.7 + Vector3.new(0, 2, 0)
		local leaf = part(Vector3.new(1.4, 0.15, 0.9), k % 2 == 0 and LEAF or c2, Enum.Material.SmoothPlastic, 0, "ball")
		leaf.CFrame = CFrame.new(at + d * 4 + Vector3.new(0, 3, 0))
		fadeOut(leaf, 0.5, { CFrame = CFrame.new(p) * CFrame.Angles(math.random() * 3, math.random() * 3, 0) })
	end
	Fx.ring(ground(at) + Vector3.new(0, 0.4, 0), c, 3, range * 2, 0.5)
	Fx.sound("swing", 1, 0.5, at)
	shakeNear(at, 1.2, 90)
end
local function treantRoots(data: any)
	local c, c2 = colors(data.style)
	for i, at in ipairs(data.spots or {}) do
		task.delay((i - 1) * 0.03, function()
			if near(at, 220) then
				local g = ground(at)
				local R = data.radius or 6
				-- 굵은 뿌리 셋이 땅을 뚫고 솟구친다
				for k = 0, 2 do
					local a = k / 3 * math.pi * 2 + math.random()
					local base = g + Vector3.new(math.cos(a), 0, math.sin(a)) * R * 0.4
					local tip = base + Vector3.new(math.cos(a) * 1.5, R * 1.6, math.sin(a) * 1.5)
					local r = beam(base, base + Vector3.new(0, 0.2, 0), 1.2, BARK, 0, Enum.Material.Wood)
					tween(r, 0.12, { Size = Vector3.new(1.2, 1.2, (tip - base).Magnitude), CFrame = CFrame.lookAt((base + tip) / 2, tip) }, Enum.EasingStyle.Back)
					task.delay(0.7, function()
						fadeOut(r, 0.4)
					end)
				end
				Fx.ring(g + Vector3.new(0, 0.3, 0), c, 2, R * 2.2, 0.4)
				Fx.debris(g, 4, 25, Color3.fromRGB(100, 80, 55))
			end
		end)
	end
	local first = (data.spots or {})[1]
	if first then
		Fx.sound("heavy", 0.8, 0.7, first)
	end
	local _ = c2
end

-- 개화의 꽃잎 회오리: 핀 꽃에서 꽃잎 수십 장이 나선으로 둘레에 휘몰아친다
local function budPetals(data: any)
	local at: Vector3 = data.at
	if not near(at, 220) then
		return
	end
	local c, c2 = colors(data.style)
	local R = data.radius or 22
	local g = ground(at)
	for k = 1, 28 do
		local a0 = k / 28 * math.pi * 2
		local p = part(Vector3.new(1.4, 0.12, 0.9), k % 3 == 0 and c2 or PETAL, Enum.Material.SmoothPlastic, 0, "ball")
		local t0 = os.clock()
		local life = 0.55
		local conn: RBXScriptConnection
		conn = RunService.Heartbeat:Connect(function()
			local u = math.clamp((os.clock() - t0) / life, 0, 1)
			local a = a0 + u * 3
			local r = 2 + (R - 2) * u
			p.CFrame = CFrame.new(g + Vector3.new(math.cos(a) * r, 3 + math.sin(u * math.pi) * 4, math.sin(a) * r)) * CFrame.Angles(u * 9, a, u * 5)
			p.Transparency = u * u
			if u >= 1 then
				conn:Disconnect()
				p:Destroy()
			end
		end)
	end
	Fx.ring(g + Vector3.new(0, 0.4, 0), PETAL, 3, R * 2.2, 0.5)
	Fx.sound("swing", 0.9, 1.1, at)
	local _ = c
end
-- 목령강림의 잎 폭풍: 둘레에 큰 잎이 소용돌이치며 쏟아진다
local function leafStorm(data: any)
	local at: Vector3 = data.at
	if not near(at, 240) then
		return
	end
	local c, c2 = colors(data.style)
	local R = data.radius or 22
	local dur = data.dur or 0.8
	local g = ground(at)
	local n = 36
	for k = 1, n do
		task.delay((k / n) * dur, function()
			local a = math.random() * math.pi * 2
			local r = math.random() * R
			local top = g + Vector3.new(math.cos(a) * r, 24, math.sin(a) * r)
			local leaf = part(Vector3.new(1.8, 0.14, 1.1), k % 2 == 0 and LEAF or c, Enum.Material.SmoothPlastic, 0, "ball")
			leaf.CFrame = CFrame.new(top) * CFrame.Angles(math.random() * 3, math.random() * 3, 0)
			fadeOut(leaf, 0.6, { CFrame = CFrame.new(top - Vector3.new(math.sin(a) * 6, 23, -math.cos(a) * 6)) * CFrame.Angles(math.random() * 6, math.random() * 6, 0) })
		end)
	end
	Fx.ring(g + Vector3.new(0, 0.4, 0), c2, 2, R * 2.2, dur)
	Fx.sound("swing", 0.8, 0.7, at)
end
-- 만목신권 생장 (네 번째 맞힘): 상대 자리의 가시덤불
local function thornPulse(data: any)
	if near(data.at, 200) then
		local c, c2 = colors(data.style)
		task.delay(data.delay or 0.3, function()
			thornBush(data.at, data.radius or 10, c, c2)
		end)
	end
end

local HANDLERS: { [string]: (any) -> () } = {
	needleShot = needleShot,
	needleBurst = needleBurst,
	gripRise = gripRise,
	gripSqueeze = gripSqueeze,
	gripSlam = gripSlam,
	dragonRoar = dragonRoar,
	palmWave = palmWave,
	palmBurst = palmBurst,
	sigilsPlace = sigilsPlace,
	sigilBolt = sigilBolt,
	railCharge = railCharge,
	railFire = railFire,
	bellDrop = bellDrop,
	bellRing = bellRing,
	vajraThrow = vajraThrow,
	cloneSpawn = cloneSpawn,
	cloneStrike = cloneStrike,
	shadowSlide = shadowSlide,
	shadowKick = shadowKick,
	orbitStart = orbitStart,
	orbitBurst = orbitBurst,
	hotGeyser = hotGeyser,
	wheelRoll = wheelRoll,
	flameRing = flameRing,
	volcanoRise = volcanoRise,
	vent = vent,
	eruptMain = eruptMain,
	meteorDrop = meteorDrop,
	bubbleTrap = bubbleTrap,
	bubblePop = bubblePop,
	waterSpear = waterSpear,
	whale = whale,
	twisterStart = twisterStart,
	twisterMove = twisterMove,
	twisterEnd = twisterEnd,
	downdraftWarn = downdraftWarn,
	downdraft = downdraft,
	diveMark = diveMark,
	diveImpact = diveImpact,
	yyShot = yyShot,
	yyOrbit = yyOrbit,
	taijiSeal = taijiSeal,
	starStart = starStart,
	starBeam = starBeam,
	starCrash = starCrash,
	ballStart = ballStart,
	ballArc = ballArc,
	ballBurst = ballBurst,
	lockOn = lockOn,
	judgeBolt = judgeBolt,
	drumRing = drumRing,
	drumBeat = drumBeat,
	drumFinale = drumFinale,
	seedShot = seedShot,
	thornSprout = thornSprout,
	budRise = budRise,
	budBloom = budBloom,
	treantRise = treantRise,
	treantSlam = treantSlam,
	treantSweep = treantSweep,
	treantRoots = treantRoots,
	thornPulse = thornPulse,
	budPetals = budPetals,
	leafStorm = leafStorm,
}
function Awake3.handles(data: any): boolean
	return HANDLERS[data.kind] ~= nil
end
function Awake3.run(data: any)
	local fn = HANDLERS[data.kind]
	if fn then
		fn(data)
	end
end

local _ = player
return Awake3
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="22">
          <Properties>
            <string name="Name">Blossom</string>
            <string name="Source"><![CDATA[-- 권왕 2.7판: 초·매화난무권의 새 기술 (화면). 날아가는 부채, 꽃 그림자, 하늘의 큰 부채
-- 부채는 살 (가는 대)과 그 사이의 분홍 면, 바깥의 짙은 테, 면 위의 벚꽃 무늬로 짓는다. 펼친 너비가 바뀌면 면의 너비도 다시 잰다
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local Config = require(ReplicatedStorage:WaitForChild("Config"))
local Fx = require(script.Parent:WaitForChild("Fx"))

local Blossom = {}
local _player = Players.LocalPlayer

local folder = Instance.new("Folder")
folder.Name = "KwonBlossom"
folder.Parent = workspace

local opts: any = {}
function Blossom.init(o: any)
	opts = o or {}
end

local PINKS = { Color3.fromRGB(255, 183, 213), Color3.fromRGB(255, 160, 200), Color3.fromRGB(255, 205, 225) }
local PINK_DEEP = Color3.fromRGB(232, 84, 146)
local WHITE = Color3.new(1, 1, 1)
local WOOD = Color3.fromRGB(70, 40, 30)
local GOLD = Color3.fromRGB(240, 200, 120)

local function tween(inst: Instance, time: number, goal: { [string]: any }, style: Enum.EasingStyle?, dir: Enum.EasingDirection?)
	local tw = TweenService:Create(inst, TweenInfo.new(math.max(0.01, time), style or Enum.EasingStyle.Quad, dir or Enum.EasingDirection.Out), goal)
	tw:Play()
	return tw
end
local function near(pos: Vector3, d: number): boolean
	local cam = workspace.CurrentCamera
	return cam ~= nil and (cam.CFrame.Position - pos).Magnitude < d
end
local function rootOf(m: Instance?): BasePart?
	local r = m and m:FindFirstChild("HumanoidRootPart")
	return (r and r:IsA("BasePart")) and r or nil
end
local function flat(v: Vector3): Vector3
	local f = Vector3.new(v.X, 0, v.Z)
	return f.Magnitude > 1e-3 and f.Unit or Vector3.new(0, 0, -1)
end
local function ground(at: Vector3): Vector3
	return Vector3.new(at.X, at.Y - 2.7, at.Z)
end
local function part(size: Vector3, color: Color3, material: Enum.Material?, alpha: number?, shape: string?): BasePart
	local q = Instance.new("Part")
	if shape == "ball" then
		q.Shape = Enum.PartType.Ball
	elseif shape == "cyl" then
		q.Shape = Enum.PartType.Cylinder
	end
	q.Anchored = true
	q.CanCollide = false
	q.CanQuery = false
	q.CanTouch = false
	q.CastShadow = false
	q.Size = size
	q.Color = color
	q.Material = material or Enum.Material.SmoothPlastic
	q.Transparency = alpha or 0
	q.Parent = folder
	return q
end
local function fadeOut(p: BasePart, time: number, goal: { [string]: any }?)
	local g = goal or {}
	g.Transparency = 1
	tween(p, time, g)
	task.delay(time + 0.05, function()
		p:Destroy()
	end)
end
local function shakeNear(pos: Vector3, amount: number, range: number)
	if opts.shake and near(pos, range) then
		opts.shake(amount)
	end
end
-- 꽃잎 하나 (납작한 타원). 흔들리며 떨어진다
local function petal(at: Vector3, size: number, life: number, push: Vector3?)
	local p = part(Vector3.new(0.05, size * 0.75, size), PINKS[math.random(1, 3)], Enum.Material.SmoothPlastic, 0.05, "ball")
	local drift = (push or Vector3.zero) + Vector3.new(math.random() - 0.5, -0.6 - math.random() * 0.5, math.random() - 0.5) * 3
	local t0 = os.clock()
	local ph = math.random() * 6
	local conn: RBXScriptConnection
	conn = RunService.Heartbeat:Connect(function()
		local t = os.clock() - t0
		if t > life or not p.Parent then
			conn:Disconnect()
			if p.Parent then
				fadeOut(p, 0.2)
			end
			return
		end
		local pos = at + drift * t + Vector3.new(math.sin(t * 4 + ph) * 0.5, 0, math.cos(t * 3 + ph) * 0.5)
		p.CFrame = CFrame.new(pos) * CFrame.Angles(t * 3 + ph, t * 2, math.sin(t * 5) * 0.8)
	end)
end

------------------------------------------------------------------------
-- 부채 한 자루 (기준: 사북이 0, 살은 -Z 쪽으로 뻗는다, 판은 XZ 평면). span = 펼친 각도
------------------------------------------------------------------------
type Fan = { ribs: { BasePart }, panels: { BasePart }, edges: { BasePart }, prints: { { p: BasePart, rib: number, r: number } }, pivot: BasePart, n: number, R: number, R0: number }
local function makeFan(R: number, alpha: number?, glow: boolean?): Fan
	local a = alpha or 0
	local n = 13
	local fan: Fan = { ribs = {}, panels = {}, edges = {}, prints = {}, pivot = part(Vector3.new(1, 1, 1) * R * 0.07, GOLD, Enum.Material.Metal, a, "ball"), n = n, R = R, R0 = R * 0.22 }
	for i = 1, n do
		fan.ribs[i] = part(Vector3.new(R * 0.03, R * 0.022, R), WOOD, Enum.Material.Wood, a)
		if i < n then
			local col = PINKS[(i % 3) + 1]:Lerp(WHITE, (i % 2) * 0.12)
			fan.panels[i] = part(Vector3.new(1, R * 0.012, R - fan.R0), col, glow and Enum.Material.Neon or Enum.Material.SmoothPlastic, glow and math.max(a, 0.35) or a)
			fan.edges[i] = part(Vector3.new(1, R * 0.016, R * 0.06), PINK_DEEP, Enum.Material.SmoothPlastic, a)
		end
	end
	-- 면 위의 벚꽃 셋 (살 번호와 거리로 자리를 잡는다)
	for _, at in ipairs({ { 4, 0.72 }, { 7, 0.6 }, { 10, 0.78 } }) do
		for j = 0, 4 do
			local p = part(Vector3.new(R * 0.07, R * 0.014, R * 0.055), j == 0 and WHITE or PINKS[2]:Lerp(WHITE, 0.35), Enum.Material.SmoothPlastic, a, "ball")
			table.insert(fan.prints, { p = p, rib = at[1] + 0.5, r = at[2] + j * 0.001 })
		end
	end
	return fan
end
local function placeFan(fan: Fan, cf: CFrame, span: number)
	local n, R, R0 = fan.n, fan.R, fan.R0
	fan.pivot.CFrame = cf
	local function ang(i: number): number
		return (i - 1) / (n - 1) * span - span / 2
	end
	for i, rib in ipairs(fan.ribs) do
		rib.CFrame = cf * CFrame.Angles(0, ang(i), 0) * CFrame.new(0, 0, -R / 2)
	end
	local dth = span / (n - 1)
	local rm = (R + R0) / 2
	local w = math.max(0.05, 2 * rm * math.sin(dth / 2) * 1.15)
	for i, pnl in ipairs(fan.panels) do
		local th = ang(i) + dth / 2
		pnl.Size = Vector3.new(w, pnl.Size.Y, R - R0)
		pnl.CFrame = cf * CFrame.Angles(0, th, 0) * CFrame.new(0, 0, -rm)
		local e = fan.edges[i]
		e.Size = Vector3.new(math.max(0.05, 2 * R * math.sin(dth / 2) * 1.12), e.Size.Y, e.Size.Z)
		e.CFrame = cf * CFrame.Angles(0, th, 0) * CFrame.new(0, R * 0.012, -R * 0.97)
	end
	for k, pr in ipairs(fan.prints) do
		local th = ang(pr.rib)
		local j = (k - 1) % 5
		local base = cf * CFrame.Angles(0, th, 0) * CFrame.new(0, R * 0.015, -R * pr.r)
		if j == 0 then
			pr.p.CFrame = base
		else
			local a = j / 4 * math.pi * 2
			pr.p.CFrame = base * CFrame.Angles(0, a, 0) * CFrame.new(0, 0, -R * 0.045)
		end
	end
end
local function fanParts(fan: Fan): { BasePart }
	local out = { fan.pivot }
	for _, l in ipairs({ fan.ribs, fan.panels, fan.edges }) do
		for _, p in ipairs(l) do
			table.insert(out, p)
		end
	end
	for _, pr in ipairs(fan.prints) do
		table.insert(out, pr.p)
	end
	return out
end
local function dropFan(fan: Fan, time: number)
	for _, p in ipairs(fanParts(fan)) do
		if p.Parent then
			fadeOut(p, time)
		end
	end
end

------------------------------------------------------------------------
-- 선풍낙화 (E): 양옆으로 둥글게 날아갔다 되돌아오는 부채 둘
------------------------------------------------------------------------
local function fanBoomerang(data: any)
	local from: Vector3 = data.from
	if not near(from, 220) then
		return
	end
	local look = flat(data.dir or Vector3.new(0, 0, -1))
	local right = Vector3.new(-look.Z, 0, look.X)
	local D, W, T = data.dist or 24, data.width or 9, data.time or 1.0
	local fans = { makeFan(2.6), makeFan(2.6) }
	local t0 = os.clock()
	local conn: RBXScriptConnection
	conn = RunService.Heartbeat:Connect(function()
		local t = os.clock() - t0
		local u = math.clamp(t / T, 0, 1)
		for i, fan in ipairs(fans) do
			local side = i == 1 and -1 or 1
			local pos = from + Vector3.new(0, 1.2, 0) + look * (D * (1 - math.cos(2 * math.pi * u)) / 2) + right * side * (W * math.sin(2 * math.pi * u))
			-- 펼친 채 빙글빙글 돈다 (조금 기울어)
			placeFan(fan, CFrame.new(pos) * CFrame.Angles(math.rad(10) * side, t * 22 * side, 0) * CFrame.new(0, 0, 1.1), math.rad(160))
			if math.random() < 0.7 then
				petal(pos + Vector3.new(math.random() - 0.5, 0, math.random() - 0.5) * 2, 0.6, 0.9)
			end
		end
		if u >= 1 then
			conn:Disconnect()
			for _, fan in ipairs(fans) do
				dropFan(fan, 0.15)
			end
			for _ = 1, 8 do
				petal(from + Vector3.new(0, 2, 0), 0.6, 0.8, Vector3.new(math.random() - 0.5, 0.5, math.random() - 0.5) * 6)
			end
		end
	end)
	Fx.sound("swing", 0.8, 1.3, from)
	task.delay(T * 0.5, function()
		Fx.sound("swing", 0.6, 1.5, from)
	end)
end

------------------------------------------------------------------------
-- 화영보 (R): 지나간 길에 남는 꽃 그림자 셋 (내 몸을 본뜬 분홍 그림자가 부채를 휘두르고 꽃잎으로 흩어진다)
------------------------------------------------------------------------
local function ghostOf(model: Model, offset: Vector3, color: Color3): { BasePart }
	local out: { BasePart } = {}
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("BasePart") and d.Transparency < 0.9 and d.Name ~= "HumanoidRootPart" then
			local g = part(d.Size, color, Enum.Material.ForceField, 0.15, (d:IsA("Part") and d.Shape == Enum.PartType.Ball) and "ball" or nil)
			g.CFrame = d.CFrame + offset
			table.insert(out, g)
		end
	end
	return out
end
local function petalShadow(data: any)
	local m = data.m
	local r = rootOf(m)
	if not r or not near(r.Position, 220) then
		return
	end
	local look = flat(data.dir or Vector3.new(0, 0, -1))
	local spots = data.spots or {}
	local start = r.Position
	local delay, every = data.delay or 0.25, data.every or 0.14
	local R = data.radius or 7.5
	local ghosts: { { BasePart } } = {}
	-- 미끄러지는 동안 지나간 자리마다 그림자를 남긴다
	for i, at in ipairs(spots) do
		task.delay(0.05 + i * 0.05, function()
			local cur = rootOf(m)
			local ref = cur and cur.Position or start
			ghosts[i] = ghostOf(m, Vector3.new(at.X - ref.X, 0, at.Z - ref.Z), PINKS[(i % 3) + 1])
			for _ = 1, 4 do
				petal(at + Vector3.new(0, 1, 0), 0.6, 0.7)
			end
		end)
		task.delay(delay + (i - 1) * every, function()
			-- 그림자의 부채질: 둘레를 가르는 분홍 반달 칼날
			local g = ground(at)
			local side = (i % 2 == 0) and 1 or -1
			for k = 0, 8 do
				local a = (k / 8 - 0.5) * math.pi * 1.2 * side
				local dirA = CFrame.Angles(0, a, 0) * look
				local seg = part(Vector3.new(0.18, 0.5, R * 0.35), k % 2 == 0 and PINK_DEEP or PINKS[1], Enum.Material.Neon, 0.1)
				seg.CFrame = CFrame.lookAt(g + Vector3.new(0, 2.6, 0) + dirA * R * 0.75, g + Vector3.new(0, 2.6, 0) + dirA * R * 0.75 + CFrame.Angles(0, math.pi / 2, 0) * dirA)
				fadeOut(seg, 0.25, { Size = Vector3.new(0.05, 0.3, R * 0.5) })
			end
			Fx.ring(g + Vector3.new(0, 0.3, 0), PINKS[2], 2, R * 2, 0.3)
			Fx.sound("swing", 0.6, 1.4 + i * 0.1, at)
		end)
	end
	-- 모두 꽃잎으로 흩어진다
	task.delay(delay + (#spots - 1) * every + (data.burstAt or 0.45), function()
		for i, list in pairs(ghosts) do
			local at = spots[i]
			for _, g in ipairs(list) do
				fadeOut(g, 0.25)
			end
			for _ = 1, 14 do
				petal(at + Vector3.new(0, 2, 0), 0.7, 1.0, Vector3.new(math.random() - 0.5, 0.8, math.random() - 0.5) * 10)
			end
			Fx.ring(ground(at) + Vector3.new(0, 0.3, 0), WHITE, 2, R * 2.4, 0.35)
		end
		Fx.breakSound("whoosh", 0.6, 1.5, start)
		shakeNear(start, 0.6, 70)
	end)
end

------------------------------------------------------------------------
-- 만화천선 (오의): 하늘의 큰 부채가 펼쳐지고, 앞의 땅을 두 번 쓸고, 접히며 꽃잎 폭풍
------------------------------------------------------------------------
local function skyFan(data: any)
	local at: Vector3 = data.at
	if not near(at, 260) then
		return
	end
	local look = flat(data.dir or Vector3.new(0, 0, -1))
	local range = data.range or 34
	local open, sweeps, sweepT = data.open or 0.6, data.sweeps or 2, data.sweepTime or 0.55
	local closeAt = data.closeAt or 0.35
	local fan = makeFan(range * 0.95, 0.05, false)
	local g = ground(at)
	local pivot = g + Vector3.new(0, 7, 0) - look * 3
	local baseYaw = math.atan2(-look.X, -look.Z)
	local t0 = os.clock()
	local tSweepEnd = open + sweeps * (sweepT + 0.05)
	local tClose = tSweepEnd + closeAt
	local done = false
	local conn: RBXScriptConnection
	conn = RunService.Heartbeat:Connect(function()
		local t = os.clock() - t0
		local span, yaw, h
		if t < open then
			-- 하늘에서 내려오며 펼쳐진다
			local k = t / open
			local e = 1 - (1 - k) ^ 3
			span = math.rad(10 + 140 * e)
			yaw = 0
			h = 18 - 11 * e
		elseif t < tSweepEnd then
			-- 쓸기: 홀수 번은 왼쪽에서 오른쪽으로, 짝수 번은 거꾸로 (끝에서 끝까지)
			local k = math.floor((t - open) / (sweepT + 0.05))
			local u = math.clamp(((t - open) - k * (sweepT + 0.05)) / sweepT, 0, 1)
			local e = u * u * (3 - 2 * u)
			local a = math.rad(55)
			yaw = (k % 2 == 0) and (-a + 2 * a * e) or (a - 2 * a * e)
			span = math.rad(150)
			h = 7
			if math.random() < 0.8 then
				local rr = math.random() * range
				local aa = baseYaw + yaw + (math.random() - 0.5) * span
				petal(g + Vector3.new(-math.sin(aa) * rr, 3 + math.random() * 3, -math.cos(aa) * rr), 0.9, 1.0)
			end
		elseif t < tClose then
			-- 접힌다 (탁!)
			local k = math.clamp((t - tSweepEnd) / closeAt, 0, 1)
			span = math.rad(150) * (1 - k * k)
			yaw = 0
			h = 7 + 4 * k
		else
			if not done then
				done = true
				conn:Disconnect()
				dropFan(fan, 0.3)
				-- 꽃잎 폭풍: 둘레를 휘감으며 솟는다
				local R = data.closeRadius or 26
				for i = 0, 59 do
					local a = i / 60 * math.pi * 2
					local rr = R * (0.3 + (i % 5) * 0.16)
					local p0 = g + Vector3.new(math.cos(a) * rr, 1 + (i % 4), math.sin(a) * rr)
					petal(p0, 1.0, 1.3, Vector3.new(-math.sin(a), 0.6, math.cos(a)) * 14)
				end
				Fx.ring(g + Vector3.new(0, 0.3, 0), PINK_DEEP, 4, R * 2.4, 0.6)
				task.delay(0.08, function()
					Fx.ring(g + Vector3.new(0, 0.35, 0), WHITE, 4, R * 2, 0.5)
				end)
				Fx.flash(at, PINKS[2], 90, 6, 0.6)
				Fx.breakSound("whoosh", 1, 1.1, at)
				shakeNear(at, 1.8, 140)
			end
			return
		end
		local cf = CFrame.new(pivot.X, g.Y + h, pivot.Z) * CFrame.Angles(0, baseYaw + yaw, 0) * CFrame.Angles(math.rad(-8), 0, 0)
		placeFan(fan, cf, span)
	end)
	Fx.sound("swing", 0.9, 0.6, at)
	for k = 1, sweeps do
		task.delay(open + (k - 1) * (sweepT + 0.05), function()
			Fx.sound("swing", 1, 0.8, at)
			shakeNear(at, 0.8, 90)
		end)
	end
	task.delay(tSweepEnd + closeAt * 0.8, function()
		Fx.sound("hit", 1, 0.7, at)
	end)
end

local HANDLERS: { [string]: (any) -> () } = {
	fanBoomerang = fanBoomerang,
	petalShadow = petalShadow,
	skyFan = skyFan,
}
function Blossom.handles(data: any): boolean
	return HANDLERS[data.kind] ~= nil
end
function Blossom.run(data: any)
	local fn = HANDLERS[data.kind]
	if fn then
		fn(data)
	end
end
-- 렌더 확인용
Blossom._makeFan = makeFan
Blossom._placeFan = placeFan
Blossom._fanParts = fanParts
local _ = Config
return Blossom
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="23">
          <Properties>
            <string name="Name">Cutscene</string>
            <string name="Source"><![CDATA[-- 권왕: 컷씬 (위아래 검은 띠, 말하는 이와 대사, 천천히 도는 카메라) 과 처음 들어온 사람의 조작 안내
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

local Cutscene = {}
Cutscene.active = false

local player = Players.LocalPlayer
local queue: { any } = {}

local gui = Instance.new("ScreenGui")
gui.Name = "KwonCutscene"
gui.ResetOnSpawn = false
gui.IgnoreGuiInset = true
gui.DisplayOrder = 50
gui.Enabled = false
gui.Parent = player:WaitForChild("PlayerGui")

local function tween(inst: Instance, time: number, goal: { [string]: any })
	local tw = TweenService:Create(inst, TweenInfo.new(time, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), goal)
	tw:Play()
	return tw
end

local function frame(props: { [string]: any }): Frame
	local f = Instance.new("Frame")
	f.BorderSizePixel = 0
	for k, v in pairs(props) do
		(f :: any)[k] = v
	end
	return f
end

local function label(props: { [string]: any }): TextLabel
	local l = Instance.new("TextLabel")
	l.BackgroundTransparency = 1
	l.Font = Enum.Font.GothamBold
	l.TextColor3 = Color3.new(1, 1, 1)
	l.TextStrokeTransparency = 0.6
	for k, v in pairs(props) do
		(l :: any)[k] = v
	end
	return l
end

-- 위아래 띠
local top = frame({ Name = "Top", BackgroundColor3 = Color3.new(0, 0, 0), Size = UDim2.fromScale(1, 0), Parent = gui })
local bottom = frame({ Name = "Bottom", BackgroundColor3 = Color3.new(0, 0, 0), AnchorPoint = Vector2.new(0, 1), Position = UDim2.fromScale(0, 1), Size = UDim2.fromScale(1, 0), Parent = gui })
local who = label({ Name = "Who", AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -118), Size = UDim2.new(0.8, 0, 0, 30), TextScaled = true, TextColor3 = Color3.fromRGB(255, 215, 130), Text = "", Parent = gui })
local line = label({ Name = "Line", AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -26), Size = UDim2.new(0.8, 0, 0, 86), TextScaled = true, TextWrapped = true, Font = Enum.Font.Gotham, Text = "", Parent = gui })
local sizeLimit = Instance.new("UITextSizeConstraint")
sizeLimit.MaxTextSize = 30
sizeLimit.Parent = line
label({ Name = "Next", AnchorPoint = Vector2.new(1, 1), Position = UDim2.new(1, -20, 1, -8), Size = UDim2.new(0, 220, 0, 20), TextScaled = true, Font = Enum.Font.Gotham, TextColor3 = Color3.fromRGB(190, 190, 190), Text = "누르면 다음 ▶", TextXAlignment = Enum.TextXAlignment.Right, Parent = gui })
-- 화면 아무 곳이나 누르면 다음 대사
local tap = Instance.new("TextButton")
tap.Name = "Tap"
tap.BackgroundTransparency = 1
tap.Text = ""
tap.Size = UDim2.fromScale(1, 1)
tap.Parent = gui
local skip = Instance.new("TextButton")
skip.Name = "Skip"
skip.AnchorPoint = Vector2.new(1, 0)
skip.Position = UDim2.new(1, -20, 0, 20)
skip.Size = UDim2.new(0, 130, 0, 36)
skip.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
skip.BackgroundTransparency = 0.3
skip.TextColor3 = Color3.new(1, 1, 1)
skip.Font = Enum.Font.GothamBold
skip.TextScaled = true
skip.Text = "건너뛰기 ▶▶"
skip.ZIndex = 3
skip.Parent = gui
local corner = Instance.new("UICorner")
corner.CornerRadius = UDim.new(0, 8)
corner.Parent = skip

local advance = false
local skipped = false
tap.Activated:Connect(function()
	advance = true
end)
skip.Activated:Connect(function()
	skipped = true
	advance = true
end)

-- 움직임 막기 (컷씬 동안 캐릭터가 걷지 않게)
local function controls(on: boolean)
	pcall(function()
		local ps = player:FindFirstChild("PlayerScripts")
		local pm = ps and ps:FindFirstChild("PlayerModule")
		if pm and pm:IsA("ModuleScript") then
			local c = (require :: any)(pm):GetControls()
			if on then
				c:Enable()
			else
				c:Disable()
			end
		end
	end)
end

local function rootOf(m: Model?): BasePart?
	local r = m and m:FindFirstChild("HumanoidRootPart")
	return (r and r:IsA("BasePart")) and r or nil
end

-- 비출 곳: 모델이면 그 몸, 자리면 그 자리, 없으면 나
local function subjectOf(subject: any): (() -> Vector3, number)
	local m = subject and subject.m
	if typeof(m) == "Instance" and m:IsA("Model") then
		local scale = tonumber(m:GetAttribute("Scale")) or 1
		return function()
			local r = rootOf(m)
			return r and r.Position + Vector3.new(0, 1.5 * scale, 0) or Vector3.zero
		end, 10 + 4 * scale
	end
	local at = subject and subject.at
	if typeof(at) == "Vector3" then
		return function()
			return at + Vector3.new(0, 4, 0)
		end, subject.far and 60 or 16
	end
	return function()
		local r = rootOf(player.Character)
		return r and r.Position + Vector3.new(0, 1.5, 0) or Vector3.zero
	end, 12
end

local function runOne(item: any)
	Cutscene.active = true
	advance, skipped = false, false
	controls(false)
	local cam = workspace.CurrentCamera
	local oldType = cam.CameraType
	local focus, dist = subjectOf(item.subject)
	-- 처음 각도: 내 쪽에서 비스듬히 (대상이 나를 보고 말하는 듯)
	local me = rootOf(player.Character)
	local p0 = focus()
	local from = me and Vector3.new(me.Position.X - p0.X, 0, me.Position.Z - p0.Z) or Vector3.new(0, 0, 1)
	local a0 = (from.Magnitude > 0.1 and math.atan2(from.Z, from.X) or 0) + 0.5
	local t0 = os.clock()
	cam.CameraType = Enum.CameraType.Scriptable
	local conn = RunService.RenderStepped:Connect(function()
		local p = focus()
		local a = a0 + (os.clock() - t0) * 0.06
		local eye = p + Vector3.new(math.cos(a) * dist, dist * 0.28, math.sin(a) * dist)
		cam.CFrame = cam.CFrame:Lerp(CFrame.lookAt(eye, p), 0.12)
	end)
	cam.CFrame = CFrame.lookAt(p0 + Vector3.new(math.cos(a0) * dist * 1.4, dist * 0.4, math.sin(a0) * dist * 1.4), p0)
	gui.Enabled = true
	who.Text = item.scene.who or ""
	line.Text = ""
	tween(top, 0.35, { Size = UDim2.fromScale(1, 0.11) })
	tween(bottom, 0.35, { Size = UDim2.new(1, 0, 0, 150) })
	task.wait(0.35)
	for _, text in ipairs(item.scene.lines or {}) do
		if skipped then
			break
		end
		advance = false
		local n = utf8.len(text) or #text
		local dur = math.clamp(1.6 + n * 0.07, 2.4, 6)
		-- 한 글자씩
		local shown = 0
		local typeStart = os.clock()
		while shown < n and not advance do
			shown = math.min(n, math.floor((os.clock() - typeStart) / 0.035) + 1)
			local cut = utf8.offset(text, shown + 1)
			line.Text = cut and string.sub(text, 1, cut - 1) or text
			RunService.RenderStepped:Wait()
		end
		line.Text = text
		advance = false
		local t = os.clock()
		while os.clock() - t < dur and not advance do
			RunService.RenderStepped:Wait()
		end
	end
	tween(top, 0.3, { Size = UDim2.fromScale(1, 0) })
	tween(bottom, 0.3, { Size = UDim2.fromScale(1, 0) })
	who.Text = ""
	line.Text = ""
	task.wait(0.3)
	conn:Disconnect()
	gui.Enabled = false
	cam.CameraType = oldType == Enum.CameraType.Scriptable and Enum.CameraType.Custom or oldType
	controls(true)
	Cutscene.active = false
	if item.onDone then
		task.spawn(item.onDone)
	end
end

local running = false
local function pump()
	if running then
		return
	end
	running = true
	task.spawn(function()
		while #queue > 0 do
			local item = table.remove(queue, 1)
			local ok, err = pcall(runOne, item)
			if not ok then
				warn("[권왕] 컷씬 오류:", err)
				pcall(function()
					gui.Enabled = false
					workspace.CurrentCamera.CameraType = Enum.CameraType.Custom
				end)
				controls(true)
				Cutscene.active = false
			end
		end
		running = false
	end)
end

-- scene = { who, lines }, subject = { m = 모델 } 또는 { at = 자리 }
function Cutscene.play(scene: any, subject: any?, onDone: (() -> ())?)
	if type(scene) ~= "table" then
		return
	end
	table.insert(queue, { scene = scene, subject = subject, onDone = onDone })
	pump()
end

------------------------------------------------------------------------
-- 처음 들어온 사람에게 한 번: 조작 안내
------------------------------------------------------------------------
function Cutscene.controls(onDone: (() -> ())?)
	local card = Instance.new("ScreenGui")
	card.Name = "KwonControls"
	card.ResetOnSpawn = false
	card.DisplayOrder = 45
	card.Parent = player:WaitForChild("PlayerGui")
	local dim = frame({ BackgroundColor3 = Color3.new(0, 0, 0), BackgroundTransparency = 0.45, Size = UDim2.fromScale(1, 1), Parent = card })
	local panel = frame({ AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.new(0.92, 0, 0.8, 0), BackgroundColor3 = Color3.fromRGB(28, 24, 22), Parent = dim })
	local sizeC = Instance.new("UISizeConstraint")
	sizeC.MaxSize = Vector2.new(520, 430)
	sizeC.Parent = panel
	local pc = Instance.new("UICorner")
	pc.CornerRadius = UDim.new(0, 14)
	pc.Parent = panel
	local stroke = Instance.new("UIStroke")
	stroke.Color = Color3.fromRGB(235, 190, 80)
	stroke.Thickness = 2
	stroke.Parent = panel
	label({ Position = UDim2.new(0, 0, 0, 12), Size = UDim2.new(1, 0, 0, 34), TextScaled = true, Font = Enum.Font.GothamBlack, TextColor3 = Color3.fromRGB(255, 215, 130), Text = "🥋 조작법", Parent = panel })
	local touch = UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled
	local rows = touch and {
		{ "왼쪽 화면", "움직이기" },
		{ "👊 버튼", "연타 (네 번 이으면 마무리 일격)" },
		{ "강타 버튼", "꾹 눌렀다 떼면 모아치기" },
		{ "E · R · G 버튼", "기술 · 오의" },
		{ "🛡 버튼", "막기. 맞기 직전에 누르면 흘리기" },
		{ "회피 버튼", "구르며 피하기 (잠깐 무적)" },
		{ "🐎 버튼", "탈것 타기·내리기" },
		{ "말 걸기", "사람·수련터·상점 가까이에서 뜨는 버튼" },
	} or {
		{ "마우스 왼쪽", "연타 (네 번 이으면 마무리 일격)" },
		{ "Z (누르고 떼기)", "강타 · 모아치기" },
		{ "E · R / G", "기술 / 오의" },
		{ "F", "막기. 맞기 직전에 누르면 흘리기" },
		{ "Q / Shift", "회피 / 달리기" },
		{ "Space 두 번", "이단 뛰기" },
		{ "T", "말 걸기 · 수련 · 상점" },
		{ "Tab / M / H", "능력치 / 지도 / 회복약" },
		{ "V", "탈것 타기·내리기" },
		{ "마우스 오른쪽 끌기", "시점 돌리기" },
	}
	local list = frame({ BackgroundTransparency = 1, Position = UDim2.new(0, 24, 0, 56), Size = UDim2.new(1, -48, 1, -120), Parent = panel })
	local layout = Instance.new("UIListLayout")
	layout.Padding = UDim.new(0, 4)
	layout.Parent = list
	for _, r in ipairs(rows) do
		local row = frame({ BackgroundTransparency = 1, Size = UDim2.new(1, 0, 1 / #rows, -4), Parent = list })
		label({ Size = UDim2.fromScale(0.4, 1), TextScaled = true, TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = Color3.fromRGB(255, 225, 160), Text = r[1], Parent = row })
		label({ Position = UDim2.fromScale(0.42, 0), Size = UDim2.fromScale(0.58, 1), TextScaled = true, TextXAlignment = Enum.TextXAlignment.Left, Font = Enum.Font.Gotham, Text = r[2], Parent = row })
	end
	local ok = Instance.new("TextButton")
	ok.AnchorPoint = Vector2.new(0.5, 1)
	ok.Position = UDim2.new(0.5, 0, 1, -14)
	ok.Size = UDim2.new(0, 200, 0, 44)
	ok.BackgroundColor3 = Color3.fromRGB(235, 190, 80)
	ok.TextColor3 = Color3.fromRGB(30, 20, 10)
	ok.Font = Enum.Font.GothamBlack
	ok.TextScaled = true
	ok.Text = "알겠어요"
	ok.Parent = panel
	local oc = Instance.new("UICorner")
	oc.CornerRadius = UDim.new(0, 10)
	oc.Parent = ok
	ok.Activated:Connect(function()
		card:Destroy()
		if onDone then
			onDone()
		end
	end)
end

return Cutscene
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="24">
          <Properties>
            <string name="Name">Demon</string>
            <string name="Source"><![CDATA[-- 권왕 2.7판: 피의 악마 (화면에만 보이는 연출). 처음부터 다시 짰다
-- 혈해만마: 피의 바다에서 허리까지 솟은 마수들이 손톱을 휘두른다
-- 혈월만겸: 쓴 사람 뒤에서 날개 달린 거대한 우두머리 악마가 솟아, 큰 낫을 치켜들었다가 내리찍는다
-- 생김새: 굽은 등과 넓은 가슴, 뒤로 휘어 감기는 이어진 뿔, 이마 아래 빛나는 눈, 긴 팔과 갈고리 손가락,
-- 뼈대 사이에 막이 이어진 박쥐 날개 (세모 조각으로 막을 채운다), 초승달처럼 휜 한 장의 낫날
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local Demon = {}

local SKIN = Color3.fromRGB(58, 10, 14)
local SKIN2 = Color3.fromRGB(88, 16, 22)
local PLATE = Color3.fromRGB(34, 8, 11)
local HORN = Color3.fromRGB(28, 20, 20)
local BONE = Color3.fromRGB(214, 196, 178)
local WING = Color3.fromRGB(72, 10, 18)
local EYE = Color3.fromRGB(255, 70, 40)
local RED = Color3.fromRGB(220, 24, 40)
local IRON = Color3.fromRGB(46, 12, 16)
local SHAFT = Color3.fromRGB(30, 14, 14)

local folder = Instance.new("Folder")
folder.Name = "KwonDemon"
folder.Parent = workspace

type Piece = { p: BasePart, limb: string, off: CFrame }
export type Handle = {
	root: CFrame,
	armR: number,
	armL: number,
	scale: number,
	pieces: { Piece },
	model: Model,
	alive: boolean,
	born: number,
	anim: ((t: number) -> ())?,
	conn: RBXScriptConnection?,
}

local function newPart(size: Vector3, color: Color3, material: Enum.Material?, alpha: number?, shape: string?): BasePart
	local p: BasePart
	if shape == "wedge" then
		p = Instance.new("WedgePart")
	else
		local q = Instance.new("Part")
		if shape == "ball" then
			q.Shape = Enum.PartType.Ball
		elseif shape == "cyl" then
			q.Shape = Enum.PartType.Cylinder
		end
		p = q
	end
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	p.Size = size
	p.Color = color
	p.Material = material or Enum.Material.SmoothPlastic
	p.Transparency = alpha or 0
	return p
end

-- 관절 자리 (팔은 어깨를 축으로 앞뒤로 돈다: 0 = 아래로 늘어뜨림, π/2 = 앞으로 뻗음, π = 머리 위)
local SHOULDER_R = Vector3.new(2.05, 6.55, 0)
local SHOULDER_L = Vector3.new(-2.05, 6.55, 0)
local WING_R = Vector3.new(1.0, 7.2, 0.95)
local WING_L = Vector3.new(-1.0, 7.2, 0.95)

local function place(h: Handle)
	local s = h.scale
	local root = h.root
	local t = os.clock() - h.born
	local flap = math.sin(t * 2.2) * 0.12
	local frames = {
		B = root,
		R = root * CFrame.new(SHOULDER_R * s) * CFrame.Angles(h.armR, 0, 0),
		L = root * CFrame.new(SHOULDER_L * s) * CFrame.Angles(h.armL, 0, 0),
		WR = root * CFrame.new(WING_R * s) * CFrame.Angles(0, -flap, -flap * 0.5),
		WL = root * CFrame.new(WING_L * s) * CFrame.Angles(0, flap, flap * 0.5),
	}
	for _, pc in ipairs(h.pieces) do
		pc.p.CFrame = (frames[pc.limb] or root) * pc.off
	end
end

-- rootCf: 발밑 (악마는 -Z 쪽을 본다). scale 1 = 사람보다 조금 큰 키 (약 9칸)
function Demon.spawn(rootCf: CFrame, scale: number, opts: { scythe: boolean?, wings: boolean?, legs: boolean? }?): Handle
	local o = opts or {}
	local s = scale
	local model = Instance.new("Model")
	model.Name = "KwonDemon"
	local h: Handle = { root = rootCf, armR = 0.3, armL = 0.3, scale = s, pieces = {}, model = model, alive = true, born = os.clock() }
	local function add(limb: string, size: Vector3, cf: CFrame, color: Color3, mat: Enum.Material?, alpha: number?, shape: string?): BasePart
		local p = newPart(size * s, color, mat, alpha, shape)
		p.Parent = model
		table.insert(h.pieces, { p = p, limb = limb, off = CFrame.new(cf.Position * s) * cf.Rotation })
		return p
	end
	-- 세모 하나 = 쐐기 둘 (로블록스에서 세모를 그리는 흔한 방법). 꼭짓점은 그 부위 기준 좌표
	local function tri(limb: string, a: Vector3, b: Vector3, c: Vector3, color: Color3, mat: Enum.Material?, alpha: number?, thick: number?)
		local ab, ac, bc = b - a, c - a, c - b
		local abd, acd, bcd = ab:Dot(ab), ac:Dot(ac), bc:Dot(bc)
		if abd > acd and abd > bcd then
			c, a = a, c
		elseif acd > bcd and acd > abd then
			a, b = b, a
		end
		ab, ac, bc = b - a, c - a, c - b
		if ac:Cross(ab).Magnitude < 1e-4 then
			return
		end
		local right = ac:Cross(ab).Unit
		local up = bc:Cross(right).Unit
		local back = bc.Unit
		local height = math.abs(ab:Dot(up))
		local th = (thick or 0.12)
		local w1 = add(limb, Vector3.new(th, height, math.abs(ab:Dot(back))), CFrame.fromMatrix((a + b) / 2, right, up, back), color, mat, alpha, "wedge")
		local w2 = add(limb, Vector3.new(th, height, math.abs(ac:Dot(back))), CFrame.fromMatrix((a + c) / 2, -right, up, -back), color, mat, alpha, "wedge")
		local _ = w1
		local _ = w2
	end
	-- 이어진 마디 (뿔·손가락·꼬리): 마디마다 조금씩 꺾이며 가늘어진다. 마디는 서로 겹쳐 끊기지 않는다
	local function chain(limb: string, start: CFrame, n: number, len: number, w0: number, w1: number, bend: CFrame, color: Color3, mat: Enum.Material?): CFrame
		local cf = start
		for j = 0, n - 1 do
			local u = j / math.max(1, n - 1)
			local w = w0 + (w1 - w0) * u
			add(limb, Vector3.new(w, len * 1.3, w), cf * CFrame.new(0, len / 2, 0), color, mat)
			cf = cf * CFrame.new(0, len, 0) * bend
		end
		return cf
	end

	-- 허리와 다리 (다리가 있으면 짐승처럼 무릎이 앞으로, 발목이 뒤로 꺾인다)
	add("B", Vector3.new(1.9, 0.95, 1.25), CFrame.new(0, 3.45, 0.05), SKIN)
	if o.legs ~= false then
		for _, x in ipairs({ -1, 1 }) do
			add("B", Vector3.new(1.0, 2.0, 1.1), CFrame.new(x * 0.78, 2.55, -0.25) * CFrame.Angles(math.rad(22), 0, x * math.rad(-4)), SKIN2)
			add("B", Vector3.new(0.75, 1.7, 0.8), CFrame.new(x * 0.82, 1.35, 0.25) * CFrame.Angles(math.rad(-28), 0, 0), SKIN)
			add("B", Vector3.new(0.6, 0.9, 0.65), CFrame.new(x * 0.82, 0.45, 0.32) * CFrame.Angles(math.rad(14), 0, 0), SKIN2)
			add("B", Vector3.new(0.85, 0.35, 1.2), CFrame.new(x * 0.82, 0.16, -0.12), PLATE)
			for j = -1, 1 do
				add("B", Vector3.new(0.16, 0.16, 0.5), CFrame.new(x * 0.82 + j * 0.26, 0.12, -0.8) * CFrame.Angles(math.rad(12), j * 0.2, 0), BONE)
			end
		end
		-- 꼬리: 허리 뒤에서 땅으로 늘어졌다가 끝이 들린다
		local tip = chain("B", CFrame.new(0, 3.3, 0.6) * CFrame.Angles(math.rad(-120), 0, 0), 7, 0.75, 0.5, 0.16, CFrame.Angles(math.rad(10), math.rad(6), 0), SKIN)
		add("B", Vector3.new(0.5, 0.6, 0.12), tip * CFrame.new(0, 0.15, 0) * CFrame.Angles(0, 0, math.rad(45)), PLATE)
	end
	-- 배와 가슴: 아래는 좁고 위는 넓게, 등이 굽었다
	add("B", Vector3.new(1.75, 1.35, 1.15), CFrame.new(0, 4.45, -0.05), SKIN2)
	for i = 0, 2 do
		add("B", Vector3.new(1.3 - i * 0.12, 0.3, 0.1), CFrame.new(0, 4.0 + i * 0.42, -0.63), PLATE)
	end
	add("B", Vector3.new(3.4, 2.05, 1.9), CFrame.new(0, 6.05, 0.05) * CFrame.Angles(math.rad(-10), 0, 0), SKIN)
	for _, x in ipairs({ -1, 1 }) do
		add("B", Vector3.new(1.45, 1.0, 0.45), CFrame.new(x * 0.74, 6.35, -0.92) * CFrame.Angles(math.rad(-12), 0, x * math.rad(-6)), SKIN2)
		-- 어깨 근육과 그 위로 솟은 뼈 가시 둘
		add("B", Vector3.new(1.55, 1.45, 1.6), CFrame.new(x * 1.95, 6.85, 0.05), SKIN2, nil, nil, "ball")
		for j = 0, 1 do
			chain("B", CFrame.new(x * (1.75 + j * 0.45), 7.4, 0.25 + j * 0.2) * CFrame.Angles(math.rad(-30), 0, x * math.rad(-25)), 3, 0.4 - j * 0.08, 0.3, 0.08, CFrame.Angles(math.rad(-12), 0, 0), BONE)
		end
	end
	-- 가슴 한가운데의 갈라진 틈 (속에서 핏빛이 샌다)
	add("B", Vector3.new(0.12, 1.4, 0.08), CFrame.new(0, 6.0, -1.08) * CFrame.Angles(math.rad(-10), 0, 0), RED, Enum.Material.Neon)
	for _, x in ipairs({ -1, 1 }) do
		add("B", Vector3.new(0.7, 0.08, 0.08), CFrame.new(x * 0.32, 5.7, -1.02) * CFrame.Angles(0, 0, x * math.rad(-25)), RED, Enum.Material.Neon)
	end
	-- 등뼈 가시 다섯
	for i = 0, 4 do
		chain("B", CFrame.new(0, 7.1 - i * 0.7, 0.95 + i * 0.02) * CFrame.Angles(math.rad(-60), 0, 0), 2, 0.4 - i * 0.04, 0.3, 0.1, CFrame.Angles(math.rad(-15), 0, 0), BONE)
	end
	-- 목과 머리: 앞으로 내민 머리, 무거운 이마, 아래턱, 이빨, 빛나는 눈
	add("B", Vector3.new(1.05, 0.9, 1.05), CFrame.new(0, 7.2, -0.3) * CFrame.Angles(math.rad(-20), 0, 0), SKIN)
	add("B", Vector3.new(1.4, 1.25, 1.5), CFrame.new(0, 7.8, -0.6), SKIN2)
	add("B", Vector3.new(1.55, 0.36, 0.55), CFrame.new(0, 8.12, -1.2) * CFrame.Angles(math.rad(12), 0, 0), PLATE)
	add("B", Vector3.new(1.2, 0.5, 1.15), CFrame.new(0, 7.2, -0.85) * CFrame.Angles(math.rad(8), 0, 0), SKIN)
	for _, x in ipairs({ -1, 1 }) do
		add("B", Vector3.new(0.36, 0.13, 0.08), CFrame.new(x * 0.34, 7.95, -1.38) * CFrame.Angles(0, 0, x * math.rad(-14)), EYE, Enum.Material.Neon)
		add("B", Vector3.new(0.12, 0.38, 0.12), CFrame.new(x * 0.36, 7.12, -1.36) * CFrame.Angles(0, 0, x * math.rad(6)), BONE)
		add("B", Vector3.new(0.4, 0.5, 0.12), CFrame.new(x * 0.72, 7.75, -0.4) * CFrame.Angles(0, x * math.rad(30), x * math.rad(-30)), SKIN2)
		-- 뿔: 이마 옆에서 위로 솟아 뒤로 휘어 감긴다 (마디 일곱이 이어진다)
		chain("B", CFrame.new(x * 0.58, 8.25, -0.75) * CFrame.Angles(math.rad(-10), 0, x * math.rad(-38)), 7, 0.62, 0.5, 0.1, CFrame.Angles(math.rad(-24), 0, x * math.rad(7)), HORN, Enum.Material.Slate)
	end
	add("B", Vector3.new(0.85, 0.1, 0.08), CFrame.new(0, 7.38, -1.45), RED, Enum.Material.Neon)
	for j = -2, 2 do
		add("B", Vector3.new(0.1, 0.18, 0.08), CFrame.new(j * 0.17, 7.46, -1.47), BONE)
	end

	-- 팔 (어깨 기준): 윗팔, 팔꿈치 가시, 손목으로 갈수록 굵은 아래팔과 그 위의 판, 손바닥, 갈고리 손가락 넷과 엄지
	for _, limb in ipairs({ "R", "L" }) do
		add(limb, Vector3.new(1.05, 2.4, 1.05), CFrame.new(0, -1.2, 0), SKIN)
		chain(limb, CFrame.new(0, -2.3, 0.45) * CFrame.Angles(math.rad(120), 0, 0), 2, 0.45, 0.28, 0.08, CFrame.Angles(math.rad(-10), 0, 0), BONE)
		add(limb, Vector3.new(0.95, 2.2, 1.0), CFrame.new(0, -3.4, -0.05), SKIN2)
		add(limb, Vector3.new(1.05, 1.3, 0.35), CFrame.new(0, -3.6, -0.52), PLATE)
		add(limb, Vector3.new(1.15, 0.8, 0.95), CFrame.new(0, -4.85, -0.1), SKIN)
		if not (limb == "R" and o.scythe) then
			for j = 0, 3 do
				local x = (j - 1.5) * 0.28
				local tip = chain(limb, CFrame.new(x, -5.15, -0.3) * CFrame.Angles(math.rad(180 + 15), 0, 0), 3, 0.42, 0.2, 0.1, CFrame.Angles(math.rad(-24), 0, 0), SKIN2)
				add(limb, Vector3.new(0.09, 0.45, 0.09), tip * CFrame.new(0, 0.15, 0) * CFrame.Angles(math.rad(-20), 0, 0), BONE)
			end
			chain(limb, CFrame.new(limb == "R" and -0.55 or 0.55, -4.75, -0.45) * CFrame.Angles(math.rad(200), 0, (limb == "R" and 1 or -1) * math.rad(30)), 2, 0.4, 0.22, 0.12, CFrame.Angles(math.rad(-25), 0, 0), SKIN2)
		else
			-- 낫을 쥔 주먹
			add(limb, Vector3.new(1.2, 0.7, 1.0), CFrame.new(0, -5.3, -0.15), SKIN2)
		end
	end

	-- 날개: 뼈 (윗뼈 하나와 손가락뼈 셋, 엄지 갈고리)와 그 사이를 잇는 막. 바깥 가장자리는 오목하게
	if o.wings then
		for _, side in ipairs({ { "WR", 1 }, { "WL", -1 } }) do
			local limb, x = side[1], side[2]
			local function v(px: number, py: number, pz: number): Vector3
				return Vector3.new(px * x, py, pz)
			end
			local R0, W = v(0, 0, 0), v(3.4, 2.4, 1.2)
			local T1, T2, T3 = v(7.4, 4.0, 1.9), v(8.0, 0.2, 2.2), v(5.6, -2.8, 1.9)
			local B = v(0.1, -2.6, 0.1)
			local function bone(a: Vector3, b: Vector3, w: number)
				local mid = (a + b) / 2
				add(limb, Vector3.new(w, w, (b - a).Magnitude + w * 0.6), CFrame.lookAt(mid, b), SKIN2)
			end
			bone(R0, W, 0.4)
			bone(W, T1, 0.24)
			bone(W, T2, 0.22)
			bone(W, T3, 0.2)
			add(limb, Vector3.new(0.5, 0.5, 0.5), CFrame.new(W), SKIN2, nil, nil, "ball")
			chain(limb, CFrame.new(W) * CFrame.Angles(0, 0, x * math.rad(-30)), 2, 0.35, 0.18, 0.07, CFrame.Angles(math.rad(-30), 0, 0), BONE)
			-- 막: 손가락 끝 사이를 안쪽으로 당겨 오목하게
			local M12 = (T1 + T2) / 2 * 0.82 + W * 0.18
			local M23 = (T2 + T3) / 2 * 0.82 + W * 0.18
			local M3B = (T3 + B) / 2 * 0.85 + W * 0.15
			for _, t in ipairs({ { W, T1, M12 }, { W, M12, T2 }, { W, T2, M23 }, { W, M23, T3 }, { W, T3, M3B }, { W, M3B, B }, { R0, W, B } }) do
				tri(limb, t[1], t[2], t[3], WING, Enum.Material.SmoothPlastic, 0.06, 0.1)
			end
		end
	end

	-- 큰 낫: 손에서 위아래로 뻗은 자루 (감긴 손잡이, 끝의 가시), 자루 끝에서 초승달처럼 휜 한 장의 날
	if o.scythe then
		add("R", Vector3.new(0.42, 14.0, 0.42), CFrame.new(0, -9.8, -0.15), SHAFT, Enum.Material.Wood)
		for i = 0, 3 do
			add("R", Vector3.new(0.5, 0.18, 0.5), CFrame.new(0, -6.0 - i * 0.55, -0.15), IRON, Enum.Material.Metal)
		end
		local tipY = -16.6
		local base = Vector3.new(0, tipY, -0.15)
		-- 날 뿌리의 쇠 고리와 해골
		add("R", Vector3.new(0.9, 1.2, 0.9), CFrame.new(base + Vector3.new(0, 0.3, 0)), IRON, Enum.Material.Metal)
		add("R", Vector3.new(0.85, 0.8, 0.8), CFrame.new(base + Vector3.new(0, 1.1, -0.2)), BONE, nil, nil, "ball")
		for _, xx in ipairs({ -1, 1 }) do
			add("R", Vector3.new(0.18, 0.16, 0.06), CFrame.new(base + Vector3.new(xx * 0.18, 1.15, -0.6)), RED, Enum.Material.Neon)
		end
		-- 날: 등줄기(휜 곡선)에서 안쪽(오목한 쪽)으로 폭이 있는 판. 끝으로 갈수록 가늘어진다
		local n = 12
		local backs, edges = {}, {}
		for i = 0, n do
			local u = i / n
			local c = base + Vector3.new(0, 3.6 * u * u, 8.2 * u)
			local tan = Vector3.new(0, 7.2 * u, 8.2).Unit
			local nrm = Vector3.new(0, tan.Z, -tan.Y)
			local w = 1.9 * (1 - u) ^ 0.85 + 0.04
			backs[i] = c
			edges[i] = c + nrm * w
		end
		for i = 0, n - 1 do
			tri("R", backs[i], backs[i + 1], edges[i], IRON, Enum.Material.Metal, 0, 0.22)
			tri("R", backs[i + 1], edges[i + 1], edges[i], IRON, Enum.Material.Metal, 0, 0.22)
			-- 날끝을 따라 붉게 빛나는 선
			local a, b = edges[i], edges[i + 1]
			add("R", Vector3.new(0.26, 0.16, (b - a).Magnitude + 0.12), CFrame.lookAt((a + b) / 2, b), RED, Enum.Material.Neon)
			-- 등줄기의 두꺼운 테
			local c0, c1 = backs[i], backs[i + 1]
			add("R", Vector3.new(0.34, 0.3, (c1 - c0).Magnitude + 0.1), CFrame.lookAt((c0 + c1) / 2, c1), SHAFT, Enum.Material.Metal)
		end
		local glow = Instance.new("PointLight")
		glow.Color = RED
		glow.Range = 14 * s
		glow.Brightness = 1.5
		local tipPart = h.pieces[#h.pieces].p
		glow.Parent = tipPart
	end
	-- 가슴 속의 핏빛 (은은한 빛)
	local core = h.pieces[1].p
	local light = Instance.new("PointLight")
	light.Color = RED
	light.Range = 10 * s
	light.Brightness = 0.8
	light.Parent = core

	model.Parent = folder
	place(h)
	h.conn = RunService.RenderStepped:Connect(function()
		if not h.alive then
			return
		end
		local fn = h.anim
		if fn then
			local ok = pcall(fn, os.clock() - h.born)
			if not ok then
				h.anim = nil
			end
		end
		place(h)
	end)
	return h
end

-- 사라지기: 흐려지며 가라앉는다
function Demon.remove(h: Handle, time: number?)
	if not h.alive or (h :: any).leaving then
		return
	end
	(h :: any).leaving = true
	local t = time or 0.6
	for _, pc in ipairs(h.pieces) do
		TweenService:Create(pc.p, TweenInfo.new(t), { Transparency = 1 }):Play()
	end
	task.delay(t + 0.05, function()
		h.alive = false
		if h.conn then
			h.conn:Disconnect()
		end
		h.model:Destroy()
	end)
end

return Demon
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="25">
          <Properties>
            <string name="Name">Dream</string>
            <string name="Source"><![CDATA[-- 권왕 3.10판: 몽유권 (화면). 반쯤 잠든 채 꿈속을 걷는 권
-- 빛깔은 밤하늘빛 (남빛·보랏빛, 안개처럼 번진다)과 따뜻한 달빛. 꿈의 문, 달빛 디딤돌 꿈길, 뒤집히는 중력, 떠다니는 섬·계단·문, 보름달과 밤 호수
local Lighting = game:GetService("Lighting")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local Fx = require(script.Parent:WaitForChild("Fx"))

local Dream = {}

local NIGHT = Color3.fromRGB(34, 38, 96)
local DUSK = Color3.fromRGB(120, 124, 230)
local LAVENDER = Color3.fromRGB(196, 176, 255)
local MOON = Color3.fromRGB(255, 232, 170)
local STAR = Color3.fromRGB(255, 250, 232)
local MIST = Color3.fromRGB(205, 205, 255)
local DOORWOOD = Color3.fromRGB(72, 58, 104)
local UP = CFrame.Angles(0, 0, math.rad(90))
local TEX_SMOKE = "rbxasset://textures/particles/smoke_main.dds"

local folder = Instance.new("Folder")
folder.Name = "KwonDream"
folder.Parent = workspace

local opts: any = {}
function Dream.init(o: any)
	opts = o or {}
end

local function part(size: Vector3, color: Color3, material: Enum.Material?, alpha: number?, shape: string?): Part
	local q = Instance.new("Part")
	if shape == "ball" then
		q.Shape = Enum.PartType.Ball
	elseif shape == "cyl" then
		q.Shape = Enum.PartType.Cylinder
	end
	q.Anchored = true
	q.CanCollide = false
	q.CanQuery = false
	q.CanTouch = false
	q.CastShadow = false
	q.Size = size
	q.Color = color
	q.Material = material or Enum.Material.SmoothPlastic
	q.Transparency = alpha or 0
	q.Parent = folder
	return q
end
local function tween(inst: Instance, time: number, goal: { [string]: any }, style: Enum.EasingStyle?, dir: Enum.EasingDirection?)
	local tw = TweenService:Create(inst, TweenInfo.new(math.max(0.01, time), style or Enum.EasingStyle.Quad, dir or Enum.EasingDirection.Out), goal)
	tw:Play()
	return tw
end
local function fadeOut(p: BasePart, time: number, goal: { [string]: any }?)
	local g = goal or {}
	g.Transparency = 1
	tween(p, time, g)
	task.delay(time + 0.05, function()
		p:Destroy()
	end)
end
local function near(pos: Vector3, d: number): boolean
	local cam = workspace.CurrentCamera
	return cam ~= nil and (cam.CFrame.Position - pos).Magnitude < d
end
local function rootOf(m: Instance?): BasePart?
	local r = m and m:FindFirstChild("HumanoidRootPart")
	return (r and r:IsA("BasePart")) and r or nil
end
local function flat(v: Vector3): Vector3
	local f = Vector3.new(v.X, 0, v.Z)
	return f.Magnitude > 1e-3 and f.Unit or Vector3.new(0, 0, -1)
end
local function ground(at: Vector3): Vector3
	return Vector3.new(at.X, at.Y - 2.7, at.Z)
end
local function shakeNear(pos: Vector3, amount: number, range: number)
	if opts.shake and near(pos, range) then
		opts.shake(amount)
	end
end
-- 별가루 (위로 천천히 떠오르며 깜박인다)
local function stardust(at: Vector3, n: number, s: number, rise: number?)
	for k = 1, n do
		local c = (k % 3 == 0) and MOON or ((k % 3 == 1) and STAR or LAVENDER)
		local q = part(Vector3.one * 0.3 * s, c, Enum.Material.Neon, 0.05, "ball")
		q.CFrame = CFrame.new(at + Vector3.new(math.random() - 0.5, math.random() - 0.5, math.random() - 0.5) * 2 * s)
		fadeOut(q, 0.9 + math.random() * 0.6, { CFrame = q.CFrame + Vector3.new((math.random() - 0.5) * 3 * s, (rise or 4) * (0.4 + math.random()), (math.random() - 0.5) * 3 * s) })
	end
end
-- 잠의 Z (글자 판이 떠올라 사라진다)
local function zzz(at: Vector3, s: number)
	local holder = part(Vector3.new(0.2, 0.2, 0.2), LAVENDER, Enum.Material.Neon, 1)
	holder.CFrame = CFrame.new(at)
	local bb = Instance.new("BillboardGui")
	bb.Size = UDim2.fromScale(2.4 * s, 2.4 * s)
	bb.LightInfluence = 0
	bb.Parent = holder
	local t = Instance.new("TextLabel")
	t.BackgroundTransparency = 1
	t.Size = UDim2.fromScale(1, 1)
	t.Font = Enum.Font.FredokaOne
	t.TextScaled = true
	t.Text = "z Z"
	t.TextColor3 = LAVENDER
	t.Parent = bb
	tween(holder, 1.2, { CFrame = CFrame.new(at + Vector3.new(0.6, 3, 0)) })
	tween(t, 1.2, { TextTransparency = 1 })
	task.delay(1.25, function()
		holder:Destroy()
	end)
end
-- 꿈 안개 한 무더기 (낮게 번진다)
local function mist(at: Vector3, s: number, life: number)
	for k = 1, 4 do
		local m = part(Vector3.new(4, 1.4, 4) * s, (k % 2 == 0) and MIST or LAVENDER, Enum.Material.SmoothPlastic, 0.6, "ball")
		m.CFrame = CFrame.new(at + Vector3.new((math.random() - 0.5) * 3 * s, 0.4, (math.random() - 0.5) * 3 * s))
		fadeOut(m, life, { Size = m.Size * 1.8, CFrame = m.CFrame + Vector3.new(0, 0.8 * s, 0) })
	end
end
-- 초승달 (호를 따라 조각을 이어 붙인다): 조각 목록과 각 조각의 자리 (틀 기준)
local function crescentParts(R: number, thick: number, color: Color3, alpha: number?): { { p: Part, off: CFrame } }
	local out = {}
	for k = 0, 10 do
		local a = math.rad(-100 + k * 20)
		local w = thick * math.sin((k + 0.5) / 11 * math.pi) + thick * 0.12
		local seg = part(Vector3.new(w, R * 0.34, w * 0.7), color, Enum.Material.Neon, alpha or 0)
		table.insert(out, { p = seg, off = CFrame.new(math.cos(a) * R, math.sin(a) * R, 0) * CFrame.Angles(0, 0, a) })
	end
	return out
end
local function placeList(list: { { p: Part, off: CFrame } }, cf: CFrame)
	for _, it in ipairs(list) do
		if it.p.Parent then
			it.p.CFrame = cf * it.off
		end
	end
end

------------------------------------------------------------------------
-- 차림: 머리 뒤를 천천히 도는 초승달, 둘레에서 깜박이는 작은 별 셋, 발밑에 번지는 꿈 안개
------------------------------------------------------------------------
function Dream.buildGear(model: Model): { Instance }
	local out: { Instance } = {}
	local holder = Instance.new("Folder")
	holder.Name = "Dream_" .. model.Name
	holder.Parent = folder
	table.insert(out, holder)
	local head = model:FindFirstChild("Head")
	local torso = model:FindFirstChild("UpperTorso")
	if not (head and head:IsA("BasePart")) or not (torso and torso:IsA("BasePart")) then
		return out
	end
	local moon = crescentParts(0.85, 0.32, MOON, 0.05)
	for _, it in ipairs(moon) do
		it.p.Parent = holder
		table.insert(out, it.p)
	end
	local stars: { Part } = {}
	for k = 1, 3 do
		local s = part(Vector3.new(0.22, 0.22, 0.22), STAR, Enum.Material.Neon, 0, "ball")
		s.Parent = holder
		table.insert(out, s)
		stars[k] = s
	end
	local foot = part(Vector3.new(2, 0.2, 2), LAVENDER, Enum.Material.SmoothPlastic, 1)
	foot.Parent = holder
	table.insert(out, foot)
	local a0 = Instance.new("Attachment")
	a0.Parent = foot
	local e = Instance.new("ParticleEmitter")
	e.Texture = TEX_SMOKE
	e.Color = ColorSequence.new(LAVENDER, MIST)
	e.LightEmission = 0.3
	e.Rate = 4
	e.Lifetime = NumberRange.new(1.2, 2)
	e.Speed = NumberRange.new(0.2, 0.8)
	e.SpreadAngle = Vector2.new(180, 10)
	e.Size = NumberSequence.new(1.2, 3)
	e.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.3, 0.75), NumberSequenceKeypoint.new(1, 1) })
	e.Parent = a0
	local t0 = os.clock()
	local conn: RBXScriptConnection
	conn = RunService.RenderStepped:Connect(function()
		if not holder.Parent or not head.Parent then
			conn:Disconnect()
			return
		end
		local t = os.clock() - t0
		local hide = model:GetAttribute("Vanish") == true
		local cf = head.CFrame * CFrame.new(0.2, 0.55 + math.sin(t * 1.4) * 0.12, 0.7) * CFrame.Angles(0, 0, math.rad(-25) + math.sin(t * 0.7) * 0.15)
		placeList(moon, cf)
		for _, it in ipairs(moon) do
			it.p.LocalTransparencyModifier = hide and 1 or 0
		end
		for k, s in ipairs(stars) do
			local a = t * 0.6 + k * 2.1
			s.CFrame = torso.CFrame * CFrame.new(math.cos(a) * 1.9, 1.2 + math.sin(t + k) * 0.5, math.sin(a) * 1.9)
			s.Transparency = 0.2 + 0.6 * (0.5 + 0.5 * math.sin(t * 3 + k * 2))
			s.LocalTransparencyModifier = hide and 1 or 0
		end
		foot.CFrame = CFrame.new(torso.Position - Vector3.new(0, 2.9, 0))
		e.Enabled = not hide
	end)
	return out
end

------------------------------------------------------------------------
-- 문 (꿈의 문): 문틀 + 문짝 (경첩 둘레로 열린다) + 문 안의 달빛
------------------------------------------------------------------------
type Door = { frame: { Part }, panel: Part, light: Part, cf: CFrame, w: number, h: number, open: number }
local function makeDoor(cf: CFrame, w: number, h: number): Door
	local frame: { Part } = {}
	for _, x in ipairs({ -1, 1 }) do
		local post = part(Vector3.new(0.35, h + 0.4, 0.4), DOORWOOD, Enum.Material.Wood, 0)
		post.CFrame = cf * CFrame.new(x * (w / 2 + 0.15), 0, 0)
		table.insert(frame, post)
	end
	local top = part(Vector3.new(w + 0.8, 0.4, 0.45), DOORWOOD, Enum.Material.Wood, 0)
	top.CFrame = cf * CFrame.new(0, h / 2 + 0.2, 0)
	table.insert(frame, top)
	local light = part(Vector3.new(w, h, 0.1), MOON, Enum.Material.Neon, 0.15)
	light.CFrame = cf
	local panel = part(Vector3.new(w, h, 0.18), LAVENDER, Enum.Material.SmoothPlastic, 0)
	panel.CFrame = cf * CFrame.new(0, 0, -0.08)
	return { frame = frame, panel = panel, light = light, cf = cf, w = w, h = h, open = 0 }
end
local function setDoor(d: Door, open: number)
	d.open = open
	-- 왼쪽 경첩을 축으로 바깥쪽 (-Z)으로 열린다
	local hinge = d.cf * CFrame.new(-d.w / 2, 0, -0.08)
	d.panel.CFrame = hinge * CFrame.Angles(0, open * math.rad(105), 0) * CFrame.new(d.w / 2, 0, 0)
end
local function killDoor(d: Door, time: number)
	for _, p in ipairs(d.frame) do
		fadeOut(p, time)
	end
	fadeOut(d.panel, time)
	fadeOut(d.light, time)
end
-- 문을 열었다 닫는다 (총 time 초), 열린 동안 별이 흘러나온다
local function doorBlink(d: Door, time: number, onShut: (() -> ())?)
	local t0 = os.clock()
	local conn: RBXScriptConnection
	conn = RunService.Heartbeat:Connect(function()
		local u = math.clamp((os.clock() - t0) / time, 0, 1)
		local o = u < 0.3 and (u / 0.3) or (u < 0.75 and 1 or (1 - (u - 0.75) / 0.25))
		setDoor(d, o)
		if o > 0.5 and math.random() < 0.4 then
			stardust(d.cf.Position + d.cf.LookVector * -0.5, 1, 0.8, 2)
		end
		if u >= 1 then
			conn:Disconnect()
			if onShut then
				onShut()
			end
		end
	end)
end

------------------------------------------------------------------------
-- 연타 장치 꿈의 문: 상대 등 뒤 허공에 문이 열려 빨아들였다가 쾅 닫히며 뱉어 낸다
------------------------------------------------------------------------
local function dreamDoorPulse(data: any)
	local at: Vector3 = data.at
	if not near(at, 200) then
		return
	end
	local delay = data.delay or 0.6
	local cam = workspace.CurrentCamera
	local away = cam and flat(at - cam.CFrame.Position) or Vector3.new(0, 0, -1)
	local doorPos = at + away * 2.6 + Vector3.new(0, 1.2, 0)
	local d = makeDoor(CFrame.lookAt(doorPos, doorPos - away), 3.2, 5.2)
	-- 문 안으로 별이 빨려 든다
	for k = 1, 8 do
		task.delay(k * delay / 10, function()
			local from = at + Vector3.new(math.random() - 0.5, math.random() * 2 - 0.5, math.random() - 0.5) * 3
			local s = part(Vector3.new(0.3, 0.3, 0.3), k % 2 == 0 and MOON or LAVENDER, Enum.Material.Neon, 0, "ball")
			s.CFrame = CFrame.new(from)
			fadeOut(s, 0.3, { CFrame = CFrame.new(doorPos) })
		end)
	end
	doorBlink(d, delay, function()
		Fx.sound("block", 0.5, 1.4, doorPos)
		stardust(at, 12, 1.1, 5)
		zzz(at + Vector3.new(0, 2, 0), 1)
		Fx.ring(ground(at) + Vector3.new(0, 0.3, 0), LAVENDER, 2, (data.radius or 6) * 2, 0.35)
		killDoor(d, 0.35)
	end)
end

------------------------------------------------------------------------
-- E 꿈길 걸음: 눈을 감고 앞으로 걷는 꿈속의 나 (반투명). 발 앞 허공에 달빛 디딤돌이 하나씩 놓이며 밤하늘 길이 되고,
-- 길 위에 z Z가 떠오른다. 길 끝에 닿으면 디딤돌이 처음부터 차례로 별가루가 되어 솟구친다
------------------------------------------------------------------------
local function dreamGhost(model: Model): { { p: Part, off: CFrame } }
	local out = {}
	local r = rootOf(model)
	if not r then
		return out
	end
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("BasePart") and d.Name ~= "HumanoidRootPart" and d.Transparency < 0.9 and d.Size.Magnitude < 8 and (d.Parent == model or (d.Parent and d.Parent:IsA("Accessory"))) then
			local q = part(d.Size, LAVENDER:Lerp(DUSK, math.random() * 0.3), Enum.Material.Glass, 1)
			table.insert(out, { p = q, off = r.CFrame:ToObjectSpace(d.CFrame) })
		end
	end
	return out
end
local function dreamWalk(data: any)
	local from: Vector3, to: Vector3 = data.from, data.to
	if not near(from, 220) then
		return
	end
	local time = data.time or 0.45
	local n = 7
	local dir = flat(to - from)
	local side = Vector3.new(-dir.Z, 0, dir.X)
	local g0 = ground(from)
	-- 밤하늘 길 (얇은 남빛 띠, 속에 별 점)
	local len = (to - from).Magnitude
	local road = part(Vector3.new(3.4, 0.06, 0.2), NIGHT, Enum.Material.Neon, 0.45)
	road.CFrame = CFrame.lookAt(g0 + Vector3.new(0, 0.12, 0), g0 + Vector3.new(0, 0.12, 0) + dir)
	tween(road, time, { Size = Vector3.new(3.4, 0.06, len), CFrame = CFrame.lookAt(g0 + dir * (len / 2) + Vector3.new(0, 0.12, 0), g0 + dir * len + Vector3.new(0, 0.12, 0)) })
	for k = 1, 10 do
		local sp = part(Vector3.one * 0.22, STAR, Enum.Material.Neon, 1, "ball")
		sp.CFrame = CFrame.new(g0 + dir * (len * (k - 0.5) / 10) + side * (math.random() - 0.5) * 2.6 + Vector3.new(0, 0.2, 0))
		task.delay(time * (k - 0.5) / 10, function()
			tween(sp, 0.1, { Transparency = 0.1 })
		end)
		task.delay(time + 0.9, function()
			fadeOut(sp, 0.4)
		end)
	end
	-- 꿈속의 나: 반투명한 내가 눈을 감고 길을 미끄러져 간다 (지나간 자리에 잔상)
	local ghost = data.m and dreamGhost(data.m) or {}
	for _, it in ipairs(ghost) do
		tween(it.p, 0.08, { Transparency = 0.5 })
	end
	local t0 = os.clock()
	local lastShade = 0
	local conn: RBXScriptConnection
	conn = RunService.Heartbeat:Connect(function()
		local u = math.clamp((os.clock() - t0) / time, 0, 1)
		local e = u * u * (3 - 2 * u)
		local pos = from:Lerp(to, e) + Vector3.new(0, 0.6 + math.sin(u * math.pi) * 0.8, 0)
		placeList(ghost, CFrame.lookAt(pos, pos + dir))
		if u - lastShade > 0.25 then
			lastShade = u
			for _, it in ipairs(ghost) do
				local q = part(it.p.Size, LAVENDER, Enum.Material.Neon, 0.75)
				q.CFrame = it.p.CFrame
				fadeOut(q, 0.4)
			end
		end
		if u >= 1 then
			conn:Disconnect()
			for _, it in ipairs(ghost) do
				fadeOut(it.p, 0.15, { Size = it.p.Size * 1.3 })
			end
		end
	end)
	-- 달빛 디딤돌: 발 앞에 하나씩 (좌우로 번갈아), 놓일 때마다 높아지는 종소리
	local stones: { { Part } } = {}
	for i = 1, n do
		local at = g0 + dir * (len * (i - 0.4) / n) + side * ((i % 2 == 0) and 0.7 or -0.7) + Vector3.new(0, 0.5 + math.sin(i / n * math.pi) * 0.6, 0)
		task.delay(time * (i - 1) / n, function()
			local rim = part(Vector3.new(0.12, 0.2, 0.2), LAVENDER, Enum.Material.Glass, 0.35, "cyl")
			rim.CFrame = CFrame.new(at - Vector3.new(0, 0.08, 0)) * UP
			tween(rim, 0.12, { Size = Vector3.new(0.12, 3.1, 3.1) }, Enum.EasingStyle.Back)
			local stone = part(Vector3.new(0.22, 0.2, 0.2), MOON, Enum.Material.Neon, 0.05, "cyl")
			stone.CFrame = CFrame.new(at) * UP
			tween(stone, 0.12, { Size = Vector3.new(0.22, 2.3, 2.3) }, Enum.EasingStyle.Back)
			stones[i] = { stone, rim }
			if i % 2 == 1 then
				zzz(at + Vector3.new(0, 1.6, 0), 0.8)
			end
			Fx.sound("ping", 0.3, 0.9 + i * 0.1, at)
		end)
	end
	mist(g0, 0.7, 0.8)
	-- 길 끝: 디딤돌이 차례로 별가루가 되어 솟는다
	task.delay(time + 0.1, function()
		mist(ground(to), 0.9, 1)
		Fx.ring(ground(to) + Vector3.new(0, 0.3, 0), LAVENDER, 2, 12, 0.4)
		for i = 1, n do
			task.delay((i - 1) * 0.05, function()
				local st = stones[i]
				if not st then
					return
				end
				local at = st[1].Position
				for _, p in ipairs(st) do
					fadeOut(p, 0.25, { Size = p.Size * Vector3.new(1, 1.6, 1.6) })
				end
				stardust(at, 6, 0.9, 5)
				local col = part(Vector3.new(6, 0.8, 0.8), MOON, Enum.Material.Neon, 0.2, "cyl")
				col.CFrame = CFrame.new(at + Vector3.new(0, 3, 0)) * UP
				fadeOut(col, 0.35, { Size = Vector3.new(9, 0.1, 0.1), CFrame = CFrame.new(at + Vector3.new(0, 4.5, 0)) * UP })
			end)
		end
		Fx.sound("splash", 0.4, 1.6, to)
		Fx.sound("ping", 0.5, 1.8, to)
		shakeNear(to, 0.6, 120)
		fadeOut(road, 0.6)
	end)
end

------------------------------------------------------------------------
-- R 거꾸로 꿈: 앞의 땅이 밤하늘이 되고, 풀과 돌이 하늘로 떨어진다. 꿈이 바로 서면 쾅
------------------------------------------------------------------------
local function upsideDown(data: any)
	local at: Vector3 = data.at
	if not near(at, 220) then
		return
	end
	local R = data.radius or 11
	local delay = data.delay or 0.25
	local hold = data.hold or 1.2
	local g = ground(at)
	local sky = part(Vector3.new(0.2, 1, 1), NIGHT, Enum.Material.SmoothPlastic, 0.1, "cyl")
	sky.CFrame = CFrame.new(g + Vector3.new(0, 0.12, 0)) * UP
	tween(sky, delay, { Size = Vector3.new(0.2, R * 2, R * 2) })
	local rim = part(Vector3.new(0.25, 1, 1), DUSK, Enum.Material.Neon, 0.4, "cyl")
	rim.CFrame = CFrame.new(g + Vector3.new(0, 0.1, 0)) * UP
	tween(rim, delay, { Size = Vector3.new(0.25, R * 2 + 1, R * 2 + 1) })
	-- 땅 아래 하늘의 별 (거꾸로 비친 밤하늘)
	local dots: { Part } = {}
	for k = 1, 18 do
		local a, rr = math.random() * math.pi * 2, math.sqrt(math.random()) * R * 0.9
		local d = part(Vector3.new(0.3, 0.3, 0.3), k % 4 == 0 and MOON or STAR, Enum.Material.Neon, 0.1, "ball")
		d.CFrame = CFrame.new(g + Vector3.new(math.cos(a) * rr, 0.25, math.sin(a) * rr))
		table.insert(dots, d)
	end
	-- 풀과 작은 돌이 하늘로 떨어진다 (거꾸로)
	local t0 = os.clock()
	local conn: RBXScriptConnection
	conn = RunService.Heartbeat:Connect(function()
		local t = os.clock() - t0
		if t > delay and t < delay + hold and math.random() < 0.6 then
			local a, rr = math.random() * math.pi * 2, math.sqrt(math.random()) * R
			local p = g + Vector3.new(math.cos(a) * rr, 0.4, math.sin(a) * rr)
			local bit = part(Vector3.new(0.4, 0.4, 0.4) * (0.6 + math.random()), math.random() < 0.5 and Color3.fromRGB(110, 140, 90) or Color3.fromRGB(120, 112, 104), Enum.Material.SmoothPlastic, 0)
			bit.CFrame = CFrame.new(p) * CFrame.Angles(math.random() * 3, math.random() * 3, 0)
			fadeOut(bit, 1.1, { CFrame = CFrame.new(p + Vector3.new(0, 10 + math.random() * 6, 0)) * CFrame.Angles(math.random() * 6, math.random() * 6, 0) })
		end
		if t >= delay + hold then
			conn:Disconnect()
		end
	end)
	Fx.sound("ping", 0.4, 0.7, at)
	task.delay(delay + hold, function()
		for _, d in ipairs(dots) do
			fadeOut(d, 0.2)
		end
		fadeOut(sky, 0.4)
		fadeOut(rim, 0.4)
		Fx.ring(g + Vector3.new(0, 0.4, 0), LAVENDER, 2, R * 2.6, 0.45)
		Fx.ring(g + Vector3.new(0, 0.6, 0), MOON, 2, R * 1.8, 0.35)
		Fx.burst("dust", g + Vector3.new(0, 0.5, 0), Color3.fromRGB(150, 140, 170), 14, 1.4)
		stardust(g + Vector3.new(0, 1, 0), 14, 1.4, 3)
		Fx.sound("heavy", 0.8, 1.0, g)
		shakeNear(g, 1.6, 100)
	end)
end

------------------------------------------------------------------------
-- G 몽중몽: 커다란 달, 떠다니는 작은 섬과 끝없는 계단과 문. 문이 여기저기서 열렸다 닫힌다. 끝에 모두 떨어지며 깬다
------------------------------------------------------------------------
local function island(at: Vector3, s: number): { Part }
	local list: { Part } = {}
	local rock = part(Vector3.new(4 * s, 3 * s, 4 * s), Color3.fromRGB(110, 100, 120), Enum.Material.Slate, 0, "ball")
	rock.CFrame = CFrame.new(at - Vector3.new(0, 1.2 * s, 0))
	table.insert(list, rock)
	local tip = part(Vector3.new(2 * s, 2.6 * s, 2 * s), Color3.fromRGB(96, 88, 108), Enum.Material.Slate, 0, "ball")
	tip.CFrame = CFrame.new(at - Vector3.new(0, 2.8 * s, 0))
	table.insert(list, tip)
	local grass = part(Vector3.new(0.4 * s, 4.2 * s, 4.2 * s), Color3.fromRGB(120, 170, 130), Enum.Material.Grass, 0, "cyl")
	grass.CFrame = CFrame.new(at) * UP
	table.insert(list, grass)
	local trunk = part(Vector3.new(0.3, 1.6, 0.3) * s, Color3.fromRGB(90, 70, 60), Enum.Material.Wood, 0)
	trunk.CFrame = CFrame.new(at + Vector3.new(0.6 * s, 0.9 * s, 0))
	table.insert(list, trunk)
	local leaf = part(Vector3.new(1.6, 1.4, 1.6) * s, Color3.fromRGB(200, 170, 240), Enum.Material.SmoothPlastic, 0, "ball")
	leaf.CFrame = CFrame.new(at + Vector3.new(0.6 * s, 2 * s, 0))
	table.insert(list, leaf)
	return list
end
local function dreamIsles(data: any)
	local at: Vector3 = data.at
	if not near(at, 260) then
		return
	end
	local R = data.radius or 26
	local delay = data.delay or 0.4
	local dur = data.dur or 3.0
	local g = ground(at)
	local cc: ColorCorrectionEffect? = nil
	if near(at, R * 2.5) then
		local c = Instance.new("ColorCorrectionEffect")
		c.Name = "KwonDreamGrade"
		c.Parent = Lighting
		tween(c, 0.5, { TintColor = Color3.fromRGB(200, 196, 255), Brightness = -0.06, Saturation = 0.1 })
		cc = c
	end
	local things: { { list: { Part }, base: Vector3, bob: number } } = {}
	-- 큰 달 (머리 위, 한쪽으로)
	local moonC = g + Vector3.new(R * 0.4, 34, -R * 0.3)
	local moon = part(Vector3.new(1, 1, 1), MOON, Enum.Material.Neon, 0.05, "ball")
	moon.CFrame = CFrame.new(moonC)
	tween(moon, 0.6, { Size = Vector3.new(16, 16, 16) }, Enum.EasingStyle.Back)
	local halo = part(Vector3.new(1, 1, 1), MOON, Enum.Material.Neon, 0.85, "ball")
	halo.CFrame = CFrame.new(moonC)
	tween(halo, 0.8, { Size = Vector3.new(30, 30, 30) })
	-- 떠다니는 섬 여섯
	for k = 1, 6 do
		local a = k / 6 * math.pi * 2 + 0.3
		local base = g + Vector3.new(math.cos(a) * R * 0.75, 8 + (k % 3) * 4, math.sin(a) * R * 0.75)
		table.insert(things, { list = island(base, 0.9 + (k % 2) * 0.4), base = base, bob = k })
	end
	-- 끝없는 계단 셋 (빙글 돌며 올라가다 허공에서 끊긴다)
	for k = 1, 3 do
		local a0 = k / 3 * math.pi * 2
		local c = g + Vector3.new(math.cos(a0) * R * 0.45, 0, math.sin(a0) * R * 0.45)
		local list: { Part } = {}
		for j = 0, 13 do
			local a = a0 + j * 0.42
			local st = part(Vector3.new(3, 0.5, 1.4), j % 2 == 0 and LAVENDER or Color3.fromRGB(230, 222, 250), Enum.Material.SmoothPlastic, 0.05)
			st.CFrame = CFrame.new(c + Vector3.new(math.cos(a) * 3, 1 + j * 1.1, math.sin(a) * 3)) * CFrame.Angles(0, -a, 0)
			st.Transparency = 1
			task.delay(delay + j * 0.04, function()
				tween(st, 0.2, { Transparency = 0.05 })
			end)
			table.insert(list, st)
		end
		table.insert(things, { list = list, base = c, bob = 10 + k })
	end
	-- 문 다섯 (떠다니며 가끔 열렸다 닫힌다)
	local doors: { Door } = {}
	for k = 1, 5 do
		local a = k / 5 * math.pi * 2 + 1
		local p = g + Vector3.new(math.cos(a) * R * 0.55, 4 + (k % 2) * 3, math.sin(a) * R * 0.55)
		doors[k] = makeDoor(CFrame.lookAt(p, Vector3.new(g.X, p.Y, g.Z)), 3, 5)
	end
	local t0 = os.clock()
	local nextDoor = delay
	local conn: RBXScriptConnection
	conn = RunService.Heartbeat:Connect(function()
		local t = os.clock() - t0
		for _, th in ipairs(things) do
			local off = Vector3.new(0, math.sin(t * 1.2 + th.bob) * 0.6, 0)
			for _, p in ipairs(th.list) do
				if p.Parent then
					p.CFrame = p.CFrame + off * 0.03
				end
			end
		end
		if t >= nextDoor and t < delay + dur then
			nextDoor = t + 0.35
			local d = doors[math.random(1, #doors)]
			doorBlink(d, 0.5)
			Fx.sound("block", 0.25, 1.6, d.cf.Position)
		end
		if math.random() < 0.3 then
			local a, rr = math.random() * math.pi * 2, math.random() * R
			stardust(g + Vector3.new(math.cos(a) * rr, 1, math.sin(a) * rr), 1, 1, 6)
		end
		if t >= delay + dur then
			conn:Disconnect()
		end
	end)
	mist(g, 2.4, dur + delay)
	Fx.sound("ping", 0.6, 0.6, at)
	-- 깬다: 모든 것이 아래로 떨어지고 하얀 빛
	task.delay(delay + dur, function()
		local all: { Part } = { moon, halo }
		for _, th in ipairs(things) do
			for _, p in ipairs(th.list) do
				table.insert(all, p)
			end
		end
		for _, d in ipairs(doors) do
			for _, p in ipairs(d.frame) do
				table.insert(all, p)
			end
			table.insert(all, d.panel)
			table.insert(all, d.light)
		end
		for _, p in ipairs(all) do
			if p.Parent then
				fadeOut(p, 0.6, { CFrame = p.CFrame - Vector3.new(0, 18, 0) })
			end
		end
		local core = part(Vector3.new(4, 4, 4), STAR, Enum.Material.Neon, 0, "ball")
		core.CFrame = CFrame.new(g + Vector3.new(0, 4, 0))
		fadeOut(core, 0.6, { Size = Vector3.new(R * 1.8, R * 1.8, R * 1.8) })
		for k = 1, 3 do
			task.delay(k * 0.06, function()
				Fx.ring(g + Vector3.new(0, 0.5 + k, 0), k == 2 and MOON or LAVENDER, 4, R * 2.4 + k * 6, 0.6)
			end)
		end
		stardust(g + Vector3.new(0, 4, 0), 30, 2.2, 6)
		Fx.flash(g + Vector3.new(0, 4, 0), MOON, 90, 6, 0.5)
		Fx.sound("splash", 0.6, 1.4, g)
		Fx.sound("heavy", 0.8, 0.8, g)
		shakeNear(g, 2.2, 150)
		if cc then
			tween(cc, 0.6, { TintColor = Color3.new(1, 1, 1), Brightness = 0, Saturation = 0 })
			task.delay(0.7, function()
				cc:Destroy()
			end)
		end
	end)
end

------------------------------------------------------------------------
-- X 월하몽: 보름달이 떠오르고 땅이 밤 호수가 된다. 등불과 문이 떠오르고 별이 소용돌이친다. 달이 내려와 호수에 닿으면 소리 없이 하얗게
------------------------------------------------------------------------
local function moonDream(data: any)
	local at: Vector3 = data.at
	if not near(at, 340) then
		return
	end
	local dir = flat(data.dir or Vector3.new(0, 0, -1))
	local cut = data.cut or 1.4
	local rise = data.rise or 0.5
	local drift = data.drift or 2.0
	local descend = data.descend or 0.8
	local range = data.range or 40
	local g = ground(at)
	local cc: ColorCorrectionEffect? = nil
	if near(at, range * 2.5) then
		local c = Instance.new("ColorCorrectionEffect")
		c.Name = "KwonMoonGrade"
		c.Parent = Lighting
		tween(c, 0.8, { TintColor = Color3.fromRGB(170, 176, 255), Brightness = -0.12, Contrast = 0.1 })
		cc = c
	end
	local parts: { Part } = {}
	-- 하늘을 채우는 보름달 (등 뒤에서 떠오른다)
	local moonFrom = g - dir * 60 + Vector3.new(0, -20, 0)
	local moonAt = g - dir * 50 + Vector3.new(0, 55, 0)
	local moon = part(Vector3.new(56, 56, 56), MOON, Enum.Material.Neon, 0.02, "ball")
	moon.CFrame = CFrame.new(moonFrom)
	local glow = part(Vector3.new(90, 90, 90), MOON, Enum.Material.Neon, 0.9, "ball")
	glow.CFrame = CFrame.new(moonFrom)
	tween(moon, cut, { CFrame = CFrame.new(moonAt) }, Enum.EasingStyle.Sine)
	tween(glow, cut, { CFrame = CFrame.new(moonAt) }, Enum.EasingStyle.Sine)
	table.insert(parts, moon)
	table.insert(parts, glow)
	-- 밤 호수 (달이 비친다)
	local lake = part(Vector3.new(0.3, 1, 1), NIGHT, Enum.Material.Glass, 0.05, "cyl")
	lake.Reflectance = 0.5
	lake.CFrame = CFrame.new(g + Vector3.new(0, 0.15, 0)) * UP
	table.insert(parts, lake)
	local reflect = part(Vector3.new(0.32, 1, 1), MOON, Enum.Material.Neon, 0.5, "cyl")
	reflect.CFrame = CFrame.new(g - dir * range * 0.45 + Vector3.new(0, 0.2, 0)) * UP
	table.insert(parts, reflect)
	task.delay(cut, function()
		tween(lake, rise, { Size = Vector3.new(0.3, range * 2, range * 2) })
		tween(reflect, rise, { Size = Vector3.new(0.32, range * 0.5, range * 0.5) })
		Fx.ring(g + Vector3.new(0, 0.4, 0), LAVENDER, 4, range * 2.2, 0.8)
		Fx.sound("splash", 0.5, 0.7, g)
		-- 호수에 박힌 별, 떠오르는 등불, 떠다니는 문
		for k = 1, 30 do
			local a, rr = math.random() * math.pi * 2, math.sqrt(math.random()) * range * 0.95
			local s = part(Vector3.new(0.4, 0.4, 0.4), k % 5 == 0 and MOON or STAR, Enum.Material.Neon, 0.1, "ball")
			s.CFrame = CFrame.new(g + Vector3.new(math.cos(a) * rr, 0.35, math.sin(a) * rr))
			table.insert(parts, s)
		end
		for k = 1, 10 do
			local a = k / 10 * math.pi * 2
			local p0 = g + Vector3.new(math.cos(a) * range * 0.7, 0.5, math.sin(a) * range * 0.7)
			local lantern = part(Vector3.new(1.2, 1.6, 1.2), Color3.fromRGB(255, 196, 130), Enum.Material.Neon, 0.1)
			lantern.CFrame = CFrame.new(p0)
			tween(lantern, rise + drift + descend, { CFrame = CFrame.new(p0 + Vector3.new(0, 14 + (k % 3) * 4, 0)) }, Enum.EasingStyle.Sine)
			table.insert(parts, lantern)
		end
		for k = 1, 4 do
			local a = k / 4 * math.pi * 2 + 0.4
			local p = g + Vector3.new(math.cos(a) * range * 0.45, 6, math.sin(a) * range * 0.45)
			local d = makeDoor(CFrame.lookAt(p, Vector3.new(g.X, p.Y, g.Z)), 3.4, 5.6)
			task.delay(rise + k * 0.4, function()
				doorBlink(d, 0.8)
			end)
			task.delay(rise + drift + descend, function()
				killDoor(d, 0.5)
			end)
		end
	end)
	-- 별의 소용돌이 (가운데를 감싸며 천천히 오른다)
	local spin: { Part } = {}
	for k = 1, 28 do
		local s = part(Vector3.new(0.5, 0.5, 0.5), k % 3 == 0 and MOON or (k % 3 == 1 and STAR or LAVENDER), Enum.Material.Neon, 1, "ball")
		table.insert(spin, s)
		table.insert(parts, s)
	end
	local t0 = os.clock()
	local conn: RBXScriptConnection
	conn = RunService.Heartbeat:Connect(function()
		local t = os.clock() - t0
		local u = math.clamp((t - cut - rise) / drift, 0, 1)
		if t > cut + rise and t < cut + rise + drift + descend then
			for k, s in ipairs(spin) do
				local a = t * 0.9 + k / #spin * math.pi * 2
				local rr = range * (0.25 + (k % 4) * 0.15) * (1 - u * 0.3)
				s.Transparency = 0.1
				s.CFrame = CFrame.new(g + Vector3.new(math.cos(a) * rr, 3 + (k % 5) * 2 + u * 4, math.sin(a) * rr))
			end
			if math.random() < 0.25 then
				local a, rr = math.random() * math.pi * 2, math.random() * range
				zzz(g + Vector3.new(math.cos(a) * rr, 4 + math.random() * 4, math.sin(a) * rr), 1.2)
			end
		end
		if t >= cut + rise + drift + descend then
			conn:Disconnect()
		end
	end)
	-- 달이 내려와 호수에 닿는다
	task.delay(cut + rise + drift, function()
		tween(moon, descend, { CFrame = CFrame.new(g + Vector3.new(0, 20, 0)), Size = Vector3.new(40, 40, 40) }, Enum.EasingStyle.Sine, Enum.EasingDirection.In)
		tween(glow, descend, { CFrame = CFrame.new(g + Vector3.new(0, 20, 0)) }, Enum.EasingStyle.Sine, Enum.EasingDirection.In)
	end)
	task.delay(cut + rise + drift + descend, function()
		-- 소리 없이 하얗게 번진다
		local bloom = part(Vector3.new(10, 10, 10), STAR, Enum.Material.Neon, 0, "ball")
		bloom.CFrame = CFrame.new(g + Vector3.new(0, 6, 0))
		fadeOut(bloom, 1.0, { Size = Vector3.new(range * 2.4, range * 2.4, range * 2.4) })
		for k = 1, 4 do
			task.delay(k * 0.1, function()
				Fx.ring(g + Vector3.new(0, 0.4, 0), k % 2 == 0 and MOON or LAVENDER, 6, range * 2.4 + k * 8, 0.9)
			end)
		end
		stardust(g + Vector3.new(0, 6, 0), 40, 2.4, 8)
		Fx.flash(g + Vector3.new(0, 6, 0), STAR, 160, 9, 0.9)
		Fx.sound("splash", 0.7, 0.6, g)
		shakeNear(g, 2.0, 220)
		if opts.flash and near(g, 120) then
			opts.flash(STAR, 0.35)
		end
		for _, p in ipairs(parts) do
			if p.Parent then
				fadeOut(p, 0.8, { CFrame = p.CFrame - Vector3.new(0, 4, 0) })
			end
		end
		if cc then
			tween(cc, 0.9, { TintColor = Color3.new(1, 1, 1), Brightness = 0, Contrast = 0 })
			task.delay(1, function()
				cc:Destroy()
			end)
		end
	end)
end

local HANDLERS: { [string]: (any) -> () } = {
	dreamWalk = dreamWalk,
	upsideDown = upsideDown,
	dreamIsles = dreamIsles,
	moonDream = moonDream,
}
function Dream.handles(data: any): boolean
	return HANDLERS[data.kind] ~= nil or (data.kind == "pulse" and data.fx == "dreamDoor")
end
function Dream.run(data: any)
	if data.kind == "pulse" then
		dreamDoorPulse(data)
		return
	end
	local fn = HANDLERS[data.kind]
	if fn then
		fn(data)
	end
end

return Dream
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="26">
          <Properties>
            <string name="Name">Drunk</string>
            <string name="Source"><![CDATA[-- 권왕: 초월 권법 초·취팔선권의 화면 (초록 술병, 머리에 동여맨 넥타이, 기술 연출, 초 오의 취선만권의 컷씬)
-- 술병은 상표 없는 초록 유리병. 몸짓마다 초록 불길과 유리 조각, 술 방울이 튄다
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local Debris = game:GetService("Debris")

local Config = require(ReplicatedStorage:WaitForChild("Config"))
local Fx = require(script.Parent:WaitForChild("Fx"))

local Drunk = {}
local player = Players.LocalPlayer

local GREEN = Color3.fromRGB(70, 200, 110)
local GLASS = Color3.fromRGB(60, 165, 95)
local PALE = Color3.fromRGB(215, 255, 225)
local FLAME = Color3.fromRGB(120, 255, 160)
local WHITE = Color3.new(1, 1, 1)
local TEX_FIRE = "rbxasset://textures/particles/fire_main.dds"
local TEX_SPARK = "rbxasset://textures/particles/sparkles_main.dds"

local folder = Instance.new("Folder")
folder.Name = "KwonDrunk"
folder.Parent = workspace

local function tween(inst: Instance, time: number, goal: { [string]: any }, style: Enum.EasingStyle?, dir: Enum.EasingDirection?)
	local tw = TweenService:Create(inst, TweenInfo.new(time, style or Enum.EasingStyle.Quad, dir or Enum.EasingDirection.Out), goal)
	tw:Play()
	return tw
end
local function rootOf(m: Instance?): BasePart?
	local r = m and m:FindFirstChild("HumanoidRootPart")
	return (r and r:IsA("BasePart")) and r or nil
end
local function near(pos: Vector3, d: number): boolean
	local cam = workspace.CurrentCamera
	return cam ~= nil and (cam.CFrame.Position - pos).Magnitude < d
end
local function flat(v: Vector3): Vector3
	local f = Vector3.new(v.X, 0, v.Z)
	return f.Magnitude > 1e-3 and f.Unit or Vector3.new(0, 0, -1)
end

-- 떠다니는 조각 (물리 없음)
local function part(size: Vector3, color: Color3, material: Enum.Material?, alpha: number?, shape: string?): Part
	local p = Instance.new("Part")
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	p.Size = size
	p.Color = color
	p.Material = material or Enum.Material.Neon
	p.Transparency = alpha or 0
	if shape == "ball" then
		local mesh = Instance.new("SpecialMesh")
		mesh.MeshType = Enum.MeshType.Sphere
		mesh.Parent = p
	elseif shape == "cyl" then
		p.Shape = Enum.PartType.Cylinder
	end
	p.Parent = folder
	return p
end

------------------------------------------------------------------------
-- 술병과 넥타이 (손과 머리에 붙는다)
------------------------------------------------------------------------
local tails: { { weld: Weld, base: CFrame, phase: number } } = {}
local function attach(p: BasePart, to: BasePart, cf: CFrame, holder: Instance, list: { Instance }, flutter: number?)
	p.Massless = true
	p.Anchored = false
	if flutter then
		-- 넥타이 꼬리는 바람에 흔들린다 (용접 각도를 매 순간 바꾼다)
		local w = Instance.new("Weld")
		w.Part0 = to
		w.Part1 = p
		w.C0 = cf
		w.Parent = p
		table.insert(tails, { weld = w, base = cf, phase = flutter })
	else
		p.CFrame = to.CFrame * cf
		local w = Instance.new("WeldConstraint")
		w.Part0 = to
		w.Part1 = p
		w.Parent = p
	end
	p.Parent = holder
	table.insert(list, p)
end

-- 상표 없는 초록 유리병: 손이 목을 쥐고, 몸통은 새끼손가락 쪽으로 뻗는다
local function buildBottle(hand: BasePart, holder: Instance, list: { Instance })
	local up = CFrame.Angles(0, 0, math.rad(90)) -- 원기둥의 축(X)을 손의 위아래(Y)로
	local function cyl(len: number, d: number, y: number, color: Color3, mat: Enum.Material, alpha: number?)
		local p = part(Vector3.new(len, d, d), color, mat, alpha, "cyl")
		attach(p, hand, CFrame.new(0, y, 0) * up, holder, list)
		return p
	end
	cyl(0.75, 0.28, -0.05, GLASS, Enum.Material.Glass, 0.15) -- 목
	cyl(0.16, 0.31, 0.36, Color3.fromRGB(40, 120, 70), Enum.Material.Metal) -- 뚜껑
	local shoulder = part(Vector3.new(0.68, 0.5, 0.68), GLASS, Enum.Material.Glass, 0.2, "ball")
	attach(shoulder, hand, CFrame.new(0, -0.5, 0), holder, list)
	cyl(1.5, 0.68, -1.25, GLASS, Enum.Material.Glass, 0.22) -- 몸통
	cyl(1.1, 0.56, -1.35, Color3.fromRGB(225, 250, 230), Enum.Material.SmoothPlastic, 0.55) -- 속에 찰랑이는 술
	cyl(0.62, 0.7, -1.2, Color3.fromRGB(240, 245, 238), Enum.Material.SmoothPlastic) -- 빈 띠 (글씨 없음)
	cyl(0.05, 0.71, -0.9, GREEN, Enum.Material.SmoothPlastic)
	cyl(0.05, 0.71, -1.5, GREEN, Enum.Material.SmoothPlastic)
	cyl(0.06, 0.66, -2.0, Color3.fromRGB(40, 110, 65), Enum.Material.Glass, 0.1) -- 바닥
	-- 병 입구의 작은 초록 빛 (불을 뿜는 자리)
	local mouth = part(Vector3.new(0.12, 0.12, 0.12), FLAME, Enum.Material.Neon, 1)
	mouth.Name = "SojuMouth"
	attach(mouth, hand, CFrame.new(0, 0.45, 0), holder, list)
	local glow = Instance.new("PointLight")
	glow.Color = FLAME
	glow.Range = 5
	glow.Brightness = 0.5
	glow.Parent = mouth
end

-- 머리에 질끈 동여맨 붉은 넥타이: 이마를 한 바퀴 두르고, 오른쪽 뒤에 매듭, 두 꼬리가 늘어져 흔들린다
local function buildTie(head: BasePart, holder: Instance, list: { Instance })
	local r = math.max(head.Size.X, head.Size.Z) * 0.5 + 0.04
	local y = head.Size.Y * 0.2
	local red = Color3.fromRGB(205, 40, 50)
	local dark = Color3.fromRGB(120, 20, 35)
	local n = 14
	local chord = 2 * r * math.sin(math.pi / n) * 1.08
	for k = 0, n - 1 do
		local a = k / n * math.pi * 2
		local p = part(Vector3.new(chord, 0.26, 0.06), k % 3 == 0 and dark or red, Enum.Material.Fabric)
		attach(p, head, CFrame.Angles(0, a, 0) * CFrame.new(0, y, -r), holder, list)
	end
	local knotA = math.rad(-125)
	local knotCF = CFrame.Angles(0, knotA, 0) * CFrame.new(0, y, -r - 0.08)
	local knot = part(Vector3.new(0.3, 0.3, 0.2), dark, Enum.Material.Fabric)
	attach(knot, head, knotCF, holder, list)
	-- 두 꼬리: 넓은 쪽과 좁은 쪽 (끝은 뾰족하게)
	for i, spec in ipairs({ { 0.34, 1.25, 18 }, { 0.24, 1.0, -14 } }) do
		local w, len, tilt = spec[1], spec[2], spec[3]
		local base = knotCF * CFrame.Angles(math.rad(-25), 0, math.rad(tilt)) * CFrame.new(0, -len / 2 - 0.1, -0.05)
		local tail = part(Vector3.new(w, len, 0.05), red, Enum.Material.Fabric)
		attach(tail, head, base, holder, list, i * 1.7)
		local tip = part(Vector3.new(w * 0.72, w * 0.72, 0.05), red, Enum.Material.Fabric)
		attach(tip, head, base * CFrame.new(0, -len / 2, 0) * CFrame.Angles(0, 0, math.rad(45)), holder, list, i * 1.7)
		-- 사선 줄무늬
		for s = 0, 1 do
			local stripe = part(Vector3.new(w * 1.02, 0.07, 0.055), dark, Enum.Material.Fabric)
			attach(stripe, head, base * CFrame.new(0, 0.25 - s * 0.45, 0) * CFrame.Angles(0, 0, math.rad(30)), holder, list, i * 1.7)
		end
	end
end

local mouths: { [Model]: BasePart } = {}
-- 몸 하나에 술병과 넥타이를 만든다 (Sakura가 부채와 같은 자리에서 부른다). 만든 것들을 돌려준다
function Drunk.build(model: Model): { Instance }
	local out: { Instance } = {}
	local holder = Instance.new("Folder")
	holder.Name = "Soju_" .. model.Name
	holder.Parent = folder
	table.insert(out, holder)
	local hand = model:FindFirstChild("RightHand")
	if hand and hand:IsA("BasePart") then
		buildBottle(hand, holder, out)
	end
	local head = model:FindFirstChild("Head")
	if head and head:IsA("BasePart") then
		buildTie(head, holder, out)
	end
	for _, p in ipairs(out) do
		if p.Name == "SojuMouth" and p:IsA("BasePart") then
			mouths[model] = p
		end
	end
	return out
end

RunService.Heartbeat:Connect(function()
	local t = os.clock()
	for i = #tails, 1, -1 do
		local tl = tails[i]
		if not tl.weld.Parent then
			table.remove(tails, i)
		else
			tl.weld.C0 = tl.base * CFrame.Angles(math.sin(t * 3.1 + tl.phase) * 0.22, 0, math.sin(t * 2.3 + tl.phase) * 0.12)
		end
	end
	for m, p in pairs(mouths) do
		if not p.Parent or not m.Parent then
			mouths[m] = nil
		end
	end
end)

local function mouthOf(model: Model): Vector3?
	local p = mouths[model]
	if p and p.Parent then
		return p.Position
	end
	local h = model:FindFirstChild("RightHand")
	return (h and h:IsA("BasePart")) and h.Position or nil
end

------------------------------------------------------------------------
-- 작은 연출 조각들
------------------------------------------------------------------------
-- 술 방울이 튄다 (초록빛 도는 투명한 알갱이)
local function splash(pos: Vector3, n: number, spread: number, up: number?)
	for _ = 1, n do
		local d = part(Vector3.one * (0.25 + math.random() * 0.3), Color3.fromRGB(200, 245, 215), Enum.Material.Glass, 0.3, "ball")
		d.Position = pos
		local v = Vector3.new(math.random() - 0.5, 0, math.random() - 0.5).Unit * spread * (0.4 + math.random() * 0.6) + Vector3.new(0, (up or 4) * (0.5 + math.random()), 0)
		local life = 0.45 + math.random() * 0.3
		tween(d, life, { Position = pos + v - Vector3.new(0, 3, 0), Transparency = 1 }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
		Debris:AddItem(d, life + 0.05)
	end
end
-- 유리 조각이 튄다 (깨진 술병)
local function shards(pos: Vector3, n: number, spread: number)
	for _ = 1, n do
		local s = part(Vector3.new(0.4 + math.random() * 0.5, 0.05, 0.25 + math.random() * 0.4), GLASS, Enum.Material.Glass, 0.15)
		s.CFrame = CFrame.new(pos) * CFrame.Angles(math.random() * 6, math.random() * 6, math.random() * 6)
		local v = Vector3.new(math.random() - 0.5, math.random() * 0.8, math.random() - 0.5).Unit * spread * (0.5 + math.random() * 0.5)
		local life = 0.5 + math.random() * 0.4
		tween(s, life, { CFrame = CFrame.new(pos + v - Vector3.new(0, 2, 0)) * CFrame.Angles(math.random() * 12, math.random() * 12, math.random() * 12), Transparency = 1 })
		Debris:AddItem(s, life + 0.05)
	end
end
-- 초록 불길 기둥
local function flameAt(pos: Vector3, size: number, life: number)
	local p = part(Vector3.new(size, 0.2, size), FLAME, Enum.Material.Neon, 1)
	p.Position = pos
	local pe = Instance.new("ParticleEmitter")
	pe.Texture = TEX_FIRE
	pe.Color = ColorSequence.new({ ColorSequenceKeypoint.new(0, Color3.fromRGB(230, 255, 200)), ColorSequenceKeypoint.new(0.4, FLAME), ColorSequenceKeypoint.new(1, Color3.fromRGB(40, 140, 120)) })
	pe.LightEmission = 0.9
	pe.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, size * 0.6), NumberSequenceKeypoint.new(1, size * 0.15) })
	pe.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.2), NumberSequenceKeypoint.new(1, 1) })
	pe.Lifetime = NumberRange.new(0.5, 0.9)
	pe.Speed = NumberRange.new(size * 1.2, size * 2.2)
	pe.SpreadAngle = Vector2.new(12, 12)
	pe.EmissionDirection = Enum.NormalId.Top
	pe.Rate = 40
	pe.Parent = p
	task.delay(life, function()
		pe.Enabled = false
	end)
	Debris:AddItem(p, life + 1)
end
-- 반달 휘두름 자국 (초록)
local function swoosh(cf: CFrame, radius: number, life: number, thick: number)
	local n = 9
	for i = 0, n - 1 do
		local a = -1.2 + 2.4 * i / (n - 1)
		local seg = part(Vector3.new(radius * 2.4 / n, thick * (1 - math.abs(a) * 0.5), 0.08), i % 2 == 0 and GREEN or PALE, Enum.Material.Neon, 0.15)
		seg.CFrame = cf * CFrame.Angles(0, a, 0) * CFrame.new(0, 0, -radius)
		tween(seg, life, { Transparency = 1, Size = seg.Size * Vector3.new(1.2, 0.2, 1) })
		Debris:AddItem(seg, life + 0.05)
	end
end
-- 초록 반투명 잔상 (몸을 본뜬 그림자)
local function ghostOf(model: Model, at: CFrame, color: Color3, alpha: number): { BasePart }
	local r = rootOf(model)
	local out = {}
	if not r then
		return out
	end
	for _, d in ipairs(model:GetChildren()) do
		if d:IsA("BasePart") and d.Name ~= "HumanoidRootPart" and d.Transparency < 0.9 then
			local g = part(d.Size, color, Enum.Material.Neon, alpha)
			g.CFrame = at * r.CFrame:ToObjectSpace(d.CFrame)
			table.insert(out, g)
		end
	end
	return out
end

------------------------------------------------------------------------
-- 연타·강타·기술을 쓸 때 (모두가 본다)
------------------------------------------------------------------------
function Drunk.cast(styleId: any, slot: any, model: Model, dur: number)
	local st = type(styleId) == "string" and Config.STYLE_BY_ID[styleId] or nil
	if not st or not st.soju then
		return
	end
	local r = rootOf(model)
	if not r or not near(r.Position, 160) then
		return
	end
	if type(slot) == "number" or slot == "H" or slot == "F" then
		local big = slot == 4 or slot == "H" or slot == "F"
		task.delay(math.min(0.14, dur * 0.4), function()
			local look = r.CFrame
			swoosh(look * CFrame.new(0, 0.8, 0) * CFrame.Angles(0, 0, (type(slot) == "number" and slot % 2 == 0) and 0.6 or -0.6), big and 6 or 4, big and 0.4 or 0.25, big and 0.9 or 0.5)
			local m = mouthOf(model)
			if m then
				splash(m, big and 10 or 4, big and 6 or 3, 3)
			end
			if slot == 4 or slot == "F" then
				local feet = (look * CFrame.new(0, -2.4, -3)).Position
				Fx.ring(feet, GREEN, 2, 16, 0.35)
				shards(feet + Vector3.new(0, 1, 0), 8, 6)
				Fx.sound("block", 0.5, 1.5, feet)
			elseif slot == "H" then
				Fx.afterimage(model, GREEN, 0.3)
			end
		end)
	elseif slot == "E" then
		local m = mouthOf(model)
		if m then
			splash(m, 10, 3, 5)
		end
	elseif slot == "R" then
		Fx.text(r.Position + Vector3.new(0, 4, 0), "딸꾹!", PALE, 26, 0.9)
	elseif slot == "G" then
		splash(r.Position + Vector3.new(0, 2, 0), 16, 6, 6)
		Fx.ring(r.Position - Vector3.new(0, 2.4, 0), GREEN, 2, 26, 0.6)
	end
end

------------------------------------------------------------------------
-- 기술 장치의 연출 (서버의 skillfx)
------------------------------------------------------------------------
-- 취화방사 (E): 병 입구에서 초록 불길이 앞으로 뿜어져 나간다
local function sprayCone(data: any)
	local m0: Model? = data.m
	local r = rootOf(m0)
	if not m0 or not r or not near(r.Position, 200) then
		return
	end
	local m = m0 :: Model
	local range = data.range or 20
	local nozzle = part(Vector3.new(0.4, 0.4, 0.4), FLAME, Enum.Material.Neon, 1)
	local pe = Instance.new("ParticleEmitter")
	pe.Texture = TEX_FIRE
	pe.Color = ColorSequence.new({ ColorSequenceKeypoint.new(0, Color3.fromRGB(240, 255, 220)), ColorSequenceKeypoint.new(0.3, FLAME), ColorSequenceKeypoint.new(0.75, GREEN), ColorSequenceKeypoint.new(1, Color3.fromRGB(30, 110, 90)) })
	pe.LightEmission = 1
	pe.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.6), NumberSequenceKeypoint.new(0.5, 3.2), NumberSequenceKeypoint.new(1, 5) })
	pe.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.1), NumberSequenceKeypoint.new(0.7, 0.4), NumberSequenceKeypoint.new(1, 1) })
	pe.Lifetime = NumberRange.new(0.4, 0.55)
	pe.Speed = NumberRange.new(range * 1.7, range * 2.1)
	pe.SpreadAngle = Vector2.new((data.angle or 60) * 0.35, (data.angle or 60) * 0.2)
	pe.EmissionDirection = Enum.NormalId.Front
	pe.Drag = 1.2
	pe.Rate = 0
	pe.Parent = nozzle
	local light = Instance.new("PointLight")
	light.Color = FLAME
	light.Range = 18
	light.Brightness = 2
	light.Parent = nozzle
	local delay = data.delay or 0
	local dur = data.dur or 1.6
	local t0 = os.clock()
	local conn
	conn = RunService.Heartbeat:Connect(function()
		local t = os.clock() - t0
		if t > delay + dur + 0.6 or not m.Parent then
			conn:Disconnect()
			nozzle:Destroy()
			return
		end
		local from = mouthOf(m) or r.Position
		local look = flat(r.CFrame.LookVector)
		nozzle.CFrame = CFrame.lookAt(from, from + look + Vector3.new(0, -0.05, 0))
		pe.Rate = (t > delay and t < delay + dur) and 90 or 0
	end)
	task.delay(delay, function()
		Fx.sound("splash", 0.5, 1.6, r.Position)
	end)
end

-- 팔선취보 (R): 걸음마다 초록 잔상과 술 방울
local function zigzagStep(data: any)
	local to0: Vector3? = data.to
	if not to0 or not near(to0, 200) then
		return
	end
	local to = to0 :: Vector3
	local m: Model? = data.m
	if m then
		Fx.afterimage(m, GREEN, 0.35)
	end
	Fx.ring(to - Vector3.new(0, 2.5, 0), GREEN, 1.5, 11, 0.3)
	splash(to, 5, 4, 3)
	if data.i and data.i % 3 == 0 then
		Fx.text(to + Vector3.new(0, 4, 0), "딸꾹", PALE, 20, 0.7)
	end
	Fx.sound("swing", 0.35, 0.8 + math.random() * 0.3, to)
end

-- 취몽팔선진 (G): 하늘로 던진 술병 → 깨져서 술비 → 웅덩이
local puddles: { [any]: Part } = {}
local function sojuThrow(data: any)
	local at: Vector3 = data.at
	if not at or not near(at, 260) then
		return
	end
	local radius = data.radius or 26
	local delay = data.delay or 0.6
	local rain = data.rain or 1.6
	local m: Model? = data.m
	local from = (m and mouthOf(m)) or at + Vector3.new(0, 3, 0)
	local top = at + Vector3.new(0, 34, 0)
	-- 날아오르며 빙글빙글 도는 술병
	local bottle = part(Vector3.new(1.6, 0.7, 0.7), GLASS, Enum.Material.Glass, 0.2, "cyl")
	bottle.CFrame = CFrame.new(from)
	tween(bottle, delay, { CFrame = CFrame.new(top) * CFrame.Angles(math.pi * 6, math.pi * 2, 0) }, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
	Debris:AddItem(bottle, delay + 0.05)
	task.delay(delay, function()
		-- 하늘에서 깨진다
		shards(top, 26, 16)
		Fx.flash(top, FLAME, 60, 4, 0.4)
		Fx.breakSound("glass", 1, 0.9, at)
		-- 술비: 둘레 위에서 방울이 쏟아진다
		local cloud = part(Vector3.new(radius * 2, 1, radius * 2), PALE, Enum.Material.Neon, 1)
		cloud.Position = at + Vector3.new(0, 26, 0)
		local pe = Instance.new("ParticleEmitter")
		pe.Texture = TEX_SPARK
		pe.Color = ColorSequence.new(Color3.fromRGB(215, 255, 230), Color3.fromRGB(150, 230, 180))
		pe.LightEmission = 0.5
		pe.Size = NumberSequence.new(0.35, 0.2)
		pe.Squash = NumberSequence.new(-2) -- 길쭉한 빗줄기
		pe.Transparency = NumberSequence.new(0.2, 0.6)
		pe.Lifetime = NumberRange.new(0.6, 0.8)
		pe.Speed = NumberRange.new(36, 44)
		pe.EmissionDirection = Enum.NormalId.Bottom
		pe.SpreadAngle = Vector2.new(4, 4)
		pe.Shape = Enum.ParticleEmitterShape.Box
		pe.Rate = 260
		pe.Parent = cloud
		task.delay(rain, function()
			pe.Enabled = false
		end)
		Debris:AddItem(cloud, rain + 1)
		-- 바닥에 번지는 술 웅덩이
		local pool = part(Vector3.new(0.12, 2, 2), Color3.fromRGB(190, 240, 205), Enum.Material.Glass, 0.45, "cyl")
		pool.CFrame = CFrame.new(at - Vector3.new(0, 2.6, 0)) * CFrame.Angles(0, 0, math.rad(90))
		tween(pool, rain, { Size = Vector3.new(0.12, radius * 2, radius * 2) }, Enum.EasingStyle.Sine)
		puddles[data.m or at] = pool
		Debris:AddItem(pool, rain + 3)
	end)
end
-- 불똥 하나에 웅덩이가 타오르고, 여덟 취선의 그림자가 한가운데로 덮친다
local function sojuIgnite(data: any)
	local at: Vector3 = data.at
	if not at or not near(at, 260) then
		return
	end
	local radius = data.radius or 26
	local pool = puddles[data.m or at]
	puddles[data.m or at] = nil
	if pool and pool.Parent then
		pool.Material = Enum.Material.Neon
		pool.Color = FLAME
		tween(pool, 1.4, { Transparency = 1 })
	end
	-- 바닥 가득 초록 불길
	for k = 0, 13 do
		local a = k / 14 * math.pi * 2
		for _, rr in ipairs({ radius * 0.45, radius * 0.85 }) do
			flameAt(at + Vector3.new(math.cos(a) * rr, -2.4, math.sin(a) * rr), 3 + math.random() * 2, 1.1)
		end
	end
	flameAt(at - Vector3.new(0, 2.4, 0), 8, 1.2)
	Fx.flash(at, FLAME, radius * 3, 5, 0.6)
	Fx.sound("heavy", 1, 0.6, at)
	-- 여덟 취선의 그림자
	local m: Model? = data.m
	local n = data.ghosts or 8
	local targets: { Model } = data.targets or {}
	if m then
		for i = 1, n do
			local a = (i - 1) / n * math.pi * 2
			local from = at + Vector3.new(math.cos(a) * radius * 0.7, 0, math.sin(a) * radius * 0.7)
			local tgt = targets[((i - 1) % math.max(1, #targets)) + 1]
			local tr = tgt and rootOf(tgt)
			local to = tr and tr.Position or at
			local cf0 = CFrame.lookAt(from, Vector3.new(to.X, from.Y, to.Z))
			local list = ghostOf(m, cf0, i % 2 == 0 and GREEN or PALE, 0.45)
			local lunge = flat(to - from) * math.max(0, (to - from).Magnitude - 3)
			for _, g in ipairs(list) do
				tween(g, 0.32, { CFrame = g.CFrame + lunge }, Enum.EasingStyle.Back, Enum.EasingDirection.In)
				task.delay(0.32, function()
					tween(g, 0.3, { Transparency = 1 })
				end)
				Debris:AddItem(g, 0.7)
			end
		end
	end
	task.delay(0.35, function()
		for _, t in ipairs(targets) do
			local tr = rootOf(t)
			if tr then
				Fx.blast(tr.Position, GREEN, PALE, 1.4)
				shards(tr.Position, 6, 6)
			end
		end
		Fx.ring(at - Vector3.new(0, 2.3, 0), FLAME, 4, radius * 2.4, 0.6)
	end)
end

-- 취선만권 (X): 구르는 몸에 초록 잔상 (모두가 본다)
local function rushCut(data: any)
	local m0: Model? = data.m
	local r = rootOf(m0)
	if not m0 or not r or not near(r.Position, 200) then
		return
	end
	local m = m0 :: Model
	local dur = data.dur or 1
	local t0 = os.clock()
	local last = 0
	local conn
	conn = RunService.Heartbeat:Connect(function()
		local t = os.clock() - t0
		if t > dur or not m.Parent then
			conn:Disconnect()
			return
		end
		-- 갈수록 잔상이 촘촘해진다
		local gap = 0.14 - 0.1 * (t / dur)
		if t - last > gap then
			last = t
			Fx.afterimage(m, t / dur > 0.6 and PALE or GREEN, 0.25)
			Fx.dust(r.Position - Vector3.new(0, 2.6, 0), 1.2 + t / dur)
		end
	end)
end
-- 와다다다: 앞으로 쏟아지는 주먹 그림자와 맞는 자리의 불꽃
local function rushFlurry(data: any)
	local m0: Model? = data.m
	local r = rootOf(m0)
	if not m0 or not r or not near(r.Position, 200) then
		return
	end
	local m = m0 :: Model
	local dur = data.dur or 1.8
	Fx.text(r.Position + Vector3.new(0, 6, 0), "와다다다다다!", Color3.fromRGB(230, 255, 120), 40, 1.4)
	local t0 = os.clock()
	local last = 0
	local conn
	conn = RunService.Heartbeat:Connect(function()
		local t = os.clock() - t0
		if t > dur or not m.Parent then
			conn:Disconnect()
			return
		end
		if t - last < 0.035 then
			return
		end
		last = t
		local cf = r.CFrame
		for _ = 1, 2 do
			local off = Vector3.new((math.random() - 0.5) * 2.6, (math.random() - 0.3) * 1.8, 0)
			local fist = part(Vector3.new(0.9, 0.9, 0.9), math.random() < 0.5 and GREEN or PALE, Enum.Material.Neon, 0.25, "ball")
			fist.CFrame = cf * CFrame.new(off + Vector3.new(0, 0.6, -1.2))
			tween(fist, 0.16, { CFrame = cf * CFrame.new(off * 1.3 + Vector3.new(0, 0.6, -4.5)), Transparency = 1, Size = Vector3.new(1.6, 1.6, 0.4) })
			Debris:AddItem(fist, 0.2)
		end
		if math.random() < 0.35 then
			local hitAt = (cf * CFrame.new((math.random() - 0.5) * 3, 0.6 + (math.random() - 0.5) * 2, -4)).Position
			Fx.spark(hitAt, math.random() < 0.5 and WHITE or FLAME, 0.7, 3)
			Fx.sound("hit", 0.25, 1.2 + math.random() * 0.4, hitAt)
		end
	end)
end
-- 마지막: 술병을 깨뜨리며 초록 불길이 터진다
local function rushEnd(data: any)
	local at: Vector3 = data.at
	if not at or not near(at, 260) then
		return
	end
	local radius = data.radius or 22
	shards(at + Vector3.new(0, 1, 0), 30, 14)
	splash(at, 24, 12, 8)
	Fx.blast(at, GREEN, PALE, 3)
	Fx.flash(at, FLAME, 90, 6, 0.5)
	Fx.ring(at - Vector3.new(0, 2.3, 0), FLAME, 4, radius * 2.6, 0.6)
	Fx.ring(at - Vector3.new(0, 2.2, 0), WHITE, 3, radius * 1.6, 0.4)
	for k = 0, 9 do
		local a = k / 10 * math.pi * 2
		flameAt(at + Vector3.new(math.cos(a) * radius * 0.5, -2.4, math.sin(a) * radius * 0.5), 4, 0.8)
	end
	Fx.breakSound("rock", 1, 0.8, at)
	Fx.sound("heavy", 1, 0.5, at)
end

local HANDLERS: { [string]: (any) -> () } = {
	zigzagStep = zigzagStep,
	sojuThrow = sojuThrow,
	sojuIgnite = sojuIgnite,
	rushCut = rushCut,
	rushFlurry = rushFlurry,
	rushEnd = rushEnd,
}
function Drunk.handles(data: any): boolean
	return (data.kind == "cone" and data.fx == "soju") or data.kind == "zigzagStart" or HANDLERS[data.kind] ~= nil
end
function Drunk.run(data: any)
	if data.kind == "cone" then
		sprayCone(data)
		return
	end
	local fn = HANDLERS[data.kind]
	if fn then
		fn(data)
	end
end

------------------------------------------------------------------------
-- 초 오의 취선만권의 컷씬 (쓴 사람 화면에서만, 1.6초, 대사 없이):
-- 위아래 검은 띠, 옆에서 낮게 잡은 카메라, 점점 빨라지는 앞구르기와 몰려드는 속도선 → 띠가 걷히며 와다다다
------------------------------------------------------------------------
local cutActive = false
function Drunk.superCut(model: Model, dur: number, name: string, shake: ((number) -> ())?)
	local cam = workspace.CurrentCamera
	local r = rootOf(model)
	if not cam or not r or cutActive then
		return
	end
	cutActive = true
	local pg = player:WaitForChild("PlayerGui")
	local g = Instance.new("ScreenGui")
	g.Name = "KwonDrunkCut"
	g.IgnoreGuiInset = true
	g.ResetOnSpawn = false
	g.DisplayOrder = 85
	g.Parent = pg
	-- 초록빛 도는 가장자리
	local tintF = Instance.new("Frame")
	tintF.Size = UDim2.fromScale(1, 1)
	tintF.BackgroundColor3 = Color3.fromRGB(20, 60, 35)
	tintF.BackgroundTransparency = 1
	tintF.BorderSizePixel = 0
	tintF.Parent = g
	local grad = Instance.new("UIGradient")
	grad.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.2), NumberSequenceKeypoint.new(0.3, 1), NumberSequenceKeypoint.new(0.7, 1), NumberSequenceKeypoint.new(1, 0.2) })
	grad.Parent = tintF
	tween(tintF, 0.15, { BackgroundTransparency = 0.55 })
	-- 속도선: 화면을 가로질러 뒤로 흘러간다 (갈수록 빠르다)
	local lines: { Frame } = {}
	for i = 1, 16 do
		local l = Instance.new("Frame")
		l.AnchorPoint = Vector2.new(0.5, 0.5)
		l.Position = UDim2.fromScale(math.random(), 0.15 + 0.7 * (i - 0.5) / 16)
		l.Size = UDim2.new(0.1 + math.random() * 0.2, 0, 0, 2 + math.random(0, 2))
		l.BackgroundColor3 = i % 3 == 0 and PALE or WHITE
		l.BackgroundTransparency = 0.35
		l.BorderSizePixel = 0
		l.ZIndex = 2
		l.Parent = g
		table.insert(lines, l)
	end
	-- 위아래 검은 띠
	local bars: { Frame } = {}
	for i, y in ipairs({ 0, 1 }) do
		local b = Instance.new("Frame")
		b.AnchorPoint = Vector2.new(0, y)
		b.Position = UDim2.fromScale(0, y)
		b.Size = UDim2.new(1, 0, 0, 0)
		b.BackgroundColor3 = Color3.new(0, 0, 0)
		b.BorderSizePixel = 0
		b.ZIndex = 5
		b.Parent = g
		tween(b, 0.12, { Size = UDim2.new(1, 0, 0.14, 0) })
		bars[i] = b
	end
	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.AnchorPoint = Vector2.new(1, 0.5)
	label.Position = UDim2.new(1, -30, 0.5, 0)
	label.Size = UDim2.new(0.5, 0, 0.45, 0)
	label.Font = Enum.Font.GothamBlack
	label.TextScaled = true
	label.TextXAlignment = Enum.TextXAlignment.Right
	label.Text = "초 오의 · " .. name
	label.TextColor3 = PALE
	label.TextStrokeColor3 = GREEN
	label.TextStrokeTransparency = 0.3
	label.TextTransparency = 1
	label.ZIndex = 6
	label.Parent = bars[2]
	tween(label, 0.2, { TextTransparency = 0 })

	-- 카메라: 구르는 방향의 옆에서 낮게 (시작할 때의 방향으로 고정)
	local oldType = cam.CameraType
	local oldFov = cam.FieldOfView
	local look = flat(r.CFrame.LookVector)
	local side = Vector3.new(-look.Z, 0, look.X)
	cam.CameraType = Enum.CameraType.Scriptable
	local t0 = os.clock()
	local focus = r.Position
	local finished = false
	local function restore()
		if finished then
			return
		end
		finished = true
		RunService:UnbindFromRenderStep("KwonDrunkCut")
		cam.CameraType = oldType == Enum.CameraType.Scriptable and Enum.CameraType.Custom or oldType
		cam.FieldOfView = oldFov
		cutActive = false
		-- 1.9.3판: 컷씬이 끝나면 카메라를 내 등 뒤 조금 높은 곳으로 (앞에서 터지는 기술이 잘 보이게)
		local function behind()
			if r.Parent then
				local lk = flat(r.CFrame.LookVector)
				cam.CFrame = CFrame.lookAt(r.Position - lk * 15 + Vector3.new(0, 6, 0), r.Position + lk * 6 + Vector3.new(0, 1, 0))
			end
		end
		behind()
		task.defer(behind)
	end
	RunService:BindToRenderStep("KwonDrunkCut", Enum.RenderPriority.Camera.Value, function(dt: number)
		if finished then
			return
		end
		local t = os.clock() - t0
		local u = math.clamp(t / dur, 0, 1)
		if not r.Parent then
			restore()
			return
		end
		focus = focus:Lerp(r.Position, math.min(1, dt * 14))
		-- 처음엔 옆에서, 끝으로 갈수록 앞쪽으로 돌아 들어간다
		local orbit = side * (10 - 3 * u) + look * (-2 + 6 * u) + Vector3.new(0, 1.6 - 0.6 * u, 0)
		cam.CFrame = CFrame.lookAt(focus + orbit, focus + look * (2 + 3 * u) + Vector3.new(0, -0.3, 0))
		cam.FieldOfView = oldFov - 18 + 10 * u * u
		-- 속도선이 점점 빨라진다
		local speed = 1.2 + 6 * u * u
		for i, l in ipairs(lines) do
			local x = l.Position.X.Scale - speed * dt * (0.8 + (i % 4) * 0.15)
			if x < -0.2 then
				x += 1.4
			end
			l.Position = UDim2.fromScale(x, l.Position.Y.Scale)
			l.BackgroundTransparency = 0.6 - 0.4 * u
		end
		if shake and u > 0.5 then
			shake(0.15 + u * 0.5)
		end
	end)
	task.delay(dur, function()
		restore()
		-- 띠가 걷히고 하얗게 번쩍인 뒤 와다다다
		for _, b in ipairs(bars) do
			tween(b, 0.18, { Size = UDim2.new(1, 0, 0, 0) })
		end
		tween(label, 0.15, { TextTransparency = 1, TextStrokeTransparency = 1 })
		for _, l in ipairs(lines) do
			l:Destroy()
		end
		tintF.BackgroundColor3 = Color3.fromRGB(235, 255, 240)
		tintF.BackgroundTransparency = 0.2
		grad:Destroy()
		tween(tintF, 0.3, { BackgroundTransparency = 1 })
		if shake then
			shake(1.4)
		end
		Debris:AddItem(g, 0.5)
	end)
end

return Drunk
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="27">
          <Properties>
            <string name="Name">Forest</string>
            <string name="Source"><![CDATA[-- 권왕 2.7판: 만목신권의 숲 (화면). 대나무 창 · 소용돌이치는 잎 · 천 년 은행나무
-- 가시·꽃봉오리·나무 정령 대신 곧고 깨끗한 생김새로: 마디가 있는 대나무, 납작한 타원 잎, 풀결 재질의 금빛 우듬지
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local Config = require(ReplicatedStorage:WaitForChild("Config"))
local Fx = require(script.Parent:WaitForChild("Fx"))

local Forest = {}
local _player = Players.LocalPlayer

local folder = Instance.new("Folder")
folder.Name = "KwonForest"
folder.Parent = workspace

local opts: any = {}
function Forest.init(o: any)
	opts = o or {}
end

local BAMBOO = Color3.fromRGB(104, 160, 64)
local BAMBOO2 = Color3.fromRGB(136, 182, 78)
local NODE = Color3.fromRGB(176, 196, 112)
local LEAF = Color3.fromRGB(78, 140, 56)
local LEAF2 = Color3.fromRGB(122, 180, 80)
local BARK = Color3.fromRGB(96, 74, 56)
local BARK2 = Color3.fromRGB(74, 56, 42)
local GOLD = Color3.fromRGB(240, 196, 60)
local GOLD2 = Color3.fromRGB(252, 220, 96)
local GOLD3 = Color3.fromRGB(222, 168, 40)
local EARTH = Color3.fromRGB(110, 86, 60)
local WHITE = Color3.new(1, 1, 1)

local function tween(inst: Instance, time: number, goal: { [string]: any }, style: Enum.EasingStyle?, dir: Enum.EasingDirection?)
	local tw = TweenService:Create(inst, TweenInfo.new(math.max(0.01, time), style or Enum.EasingStyle.Quad, dir or Enum.EasingDirection.Out), goal)
	tw:Play()
	return tw
end
local function rootOf(m: Instance?): BasePart?
	local r = m and m:FindFirstChild("HumanoidRootPart")
	return (r and r:IsA("BasePart")) and r or nil
end
local function near(pos: Vector3, d: number): boolean
	local cam = workspace.CurrentCamera
	return cam ~= nil and (cam.CFrame.Position - pos).Magnitude < d
end
local function flat(v: Vector3): Vector3
	local f = Vector3.new(v.X, 0, v.Z)
	return f.Magnitude > 1e-3 and f.Unit or Vector3.new(0, 0, -1)
end
local function ground(at: Vector3): Vector3
	return Vector3.new(at.X, at.Y - 2.7, at.Z)
end
local function part(size: Vector3, color: Color3, material: Enum.Material?, alpha: number?, shape: string?): BasePart
	local p: BasePart
	if shape == "wedge" then
		p = Instance.new("WedgePart")
	else
		local q = Instance.new("Part")
		if shape == "ball" then
			q.Shape = Enum.PartType.Ball
		elseif shape == "cyl" then
			q.Shape = Enum.PartType.Cylinder
		end
		p = q
	end
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	p.Size = size
	p.Color = color
	p.Material = material or Enum.Material.SmoothPlastic
	p.Transparency = alpha or 0
	p.Parent = folder
	return p
end
local function fadeOut(p: BasePart, time: number, goal: { [string]: any }?)
	local g = goal or {}
	g.Transparency = 1
	tween(p, time, g)
	task.delay(time + 0.05, function()
		p:Destroy()
	end)
end
local function shakeNear(pos: Vector3, amount: number, range: number)
	if opts.shake and near(pos, range) then
		opts.shake(amount)
	end
end
local UP = CFrame.Angles(0, 0, math.rad(90))

-- 묶음: 조각마다 (기준 위치, 크기)를 기억해 두고 한꺼번에 옮기고 키운다
type Piece = { p: BasePart, off: CFrame, size: Vector3, alpha: number }
local function addTo(list: { Piece }, size: Vector3, off: CFrame, color: Color3, mat: Enum.Material?, alpha: number?, shape: string?): BasePart
	local p = part(size, color, mat, alpha, shape)
	table.insert(list, { p = p, off = off, size = size, alpha = alpha or 0 })
	return p
end
local function placeAll(list: { Piece }, cf: CFrame, g: number?)
	local k = g or 1
	for _, pc in ipairs(list) do
		if pc.p.Parent then
			if k ~= 1 then
				pc.p.Size = pc.size * math.max(0.02, k)
				pc.p.CFrame = cf * CFrame.new(pc.off.Position * k) * pc.off.Rotation
			else
				pc.p.CFrame = cf * pc.off
			end
		end
	end
end

------------------------------------------------------------------------
-- 잎 한 장 (납작한 타원). 떨어지거나 날아가는 잎
------------------------------------------------------------------------
local function leaf(size: number, color: Color3): BasePart
	return part(Vector3.new(0.05, size * 0.4, size), color, Enum.Material.SmoothPlastic, 0, "ball")
end
-- 지는 잎: 흔들리며 내려앉는다
local function fallingLeaf(at: Vector3, color: Color3, size: number, fall: number, life: number)
	local p = leaf(size, color)
	local t0 = os.clock()
	local ph = math.random() * 6
	local spin = (math.random() - 0.5) * 6
	local drift = Vector3.new(math.random() - 0.5, 0, math.random() - 0.5) * 3
	local conn: RBXScriptConnection
	conn = RunService.Heartbeat:Connect(function()
		local t = os.clock() - t0
		if t > life or not p.Parent then
			conn:Disconnect()
			if p.Parent then
				fadeOut(p, 0.3)
			end
			return
		end
		local pos = at + drift * t + Vector3.new(math.sin(t * 3 + ph) * 1.2, -math.min(fall, t * fall / life * 1.3), math.cos(t * 2.6 + ph) * 0.8)
		p.CFrame = CFrame.new(pos) * CFrame.Angles(math.sin(t * 4 + ph) * 0.8, t * spin, math.cos(t * 3 + ph) * 0.6)
	end)
	return p
end

------------------------------------------------------------------------
-- 대나무 한 그루: 마디 있는 줄기, 비스듬히 잘린 끝, 꼭대기 가지의 잎 (아래가 0, 위로 높이 h)
------------------------------------------------------------------------
local function bamboo(h: number, d: number, seed: number): { Piece }
	local list: { Piece } = {}
	local segLen = 1.7 + (seed % 3) * 0.15
	local n = math.max(2, math.floor(h / segLen))
	segLen = h / n
	for i = 0, n - 1 do
		local y = segLen * (i + 0.5)
		local c = BAMBOO:Lerp(BAMBOO2, i / n)
		addTo(list, Vector3.new(segLen * 1.01, d, d), CFrame.new(0, y, 0) * UP, c, Enum.Material.SmoothPlastic, 0, "cyl")
		if i > 0 then
			addTo(list, Vector3.new(0.14, d * 1.14, d * 1.14), CFrame.new(0, segLen * i, 0) * UP, NODE, Enum.Material.SmoothPlastic, 0, "cyl")
		end
	end
	-- 비스듬히 잘린 끝 (창날처럼)
	addTo(list, Vector3.new(d, d * 1.8, d), CFrame.new(0, h + d * 0.9, 0) * CFrame.Angles(0, seed, 0), BAMBOO2, Enum.Material.SmoothPlastic, 0, "wedge")
	-- 위쪽 마디에서 뻗은 가는 가지 둘과 잎
	for b = 0, 1 do
		local y = h - segLen * (1.2 + b * 1.1)
		local a = seed * 1.7 + b * math.pi * 0.9
		local dir = CFrame.new(0, y, 0) * CFrame.Angles(0, a, 0) * CFrame.Angles(0, 0, math.rad(-55))
		addTo(list, Vector3.new(0.08, 1.6, 0.08), dir * CFrame.new(0, 0.8, 0), BAMBOO, Enum.Material.SmoothPlastic)
		for l = 0, 2 do
			local lcf = dir * CFrame.new(0, 1.3 + l * 0.15, 0) * CFrame.Angles(0, (l - 1) * 0.7, 0) * CFrame.Angles(math.rad(70 + l * 10), 0, 0) * CFrame.new(0, 0, -0.7)
			addTo(list, Vector3.new(0.04, 0.3, 1.5), lcf, l % 2 == 0 and LEAF or LEAF2, Enum.Material.SmoothPlastic, 0, "ball")
		end
	end
	return list
end
-- 땅을 뚫고 솟는다 (흙 조각이 튄다), 잠시 서 있다가 잎을 날리며 가라앉는다
local function riseBamboo(at: Vector3, h: number, d: number, stand: number, lean: Vector3?)
	local g = ground(at)
	local seed = math.random(1, 9)
	local list = bamboo(h, d, seed)
	local tilt = lean or Vector3.zero
	local base = CFrame.new(g) * CFrame.Angles(tilt.X, math.random() * 6, tilt.Z)
	local t0 = os.clock()
	local rise, sink = 0.11, 0.35
	placeAll(list, base * CFrame.new(0, -h, 0))
	local conn: RBXScriptConnection
	conn = RunService.Heartbeat:Connect(function()
		local t = os.clock() - t0
		local y
		if t < rise then
			local k = t / rise
			y = -h * (1 - k) + math.sin(k * math.pi) * 0.6
		elseif t < rise + stand then
			-- 솟은 뒤 살짝 흔들린다
			local k = t - rise
			y = 0
			placeAll(list, base * CFrame.Angles(math.sin(k * 14) * 0.03 * math.exp(-k * 3), 0, math.cos(k * 12) * 0.03 * math.exp(-k * 3)))
			return
		elseif t < rise + stand + sink then
			local k = (t - rise - stand) / sink
			y = -h * k * k
		else
			conn:Disconnect()
			for _, pc in ipairs(list) do
				pc.p:Destroy()
			end
			return
		end
		placeAll(list, base * CFrame.new(0, y, 0))
	end)
	-- 흙 고리와 튀는 흙덩이
	Fx.ring(g + Vector3.new(0, 0.25, 0), EARTH, 1, d * 6, 0.35)
	for _ = 1, 4 do
		local chunk = part(Vector3.new(0.4, 0.3, 0.4) * (0.6 + math.random()), EARTH, Enum.Material.Ground)
		chunk.CFrame = CFrame.new(g + Vector3.new(math.random() - 0.5, 0.3, math.random() - 0.5) * d)
		local out = Vector3.new(math.random() - 0.5, 0, math.random() - 0.5).Unit * (1.5 + math.random() * 2)
		fadeOut(chunk, 0.5, { CFrame = chunk.CFrame + out + Vector3.new(0, 1.5, 0) })
	end
	-- 가라앉을 때 잎이 떨어진다
	task.delay(rise + stand, function()
		for _ = 1, 3 do
			fallingLeaf(g + Vector3.new(math.random() - 0.5, h * 0.85, math.random() - 0.5) * 1.5, math.random() < 0.5 and LEAF or LEAF2, 1.2, h * 0.7, 1.4)
		end
	end)
end

local function bambooLine(data: any)
	local from: Vector3 = data.from
	if not near(from, 220) then
		return
	end
	local dir = flat(data.dir or Vector3.new(0, 0, -1))
	local n = data.n or 7
	local delay, step = data.delay or 0.18, data.step or 0.06
	for i = 1, n do
		task.delay(delay + (i - 1) * step, function()
			local at = from + dir * ((data.start or 4) + (i - 1) * (data.gap or 4.2))
			-- 가운데 줄기 하나와 둘레의 가는 줄기 둘 (대숲처럼), 앞으로 갈수록 크다
			local h = 8 + i * 0.7
			riseBamboo(at, h, 1.0, data.stand or 0.9, Vector3.new(dir.Z, 0, -dir.X) * 0)
			local side = Vector3.new(-dir.Z, 0, dir.X)
			riseBamboo(at + side * 1.3 - dir * 0.4, h * 0.7, 0.7, (data.stand or 0.9) - 0.1, Vector3.new(math.rad(-6), 0, math.rad(8)))
			riseBamboo(at - side * 1.2 + dir * 0.3, h * 0.6, 0.65, (data.stand or 0.9) - 0.15, Vector3.new(math.rad(5), 0, math.rad(-9)))
			if i % 2 == 1 then
				Fx.sound("hit", 0.5, 1.4, at)
			end
			shakeNear(at, 0.15, 50)
		end)
	end
	Fx.sound("heavy", 0.6, 1.3, from)
end
-- 네 번째 일격의 죽순 (상대 발밑에서 하나)
local function bambooShoot(data: any)
	local at: Vector3 = data.at
	if not near(at, 200) then
		return
	end
	task.delay(data.delay or 0.2, function()
		riseBamboo(at, 6, 0.9, 0.45, Vector3.new(math.rad(4), 0, math.rad(-3)))
		riseBamboo(at + Vector3.new(1.2, 0, 0.6), 4, 0.6, 0.35, Vector3.new(math.rad(-6), 0, math.rad(10)))
		Fx.sound("hit", 0.6, 1.5, at)
	end)
end

------------------------------------------------------------------------
-- 천엽비수: 둘레를 감아 도는 푸른 잎, 적에게 줄지어 날아가는 잎
------------------------------------------------------------------------
type Gather = { leaves: { BasePart }, t0: number, root: BasePart, done: boolean }
-- 날아간 잎 (부서진 조각에 속성을 묻지 않도록 표로 기억한다)
local FLY: { [BasePart]: boolean } = setmetatable({}, { __mode = "k" }) :: any
local gathers: { [Instance]: Gather } = {}
local function orbitPos(g: Gather, i: number, n: number): CFrame
	local t = os.clock() - g.t0
	local a = i / n * math.pi * 2 + t * 5
	local r = 3.2 + (i % 3) * 0.7
	local y = -1.2 + ((i * 7) % 5) * 0.8 + math.sin(t * 3 + i) * 0.3
	local pos = g.root.Position + Vector3.new(math.cos(a) * r, y, math.sin(a) * r)
	return CFrame.lookAt(pos, pos + Vector3.new(-math.sin(a), 0.2, math.cos(a)))
end
local function leafGather(data: any)
	local m = data.m
	local r = rootOf(m)
	if not r or not near(r.Position, 220) then
		return
	end
	local old = gathers[m]
	if old then
		old.done = true
	end
	local n = 26
	local g: Gather = { leaves = {}, t0 = os.clock(), root = r, done = false }
	gathers[m] = g
	for i = 1, n do
		local p = part(Vector3.new(0.05, 0.36, 1.0), i % 3 == 0 and LEAF2 or LEAF, Enum.Material.SmoothPlastic, 1, "ball")
		tween(p, 0.2, { Transparency = 0 })
		g.leaves[i] = p
	end
	local conn: RBXScriptConnection
	conn = RunService.Heartbeat:Connect(function()
		if g.done or not r.Parent or os.clock() - g.t0 > 2 then
			conn:Disconnect()
			for _, p in ipairs(g.leaves) do
				if not FLY[p] and p.Parent then
					fadeOut(p, 0.2)
				end
			end
			if gathers[m] == g then
				gathers[m] = nil
			end
			return
		end
		for i, p in ipairs(g.leaves) do
			if not FLY[p] then
				p.CFrame = orbitPos(g, i, n)
			end
		end
	end)
	Fx.ring(ground(r.Position) + Vector3.new(0, 0.3, 0), LEAF2, 2, 12, 0.4)
	Fx.sound("swing", 0.7, 1.1, r.Position)
end
-- 잎 하나가 곡선을 그리며 날아가 꽂힌다
local function flyLeaf(p: BasePart, target: BasePart, travel: number, c2: Color3)
	FLY[p] = true
	local from = p.Position
	local t0 = os.clock()
	local side = Vector3.new(math.random() - 0.5, 0, math.random() - 0.5) * 6 + Vector3.new(0, 3 + math.random() * 2, 0)
	local conn: RBXScriptConnection
	conn = RunService.Heartbeat:Connect(function()
		local k = math.clamp((os.clock() - t0) / travel, 0, 1)
		local to = target.Parent and target.Position or from
		local ctrl = (from + to) / 2 + side
		local a = from:Lerp(ctrl, k)
		local b = ctrl:Lerp(to, k)
		local pos = a:Lerp(b, k)
		local ahead = a:Lerp(b, math.min(1, k + 0.05))
		p.CFrame = CFrame.lookAt(pos, ahead + Vector3.new(0, 1e-3, 0))
		if k >= 1 then
			conn:Disconnect()
			-- 베인 자리: 가는 빛줄기와 잎 부스러기
			local slash = part(Vector3.new(0.12, 0.12, 3.2), c2, Enum.Material.Neon, 0.1)
			slash.CFrame = CFrame.new(to) * CFrame.Angles(math.random() * 6, math.random() * 6, 0)
			fadeOut(slash, 0.18, { Size = Vector3.new(0.02, 0.02, 4.2) })
			fadeOut(p, 0.15)
		end
	end)
end
local function leafVolley(data: any)
	local m = data.m
	local g = gathers[m]
	local _, c2 = Config.STYLE_BY_ID[data.style] and Config.STYLE_BY_ID[data.style].color or WHITE, Config.STYLE_BY_ID[data.style] and Config.STYLE_BY_ID[data.style].color2 or WHITE
	local targets = {}
	for _, tm in ipairs(data.targets or {}) do
		local tr = rootOf(tm)
		if tr then
			table.insert(targets, tr)
		end
	end
	if not g or #targets == 0 then
		return
	end
	local waves = data.waves or 3
	local every = data.every or 0.12
	local travel = data.travel or 0.22
	local idx = 0
	for w = 0, waves - 1 do
		task.delay(w * every, function()
			for _, tr in ipairs(targets) do
				for _ = 1, 2 do
					idx += 1
					local p = g.leaves[((idx - 1) % #g.leaves) + 1]
					if p and not FLY[p] and p.Parent then
						flyLeaf(p, tr, travel, c2)
					else
						-- 모자라면 새 잎을 그 자리에서 띄운다
						local q = part(Vector3.new(0.05, 0.36, 1.0), LEAF2, Enum.Material.SmoothPlastic, 0, "ball")
						q.CFrame = orbitPos(g, idx, 26)
						flyLeaf(q, tr, travel, c2)
					end
				end
			end
			Fx.sound("swing", 0.5, 1.6, g.root.Position)
		end)
	end
end

------------------------------------------------------------------------
-- 신목강림: 천 년 은행나무
-- 뿌리 다섯이 땅을 움켜쥐고, 굵은 줄기가 살짝 비틀리며 솟고, 큰 가지 여섯 끝에 금빛 우듬지가 뭉게뭉게 얹힌다
------------------------------------------------------------------------
local function ginkgo(S: number): ({ Piece }, { Piece })
	local wood: { Piece } = {}
	local crown: { Piece } = {}
	-- 뿌리
	for i = 0, 4 do
		local a = i / 5 * math.pi * 2 + 0.3
		local cf = CFrame.Angles(0, a, 0) * CFrame.new(0, 0.6 * S, -2.4 * S) * CFrame.Angles(math.rad(18), 0, 0)
		addTo(wood, Vector3.new(1.5, 1.3, 4.6) * S, cf, BARK2, Enum.Material.Wood)
		addTo(wood, Vector3.new(0.9, 0.8, 2.6) * S, CFrame.Angles(0, a, 0) * CFrame.new(0, 0.15 * S, -4.8 * S) * CFrame.Angles(math.rad(8), 0, 0), BARK2, Enum.Material.Wood)
	end
	-- 줄기: 아래가 굵고 위로 가늘며 마디마다 조금씩 기울고 비틀린다
	local cf = CFrame.new()
	local n = 6
	local segH = 3.6 * S
	for i = 0, n - 1 do
		local r = (2.5 - i * 0.2) * S
		addTo(wood, Vector3.new(segH * 1.08, r * 2, r * 2), cf * CFrame.new(0, segH / 2, 0) * UP, i % 2 == 0 and BARK or BARK:Lerp(BARK2, 0.4), Enum.Material.Wood, 0, "cyl")
		-- 껍질의 세로 골
		if i < 4 then
			for j = 0, 3 do
				local a = j / 4 * math.pi * 2 + i
				addTo(wood, Vector3.new(0.35 * S, segH * 0.9, 0.35 * S), cf * CFrame.new(math.cos(a) * r * 0.95, segH / 2, math.sin(a) * r * 0.95), BARK2, Enum.Material.Wood)
			end
		end
		cf = cf * CFrame.new(0, segH, 0) * CFrame.Angles(math.rad(i % 2 == 0 and 3 or -2), math.rad(14), math.rad(i % 2 == 0 and -2 or 3))
	end
	local topCf = cf
	-- 큰 가지 여섯: 줄기 윗부분에서 바깥 위로 뻗고, 끝에 우듬지 덩이
	local tips: { CFrame } = {}
	for b = 0, 5 do
		local hRatio = 0.55 + (b % 3) * 0.15
		local start = CFrame.new(0, n * segH * hRatio, 0) * CFrame.Angles(0, b / 6 * math.pi * 2 + 0.4, 0) * CFrame.Angles(math.rad(-60 + (b % 2) * 10), 0, 0)
		local bc = start
		for s = 0, 2 do
			local w = (1.1 - s * 0.3) * S
			local L = (4.4 - s * 0.7) * S
			addTo(wood, Vector3.new(w, L * 1.15, w), bc * CFrame.new(0, L / 2, 0), BARK, Enum.Material.Wood)
			bc = bc * CFrame.new(0, L, 0) * CFrame.Angles(math.rad(12), 0, 0)
		end
		table.insert(tips, bc)
	end
	table.insert(tips, topCf * CFrame.new(0, 2 * S, 0))
	-- 우듬지: 가지 끝마다 큰 덩이 하나와 작은 덩이 둘, 가운데 위에 큰 덩이 (풀결 재질, 금빛 셋을 섞어)
	local golds = { GOLD, GOLD2, GOLD3 }
	for i, tcf in ipairs(tips) do
		local p0 = tcf.Position
		local big = (i == #tips and 11 or 8.5) * S
		addTo(crown, Vector3.new(big, big * 0.78, big), CFrame.new(p0), golds[(i % 3) + 1], Enum.Material.Grass, 0, "ball")
		for j = 0, 1 do
			local a = i * 1.3 + j * 2.4
			local off = Vector3.new(math.cos(a), 0.3 - j * 0.5, math.sin(a)) * big * 0.42
			addTo(crown, Vector3.new(big, big * 0.8, big) * 0.62, CFrame.new(p0 + off), golds[((i + j) % 3) + 1], Enum.Material.Grass, 0, "ball")
		end
	end
	return wood, crown
end

local function treeRise(data: any)
	local at: Vector3 = data.at
	if not near(at, 320) then
		return
	end
	local g = ground(at)
	local center: Vector3 = data.center or at
	local rise, dur = data.rise or 0.8, data.dur or 2.4
	local R = data.radius or 24
	local S = 1.25
	local wood, crown = ginkgo(S)
	local dir = flat(data.dir or Vector3.new(0, 0, -1))
	local base = CFrame.lookAt(g, g + dir)
	local light = Instance.new("PointLight")
	light.Color = GOLD2
	light.Range = 40
	light.Brightness = 0
	light.Shadows = false
	light.Parent = crown[#crown].p
	tween(light, rise, { Brightness = 2 })
	local t0 = os.clock()
	local state = { done = false }
	;(Forest :: any)._trees = (Forest :: any)._trees or {}
	;(Forest :: any)._trees[data.id or 0] = { wood = wood, crown = crown, base = base, state = state, light = light }
	local conn: RBXScriptConnection
	conn = RunService.Heartbeat:Connect(function()
		local t = os.clock() - t0
		if state.done or t > rise + dur + 3 then
			conn:Disconnect()
			return
		end
		-- 자란다: 줄기가 먼저, 우듬지는 조금 늦게 부풀어 오른다
		local k = math.clamp(t / rise, 0, 1)
		local gw = 1 - (1 - k) ^ 3
		local kc = math.clamp((t - rise * 0.35) / (rise * 0.75), 0, 1)
		local gc = kc < 1 and (1 - (1 - kc) ^ 2) * (1 + math.sin(kc * math.pi) * 0.12) or 1
		local sway = CFrame.Angles(math.sin(t * 0.9) * 0.012, 0, math.cos(t * 0.7) * 0.012)
		placeAll(wood, base * sway, math.max(0.05, gw))
		placeAll(crown, base * sway, math.max(0.02, gc * gw))
	end)
	-- 땅이 들썩이며 갈라지는 고리, 흙과 잎
	Fx.ring(g + Vector3.new(0, 0.3, 0), EARTH, 4, 26, 0.6)
	Fx.ring(g + Vector3.new(0, 0.35, 0), GOLD, 4, 34, 0.8)
	shakeNear(at, 1.0, 120)
	Fx.sound("heavy", 1, 0.5, at)
	-- 금빛 잎 비: 우듬지 아래에서 둘레 R칸으로 쏟아진다
	task.delay(rise * 0.7, function()
		local endT = os.clock() + dur
		task.spawn(function()
			while os.clock() < endT and not state.done do
				for _ = 1, 3 do
					local a, rr = math.random() * math.pi * 2, math.sqrt(math.random()) * R
					local p = center + Vector3.new(math.cos(a) * rr, 14 + math.random() * 10, math.sin(a) * rr)
					fallingLeaf(p, ({ GOLD, GOLD2, GOLD3 })[math.random(1, 3)], 1.1 + math.random() * 0.5, 16, 1.6)
				end
				task.wait(0.06)
			end
		end)
		-- 땅에 내려앉는 금빛 (둘레를 덮는 옅은 원)
		local carpet = part(Vector3.new(0.2, 2, 2), GOLD, Enum.Material.Grass, 0.55, "cyl")
		carpet.CFrame = CFrame.new(ground(center) + Vector3.new(0, 0.12, 0)) * UP
		tween(carpet, dur * 0.6, { Size = Vector3.new(0.2, R * 2, R * 2), Transparency = 0.35 })
		task.delay(dur + 1.2, function()
			fadeOut(carpet, 0.8)
		end)
	end)
end
local function treeBurst(data: any)
	local at: Vector3 = data.at
	local trees = (Forest :: any)._trees or {}
	local tr = trees[data.id or 0]
	local center: Vector3 = data.center or at
	local R = data.radius or 28
	if tr then
		trees[data.id or 0] = nil
		-- 우듬지가 환해졌다가 잎으로 흩어진다. 줄기는 천천히 땅으로 돌아간다
		for _, pc in ipairs(tr.crown) do
			tween(pc.p, 0.18, { Color = GOLD2:Lerp(WHITE, 0.4) })
		end
		tween(tr.light, 0.18, { Brightness = 6, Range = 60 })
		task.delay(0.2, function()
			for _, pc in ipairs(tr.crown) do
				local p0 = pc.p.Position
				for _ = 1, 4 do
					local q = leaf(1.3, ({ GOLD, GOLD2, GOLD3 })[math.random(1, 3)])
					q.CFrame = CFrame.new(p0 + Vector3.new(math.random() - 0.5, math.random() - 0.5, math.random() - 0.5) * pc.p.Size.X * 0.6)
					local out = (Vector3.new(p0.X - center.X, 0, p0.Z - center.Z).Unit + Vector3.new(math.random() - 0.5, -0.3 - math.random() * 0.4, math.random() - 0.5)) * (R * (0.6 + math.random() * 0.6))
					fadeOut(q, 0.9 + math.random() * 0.4, { CFrame = q.CFrame + out, Orientation = Vector3.new(math.random() * 360, math.random() * 360, 0) })
				end
				fadeOut(pc.p, 0.35, { Size = pc.p.Size * 1.15 })
			end
			tr.state.done = true
			local t0 = os.clock()
			local conn: RBXScriptConnection
			conn = RunService.Heartbeat:Connect(function()
				local k = (os.clock() - t0) / 1.0
				if k >= 1 then
					conn:Disconnect()
					for _, pc in ipairs(tr.wood) do
						if pc.p.Parent then
							pc.p:Destroy()
						end
					end
					return
				end
				placeAll(tr.wood, tr.base * CFrame.new(0, -18 * k * k, 0))
				for _, pc in ipairs(tr.wood) do
					pc.p.Transparency = k
				end
			end)
		end)
	end
	if not near(center, 300) then
		return
	end
	local g = ground(center)
	Fx.ring(g + Vector3.new(0, 0.3, 0), GOLD2, 4, R * 2.4, 0.6)
	task.delay(0.1, function()
		Fx.ring(g + Vector3.new(0, 0.35, 0), LEAF2, 4, R * 2.0, 0.6)
	end)
	-- 사방으로 휘몰아치는 잎 바람
	for i = 0, 23 do
		local a = i / 24 * math.pi * 2
		local q = leaf(1.4, i % 2 == 0 and GOLD or GOLD2)
		local p0 = g + Vector3.new(math.cos(a) * 2, 1.5 + (i % 3), math.sin(a) * 2)
		q.CFrame = CFrame.lookAt(p0, p0 + Vector3.new(math.cos(a), 0, math.sin(a)))
		fadeOut(q, 0.7, { CFrame = CFrame.lookAt(p0 + Vector3.new(math.cos(a), 0.1, math.sin(a)) * R, p0 + Vector3.new(math.cos(a), 0, math.sin(a)) * (R + 1)) })
	end
	Fx.flash(center, GOLD2, 90, 6, 0.6)
	Fx.breakSound("wood", 0.8, 0.9, center)
	shakeNear(center, 1.8, 140)
end

local HANDLERS: { [string]: (any) -> () } = {
	bambooLine = bambooLine,
	bambooShoot = bambooShoot,
	leafGather = leafGather,
	leafVolley = leafVolley,
	treeRise = treeRise,
	treeBurst = treeBurst,
}
function Forest.handles(data: any): boolean
	return HANDLERS[data.kind] ~= nil
end
function Forest.run(data: any)
	local fn = HANDLERS[data.kind]
	if fn then
		fn(data)
	end
end
-- 렌더 확인용 (테스트에서만)
Forest._bamboo = bamboo
Forest._ginkgo = ginkgo
Forest._place = placeAll

return Forest
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="28">
          <Properties>
            <string name="Name">Fx</string>
            <string name="Source"><![CDATA[-- 권왕: 타격감 (불꽃, 충격파, 잔상, 숫자, 권법마다 다른 빛)
local Debris = game:GetService("Debris")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local SoundService = game:GetService("SoundService")
local TweenService = game:GetService("TweenService")

local Config = require(ReplicatedStorage:WaitForChild("Config"))
local Poses = require(ReplicatedStorage:WaitForChild("Poses"))

local Fx = {}

local folder = Instance.new("Folder")
folder.Name = "KwonFx"
folder.Parent = workspace

------------------------------------------------------------------------
-- 소리 (로블록스에 들어 있는 기본 소리. 더 좋은 소리 번호가 있으면 여기만 바꾸면 된다)
------------------------------------------------------------------------
local SOUNDS = {
	swing = "rbxasset://sounds/swordlunge.wav",
	hit = "rbxasset://sounds/action_jump_land.mp3",
	heavy = "rbxasset://sounds/action_jump_land.mp3",
	block = "rbxasset://sounds/swordslash.wav",
	deflect = "rbxasset://sounds/unsheath.wav",
	ping = "rbxasset://sounds/electronicpingshort.wav",
	fall = "rbxasset://sounds/action_falling.mp3",
	jump = "rbxasset://sounds/action_jump.mp3",
	splash = "rbxasset://sounds/impact_water.mp3",
	shatter = "rbxasset://sounds/glassbreak.wav",
}

function Fx.sound(name: string, volume: number?, pitch: number?, at: Vector3?)
	local id = SOUNDS[name]
	if not id then
		return
	end
	local s = Instance.new("Sound")
	s.SoundId = id
	s.Volume = volume or 0.5
	s.PlaybackSpeed = pitch or 1
	if at then
		local a = Instance.new("Part")
		a.Anchored = true
		a.CanCollide = false
		a.CanQuery = false
		a.Transparency = 1
		a.Size = Vector3.new(0.2, 0.2, 0.2)
		a.Position = at
		a.Parent = folder
		s.RollOffMaxDistance = 160
		s.Parent = a
		Debris:AddItem(a, 3)
	else
		s.Parent = SoundService
		Debris:AddItem(s, 3)
	end
	s:Play()
end

-- 2.8.1판: 부서지고 터지는 소리를 재질마다 다르게 (예전엔 나무가 부서져도 유리 깨지는 소리였다)
--   glass 유리·얼음·병·결정   wood 나무가 쪼개진다   rock 바위·땅이 무너진다
--   boom 벼락·북·기운이 터진다   whoosh 꽃잎·부채·먹이 흩날린다   slash 칼날이 가른다
local BREAK: { [string]: { { any } } } = {
	glass = { { "shatter", 1, 1 } },
	wood = { { "heavy", 1, 0.55 }, { "block", 0.7, 0.45 } },
	rock = { { "heavy", 1.2, 0.42 }, { "fall", 0.5, 0.6 } },
	boom = { { "heavy", 1.3, 0.35 }, { "swing", 0.6, 0.4 } },
	whoosh = { { "swing", 0.9, 0.75 } },
	slash = { { "block", 1, 0.85 }, { "swing", 0.6, 0.6 } },
}
function Fx.breakSound(kind: string, volume: number?, pitch: number?, at: Vector3?)
	for _, it in ipairs(BREAK[kind] or BREAK.boom) do
		Fx.sound(it[1], (volume or 0.8) * it[2], (pitch or 1) * it[3], at)
	end
end

------------------------------------------------------------------------
-- 기본 조각
------------------------------------------------------------------------
local TEX_FIRE_AURA = "rbxasset://textures/particles/fire_main.dds"
local TEX_SPARK_AURA = "rbxasset://textures/particles/sparkles_main.dds"
local function piece(size: Vector3, color: Color3, material: Enum.Material?, shape: Enum.PartType?, transparency: number?): Part
	local p = Instance.new("Part")
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	p.Size = size
	p.Color = color
	p.Material = material or Enum.Material.Neon
	if shape then
		p.Shape = shape
	end
	p.Transparency = transparency or 0
	p.Parent = folder
	return p
end

-- 두 점이 같으면 방향을 정할 수 없어서 (NaN) 그냥 그 자리에 둔다
local function lookAt(from: Vector3, to: Vector3): CFrame
	if (to - from).Magnitude < 1e-3 then
		return CFrame.new(from)
	end
	return CFrame.lookAt(from, to)
end

local function tween(inst: Instance, time: number, goal: { [string]: any }, style: Enum.EasingStyle?, dir: Enum.EasingDirection?)
	local tw = TweenService:Create(inst, TweenInfo.new(time, style or Enum.EasingStyle.Quad, dir or Enum.EasingDirection.Out), goal)
	tw:Play()
	return tw
end

-- 터지는 빛 조각
function Fx.spark(pos: Vector3, color: Color3, size: number, count: number)
	-- 불티 입자와 맞은 자리의 빛
	Fx.burst("spark", pos, color, count * 1.4, math.clamp(size / 1.3, 0.6, 2))
	Fx.flash(pos, color, 8 + size * 4, 1.6 + size * 0.6, 0.18)
	local flash = piece(Vector3.new(1, 1, 1) * size, Color3.new(1, 1, 1), Enum.Material.Neon, Enum.PartType.Ball, 0)
	flash.Position = pos
	tween(flash, 0.12, { Size = Vector3.new(1, 1, 1) * size * 2.4, Transparency = 1 })
	Debris:AddItem(flash, 0.15)
	for _ = 1, count do
		local dir = Vector3.new(math.random() - 0.5, math.random() * 0.8 - 0.2, math.random() - 0.5)
		if dir.Magnitude < 0.05 then
			dir = Vector3.new(0, 1, 0)
		end
		dir = dir.Unit
		local len = size * (0.6 + math.random() * 0.8)
		local shard = piece(Vector3.new(0.15 * size, 0.15 * size, len), color, Enum.Material.Neon)
		shard.CFrame = CFrame.lookAt(pos, pos + dir)
		local to = pos + dir * size * (2 + math.random() * 2.5)
		tween(shard, 0.22, { CFrame = CFrame.lookAt(to, to + dir), Size = Vector3.new(0.05, 0.05, len * 0.3), Transparency = 1 })
		Debris:AddItem(shard, 0.25)
	end
end

-- 바닥에 퍼지는 충격파 고리 (faceDir를 주면 그 방향을 보고 선다)
-- 속이 빈 빛의 테 (조각을 둥글게 이어 붙인다) + 안쪽의 옅은 빛
function Fx.ring(pos: Vector3, color: Color3, fromD: number, toD: number, life: number, faceDir: Vector3?)
	local cf = faceDir and lookAt(pos, pos + faceDir) or CFrame.lookAt(pos, pos + Vector3.new(0, 1, 0), Vector3.new(0, 0, -1))
	-- 바닥의 큰 충격파: 흙먼지가 고리를 따라 퍼지고, 아주 크면 돌 조각이 튄다
	if not faceDir and toD >= 24 and toD > fromD then
		Fx.burst("dust", pos + Vector3.new(0, 0.5, 0), Color3.fromRGB(175, 160, 140), math.min(30, toD / 2.5), math.clamp(toD / 28, 0.8, 2.2))
		Fx.flash(pos + Vector3.new(0, 2, 0), color, toD * 0.6, 2.5, life)
		if toD >= 40 then
			Fx.debris(pos, math.min(10, math.floor(toD / 8)), math.min(26, toD * 0.35))
		end
	end
	local glow = piece(Vector3.new(0.1, fromD, fromD), color, Enum.Material.Neon, Enum.PartType.Cylinder, 0.7)
	glow.CFrame = cf * CFrame.Angles(0, math.rad(90), 0)
	tween(glow, life, { Size = Vector3.new(0.05, toD, toD), Transparency = 1 })
	Debris:AddItem(glow, life + 0.05)
	-- 작은 고리 (평타 맞힘 등)는 매끈한 빛 원반 하나 (조각을 이으면 네모가 보인다)
	if toD < 24 then
		glow.Transparency = 0.2
		return
	end
	local n = math.clamp(math.floor(toD / 1.6), 16, 40)
	local thick = math.clamp(toD * 0.02, 0.4, 1.2)
	for i = 0, n - 1 do
		local a = i / n * math.pi * 2
		local dir = cf.RightVector * math.cos(a) + cf.UpVector * math.sin(a)
		local tangent = cf.RightVector * -math.sin(a) + cf.UpVector * math.cos(a)
		local function seg(d: number): CFrame
			local at = pos + dir * (d / 2)
			return CFrame.lookAt(at, at + tangent, cf.LookVector)
		end
		local p = piece(Vector3.new(thick, thick * 0.4, math.max(0.2, math.pi * fromD / n * 1.15)), color, Enum.Material.Neon, nil, 0.05)
		p.CFrame = seg(fromD)
		tween(p, life, { CFrame = seg(toD), Size = Vector3.new(thick * 0.3, thick * 0.15, math.pi * toD / n * 1.15), Transparency = 1 })
		Debris:AddItem(p, life + 0.05)
	end
end

-- 떠오르는 글자 (피해 숫자, '흘리기!' 같은 말)
function Fx.text(pos: Vector3, text: string, color: Color3, size: number, rise: number?)
	local anchor = piece(Vector3.new(0.2, 0.2, 0.2), color, Enum.Material.Neon, nil, 1)
	anchor.Position = pos
	local bb = Instance.new("BillboardGui")
	bb.Size = UDim2.new(0, 300, 0, 70)
	bb.AlwaysOnTop = true
	bb.LightInfluence = 0
	bb.MaxDistance = 300
	bb.Parent = anchor
	local l = Instance.new("TextLabel")
	l.Size = UDim2.fromScale(1, 1)
	l.BackgroundTransparency = 1
	l.Font = Enum.Font.GothamBlack
	l.TextSize = size
	l.TextColor3 = color
	l.TextStrokeTransparency = 1
	l.Text = text
	l.Parent = bb
	-- 글자: 위는 밝고 아래로 진해지는 빛깔, 굵은 검은 테
	local grad = Instance.new("UIGradient")
	grad.Rotation = 90
	grad.Color = ColorSequence.new(color:Lerp(Color3.new(1, 1, 1), 0.55), color)
	grad.Parent = l
	local st = Instance.new("UIStroke")
	st.Color = Color3.fromRGB(18, 8, 8)
	st.Thickness = math.clamp(size / 12, 1.5, 4)
	st.Parent = l
	local sc = Instance.new("UIScale")
	sc.Scale = 1.8
	sc.Parent = l
	tween(sc, 0.14, { Scale = 1 }, Enum.EasingStyle.Back)
	tween(anchor, 0.8, { Position = pos + Vector3.new(math.random() * 2 - 1, rise or 3.5, 0) })
	task.delay(0.45, function()
		tween(l, 0.35, { TextTransparency = 1 })
		tween(st, 0.35, { Transparency = 1 })
	end)
	Debris:AddItem(anchor, 0.85)
end

-- 흙먼지
function Fx.dust(pos: Vector3, size: number)
	Fx.burst("dust", pos, Color3.fromRGB(185, 168, 140), 6 + size * 2, math.clamp(size / 2, 0.6, 2))
	for _ = 1, 3 do
		local p = piece(Vector3.new(1, 1, 1) * size * (0.6 + math.random() * 0.6), Color3.fromRGB(190, 170, 140), Enum.Material.SmoothPlastic, Enum.PartType.Ball, 0.4)
		p.Position = pos + Vector3.new(math.random() * 2 - 1, 0, math.random() * 2 - 1) * size
		tween(p, 0.6, { Size = p.Size * 2.2, Position = p.Position + Vector3.new(0, size, 0), Transparency = 1 })
		Debris:AddItem(p, 0.65)
	end
end

-- 번개 (지그재그 빛줄기)
function Fx.lightning(from: Vector3, to: Vector3, color: Color3?, width: number?)
	local col = color or Color3.fromRGB(255, 245, 140)
	local w = width or 0.35
	local n = 7
	local prev = from
	for i = 1, n do
		local k = i / n
		local p = from:Lerp(to, k)
		if i < n then
			p += Vector3.new(math.random() - 0.5, math.random() - 0.5, math.random() - 0.5) * (to - from).Magnitude * 0.12
		end
		local len = (p - prev).Magnitude
		if len > 0.05 then
			local seg = piece(Vector3.new(w, w, len), col, Enum.Material.Neon)
			seg.CFrame = lookAt((prev + p) / 2, p)
			tween(seg, 0.25, { Transparency = 1, Size = Vector3.new(w * 0.2, w * 0.2, len) })
			Debris:AddItem(seg, 0.3)
			-- 번개 둘레의 흐린 빛무리
			local halo = piece(Vector3.new(w * 4, w * 4, len), col, Enum.Material.Neon, nil, 0.8)
			halo.CFrame = seg.CFrame
			tween(halo, 0.2, { Transparency = 1 })
			Debris:AddItem(halo, 0.22)
		end
		prev = p
	end
	-- 떨어진 자리: 불티와 번쩍임
	Fx.burst("spark", to, col, 8, 1)
	Fx.flash(to, col, 18, 4, 0.2)
end

-- 잔상: 몸을 반투명한 그림자로 남긴다
function Fx.afterimage(model: Model, color: Color3, life: number?)
	for _, d in ipairs(model:GetChildren()) do
		if d:IsA("BasePart") and d.Name ~= "HumanoidRootPart" and d.Transparency < 0.9 then
			local p = piece(d.Size, color, Enum.Material.Neon, nil, 0.45)
			p.CFrame = d.CFrame
			tween(p, life or 0.35, { Transparency = 1 })
			Debris:AddItem(p, (life or 0.35) + 0.05)
		end
	end
end

------------------------------------------------------------------------
-- 손발 잔상 (기술 쓰는 동안)
------------------------------------------------------------------------
local function trailOn(part: BasePart, color: Color3, color2: Color3, life: number)
	local a0 = Instance.new("Attachment")
	a0.Position = Vector3.new(0, 0.7, 0)
	a0.Parent = part
	local a1 = Instance.new("Attachment")
	a1.Position = Vector3.new(0, -0.8, 0)
	a1.Parent = part
	local tr = Instance.new("Trail")
	tr.Attachment0 = a0
	tr.Attachment1 = a1
	tr.Lifetime = 0.28
	tr.LightEmission = 1
	tr.FaceCamera = true
	tr.Color = ColorSequence.new(color2, color)
	tr.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(0.6, 0.35), NumberSequenceKeypoint.new(1, 1) })
	tr.WidthScale = NumberSequence.new(1.6, 0.1)
	tr.Lifetime = 0.34
	tr.Parent = part
	-- 안쪽의 흰 심 (얇고 짧다): 꼬리가 빛을 품은 듯 보인다
	local core = Instance.new("Trail")
	core.Attachment0 = a0
	core.Attachment1 = a1
	core.Lifetime = 0.16
	core.LightEmission = 1
	core.FaceCamera = true
	core.Color = ColorSequence.new(Color3.new(1, 1, 1), color2)
	core.Transparency = NumberSequence.new(0, 1)
	core.WidthScale = NumberSequence.new(0.45, 0)
	core.Parent = part
	task.delay(life, function()
		tr.Enabled = false
		core.Enabled = false
		Debris:AddItem(core, 0.3)
		Debris:AddItem(tr, 0.4)
		Debris:AddItem(a0, 0.3)
		Debris:AddItem(a1, 0.3)
	end)
end

function Fx.limbTrails(model: Model, pose: string, dur: number, color: Color3, color2: Color3)
	-- 무기를 든 적은 무기 날에, 맨손이면 휘두르는 손발에
	local hasWeapon = false
	for _, w in ipairs(model:GetChildren()) do
		if w.Name == "Weapon" then
			local blade = w:FindFirstChild("Blade")
			if blade and blade:IsA("BasePart") then
				trailOn(blade, color, color2, dur)
				hasWeapon = true
			end
		end
	end
	if hasWeapon then
		return
	end
	for _, name in ipairs(Poses.limbs[pose] or {}) do
		local part = model:FindFirstChild(name)
		if part and part:IsA("BasePart") then
			trailOn(part, color, color2, dur)
		end
	end
end

------------------------------------------------------------------------
-- 권법마다 다른 빛 (맞힌 자리에)
------------------------------------------------------------------------
local function styleOf(id: any): any
	return type(id) == "string" and Config.STYLE_BY_ID[id] or nil
end

local HIT_SCALE = 1.45
function Fx.styleHit(styleId: any, pos: Vector3, heavy: boolean, dir: Vector3?)
	local style = styleOf(styleId)
	if not style then
		Fx.spark(pos, Color3.fromRGB(255, 230, 200), heavy and 2 or 1.2, heavy and 10 or 6)
		return
	end
	-- 맞는 순간의 연출은 모두 한 치수 크게 (HIT_SCALE)
	local s = (heavy and 1.6 or 1) * HIT_SCALE
	local c, c2 = style.color, style.color2
	Fx.spark(pos, c, 1.3 * s, heavy and 12 or 7)
	-- 각성 권법 (진): 맞을 때마다 둘째 빛깔의 큰 고리와 빛 가루가 한 겹 더
	if style.awakenOf then
		Fx.ring(pos, c2, 1, 15 * s, 0.4, dir)
		Fx.burst("glitter", pos, c2, heavy and 14 or 8, 1.2)
	end
	-- 강타는 땅까지 울린다 (흙먼지·돌 조각)
	if heavy then
		Fx.impact(pos, c, 1)
	end
	if style.fx == "water" then
		-- 물방울과 물결
		Fx.ring(pos, c2, 1, 9 * s, 0.35, dir)
		for _ = 1, 6 do
			local drop = piece(Vector3.new(0.5, 0.5, 0.5), c2, Enum.Material.Glass, Enum.PartType.Ball, 0.2)
			drop.Position = pos
			local to = pos + Vector3.new(math.random() * 6 - 3, math.random() * 4, math.random() * 6 - 3) * s
			tween(drop, 0.4, { Position = to, Transparency = 1 })
			Debris:AddItem(drop, 0.45)
		end
	elseif style.fx == "gold" then
		-- 금빛 범종 소리 같은 둥근 빛
		local bell = piece(Vector3.new(1, 1, 1) * 3 * s, c, Enum.Material.Neon, Enum.PartType.Ball, 0.3)
		bell.Position = pos
		tween(bell, 0.3, { Size = Vector3.new(1, 1, 1) * 9 * s, Transparency = 1 })
		Debris:AddItem(bell, 0.35)
		Fx.ring(pos, c, 2, 14 * s, 0.4, dir)
	elseif style.fx == "petal" then
		for _ = 1, heavy and 14 or 8 do
			local petal = piece(Vector3.new(0.7, 0.08, 0.5), math.random() < 0.5 and c or c2, Enum.Material.SmoothPlastic)
			petal.CFrame = CFrame.new(pos) * CFrame.Angles(math.random() * 6, math.random() * 6, math.random() * 6)
			local to = pos + Vector3.new(math.random() * 10 - 5, math.random() * 5 - 1, math.random() * 10 - 5) * s
			tween(petal, 0.9, { CFrame = CFrame.new(to) * CFrame.Angles(math.random() * 6, math.random() * 6, math.random() * 6), Transparency = 1 })
			Debris:AddItem(petal, 0.95)
		end
	elseif style.fx == "nature" then
		-- 2.4판 만목신권: 잎이 흩날리고 작은 새싹 고리
		for _ = 1, heavy and 12 or 7 do
			local leaf = piece(Vector3.new(0.05, 0.34, 0.9), math.random() < 0.6 and c or c2, Enum.Material.SmoothPlastic, Enum.PartType.Ball)
			leaf.CFrame = CFrame.new(pos) * CFrame.Angles(math.random() * 6, math.random() * 6, math.random() * 6)
			local to = pos + Vector3.new(math.random() * 9 - 4.5, math.random() * 4, math.random() * 9 - 4.5) * s
			tween(leaf, 0.8, { CFrame = CFrame.new(to) * CFrame.Angles(math.random() * 6, math.random() * 6, math.random() * 6), Transparency = 1 })
			Debris:AddItem(leaf, 0.85)
		end
		Fx.ring(pos, c2, 1, 8 * s, 0.3, dir)
	elseif style.fx == "dragon" then
		Fx.ring(pos, c, 1, 10 * s, 0.35, dir)
		Fx.ring(pos, c2, 1, 6 * s, 0.25, dir)
	elseif style.fx == "shadow" then
		for _ = 1, 6 do
			local smoke = piece(Vector3.new(1, 1, 1) * (1.5 + math.random()) * s, Color3.fromRGB(30, 15, 50), Enum.Material.SmoothPlastic, Enum.PartType.Ball, 0.3)
			smoke.Position = pos + Vector3.new(math.random() * 2 - 1, math.random() * 2 - 1, math.random() * 2 - 1)
			tween(smoke, 0.5, { Size = smoke.Size * 2.5, Transparency = 1 })
			Debris:AddItem(smoke, 0.55)
		end
		Fx.ring(pos, c, 1, 8 * s, 0.3, dir)
	elseif style.fx == "lightning" then
		for _ = 1, heavy and 4 or 2 do
			local off = Vector3.new(math.random() * 8 - 4, math.random() * 6, math.random() * 8 - 4) * s
			Fx.lightning(pos, pos + off, c, 0.3)
		end
	elseif style.fx == "basic" then
		Fx.ring(pos, c2, 1, 7 * s, 0.25, dir)
	elseif style.fx == "void" then
		-- 무극: 맞은 자리가 한 점으로 꺼졌다 터진다
		local hole = piece(Vector3.new(3, 3, 3) * s, Color3.new(0, 0, 0), Enum.Material.SmoothPlastic, Enum.PartType.Ball, 0.1)
		hole.Position = pos
		tween(hole, 0.15, { Size = Vector3.new(0.2, 0.2, 0.2) })
		Debris:AddItem(hole, 0.16)
		task.delay(0.15, function()
			Fx.ring(pos, c2, 0.5, 14 * s, 0.35, dir)
			Fx.ring(pos, c, 0.5, 9 * s, 0.3)
		end)
	elseif style.fx == "blood" then
		-- 혈마: 핏빛 방울이 튀고 붉은 고리
		Fx.ring(pos, c, 1, 9 * s, 0.3, dir)
		for _ = 1, heavy and 10 or 6 do
			local drop = piece(Vector3.new(0.4, 0.4, 0.4), c, Enum.Material.Neon, Enum.PartType.Ball, 0.1)
			drop.Position = pos
			tween(drop, 0.45, { Position = pos + Vector3.new(math.random() * 6 - 3, math.random() * 3 - 2, math.random() * 6 - 3) * s, Transparency = 1 })
			Debris:AddItem(drop, 0.5)
		end
	elseif style.fx == "celestial" then
		-- 천제: 금빛 십자가 번쩍
		for _, rot in ipairs({ 0, 90 }) do
			local bar = piece(Vector3.new(0.4, 6 * s, 0.4), Color3.fromRGB(255, 250, 225), Enum.Material.Neon, nil, 0)
			bar.CFrame = CFrame.new(pos) * CFrame.Angles(0, 0, math.rad(rot + 45))
			tween(bar, 0.25, { Size = Vector3.new(0.05, 9 * s, 0.05), Transparency = 1 })
			Debris:AddItem(bar, 0.3)
		end
		Fx.ring(pos, c, 1, 9 * s, 0.3, dir)
	elseif style.fx == "gravity" then
		-- 파천: 맞은 자리가 아래로 짓눌린다 (보랏빛 고리가 안으로 조이고 바닥이 꺼진다)
		local dent = piece(Vector3.new(2.5, 2.5, 2.5) * s, Color3.fromRGB(10, 0, 20), Enum.Material.SmoothPlastic, Enum.PartType.Ball, 0.2)
		dent.Position = pos
		tween(dent, 0.14, { Size = Vector3.new(0.3, 0.3, 0.3) })
		Debris:AddItem(dent, 0.15)
		Fx.ring(pos, c, 10 * s, 1, 0.18, dir)
		task.delay(0.12, function()
			Fx.ring(pos - Vector3.new(0, 2, 0), c2, 1, 10 * s, 0.3)
		end)
	elseif style.fx == "origin" then
		-- 태초: 맑은 빛의 결정이 맞은 자리에서 여섯 갈래로 갈라진다
		local face = lookAt(pos, pos + (dir or Vector3.new(0, 0, -1)))
		for k = 0, 5 do
			local a = k / 6 * math.pi * 2
			local bar = piece(Vector3.new(0.3, 0.3, 0.3), k % 2 == 0 and Color3.fromRGB(255, 252, 240) or c2, Enum.Material.Neon, nil, 0)
			bar.CFrame = lookAt(pos, pos + face:VectorToWorldSpace(Vector3.new(math.cos(a), math.sin(a), 0)))
			tween(bar, 0.22, { Size = Vector3.new(0.08, 0.08, 6 * s), Transparency = 1, CFrame = bar.CFrame * CFrame.new(0, 0, -3 * s) })
			Debris:AddItem(bar, 0.25)
		end
		Fx.ring(pos, c2, 1, 9 * s, 0.28, dir)
	elseif style.fx == "time" then
		-- 영겁: 맞은 자리에 시계판이 번쩍 (열두 눈금과 바늘), 푸른 빛 조각이 멈춘 듯 떠 있다가 흩어진다
		local face = lookAt(pos, pos + (dir or Vector3.new(0, 0, -1)))
		for k = 0, 11 do
			local a = k / 12 * math.pi * 2
			local tick = piece(Vector3.new(0.18, k % 3 == 0 and 1.1 or 0.6, 0.18) * s, k % 3 == 0 and c2 or c, Enum.Material.Neon, nil, 0.05)
			tick.CFrame = face * CFrame.new(math.cos(a) * 3 * s, math.sin(a) * 3 * s, 0) * CFrame.Angles(0, 0, a - math.pi / 2)
			tween(tick, 0.35, { Transparency = 1 })
			Debris:AddItem(tick, 0.4)
		end
		local hand = piece(Vector3.new(0.25, 2.6 * s, 0.25), c2, Enum.Material.Neon, nil, 0)
		hand.CFrame = face * CFrame.new(0, 1.3 * s, 0)
		tween(hand, 0.3, { CFrame = face * CFrame.Angles(0, 0, math.rad(-300)) * CFrame.new(0, 1.3 * s, 0), Transparency = 1 })
		Debris:AddItem(hand, 0.35)
		for _ = 1, heavy and 8 or 5 do
			local shard = piece(Vector3.new(0.4, 0.4, 0.4) * s, c, Enum.Material.Glass, nil, 0.2)
			shard.CFrame = CFrame.new(pos + Vector3.new(math.random() - 0.5, math.random() - 0.5, math.random() - 0.5) * 3 * s) * CFrame.Angles(math.random() * 6, math.random() * 6, 0)
			task.delay(0.25, function()
				if shard.Parent then
					tween(shard, 0.25, { Position = shard.Position + Vector3.new(math.random() - 0.5, math.random(), math.random() - 0.5) * 5 * s, Transparency = 1 })
				end
			end)
			Debris:AddItem(shard, 0.55)
		end
		Fx.ring(pos, c, 1, 11 * s, 0.35, dir)
	elseif style.fx == "cloud" then
		-- 운류: 맞은 자리에서 흰 구름이 뭉게뭉게 피었다 흩어진다
		for _ = 1, heavy and 7 or 4 do
			local size = (1.2 + math.random() * 1.4) * s
			local puff = piece(Vector3.new(size, size, size), Color3.new(1, 1, 1), Enum.Material.SmoothPlastic, Enum.PartType.Ball, 0.15)
			puff.Position = pos + Vector3.new(math.random() - 0.5, math.random() - 0.5, math.random() - 0.5) * 2 * s
			tween(puff, 0.45, { Size = puff.Size * 2, Position = puff.Position + Vector3.new(math.random() - 0.5, math.random() * 0.8, math.random() - 0.5) * 4 * s, Transparency = 1 })
			Debris:AddItem(puff, 0.5)
		end
		Fx.ring(pos, c, 1, (heavy and 11 or 7) * s, 0.3, dir)
	elseif style.fx == "galaxy" then
		-- 성하: 별빛이 흩어지고 금빛 별 하나가 반짝인다
		local star = piece(Vector3.new(0.3, 0.3, 0.3), c2, Enum.Material.Neon, nil, 0)
		star.CFrame = lookAt(pos, pos + (dir or Vector3.new(0, 0, -1))) * CFrame.Angles(0, 0, math.rad(45))
		tween(star, 0.12, { Size = Vector3.new(0.4, 0.4, 0.4) * 8 * s })
		task.delay(0.12, function()
			if star.Parent then
				tween(star, 0.2, { Transparency = 1, Size = Vector3.new(0.1, 0.1, 0.1) })
			end
		end)
		Debris:AddItem(star, 0.35)
		Fx.burst("glitter", pos, c2, heavy and 18 or 10, 1.2 * s)
		Fx.ring(pos, c, 1, (heavy and 13 or 9) * s, 0.3, dir)
		Fx.flash(pos, c2, 16 * s, 3, 0.25)
	elseif style.fx == "subspace" then
		-- 아공: 맞은 자리의 공간이 접힌다 (유리 조각 넷이 안으로 모였다 튀고, 민트빛 십자)
		for k = 0, 3 do
			local a = k / 4 * math.pi * 2 + math.random()
			local cube = piece(Vector3.new(0.9, 0.9, 0.9) * s, k % 2 == 0 and c or c2, Enum.Material.Glass, nil, 0.2)
			cube.CFrame = CFrame.new(pos + Vector3.new(math.cos(a), math.sin(a), 0) * 3 * s) * CFrame.Angles(a, a, 0)
			tween(cube, 0.1, { CFrame = CFrame.new(pos) })
			task.delay(0.1, function()
				if cube.Parent then
					tween(cube, 0.2, { CFrame = CFrame.new(pos + Vector3.new(math.cos(a), math.sin(a), 0) * 5 * s) * CFrame.Angles(a * 2, 0, a), Transparency = 1 })
				end
			end)
			Debris:AddItem(cube, 0.35)
		end
		local face = lookAt(pos, pos + (dir or Vector3.new(0, 0, -1)))
		for _, sgn in ipairs({ 1, -1 }) do
			local bar = piece(Vector3.new(0.2, 0.2, (heavy and 9 or 6) * s), c2, Enum.Material.Neon, nil, 0)
			bar.CFrame = face * CFrame.Angles(0, 0, sgn * math.rad(45)) * CFrame.Angles(math.rad(90), 0, 0)
			tween(bar, 0.2, { Transparency = 1 })
			Debris:AddItem(bar, 0.22)
		end
		Fx.ring(pos, c, 1, (heavy and 12 or 8) * s, 0.25, dir)
	elseif style.fx == "duel" then
		-- 무쌍: 맞은 자리에 붉은 십자 베기와 하얀 섬광 (군더더기 없이 날카롭게)
		local face = lookAt(pos, pos + (dir or Vector3.new(0, 0, -1)))
		for _, sgn in ipairs({ 1, -1 }) do
			local bar = piece(Vector3.new(0.35, 0.35, 0.35), sgn > 0 and c or c2, Enum.Material.Neon, nil, 0)
			bar.CFrame = face * CFrame.Angles(0, 0, sgn * math.rad(45)) * CFrame.Angles(math.rad(90), 0, 0)
			tween(bar, 0.16, { Size = Vector3.new(0.12, 0.12, (heavy and 11 or 7) * s) })
			task.delay(0.16, function()
				if bar.Parent then
					tween(bar, 0.14, { Transparency = 1 })
				end
			end)
			Debris:AddItem(bar, 0.32)
		end
		Fx.ring(pos, c2, 1, (heavy and 12 or 8) * s, 0.22, dir)
		if heavy then
			Fx.ring(pos, c, 2, 16 * s, 0.32, dir)
			Fx.burst("spark", pos, c2, 14, 1.2)
		end
		Fx.flash(pos, c, 14 * s, 3, 0.2)
	elseif style.fx == "fire" then
		-- 열화: 불덩이가 터지고 불씨가 솟는다
		local ball = piece(Vector3.new(2, 2, 2) * s, Color3.fromRGB(255, 200, 90), Enum.Material.Neon, Enum.PartType.Ball, 0.1)
		ball.Position = pos
		tween(ball, 0.25, { Size = Vector3.new(6, 6, 6) * s, Transparency = 1, Color = c })
		Debris:AddItem(ball, 0.3)
		Fx.burst("ember", pos, c, heavy and 18 or 10, 1.2 * s)
		if heavy then
			Fx.burst("smoke", pos, Color3.fromRGB(80, 60, 55), 5, 1)
		end
		Fx.ring(pos, c, 1, 11 * s, 0.32, dir)
		Fx.flash(pos, c, 18 * s, 3, 0.3)
	elseif style.fx == "ocean" then
		-- 창해: 맞은 자리에서 물보라가 크게 튀고, 물결 고리 두 겹이 퍼진다
		local splash = piece(Vector3.new(2, 2, 2) * s, c2, Enum.Material.Glass, Enum.PartType.Ball, 0.3)
		splash.Position = pos
		tween(splash, 0.25, { Size = Vector3.new(6, 6, 6) * s, Transparency = 1 })
		Debris:AddItem(splash, 0.3)
		for _ = 1, heavy and 12 or 7 do
			local drop = piece(Vector3.new(0.6, 0.6, 0.6) * s, math.random() < 0.5 and c or c2, Enum.Material.Glass, Enum.PartType.Ball, 0.15)
			drop.Position = pos
			local to = pos + Vector3.new(math.random() * 8 - 4, math.random() * 5 + 1, math.random() * 8 - 4) * s
			tween(drop, 0.35, { Position = to }, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
			task.delay(0.35, function()
				if drop.Parent then
					tween(drop, 0.25, { Position = to - Vector3.new(0, 4 * s, 0), Transparency = 1 }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
				end
			end)
			Debris:AddItem(drop, 0.65)
		end
		Fx.ring(pos, c2, 1, 10 * s, 0.3, dir)
		Fx.ring(pos, c, 1, 14 * s, 0.45, dir)
	elseif style.fx == "eclipse" then
		-- 일월: 금빛 해가 터지며 빛살이 뻗고, 은빛 초승달이 그 위를 가로질러 벤다
		local sun = piece(Vector3.new(1.4, 1.4, 1.4) * s, c, Enum.Material.Neon, Enum.PartType.Ball, 0)
		sun.Position = pos
		tween(sun, 0.22, { Size = Vector3.new(4, 4, 4) * s, Transparency = 1 })
		Debris:AddItem(sun, 0.25)
		local face = lookAt(pos, pos + (dir or Vector3.new(0, 0, -1)))
		for k = 0, 7 do
			local a = k / 8 * math.pi * 2
			local ray = piece(Vector3.new(0.2, 0.2, 0.2), c:Lerp(Color3.new(1, 1, 1), 0.45), Enum.Material.Neon, nil, 0)
			ray.CFrame = lookAt(pos, pos + face:VectorToWorldSpace(Vector3.new(math.cos(a), math.sin(a), 0)))
			tween(ray, 0.2, { Size = Vector3.new(0.06, 0.06, (k % 2 == 0 and 5 or 3) * s), Transparency = 1, CFrame = ray.CFrame * CFrame.new(0, 0, -2.2 * s) })
			Debris:AddItem(ray, 0.22)
		end
		local tilt = math.random() * math.pi
		for k = 0, 6 do
			local a = math.rad(-60 + k * 20)
			local off = face:VectorToWorldSpace(Vector3.new(math.cos(a + tilt), math.sin(a + tilt), 0)) * 2.4 * s
			local seg = piece(Vector3.new(0.28, 0.28, 1.4 * s), c2, Enum.Material.Neon, nil, 0.05)
			seg.CFrame = lookAt(pos + off, pos + off + face:VectorToWorldSpace(Vector3.new(-math.sin(a + tilt), math.cos(a + tilt), 0)))
			tween(seg, 0.28, { Transparency = 1, Size = Vector3.new(0.05, 0.05, 1.8 * s) })
			Debris:AddItem(seg, 0.3)
		end
		Fx.ring(pos, c, 1, 10 * s, 0.28, dir)
		if heavy then
			Fx.burst("ember", pos, c, 10, 1)
			Fx.burst("glitter", pos, c2, 10, 1)
		end
	elseif style.fx == "wind" then
		-- 풍신: 바람 고리 두 겹과 날리는 잎
		Fx.ring(pos, c2, 1, 8 * s, 0.3, dir)
		Fx.ring(pos, c, 1, 12 * s, 0.4, dir)
		for _ = 1, heavy and 8 or 4 do
			local leaf = piece(Vector3.new(0.6, 0.08, 0.4), Color3.fromRGB(150, 210, 120), Enum.Material.SmoothPlastic)
			leaf.CFrame = CFrame.new(pos) * CFrame.Angles(math.random() * 6, math.random() * 6, 0)
			tween(leaf, 0.7, { CFrame = CFrame.new(pos + Vector3.new(math.random() * 10 - 5, math.random() * 6, math.random() * 10 - 5)) * CFrame.Angles(math.random() * 6, math.random() * 6, 0), Transparency = 1 })
			Debris:AddItem(leaf, 0.75)
		end
	elseif style.fx == "cosmic" then
		-- 개천: 별빛이 사방으로 튀고 금빛 고리
		Fx.ring(pos, c2, 1, 10 * s, 0.3, dir)
		for _ = 1, heavy and 10 or 6 do
			local st = piece(Vector3.new(0.35, 0.35, 0.35), math.random() < 0.5 and c or Color3.new(1, 1, 1), Enum.Material.Neon, Enum.PartType.Ball, 0)
			st.Position = pos
			tween(st, 0.5, { Position = pos + Vector3.new(math.random() * 8 - 4, math.random() * 6 - 1, math.random() * 8 - 4) * s, Transparency = 1 })
			Debris:AddItem(st, 0.55)
		end
	elseif style.fx == "drunk" then
		Fx.ring(pos, c, 1, 8 * s, 0.4, dir)
		if heavy then
			local fire = piece(Vector3.new(1, 1, 1) * 3, Color3.fromRGB(255, 120, 40), Enum.Material.Neon, Enum.PartType.Ball, 0.2)
			fire.Position = pos
			tween(fire, 0.35, { Size = Vector3.new(1, 1, 1) * 8, Transparency = 1 })
			Debris:AddItem(fire, 0.4)
		end	-- 3.0판 환생 권법
	elseif style.fx == "rinne" then
		-- 윤회권: 금빛 고리 둘이 바퀴처럼 엇갈려 돌고, 쪽빛 빛 가루
		Fx.ring(pos, c2, 1, 10 * s, 0.35, dir)
		Fx.ring(pos, c, 1, 6 * s, 0.3, dir and Vector3.new(-dir.Z, 0, dir.X) or nil)
		Fx.burst("glitter", pos, c, heavy and 10 or 5, 1)
	elseif style.fx == "karma" then
		-- 업화권: 검붉은 불티와 그을음
		Fx.ring(pos, c, 1, 9 * s, 0.35, dir)
		Fx.burst("ember", pos, c, heavy and 12 or 6, 1.1)
		local soot = piece(Vector3.new(1, 1, 1) * 1.6 * s, Color3.fromRGB(28, 10, 14), Enum.Material.SmoothPlastic, Enum.PartType.Ball, 0.3)
		soot.Position = pos
		tween(soot, 0.45, { Size = Vector3.new(1, 1, 1) * 5 * s, Transparency = 1, Position = pos + Vector3.new(0, 1.5, 0) })
		Debris:AddItem(soot, 0.5)
	elseif style.fx == "mist" then
		-- 무상권: 안개가 훅 퍼지고 푸른 칼빛이 엇갈린다
		local puff = piece(Vector3.new(1, 1, 1) * 2 * s, c2, Enum.Material.SmoothPlastic, Enum.PartType.Ball, 0.4)
		puff.Position = pos
		tween(puff, 0.4, { Size = Vector3.new(1, 1, 1) * 6 * s, Transparency = 1 })
		Debris:AddItem(puff, 0.45)
		for k = -1, 1, 2 do
			local sl = piece(Vector3.new(0.12, 4 * s, 0.4), c, Enum.Material.Neon, nil, 0.05)
			sl.CFrame = CFrame.new(pos) * CFrame.Angles(0, math.random() * 6, math.rad(40 * k))
			tween(sl, 0.25, { Transparency = 1, Size = Vector3.new(0.04, 5 * s, 0.1) })
			Debris:AddItem(sl, 0.3)
		end
	elseif style.fx == "king" then
		-- 권왕신권: 금빛 별 모양 충격선과 붉은 고리
		Fx.ring(pos, c, 1, 12 * s, 0.35, dir)
		Fx.ring(pos, c2, 1, 7 * s, 0.4, dir)
		for k = 0, heavy and 7 or 4 do
			local ray = piece(Vector3.new(0.25, 0.25, 3 * s), c, Enum.Material.Neon, nil, 0)
			local a = k / (heavy and 8 or 5) * math.pi * 2
			ray.CFrame = CFrame.lookAt(pos, pos + Vector3.new(math.cos(a), math.sin(a * 2) * 0.4, math.sin(a))) * CFrame.new(0, 0, -1.5 * s)
			tween(ray, 0.25, { Transparency = 1, Size = Vector3.new(0.05, 0.05, 5 * s) })
			Debris:AddItem(ray, 0.3)
		end
	end
end

------------------------------------------------------------------------
-- 장풍 (날아가는 기운)
------------------------------------------------------------------------
function Fx.projectile(data: any)
	local style = styleOf(data.style)
	local c = style and style.color or Color3.fromRGB(120, 255, 230)
	local c2 = style and style.color2 or Color3.new(1, 1, 1)
	local size = data.size or 3
	local ball = piece(Vector3.new(1, 1, 1) * size, c, Enum.Material.Neon, Enum.PartType.Ball, 0.15)
	local core = piece(Vector3.new(1, 1, 1) * size * 0.55, c2, Enum.Material.Neon, Enum.PartType.Ball, 0)
	ball.Position = data.pos
	core.Position = data.pos
	local a0 = Instance.new("Attachment")
	a0.Position = Vector3.new(0, size * 0.4, 0)
	a0.Parent = ball
	local a1 = Instance.new("Attachment")
	a1.Position = Vector3.new(0, -size * 0.4, 0)
	a1.Parent = ball
	local tr = Instance.new("Trail")
	tr.Attachment0 = a0
	tr.Attachment1 = a1
	tr.Lifetime = 0.3
	tr.LightEmission = 1
	tr.Color = ColorSequence.new(c2, c)
	tr.Transparency = NumberSequence.new(0, 1)
	tr.Parent = ball
	-- 날아가는 기운 뒤로 빛 가루가 흩날린다
	local dustE = Instance.new("ParticleEmitter")
	dustE.Texture = "rbxasset://textures/particles/sparkles_main.dds"
	dustE.Rate = 40
	dustE.Lifetime = NumberRange.new(0.25, 0.5)
	dustE.Speed = NumberRange.new(1, 4)
	dustE.SpreadAngle = Vector2.new(180, 180)
	dustE.Size = NumberSequence.new(size * 0.18, 0)
	dustE.LightEmission = 1
	dustE.Color = ColorSequence.new(c2, c)
	dustE.Parent = core
	-- 용 모양: 몸통이 따라오며 꿈틀댄다
	local tail = {}
	if style and style.fx == "dragon" then
		for i = 1, 6 do
			local seg = piece(Vector3.new(1, 1, 1) * size * (0.85 - i * 0.1), c:Lerp(c2, i / 8), Enum.Material.Neon, Enum.PartType.Ball, 0.25)
			seg.Position = data.pos
			table.insert(tail, seg)
		end
	end
	-- 일월 만월참: 빛의 공 대신 커다란 은빛 초승달이 눕혀서 날아간다 (가운데가 두껍고 끝이 가늘다)
	local moon = {}
	if style and style.fx == "eclipse" then
		ball.Transparency = 1
		core.Transparency = 1
		for k = 0, 12 do
			local w = 1 - math.abs(k - 6) / 6
			local seg = piece(Vector3.new(size * 0.32, 0.3, 0.4 + w * size * 0.35), k % 4 == 0 and c or c2, Enum.Material.Neon, nil, 0.05)
			seg.Position = data.pos
			table.insert(moon, seg)
		end
	end
	local start = os.clock()
	local dir: Vector3 = data.dir
	local conn: RBXScriptConnection
	conn = RunService.RenderStepped:Connect(function()
		local t = os.clock() - start
		local pos = data.pos + dir * data.speed * t
		ball.Position = pos
		core.Position = pos
		if #moon > 0 then
			local cf = CFrame.lookAt(pos, pos + dir)
			for k, seg in ipairs(moon) do
				local a = math.rad(-80 + (k - 1) * (160 / 12))
				local lp = Vector3.new(math.sin(a) * size, 0, -math.cos(a) * size + size * 0.6)
				seg.CFrame = cf * CFrame.new(lp) * CFrame.Angles(0, -a, 0)
			end
		end
		local side = Vector3.new(-dir.Z, 0, dir.X)
		for i, seg in ipairs(tail) do
			local back = math.max(0, t - i * 0.025)
			seg.Position = data.pos + dir * data.speed * back + side * math.sin(back * 18 + i) * size * 0.4
		end
		if t >= data.life then
			conn:Disconnect()
			Fx.spark(pos, c, size * 0.6, 6)
			for _, p in ipairs({ ball, core, table.unpack(tail) }) do
				tween(p, 0.15, { Transparency = 1 })
				Debris:AddItem(p, 0.2)
			end
			for _, p in ipairs(moon) do
				tween(p, 0.2, { Transparency = 1 })
				Debris:AddItem(p, 0.25)
			end
		end
	end)
end

------------------------------------------------------------------------
-- 큰 연출
------------------------------------------------------------------------
-- 꽃잎 폭발 (매화 만개)
function Fx.bloom(pos: Vector3, radius: number)
	Fx.ring(pos, Color3.fromRGB(255, 150, 200), 2, radius * 2.2, 0.5)
	for _ = 1, 40 do
		local petal = piece(Vector3.new(1, 0.1, 0.7), Color3.fromRGB(255, 130 + math.random(0, 80), 190), Enum.Material.SmoothPlastic)
		petal.CFrame = CFrame.new(pos + Vector3.new(0, 2, 0)) * CFrame.Angles(math.random() * 6, math.random() * 6, 0)
		local a = math.random() * math.pi * 2
		local to = pos + Vector3.new(math.cos(a) * radius, math.random() * 8, math.sin(a) * radius)
		tween(petal, 1.1, { CFrame = CFrame.new(to) * CFrame.Angles(math.random() * 6, math.random() * 6, 0), Transparency = 1 })
		Debris:AddItem(petal, 1.15)
	end
end

------------------------------------------------------------------------
-- 기술 쓰는 순간의 연출 (Z 강타·E·R). 오의(G)는 Fx.ult
------------------------------------------------------------------------
local function rootPart(model: Model): BasePart?
	local r = model:FindFirstChild("HumanoidRootPart")
	return (r and r:IsA("BasePart")) and r or nil
end

-- 몸을 따라다니는 조각들 (dur초 동안). place(t) 가 { [Part] = CFrame } 를 돌려준다
local function follow(model: Model, dur: number, parts: { Part }, place: (number, CFrame) -> { CFrame }, fade: number?)
	local start = os.clock()
	local conn: RBXScriptConnection
	conn = RunService.RenderStepped:Connect(function()
		local t = os.clock() - start
		local r = rootPart(model)
		if t > dur or not r or not model.Parent then
			conn:Disconnect()
			for _, p in ipairs(parts) do
				tween(p, fade or 0.25, { Transparency = 1 })
				Debris:AddItem(p, (fade or 0.25) + 0.05)
			end
			return
		end
		local cfs = place(t, r.CFrame)
		for i, p in ipairs(parts) do
			if cfs[i] then
				p.CFrame = cfs[i]
			end
		end
	end)
end

-- 몸에서 터지는 기운 (모든 기술 공통)
local function flare(pos: Vector3, color: Color3, size: number)
	local b = piece(Vector3.new(1, 1, 1) * size, color, Enum.Material.Neon, Enum.PartType.Ball, 0.35)
	b.Position = pos
	tween(b, 0.35, { Size = Vector3.new(1, 1, 1) * size * 2.6, Transparency = 1 })
	Debris:AddItem(b, 0.4)
	for _ = 1, 8 do
		local a = math.random() * math.pi * 2
		local shard = piece(Vector3.new(0.3, 2.4, 0.3), color, Enum.Material.Neon)
		local from = pos + Vector3.new(math.cos(a) * size * 0.6, -2, math.sin(a) * size * 0.6)
		shard.Position = from
		tween(shard, 0.5, { Position = from + Vector3.new(0, 6 + math.random() * 4, 0), Size = Vector3.new(0.1, 0.6, 0.1), Transparency = 1 })
		Debris:AddItem(shard, 0.55)
	end
end

-- 앞으로 뻗는 기운의 띠 (돌진 기술의 지나간 길)
local function streak(from: Vector3, to: Vector3, color: Color3, width: number, life: number)
	if (to - from).Magnitude < 0.5 then
		return
	end
	local p = piece(Vector3.new(width, width * 0.4, (to - from).Magnitude), color, Enum.Material.Neon, nil, 0.2)
	p.CFrame = lookAt((from + to) / 2, to)
	tween(p, life, { Size = Vector3.new(width * 0.1, width * 0.05, (to - from).Magnitude), Transparency = 1 })
	Debris:AddItem(p, life + 0.05)
end

-- 오의 연출 (권법마다 전혀 다르게). 발밑 진 → 모으기 → 절정(dur의 85%)에 터진다
local function beam(at: Vector3, color: Color3, width: number, height: number, life: number)
	local b = piece(Vector3.new(width, 1, width), color, Enum.Material.Neon, Enum.PartType.Cylinder, 0.15)
	b.CFrame = CFrame.new(at) * CFrame.Angles(0, 0, math.rad(90))
	b.Size = Vector3.new(1, width, width)
	tween(b, 0.18, { Size = Vector3.new(height, width, width), CFrame = CFrame.new(at + Vector3.new(0, height / 2, 0)) * CFrame.Angles(0, 0, math.rad(90)) })
	task.delay(0.18, function()
		tween(b, life, { Size = Vector3.new(height, width * 0.1, width * 0.1), Transparency = 1 })
	end)
	Debris:AddItem(b, life + 0.25)
	return b
end
local function sphere(at: Vector3, color: Color3, from: number, to: number, life: number, material: Enum.Material?, trans: number?)
	local s = piece(Vector3.new(from, from, from), color, material or Enum.Material.Neon, Enum.PartType.Ball, trans or 0.3)
	s.Position = at
	tween(s, life, { Size = Vector3.new(to, to, to), Transparency = 1 })
	Debris:AddItem(s, life + 0.05)
	return s
end
-- 돌며 솟는 조각 무리 (용, 꽃잎 회오리, 별 은하)
local function spiral(base: Vector3, n: number, dur: number, size: number, colors: { Color3 }, mat: Enum.Material, radius: number, rise: number, spin: number, shape: Enum.PartType?)
	local segs = {}
	for i = 1, n do
		local seg = piece(Vector3.new(1, 1, 1) * size * (1 - i / n * 0.5), colors[(i % #colors) + 1], mat, shape or Enum.PartType.Ball, 0.15)
		seg.Position = base
		table.insert(segs, seg)
	end
	local start = os.clock()
	local conn: RBXScriptConnection
	conn = RunService.RenderStepped:Connect(function()
		local t = os.clock() - start
		for i, seg in ipairs(segs) do
			local k = math.max(0, t - i * 0.035)
			local a = k * spin + i * 0.3
			local r = radius * (1 - math.min(0.6, k * 0.4))
			seg.CFrame = CFrame.new(base + Vector3.new(math.cos(a) * r, k * rise, math.sin(a) * r)) * CFrame.Angles(a, a * 0.5, 0)
		end
		if t > dur then
			conn:Disconnect()
			for _, seg in ipairs(segs) do
				tween(seg, 0.35, { Transparency = 1 })
				Debris:AddItem(seg, 0.4)
			end
		end
	end)
end

function Fx.ult(styleId: string, model: Model, dur: number)
	local style = styleOf(styleId)
	local root = model:FindFirstChild("HumanoidRootPart")
	if not style or not root or not root:IsA("BasePart") then
		return
	end
	local base = Vector3.new(root.Position.X, root.Position.Y - 2.5, root.Position.Z)
	local look = Vector3.new(root.CFrame.LookVector.X, 0, root.CFrame.LookVector.Z)
	look = look.Magnitude > 0.01 and look.Unit or Vector3.new(0, 0, -1)
	local c, c2 = style.color, style.color2
	local climax = dur * 0.85
	-- 공통: 발밑의 두 겹 진 (도는 띠)
	local circle = piece(Vector3.new(0.3, 4, 4), c, Enum.Material.Neon, Enum.PartType.Cylinder, 0.3)
	circle.CFrame = CFrame.new(base + Vector3.new(0, 0.2, 0)) * CFrame.Angles(0, 0, math.rad(90))
	tween(circle, 0.5, { Size = Vector3.new(0.3, 36, 36) })
	local inner = piece(Vector3.new(0.35, 4, 4), c2, Enum.Material.Neon, Enum.PartType.Cylinder, 0.45)
	inner.CFrame = CFrame.new(base + Vector3.new(0, 0.25, 0)) * CFrame.Angles(0, 0, math.rad(90))
	tween(inner, 0.6, { Size = Vector3.new(0.35, 22, 22) })
	task.delay(dur - 0.3, function()
		tween(circle, 0.3, { Transparency = 1 })
		tween(inner, 0.3, { Transparency = 1 })
	end)
	Debris:AddItem(circle, dur + 0.1)
	Debris:AddItem(inner, dur + 0.1)
	-- 모으는 동안 둘레에서 빛이 빨려 든다
	for k = 0, 9 do
		task.delay(k * dur * 0.05, function()
			local a = math.random() * math.pi * 2
			local from = base + Vector3.new(math.cos(a) * 18, math.random() * 8 + 1, math.sin(a) * 18)
			local mote = piece(Vector3.new(0.8, 0.8, 0.8), k % 2 == 0 and c or c2, Enum.Material.Neon, Enum.PartType.Ball, 0.1)
			mote.Position = from
			tween(mote, 0.4, { Position = base + Vector3.new(0, 3, 0), Size = Vector3.new(0.2, 0.2, 0.2) }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
			Debris:AddItem(mote, 0.45)
		end)
	end
	local fx = style.fx
	if fx == "water" then
		-- 물의 돔이 솟고, 물의 용이 감아 오르다, 해일 고리가 퍼져 나간다
		local dome = piece(Vector3.new(4, 4, 4), c2, Enum.Material.Glass, Enum.PartType.Ball, 0.55)
		dome.Position = base
		tween(dome, dur * 0.6, { Size = Vector3.new(30, 18, 30) })
		task.delay(climax, function()
			tween(dome, 0.3, { Size = Vector3.new(44, 4, 44), Transparency = 1 })
		end)
		Debris:AddItem(dome, climax + 0.4)
		spiral(base, 16, climax, 3.6, { c, c2 }, Enum.Material.Glass, 10, 20, 6)
		task.delay(climax, function()
			for k = 0, 3 do
				task.delay(k * 0.08, function()
					Fx.ring(base + Vector3.new(0, 0.5 + k * 0.6, 0), k % 2 == 0 and c2 or c, 4, 50 + k * 10, 0.6)
				end)
			end
			for _ = 1, 24 do
				local a = math.random() * math.pi * 2
				local drop = piece(Vector3.new(0.8, 0.8, 0.8), c2, Enum.Material.Glass, Enum.PartType.Ball, 0.1)
				drop.Position = base + Vector3.new(0, 2, 0)
				tween(drop, 0.7, { Position = base + Vector3.new(math.cos(a) * 22, math.random() * 12, math.sin(a) * 22), Transparency = 1 })
				Debris:AddItem(drop, 0.75)
			end
		end)
	elseif fx == "gold" then
		-- 등 뒤의 금빛 후광, 둘레를 도는 경문 고리, 하늘에서 내려찍는 손바닥과 빛기둥
		local halo = piece(Vector3.new(0.4, 12, 12), c, Enum.Material.Neon, Enum.PartType.Cylinder, 0.35)
		halo.CFrame = CFrame.lookAt(base + Vector3.new(0, 6, 0) - look * 1.5, base + Vector3.new(0, 6, 0) - look * 3) * CFrame.Angles(0, math.rad(90), 0)
		tween(halo, 0.5, { Size = Vector3.new(0.4, 16, 16) })
		task.delay(dur - 0.3, function()
			tween(halo, 0.3, { Transparency = 1 })
		end)
		Debris:AddItem(halo, dur + 0.1)
		for k = 0, 2 do
			task.delay(k * 0.2, function()
				Fx.ring(base + Vector3.new(0, 2 + k * 3, 0), c2, 6, 12, 0.6)
			end)
		end
		local target = base + look * 6
		local palm = piece(Vector3.new(16, 2, 20), c, Enum.Material.Neon, nil, 0.25)
		palm.CFrame = CFrame.new(target + Vector3.new(0, 70, 0))
		local fingers = {}
		for i = -2, 2 do
			local fg = piece(Vector3.new(2.6, 1.8, 9), c2, Enum.Material.Neon, nil, 0.3)
			fg.CFrame = palm.CFrame * CFrame.new(i * 3.2, 0, -13)
			table.insert(fingers, fg)
		end
		task.delay(climax - 0.2, function()
			tween(palm, 0.2, { CFrame = CFrame.new(target + Vector3.new(0, 1, 0)) }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
			for i, fg in ipairs(fingers) do
				tween(fg, 0.2, { CFrame = CFrame.new(target + Vector3.new(0, 1, 0)) * CFrame.new((i - 3) * 3.2, 0, -13) }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
			end
			task.delay(0.2, function()
				beam(target, c2, 10, 120, 0.6)
				Fx.ring(target, c, 4, 64, 0.6)
				Fx.ring(target + Vector3.new(0, 1, 0), c2, 4, 40, 0.5)
				Fx.dust(target, 7)
				tween(palm, 0.6, { Transparency = 1 })
				for _, fg in ipairs(fingers) do
					tween(fg, 0.6, { Transparency = 1 })
				end
			end)
		end)
		Debris:AddItem(palm, dur + 1)
		for _, fg in ipairs(fingers) do
			Debris:AddItem(fg, dur + 1)
		end
	elseif fx == "petal" then
		-- 꽃잎 회오리가 몸을 감싸 솟고, 다섯 번 피었다가 마지막에 크게 만개
		spiral(base, 30, dur, 1.4, { c, c2, Color3.fromRGB(255, 240, 245) }, Enum.Material.SmoothPlastic, 9, 10, 9, Enum.PartType.Block)
		for k = 0, 3 do
			task.delay(k * dur * 0.2, function()
				Fx.bloom(base + Vector3.new(0, 1, 0), 10 + k * 2)
			end)
		end
		task.delay(climax, function()
			Fx.bloom(base + Vector3.new(0, 1, 0), 26)
			sphere(base + Vector3.new(0, 2, 0), c, 4, 30, 0.5, Enum.Material.Neon, 0.6)
		end)
	elseif fx == "dragon" then
		-- 용 한 마리가 몸을 감아 하늘로, 이어 아홉 용 기둥이 땅을 뚫는다
		spiral(base, 18, dur, 4, { c, c2 }, Enum.Material.Neon, 9, 26, 7)
		for i = 0, 8 do
			task.delay(climax - 0.3 + i * 0.05, function()
				local a = i / 9 * math.pi * 2
				local p = base + Vector3.new(math.cos(a) * 15, 0, math.sin(a) * 15)
				beam(p, i % 2 == 0 and c or c2, 4, 70, 0.5)
				Fx.ring(p + Vector3.new(0, 0.3, 0), c, 1, 10, 0.4)
			end)
		end
		task.delay(climax, function()
			Fx.ring(base + Vector3.new(0, 0.5, 0), c, 4, 56, 0.6)
			Fx.dust(base, 6)
		end)
	elseif fx == "shadow" then
		-- 검은 구가 몸을 삼키고, 여섯 그림자가 사방에서 엇갈려 지나간다
		sphere(base + Vector3.new(0, 3, 0), Color3.fromRGB(20, 10, 35), 2, 14, 0.4, Enum.Material.SmoothPlastic, 0.2)
		for k = 0, 5 do
			task.delay(0.25 + k * (climax - 0.25) / 6, function()
				local a = k / 6 * math.pi * 2
				local p = base + Vector3.new(math.cos(a) * 10, 3, math.sin(a) * 10)
				local q = base + Vector3.new(-math.cos(a) * 10, 3, -math.sin(a) * 10)
				local ghost = piece(Vector3.new(2, 5, 1), Color3.fromRGB(40, 20, 70), Enum.Material.Neon, nil, 0.3)
				ghost.CFrame = lookAt(p, q)
				tween(ghost, 0.18, { CFrame = lookAt(q, q + (q - p)) })
				streak(p, q, c, 0.6, 0.3)
				task.delay(0.18, function()
					tween(ghost, 0.2, { Transparency = 1 })
				end)
				Debris:AddItem(ghost, 0.45)
			end)
		end
		task.delay(climax, function()
			sphere(base + Vector3.new(0, 3, 0), c, 3, 30, 0.45, Enum.Material.Neon, 0.4)
			Fx.ring(base + Vector3.new(0, 0.4, 0), c, 3, 40, 0.5)
		end)
	elseif fx == "lightning" then
		-- 머리 위로 먹구름이 모이고, 벼락이 쏟아지다 마지막에 거대한 한 줄기
		local cloud = piece(Vector3.new(4, 40, 40), Color3.fromRGB(40, 40, 60), Enum.Material.SmoothPlastic, Enum.PartType.Cylinder, 0.4)
		cloud.CFrame = CFrame.new(base + Vector3.new(0, 55, 0)) * CFrame.Angles(0, 0, math.rad(90))
		tween(cloud, 0.6, { Size = Vector3.new(6, 70, 70) })
		task.delay(dur, function()
			tween(cloud, 0.4, { Transparency = 1 })
		end)
		Debris:AddItem(cloud, dur + 0.5)
		for k = 0, 11 do
			task.delay(0.4 + k * (climax - 0.4) / 12, function()
				local a = math.random() * math.pi * 2
				local p = base + Vector3.new(math.cos(a), 0, math.sin(a)) * math.random(4, 22)
				Fx.lightning(p + Vector3.new(0, 55, 0), p, c, 0.7)
				Fx.ring(p, c, 1, 9, 0.3)
			end)
		end
		task.delay(climax, function()
			local p = base + look * 6
			Fx.lightning(p + Vector3.new(0, 80, 0), p, c2, 3)
			Fx.lightning(p + Vector3.new(4, 80, 0), p, c, 2)
			beam(p, c2, 8, 90, 0.4)
			Fx.ring(p, c, 4, 50, 0.5)
		end)
	elseif fx == "drunk" then
		-- 술기운이 불길이 되어 앞으로 쏟아진다 (불덩이 줄기)
		for k = 0, 13 do
			task.delay(0.35 + k * (climax - 0.35) / 14, function()
				local from = base + Vector3.new(0, 4, 0) + look * 2
				local side = Vector3.new(-look.Z, 0, look.X) * (math.random() * 6 - 3)
				local ball = piece(Vector3.new(2, 2, 2), k % 2 == 0 and Color3.fromRGB(255, 140, 40) or c, Enum.Material.Neon, Enum.PartType.Ball, 0.1)
				ball.Position = from
				tween(ball, 0.45, { Position = from + look * 20 + side + Vector3.new(0, -2, 0), Size = Vector3.new(6, 6, 6), Transparency = 1 })
				Debris:AddItem(ball, 0.5)
			end)
		end
		task.delay(climax, function()
			Fx.ring(base + Vector3.new(0, 0.5, 0) + look * 10, Color3.fromRGB(255, 140, 40), 4, 36, 0.5)
			sphere(base + look * 12 + Vector3.new(0, 2, 0), Color3.fromRGB(255, 120, 30), 4, 22, 0.4)
		end)
	elseif fx == "basic" then
		-- 하늘·땅·사람: 세 기둥이 셋으로 서고, 한 주먹에 모여 땅이 갈라진다
		for k = 0, 2 do
			task.delay(k * 0.2, function()
				local a = k / 3 * math.pi * 2
				local p = base + Vector3.new(math.cos(a) * 9, 0, math.sin(a) * 9)
				beam(p, k == 1 and c2 or c, 3, 40, climax - k * 0.2)
			end)
		end
		task.delay(climax, function()
			for k = 0, 7 do
				local a = k / 8 * math.pi * 2
				local p = base + look * 4
				streak(p, p + Vector3.new(math.cos(a), 0, math.sin(a)) * 22, c, 1.2, 0.5)
			end
			Fx.ring(base + look * 4 + Vector3.new(0, 0.4, 0), c, 3, 40, 0.5)
			Fx.dust(base + look * 4, 6)
		end)
	elseif fx == "void" then
		-- 무극: 검은 구와 흰 구가 서로를 돌다(태극), 모든 것이 한 점으로 빨려 들었다가 터진다
		local orbs = { piece(Vector3.new(3, 3, 3), Color3.new(0, 0, 0), Enum.Material.SmoothPlastic, Enum.PartType.Ball, 0), piece(Vector3.new(3, 3, 3), Color3.new(1, 1, 1), Enum.Material.Neon, Enum.PartType.Ball, 0) }
		follow(model, climax, orbs, function(t, cf)
			local a = t * 6
			local r = 7 - math.min(6, t * 3)
			local p = cf.Position + Vector3.new(0, 3, 0)
			return { CFrame.new(p + Vector3.new(math.cos(a) * r, math.sin(t * 3), math.sin(a) * r)), CFrame.new(p - Vector3.new(math.cos(a) * r, math.sin(t * 3), math.sin(a) * r)) }
		end)
		local hole = piece(Vector3.new(40, 40, 40), Color3.new(0, 0, 0), Enum.Material.SmoothPlastic, Enum.PartType.Ball, 0.6)
		hole.Position = base + Vector3.new(0, 3, 0)
		tween(hole, climax, { Size = Vector3.new(1, 1, 1), Transparency = 0 }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
		Debris:AddItem(hole, climax + 0.05)
		task.delay(climax, function()
			sphere(base + Vector3.new(0, 3, 0), Color3.new(1, 1, 1), 2, 50, 0.55, Enum.Material.Neon, 0.2)
			for k = 0, 3 do
				task.delay(k * 0.07, function()
					Fx.ring(base + Vector3.new(0, 3, 0), k % 2 == 0 and c2 or c, 2, 60 - k * 8, 0.55)
				end)
			end
		end)
	elseif fx == "blood" then
		-- 혈마 강림: 하늘에 핏빛 달, 핏방울 비, 마지막에 거대한 X자 손톱
		local moon = piece(Vector3.new(16, 16, 16), Color3.fromRGB(180, 10, 25), Enum.Material.Neon, Enum.PartType.Ball, 0.2)
		moon.Position = base + Vector3.new(0, 45, 0) - look * 10
		tween(moon, 0.5, { Size = Vector3.new(26, 26, 26) })
		task.delay(dur, function()
			tween(moon, 0.4, { Transparency = 1 })
		end)
		Debris:AddItem(moon, dur + 0.5)
		for k = 0, 23 do
			task.delay(k * climax / 24, function()
				local p = base + Vector3.new(math.random() * 30 - 15, 40, math.random() * 30 - 15)
				local drop = piece(Vector3.new(0.4, 2.4, 0.4), c, Enum.Material.Neon, nil, 0.1)
				drop.Position = p
				tween(drop, 0.4, { Position = Vector3.new(p.X, base.Y + 0.5, p.Z) }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
				Debris:AddItem(drop, 0.42)
			end)
		end
		task.delay(climax, function()
			local center = base + look * 5 + Vector3.new(0, 4, 0)
			for _, sgn in ipairs({ 1, -1 }) do
				for i = -1, 1 do
					local bar = piece(Vector3.new(0.6, 0.6, 26), i == 0 and c2 or c, Enum.Material.Neon, nil, 0.05)
					bar.CFrame = lookAt(center, center + look) * CFrame.Angles(0, 0, sgn * math.rad(45)) * CFrame.new(i * 1.6, 0, 0) * CFrame.Angles(math.rad(90), 0, 0)
					tween(bar, 0.5, { Size = Vector3.new(0.1, 0.1, 34), Transparency = 1 })
					Debris:AddItem(bar, 0.55)
				end
			end
			Fx.ring(base + Vector3.new(0, 0.5, 0), c, 4, 46, 0.55)
		end)
	elseif fx == "cosmic" then
		-- 개천벽지: 하늘에 문이 열리고, 은하가 땅에 돌고, 별들이 쏟아지다 하늘에서 빛이 내리꽂힌다
		local gateC = base + Vector3.new(0, 60, 0)
		local gate = {}
		for k = 0, 17 do
			local p = piece(Vector3.new(3, 3, 7), k % 2 == 0 and c or c2, Enum.Material.Neon, nil, 0.1)
			table.insert(gate, p)
		end
		local start = os.clock()
		local conn: RBXScriptConnection
		conn = RunService.RenderStepped:Connect(function()
			local t = os.clock() - start
			local r = math.min(30, 4 + t * 30)
			for k, p in ipairs(gate) do
				local a = k / #gate * math.pi * 2 + t * 1.5
				local at = gateC + Vector3.new(math.cos(a) * r, 0, math.sin(a) * r)
				p.CFrame = CFrame.lookAt(at, gateC)
			end
			if t > dur then
				conn:Disconnect()
				for _, p in ipairs(gate) do
					tween(p, 0.4, { Transparency = 1 })
					Debris:AddItem(p, 0.45)
				end
			end
		end)
		local core = piece(Vector3.new(4, 4, 4), Color3.new(1, 1, 1), Enum.Material.Neon, Enum.PartType.Ball, 0.1)
		core.Position = gateC
		tween(core, dur * 0.6, { Size = Vector3.new(36, 36, 36), Color = c })
		task.delay(dur, function()
			tween(core, 0.4, { Transparency = 1 })
		end)
		Debris:AddItem(core, dur + 0.5)
		spiral(base + Vector3.new(0, 0.5, 0), 36, dur, 1, { c, c2, Color3.new(1, 1, 1) }, Enum.Material.Neon, 16, 0.5, 4)
		for k = 0, 9 do
			task.delay(0.45 + k * (climax - 0.45) / 10, function()
				local a = math.random() * math.pi * 2
				Fx.starfall(base + Vector3.new(math.cos(a), 0, math.sin(a)) * math.random(4, 20), styleId)
			end)
		end
		task.delay(climax, function()
			beam(base + look * 2, Color3.new(1, 1, 1), 16, 140, 0.7)
			beam(base + look * 2, c, 24, 140, 0.5)
			for k = 0, 3 do
				task.delay(k * 0.08, function()
					Fx.ring(base + Vector3.new(0, 0.5 + k, 0), k % 2 == 0 and c or c2, 4, 70 - k * 10, 0.6)
				end)
			end
			Fx.dust(base, 8)
		end)
	end
end

-- 별 하나가 떨어진다 (개천신권 장치, 낙성우, 오의)
function Fx.starfall(at: Vector3, styleId: any)
	local style = styleOf(styleId)
	local c = style and style.color or Color3.fromRGB(150, 200, 255)
	local c2 = style and style.color2 or Color3.fromRGB(255, 245, 190)
	local ground = Vector3.new(at.X, at.Y - 2, at.Z)
	local from = ground + Vector3.new(math.random() * 16 - 8, 70, math.random() * 16 - 8)
	local star = piece(Vector3.new(2.6, 2.6, 2.6), c2, Enum.Material.Neon, Enum.PartType.Ball, 0)
	star.Position = from
	local tail = piece(Vector3.new(1.2, 1.2, 14), c, Enum.Material.Neon, nil, 0.3)
	tail.CFrame = lookAt(from, ground) * CFrame.new(0, 0, 7)
	tween(star, 0.32, { Position = ground }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
	tween(tail, 0.32, { CFrame = lookAt(ground, ground + (ground - from)) * CFrame.new(0, 0, -7) }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
	Debris:AddItem(star, 0.34)
	Debris:AddItem(tail, 0.34)
	task.delay(0.32, function()
		Fx.ring(ground + Vector3.new(0, 0.3, 0), c, 2, 26, 0.45)
		Fx.ring(ground + Vector3.new(0, 0.4, 0), c2, 1, 14, 0.35)
		Fx.spark(ground + Vector3.new(0, 1, 0), c2, 2.4, 12)
		Fx.dust(ground, 3)
		Fx.sound("heavy", 0.6, 0.8, ground)
	end)
end

-- 권법마다 다른 휘두름 무늬 (주먹이 나갈 때마다 그 권법만의 빛이 앞으로 뻗는다)
local function flourish(style: any, r: BasePart, heavy: boolean)
	local c, c2 = style.color, style.color2
	local cf = r.CFrame
	local look, right, up = cf.LookVector, cf.RightVector, Vector3.new(0, 1, 0)
	local base = r.Position + Vector3.new(0, 0.6, 0)
	local s = (heavy and 1.6 or 1) * 1.35 -- 기술 연출은 한 치수 크게
	local kind = style.fx
	if kind == "water" then
		-- 물의 초승달: 물방울이 둥글게 휘어 앞으로 흐른다
		for i = -4, 4 do
			local a = i / 4 * 1.1
			local p = base + (look * math.cos(a) + right * math.sin(a)) * 4.2 * s
			local d = piece(Vector3.new(0.55, 0.55, 0.55) * s, i % 2 == 0 and c2 or c, Enum.Material.Glass, Enum.PartType.Ball, 0.15)
			d.Position = base + look * 1.5
			tween(d, 0.16, { Position = p })
			task.delay(0.16, function()
				tween(d, 0.3, { Position = p + look * 3 + Vector3.new(0, -1, 0), Transparency = 1, Size = Vector3.new(0.2, 0.2, 0.2) })
			end)
			Debris:AddItem(d, 0.5)
		end
	elseif kind == "gold" then
		-- 금강의 그림자 주먹: 금빛 큰 주먹이 겹쳐 뻗는다
		local fist = piece(Vector3.new(2.2, 2.2, 2.2) * s, c, Enum.Material.Neon, Enum.PartType.Ball, 0.35)
		fist.Position = base + look * 1.5
		tween(fist, 0.18, { Position = base + look * 6 * s, Size = Vector3.new(3.4, 3.4, 3.4) * s, Transparency = 1 })
		Debris:AddItem(fist, 0.2)
		local hex = piece(Vector3.new(0.2, 4, 4) * s, c2, Enum.Material.Neon, Enum.PartType.Cylinder, 0.4)
		hex.CFrame = lookAt(base + look * 5, base + look * 6) * CFrame.Angles(0, math.rad(90), 0)
		tween(hex, 0.25, { Size = Vector3.new(0.05, 8, 8) * s, Transparency = 1 })
		Debris:AddItem(hex, 0.3)
	elseif kind == "petal" then
		-- 매화 부채: 꽃잎이 부채꼴로 흩뿌려진다
		for _ = 1, heavy and 12 or 7 do
			local a = (math.random() - 0.5) * 1.6
			local dir = look * math.cos(a) + right * math.sin(a)
			local pt = piece(Vector3.new(0.6, 0.06, 0.45), math.random() < 0.5 and c or c2, Enum.Material.SmoothPlastic)
			pt.CFrame = CFrame.new(base + look * 1.5) * CFrame.Angles(math.random() * 6, math.random() * 6, 0)
			tween(pt, 0.45, { CFrame = CFrame.new(base + dir * (5 + math.random() * 3) * s + up * (math.random() * 2 - 0.5)) * CFrame.Angles(math.random() * 6, math.random() * 6, 0), Transparency = 1 })
			Debris:AddItem(pt, 0.5)
		end
	elseif kind == "dragon" then
		-- 용의 몸: 굽이치는 빛 구슬이 앞으로 헤엄친다
		for i = 1, 7 do
			local seg = piece(Vector3.new(1, 1, 1) * (1.6 - i * 0.15) * s, c:Lerp(c2, i / 7), Enum.Material.Neon, Enum.PartType.Ball, 0.15)
			seg.Position = base + look * 1.5
			local p = base + look * (1.5 + i * 1.1 * s) + right * math.sin(i * 0.9) * 1.2 + up * math.cos(i * 0.9) * 0.6
			task.delay(i * 0.015, function()
				tween(seg, 0.14, { Position = p })
				task.delay(0.14, function()
					tween(seg, 0.25, { Transparency = 1, Size = seg.Size * 0.3 })
				end)
			end)
			Debris:AddItem(seg, 0.5)
		end
	elseif kind == "shadow" then
		-- 그림자 십자: 보랏빛 두 줄이 엇갈린다
		for _, sgn in ipairs({ 1, -1 }) do
			local bar = piece(Vector3.new(0.25, 0.25, 5 * s), c, Enum.Material.Neon, nil, 0.1)
			bar.CFrame = lookAt(base + look * 3.5, base + look * 4.5) * CFrame.Angles(0, 0, sgn * math.rad(45)) * CFrame.Angles(math.rad(90), 0, 0)
			tween(bar, 0.22, { Size = Vector3.new(0.05, 0.05, 7 * s), Transparency = 1 })
			Debris:AddItem(bar, 0.25)
		end
		local smoke = piece(Vector3.new(1.5, 1.5, 1.5), Color3.fromRGB(30, 15, 45), Enum.Material.SmoothPlastic, Enum.PartType.Ball, 0.4)
		smoke.Position = base - look * 0.5
		tween(smoke, 0.4, { Size = Vector3.new(4, 4, 4), Transparency = 1 })
		Debris:AddItem(smoke, 0.45)
	elseif kind == "lightning" then
		-- 벼락 주먹: 주먹 끝에서 갈라지는 번개
		local tip = base + look * 2
		for _ = 1, heavy and 3 or 2 do
			Fx.lightning(tip, tip + look * (5 + math.random() * 3) * s + right * (math.random() * 4 - 2) + up * (math.random() * 2 - 1), c, 0.22)
		end
	elseif kind == "drunk" then
		-- 취기: 술 방울과 불씨가 휘청이며 퍼진다
		for _ = 1, 5 do
			local f = piece(Vector3.new(0.7, 0.7, 0.7) * s, math.random() < 0.5 and Color3.fromRGB(255, 140, 50) or c, Enum.Material.Neon, Enum.PartType.Ball, 0.2)
			f.Position = base + look * 1.5
			tween(f, 0.35, { Position = base + look * (3 + math.random() * 3) + right * (math.random() * 4 - 2) + up * math.random() * 2, Size = Vector3.new(0.1, 0.1, 0.1), Transparency = 1 })
			Debris:AddItem(f, 0.4)
		end
	elseif kind == "basic" then
		-- 삼재: 바른 주먹이 공기를 꿰뚫는 세 겹 고리
		for i = 1, 3 do
			task.delay(i * 0.03, function()
				Fx.ring(base + look * (1.5 + i * 1.2), i == 2 and c2 or c, 0.5, (2 + i) * s, 0.18, look)
			end)
		end
	elseif kind == "void" then
		-- 무극: 앞이 한 점으로 빨려 들었다가 터진다
		local p0 = base + look * 4
		local hole = piece(Vector3.new(4, 4, 4) * s, Color3.new(0, 0, 0), Enum.Material.SmoothPlastic, Enum.PartType.Ball, 0.2)
		hole.Position = p0
		tween(hole, 0.12, { Size = Vector3.new(0.3, 0.3, 0.3) })
		task.delay(0.12, function()
			hole:Destroy()
			Fx.ring(p0, c2, 0.5, 10 * s, 0.3, look)
			Fx.ring(p0, c, 0.5, 6 * s, 0.25)
		end)
		Debris:AddItem(hole, 0.2)
	elseif kind == "celestial" then
		-- 천제: 주먹 끝으로 금빛 초승달 칼날이 그어진다
		local arc = piece(Vector3.new(5 * s, 0.12, 1.4), c, Enum.Material.Neon, nil, 0.1)
		arc.CFrame = lookAt(base + look * 3, base + look * 4) * CFrame.Angles(0, 0, math.random() * math.pi)
		tween(arc, 0.2, { Size = Vector3.new(8 * s, 0.04, 0.3), Transparency = 1 })
		Debris:AddItem(arc, 0.22)
		local glint = piece(Vector3.new(0.5, 0.5, 0.5), Color3.new(1, 1, 1), Enum.Material.Neon, Enum.PartType.Ball, 0)
		glint.Position = base + look * 4.5
		tween(glint, 0.2, { Size = Vector3.new(2, 2, 2), Transparency = 1 })
		Debris:AddItem(glint, 0.22)
	elseif kind == "gravity" then
		-- 파천: 주먹이 지나간 길이 무겁게 휘어진다 (검은 띠와 보랏빛 테)
		local band = piece(Vector3.new(0.6, 0.6, 5 * s), Color3.fromRGB(15, 5, 25), Enum.Material.SmoothPlastic, nil, 0.2)
		band.CFrame = lookAt(base + look * 3, base + look * 6)
		tween(band, 0.2, { Size = Vector3.new(0.1, 0.1, 7 * s), Transparency = 1 })
		Debris:AddItem(band, 0.22)
		streak(base + look * 1.5, base + look * (5.5 * s), c, 0.35, 0.18)
		if heavy then
			Fx.ring(base + look * 4, c2, 6, 1, 0.2, look)
		end
	elseif kind == "origin" then
		-- 태초: 손끝에서 맑은 빛줄기가 곧게 뻗는다
		streak(base + look * 1.5, base + look * (7 * s), Color3.fromRGB(255, 252, 240), 0.3, 0.16)
		streak(base + look * 1.5 + up * 0.3, base + look * (6 * s), c2, 0.15, 0.2)
		if heavy then
			Fx.ring(base + look * 5, c2, 1, 10, 0.25, look)
		end
	elseif kind == "time" then
		-- 영겁: 곧은 빛줄기 끝에 작은 시계판 고리
		streak(base + look * 1.5, base + look * (7 * s), c, 0.28, 0.16)
		Fx.ring(base + look * (6 * s), c2, 1, 4 * s, 0.25, look)
		if heavy then
			Fx.ring(base + look * 5, c, 1, 12, 0.3, look)
		end
	elseif kind == "cloud" then
		-- 운류: 손바닥 앞으로 구름 한 덩이가 밀려 나간다
		local puff = piece(Vector3.new(1.6, 1.6, 1.6) * s, Color3.new(1, 1, 1), Enum.Material.SmoothPlastic, Enum.PartType.Ball, 0.2)
		puff.Position = base + look * 2
		tween(puff, 0.3, { Position = base + look * (6 * s), Size = puff.Size * 1.8, Transparency = 1 })
		Debris:AddItem(puff, 0.32)
	elseif kind == "galaxy" then
		-- 성하: 주먹 끝에서 별 꼬리가 뻗는다
		streak(base + look * 1.5, base + look * (7 * s), c2, 0.25, 0.16)
		streak(base + look * 1.5 + up * 0.25, base + look * (5.5 * s), c, 0.12, 0.2)
		Fx.burst("glitter", base + look * 4, c2, heavy and 8 or 3, 0.8)
	elseif kind == "subspace" then
		-- 아공: 손끝 앞의 공간이 접히며 민트빛 금이 간다
		streak(base + look * 1.5, base + look * (6.5 * s), c2, 0.2, 0.14)
		local sq = piece(Vector3.new(1.4, 1.4, 0.1) * s, c, Enum.Material.Glass, nil, 0.3)
		sq.CFrame = lookAt(base + look * 4, base + look * 6) * CFrame.Angles(0, 0, math.rad(45))
		tween(sq, 0.2, { Size = Vector3.new(0.2, 0.2, 0.1), Transparency = 1 })
		Debris:AddItem(sq, 0.22)
		if heavy then
			Fx.ring(base + look * 5, c2, 1, 11, 0.25, look)
		end
	elseif kind == "duel" then
		-- 무쌍: 곧은 하얀 일직선 끝에 붉은 날
		streak(base + look * 1.5, base + look * (7 * s), c2, 0.22, 0.12)
		streak(base + look * 1.5 + up * 0.2, base + look * (6 * s), c, 0.12, 0.16)
		if heavy then
			Fx.ring(base + look * 5, c, 1, 11, 0.22, look)
		end
	elseif kind == "fire" then
		-- 열화: 주먹을 따라 휘어지는 불길 세 가닥
		for i = -1, 1 do
			local fl = piece(Vector3.new(0.5, 0.5, 4.5 * s), i == 0 and Color3.fromRGB(255, 220, 120) or c, Enum.Material.Neon, nil, 0.1)
			fl.CFrame = lookAt(base + look * 2 + right * i * 0.8, base + look * 6 + right * i * 1.6 + up * math.abs(i) * 0.6)
			tween(fl, 0.22, { Size = Vector3.new(0.1, 0.1, 7 * s), Transparency = 1, CFrame = fl.CFrame * CFrame.new(0, 0.6, -2) })
			Debris:AddItem(fl, 0.25)
		end
		Fx.burst("ember", base + look * 4, c, heavy and 10 or 4, 1)
	elseif kind == "ocean" then
		-- 창해: 손끝을 따라 휘어지는 물줄기 두 가닥과 물방울
		for i = -1, 1, 2 do
			local w = piece(Vector3.new(0.35, 0.35, 5 * s), i < 0 and c or c2, Enum.Material.Glass, nil, 0.15)
			w.CFrame = lookAt(base + look * 2 + up * i * 0.6, base + look * 6 + right * i * 1.5) * CFrame.Angles(0, 0, math.rad(25 * i))
			tween(w, 0.25, { Size = Vector3.new(0.08, 0.08, 8 * s), Transparency = 1, CFrame = w.CFrame * CFrame.new(0, 0, -2.5) })
			Debris:AddItem(w, 0.28)
		end
		if heavy then
			Fx.ring(base + look * 5, c2, 1, 12, 0.3, look)
			Fx.ring(base + look * 6, c, 1, 16, 0.4, look)
		end
	elseif kind == "eclipse" then
		-- 일월: 금빛 빛줄기 한 줄과, 그 둘레를 감는 은빛 반달
		streak(base + look * 1.5, base + look * (7 * s), c, 0.32, 0.16)
		for k = 0, 5 do
			local a = math.rad(-70 + k * 28)
			local p = base + look * (4 * s) + right * math.cos(a) * 1.8 + up * math.sin(a) * 1.8
			local seg = piece(Vector3.new(0.18, 0.18, 1.1), c2, Enum.Material.Neon, nil, 0.1)
			seg.CFrame = lookAt(p, p + right * -math.sin(a) + up * math.cos(a))
			tween(seg, 0.2, { Transparency = 1, Size = Vector3.new(0.05, 0.05, 1.4) })
			Debris:AddItem(seg, 0.22)
		end
		if heavy then
			Fx.ring(base + look * 5, c, 1, 11, 0.25, look)
			Fx.ring(base + look * 5, c2, 1, 7, 0.3, look)
		end
	elseif kind == "wind" then
		-- 풍신: 발끝을 따라 휘어진 바람 줄기
		for i = -1, 1, 2 do
			local w = piece(Vector3.new(0.15, 0.15, 5 * s), c2, Enum.Material.Neon, nil, 0.3)
			w.CFrame = lookAt(base + look * 2 + right * i, base + look * 6 + right * i * 2.5) * CFrame.Angles(0, 0, math.rad(30 * i))
			tween(w, 0.25, { Size = Vector3.new(0.04, 0.04, 8 * s), Transparency = 1, CFrame = w.CFrame * CFrame.new(0, 0, -2) })
			Debris:AddItem(w, 0.28)
		end
	elseif kind == "cosmic" then
		-- 개천: 주먹을 따라 나선으로 감기는 별빛
		for i = 1, 8 do
			local a = i * 0.9
			local st = piece(Vector3.new(0.45, 0.45, 0.45) * s, i % 2 == 0 and c or c2, Enum.Material.Neon, Enum.PartType.Ball, 0)
			st.Position = base + look * 1.5
			local p = base + look * (1.5 + i * 0.7 * s) + right * math.cos(a) * 1.1 + up * math.sin(a) * 1.1
			task.delay(i * 0.01, function()
				tween(st, 0.15, { Position = p })
				task.delay(0.15, function()
					tween(st, 0.25, { Transparency = 1, Size = Vector3.new(0.1, 0.1, 0.1) })
				end)
			end)
			Debris:AddItem(st, 0.45)
		end
		if heavy then
			Fx.ring(base + look * 5, c2, 1, 9, 0.25, look)
		end
	elseif kind == "blood" then
		-- 혈마: 핏빛 세 갈래 손톱 자국
		for i = -1, 1 do
			local bar = piece(Vector3.new(0.18, 0.18, 4.5 * s), i == 0 and c2 or c, Enum.Material.Neon, nil, 0.05)
			bar.CFrame = lookAt(base + look * 3.2 + right * i * 0.7, base + look * 4.2 + right * i * 0.7) * CFrame.Angles(0, 0, math.rad(60)) * CFrame.Angles(math.rad(90), 0, 0)
			tween(bar, 0.28, { Size = Vector3.new(0.04, 0.04, 6 * s), Transparency = 1 })
			Debris:AddItem(bar, 0.3)
		end
	end
end

-- 권법마다 손에 맺힌 기운 (쓰는 권법이 바뀌면 바뀐다, 각성하면 짙어진다)
local HAND_FX = {
	water = { tex = "rbxasset://textures/particles/sparkles_main.dds", speed = 1.5, life = 0.6, size = 0.35 },
	gold = { tex = "rbxasset://textures/particles/sparkles_main.dds", speed = 2, life = 0.5, size = 0.4 },
	petal = { tex = "rbxasset://textures/particles/sparkles_main.dds", speed = 2.5, life = 0.9, size = 0.3 },
	dragon = { tex = "rbxasset://textures/particles/fire_main.dds", speed = 2, life = 0.45, size = 0.5 },
	shadow = { tex = "rbxasset://textures/particles/smoke_main.dds", speed = 1, life = 0.7, size = 0.6 },
	lightning = { tex = "rbxasset://textures/particles/sparkles_main.dds", speed = 6, life = 0.15, size = 0.3 },
	drunk = { tex = "rbxasset://textures/particles/fire_main.dds", speed = 1.5, life = 0.5, size = 0.4 },
	basic = { tex = "rbxasset://textures/particles/sparkles_main.dds", speed = 1, life = 0.4, size = 0.2 },
	void = { tex = "rbxasset://textures/particles/smoke_main.dds", speed = 0.6, life = 1, size = 0.7 },
	blood = { tex = "rbxasset://textures/particles/smoke_main.dds", speed = 1.2, life = 0.6, size = 0.5 },
	cosmic = { tex = "rbxasset://textures/particles/sparkles_main.dds", speed = 2, life = 1, size = 0.35 },
	celestial = { tex = "rbxasset://textures/particles/sparkles_main.dds", speed = 1.5, life = 0.9, size = 0.4 },
	gravity = { tex = "rbxasset://textures/particles/smoke_main.dds", speed = 0.4, life = 0.6, size = 0.6 },
	origin = { tex = "rbxasset://textures/particles/sparkles_main.dds", speed = 1.2, life = 1.1, size = 0.4 },
	wind = { tex = "rbxasset://textures/particles/smoke_main.dds", speed = 4, life = 0.5, size = 0.5 },
	eclipse = { tex = "rbxasset://textures/particles/fire_main.dds", speed = 1.4, life = 0.8, size = 0.45 },
	ocean = { tex = "rbxasset://textures/particles/sparkles_main.dds", speed = 2.2, life = 0.7, size = 0.45 },
	time = { tex = "rbxasset://textures/particles/sparkles_main.dds", speed = 0.6, life = 1.4, size = 0.35 },
	fire = { tex = "rbxasset://textures/particles/fire_main.dds", speed = 2.5, life = 0.5, size = 0.6 },
	duel = { tex = "rbxasset://textures/particles/sparkles_main.dds", speed = 3, life = 0.35, size = 0.4 },
	subspace = { tex = "rbxasset://textures/particles/sparkles_main.dds", speed = 0.8, life = 1.2, size = 0.35 },
	cloud = { tex = "rbxasset://textures/particles/smoke_main.dds", speed = 1.2, life = 0.8, size = 0.5 },
	galaxy = { tex = "rbxasset://textures/particles/sparkles_main.dds", speed = 1.6, life = 1.0, size = 0.4 },
}
function Fx.styleHands(model: Model, styleId: any, tier: number)
	for _, d in ipairs(model:GetDescendants()) do
		if d.Name == "KwonStyleHand" then
			d:Destroy()
		end
	end
	local style = styleOf(styleId)
	local h = style and HAND_FX[style.fx]
	if not style or not h then
		return
	end
	for _, side in ipairs({ "RightHand", "LeftHand", "Right Arm", "Left Arm" }) do
		local hand = model:FindFirstChild(side)
		if hand and hand:IsA("BasePart") then
			local e = Instance.new("ParticleEmitter")
			e.Name = "KwonStyleHand"
			e.Texture = h.tex
			e.Color = ColorSequence.new(style.color, style.color2)
			e.LightEmission = style.fx == "shadow" and 0 or 1
			e.Transparency = NumberSequence.new(0.3, 1)
			e.Size = NumberSequence.new(h.size * (1 + tier * 0.4), 0)
			e.Lifetime = NumberRange.new(h.life * 0.7, h.life)
			e.Speed = NumberRange.new(h.speed * 0.5, h.speed)
			e.SpreadAngle = Vector2.new(180, 180)
			e.Rate = (6 + tier * 10) * (style.awakenOf and 2 or 1)
			if style.awakenOf then
				e.Size = NumberSequence.new(h.size * (1.8 + tier * 0.4), 0)
			end
			e.Parent = hand
		end
	end
	-- 각성 권법 (진): 온몸에서 두 빛깔의 기운이 타오르고 금빛 불티가 튄다
	if style.awakenOf then
		local torso = model:FindFirstChild("UpperTorso") or model:FindFirstChild("Torso")
		if torso and torso:IsA("BasePart") then
			local flame = Instance.new("ParticleEmitter")
			flame.Name = "KwonStyleHand"
			flame.Texture = "rbxasset://textures/particles/fire_main.dds"
			flame.Color = ColorSequence.new(style.color, style.color2)
			flame.LightEmission = 1
			flame.Transparency = NumberSequence.new(0.45, 1)
			flame.Size = NumberSequence.new(2.2, 0.4)
			flame.Lifetime = NumberRange.new(0.5, 0.9)
			flame.Speed = NumberRange.new(2, 5)
			flame.Acceleration = Vector3.new(0, 8, 0)
			flame.SpreadAngle = Vector2.new(30, 30)
			flame.EmissionDirection = Enum.NormalId.Top
			flame.Rate = 22
			flame.Parent = torso
			local sparks = Instance.new("ParticleEmitter")
			sparks.Name = "KwonStyleHand"
			sparks.Texture = "rbxasset://textures/particles/sparkles_main.dds"
			sparks.Color = ColorSequence.new(Color3.fromRGB(255, 225, 140), style.color2)
			sparks.LightEmission = 1
			sparks.Size = NumberSequence.new(0.35, 0)
			sparks.Lifetime = NumberRange.new(0.6, 1.2)
			sparks.Speed = NumberRange.new(3, 7)
			sparks.SpreadAngle = Vector2.new(180, 180)
			sparks.Rate = 14
			sparks.Parent = torso
		end
	end
end

-- 휘두를 때마다 앞에 터지는 바람 (빗나가도 보인다)
function Fx.swing(styleId: any, model: Model, heavy: boolean)
	local r = rootPart(model)
	if not r then
		return
	end
	local style = styleOf(styleId)
	local c = style and style.color or Color3.fromRGB(240, 240, 255)
	local look = r.CFrame.LookVector
	local pos = r.Position + look * 3.5 + Vector3.new(0, 0.6, 0)
	Fx.ring(pos, c, 1, heavy and 9 or 5, heavy and 0.28 or 0.18, look)
	local arc = piece(Vector3.new(heavy and 5 or 3.4, 0.15, 1.2), c, Enum.Material.Neon, nil, 0.25)
	arc.CFrame = lookAt(pos, pos + look) * CFrame.Angles(0, 0, math.random() * math.pi)
	tween(arc, 0.18, { Size = Vector3.new(heavy and 9 or 6, 0.05, 0.3), Transparency = 1 })
	Debris:AddItem(arc, 0.2)
	if style then
		flourish(style, r, heavy)
	end
end

-- 기술 진(陣): 발밑에 도는 빛의 고리 두 겹과 여섯 개의 표식. 펼쳐졌다가 돌며 사라진다 (모든 기술이 같은 틀, 빛깔만 권법마다)
function Fx.sigil(at: Vector3, radius: number, c: Color3, c2: Color3, life: number)
	local parts: { BasePart } = {}
	local spec: { { number } } = {} -- { 반지름 비율, 각도, 도는 방향, 굵기 }
	local nOuter, nInner = 20, 12
	for k = 0, nOuter - 1 do
		local p = piece(Vector3.new(0.35, 0.15, radius * 2 * math.pi / nOuter * 0.82), c, Enum.Material.Neon, nil, 0.1)
		table.insert(parts, p)
		table.insert(spec, { 1, k / nOuter * math.pi * 2, 1 })
	end
	for k = 0, nInner - 1 do
		local p = piece(Vector3.new(0.25, 0.15, radius * 0.62 * 2 * math.pi / nInner * 0.7), c2, Enum.Material.Neon, nil, 0.15)
		table.insert(parts, p)
		table.insert(spec, { 0.62, k / nInner * math.pi * 2, -1 })
	end
	for k = 0, 5 do
		local p = piece(Vector3.new(radius * 0.16, 0.15, radius * 0.16), k % 2 == 0 and c2 or c, Enum.Material.Neon, nil, 0.05)
		table.insert(parts, p)
		table.insert(spec, { 0.81, k / 6 * math.pi * 2, 1, 1 })
	end
	local start = os.clock()
	local conn: RBXScriptConnection
	conn = RunService.Heartbeat:Connect(function()
		local t = os.clock() - start
		if t > life then
			conn:Disconnect()
			for _, p in ipairs(parts) do
				p:Destroy()
			end
			return
		end
		local open = math.min(1, t / 0.15) -- 펼쳐진다
		local fade = math.max(0, (t - life * 0.55) / (life * 0.45)) -- 끝 무렵 흐려진다
		for i, p in ipairs(parts) do
			local sp = spec[i]
			local a = sp[2] + t * 1.6 * sp[3]
			local rr = radius * sp[1] * (0.4 + 0.6 * open)
			local pos = at + Vector3.new(math.cos(a) * rr, 0.25, math.sin(a) * rr)
			if sp[4] then
				p.CFrame = CFrame.new(pos) * CFrame.Angles(0, -a + math.rad(45), 0)
			else
				p.CFrame = CFrame.lookAt(pos, pos + Vector3.new(-math.sin(a), 0, math.cos(a)))
			end
			p.Transparency = 0.1 + 0.9 * fade
		end
	end)
end

function Fx.cast(styleId: any, slot: any, model: Model, dur: number)
	local style = styleOf(styleId)
	local r = rootPart(model)
	if not style or not r or slot == "G" or type(slot) == "number" then
		return
	end
	local c, c2 = style.color, style.color2
	local pos = r.Position
	local look = Vector3.new(r.CFrame.LookVector.X, 0, r.CFrame.LookVector.Z)
	-- 1.8판: 모든 기술에 똑같이 붙던 공통 틀 (발밑 진·고리·몸의 기운·손의 빛 구슬·앞으로 뻗는 초승달) 은 없앴다
	-- 기술마다의 이펙트는 아래 (속성:칸) 과 SkillFx 가 맡는다
	look = look.Magnitude > 0.01 and look.Unit or Vector3.new(0, 0, -1)
	local feet = pos - Vector3.new(0, 2.6, 0)
	Fx.sound("swing", 0.5, slot == "H" and 0.7 or 0.55)
	-- 각성한 기술: 금빛 (완전 각성은 흰빛) 고리가 한 겹 더, 머리 위에 覺
	local tier = tonumber(model:GetAttribute("Awaken")) or 0
	if tier >= 1 then
		local glow = tier >= 2 and Color3.fromRGB(255, 250, 235) or Color3.fromRGB(255, 210, 90)
		Fx.ring(feet + Vector3.new(0, 0.3, 0), glow, 3, slot == "H" and 18 or 24, 0.55)
		flare(pos + Vector3.new(0, 1, 0), c2, 2.5)
		Fx.text(pos + Vector3.new(0, 4.2, 0), tier >= 2 and "✦✦" or "✦", glow, 22, 0.6)
	end
	-- 각성 마무리: 땅에서 솟는 기둥과 하늘로 치솟는 고리
	if slot == "F" then
		task.delay(0.24, function()
			local column = piece(Vector3.new(4, 1, 4), c, Enum.Material.Neon, nil, 0.25)
			local at = pos + look * 4 - Vector3.new(0, 2.5, 0)
			column.Position = at
			tween(column, 0.3, { Size = Vector3.new(1.2, 34, 1.2), Position = at + Vector3.new(0, 17, 0), Transparency = 1 })
			Debris:AddItem(column, 0.35)
			for k = 0, 2 do
				task.delay(k * 0.06, function()
					Fx.ring(at + Vector3.new(0, 2 + k * 4, 0), k == 1 and c2 or c, 2, 10 - k * 2, 0.35)
				end)
			end
			Fx.dust(at, 3)
		end)
		return
	elseif slot == "J" then
		Fx.ring(pos, c, 1, 8, 0.25, look)
		return
	end
	local fx = style.fx
	local key = fx .. ":" .. tostring(slot)

	if key == "water:H" then
		-- 앞으로 밀려가는 물결 벽
		task.delay(0.25, function()
			for k = 0, 2 do
				task.delay(k * 0.06, function()
					Fx.ring(pos + look * (4 + k * 3), c2, 2, 12 + k * 3, 0.35, look)
				end)
			end
		end)
	elseif key == "water:E" then
		-- 몸을 감싸고 도는 물의 띠 두 줄 (받아넘기기 자세)
		local parts = {}
		for i = 1, 10 do
			table.insert(parts, piece(Vector3.new(0.9, 0.9, 0.9), i % 2 == 0 and c or c2, Enum.Material.Neon, Enum.PartType.Ball, 0.2))
		end
		follow(model, dur + 0.3, parts, function(t, cf)
			local out = {}
			for i = 1, 10 do
				local a = t * 9 + i / 10 * math.pi * 2
				local y = (i % 2 == 0) and 0.8 or -0.8
				out[i] = cf * CFrame.new(math.cos(a) * 3.4, y + math.sin(a * 2) * 0.4, math.sin(a) * 3.4)
			end
			return out
		end)
	elseif key == "water:R" then
		-- 안으로 말려드는 소용돌이
		local parts = {}
		for i = 1, 16 do
			table.insert(parts, piece(Vector3.new(1.4, 1.4, 1.4), c:Lerp(c2, i / 16), Enum.Material.Neon, Enum.PartType.Ball, 0.25))
		end
		follow(model, dur, parts, function(t, cf)
			local out = {}
			for i = 1, 16 do
				local a = t * 8 + i / 16 * math.pi * 2
				local rad = math.max(2, 14 - t * 14) + (i % 3)
				out[i] = CFrame.new(cf.Position + Vector3.new(math.cos(a) * rad, -1.5 + (i % 4) * 0.8, math.sin(a) * rad))
			end
			return out
		end)
		for k = 0, 3 do
			task.delay(k * 0.2, function()
				Fx.ring(feet + Vector3.new(0, 0.3, 0), c2, 24, 4, 0.3)
			end)
		end
	elseif key == "gold:H" then
		-- 금빛 손바닥이 앞으로 날아간다
		task.delay(0.35, function()
			local palm = piece(Vector3.new(6, 7, 0.6), c, Enum.Material.Neon, nil, 0.2)
			local from = pos + look * 2
			palm.CFrame = lookAt(from, from + look)
			tween(palm, 0.3, { CFrame = lookAt(from + look * 12, from + look * 13), Size = Vector3.new(9, 10, 0.3), Transparency = 1 })
			Debris:AddItem(palm, 0.35)
			Fx.ring(from + look * 3, c2, 3, 16, 0.4, look)
		end)
	elseif key == "gold:E" then
		-- 금빛 갑옷: 발에서 머리로 오르는 고리 셋, 몸을 감싸는 금빛 껍질
		for k = 0, 2 do
			task.delay(k * 0.1, function()
				local ring = piece(Vector3.new(0.3, 6, 6), c, Enum.Material.Neon, Enum.PartType.Cylinder, 0.2)
				ring.CFrame = CFrame.new(feet) * CFrame.Angles(0, 0, math.rad(90))
				tween(ring, 0.4, { CFrame = CFrame.new(feet + Vector3.new(0, 6, 0)) * CFrame.Angles(0, 0, math.rad(90)), Transparency = 1 })
				Debris:AddItem(ring, 0.45)
			end)
		end
		Fx.aura(model, c, 6)
	elseif key == "gold:R" then
		-- 사자후: 앞으로 퍼지는 소리 고리와 땅을 휩쓰는 큰 충격파
		for k = 0, 4 do
			task.delay(0.15 + k * 0.08, function()
				Fx.ring(pos + look * (3 + k * 3), c, 3, 10 + k * 4, 0.35, look)
			end)
		end
		task.delay(0.2, function()
			Fx.ring(feet + Vector3.new(0, 0.3, 0), c, 4, 44, 0.6)
			Fx.ring(feet + Vector3.new(0, 0.4, 0), c2, 2, 30, 0.5)
			Fx.dust(feet, 5)
		end)
	elseif key == "petal:H" or key == "petal:R" then
		-- 지나간 길에 남는 매화빛 칼금과 꽃잎
		local lunge = slot == "R" and 22 or 14
		task.delay(0.12, function()
			streak(pos, pos + look * lunge, c, 1.6, 0.5)
			streak(pos + Vector3.new(0, 1, 0), pos + look * lunge + Vector3.new(0, 1, 0), c2, 0.7, 0.4)
			for k = 0, 5 do
				local p = pos + look * (lunge * k / 5)
				for _ = 1, 3 do
					local petal = piece(Vector3.new(0.8, 0.08, 0.6), math.random() < 0.5 and c or c2, Enum.Material.SmoothPlastic)
					petal.CFrame = CFrame.new(p) * CFrame.Angles(math.random() * 6, math.random() * 6, 0)
					tween(petal, 1, { CFrame = CFrame.new(p + Vector3.new(math.random() * 4 - 2, -2, math.random() * 4 - 2)) * CFrame.Angles(math.random() * 6, 0, math.random() * 6), Transparency = 1 })
					Debris:AddItem(petal, 1.05)
				end
			end
		end)
		if slot == "R" then
			for k = 1, 3 do
				task.delay(k * 0.07, function()
					Fx.afterimage(model, c, 0.4)
				end)
			end
		end
	elseif key == "petal:E" then
		-- 여덟 번의 번쩍임
		for k = 0, 7 do
			task.delay(0.08 + k * dur / 9, function()
				local rr = rootPart(model)
				if rr then
					local side = Vector3.new(-look.Z, 0, look.X) * (math.random() * 3 - 1.5)
					Fx.spark(rr.Position + rr.CFrame.LookVector * 3.5 + side + Vector3.new(0, math.random() * 2 - 0.5, 0), k % 2 == 0 and c or c2, 0.9, 4)
				end
			end)
		end
	elseif key == "dragon:H" or key == "dragon:E" then
		-- 두 손 앞에 모이는 용의 기운
		local orb = piece(Vector3.new(1, 1, 1), c, Enum.Material.Neon, Enum.PartType.Ball, 0.1)
		orb.Position = pos + look * 2.5
		tween(orb, dur * 0.4, { Size = Vector3.new(4, 4, 4), Transparency = 0.3 })
		task.delay(dur * 0.42, function()
			tween(orb, 0.12, { Size = Vector3.new(7, 7, 7), Transparency = 1 })
			Fx.ring(pos + look * 3, c2, 2, 14, 0.35, look)
		end)
		Debris:AddItem(orb, dur * 0.42 + 0.15)
	elseif key == "dragon:R" then
		-- 몸을 휘감으며 같이 솟구치는 용
		local parts = {}
		for i = 1, 10 do
			table.insert(parts, piece(Vector3.new(1, 1, 1) * (2.4 - i * 0.15), c:Lerp(c2, i / 10), Enum.Material.Neon, Enum.PartType.Ball, 0.2))
		end
		follow(model, dur + 0.2, parts, function(t, cf)
			local out = {}
			for i = 1, 10 do
				local k = math.max(0, t - i * 0.03)
				local a = k * 14
				out[i] = CFrame.new(cf.Position + Vector3.new(math.cos(a) * 3, -2 + k * 4 - i * 0.4, math.sin(a) * 3))
			end
			return out
		end)
		local column = piece(Vector3.new(3, 1, 3), c, Enum.Material.Neon, nil, 0.3)
		column.Position = feet
		tween(column, 0.3, { Size = Vector3.new(1.5, 40, 1.5), Position = feet + Vector3.new(0, 20, 0), Transparency = 1 })
		Debris:AddItem(column, 0.35)
	elseif key == "shadow:H" then
		for k = 1, 4 do
			task.delay(k * 0.06, function()
				Fx.afterimage(model, Color3.fromRGB(70, 40, 120), 0.45)
			end)
		end
		task.delay(0.1, function()
			streak(pos, pos + look * 12, Color3.fromRGB(60, 30, 100), 1.4, 0.45)
		end)
	elseif key == "shadow:E" then
		-- 사라지는 자리에 검은 연기
		for _ = 1, 8 do
			local smoke = piece(Vector3.new(1, 1, 1) * (2 + math.random()), Color3.fromRGB(25, 12, 45), Enum.Material.SmoothPlastic, Enum.PartType.Ball, 0.2)
			smoke.Position = pos + Vector3.new(math.random() * 3 - 1.5, math.random() * 3 - 1.5, math.random() * 3 - 1.5)
			tween(smoke, 0.7, { Size = smoke.Size * 3, Transparency = 1 })
			Debris:AddItem(smoke, 0.75)
		end
	elseif key == "shadow:R" then
		-- 몸을 둘러싼 검보랏빛 회오리 고리
		local parts = {}
		for i = 1, 3 do
			table.insert(parts, piece(Vector3.new(0.25, 7 + i, 7 + i), c, Enum.Material.Neon, Enum.PartType.Cylinder, 0.35))
		end
		follow(model, dur, parts, function(t, cf)
			local out = {}
			for i = 1, 3 do
				out[i] = CFrame.new(cf.Position) * CFrame.Angles(t * 12 + i, t * 9 + i * 2, 0)
			end
			return out
		end)
	elseif key == "lightning:H" or key == "lightning:E" then
		local lunge = slot == "E" and 20 or 18
		task.delay(0.08, function()
			local prev = pos
			for k = 1, 5 do
				local side = Vector3.new(-look.Z, 0, look.X) * ((k % 2 == 0) and 2.5 or -2.5)
				local p = pos + look * (lunge * k / 5) + (slot == "E" and side or Vector3.zero)
				Fx.lightning(prev, p, c, 0.5)
				prev = p
			end
			Fx.spark(pos + look * lunge, c2, 1.6, 8)
		end)
	elseif key == "lightning:R" then
		-- 하늘을 가리키면 주변에 벼락이 내리꽂힌다
		local orb = piece(Vector3.new(1.5, 1.5, 1.5), c2, Enum.Material.Neon, Enum.PartType.Ball, 0)
		orb.Position = pos + Vector3.new(0, 4, 0)
		tween(orb, 0.3, { Size = Vector3.new(3, 3, 3), Transparency = 0.4 })
		Debris:AddItem(orb, 0.4)
		for k = 0, 5 do
			task.delay(0.3 + k * 0.07, function()
				local a = math.random() * math.pi * 2
				local p = feet + Vector3.new(math.cos(a), 0, math.sin(a)) * math.random(4, 16)
				Fx.lightning(p + Vector3.new(0, 55, 0), p, c, 0.7)
				Fx.ring(p + Vector3.new(0, 0.3, 0), c, 1, 8, 0.3)
			end)
		end
	elseif key == "drunk:H" then
		task.delay(0.25, function()
			for _ = 1, 10 do
				local drop = piece(Vector3.new(0.5, 0.5, 0.5), Color3.fromRGB(255, 160, 60), Enum.Material.Neon, Enum.PartType.Ball, 0.1)
				drop.Position = pos + look * 3
				tween(drop, 0.45, { Position = pos + look * 3 + Vector3.new(math.random() * 8 - 4, math.random() * 5, math.random() * 8 - 4), Transparency = 1 })
				Debris:AddItem(drop, 0.5)
			end
			Fx.ring(pos + look * 3, c, 2, 12, 0.35, look)
		end)
	elseif key == "drunk:E" then
		Fx.aura(model, c, 3)
	elseif key == "drunk:R" then
		-- 여덟 신선의 빛이 몸 둘레를 돈다
		local parts = {}
		for i = 1, 8 do
			table.insert(parts, piece(Vector3.new(1.3, 1.3, 1.3), i % 2 == 0 and c or c2, Enum.Material.Neon, Enum.PartType.Ball, 0.1))
		end
		follow(model, dur, parts, function(t, cf)
			local out = {}
			for i = 1, 8 do
				local a = t * 10 + i / 8 * math.pi * 2
				out[i] = CFrame.new(cf.Position + Vector3.new(math.cos(a) * 6, math.sin(t * 6 + i) * 1.5, math.sin(a) * 6))
			end
			return out
		end)
		for k = 0, 3 do
			task.delay(k * 0.25, function()
				Fx.ring(feet + Vector3.new(0, 0.3, 0), c, 3, 18, 0.35)
			end)
		end
	elseif key == "basic:H" then
		-- 정권: 주먹 끝에서 공기가 세 겹으로 터진다
		task.delay(0.28, function()
			for k = 0, 2 do
				task.delay(k * 0.04, function()
					Fx.ring(pos + look * (3 + k * 2), k == 1 and c2 or c, 1, 7 + k * 3, 0.3, look)
				end)
			end
		end)
	elseif key == "basic:E" then
		task.delay(0.2, function()
			streak(pos - look * 6, pos + look * 3, c, 1.2, 0.3)
		end)
	elseif key == "basic:R" then
		for k = 0, 2 do
			task.delay(0.15 + k * 0.2, function()
				Fx.ring(pos + look * 3, c, 1, 8, 0.25, look)
				Fx.spark(pos + look * 3, c2, 1, 5)
			end)
		end
	elseif key == "void:H" then
		-- 무극장: 앞이 한 점으로 꺼졌다가 크게 터진다
		task.delay(0.3, function()
			local p0 = pos + look * 5
			local hole = piece(Vector3.new(8, 8, 8), Color3.new(0, 0, 0), Enum.Material.SmoothPlastic, Enum.PartType.Ball, 0.2)
			hole.Position = p0
			tween(hole, 0.12, { Size = Vector3.new(0.4, 0.4, 0.4) })
			Debris:AddItem(hole, 0.13)
			task.delay(0.12, function()
				Fx.ring(p0, Color3.new(1, 1, 1), 1, 22, 0.4, look)
				Fx.ring(p0, c, 1, 14, 0.35)
			end)
		end)
	elseif key == "void:E" then
		-- 허공격: 손가락 끝에서 하얀 선이 멀리 꿰뚫는다
		task.delay(0.2, function()
			streak(pos + look * 2, pos + look * 32, Color3.new(1, 1, 1), 0.8, 0.4)
			streak(pos + look * 2, pos + look * 32, c, 2, 0.3)
		end)
	elseif key == "void:R" then
		-- 무극회선: 둘레의 빛이 빨려 들었다 터진다
		for k = 0, 11 do
			local a = k / 12 * math.pi * 2
			local m = piece(Vector3.new(1, 1, 1), k % 2 == 0 and c or Color3.new(1, 1, 1), Enum.Material.Neon, Enum.PartType.Ball, 0.1)
			m.Position = pos + Vector3.new(math.cos(a) * 14, 0, math.sin(a) * 14)
			tween(m, dur * 0.7, { Position = pos, Size = Vector3.new(0.2, 0.2, 0.2) }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
			Debris:AddItem(m, dur * 0.7)
		end
		task.delay(dur * 0.75, function()
			Fx.ring(feet + Vector3.new(0, 0.3, 0), c, 2, 30, 0.45)
			Fx.ring(pos, Color3.new(1, 1, 1), 2, 22, 0.4)
		end)
	elseif key == "blood:H" then
		-- 혈수천강: 두 손이 내리꽂힌 자리에 피의 웅덩이와 가시
		task.delay(0.32, function()
			local at = feet + look * 4
			Fx.ring(at + Vector3.new(0, 0.3, 0), c, 2, 20, 0.45)
			for k = 0, 7 do
				local a = k / 8 * math.pi * 2
				local p = at + Vector3.new(math.cos(a) * 4, 0, math.sin(a) * 4)
				local spike = piece(Vector3.new(0.6, 0.5, 0.6), c, Enum.Material.Neon, nil, 0)
				spike.CFrame = CFrame.new(p) * CFrame.Angles(math.cos(a) * 0.4, 0, math.sin(a) * 0.4)
				tween(spike, 0.15, { Size = Vector3.new(0.6, 5, 0.6) })
				task.delay(0.2, function()
					tween(spike, 0.3, { Transparency = 1 })
				end)
				Debris:AddItem(spike, 0.55)
			end
		end)
	elseif key == "blood:E" then
		-- 혈영보: 지나간 길에 핏빛 잔상
		task.delay(0.1, function()
			streak(pos, pos + look * 24, c, 2.2, 0.45)
			Fx.afterimage(model, c, 0.5)
		end)
	elseif key == "blood:R" then
		-- 혈해: 둘레로 피의 바다가 퍼진다
		task.delay(0.28, function()
			local sea = piece(Vector3.new(0.3, 4, 4), c, Enum.Material.Neon, Enum.PartType.Cylinder, 0.3)
			sea.CFrame = CFrame.new(feet + Vector3.new(0, 0.2, 0)) * CFrame.Angles(0, 0, math.rad(90))
			tween(sea, 0.35, { Size = Vector3.new(0.3, 28, 28) })
			task.delay(0.5, function()
				tween(sea, 0.4, { Transparency = 1 })
			end)
			Debris:AddItem(sea, 1)
			for _ = 1, 16 do
				local d = piece(Vector3.new(0.5, 0.5, 0.5), c2, Enum.Material.Neon, Enum.PartType.Ball, 0.1)
				d.Position = feet + Vector3.new(math.random() * 20 - 10, 0.5, math.random() * 20 - 10)
				tween(d, 0.5, { Position = d.Position + Vector3.new(0, math.random() * 6 + 2, 0), Transparency = 1 })
				Debris:AddItem(d, 0.55)
			end
		end)
	elseif key == "celestial:H" then
		-- 천검일섬: 하늘까지 닿는 금빛 세로 칼금
		task.delay(0.36, function()
			local at = feet + look * 6
			local slash = piece(Vector3.new(0.6, 46, 3.4), Color3.fromRGB(255, 248, 220), Enum.Material.Neon, nil, 0.05)
			slash.CFrame = CFrame.lookAt(at + Vector3.new(0, 23, 0), at + Vector3.new(0, 23, 0) + look)
			tween(slash, 0.45, { Size = Vector3.new(0.1, 64, 0.4), Transparency = 1 })
			Debris:AddItem(slash, 0.5)
			Fx.ring(at + Vector3.new(0, 0.3, 0), c, 2, 24, 0.45)
		end)
	elseif key == "king:H" then
		-- 패왕권: 앞으로 겹겹이 터지는 공기
		task.delay(0.4, function()
			for k = 1, 6 do
				task.delay(k * 0.03, function()
					Fx.ring(pos + look * (2 + k * 2.5), k % 2 == 0 and c2 or Color3.new(1, 1, 1), 1, 6 + k * 2.2, 0.35, look)
				end)
			end
			Fx.dust(feet + look * 4, 5)
		end)
	elseif key == "king:E" then
		task.delay(0.15, function()
			streak(pos - look * 4, pos + look * 24, c, 3, 0.4)
			Fx.afterimage(model, c, 0.45)
		end)
	elseif key == "king:R" then
		for k = 0, 8 do
			task.delay(0.1 + k * 0.1, function()
				local p = pos + look * 3 + Vector3.new(math.random() * 2 - 1, math.random() * 2 - 0.5, 0)
				Fx.ring(p, Color3.new(1, 1, 1), 0.5, 5, 0.15, look)
			end)
		end
	elseif key == "wind:H" then
		-- 풍인각: 초승달 바람 칼날
		task.delay(0.3, function()
			local blade = piece(Vector3.new(9, 0.2, 2.5), c2, Enum.Material.Neon, nil, 0.2)
			blade.CFrame = lookAt(pos + look * 3, pos + look * 4)
			tween(blade, 0.4, { CFrame = lookAt(pos + look * 40, pos + look * 41), Size = Vector3.new(12, 0.1, 1), Transparency = 1 })
			Debris:AddItem(blade, 0.45)
		end)
	elseif key == "wind:E" then
		task.delay(0.1, function()
			streak(pos, pos + look * 24, c2, 1.6, 0.4)
		end)
	elseif key == "cosmic:H" then
		-- 개천일도: 손날이 지나간 자리에 하늘까지 닿는 금
		task.delay(0.36, function()
			local at = feet + look * 6
			local slash = piece(Vector3.new(0.5, 40, 3), c2, Enum.Material.Neon, nil, 0.05)
			slash.CFrame = CFrame.lookAt(at + Vector3.new(0, 20, 0), at + Vector3.new(0, 20, 0) + look)
			tween(slash, 0.45, { Size = Vector3.new(0.1, 60, 0.4), Transparency = 1 })
			Debris:AddItem(slash, 0.5)
			Fx.ring(at + Vector3.new(0, 0.3, 0), c, 2, 22, 0.45)
			streak(at - look * 4, at + look * 14, c, 1.4, 0.4)
		end)
	elseif key == "cosmic:E" then
		-- 유성추: 솟을 때 별빛 꼬리, 떨어진 자리에 별이 터진다
		local trail = {}
		for i = 1, 6 do
			table.insert(trail, piece(Vector3.new(1, 1, 1) * (1.4 - i * 0.15), i % 2 == 0 and c or c2, Enum.Material.Neon, Enum.PartType.Ball, 0.1))
		end
		follow(model, dur * 0.7, trail, function(t, cf)
			local out = {}
			for i = 1, 6 do
				out[i] = CFrame.new(cf.Position + Vector3.new(0, -i * 0.8, 0) + cf.LookVector * (-i * 0.4) + Vector3.new(math.sin(t * 20 + i), 0, math.cos(t * 20 + i)) * 0.3)
			end
			return out
		end)
		task.delay(dur * 0.72, function()
			local rr = rootPart(model)
			if rr then
				Fx.starfall(rr.Position, styleId)
			end
		end)
	elseif key == "cosmic:R" then
		-- 낙성우: 별비
		for k = 0, 5 do
			task.delay(0.3 + k * 0.11, function()
				local a = math.random() * math.pi * 2
				Fx.starfall(pos + Vector3.new(math.cos(a), 0, math.sin(a)) * math.random(3, 15), styleId)
			end)
		end
	end
end

-- 흘리기의 빛: 흘린 손이 지나간 반원을 따라 빛이 흐르고, 물결처럼 퍼진다
function Fx.parryArc(model: Model, side: number, color: Color3)
	local r = rootPart(model)
	if not r then
		return
	end
	local cf = r.CFrame * CFrame.new(0, 0.6, 0)
	local n = 9
	for i = 0, n - 1 do
		task.delay(i * 0.018, function()
			local a0 = math.rad(-35 + i * 15) * side
			local a1 = math.rad(-35 + (i + 1) * 15) * side
			local p0 = (cf * CFrame.new(math.sin(a0) * 3.4, i * 0.06, -math.cos(a0) * 3.4)).Position
			local p1 = (cf * CFrame.new(math.sin(a1) * 3.4, (i + 1) * 0.06, -math.cos(a1) * 3.4)).Position
			local seg = piece(Vector3.new(0.5, 0.18, (p1 - p0).Magnitude + 0.3), i % 3 == 0 and Color3.new(1, 1, 1) or color, Enum.Material.Neon, nil, 0.05)
			seg.CFrame = lookAt((p0 + p1) / 2, p1)
			tween(seg, 0.35, { Size = Vector3.new(0.05, 0.05, seg.Size.Z * 1.3), Transparency = 1 })
			Debris:AddItem(seg, 0.4)
		end)
	end
	-- 흘려 보낸 쪽으로 퍼지는 물결 고리
	local out = (cf * CFrame.new(side * 3, 0, -1)).Position
	Fx.ring(out, color, 1, 9, 0.4, r.CFrame.RightVector * side)
	Fx.ring(r.Position - Vector3.new(0, 2.5, 0), color, 2, 10, 0.4)
end

-- 그림자 메아리 (완전 각성): 흰 그림자가 같은 기술을 한 번 더 그려 낸다
function Fx.echo(model: Model, styleId: any, slot: any, dur: number)
	local style = styleOf(styleId)
	local c2 = style and style.color2 or Color3.new(1, 1, 1)
	Fx.text((rootPart(model) or { Position = Vector3.zero } :: any).Position + Vector3.new(0, 5.5, 0), "메아리", c2, 26, 0.8)
	for k = 0, 5 do
		task.delay(k * dur / 6, function()
			if model.Parent then
				Fx.afterimage(model, k % 2 == 0 and c2 or (style and style.color or c2), 0.4)
			end
		end)
	end
	Fx.cast(styleId, slot, model, dur)
end

-- 각성의 기운: 몸에서 빛 조각이 피어오른다 (완전 각성은 둘레에 빛 고리도)
local auras: { [Model]: { tier: number, parts: { Instance } } } = {}
function Fx.awakenAura(model: Model, tier: number, color: Color3)
	local cur = auras[model]
	if cur and cur.tier == tier then
		return
	end
	if cur then
		for _, p in ipairs(cur.parts) do
			p:Destroy()
		end
		auras[model] = nil
	end
	local r = rootPart(model)
	if tier <= 0 or not r then
		return
	end
	local parts: { Instance } = {}
	local att = Instance.new("Attachment")
	att.Name = "AwakenAura"
	att.Position = Vector3.new(0, -1, 0)
	att.Parent = r
	table.insert(parts, att)
	local e = Instance.new("ParticleEmitter")
	e.Rate = tier >= 2 and 22 or 10
	e.Color = ColorSequence.new(color, tier >= 2 and Color3.new(1, 1, 1) or color)
	e.LightEmission = 1
	e.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, tier >= 2 and 0.5 or 0.35), NumberSequenceKeypoint.new(1, 0) })
	e.Transparency = NumberSequence.new(0.1, 1)
	e.Lifetime = NumberRange.new(0.8, 1.4)
	e.Speed = NumberRange.new(2, 5)
	e.SpreadAngle = Vector2.new(40, 40)
	e.EmissionDirection = Enum.NormalId.Top
	e.Shape = Enum.ParticleEmitterShape.Cylinder
	e.ShapeStyle = Enum.ParticleEmitterShapeStyle.Surface
	e.Parent = att
	table.insert(parts, e)
	auras[model] = { tier = tier, parts = parts }
end

-- 몸을 감싸는 은은한 기운 (철포삼, 취보처럼 오래 가는 기술)
function Fx.aura(model: Model, color: Color3, dur: number)
	local shell = piece(Vector3.new(7, 7, 7), color, Enum.Material.ForceField, Enum.PartType.Ball, 0)
	local sparks = {}
	for _ = 1, 4 do
		table.insert(sparks, piece(Vector3.new(0.5, 0.5, 0.5), color, Enum.Material.Neon, Enum.PartType.Ball, 0))
	end
	local parts = { shell, table.unpack(sparks) }
	follow(model, dur, parts, function(t, cf)
		local out = { CFrame.new(cf.Position) }
		for i = 1, 4 do
			local a = t * 4 + i / 4 * math.pi * 2
			out[i + 1] = CFrame.new(cf.Position + Vector3.new(math.cos(a) * 3, ((t * 2 + i * 0.25) % 1) * 6 - 3, math.sin(a) * 3))
		end
		return out
	end, 0.4)
end

------------------------------------------------------------------------
-- 히트스톱: 맞은 순간 둘 다 멈칫. 내 몸이면 아주 잠깐 굳힌다
------------------------------------------------------------------------
local Anim: any = nil
function Fx.bindAnim(a: any)
	Anim = a
end

function Fx.hitstop(models: { Model }, secs: number)
	local me = Players.LocalPlayer.Character
	for _, m in ipairs(models) do
		if Anim then
			Anim.freeze(m, secs)
		end
		if m == me then
			local root = m:FindFirstChild("HumanoidRootPart")
			if root and root:IsA("BasePart") and not root.Anchored then
				local vel = root.AssemblyLinearVelocity
				root.Anchored = true
				task.delay(secs, function()
					if root.Parent then
						root.Anchored = false
						root.AssemblyLinearVelocity = vel
					end
				end)
			end
		end
	end
end

------------------------------------------------------------------------
-- 기술 장치 연출 (서버가 알려 준다): 소용돌이, 붉은 원, 내리찍기, 기둥, 시간 멈춤 ...
------------------------------------------------------------------------
local function groundDisc(at: Vector3, radius: number, color: Color3, trans: number, h: number?): Part
	local d = piece(Vector3.new(h or 0.2, radius * 2, radius * 2), color, Enum.Material.Neon, Enum.PartType.Cylinder, trans)
	d.CFrame = CFrame.new(at.X, at.Y - 2.4, at.Z) * CFrame.Angles(0, 0, math.rad(90))
	return d
end
local function fadeAfter(p: Instance, t: number, life: number)
	task.delay(t, function()
		if p.Parent then
			tween(p, life, { Transparency = 1 })
		end
	end)
	Debris:AddItem(p, t + life + 0.05)
end

function Fx.mech(data: any)
	local style = styleOf(data.style)
	local c = data.color or (style and style.color) or Color3.fromRGB(255, 230, 180)
	local c2 = data.color and data.color:Lerp(Color3.new(1, 1, 1), 0.5) or (style and style.color2) or Color3.new(1, 1, 1)
	local kind = data.kind
	-- 기술이 땅에 닿는 곳: 빛과 불티 (장치마다 공통)
	if data.at and (kind == "zone" or kind == "drop" or kind == "strike" or kind == "pillar" or kind == "wave" or kind == "beam" or kind == "launch") then
		local rad = data.radius or 8
		Fx.blast(data.at, c, c2, math.clamp(rad / 9, 0.8, 2.6))
		Fx.flash(data.at, c, rad * 2.8, 3.5, 0.4)
		Fx.burst("spark", data.at, c, 14, math.clamp(rad / 7, 0.9, 2.2))
		Fx.burst("glitter", data.at, c2, 8, math.clamp(rad / 9, 0.8, 1.8))
		-- 땅에 닿는 자리마다 두 겹 충격 고리 (안쪽은 밝게, 바깥은 넓게)
		Fx.ring(data.at - Vector3.new(0, 2.2, 0), c2, 1, rad * 1.6, 0.3)
		if kind == "strike" or kind == "pillar" or kind == "drop" then
			local col = piece(Vector3.new(rad * 0.5, 40, rad * 0.5), c2, Enum.Material.Neon, Enum.PartType.Cylinder, 0.35)
			col.CFrame = CFrame.new(data.at + Vector3.new(0, 18, 0)) * CFrame.Angles(0, 0, math.rad(90))
			col.Size = Vector3.new(40, rad * 0.5, rad * 0.5)
			tween(col, 0.35, { Size = Vector3.new(44, 0.2, 0.2), Transparency = 1 })
			Debris:AddItem(col, 0.4)
		end
		if kind == "drop" or kind == "wave" or kind == "launch" then
			Fx.burst("dust", data.at - Vector3.new(0, 2, 0), Color3.fromRGB(175, 160, 140), 14, math.clamp((data.radius or 8) / 10, 0.8, 2))
		end
		-- 땅이 갈라진다: 닿은 자리에서 사방으로 뻗는 금과 튀어 오르는 돌 조각
		local g = data.at - Vector3.new(0, 2.35, 0)
		for k = 0, 6 do
			local a = k / 7 * math.pi * 2 + math.random() * 0.4
			local len = rad * (0.6 + math.random() * 0.5)
			local crack = piece(Vector3.new(0.35, 0.12, len), Color3.fromRGB(35, 28, 25), Enum.Material.SmoothPlastic, nil, 0.1)
			crack.CFrame = CFrame.new(g) * CFrame.Angles(0, a, 0) * CFrame.new(0, 0, -len / 2)
			local glowLine = piece(Vector3.new(0.12, 0.14, len * 0.9), c, Enum.Material.Neon, nil, 0.2)
			glowLine.CFrame = crack.CFrame * CFrame.new(0, 0.02, 0)
			task.delay(0.6, function()
				if crack.Parent then
					tween(crack, 0.5, { Transparency = 1 })
					tween(glowLine, 0.3, { Transparency = 1 })
				end
			end)
			Debris:AddItem(crack, 1.2)
			Debris:AddItem(glowLine, 1)
		end
		Fx.debris(g + Vector3.new(0, 0.5, 0), math.clamp(math.floor(rad / 2), 4, 10), 16, Color3.fromRGB(110, 100, 90))
	end
	if kind == "zone" then
		local at, r, dur = data.at, data.radius, data.dur
		local disc = groundDisc(at, 1, c, 0.55)
		tween(disc, 0.25, { Size = Vector3.new(0.2, r * 2, r * 2) })
		fadeAfter(disc, dur, 0.3)
		local rim = groundDisc(at, r, c2, 0.3, 0.35)
		fadeAfter(rim, dur, 0.3)
		-- 둘레를 도는 조각 (물방울 / 핏방울 / 검은 티끌)
		local mat = data.fx == "water" and Enum.Material.Glass or Enum.Material.Neon
		local bits = {}
		for i = 1, 16 do
			local b = piece(Vector3.new(1, 1, 1) * (data.fx == "void" and 0.7 or 1), i % 2 == 0 and c or c2, mat, Enum.PartType.Ball, 0.15)
			table.insert(bits, b)
		end
		local start = os.clock()
		local conn: RBXScriptConnection
		conn = RunService.RenderStepped:Connect(function()
			local t = os.clock() - start
			for i, b in ipairs(bits) do
				local k = (i / #bits + t * 0.35) % 1
				local rr = data.fx == "blood" and r * (0.3 + 0.7 * ((i * 0.37) % 1)) or r * (1 - k)
				local a = i * 0.9 + t * (data.fx == "blood" and 1 or 5)
				local y = data.fx == "blood" and ((t * 2 + i * 0.3) % 1) * 5 or k * 3
				b.Position = Vector3.new(at.X + math.cos(a) * rr, at.Y - 2 + y, at.Z + math.sin(a) * rr)
			end
			if t > dur then
				conn:Disconnect()
				for _, b in ipairs(bits) do
					tween(b, 0.25, { Transparency = 1 })
					Debris:AddItem(b, 0.3)
				end
			end
		end)
		Fx.ring(at - Vector3.new(0, 2.2, 0), c, 1, r * 2, 0.4)
	elseif kind == "reflect" then
		-- 물의 장막 (몸을 감싼 유리 구슬)
		local m = data.m
		local shell = piece(Vector3.new(9, 9, 9), c2, Enum.Material.Glass, Enum.PartType.Ball, 0.6)
		local band = piece(Vector3.new(0.4, 11, 11), c, Enum.Material.Neon, Enum.PartType.Cylinder, 0.4)
		follow(m, data.dur, { shell, band }, function(t, cf)
			return { CFrame.new(cf.Position), CFrame.new(cf.Position) * CFrame.Angles(t * 2, t * 3, math.rad(90)) }
		end, 0.3)
	elseif kind == "wave" then
		local at, r = data.at, data.radius
		for k = 0, 3 do
			task.delay(k * 0.07, function()
				Fx.ring(at - Vector3.new(0, 2 - k * 0.6, 0), k % 2 == 0 and c2 or c, 3, r * 2 + k * 6, 0.55)
			end)
		end
		local dome = piece(Vector3.new(6, 6, 6), c2, Enum.Material.Glass, Enum.PartType.Ball, 0.4)
		dome.Position = at
		tween(dome, 0.4, { Size = Vector3.new(r * 2, r * 0.8, r * 2), Transparency = 1 })
		Debris:AddItem(dome, 0.45)
	elseif kind == "cone" then
		local m = data.m
		local root = m and rootPart(m)
		if not root then
			return
		end
		local range, dur = data.range, data.dur or 0.4
		task.delay(data.delay or 0, function()
			if data.fx == "fire" then
				-- 불길이 앞쪽 부채꼴로 쏟아진다
				local n = math.max(6, math.floor(dur / 0.05))
				for k = 0, n - 1 do
					task.delay(k * dur / n, function()
						local r = rootPart(m)
						if not r then
							return
						end
						local look = r.CFrame.LookVector
						local side = r.CFrame.RightVector * (math.random() * 2 - 1) * math.tan(math.rad(data.angle / 2)) * range
						local from = r.Position + Vector3.new(0, 1.4, 0) + look * 1.5
						local ball = piece(Vector3.new(1.4, 1.4, 1.4), k % 3 == 0 and Color3.fromRGB(255, 230, 120) or Color3.fromRGB(255, 120, 30), Enum.Material.Neon, Enum.PartType.Ball, 0.1)
						ball.Position = from
						tween(ball, 0.4, { Position = from + look * range + side, Size = Vector3.new(5, 5, 5), Transparency = 1 })
						Debris:AddItem(ball, 0.45)
					end)
				end
			else
				-- 포효: 앞으로 퍼져 나가는 금빛 반달 고리
				for k = 0, 3 do
					task.delay(k * 0.06, function()
						local r = rootPart(m)
						if not r then
							return
						end
						local look = r.CFrame.LookVector
						Fx.ring(r.Position + look * (3 + k * range / 5), k % 2 == 0 and c or c2, 3, 8 + k * range * 0.35, 0.4, look)
					end)
				end
				Fx.dust(root.Position - Vector3.new(0, 2.5, 0), 4)
			end
		end)
	elseif kind == "ignite" then
		-- 폭염: 불타던 적이 크게 터진다
		local at, r = data.at, data.radius or 11
		local ball = piece(Vector3.new(3, 3, 3), Color3.fromRGB(255, 220, 120), Enum.Material.Neon, Enum.PartType.Ball, 0)
		ball.Position = at
		tween(ball, 0.35, { Size = Vector3.new(r * 2, r * 2, r * 2), Transparency = 1, Color = Color3.fromRGB(255, 90, 20) })
		Debris:AddItem(ball, 0.4)
		Fx.ring(at - Vector3.new(0, 2.3, 0), c, 2, r * 2.6, 0.45)
		Fx.burst("ember", at, c, 30, 1.8)
		Fx.burst("smoke", at, Color3.fromRGB(70, 55, 50), 10, 1.6)
		Fx.text(at + Vector3.new(0, 5, 0), "폭염!", Color3.fromRGB(255, 160, 60), 34, 0.8)
		Fx.flash(at, c, 40, 6, 0.45)
		Fx.sound("heavy", 0.8, 0.8, at)
	elseif kind == "shock" then
		-- 기술 마무리 충격파: 권법 빛깔의 둥근 충격, 바깥 고리 셋, 위로 솟는 빛, 불티와 흙먼지
		local at, r = data.at, data.radius or 9
		local g = at - Vector3.new(0, 2.3, 0)
		local dome = piece(Vector3.new(3, 3, 3), c, Enum.Material.ForceField, Enum.PartType.Ball, 0)
		dome.Position = at
		tween(dome, 0.3, { Size = Vector3.new(r * 2.2, r * 1.4, r * 2.2), Transparency = 1 })
		Debris:AddItem(dome, 0.35)
		for k = 0, 2 do
			task.delay(k * 0.05, function()
				Fx.ring(g + Vector3.new(0, 0.3 + k * 0.6, 0), k == 1 and c2 or c, 2, r * (2.2 + k * 0.5), 0.4)
			end)
		end
		local col = piece(Vector3.new(26, r * 0.7, r * 0.7), c2, Enum.Material.Neon, Enum.PartType.Cylinder, 0.3)
		col.CFrame = CFrame.new(g + Vector3.new(0, 13, 0)) * CFrame.Angles(0, 0, math.rad(90))
		tween(col, 0.3, { Size = Vector3.new(30, 0.2, 0.2), Transparency = 1 })
		Debris:AddItem(col, 0.35)
		Fx.impact(at, c, 1.2)
		Fx.sound("hit", 0.7, 0.8, at)
	elseif kind == "telegraph" or kind == "mark" then
		-- 바닥의 원이 가운데부터 차오른다: 다 차면 떨어진다
		local at, r, time = data.at, data.radius, data.time or 1
		local rim = groundDisc(at, r, kind == "telegraph" and c or c2, 0.25, 0.3)
		local fill = groundDisc(at, 0.5, c, 0.55, 0.25)
		tween(fill, time, { Size = Vector3.new(0.25, r * 2, r * 2) }, Enum.EasingStyle.Linear)
		fadeAfter(rim, time, 0.15)
		fadeAfter(fill, time, 0.15)
	elseif kind == "lineTele" then
		-- 보스 돌진 길: 바닥에 붉은 띠가 차오른다
		local from, to, w, time = data.from, data.to, data.width or 8, data.time or 1
		local mid = (from + to) / 2
		local len = (to - from).Magnitude
		local cf = CFrame.lookAt(Vector3.new(mid.X, from.Y - 2.35, mid.Z), Vector3.new(to.X, from.Y - 2.35, to.Z))
		local rim = piece(Vector3.new(w, 0.25, len), c, Enum.Material.Neon, nil, 0.6)
		rim.CFrame = cf
		local fill = piece(Vector3.new(w, 0.3, 0.5), c, Enum.Material.Neon, nil, 0.35)
		fill.CFrame = cf * CFrame.new(0, 0, len / 2)
		tween(fill, time, { Size = Vector3.new(w, 0.3, len), CFrame = cf }, Enum.EasingStyle.Linear)
		fadeAfter(rim, time, 0.15)
		fadeAfter(fill, time, 0.15)
	elseif kind == "donut" then
		-- 보스에서 떨어진 고리: 안쪽은 안전 (보스 품으로 파고들어라)
		local at, r0, r1, time = data.at, data.inner, data.outer, data.time or 1
		local outer = groundDisc(at, r1, c, 0.55, 0.25)
		local safe = groundDisc(at, r0, Color3.fromRGB(120, 255, 160), 0.5, 0.3)
		local fill = groundDisc(at, r1, c, 0.8, 0.28)
		tween(fill, time, { Transparency = 0.3 }, Enum.EasingStyle.Linear)
		fadeAfter(outer, time, 0.15)
		fadeAfter(safe, time, 0.15)
		fadeAfter(fill, time, 0.15)
		Fx.text(at + Vector3.new(0, 3, 0), "안으로!", Color3.fromRGB(150, 255, 170), 28, 1)
	elseif kind == "drop" then
		-- 하늘에서 내리찍는 거대한 손바닥 (또는 그 권법의 빛)
		local at, r = data.at, data.radius
		local palm = piece(Vector3.new(r * 1.2, 2, r * 1.5), c, Enum.Material.Neon, nil, 0.2)
		palm.CFrame = CFrame.new(at + Vector3.new(0, 60, 0))
		tween(palm, 0.14, { CFrame = CFrame.new(at + Vector3.new(0, -1, 0)) }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
		fadeAfter(palm, 0.2, 0.5)
		for i = -2, 2 do
			local fg = piece(Vector3.new(r * 0.18, 1.6, r * 0.6), c2, Enum.Material.Neon, nil, 0.25)
			fg.CFrame = CFrame.new(at + Vector3.new(i * r * 0.22, 60, -r * 1.0))
			tween(fg, 0.14, { CFrame = CFrame.new(at + Vector3.new(i * r * 0.22, -1, -r * 1.0)) }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
			fadeAfter(fg, 0.2, 0.5)
		end
		task.delay(0.14, function()
			beam(at - Vector3.new(0, 2.4, 0), c2, r * 0.6, 100, 0.5)
			Fx.ring(at - Vector3.new(0, 2.2, 0), c, 3, r * 4, 0.6)
			Fx.ring(at - Vector3.new(0, 2.1, 0), c2, 2, r * 2.4, 0.5)
			Fx.dust(at - Vector3.new(0, 2.4, 0), 7)
			Fx.sound("heavy", 1, 0.5, at)
		end)
	elseif kind == "pillar" then
		-- 땅을 뚫고 솟는 용 기둥
		local at, r = data.at, data.radius
		local p = at - Vector3.new(0, 2.4, 0)
		beam(p, (data.i or 1) % 2 == 0 and c2 or c, r * 0.9, 50, 0.45)
		Fx.ring(p + Vector3.new(0, 0.3, 0), c, 1, r * 2.4, 0.4)
		Fx.dust(p, 3)
		for k = 1, 4 do
			local seg = piece(Vector3.new(1, 1, 1) * (2.2 - k * 0.3), c:Lerp(c2, k / 4), Enum.Material.Neon, Enum.PartType.Ball, 0.1)
			seg.Position = p
			tween(seg, 0.4, { Position = p + Vector3.new(math.cos(k * 1.6) * 2, 12 + k * 7, math.sin(k * 1.6) * 2), Transparency = 1 })
			Debris:AddItem(seg, 0.45)
		end
	elseif kind == "slash" then
		local a, t = data.m and rootPart(data.m), data.t and rootPart(data.t)
		if a and t then
			streak(a.Position, t.Position + (t.Position - a.Position).Unit * 4, c, 0.8, 0.3)
			Fx.afterimage(data.m, Color3.fromRGB(40, 20, 70), 0.35)
			Fx.ring(t.Position, c, 1, 9, 0.3)
		end
	elseif kind == "strike" then
		local at = data.at
		local ground = at - Vector3.new(0, 2.4, 0)
		if data.fx == "star" then
			Fx.starfall(at, data.style)
		elseif data.fx == "fire" then
			-- 하늘에서 떨어지는 불덩이 (화산탄)
			local ball = piece(Vector3.new(4, 4, 4), Color3.fromRGB(255, 140, 40), Enum.Material.Neon, Enum.PartType.Ball, 0)
			local from = ground + Vector3.new(math.random(-14, 14), 70, math.random(-14, 14))
			ball.Position = from
			tween(ball, 0.35, { Position = ground + Vector3.new(0, 1.5, 0) }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
			streak(from, ground, Color3.fromRGB(255, 90, 20), 1.6, 0.4)
			task.delay(0.35, function()
				ball:Destroy()
				sphere(ground + Vector3.new(0, 1, 0), Color3.fromRGB(255, 120, 30), 2, (data.radius or 6) * 2.2, 0.35, Enum.Material.Neon, 0.2)
				Fx.ring(ground + Vector3.new(0, 0.3, 0), Color3.fromRGB(255, 80, 20), 1, (data.radius or 6) * 2.4, 0.4)
				Fx.dust(ground, 3)
				Fx.sound("heavy", 0.8, 0.8, at)
			end)
			Debris:AddItem(ball, 0.4)
		elseif data.fx == "ice" or data.fx == "blood" or data.fx == "sand" then
			-- 땅에서 솟는 얼음 창 / 핏빛 가시 / 모래 창
			for k = 0, 6 do
				local a = k / 7 * math.pi * 2
				local p = ground + Vector3.new(math.cos(a), 0, math.sin(a)) * (k == 0 and 0 or (data.radius or 6) * 0.55)
				local spike = piece(Vector3.new(1.4, 0.5, 1.4), k % 2 == 0 and c or c2, data.fx == "ice" and Enum.Material.Glass or (data.fx == "sand" and Enum.Material.Sandstone or Enum.Material.Neon), nil, 0.1)
				spike.CFrame = CFrame.new(p) * CFrame.Angles(math.cos(a) * 0.35, 0, math.sin(a) * 0.35)
				tween(spike, 0.12, { Size = Vector3.new(1.4, k == 0 and 11 or 7, 1.4) })
				fadeAfter(spike, 0.35, 0.35)
			end
			Fx.ring(ground + Vector3.new(0, 0.3, 0), c, 1, (data.radius or 6) * 2.2, 0.35)
			Fx.sound("heavy", 0.7, 1.1, at)
		else
			Fx.lightning(ground + Vector3.new(math.random(-6, 6), 70, math.random(-6, 6)), ground, c, data.small and 0.6 or 1.6)
			if not data.small then
				Fx.lightning(ground + Vector3.new(math.random(-6, 6), 70, math.random(-6, 6)), ground, c2, 1)
				beam(ground, c2, data.radius * 0.6, 80, 0.35)
			end
			Fx.ring(ground + Vector3.new(0, 0.3, 0), c, 1, (data.radius or 5) * 2.2, 0.3)
			Fx.sound("heavy", data.small and 0.4 or 0.8, 1.3, at)
		end
	elseif kind == "stormcloud" then
		local cloud = piece(Vector3.new(3, (data.radius or 20) * 2, (data.radius or 20) * 2), Color3.fromRGB(45, 45, 65), Enum.Material.SmoothPlastic, Enum.PartType.Cylinder, 0.45)
		follow(data.m, data.dur, { cloud }, function(t, cf)
			return { CFrame.new(cf.Position + Vector3.new(0, 50, 0)) * CFrame.Angles(t * 0.5, 0, math.rad(90)) }
		end, 0.4)
	elseif kind == "freeze" then
		-- 시간이 멈춘다: 잿빛 돔, 멈춘 적은 유리에 갇힌다
		local at, r = data.at, data.radius
		local dome = piece(Vector3.new(4, 4, 4), Color3.fromRGB(220, 220, 235), Enum.Material.Glass, Enum.PartType.Ball, 0.5)
		dome.Position = at
		tween(dome, 0.35, { Size = Vector3.new(r * 2, r * 1.2, r * 2) })
		fadeAfter(dome, data.dur * 0.7, 0.3)
		Fx.ring(at - Vector3.new(0, 2.2, 0), Color3.new(1, 1, 1), 2, r * 2, 0.5)
		for _, m in ipairs(data.targets or {}) do
			local tr = rootPart(m)
			if tr then
				local box = piece(Vector3.new(4.5, 7, 4.5), Color3.fromRGB(200, 220, 255), Enum.Material.Glass, nil, 0.45)
				box.CFrame = tr.CFrame * CFrame.new(0, 0.5, 0)
				fadeAfter(box, data.dur * 0.6, 0.2)
			end
		end
		Fx.sound("deflect", 0.8, 0.5, at)
	elseif kind == "erase" then
		local tr = data.t and rootPart(data.t)
		if tr then
			sphere(tr.Position, Color3.new(1, 1, 1), 2, 14, 0.35, Enum.Material.Neon, 0.2)
			Fx.ring(tr.Position, c, 1, 16, 0.35)
			Fx.spark(tr.Position, Color3.new(1, 1, 1), 2, 10)
		end
	elseif kind == "launch" then
		local at, r = data.at, data.radius
		for k = 0, 4 do
			task.delay(k * 0.06, function()
				Fx.ring(at - Vector3.new(0, 2 - k * 4, 0), k % 2 == 0 and c or c2, 2, r * 2 - k * 4, 0.45)
			end)
		end
		for _ = 1, 14 do
			local a = math.random() * math.pi * 2
			local p = at + Vector3.new(math.cos(a) * r * math.random(), -2, math.sin(a) * r * math.random())
			streak(p, p + Vector3.new(0, 26, 0), c2, 0.5, 0.4)
		end
	elseif kind == "beam" then
		local at, r = data.at, data.radius
		beam(at - Vector3.new(0, 2.4, 0), Color3.new(1, 1, 1), r * 0.6, 160, 0.6)
		beam(at - Vector3.new(0, 2.4, 0), c, r * 1.0, 160, 0.45)
		Fx.ring(at - Vector3.new(0, 2.2, 0), c, 4, r * 3, 0.6)
		Fx.dust(at - Vector3.new(0, 2.4, 0), 8)
	elseif kind == "moving" then
		-- 몸을 따라다니는 꽃잎 폭풍
		local bits = {}
		for i = 1, 26 do
			table.insert(bits, piece(Vector3.new(1, 0.1, 0.7), i % 3 == 0 and Color3.fromRGB(255, 240, 245) or (i % 2 == 0 and c or c2), Enum.Material.SmoothPlastic, nil, 0.05))
		end
		local r = data.radius
		follow(data.m, data.dur, bits, function(t, cf)
			local out = {}
			for i = 1, #bits do
				local a = t * 7 + i / #bits * math.pi * 2
				local rr = r * (0.4 + 0.6 * ((i * 0.53) % 1))
				out[i] = CFrame.new(cf.Position + Vector3.new(math.cos(a) * rr, math.sin(t * 4 + i) * 2.5, math.sin(a) * rr)) * CFrame.Angles(a, t * 5, 0)
			end
			return out
		end, 0.3)
	elseif kind == "trail" then
		-- 지나간 길이 터진다: 매화는 꽃잎, 바람은 칼바람, 바다는 물기둥, 그 밖엔 기운의 폭발
		local fxk = data.fx or (style and style.fx)
		for i, p in ipairs(data.points or {}) do
			task.delay(i * 0.05, function()
				local rad = data.radius or 6
				local g = p - Vector3.new(0, 2.2, 0)
				if fxk == "petal" then
					Fx.bloom(p - Vector3.new(0, 1.5, 0), rad)
				elseif fxk == "tide" or fxk == "ocean" then
					local col = piece(Vector3.new(14, rad * 1.1, rad * 1.1), c2, Enum.Material.Glass, Enum.PartType.Cylinder, 0.25)
					col.CFrame = CFrame.new(g + Vector3.new(0, 7, 0)) * CFrame.Angles(0, 0, math.rad(90))
					tween(col, 0.35, { Size = Vector3.new(18, 0.4, 0.4), Transparency = 1 })
					Debris:AddItem(col, 0.4)
					Fx.burst("glitter", p, c2, 10, 1.2)
				elseif fxk == "fire" then
					local col = piece(Vector3.new(16, rad * 1.1, rad * 1.1), Color3.fromRGB(255, 140, 40), Enum.Material.Neon, Enum.PartType.Cylinder, 0.2)
					col.CFrame = CFrame.new(g + Vector3.new(0, 8, 0)) * CFrame.Angles(0, 0, math.rad(90))
					tween(col, 0.4, { Size = Vector3.new(20, 0.4, 0.4), Transparency = 1 })
					Debris:AddItem(col, 0.45)
					Fx.burst("ember", p, c, 14, 1.3)
				elseif fxk == "wind" then
					for k = 0, 2 do
						local blade = piece(Vector3.new(rad * 1.8, 0.15, 0.6), c2, Enum.Material.Neon, nil, 0.1)
						blade.CFrame = CFrame.new(p) * CFrame.Angles(0, k * 1.05 + i, math.rad(20))
						tween(blade, 0.25, { Size = Vector3.new(rad * 2.6, 0.05, 0.1), Transparency = 1 })
						Debris:AddItem(blade, 0.3)
					end
				else
					Fx.impact(p, c, 0.8)
				end
				Fx.ring(g, c, 1, rad * 2.2, 0.35)
			end)
		end
	end
end

------------------------------------------------------------------------
-- 고급 연출: 모든 기술이 함께 쓰는 바탕 (불티·연기·흙먼지 입자, 터지는 빛, 튀는 돌 조각)
-- 기술 자체는 그대로, 맞는 순간·터지는 순간의 질감만 올린다
------------------------------------------------------------------------
local TEX_SPARK = "rbxasset://textures/particles/sparkles_main.dds"
local TEX_SMOKE = "rbxasset://textures/particles/smoke_main.dds"
local TEX_FIRE = "rbxasset://textures/particles/fire_main.dds"
local BURST_KINDS: { [string]: any } = {
	-- 날카로운 불티: 빠르게 튀었다가 금방 진다
	spark = { tex = TEX_SPARK, life = { 0.18, 0.42 }, speed = { 22, 48 }, size = { 0.55, 0 }, drag = 7, light = 1, trans = { 0, 1 }, spread = 180 },
	-- 떠오르는 불씨
	ember = { tex = TEX_FIRE, life = { 0.5, 1.1 }, speed = { 4, 12 }, size = { 0.7, 0 }, drag = 2, light = 1, trans = { 0.1, 1 }, spread = 180, accel = Vector3.new(0, 10, 0) },
	-- 피어오르는 연기 (부드럽게 커지며 사라진다)
	smoke = { tex = TEX_SMOKE, life = { 0.9, 1.7 }, speed = { 3, 9 }, size = { 2, 7 }, drag = 3, light = 0, trans = { 0.45, 1 }, spread = 180, rot = 60 },
	-- 땅을 따라 퍼지는 흙먼지
	dust = { tex = TEX_SMOKE, life = { 0.7, 1.3 }, speed = { 14, 30 }, size = { 1.6, 5.5 }, drag = 5, light = 0, trans = { 0.35, 1 }, spread = 90, rot = 40 },
	-- 빛 가루 (오의의 여운)
	glitter = { tex = TEX_SPARK, life = { 0.6, 1.4 }, speed = { 6, 18 }, size = { 0.45, 0 }, drag = 3, light = 1, trans = { 0, 1 }, spread = 180, accel = Vector3.new(0, 3, 0) },
}
local burstFolder = Instance.new("Folder")
burstFolder.Name = "KwonBursts"
burstFolder.Parent = workspace
local burstPool: { [string]: { list: { ParticleEmitter }, i: number } } = {}
local function emitterFor(kind: string): ParticleEmitter?
	local def = BURST_KINDS[kind]
	if not def then
		return nil
	end
	local pool = burstPool[kind]
	if not pool then
		pool = { list = {}, i = 0 }
		for _ = 1, 6 do
			local holder = Instance.new("Part")
			holder.Anchored = true
			holder.CanCollide = false
			holder.CanQuery = false
			holder.CanTouch = false
			holder.Transparency = 1
			holder.Size = Vector3.new(0.2, 0.2, 0.2)
			holder.Parent = burstFolder
			local e = Instance.new("ParticleEmitter")
			e.Texture = def.tex
			e.Rate = 0
			e.Lifetime = NumberRange.new(def.life[1], def.life[2])
			e.Speed = NumberRange.new(def.speed[1], def.speed[2])
			e.Size = NumberSequence.new(def.size[1], def.size[2])
			e.Transparency = NumberSequence.new(def.trans[1], def.trans[2])
			e.Drag = def.drag
			e.LightEmission = def.light
			e.SpreadAngle = Vector2.new(def.spread, def.spread)
			e.Acceleration = def.accel or Vector3.zero
			e.Rotation = NumberRange.new(0, 360)
			e.RotSpeed = NumberRange.new(-(def.rot or 0), def.rot or 0)
			e.EmissionDirection = Enum.NormalId.Top
			e.Parent = holder
			table.insert(pool.list, e)
		end
		burstPool[kind] = pool
	end
	pool.i = pool.i % #pool.list + 1
	return pool.list[pool.i]
end
function Fx.burst(kind: string, pos: Vector3, color: Color3, n: number, scale: number?)
	local e = emitterFor(kind)
	if not e then
		return
	end
	local def = BURST_KINDS[kind]
	local k = scale or 1
	local holder = e.Parent :: BasePart
	holder.CFrame = CFrame.new(pos)
	e.Color = ColorSequence.new(color, color:Lerp(Color3.new(1, 1, 1), def.light > 0 and 0.5 or 0.15))
	e.Size = NumberSequence.new(def.size[1] * k, def.size[2] * k)
	e.Speed = NumberRange.new(def.speed[1] * math.sqrt(k), def.speed[2] * math.sqrt(k))
	pcall(function()
		e:Emit(math.max(1, math.floor(n)))
	end)
end

-- 터지는 빛: 맞은 자리 둘레를 잠깐 실제로 밝힌다 (미래 조명이라 그림자까지 진다)
local flashPool: { PointLight } = {}
local flashIdx = 0
function Fx.flash(pos: Vector3, color: Color3, range: number, brightness: number, life: number)
	if #flashPool < 8 then
		local holder = Instance.new("Part")
		holder.Anchored = true
		holder.CanCollide = false
		holder.CanQuery = false
		holder.CanTouch = false
		holder.Transparency = 1
		holder.Size = Vector3.new(0.2, 0.2, 0.2)
		holder.Parent = burstFolder
		local l = Instance.new("PointLight")
		l.Brightness = 0
		l.Shadows = false
		l.Parent = holder
		table.insert(flashPool, l)
	end
	flashIdx = flashIdx % #flashPool + 1
	local l = flashPool[flashIdx]
	local holder = l.Parent :: BasePart
	holder.CFrame = CFrame.new(pos)
	l.Color = color
	l.Range = math.min(60, range)
	l.Brightness = brightness
	TweenService:Create(l, TweenInfo.new(life, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Brightness = 0 }):Play()
end

-- 튀는 돌 조각: 포물선을 그리며 날아갔다가 떨어져 사라진다
function Fx.debris(pos: Vector3, n: number, power: number, color: Color3?)
	local ground = color or Color3.fromRGB(120, 110, 100)
	for _ = 1, n do
		local s = 0.4 + math.random() * 0.9
		local chunk = piece(Vector3.new(s, s * 0.7, s * 0.9), ground:Lerp(Color3.new(0, 0, 0), math.random() * 0.3), Enum.Material.Slate, nil, 0)
		chunk.CFrame = CFrame.new(pos) * CFrame.Angles(math.random() * 6, math.random() * 6, math.random() * 6)
		local a = math.random() * math.pi * 2
		local out = Vector3.new(math.cos(a), 0, math.sin(a)) * power * (0.5 + math.random() * 0.6)
		local peak = pos + out * 0.5 + Vector3.new(0, power * (0.4 + math.random() * 0.4), 0)
		local land = pos + out + Vector3.new(0, -0.5, 0)
		local spin = CFrame.Angles(math.random() * 6, math.random() * 6, math.random() * 6)
		TweenService:Create(chunk, TweenInfo.new(0.22, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { CFrame = CFrame.new(peak) * spin }):Play()
		task.delay(0.22, function()
			if chunk.Parent then
				TweenService:Create(chunk, TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { CFrame = CFrame.new(land) * spin * spin }):Play()
			end
		end)
		task.delay(0.7, function()
			if chunk.Parent then
				TweenService:Create(chunk, TweenInfo.new(0.4), { Transparency = 1, Size = chunk.Size * 0.5 }):Play()
			end
		end)
		Debris:AddItem(chunk, 1.15)
	end
end

-- 겹겹의 폭발 (기술이 맞거나 땅에 닿는 자리): 흰 심이 번쩍 → 권법 빛깔 구가 부풀고 →
-- 사방으로 뾰족한 충격선이 튀고 → 불티·빛 가루·불씨·연기가 차례로 흩어진다
function Fx.blast(pos: Vector3, color: Color3, color2: Color3, scale: number?)
	local k = math.clamp(scale or 1, 0.6, 3)
	local core = piece(Vector3.new(1, 1, 1) * k, Color3.new(1, 1, 1), Enum.Material.Neon, Enum.PartType.Ball, 0)
	core.Position = pos
	tween(core, 0.09, { Size = Vector3.new(4, 4, 4) * k })
	task.delay(0.09, function()
		if core.Parent then
			tween(core, 0.16, { Size = Vector3.new(5.5, 5.5, 5.5) * k, Transparency = 1, Color = color2 })
		end
	end)
	Debris:AddItem(core, 0.3)
	local shell = piece(Vector3.new(2, 2, 2) * k, color, Enum.Material.Glass, Enum.PartType.Ball, 0.35)
	shell.Position = pos
	tween(shell, 0.3, { Size = Vector3.new(9, 9, 9) * k, Transparency = 1 })
	Debris:AddItem(shell, 0.32)
	-- 충격선: 가운데에서 바깥으로 뻗었다가 끝이 가늘어지며 사라진다
	for i = 1, math.floor(8 + 4 * k) do
		local d = Vector3.new(math.random() - 0.5, (math.random() - 0.3) * 0.8, math.random() - 0.5)
		if d.Magnitude < 0.05 then
			d = Vector3.new(1, 0, 0)
		end
		d = d.Unit
		local len = (3 + math.random() * 4) * k
		local spike = piece(Vector3.new(0.35, 0.35, 0.4) * k, i % 3 == 0 and Color3.new(1, 1, 1) or (i % 2 == 0 and color2 or color), Enum.Material.Neon, nil, 0)
		spike.CFrame = CFrame.lookAt(pos, pos + d)
		tween(spike, 0.1, { Size = Vector3.new(0.3 * k, 0.3 * k, len), CFrame = CFrame.lookAt(pos + d * len / 2, pos + d * len) })
		task.delay(0.1, function()
			if spike.Parent then
				tween(spike, 0.14, { Size = Vector3.new(0.02, 0.02, len * 1.3), Transparency = 1, CFrame = CFrame.lookAt(pos + d * len, pos + d * len * 2) })
			end
		end)
		Debris:AddItem(spike, 0.28)
	end
	Fx.burst("spark", pos, color2, 16 * k, 1 + k * 0.4)
	Fx.burst("glitter", pos, color, 10 * k, 0.8 + k * 0.3)
	Fx.burst("ember", pos, color, 6 * k, 0.8 + k * 0.2)
	if k >= 1.3 then
		Fx.burst("smoke", pos, color:Lerp(Color3.fromRGB(60, 55, 55), 0.6), 4 * k, k * 0.7)
	end
	Fx.flash(pos, color, 20 + 14 * k, 4 + k, 0.3)
end

-- 기술을 쓰는 동안 몸에서 타오르는 기운 (권법 빛깔의 불꽃 + 발밑에서 솟는 빛 가루 + 빛)
function Fx.skillAura(model: Model, color: Color3, color2: Color3, dur: number, strong: boolean?)
	local torso = model:FindFirstChild("UpperTorso") or model:FindFirstChild("HumanoidRootPart")
	if not torso or not torso:IsA("BasePart") then
		return
	end
	local att = Instance.new("Attachment")
	att.Parent = torso
	local flame = Instance.new("ParticleEmitter")
	flame.Texture = TEX_FIRE_AURA
	flame.LightEmission = 1
	flame.Color = ColorSequence.new(color2, color)
	flame.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, strong and 2.4 or 1.6), NumberSequenceKeypoint.new(1, 0) })
	flame.Transparency = NumberSequence.new(0.2, 1)
	flame.Lifetime = NumberRange.new(0.35, 0.7)
	flame.Speed = NumberRange.new(2, 5)
	flame.SpreadAngle = Vector2.new(40, 40)
	flame.Acceleration = Vector3.new(0, 14, 0)
	flame.Rate = strong and 90 or 55
	flame.Rotation = NumberRange.new(0, 360)
	flame.RotSpeed = NumberRange.new(-90, 90)
	flame.Parent = att
	local dust = Instance.new("ParticleEmitter")
	dust.Texture = TEX_SPARK_AURA
	dust.LightEmission = 1
	dust.Color = ColorSequence.new(color2)
	dust.Size = NumberSequence.new(0.5, 0)
	dust.Lifetime = NumberRange.new(0.6, 1)
	dust.Speed = NumberRange.new(3, 7)
	dust.SpreadAngle = Vector2.new(180, 180)
	dust.Rate = strong and 40 or 20
	dust.Parent = att
	local glow = Instance.new("PointLight")
	glow.Color = color
	glow.Range = strong and 18 or 12
	glow.Brightness = strong and 2.5 or 1.6
	glow.Parent = torso
	task.delay(dur, function()
		flame.Enabled = false
		dust.Enabled = false
		tween(glow, 0.3, { Brightness = 0 })
		Debris:AddItem(att, 1)
		Debris:AddItem(glow, 0.35)
	end)
end

-- 큰 충격: 불티 + 빛 + (크면) 흙먼지 고리 · 돌 조각 · 연기
function Fx.impact(pos: Vector3, color: Color3, scale: number?)
	local k = scale or 1
	Fx.burst("spark", pos, color, 10 * k, math.min(2, 0.8 + k * 0.4))
	Fx.flash(pos, color, 14 + 10 * k, 3 + k, 0.25 + 0.1 * k)
	if k >= 1 then
		local g = pos - Vector3.new(0, 2.2, 0)
		Fx.burst("dust", g, Color3.fromRGB(170, 155, 135), 10 * k, k)
		Fx.debris(g, math.floor(4 + 3 * k), 10 + 6 * k)
	end
	if k >= 2 then
		Fx.burst("smoke", pos, Color3.fromRGB(90, 85, 85), 6 * k, k * 0.8)
		Fx.burst("ember", pos, color, 8 * k, 1)
	end
end

-- 연소: 불붙은 몸에서 불꽃이 피어오른다 (꺼지면 걷는다)
function Fx.burning(model: Model, on: boolean)
	local torso = model:FindFirstChild("UpperTorso") or model:FindFirstChild("Torso") or model:FindFirstChild("HumanoidRootPart")
	if not torso or not torso:IsA("BasePart") then
		return
	end
	local old = torso:FindFirstChild("KwonBurn")
	if old then
		old:Destroy()
	end
	if not on then
		return
	end
	local e = Instance.new("ParticleEmitter")
	e.Name = "KwonBurn"
	e.Texture = "rbxasset://textures/particles/fire_main.dds"
	e.Color = ColorSequence.new(Color3.fromRGB(255, 200, 90), Color3.fromRGB(255, 80, 20))
	e.LightEmission = 1
	e.Size = NumberSequence.new(1.8, 0.3)
	e.Transparency = NumberSequence.new(0.2, 1)
	e.Lifetime = NumberRange.new(0.4, 0.7)
	e.Speed = NumberRange.new(2, 5)
	e.Acceleration = Vector3.new(0, 10, 0)
	e.SpreadAngle = Vector2.new(40, 40)
	e.Rate = 30
	e.Parent = torso
end

return Fx
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="29">
          <Properties>
            <string name="Name">Gacha</string>
            <string name="Source"><![CDATA[-- 권왕: 심법 뽑기 연출. 두루마리가 떨리며 빛나고 (가장 높은 등급의 빛깔), 터진 뒤 카드가 한 장씩 뒤집힌다
-- 화면을 누르면 바로 끝까지 보여 준다
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local Config = require(ReplicatedStorage:WaitForChild("Config"))

local Gacha = {}
Gacha.active = false

local player = Players.LocalPlayer

local function tween(inst: Instance, time: number, goal: { [string]: any }, style: Enum.EasingStyle?)
	local tw = TweenService:Create(inst, TweenInfo.new(time, style or Enum.EasingStyle.Quad, Enum.EasingDirection.Out), goal)
	tw:Play()
	return tw
end

local function new(class: string, props: { [string]: any }): any
	local inst = Instance.new(class)
	for k, v in pairs(props) do
		if k ~= "Parent" then
			(inst :: any)[k] = v
		end
	end
	inst.Parent = props.Parent
	return inst
end

local function round(parent: Instance, r: number)
	new("UICorner", { CornerRadius = UDim.new(0, r), Parent = parent })
end

-- 천상: 무지개 빛깔이 돈다
local RAINBOW = ColorSequence.new({
	ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 120, 160)),
	ColorSequenceKeypoint.new(0.25, Color3.fromRGB(255, 230, 120)),
	ColorSequenceKeypoint.new(0.5, Color3.fromRGB(140, 255, 200)),
	ColorSequenceKeypoint.new(0.75, Color3.fromRGB(130, 200, 255)),
	ColorSequenceKeypoint.new(1, Color3.fromRGB(220, 150, 255)),
})

local function card(parent: Instance, res: any, size: Vector2): Frame
	local m = Config.MANUAL_BY_ID[res.id]
	local R = Config.MANUAL_RARITY[res.r] or Config.MANUAL_RARITY[1]
	local high = res.r >= 4
	local c = new("Frame", { Size = UDim2.fromOffset(size.X, size.Y), BackgroundColor3 = Color3.fromRGB(24, 18, 16), Parent = parent })
	round(c, 12)
	local stroke = new("UIStroke", { Color = R.color, Thickness = high and 4 or 2, Parent = c })
	new("UIGradient", { Rotation = 90, Color = ColorSequence.new(R.color:Lerp(Color3.new(0, 0, 0), 0.55), Color3.fromRGB(20, 14, 12)), Parent = c })
	if R.heavenly then
		local g = new("UIGradient", { Color = RAINBOW, Parent = stroke })
		task.spawn(function()
			while g.Parent do
				g.Rotation = (g.Rotation + 4) % 360
				RunService.RenderStepped:Wait()
			end
		end)
	end
	local s = size.Y / 300
	new("TextLabel", { BackgroundTransparency = 1, Position = UDim2.new(0, 0, 0, 10 * s), Size = UDim2.new(1, 0, 0, 30 * s), Font = Enum.Font.GothamBlack, TextScaled = true, TextColor3 = R.color, Text = R.name, Parent = c })
	new("TextLabel", { BackgroundTransparency = 1, Position = UDim2.new(0, 0, 0, 50 * s), Size = UDim2.new(1, 0, 0, 110 * s), Font = Enum.Font.GothamBlack, TextScaled = true, Text = m and m.icon or "📜", Parent = c })
	new("TextLabel", { BackgroundTransparency = 1, Position = UDim2.new(0.05, 0, 0, 170 * s), Size = UDim2.new(0.9, 0, 0, 36 * s), Font = Enum.Font.GothamBlack, TextScaled = true, TextColor3 = Color3.new(1, 1, 1), Text = m and m.name or "", Parent = c })
	new("TextLabel", { BackgroundTransparency = 1, Position = UDim2.new(0.05, 0, 0, 210 * s), Size = UDim2.new(0.9, 0, 0, 30 * s), Font = Enum.Font.GothamBold, TextScaled = true, TextColor3 = Color3.fromRGB(230, 220, 200),
		Text = m and string.format("%s +%.1f%%", m.desc, Config.manualValue(res.id, res.r) * 100) or "", Parent = c })
	local tag = res.refund and ("💰 +" .. Config.formatNumber(res.refund)) or (res.up and "⬆ 등급 상승" or "✨ 새로 얻음")
	new("TextLabel", { BackgroundTransparency = 1, Position = UDim2.new(0, 0, 1, -44 * s), Size = UDim2.new(1, 0, 0, 30 * s), Font = Enum.Font.GothamBold, TextScaled = true,
		TextColor3 = res.refund and Color3.fromRGB(200, 190, 170) or Color3.fromRGB(255, 225, 140), Text = tag, Parent = c })
	return c
end

function Gacha.play(results: { any }, onDone: (() -> ())?)
	if Gacha.active or #results == 0 then
		return
	end
	Gacha.active = true
	local best = 1
	for _, res in ipairs(results) do
		best = math.max(best, res.r or 1)
	end
	local B = Config.MANUAL_RARITY[best]
	local gui = new("ScreenGui", { Name = "KwonGacha", ResetOnSpawn = false, IgnoreGuiInset = true, DisplayOrder = 60, Parent = player:WaitForChild("PlayerGui") })
	local bg = new("TextButton", { Text = "", AutoButtonColor = false, BackgroundColor3 = Color3.fromRGB(6, 4, 10), BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Parent = gui })
	local skip = false
	bg.Activated:Connect(function()
		skip = true
	end)
	tween(bg, 0.3, { BackgroundTransparency = 0.08 })
	local function pause(sec: number)
		local t = os.clock()
		while os.clock() - t < sec and not skip do
			RunService.RenderStepped:Wait()
		end
	end

	-- 1) 두루마리: 떨리며 빛이 차오른다
	local center = new("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(150, 150), BackgroundColor3 = Color3.new(1, 1, 1), BackgroundTransparency = 0.6, Parent = bg })
	round(center, 75)
	local glow = new("UIStroke", { Color = Color3.new(1, 1, 1), Thickness = 4, Parent = center })
	new("TextLabel", { BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Font = Enum.Font.GothamBlack, TextScaled = true, Text = "📜", Parent = center })
	local rays: { Frame } = {}
	for k = 1, 12 do
		local ray = new("Frame", { AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(6, 0), Rotation = k * 30, BackgroundColor3 = B.color, BackgroundTransparency = 0.3, BorderSizePixel = 0, ZIndex = 0, Parent = bg })
		table.insert(rays, ray)
	end
	local title = new("TextLabel", { BackgroundTransparency = 1, AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0.5, 100), Size = UDim2.fromOffset(500, 40), Font = Enum.Font.GothamBlack, TextScaled = true, TextColor3 = Color3.fromRGB(255, 230, 180), Text = "심법을 펼친다...", Parent = bg })
	local t0 = os.clock()
	local shaking = true
	task.spawn(function()
		while shaking and center.Parent do
			local k = math.clamp((os.clock() - t0) / 1.6, 0, 1)
			local amp = math.floor(2 + k * 8)
			center.Position = UDim2.new(0.5, math.random(-amp, amp), 0.5, math.random(-amp, amp))
			center.Rotation = math.random(-6, 6) * k
			RunService.RenderStepped:Wait()
		end
	end)
	-- 처음엔 흰빛, 반쯤에서 가장 높은 등급의 빛깔로
	pause(0.7)
	tween(center, 0.5, { BackgroundColor3 = B.color, BackgroundTransparency = 0.2, Size = UDim2.fromOffset(190, 190) })
	glow.Color = B.color
	if best >= 4 then
		title.Text = best >= 6 and "하늘이 열린다!" or (best >= 5 and "전설을 넘어선 빛!" or "황금빛이 번진다!")
		title.TextColor3 = B.color
		for _, ray in ipairs(rays) do
			tween(ray, 0.6, { Size = UDim2.fromOffset(best >= 5 and 10 or 6, 900) })
		end
		if B.heavenly then
			new("UIGradient", { Color = RAINBOW, Parent = glow })
		end
	end
	pause(best >= 4 and 1.2 or 0.7)
	shaking = false

	-- 2) 터진다
	local flash = new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = best >= 4 and B.color:Lerp(Color3.new(1, 1, 1), 0.6) or Color3.new(1, 1, 1), BackgroundTransparency = skip and 1 or 0, ZIndex = 5, Parent = bg })
	tween(flash, 0.5, { BackgroundTransparency = 1 })
	center:Destroy()
	title.Text = ""
	for _, ray in ipairs(rays) do
		ray:Destroy()
	end

	-- 3) 카드가 한 장씩
	local one = #results == 1
	local size = one and Vector2.new(240, 330) or Vector2.new(150, 206)
	local grid = new("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.47), Size = UDim2.fromOffset(one and size.X or (size.X + 12) * 5, one and size.Y or (size.Y + 12) * 2), BackgroundTransparency = 1, Parent = bg })
	new("UIGridLayout", { CellSize = UDim2.fromOffset(size.X, size.Y), CellPadding = UDim2.fromOffset(12, 12), HorizontalAlignment = Enum.HorizontalAlignment.Center, Parent = grid })
	-- 작은 화면이면 줄인다
	local vp = workspace.CurrentCamera and workspace.CurrentCamera.ViewportSize or Vector2.new(1280, 720)
	local sc = math.min(1, (vp.X * 0.94) / grid.Size.X.Offset, (vp.Y * 0.75) / grid.Size.Y.Offset)
	new("UIScale", { Scale = sc, Parent = grid })
	for _, res in ipairs(results) do
		local c = card(grid, res, size)
		local us = new("UIScale", { Scale = skip and 1 or 0, Parent = c })
		if not skip then
			tween(us, 0.25, { Scale = 1 }, Enum.EasingStyle.Back)
			pause(res.r >= 4 and 0.45 or 0.12)
		end
	end
	local ok = new("TextButton", { AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -30), Size = UDim2.fromOffset(220, 54), BackgroundColor3 = Color3.fromRGB(235, 190, 80), TextColor3 = Color3.fromRGB(30, 20, 10),
		Font = Enum.Font.GothamBlack, TextScaled = true, Text = "확인", Parent = bg })
	round(ok, 12)
	ok.Activated:Connect(function()
		gui:Destroy()
		Gacha.active = false
		if onDone then
			onDone()
		end
	end)
end

return Gacha
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="30">
          <Properties>
            <string name="Name">Geuk</string>
            <string name="Source"><![CDATA[-- 권왕 3.1판: 극 권법 (극 일월신권) 의 기술과 일월극변 (화면)
-- 해: 주홍빛 심과 금빛 빛살 · 달: 푸른 흰빛 초승달 · 황혼: 노을빛 주홍과 보랏빛이 겹친다
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local Fx = require(script.Parent:WaitForChild("Fx"))

local Geuk = {}

local folder = Instance.new("Folder")
folder.Name = "KwonGeuk"
folder.Parent = workspace

local opts: any = {}
function Geuk.init(o: any)
	opts = o or {}
end

local SUN = Color3.fromRGB(255, 170, 50)
local SUN_CORE = Color3.fromRGB(255, 245, 200)
local MOON = Color3.fromRGB(205, 220, 255)
local DUSK = Color3.fromRGB(255, 120, 60)
local DUSK2 = Color3.fromRGB(165, 95, 235)
local WHITE = Color3.new(1, 1, 1)
local DARK = Color3.fromRGB(20, 14, 30)

local function tween(inst: Instance, time: number, goal: { [string]: any }, style: Enum.EasingStyle?, dir: Enum.EasingDirection?)
	local tw = TweenService:Create(inst, TweenInfo.new(math.max(0.01, time), style or Enum.EasingStyle.Quad, dir or Enum.EasingDirection.Out), goal)
	tw:Play()
	return tw
end
local function near(pos: Vector3, d: number): boolean
	local cam = workspace.CurrentCamera
	return cam ~= nil and (cam.CFrame.Position - pos).Magnitude < d
end
local function ground(at: Vector3): Vector3
	return Vector3.new(at.X, at.Y - 2.7, at.Z)
end
local function part(size: Vector3, color: Color3, material: Enum.Material?, alpha: number?, shape: string?): BasePart
	local q = Instance.new("Part")
	if shape == "ball" then
		q.Shape = Enum.PartType.Ball
	elseif shape == "cyl" then
		q.Shape = Enum.PartType.Cylinder
	end
	q.Anchored = true
	q.CanCollide = false
	q.CanQuery = false
	q.CanTouch = false
	q.CastShadow = false
	q.Size = size
	q.Color = color
	q.Material = material or Enum.Material.Neon
	q.Transparency = alpha or 0
	q.Parent = folder
	return q
end
local function fadeOut(p: BasePart, time: number, goal: { [string]: any }?)
	local g = goal or {}
	g.Transparency = 1
	tween(p, time, g)
	task.delay(time + 0.05, function()
		p:Destroy()
	end)
end
local function shakeNear(pos: Vector3, amount: number, range: number)
	if opts.shake and near(pos, range) then
		opts.shake(amount)
	end
end
local function anim(life: number, fn: (number) -> ())
	local t0 = os.clock()
	local conn: RBXScriptConnection
	conn = RunService.Heartbeat:Connect(function()
		local u = math.clamp((os.clock() - t0) / life, 0, 1)
		fn(u)
		if u >= 1 then
			conn:Disconnect()
		end
	end)
end
local function rootOf(m: any): BasePart?
	local r = typeof(m) == "Instance" and m:FindFirstChild("HumanoidRootPart")
	return (r and r:IsA("BasePart")) and r or nil
end
local function flat(v: Vector3): Vector3
	local f = Vector3.new(v.X, 0, v.Z)
	return f.Magnitude > 1e-3 and f.Unit or Vector3.new(0, 0, -1)
end
local function safeLook(from: Vector3, to: Vector3): CFrame
	if (to - from).Magnitude < 1e-3 then
		return CFrame.new(from)
	end
	return CFrame.lookAt(from, to)
end

-- 덩이 (조각 + 덩이 안의 자리)
type Group = { items: { { any } } }
local function group(): Group
	return { items = {} }
end
local function gpart(g: Group, size: Vector3, color: Color3, mat: Enum.Material?, alpha: number?, shape: string?, off: CFrame): BasePart
	local p = part(size, color, mat, alpha, shape)
	p:SetAttribute("A0", alpha or 0)
	table.insert(g.items, { p, off })
	return p
end
local function gset(g: Group, cf: CFrame)
	for _, it in ipairs(g.items) do
		local p = it[1] :: BasePart
		if p.Parent then
			p.CFrame = cf * (it[2] :: CFrame)
		end
	end
end
local function gfade(g: Group, time: number)
	for _, it in ipairs(g.items) do
		local p = it[1] :: BasePart
		if p.Parent then
			fadeOut(p, time)
		end
	end
end
local function galpha(g: Group, k: number)
	for _, it in ipairs(g.items) do
		local p = it[1] :: BasePart
		if p.Parent then
			p.Transparency = math.clamp(math.max(k, p:GetAttribute("A0") or 0), 0, 1)
		end
	end
end

-- 해: 흰 심, 주홍 몸, 둘레의 금빛 빛살 열둘, 바깥의 흐린 빛
local function sunGroup(R: number, color: Color3?): Group
	local g = group()
	local c = color or SUN
	gpart(g, Vector3.new(R * 1.2, R * 1.2, R * 1.2), SUN_CORE, Enum.Material.Neon, 0, "ball", CFrame.new())
	gpart(g, Vector3.new(R * 2, R * 2, R * 2), c, Enum.Material.Neon, 0.15, "ball", CFrame.new())
	gpart(g, Vector3.new(R * 3, R * 3, R * 3), c, Enum.Material.Neon, 0.75, "ball", CFrame.new())
	for k = 0, 11 do
		local a = k / 12 * math.pi * 2
		gpart(g, Vector3.new(R * 0.18, R * (k % 2 == 0 and 1.4 or 0.9), R * 0.18), c:Lerp(WHITE, 0.3), Enum.Material.Neon, 0.1, nil, CFrame.Angles(0, 0, a) * CFrame.new(0, R * 1.3, 0))
	end
	return g
end
-- 달: 초승달 (가운데가 두껍고 끝이 가는 호), 덩이의 XY 면, 오목한 쪽이 +X
local function moonGroup(R: number, color: Color3?, thick: number?): Group
	local g = group()
	local c = color or MOON
	local n = 16
	for i = 0, n - 1 do
		local a0 = math.rad(-110 + 220 * i / n)
		local a1 = math.rad(-110 + 220 * (i + 1) / n)
		local p0 = Vector3.new(-math.cos(a0) * R, math.sin(a0) * R, 0)
		local p1 = Vector3.new(-math.cos(a1) * R, math.sin(a1) * R, 0)
		local u = (i + 0.5) / n
		local w = (thick or R * 0.45) * math.sin(u * math.pi) + R * 0.05
		local mid = (p0 + p1) / 2
		gpart(g, Vector3.new(w, (p1 - p0).Magnitude * 1.12, w * 0.6), c:Lerp(WHITE, (1 - math.sin(u * math.pi)) * 0.4), Enum.Material.Neon, 0.05, nil,
			CFrame.new(mid) * CFrame.Angles(0, 0, math.atan2(p1.Y - p0.Y, p1.X - p0.X) - math.pi / 2))
	end
	return g
end

local H: { [string]: (any) -> () } = {}

------------------------------------------------------------------------
-- 일월쌍륜 (E): 해의 원반과 달의 원반이 엇갈리는 활을 그리며 날아가 앞에서 만나 일식처럼 터진다
------------------------------------------------------------------------
function H.twinDiscs(d: any)
	local from: Vector3 = d.from
	if not near(from, 300) then
		return
	end
	local dir = flat(d.dir)
	local right = Vector3.new(-dir.Z, 0, dir.X)
	local time = d.time or 0.6
	local sun = sunGroup(1.6)
	local moon = moonGroup(2.4)
	local last = 0
	anim(time, function(u)
		local sp = from + dir * (d.dist * u) + right * (d.swing * math.sin(u * math.pi))
		local mp = from + dir * (d.dist * u) - right * (d.swing * math.sin(u * math.pi))
		gset(sun, CFrame.new(sp) * CFrame.Angles(0, 0, u * 14))
		gset(moon, CFrame.lookAt(mp, mp + dir) * CFrame.Angles(0, math.rad(90), 0) * CFrame.Angles(0, 0, -u * 16))
		local now = os.clock()
		if now - last > 0.04 then
			last = now
			local a = part(Vector3.new(0.6, 0.6, 0.6), SUN, Enum.Material.Neon, 0.1, "ball")
			a.Position = sp
			fadeOut(a, 0.35, { Size = Vector3.new(0.1, 0.1, 0.1) })
			local b = part(Vector3.new(0.5, 0.5, 0.5), MOON, Enum.Material.Neon, 0.1, "ball")
			b.Position = mp
			fadeOut(b, 0.35, { Size = Vector3.new(0.1, 0.1, 0.1) })
		end
		if u >= 1 then
			gfade(sun, 0.1)
			gfade(moon, 0.1)
			local at = from + dir * d.dist
			local ecl = part(Vector3.new(3, 3, 3), DARK, Enum.Material.SmoothPlastic, 0, "ball")
			ecl.Position = at
			local ring = part(Vector3.new(4, 4, 4), SUN, Enum.Material.Neon, 0.3, "ball")
			ring.Position = at
			fadeOut(ecl, 0.5, { Size = Vector3.new(8, 8, 8) })
			fadeOut(ring, 0.4, { Size = Vector3.new(22, 22, 22) })
			Fx.blast(at, SUN, MOON, 1.6)
			Fx.ring(ground(at) + Vector3.new(0, 0.3, 0), SUN, 2, 24, 0.4)
			Fx.breakSound("boom", 0.8, 1.0, at)
			shakeNear(at, 0.7, 120)
		end
	end)
	Fx.breakSound("whoosh", 0.6, 1.0, from)
end

------------------------------------------------------------------------
-- 일월환보 (R): 제자리에 해가 터지고, 지나간 길을 달빛이 베고, 내려선 자리에서 초승달이 둥글게 터진다
------------------------------------------------------------------------
function H.solarLunarStep(d: any)
	local a: Vector3, b: Vector3 = d.from, d.to
	if not near(a, 300) then
		return
	end
	local m = d.m
	task.delay(0.05, function()
		local s = sunGroup(2.4)
		gset(s, CFrame.new(a))
		anim(0.35, function(u)
			galpha(s, u)
			gset(s, CFrame.new(a) * CFrame.Angles(0, 0, u * 3))
			if u >= 1 then
				gfade(s, 0.05)
			end
		end)
		Fx.ring(ground(a) + Vector3.new(0, 0.3, 0), SUN, 2, 20, 0.4)
		Fx.burst("ember", a, SUN, 14, 1.4)
		Fx.breakSound("boom", 0.7, 1.1, a)
	end)
	for k = 0, 3 do
		task.delay(k * 0.04, function()
			if m and m.Parent then
				Fx.afterimage(m, k % 2 == 0 and SUN or MOON, 0.35)
			end
		end)
	end
	task.delay(0.28, function()
		local mid = (a + b) / 2
		local len = (b - a).Magnitude
		local slash = part(Vector3.new(0.3, 4.5, len), MOON, Enum.Material.Neon, 0.05)
		slash.CFrame = safeLook(mid, b) * CFrame.Angles(0, 0, math.rad(20))
		fadeOut(slash, 0.4, { Size = Vector3.new(0.05, 0.6, len) })
		Fx.sound("swing", 0.7, 0.8, mid)
	end)
	task.delay(0.45, function()
		local mg = moonGroup(6, MOON, 2)
		local base = CFrame.new(b) * CFrame.Angles(math.rad(90), 0, 0)
		anim(0.35, function(u)
			gset(mg, base * CFrame.Angles(0, 0, u * math.pi * 1.5))
			galpha(mg, u)
			if u >= 1 then
				gfade(mg, 0.05)
			end
		end)
		Fx.ring(ground(b) + Vector3.new(0, 0.3, 0), MOON, 2, 24, 0.4)
		Fx.burst("glitter", b, MOON, 16, 1.4)
		shakeNear(b, 0.6, 100)
	end)
end

------------------------------------------------------------------------
-- 3.1.1판 오의·초 오의 공통 조각: 화면 빛깔, 빛줄기, 고리, 바닥의 진, 꼬리, 땅의 금
------------------------------------------------------------------------
local UP = Vector3.new(0, 1, 0)
local function v3(s: number): Vector3
	return Vector3.new(s, s, s)
end
local grade = Instance.new("ColorCorrectionEffect")
grade.Name = "KwonGeukGrade"
grade.Parent = game:GetService("Lighting")
-- 내 화면의 빛깔을 time 동안 옮긴다 (나중 부름이 앞의 것을 덮는다)
local function gradeTo(time: number, sat: number, bright: number, contrast: number, tintC: Color3?)
	tween(grade, time, { Saturation = sat, Brightness = bright, Contrast = contrast, TintColor = tintC or WHITE })
end
local function gradeReset(time: number)
	gradeTo(time, 0, 0, 0, WHITE)
end
-- a에서 b로 뻗는 빛줄기 (원기둥, 길이는 X)
local function setBeam(p: BasePart, a: Vector3, b: Vector3, w: number)
	local len = math.max(0.2, (b - a).Magnitude)
	p.Size = Vector3.new(len, w, w)
	p.CFrame = safeLook((a + b) / 2, b) * CFrame.Angles(0, math.rad(90), 0)
end
local function beamTo(a: Vector3, b: Vector3, w: number, color: Color3, alpha: number?): BasePart
	local p = part(Vector3.new(1, w, w), color, Enum.Material.Neon, alpha, "cyl")
	setBeam(p, a, b, w)
	return p
end
-- 덩이의 XY 면에 놓인 고리 (조각 n개)
local function gHalo(g: Group, R: number, thick: number, color: Color3, n: number, alpha: number?, base: CFrame?)
	local seg = 2 * math.pi * R / n * 1.1
	for k = 0, n - 1 do
		local a = (k + 0.5) / n * math.pi * 2
		gpart(g, Vector3.new(seg, thick, thick * 0.6), color, Enum.Material.Neon, alpha, nil, (base or CFrame.new()) * CFrame.Angles(0, 0, a) * CFrame.new(0, R, 0))
	end
end
-- 바닥의 진: 바깥 고리 (눈금 열둘) 와 안쪽 고리 (육각별). 둘은 따로 돈다
local FLAT = CFrame.Angles(math.rad(90), 0, 0)
local function sigil(R: number, c1: Color3, c2: Color3): (Group, Group)
	local outer, inner = group(), group()
	gHalo(outer, R, 0.55, c1, 40, 0.1, FLAT)
	gHalo(outer, R * 0.9, 0.25, c1:Lerp(WHITE, 0.3), 40, 0.35, FLAT)
	for k = 0, 11 do
		local a = k / 12 * math.pi * 2
		gpart(outer, Vector3.new(0.5, R * 0.12, 0.2), c1:Lerp(WHITE, 0.35), Enum.Material.Neon, 0.1, nil, FLAT * CFrame.Angles(0, 0, a) * CFrame.new(0, R * 0.8, 0))
	end
	local r = R * 0.66
	gHalo(inner, r, 0.4, c2, 30, 0.15, FLAT)
	for k = 0, 5 do
		gpart(inner, Vector3.new(r * 1.732, 0.3, 0.15), c2:Lerp(WHITE, 0.2), Enum.Material.Neon, 0.2, nil, FLAT * CFrame.Angles(0, 0, k * math.pi / 3) * CFrame.new(0, r * 0.5, 0))
	end
	galpha(outer, 1)
	galpha(inner, 1)
	return outer, inner
end
-- 진을 life 동안 돌린다 (처음에 밝아지고, 끝에 사라진다)
local function runSigil(at: Vector3, R: number, c1: Color3, c2: Color3, life: number, speed: number?)
	local outer, inner = sigil(R, c1, c2)
	local g = ground(at) + Vector3.new(0, 0.15, 0)
	local sp = speed or 1
	anim(life, function(u)
		local t = u * life
		local k = math.min(1, t / 0.35)
		galpha(outer, 1 - k)
		galpha(inner, 1 - k)
		gset(outer, CFrame.new(g) * CFrame.Angles(0, t * 0.9 * sp * (1 + u * 2), 0))
		gset(inner, CFrame.new(g + Vector3.new(0, 0.03, 0)) * CFrame.Angles(0, -t * 1.5 * sp * (1 + u * 2), 0))
		if u >= 1 then
			gfade(outer, 0.25)
			gfade(inner, 0.25)
		end
	end)
end
local function trailDot(p: Vector3, d: number, color: Color3, life: number)
	local b = part(v3(d), color, Enum.Material.Neon, 0.3, "ball")
	b.Position = p
	fadeOut(b, life, { Size = v3(d * 0.2) })
end
-- 땅이 가운데에서 사방으로 갈라진다 (금이 차례로 자라고, 끝에서 빛이 샌다)
local function groundCracks(c: Vector3, n: number, len: number, c1: Color3, c2: Color3, life: number, leak: boolean?)
	local g0 = ground(c) + Vector3.new(0, 0.1, 0)
	for k = 1, n do
		local a = k / n * math.pi * 2 + (math.random() - 0.5) * 0.3
		local col = k % 2 == 0 and c1 or c2
		local p = g0
		for s = 1, 4 do
			a += (math.random() - 0.5) * 0.5
			local q = p + Vector3.new(math.cos(a), 0, math.sin(a)) * (len / 4) * (0.8 + math.random() * 0.4)
			local p0, w = p, 1.2 - s * 0.22
			task.delay((s - 1) * 0.04, function()
				local cr = part(Vector3.new(w, 0.14, (q - p0).Magnitude + 0.25), col, Enum.Material.Neon, 0.05)
				cr.CFrame = safeLook((p0 + q) / 2, q)
				task.delay(life, function()
					fadeOut(cr, 0.35)
				end)
			end)
			p = q
		end
		if leak then
			local tip = p
			task.delay(0.18, function()
				local lk = beamTo(tip, tip + Vector3.new(0, 18, 0), 1, col, 0.3)
				fadeOut(lk, life, { Size = Vector3.new(18, 0.15, 0.15) })
			end)
		end
	end
end
local function camFace(from: Vector3, fallback: Vector3): Vector3
	local cam = workspace.CurrentCamera
	if cam then
		local v = cam.CFrame.Position - from
		if v.Magnitude > 1e-3 then
			return v.Unit
		end
	end
	return fallback
end

------------------------------------------------------------------------
-- 대일월천 (오의, 3.1.1판 새로)
-- 등 뒤에 해와 달이 떠오른다 → 해는 불의 빛줄기로 땅을 앞뒤로 가르고, 달은 거대한 초승달 셋을 내리꽂는다
-- → 둘이 적 위에서 부딪쳐 일식이 되고 땅이 금빛·푸른빛으로 갈라진다 → 일식이 땅에 박히며 빛의 돔으로 터진다
------------------------------------------------------------------------
function H.sunMoonFall(d: any)
	local c: Vector3 = d.at
	if not near(c, 450) then
		return
	end
	local dir = flat(d.dir)
	local right = Vector3.new(-dir.Z, 0, dir.X)
	local from: Vector3 = d.from or (c - dir * 14)
	local summon, beamT, merge = d.summon or 0.7, d.beam or 1.2, d.merge or 0.5
	local slams, slamAt, slamEvery, travel = d.slams or 3, d.slamAt or 0.85, d.slamEvery or 0.36, d.travel or 0.22
	local sweep, R = d.sweep or 9, d.radius or 26
	local g0 = ground(c)
	local total = summon + beamT + merge
	local meetT = summon + beamT + merge * 0.7
	local sunHome = from - dir * 5 + right * 11 + UP * 18
	local moonHome = from - dir * 5 - right * 11 + UP * 20
	local sun = sunGroup(5.5)
	local moon = moonGroup(7.5, MOON, 3.2)
	galpha(sun, 1)
	galpha(moon, 1)
	local sunPos, moonPos = sunHome - UP * 18, moonHome - UP * 20
	if opts.tint then
		opts.tint(Color3.fromRGB(255, 215, 170), 0.3, total + 0.4)
	end
	runSigil(from, 10, SUN, MOON, total, 1.2)
	Fx.sound("ping", 0.6, 0.5, from)
	-- 해와 달: 떠오르고 → 떠 있으며 치고 → 적 위로 모여 부딪친다
	local merged = false
	anim(meetT, function(u)
		local t = u * meetT
		if t < summon then
			local k = t / summon
			local e = 1 - (1 - k) ^ 3
			sunPos = (sunHome - UP * 18):Lerp(sunHome, e)
			moonPos = (moonHome - UP * 20):Lerp(moonHome, e)
			galpha(sun, 1 - k)
			galpha(moon, 1 - k)
			if math.random() < 0.5 then
				Fx.burst("glitter", from + UP * 2, math.random() < 0.5 and SUN or MOON, 3, 1.2)
			end
		elseif t < summon + beamT then
			galpha(sun, 0)
			galpha(moon, 0)
			sunPos = sunHome + UP * math.sin(t * 3) * 0.6
			moonPos = moonHome + UP * math.cos(t * 3) * 0.6
		else
			local k = math.clamp((t - summon - beamT) / (merge * 0.7), 0, 1)
			local meet = g0 + UP * 14
			sunPos = sunHome:Lerp(meet, k * k)
			moonPos = moonHome:Lerp(meet, k * k)
			trailDot(sunPos, 4, SUN, 0.3)
			trailDot(moonPos, 4, MOON, 0.3)
		end
		local face = camFace(sunPos, -dir)
		gset(sun, CFrame.lookAt(sunPos, sunPos + face) * CFrame.Angles(0, 0, t * 2.5))
		gset(moon, CFrame.lookAt(moonPos, moonPos + face) * CFrame.Angles(0, 0, -0.4 + math.sin(t * 2) * 0.2))
		if u >= 1 and not merged then
			merged = true
			gfade(sun, 0.06)
			gfade(moon, 0.06)
		end
	end)
	-- 해의 빛줄기: 적 둘레의 땅을 앞뒤로 쓸며 태운다
	task.delay(summon, function()
		local core = part(Vector3.new(1, 2, 2), SUN_CORE, Enum.Material.Neon, 0, "cyl")
		local glow = part(Vector3.new(1, 5, 5), SUN, Enum.Material.Neon, 0.45, "cyl")
		Fx.sound("deflect", 1, 0.45, c)
		shakeNear(c, 0.8, 160)
		anim(beamT, function(u)
			local p = g0 + dir * (-sweep * math.cos(u * math.pi * 2))
			local w = 1 + math.sin(u * 70) * 0.15
			setBeam(core, sunPos, p, 2 * w)
			setBeam(glow, sunPos, p, 5.2 * w)
			if math.random() < 0.7 then
				local s = part(Vector3.new(0.2, 3.5, 3.5), Color3.fromRGB(255, 120, 40), Enum.Material.Neon, 0.15, "cyl")
				s.CFrame = CFrame.new(p + UP * 0.12) * CFrame.Angles(0, 0, math.rad(90))
				fadeOut(s, 1.6, { Size = Vector3.new(0.2, 4.5, 4.5) })
			end
			if math.random() < 0.35 then
				Fx.burst("ember", p + UP, SUN, 4, 1.6)
			end
			if math.random() < 0.15 then
				Fx.ring(p + UP * 0.3, SUN, 2, 10, 0.3)
			end
			if u >= 1 then
				fadeOut(core, 0.15)
				fadeOut(glow, 0.2)
			end
		end)
	end)
	-- 달의 초승달 셋: 하늘을 넘어 적 위에 내리꽂히고, 땅에 초승달 자국이 남는다
	for i = 1, slams do
		local t0 = slamAt + (i - 1) * slamEvery
		task.delay(t0, function()
			local yaw = (i - 1) * math.pi / 3 + math.random() * 0.3
			local mg = moonGroup(8, MOON, 3)
			local start = moonPos
			Fx.sound("swing", 0.9, 0.6, start)
			anim(travel, function(u)
				local p = start:Lerp(g0 + UP * 4, u * u) + UP * math.sin(u * math.pi) * 8
				gset(mg, CFrame.new(p) * CFrame.Angles(0, yaw, 0) * CFrame.Angles(0, 0, u * math.pi * 1.5))
				trailDot(p, 2.4, MOON, 0.3)
				if u >= 1 then
					gfade(mg, 0.12)
					local gash = moonGroup(9, MOON, 2)
					gset(gash, CFrame.new(g0 + UP * 0.2) * CFrame.Angles(0, yaw, 0) * FLAT)
					galpha(gash, 0.15)
					task.delay(math.max(0.1, total - t0 - travel), function()
						gfade(gash, 0.3)
					end)
					Fx.ring(g0 + UP * 0.4, MOON, 3, 26, 0.45)
					Fx.flash(c, MOON, 60, 5, 0.3)
					Fx.sound("deflect", 0.9, 0.7 + i * 0.08, c)
					Fx.debris(g0, 6, 26)
					shakeNear(c, 1, 160)
				end
			end)
		end)
	end
	-- 땅이 갈라진다: 둘이 모여들 때
	task.delay(summon + beamT + merge * 0.15, function()
		groundCracks(c, 14, R * 0.9, SUN, MOON, merge * 0.85 + 0.2, true)
		Fx.ring(g0 + UP * 0.5, WHITE, 50, 6, merge * 0.55)
		Fx.sound("ping", 0.5, 0.4, c)
	end)
	-- 일식: 부딪친 자리에 검은 해와 흰 테. 한순간 떠 있다가 땅으로 박힌다
	task.delay(meetT, function()
		local meet = g0 + UP * 14
		local face = camFace(meet, -dir)
		local ecl = group()
		gpart(ecl, v3(9), DARK, Enum.Material.SmoothPlastic, 0, "ball", CFrame.new())
		gHalo(ecl, 5.2, 0.7, SUN_CORE, 24, 0, nil)
		gHalo(ecl, 6.4, 0.3, SUN, 28, 0.3, nil)
		gpart(ecl, v3(16), SUN, Enum.Material.Neon, 0.82, "ball", CFrame.new())
		local flare = part(v3(1), WHITE, Enum.Material.Neon, 0, "ball")
		Fx.flash(meet, SUN_CORE, 120, 8, 0.35)
		Fx.breakSound("boom", 0.8, 0.5, c)
		Fx.ring(meet, SUN_CORE, 4, 50, 0.4, face)
		shakeNear(c, 1.4, 200)
		if opts.tint then
			opts.tint(Color3.fromRGB(150, 140, 190), 0.5, merge * 0.3 + 0.1)
		end
		local hang = math.max(0.05, total - meetT)
		anim(hang, function(u)
			local p = meet - UP * (u ^ 3) * 13
			local cf = CFrame.lookAt(p, p + face)
			gset(ecl, cf * CFrame.Angles(0, 0, u * 2))
			flare.CFrame = cf * CFrame.new(3.6, 3.6, -0.5)
			flare.Size = v3(1 + math.sin(u * math.pi) * 6)
			if u >= 1 then
				gfade(ecl, 0.1)
				flare:Destroy()
			end
		end)
	end)
	-- 일식이 땅에 박힌다: 빛의 돔, 하늘까지 닿는 기둥, 사방으로 나는 초승달 조각, 땅을 따라 뻗는 빛살
	task.delay(total, function()
		local core = part(v3(6), WHITE, Enum.Material.Neon, 0, "ball")
		core.Position = g0 + UP * 2
		fadeOut(core, 0.7, { Size = v3(R * 2.4) })
		local shell = part(v3(8), SUN, Enum.Material.Neon, 0.35, "ball")
		shell.Position = g0 + UP * 2
		fadeOut(shell, 0.9, { Size = v3(R * 3.2) })
		local outer = part(v3(8), MOON, Enum.Material.Neon, 0.6, "ball")
		outer.Position = g0 + UP * 2
		fadeOut(outer, 1.0, { Size = v3(R * 4) })
		local pillar = beamTo(g0 - UP * 2, g0 + UP * 150, 16, SUN_CORE, 0.05)
		fadeOut(pillar, 0.8, { Size = Vector3.new(pillar.Size.X, 42, 42) })
		for k = 0, 9 do
			local a = k / 10 * math.pi * 2
			local out = Vector3.new(math.cos(a), 0, math.sin(a))
			local mg = moonGroup(2.6, k % 2 == 0 and MOON or SUN, 1)
			anim(0.6, function(u)
				local p = g0 + UP * (3 + math.sin(u * math.pi) * 5) + out * (4 + u * R * 1.6)
				gset(mg, CFrame.lookAt(p, p + out) * CFrame.Angles(0, math.rad(90), u * 8))
				if u >= 1 then
					gfade(mg, 0.15)
				end
			end)
		end
		for k = 0, 11 do
			local a = k / 12 * math.pi * 2 + 0.13
			local ray = beamTo(g0 + UP * 0.3, g0 + Vector3.new(math.cos(a), 0, math.sin(a)) * R * 1.5 + UP * 0.3, 1.4, k % 2 == 0 and SUN or MOON, 0.1)
			fadeOut(ray, 0.6)
		end
		Fx.ring(g0 + UP * 0.5, SUN_CORE, 6, R * 3.2, 0.8)
		Fx.ring(g0 + UP * 1.5, SUN, 4, R * 2.4, 0.7)
		Fx.ring(g0 + UP * 3, MOON, 4, R * 1.8, 0.6)
		Fx.blast(g0 + UP * 3, SUN, MOON, 3.4)
		Fx.debris(g0, 16, 44)
		Fx.flash(c, WHITE, 150, 9, 0.9)
		if opts.flash and near(c, 120) then
			opts.flash(SUN_CORE, 0.3)
		end
		Fx.breakSound("boom", 1.2, 0.4, c)
		Fx.breakSound("rock", 1, 0.6, c)
		shakeNear(c, 2.4, 240)
	end)
end

------------------------------------------------------------------------
-- 일월개벽 (초 오의, 3.1.1판 새로)
-- 컷씬: 세상이 어두워지고, 내 등 뒤 지평선 양쪽에서 거대한 해와 달이 솟는다 (나는 둘 사이에 떠오른다)
-- → 일월윤전: 해와 달이 나를 두고 점점 빨리 돌며 번갈아 적을 친다 (해는 불기둥, 달은 초승달). 하늘빛이 따라 바뀐다
-- → 합삭: 둘이 머리 위에서 부딪쳐 거대한 일식이 걸리고 세상의 빛깔이 빠진다 (시간이 멈춘 듯)
-- → 빛살: 일식의 테에서 빛살이 쏟아진다 → 개벽: 하늘로 주먹을 내지르면 일식이 금 가고 깨지며 새벽빛으로 터진다
------------------------------------------------------------------------
local orbState: { [any]: { sun: Vector3, moon: Vector3 } } = {}
function H.eclipseGenesis(d: any)
	local C: Vector3 = d.at
	if not near(C, 600) then
		return
	end
	local look = flat(d.dir or Vector3.new(0, 0, -1))
	local right = Vector3.new(-look.Z, 0, look.X)
	local T1 = d.cut or 1.5
	local T2 = T1 + (d.orbit or 1.4)
	local T3 = T2 + (d.collide or 0.4)
	local T4 = T3 + (d.rays or 1.4)
	local T5 = T4 + (d.finalAt or 0.4)
	local OR = d.orbitR or 30
	local sky = C + UP * 40
	local gC = ground(C)
	local graded = near(C, 250)
	if graded then
		gradeTo(0.6, -0.35, -0.2, 0.15, Color3.fromRGB(200, 200, 235))
	end
	local st = { sun = C, moon = C }
	orbState[d.m] = st
	local sun = sunGroup(9)
	local moon = moonGroup(11, MOON, 4.5)
	galpha(sun, 1)
	galpha(moon, 1)
	local sunRise0 = C - look * 70 + right * 40 - UP * 25
	local sunRise1 = C - look * 70 + right * 40 + UP * 26
	local moonRise0 = C - look * 70 - right * 40 - UP * 25
	local moonRise1 = C - look * 70 - right * 40 + UP * 30
	runSigil(C, 14, SUN, MOON, T5, 1)
	Fx.sound("ping", 0.7, 0.35, C)
	Fx.breakSound("boom", 0.6, 0.3, C)
	local orbitCenter = C + UP * 22
	local function orbitAt(a: number): Vector3
		return orbitCenter + (right * math.cos(a) - look * math.sin(a)) * OR + UP * math.sin(a * 2) * 5
	end
	local function theta(t: number): number
		local k = math.clamp((t - T1) / (T2 - T1), 0, 1)
		return math.pi * 2 * (0.4 * k + 1.6 * k * k) + 0.5
	end
	local lastTrail = 0
	local hidden = false
	anim(T3, function(u)
		local t = u * T3
		local sp, mp
		if t < T1 then
			local k = t / T1
			local e = 1 - (1 - k) ^ 2
			sp = sunRise0:Lerp(sunRise1, e)
			mp = moonRise0:Lerp(moonRise1, e)
			galpha(sun, 1 - math.min(1, k * 3))
			galpha(moon, 1 - math.min(1, k * 3))
			-- 사방의 하늘에서 빛줄기가 나에게로 모여든다
			if math.random() < 0.5 then
				local a = math.random() * math.pi * 2
				local p = C + Vector3.new(math.cos(a) * 80, 20 + math.random() * 40, math.sin(a) * 80)
				local tgt = C + UP * 3
				local b = beamTo(p, p + (tgt - p).Unit * 14, 0.25, math.random() < 0.5 and SUN_CORE or MOON, 0.3)
				fadeOut(b, 0.25, { CFrame = b.CFrame + (tgt - p).Unit * 30 })
			end
			if math.random() < 0.3 then
				Fx.burst("glitter", gC + UP, SUN_CORE, 3, 1.5)
			end
		elseif t < T2 then
			local th = theta(t)
			local j = math.clamp((t - T1) / 0.35, 0, 1)
			j = j * j * (3 - 2 * j)
			sp = sunRise1:Lerp(orbitAt(th), j)
			mp = moonRise1:Lerp(orbitAt(th + math.pi), j)
			if graded then
				grade.TintColor = Color3.fromRGB(255, 215, 170):Lerp(Color3.fromRGB(170, 190, 255), (math.sin(th) + 1) / 2)
			end
		else
			local k = math.clamp((t - T2) / (T3 - T2), 0, 1)
			local th = theta(T2)
			sp = orbitAt(th):Lerp(sky, k ^ 2.2)
			mp = orbitAt(th + math.pi):Lerp(sky, k ^ 2.2)
		end
		st.sun, st.moon = sp, mp
		local face = camFace(sp, -look)
		gset(sun, CFrame.lookAt(sp, sp + face) * CFrame.Angles(0, 0, t * 2))
		gset(moon, CFrame.lookAt(mp, mp + face) * CFrame.Angles(0, 0, -0.5 + math.sin(t * 2) * 0.3))
		if t >= T1 and os.clock() - lastTrail > 0.03 then
			lastTrail = os.clock()
			trailDot(sp, 7, SUN, 0.45)
			trailDot(mp, 7, MOON, 0.45)
		end
		if u >= 1 and not hidden then
			hidden = true
			gfade(sun, 0.05)
			gfade(moon, 0.05)
		end
	end)
	-- 합삭: 머리 위의 거대한 일식
	task.delay(T3, function()
		local ecl = group()
		gpart(ecl, v3(24), DARK, Enum.Material.SmoothPlastic, 0, "ball", CFrame.new())
		gHalo(ecl, 13, 1.6, SUN_CORE, 40, 0, nil)
		gHalo(ecl, 14.6, 0.6, SUN, 44, 0.25, nil)
		for k = 0, 23 do
			local a = k / 24 * math.pi * 2
			local L = 8 + math.random() * 18
			gpart(ecl, Vector3.new(0.5 + math.random() * 0.6, L, 0.3), SUN_CORE:Lerp(SUN, math.random()), Enum.Material.Neon, 0.25 + math.random() * 0.3, nil, CFrame.Angles(0, 0, a) * CFrame.new(0, 13 + L / 2, 0))
		end
		gpart(ecl, v3(44), SUN, Enum.Material.Neon, 0.86, "ball", CFrame.new())
		local cracksG = group()
		local flare = part(v3(1), WHITE, Enum.Material.Neon, 0, "ball")
		if graded then
			gradeTo(0.25, -0.85, -0.12, 0.35, Color3.fromRGB(230, 225, 255))
		end
		local face0 = camFace(sky, -look)
		Fx.flash(sky, SUN_CORE, 200, 10, 0.5)
		Fx.ring(sky, SUN_CORE, 10, 120, 0.6, face0)
		Fx.breakSound("boom", 1.2, 0.3, C)
		Fx.sound("ping", 0.6, 0.4, C)
		shakeNear(C, 2, 300)
		local hold = T5 - T3
		local rayEnd = T4 - T3
		local cracked = false
		local lastRing = 0
		anim(hold, function(u)
			local t = u * hold
			local face = camFace(sky, -look)
			local jit = t > rayEnd and (math.random() - 0.5) * 0.9 or 0
			local cf = CFrame.lookAt(sky, sky + face) * CFrame.new(jit, jit, 0)
			local spin = CFrame.Angles(0, 0, t * 0.35)
			gset(ecl, cf * spin)
			gset(cracksG, cf * spin)
			-- 다이아몬드 고리: 테의 한 점이 크게 번쩍였다 잦아든다
			local fl = math.max(0, 1 - t / 0.5)
			flare.CFrame = cf * CFrame.new(9.5, 9.5, -0.5)
			flare.Size = v3(1 + fl * 10)
			flare.Transparency = 1 - fl
			-- 빛살 비 (장식): 일식에서 땅 여기저기로
			if t > 0.1 and t < rayEnd and math.random() < 0.45 then
				local a = math.random() * math.pi * 2
				local r = math.random() * (d.range or 55)
				local b = beamTo(sky, gC + Vector3.new(math.cos(a) * r, 0.2, math.sin(a) * r), 0.35, SUN_CORE, 0.45)
				fadeOut(b, 0.18)
			end
			if t < rayEnd and os.clock() - lastRing > 0.3 then
				lastRing = os.clock()
				Fx.ring(gC + UP * 0.4, SUN_CORE, 6, 60, 0.6)
			end
			-- 개벽 직전: 일식에 금이 간다
			if not cracked and t >= rayEnd then
				cracked = true
				for _ = 1, 8 do
					local a = math.random() * math.pi * 2
					local L = 6 + math.random() * 8
					gpart(cracksG, Vector3.new(0.45, L, 0.2), WHITE, Enum.Material.Neon, 0, nil, CFrame.Angles(0, 0, a) * CFrame.new(0, L * 0.4, -12.2))
				end
				Fx.sound("shatter", 0.8, 0.6, C)
				Fx.flash(sky, WHITE, 120, 6, 0.3)
			end
			if u >= 1 then
				gfade(ecl, 0.05)
				gfade(cracksG, 0.05)
				flare:Destroy()
			end
		end)
	end)
	-- 개벽: 일식이 깨지며 새벽빛으로 터진다
	task.delay(T5, function()
		orbState[d.m] = nil
		local R = d.radius or 40
		for k = 0, 13 do
			local a = k / 14 * math.pi * 2
			local out = right * math.cos(a) + UP * math.sin(a) + look * (math.random() - 0.5)
			local sh = part(Vector3.new(3 + math.random() * 3, 3 + math.random() * 3, 1), DARK, Enum.Material.SmoothPlastic, 0)
			sh.CFrame = CFrame.new(sky) * CFrame.Angles(math.random() * 6, math.random() * 6, math.random() * 6)
			fadeOut(sh, 0.9, { CFrame = CFrame.new(sky + out * 40 - UP * 6) * CFrame.Angles(math.random() * 6, math.random() * 6, 0), Size = v3(0.5) })
		end
		local core = part(v3(10), WHITE, Enum.Material.Neon, 0, "ball")
		core.Position = sky
		fadeOut(core, 1.0, { Size = v3(180) })
		local shell = part(v3(12), SUN_CORE, Enum.Material.Neon, 0.4, "ball")
		shell.Position = sky
		fadeOut(shell, 1.3, { Size = v3(240) })
		local col = beamTo(gC - UP * 2, sky + UP * 100, 28, SUN_CORE, 0.05)
		fadeOut(col, 1.0, { Size = Vector3.new(col.Size.X, 70, 70) })
		local dome = part(v3(6), SUN, Enum.Material.Neon, 0.3, "ball")
		dome.Position = gC
		fadeOut(dome, 0.9, { Size = v3(R * 2.6) })
		Fx.ring(gC + UP * 0.5, SUN_CORE, 8, R * 3.4, 1.0)
		Fx.ring(gC + UP * 2, SUN, 6, R * 2.6, 0.9)
		Fx.ring(gC + UP * 4, MOON, 6, R * 2, 0.8)
		Fx.blast(gC + UP * 3, SUN_CORE, SUN, 4.2)
		Fx.debris(gC, 20, 50)
		Fx.flash(sky, WHITE, 260, 12, 1.4)
		if opts.flash and near(C, 200) then
			opts.flash(Color3.fromRGB(255, 240, 210), 0.5)
		end
		Fx.breakSound("boom", 1.3, 0.28, C)
		Fx.breakSound("glass", 1, 0.5, C)
		shakeNear(C, 3, 320)
		if graded then
			gradeTo(0.12, 0.25, 0.45, 0.1, Color3.fromRGB(255, 225, 185))
			task.delay(0.35, function()
				gradeReset(1.8)
			end)
		end
		-- 새벽빛 먼지가 천천히 떠오른다
		for k = 1, 8 do
			task.delay(k * 0.1, function()
				Fx.burst("glitter", gC + Vector3.new((math.random() - 0.5) * 40, 2, (math.random() - 0.5) * 40), SUN_CORE, 6, 1.6)
			end)
		end
	end)
end
-- 일월윤전의 한 박자: 도는 해는 불기둥을, 도는 달은 초승달을 적에게 꽂는다
function H.eclipseStrike(d: any)
	local st = orbState[d.m]
	local isSun = d.who == "sun"
	local src0 = st and (isSun and st.sun or st.moon)
	for _, at in ipairs(d.ats or {}) do
		if near(at, 320) then
			local src = src0 or (at + Vector3.new(0, 40, 0))
			local g = ground(at)
			if isSun then
				local b = beamTo(src, at, 2.6, SUN_CORE, 0.05)
				local gl = beamTo(src, at, 5.5, SUN, 0.5)
				fadeOut(b, 0.22, { Size = Vector3.new(b.Size.X, 0.2, 0.2) })
				fadeOut(gl, 0.3, { Size = Vector3.new(gl.Size.X, 0.4, 0.4) })
				local fire = beamTo(g, g + UP * 12, 3, Color3.fromRGB(255, 130, 50), 0.2)
				fadeOut(fire, 0.4, { Size = Vector3.new(12, 0.5, 0.5) })
				Fx.burst("ember", at, SUN, 8, 1.6)
				Fx.ring(g + UP * 0.3, SUN, 2, 14, 0.35)
				Fx.sound("heavy", 0.6, 1.1, at)
			else
				local mg = moonGroup(4.5, MOON, 1.6)
				local yaw = math.random() * math.pi * 2
				anim(0.14, function(u)
					local p = src:Lerp(at, u)
					gset(mg, CFrame.new(p) * CFrame.Angles(0, yaw, 0) * CFrame.Angles(0, 0, u * 6))
					if u >= 1 then
						gfade(mg, 0.15)
						Fx.ring(g + UP * 0.3, MOON, 2, 14, 0.35)
						Fx.burst("glitter", at, MOON, 8, 1.4)
						Fx.sound("deflect", 0.6, 1.1, at)
					end
				end)
			end
		end
	end
end
-- 일식의 빛살: 하늘의 일식에서 적에게 꽂히고, 그 자리에서 빛의 가시가 솟는다
function H.eclipseRay(d: any)
	local from: Vector3 = d.from
	for _, at in ipairs(d.ats or {}) do
		if near(at, 320) then
			local core = beamTo(from, at, 1.2, WHITE, 0)
			local glow = beamTo(from, at, 3.4, SUN_CORE, 0.45)
			fadeOut(core, 0.18, { Size = Vector3.new(core.Size.X, 0.1, 0.1) })
			fadeOut(glow, 0.25, { Size = Vector3.new(glow.Size.X, 0.3, 0.3) })
			local g = ground(at)
			local spike = beamTo(g, g + UP * 9, 2.2, SUN_CORE, 0.1)
			fadeOut(spike, 0.3, { Size = Vector3.new(spike.Size.X, 0.3, 0.3) })
			Fx.burst("spark", at, SUN, 6, 1.2)
			Fx.ring(g + UP * 0.3, SUN_CORE, 1, 10, 0.25)
		end
	end
end

------------------------------------------------------------------------
-- 황혼의 기술
------------------------------------------------------------------------
-- 황혼 (연타 셋마다): 노을빛 해와 보랏빛 달이 함께 떨어져 겹치며 터진다
function H.duskPulse(d: any)
	local at: Vector3 = d.at
	if not near(at, 250) then
		return
	end
	local delay = d.delay or 0.3
	local s = sunGroup(1.2, DUSK)
	local mg = moonGroup(1.8, DUSK2, 0.7)
	anim(delay, function(u)
		local sp = (at + Vector3.new(6, 18, 0)):Lerp(at, u * u)
		local mp = (at + Vector3.new(-6, 18, 0)):Lerp(at, u * u)
		gset(s, CFrame.new(sp))
		gset(mg, CFrame.new(mp) * CFrame.Angles(0, 0, u * 6))
		if u >= 1 then
			gfade(s, 0.1)
			gfade(mg, 0.1)
			Fx.blast(at, DUSK, DUSK2, 1.2)
			Fx.ring(ground(at) + Vector3.new(0, 0.3, 0), DUSK, 1, 18, 0.35)
			Fx.breakSound("boom", 0.6, 1.2, at)
		end
	end)
end

-- 황혼참 (E): 노을빛 초승달 다섯이 부채꼴로 날아갔다가 되돌아온다
function H.duskFan(d: any)
	local from: Vector3 = d.from
	if not near(from, 300) then
		return
	end
	local m = d.m
	local time = d.time or 0.7
	local moons = {}
	for i, dir in ipairs(d.dirs or {}) do
		moons[i] = { g = moonGroup(2.2, i % 2 == 0 and DUSK2 or DUSK, 0.9), dir = flat(dir) }
	end
	local last = 0
	anim(time, function(u)
		local r = rootOf(m)
		local owner = r and r.Position or from
		local base = from:Lerp(owner, u)
		local now = os.clock()
		for i, mo in ipairs(moons) do
			local p = base + mo.dir * (d.dist * math.sin(u * math.pi))
			gset(mo.g, CFrame.lookAt(p, p + mo.dir) * CFrame.Angles(math.rad(90), 0, 0) * CFrame.Angles(0, 0, -u * 20))
			if now - last > 0.05 then
				local tr = part(Vector3.new(0.5, 0.5, 0.5), i % 2 == 0 and DUSK2 or DUSK, Enum.Material.Neon, 0.15, "ball")
				tr.Position = p
				fadeOut(tr, 0.3, { Size = Vector3.new(0.1, 0.1, 0.1) })
			end
		end
		if now - last > 0.05 then
			last = now
		end
		if u >= 1 then
			for _, mo in ipairs(moons) do
				gfade(mo.g, 0.1)
			end
		end
	end)
	Fx.breakSound("whoosh", 0.8, 0.9, from)
end

-- 석양보 (R): 노을이 되어 적들의 등 뒤로 차례로 나타나고, 지나간 노을빛 줄이 한꺼번에 터진다
function H.duskChain(d: any)
	local prev: Vector3 = d.from
	if not near(prev, 300) then
		return
	end
	local m = d.m
	local lines: { { Vector3 } } = {}
	for i, t in ipairs(d.targets or {}) do
		task.delay((d.delay or 0.08) + (i - 1) * (d.every or 0.12), function()
			local tr = rootOf(t)
			if not tr then
				return
			end
			local to = tr.Position
			if m and m.Parent then
				Fx.afterimage(m, i % 2 == 0 and DUSK2 or DUSK, 0.4)
			end
			local len = (to - prev).Magnitude
			if len > 0.3 then
				local ln = part(Vector3.new(0.5, 0.5, len), DUSK, Enum.Material.Neon, 0.1)
				ln.CFrame = safeLook((prev + to) / 2, to)
				table.insert(lines, { prev, to })
				task.delay(0.6 + (d.burstAt or 0.35), function()
					fadeOut(ln, 0.2)
				end)
			end
			Fx.burst("spark", to, DUSK, 8, 1.2)
			Fx.sound("swing", 0.7, 1 + i * 0.1, to)
			prev = to
		end)
	end
	local n = math.max(1, #(d.targets or {}))
	task.delay((d.delay or 0.08) + n * (d.every or 0.12) + (d.burstAt or 0.35), function()
		for _, ln in ipairs(lines) do
			local a, b = ln[1], ln[2]
			for k = 0, 3 do
				local p = a:Lerp(b, k / 3)
				local boom = part(Vector3.new(2, 2, 2), k % 2 == 0 and DUSK or DUSK2, Enum.Material.Neon, 0.1, "ball")
				boom.Position = p
				fadeOut(boom, 0.35, { Size = Vector3.new(9, 9, 9) })
			end
		end
		Fx.breakSound("boom", 0.9, 0.9, prev)
		shakeNear(prev, 0.9, 140)
	end)
end

-- 노을의 해: 노을빛 몸을 보랏빛 구름 띠 넷이 가로지른다 (어느 쪽에서 봐도 가로줄)
local function duskSunGroup(R: number): Group
	local g = sunGroup(R, DUSK)
	for i, y in ipairs({ -0.55, -0.2, 0.15, 0.5 }) do
		local w = math.sqrt(math.max(0.05, 1 - y * y)) * R * 2.3
		gpart(g, Vector3.new(R * 0.09, w, w), DUSK2, Enum.Material.Neon, 0.3 + i * 0.08, "cyl", CFrame.new(0, y * R, 0) * CFrame.Angles(0, 0, math.rad(90)))
	end
	return g
end

------------------------------------------------------------------------
-- 황혼낙일 (황혼 G, 3.1.1판 새로)
-- 하늘 저편에서 거대한 석양이 내려와 앞의 땅에 닿는다 → 땅이 노을빛 바다가 되고 석양이 천천히 가라앉는다
-- (가라앉는 동안 노을빛 물결이 넷 퍼지고 달빛 기둥이 솟는다) → 다 잠기면 바다가 검보랏빛으로 식어 고요해진다
-- → 바다가 노을 불꽃의 왕관으로 솟구친다
------------------------------------------------------------------------
function H.sunsetSea(d: any)
	local c: Vector3 = d.at
	if not near(c, 450) then
		return
	end
	local dir = flat(d.dir or Vector3.new(0, 0, -1))
	local descend, sink, dark = d.descend or 0.7, d.sink or 1.6, d.dark or 0.3
	local R = d.radius or 24
	local g = ground(c)
	local SR = 12
	local total = descend + sink
	local sun = duskSunGroup(SR)
	local hi = g + UP * 70 + dir * 25
	local touch = g + UP * (SR * 0.95)
	local under = g - UP * (SR * 1.15)
	if opts.tint then
		opts.tint(Color3.fromRGB(255, 165, 130), 0.4, total + dark + 0.3)
	end
	-- 바다 (처음엔 보이지 않는다): 노을빛 가운데, 보랏빛 테, 흰 빛의 심
	local rim = part(Vector3.new(0.3, 1, 1), DUSK2, Enum.Material.Neon, 1, "cyl")
	rim.CFrame = CFrame.new(g + UP * 0.16) * CFrame.Angles(0, 0, math.rad(90))
	local sea = part(Vector3.new(0.32, 1, 1), DUSK, Enum.Material.Neon, 1, "cyl")
	sea.CFrame = CFrame.new(g + UP * 0.2) * CFrame.Angles(0, 0, math.rad(90))
	local glow = part(Vector3.new(0.34, 1, 1), SUN_CORE, Enum.Material.Neon, 1, "cyl")
	glow.CFrame = CFrame.new(g + UP * 0.24) * CFrame.Angles(0, 0, math.rad(90))
	-- 해기둥: 해 위로 곧게 솟은 노을빛 기둥
	local pillar = part(Vector3.new(1, 2, 2), DUSK, Enum.Material.Neon, 0.55, "cyl")
	Fx.sound("swing", 1, 0.4, c)
	anim(total, function(u)
		local t = u * total
		local p
		if t < descend then
			local k = t / descend
			p = hi:Lerp(touch, 1 - (1 - k) ^ 2)
		else
			local k = (t - descend) / sink
			p = touch:Lerp(under, k * k * (3 - 2 * k))
		end
		gset(sun, CFrame.new(p) * CFrame.Angles(0, t * 0.4, 0))
		setBeam(pillar, p + UP * SR * 0.8, p + UP * (SR + 45), 2.2 + math.sin(t * 20) * 0.3)
		if t > descend and math.random() < 0.6 then
			local a = math.random() * math.pi * 2
			Fx.burst("ember", g + Vector3.new(math.cos(a) * SR, 1, math.sin(a) * SR), DUSK, 4, 1.6)
		end
		if u >= 1 then
			gfade(sun, 0.2)
			fadeOut(pillar, 0.25)
		end
	end)
	-- 닿는 순간: 땅이 노을빛 바다가 된다
	task.delay(descend, function()
		tween(rim, 0.45, { Size = Vector3.new(0.3, R * 2.2, R * 2.2), Transparency = 0.4 })
		tween(sea, 0.35, { Size = Vector3.new(0.32, R * 2, R * 2), Transparency = 0.25 })
		tween(glow, 0.3, { Size = Vector3.new(0.34, R * 0.8, R * 0.8), Transparency = 0.35 })
		Fx.ring(g + UP * 0.4, DUSK, 4, R * 2.6, 0.6)
		Fx.debris(g, 12, 36)
		Fx.flash(c, DUSK, 90, 6, 0.5)
		Fx.breakSound("boom", 1, 0.5, c)
		shakeNear(c, 1.4, 180)
		anim(sink, function(u)
			if math.random() < 0.12 then
				Fx.ring(g + UP * 0.35, DUSK:Lerp(DUSK2, math.random()), 2, R * 2, 0.6)
			end
			if math.random() < 0.35 then
				local a = math.random() * math.pi * 2
				local r = math.random() * R
				local bub = part(v3(1), math.random() < 0.5 and DUSK or DUSK2, Enum.Material.Neon, 0.2, "ball")
				bub.Position = g + Vector3.new(math.cos(a) * r, 0.5, math.sin(a) * r)
				fadeOut(bub, 0.5, { Size = Vector3.new(3, 0.5, 3) })
			end
			glow.Size = Vector3.new(0.34, R * (0.8 - u * 0.5), R * (0.8 - u * 0.5))
		end)
		-- 노을 물결: 가라앉는 해에서 땅을 따라 가로로 퍼지는 빛의 판
		local waves = d.waves or 4
		for i = 1, waves do
			task.delay((i - 0.5) * sink / waves, function()
				local blade = part(Vector3.new(0.25, SR * 2, SR * 2), DUSK:Lerp(SUN_CORE, 0.35), Enum.Material.Neon, 0.2, "cyl")
				blade.CFrame = CFrame.new(g + UP * (1.2 + i * 0.3)) * CFrame.Angles(0, 0, math.rad(90))
				fadeOut(blade, 0.55, { Size = Vector3.new(0.1, R * 2.5, R * 2.5) })
				Fx.ring(g + UP * 1.5, DUSK, SR * 2, R * 2.6, 0.55)
				Fx.sound("swing", 0.8, 0.5 + i * 0.05, c)
				shakeNear(c, 0.7, 140)
			end)
		end
		-- 달빛 기둥: 바다 여기저기에서 보랏빛 기둥이 솟고 꼭대기에 초승달이 맺힌다
		local beams = d.beams or {}
		for i, pt in ipairs(beams) do
			task.delay((i - 0.5) * sink / math.max(1, #beams), function()
				local pg = ground(pt)
				local beam = beamTo(pg, pg + UP * 30, 3, DUSK2, 0.1)
				fadeOut(beam, 0.45, { Size = Vector3.new(beam.Size.X, 0.4, 0.4) })
				local mg = moonGroup(3, MOON, 1.2)
				local face = camFace(pg, dir)
				anim(0.4, function(u)
					local p = pg + UP * (6 + u * 26)
					gset(mg, CFrame.lookAt(p, p + Vector3.new(face.X, 0, face.Z)) * CFrame.Angles(0, 0, u * 4))
					if u >= 1 then
						gfade(mg, 0.15)
					end
				end)
				Fx.ring(pg + UP * 0.4, DUSK2, 1, 12, 0.3)
				Fx.sound("deflect", 0.5, 1.2, pg)
			end)
		end
	end)
	-- 해가 다 잠긴다: 바다가 검보랏빛으로 식고 고요해진다
	task.delay(total, function()
		local cold = DARK:Lerp(DUSK2, 0.45)
		tween(sea, dark, { Color = cold })
		tween(rim, dark, { Color = DARK })
		tween(glow, dark, { Transparency = 1 })
		if opts.tint then
			opts.tint(Color3.fromRGB(120, 90, 150), 0.5, dark)
		end
	end)
	-- 노을 불꽃의 왕관: 바다가 한꺼번에 솟구친다
	task.delay(total + dark, function()
		fadeOut(sea, 0.4)
		fadeOut(rim, 0.4)
		fadeOut(glow, 0.1)
		for k = 0, 19 do
			local a = k / 20 * math.pi * 2
			local out = Vector3.new(math.cos(a), 0, math.sin(a))
			local p = g + out * (R * 0.7)
			local h = 16 + (k % 2) * 10
			local sp = beamTo(p, p + UP * h + out * 4, 3.2, k % 2 == 0 and DUSK or DUSK2, 0.1)
			fadeOut(sp, 0.7, { Size = Vector3.new(sp.Size.X, 0.4, 0.4) })
		end
		local col = beamTo(g - UP * 2, g + UP * 130, 18, SUN_CORE, 0.05)
		fadeOut(col, 0.8, { Size = Vector3.new(col.Size.X, 50, 50) })
		local core = part(v3(6), WHITE, Enum.Material.Neon, 0, "ball")
		core.Position = g + UP * 2
		fadeOut(core, 0.7, { Size = v3(R * 2.2) })
		local shell = part(v3(8), DUSK, Enum.Material.Neon, 0.35, "ball")
		shell.Position = g + UP * 2
		fadeOut(shell, 0.9, { Size = v3(R * 3) })
		local outer = part(v3(8), DUSK2, Enum.Material.Neon, 0.6, "ball")
		outer.Position = g + UP * 2
		fadeOut(outer, 1.0, { Size = v3(R * 3.8) })
		for k = 0, 11 do
			local a = k / 12 * math.pi * 2 + 0.2
			local out = Vector3.new(math.cos(a), 0, math.sin(a))
			local mg = moonGroup(2.8, k % 2 == 0 and DUSK2 or DUSK, 1)
			anim(0.65, function(u)
				local p = g + UP * (4 + math.sin(u * math.pi) * 9) + out * (4 + u * R * 1.7)
				gset(mg, CFrame.lookAt(p, p + out) * CFrame.Angles(0, math.rad(90), u * 9))
				if u >= 1 then
					gfade(mg, 0.15)
				end
			end)
		end
		Fx.ring(g + UP * 0.5, DUSK, 6, R * 3.2, 0.8)
		Fx.ring(g + UP * 2, DUSK2, 5, R * 2.5, 0.7)
		Fx.blast(g + UP * 3, DUSK, DUSK2, 3.4)
		Fx.debris(g, 16, 44)
		Fx.flash(c, DUSK, 150, 9, 0.9)
		if opts.flash and near(c, 120) then
			opts.flash(DUSK, 0.3)
		end
		Fx.breakSound("boom", 1.2, 0.4, c)
		Fx.breakSound("rock", 1, 0.6, c)
		shakeNear(c, 2.4, 240)
	end)
end

------------------------------------------------------------------------
-- 일월동귀 (황혼의 초 오의, 3.1.1판 새로)
-- 컷씬: 하늘이 노을로 물들고 양쪽에서 거대한 석양과 보랏빛 달이 내게로 내려온다
-- → 둘이 빨려 들며 작아져 내 오른손 (해) 과 왼손 (달) 에 맺힌다
-- → 손을 떠나 발밑 진의 테두리를 서로 반대로 내달리며 불의 원을 그리고, 앞에서 만난다
-- → 하나가 된 황혼의 구슬이 머리 위로 떠올라 커지며 둘레를 빨아들이다가, 한 점으로 줄어든다 (빛이 모두 꺼진다)
-- → 세상이 노을빛으로 하얗게 터진다
------------------------------------------------------------------------
function H.twilightCollapse(d: any)
	local C: Vector3 = d.at
	if not near(C, 600) then
		return
	end
	local look = flat(d.dir or Vector3.new(0, 0, -1))
	local right = Vector3.new(-look.Z, 0, look.X)
	local T1 = d.cut or 1.3
	local T2 = T1 + (d.gather or 0.8)
	local T3 = T2 + (d.circle or 1.2)
	local T4 = T3 + (d.fuse or 0.6)
	local T5 = T4 + (d.collapse or 0.35)
	local RR = d.rim or 26
	local gC = ground(C)
	local m = d.m
	local function hand(name: string, fallback: Vector3): Vector3
		local h = typeof(m) == "Instance" and m:FindFirstChild(name)
		if h and h:IsA("BasePart") then
			return h.Position
		end
		return fallback
	end
	local graded = near(C, 250)
	if graded then
		gradeTo(0.8, -0.2, -0.15, 0.2, Color3.fromRGB(255, 190, 170))
	end
	runSigil(C, RR, DUSK, DUSK2, T4, 1.3)
	Fx.sound("ping", 0.7, 0.3, C)
	local bigSun, bigMoon = sunGroup(11, DUSK), moonGroup(13, DUSK2, 5)
	local smallSun, smallMoon = sunGroup(1.4, DUSK), moonGroup(1.9, DUSK2, 0.8)
	galpha(bigSun, 1)
	galpha(bigMoon, 1)
	galpha(smallSun, 1)
	galpha(smallMoon, 1)
	local sunA, sunB = C + right * 34 + UP * 70 - look * 10, C + right * 15 + UP * 13
	local moonA, moonB = C - right * 34 + UP * 74 - look * 10, C - right * 15 + UP * 14
	local trail: { BasePart } = {}
	local lastTrail = 0
	local rhHold, lhHold = C + right * 2, C - right * 2
	local function rimAt(a: number): Vector3
		return gC + UP * 3 + (right * math.cos(a) + look * math.sin(a)) * RR
	end
	local hidden = false
	anim(T3, function(u)
		local t = u * T3
		if t < T1 then
			local k = t / T1
			local e = 1 - (1 - k) ^ 2
			local sp, mp = sunA:Lerp(sunB, e), moonA:Lerp(moonB, e)
			galpha(bigSun, 1 - math.min(1, k * 3))
			galpha(bigMoon, 1 - math.min(1, k * 3))
			gset(bigSun, CFrame.lookAt(sp, sp + camFace(sp, -look)) * CFrame.Angles(0, 0, t * 1.5))
			gset(bigMoon, CFrame.lookAt(mp, mp + camFace(mp, -look)) * CFrame.Angles(0, 0, -0.4))
			if math.random() < 0.3 then
				Fx.burst("ember", gC + UP, DUSK, 3, 1.5)
			end
		elseif t < T2 then
			local k = (t - T1) / (T2 - T1)
			local rh = hand("RightHand", C + right * 2 + UP)
			local lh = hand("LeftHand", C - right * 2 + UP)
			rhHold, lhHold = rh, lh
			local bp, bm = sunB:Lerp(rh, k * k), moonB:Lerp(lh, k * k)
			gset(bigSun, CFrame.lookAt(bp, bp + camFace(bp, -look)) * CFrame.Angles(0, 0, t * 3))
			gset(bigMoon, CFrame.lookAt(bm, bm + camFace(bm, -look)) * CFrame.Angles(0, 0, -0.4))
			galpha(bigSun, k)
			galpha(bigMoon, k)
			gset(smallSun, CFrame.lookAt(rh, rh + camFace(rh, -look)) * CFrame.Angles(0, 0, t * 4))
			gset(smallMoon, CFrame.lookAt(lh, lh + camFace(lh, -look)))
			galpha(smallSun, 1 - k)
			galpha(smallMoon, 1 - k)
			if math.random() < 0.6 then
				trailDot(bp, 1 + 4 * (1 - k), DUSK, 0.3)
				trailDot(bm, 1 + 4 * (1 - k), DUSK2, 0.3)
			end
		else
			if not hidden then
				hidden = true
				gfade(bigSun, 0.05)
				gfade(bigMoon, 0.05)
				Fx.sound("swing", 1, 0.5, C)
			end
			-- 해는 오른쪽에서 뒤로 돌아, 달은 왼쪽에서 뒤로 돌아 각각 4분의 3 바퀴를 돌아 앞에서 만난다
			local k = (t - T2) / (T3 - T2)
			local aS = -k * 1.5 * math.pi
			local aM = math.pi + k * 1.5 * math.pi
			local j = math.clamp(k / 0.12, 0, 1)
			local sp = rhHold:Lerp(rimAt(aS), j)
			local mp = lhHold:Lerp(rimAt(aM), j)
			gset(smallSun, CFrame.lookAt(sp, sp + camFace(sp, -look)) * CFrame.Angles(0, 0, t * 6))
			gset(smallMoon, CFrame.lookAt(mp, mp + camFace(mp, -look)) * CFrame.Angles(0, 0, t * 6))
			if os.clock() - lastTrail > 0.02 then
				lastTrail = os.clock()
				for _, q in ipairs({ { sp, DUSK }, { mp, DUSK2 } }) do
					local f = part(v3(3.2), q[2] :: Color3, Enum.Material.Neon, 0.2, "ball")
					f.Position = (q[1] :: Vector3) - UP * 1.5
					table.insert(trail, f)
					local fl = part(Vector3.new(1.2, 5, 1.2), (q[2] :: Color3):Lerp(SUN_CORE, 0.3), Enum.Material.Neon, 0.35)
					local fp = (q[1] :: Vector3) + UP * 0.5
					fl.Position = fp
					fadeOut(fl, 0.4, { Size = Vector3.new(0.2, 9, 0.2), Position = fp + UP * 3 })
				end
				if math.random() < 0.4 then
					Fx.burst("ember", sp, DUSK, 3, 1.3)
					Fx.burst("glitter", mp, DUSK2, 3, 1.3)
				end
			end
			if u >= 1 then
				gfade(smallSun, 0.05)
				gfade(smallMoon, 0.05)
			end
		end
	end)
	-- 하나가 된다: 앞에서 만난 둘이 황혼의 구슬이 되어 머리 위로 떠오르며 커지고, 둘레를 빨아들이다가 한 점으로 줄어든다
	task.delay(T3, function()
		local F = rimAt(math.pi / 2)
		local O = C + UP * 18
		local core = part(v3(1), WHITE, Enum.Material.Neon, 0, "ball")
		local inner = part(v3(1), DUSK, Enum.Material.Neon, 0.15, "ball")
		local outer = part(v3(1), DUSK2, Enum.Material.Neon, 0.5, "ball")
		local ringA, ringB = group(), group()
		gHalo(ringA, 13, 0.7, DUSK, 30, 0.1, nil)
		gHalo(ringB, 15, 0.5, DUSK2, 34, 0.2, nil)
		galpha(ringA, 1)
		galpha(ringB, 1)
		Fx.flash(F, DUSK, 120, 8, 0.4)
		Fx.breakSound("boom", 1, 0.5, C)
		shakeNear(C, 1.6, 240)
		local fuse, col = T4 - T3, T5 - T4
		anim(fuse + col, function(u)
			local t = u * (fuse + col)
			local p, s
			if t < fuse then
				local k = t / fuse
				p = F:Lerp(O, 1 - (1 - k) ^ 2)
				s = 3 + 19 * k
				galpha(ringA, 1 - k)
				galpha(ringB, 1 - k)
				if math.random() < 0.7 then
					local a = math.random() * math.pi * 2
					local q = gC + Vector3.new(math.cos(a) * RR * 1.2, 1 + math.random() * 6, math.sin(a) * RR * 1.2)
					local b = beamTo(q, p, 0.3, math.random() < 0.5 and DUSK or DUSK2, 0.3)
					fadeOut(b, 0.15)
				end
			else
				local k = (t - fuse) / col
				p = O
				s = 22 * (1 - k) ^ 3 + 0.4
				galpha(ringA, k)
				galpha(ringB, k)
			end
			core.Size = v3(s * 0.45)
			core.Position = p
			inner.Size = v3(s * 0.8)
			inner.Position = p
			outer.Size = v3(s)
			outer.Position = p
			gset(ringA, CFrame.new(p) * CFrame.Angles(t * 2.2, t * 1.4, 0))
			gset(ringB, CFrame.new(p) * CFrame.Angles(-t * 1.6, 0, t * 2.4))
			if u >= 1 then
				core:Destroy()
				inner:Destroy()
				outer:Destroy()
				gfade(ringA, 0.05)
				gfade(ringB, 0.05)
			end
		end)
	end)
	-- 줄어드는 순간: 불의 원과 모든 빛이 꺼진다
	task.delay(T4, function()
		for _, p in ipairs(trail) do
			if p.Parent then
				fadeOut(p, 0.12)
			end
		end
		if graded then
			gradeTo(0.2, -0.6, -0.4, 0.3, Color3.fromRGB(200, 170, 230))
		end
		Fx.sound("ping", 0.5, 0.35, C)
	end)
	-- 세상이 노을빛으로 하얗게 터진다
	task.delay(T5, function()
		local R = d.radius or 50
		local O = C + UP * 18
		local core = part(v3(4), WHITE, Enum.Material.Neon, 0, "ball")
		core.Position = O
		fadeOut(core, 1.0, { Size = v3(140) })
		local shell = part(v3(6), DUSK, Enum.Material.Neon, 0.35, "ball")
		shell.Position = O
		fadeOut(shell, 1.2, { Size = v3(180) })
		local shell2 = part(v3(6), DUSK2, Enum.Material.Neon, 0.55, "ball")
		shell2.Position = O
		fadeOut(shell2, 1.4, { Size = v3(220) })
		for k = 0, 15 do
			local a = k / 16 * math.pi * 2
			local out = Vector3.new(math.cos(a), 0, math.sin(a))
			local mg = moonGroup(4, k % 2 == 0 and DUSK or DUSK2, 1.4)
			anim(0.7, function(u)
				local p = O:Lerp(gC + UP * 3, u) + out * (3 + u * R * 1.3)
				gset(mg, CFrame.lookAt(p, p + out) * CFrame.Angles(0, math.rad(90), u * 10))
				if u >= 1 then
					gfade(mg, 0.15)
				end
			end)
			local ray = beamTo(gC + UP * 0.3, gC + out * R * 1.4 + UP * 0.3, 1.6, k % 2 == 0 and DUSK or DUSK2, 0.1)
			fadeOut(ray, 0.7)
		end
		local colm = beamTo(gC - UP * 2, gC + UP * 160, 24, WHITE, 0.05)
		fadeOut(colm, 1.0, { Size = Vector3.new(colm.Size.X, 60, 60) })
		Fx.ring(gC + UP * 0.5, WHITE, 8, R * 3.2, 1.0)
		Fx.ring(gC + UP * 2, DUSK, 6, R * 2.6, 0.9)
		Fx.ring(gC + UP * 4, DUSK2, 6, R * 2, 0.8)
		Fx.blast(gC + UP * 4, DUSK, DUSK2, 4.4)
		Fx.debris(gC, 24, 54)
		Fx.flash(O, WHITE, 260, 12, 1.4)
		if opts.flash and near(C, 200) then
			opts.flash(Color3.fromRGB(255, 220, 200), 0.5)
		end
		Fx.breakSound("boom", 1.3, 0.26, C)
		Fx.breakSound("glass", 1, 0.45, C)
		shakeNear(C, 3.2, 320)
		if graded then
			gradeTo(0.1, 0.2, 0.5, 0.1, Color3.fromRGB(255, 205, 170))
			task.delay(0.3, function()
				gradeReset(1.8)
			end)
		end
	end)
end

------------------------------------------------------------------------
-- 일월극변: 서버 전체에 컷씬. 하늘에서 해와 달이 미친 듯이 번갈아 뜨다가, 둘이 겹쳐 지는 해가 되고 세상이 황혼에 멈춘다
-- (낮과 밤을 번갈아 바꾸는 것은 서버가 한다: 모두에게 같은 박자로. 화면은 하늘의 해·달과 소리·번쩍임만)
------------------------------------------------------------------------
local duskSky: BasePart? = nil
function Geuk.twilight(d: any)
	local cut, dur = d.cut or 3, d.dur or 40
	local cam = workspace.CurrentCamera
	if not cam then
		return
	end
	local camPos = cam.CFrame.Position
	local fwd = flat(cam.CFrame.LookVector)
	local skyAt = camPos + fwd * 380 + Vector3.new(0, 170, 0)
	local sun = sunGroup(18)
	local moon = moonGroup(26, MOON, 11)
	local beats = 12
	local t0 = os.clock()
	local lastBeat = -1
	anim(cut, function(u)
		-- 박자가 점점 빨라진다 (u²)
		local beat = math.floor((u * u) * beats * 1.6)
		local day = beat % 2 == 0
		gset(sun, CFrame.new(skyAt) * CFrame.Angles(0, 0, os.clock() - t0))
		gset(moon, CFrame.lookAt(skyAt, camPos) * CFrame.Angles(0, 0, -(os.clock() - t0)))
		galpha(sun, day and 0 or 1)
		galpha(moon, day and 1 or 0)
		if beat ~= lastBeat then
			lastBeat = beat
			Fx.sound(day and "deflect" or "block", 0.5, day and 1.4 or 0.8)
			if opts.flash then
				opts.flash(day and SUN or MOON, 0.15)
			end
			if opts.shake then
				opts.shake(0.25 + u * 0.6)
			end
		end
		if u >= 1 then
			gfade(sun, 0.4)
			gfade(moon, 0.4)
		end
	end)
	-- 해와 달이 겹친 지는 해: 황혼 동안 하늘 끝에 걸려 있다
	task.delay(cut, function()
		if duskSky then
			duskSky:Destroy()
		end
		local horizon = camPos + fwd * 420 + Vector3.new(0, 40, 0)
		local disc = part(Vector3.new(60, 60, 60), DUSK, Enum.Material.Neon, 0.1, "ball")
		disc.Position = horizon
		local veil = part(Vector3.new(90, 90, 90), DUSK2, Enum.Material.Neon, 0.7, "ball")
		veil.Position = horizon
		duskSky = disc
		if opts.flash then
			opts.flash(DUSK, 0.6)
		end
		if opts.shake then
			opts.shake(1.4)
		end
		Fx.sound("deflect", 0.9, 0.5)
		task.delay(dur, function()
			fadeOut(disc, 1.2)
			fadeOut(veil, 1.2)
			if duskSky == disc then
				duskSky = nil
			end
		end)
	end)
	-- 황혼의 주인: 몸에서 노을빛 불꽃과 보랏빛 연기가 피어오른다
	local r = rootOf(d.m)
	if r then
		local a = Instance.new("Attachment")
		a.Parent = r
		local e = Instance.new("ParticleEmitter")
		e.Texture = "rbxasset://textures/particles/fire_main.dds"
		e.Color = ColorSequence.new(DUSK, DUSK2)
		e.LightEmission = 0.8
		e.Rate = 30
		e.Lifetime = NumberRange.new(0.5, 0.9)
		e.Speed = NumberRange.new(3, 6)
		e.SpreadAngle = Vector2.new(25, 25)
		e.Size = NumberSequence.new(1.6, 0)
		e.Transparency = NumberSequence.new(0.2, 1)
		e.Acceleration = Vector3.new(0, 8, 0)
		e.Parent = a
		local pl = Instance.new("PointLight")
		pl.Color = DUSK
		pl.Range = 14
		pl.Brightness = 1.5
		pl.Parent = a
		task.delay(cut + dur, function()
			e.Enabled = false
			task.delay(1, function()
				a:Destroy()
			end)
		end)
	end
end

------------------------------------------------------------------------
-- 초 오의 컷씬 (쓴 사람 화면에서만, 대사 없이)
-- 일월개벽: 앞쪽 낮은 곳에서 나를 올려다보며 물러선다 (내 등 뒤 지평선에서 해와 달이 솟는다)
-- 일월동귀: 나를 가운데 두고 천천히 돌며 올라간다 (양쪽에서 석양과 달이 내려온다)
------------------------------------------------------------------------
local cutActive = false
function Geuk.superCut(model: Model, dur: number, name: string, shake: ((number) -> ())?, dusk: boolean?)
	local cam = workspace.CurrentCamera
	local r = rootOf(model)
	local player = game:GetService("Players").LocalPlayer
	if not cam or not r or cutActive or not player then
		return
	end
	cutActive = true
	local g = Instance.new("ScreenGui")
	g.Name = "KwonGeukCut"
	g.IgnoreGuiInset = true
	g.ResetOnSpawn = false
	g.DisplayOrder = 85
	g.Parent = player:WaitForChild("PlayerGui")
	local tintF = Instance.new("Frame")
	tintF.Size = UDim2.fromScale(1, 1)
	tintF.BackgroundColor3 = dusk and Color3.fromRGB(90, 30, 60) or Color3.fromRGB(20, 18, 50)
	tintF.BackgroundTransparency = 1
	tintF.BorderSizePixel = 0
	tintF.Parent = g
	local grad = Instance.new("UIGradient")
	grad.Rotation = 90
	grad.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.1), NumberSequenceKeypoint.new(0.4, 1), NumberSequenceKeypoint.new(0.6, 1), NumberSequenceKeypoint.new(1, 0.1) })
	grad.Parent = tintF
	tween(tintF, 0.3, { BackgroundTransparency = 0.4 })
	local bars: { Frame } = {}
	for i, y in ipairs({ 0, 1 }) do
		local b = Instance.new("Frame")
		b.AnchorPoint = Vector2.new(0, y)
		b.Position = UDim2.fromScale(0, y)
		b.Size = UDim2.new(1, 0, 0, 0)
		b.BackgroundColor3 = Color3.new(0, 0, 0)
		b.BorderSizePixel = 0
		b.ZIndex = 5
		b.Parent = g
		tween(b, 0.15, { Size = UDim2.new(1, 0, 0.14, 0) })
		bars[i] = b
	end
	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.AnchorPoint = Vector2.new(1, 0.5)
	label.Position = UDim2.new(1, -30, 0.5, 0)
	label.Size = UDim2.new(0.5, 0, 0.45, 0)
	label.Font = Enum.Font.GothamBlack
	label.TextScaled = true
	label.TextXAlignment = Enum.TextXAlignment.Right
	label.Text = "초 오의 · " .. name
	label.TextColor3 = dusk and Color3.fromRGB(255, 200, 150) or SUN_CORE
	label.TextStrokeColor3 = dusk and DUSK2 or Color3.fromRGB(60, 80, 160)
	label.TextStrokeTransparency = 0.2
	label.TextTransparency = 1
	label.ZIndex = 6
	label.Parent = bars[2]
	tween(label, 0.25, { TextTransparency = 0 })
	local oldType = cam.CameraType
	local oldFov = cam.FieldOfView
	local look = flat(r.CFrame.LookVector)
	local side = Vector3.new(-look.Z, 0, look.X)
	cam.CameraType = Enum.CameraType.Scriptable
	local t0 = os.clock()
	local focus = r.Position
	local finished = false
	local function restore()
		if finished then
			return
		end
		finished = true
		RunService:UnbindFromRenderStep("KwonGeukCut")
		cam.CameraType = oldType == Enum.CameraType.Scriptable and Enum.CameraType.Custom or oldType
		cam.FieldOfView = oldFov
		cutActive = false
		-- 컷씬이 끝나면 카메라를 내 등 뒤 높은 곳으로 (하늘에서 벌어지는 일이 잘 보이게)
		local function behind()
			if r.Parent then
				local lk = flat(r.CFrame.LookVector)
				cam.CFrame = CFrame.lookAt(r.Position - lk * 22 + UP * 12, r.Position + lk * 4 + UP * 10)
			end
		end
		behind()
		task.defer(behind)
		for _, b in ipairs(bars) do
			tween(b, 0.2, { Size = UDim2.new(1, 0, 0, 0) })
		end
		tween(tintF, 0.25, { BackgroundTransparency = 1 })
		tween(label, 0.2, { TextTransparency = 1 })
		task.delay(0.3, function()
			g:Destroy()
		end)
	end
	RunService:BindToRenderStep("KwonGeukCut", Enum.RenderPriority.Camera.Value + 2, function(dt: number)
		if finished then
			return
		end
		if not r.Parent then
			restore()
			return
		end
		local t = os.clock() - t0
		local k = math.clamp(t / dur, 0, 1)
		focus = focus:Lerp(r.Position, math.min(1, dt * 10))
		local e = 1 - (1 - k) ^ 2
		if dusk then
			local a = e * math.rad(150) - math.rad(40)
			local eye = focus + (look * math.cos(a) + side * math.sin(a)) * (13 + e * 5) + UP * (1.5 + e * 6)
			cam.CFrame = CFrame.lookAt(eye, focus + UP * (3 + e * 8))
		else
			local eye = focus + look * (9 + e * 6) + side * math.sin(e * 0.8) * 6 + UP * (0.6 + e * 2.5)
			cam.CFrame = CFrame.lookAt(eye, focus - look * 60 + UP * (14 + e * 14))
		end
		cam.FieldOfView = oldFov + e * 12
		if t >= dur then
			restore()
		end
	end)
	if shake then
		task.delay(dur * 0.55, function()
			shake(0.8)
		end)
	end
	task.delay(dur + 1, restore)
end

local PULSE: { [string]: string } = { dusk = "duskPulse" }
function Geuk.handles(data: any): boolean
	if data.kind == "pulse" then
		return PULSE[data.fx or ""] ~= nil
	end
	return H[data.kind] ~= nil
end
function Geuk.run(data: any)
	local fn = data.kind == "pulse" and H[PULSE[data.fx or ""] or ""] or H[data.kind]
	if fn then
		fn(data)
	end
end

return Geuk
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="31">
          <Properties>
            <string name="Name">Gourd</string>
            <string name="Source"><![CDATA[-- 권왕 2.9판: 진 취팔선권 (취선) 의 기술 (화면). 호리병, 술의 강, 여덟 신선의 그림자
-- 호리병은 아래가 크고 위가 작은 두 구 (잘록한 허리에 끈), 좁은 목과 마개로 짓는다. 술은 보랏빛 도는 짙은 술빛
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local Config = require(ReplicatedStorage:WaitForChild("Config"))
local Fx = require(script.Parent:WaitForChild("Fx"))

local Gourd = {}

local folder = Instance.new("Folder")
folder.Name = "KwonGourd"
folder.Parent = workspace

local opts: any = {}
function Gourd.init(o: any)
	opts = o or {}
end

local SHELL = Color3.fromRGB(196, 140, 62)
local SHELL_DARK = Color3.fromRGB(150, 98, 40)
local CORD = Color3.fromRGB(170, 30, 40)
local WINE = Color3.fromRGB(150, 60, 170)
local WINE_LIGHT = Color3.fromRGB(220, 150, 255)
local FLAME = Color3.fromRGB(255, 150, 60)
local GHOST = Color3.fromRGB(205, 170, 255)
local UPRIGHT = CFrame.Angles(0, 0, math.rad(90))

local function tween(inst: Instance, time: number, goal: { [string]: any }, style: Enum.EasingStyle?, dir: Enum.EasingDirection?)
	local tw = TweenService:Create(inst, TweenInfo.new(math.max(0.01, time), style or Enum.EasingStyle.Quad, dir or Enum.EasingDirection.Out), goal)
	tw:Play()
	return tw
end
local function near(pos: Vector3, d: number): boolean
	local cam = workspace.CurrentCamera
	return cam ~= nil and (cam.CFrame.Position - pos).Magnitude < d
end
local function rootOf(m: Instance?): BasePart?
	local r = m and m:FindFirstChild("HumanoidRootPart")
	return (r and r:IsA("BasePart")) and r or nil
end
local function ground(at: Vector3): Vector3
	return Vector3.new(at.X, at.Y - 2.7, at.Z)
end
local function part(size: Vector3, color: Color3, material: Enum.Material?, alpha: number?, shape: string?): BasePart
	local q = Instance.new("Part")
	if shape == "ball" then
		q.Shape = Enum.PartType.Ball
	elseif shape == "cyl" then
		q.Shape = Enum.PartType.Cylinder
	end
	q.Anchored = true
	q.CanCollide = false
	q.CanQuery = false
	q.CanTouch = false
	q.CastShadow = false
	q.Size = size
	q.Color = color
	q.Material = material or Enum.Material.SmoothPlastic
	q.Transparency = alpha or 0
	q.Parent = folder
	return q
end
local function fadeOut(p: BasePart, time: number, goal: { [string]: any }?)
	local g = goal or {}
	g.Transparency = 1
	tween(p, time, g)
	task.delay(time + 0.05, function()
		p:Destroy()
	end)
end
local function shakeNear(pos: Vector3, amount: number, range: number)
	if opts.shake and near(pos, range) then
		opts.shake(amount)
	end
end
local function anim(life: number, fn: (number) -> ())
	local t0 = os.clock()
	local conn: RBXScriptConnection
	conn = RunService.Heartbeat:Connect(function()
		local u = math.clamp((os.clock() - t0) / life, 0, 1)
		fn(u)
		if u >= 1 then
			conn:Disconnect()
		end
	end)
end

------------------------------------------------------------------------
-- 호리병: cf = 병의 아래 구 가운데, 위(Y)가 목. S = 크기
------------------------------------------------------------------------
type Gourd = { parts: { BasePart }, place: (CFrame) -> () }
local function gourd(S: number): Gourd
	local low = part(Vector3.one, SHELL, Enum.Material.SmoothPlastic, 0, "ball")
	local high = part(Vector3.one, SHELL, Enum.Material.SmoothPlastic, 0, "ball")
	local waist = part(Vector3.one, CORD, Enum.Material.Fabric, 0, "cyl")
	local neck = part(Vector3.one, SHELL_DARK, Enum.Material.SmoothPlastic, 0, "cyl")
	local cork = part(Vector3.one, Color3.fromRGB(110, 70, 40), Enum.Material.Wood, 0, "cyl")
	local tassel = part(Vector3.one, CORD, Enum.Material.Fabric)
	local list = { low, high, waist, neck, cork, tassel }
	local function place(cf: CFrame)
		low.Size = Vector3.new(1.6, 1.5, 1.6) * S
		low.CFrame = cf
		high.Size = Vector3.new(1.05, 1.0, 1.05) * S
		high.CFrame = cf * CFrame.new(0, 1.15 * S, 0)
		waist.Size = Vector3.new(0.18 * S, 0.62 * S, 0.62 * S)
		waist.CFrame = cf * CFrame.new(0, 0.66 * S, 0) * UPRIGHT
		neck.Size = Vector3.new(0.5 * S, 0.36 * S, 0.36 * S)
		neck.CFrame = cf * CFrame.new(0, 1.78 * S, 0) * UPRIGHT
		cork.Size = Vector3.new(0.18 * S, 0.42 * S, 0.42 * S)
		cork.CFrame = cf * CFrame.new(0, 2.05 * S, 0) * UPRIGHT
		tassel.Size = Vector3.new(0.12, 0.7, 0.12) * S
		tassel.CFrame = cf * CFrame.new(0.3 * S, 0.3 * S, 0) * CFrame.Angles(0, 0, math.rad(12))
	end
	return { parts = list, place = place }
end
local function fadeGourd(g: Gourd, time: number)
	for _, p in ipairs(g.parts) do
		fadeOut(p, time)
	end
end
-- 술 방울이 튀어 올랐다가 떨어진다
local function splash(at: Vector3, n: number, power: number)
	for _ = 1, n do
		local d = Vector3.new(math.random() - 0.5, 0, math.random() - 0.5).Unit
		local drop = part(Vector3.one * (0.3 + math.random() * 0.35), math.random() < 0.5 and WINE or WINE_LIGHT, Enum.Material.Glass, 0.15, "ball")
		local up = power * (0.6 + math.random() * 0.6)
		local out = power * (0.3 + math.random() * 0.4)
		anim(0.7, function(u)
			local t = u * 0.7
			drop.Position = at + d * out * t + Vector3.new(0, up * t - 16 * t * t, 0)
			drop.Transparency = 0.15 + 0.85 * u
			if u >= 1 then
				drop:Destroy()
			end
		end)
	end
end

------------------------------------------------------------------------
-- 술 튐 (권법 장치): 상대 자리에서 술이 솟아 튀고, 어지러운 별이 맴돈다
------------------------------------------------------------------------
local function winePulse(data: any)
	local at: Vector3 = data.at
	if not near(at, 200) then
		return
	end
	local g = ground(at) + Vector3.new(0, 0.3, 0)
	task.delay(data.delay or 0.25, function()
		local col = part(Vector3.new(0.6, 3, 3), WINE, Enum.Material.Glass, 0.2, "cyl")
		col.CFrame = CFrame.new(g + Vector3.new(0, 0.3, 0)) * UPRIGHT
		tween(col, 0.15, { Size = Vector3.new(6, 2.2, 2.2), CFrame = CFrame.new(g + Vector3.new(0, 3, 0)) * UPRIGHT })
		task.delay(0.15, function()
			fadeOut(col, 0.25, { Size = Vector3.new(7, 0.4, 0.4) })
		end)
		splash(g + Vector3.new(0, 1, 0), 10, 12)
		Fx.ring(g, WINE, 2, (data.radius or 9) * 2, 0.35)
		-- 어지러운 별 셋
		for k = 1, 3 do
			local star = part(Vector3.one * 0.5, Color3.fromRGB(255, 230, 120), Enum.Material.Neon, 0, "ball")
			anim(0.9, function(u)
				local a = k / 3 * math.pi * 2 + u * 9
				star.Position = g + Vector3.new(math.cos(a) * 1.6, 4.6, math.sin(a) * 1.6)
				star.Transparency = u
				if u >= 1 then
					star:Destroy()
				end
			end)
		end
		Fx.sound("splash", 0.6, 1.2, g)
	end)
end

------------------------------------------------------------------------
-- 취월삼보 (E): 휘청이는 세 걸음. 내려설 때마다 그림자와 술 고리, 걸음 사이를 잇는 비틀린 빛
------------------------------------------------------------------------
local function drunkZig(data: any)
	local m: Model? = data.m
	local hops: { Vector3 } = data.hops or {}
	local r = rootOf(m)
	if not r or not near(r.Position, 220) then
		return
	end
	local every = data.every or 0.18
	local prev = r.Position
	for i, h in ipairs(hops) do
		local a = prev
		task.delay(i * every, function()
			local b = Vector3.new(h.X, a.Y, h.Z)
			-- 비틀린 빛줄기 (가운데가 옆으로 휜다)
			local side = Vector3.new(-(b - a).Unit.Z, 0, (b - a).Unit.X) * ((i % 2 == 0) and 1.6 or -1.6)
			local last = a
			for k = 1, 6 do
				local u = k / 6
				local p = a:Lerp(b, u) + side * math.sin(u * math.pi) + Vector3.new(0, math.sin(u * math.pi) * 1.2, 0)
				local seg = part(Vector3.new(0.25, 0.25, (p - last).Magnitude + 0.1), k % 2 == 0 and WINE_LIGHT or WINE, Enum.Material.Neon, 0.1)
				seg.CFrame = CFrame.lookAt((p + last) / 2, p)
				fadeOut(seg, 0.4)
				last = p
			end
			if m then
				Fx.afterimage(m, GHOST, 0.4)
			end
			local g = ground(b) + Vector3.new(0, 0.3, 0)
			Fx.ring(g, WINE, 2, 13, 0.3)
			splash(g + Vector3.new(0, 0.6, 0), 6, 9)
			Fx.sound("swing", 0.8, 0.7 + i * 0.1, g)
		end)
		prev = Vector3.new(h.X, r.Position.Y, h.Z)
	end
end

------------------------------------------------------------------------
-- 주천강 (R): 손의 호리병에서 술이 쏟아져 앞으로 강이 되어 흐르고, 끝에 불이 붙는다
------------------------------------------------------------------------
local function wineRiver(data: any)
	local from: Vector3, to: Vector3 = data.from, data.to
	if not near(from, 260) then
		return
	end
	local W = data.width or 6
	local delay, dur = data.delay or 0.25, data.dur or 2
	local dir = (to - from).Unit
	local len = (to - from).Magnitude
	local gf, gt = ground(from), ground(to)
	-- 들어 올린 호리병과 쏟아지는 술줄기
	local m: Model? = data.m
	local r = rootOf(m)
	local held = gourd(0.9)
	local spout = part(Vector3.new(0.5, 0.5, 1), WINE, Enum.Material.Glass, 0.15)
	anim(delay + 0.4, function(u)
		local base = r and r.CFrame or CFrame.new(from)
		local hand = base * CFrame.new(1.4, 2.4, -1.2) * CFrame.Angles(math.rad(-50 - u * 50), 0, 0)
		held.place(hand)
		local mouth = (hand * CFrame.new(0, 2.1 * 0.9, 0)).Position
		local hitG = gf + dir * 2 + Vector3.new(0, 0.3, 0)
		spout.Size = Vector3.new(0.45, 0.45, (hitG - mouth).Magnitude)
		spout.CFrame = CFrame.lookAt((mouth + hitG) / 2, hitG)
		if u >= 1 then
			fadeGourd(held, 0.3)
			fadeOut(spout, 0.3)
		end
	end)
	-- 강: 앞으로 흘러가며 넓어지는 술빛 물길, 물길 위를 흘러가는 물결
	local river = part(Vector3.new(0.2, W, 1), WINE, Enum.Material.Glass, 0.25)
	local shine = part(Vector3.new(0.21, W * 0.4, 1), WINE_LIGHT, Enum.Material.Neon, 0.6)
	anim(delay + 0.35, function(u)
		local l = math.max(1, len * u)
		local mid = gf + dir * (l / 2) + Vector3.new(0, 0.12, 0)
		local cf = CFrame.lookAt(mid, mid + dir) * CFrame.Angles(0, 0, math.rad(90))
		river.Size = Vector3.new(0.2, W, l)
		river.CFrame = cf
		shine.Size = Vector3.new(0.22, W * 0.4, l)
		shine.CFrame = cf
	end)
	local n = math.floor(dur / 0.25)
	for k = 0, n - 1 do
		task.delay(delay + k * 0.25, function()
			local rip = part(Vector3.new(0.12, W * 0.9, 0.3), WINE_LIGHT, Enum.Material.Neon, 0.3)
			local s = gf + Vector3.new(0, 0.25, 0)
			anim(0.8, function(u)
				local p = s + dir * (len * u)
				rip.CFrame = CFrame.lookAt(p, p + dir) * CFrame.Angles(0, 0, math.rad(90))
				rip.Transparency = 0.3 + 0.7 * u
				if u >= 1 then
					rip:Destroy()
				end
			end)
		end)
	end
	-- 불이 붙는다: 강을 따라 불꽃이 앞으로 번진다
	task.delay(delay + dur, function()
		for k = 0, 11 do
			task.delay(k * 0.03, function()
				local p = gf + dir * (len * (k + 0.5) / 12) + Vector3.new(0, 0.3, 0)
				local tongue = part(Vector3.new(W * 0.5, 0.6, W * 0.5), FLAME, Enum.Material.Neon, 0.1, "ball")
				tongue.Position = p
				tween(tongue, 0.3, { Size = Vector3.new(W * 0.35, 7 + math.random() * 3, W * 0.35), Position = p + Vector3.new(0, 3.5, 0) })
				task.delay(0.3, function()
					fadeOut(tongue, 0.3, { Size = Vector3.new(0.4, 9, 0.4) })
				end)
				Fx.burst("ember", p, FLAME, 4, 1)
			end)
		end
		fadeOut(river, 0.6)
		fadeOut(shine, 0.4)
		Fx.flash(gf:Lerp(gt, 0.5), FLAME, len, 4, 0.5)
		Fx.breakSound("boom", 0.9, 1.1, gf:Lerp(gt, 0.5))
		shakeNear(from, 0.8, 90)
	end)
end

------------------------------------------------------------------------
-- 팔선강림 (오의): 여덟 신선의 그림자가 둘레에 나타나 차례로 적에게 덮쳐 들고, 하늘에서 거대한 호리병이 내리꽂힌다
------------------------------------------------------------------------
-- 신선 그림자 하나: 도포 자락 (넓어지는 몸), 머리, 늘어진 소매, 손의 작은 호리병
local function immortal(at: Vector3, face: Vector3): { BasePart }
	local list = {}
	local cf = CFrame.lookAt(at, at + face)
	local function add(size: Vector3, off: CFrame, color: Color3, shape: string?)
		local p = part(size, color, Enum.Material.ForceField, 0.25, shape)
		p.CFrame = cf * off
		table.insert(list, p)
		return p
	end
	add(Vector3.new(2.4, 3.6, 1.8), CFrame.new(0, 0.2, 0), GHOST)
	add(Vector3.new(3.2, 1.4, 2.4), CFrame.new(0, -1.9, 0), GHOST)
	add(Vector3.new(1.3, 1.3, 1.3), CFrame.new(0, 2.7, 0), GHOST, "ball")
	add(Vector3.new(0.9, 2.6, 0.9), CFrame.new(1.7, 0.4, -0.3) * CFrame.Angles(math.rad(-30), 0, math.rad(20)), GHOST)
	add(Vector3.new(0.9, 2.6, 0.9), CFrame.new(-1.7, 0.4, -0.3) * CFrame.Angles(math.rad(-30), 0, math.rad(-20)), GHOST)
	local g = gourd(0.45)
	g.place(cf * CFrame.new(2.1, -0.6, -0.8))
	for _, p in ipairs(g.parts) do
		table.insert(list, p)
	end
	return list
end
local function eightImmortals(data: any)
	local at: Vector3 = data.at
	if not near(at, 320) then
		return
	end
	local spots: { Vector3 } = data.spots or {}
	local targets: { any } = data.targets or {}
	local delay, every = data.delay or 0.35, data.every or 0.18
	local g0 = ground(at)
	if opts.tint then
		opts.tint(Color3.fromRGB(200, 170, 255), 0.25, delay + every * #spots + 1.2)
	end
	Fx.ring(g0 + Vector3.new(0, 0.3, 0), WINE, 4, 30, 0.6)
	for i, s in ipairs(spots) do
		local pos = Vector3.new(s.X, at.Y, s.Z)
		local ghost = immortal(pos, (at - pos).Unit)
		for _, p in ipairs(ghost) do
			p.Transparency = 1
			tween(p, 0.2, { Transparency = 0.25 })
		end
		task.delay(delay + (i - 1) * every, function()
			local tm = targets[i]
			local tr = typeof(tm) == "Instance" and rootOf(tm) or nil
			local dest = tr and tr.Position or at
			local shift = dest - pos
			-- 덮쳐 든다: 그림자 전체가 목표로 미끄러지며 옅어진다
			for _, p in ipairs(ghost) do
				fadeOut(p, 0.3, { CFrame = p.CFrame + shift * 0.9 })
			end
			local trail = part(Vector3.new(0.4, 0.4, shift.Magnitude + 0.1), GHOST, Enum.Material.Neon, 0.3)
			trail.CFrame = CFrame.lookAt(pos + shift / 2, dest)
			fadeOut(trail, 0.3)
			task.delay(0.15, function()
				Fx.ring(ground(dest) + Vector3.new(0, 0.3, 0), WINE_LIGHT, 2, 12, 0.3)
				splash(ground(dest) + Vector3.new(0, 0.6, 0), 6, 10)
				Fx.sound("hit", 0.8, 0.8 + i * 0.05, dest)
			end)
		end)
	end
	-- 하늘의 거대한 호리병이 내리꽂힌다
	local tEnd = delay + (#spots - 1) * every + (data.finalAt or 0.45)
	local big = gourd(7)
	local top = g0 + Vector3.new(0, 70, 0)
	big.place(CFrame.new(top) * CFrame.Angles(math.pi, 0, 0))
	for _, p in ipairs(big.parts) do
		p.Transparency = 1
	end
	task.delay(tEnd - 0.5, function()
		anim(0.5, function(u)
			local e = u * u
			big.place(CFrame.new(top:Lerp(g0 + Vector3.new(0, 10, 0), e)) * CFrame.Angles(math.pi, u * 2, 0))
			for _, p in ipairs(big.parts) do
				p.Transparency = 1 - math.min(1, u * 3)
			end
		end)
	end)
	task.delay(tEnd, function()
		fadeGourd(big, 0.5)
		local R = data.finalRadius or 18
		local wave = part(Vector3.new(1.2, 4, 4), WINE, Enum.Material.Glass, 0.2, "cyl")
		wave.CFrame = CFrame.new(g0 + Vector3.new(0, 0.6, 0)) * UPRIGHT
		fadeOut(wave, 0.6, { Size = Vector3.new(0.3, R * 2.6, R * 2.6) })
		splash(g0 + Vector3.new(0, 1, 0), 26, 22)
		Fx.ring(g0 + Vector3.new(0, 0.4, 0), WINE_LIGHT, 4, R * 2.6, 0.6)
		Fx.flash(g0, WINE_LIGHT, R * 3, 5, 0.5)
		Fx.breakSound("glass", 1, 0.6, g0)
		Fx.breakSound("rock", 1, 1, g0)
		shakeNear(at, 1.8, 140)
	end)
end

local HANDLERS: { [string]: (any) -> () } = {
	winePulse = winePulse,
	drunkZig = drunkZig,
	wineRiver = wineRiver,
	eightImmortals = eightImmortals,
}
function Gourd.handles(data: any): boolean
	return HANDLERS[data.kind] ~= nil
end
function Gourd.run(data: any)
	local fn = HANDLERS[data.kind]
	if fn then
		fn(data)
	end
end
-- 렌더 확인용
Gourd._gourd = gourd
Gourd._immortal = immortal
local _ = Config
return Gourd
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="32">
          <Properties>
            <string name="Name">Ink</string>
            <string name="Source"><![CDATA[-- 권왕 2.7판: 진 무극신권의 먹과 붓 (화면)
-- 획은 겹쳐 찍은 먹 방울로 그린다: 붓을 누른 처음은 굵고, 끝으로 갈수록 가늘어지며, 가장자리에 먹이 튄다.
-- 먹은 잠시 뒤 금빛으로 타오르며 터진다
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local Config = require(ReplicatedStorage:WaitForChild("Config"))
local Fx = require(script.Parent:WaitForChild("Fx"))

local Ink = {}
local _player = Players.LocalPlayer

local folder = Instance.new("Folder")
folder.Name = "KwonInk"
folder.Parent = workspace

local opts: any = {}
function Ink.init(o: any)
	opts = o or {}
end

local INK = Color3.fromRGB(14, 14, 18)
local INK2 = Color3.fromRGB(34, 32, 38)
local GOLD = Color3.fromRGB(255, 214, 120)
local GOLD2 = Color3.fromRGB(255, 244, 200)
local WOOD = Color3.fromRGB(70, 44, 30)
local UP = CFrame.Angles(0, 0, math.rad(90))

local function tween(inst: Instance, time: number, goal: { [string]: any }, style: Enum.EasingStyle?, dir: Enum.EasingDirection?)
	local tw = TweenService:Create(inst, TweenInfo.new(math.max(0.01, time), style or Enum.EasingStyle.Quad, dir or Enum.EasingDirection.Out), goal)
	tw:Play()
	return tw
end
local function near(pos: Vector3, d: number): boolean
	local cam = workspace.CurrentCamera
	return cam ~= nil and (cam.CFrame.Position - pos).Magnitude < d
end
local function ground(at: Vector3): Vector3
	return Vector3.new(at.X, at.Y - 2.7, at.Z)
end
local function part(size: Vector3, color: Color3, material: Enum.Material?, alpha: number?, shape: string?): BasePart
	local q = Instance.new("Part")
	if shape == "ball" then
		q.Shape = Enum.PartType.Ball
	elseif shape == "cyl" then
		q.Shape = Enum.PartType.Cylinder
	end
	q.Anchored = true
	q.CanCollide = false
	q.CanQuery = false
	q.CanTouch = false
	q.CastShadow = false
	q.Size = size
	q.Color = color
	q.Material = material or Enum.Material.SmoothPlastic
	q.Transparency = alpha or 0
	q.Parent = folder
	return q
end
local function fadeOut(p: BasePart, time: number, goal: { [string]: any }?)
	local g = goal or {}
	g.Transparency = 1
	tween(p, time, g)
	task.delay(time + 0.05, function()
		p:Destroy()
	end)
end
local function shakeNear(pos: Vector3, amount: number, range: number)
	if opts.shake and near(pos, range) then
		opts.shake(amount)
	end
end

-- 붓의 누름: 처음 0.15까지 굵어지고, 끝으로 가며 가늘어진다 (조금 물결친다)
local function pressure(u: number, seed: number): number
	local rise = math.clamp(u / 0.15, 0, 1)
	local fall = 1 - u * 0.7
	return (0.55 + 0.45 * rise) * fall * (1 + math.sin(u * 9 + seed) * 0.08)
end
-- 땅 위의 획: points를 따라 먹 방울을 찍는다. draw 동안 차례로 나타난다. 찍힌 조각 목록을 돌려준다
local function groundStroke(points: { Vector3 }, width: number, draw: number, seed: number): { BasePart }
	local out: { BasePart } = {}
	local total = 0
	for i = 2, #points do
		total += (points[i] - points[i - 1]).Magnitude
	end
	if total <= 0 then
		return out
	end
	local step = math.max(0.4, width * 0.32)
	local n = math.max(2, math.floor(total / step))
	local seg, acc = 2, 0
	for k = 0, n do
		local dist = total * k / n
		while seg < #points and acc + (points[seg] - points[seg - 1]).Magnitude < dist do
			acc += (points[seg] - points[seg - 1]).Magnitude
			seg += 1
		end
		local a, b = points[seg - 1], points[seg]
		local L = (b - a).Magnitude
		local pos = L > 0 and a:Lerp(b, math.clamp((dist - acc) / L, 0, 1)) or a
		local u = k / n
		local d = width * pressure(u, seed)
		local p = part(Vector3.new(0.12, d, d), u < 0.5 and INK or INK:Lerp(INK2, (u - 0.5)), Enum.Material.SmoothPlastic, 1, "cyl")
		p.CFrame = CFrame.new(ground(pos) + Vector3.new(0, 0.12 + (k % 3) * 0.004, 0)) * UP
		table.insert(out, p)
		task.delay(draw * u, function()
			if p.Parent then
				p.Transparency = 0
			end
		end)
		-- 가장자리에 튄 먹
		if (k * 7 + seed) % 5 == 0 then
			local side = Vector3.new(math.cos(k * 2.3 + seed), 0, math.sin(k * 2.3 + seed)) * d * (0.65 + (k % 3) * 0.15)
			local dot = part(Vector3.new(0.1, d * 0.22, d * 0.22), INK, Enum.Material.SmoothPlastic, 1, "cyl")
			dot.CFrame = CFrame.new(ground(pos + side) + Vector3.new(0, 0.11, 0)) * UP
			table.insert(out, dot)
			task.delay(draw * u + 0.03, function()
				if dot.Parent then
					dot.Transparency = 0
				end
			end)
		end
	end
	return out
end
-- 먹이 금빛으로 타올라 터진다: 조각들이 금빛이 되었다가 부풀며 사라지고, 몇 곳에서 금빛 기둥이 솟는다
local function ignite(parts: { BasePart }, life: number, columns: number?)
	for i, p in ipairs(parts) do
		if p.Parent then
			task.delay((i % 6) * 0.02, function()
				if not p.Parent then
					return
				end
				p.Material = Enum.Material.Neon
				tween(p, 0.12, { Color = GOLD })
				task.delay(0.12, function()
					if p.Parent then
						fadeOut(p, life, { Size = p.Size * Vector3.new(1, 1.5, 1.5), Color = GOLD2 })
					end
				end)
			end)
		end
	end
	local nc = columns or 0
	for c = 1, nc do
		local p = parts[math.max(1, math.floor(#parts * c / (nc + 1)))]
		if p and p.Parent then
			local at = p.Position
			local col = part(Vector3.new(1, 1.2, 1.2), GOLD, Enum.Material.Neon, 0.1, "cyl")
			col.CFrame = CFrame.new(at + Vector3.new(0, 0.5, 0)) * UP
			fadeOut(col, 0.45, { Size = Vector3.new(16, 0.3, 0.3), CFrame = CFrame.new(at + Vector3.new(0, 8, 0)) * UP })
		end
	end
end

------------------------------------------------------------------------
-- 일획 (E): 허공의 먹 획
------------------------------------------------------------------------
local function inkSlash(data: any)
	local from: Vector3, to: Vector3 = data.from, data.to
	if not near(from, 220) then
		return
	end
	local seed = data.seed or 1
	local delay = data.delay or 0.15
	local W = (data.width or 5) * 0.75
	local dir = (to - from)
	local L = dir.Magnitude
	dir = dir.Unit
	local side = Vector3.new(-dir.Z, 0, dir.X)
	local blots: { BasePart } = {}
	local n = math.floor(L / 0.8)
	task.delay(delay * 0.6, function()
		for k = 0, n do
			local u = k / n
			-- 살짝 휜 획 (가운데가 앞으로 부푼다), 처음은 조금 높고 끝은 낮게
			local pos = from:Lerp(to, u) + side * math.sin(u * math.pi) * 2.2 + Vector3.new(0, 1.2 - u * 0.9, 0)
			local d = W * pressure(u, seed)
			local b = part(Vector3.new(0.35, d, d * 1.5), INK, Enum.Material.SmoothPlastic, 0, "ball")
			b.CFrame = CFrame.lookAt(pos, pos + dir) * CFrame.Angles(0, 0, math.rad(8))
			b.Transparency = 1
			table.insert(blots, b)
			task.delay(u * 0.12, function()
				if b.Parent then
					b.Transparency = 0
				end
			end)
			-- 금빛 심 (획 가운데의 가는 빛)
			if k % 3 == 0 then
				local core = part(Vector3.new(0.12, d * 0.18, 1.4), GOLD, Enum.Material.Neon, 1)
				core.CFrame = CFrame.lookAt(pos, pos + dir)
				table.insert(blots, core)
				task.delay(u * 0.12 + 0.02, function()
					if core.Parent then
						core.Transparency = 0.2
					end
				end)
			end
			if k % 4 == 1 then
				local drop = part(Vector3.new(0.3, 0.3, 0.3) * (0.6 + (k % 3) * 0.3), INK, Enum.Material.SmoothPlastic, 0, "ball")
				drop.CFrame = CFrame.new(pos + side * (math.random() - 0.5) * d)
				fadeOut(drop, 0.6, { CFrame = CFrame.new(ground(pos) + side * (math.random() - 0.5) * 2) })
			end
		end
		Fx.sound("swing", 0.8, 0.7, from)
		shakeNear(from, 0.4, 60)
	end)
	-- 잠시 뒤 금빛으로 타오른다
	task.delay(delay + (data.burstAt or 0.5), function()
		ignite(blots, 0.35, 0)
		Fx.ring(ground(from:Lerp(to, 0.5)) + Vector3.new(0, 0.3, 0), GOLD, 2, L * 0.9, 0.35)
		Fx.breakSound("whoosh", 0.6, 1.2, from)
		shakeNear(from, 0.6, 70)
	end)
end

------------------------------------------------------------------------
-- 원상 (R): 발밑의 먹 원과 솟는 먹 벽
------------------------------------------------------------------------
local function ensoPoints(at: Vector3, R: number, startA: number, span: number, n: number): { Vector3 }
	local pts = {}
	for k = 0, n do
		local a = startA + span * k / n
		-- 손으로 그린 원: 반지름이 조금씩 흔들린다
		local r = R * (1 + math.sin(a * 3 + startA) * 0.03)
		table.insert(pts, at + Vector3.new(math.cos(a) * r, 0, math.sin(a) * r))
	end
	return pts
end
local function enso(data: any)
	local at: Vector3 = data.at
	if not near(at, 220) then
		return
	end
	local R = data.radius or 16
	local draw = data.draw or 0.55
	local a0 = math.random() * math.pi * 2
	local parts = groundStroke(ensoPoints(at, R, a0, math.rad(335), 36), 3.4, draw, a0)
	Fx.sound("swing", 0.7, 0.55, at)
	task.delay(draw, function()
		-- 먹 벽: 원을 따라 검은 기둥이 솟는다
		local walls: { BasePart } = {}
		for k = 0, 23 do
			local a = a0 + k / 24 * math.pi * 2
			local p0 = ground(at) + Vector3.new(math.cos(a) * R, 0, math.sin(a) * R)
			local w = part(Vector3.new(0.6, 2.6, 0.6), INK, Enum.Material.SmoothPlastic, 0.15)
			w.CFrame = CFrame.new(p0 + Vector3.new(0, 0.2, 0)) * CFrame.Angles(0, -a, 0)
			tween(w, 0.2, { Size = Vector3.new(0.6, 2.6, 7 + (k % 3) * 1.5), CFrame = CFrame.new(p0 + Vector3.new(0, 3.6 + (k % 3) * 0.75, 0)) * CFrame.Angles(0, -a, 0) * CFrame.Angles(math.rad(90), 0, 0) })
			table.insert(walls, w)
		end
		shakeNear(at, 0.6, 70)
		task.delay(data.burstAt or 0.35, function()
			ignite(parts, 0.4, 6)
			ignite(walls, 0.3, 0)
			Fx.ring(ground(at) + Vector3.new(0, 0.3, 0), GOLD, 2, R * 2.4, 0.4)
			Fx.flash(at, GOLD, 60, 4, 0.4)
			Fx.breakSound("whoosh", 0.8, 0.9, at)
			shakeNear(at, 1.0, 90)
		end)
	end)
end

------------------------------------------------------------------------
-- 무극필 (오의): 하늘의 큰 붓, 먹의 꽃, 금빛
------------------------------------------------------------------------
type Brush = { parts: { { p: BasePart, off: CFrame } } }
local function makeBrush(S: number): Brush
	local b: Brush = { parts = {} }
	local function add(size: Vector3, off: CFrame, color: Color3, mat: Enum.Material?, shape: string?)
		local p = part(size * S, color, mat, 0, shape)
		table.insert(b.parts, { p = p, off = CFrame.new(off.Position * S) * off.Rotation })
	end
	-- 붓끝이 0, 위로 붓털 → 쇠 테 → 긴 대 → 끝의 술
	add(Vector3.new(0.6, 0.6, 0.6), CFrame.new(0, 0.3, 0), INK, Enum.Material.SmoothPlastic, "ball")
	for k = 0, 4 do
		local w = 0.7 + k * 0.28
		add(Vector3.new(w, 0.9, w), CFrame.new(0, 0.75 + k * 0.6, 0), k < 3 and INK or INK2, Enum.Material.SmoothPlastic, "ball")
	end
	add(Vector3.new(0.4, 1.9, 1.9), CFrame.new(0, 3.9, 0) * UP, GOLD, Enum.Material.Metal, "cyl")
	add(Vector3.new(10, 1.3, 1.3), CFrame.new(0, 9.0, 0) * UP, WOOD, Enum.Material.Wood, "cyl")
	add(Vector3.new(0.5, 1.6, 1.6), CFrame.new(0, 14.1, 0) * UP, GOLD, Enum.Material.Metal, "cyl")
	add(Vector3.new(0.3, 2.2, 0.3), CFrame.new(0, 15.4, 0), Color3.fromRGB(170, 30, 30), Enum.Material.Fabric)
	return b
end
local function placeBrush(b: Brush, cf: CFrame)
	for _, e in ipairs(b.parts) do
		e.p.CFrame = cf * e.off
	end
end
local function flowerStroke(center: Vector3, R: number, a0: number): { Vector3 }
	local pts = { center }
	for k = 1, 5 do
		local r = 3 + (R - 3) * k / 5
		local a = a0 + 0.75 * k / 5
		table.insert(pts, center + Vector3.new(math.cos(a) * r, 0, math.sin(a) * r))
	end
	return pts
end
local function inkFlower(data: any)
	local at: Vector3 = data.at
	if not near(at, 260) then
		return
	end
	local R = data.radius or 22
	local n = data.strokes or 8
	local delay, every = data.delay or 0.35, data.every or 0.16
	local rot = data.rot or 0
	local order = { 1, 5, 3, 7, 2, 6, 4, 8 }
	local all: { BasePart } = {}
	local brush = makeBrush(1.6)
	local brushAt = at + Vector3.new(0, 30, 0)
	placeBrush(brush, CFrame.new(brushAt))
	for _, e in ipairs(brush.parts) do
		e.p.Transparency = 1
		tween(e.p, delay, { Transparency = 0 })
	end
	-- 하늘이 옅은 잿빛으로 (가까운 사람만)
	local cc: ColorCorrectionEffect? = nil
	if near(at, 160) then
		local e = Instance.new("ColorCorrectionEffect")
		e.Name = "KwonInk"
		e.Parent = game:GetService("Lighting")
		tween(e, delay, { Saturation = -0.7, Contrast = 0.2 })
		cc = e
	end
	local strokeT = every * 0.85
	local tStroke = delay
	for i = 1, n do
		local a0 = rot + ((order[i] or i) - 1) / n * math.pi * 2
		local pts = flowerStroke(at, R, a0)
		task.delay(tStroke, function()
			local list = groundStroke(pts, 4.6, strokeT, a0)
			for _, p in ipairs(list) do
				table.insert(all, p)
			end
			-- 붓이 획을 따라 내리긋는다 (붓끝이 땅에 닿는다)
			local t0 = os.clock()
			local conn: RBXScriptConnection
			conn = RunService.Heartbeat:Connect(function()
				local u = math.clamp((os.clock() - t0) / strokeT, 0, 1)
				local idx = 1 + u * (#pts - 1)
				local i0 = math.clamp(math.floor(idx), 1, #pts - 1)
				local pos = pts[i0]:Lerp(pts[i0 + 1], idx - i0)
				local tip = ground(pos) + Vector3.new(0, 0.2, 0)
				local tilt = CFrame.Angles(math.rad(-25), a0 + math.pi / 2, 0)
				placeBrush(brush, CFrame.new(tip) * tilt)
				if u >= 1 then
					conn:Disconnect()
				end
			end)
			Fx.sound("swing", 0.6, 0.6 + i * 0.03, at)
			shakeNear(at, 0.25, 60)
		end)
		tStroke += every
	end
	-- 둘레에 원을 두른다
	local ringAt = tStroke + (data.ringAt or 0.3) - every
	task.delay(ringAt - 0.25, function()
		local a1 = rot
		local list = groundStroke(ensoPoints(at, R + 1, a1, math.rad(340), 40), 3.6, 0.25, a1)
		for _, p in ipairs(list) do
			table.insert(all, p)
		end
		local t0 = os.clock()
		local conn: RBXScriptConnection
		conn = RunService.Heartbeat:Connect(function()
			local u = math.clamp((os.clock() - t0) / 0.25, 0, 1)
			local a = a1 + math.rad(340) * u
			local tip = ground(at + Vector3.new(math.cos(a) * (R + 1), 0, math.sin(a) * (R + 1))) + Vector3.new(0, 0.2, 0)
			placeBrush(brush, CFrame.new(tip) * CFrame.Angles(math.rad(-30), -a, 0))
			if u >= 1 then
				conn:Disconnect()
			end
		end)
	end)
	-- 그림 전체가 금빛으로 타오르며 터진다
	task.delay(ringAt + (data.finalAt or 0.45), function()
		ignite(all, 0.5, 10)
		for _, e in ipairs(brush.parts) do
			fadeOut(e.p, 0.4, { CFrame = e.p.CFrame + Vector3.new(0, 16, 0) })
		end
		local g = ground(at)
		Fx.ring(g + Vector3.new(0, 0.3, 0), GOLD, 4, (R + 4) * 2.4, 0.6)
		task.delay(0.08, function()
			Fx.ring(g + Vector3.new(0, 0.35, 0), GOLD2, 4, (R + 4) * 2, 0.5)
		end)
		local col = part(Vector3.new(2, 8, 8), GOLD, Enum.Material.Neon, 0.05, "cyl")
		col.CFrame = CFrame.new(g + Vector3.new(0, 1, 0)) * UP
		fadeOut(col, 0.6, { Size = Vector3.new(80, 1, 1), CFrame = CFrame.new(g + Vector3.new(0, 40, 0)) * UP })
		Fx.flash(at, GOLD, 120, 9, 0.7)
		Fx.breakSound("boom", 1, 0.7, at)
		Fx.sound("heavy", 1, 0.55, at)
		shakeNear(at, 2.4, 150)
		local e = cc
		if e then
			tween(e, 0.6, { Saturation = 0, Contrast = 0 })
			task.delay(0.65, function()
				e:Destroy()
			end)
		end
	end)
	task.delay(ringAt + 4, function()
		if cc and cc.Parent then
			cc:Destroy()
		end
		for _, e in ipairs(brush.parts) do
			if e.p.Parent then
				e.p:Destroy()
			end
		end
	end)
end

------------------------------------------------------------------------
-- 먹 번짐 (네 번째 일격): 상대 발밑에 먹이 사방으로 번졌다가 금빛으로 터진다
------------------------------------------------------------------------
local function inkPulse(data: any)
	local at: Vector3 = data.at
	if not near(at, 200) then
		return
	end
	local R = data.radius or 10
	local parts: { BasePart } = {}
	local seed = math.random() * 6
	for k = 0, 6 do
		local a = seed + k / 7 * math.pi * 2
		local L = R * (0.55 + ((k * 5) % 4) * 0.12)
		local pts = { at, at + Vector3.new(math.cos(a) * L, 0, math.sin(a) * L) }
		for _, p in ipairs(groundStroke(pts, 2.4, 0.16, a)) do
			table.insert(parts, p)
		end
	end
	local blot = part(Vector3.new(0.13, 2, 2), INK, Enum.Material.SmoothPlastic, 0, "cyl")
	blot.CFrame = CFrame.new(ground(at) + Vector3.new(0, 0.13, 0)) * UP
	tween(blot, 0.15, { Size = Vector3.new(0.13, R * 0.9, R * 0.9) })
	table.insert(parts, blot)
	task.delay(data.delay or 0.45, function()
		ignite(parts, 0.3, 2)
		Fx.breakSound("whoosh", 0.5, 1.4, at)
	end)
end

local HANDLERS: { [string]: (any) -> () } = {
	inkSlash = inkSlash,
	enso = enso,
	inkFlower = inkFlower,
	inkPulse = inkPulse,
}
function Ink.handles(data: any): boolean
	return HANDLERS[data.kind] ~= nil
end
function Ink.run(data: any)
	local fn = HANDLERS[data.kind]
	if fn then
		fn(data)
	end
end
local _ = Config
return Ink
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="33">
          <Properties>
            <string name="Name">Mount</string>
            <string name="Source"><![CDATA[-- 권왕: 탈것 (화면마다 직접 그린다). 몸에 "Mount" 표시가 붙은 사람 아래에 말·범·구름·청룡을 빚는다
-- 1.0판: 둥근 타원 조각으로 빚은 몸, 뼈마다 붙은 조각, 땅을 딛는 걸음 (두 마디 다리를 발끝까지 맞춰 굽힌다),
-- 걸음새 (평보 → 습보, 범은 튀어 오르듯), 늦게 따라오는 꼬리와 갈기, 돌 때 기우는 몸, 고삐와 등자,
-- 용은 지나온 길을 몸이 그대로 따라 흐르고, 구름은 뒤로 흩어진다
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Config = require(ReplicatedStorage:WaitForChild("Config"))
local Fx = require(script.Parent:WaitForChild("Fx"))

local Mount = {}

local folder = Instance.new("Folder")
folder.Name = "KwonMounts"
folder.Parent = workspace

-- 조각: bone = 붙은 뼈, off = 뼈 기준 자리, alpha = 투명도, w = 흔들림 { 축(1·2·3), 크기, 빠르기, 어긋남, 달릴 때 더하는 크기 },
-- bob = 위아래 둥실 { 크기, 빠르기, 어긋남 }
type Piece = { p: BasePart, bone: string, off: CFrame, alpha: number, w: { number }?, bob: { number }? }
type Leg = { n: string, x: number, hy: number, hz: number, a: number, b: number, front: boolean }
type Rig = {
	kind: string,
	m: any,
	model: Model,
	k: number,
	Q: any,
	parts: { Piece },
	bones: { [string]: CFrame },
	phase: number,
	move: number,
	run: number,
	yaw: number?,
	yawRate: number,
	bank: number,
	born: number,
	shown: boolean,
	hist: { Vector3 },
	trail: { Piece },
	reins: { BasePart },
	straps: { BasePart },
	irons: { BasePart },
	skip: number,
	lastU: { [string]: number },
	roarT: number?,
}

local rigs: { [Model]: Rig } = {}

local RAD = math.pi / 180
local TAU = math.pi * 2
local V = Vector3.new
local CF = CFrame.new
local ANG = CFrame.Angles
local DARK = Color3.fromRGB(26, 20, 18)
local WHITE = Color3.new(1, 1, 1)

local function lerp(a: number, b: number, t: number): number
	return a + (b - a) * t
end
local function smooth(x: number): number
	return x * x * (3 - 2 * x)
end

------------------------------------------------------------------------
-- 조각 빚기
------------------------------------------------------------------------
-- shape: "ell" 타원 (부드러운 몸) / "ball" 공 / "cyl" 원통 / "block" 네모
local function add(rig: Rig, bone: string, shape: string, size: Vector3, off: CFrame, color: Color3, material: Enum.Material?, alpha: number?): Piece
	local k = rig.k
	local p = Instance.new("Part")
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.Size = size * k
	p.Color = color
	p.Material = material or Enum.Material.SmoothPlastic
	p.CastShadow = size.Magnitude > 1.8
	p.Transparency = 1
	if shape == "ell" then
		local mesh = Instance.new("SpecialMesh")
		mesh.MeshType = Enum.MeshType.Sphere
		mesh.Parent = p
	elseif shape == "ball" then
		p.Shape = Enum.PartType.Ball
	elseif shape == "cyl" then
		p.Shape = Enum.PartType.Cylinder
	end
	p.Parent = folder
	local e: Piece = { p = p, bone = bone, off = CF(off.Position * k) * off.Rotation, alpha = alpha or 0 }
	table.insert(rig.parts, e)
	return e
end
-- 흔들리는 조각 (갈기·꼬리털·수염)
local function wave(e: Piece, axis: number, amp: number, freq: number, ph: number, runAmp: number?): Piece
	e.w = { axis, amp, freq, ph, runAmp or 0 }
	return e
end
-- 두 점 사이를 잇는 끈
local function span(p: BasePart, a: Vector3, b: Vector3, thick: number)
	local d = b - a
	local len = d.Magnitude
	if len < 0.02 then
		return
	end
	p.Size = V(thick, thick, len)
	p.CFrame = CFrame.lookAt(a + d / 2, b)
end
-- 반짝이·안개 뿌리개
local function emitter(parent: Instance, texture: string, color: Color3, size: number, rate: number, life: number, speed: number, spread: number): ParticleEmitter
	local pe = Instance.new("ParticleEmitter")
	pe.Texture = texture
	pe.Color = ColorSequence.new(color)
	pe.LightEmission = 0.8
	pe.Size = NumberSequence.new(size, 0)
	pe.Transparency = NumberSequence.new(0.2, 1)
	pe.Lifetime = NumberRange.new(life * 0.7, life)
	pe.Rate = rate
	pe.Speed = NumberRange.new(speed * 0.5, speed)
	pe.SpreadAngle = Vector2.new(spread, spread)
	pe.Parent = parent
	return pe
end
local TEX_SPARK = "rbxasset://textures/particles/sparkles_main.dds"
local TEX_SMOKE = "rbxasset://textures/particles/smoke_main.dds"

------------------------------------------------------------------------
-- 다리: 엉덩이에서 발목까지 두 마디를 굽혀 맞춘다 (옆에서 본 평면 안에서)
-- 반환: 윗마디·아랫마디 뼈 (뼈의 -Y가 마디 방향), 발목 자리
------------------------------------------------------------------------
local function ik(H: Vector3, T: Vector3, a: number, b: number, kneeFwd: boolean): (CFrame, CFrame, Vector3)
	local dy, dz = T.Y - H.Y, T.Z - H.Z
	local d = math.clamp(math.sqrt(dy * dy + dz * dz), 0.05, (a + b) * 0.995)
	local base = math.atan2(dz, -dy)
	local cosA = math.clamp((a * a + d * d - b * b) / (2 * a * d), -1, 1)
	local alpha = math.acos(cosA)
	local th1 = kneeFwd and (base - alpha) or (base + alpha)
	local K = V(H.X, H.Y - a * math.cos(th1), H.Z + a * math.sin(th1))
	local F = V(H.X, H.Y - d * math.cos(base), H.Z + d * math.sin(base))
	local th2 = math.atan2(F.Z - K.Z, -(F.Y - K.Y))
	return CF(H) * ANG(-th1, 0, 0), CF(K) * ANG(-th2, 0, 0), F
end

-- 다리 조각 (윗마디·아랫마디·발)
local function buildLeg(rig: Rig, L: Leg, coat: Color3, footColor: Color3, paw: boolean)
	local a, b = L.a, L.b
	if paw then
		add(rig, L.n .. "u", "ell", V(1.0, a + 0.6, 1.15), CF(0, -a / 2 + 0.15, 0), coat)
		add(rig, L.n .. "l", "ell", V(0.72, b + 0.35, 0.78), CF(0, -b / 2, 0), coat)
		add(rig, L.n .. "p", "ball", V(0.82, 0.82, 0.82), CF(0, -0.3, -0.1), footColor)
		for _, x in ipairs({ -0.22, 0, 0.22 }) do
			add(rig, L.n .. "p", "ell", V(0.27, 0.22, 0.32), CF(x, -0.42, -0.45), footColor)
		end
	else
		if L.front then
			add(rig, L.n .. "u", "ell", V(0.88, a + 0.65, 1.02), CF(0, -a / 2 + 0.12, 0), coat)
		else
			add(rig, L.n .. "u", "ell", V(1.0, a + 0.75, 1.3), CF(0, -a / 2 + 0.15, 0.05), coat)
		end
		add(rig, L.n .. "u", "ball", V(0.62, 0.62, 0.62), CF(0, -a, 0), coat)
		add(rig, L.n .. "l", "ell", V(0.46, b + 0.25, 0.55), CF(0, -b / 2, 0), coat)
		add(rig, L.n .. "l", "ball", V(0.56, 0.56, 0.56), CF(0, -b, 0), coat)
		add(rig, L.n .. "p", "ell", V(0.4, 0.55, 0.42), CF(0, -0.22, 0), coat)
		add(rig, L.n .. "p", "block", V(0.6, 0.3, 0.68), CF(0, -0.48, -0.05), footColor)
	end
end

------------------------------------------------------------------------
-- 말
------------------------------------------------------------------------
local HORSE = {
	B = 6.15, -- 등(안장) 높이
	footH = 0.62,
	legs = {
		{ n = "LF", x = -0.72, hy = -2.9, hz = -2.25, a = 1.6, b = 1.5, front = true },
		{ n = "RF", x = 0.72, hy = -2.9, hz = -2.25, a = 1.6, b = 1.5, front = true },
		{ n = "LH", x = -0.78, hy = -2.6, hz = 2.4, a = 1.7, b = 1.6, front = false },
		{ n = "RH", x = 0.78, hy = -2.6, hz = 2.4, a = 1.7, b = 1.6, front = false },
	},
	-- 평보 (네 박자)와 습보 (뒷다리 둘 → 앞다리 둘)
	walkOff = { LH = 0, LF = 0.25, RH = 0.5, RF = 0.75 },
	runOff = { LH = 0, RH = 0.1, LF = 0.42, RF = 0.54 },
	dutyWalk = 0.62,
	dutyRun = 0.36,
	liftWalk = 0.5,
	liftRun = 1.15,
	maxTravel = 3.8,
	bobRun = 0.24,
	pitchRun = 5 * RAD,
	flexRun = 0,
	rear = 20 * RAD, -- 처음 부르면 앞발을 들고 일어선다
	curlFront = 1.35,
	curlHind = 1.0,
	stand = -0.42,
}

local function buildHorse(rig: Rig)
	local m = rig.m
	local c, mane = m.color, m.mane
	local light = c:Lerp(WHITE, 0.12)
	local dark = c:Lerp(DARK, 0.5)
	local hoof = Color3.fromRGB(44, 36, 32)
	local leather = Color3.fromRGB(76, 44, 26)
	local fancy = m.id == "blackhorse"
	local metal = fancy and Color3.fromRGB(225, 185, 95) or Color3.fromRGB(205, 205, 210)
	local cloth = fancy and Color3.fromRGB(150, 22, 30) or Color3.fromRGB(42, 72, 125)
	local trim = fancy and Color3.fromRGB(230, 190, 90) or Color3.fromRGB(220, 200, 150)
	-- 몸통: 배·가슴·엉덩이·어깨·허벅지를 겹쳐 둥글게
	add(rig, "body", "ell", V(2.7, 3.0, 5.4), CF(0, -1.6, 0.1), c)
	add(rig, "body", "ell", V(2.55, 3.05, 2.6), CF(0, -1.65, -2.2), c)
	add(rig, "body", "ell", V(2.75, 2.9, 2.9), CF(0, -1.4, 2.35), c)
	add(rig, "body", "ell", V(1.3, 1.6, 2.2), CF(0, -0.8, -1.85), c)
	add(rig, "body", "ell", V(2.2, 1.3, 4.4), CF(0, -2.55, 0.1), light)
	add(rig, "body", "ell", V(1.8, 2.0, 1.2), CF(0, -2.3, -3.15), c)
	for _, s in ipairs({ -1, 1 }) do
		add(rig, "body", "ell", V(0.95, 2.3, 1.7), CF(s * 0.92, -2.25, -2.15) * ANG(0, 0, -s * 0.08), c)
		add(rig, "body", "ell", V(1.05, 2.5, 2.3), CF(s * 0.95, -1.95, 2.4), c)
	end
	-- 안장: 깔개와 테두리, 가죽 안장, 앞뒤 턱, 옆 덮개, 뱃대끈, 가슴걸이
	add(rig, "body", "block", V(2.5, 0.12, 2.65), CF(0, -0.14, 0.05), cloth, Enum.Material.Fabric)
	add(rig, "body", "block", V(2.6, 0.07, 2.75), CF(0, -0.21, 0.05), trim, Enum.Material.Fabric)
	add(rig, "body", "ell", V(1.75, 0.5, 2.2), CF(0, 0.0, 0.05), leather)
	add(rig, "body", "ell", V(0.95, 0.72, 0.5), CF(0, 0.25, -0.92), leather)
	add(rig, "body", "ell", V(1.35, 0.62, 0.42), CF(0, 0.28, 0.97), leather)
	add(rig, "body", "ball", V(0.22, 0.22, 0.22), CF(0, 0.6, -0.98), metal, Enum.Material.Metal)
	for _, s in ipairs({ -1, 1 }) do
		add(rig, "body", "block", V(0.08, 1.15, 1.35), CF(s * 1.3, -0.68, -0.05) * ANG(0, 0, s * 0.12), leather)
		add(rig, "body", "block", V(0.1, 2.3, 0.32), CF(s * 1.33, -1.75, -0.75), leather)
	end
	add(rig, "body", "block", V(2.1, 0.12, 0.32), CF(0, -3.17, -0.75), leather)
	add(rig, "body", "block", V(2.0, 0.14, 0.14), CF(0, -2.05, -3.58) * ANG(0, 0, 0), leather)
	add(rig, "body", "ball", V(0.38, 0.38, 0.38), CF(0, -2.12, -3.72), metal, Enum.Material.Metal)
	-- 다리
	for _, L in ipairs(HORSE.legs) do
		buildLeg(rig, L, c, hoof, false)
	end
	-- 목 (세 마디): 굵게 시작해 머리 쪽으로 가늘어진다
	-- 갈기: 목덜미를 따라 이어지는 볏 한 줄과, 오른쪽 목에 붙어 흘러내리는 매끈한 털 한 장씩 (마디마다 하나, 같은 물결로 함께 흔들린다)
	local neckSize = { V(1.15, 2.1, 1.6), V(1.0, 1.75, 1.5), V(0.9, 1.4, 1.4) }
	local neckY = { -0.45, -0.35, -0.25 }
	for i = 1, 3 do
		local ns = neckSize[i]
		add(rig, "n" .. i, "ell", ns, CF(0, neckY[i], -0.47), c)
		local top = neckY[i] + ns.Y / 2
		add(rig, "n" .. i, "ell", V(0.26, 0.34, 1.12), CF(0, top - 0.04, -0.47), mane)
		local dy = 0.55
		local hw = ns.X / 2 * math.sqrt(math.max(0.05, 1 - (dy / (ns.Y / 2)) ^ 2))
		local drape = add(rig, "n" .. i, "ell", V(0.12, 1.2 - i * 0.08, 1.12), CF(hw - 0.03, top - dy - 0.1, -0.47) * ANG(0, 0, 0.32), mane)
		wave(drape, 3, 0.025, 6, -i * 0.8, 0.09)
	end
	-- 머리 (뼈는 정수리, -Z가 코끝)
	add(rig, "head", "ell", V(0.95, 1.05, 1.3), CF(0, -0.15, -0.35), c)
	add(rig, "head", "ell", V(0.92, 1.15, 1.05), CF(0, -0.45, -0.2), c)
	add(rig, "head", "ell", V(0.72, 0.8, 2.0), CF(0, -0.2, -1.2), c)
	add(rig, "head", "ell", V(0.78, 0.78, 0.8), CF(0, -0.28, -2.05), dark)
	add(rig, "head", "block", V(0.55, 0.05, 0.4), CF(0, -0.62, -2.0), DARK)
	if m.id == "horse" then
		add(rig, "head", "ell", V(0.24, 0.06, 1.6), CF(0, 0.21, -1.15), Color3.fromRGB(245, 240, 232))
	end
	for _, s in ipairs({ -1, 1 }) do
		add(rig, "head", "ball", V(0.17, 0.17, 0.17), CF(s * 0.24, -0.12, -2.38), DARK)
		add(rig, "head", "ball", V(0.25, 0.25, 0.25), CF(s * 0.45, 0.05, -0.55), DARK)
		add(rig, "head", "ball", V(0.08, 0.08, 0.08), CF(s * 0.54, 0.12, -0.62), WHITE)
		-- 굴레: 볼끈, 코끈 옆, 재갈 고리
		add(rig, "head", "block", V(0.07, 0.09, 1.4), CF(s * 0.43, -0.05, -0.95), leather)
		add(rig, "head", "block", V(0.07, 0.7, 0.14), CF(s * 0.4, -0.13, -1.6), leather)
		add(rig, "head", "cyl", V(0.07, 0.28, 0.28), CF(s * 0.43, -0.5, -1.95), metal, Enum.Material.Metal)
	end
	add(rig, "head", "block", V(0.98, 0.09, 0.12), CF(0, 0.25, -0.3), leather)
	add(rig, "head", "block", V(0.86, 0.09, 0.14), CF(0, 0.22, -1.6), leather)
	wave(add(rig, "head", "ell", V(0.32, 0.65, 0.2), CF(0, 0.42, -0.28) * ANG(-0.6, 0, 0), mane), 3, 0.06, 5, 0, 0.12)
	for _, ear in ipairs({ "earL", "earR" }) do
		add(rig, ear, "ell", V(0.22, 0.66, 0.3), CF(0, 0.3, 0), c)
		add(rig, ear, "ell", V(0.12, 0.46, 0.12), CF(0, 0.3, -0.1), dark)
	end
	-- 꼬리 (여섯 마디): 첫 마디는 털빛, 나머지는 갈기 빛 털
	add(rig, "t1", "ell", V(0.5, 0.85, 0.55), CF(0, -0.3, 0), c)
	for i = 2, 6 do
		add(rig, "t" .. i, "ell", V(0.58 - 0.04 * i, 1.0, 0.42), CF(0, -0.3, 0), mane)
		add(rig, "t" .. i, "ell", V(0.36, 0.85, 0.5), CF(0.07, -0.36, 0.06), mane:Lerp(DARK, 0.2))
	end
	-- 고삐 둘과 등자 (탄 사람의 손과 발에 맞춰 매 화면 잇는다)
	for _ = 1, 2 do
		local r = add(rig, "_dyn", "block", V(0.07, 0.07, 1), CF(), leather)
		table.insert(rig.reins, r.p)
		local st = add(rig, "_dyn", "block", V(0.08, 0.08, 1), CF(), leather)
		table.insert(rig.straps, st.p)
		local iron = add(rig, "_dyn", "block", V(0.55, 0.09, 0.38), CF(), metal, Enum.Material.Metal)
		table.insert(rig.irons, iron.p)
	end
end

------------------------------------------------------------------------
-- 백호
------------------------------------------------------------------------
local TIGER = {
	B = 5.35,
	footH = 0.7,
	legs = {
		{ n = "LF", x = -0.75, hy = -2.3, hz = -1.6, a = 1.45, b = 1.4, front = true },
		{ n = "RF", x = 0.75, hy = -2.3, hz = -1.6, a = 1.45, b = 1.4, front = true },
		{ n = "LH", x = -0.75, hy = -2.15, hz = 1.75, a = 1.55, b = 1.45, front = false },
		{ n = "RH", x = 0.75, hy = -2.15, hz = 1.75, a = 1.55, b = 1.45, front = false },
	},
	walkOff = { LH = 0, LF = 0.25, RH = 0.5, RF = 0.75 },
	-- 달릴 때: 앞발 둘, 뒷발 둘이 거의 함께 (튀어 오르듯)
	runOff = { LH = 0, RH = 0.07, LF = 0.5, RF = 0.57 },
	dutyWalk = 0.6,
	dutyRun = 0.3,
	liftWalk = 0.45,
	liftRun = 1.0,
	maxTravel = 4.2,
	bobRun = 0.3,
	pitchRun = 4 * RAD,
	flexRun = 11 * RAD, -- 허리가 접혔다 펴진다
	curlFront = 1.0,
	curlHind = 0.9,
	stand = -0.05,
}

local function band(rig: Rig, bone: string, center: Vector3, size: Vector3, z: number, thick: number, color: Color3, tilt: number)
	local f = 1 - ((z - center.Z) / (size.Z / 2)) ^ 2
	if f <= 0.05 then
		return
	end
	local r = math.sqrt(f) * 1.03
	add(rig, bone, "ell", V(size.X * r, size.Y * r, thick), CF(center.X, center.Y, z) * ANG(tilt, 0, 0), color)
end

local function buildTiger(rig: Rig)
	local m = rig.m
	local c, stripe = m.color, m.mane
	local white = c:Lerp(WHITE, 0.6)
	local cloth = Color3.fromRGB(40, 60, 140)
	local gold = Color3.fromRGB(230, 190, 90)
	-- 몸: 앞(가슴·어깨)과 뒤(엉덩이·허벅지)로 나뉘어 허리가 접힌다
	local chestC, chestS = V(0, -1.35, -1.25), V(2.2, 2.3, 2.9)
	local rumpC, rumpS = V(0, -1.3, 1.3), V(2.1, 2.1, 2.9)
	add(rig, "front", "ell", chestS, CF(chestC), c)
	add(rig, "rear", "ell", rumpS, CF(rumpC), c)
	for _, s in ipairs({ -1, 1 }) do
		add(rig, "front", "ell", V(0.9, 1.8, 1.4), CF(s * 0.85, -1.55, -1.75), c)
		add(rig, "rear", "ell", V(0.95, 1.9, 1.6), CF(s * 0.85, -1.45, 1.75), c)
	end
	add(rig, "body", "ell", V(1.7, 1.0, 3.6), CF(0, -2.25, 0), white)
	add(rig, "front", "ell", V(1.5, 1.4, 1.0), CF(0, -2.0, -2.45), white)
	-- 줄무늬: 몸을 감는 검은 띠 (굵기와 기울기를 조금씩 다르게)
	for i, dz in ipairs({ -0.95, -0.35, 0.25, 0.85 }) do
		band(rig, "front", chestC, chestS, chestC.Z + dz, i % 2 == 0 and 0.14 or 0.2, stripe, (i % 2 == 0 and 1 or -1) * 0.18)
		band(rig, "rear", rumpC, rumpS, rumpC.Z + dz, i % 2 == 0 and 0.2 or 0.14, stripe, (i % 2 == 0 and -1 or 1) * 0.18)
	end
	-- 목
	add(rig, "front", "ell", V(1.65, 1.8, 1.6), CF(0, -1.05, -2.75), c)
	band(rig, "front", V(0, -1.05, -2.75), V(1.65, 1.8, 1.6), -2.65, 0.16, stripe, 0.2)
	-- 안장 대신 금빛 술이 달린 두툼한 천
	add(rig, "body", "block", V(2.0, 0.12, 2.2), CF(0, -0.12, 0), cloth, Enum.Material.Fabric)
	add(rig, "body", "block", V(2.1, 0.06, 2.3), CF(0, -0.18, 0), gold, Enum.Material.Fabric)
	add(rig, "body", "ell", V(1.5, 0.45, 1.8), CF(0, 0.04, 0), Color3.fromRGB(140, 30, 35))
	for _, x in ipairs({ -1, 1 }) do
		for _, z in ipairs({ -1, 1 }) do
			wave(add(rig, "body", "ell", V(0.15, 0.5, 0.15), CF(x * 1.0, -0.45, z * 1.05), gold, Enum.Material.Metal), 1, 0.08, 5, x + z, 0.2)
		end
	end
	-- 다리: 굵고 둥근 발, 허벅지의 줄무늬
	for _, L in ipairs(TIGER.legs) do
		buildLeg(rig, L, c, white, true)
		local a = L.a
		for _, frac in ipairs({ 0.35, 0.68 }) do
			local cy = -a / 2 + 0.15
			local h = (a + 0.6) / 2
			local y = -a * frac
			local f = 1 - ((y - cy) / h) ^ 2
			if f > 0.05 then
				local r = math.sqrt(f) * 1.04
				add(rig, L.n .. "u", "ell", V(1.0 * r, 0.13, 1.15 * r), CF(0, y, 0), stripe)
			end
		end
	end
	-- 머리 (-Z가 앞): 콧등이 곧게 내려와 넓적한 주둥이로, 눈꼬리가 올라간 매서운 눈과 찌푸린 눈썹, 드러난 송곳니
	add(rig, "head", "ell", V(1.75, 1.5, 1.55), CF(0, 0, 0), c)
	add(rig, "head", "ell", V(0.55, 0.42, 1.0), CF(0, 0.08, -0.62), c)
	add(rig, "head", "ell", V(0.1, 0.08, 0.75), CF(0, 0.73, -0.1), stripe)
	for _, s in ipairs({ -1, 1 }) do
		add(rig, "head", "ell", V(0.09, 0.07, 0.55), CF(s * 0.3, 0.67, -0.18) * ANG(0, -s * 0.35, 0), stripe)
		add(rig, "head", "ell", V(0.08, 0.06, 0.4), CF(s * 0.52, 0.58, -0.05) * ANG(0, -s * 0.5, s * 0.3), stripe)
	end
	add(rig, "head", "ell", V(0.4, 0.22, 0.26), CF(0, -0.06, -1.12), Color3.fromRGB(130, 70, 78))
	add(rig, "head", "ell", V(0.62, 0.34, 0.55), CF(0, -0.66, -0.62), white)
	add(rig, "head", "ell", V(0.62, 0.14, 0.45), CF(0, -0.55, -0.88), DARK)
	for _, s in ipairs({ -1, 1 }) do
		-- 주둥이의 두 볼록한 수염 자리, 송곳니, 수염
		add(rig, "head", "ell", V(0.6, 0.52, 0.62), CF(s * 0.25, -0.32, -0.85), white)
		add(rig, "head", "ell", V(0.09, 0.28, 0.09), CF(s * 0.2, -0.6, -1.02), WHITE)
		for j = 0, 2 do
			add(rig, "head", "block", V(0.03, 0.03, 0.95), CF(s * 0.88, -0.36 + j * 0.07, -0.85) * ANG(j * 0.1 - 0.1, s * 1.3, 0), WHITE)
		end
		-- 볼의 흰 털과 줄무늬 (뒤로 뻗는다)
		add(rig, "head", "ell", V(0.55, 0.85, 0.8), CF(s * 0.78, -0.32, 0.05) * ANG(0, 0, s * 0.25), white)
		add(rig, "head", "ell", V(0.07, 0.32, 0.45), CF(s * 1.04, -0.25, 0.05) * ANG(0, 0, s * 0.3), stripe)
		add(rig, "head", "ell", V(0.07, 0.26, 0.4), CF(s * 1.0, -0.55, 0.08) * ANG(0, 0, s * 0.15), stripe)
		-- 눈: 짙은 눈두덩 위에 빛나는 얼음빛 눈동자, 세로로 가는 동공. 눈꼬리는 바깥으로 올라가고 눈썹은 안쪽으로 내려온다
		local eye = CF(s * 0.42, 0.2, -0.68) * ANG(0, s * 0.35, s * 0.3)
		add(rig, "head", "ell", V(0.46, 0.22, 0.12), eye, stripe)
		add(rig, "head", "ell", V(0.3, 0.15, 0.08), eye * CF(0, 0, -0.05), Color3.fromRGB(140, 220, 255), Enum.Material.Neon)
		add(rig, "head", "ell", V(0.05, 0.14, 0.05), eye * CF(0, 0, -0.09), DARK)
		add(rig, "head", "ell", V(0.48, 0.09, 0.12), CF(s * 0.42, 0.36, -0.66) * ANG(0, s * 0.35, s * 0.45), stripe)
	end
	for _, ear in ipairs({ "earL", "earR" }) do
		add(rig, ear, "ell", V(0.5, 0.5, 0.2), CF(0, 0.2, 0), c)
		add(rig, ear, "ell", V(0.28, 0.3, 0.08), CF(0, 0.2, -0.08), WHITE)
		add(rig, ear, "ell", V(0.44, 0.44, 0.06), CF(0, 0.2, 0.09), stripe)
		add(rig, ear, "ell", V(0.16, 0.16, 0.04), CF(0, 0.22, 0.12), WHITE)
	end
	-- 꼬리 (아홉 마디): 뒤로 뻗었다가 끝이 위로 말린다. 마디마다 검은 고리
	for i = 1, 9 do
		local w = 0.42 - 0.02 * i
		add(rig, "t" .. i, "ell", V(w, 0.65, w), CF(0, -0.25, 0), i == 9 and stripe or c)
		if i % 2 == 1 and i < 9 then
			add(rig, "t" .. i, "ell", V(w * 1.05, 0.12, w * 1.05), CF(0, -0.42, 0), stripe)
		end
	end
	for _ = 1, 2 do
		local r = add(rig, "_dyn", "block", V(0.07, 0.07, 1), CF(), gold, Enum.Material.Metal)
		table.insert(rig.reins, r.p)
	end
end

------------------------------------------------------------------------
-- 네발짐승의 움직임 (말·범 공통)
------------------------------------------------------------------------
local function updateQuad(rig: Rig, yawCF: CFrame, groundLocal: number, t: number, speed: number, freq: number)
	local Q = rig.Q
	local k = rig.k
	local bones = rig.bones
	local m, run, A = rig.move, rig.run, rig.phase * TAU
	-- 몸: 걸을 땐 작게 두 번, 달릴 땐 크게 한 번 들썩이며 앞뒤로 흔들린다. 서 있으면 숨을 쉰다
	local bob = math.sin(A * 2) * 0.05 * k * m * (1 - run) + math.sin(A) * Q.bobRun * k * run + math.sin(t * 1.6) * 0.035 * k * (1 - m)
	local pitch = math.sin(A + 1.2) * Q.pitchRun * run + math.sin(A * 2) * 0.012 * m * (1 - run)
	local rear = 0
	if Q.rear then
		local u = (t - rig.born) / 1.1
		if u < 1 then
			rear = math.sin(math.pi * u) ^ 1.5
		end
	end
	pitch += rear * (Q.rear or 0)
	local bodyLocal = CF(0, bob, 0) * ANG(pitch, 0, rig.bank)
	local flex = math.sin(A + 0.6) * Q.flexRun * run
	local frontLocal = bodyLocal * ANG(flex, 0, 0)
	local rearLocal = bodyLocal * ANG(-flex, 0, 0)
	bones.body = yawCF * bodyLocal
	bones.front = yawCF * frontLocal
	bones.rear = yawCF * rearLocal
	-- 다리: 땅에 닿아 있는 동안 발은 제자리 (몸이 지나간다), 떨어진 동안 앞으로 들어 옮긴다
	local cam = workspace.CurrentCamera
	local dustNear = cam ~= nil and (cam.CFrame.Position - yawCF.Position).Magnitude < 120
	local duty = lerp(Q.dutyWalk, Q.dutyRun, run)
	local travel = math.min(speed * duty / freq, Q.maxTravel * k)
	local lift = lerp(Q.liftWalk, Q.liftRun, run) * k
	for _, L in ipairs(Q.legs) do
		local half = L.front and frontLocal or rearLocal
		local hip = half * V(L.x * k, L.hy * k, L.hz * k)
		local rest = L.hz * k
		local off = lerp(Q.walkOff[L.n], Q.runOff[L.n], run)
		local u = (rig.phase + off) % 1
		-- 달릴 때 발이 땅을 박차는 순간 흙먼지
		local prevU = rig.lastU[L.n]
		rig.lastU[L.n] = u
		if prevU and u < prevU and run > 0.35 and dustNear then
			Fx.burst("smoke", yawCF * V(hip.X, groundLocal + 0.3, rest + travel * 0.5), Color3.fromRGB(205, 190, 165), 2, 0.55 * k)
		end
		local z, y, curl
		if u < duty then
			z = rest + travel * (u / duty - 0.5)
			y = 0
			curl = 0
		else
			local s = (u - duty) / (1 - duty)
			z = rest + travel * (0.5 - smooth(s))
			y = lift * math.sin(math.pi * s) * (L.front and 1.15 or 1)
			curl = math.sin(math.pi * s)
		end
		z = rest + (z - rest) * m
		y *= m
		curl *= m
		if L.front and rear > 0 then
			y += rear * 1.9 * k
			z -= rear * 0.9 * k
			curl = math.max(curl, rear)
		end
		local T = V(hip.X, groundLocal + Q.footH * k + y, z)
		local upper, lower, F = ik(hip, T, L.a * k, L.b * k, L.front)
		local pa = lerp(Q.stand, L.front and Q.curlFront or Q.curlHind, curl)
		bones[L.n .. "u"] = yawCF * upper
		bones[L.n .. "l"] = yawCF * lower
		bones[L.n .. "p"] = yawCF * CF(F) * ANG(-pa, 0, 0)
	end
	-- 귀: 가끔 쫑긋
	local twL = math.max(0, math.sin(t * 0.7)) ^ 14 * 0.6
	local twR = math.max(0, math.sin(t * 0.83 + 2)) ^ 14 * 0.6
	local look = math.sin(t * 0.37) * 0.14 * (1 - m) + math.clamp(rig.yawRate * 0.08, -0.3, 0.3)
	if rig.kind == "horse" then
		-- 목과 머리: 걸음에 맞춰 끄덕이고, 달리면 목을 앞으로 뻗는다. 도는 쪽을 먼저 본다
		local nod = math.sin(A * 2 + 0.5) * 0.05 * m * (1 - run) + math.sin(A + 2.2) * 0.12 * run
		local e = lerp(52, 34, run) * RAD + rear * 0.5 + nod * 0.5
		local cf = bones.front * CF(0, -1.05 * k, -2.95 * k) * ANG(e, look * 0.5, 0)
		for i = 1, 3 do
			bones["n" .. i] = cf
			cf = cf * CF(0, 0, -0.95 * k) * ANG(-9 * RAD, look * 0.25, 0)
		end
		local head = cf * ANG(-78 * RAD + nod - rear * 0.3, look * 0.3, 0)
		bones.head = head
		bones.earL = head * CF(-0.3 * k, 0.5 * k, -0.1 * k) * ANG(-0.25 - twL, 0, 0.3)
		bones.earR = head * CF(0.3 * k, 0.5 * k, -0.1 * k) * ANG(-0.25 - twR, 0, -0.3)
		-- 꼬리: 서 있으면 느리게 휘휘, 달리면 뒤로 흩날린다
		local th = lerp(28, 70, run) * RAD - rear * 0.2
		local tc = bones.rear * CF(0, -0.2 * k, 3.7 * k) * ANG(-th, 0, 0)
		for i = 1, 6 do
			bones["t" .. i] = tc
			local sway = math.sin(t * 2.1 - i * 0.7) * 7 * RAD * (0.4 + i * 0.25) * (1 - run * 0.5) + math.sin(t * 11 - i * 0.9) * 5 * RAD * run
			tc = tc * CF(0, -0.6 * k, 0) * ANG(lerp(9, 2, run) * RAD, 0, sway)
		end
	else
		-- 범: 고개를 낮게 들고, 달리면 더 숙인다
		local nod = math.sin(A * 2) * 0.04 * m * (1 - run) + math.sin(A + 1.8) * 0.08 * run
		local head = bones.front * CF(0, -0.85 * k, -3.35 * k) * ANG(-0.12 + nod - run * 0.15, look, 0)
		bones.head = head
		bones.earL = head * CF(-0.6 * k, 0.62 * k, 0.25 * k) * ANG(-twL, 0, 0.35)
		bones.earR = head * CF(0.6 * k, 0.62 * k, 0.25 * k) * ANG(-twR, 0, -0.35)
		-- 꼬리: 뒤로 뻗었다가 끝이 위로 말리고, 물결치듯 흔들린다
		local tc = bones.rear * CF(0, -0.75 * k, 2.75 * k) * ANG(-lerp(100, 92, run) * RAD, 0, 0)
		for i = 1, 9 do
			bones["t" .. i] = tc
			local bend = (i <= 4 and 10 or -16) * RAD * (1 - run * 0.5)
			local sway = math.sin(t * 1.8 - i * 0.6) * 9 * RAD * (0.5 + i * 0.15) + math.sin(t * 9 - i) * 4 * RAD * run
			tc = tc * CF(0, -0.5 * k, 0) * ANG(bend, 0, sway)
		end
	end
end

------------------------------------------------------------------------
-- 날개구름: 탄 사람은 구름 위에 선다. 뭉치마다 따로 둥실거리고, 뒤로 작은 구름이 흩어진다
------------------------------------------------------------------------
local CLOUD = { B = 6.05 }
local function buildCloud(rig: Rig)
	local m = rig.m
	local spots = {
		{ 0, -1.2, 0, 3.0 }, { 1.3, -1.1, -0.9, 2.2 }, { -1.3, -1.1, -0.9, 2.2 }, { 1.4, -1.15, 1.0, 2.3 }, { -1.4, -1.15, 1.0, 2.3 },
		{ 0, -1.05, -1.9, 2.1 }, { 0, -1.1, 1.9, 2.2 }, { 0.8, -0.55, 0.3, 1.5 }, { -0.8, -0.55, 0.3, 1.5 }, { 0, -1.8, 0, 2.4 },
		{ 2.2, -1.3, 0, 1.6 }, { -2.2, -1.3, 0, 1.6 },
	}
	for i, sp in ipairs(spots) do
		local col = m.color:Lerp(Color3.fromRGB(225, 230, 245), (i % 3) * 0.08)
		local e = add(rig, "body", "ball", V(sp[4], sp[4], sp[4]), CF(sp[1], sp[2], sp[3]), col)
		e.bob = { 0.12, 1.4 + (i % 4) * 0.35, i * 1.3 }
		-- 바깥의 옅은 솜털 (부드러운 가장자리)
		local o = add(rig, "body", "ball", V(sp[4], sp[4], sp[4]) * 1.22, CF(sp[1], sp[2] - 0.05, sp[3]), col:Lerp(m.mane, 0.08), nil, 0.6)
		o.bob = { 0.15, 1.1 + (i % 3) * 0.3, i * 0.7 }
	end
	local glow = add(rig, "body", "cyl", V(0.25, 5.2, 5.2), CF(0, -2.75, 0) * ANG(0, 0, math.rad(90)), m.mane, Enum.Material.Neon, 0.5).p
	local light = Instance.new("PointLight")
	light.Color = m.mane
	light.Range = 16
	light.Brightness = 1.6
	light.Parent = glow
	emitter(glow, TEX_SPARK, m.mane, 0.4, 20, 1.0, 2, 60)
	local mist = emitter(glow, TEX_SMOKE, WHITE, 2.2, 6, 1.4, 1, 40)
	mist.Transparency = NumberSequence.new(0.6, 1)
	mist.LightEmission = 0.2
	-- 뒤로 흩어지는 꼬리 구름
	for i = 1, 6 do
		local sz = 2.0 - i * 0.24
		local e = add(rig, "_trail", "ball", V(sz, sz, sz), CF(), m.color, nil, 0.1 + i * 0.12)
		table.insert(rig.trail, e)
	end
end

------------------------------------------------------------------------
-- 청룡 (로벅스 상품): 스물두 마디의 비늘 몸이 머리가 지나간 길을 그대로 따라 흐른다.
-- 빛나는 등줄기, 금빛 등지느러미, 몸을 감도는 영기의 불꽃, 꼬리 끝에서 흐르는 금빛 띠,
-- 크게 벌린 입과 송곳니, 가지 뿔, 흐르는 수염, 빛을 끌며 도는 눈, 여의주. 가끔 고개를 들고 포효한다
------------------------------------------------------------------------
local DRAGON = { B = 4.8, N = 22, gap = 1.05, legs = { 5, 14 }, H = 1.25 } -- B가 작을수록 크게, H = 머리 크기
local TEX_FIRE = "rbxasset://textures/particles/fire_main.dds"
local function segW(i: number): number
	if i < 3 then
		return 1.8 + 0.17 * i
	end
	return 2.3 - 1.75 * ((i - 3) / (DRAGON.N - 4))
end
local function trailOn(part: BasePart, a: Vector3, b: Vector3, c0: Color3, c1: Color3, life: number)
	local a0 = Instance.new("Attachment")
	a0.Position = a
	a0.Parent = part
	local a1 = Instance.new("Attachment")
	a1.Position = b
	a1.Parent = part
	local tr = Instance.new("Trail")
	tr.Attachment0 = a0
	tr.Attachment1 = a1
	tr.Color = ColorSequence.new(c0, c1)
	tr.Transparency = NumberSequence.new(0.15, 1)
	tr.LightEmission = 1
	tr.Lifetime = life
	tr.MinLength = 0.05
	tr.FaceCamera = true
	tr.Parent = part
end
local function buildDragon(rig: Rig)
	local m = rig.m
	local k = rig.k
	local c, gold = m.color, m.mane
	local deep = Color3.fromRGB(18, 66, 104)
	local belly = Color3.fromRGB(242, 226, 168)
	local glowGold = Color3.fromRGB(255, 232, 150)
	local spirit = Color3.fromRGB(120, 255, 220)
	local N = DRAGON.N
	for i = 0, N - 1 do
		local w = segW(i)
		local b = "s" .. i
		-- 머리 쪽 비취빛에서 꼬리 쪽 짙은 바닷빛으로
		local col = c:Lerp(deep, i / (N - 1) * 0.55)
		local sheen = col:Lerp(Color3.fromRGB(130, 230, 210), 0.3)
		local body = add(rig, b, "ell", V(w, w * 0.92, 1.85), CF(), col)
		body.p.Reflectance = 0.12
		add(rig, b, "ell", V(w * 0.74, w * 0.42, 1.6), CF(0, -w * 0.32, 0), belly)
		add(rig, b, "ell", V(w * 0.6, 0.12, 0.35), CF(0, -w * 0.48, -0.6), belly:Lerp(gold, 0.45))
		-- 등의 비늘 두 줄 (겹쳐 얹은 비늘판)
		for _, sd in ipairs({ -1, 1 }) do
			local sc = add(rig, b, "ell", V(w * 0.55, w * 0.22, 0.95), CF(sd * w * 0.2, w * 0.36, -0.15) * ANG(0.2, 0, sd * 0.35), sheen)
			sc.p.Reflectance = 0.25
		end
		-- 빛나는 등줄기와 금빛 등지느러미 (끝은 빛난다)
		add(rig, b, "ell", V(0.13, 0.13, 1.5), CF(0, w * 0.47, 0), glowGold, Enum.Material.Neon, 0.1)
		wave(add(rig, b, "ell", V(0.12, w * 0.7, 0.95), CF(0, w * 0.56, 0.15) * ANG(-0.5, 0, 0), gold, Enum.Material.Metal), 1, 0.05, 4, i * 0.6, 0.12)
		wave(add(rig, b, "ell", V(0.07, w * 0.36, 0.5), CF(0, w * 0.86, 0.42) * ANG(-0.6, 0, 0), glowGold, Enum.Material.Neon, 0.2), 1, 0.05, 4, i * 0.6, 0.12)
		if i % 2 == 0 then
			for _, sd in ipairs({ -1, 1 }) do
				add(rig, b, "ell", V(0.1, w * 0.3, 1.25), CF(sd * w * 0.46, w * 0.05, 0), col:Lerp(DARK, 0.35))
			end
		end
		-- 옆구리의 금빛 불꽃 털 (세 마디마다, 뒤로 흩날린다)
		if i % 3 == 1 and i > 3 then
			for _, sd in ipairs({ -1, 1 }) do
				wave(add(rig, b, "ell", V(0.12, w * 0.65, 0.95), CF(sd * w * 0.5, w * 0.1, 0.3) * ANG(-0.9, 0, sd * 1.0), gold), 3, 0.12, 5, i + sd, 0.25)
			end
		end
	end
	-- 몸을 감도는 영기의 불꽃과 금빛 가루, 몸 아래로 흩어지는 구름
	for _, si in ipairs({ 3, 8, 13, 18 }) do
		local holder = add(rig, "s" .. si, "ball", V(0.1, 0.1, 0.1), CF(0, segW(si) * 0.3, 0), WHITE, nil, 1).p
		local fl = emitter(holder, TEX_FIRE, spirit, 1.8 * k, 14, 0.7, 1.2, 40)
		fl.Color = ColorSequence.new(spirit, gold)
		fl.LightEmission = 1
		fl.Acceleration = V(0, 4, 0)
		emitter(holder, TEX_SPARK, glowGold, 0.45 * k, 10, 1.2, 1.5, 180)
	end
	for _, si in ipairs({ 6, 12, 18 }) do
		local holder = add(rig, "s" .. si, "ball", V(0.1, 0.1, 0.1), CF(0, -segW(si) * 0.4, 0), WHITE, nil, 1).p
		local mist = emitter(holder, TEX_SMOKE, Color3.fromRGB(240, 245, 255), 3.4 * k, 7, 1.8, 0.6, 50)
		mist.Transparency = NumberSequence.new(0.55, 1)
		mist.LightEmission = 0.15
	end
	local bodyLight = Instance.new("PointLight")
	bodyLight.Color = spirit
	bodyLight.Range = 18
	bodyLight.Brightness = 1.1
	bodyLight.Parent = rig.parts[#rig.parts].p
	-- 꼬리 끝: 다섯 갈래 금빛 부채 지느러미 (가장자리는 빛난다)와 흐르는 금빛 띠
	local tailB = "s" .. (N - 1)
	for j = -2, 2 do
		local th = math.rad(90 + j * 24)
		local off = CF(0, math.cos(th) * 1.0, math.sin(th) * 1.0) * ANG(th, 0, 0)
		wave(add(rig, tailB, "ell", V(0.1, 2.0, 1.1), off, gold, Enum.Material.Metal), 3, 0.12, 3, j, 0.15)
		wave(add(rig, tailB, "ell", V(0.06, 2.1, 0.45), off * CF(0, 0.15, 0.35), glowGold, Enum.Material.Neon, 0.25), 3, 0.12, 3, j, 0.15)
	end
	local tailPart = add(rig, tailB, "ball", V(0.1, 0.1, 0.1), CF(0, 0, 1.6), WHITE, nil, 1).p
	trailOn(tailPart, V(0, 0.7 * k, 0), V(0, -0.7 * k, 0), glowGold, spirit, 0.8)
	-- 다리 넷: 비늘 다리, 팔꿈치의 불꽃 털, 금빛 발톱 넷
	for _, si in ipairs(DRAGON.legs) do
		local ls = segW(si) / 2
		for _, side in ipairs({ "L", "R" }) do
			local nm = "d" .. si .. side
			local col = c:Lerp(deep, si / (N - 1) * 0.55)
			add(rig, nm .. "u", "ell", V(0.6, 1.35, 0.6) * ls, CF(0, -0.6 * ls, 0), col)
			add(rig, nm .. "l", "ell", V(0.45, 1.05, 0.45) * ls, CF(0, -0.45 * ls, 0), col)
			wave(add(rig, nm .. "l", "ell", V(0.12, 0.9, 0.5) * ls, CF(0, 0.1 * ls, 0.3 * ls) * ANG(-1.2, 0, 0), gold), 1, 0.15, 5, si, 0.2)
			add(rig, nm .. "f", "ell", V(0.55, 0.3, 0.6) * ls, CF(0, -0.1 * ls, -0.1 * ls), col)
			for _, x in ipairs({ -0.2, -0.07, 0.07, 0.2 }) do
				add(rig, nm .. "f", "ell", V(0.12, 0.12, 0.55) * ls, CF(x * ls, -0.2 * ls, -0.45 * ls) * ANG(-0.5, x * 0.6, 0), gold, Enum.Material.Metal)
			end
		end
	end
	-- 머리 (-Z가 앞, H배 크게)
	local H = DRAGON.H
	local function hd(bone: string, shape: string, size: Vector3, pos: Vector3, rot: CFrame?, color: Color3, mat: Enum.Material?, alpha: number?): Piece
		return add(rig, bone, shape, size * H, CF(pos * H) * (rot or CFrame.identity), color, mat, alpha)
	end
	local darkC = c:Lerp(DARK, 0.35)
	local mouth = Color3.fromRGB(90, 20, 26)
	hd("head", "ell", V(1.6, 1.25, 1.8), V(0, 0.1, 0), nil, c)
	hd("head", "ell", V(1.2, 0.7, 1.2), V(0, 0.55, 0.1), nil, c)
	hd("head", "ell", V(1.15, 0.75, 2.1), V(0, -0.02, -1.5), nil, c)
	hd("head", "ell", V(1.0, 0.6, 0.7), V(0, 0.15, -2.45), nil, c)
	hd("head", "ell", V(0.85, 0.25, 1.7), V(0, -0.33, -1.25), nil, mouth)
	for _, s in ipairs({ -1, 1 }) do
		-- 젖혀진 윗입술, 말린 콧구멍
		hd("head", "ell", V(0.35, 0.35, 1.5), V(s * 0.5, -0.25, -1.6), ANG(0, -s * 0.12, 0), belly)
		hd("head", "ell", V(0.28, 0.28, 0.2), V(s * 0.3, 0.32, -2.72), nil, darkC)
		hd("head", "ball", V(0.14, 0.14, 0.14), V(s * 0.3, 0.32, -2.8), nil, DARK)
		-- 매서운 눈썹 뼈와 빛나는 금빛 눈 (세로 동공), 눈에서 끌리는 빛
		hd("head", "ell", V(0.5, 0.32, 1.0), V(s * 0.45, 0.58, -0.35), ANG(0, -s * 0.15, s * 0.25), darkC)
		local eyeRot = ANG(0, s * 0.5, s * 0.25)
		hd("head", "ell", V(0.42, 0.3, 0.2), V(s * 0.58, 0.36, -0.6), eyeRot, DARK)
		local iris = hd("head", "ell", V(0.34, 0.24, 0.14), V(s * 0.62, 0.36, -0.62), eyeRot, Color3.fromRGB(255, 225, 90), Enum.Material.Neon).p
		hd("head", "ell", V(0.06, 0.22, 0.08), V(s * 0.68, 0.36, -0.64), eyeRot, DARK)
		trailOn(iris, V(0, 0.06 * k, 0), V(0, -0.06 * k, 0), Color3.fromRGB(255, 230, 120), spirit, 0.35)
		-- 윗니와 송곳니
		for _, z in ipairs({ -0.9, -1.3, -1.7, -2.1 }) do
			hd("head", "ell", V(0.1, 0.2, 0.1), V(s * 0.42, -0.38, z), nil, WHITE)
		end
		hd("head", "ell", V(0.13, 0.42, 0.13), V(s * 0.36, -0.5, -2.2), nil, WHITE)
		-- 가지 뿔: 굵은 밑동 → 휘어 오르는 줄기 → 빛나는 끝, 옆으로 뻗는 곁가지
		hd("head", "ell", V(0.3, 0.3, 1.7), V(s * 0.45, 0.75, 0.65), ANG(0.55, s * 0.28, 0), gold, Enum.Material.Metal)
		hd("head", "ell", V(0.22, 0.22, 1.3), V(s * 0.6, 1.3, 1.5), ANG(0.95, s * 0.35, 0), gold, Enum.Material.Metal)
		hd("head", "ell", V(0.14, 0.14, 0.8), V(s * 0.68, 1.75, 2.1), ANG(1.25, s * 0.4, 0), glowGold, Enum.Material.Neon)
		hd("head", "ell", V(0.15, 0.15, 0.8), V(s * 0.7, 1.05, 1.0), ANG(-0.1, s * 0.7, 0), gold, Enum.Material.Metal)
		hd("head", "ell", V(0.1, 0.1, 0.45), V(s * 0.95, 1.1, 1.25), ANG(-0.1, s * 0.75, 0), glowGold, Enum.Material.Neon)
		-- 볼 뒤의 부채 가시 셋
		for j = 0, 2 do
			wave(hd("head", "ell", V(0.08, 1.0, 0.55), V(s * 0.78, -0.25 + j * 0.25, 0.35), ANG(0.9 - j * 0.25, 0, s * (0.7 + j * 0.2)), gold, Enum.Material.Metal), 3, 0.06, 3, j + s, 0.1)
		end
		-- 수염 (여섯 마디), 눈썹 수염 (네 마디)
		local tag = s < 0 and "L" or "R"
		for j = 1, 6 do
			add(rig, "w" .. tag .. j, "ell", V(0.12 - j * 0.012, 0.12 - j * 0.012, 0.85), CF(0, 0, 0.4), glowGold, Enum.Material.Neon)
		end
		for j = 1, 4 do
			add(rig, "b" .. tag .. j, "ell", V(0.08, 0.08, 0.7), CF(0, 0, 0.33), gold, Enum.Material.Neon, 0.1)
		end
	end
	-- 뒤통수의 금빛 갈기 (달리면 흩날린다)
	for j = 0, 5 do
		local sd = j % 2 == 0 and 1 or -1
		wave(hd("head", "ell", V(0.16, 1.1, 0.6), V(sd * 0.25, 0.65, 0.5 + j * 0.3), ANG(-0.75, 0, sd * 0.35), gold), 3, 0.1, 4, j, 0.25)
	end
	-- 아래턱: 이빨과 송곳니, 붉은 혀, 금빛 턱수염
	hd("jaw", "ell", V(1.05, 0.36, 2.0), V(0, -0.05, -1.05), nil, belly)
	hd("jaw", "ell", V(0.45, 0.12, 1.4), V(0, 0.1, -1.1), nil, Color3.fromRGB(200, 50, 62))
	for _, s in ipairs({ -1, 1 }) do
		for _, z in ipairs({ -1.0, -1.4, -1.8 }) do
			hd("jaw", "ell", V(0.1, 0.18, 0.1), V(s * 0.4, 0.17, z), nil, WHITE)
		end
		hd("jaw", "ell", V(0.12, 0.34, 0.12), V(s * 0.34, 0.25, -1.95), nil, WHITE)
	end
	for _, x in ipairs({ -0.2, 0, 0.2 }) do
		wave(hd("jaw", "ell", V(0.3, 0.9, 0.28), V(x, -0.45, -0.7 + math.abs(x)), ANG(0.35, 0, x), gold), 3, 0.08, 3, x * 5, 0.2)
	end
	-- 여의주: 빛나는 구슬, 둘레를 도는 빛 여섯, 푸른 금빛 불꽃
	local pearl = add(rig, "pearl", "ball", V(1.3, 1.3, 1.3), CF(), Color3.fromRGB(255, 248, 220), Enum.Material.Neon).p
	local pl = Instance.new("PointLight")
	pl.Color = gold
	pl.Range = 22
	pl.Brightness = 2.2
	pl.Parent = pearl
	emitter(pearl, TEX_SPARK, gold, 0.4 * k, 18, 0.9, 1.5, 180)
	local pf = emitter(pearl, TEX_FIRE, spirit, 1.6 * k, 16, 0.5, 0.8, 180)
	pf.Color = ColorSequence.new(spirit, gold)
	pf.LightEmission = 1
	for j = 0, 5 do
		local a = j / 6 * TAU
		add(rig, "pearlSpin", "ball", V(0.22, 0.22, 0.22), CF(math.cos(a) * 1.25, 0, math.sin(a) * 1.25), j % 2 == 0 and glowGold or spirit, Enum.Material.Neon)
	end
	local glowHolder = add(rig, "head", "ball", V(0.1, 0.1, 0.1), CF(0, 0.2, -0.4), gold, Enum.Material.Neon, 1).p
	emitter(glowHolder, TEX_SPARK, gold, 0.45 * k, 22, 1.3, 1.2, 180)
	local headLight = Instance.new("PointLight")
	headLight.Color = glowGold
	headLight.Range = 18
	headLight.Brightness = 1.5
	headLight.Parent = glowHolder
end

-- 지나온 길 (머리 쪽이 1번). 너무 멀리 뛰면 (순간이동) 새로 시작한다
local function pushHist(rig: Rig, p: Vector3, maxLen: number)
	local h = rig.hist
	if #h == 0 or (p - h[1]).Magnitude > 40 then
		table.clear(h)
		table.insert(h, p)
		return
	end
	if (p - h[1]).Magnitude > 0.3 then
		table.insert(h, 1, p)
	else
		h[1] = p
	end
	local total = 0
	for i = 2, #h do
		total += (h[i] - h[i - 1]).Magnitude
		if total > maxLen then
			for _ = #h, i + 1, -1 do
				table.remove(h)
			end
			break
		end
	end
end
-- 길 위에서 머리부터 일정한 간격의 자리들 (길이 모자라면 뒤로 곧게 늘인다)
local function samplePath(h: { Vector3 }, back: Vector3, gap: number, n: number, start: number): { Vector3 }
	local out = {}
	local idx, acc = 1, 0
	for i = 0, n - 1 do
		local want = start + i * gap
		while idx < #h and acc + (h[idx + 1] - h[idx]).Magnitude < want do
			acc += (h[idx + 1] - h[idx]).Magnitude
			idx += 1
		end
		if idx < #h then
			local seg = h[idx + 1] - h[idx]
			local L = seg.Magnitude
			out[i + 1] = h[idx] + seg * (L > 1e-4 and math.clamp((want - acc) / L, 0, 1) or 0)
		else
			local dir = #h >= 2 and (h[#h] - h[#h - 1]) or back
			if dir.Magnitude < 1e-4 then
				dir = back
			end
			out[i + 1] = h[#h] + dir.Unit * (want - acc)
		end
	end
	return out
end

------------------------------------------------------------------------
-- 만들기·지우기
------------------------------------------------------------------------
local function poof(model: Model, color: Color3, big: boolean?)
	local root = model:FindFirstChild("HumanoidRootPart")
	if root and root:IsA("BasePart") then
		local cam = workspace.CurrentCamera
		if cam and (cam.CFrame.Position - root.Position).Magnitude > 200 then
			return
		end
		Fx.burst("smoke", root.Position - V(0, 2, 0), Color3.fromRGB(235, 230, 220), 10, 1.4)
		Fx.burst("glitter", root.Position, color, 10, 1)
		if big then
			-- 청룡이 나타날 때: 금빛 기운이 크게 터지고 고리가 퍼진다
			Fx.burst("glitter", root.Position, color, 40, 2.2)
			Fx.burst("spark", root.Position, Color3.fromRGB(120, 255, 220), 24, 1.8)
			Fx.ring(root.Position - V(0, 5, 0), color, 4, 44, 0.8)
			Fx.flash(root.Position, color, 50, 4, 0.5)
		end
	end
end

local function build(model: Model, id: string)
	local m = Config.MOUNT_BY_ID[id]
	if not m then
		return
	end
	local Q = m.kind == "tiger" and TIGER or m.kind == "cloud" and CLOUD or m.kind == "dragon" and DRAGON or HORSE
	-- 크기: 탄 사람이 들린 높이에 맞춘다 (서버의 Config.MOUNT_HIP)
	local hum = model:FindFirstChildOfClass("Humanoid")
	local hip = Config.MOUNT_HIP[m.kind] or 3
	local back = hip + 1.85
	if hum and hum.HipHeight > hip + 0.5 then
		back = hum.HipHeight - 0.15
	end
	local rig: Rig = {
		kind = m.kind,
		m = m,
		model = model,
		k = math.clamp(back / Q.B, 0.75, 1.8),
		Q = Q,
		parts = {},
		bones = {},
		phase = 0,
		move = 0,
		run = 0,
		yaw = nil,
		yawRate = 0,
		bank = 0,
		born = os.clock(),
		shown = false,
		hist = {},
		trail = {},
		reins = {},
		straps = {},
		irons = {},
		skip = 0,
		lastU = {},
	}
	if m.kind == "cloud" then
		buildCloud(rig)
	elseif m.kind == "dragon" then
		buildDragon(rig)
	elseif m.kind == "tiger" then
		buildTiger(rig)
	else
		buildHorse(rig)
	end
	rigs[model] = rig
	poof(model, m.mane, m.kind == "dragon")
end

local function clear(model: Model, fx: boolean?)
	local rig = rigs[model]
	if rig then
		for _, e in ipairs(rig.parts) do
			e.p:Destroy()
		end
		rigs[model] = nil
		if fx then
			poof(model, rig.m.mane)
		end
	end
end

function Mount.watch(model: Model)
	local function refresh()
		local had = rigs[model] ~= nil
		clear(model, had)
		local id = model:GetAttribute("Mount")
		if type(id) == "string" then
			build(model, id)
		end
	end
	model:GetAttributeChangedSignal("Mount"):Connect(refresh)
	model.AncestryChanged:Connect(function()
		if not model.Parent then
			clear(model)
		end
	end)
	refresh()
end

------------------------------------------------------------------------
-- 매 화면
------------------------------------------------------------------------
local function update(rig: Rig, root: BasePart, hum: Humanoid, dt: number, t: number)
	local k = rig.k
	local bones = rig.bones
	local vel = root.AssemblyLinearVelocity
	local speed = V(vel.X, 0, vel.Z).Magnitude
	local look = root.CFrame.LookVector
	local flat = V(look.X, 0, look.Z)
	if flat.Magnitude < 1e-3 then
		flat = V(0, 0, -1)
	end
	flat = flat.Unit
	-- 방향은 살짝 늦게 따라오고, 도는 만큼 안쪽으로 기운다
	local yawT = math.atan2(-flat.X, -flat.Z)
	if not rig.yaw then
		rig.yaw = yawT
	end
	local yaw = rig.yaw :: number
	local d = (yawT - yaw + math.pi) % TAU - math.pi
	yaw += d * math.min(1, dt * 9)
	rig.yaw = yaw
	rig.yawRate += (d * 9 - rig.yawRate) * math.min(1, dt * 6)
	rig.move += ((speed > 1.2 and 1 or 0) - rig.move) * math.min(1, dt * 5)
	rig.run += (math.clamp((speed - 9) / 12, 0, 1) - rig.run) * math.min(1, dt * 3)
	rig.bank += (math.clamp(rig.yawRate * 0.07, -0.3, 0.3) * (0.25 + 0.75 * rig.move) - rig.bank) * math.min(1, dt * 6)
	local freq = (0.75 + speed * 0.062) / math.sqrt(k) -- 큰 짐승일수록 보폭이 길고 걸음이 느긋하다
	rig.phase = (rig.phase + dt * freq) % 1
	local pos = root.Position
	local rootBottom = pos.Y - root.Size.Y / 2
	local seatY = rootBottom - 0.3
	local groundY = rootBottom - hum.HipHeight
	local turn = ANG(0, yaw, 0)

	if rig.kind == "horse" or rig.kind == "tiger" then
		local yawCF = CF(pos.X, seatY, pos.Z) * turn
		updateQuad(rig, yawCF, groundY - seatY, t, speed, freq)
	elseif rig.kind == "cloud" then
		local baseHip = math.max(0.5, hum.HipHeight - (Config.MOUNT_HIP.cloud or 2.6))
		local feetY = rootBottom - baseHip
		local body = CF(pos.X, feetY + 0.15, pos.Z) * turn * CF(0, math.sin(t * 1.9) * 0.1 * k, 0) * ANG(-7 * RAD * rig.move, 0, rig.bank * 1.4)
		bones.body = body
		pushHist(rig, body.Position, 14 * k)
		local pts = samplePath(rig.hist, -flat, 1.3 * k, #rig.trail, 2.4 * k)
		for i, e in ipairs(rig.trail) do
			local p = pts[i] + V(math.sin(t * 2 + i) * 0.25, -1.2 * k + math.sin(t * 1.5 + i * 0.8) * 0.2, 0)
			e.p.CFrame = CF(p)
		end
	else
		-- 청룡: 머리는 탄 사람 앞, 몸은 지나온 길을 따라 흐르며 옆과 위아래로 물결친다
		local N, gap = DRAGON.N, DRAGON.gap * k
		local anchor = V(pos.X, seatY - 0.95 * k, pos.Z) + flat * 2.2 * k + V(0, math.sin(t * 1.5) * 0.12 * k, 0)
		pushHist(rig, anchor, N * gap + 6)
		local pts = samplePath(rig.hist, -flat, gap, N, 0)
		local up = V(0, 1, 0)
		for i = 0, N - 1 do
			local w = i / (N - 1)
			local here = pts[i + 1]
			local ahead = i == 0 and (here + flat) or pts[i]
			local tan = ahead - here
			if tan.Magnitude < 1e-3 then
				tan = flat
			end
			local right = tan.Unit:Cross(up)
			if right.Magnitude < 1e-3 then
				right = V(1, 0, 0)
			end
			local calm = i <= 2 and 0 or 1
			-- 탄 사람 아래의 앞 마디는 곧게 (돌 때 몸이 사람에게서 비껴 나지 않게)
			local rigid = math.clamp((4 - i) / 2, 0, 1)
			if rigid > 0 then
				local line = V(anchor.X, here.Y, anchor.Z) - flat * i * gap
				here = here:Lerp(line, rigid)
			end
			local lat = math.sin(t * 2.4 - i * 0.5) * k * math.max(0, i - 2) / (N - 3) * (0.6 + 0.6 * rig.move) * 1.1
			local vert = math.sin(t * 1.7 - i * 0.42) * k * (0.15 + 0.55 * w) * (1 - 0.4 * rig.move) * calm
			pts[i + 1] = here + right.Unit * lat * calm + up * vert
		end
		for i = 0, N - 1 do
			local here = pts[i + 1]
			local ahead = i == 0 and (here + flat * gap) or pts[i]
			if (ahead - here).Magnitude < 1e-3 then
				ahead = here + flat
			end
			bones["s" .. i] = CFrame.lookAt(here, ahead)
		end
		-- 다리: 헤엄치듯 천천히 젓는다 (발목이 따라 접힌다)
		for _, si in ipairs(DRAGON.legs) do
			local seg = bones["s" .. si]
			local w = segW(si)
			local ls = w / 2
			for _, side in ipairs({ -1, 1 }) do
				local paddle = math.sin(t * (2 + 3 * rig.move) + side + si) * 0.5
				local u = seg * CF(side * 0.5 * w * k, -0.35 * w * k, 0) * ANG(paddle, 0, side * 0.7)
				local name = "d" .. si .. (side < 0 and "L" or "R")
				bones[name .. "u"] = u
				local l = u * CF(0, -1.1 * ls * k, 0) * ANG(-0.9 - paddle * 0.4, 0, 0)
				bones[name .. "l"] = l
				bones[name .. "f"] = l * CF(0, -0.95 * ls * k, 0) * ANG(0.5 + paddle * 0.4, 0, 0)
			end
		end
		-- 포효: 아홉 초마다 고개를 들고 입을 크게 벌린다 (금빛 기운이 터진다)
		local H = DRAGON.H
		local rt = t % 9
		local roar = rt < 1.4 and math.sin(math.pi * rt / 1.4) or 0
		local nod = math.sin(t * 1.3) * 0.08 + roar * 0.28
		local look2 = math.clamp(rig.yawRate * 0.12, -0.4, 0.4)
		local head = CF(pts[1] + flat * 1.0 * k * H + V(0, 0.35 * k, 0)) * turn * ANG(nod, look2, 0)
		bones.head = head
		bones.jaw = head * CF(0, -0.38 * k * H, -0.3 * k * H) * ANG(-(0.12 + 0.05 * math.sin(t * 1.3) + roar * 0.55), 0, 0)
		local pearl = head * CF(math.sin(t * 1.1) * 0.5 * k, 0.4 * k + math.sin(t * 2) * 0.3 * k, -4.2 * k * H)
		bones.pearl = pearl
		bones.pearlSpin = pearl * ANG(0.5, t * 2.2, 0)
		if rt < (rig.roarT or 0) then
			local cam = workspace.CurrentCamera
			if cam and (cam.CFrame.Position - head.Position).Magnitude < 160 then
				local mouthAt = (head * CF(0, -0.2 * k * H, -2.6 * k * H)).Position
				Fx.burst("glitter", mouthAt, rig.m.mane, 22, 1.6)
				Fx.burst("spark", mouthAt, Color3.fromRGB(120, 255, 220), 14, 1.3)
				Fx.flash(mouthAt, rig.m.mane, 30, 3, 0.4)
			end
		end
		rig.roarT = rt
		for _, s in ipairs({ -1, 1 }) do
			local tag = s < 0 and "L" or "R"
			local cf = head * CF(s * 0.5 * k * H, -0.05 * k * H, -2.2 * k * H) * ANG(0, s * 0.9, 0)
			for j = 1, 6 do
				bones["w" .. tag .. j] = cf
				cf = cf * CF(0, 0, 0.8 * k) * ANG(math.sin(t * 3 - j * 0.8) * (0.22 + 0.1 * rig.run), s * 0.1, 0)
			end
			local bc = head * CF(s * 0.55 * k * H, 0.8 * k * H, -0.3 * k * H) * ANG(0.5, s * 0.5, 0)
			for j = 1, 4 do
				bones["b" .. tag .. j] = bc
				bc = bc * CF(0, 0, 0.66 * k) * ANG(math.sin(t * 2.5 - j) * 0.2 - 0.05, s * 0.08, 0)
			end
		end
	end

	-- 조각을 뼈에 붙인다
	local run = rig.run
	for _, e in ipairs(rig.parts) do
		local b = bones[e.bone]
		if b then
			local cf = b
			local bob = e.bob
			if bob then
				cf = cf * CF(0, math.sin(t * bob[2] + bob[3]) * bob[1] * k, 0)
			end
			cf = cf * e.off
			local w = e.w
			if w then
				local a = math.sin(t * w[3] + w[4]) * (w[2] + w[5] * run)
				if w[1] == 1 then
					cf = cf * ANG(a, 0, 0)
				elseif w[1] == 2 then
					cf = cf * ANG(0, a, 0)
				else
					cf = cf * ANG(0, 0, a)
				end
			end
			e.p.CFrame = cf
		end
	end

	-- 고삐 (재갈 → 손), 등자 (안장 옆 → 발)
	local model = rig.model
	if #rig.reins > 0 and bones.head then
		local bitOff = rig.kind == "horse" and V(0.45, -0.5, -1.95) or V(0.55, -0.45, -0.75)
		for i, side in ipairs({ -1, 1 }) do
			local hand = model:FindFirstChild(side < 0 and "LeftHand" or "RightHand")
			local rein = rig.reins[i]
			if hand and hand:IsA("BasePart") and rein then
				local bit = bones.head * V(bitOff.X * side * k, bitOff.Y * k, bitOff.Z * k)
				span(rein, bit, hand.Position, 0.07 * k)
			end
		end
	end
	if #rig.straps > 0 and bones.body then
		for i, side in ipairs({ -1, 1 }) do
			local foot = model:FindFirstChild(side < 0 and "LeftFoot" or "RightFoot")
			local strap, iron = rig.straps[i], rig.irons[i]
			if foot and foot:IsA("BasePart") and strap and iron then
				local top = bones.body * V(side * 1.2 * k, -0.25 * k, -0.15 * k)
				local fp = foot.Position - V(0, foot.Size.Y / 2 + 0.05, 0)
				span(strap, top, fp, 0.08 * k)
				iron.CFrame = CF(fp) * turn
			end
		end
	end

	-- 나타날 때 0.3초에 걸쳐 짙어진다
	if not rig.shown then
		local prog = math.clamp((t - rig.born) / 0.3, 0, 1)
		for _, e in ipairs(rig.parts) do
			e.p.Transparency = lerp(1, e.alpha, prog)
		end
		if prog >= 1 then
			rig.shown = true
		end
	end
end

local warned = false
RunService.RenderStepped:Connect(function(dt: number)
	local t = os.clock()
	local cam = workspace.CurrentCamera
	for model, rig in pairs(rigs) do
		local root = model:FindFirstChild("HumanoidRootPart")
		local hum = model:FindFirstChildOfClass("Humanoid")
		if not root or not root:IsA("BasePart") or not hum or not model.Parent then
			clear(model)
			continue
		end
		-- 멀리 있는 탈것은 세 화면에 한 번만
		if cam and (cam.CFrame.Position - root.Position).Magnitude > 260 then
			rig.skip += 1
			if rig.skip % 3 ~= 0 then
				continue
			end
		end
		local ok, err = pcall(update, rig, root, hum, dt, t)
		if not ok then
			if not warned then
				warned = true
				warn("[권왕] 탈것 오류:", err)
			end
			clear(model)
		end
	end
end)

return Mount
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="34">
          <Properties>
            <string name="Name">Mujo</string>
            <string name="Source"><![CDATA[-- 권왕 3.6판: 무상권 (화면). 모든 것은 지나간다: 금 간 사기, 재로 빚은 나, 시드는 꽃, 다 흐르는 모래시계, 깨지는 거울
-- 빛깔은 은빛 재와 차가운 푸른 넋불 둘뿐 (번쩍이는 색을 쓰지 않는다)
local Lighting = game:GetService("Lighting")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local Fx = require(script.Parent:WaitForChild("Fx"))

local Mujo = {}

local ASH = Color3.fromRGB(205, 210, 220)
local ASH_DARK = Color3.fromRGB(110, 114, 124)
local SOUL = Color3.fromRGB(110, 210, 255)
local SAND = Color3.fromRGB(214, 200, 168)
local WOOD = Color3.fromRGB(70, 56, 46)
local WHITE = Color3.new(1, 1, 1)
local TEX_SMOKE = "rbxasset://textures/particles/smoke_main.dds"
local TEX_SPARK = "rbxasset://textures/particles/sparkles_main.dds"
local UP = CFrame.Angles(0, 0, math.rad(90))

local folder = Instance.new("Folder")
folder.Name = "KwonMujo"
folder.Parent = workspace

local opts: any = {}
function Mujo.init(o: any)
	opts = o or {}
end

local function part(size: Vector3, color: Color3, material: Enum.Material?, alpha: number?, shape: string?): BasePart
	local p: BasePart
	if shape == "wedge" then
		p = Instance.new("WedgePart")
	else
		local q = Instance.new("Part")
		if shape == "ball" then
			q.Shape = Enum.PartType.Ball
		elseif shape == "cyl" then
			q.Shape = Enum.PartType.Cylinder
		end
		p = q
	end
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	p.Size = size
	p.Color = color
	p.Material = material or Enum.Material.SmoothPlastic
	p.Transparency = alpha or 0
	p.Parent = folder
	return p
end
local function tween(inst: Instance, time: number, goal: { [string]: any }, style: Enum.EasingStyle?, dir: Enum.EasingDirection?)
	local tw = TweenService:Create(inst, TweenInfo.new(math.max(0.01, time), style or Enum.EasingStyle.Quad, dir or Enum.EasingDirection.Out), goal)
	tw:Play()
	return tw
end
local function fadeOut(p: BasePart, time: number, goal: { [string]: any }?)
	local g = goal or {}
	g.Transparency = 1
	tween(p, time, g)
	task.delay(time + 0.05, function()
		p:Destroy()
	end)
end
local function near(pos: Vector3, d: number): boolean
	local cam = workspace.CurrentCamera
	return cam ~= nil and (cam.CFrame.Position - pos).Magnitude < d
end
local function rootOf(m: Instance?): BasePart?
	local r = m and m:FindFirstChild("HumanoidRootPart")
	return (r and r:IsA("BasePart")) and r or nil
end
local function flat(v: Vector3): Vector3
	local f = Vector3.new(v.X, 0, v.Z)
	return f.Magnitude > 1e-3 and f.Unit or Vector3.new(0, 0, -1)
end
local function ground(at: Vector3): Vector3
	return Vector3.new(at.X, at.Y - 2.7, at.Z)
end
local function shakeNear(pos: Vector3, amount: number, range: number)
	if opts.shake and near(pos, range) then
		opts.shake(amount)
	end
end
local function beam(a: Vector3, b: Vector3, w: number, color: Color3, alpha: number?, mat: Enum.Material?): BasePart
	local p = part(Vector3.new(w, w, math.max(0.05, (b - a).Magnitude)), color, mat or Enum.Material.Neon, alpha or 0)
	p.CFrame = (b - a).Magnitude > 1e-3 and CFrame.lookAt((a + b) / 2, b) or CFrame.new(a)
	return p
end
-- 흩날리는 재 한 줌 (조각 몇 개가 위로 떠올랐다 흩어진다)
local function ashPuff(at: Vector3, n: number, s: number, rise: number?)
	for _ = 1, n do
		local q = part(Vector3.new(0.3, 0.3, 0.3) * s * (0.6 + math.random() * 0.8), math.random() < 0.7 and ASH or ASH_DARK, Enum.Material.SmoothPlastic, 0.1)
		q.CFrame = CFrame.new(at + Vector3.new(math.random() - 0.5, math.random() - 0.5, math.random() - 0.5) * 2 * s) * CFrame.Angles(math.random() * 6, math.random() * 6, 0)
		fadeOut(q, 0.8 + math.random() * 0.6, { CFrame = q.CFrame + Vector3.new((math.random() - 0.5) * 6 * s, (rise or 3) * (0.5 + math.random()), (math.random() - 0.5) * 6 * s) })
	end
	Fx.burst("smoke", at, ASH, math.max(2, math.floor(n / 3)), s)
end
-- 사기 조각: 흰 판이 사방으로 튄다
local function shards(at: Vector3, n: number, s: number, color: Color3?)
	for _ = 1, n do
		local q = part(Vector3.new(0.9, 0.12, 0.7) * s * (0.6 + math.random() * 0.8), color or WHITE, Enum.Material.Glass, 0.15, "wedge")
		q.CFrame = CFrame.new(at) * CFrame.Angles(math.random() * 6, math.random() * 6, math.random() * 6)
		local d = Vector3.new(math.random() - 0.5, math.random() * 0.8, math.random() - 0.5).Unit
		fadeOut(q, 0.6, { CFrame = CFrame.new(at + d * (6 + math.random() * 5) * s) * CFrame.Angles(math.random() * 9, math.random() * 9, 0) })
	end
end
-- 금 (가지를 치며 갈라지는 가는 선)
local function crackLines(origin: Vector3, n: number, len: number, life: number, color: Color3?, planeUp: Vector3?)
	local up = planeUp or Vector3.new(0, 1, 0)
	local helper = math.abs(up.Y) > 0.9 and Vector3.new(1, 0, 0) or Vector3.new(0, 1, 0)
	local axisA = up:Cross(helper).Unit
	local axisB = up:Cross(axisA).Unit
	local out: { BasePart } = {}
	for k = 1, n do
		local a = (k / n + math.random() * 0.1) * math.pi * 2
		local p = origin
		local dir = axisA * math.cos(a) + axisB * math.sin(a)
		for _ = 1, 3 do
			local seg = len / 3 * (0.7 + math.random() * 0.6)
			local q = p + dir * seg
			table.insert(out, beam(p, q, 0.12, color or SOUL, 0.05))
			p = q
			local turn = (math.random() - 0.5) * 1.1
			dir = (dir * math.cos(turn) + up:Cross(dir) * math.sin(turn)).Unit
		end
	end
	task.delay(life, function()
		for _, q in ipairs(out) do
			if q.Parent then
				fadeOut(q, 0.2)
			end
		end
	end)
	return out
end

------------------------------------------------------------------------
-- 차림: 머리 뒤의 이 빠진 은빛 후광 (조각 열 중 둘이 빠졌다). 빠진 자리에서 재가 조금씩 떨어진다
------------------------------------------------------------------------
function Mujo.buildGear(model: Model): { Instance }
	local out: { Instance } = {}
	local holder = Instance.new("Folder")
	holder.Name = "Mujo_" .. model.Name
	holder.Parent = folder
	table.insert(out, holder)
	local head = model:FindFirstChild("Head")
	if not (head and head:IsA("BasePart")) then
		return out
	end
	local R = 1.15
	local segs: { { p: BasePart, a: number } } = {}
	for k = 0, 9 do
		if k ~= 3 and k ~= 4 then
			local a = k / 10 * math.pi * 2
			local p = part(Vector3.new(0.14, 0.16, R * 0.6), k % 2 == 0 and ASH or Color3.fromRGB(230, 234, 242), Enum.Material.SmoothPlastic, 0)
			p.Parent = holder
			table.insert(out, p)
			table.insert(segs, { p = p, a = a })
		end
	end
	-- 떨어져 나가는 중인 조각 둘 (빠진 자리 곁을 떠돈다)
	local loose: { BasePart } = {}
	for k = 1, 2 do
		local p = part(Vector3.new(0.12, 0.14, 0.32), ASH, Enum.Material.SmoothPlastic, 0.2)
		p.Parent = holder
		table.insert(out, p)
		loose[k] = p
	end
	local glow = part(Vector3.new(0.2, 0.2, 0.2), SOUL, Enum.Material.Neon, 1)
	glow.Parent = holder
	table.insert(out, glow)
	local a0 = Instance.new("Attachment")
	a0.Parent = glow
	local e = Instance.new("ParticleEmitter")
	e.Texture = TEX_SMOKE
	e.Color = ColorSequence.new(ASH, ASH_DARK)
	e.LightEmission = 0
	e.Rate = 5
	e.Lifetime = NumberRange.new(0.8, 1.4)
	e.Speed = NumberRange.new(0.2, 0.6)
	e.Acceleration = Vector3.new(0, -2.5, 0)
	e.Size = NumberSequence.new(0.25, 0.05)
	e.Transparency = NumberSequence.new(0.3, 1)
	e.Parent = a0
	local t0 = os.clock()
	local conn: RBXScriptConnection
	conn = RunService.RenderStepped:Connect(function()
		if not holder.Parent or not head.Parent then
			conn:Disconnect()
			return
		end
		local t = os.clock() - t0
		local hide = model:GetAttribute("Vanish") == true
		-- 머리 뒤, 몸을 따라 약간 기울어 천천히 돈다
		local base = head.CFrame * CFrame.new(0, 0.25, 0.75) * CFrame.Angles(math.rad(-12), 0, 0)
		local spin = t * 0.35
		for _, it in ipairs(segs) do
			local a = it.a + spin
			local pos = base * Vector3.new(math.cos(a) * R, math.sin(a) * R, 0)
			it.p.CFrame = CFrame.lookAt(pos, pos + (base.RightVector * -math.sin(a) + base.UpVector * math.cos(a)), base.LookVector)
			it.p.LocalTransparencyModifier = hide and 1 or 0
		end
		for k, p in ipairs(loose) do
			local a = (3.3 + k * 0.6) / 10 * math.pi * 2 + spin
			local drift = 0.25 + 0.15 * math.sin(t * 1.3 + k)
			local pos = base * Vector3.new(math.cos(a) * (R + drift), math.sin(a) * (R + drift), 0.1 * k)
			p.CFrame = CFrame.new(pos) * CFrame.Angles(t * (0.8 + k * 0.3), t * 0.5, 0)
			p.LocalTransparencyModifier = hide and 1 or 0
		end
		local ga = 3.5 / 10 * math.pi * 2 + spin
		glow.CFrame = CFrame.new(base * Vector3.new(math.cos(ga) * R, math.sin(ga) * R, 0))
		e.Enabled = not hide
	end)
	return out
end

------------------------------------------------------------------------
-- 연타 장치 무상인: 상대 둘레에 사기 껍질이 씌워지고 금이 번지다가, 산산이 깨져 재로 흩어진다
------------------------------------------------------------------------
local function ashCrack(data: any)
	local at: Vector3 = data.at
	if not near(at, 200) then
		return
	end
	local delay = data.delay or 0.45
	local shell = part(Vector3.new(5, 6.5, 5), WHITE, Enum.Material.Glass, 0.75, "ball")
	shell.CFrame = CFrame.new(at)
	-- 금이 위아래로 번진다 (껍질 겉에 세운 금 셋)
	for k = 0, 2 do
		local a = k / 3 * math.pi * 2 + math.random()
		local n = Vector3.new(math.cos(a), 0, math.sin(a))
		task.delay(k * 0.06, function()
			crackLines(at + n * 2.4, 3, 2.6, delay, SOUL, n)
		end)
	end
	local g = ground(at)
	crackLines(g + Vector3.new(0, 0.15, 0), 7, (data.radius or 6) * 0.9, delay + 0.1, ASH_DARK)
	Fx.sound("deflect", 0.4, 1.6, at)
	task.delay(delay, function()
		shell:Destroy()
		shards(at, 14, 1.1)
		ashPuff(at, 10, 1.2, 4)
		Fx.ring(g + Vector3.new(0, 0.3, 0), ASH, 2, (data.radius or 6) * 2, 0.4)
		Fx.sound("shatter", 0.6, 1.3, at)
	end)
end

------------------------------------------------------------------------
-- E 잔영멸: 재로 빚은 나 다섯 (몸의 생김새를 그대로 본떠 잿빛으로)
------------------------------------------------------------------------
local function statueOf(model: Model, cf: CFrame): { BasePart }
	local out: { BasePart } = {}
	local r = rootOf(model)
	if not r then
		return out
	end
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("BasePart") and d.Name ~= "HumanoidRootPart" and d.Transparency < 0.9 and d.Size.Magnitude < 8 and (d.Parent == model or (d.Parent and d.Parent:IsA("Accessory"))) then
			local q = part(d.Size, ASH:Lerp(ASH_DARK, math.random() * 0.25), Enum.Material.Slate, 0.05, d:IsA("Part") and d.Shape == Enum.PartType.Ball and "ball" or nil)
			q.CFrame = cf * r.CFrame:ToObjectSpace(d.CFrame)
			table.insert(out, q)
		end
	end
	return out
end
local function ashStatues(data: any)
	local from: Vector3, to: Vector3 = data.from, data.to
	if not near(from, 220) then
		return
	end
	local model: Model? = data.m
	local n = data.n or 5
	local dir = flat(to - from)
	local crumble = data.crumble or 0.45
	local step = data.step or 0.1
	-- 스친 자리의 재 띠
	for k = 0, 8 do
		task.delay(k * 0.02, function()
			ashPuff(from:Lerp(to, k / 8), 3, 0.9, 1.5)
		end)
	end
	Fx.sound("swing", 0.6, 0.7, from)
	local body = model
	if not body then
		return
	end
	for i = 1, n do
		local pos = from:Lerp(to, (i - 0.5) / n)
		local turn = (i % 2 == 0 and 1 or -1) * math.rad(25)
		local list = statueOf(body, CFrame.lookAt(pos, pos + dir) * CFrame.Angles(0, turn, 0))
		task.delay(crumble + (i - 1) * step - 0.12, function()
			crackLines(pos + Vector3.new(0, 0.5, 0), 4, 2.2, 0.14, SOUL, -dir)
		end)
		task.delay(crumble + (i - 1) * step, function()
			for _, q in ipairs(list) do
				local fall = q.CFrame - Vector3.new(0, 2.5 + math.random() * 1.5, 0) + Vector3.new((math.random() - 0.5) * 2, 0, (math.random() - 0.5) * 2)
				fadeOut(q, 0.55, { CFrame = fall * CFrame.Angles(math.random() * 2, math.random() * 2, 0), Size = q.Size * 0.5 })
			end
			ashPuff(pos, 8, 1.3, 3)
			Fx.ring(ground(pos) + Vector3.new(0, 0.3, 0), ASH, 2, (data.radius or 6) * 2, 0.35)
			Fx.sound("shatter", 0.35, 0.9 + i * 0.06, pos)
		end)
	end
end

------------------------------------------------------------------------
-- R 화무십일: 땅에 커다란 잿빛 꽃 (꽃잎 여덟)이 피었다가, 안으로 오므려 쥐고, 시들어 재로 무너진다
------------------------------------------------------------------------
local function witherBloom(data: any)
	local at: Vector3 = data.at
	if not near(at, 220) then
		return
	end
	local R = data.radius or 11
	local bloom = data.bloom or 0.35
	local hold = data.hold or 0.9
	local g = ground(at)
	local petals: { { p: BasePart, a: number } } = {}
	for k = 0, 7 do
		local p = part(Vector3.new(R * 0.42, 0.25, R * 0.75), ASH:Lerp(WHITE, 0.25), Enum.Material.SmoothPlastic, 0.05, "ball")
		table.insert(petals, { p = p, a = k / 8 * math.pi * 2 })
	end
	local core = part(Vector3.new(2, 2, 2), SOUL, Enum.Material.Neon, 0.1, "ball")
	core.CFrame = CFrame.new(g + Vector3.new(0, 1, 0))
	local stamens: { BasePart } = {}
	for k = 0, 5 do
		local a = k / 6 * math.pi * 2
		local s = part(Vector3.new(0.4, 0.4, 0.4), SOUL, Enum.Material.Neon, 0.1, "ball")
		s.CFrame = CFrame.new(g + Vector3.new(math.cos(a) * 1.4, 2.2, math.sin(a) * 1.4))
		table.insert(stamens, s)
	end
	Fx.sound("ping", 0.4, 0.8, at)
	local t0 = os.clock()
	local conn: RBXScriptConnection
	conn = RunService.Heartbeat:Connect(function()
		local t = os.clock() - t0
		-- 0 → 1: 피어난다 (꽃잎이 바깥으로 눕는다). 그 뒤엔 천천히 안으로 오므린다
		local open = math.clamp(t / bloom, 0, 1)
		local grip = math.clamp((t - bloom) / hold, 0, 1)
		local tilt = math.rad(80 - open * 70 + grip * 38) -- 80도 (닫힘) → 10도 (활짝) → 48도 (쥠)
		local reach = R * 0.45 * (0.4 + 0.6 * open) * (1 - grip * 0.25)
		for _, it in ipairs(petals) do
			local cf = CFrame.new(g) * CFrame.Angles(0, it.a + t * 0.4, 0) * CFrame.new(0, 0.4, -reach * 0.6) * CFrame.Angles(tilt, 0, 0) * CFrame.new(0, 0, -reach * 0.55)
			it.p.CFrame = cf
		end
		if t > bloom + hold then
			conn:Disconnect()
		end
	end)
	-- 쥐는 동안 꽃잎 끝에서 재가 떨어진다
	for k = 1, 4 do
		task.delay(bloom + k * hold / 5, function()
			local a = math.random() * math.pi * 2
			ashPuff(g + Vector3.new(math.cos(a) * R * 0.6, 2, math.sin(a) * R * 0.6), 3, 0.8, -1)
		end)
	end
	task.delay(bloom + hold + 0.1, function()
		-- 시든다: 잿빛으로 어두워지며 처지고 무너진다
		for _, it in ipairs(petals) do
			it.p.Color = ASH_DARK
			fadeOut(it.p, 0.6, { CFrame = it.p.CFrame - Vector3.new(0, 1.5, 0), Size = it.p.Size * Vector3.new(0.6, 1, 0.5) })
			ashPuff(it.p.Position, 4, 1, 2)
		end
		for _, s in ipairs(stamens) do
			fadeOut(s, 0.3)
		end
		fadeOut(core, 0.35, { Size = Vector3.new(R, R, R) })
		Fx.ring(g + Vector3.new(0, 0.4, 0), ASH, 2, R * 2.4, 0.45)
		Fx.ring(g + Vector3.new(0, 0.6, 0), SOUL, 2, R * 1.6, 0.35)
		Fx.flash(g + Vector3.new(0, 3, 0), SOUL, 30, 3, 0.3)
		Fx.sound("heavy", 0.7, 1.2, g)
		shakeNear(g, 1.0, 90)
	end)
end

------------------------------------------------------------------------
-- G 제행무상: 둘레 위로 커다란 모래시계가 내려선다. 모래가 흐르는 동안 재의 비, 다 흐르면 금이 가고 깨진다
------------------------------------------------------------------------
local function hourglass(data: any)
	local at: Vector3 = data.at
	if not near(at, 260) then
		return
	end
	local R = data.radius or 26
	local descend = data.descend or 0.5
	local run = data.run or 2.4
	local crack = data.crack or 0.35
	local g = ground(at)
	local H = 30 -- 모래시계 높이
	local B = 8 -- 둥근 배의 반지름
	local base = g + Vector3.new(0, 12, 0) -- 모래시계 아랫면 (머리 위에 떠 있다)
	local parts: { { p: BasePart, off: Vector3, rot: CFrame? } } = {}
	local function add(p: BasePart, off: Vector3, rot: CFrame?)
		table.insert(parts, { p = p, off = off, rot = rot })
		return p
	end
	-- 나무 틀: 위·아래 판과 기둥 셋
	add(part(Vector3.new(1.2, B * 2.6, B * 2.6), WOOD, Enum.Material.Wood, 0, "cyl"), Vector3.new(0, 0, 0), UP)
	add(part(Vector3.new(1.2, B * 2.6, B * 2.6), WOOD, Enum.Material.Wood, 0, "cyl"), Vector3.new(0, H, 0), UP)
	for k = 0, 2 do
		local a = k / 3 * math.pi * 2
		add(part(Vector3.new(0.9, H, 0.9), WOOD, Enum.Material.Wood), Vector3.new(math.cos(a) * B * 1.15, H / 2, math.sin(a) * B * 1.15))
	end
	-- 유리 배 둘 (위아래로 좁아지는 둥근 조각들)
	local glass: { BasePart } = {}
	for half = 0, 1 do
		for k = 0, 5 do
			local u = (k + 0.5) / 6
			local rr = B * math.sin(math.pi * (0.12 + u * 0.88))
			local y = half == 0 and (0.6 + u * (H / 2 - 0.6)) or (H - 0.6 - u * (H / 2 - 0.6))
			local p = add(part(Vector3.new(H / 12 + 0.2, rr * 2, rr * 2), Color3.fromRGB(200, 225, 240), Enum.Material.Glass, 0.7, "cyl"), Vector3.new(0, y, 0), UP)
			table.insert(glass, p)
		end
	end
	-- 모래: 위 더미 (줄어든다) · 흐르는 줄기 · 아래 더미 (늘어난다)
	local topSand = add(part(Vector3.new(1, B * 1.6, B * 1.6), SAND, Enum.Material.Sand, 0, "cyl"), Vector3.new(0, H * 0.7, 0), UP)
	local stream = add(part(Vector3.new(0.35, H / 2, 0.35), SAND, Enum.Material.Sand, 0), Vector3.new(0, H / 4, 0))
	local pile = add(part(Vector3.new(1, 1, 1), SAND, Enum.Material.Sand, 0, "ball"), Vector3.new(0, 0.6, 0))
	local function place(origin: Vector3)
		for _, it in ipairs(parts) do
			if it.p.Parent then
				it.p.CFrame = CFrame.new(origin + it.off) * (it.rot or CFrame.new())
			end
		end
	end
	place(base + Vector3.new(0, 40, 0))
	-- 땅: 모래빛 원과 둘레의 재 비
	local floor = part(Vector3.new(0.2, 2, 2), SAND, Enum.Material.Sand, 0.55, "cyl")
	floor.CFrame = CFrame.new(g + Vector3.new(0, 0.1, 0)) * UP
	tween(floor, descend + 0.3, { Size = Vector3.new(0.2, R * 2, R * 2) })
	local rainHolder = part(Vector3.new(R * 1.6, 1, R * 1.6), ASH, Enum.Material.SmoothPlastic, 1)
	rainHolder.CFrame = CFrame.new(g + Vector3.new(0, 18, 0))
	local rain = Instance.new("ParticleEmitter")
	rain.Texture = TEX_SPARK
	rain.Shape = Enum.ParticleEmitterShape.Box
	rain.EmissionDirection = Enum.NormalId.Bottom
	rain.Color = ColorSequence.new(ASH, ASH_DARK)
	rain.LightEmission = 0.2
	rain.Rate = 70
	rain.Lifetime = NumberRange.new(1.2, 1.8)
	rain.Speed = NumberRange.new(10, 14)
	rain.Size = NumberSequence.new(0.35, 0.1)
	rain.Transparency = NumberSequence.new(0.2, 1)
	rain.Enabled = false
	rain.Parent = rainHolder
	local t0 = os.clock()
	local conn: RBXScriptConnection
	conn = RunService.Heartbeat:Connect(function()
		local t = os.clock() - t0
		local d = math.clamp(t / descend, 0, 1)
		local y = 40 * (1 - d) ^ 3
		place(base + Vector3.new(0, y, 0))
		local u = math.clamp((t - descend) / run, 0, 1)
		topSand.Size = Vector3.new(math.max(0.05, H * 0.36 * (1 - u)), B * 1.6 * (1 - u * 0.6), B * 1.6 * (1 - u * 0.6))
		pile.Size = Vector3.new(B * 1.8, math.max(0.5, H * 0.32 * u), B * 1.8) * Vector3.new(0.3 + 0.7 * u, 1, 0.3 + 0.7 * u)
		stream.Transparency = (u > 0 and u < 1) and 0 or 1
		rain.Enabled = t > descend and u < 1
		if t > descend + run + crack then
			conn:Disconnect()
		end
	end)
	task.delay(descend, function()
		Fx.ring(g + Vector3.new(0, 0.3, 0), SAND, 4, R * 2.2, 0.6)
		Fx.sound("heavy", 0.8, 0.6, g)
		shakeNear(g, 1.4, 140)
	end)
	-- 다 흐르면 유리에 금이 가고, 깨진다
	task.delay(descend + run, function()
		for _, gp in ipairs(glass) do
			gp.Color = Color3.fromRGB(230, 245, 255)
		end
		local mid = base + Vector3.new(0, H / 2, 0)
		for k = 0, 3 do
			local a = k / 4 * math.pi * 2
			crackLines(mid + Vector3.new(math.cos(a) * B * 0.8, (k - 1.5) * 4, math.sin(a) * B * 0.8), 3, 5, crack, WHITE, Vector3.new(math.cos(a), 0, math.sin(a)))
		end
		Fx.sound("deflect", 0.8, 0.6, mid)
	end)
	task.delay(descend + run + crack, function()
		local mid = base + Vector3.new(0, H / 2, 0)
		for _, it in ipairs(parts) do
			if it.p.Parent then
				local d = (it.p.Position - mid)
				local dir = d.Magnitude > 0.1 and d.Unit or Vector3.new(0, 1, 0)
				fadeOut(it.p, 0.7, { CFrame = it.p.CFrame + dir * 14 + Vector3.new(0, -6, 0) })
			end
		end
		shards(mid, 30, 3, Color3.fromRGB(220, 240, 255))
		-- 모래 폭풍: 겹친 고리와 흙먼지
		for k = 0, 2 do
			task.delay(k * 0.08, function()
				Fx.ring(g + Vector3.new(0, 0.5 + k * 1.5, 0), k == 1 and ASH or SAND, 4, R * 2.4 + k * 8, 0.7)
			end)
		end
		Fx.burst("dust", g + Vector3.new(0, 1, 0), SAND, 30, 2.4)
		Fx.burst("smoke", mid, ASH, 16, 3)
		Fx.flash(mid, WHITE, 90, 6, 0.5)
		Fx.sound("shatter", 1, 0.7, mid)
		Fx.sound("heavy", 1, 0.5, g)
		shakeNear(g, 2.6, 160)
		rain.Enabled = false
		fadeOut(floor, 0.8)
		task.delay(1.5, function()
			rainHolder:Destroy()
		end)
	end)
end

------------------------------------------------------------------------
-- X 경화수월: 빛깔이 빠지고, 둘레에 거울 열둘이 솟는다. 발밑은 물처럼 비치는 바닥, 하늘엔 창백한 달과 바닥에 비친 달.
-- 거울 속 잿빛 내가 튀어나와 적을 치고 다른 거울로 돌아가기를 거듭하다, 거울마다 금이 가고 한가운데로 깨져 쏟아진다
------------------------------------------------------------------------
local GLASS = Color3.fromRGB(200, 222, 236)
type Ghost = { parts: { BasePart }, rel: { CFrame }, cf: CFrame }
type Mirror = { at: Vector3, R: number, panels: { BasePart }, extras: { BasePart }, model: Model?, cc: ColorCorrectionEffect?, done: boolean, ghosts: { Ghost } }
local mirrors: { [number]: Mirror } = {}
local function ghostOf(model: Model, cf: CFrame): Ghost
	local list = statueOf(model, cf)
	local rel: { CFrame } = {}
	for i, q in ipairs(list) do
		q.Material = Enum.Material.Glass
		q.Color = GLASS:Lerp(SOUL, math.random() * 0.3)
		q.Transparency = 1
		q.Reflectance = 0.3
		rel[i] = cf:ToObjectSpace(q.CFrame)
	end
	return { parts = list, rel = rel, cf = cf }
end
local function ghostMove(gh: Ghost, cf: CFrame)
	gh.cf = cf
	for i, q in ipairs(gh.parts) do
		if q.Parent then
			q.CFrame = cf * gh.rel[i]
		end
	end
end
local function ghostAlpha(gh: Ghost, a: number, time: number)
	for _, q in ipairs(gh.parts) do
		if q.Parent then
			tween(q, time, { Transparency = a })
		end
	end
end
local function mirrorEnd(mr: Mirror)
	if mr.done then
		return
	end
	mr.done = true
	for _, gh in ipairs(mr.ghosts) do
		for _, q in ipairs(gh.parts) do
			if q.Parent then
				fadeOut(q, 0.2)
			end
		end
	end
	for _, q in ipairs(mr.panels) do
		if q.Parent then
			fadeOut(q, 0.3)
		end
	end
	for _, q in ipairs(mr.extras) do
		if q.Parent then
			fadeOut(q, 0.6)
		end
	end
	local cc = mr.cc
	if cc then
		tween(cc, 0.9, { Saturation = 0, Brightness = 0, Contrast = 0, TintColor = WHITE })
		task.delay(1, function()
			cc:Destroy()
		end)
	end
end
local function mirrorOpen(data: any)
	local at: Vector3 = data.at
	if not near(at, 320) then
		return
	end
	local R = data.radius or 36
	local cut = data.cut or 1.4
	local rise = data.rise or 0.5
	local echo = data.echo or 1.6
	local crack = data.crack or 0.5
	local g = ground(at)
	local mr: Mirror = { at = g, R = R, panels = {}, extras = {}, model = data.m, cc = nil, done = false, ghosts = {} }
	mirrors[data.id] = mr
	if near(at, R * 2.5) then
		local cc = Instance.new("ColorCorrectionEffect")
		cc.Name = "KwonMujoGrade"
		cc.Parent = Lighting
		tween(cc, 0.6, { Saturation = -1, Brightness = -0.06, Contrast = 0.15, TintColor = Color3.fromRGB(225, 236, 255) })
		mr.cc = cc
	end
	-- 물처럼 비치는 바닥 (컷씬 동안 천천히 번진다)
	local floor = part(Vector3.new(0.2, 4, 4), GLASS, Enum.Material.Glass, 0.55, "cyl")
	floor.Reflectance = 0.6
	floor.CFrame = CFrame.new(g + Vector3.new(0, 0.12, 0)) * UP
	tween(floor, cut + rise, { Size = Vector3.new(0.2, R * 2, R * 2) })
	table.insert(mr.extras, floor)
	-- 하늘의 달과 바닥에 비친 달 (경화수월: 거울 속 꽃, 물 속 달)
	local moonPos = g + Vector3.new(0, 46, 0) + flat(Vector3.new(math.random() - 0.5, 0, math.random() - 0.5)) * 10
	local moon = part(Vector3.new(9, 9, 9), Color3.fromRGB(236, 242, 255), Enum.Material.Neon, 1, "ball")
	moon.CFrame = CFrame.new(moonPos)
	tween(moon, cut, { Transparency = 0.1 })
	table.insert(mr.extras, moon)
	local halo = part(Vector3.new(0.2, 18, 18), SOUL, Enum.Material.Neon, 1, "cyl")
	halo.CFrame = CFrame.lookAt(moonPos, at) * CFrame.Angles(0, math.rad(90), 0)
	tween(halo, cut, { Transparency = 0.85 })
	table.insert(mr.extras, halo)
	local water = part(Vector3.new(0.1, 8, 8), Color3.fromRGB(236, 242, 255), Enum.Material.Neon, 1, "cyl")
	water.CFrame = CFrame.new(Vector3.new(moonPos.X, g.Y + 0.2, moonPos.Z)) * UP
	tween(water, cut, { Transparency = 0.35 })
	table.insert(mr.extras, water)
	-- 물결 (컷씬 동안 바닥에 동심원)
	for k = 0, 3 do
		task.delay(k * cut / 4, function()
			Fx.ring(g + Vector3.new(0, 0.3, 0), GLASS, 0.6, R * 2, 0.9)
		end)
	end
	Fx.sound("ping", 0.5, 0.5, at)
	-- 거울 열둘이 둘레에서 솟는다 (가운데를 바라본다)
	local n = 12
	for i = 1, n do
		local a = (i - 1) / n * math.pi * 2
		local pos = g + Vector3.new(math.cos(a) * R * 0.85, 0, math.sin(a) * R * 0.85)
		local face = CFrame.lookAt(pos, Vector3.new(g.X, pos.Y, g.Z))
		local h, w = 13, 7
		local glass = part(Vector3.new(w, h, 0.3), GLASS, Enum.Material.Glass, 0.3)
		glass.Reflectance = 0.75
		local frame = part(Vector3.new(w + 1, h + 1, 0.2), ASH_DARK, Enum.Material.Slate, 0)
		local top = face * CFrame.new(0, h / 2 + 0.5, 0)
		local downCF = face * CFrame.new(0, -h / 2 - 1, 0)
		glass.CFrame = downCF
		frame.CFrame = downCF * CFrame.new(0, 0, 0.3)
		table.insert(mr.panels, glass)
		table.insert(mr.extras, frame)
		task.delay(cut + (i % 4) * rise * 0.12, function()
			if mr.done then
				return
			end
			tween(glass, rise * 0.6, { CFrame = top }, Enum.EasingStyle.Back)
			tween(frame, rise * 0.6, { CFrame = top * CFrame.new(0, 0, 0.3) }, Enum.EasingStyle.Back)
			ashPuff(pos, 3, 1, 2)
		end)
	end
	task.delay(cut, function()
		Fx.sound("heavy", 0.6, 1.4, at)
		shakeNear(g, 1.2, 160)
	end)
	-- 금이 간다: 거울마다 넋빛 금이 번진다
	task.delay(cut + rise + echo, function()
		if mr.done then
			return
		end
		for i, q in ipairs(mr.panels) do
			task.delay((i % 6) * crack * 0.08, function()
				if q.Parent then
					crackLines(q.Position, 5, 6, crack, SOUL, q.CFrame.LookVector)
					tween(q, crack * 0.5, { Transparency = 0.15 })
				end
			end)
		end
		crackLines(g + Vector3.new(0, 0.3, 0), 10, R * 0.8, crack + 0.2, SOUL)
		if water.Parent then
			crackLines(water.Position + Vector3.new(0, 0.1, 0), 5, 5, crack, WHITE)
		end
		Fx.sound("deflect", 0.8, 0.6, at)
		shakeNear(g, 0.8, 160)
	end)
	-- 깨진다: 거울 조각이 모두 한가운데로 쏟아져 들어가 터진다
	task.delay(cut + rise + echo + crack, function()
		if mr.done then
			return
		end
		local mid = g + Vector3.new(0, 4, 0)
		for _, q in ipairs(mr.panels) do
			local from = q.Position
			for _ = 1, 6 do
				local s = part(Vector3.new(1.8, 0.12, 1.4) * (0.6 + math.random() * 0.8), GLASS, Enum.Material.Glass, 0.15, "wedge")
				s.Reflectance = 0.6
				s.CFrame = CFrame.new(from + Vector3.new((math.random() - 0.5) * 6, (math.random() - 0.5) * 10, (math.random() - 0.5) * 2)) * CFrame.Angles(math.random() * 6, math.random() * 6, 0)
				local land = mid + Vector3.new((math.random() - 0.5) * 3, (math.random() - 0.5) * 3, (math.random() - 0.5) * 3)
				tween(s, 0.28, { CFrame = CFrame.new(land) * CFrame.Angles(math.random() * 9, math.random() * 9, 0) }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
				task.delay(0.3, function()
					s:Destroy()
				end)
			end
		end
		for _, q in ipairs(mr.panels) do
			q:Destroy()
		end
		table.clear(mr.panels)
		Fx.sound("shatter", 1, 0.8, at)
		task.delay(0.3, function()
			for k = 0, 3 do
				task.delay(k * 0.07, function()
					Fx.ring(g + Vector3.new(0, 0.5 + k, 0), k % 2 == 0 and WHITE or SOUL, 4, R * 2.4 + k * 10, 0.8)
				end)
			end
			shards(mid, 30, 2.2, GLASS)
			for _ = 1, 8 do
				local a, rr = math.random() * math.pi * 2, math.sqrt(math.random()) * R
				ashPuff(g + Vector3.new(math.cos(a) * rr, 2 + math.random() * 4, math.sin(a) * rr), 5, 1.5, 6)
			end
			if moon.Parent then
				shards(moon.Position, 14, 1.6, Color3.fromRGB(236, 242, 255))
				moon:Destroy()
			end
			Fx.burst("smoke", mid, ASH, 26, 3.5)
			Fx.flash(mid, WHITE, 140, 9, 0.6)
			Fx.sound("shatter", 1, 0.5, at)
			Fx.sound("heavy", 1, 0.4, at)
			shakeNear(g, 3.2, 220)
			if opts.flash and near(g, R * 2) then
				opts.flash(WHITE, 0.3)
			end
			mirrorEnd(mr)
		end)
	end)
	task.delay(cut + rise + echo + crack + 5, function()
		mirrorEnd(mr)
		mirrors[data.id] = nil
	end)
end
local function mirrorEcho(data: any)
	local mr = mirrors[data.id]
	if not mr or mr.done then
		return
	end
	local model = mr.model
	if not model then
		return
	end
	local every = data.every or 0.25
	local n = data.n or 6
	local targets = data.targets or {}
	local count = math.min(#targets, 6)
	for ti = 1, count do
		local tm: Model? = targets[ti]
		local tr = rootOf(tm)
		if tr then
			local gh = ghostOf(model, CFrame.new(mr.at))
			table.insert(mr.ghosts, gh)
			-- 칠 때마다 다른 거울에서 나온다
			for k = 1, n do
				task.delay((k - 1) * every, function()
					if mr.done or #mr.panels == 0 then
						return
					end
					local panel = mr.panels[((ti * 5 + k * 7) % #mr.panels) + 1]
					local goal = tr.Parent and tr.Position or mr.at + Vector3.new(0, 3, 0)
					local from = panel.Position - Vector3.new(0, 3, 0)
					local dir = flat(goal - from)
					local startCF = CFrame.lookAt(from, from + dir)
					ghostMove(gh, startCF)
					ghostAlpha(gh, 0.25, 0.05)
					tween(panel, 0.08, { Transparency = 0.05 })
					task.delay(0.1, function()
						if panel.Parent then
							tween(panel, 0.15, { Transparency = 0.3 })
						end
					end)
					local hitPos = goal - dir * 2.5
					local endCF = CFrame.lookAt(hitPos, hitPos + dir)
					local t0 = os.clock()
					local last = from + Vector3.new(0, 1, 0)
					local conn: RBXScriptConnection
					conn = RunService.Heartbeat:Connect(function()
						local u = math.clamp((os.clock() - t0) / (every * 0.45), 0, 1)
						local e = 1 - (1 - u) * (1 - u)
						local cf = startCF:Lerp(endCF, e)
						ghostMove(gh, cf)
						local p = cf.Position + Vector3.new(0, 1, 0)
						if (p - last).Magnitude > 1.5 then
							local trl = beam(last, p, 0.5, GLASS, 0.5, Enum.Material.Glass)
							fadeOut(trl, 0.25, { Size = Vector3.new(0.05, 0.05, trl.Size.Z) })
							last = p
						end
						if u >= 1 or mr.done then
							conn:Disconnect()
							if mr.done then
								return
							end
							shards(goal, 4, 0.7, GLASS)
							crackLines(goal, 3, 2, 0.12, SOUL, -dir)
							ghostAlpha(gh, 1, every * 0.4)
						end
					end)
					if ti == 1 then
						Fx.sound("swing", 0.45, 1.1 + k * 0.05, goal)
					end
				end)
			end
		end
	end
end

local HANDLERS: { [string]: (any) -> () } = {
	ashStatues = ashStatues,
	witherBloom = witherBloom,
	hourglass = hourglass,
	mirrorOpen = mirrorOpen,
	mirrorEcho = mirrorEcho,
}
function Mujo.handles(data: any): boolean
	return HANDLERS[data.kind] ~= nil or (data.kind == "pulse" and data.fx == "ashCrack")
end
function Mujo.run(data: any)
	if data.kind == "pulse" then
		ashCrack(data)
		return
	end
	local fn = HANDLERS[data.kind]
	if fn then
		fn(data)
	end
end

return Mujo
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="35">
          <Properties>
            <string name="Name">Music</string>
            <string name="Source"><![CDATA[-- 권왕: 배경 음악. 있는 곳에 따라 바꾸고, 바뀔 때 천천히 겹쳐 넘긴다 (Config.MUSIC의 번호가 0이면 조용하다)
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local SoundService = game:GetService("SoundService")
local TweenService = game:GetService("TweenService")

local Config = require(ReplicatedStorage:WaitForChild("Config"))

local Music = {}
local current: Sound? = nil
local currentKey = ""
local muted = false

local function idOf(key: string): number
	local id = tonumber(Config.MUSIC[key]) or 0
	if id == 0 and key ~= "default" then
		return tonumber(Config.MUSIC.default) or 0
	end
	return id
end

-- key: village / default / boss / tower / 지역 id (snow, cult ...)
function Music.set(key: string)
	local id = idOf(key)
	local resolved = id == 0 and "" or tostring(id)
	if resolved == currentKey then
		return
	end
	currentKey = resolved
	local old = current
	current = nil
	if old then
		local o = old
		TweenService:Create(o, TweenInfo.new(1.5), { Volume = 0 }):Play()
		task.delay(1.6, function()
			o:Destroy()
		end)
	end
	if id == 0 then
		return
	end
	local s = Instance.new("Sound")
	s.Name = "KwonMusic"
	s.SoundId = "rbxassetid://" .. id
	s.Looped = true
	s.Volume = 0
	s.Parent = SoundService
	s:Play()
	current = s
	TweenService:Create(s, TweenInfo.new(2), { Volume = muted and 0 or Config.MUSIC.volume }):Play()
end

function Music.toggleMute(): boolean
	muted = not muted
	if current then
		current.Volume = muted and 0 or Config.MUSIC.volume
	end
	return muted
end

return Music
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="36">
          <Properties>
            <string name="Name">Null</string>
            <string name="Source"><![CDATA[-- 권왕 3.8판: 공백권 (화면). 지워진 것, 있어서는 안 되는 빈칸
-- 빛깔은 검정·흰색, 가끔 번쩍이는 붉은빛과 '빠진 무늬' (자홍·검정 바둑판). 움직임은 부드럽지 않고 끊긴다 (지직)
local Lighting = game:GetService("Lighting")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local Fx = require(script.Parent:WaitForChild("Fx"))

local Null = {}

local BLACK = Color3.fromRGB(14, 14, 18)
local WHITE = Color3.fromRGB(240, 240, 245)
local RED = Color3.fromRGB(230, 40, 60)
local CYAN = Color3.fromRGB(60, 230, 240)
local MAGENTA = Color3.fromRGB(255, 0, 220)
local UP = CFrame.Angles(0, 0, math.rad(90))
local player = Players.LocalPlayer

local folder = Instance.new("Folder")
folder.Name = "KwonNull"
folder.Parent = workspace

local opts: any = {}
function Null.init(o: any)
	opts = o or {}
end

local function part(size: Vector3, color: Color3, material: Enum.Material?, alpha: number?): Part
	local q = Instance.new("Part")
	q.Anchored = true
	q.CanCollide = false
	q.CanQuery = false
	q.CanTouch = false
	q.CastShadow = false
	q.Size = size
	q.Color = color
	q.Material = material or Enum.Material.SmoothPlastic
	q.Transparency = alpha or 0
	q.Parent = folder
	return q
end
local function tween(inst: Instance, time: number, goal: { [string]: any }, style: Enum.EasingStyle?, dir: Enum.EasingDirection?)
	local tw = TweenService:Create(inst, TweenInfo.new(math.max(0.01, time), style or Enum.EasingStyle.Quad, dir or Enum.EasingDirection.Out), goal)
	tw:Play()
	return tw
end
local function fadeOut(p: BasePart, time: number, goal: { [string]: any }?)
	local g = goal or {}
	g.Transparency = 1
	tween(p, time, g)
	task.delay(time + 0.05, function()
		p:Destroy()
	end)
end
local function near(pos: Vector3, d: number): boolean
	local cam = workspace.CurrentCamera
	return cam ~= nil and (cam.CFrame.Position - pos).Magnitude < d
end
local function rootOf(m: Instance?): BasePart?
	local r = m and m:FindFirstChild("HumanoidRootPart")
	return (r and r:IsA("BasePart")) and r or nil
end
local function flat(v: Vector3): Vector3
	local f = Vector3.new(v.X, 0, v.Z)
	return f.Magnitude > 1e-3 and f.Unit or Vector3.new(0, 0, -1)
end
local function ground(at: Vector3): Vector3
	return Vector3.new(at.X, at.Y - 2.7, at.Z)
end
local function shakeNear(pos: Vector3, amount: number, range: number)
	if opts.shake and near(pos, range) then
		opts.shake(amount)
	end
end
-- 화소 조각: 검정·흰색·가끔 자홍의 작은 정육면체가 튄다 (돌지 않고 곧게, 끊기듯)
local function pixels(at: Vector3, n: number, s: number, spread: number?)
	for k = 1, n do
		local c = (k % 7 == 0) and MAGENTA or ((k % 2 == 0) and BLACK or WHITE)
		local q = part(Vector3.one * (0.4 + math.random() * 0.5) * s, c, c == WHITE and Enum.Material.Neon or Enum.Material.SmoothPlastic, 0)
		q.CFrame = CFrame.new(at + Vector3.new(math.random() - 0.5, math.random() - 0.5, math.random() - 0.5) * 2 * s)
		local d = Vector3.new(math.random() - 0.5, math.random() * 0.7, math.random() - 0.5).Unit * (spread or 6) * s * (0.5 + math.random())
		fadeOut(q, 0.5 + math.random() * 0.4, { CFrame = CFrame.new(q.Position + d) })
	end
end
-- 찢어진 화면 줄 (가로로 길고 얇은 붉은·푸른 빛줄이 잠깐)
local function tear(at: Vector3, len: number, life: number)
	for k, c in ipairs({ RED, CYAN, WHITE }) do
		local q = part(Vector3.new(len, 0.12, 0.05), c, Enum.Material.Neon, 0.1)
		q.CFrame = CFrame.lookAt(at + Vector3.new(0, (k - 2) * 0.35, 0), at + Vector3.new(0, (k - 2) * 0.35, 0) + (workspace.CurrentCamera and workspace.CurrentCamera.CFrame.LookVector or Vector3.new(0, 0, -1))) * CFrame.new((k - 2) * 0.4, 0, 0)
		task.delay(life, function()
			q:Destroy()
		end)
	end
end
-- 상자 테두리 (모서리 열둘)
local function boxEdges(cf: CFrame, size: Vector3, color: Color3, w: number): { BasePart }
	local out: { BasePart } = {}
	local hx, hy, hz = size.X / 2, size.Y / 2, size.Z / 2
	for _, sy in ipairs({ -1, 1 }) do
		for _, sz in ipairs({ -1, 1 }) do
			local q = part(Vector3.new(size.X, w, w), color, Enum.Material.Neon, 0)
			q.CFrame = cf * CFrame.new(0, sy * hy, sz * hz)
			table.insert(out, q)
		end
		for _, sx in ipairs({ -1, 1 }) do
			local q = part(Vector3.new(w, w, size.Z), color, Enum.Material.Neon, 0)
			q.CFrame = cf * CFrame.new(sx * hx, sy * hy, 0)
			table.insert(out, q)
		end
	end
	for _, sx in ipairs({ -1, 1 }) do
		for _, sz in ipairs({ -1, 1 }) do
			local q = part(Vector3.new(w, size.Y, w), color, Enum.Material.Neon, 0)
			q.CFrame = cf * CFrame.new(sx * hx, 0, sz * hz)
			table.insert(out, q)
		end
	end
	return out
end
-- 빠진 무늬 상자 (작은 상자 여덟)
local function missingCube(cf: CFrame, s: number): { BasePart }
	local out: { BasePart } = {}
	for x = 0, 1 do
		for y = 0, 1 do
			for z = 0, 1 do
				local q = part(Vector3.one * s, ((x + y + z) % 2 == 0) and MAGENTA or BLACK, Enum.Material.SmoothPlastic, 0)
				q.CFrame = cf * CFrame.new((x - 0.5) * s, (y - 0.5) * s, (z - 0.5) * s)
				table.insert(out, q)
			end
		end
	end
	return out
end
local function moveCube(list: { BasePart }, cf: CFrame, s: number)
	local i = 0
	for x = 0, 1 do
		for y = 0, 1 do
			for z = 0, 1 do
				i += 1
				local q = list[i]
				if q and q.Parent then
					q.CFrame = cf * CFrame.new((x - 0.5) * s, (y - 0.5) * s, (z - 0.5) * s)
				end
			end
		end
	end
end
-- 빛깔 빼기 (가까울 때만, 내 화면에서)
local function gradeTo(cc: ColorCorrectionEffect?, time: number, goal: { [string]: any }): ColorCorrectionEffect
	local c = cc
	if not c then
		local nc = Instance.new("ColorCorrectionEffect")
		nc.Name = "KwonNullGrade"
		nc.Parent = Lighting
		c = nc
	end
	tween(c :: ColorCorrectionEffect, time, goal)
	return c :: ColorCorrectionEffect
end
local function gradeEnd(cc: ColorCorrectionEffect?, time: number)
	if cc then
		tween(cc, time, { Saturation = 0, Contrast = 0, Brightness = 0, TintColor = Color3.new(1, 1, 1) })
		task.delay(time + 0.1, function()
			cc:Destroy()
		end)
	end
end
-- 화면 잡음 (가로 줄들이 지직거리고 null 글자가 번쩍인다). 내 화면에서만
local function screenGlitch(dur: number, strength: number)
	local pg = player and player:FindFirstChild("PlayerGui")
	if not pg then
		return
	end
	local g = Instance.new("ScreenGui")
	g.Name = "KwonNullGlitch"
	g.IgnoreGuiInset = true
	g.ResetOnSpawn = false
	g.DisplayOrder = 86
	g.Parent = pg
	local bars: { Frame } = {}
	for k = 1, math.floor(8 * strength) do
		local b = Instance.new("Frame")
		b.BorderSizePixel = 0
		b.BackgroundColor3 = k % 3 == 0 and RED or (k % 3 == 1 and BLACK or WHITE)
		b.BackgroundTransparency = 0.3
		b.Visible = false
		b.Parent = g
		bars[k] = b
	end
	local words: { TextLabel } = {}
	for k, c in ipairs({ RED, CYAN, WHITE }) do
		local t = Instance.new("TextLabel")
		t.BackgroundTransparency = 1
		t.Size = UDim2.fromScale(0.4, 0.16)
		t.AnchorPoint = Vector2.new(0.5, 0.5)
		t.Font = Enum.Font.Code
		t.TextScaled = true
		t.Text = "null"
		t.TextColor3 = c
		t.TextTransparency = 1
		t.ZIndex = 2 + k
		t.Parent = g
		words[k] = t
	end
	local t0 = os.clock()
	local nextAt = 0
	local conn: RBXScriptConnection
	conn = RunService.RenderStepped:Connect(function()
		local t = os.clock() - t0
		if t > dur then
			conn:Disconnect()
			g:Destroy()
			return
		end
		if t < nextAt then
			return
		end
		nextAt = t + 0.04 + math.random() * 0.08
		for _, b in ipairs(bars) do
			b.Visible = math.random() < 0.6
			b.Position = UDim2.fromScale(math.random() * 0.3 - 0.1, math.random())
			b.Size = UDim2.new(0.5 + math.random() * 0.8, 0, 0, 2 + math.random() * 14)
		end
		local show = math.random() < 0.35
		local cx, cy = 0.3 + math.random() * 0.4, 0.3 + math.random() * 0.4
		for k, w in ipairs(words) do
			w.TextTransparency = show and 0.1 or 1
			w.Position = UDim2.fromScale(cx + (k - 2) * 0.006, cy + (k - 2) * 0.004)
		end
	end)
end
local function glitchNear(at: Vector3, range: number, dur: number, strength: number)
	if near(at, range) then
		screenGlitch(dur, strength)
	end
end

------------------------------------------------------------------------
-- 차림: 몸 둘레의 빈칸 상자 셋. 천천히 돌다가 가끔 끊기듯 다른 자리로 튄다. 가끔 붉은 찢어진 줄
------------------------------------------------------------------------
function Null.buildGear(model: Model): { Instance }
	local out: { Instance } = {}
	local holder = Instance.new("Folder")
	holder.Name = "Null_" .. model.Name
	holder.Parent = folder
	table.insert(out, holder)
	local torso = model:FindFirstChild("UpperTorso")
	if not (torso and torso:IsA("BasePart")) then
		return out
	end
	local cubes: { { list: { BasePart }, s: number, phase: number, jump: Vector3, until_: number } } = {}
	for k = 1, 3 do
		local s = 0.32 + (k % 2) * 0.08
		local list = missingCube(CFrame.new(torso.Position), s)
		for _, q in ipairs(list) do
			q.Parent = holder
			table.insert(out, q)
		end
		table.insert(cubes, { list = list, s = s, phase = k * 2.1, jump = Vector3.zero, until_ = 0 })
	end
	local t0 = os.clock()
	local conn: RBXScriptConnection
	conn = RunService.RenderStepped:Connect(function()
		if not holder.Parent or not torso.Parent then
			conn:Disconnect()
			return
		end
		local t = os.clock() - t0
		local hide = model:GetAttribute("Vanish") == true
		for _, c in ipairs(cubes) do
			-- 가끔 (지직) 엉뚱한 자리로 튀었다가 돌아온다
			if t > c.until_ and math.random() < 0.012 then
				c.jump = Vector3.new(math.random() - 0.5, math.random() - 0.5, math.random() - 0.5) * 3
				c.until_ = t + 0.08 + math.random() * 0.1
			elseif t > c.until_ then
				c.jump = Vector3.zero
			end
			local a = t * 0.9 + c.phase
			local cf = torso.CFrame * CFrame.new(math.cos(a) * 2.3, 0.6 + math.sin(t * 1.1 + c.phase) * 0.7, math.sin(a) * 2.3) + c.jump
			-- 돌지 않고 각진 채로 (90도씩 끊어서 돈다)
			local step = math.floor(t * 2 + c.phase) * math.rad(90)
			moveCube(c.list, CFrame.new(cf.Position) * CFrame.Angles(step, step * 0.5, 0), c.s)
			for _, q in ipairs(c.list) do
				q.LocalTransparencyModifier = hide and 1 or 0
			end
		end
	end)
	return out
end

------------------------------------------------------------------------
-- 연타 장치 빈칸: 상대가 검은 네모 칸에 지워졌다가, 깨진 화면처럼 돌아온다
------------------------------------------------------------------------
local function voidCell(data: any)
	local at: Vector3 = data.at
	if not near(at, 200) then
		return
	end
	local delay = data.delay or 0.4
	local size = Vector3.new(5, 6.5, 5)
	local box = part(size, BLACK, Enum.Material.SmoothPlastic, 0.02)
	box.CFrame = CFrame.new(at)
	local edges = boxEdges(CFrame.new(at), size, WHITE, 0.12)
	Fx.sound("ping", 0.4, 2.2, at)
	local t0 = os.clock()
	local conn: RBXScriptConnection
	conn = RunService.Heartbeat:Connect(function()
		local t = os.clock() - t0
		-- 끊기듯 흔들린다
		local j = (math.random() < 0.3) and Vector3.new(math.random() - 0.5, 0, math.random() - 0.5) * 0.8 or Vector3.zero
		box.CFrame = CFrame.new(at + j)
		if t >= delay then
			conn:Disconnect()
			box:Destroy()
			for _, e in ipairs(edges) do
				e:Destroy()
			end
			pixels(at, 18, 1)
			tear(at, 8, 0.12)
			Fx.ring(ground(at) + Vector3.new(0, 0.3, 0), RED, 2, (data.radius or 6) * 2, 0.3)
			Fx.sound("shatter", 0.5, 1.8, at)
		end
	end)
end

------------------------------------------------------------------------
-- E 소거: 흰 선택 상자가 깜박이고, 안이 검게 지워졌다가 화소로 부서진다
------------------------------------------------------------------------
local function eraseBox(data: any)
	local from: Vector3, to: Vector3 = data.from, data.to
	if not near(from, 220) then
		return
	end
	local dir = flat(to - from)
	local L = (Vector3.new(to.X, 0, to.Z) - Vector3.new(from.X, 0, from.Z)).Magnitude
	local W = data.width or 9
	local delay = data.delay or 0.35
	local mid = ground((from + to) / 2)
	local base = CFrame.lookAt(mid, mid + dir)
	-- 바닥의 점선 상자 (선택 영역)
	local dashes: { BasePart } = {}
	local function dashLine(a: Vector3, b: Vector3)
		local n = math.max(2, math.floor((b - a).Magnitude / 2))
		for k = 0, n - 1, 2 do
			local p0, p1 = a:Lerp(b, k / n), a:Lerp(b, (k + 1) / n)
			local q = part(Vector3.new(0.18, 0.08, (p1 - p0).Magnitude), WHITE, Enum.Material.Neon, 0)
			q.CFrame = CFrame.lookAt((p0 + p1) / 2, p1)
			table.insert(dashes, q)
		end
	end
	local c1 = (base * CFrame.new(-W / 2, 0.15, L / 2)).Position
	local c2 = (base * CFrame.new(W / 2, 0.15, L / 2)).Position
	local c3 = (base * CFrame.new(W / 2, 0.15, -L / 2)).Position
	local c4 = (base * CFrame.new(-W / 2, 0.15, -L / 2)).Position
	dashLine(c1, c2)
	dashLine(c2, c3)
	dashLine(c3, c4)
	dashLine(c4, c1)
	-- 깜박임 셋
	for k = 1, 3 do
		task.delay(delay * (k - 0.5) / 3, function()
			for _, q in ipairs(dashes) do
				q.Transparency = 1
			end
			task.wait(0.04)
			for _, q in ipairs(dashes) do
				q.Transparency = 0
			end
		end)
	end
	Fx.sound("block", 0.4, 2, from)
	task.delay(delay, function()
		for _, q in ipairs(dashes) do
			q:Destroy()
		end
		local H = 8
		local vol = part(Vector3.new(W, H, L), BLACK, Enum.Material.SmoothPlastic, 0.04)
		vol.CFrame = base * CFrame.new(0, H / 2, 0)
		local edges = boxEdges(vol.CFrame, vol.Size, WHITE, 0.15)
		tear((from + to) / 2 + Vector3.new(0, 2, 0), L * 0.8, 0.1)
		Fx.sound("ping", 0.6, 2.4, from)
		shakeNear(mid, 1.0, 100)
		task.delay(data.shardAt or 0.25, function()
			-- 부서진다: 상자 부피 곳곳에서 화소 조각
			for k = 0, 7 do
				pixels((base * CFrame.new((math.random() - 0.5) * W, 1 + math.random() * H, (k / 7 - 0.5) * L)).Position, 6, 1.2)
			end
			vol:Destroy()
			for _, e in ipairs(edges) do
				fadeOut(e, 0.15)
			end
			Fx.flash(mid + Vector3.new(0, 3, 0), WHITE, 40, 3, 0.2)
			Fx.sound("shatter", 0.7, 1.5, mid)
		end)
	end)
end

------------------------------------------------------------------------
-- R 끊김: 적 넷 사이를 끊기듯 옮겨 다니며 친다. 자리마다 붉은·푸른으로 어긋난 잔상
------------------------------------------------------------------------
local function ghostAt(model: Model?, cf: CFrame, color: Color3, alpha: number, life: number)
	local r = rootOf(model)
	local body = model
	if not body or not r then
		return
	end
	for _, d in ipairs(body:GetChildren()) do
		if d:IsA("BasePart") and d.Name ~= "HumanoidRootPart" and d.Transparency < 0.9 then
			local q = part(d.Size, color, Enum.Material.SmoothPlastic, alpha)
			q.CFrame = cf * r.CFrame:ToObjectSpace(d.CFrame)
			task.delay(life, function()
				q:Destroy()
			end)
		end
	end
end
local function glitchBlink(data: any)
	local from: Vector3 = data.from
	if not near(from, 220) then
		return
	end
	local m: Model? = data.m
	local targets = data.targets or {}
	local delay = data.delay or 0.08
	local every = data.every or 0.13
	local r0 = rootOf(m)
	if r0 then
		ghostAt(m, r0.CFrame, BLACK, 0.2, 0.25)
	end
	for i, t in ipairs(targets) do
		task.delay(delay + (i - 1) * every, function()
			local tr = rootOf(t)
			if not tr then
				return
			end
			local look = flat(tr.Position - from)
			local cf = CFrame.lookAt(tr.Position - look * 3, tr.Position)
			ghostAt(m, cf * CFrame.new(0.35, 0, 0), RED, 0.55, 0.12)
			ghostAt(m, cf * CFrame.new(-0.35, 0, 0), CYAN, 0.55, 0.12)
			ghostAt(m, cf, BLACK, 0.1, 0.18)
			tear(tr.Position + Vector3.new(0, 1, 0), 6, 0.1)
			pixels(tr.Position, 10, 0.9)
			Fx.sound("ping", 0.4, 2 + i * 0.1, tr.Position)
		end)
	end
	glitchNear(from, 60, delay + #targets * every, 0.6)
end

------------------------------------------------------------------------
-- G 허공 격자: 빛깔이 빠지고 흰 격자의 검은 허공, 붉은 null 글자가 떠다니다 한 점으로 오그라든 뒤 흰 잡음으로
------------------------------------------------------------------------
local function voidGrid(data: any)
	local at: Vector3 = data.at
	if not near(at, 260) then
		return
	end
	local R = data.radius or 26
	local delay = data.delay or 0.35
	local dur = data.dur or 2.6
	local collapse = data.collapse or 0.35
	local g = ground(at)
	local parts: { BasePart } = {}
	local floor = part(Vector3.new(0.2, 1, 1), BLACK, Enum.Material.SmoothPlastic, 0.05)
	floor.Shape = Enum.PartType.Cylinder
	floor.CFrame = CFrame.new(g + Vector3.new(0, 0.12, 0)) * UP
	tween(floor, delay, { Size = Vector3.new(0.2, R * 2, R * 2) })
	table.insert(parts, floor)
	local n = math.floor(R / 4)
	for k = -n, n do
		local len = 2 * math.sqrt(math.max(0, R * R - (k * 4) ^ 2))
		local a = part(Vector3.new(len, 0.06, 0.14), WHITE, Enum.Material.Neon, 1)
		a.CFrame = CFrame.new(g + Vector3.new(0, 0.25, k * 4))
		local b = part(Vector3.new(0.14, 0.06, len), WHITE, Enum.Material.Neon, 1)
		b.CFrame = CFrame.new(g + Vector3.new(k * 4, 0.25, 0))
		task.delay(delay * (0.3 + math.abs(k) / n * 0.7), function()
			a.Transparency = 0.35
			b.Transparency = 0.35
		end)
		table.insert(parts, a)
		table.insert(parts, b)
	end
	-- 떠다니는 붉은 null 글자 (머리 위 판)
	local words: { { p: BasePart, a: number, r: number, h: number } } = {}
	for k = 1, 7 do
		local holder = part(Vector3.new(0.2, 0.2, 0.2), RED, Enum.Material.Neon, 1)
		local bb = Instance.new("BillboardGui")
		bb.Size = UDim2.fromScale(7, 2.4)
		bb.AlwaysOnTop = false
		bb.LightInfluence = 0
		bb.Parent = holder
		local tl = Instance.new("TextLabel")
		tl.BackgroundTransparency = 1
		tl.Size = UDim2.fromScale(1, 1)
		tl.Font = Enum.Font.Code
		tl.TextScaled = true
		tl.Text = (k % 3 == 0) and "ERROR" or "null"
		tl.TextColor3 = RED
		tl.Parent = bb
		table.insert(words, { p = holder, a = k / 7 * math.pi * 2, r = R * (0.5 + (k % 3) * 0.15), h = 4 + (k % 4) * 2 })
		table.insert(parts, holder)
	end
	local cc: ColorCorrectionEffect? = nil
	if near(at, R * 2.5) then
		cc = gradeTo(nil, 0.3, { Saturation = -1, Contrast = 0.25, Brightness = -0.03 })
	end
	local t0 = os.clock()
	local conn: RBXScriptConnection
	conn = RunService.Heartbeat:Connect(function()
		local t = os.clock() - t0
		local u = math.clamp((t - delay) / dur, 0, 1)
		for i, w in ipairs(words) do
			local a = w.a + t * 0.6
			local r = w.r * (1 - u * 0.6)
			local jump = (math.random() < 0.08) and Vector3.new(math.random() - 0.5, 0, math.random() - 0.5) * 4 or Vector3.zero
			w.p.CFrame = CFrame.new(g + Vector3.new(math.cos(a) * r, w.h + math.sin(t * 2 + i), math.sin(a) * r) + jump)
		end
		if math.random() < 0.15 then
			local aa, rr = math.random() * math.pi * 2, math.random() * R
			tear(g + Vector3.new(math.cos(aa) * rr, 1 + math.random() * 5, math.sin(aa) * rr), 4 + math.random() * 6, 0.08)
		end
		if t >= delay + dur then
			conn:Disconnect()
		end
	end)
	Fx.sound("ping", 0.5, 0.6, at)
	-- 오그라든다: 모든 것이 가운데 한 점으로
	task.delay(delay + dur, function()
		local center = g + Vector3.new(0, 2, 0)
		for _, p in ipairs(parts) do
			if p.Parent then
				tween(p, collapse, { CFrame = CFrame.new(center) * p.CFrame.Rotation, Size = p.Size * 0.05 }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
			end
		end
		local dot = part(Vector3.new(2, 2, 2), BLACK, Enum.Material.SmoothPlastic, 0)
		dot.CFrame = CFrame.new(center)
		tween(dot, collapse, { Size = Vector3.new(0.3, 0.3, 0.3) }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
		task.delay(collapse, function()
			for _, p in ipairs(parts) do
				if p.Parent then
					p:Destroy()
				end
			end
			dot:Destroy()
			-- 흰 잡음으로 터진다
			pixels(center, 40, 2.4, 9)
			local flash = part(Vector3.new(4, 4, 4), WHITE, Enum.Material.Neon, 0)
			flash.Shape = Enum.PartType.Ball
			flash.CFrame = CFrame.new(center)
			fadeOut(flash, 0.4, { Size = Vector3.new(R * 2, R * 2, R * 2) })
			Fx.ring(g + Vector3.new(0, 0.5, 0), WHITE, 4, R * 2.6, 0.5)
			Fx.ring(g + Vector3.new(0, 0.8, 0), RED, 4, R * 2.2, 0.4)
			Fx.flash(center, WHITE, 90, 7, 0.4)
			Fx.sound("shatter", 0.9, 1.2, center)
			Fx.sound("heavy", 0.8, 0.8, center)
			shakeNear(center, 2.4, 150)
			glitchNear(center, 120, 0.4, 1)
			gradeEnd(cc, 0.5)
		end)
	end)
end

------------------------------------------------------------------------
-- X 존재소거: 화면 균열이 미끄러지고, 빈칸 상자들이 떨어지고, 멈추고 (빛깔이 날아가고), 삑, 화소로 무너진다
------------------------------------------------------------------------
type NullState = { at: Vector3, range: number, cc: ColorCorrectionEffect?, done: boolean, panels: { BasePart } }
local nulls: { [number]: NullState } = {}
local function nullOpen(data: any)
	local at: Vector3 = data.at
	if not near(at, 340) then
		return
	end
	local range = data.range or 40
	local cut = data.cut or 1.4
	local rain = data.rain or 2.0
	local freeze = data.freeze or 0.5
	local g = ground(at)
	local st: NullState = { at = g, range = range, cc = nil, done = false, panels = {} }
	nulls[data.id] = st
	if near(at, range * 2.5) then
		st.cc = gradeTo(nil, 0.4, { Saturation = -0.85, Contrast = 0.2 })
	end
	-- 하늘에서 땅까지 검은 화면 균열 판들이 미끄러진다
	task.delay(cut, function()
		for k = 1, 8 do
			local a = k / 8 * math.pi * 2
			local p = part(Vector3.new(0.3, 60, 3 + (k % 3) * 2), BLACK, Enum.Material.SmoothPlastic, 0.05)
			local c0 = g + Vector3.new(math.cos(a) * range * 0.9, 30, math.sin(a) * range * 0.9)
			p.CFrame = CFrame.lookAt(c0, Vector3.new(g.X, c0.Y, g.Z))
			local edge = part(Vector3.new(0.32, 60, 0.15), RED, Enum.Material.Neon, 0.1)
			edge.CFrame = p.CFrame * CFrame.new(0, 0, p.Size.Z / 2)
			table.insert(st.panels, p)
			table.insert(st.panels, edge)
			local side = Vector3.new(-math.sin(a), 0, math.cos(a)) * 14
			tween(p, rain, { CFrame = p.CFrame + side }, Enum.EasingStyle.Linear)
			tween(edge, rain, { CFrame = edge.CFrame + side }, Enum.EasingStyle.Linear)
		end
		shakeNear(g, 1.6, 200)
		Fx.sound("heavy", 0.8, 0.5, g)
	end)
	-- 멈춤: 빛깔이 하얗게 날아간다, 삑
	task.delay(cut + rain, function()
		if st.done then
			return
		end
		if st.cc then
			gradeTo(st.cc, 0.08, { Saturation = -1, Contrast = 1, Brightness = 0.35 })
		end
		Fx.sound("ping", 1, 3, g)
		glitchNear(g, range * 2.5, freeze, 1.4)
	end)
	-- 무너진다
	task.delay(cut + rain + freeze, function()
		if st.done then
			return
		end
		st.done = true
		for _, p in ipairs(st.panels) do
			if p.Parent then
				pixels(p.Position, 6, 1.6)
				p:Destroy()
			end
		end
		for _ = 1, 14 do
			local a, rr = math.random() * math.pi * 2, math.random() * range
			pixels(g + Vector3.new(math.cos(a) * rr, 2 + math.random() * 6, math.sin(a) * rr), 8, 1.6, 8)
		end
		for k = 1, 3 do
			task.delay(k * 0.06, function()
				Fx.ring(g + Vector3.new(0, 0.5 + k, 0), k == 2 and RED or WHITE, 6, range * 2.4 + k * 10, 0.6)
			end)
		end
		Fx.flash(g + Vector3.new(0, 5, 0), WHITE, 150, 9, 0.6)
		Fx.sound("shatter", 1, 0.7, g)
		Fx.sound("heavy", 1, 0.4, g)
		shakeNear(g, 3.4, 220)
		if opts.flash and near(g, 120) then
			opts.flash(WHITE, 0.3)
		end
		gradeEnd(st.cc, 0.6)
		nulls[data.id] = nil
	end)
	task.delay(cut + rain + freeze + 4, function()
		if nulls[data.id] == st then
			nulls[data.id] = nil
			gradeEnd(st.cc, 0.3)
		end
	end)
end
local function nullCubes(data: any)
	local st = nulls[data.id]
	if not st or st.done then
		return
	end
	local fall = data.fall or 0.25
	for _, pt in ipairs(data.pts or {}) do
		local s = 1.6
		local top = pt + Vector3.new((math.random() - 0.5) * 4, 34, (math.random() - 0.5) * 4)
		local list = missingCube(CFrame.new(top), s)
		local t0 = os.clock()
		local conn: RBXScriptConnection
		conn = RunService.Heartbeat:Connect(function()
			local u = math.clamp((os.clock() - t0) / fall, 0, 1)
			-- 떨어지는 것도 끊기듯 (네 칸씩 툭툭)
			local q = math.floor(u * 6) / 6
			moveCube(list, CFrame.new(top:Lerp(pt, q)), s)
			if u >= 1 then
				conn:Disconnect()
				for _, c in ipairs(list) do
					c:Destroy()
				end
				pixels(pt, 10, 1.1)
				Fx.ring(ground(pt) + Vector3.new(0, 0.3, 0), RED, 2, 10, 0.25)
			end
		end)
	end
end

-- 초 오의 컷씬 (쓴 사람 화면에서만): 화면이 깨진다. 카메라가 끊기듯 이리저리 튀며 나를 비추고, 붉고 푸르게 어긋난 null
local cutActive = false
function Null.superCut(model: Model, dur: number, name: string, shake: ((number) -> ())?)
	local cam = workspace.CurrentCamera
	local r = rootOf(model)
	if not cam or not r or cutActive or not player then
		return
	end
	cutActive = true
	screenGlitch(dur, 1.6)
	local pg = player:WaitForChild("PlayerGui")
	local g = Instance.new("ScreenGui")
	g.Name = "KwonNullCut"
	g.IgnoreGuiInset = true
	g.ResetOnSpawn = false
	g.DisplayOrder = 85
	g.Parent = pg
	local tint = Instance.new("Frame")
	tint.Size = UDim2.fromScale(1, 1)
	tint.BackgroundColor3 = BLACK
	tint.BackgroundTransparency = 1
	tint.BorderSizePixel = 0
	tint.Parent = g
	tween(tint, 0.2, { BackgroundTransparency = 0.45 })
	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.AnchorPoint = Vector2.new(1, 1)
	label.Position = UDim2.new(1, -30, 1, -30)
	label.Size = UDim2.new(0.5, 0, 0.1, 0)
	label.Font = Enum.Font.Code
	label.TextScaled = true
	label.TextXAlignment = Enum.TextXAlignment.Right
	label.Text = "초 오의 · " .. name
	label.TextColor3 = WHITE
	label.TextStrokeColor3 = RED
	label.TextStrokeTransparency = 0.2
	label.ZIndex = 5
	label.Parent = g
	local oldType = cam.CameraType
	local oldFov = cam.FieldOfView
	local look = flat(r.CFrame.LookVector)
	local side = Vector3.new(-look.Z, 0, look.X)
	cam.CameraType = Enum.CameraType.Scriptable
	local t0 = os.clock()
	local focus = r.Position
	local finished = false
	local shot = 0
	local nextCut = 0
	local function restore()
		if finished then
			return
		end
		finished = true
		RunService:UnbindFromRenderStep("KwonNullCut")
		cam.CameraType = oldType == Enum.CameraType.Scriptable and Enum.CameraType.Custom or oldType
		cam.FieldOfView = oldFov
		cutActive = false
		tween(tint, 0.2, { BackgroundTransparency = 1 })
		tween(label, 0.2, { TextTransparency = 1 })
		task.delay(0.25, function()
			g:Destroy()
		end)
	end
	RunService:BindToRenderStep("KwonNullCut", Enum.RenderPriority.Camera.Value + 2, function()
		local t = os.clock() - t0
		-- 몇 장면을 끊어 붙인다 (부드럽게 움직이지 않는다)
		if t >= nextCut then
			shot += 1
			nextCut = t + 0.18 + math.random() * 0.22
		end
		local k = shot % 4
		local eye: Vector3
		if k == 0 then
			eye = focus + look * 7 + Vector3.new(0, 1.2, 0)
		elseif k == 1 then
			eye = focus + side * 8 + Vector3.new(0, 3, 0)
		elseif k == 2 then
			eye = focus + look * 3 + Vector3.new(0, 0.4, 0) - side * 2
		else
			eye = focus + look * 14 + Vector3.new(0, 9, 0)
		end
		cam.CFrame = CFrame.lookAt(eye, focus + Vector3.new(0, 1.5, 0)) * CFrame.Angles(0, 0, (shot % 2 == 0) and 0.04 or -0.04)
		cam.FieldOfView = oldFov + (k == 2 and 20 or 4)
		if t >= dur then
			restore()
		end
	end)
	if shake then
		task.delay(dur * 0.5, function()
			shake(0.8)
		end)
	end
	task.delay(dur + 1, restore)
end

local HANDLERS: { [string]: (any) -> () } = {
	eraseBox = eraseBox,
	glitchBlink = glitchBlink,
	voidGrid = voidGrid,
	nullOpen = nullOpen,
	nullCubes = nullCubes,
}
function Null.handles(data: any): boolean
	return HANDLERS[data.kind] ~= nil or (data.kind == "pulse" and data.fx == "voidCell")
end
function Null.run(data: any)
	if data.kind == "pulse" then
		voidCell(data)
		return
	end
	local fn = HANDLERS[data.kind]
	if fn then
		fn(data)
	end
end

return Null
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="37">
          <Properties>
            <string name="Name">Plum</string>
            <string name="Source"><![CDATA[-- 권왕 2.9판: 진 매화난무권 (설중매) 의 기술 (화면). 눈 속에 피는 붉은 매화
-- 매화는 둥근 꽃잎 다섯 (가운데로 오목하게 겹친다), 노란 꽃술, 흰 꽃눈으로 짓는다. 가지는 짙은 밤빛으로 꺾이며 가늘어진다
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local Config = require(ReplicatedStorage:WaitForChild("Config"))
local Fx = require(script.Parent:WaitForChild("Fx"))

local Plum = {}

local folder = Instance.new("Folder")
folder.Name = "KwonPlum"
folder.Parent = workspace

local opts: any = {}
function Plum.init(o: any)
	opts = o or {}
end

local REDS = { Color3.fromRGB(215, 30, 60), Color3.fromRGB(190, 20, 50), Color3.fromRGB(235, 70, 95) }
local STAMEN = Color3.fromRGB(255, 214, 90)
local BARK = Color3.fromRGB(58, 34, 30)
local SNOW = Color3.fromRGB(245, 250, 255)
local WHITE = Color3.new(1, 1, 1)
local UPRIGHT = CFrame.Angles(0, 0, math.rad(90))

local function tween(inst: Instance, time: number, goal: { [string]: any }, style: Enum.EasingStyle?, dir: Enum.EasingDirection?)
	local tw = TweenService:Create(inst, TweenInfo.new(math.max(0.01, time), style or Enum.EasingStyle.Quad, dir or Enum.EasingDirection.Out), goal)
	tw:Play()
	return tw
end
local function near(pos: Vector3, d: number): boolean
	local cam = workspace.CurrentCamera
	return cam ~= nil and (cam.CFrame.Position - pos).Magnitude < d
end
local function ground(at: Vector3): Vector3
	return Vector3.new(at.X, at.Y - 2.7, at.Z)
end
local function part(size: Vector3, color: Color3, material: Enum.Material?, alpha: number?, shape: string?): BasePart
	local q = Instance.new("Part")
	if shape == "ball" then
		q.Shape = Enum.PartType.Ball
	elseif shape == "cyl" then
		q.Shape = Enum.PartType.Cylinder
	end
	q.Anchored = true
	q.CanCollide = false
	q.CanQuery = false
	q.CanTouch = false
	q.CastShadow = false
	q.Size = size
	q.Color = color
	q.Material = material or Enum.Material.SmoothPlastic
	q.Transparency = alpha or 0
	q.Parent = folder
	return q
end
local function fadeOut(p: BasePart, time: number, goal: { [string]: any }?)
	local g = goal or {}
	g.Transparency = 1
	tween(p, time, g)
	task.delay(time + 0.05, function()
		p:Destroy()
	end)
end
local function shakeNear(pos: Vector3, amount: number, range: number)
	if opts.shake and near(pos, range) then
		opts.shake(amount)
	end
end
-- 프레임마다 u (0 → 1)
local function anim(life: number, fn: (number) -> ())
	local t0 = os.clock()
	local conn: RBXScriptConnection
	conn = RunService.Heartbeat:Connect(function()
		local u = math.clamp((os.clock() - t0) / life, 0, 1)
		fn(u)
		if u >= 1 then
			conn:Disconnect()
		end
	end)
end

------------------------------------------------------------------------
-- 매화 한 송이: cf의 위(Y)가 꽃이 보는 쪽. size = 꽃의 지름
------------------------------------------------------------------------
type Flower = { parts: { BasePart }, place: (CFrame, number) -> () }
local function flower(size: number, color: Color3?): Flower
	local list: { BasePart } = {}
	local petals: { BasePart } = {}
	local c = color or REDS[math.random(1, 3)]
	for i = 1, 5 do
		local p = part(Vector3.one, i % 2 == 0 and c or c:Lerp(WHITE, 0.08), Enum.Material.SmoothPlastic, 0, "ball")
		petals[i] = p
		table.insert(list, p)
	end
	local heart = part(Vector3.one, WHITE, Enum.Material.SmoothPlastic, 0, "ball")
	table.insert(list, heart)
	local stamens: { BasePart } = {}
	for i = 1, 6 do
		local s = part(Vector3.one * 0.1, STAMEN, Enum.Material.Neon, 0, "ball")
		stamens[i] = s
		table.insert(list, s)
	end
	local function place(cf: CFrame, k: number)
		local D = math.max(0.05, size * k)
		for i, p in ipairs(petals) do
			local a = i / 5 * math.pi * 2
			p.Size = Vector3.new(D * 0.5, D * 0.12, D * 0.5)
			-- 꽃잎은 바깥으로 놓이고 가장자리가 살짝 위로 오므라든다
			p.CFrame = cf * CFrame.Angles(0, a, 0) * CFrame.new(0, D * 0.04, -D * 0.27) * CFrame.Angles(math.rad(14), 0, 0)
		end
		heart.Size = Vector3.new(D * 0.26, D * 0.12, D * 0.26)
		heart.CFrame = cf * CFrame.new(0, D * 0.08, 0)
		for i, s in ipairs(stamens) do
			local a = i / 6 * math.pi * 2
			s.Size = Vector3.one * math.max(0.05, D * 0.07)
			s.CFrame = cf * CFrame.new(math.cos(a) * D * 0.12, D * 0.2, math.sin(a) * D * 0.12)
		end
	end
	return { parts = list, place = place }
end
local function fadeFlower(fl: Flower, time: number)
	for _, p in ipairs(fl.parts) do
		fadeOut(p, time)
	end
end
-- 꽃잎 하나가 흩날린다 (빙글 돌며 떨어진다)
local function petalFly(at: Vector3, size: number, life: number, push: Vector3)
	local p = part(Vector3.new(size, size * 0.15, size * 0.8), REDS[math.random(1, 3)], Enum.Material.SmoothPlastic, 0, "ball")
	local spin = Vector3.new(math.random() * 6, math.random() * 6, math.random() * 6)
	local ph = math.random() * 6
	anim(life, function(u)
		local t = u * life
		local pos = at + push * t + Vector3.new(math.sin(t * 4 + ph) * 0.8, -4 * t * t, math.cos(t * 3 + ph) * 0.8)
		p.CFrame = CFrame.new(pos) * CFrame.Angles(spin.X * t, spin.Y * t, spin.Z * t)
		p.Transparency = u > 0.7 and (u - 0.7) / 0.3 or 0
		if u >= 1 then
			p:Destroy()
		end
	end)
end
-- 눈송이 한 줌이 피어오른다
local function snowPuff(at: Vector3, r: number)
	for _ = 1, 10 do
		local s = part(Vector3.one * (0.3 + math.random() * 0.4) * r / 4, SNOW, Enum.Material.Snow, 0.05, "ball")
		local d = Vector3.new(math.random() - 0.5, math.random() * 0.6, math.random() - 0.5).Unit
		s.Position = at
		fadeOut(s, 0.6 + math.random() * 0.3, { Position = at + d * r * (0.6 + math.random() * 0.5), Size = s.Size * 1.8 })
	end
	Fx.burst("glitter", at, SNOW, 8, r / 6)
end
-- 가지 한 마디 (a → b), 굵기 w. 자라는 동안 u (0 → 1)
local function branchSeg(a: Vector3, b: Vector3, w: number): (number) -> ()
	local p = part(Vector3.new(0.05, w, w), BARK, Enum.Material.Wood, 0, "cyl")
	local snowCap = part(Vector3.new(0.05, w * 0.6, w * 1.1), SNOW, Enum.Material.Snow, 0.05)
	return function(u: number)
		local e = a:Lerp(b, u)
		local len = math.max(0.05, (e - a).Magnitude)
		local mid = (a + e) / 2
		local dir = (b - a).Unit
		p.Size = Vector3.new(len, w, w)
		p.CFrame = CFrame.lookAt(mid, mid + dir) * CFrame.Angles(0, math.rad(90), 0)
		snowCap.Size = Vector3.new(w * 1.1, w * 0.35, len * 0.9)
		snowCap.CFrame = CFrame.lookAt(mid, mid + dir) * CFrame.new(0, w * 0.45, 0)
		if u >= 1 then
			task.delay(1.2, function()
				fadeOut(p, 0.5)
				fadeOut(snowCap, 0.5)
			end)
		end
	end
end

------------------------------------------------------------------------
-- 설중매 (권법 장치): 발밑에서 짧은 가지 셋이 뻗고 꽃이 피었다가 터진다
------------------------------------------------------------------------
local function plumPulse(data: any)
	local at: Vector3 = data.at
	if not near(at, 200) then
		return
	end
	local g = ground(at) + Vector3.new(0, 0.2, 0)
	local delay = data.delay or 0.35
	local r = data.radius or 10
	local flowers: { Flower } = {}
	for k = 0, 2 do
		local a = k / 3 * math.pi * 2 + math.random()
		local tip = g + Vector3.new(math.cos(a) * r * 0.45, 0.4, math.sin(a) * r * 0.45)
		local grow = branchSeg(g, tip, 0.35)
		local fl = flower(2.2)
		table.insert(flowers, fl)
		anim(delay * 0.7, function(u)
			grow(u)
			fl.place(CFrame.new(tip + Vector3.new(0, 0.3, 0)), math.max(0, (u - 0.5) * 2))
		end)
	end
	task.delay(delay, function()
		for _, fl in ipairs(flowers) do
			local c = fl.parts[1].CFrame.Position
			for _ = 1, 4 do
				petalFly(c, 0.6, 0.9, Vector3.new(math.random() - 0.5, 1.5, math.random() - 0.5) * 5)
			end
			fadeFlower(fl, 0.25)
		end
		snowPuff(g + Vector3.new(0, 1, 0), r * 0.7)
		Fx.ring(g + Vector3.new(0, 0.3, 0), REDS[1], 2, r * 2, 0.4)
		Fx.breakSound("whoosh", 0.6, 1.2, g)
	end)
end

------------------------------------------------------------------------
-- 설중매 (E): 땅을 따라 매화 가지가 꺾이며 뻗고, 마디마다 꽃이 핀다. 잠시 뒤 모두 터진다
------------------------------------------------------------------------
local function plumBranch(data: any)
	local nodes: { Vector3 } = data.nodes or {}
	local from: Vector3 = data.from
	if #nodes == 0 or not near(from, 260) then
		return
	end
	local delay, step = data.delay or 0.15, data.step or 0.08
	local prev = ground(from) + Vector3.new(0, 0.3, 0)
	local flowers: { Flower } = {}
	for i, n in ipairs(nodes) do
		local pt = ground(n) + Vector3.new(0, 0.3, 0)
		local a = prev
		local w = 0.7 - i * 0.06
		task.delay(delay + (i - 1) * step, function()
			local grow = branchSeg(a, pt, w)
			local fl = flower(2.6 - i * 0.12)
			table.insert(flowers, fl)
			-- 곁가지 하나와 그 끝의 작은 꽃봉오리
			local side = Vector3.new(math.random() - 0.5, 0, math.random() - 0.5).Unit * 2.2
			local twig = branchSeg(pt, pt + side + Vector3.new(0, 0.6, 0), 0.22)
			local bud = flower(1.0)
			table.insert(flowers, bud)
			anim(step * 2.2, function(u)
				grow(u)
				twig(u)
				fl.place(CFrame.new(pt + Vector3.new(0, 0.5, 0)) * CFrame.Angles(math.rad(-15), i, 0), math.clamp((u - 0.3) / 0.7, 0, 1))
				bud.place(CFrame.new(pt + side + Vector3.new(0, 0.9, 0)), math.clamp((u - 0.5) * 2, 0, 1))
			end)
			Fx.burst("glitter", pt + Vector3.new(0, 0.6, 0), SNOW, 4, 0.8)
		end)
		prev = pt
	end
	local tBurst = delay + (#nodes - 1) * step + (data.burstAt or 0.45)
	task.delay(tBurst, function()
		for _, fl in ipairs(flowers) do
			local c = fl.parts[1].CFrame.Position
			for _ = 1, 3 do
				petalFly(c, 0.7, 1.0, Vector3.new(math.random() - 0.5, 1.6, math.random() - 0.5) * 6)
			end
			fadeFlower(fl, 0.2)
		end
		for _, n in ipairs(nodes) do
			snowPuff(ground(n) + Vector3.new(0, 1, 0), 5)
		end
		Fx.breakSound("whoosh", 0.9, 1.0, ground(nodes[#nodes]))
		shakeNear(from, 0.5, 80)
	end)
end

------------------------------------------------------------------------
-- 한매오판 (R): 둘레 다섯 곳에 큰 매화가 천천히 돌며 피었다가 눈보라와 함께 터진다
------------------------------------------------------------------------
local function plumRing(data: any)
	local at: Vector3 = data.at
	local spots: { Vector3 } = data.spots or {}
	if not near(at, 260) then
		return
	end
	local delay, hold = data.delay or 0.3, data.hold or 0.6
	Fx.ring(ground(at) + Vector3.new(0, 0.3, 0), SNOW, 2, 30, 0.6)
	for i, s in ipairs(spots) do
		local g = ground(s) + Vector3.new(0, 0.4, 0)
		local fl = flower(6.5, REDS[(i % 3) + 1])
		local stem = branchSeg(g - Vector3.new(0, 0.2, 0), g + Vector3.new(0, 1.4, 0), 0.6)
		anim(delay + hold, function(u)
			local t = u * (delay + hold)
			local open = math.clamp(t / delay, 0, 1)
			stem(math.min(1, open * 1.5))
			fl.place(CFrame.new(g + Vector3.new(0, 1.6, 0)) * CFrame.Angles(0, t * 1.5, 0), open * (1 + 0.06 * math.sin(t * 12)))
		end)
		task.delay(delay + hold, function()
			local c = g + Vector3.new(0, 1.6, 0)
			for _ = 1, 8 do
				petalFly(c, 1.0, 1.2, Vector3.new(math.random() - 0.5, 1.2, math.random() - 0.5) * 9)
			end
			fadeFlower(fl, 0.2)
			snowPuff(c, 8)
			Fx.ring(g, REDS[1], 2, 14, 0.4)
		end)
	end
	task.delay(delay + hold, function()
		Fx.breakSound("whoosh", 1, 0.9, at)
		shakeNear(at, 0.9, 90)
	end)
end

------------------------------------------------------------------------
-- 설중매화 (오의): 둘레에 함박눈과 붉은 꽃잎이 휘몰아치고, 땅이 하얗게 덮인다.
-- 끝에 하늘에 거대한 매화가 피어나 꽃잎이 비처럼 쏟아진다
------------------------------------------------------------------------
local function plumSnow(data: any)
	local at: Vector3 = data.at
	if not near(at, 320) then
		return
	end
	local R = data.radius or 24
	local delay, dur = data.delay or 0.3, data.dur or 2
	local g = ground(at)
	local cover = part(Vector3.new(0.2, 2, 2), SNOW, Enum.Material.Snow, 0.15, "cyl")
	cover.CFrame = CFrame.new(g + Vector3.new(0, 0.1, 0)) * UPRIGHT
	tween(cover, delay + dur * 0.6, { Size = Vector3.new(0.2, R * 2, R * 2) })
	if opts.tint then
		opts.tint(Color3.fromRGB(235, 240, 255), 0.25, delay + dur + 0.6)
	end
	-- 휘몰아치는 꽃잎 고리 (둘레를 돈다)
	local swirl: { BasePart } = {}
	for i = 1, 28 do
		swirl[i] = part(Vector3.new(0.9, 0.12, 0.7), REDS[(i % 3) + 1], Enum.Material.SmoothPlastic, 0, "ball")
	end
	anim(delay + dur, function(u)
		local t = u * (delay + dur)
		for i, p in ipairs(swirl) do
			local a = i / #swirl * math.pi * 2 + t * (2.4 + (i % 3) * 0.4)
			local r = R * (0.35 + 0.55 * ((i * 0.37) % 1))
			local y = 1 + ((i * 0.61 + t * 0.8) % 1) * 9
			p.CFrame = CFrame.new(g + Vector3.new(math.cos(a) * r, y, math.sin(a) * r)) * CFrame.Angles(t * 5 + i, t * 3, i)
			p.Transparency = u > 0.9 and (u - 0.9) / 0.1 or 0
		end
		if u >= 1 then
			for _, p in ipairs(swirl) do
				p:Destroy()
			end
		end
	end)
	-- 함박눈
	local n = math.floor((delay + dur) / 0.05)
	for k = 0, n - 1 do
		task.delay(k * 0.05, function()
			for _ = 1, 3 do
				local a, r = math.random() * math.pi * 2, math.sqrt(math.random()) * R
				local top = g + Vector3.new(math.cos(a) * r, 24, math.sin(a) * r)
				local s = part(Vector3.one * (0.3 + math.random() * 0.35), SNOW, Enum.Material.Snow, 0.05, "ball")
				s.Position = top
				fadeOut(s, 1.4, { Position = top - Vector3.new(math.random() * 3 - 1.5, 23, math.random() * 3 - 1.5) })
			end
		end)
	end
	-- 하늘의 거대한 매화
	local sky = g + Vector3.new(0, 30, 0)
	local big = flower(R * 0.9, REDS[1])
	task.delay(delay + dur * 0.4, function()
		anim(dur * 0.6, function(u)
			big.place(CFrame.new(sky) * CFrame.Angles(math.rad(180), u * 1.2, 0), u)
		end)
		Fx.flash(sky, REDS[1], 60, 3, dur * 0.6)
	end)
	task.delay(delay + dur, function()
		-- 꽃잎 비
		for k = 0, 59 do
			task.delay(k * 0.012, function()
				local a, r = math.random() * math.pi * 2, math.random() * R * 0.9
				petalFly(sky + Vector3.new(math.cos(a) * r, -2, math.sin(a) * r), 1.3, 1.4, Vector3.new(math.cos(a), -6, math.sin(a)) * 3)
			end)
		end
		fadeFlower(big, 0.6)
		fadeOut(cover, 1.2)
		snowPuff(g + Vector3.new(0, 2, 0), R * 0.6)
		Fx.ring(g + Vector3.new(0, 0.4, 0), REDS[1], 4, R * 2.4, 0.6)
		Fx.ring(g + Vector3.new(0, 0.5, 0), SNOW, 2, R * 1.6, 0.5)
		Fx.flash(g, REDS[2], R * 3, 5, 0.5)
		Fx.breakSound("boom", 1, 0.9, g)
		shakeNear(at, 1.6, 140)
	end)
end

local HANDLERS: { [string]: (any) -> () } = {
	plumPulse = plumPulse,
	plumBranch = plumBranch,
	plumRing = plumRing,
	plumSnow = plumSnow,
}
function Plum.handles(data: any): boolean
	return HANDLERS[data.kind] ~= nil
end
function Plum.run(data: any)
	local fn = HANDLERS[data.kind]
	if fn then
		fn(data)
	end
end
-- 렌더 확인용
Plum._flower = flower
local _ = Config
return Plum
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="38">
          <Properties>
            <string name="Name">Polish</string>
            <string name="Source"><![CDATA[-- 권왕 1.7: 모든 권법의 기술 연출 보완 (수치는 그대로, 보이는 것만)
-- 권법마다 '속성의 서명'을 하나씩 둔다: 불은 불씨와 불혀, 물은 물방울 왕관, 번개는 잔 번개, 바람은 휘감는 바람결 …
--   (1.8판: 기술을 쓸 때 몸 앞에 피던 서명은 뺐다. 모든 기술이 비슷해 보였다. 쓸 때의 모양은 SkillFx가 기술마다 다르게)
--   · 기술로 맞힐 때마다 맞은 자리에 서명이 터진다 (타격 연출이 비어 있던 불·바다·일월·바람·취권은 평타에도)
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local Config = require(ReplicatedStorage:WaitForChild("Config"))
local Fx = require(script.Parent:WaitForChild("Fx"))

local Polish = {}

local folder = Instance.new("Folder")
folder.Name = "KwonPolish"
folder.Parent = workspace

local WHITE = Color3.new(1, 1, 1)
local live = 0
local MAX_LIVE = 500 -- 한꺼번에 떠 있는 조각 한도 (넘으면 새 서명은 줄여서)

local function tween(inst: Instance, time: number, goal: { [string]: any }, style: Enum.EasingStyle?, dir: Enum.EasingDirection?)
	TweenService:Create(inst, TweenInfo.new(time, style or Enum.EasingStyle.Quad, dir or Enum.EasingDirection.Out), goal):Play()
end
local function near(pos: Vector3, d: number): boolean
	local cam = workspace.CurrentCamera
	return cam ~= nil and (cam.CFrame.Position - pos).Magnitude < d
end
local function bit(size: Vector3, color: Color3, mat: Enum.Material?, alpha: number?, ball: boolean?, life: number?): Part
	local p = Instance.new("Part")
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	p.Size = size
	p.Color = color
	p.Material = mat or Enum.Material.Neon
	p.Transparency = alpha or 0
	if ball then
		local m = Instance.new("SpecialMesh")
		m.MeshType = Enum.MeshType.Sphere
		m.Parent = p
	end
	p.Parent = folder
	live += 1
	local l = life or 0.6
	task.delay(l + 0.05, function()
		live -= 1
		p:Destroy()
	end)
	return p
end
local function rnd(a: number, b: number): number
	return a + math.random() * (b - a)
end
local function randDir(upBias: number?): Vector3
	local v = Vector3.new(rnd(-1, 1), rnd(-0.3, 1) + (upBias or 0), rnd(-1, 1))
	return v.Magnitude > 0.01 and v.Unit or Vector3.new(0, 1, 0)
end

------------------------------------------------------------------------
-- 속성마다의 서명 (pos = 피어나는 자리, look = 앞 방향, s = 크기)
------------------------------------------------------------------------
local SIG: { [string]: (Vector3, Vector3, number, Color3, Color3) -> () } = {}

-- 불: 위로 튀는 불씨와, 사방으로 날름거리는 불혀
SIG.fire = function(pos, look, s, c, c2)
	Fx.burst("ember", pos, Color3.fromRGB(255, 150, 50), math.floor(10 * s), s)
	for k = 0, 5 do
		local d = (look * 0.6 + randDir(0.4)).Unit
		local t = bit(Vector3.new(0.5, 0.5, 2.2) * s, k % 2 == 0 and Color3.fromRGB(255, 120, 30) or Color3.fromRGB(255, 210, 90), Enum.Material.Neon, 0.1, false, 0.3)
		t.CFrame = CFrame.lookAt(pos, pos + d)
		tween(t, 0.28, { CFrame = CFrame.lookAt(pos + d * 4 * s, pos + d * 5 * s), Size = Vector3.new(0.1, 0.1, 3.6) * s, Transparency = 1 })
	end
	Fx.flash(pos, Color3.fromRGB(255, 140, 50), 16 * s, 2.5, 0.3)
end
-- 물: 물방울 왕관 (솟았다 떨어지는 물기둥 여덟 줄기)과 물결 고리
SIG.water = function(pos, look, s, c, c2)
	Fx.ring(pos - Vector3.new(0, 1.5, 0), c2, 1, 10 * s, 0.4)
	for k = 0, 7 do
		local a = k / 8 * math.pi * 2
		local d = Vector3.new(math.cos(a), 0, math.sin(a))
		local drop = bit(Vector3.new(0.45, 0.45, 0.45) * s, k % 2 == 0 and c2 or WHITE, Enum.Material.Glass, 0.15, true, 0.5)
		drop.Position = pos
		tween(drop, 0.22, { Position = pos + d * 2.4 * s + Vector3.new(0, 2.6 * s, 0) }, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
		task.delay(0.22, function()
			tween(drop, 0.25, { Position = pos + d * 3.6 * s - Vector3.new(0, 1.5, 0), Transparency = 1 }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
		end)
	end
end
SIG.ocean = function(pos, look, s, c, c2)
	SIG.water(pos, look, s, c, c2)
	-- 흰 물보라 띠가 앞으로 휘어 나간다
	for i = -3, 3 do
		local a = i / 3 * 0.9
		local d = (CFrame.lookAt(Vector3.zero, look) * CFrame.Angles(0, a, 0)).LookVector
		local f = bit(Vector3.new(1.2, 0.3, 1.2) * s, WHITE, Enum.Material.SmoothPlastic, 0.2, true, 0.4)
		f.Position = pos
		tween(f, 0.35, { Position = pos + d * 5 * s + Vector3.new(0, 1, 0), Size = Vector3.new(2.6, 0.2, 2.6) * s, Transparency = 1 })
	end
end
-- 번개: 맞은 자리에서 사방으로 튀는 잔 번개
SIG.lightning = function(pos, look, s, c, c2)
	for _ = 1, 3 do
		Fx.lightning(pos, pos + randDir(0.3) * rnd(4, 7) * s, c2, 0.4)
	end
	Fx.flash(pos, c, 18 * s, 3, 0.2)
end
-- 바람: 휘감아 도는 흰 바람결 여섯 줄
SIG.wind = function(pos, look, s, c, c2)
	for k = 0, 5 do
		local a0 = k / 6 * math.pi * 2
		local streak = bit(Vector3.new(0.12, 0.12, 3) * s, k % 2 == 0 and WHITE or c2, Enum.Material.Neon, 0.25, false, 0.4)
		local r = 2.2 * s
		local function at(a: number, y: number): CFrame
			local p = pos + Vector3.new(math.cos(a) * r, y, math.sin(a) * r)
			return CFrame.lookAt(p, p + Vector3.new(-math.sin(a), 0.2, math.cos(a)))
		end
		streak.CFrame = at(a0, -0.6)
		tween(streak, 0.35, { CFrame = at(a0 + 2.4, 1.6 * s), Transparency = 1 })
	end
	Fx.burst("dust", pos - Vector3.new(0, 1.5, 0), Color3.fromRGB(230, 235, 230), math.floor(6 * s), s)
end
-- 공허·아공·중력: 검은 구슬이 안으로 짓눌리며 둘레의 빛이 빨려 든다
local function implode(pos: Vector3, s: number, c: Color3, c2: Color3, dark: Color3)
	local ball = bit(Vector3.one * 4 * s, dark, Enum.Material.Neon, 0.2, true, 0.35)
	ball.Position = pos
	tween(ball, 0.3, { Size = Vector3.one * 0.3, Transparency = 0.6 }, Enum.EasingStyle.Back, Enum.EasingDirection.In)
	for k = 0, 7 do
		local d = randDir(0)
		local st = bit(Vector3.new(0.15, 0.15, 2) * s, k % 2 == 0 and c or c2, Enum.Material.Neon, 0.1, false, 0.3)
		st.CFrame = CFrame.lookAt(pos + d * 5 * s, pos)
		tween(st, 0.25, { CFrame = CFrame.lookAt(pos + d * 0.5, pos), Transparency = 1 }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
	end
end
SIG.void = function(pos, look, s, c, c2)
	implode(pos, s, c, c2, Color3.fromRGB(20, 15, 30))
end
SIG.subspace = function(pos, look, s, c, c2)
	implode(pos, s, c, c2, Color3.fromRGB(40, 10, 70))
	-- 어긋난 공간 조각 (네모가 흩어지며 사라진다)
	for _ = 1, 5 do
		local q = bit(Vector3.one * rnd(0.4, 1) * s, c2, Enum.Material.Glass, 0.3, false, 0.45)
		q.CFrame = CFrame.new(pos + randDir(0) * rnd(1, 3) * s) * CFrame.Angles(rnd(0, 6), rnd(0, 6), 0)
		tween(q, 0.4, { CFrame = q.CFrame * CFrame.new(0, 1, 0) * CFrame.Angles(1, 1, 0), Transparency = 1 })
	end
end
SIG.gravity = function(pos, look, s, c, c2)
	implode(pos, s, c, c2, Color3.fromRGB(30, 20, 50))
	Fx.ring(pos - Vector3.new(0, 1.8, 0), c, 12 * s, 1, 0.3)
end
-- 피: 붉은 안개와 핏방울
SIG.blood = function(pos, look, s, c, c2)
	Fx.burst("smoke", pos, Color3.fromRGB(150, 10, 20), math.floor(5 * s), 0.7 * s)
	for _ = 1, 7 do
		local d = bit(Vector3.one * 0.35 * s, Color3.fromRGB(190, 15, 25), Enum.Material.Neon, 0.1, true, 0.45)
		d.Position = pos
		local v = randDir(0.3) * rnd(2, 5) * s
		tween(d, 0.4, { Position = pos + v - Vector3.new(0, 2, 0), Transparency = 1 }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
	end
end
-- 꽃잎
SIG.petal = function(pos, look, s, c, c2)
	for _ = 1, math.floor(9 * s) do
		local p = bit(Vector3.new(0.7, 0.07, 0.5) * s, math.random() < 0.5 and c or c2, Enum.Material.SmoothPlastic, 0, true, 0.9)
		p.CFrame = CFrame.new(pos) * CFrame.Angles(rnd(0, 6), rnd(0, 6), rnd(0, 6))
		tween(p, 0.85, { CFrame = CFrame.new(pos + randDir(0.2) * rnd(2, 5) * s - Vector3.new(0, 1, 0)) * CFrame.Angles(rnd(0, 12), rnd(0, 12), rnd(0, 12)), Transparency = 1 }, Enum.EasingStyle.Sine)
	end
end
-- 용: 금빛 비늘이 나선으로 솟는다
SIG.dragon = function(pos, look, s, c, c2)
	for k = 0, 9 do
		local a = k / 10 * math.pi * 4
		local sc = bit(Vector3.new(0.7, 0.12, 0.5) * s, k % 2 == 0 and c or c2, Enum.Material.Neon, 0.1, false, 0.5)
		local p0 = pos + Vector3.new(math.cos(a) * 1.4 * s, -1 + k * 0.2, math.sin(a) * 1.4 * s)
		sc.CFrame = CFrame.lookAt(p0, pos)
		tween(sc, 0.45, { CFrame = CFrame.lookAt(p0 + Vector3.new(math.cos(a) * 2, 3 * s, math.sin(a) * 2), pos + Vector3.new(0, 4 * s, 0)), Transparency = 1 })
	end
end
-- 금강: 세로로 선 금빛 광륜
SIG.gold = function(pos, look, s, c, c2)
	local halo = bit(Vector3.new(0.3, 2, 2) * s, c, Enum.Material.Neon, 0.2, false, 0.4)
	halo.Shape = Enum.PartType.Cylinder
	halo.CFrame = CFrame.lookAt(pos, pos + look) * CFrame.Angles(0, math.rad(90), 0)
	tween(halo, 0.35, { Size = Vector3.new(0.1, 9, 9) * s, Transparency = 1 })
	Fx.burst("glitter", pos, c2, math.floor(8 * s), s)
end
-- 그림자: 검은 연기와 흩어지는 그림자 조각
SIG.shadow = function(pos, look, s, c, c2)
	Fx.burst("smoke", pos, Color3.fromRGB(25, 20, 35), math.floor(5 * s), 0.8 * s)
	for _ = 1, 5 do
		local q = bit(Vector3.new(0.9, 0.9, 0.1) * s, Color3.fromRGB(30, 25, 45), Enum.Material.SmoothPlastic, 0.2, false, 0.4)
		q.CFrame = CFrame.new(pos) * CFrame.Angles(rnd(0, 6), rnd(0, 6), 0)
		tween(q, 0.35, { CFrame = CFrame.new(pos + randDir(0) * 3 * s), Transparency = 1 })
	end
end
-- 별 (천상·은하·성하): 반짝 별빛 여섯이 켜졌다 꺼진다
local function stars(pos: Vector3, s: number, c: Color3, c2: Color3)
	for k = 0, 5 do
		local st = bit(Vector3.new(0.2, 1.6, 0.2) * s, k % 2 == 0 and WHITE or c2, Enum.Material.Neon, 0, false, 0.45)
		local at = pos + randDir(0.2) * rnd(1.2, 3.2) * s
		st.CFrame = CFrame.new(at) * CFrame.Angles(0, 0, math.rad(45 * (k % 2)))
		local st2 = bit(Vector3.new(0.2, 1.6, 0.2) * s, k % 2 == 0 and WHITE or c2, Enum.Material.Neon, 0, false, 0.45)
		st2.CFrame = st.CFrame * CFrame.Angles(0, 0, math.rad(90))
		for _, x in ipairs({ st, st2 }) do
			tween(x, 0.4, { Size = Vector3.new(0.05, 0.1, 0.05), Transparency = 1 }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
		end
	end
	Fx.burst("glitter", pos, c, math.floor(6 * s), s)
end
SIG.celestial = function(pos, look, s, c, c2)
	stars(pos, s, c, c2)
end
SIG.galaxy = function(pos, look, s, c, c2)
	stars(pos, s, c, c2)
	Fx.ring(pos, c, 1, 9 * s, 0.4, look)
end
SIG.cosmic = SIG.galaxy
-- 구름: 하얀 구름 뭉치가 부풀며 흩어진다
SIG.cloud = function(pos, look, s, c, c2)
	for _ = 1, 6 do
		local puff = bit(Vector3.one * rnd(1.2, 2.2) * s, Color3.fromRGB(250, 250, 255), Enum.Material.SmoothPlastic, 0.15, true, 0.6)
		puff.Position = pos + randDir(0) * s
		tween(puff, 0.55, { Position = puff.Position + randDir(0.4) * 2.5 * s, Size = puff.Size * 2.2, Transparency = 1 })
	end
end
-- 시간: 시계판 고리와 바늘 둘이 한 바퀴 돈다
SIG.time = function(pos, look, s, c, c2)
	local cf = CFrame.lookAt(pos, pos + look)
	Fx.ring(pos, c, 2 * s, 6 * s, 0.45, look)
	for i, len in ipairs({ 2.2, 1.4 }) do
		local hand = bit(Vector3.new(0.18, len * s, 0.1), i == 1 and c2 or WHITE, Enum.Material.Neon, 0.05, false, 0.45)
		local t0 = os.clock()
		local conn
		conn = RunService.Heartbeat:Connect(function()
			local t = os.clock() - t0
			if t > 0.4 or not hand.Parent then
				conn:Disconnect()
				return
			end
			local a = -t * (i == 1 and 14 or 5)
			hand.CFrame = cf * CFrame.Angles(0, 0, a) * CFrame.new(0, len * s / 2, 0)
			hand.Transparency = t / 0.4
		end)
	end
	for k = 0, 11 do
		local a = k / 12 * math.pi * 2
		local mark = bit(Vector3.new(0.12, 0.4, 0.1) * s, c2, Enum.Material.Neon, 0.1, false, 0.4)
		mark.CFrame = cf * CFrame.Angles(0, 0, a) * CFrame.new(0, 2.6 * s, 0)
		tween(mark, 0.4, { Transparency = 1 })
	end
end
-- 태초: 하얀 빛살 여덟 줄기
SIG.origin = function(pos, look, s, c, c2)
	for k = 0, 7 do
		local a = k / 8 * math.pi * 2
		local d = (CFrame.lookAt(Vector3.zero, look) * CFrame.Angles(0, 0, a)).UpVector
		local ray = bit(Vector3.new(0.18, 0.18, 0.5) * s, k % 2 == 0 and WHITE or c2, Enum.Material.Neon, 0, false, 0.3)
		ray.CFrame = CFrame.lookAt(pos, pos + d)
		tween(ray, 0.25, { CFrame = CFrame.lookAt(pos + d * 2.5 * s, pos + d * 3 * s), Size = Vector3.new(0.05, 0.05, 5 * s), Transparency = 1 })
	end
	Fx.flash(pos, WHITE, 18 * s, 3, 0.25)
end
-- 일월: 검은 해와 금빛 테 (일식의 코로나)
SIG.eclipse = function(pos, look, s, c, c2)
	local disc = bit(Vector3.new(0.2, 3, 3) * s, Color3.fromRGB(15, 10, 20), Enum.Material.SmoothPlastic, 0, false, 0.45)
	disc.Shape = Enum.PartType.Cylinder
	disc.CFrame = CFrame.lookAt(pos, pos + look) * CFrame.Angles(0, math.rad(90), 0)
	local rim = bit(Vector3.new(0.15, 3.6, 3.6) * s, c, Enum.Material.Neon, 0.1, false, 0.45)
	rim.Shape = Enum.PartType.Cylinder
	rim.CFrame = disc.CFrame * CFrame.new(-0.05, 0, 0)
	tween(disc, 0.4, { Size = Vector3.new(0.2, 4.5, 4.5) * s, Transparency = 1 })
	tween(rim, 0.4, { Size = Vector3.new(0.1, 7, 7) * s, Transparency = 1 })
end
-- 결투 (무쌍): 엇갈린 쇳빛 섬광
SIG.duel = function(pos, look, s, c, c2)
	local cf = CFrame.lookAt(pos, pos + look)
	for _, a in ipairs({ math.rad(40), math.rad(-40) }) do
		local l = bit(Vector3.new(0.15, 5 * s, 0.15), WHITE, Enum.Material.Neon, 0, false, 0.25)
		l.CFrame = cf * CFrame.Angles(0, 0, a)
		tween(l, 0.22, { Size = Vector3.new(0.05, 7 * s, 0.05), Transparency = 1 })
	end
	Fx.spark(pos, c, 1.2 * s, 8)
end
-- 삼재: 흙먼지와 작은 충격 고리
SIG.basic = function(pos, look, s, c, c2)
	Fx.burst("dust", pos - Vector3.new(0, 1.5, 0), Color3.fromRGB(200, 185, 160), math.floor(5 * s), s)
	Fx.ring(pos, c, 1, 7 * s, 0.25, look)
end
-- 취권: 술 방울 (초록빛 도는 투명한 알갱이)
SIG.drunk = function(pos, look, s, c, c2)
	for _ = 1, 7 do
		local d = bit(Vector3.one * 0.35 * s, Color3.fromRGB(215, 245, 225), Enum.Material.Glass, 0.25, true, 0.5)
		d.Position = pos
		tween(d, 0.45, { Position = pos + randDir(0.5) * rnd(2, 4) * s - Vector3.new(0, 1.5, 0), Transparency = 1 }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
	end
	Fx.flash(pos, c, 12 * s, 2, 0.2)
end

local function styleOf(id: any): any
	return type(id) == "string" and Config.STYLE_BY_ID[id] or nil
end
local function sig(style: any, pos: Vector3, look: Vector3, s: number)
	if not near(pos, 180) then
		return
	end
	if live > MAX_LIVE then
		s *= 0.5
		if live > MAX_LIVE * 1.4 then
			return
		end
	end
	local fn = SIG[style.fx] or SIG.basic
	fn(pos, look, s, style.color, style.color2)
end

------------------------------------------------------------------------
-- 맞힐 때 (handlers.hit에서): 기술이면 맞은 자리에 서명이 터진다
------------------------------------------------------------------------
local HIT_EMPTY: { [string]: boolean } = { fire = true, ocean = true, eclipse = true, wind = true, drunk = true }
function Polish.hit(styleId: any, pos: Vector3, heavy: boolean, skill: boolean, dir: Vector3?)
	local style = styleOf(styleId)
	if not style or not pos then
		return
	end
	local look = dir or Vector3.new(0, 0, -1)
	if skill then
		sig(style, pos, look, heavy and 1.4 or 1)
	elseif HIT_EMPTY[style.fx] then
		sig(style, pos, look, heavy and 0.9 or 0.6)
	end
end

return Polish
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="39">
          <Properties>
            <string name="Name">Reaper</string>
            <string name="Source"><![CDATA[-- 권왕 1.9판: 초월 권법 초·혈마신수의 화면
-- 오른손에 피처럼 붉은 큰 낫 (자루는 검붉고, 날은 핏빛으로 빛나며 끝에서 피가 떨어진다), 왼손엔 붉은 손톱
-- 몸짓마다 핏빛 초승달이 남고, 오의는 하늘만 한 피의 낫, 초 오의는 붉은 달과 하늘을 가르는 낫질
local Lighting = game:GetService("Lighting")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local Config = require(ReplicatedStorage:WaitForChild("Config"))
local Fx = require(script.Parent:WaitForChild("Fx"))
local Demon = require(script.Parent:WaitForChild("Demon"))

local Reaper = {}
local player = Players.LocalPlayer

local RED = Color3.fromRGB(220, 20, 40)
local BLOOD = Color3.fromRGB(150, 0, 18)
local PALE = Color3.fromRGB(255, 170, 170)
local SHAFT = Color3.fromRGB(38, 10, 14)
local WHITE = Color3.new(1, 1, 1)
local TEX_SPARK = "rbxasset://textures/particles/sparkles_main.dds"

local folder = Instance.new("Folder")
folder.Name = "KwonReaper"
folder.Parent = workspace

local function tween(inst: Instance, time: number, goal: { [string]: any }, style: Enum.EasingStyle?, dir: Enum.EasingDirection?)
	local tw = TweenService:Create(inst, TweenInfo.new(time, style or Enum.EasingStyle.Quad, dir or Enum.EasingDirection.Out), goal)
	tw:Play()
	return tw
end
local function rootOf(m: Instance?): BasePart?
	local r = m and m:FindFirstChild("HumanoidRootPart")
	return (r and r:IsA("BasePart")) and r or nil
end
local function near(pos: Vector3, d: number): boolean
	local cam = workspace.CurrentCamera
	return cam ~= nil and (cam.CFrame.Position - pos).Magnitude < d
end
local function flat(v: Vector3): Vector3
	local f = Vector3.new(v.X, 0, v.Z)
	return f.Magnitude > 1e-3 and f.Unit or Vector3.new(0, 0, -1)
end
local function part(size: Vector3, color: Color3, material: Enum.Material?, alpha: number?, shape: string?): Part
	local p = Instance.new("Part")
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	p.Size = size
	p.Color = color
	p.Material = material or Enum.Material.Neon
	p.Transparency = alpha or 0
	if shape == "ball" then
		p.Shape = Enum.PartType.Ball
	elseif shape == "cyl" then
		p.Shape = Enum.PartType.Cylinder
	end
	p.Parent = folder
	return p
end
local function fadeOut(p: BasePart, time: number, goal: { [string]: any }?)
	local g = goal or {}
	g.Transparency = 1
	tween(p, time, g)
	task.delay(time + 0.05, function()
		p:Destroy()
	end)
end
local function ground(at: Vector3): Vector3
	return Vector3.new(at.X, at.Y - 2.7, at.Z)
end

local opts: any = {}
function Reaper.init(o: any)
	opts = o or {}
end
local function shakeNear(pos: Vector3, amount: number, range: number)
	if opts.shake and near(pos, range) then
		opts.shake(amount)
	end
end

------------------------------------------------------------------------
-- 큰 낫 (오른손). 손 기준: 자루는 주먹을 꿰뚫는 Z 축, +Z 끝에 날, -Z 끝에 붉은 물미
------------------------------------------------------------------------
local function attach(p: BasePart, to: BasePart, cf: CFrame, holder: Instance, list: { Instance })
	p.Massless = true
	p.Anchored = false
	p.CFrame = to.CFrame * cf
	local w = Instance.new("WeldConstraint")
	w.Part0 = to
	w.Part1 = p
	w.Parent = p
	p.Parent = holder
	table.insert(list, p)
end
local AXIS_Z = CFrame.Angles(0, math.rad(90), 0) -- 원기둥의 축(X)을 손의 Z로
local SHAFT_BACK, SHAFT_FRONT = 2.0, 4.6
-- 날 머리를 자루 둘레로 돌린 각도 (1.9.3판: 옆으로 뻗던 날을 90도 돌려, 치켜든 자세에서 날이 앞으로 드리우게)
local HEAD_ROLL = -90
local HEAD = CFrame.Angles(0, 0, math.rad(HEAD_ROLL))
local function buildScythe(hand: BasePart, holder: Instance, list: { Instance })
	local len = SHAFT_BACK + SHAFT_FRONT
	local mid = (SHAFT_FRONT - SHAFT_BACK) / 2
	-- 자루: 검붉은 나무, 붉은 천을 감은 띠 셋
	attach(part(Vector3.new(len, 0.34, 0.34), SHAFT, Enum.Material.Wood, 0, "cyl"), hand, CFrame.new(0, 0, mid) * AXIS_Z, holder, list)
	for _, z in ipairs({ -1.2, 1.6, 3.4 }) do
		attach(part(Vector3.new(0.32, 0.4, 0.4), BLOOD, Enum.Material.Fabric, 0, "cyl"), hand, CFrame.new(0, 0, z) * AXIS_Z, holder, list)
	end
	-- 물미: 붉게 빛나는 뾰족한 끝
	local butt = part(Vector3.new(0.3, 0.3, 0.9), RED, Enum.Material.Neon, 0)
	attach(butt, hand, CFrame.new(0, 0, -SHAFT_BACK - 0.35), holder, list)
	-- 날 머리: 검은 쇠 고리 + 붉은 눈 (빛)
	local head = part(Vector3.new(0.5, 0.55, 0.55), Color3.fromRGB(25, 20, 22), Enum.Material.Metal, 0)
	attach(head, hand, HEAD * CFrame.new(0, 0, SHAFT_FRONT), holder, list)
	local eye = part(Vector3.new(0.28, 0.28, 0.28), RED, Enum.Material.Neon, 0, "ball")
	eye.Name = "ReaperEye"
	attach(eye, hand, HEAD * CFrame.new(0, 0.3, SHAFT_FRONT), holder, list)
	local glow = Instance.new("PointLight")
	glow.Color = RED
	glow.Range = 8
	glow.Brightness = 1.2
	glow.Parent = eye
	-- 날: 자루에서 옆(-X)으로 뻗다가 자루 쪽(-Z)으로 휘어 내려간다. 날 끝으로 갈수록 가늘어진다
	local p = Vector3.new(0, 0, SHAFT_FRONT + 0.15)
	local dir = Vector3.new(-1, 0, 0)
	local n = 8
	for k = 1, n do
		local segLen = 0.85
		local width = 0.95 - (k - 1) * 0.1
		local c = p + dir * (segLen / 2)
		local cf = CFrame.lookAt(c, c + dir, Vector3.new(0, 1, 0))
		-- 등 (검붉은 쇠)과 날 (핏빛으로 빛나는 가장자리)
		attach(part(Vector3.new(width, 0.12, segLen * 1.08), Color3.fromRGB(110, 8, 20), Enum.Material.Metal, 0), hand, HEAD * cf * CFrame.new(-width * 0.15, 0, 0), holder, list)
		local edge = part(Vector3.new(0.14, 0.13, segLen * 1.1), RED, Enum.Material.Neon, 0)
		attach(edge, hand, HEAD * cf * CFrame.new(width * 0.38, 0, 0), holder, list)
		if k == n then
			edge.Name = "ReaperTip"
		end
		p += dir * segLen
		dir = (CFrame.Angles(0, math.rad(-11), 0) * CFrame.new(dir)).Position
		dir = dir.Unit
	end
	-- 머리에서 늘어진 짧은 쇠사슬
	for k = 1, 4 do
		attach(part(Vector3.new(0.22, 0.32, 0.22), Color3.fromRGB(60, 50, 55), Enum.Material.Metal, 0, "ball"), hand, HEAD * CFrame.new(0.15, -0.3 - k * 0.3, SHAFT_FRONT - 0.2), holder, list)
	end
end
-- 왼손: 붉은 손톱 셋
local function buildClaws(hand: BasePart, holder: Instance, list: { Instance })
	for i = -1, 1 do
		local c = part(Vector3.new(0.12, 0.75, 0.12), RED, Enum.Material.Neon, 0.1)
		attach(c, hand, CFrame.new(i * 0.18, -hand.Size.Y / 2 - 0.3, -0.1) * CFrame.Angles(math.rad(-20), 0, math.rad(i * 8)), holder, list)
	end
end

local tips: { [Model]: BasePart } = {}
-- 몸 하나에 낫과 손톱을 만든다 (Sakura가 부채와 같은 자리에서 부른다)
function Reaper.build(model: Model): { Instance }
	local out: { Instance } = {}
	local holder = Instance.new("Folder")
	holder.Name = "Reaper_" .. model.Name
	holder.Parent = folder
	table.insert(out, holder)
	local hand = model:FindFirstChild("RightHand")
	if hand and hand:IsA("BasePart") then
		buildScythe(hand, holder, out)
	end
	local lh = model:FindFirstChild("LeftHand")
	if lh and lh:IsA("BasePart") then
		buildClaws(lh, holder, out)
	end
	for _, p in ipairs(out) do
		if p.Name == "ReaperTip" and p:IsA("BasePart") then
			tips[model] = p
			-- 날 끝에서 피가 똑똑 떨어진다
			local a = Instance.new("Attachment")
			a.Parent = p
			local e = Instance.new("ParticleEmitter")
			e.Texture = TEX_SPARK
			e.Color = ColorSequence.new(RED, BLOOD)
			e.LightEmission = 0.4
			e.Rate = 6
			e.Lifetime = NumberRange.new(0.5, 0.9)
			e.Speed = NumberRange.new(0, 1)
			e.Acceleration = Vector3.new(0, -30, 0)
			e.Size = NumberSequence.new(0.22, 0.05)
			e.Transparency = NumberSequence.new(0, 0.4)
			e.Parent = a
		end
	end
	return out
end
function Reaper.tipOf(model: Model): Vector3?
	local p = tips[model]
	return (p and p.Parent) and p.Position or nil
end
RunService.Heartbeat:Connect(function()
	for m, p in pairs(tips) do
		if not p.Parent or not m.Parent then
			tips[m] = nil
		end
	end
end)

------------------------------------------------------------------------
-- 핏빛 초승달 (몸짓의 궤적): 몸 둘레에 기울어진 호를 조각으로 그린다
------------------------------------------------------------------------
local function crescent(center: CFrame, radius: number, from: number, to: number, thick: number, life: number, color: Color3?, segs: number?)
	local n = segs or math.clamp(math.floor(math.abs(to - from) / 12), 6, 30)
	for i = 0, n - 1 do
		local a0 = math.rad(from + (to - from) * i / n)
		local a1 = math.rad(from + (to - from) * (i + 1) / n)
		local p0 = center * Vector3.new(math.sin(a0) * radius, 0, -math.cos(a0) * radius)
		local p1 = center * Vector3.new(math.sin(a1) * radius, 0, -math.cos(a1) * radius)
		-- 가운데가 가장 두껍고 양 끝이 가늘다
		local u = (i + 0.5) / n
		local w = thick * math.sin(u * math.pi) + 0.08
		local seg = part(Vector3.new(w, 0.12, (p1 - p0).Magnitude * 1.15), (color or RED):Lerp(WHITE, (1 - math.sin(u * math.pi)) * 0.3), Enum.Material.Neon, 0.05)
		seg.CFrame = CFrame.lookAt((p0 + p1) / 2, p1, center.UpVector)
		task.delay(i * 0.006, function()
			fadeOut(seg, life, { Size = Vector3.new(w * 0.3, 0.05, seg.Size.Z) })
		end)
	end
end
-- 그 몸짓의 호: 기울기(tilt, 0 = 수평), 시작·끝 각도
local ARCS: { [string]: { tilt: number, from: number, to: number, at: number, r: number } } = {
	["1"] = { tilt = 55, from = -100, to = 80, at = 0.42, r = 6 },
	["2"] = { tilt = -55, from = 90, to = -90, at = 0.42, r = 6 },
	["3"] = { tilt = 4, from = 0, to = 720, at = 0.2, r = 7.5 },
	["4"] = { tilt = 90, from = -60, to = 120, at = 0.5, r = 7 },
	H = { tilt = 6, from = 0, to = 720, at = 0.3, r = 9 },
	F = { tilt = 90, from = 140, to = -40, at = 0.4, r = 6.5 },
}
function Reaper.cast(styleId: any, slot: any, model: Model, dur: number)
	local st = type(styleId) == "string" and Config.STYLE_BY_ID[styleId] or nil
	if not st or not st.scythe then
		return
	end
	local arc = ARCS[tostring(slot)]
	local r = rootOf(model)
	if not arc or not r or not near(r.Position, 160) then
		return
	end
	task.delay(dur * arc.at, function()
		local rr = rootOf(model)
		if not rr then
			return
		end
		local look = flat(rr.CFrame.LookVector)
		local base = CFrame.lookAt(rr.Position + Vector3.new(0, 0.6, 0), rr.Position + Vector3.new(0, 0.6, 0) + look)
		local cf = base * CFrame.Angles(0, 0, math.rad(arc.tilt))
		local spin = math.abs(arc.to - arc.from) > 360
		crescent(cf, arc.r, arc.from, spin and arc.from + 340 or arc.to, slot == "H" and 1.4 or 1.0, spin and 0.35 or 0.28)
		if spin then
			task.delay(dur * 0.3, function()
				crescent(cf * CFrame.Angles(0, math.rad(20), 0), arc.r * 1.1, arc.from, arc.from + 340, 1.0, 0.3, PALE)
			end)
		end
		Fx.burst("spark", rr.Position + look * 3, RED, 8, 1.1)
		if slot == "H" or slot == 4 or slot == "4" then
			Fx.ring(ground(rr.Position) + look * 3 + Vector3.new(0, 0.3, 0), RED, 2, 16, 0.4)
		end
		Fx.sound("swing", 0.7, 0.75, rr.Position)
	end)
end

------------------------------------------------------------------------
-- 혈사슬: 낫이 사슬을 끌고 날아가 적을 낚아 끌어온다. 끌려오는 동안 사슬이 팽팽하다
------------------------------------------------------------------------
local function chainBetween(a: Vector3, b: Vector3, links: { BasePart })
	local n = #links
	for i, l in ipairs(links) do
		local p = a:Lerp(b, (i - 0.5) / n)
		l.CFrame = CFrame.lookAt(p, b) * CFrame.Angles(0, 0, (i % 2) * math.rad(90))
	end
end
local function reapHook(data: any)
	local m: Model? = data.m
	local r0 = rootOf(m)
	if not r0 then
		return
	end
	local root = r0 :: BasePart
	local targets: { Model } = data.targets or {}
	local delay = data.delay or 0.2
	local pull = data.pull or 0.3
	Fx.sound("deflect", 0.8, 0.6, root.Position)
	for _, t in ipairs(targets) do
		local tr = rootOf(t)
		if tr then
			local troot = tr :: BasePart
			local links: { BasePart } = {}
			for _ = 1, 14 do
				table.insert(links, part(Vector3.new(0.18, 0.4, 0.75), Color3.fromRGB(70, 55, 60), Enum.Material.Metal, 0))
			end
			-- 날아가는 낫 머리
			local hook = part(Vector3.new(0.4, 2.2, 1.6), RED, Enum.Material.Neon, 0)
			local t0 = os.clock()
			local conn: RBXScriptConnection
			conn = RunService.RenderStepped:Connect(function()
				local t = os.clock() - t0
				local hand = m and m:FindFirstChild("RightHand")
				local from = (hand and hand:IsA("BasePart")) and hand.Position or root.Position
				local to = troot.Parent and troot.Position or from
				local reach = math.clamp(t / delay, 0, 1)
				local head = from:Lerp(to, reach)
				if t > delay + pull + 0.15 or not troot.Parent then
					conn:Disconnect()
					for _, l in ipairs(links) do
						fadeOut(l, 0.15)
					end
					fadeOut(hook, 0.15)
					return
				end
				chainBetween(from, head, links)
				hook.CFrame = CFrame.lookAt(head, head + (head - from).Unit) * CFrame.Angles(0, 0, t * 20)
			end)
			task.delay(delay, function()
				if troot.Parent then
					Fx.burst("spark", troot.Position, RED, 14, 1.2)
					local splat = part(Vector3.new(1, 1, 1), BLOOD, Enum.Material.Neon, 0.2, "ball")
					splat.CFrame = CFrame.new(troot.Position)
					fadeOut(splat, 0.3, { Size = Vector3.new(5, 5, 5) })
					Fx.sound("hit", 0.7, 0.8, troot.Position)
				end
			end)
		end
	end
end
-- 한 바퀴 돌며 베기 (혈사슬의 끝)
local function reapSpin(data: any)
	local r = rootOf(data.m)
	if not r then
		return
	end
	local rad = data.radius or 9
	local base = CFrame.new(r.Position + Vector3.new(0, 0.5, 0))
	crescent(base, rad * 0.8, 0, 340, 1.5, 0.35)
	crescent(base * CFrame.Angles(0, math.rad(25), 0), rad * 0.95, 0, 340, 0.9, 0.4, PALE)
	Fx.ring(ground(r.Position) + Vector3.new(0, 0.3, 0), RED, 2, rad * 2.2, 0.45)
	Fx.burst("spark", r.Position, RED, 20, 1.4)
	Fx.sound("swing", 1, 0.6, r.Position)
	shakeNear(r.Position, 0.5, 40)
end

------------------------------------------------------------------------
-- 혈월낙참: 앞의 땅에 새겨지는 핏빛 초승달 자국, 한 박자 뒤 터진다
------------------------------------------------------------------------
local function reapScar(data: any)
	local at: Vector3 = data.at
	local dir: Vector3 = data.dir or Vector3.new(0, 0, -1)
	local len = data.length or 22
	local width = data.width or 8
	local g = ground(at) + Vector3.new(0, 0.15, 0)
	-- 초승달: 길게 휜 호를 땅에 눕힌다
	local base = CFrame.lookAt(g, g + dir) * CFrame.new(0, 0, len * 0.35)
	local segs: { BasePart } = {}
	local n = 16
	local R = len * 0.75
	for i = 0, n - 1 do
		local u0, u1 = i / n, (i + 1) / n
		local a0 = math.rad(-40 + 80 * u0)
		local a1 = math.rad(-40 + 80 * u1)
		local p0 = base * Vector3.new(math.sin(a0) * R, 0, -math.cos(a0) * R + R * 0.7)
		local p1 = base * Vector3.new(math.sin(a1) * R, 0, -math.cos(a1) * R + R * 0.7)
		local w = width * 0.55 * math.sin((u0 + u1) / 2 * math.pi) + 0.3
		local s = part(Vector3.new(w, 0.2, (p1 - p0).Magnitude * 1.1), RED, Enum.Material.Neon, 0.1)
		s.CFrame = CFrame.lookAt((p0 + p1) / 2, p1)
		table.insert(segs, s)
	end
	-- 내리꽂힌 자리 (가운데 앞)
	Fx.ring(g + dir * 2, RED, 2, width * 2.5, 0.4)
	Fx.burst("dust", g + dir * 2 + Vector3.new(0, 0.5, 0), Color3.fromRGB(110, 60, 60), 18, 1.6)
	Fx.debris(g + dir * 2, 5, 20, Color3.fromRGB(90, 50, 50))
	Fx.sound("heavy", 1, 0.7, at)
	shakeNear(at, 1.0, 60)
	task.delay(data.burst or 0.45, function()
		-- 자국을 따라 피의 기둥이 솟는다
		for i, s in ipairs(segs) do
			if i % 2 == 1 then
				local col = part(Vector3.new(14, 1.8, 1.8), RED, Enum.Material.Neon, 0.1, "cyl")
				col.CFrame = CFrame.new(s.Position + Vector3.new(0, 7, 0)) * CFrame.Angles(0, 0, math.rad(90))
				fadeOut(col, 0.45, { Size = Vector3.new(18, 0.3, 0.3) })
			end
			fadeOut(s, 0.5)
		end
		Fx.burst("spark", at + Vector3.new(0, 2, 0), RED, 30, 2)
		Fx.flash(at, RED, 40, 4, 0.5)
		Fx.sound("splash", 0.8, 0.6, at)
		shakeNear(at, 0.8, 60)
	end)
end

------------------------------------------------------------------------
-- 혈마수확: 등 뒤로 하늘만 한 피의 낫이 솟아 둘레를 휩쓴다
------------------------------------------------------------------------
local function bigScythe(scale: number): Model
	local m = Instance.new("Model")
	m.Name = "BloodScythe"
	local function add(p: BasePart, cf: CFrame)
		p.CFrame = cf
		p.Parent = m
	end
	-- 원점 = 자루 아래 끝 (Y 위로 자루, 꼭대기에서 날이 -X로 뻗어 아래로 휜다)
	local h = 30 * scale
	local shaft = part(Vector3.new(h, 1.4 * scale, 1.4 * scale), Color3.fromRGB(60, 0, 10), Enum.Material.Neon, 0.25, "cyl")
	add(shaft, CFrame.new(0, h / 2, 0) * CFrame.Angles(0, 0, math.rad(90)))
	local p = Vector3.new(0, h, 0)
	local dir = Vector3.new(-1, 0.1, 0).Unit
	for k = 1, 10 do
		local segLen = 2.6 * scale
		local width = (3.2 - k * 0.26) * scale
		local c = p + dir * (segLen / 2)
		local cf = CFrame.lookAt(c, c + dir, Vector3.new(0, 0, 1))
		add(part(Vector3.new(width, 0.4 * scale, segLen * 1.1), RED, Enum.Material.Neon, 0.15), cf)
		add(part(Vector3.new(0.4 * scale, 0.45 * scale, segLen * 1.12), WHITE, Enum.Material.Neon, 0.2), cf * CFrame.new(width * 0.45, 0, 0))
		p += dir * segLen
		dir = (CFrame.Angles(0, 0, math.rad(11)) * CFrame.new(dir)).Position.Unit
	end
	m.WorldPivot = CFrame.new()
	m.Parent = folder
	return m
end
local function harvest(data: any)
	local mdl: Model? = data.m
	local r0 = rootOf(mdl)
	if not r0 then
		return
	end
	local root = r0 :: BasePart
	local R = data.radius or 26
	local delay = data.delay or 0.45
	local sweeps = data.sweeps or 2
	local sweepTime = data.sweepTime or 0.55
	local scale = R / 26
	local sc = bigScythe(scale)
	local g = ground(root.Position)
	-- 땅에서 솟는다 (등 뒤)
	local look = flat(root.CFrame.LookVector)
	local yaw0 = math.atan2(-look.X, -look.Z)
	local t0 = os.clock()
	local rim = part(Vector3.new(0.2, R * 2, R * 2), BLOOD, Enum.Material.Neon, 0.6, "cyl")
	rim.CFrame = CFrame.new(g + Vector3.new(0, 0.1, 0)) * CFrame.Angles(0, 0, math.rad(90))
	Fx.sound("deflect", 1, 0.4, root.Position)
	if opts.tint and near(root.Position, 90) then
		opts.tint(Color3.fromRGB(140, 0, 20), 0.3, delay + sweeps * sweepTime)
	end
	local conn: RBXScriptConnection
	conn = RunService.RenderStepped:Connect(function()
		local t = os.clock() - t0
		local c = root.Parent and ground(root.Position) or g
		local cf: CFrame
		if t < delay then
			-- 등 뒤에서 땅을 뚫고 솟는다
			local u = t / delay
			cf = CFrame.new(c) * CFrame.Angles(0, yaw0, 0) * CFrame.new(0, -30 * scale * (1 - u), R * 0.3) * CFrame.Angles(math.rad(-15), 0, 0)
		else
			-- 둘레를 휩쓴다: 자루가 기울어 날이 땅을 스치듯 돈다
			local u = math.clamp((t - delay) / (sweeps * sweepTime), 0, 1)
			local yaw = yaw0 - u * sweeps * math.pi * 2
			cf = CFrame.new(c) * CFrame.Angles(0, yaw, 0) * CFrame.new(0, 0, 0) * CFrame.Angles(0, 0, math.rad(62)) * CFrame.new(0, -2 * scale, 0)
		end
		sc:PivotTo(cf)
		if t > delay + sweeps * sweepTime then
			conn:Disconnect()
			-- 땅에 꽂는다
			sc:PivotTo(CFrame.new(c) * CFrame.Angles(0, yaw0, 0) * CFrame.new(0, -4 * scale, R * 0.5) * CFrame.Angles(math.rad(-25), 0, 0))
			for _, p in ipairs(sc:GetChildren()) do
				if p:IsA("BasePart") then
					fadeOut(p, 0.9)
				end
			end
			task.delay(1, function()
				sc:Destroy()
			end)
			fadeOut(rim, 0.6)
			Fx.ring(c + Vector3.new(0, 0.3, 0), RED, 4, R * 2.2, 0.6)
			Fx.burst("dust", c + Vector3.new(0, 0.5, 0), Color3.fromRGB(110, 50, 50), 30, 2.4)
			Fx.sound("heavy", 1, 0.5, c)
			shakeNear(c, 1.6, 80)
		end
	end)
	-- 휩쓸 때마다 핏빛 호
	for k = 1, sweeps do
		task.delay(delay + (k - 1) * sweepTime, function()
			if root.Parent then
				crescent(CFrame.new(root.Position + Vector3.new(0, 0.3, 0)), R * 0.85, 0, 350, 2.2, sweepTime, k % 2 == 0 and PALE or RED)
				Fx.sound("swing", 1, 0.45, root.Position)
			end
		end)
	end
end
-- 낙인이 한꺼번에 터진다 (베인 적마다 핏빛 폭발)
local function harvestBurst(data: any)
	for _, t in ipairs(data.targets or {}) do
		local tr = rootOf(t)
		if tr then
			local p = tr.Position
			local b = part(Vector3.new(1, 1, 1), RED, Enum.Material.Neon, 0.1, "ball")
			b.CFrame = CFrame.new(p)
			fadeOut(b, 0.4, { Size = Vector3.new(11, 11, 11) })
			local col = part(Vector3.new(16, 2, 2), BLOOD, Enum.Material.Neon, 0.1, "cyl")
			col.CFrame = CFrame.new(p + Vector3.new(0, 6, 0)) * CFrame.Angles(0, 0, math.rad(90))
			fadeOut(col, 0.5, { Size = Vector3.new(22, 0.3, 0.3) })
			Fx.burst("spark", p, RED, 20, 1.6)
		end
	end
	if data.at then
		Fx.flash(data.at, RED, 60, 6, 0.7)
		shakeNear(data.at, 1.4, 80)
	end
	Fx.sound("splash", 1, 0.5, data.at)
end

------------------------------------------------------------------------
-- 혈월만겸 (초 오의): 붉은 달이 뜨고, 핏빛 초승달이 쏟아지고, 마지막에 하늘과 땅과 화면을 가른다
------------------------------------------------------------------------
local moonState: { cc: ColorCorrectionEffect?, moon: BasePart?, untilT: number } = { untilT = 0 }
-- 2.1판: 혈월의 우두머리 악마 (쓴 사람마다 하나). 낫을 머리 뒤로 치켜들고 있다가 휘두른다
type Alpha = { h: Demon.Handle, swingAt: number, swingDur: number, swingTo: number, slam: boolean }
local alphas: { [Instance]: Alpha } = {}
local RAISED = 3.5 -- 머리 뒤로 치켜든 팔
local function alphaArm(a: Alpha, t: number): number
	local u = (os.clock() - a.swingAt) / a.swingDur
	if u < 0 or u > 2.2 then
		return RAISED + math.sin(t * 2) * 0.08
	end
	if u <= 1 then
		-- 내리찍기 (빠르게)
		return RAISED + (a.swingTo - RAISED) * (u * u)
	end
	-- 다시 치켜든다 (천천히). 마지막 일격은 내리찍은 채로 머문다
	if a.slam then
		return a.swingTo
	end
	local k = (u - 1) / 1.2
	return a.swingTo + (RAISED - a.swingTo) * (1 - (1 - k) ^ 2)
end
local function alphaSwing(m: Instance?, to: number, dur: number, slam: boolean)
	local a = m and alphas[m]
	if not a then
		return
	end
	local busy = (os.clock() - a.swingAt) < a.swingDur * 2.2
	if busy and not slam then
		return
	end
	a.swingAt = os.clock()
	a.swingDur = dur
	a.swingTo = to
	a.slam = slam
end
local function alphaRise(m: Model, r: BasePart)
	local old = alphas[m]
	if old then
		Demon.remove(old.h, 0.2)
	end
	local look = flat(r.CFrame.LookVector)
	local back = r.Position - look * 24
	local g = ground(back)
	local base = CFrame.lookAt(g, g + look)
	local sc = 4.2
	local dm = Demon.spawn(base * CFrame.new(0, -11 * sc, 0), sc, { scythe = true, wings = true })
	local a: Alpha = { h = dm, swingAt = -100, swingDur = 0.3, swingTo = 1, slam = false }
	alphas[m] = a
	dm.armR = RAISED
	dm.anim = function(t: number)
		local rise = math.clamp(t / 1.1, 0, 1)
		rise = 1 - (1 - rise) ^ 3
		dm.root = base * CFrame.new(0, -11 * sc * (1 - rise) + math.sin(t * 1.6) * 0.35 * sc, 0) * CFrame.Angles(math.rad(-6), 0, 0)
		dm.armR = alphaArm(a, t)
		-- 왼팔은 앞으로 벌려 손톱을 세운다
		dm.armL = 1.0 + math.sin(t * 2.4) * 0.15
	end
	-- 피의 원에서 솟는다
	Fx.ring(g + Vector3.new(0, 0.3, 0), RED, 6, 50, 0.9)
	Fx.burst("spark", g + Vector3.new(0, 4, 0), RED, 40, 3)
	Fx.sound("heavy", 1, 0.35, g)
	-- 끝내 마지막 일격이 오지 않아도 사라진다
	task.delay(12, function()
		if alphas[m] == a then
			alphas[m] = nil
			Demon.remove(dm, 0.8)
		end
	end)
end
local function moonRise(data: any)
	local r = rootOf(data.m)
	if not r or not near(r.Position, 220) then
		return
	end
	local dur = data.dur or 3.4
	moonState.untilT = math.max(moonState.untilT, os.clock() + dur)
	alphaRise(data.m, r)
	-- 하늘이 핏빛으로 (보는 사람 화면만)
	local cc = moonState.cc
	if not cc or not cc.Parent then
		local e = Instance.new("ColorCorrectionEffect")
		e.Name = "KwonBloodMoon"
		e.Parent = Lighting
		moonState.cc = e
		cc = e
	end
	local ccx = cc :: ColorCorrectionEffect
	tween(ccx, 0.5, { TintColor = Color3.fromRGB(255, 150, 150), Saturation = 0.3, Contrast = 0.25, Brightness = -0.08 })
	-- 붉은 달: 쓴 사람 뒤 하늘 높이
	local look = flat(r.CFrame.LookVector)
	local moonAt = r.Position - look * 120 + Vector3.new(0, 90, 0)
	local moon = part(Vector3.new(1, 1, 1), Color3.fromRGB(200, 20, 30), Enum.Material.Neon, 0.05, "ball")
	moon.CFrame = CFrame.new(moonAt)
	tween(moon, 0.8, { Size = Vector3.new(70, 70, 70) }, Enum.EasingStyle.Back)
	local halo = part(Vector3.new(1, 1, 1), Color3.fromRGB(255, 80, 80), Enum.Material.ForceField, 0.3, "ball")
	halo.CFrame = CFrame.new(moonAt)
	tween(halo, 1.0, { Size = Vector3.new(100, 100, 100) })
	local l = Instance.new("PointLight")
	l.Color = RED
	l.Range = 60
	l.Brightness = 2
	l.Parent = moon
	-- 발밑의 붉은 원
	local g = ground(r.Position)
	local rim = part(Vector3.new(0.2, 1, 1), BLOOD, Enum.Material.Neon, 0.4, "cyl")
	rim.CFrame = CFrame.new(g + Vector3.new(0, 0.1, 0)) * CFrame.Angles(0, 0, math.rad(90))
	tween(rim, 0.6, { Size = Vector3.new(0.2, (data.range or 40) * 2, (data.range or 40) * 2) })
	Fx.sound("deflect", 1, 0.3, r.Position)
	task.delay(dur, function()
		fadeOut(moon, 0.8)
		fadeOut(halo, 0.6)
		fadeOut(rim, 0.6)
		task.delay(0.1, function()
			if os.clock() >= moonState.untilT - 0.05 and moonState.cc then
				local c2 = moonState.cc :: ColorCorrectionEffect
				tween(c2, 0.8, { TintColor = WHITE, Saturation = 0, Contrast = 0, Brightness = 0 })
				task.delay(0.85, function()
					if os.clock() >= moonState.untilT and moonState.cc == c2 then
						c2:Destroy()
						moonState.cc = nil
					end
				end)
			end
		end)
	end)
	moonState.moon = moon
end
-- 하늘에서 떨어지는 핏빛 초승달 하나하나
local function moonSlash(data: any)
	-- 우두머리 악마가 초승달마다 낫을 한 번씩 휘두른다 (휘두르는 중이면 건너뛴다)
	alphaSwing(data.m, 1.3, 0.22, false)
	for _, at in ipairs(data.spots or {}) do
		if near(at, 200) then
			local g = ground(at) + Vector3.new(0, 0.2, 0)
			local yaw = math.random() * math.pi * 2
			local cf = CFrame.new(at + Vector3.new(0, 1, 0)) * CFrame.Angles(0, yaw, 0) * CFrame.Angles(0, 0, math.rad(math.random(50, 90)))
			crescent(cf, (data.radius or 6) * 0.9, -70, 70, 0.9, 0.22, math.random() < 0.3 and PALE or RED, 6)
			local mark = part(Vector3.new(0.15, 3, 3), BLOOD, Enum.Material.Neon, 0.3, "cyl")
			mark.CFrame = CFrame.new(g) * CFrame.Angles(0, 0, math.rad(90))
			fadeOut(mark, 0.35, { Size = Vector3.new(0.1, 7, 7) })
		end
	end
	if math.random() < 0.4 then
		local first = (data.spots or {})[1]
		if first then
			Fx.sound("swing", 0.5, 0.9 + math.random() * 0.3, first)
		end
	end
end
-- 마지막 낫질: 달에서 땅까지 한 줄기 붉은 칼날, 화면이 비스듬히 갈라진다
local function screenCut()
	local pg = player:FindFirstChild("PlayerGui")
	if not pg then
		return
	end
	local g = Instance.new("ScreenGui")
	g.Name = "KwonMoonCut"
	g.IgnoreGuiInset = true
	g.ResetOnSpawn = false
	g.DisplayOrder = 86
	g.Parent = pg
	local angle = -18
	-- 갈라지는 두 쪽 (붉게 물든 반투명 판이 서로 반대쪽으로 밀려난다)
	local halves: { Frame } = {}
	for i, sgn in ipairs({ -1, 1 }) do
		local h = Instance.new("Frame")
		h.AnchorPoint = Vector2.new(0.5, sgn < 0 and 1 or 0)
		h.Position = UDim2.fromScale(0.5, 0.5)
		h.Size = UDim2.fromScale(2.4, 1.6)
		h.Rotation = angle
		h.BackgroundColor3 = Color3.fromRGB(90, 0, 10)
		h.BackgroundTransparency = 0.55
		h.BorderSizePixel = 0
		h.Parent = g
		halves[i] = h
	end
	local line = Instance.new("Frame")
	line.AnchorPoint = Vector2.new(0.5, 0.5)
	line.Position = UDim2.fromScale(0.5, 0.5)
	line.Size = UDim2.new(0, 0, 0, 6)
	line.Rotation = angle
	line.BackgroundColor3 = Color3.fromRGB(255, 230, 230)
	line.BorderSizePixel = 0
	line.ZIndex = 3
	line.Parent = g
	local glowL = Instance.new("UIStroke")
	glowL.Color = RED
	glowL.Thickness = 5
	glowL.Parent = line
	tween(line, 0.12, { Size = UDim2.new(2.2, 0, 0, 6) }, Enum.EasingStyle.Quad)
	task.delay(0.16, function()
		local rad = math.rad(angle + 90)
		local off = Vector2.new(math.cos(rad), math.sin(rad)) * 0.035
		tween(halves[1], 0.35, { Position = UDim2.fromScale(0.5 - off.X, 0.5 - off.Y), BackgroundTransparency = 1 })
		tween(halves[2], 0.35, { Position = UDim2.fromScale(0.5 + off.X, 0.5 + off.Y), BackgroundTransparency = 1 })
		tween(line, 0.4, { BackgroundTransparency = 1, Size = UDim2.new(2.2, 0, 0, 18) })
		tween(glowL, 0.4, { Transparency = 1 })
	end)
	task.delay(0.7, function()
		g:Destroy()
	end)
end
local function moonCleave(data: any)
	local at: Vector3 = data.at
	local dir: Vector3 = data.dir or Vector3.new(0, 0, -1)
	local R = data.radius or 26
	local g = ground(at)
	-- 우두머리 악마의 마지막 내리찍기: 낫이 땅에 박힌 채 잠시 머물다 사라진다
	local m = data.m
	local a = m and alphas[m]
	if a then
		alphaSwing(m, 0.55, 0.14, true)
		task.delay(1.1, function()
			if alphas[m] == a then
				alphas[m] = nil
				Demon.remove(a.h, 0.9)
			end
		end)
	end
	-- 하늘에서 땅까지 세로로 선 거대한 칼날 (얇은 판)
	local blade = part(Vector3.new(0.6, 200, R * 2.4), RED, Enum.Material.Neon, 0.05)
	blade.CFrame = CFrame.lookAt(g + Vector3.new(0, 100, 0), g + Vector3.new(0, 100, 0) + dir)
	local core = part(Vector3.new(0.3, 200, R * 2.4), WHITE, Enum.Material.Neon, 0)
	core.CFrame = blade.CFrame
	blade.Size = Vector3.new(0.6, 200, 0.5)
	core.Size = Vector3.new(0.3, 200, 0.3)
	tween(blade, 0.1, { Size = Vector3.new(0.6, 200, R * 2.4) })
	tween(core, 0.1, { Size = Vector3.new(0.3, 200, R * 2.4) })
	task.delay(0.15, function()
		fadeOut(blade, 0.5, { Size = Vector3.new(4, 200, R * 2.6) })
		fadeOut(core, 0.3)
	end)
	-- 땅이 한 줄로 갈라지고 피가 솟는다
	local scar = part(Vector3.new(1.2, 0.25, R * 2.4), RED, Enum.Material.Neon, 0)
	scar.CFrame = CFrame.lookAt(g + Vector3.new(0, 0.15, 0), g + Vector3.new(0, 0.15, 0) + dir)
	task.delay(1.2, function()
		fadeOut(scar, 1)
	end)
	for i = 0, 3 do
		task.delay(i * 0.07, function()
			Fx.ring(g + Vector3.new(0, 0.3, 0), i % 2 == 0 and RED or PALE, 4, R * 2.6 + i * 8, 0.8)
		end)
	end
	Fx.burst("spark", at + Vector3.new(0, 3, 0), RED, 60, 2.6)
	Fx.burst("dust", g + Vector3.new(0, 0.5, 0), Color3.fromRGB(110, 50, 50), 40, 3)
	Fx.debris(g, 12, 40, Color3.fromRGB(90, 40, 40))
	Fx.flash(at, RED, 60, 8, 1)
	Fx.breakSound("slash", 0.8, 0.6, at)
	Fx.sound("heavy", 1, 0.4, at)
	shakeNear(at, 2.6, 120)
	if near(at, 120) then
		screenCut()
	end
end

local HANDLERS: { [string]: (any) -> () } = {
	reapHook = reapHook,
	reapSpin = reapSpin,
	reapScar = reapScar,
	harvest = harvest,
	harvestBurst = harvestBurst,
	moonRise = moonRise,
	moonSlash = moonSlash,
	moonCleave = moonCleave,
}
function Reaper.handles(data: any): boolean
	return HANDLERS[data.kind] ~= nil
end
function Reaper.run(data: any)
	local fn = HANDLERS[data.kind]
	if fn then
		fn(data)
	end
end

------------------------------------------------------------------------
-- 초 오의 혈월만겸의 컷씬 (쓴 사람 화면에서만, 대사 없이): 무릎 꿇은 몸을 낮게 올려다보다가,
-- 일어서며 낫을 달로 치켜드는 순간 카메라가 뒤로 빠져 붉은 달과 함께 잡는다
------------------------------------------------------------------------
local cutActive = false
function Reaper.superCut(model: Model, dur: number, name: string, shake: ((number) -> ())?)
	local cam = workspace.CurrentCamera
	local r = rootOf(model)
	if not cam or not r or cutActive then
		return
	end
	cutActive = true
	local pg = player:WaitForChild("PlayerGui")
	local g = Instance.new("ScreenGui")
	g.Name = "KwonReaperCut"
	g.IgnoreGuiInset = true
	g.ResetOnSpawn = false
	g.DisplayOrder = 85
	g.Parent = pg
	-- 붉게 물드는 가장자리
	local tintF = Instance.new("Frame")
	tintF.Size = UDim2.fromScale(1, 1)
	tintF.BackgroundColor3 = Color3.fromRGB(90, 0, 12)
	tintF.BackgroundTransparency = 1
	tintF.BorderSizePixel = 0
	tintF.Parent = g
	local grad = Instance.new("UIGradient")
	grad.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.1), NumberSequenceKeypoint.new(0.35, 1), NumberSequenceKeypoint.new(0.65, 1), NumberSequenceKeypoint.new(1, 0.1) })
	grad.Rotation = 90
	grad.Parent = tintF
	tween(tintF, 0.3, { BackgroundTransparency = 0.35 })
	-- 위아래 검은 띠와 이름
	local bars: { Frame } = {}
	for i, y in ipairs({ 0, 1 }) do
		local b = Instance.new("Frame")
		b.AnchorPoint = Vector2.new(0, y)
		b.Position = UDim2.fromScale(0, y)
		b.Size = UDim2.new(1, 0, 0, 0)
		b.BackgroundColor3 = Color3.new(0, 0, 0)
		b.BorderSizePixel = 0
		b.ZIndex = 5
		b.Parent = g
		tween(b, 0.15, { Size = UDim2.new(1, 0, 0.14, 0) })
		bars[i] = b
	end
	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.AnchorPoint = Vector2.new(1, 0.5)
	label.Position = UDim2.new(1, -30, 0.5, 0)
	label.Size = UDim2.new(0.5, 0, 0.45, 0)
	label.Font = Enum.Font.GothamBlack
	label.TextScaled = true
	label.TextXAlignment = Enum.TextXAlignment.Right
	label.Text = "초 오의 · " .. name
	label.TextColor3 = PALE
	label.TextStrokeColor3 = RED
	label.TextStrokeTransparency = 0.2
	label.TextTransparency = 1
	label.ZIndex = 6
	label.Parent = bars[2]
	tween(label, 0.25, { TextTransparency = 0 })
	-- 핏방울이 화면 위에서 흘러내린다
	local drops: { Frame } = {}
	for i = 1, 12 do
		local d = Instance.new("Frame")
		d.AnchorPoint = Vector2.new(0.5, 0)
		d.Position = UDim2.fromScale((i - 0.5) / 12 + (math.random() - 0.5) * 0.05, 0.1)
		d.Size = UDim2.new(0, 3 + math.random(0, 3), 0, 0)
		d.BackgroundColor3 = BLOOD
		d.BorderSizePixel = 0
		d.ZIndex = 4
		d.Parent = g
		table.insert(drops, d)
		tween(d, dur * (0.6 + math.random() * 0.4), { Size = UDim2.new(0, d.Size.X.Offset, 0.2 + math.random() * 0.35, 0) }, Enum.EasingStyle.Sine)
	end

	local oldType = cam.CameraType
	local oldFov = cam.FieldOfView
	local look = flat(r.CFrame.LookVector)
	local side = Vector3.new(-look.Z, 0, look.X)
	cam.CameraType = Enum.CameraType.Scriptable
	local t0 = os.clock()
	local focus = r.Position
	local finished = false
	local function restore()
		if finished then
			return
		end
		finished = true
		RunService:UnbindFromRenderStep("KwonReaperCut")
		cam.CameraType = oldType == Enum.CameraType.Scriptable and Enum.CameraType.Custom or oldType
		cam.FieldOfView = oldFov
		cutActive = false
		-- 1.9.3판: 컷씬이 끝나면 카메라를 내 등 뒤 조금 높은 곳으로 (앞에서 터지는 기술이 잘 보이게)
		local function behind()
			if r.Parent then
				local lk = flat(r.CFrame.LookVector)
				cam.CFrame = CFrame.lookAt(r.Position - lk * 15 + Vector3.new(0, 6, 0), r.Position + lk * 6 + Vector3.new(0, 1, 0))
			end
		end
		behind()
		task.defer(behind)
	end
	RunService:BindToRenderStep("KwonReaperCut", Enum.RenderPriority.Camera.Value, function(dt: number)
		if finished then
			return
		end
		local t = os.clock() - t0
		local u = math.clamp(t / dur, 0, 1)
		if not r.Parent then
			restore()
			return
		end
		focus = focus:Lerp(r.Position, math.min(1, dt * 10))
		local e = u * u * (3 - 2 * u)
		-- 처음엔 앞쪽 낮은 곳에서 얼굴을 올려다보고, 끝으로 갈수록 뒤로 크게 빠지며 달까지 담는다
		local pos = focus + look * (5 - 15 * e) + side * (2 + 4 * e) + Vector3.new(0, -1.2 + 5 * e, 0)
		local target = focus + Vector3.new(0, 1.2 + 6 * e, 0) - look * (40 * e)
		cam.CFrame = CFrame.lookAt(pos, target)
		cam.FieldOfView = oldFov - 22 + 26 * e
		if shake and u > 0.6 then
			shake(0.1 + (u - 0.6) * 0.8)
		end
	end)
	task.delay(dur, function()
		restore()
		for _, b in ipairs(bars) do
			tween(b, 0.18, { Size = UDim2.new(1, 0, 0, 0) })
		end
		tween(label, 0.15, { TextTransparency = 1, TextStrokeTransparency = 1 })
		for _, d in ipairs(drops) do
			tween(d, 0.25, { BackgroundTransparency = 1 })
		end
		grad:Destroy()
		tintF.BackgroundColor3 = Color3.fromRGB(255, 200, 200)
		tintF.BackgroundTransparency = 0.25
		tween(tintF, 0.35, { BackgroundTransparency = 1 })
		if shake then
			shake(1.4)
		end
		task.delay(0.5, function()
			g:Destroy()
		end)
	end)
end

return Reaper
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="40">
          <Properties>
            <string name="Name">Royal</string>
            <string name="Source"><![CDATA[-- 권왕 3.10판: 권왕신권의 오의 · 초 오의 (화면)
-- 패왕난무: 금빛 투기장과 금 기둥 여덟, 기둥마다 거대한 주먹이 한가운데를 내지르고 땅속 주먹이 올려친다
-- 천하제일권: 등 뒤에 하늘만 한 금빛 왕 (나의 모습)이 일어서서 한 방, 충격파 세 겹, 십자 빛기둥, 내려와 박히는 빛의 왕관
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local Fx = require(script.Parent:WaitForChild("Fx"))

local Royal = {}

local GOLD = Color3.fromRGB(255, 204, 70)
local GOLD_DEEP = Color3.fromRGB(200, 140, 30)
local CRIMSON = Color3.fromRGB(170, 20, 35)
local CRIMSON_DARK = Color3.fromRGB(100, 10, 20)
local PALE = Color3.fromRGB(255, 244, 205)
local WHITE = Color3.new(1, 1, 1)
local UP = CFrame.Angles(0, 0, math.rad(90))

local folder = Instance.new("Folder")
folder.Name = "KwonRoyal"
folder.Parent = workspace

local opts: any = {}
function Royal.init(o: any)
	opts = o or {}
end

local function part(size: Vector3, color: Color3, material: Enum.Material?, alpha: number?, shape: string?): BasePart
	local p: BasePart
	if shape == "wedge" then
		p = Instance.new("WedgePart")
	else
		local q = Instance.new("Part")
		if shape == "ball" then
			q.Shape = Enum.PartType.Ball
		elseif shape == "cyl" then
			q.Shape = Enum.PartType.Cylinder
		end
		p = q
	end
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	p.Size = size
	p.Color = color
	p.Material = material or Enum.Material.SmoothPlastic
	p.Transparency = alpha or 0
	p.Parent = folder
	return p
end
local function tween(inst: Instance, time: number, goal: { [string]: any }, style: Enum.EasingStyle?, dir: Enum.EasingDirection?)
	local tw = TweenService:Create(inst, TweenInfo.new(math.max(0.01, time), style or Enum.EasingStyle.Quad, dir or Enum.EasingDirection.Out), goal)
	tw:Play()
	return tw
end
local function fadeOut(p: BasePart, time: number, goal: { [string]: any }?)
	local g = goal or {}
	g.Transparency = 1
	tween(p, time, g)
	task.delay(time + 0.05, function()
		p:Destroy()
	end)
end
local function near(pos: Vector3, d: number): boolean
	local cam = workspace.CurrentCamera
	return cam ~= nil and (cam.CFrame.Position - pos).Magnitude < d
end
local function rootOf(m: Instance?): BasePart?
	local r = m and m:FindFirstChild("HumanoidRootPart")
	return (r and r:IsA("BasePart")) and r or nil
end
local function flat(v: Vector3): Vector3
	local f = Vector3.new(v.X, 0, v.Z)
	return f.Magnitude > 1e-3 and f.Unit or Vector3.new(0, 0, -1)
end
local function ground(at: Vector3): Vector3
	return Vector3.new(at.X, at.Y - 2.7, at.Z)
end
local function shakeNear(pos: Vector3, amount: number, range: number)
	if opts.shake and near(pos, range) then
		opts.shake(amount)
	end
end

-- 몸 하나를 여러 조각으로 함께 움직인다
type Group = { list: { { p: BasePart, off: CFrame } } }
local function gplace(g: Group, cf: CFrame)
	for _, it in ipairs(g.list) do
		if it.p.Parent then
			it.p.CFrame = cf * it.off
		end
	end
end
local function gfade(g: Group, time: number)
	for _, it in ipairs(g.list) do
		if it.p.Parent then
			fadeOut(it.p, time)
		end
	end
end
-- 왕관: 금 테 + 뾰족한 금 쐐기 n개 + 붉은 보석
local function crownInto(g: Group, base: CFrame, R: number, h: number, n: number)
	table.insert(g.list, { p = part(Vector3.new(h * 0.3, R * 2.1, R * 2.1), GOLD, Enum.Material.Metal, 0, "cyl"), off = base * UP })
	for k = 0, n - 1 do
		local a = k / n * math.pi * 2
		local w = part(Vector3.new(R * 0.3, h, h * 0.25), GOLD, Enum.Material.Metal, 0, "wedge")
		table.insert(g.list, { p = w, off = base * CFrame.Angles(0, a, 0) * CFrame.new(0, h * 0.55, -R) })
		local gem = part(Vector3.new(R * 0.18, R * 0.18, R * 0.18), k % 2 == 0 and CRIMSON or PALE, Enum.Material.Neon, 0, "ball")
		table.insert(g.list, { p = gem, off = base * CFrame.Angles(0, a, 0) * CFrame.new(0, h * 1.05, -R) })
	end
end
-- 금빛 왕의 그림자: 그 사람의 몸을 본떠 금빛 유리로, 머리 위에 관, 등에 붉은 망토
local function kingShade(model: Model?, alpha: number): Group
	local g: Group = { list = {} }
	local r = rootOf(model)
	if model and r then
		for _, d in ipairs(model:GetDescendants()) do
			if d:IsA("BasePart") and d.Name ~= "HumanoidRootPart" and d.Transparency < 0.9 and d.Size.Magnitude < 8 and d.Parent == model then
				local q = part(d.Size, GOLD, Enum.Material.Glass, alpha, d:IsA("Part") and d.Shape == Enum.PartType.Ball and "ball" or nil)
				table.insert(g.list, { p = q, off = r.CFrame:ToObjectSpace(d.CFrame) })
			end
		end
	else
		table.insert(g.list, { p = part(Vector3.new(2, 4, 1), GOLD, Enum.Material.Glass, alpha), off = CFrame.new() })
	end
	-- 망토: 어깨에서 뒤로 넓게 늘어진다
	local cape = part(Vector3.new(2.6, 3.6, 0.15), CRIMSON, Enum.Material.Fabric, math.min(0.9, alpha + 0.1))
	table.insert(g.list, { p = cape, off = CFrame.new(0, 0, 0.7) * CFrame.Angles(math.rad(14), 0, 0) })
	crownInto(g, CFrame.new(0, 2.6, 0), 0.55, 0.6, 6)
	return g
end


------------------------------------------------------------------------
-- 공용: 왕관 쐐기, 금빛 폭발
------------------------------------------------------------------------
local function crownSpikes(at: Vector3, R: number, n: number, h: number)
	for k = 0, n - 1 do
		local a = k / n * math.pi * 2
		local p = at + Vector3.new(math.cos(a) * R, 0, math.sin(a) * R)
		local w = part(Vector3.new(R * 0.35, 0.5, h * 0.3), GOLD, Enum.Material.Neon, 0.05, "wedge")
		local cf = CFrame.lookAt(p, at) * CFrame.Angles(math.rad(-90), 0, 0)
		w.CFrame = cf
		tween(w, 0.12, { Size = Vector3.new(R * 0.35, h, h * 0.3), CFrame = cf * CFrame.new(0, h / 2, 0) }, Enum.EasingStyle.Back)
		task.delay(0.35, function()
			fadeOut(w, 0.4, { Size = Vector3.new(0.2, h, 0.2) })
		end)
		local gem = part(Vector3.new(1.2, 1.2, 1.2), k % 2 == 0 and CRIMSON or PALE, Enum.Material.Neon, 0, "ball")
		gem.CFrame = CFrame.new(p + Vector3.new(0, h, 0))
		fadeOut(gem, 0.6, { Size = Vector3.new(3, 3, 3) })
	end
end
local function goldBlast(at: Vector3, R: number)
	local g = ground(at)
	local core = part(Vector3.new(3, 3, 3), WHITE, Enum.Material.Neon, 0, "ball")
	core.CFrame = CFrame.new(g + Vector3.new(0, 2, 0))
	fadeOut(core, 0.45, { Size = Vector3.new(R * 1.8, R * 1.8, R * 1.8) })
	local shell = part(Vector3.new(3, 3, 3), GOLD, Enum.Material.Neon, 0.35, "ball")
	shell.CFrame = core.CFrame
	fadeOut(shell, 0.6, { Size = Vector3.new(R * 2.4, R * 2.4, R * 2.4) })
	local col = part(Vector3.new(4, R * 0.9, R * 0.9), PALE, Enum.Material.Neon, 0.1, "cyl")
	col.CFrame = CFrame.new(g + Vector3.new(0, 2, 0)) * UP
	tween(col, 0.15, { Size = Vector3.new(80, R * 0.9, R * 0.9), CFrame = CFrame.new(g + Vector3.new(0, 40, 0)) * UP })
	task.delay(0.18, function()
		fadeOut(col, 0.5, { Size = Vector3.new(80, R * 1.8, R * 1.8) })
	end)
	for k = 0, 2 do
		task.delay(k * 0.07, function()
			Fx.ring(g + Vector3.new(0, 0.5 + k, 0), k == 1 and CRIMSON or GOLD, 4, R * 2.6 + k * 8, 0.6)
		end)
	end
	Fx.burst("glitter", g + Vector3.new(0, 3, 0), GOLD, 30, 2.2)
	Fx.burst("dust", g + Vector3.new(0, 0.5, 0), Color3.fromRGB(170, 150, 120), 20, 1.8)
	Fx.flash(g + Vector3.new(0, 4, 0), GOLD, 90, 7, 0.5)
	Fx.sound("heavy", 1, 0.5, g)
	Fx.breakSound("boom", 1, 0.55, g)
	shakeNear(g, 2.8, 170)
end
-- 큰 주먹 (붉은 소매에 금 팔찌). 기준은 주먹 가운데, 소매는 위(+Y)로 뻗는다. s배로 키운다
local function armGroup(s: number): Group
	local g: Group = { list = {} }
	local function add(p: BasePart, off: CFrame)
		p.Size *= s
		table.insert(g.list, { p = p, off = CFrame.new(off.Position * s) * off.Rotation })
	end
	add(part(Vector3.new(14, 12, 12), GOLD, Enum.Material.Metal, 0), CFrame.new())
	for k = 0, 3 do
		add(part(Vector3.new(3.8, 3.8, 3.8), GOLD_DEEP, Enum.Material.Metal, 0, "ball"), CFrame.new(-5.2 + k * 3.5, -6, -4.5))
	end
	add(part(Vector3.new(4, 8, 4), GOLD, Enum.Material.Metal), CFrame.new(7.5, 0, -2) * CFrame.Angles(0, 0, math.rad(-15)))
	add(part(Vector3.new(5, 15, 15), GOLD_DEEP, Enum.Material.Metal, 0, "cyl"), CFrame.new(0, 8, 0) * UP)
	for k = 0, 5 do
		local a = k / 6 * math.pi * 2
		add(part(Vector3.new(1.6, 1.6, 1.6), CRIMSON, Enum.Material.Neon, 0, "ball"), CFrame.new(math.cos(a) * 7.6, 8, math.sin(a) * 7.6))
	end
	add(part(Vector3.new(60, 16, 16), CRIMSON, Enum.Material.Fabric, 0, "cyl"), CFrame.new(0, 40, 0) * UP)
	for _, y in ipairs({ 12, 22 }) do
		add(part(Vector3.new(1.4, 17, 17), GOLD, Enum.Material.Metal, 0, "cyl"), CFrame.new(0, y, 0) * UP)
	end
	return g
end
-- 주먹이 dir 쪽을 향하게 (소매는 뒤로)
local function fistCF(pos: Vector3, dir: Vector3): CFrame
	return CFrame.lookAt(pos, pos + dir) * CFrame.Angles(math.rad(90), 0, 0)
end
-- 땅이 패이며 갈라지는 금빛 금
local function goldCracks(g: Vector3, n: number, len: number, life: number)
	for k = 1, n do
		local a = (k / n + math.random() * 0.08) * math.pi * 2
		local p = g + Vector3.new(0, 0.2, 0)
		local dir = Vector3.new(math.cos(a), 0, math.sin(a))
		for j = 1, 3 do
			local q = p + dir * (len / 3) * (0.7 + math.random() * 0.6)
			local seg = part(Vector3.new(0.5 / j + 0.2, 0.15, (q - p).Magnitude), j == 1 and PALE or GOLD, Enum.Material.Neon, 0)
			seg.CFrame = CFrame.lookAt((p + q) / 2, q)
			task.delay(life + math.random() * 0.3, function()
				fadeOut(seg, 0.4)
			end)
			p = q
			local turn = (math.random() - 0.5) * 0.9
			dir = Vector3.new(dir.X * math.cos(turn) - dir.Z * math.sin(turn), 0, dir.X * math.sin(turn) + dir.Z * math.cos(turn))
		end
	end
	-- 패인 자리의 바위 테두리
	for k = 0, 13 do
		local a = k / 14 * math.pi * 2 + math.random() * 0.2
		local p = g + Vector3.new(math.cos(a), 0, math.sin(a)) * len * 0.35
		local rock = part(Vector3.new(2.5, 1.6, 2) * (0.7 + math.random() * 0.6), Color3.fromRGB(120, 104, 86), Enum.Material.Slate, 0, "wedge")
		rock.CFrame = CFrame.lookAt(p, g) * CFrame.Angles(math.rad(-20), math.rad(180), 0)
		task.delay(life + 0.6 + math.random() * 0.4, function()
			fadeOut(rock, 0.5, { CFrame = rock.CFrame - Vector3.new(0, 1.5, 0) })
		end)
	end
end

------------------------------------------------------------------------
-- G 패왕난무: 발밑에 금빛 투기장, 둘레의 금 기둥 여덟. 기둥마다 거대한 주먹이 차례로 한가운데를 내지르고, 땅속 주먹이 올려친다
------------------------------------------------------------------------
local function kingArena(data: any)
	local at: Vector3 = data.at
	if not near(at, 260) then
		return
	end
	local R = data.radius or 22
	local rise = data.rise or 0.35
	local n = data.fists or 8
	local every = data.every or 0.12
	local upper = data.upper or 0.3
	local g = ground(at)
	local keep: { BasePart } = {}
	-- 투기장 바닥: 금 테, 붉은 안쪽, 관 무늬 (가운데 금 원)
	local floor = part(Vector3.new(0.2, 2, 2), CRIMSON_DARK, Enum.Material.Neon, 0.55, "cyl")
	floor.CFrame = CFrame.new(g + Vector3.new(0, 0.1, 0)) * UP
	tween(floor, rise, { Size = Vector3.new(0.2, R * 2, R * 2) })
	local rim = part(Vector3.new(0.3, 2, 2), GOLD, Enum.Material.Neon, 0.2, "cyl")
	rim.CFrame = CFrame.new(g + Vector3.new(0, 0.05, 0)) * UP
	tween(rim, rise, { Size = Vector3.new(0.3, R * 2 + 2, R * 2 + 2) })
	local mid = part(Vector3.new(0.25, 2, 2), GOLD, Enum.Material.Neon, 0.25, "cyl")
	mid.CFrame = CFrame.new(g + Vector3.new(0, 0.15, 0)) * UP
	tween(mid, rise, { Size = Vector3.new(0.25, R * 0.5, R * 0.5) })
	table.insert(keep, floor)
	table.insert(keep, rim)
	table.insert(keep, mid)
	Fx.sound("heavy", 0.7, 0.8, at)
	shakeNear(g, 1.2, 140)
	-- 금 기둥 여덟이 솟는다 (꼭대기에 붉은 보석)
	local pillars: { Vector3 } = {}
	for k = 1, n do
		local a = (k - 1) / n * math.pi * 2
		local p = g + Vector3.new(math.cos(a), 0, math.sin(a)) * R
		pillars[k] = p
		local h = 14
		local col = part(Vector3.new(h, 2.6, 2.6), GOLD_DEEP, Enum.Material.Metal, 0, "cyl")
		local cap = part(Vector3.new(1, 3.6, 3.6), GOLD, Enum.Material.Metal, 0, "cyl")
		local gem = part(Vector3.new(1.8, 1.8, 1.8), k % 2 == 0 and CRIMSON or PALE, Enum.Material.Neon, 0, "ball")
		col.CFrame = CFrame.new(p - Vector3.new(0, h / 2, 0)) * UP
		cap.CFrame = CFrame.new(p) * UP
		gem.CFrame = CFrame.new(p + Vector3.new(0, 0.8, 0))
		tween(col, rise, { CFrame = CFrame.new(p + Vector3.new(0, h / 2, 0)) * UP }, Enum.EasingStyle.Back)
		tween(cap, rise, { CFrame = CFrame.new(p + Vector3.new(0, h, 0)) * UP }, Enum.EasingStyle.Back)
		tween(gem, rise, { CFrame = CFrame.new(p + Vector3.new(0, h + 1.4, 0)) }, Enum.EasingStyle.Back)
		table.insert(keep, col)
		table.insert(keep, cap)
		table.insert(keep, gem)
		Fx.burst("dust", p, Color3.fromRGB(170, 150, 120), 4, 1.2)
	end
	-- 기둥마다 주먹이 한가운데로
	for k = 1, n do
		task.delay(rise + (k - 1) * every, function()
			local from = pillars[k] + Vector3.new(0, 5, 0)
			local to = g + Vector3.new(0, 3, 0)
			local dir = (to - from).Unit
			local arm = armGroup(0.32)
			local t0 = os.clock()
			local dur = math.max(0.08, every * 1.3)
			local conn: RBXScriptConnection
			conn = RunService.Heartbeat:Connect(function()
				local u = math.clamp((os.clock() - t0) / dur, 0, 1)
				gplace(arm, fistCF(from:Lerp(to - dir * 2, u * u), dir))
				if u >= 1 then
					conn:Disconnect()
					gfade(arm, 0.25)
					local hit = part(Vector3.new(2, 2, 2), PALE, Enum.Material.Neon, 0, "ball")
					hit.CFrame = CFrame.new(to)
					fadeOut(hit, 0.25, { Size = Vector3.new(9, 9, 9) })
					Fx.ring(g + Vector3.new(0, 0.4, 0), k % 2 == 0 and CRIMSON or GOLD, 2, 14, 0.3)
					Fx.burst("glitter", to, GOLD, 6, 1.2)
				end
			end)
			Fx.sound("hit", 0.55, 0.8 + k * 0.05, to)
			shakeNear(g, 0.6, 120)
		end)
	end
	-- 땅속에서 솟는 주먹이 올려친다
	local up = rise + n * every + upper
	task.delay(up - 0.15, function()
		goldCracks(g, 8, R * 0.5, 0.4)
		Fx.burst("dust", g, Color3.fromRGB(170, 150, 120), 12, 2)
	end)
	task.delay(up, function()
		local arm = armGroup(0.6)
		local from = g - Vector3.new(0, 10, 0)
		local to = g + Vector3.new(0, 8, 0)
		local base = CFrame.Angles(math.pi, 0, 0)
		local t0 = os.clock()
		local conn: RBXScriptConnection
		conn = RunService.Heartbeat:Connect(function()
			local u = math.clamp((os.clock() - t0) / 0.14, 0, 1)
			gplace(arm, CFrame.new(from:Lerp(to, 1 - (1 - u) ^ 2)) * base)
			if u >= 1 then
				conn:Disconnect()
				task.delay(0.25, function()
					gfade(arm, 0.35)
				end)
			end
		end)
		goldBlast(at, R * 0.6)
		crownSpikes(g, R * 0.6, 10, 10)
		if opts.flash and near(g, R * 2) then
			opts.flash(GOLD, 0.2)
		end
		for _, q in ipairs(keep) do
			if q.Parent then
				fadeOut(q, 0.6)
			end
		end
	end)
	task.delay(up + 3, function()
		for _, q in ipairs(keep) do
			if q.Parent then
				q:Destroy()
			end
		end
	end)
end

------------------------------------------------------------------------
-- X 천하제일권: 등 뒤에 하늘만 한 금빛 왕 (나의 모습)이 일어선다. 오른팔을 당겼다가 가장 강한 적에게 한 방.
-- 충격파 세 겹, 십자로 내달리는 빛기둥 넷, 하늘에서 내려와 박히는 빛의 왕관
------------------------------------------------------------------------
type Avatar = { body: Group, arm: Group?, done: boolean }
local avatars: { [number]: Avatar } = {}
local function avatarEnd(av: Avatar)
	if av.done then
		return
	end
	av.done = true
	gfade(av.body, 0.8)
	local arm = av.arm
	if arm then
		gfade(arm, 0.5)
	end
end
local function kingAvatar(data: any)
	local at: Vector3 = data.at
	local to: Vector3 = data.to
	if not near(at, 400) then
		return
	end
	local cut = data.cut or 1.5
	local rise = data.rise or 0.8
	local charge = data.charge or 0.6
	local punch = data.punch or 0.3
	local g = ground(at)
	local S = 9
	local dir = flat(to - at)
	local right = Vector3.new(-dir.Z, 0, dir.X)
	-- 왕: 나의 몸을 금빛 유리로 아홉 배, 머리 위에 관, 등에 붉은 망토
	local body = kingShade(data.m, 0.35)
	for _, it in ipairs(body.list) do
		it.p.Size *= S
		it.off = CFrame.new(it.off.Position * S) * it.off.Rotation
		it.p.Transparency = 1
	end
	local av: Avatar = { body = body, arm = nil, done = false }
	avatars[data.id] = av
	local base = g - dir * 16 - right * 6
	local stand = base + Vector3.new(0, 3 * S, 0)
	local face = CFrame.lookAt(stand, stand + dir)
	-- 등 뒤의 빛기둥과 금빛 바람
	local glow = part(Vector3.new(120, 26, 26), PALE, Enum.Material.Neon, 1, "cyl")
	glow.CFrame = CFrame.new(base + Vector3.new(0, 60, 0)) * UP
	tween(glow, cut * 0.6, { Transparency = 0.82 })
	Fx.ring(base + Vector3.new(0, 0.4, 0), GOLD, 4, 60, 1)
	Fx.sound("heavy", 0.8, 0.45, at)
	-- 땅에서 솟아 일어선다 (컷씬 동안부터)
	local t0 = os.clock()
	local from = cut * 0.25
	local riseT = cut * 0.75 + rise
	local conn: RBXScriptConnection
	conn = RunService.Heartbeat:Connect(function()
		if av.done then
			conn:Disconnect()
			return
		end
		local t = os.clock() - t0
		local u = math.clamp((t - from) / riseT, 0, 1)
		local e = 1 - (1 - u) ^ 3
		local bob = math.sin(t * 2) * 0.6
		gplace(body, face - Vector3.new(0, (1 - e) * 4 * S, 0) + Vector3.new(0, bob, 0))
	end)
	task.delay(from, function()
		for _, it in ipairs(body.list) do
			if it.p.Parent then
				tween(it.p, riseT * 0.8, { Transparency = it.p.Material == Enum.Material.Glass and 0.35 or 0.1 })
			end
		end
		shakeNear(g, 1.5, 200)
		Fx.burst("dust", base, Color3.fromRGB(170, 150, 120), 20, 3)
	end)
	task.delay(cut, function()
		Fx.sound("heavy", 1, 0.35, at)
		for k = 0, 2 do
			task.delay(k * 0.15, function()
				Fx.ring(base + Vector3.new(0, 0.5 + k * 3, 0), k == 1 and CRIMSON or GOLD, 3, 50 + k * 16, 0.8)
			end)
		end
	end)
	-- 오른팔을 당긴다: 어깨 뒤에 거대한 주먹, 금빛이 모여든다
	local shoulder = stand + right * 1.6 * S + Vector3.new(0, 1.4 * S, 0)
	local goal = to + Vector3.new(0, 2, 0)
	local pd = (goal - shoulder).Unit
	local back = shoulder - pd * 10 + Vector3.new(0, 4, 0)
	task.delay(cut + rise, function()
		if av.done then
			return
		end
		local arm = armGroup(1)
		av.arm = arm
		gplace(arm, fistCF(back, pd))
		for _, it in ipairs(arm.list) do
			local a = it.p.Transparency
			it.p.Transparency = 1
			tween(it.p, charge * 0.5, { Transparency = a })
		end
		for k = 0, 9 do
			task.delay(k * charge / 10, function()
				local o = back + Vector3.new(math.random() - 0.5, math.random() - 0.5, math.random() - 0.5).Unit * 22
				local mote = part(Vector3.new(1.2, 1.2, 1.2), k % 3 == 0 and PALE or GOLD, Enum.Material.Neon, 0, "ball")
				mote.CFrame = CFrame.new(o)
				fadeOut(mote, charge * 0.4, { CFrame = CFrame.new(back), Size = Vector3.new(0.3, 0.3, 0.3) })
			end)
		end
		Fx.sound("ping", 0.9, 0.4, at)
		shakeNear(g, 0.8, 200)
	end)
	-- 한 방
	task.delay(cut + rise + charge, function()
		local arm = av.arm
		if av.done or not arm then
			return
		end
		local st = os.clock()
		local last = back
		local c2: RBXScriptConnection
		c2 = RunService.Heartbeat:Connect(function()
			local u = math.clamp((os.clock() - st) / punch, 0, 1)
			local p = back:Lerp(goal - pd * 6, u ^ 2.2)
			gplace(arm, fistCF(p, pd))
			if (p - last).Magnitude > 4 then
				local tr = part(Vector3.new(8, 8, (p - last).Magnitude), GOLD, Enum.Material.Neon, 0.5)
				tr.CFrame = CFrame.lookAt((p + last) / 2, p)
				fadeOut(tr, 0.3, { Size = Vector3.new(0.5, 0.5, tr.Size.Z) })
				last = p
			end
			if u >= 1 then
				c2:Disconnect()
			end
		end)
		Fx.sound("swing", 1, 0.4, at)
	end)
	task.delay(cut + rise + charge + punch + 0.5, function()
		local arm = av.arm
		if arm and not av.done then
			gfade(arm, 0.4)
			av.arm = nil
		end
	end)
	task.delay(cut + rise + charge + punch + 4, function()
		avatarEnd(av)
		fadeOut(glow, 0.6)
		avatars[data.id] = nil
	end)
end
local function kingImpact(data: any)
	local at: Vector3 = data.at
	if not near(at, 400) then
		return
	end
	local g = ground(at)
	local R = data.radius or 20
	local rings = data.rings or 3
	local ringEvery = data.ringEvery or 0.2
	local cross = data.cross or 0.6
	local len = data.crossLen or 40
	local crownAt = data.crownAt or 0.4
	local FR = data.finalRadius or 28
	local dir = flat(data.dir or Vector3.new(0, 0, -1))
	local right = Vector3.new(-dir.Z, 0, dir.X)
	-- 맞은 자리: 하얀 빛, 금빛 폭발, 패인 땅
	goldBlast(at, R)
	goldCracks(g, 12, R * 1.4, 1.6)
	Fx.flash(g + Vector3.new(0, 6, 0), WHITE, 160, 10, 0.6)
	Fx.breakSound("boom", 1, 0.4, g)
	shakeNear(g, 3.4, 240)
	if opts.flash and near(g, R * 3) then
		opts.flash(PALE, 0.3)
	end
	-- 충격파 세 겹
	for k = 1, rings do
		task.delay(k * ringEvery, function()
			local r1 = R * (0.5 + k * 0.6)
			Fx.ring(g + Vector3.new(0, 0.6, 0), k % 2 == 0 and CRIMSON or GOLD, 5, r1 * 2, 0.5)
			Fx.ring(g + Vector3.new(0, 3, 0), PALE, 2, r1 * 1.8, 0.4)
			Fx.burst("dust", g, Color3.fromRGB(170, 150, 120), 10, 2 + k * 0.4)
			Fx.sound("heavy", 0.7, 0.6 + k * 0.1, g)
			shakeNear(g, 1.4, 200)
		end)
	end
	-- 십자로 내달리는 빛기둥 넷
	local steps = 6
	for _, d in ipairs({ dir, right, -dir, -right }) do
		local streak = part(Vector3.new(7, 0.3, 1), PALE, Enum.Material.Neon, 0.1)
		streak.CFrame = CFrame.lookAt(g + Vector3.new(0, 0.3, 0), g + Vector3.new(0, 0.3, 0) + d)
		for k = 1, steps do
			task.delay(0.2 + (k - 1) * cross / steps, function()
				local tip = g + d * (len * k / steps)
				local l = len * k / steps
				if streak.Parent then
					local mid = g + d * (l / 2) + Vector3.new(0, 0.3, 0)
					tween(streak, cross / steps, { Size = Vector3.new(7, 0.3, l), CFrame = CFrame.lookAt(mid, mid + d) })
				end
				local col = part(Vector3.new(4, 6, 6), k == steps and WHITE or GOLD, Enum.Material.Neon, 0.05, "cyl")
				col.CFrame = CFrame.new(tip) * UP
				tween(col, 0.15, { Size = Vector3.new(50, 6, 6), CFrame = CFrame.new(tip + Vector3.new(0, 25, 0)) * UP })
				task.delay(0.18, function()
					fadeOut(col, 0.35, { Size = Vector3.new(50, 0.5, 0.5) })
				end)
				Fx.burst("glitter", tip, GOLD, 4, 1.4)
			end)
		end
		task.delay(0.2 + cross + crownAt + 0.3, function()
			fadeOut(streak, 0.5)
		end)
	end
	Fx.sound("ping", 0.8, 0.5, g)
	-- 빛의 왕관이 하늘에서 내려와 박힌다
	local crown: Group = { list = {} }
	crownInto(crown, CFrame.new(), FR * 0.55, 9, 10)
	for _, it in ipairs(crown.list) do
		it.p.Material = Enum.Material.Neon
		it.p.Transparency = 1
		tween(it.p, 0.3, { Transparency = 0.15 })
	end
	local high = g + Vector3.new(0, 70, 0)
	local land = g + Vector3.new(0, 1, 0)
	local t0 = os.clock()
	local fall0 = 0.2 + cross * 0.4
	local fallT = 0.2 + cross + crownAt - fall0
	local conn: RBXScriptConnection
	conn = RunService.Heartbeat:Connect(function()
		local t = os.clock() - t0
		local u = math.clamp((t - fall0) / fallT, 0, 1)
		gplace(crown, CFrame.new(high:Lerp(land, u ^ 2.5)) * CFrame.Angles(0, t * 1.2, 0))
		if u >= 1 then
			conn:Disconnect()
		end
	end)
	task.delay(0.2 + cross + crownAt, function()
		gfade(crown, 0.5)
		goldBlast(at, FR)
		crownSpikes(g, FR, 14, 18)
		for k = 0, 3 do
			task.delay(k * 0.08, function()
				Fx.ring(g + Vector3.new(0, 0.6 + k * 2, 0), k % 2 == 1 and CRIMSON or GOLD, 6, FR * 2.6 + k * 14, 0.8)
			end)
		end
		Fx.flash(g + Vector3.new(0, 8, 0), WHITE, 200, 12, 0.8)
		Fx.sound("heavy", 1, 0.3, g)
		Fx.breakSound("boom", 1, 0.35, g)
		shakeNear(g, 4, 260)
		if opts.flash and near(g, FR * 3) then
			opts.flash(WHITE, 0.4)
		end
		local av = avatars[data.id]
		if av then
			avatarEnd(av)
		end
	end)
end

local HANDLERS: { [string]: (any) -> () } = {
	kingArena = kingArena,
	kingAvatar = kingAvatar,
	kingImpact = kingImpact,
}
function Royal.handles(data: any): boolean
	return HANDLERS[data.kind] ~= nil
end
function Royal.run(data: any)
	local fn = HANDLERS[data.kind]
	if fn then
		fn(data)
	end
end

return Royal
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="41">
          <Properties>
            <string name="Name">Sakura</string>
            <string name="Source"><![CDATA[-- 권왕: 초월 권법 초·매화난무권의 화면 (벚꽃 부채, 흩날리는 꽃잎, 천본앵, 초 오의 만앵참월)
-- 벚꽃이 늘 앞에 서도록: 부채에서 꽃잎이 끊임없이 흘러내리고, 모든 기술이 꽃잎의 궤적을 남긴다
local Lighting = game:GetService("Lighting")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local Debris = game:GetService("Debris")

local Config = require(ReplicatedStorage:WaitForChild("Config"))
local Fx = require(script.Parent:WaitForChild("Fx"))
local Drunk = require(script.Parent:WaitForChild("Drunk"))
local Reaper = require(script.Parent:WaitForChild("Reaper"))
local Samsara = require(script.Parent:WaitForChild("Samsara"))
local Ult2 = require(script.Parent:WaitForChild("Ult2"))
local Whale = require(script.Parent:WaitForChild("Whale"))
local Star = require(script.Parent:WaitForChild("Star"))
local Mujo = require(script.Parent:WaitForChild("Mujo"))
local Dream = require(script.Parent:WaitForChild("Dream"))
local Null = require(script.Parent:WaitForChild("Null"))

local Sakura = {}
local player = Players.LocalPlayer

local PINKS = {
	Color3.fromRGB(255, 168, 204),
	Color3.fromRGB(255, 196, 222),
	Color3.fromRGB(255, 224, 238),
	Color3.fromRGB(255, 140, 188),
	Color3.fromRGB(255, 246, 250),
}
local PINK = Color3.fromRGB(255, 150, 200)
local PINK_DEEP = Color3.fromRGB(240, 90, 150)
local WHITE = Color3.new(1, 1, 1)
local TEX_SPARK = "rbxasset://textures/particles/sparkles_main.dds"

local folder = Instance.new("Folder")
folder.Name = "KwonSakura"
folder.Parent = workspace

local function tween(inst: Instance, time: number, goal: { [string]: any }, style: Enum.EasingStyle?, dir: Enum.EasingDirection?)
	local tw = TweenService:Create(inst, TweenInfo.new(time, style or Enum.EasingStyle.Quad, dir or Enum.EasingDirection.Out), goal)
	tw:Play()
	return tw
end
local function rootOf(m: Instance?): BasePart?
	local r = m and m:FindFirstChild("HumanoidRootPart")
	return (r and r:IsA("BasePart")) and r or nil
end
local function near(pos: Vector3, d: number): boolean
	local cam = workspace.CurrentCamera
	return cam ~= nil and (cam.CFrame.Position - pos).Magnitude < d
end
local function pinkAt(i: number?): Color3
	return PINKS[((i or math.random(1, 99)) % #PINKS) + 1]
end

-- 떠다니는 조각 (물리 없음)
local function part(size: Vector3, color: Color3, material: Enum.Material?, alpha: number?, ell: boolean?): Part
	local p = Instance.new("Part")
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	p.Size = size
	p.Color = color
	p.Material = material or Enum.Material.SmoothPlastic
	p.Transparency = alpha or 0
	if ell then
		local mesh = Instance.new("SpecialMesh")
		mesh.MeshType = Enum.MeshType.Sphere
		mesh.Parent = p
	end
	p.Parent = folder
	return p
end

------------------------------------------------------------------------
-- 꽃잎: 납작한 타원 조각이 팔랑이며 흩날린다 (한꺼번에 너무 많지 않게)
------------------------------------------------------------------------
local live = 0
local MAX_PETALS = 420
function Sakura.petals(pos: Vector3, n: number, spread: number, life: number, push: Vector3?, size: number?)
	local k = size or 1
	for _ = 1, n do
		if live >= MAX_PETALS then
			return
		end
		live += 1
		local p = part(Vector3.new(0.8, 0.07, 0.55) * k, pinkAt(), Enum.Material.SmoothPlastic, 0, true)
		local from = pos + Vector3.new(math.random() - 0.5, math.random() - 0.5, math.random() - 0.5) * spread * 0.4
		p.CFrame = CFrame.new(from) * CFrame.Angles(math.random() * 6, math.random() * 6, math.random() * 6)
		local drift = (push or Vector3.zero) + Vector3.new(math.random() - 0.5, math.random() * 0.6 - 0.1, math.random() - 0.5) * spread
		local l = life * (0.7 + math.random() * 0.6)
		tween(p, l, { CFrame = CFrame.new(from + drift - Vector3.new(0, l * 1.2, 0)) * CFrame.Angles(math.random() * 12, math.random() * 12, math.random() * 12), Transparency = 1 }, Enum.EasingStyle.Sine)
		task.delay(l, function()
			live -= 1
			p:Destroy()
		end)
	end
end
-- 꽃잎 입자 (가볍게 많이)
local function petalEmitter(parent: Instance, rate: number, size: number, speed: number, life: number): ParticleEmitter
	local pe = Instance.new("ParticleEmitter")
	pe.Texture = TEX_SPARK
	pe.Color = ColorSequence.new({ ColorSequenceKeypoint.new(0, PINKS[3]), ColorSequenceKeypoint.new(0.5, PINKS[1]), ColorSequenceKeypoint.new(1, PINKS[4]) })
	pe.LightEmission = 0.4
	pe.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, size), NumberSequenceKeypoint.new(1, size * 0.6) })
	pe.Squash = NumberSequence.new(0.5)
	pe.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.1), NumberSequenceKeypoint.new(0.8, 0.3), NumberSequenceKeypoint.new(1, 1) })
	pe.Lifetime = NumberRange.new(life * 0.7, life)
	pe.Rate = rate
	pe.Speed = NumberRange.new(speed * 0.4, speed)
	pe.SpreadAngle = Vector2.new(180, 180)
	pe.Rotation = NumberRange.new(0, 360)
	pe.RotSpeed = NumberRange.new(-180, 180)
	pe.Acceleration = Vector3.new(0, -2, 0)
	pe.Drag = 1.5
	pe.Parent = parent
	return pe
end

------------------------------------------------------------------------
-- 벚꽃 부채: 손에 쥔 손잡이에서 열한 개의 살이 퍼지고, 살 사이에 분홍 부채 면, 면 위에 다섯 잎 꽃
------------------------------------------------------------------------
local fans: { [Model]: { Instance } } = {}
local function weldTo(p: BasePart, hand: BasePart, cf: CFrame)
	p.Massless = true
	p.CFrame = hand.CFrame * cf
	local w = Instance.new("WeldConstraint")
	w.Part0 = hand
	w.Part1 = p
	w.Parent = p
	p.Anchored = false
end
local function buildFan(model: Model, hand: BasePart, side: number): { Instance }
	local out: { Instance } = {}
	local s = 1.0
	local base = CFrame.new(0, -0.35, 0) * CFrame.Angles(0, side * math.rad(12), 0)
	-- 부채 조각은 몸 밖의 폴더에 둔다 (몸의 조각을 도는 다른 효과가 부채까지 건드리지 않게). 용접으로 손을 따라간다
	local holder = Instance.new("Folder")
	holder.Name = "Fan_" .. model.Name
	holder.Parent = folder
	table.insert(out, holder)
	local function add(size: Vector3, cf: CFrame, color: Color3, mat: Enum.Material?, alpha: number?, ell: boolean?): Part
		local p = part(size * s, color, mat, alpha, ell)
		weldTo(p, hand, base * cf)
		p.Parent = holder
		table.insert(out, p)
		return p
	end
	local wood = Color3.fromRGB(70, 40, 30)
	local gold = Color3.fromRGB(240, 200, 120)
	add(Vector3.new(0.22, 0.4, 0.22), CFrame.new(0, 0.05, 0), wood, Enum.Material.Wood)
	add(Vector3.new(0.18, 0.18, 0.18), CFrame.new(0, 0.28, 0), gold, Enum.Material.Metal, 0, true)
	local R0, R1, L = 0.5, 2.2, 2.3
	local n = 11
	local spanA = math.rad(150)
	for i = 0, n - 1 do
		local th = -spanA / 2 + spanA * i / (n - 1)
		add(Vector3.new(0.06, L, 0.05), CFrame.Angles(0, 0, th) * CFrame.new(0, -L / 2, 0), wood, Enum.Material.Wood)
		if i < n - 1 then
			local tm = th + spanA / (n - 1) / 2
			local rm = (R0 + R1) / 2
			local w = 2 * rm * math.sin(spanA / (n - 1) / 2) * 1.12
			local col = PINKS[(i % 3) + 1]:Lerp(WHITE, (i % 2) * 0.15)
			add(Vector3.new(w, R1 - R0, 0.03), CFrame.Angles(0, 0, tm) * CFrame.new(0, -rm, 0.02), col, Enum.Material.SmoothPlastic)
			-- 바깥 테 (짙은 분홍)
			add(Vector3.new(w * 1.05, 0.12, 0.04), CFrame.Angles(0, 0, tm) * CFrame.new(0, -R1, 0.02), PINK_DEEP, Enum.Material.SmoothPlastic)
		end
	end
	-- 부채 면 위의 벚꽃 세 송이 (다섯 잎 + 금빛 꽃술)
	for k, at in ipairs({ { -0.5, 1.55 }, { 0.55, 1.35 }, { 0.05, 1.9 } }) do
		local c = CFrame.Angles(0, 0, at[1]) * CFrame.new(0, -at[2], 0.06)
		for j = 0, 4 do
			local a = j / 5 * math.pi * 2
			add(Vector3.new(0.26, 0.2, 0.02), c * CFrame.Angles(0, 0, a) * CFrame.new(0, 0.13, 0), k == 2 and WHITE or PINKS[4], Enum.Material.SmoothPlastic, 0, true)
		end
		add(Vector3.new(0.09, 0.09, 0.03), c, gold, Enum.Material.Neon, 0, true)
	end
	-- 부채 끝에서 꽃잎이 끊임없이 흘러내린다
	local tip = add(Vector3.new(0.1, 0.1, 0.1), CFrame.new(0, -R1, 0), WHITE, nil, 1)
	petalEmitter(tip, 9, 0.35, 1.5, 1.6)
	local glow = Instance.new("PointLight")
	glow.Color = PINK
	glow.Range = 7
	glow.Brightness = 0.6
	glow.Parent = tip
	return out
end
local function clearFans(model: Model)
	local list = fans[model]
	if list then
		for _, p in ipairs(list) do
			p:Destroy()
		end
		fans[model] = nil
	end
end
local builtFor: { [Model]: string } = {}
local waiting: { [Model]: boolean } = {}
local tryFans: (Model) -> ()
local function refreshFans(model: Model)
	local id = model:GetAttribute("Style")
	local st = type(id) == "string" and Config.STYLE_BY_ID[id] or nil
	if not st or not (st.fans or st.soju or st.scythe or st.gauntlets or st.pearls or st.staff or st.ashHalo or st.dreamMoon or st.nullCubes or Samsara.hasGear(st)) then
		clearFans(model)
		builtFor[model] = nil
		return
	end
	-- 같은 권법이면 다시 만들지 않는다
	if builtFor[model] == st.id and fans[model] then
		return
	end
	clearFans(model)
	builtFor[model] = st.id
	-- 먼저 자리를 잡아 둔다 (같은 몸을 두 번 만들지 않게)
	local list: { Instance } = {}
	fans[model] = list
	-- 초·취팔선권은 부채 대신 술병과 넥타이
	if st.soju then
		for _, p in ipairs(Drunk.build(model)) do
			table.insert(list, p)
		end
		return
	end
	-- 초·창해신권은 손목의 진주 고리와 물의 띠
	if st.pearls then
		for _, p in ipairs(Whale.buildGear(model)) do
			table.insert(list, p)
		end
		return
	end
	-- 3.8판 공백권은 몸 둘레에서 지직거리는 빈칸 상자 셋
	if st.nullCubes then
		for _, p in ipairs(Null.buildGear(model)) do
			table.insert(list, p)
		end
		return
	end
	-- 3.10판 몽유권은 머리 뒤의 초승달과 별
	if st.dreamMoon then
		for _, p in ipairs(Dream.buildGear(model)) do
			table.insert(list, p)
		end
		return
	end
	-- 3.6판 무상권은 머리 뒤의 이 빠진 은빛 후광
	if st.ashHalo then
		for _, p in ipairs(Mujo.buildGear(model)) do
			table.insert(list, p)
		end
		return
	end
	-- 3.4판 초·성하신권은 오른손의 별 지팡이
	if st.staff then
		for _, p in ipairs(Star.buildGear(model)) do
			table.insert(list, p)
		end
		return
	end
	-- 초·벽력신권은 두 팔의 뇌전 토시
	if st.gauntlets then
		for _, p in ipairs(Ult2.buildGauntlets(model)) do
			table.insert(list, p)
		end
		return
	end
	-- 3.0판 환생 권법: 윤회륜 · 사슬과 검은 불꽃 · 넋불과 안개 띠 · 관과 망토
	if Samsara.hasGear(st) then
		for _, p in ipairs(Samsara.buildGear(model, st)) do
			table.insert(list, p)
		end
		return
	end
	-- 초·혈마신수는 붉은 큰 낫과 손톱
	if st.scythe then
		for _, p in ipairs(Reaper.build(model)) do
			table.insert(list, p)
		end
		return
	end
	for _, pair in ipairs({ { "RightHand", 1 }, { "LeftHand", -1 } }) do
		local hand = model:FindFirstChild(pair[1])
		if hand and hand:IsA("BasePart") then
			for _, p in ipairs(buildFan(model, hand, pair[2])) do
				table.insert(list, p)
			end
		end
	end
end
-- 부채 권법일 때만 손이 생기기를 기다렸다가 만든다 (다른 몸은 기다리지 않는다)
function tryFans(model: Model)
	local id = model:GetAttribute("Style")
	local st = type(id) == "string" and Config.STYLE_BY_ID[id] or nil
	if not st or not (st.fans or st.soju or st.scythe or st.gauntlets or st.pearls or st.staff or st.ashHalo or st.dreamMoon or st.nullCubes or Samsara.hasGear(st)) then
		refreshFans(model)
		return
	end
	if builtFor[model] == st.id and fans[model] or waiting[model] then
		return
	end
	waiting[model] = true
	task.spawn(function()
		model:WaitForChild("RightHand", 10)
		model:WaitForChild(st.soju and "Head" or "LeftHand", 10)
		waiting[model] = nil
		refreshFans(model)
	end)
end
local watched: { [Model]: boolean } = {}
function Sakura.watch(model: Model)
	if watched[model] then
		return
	end
	watched[model] = true
	tryFans(model)
	model:GetAttributeChangedSignal("Style"):Connect(function()
		tryFans(model)
	end)
	-- 사라지는 기술 (만앵참월 등) 동안 부채도 감춘다
	model:GetAttributeChangedSignal("Vanish"):Connect(function()
		local hide = model:GetAttribute("Vanish") == true
		for _, p in ipairs(fans[model] or {}) do
			if p:IsA("BasePart") then
				p.LocalTransparencyModifier = hide and 1 or 0
			end
		end
	end)
	model.AncestryChanged:Connect(function()
		if not model.Parent then
			clearFans(model)
			watched[model] = nil
			builtFor[model] = nil
		end
	end)
end
-- 폴더 안의 모든 몸 (사부·적)
function Sakura.watchFolder(f: Instance)
	for _, m in ipairs(f:GetChildren()) do
		if m:IsA("Model") then
			Sakura.watch(m)
		end
	end
	f.ChildAdded:Connect(function(m)
		if m:IsA("Model") then
			Sakura.watch(m)
		end
	end)
end

-- 부채를 든 사람은 걸을 때마다 발밑에 꽃잎이 흩날린다
local walkAcc = 0
RunService.Heartbeat:Connect(function(dt)
	walkAcc += dt
	if walkAcc < 0.25 then
		return
	end
	walkAcc = 0
	for model in pairs(fans) do
		local r = rootOf(model)
		local sid = model:GetAttribute("Style")
		local st = type(sid) == "string" and Config.STYLE_BY_ID[sid] or nil
		if st and st.fans and r and near(r.Position, 110) and model:GetAttribute("Vanish") ~= true then
			local v = r.AssemblyLinearVelocity
			local moving = Vector3.new(v.X, 0, v.Z).Magnitude > 3
			Sakura.petals(r.Position + Vector3.new(0, moving and -1.5 or 1, 0), moving and 4 or 1, moving and 4 or 3, moving and 1.2 or 1.8, moving and -v * 0.15 or nil)
		end
	end
end)

------------------------------------------------------------------------
-- 기술마다 꽃잎의 궤적: 부채가 지나간 반달 모양 칼자국과 그 길을 따라 흩어지는 꽃잎
------------------------------------------------------------------------
local function crescent(cf: CFrame, radius: number, color: Color3, life: number, thick: number?)
	local segs = 9
	for i = 0, segs - 1 do
		local a = -1.1 + 2.2 * i / (segs - 1)
		local pos = cf * Vector3.new(math.sin(a) * radius, 0, -math.cos(a) * radius)
		local nxt = cf * Vector3.new(math.sin(a + 0.25) * radius, 0, -math.cos(a + 0.25) * radius)
		local w = (1 - math.abs(a) / 1.2) * (thick or 0.5) + 0.05
		local p = part(Vector3.new(w, w * 0.3, (nxt - pos).Magnitude * 1.2), i % 2 == 0 and color or WHITE, Enum.Material.Neon, 0.15, true)
		p.CFrame = CFrame.lookAt(pos, nxt)
		tween(p, life, { Transparency = 1, Size = p.Size * Vector3.new(0.3, 0.3, 1.3) })
		Debris:AddItem(p, life + 0.05)
	end
end
function Sakura.cast(styleId: any, slot: any, model: Model, dur: number)
	local st = type(styleId) == "string" and Config.STYLE_BY_ID[styleId] or nil
	if not st or not st.fans then
		return
	end
	local r = rootOf(model)
	if not r or not near(r.Position, 160) then
		return
	end
	local look = r.CFrame
	if type(slot) == "number" or slot == "H" or slot == "F" then
		-- 연타·강타: 앞쪽으로 반달 칼자국 하나 (강타는 크게), 꽃잎이 그 길을 따라
		local big = slot == "H"
		task.delay(math.min(0.12, dur * 0.35), function()
			local cf = look * CFrame.new(0, 0.6, -1) * CFrame.Angles(0, 0, (type(slot) == "number" and slot % 2 == 0) and 0.5 or -0.5)
			crescent(cf, big and 7 or 4.5, PINK, big and 0.4 or 0.28, big and 0.9 or 0.5)
			Sakura.petals((look * CFrame.new(0, 0.5, -3)).Position, big and 18 or 8, big and 8 or 5, 1.1, look.LookVector * (big and 10 or 5))
			-- 2.7판: 칼자국 끝에 벚꽃 한 송이가 활짝 피었다 흩어진다 (다섯 잎)
			local at = (look * CFrame.new(0, 0.8, big and -5 or -3.6)).Position
			local sz = big and 1.6 or 1.0
			for j = 0, 4 do
				local a = j / 5 * math.pi * 2
				local pe = part(Vector3.new(0.6, 0.05, 0.5) * sz, j % 2 == 0 and PINK or WHITE, Enum.Material.SmoothPlastic, 0.05, true)
				local cfA = CFrame.lookAt(at, at + look.LookVector) * CFrame.Angles(0, 0, a) * CFrame.Angles(math.rad(90), 0, 0)
				pe.CFrame = cfA
				tween(pe, 0.35, { CFrame = cfA * CFrame.new(0, 0, -0.9 * sz), Transparency = 1, Size = pe.Size * 1.6 })
				task.delay(0.4, function()
					pe:Destroy()
				end)
			end
		end)
	elseif slot == "E" then
		Sakura.petals(r.Position, 14, 6, 1.2)
	elseif slot == "R" then
		Sakura.petals(r.Position, 24, 6, 1.4)
	elseif slot == "G" or slot == "X" then
		Sakura.petals(r.Position + Vector3.new(0, 2, 0), 50, 14, 2.2)
		Fx.ring(r.Position - Vector3.new(0, 2.4, 0), PINK, 2, 30, 0.7)
	end
end

------------------------------------------------------------------------
-- 천본앵 (G): 둘레가 벚꽃 칼바람의 소용돌이. 세 겹의 꽃잎 고리가 돌며 좁아지고, 끝에 한가운데로 모여 터진다
------------------------------------------------------------------------
local storms: { [any]: any } = {}
local function stormRun(data: any)
	local m = data.m
	local r = rootOf(m)
	local center0 = data.at or (r and r.Position) or Vector3.zero
	if not near(center0, 300) then
		return
	end
	local radius = data.radius or 30
	local dur = data.dur or 3.5
	local rings = {}
	local blades = {}
	-- 세 겹의 꽃잎 고리 (안쪽일수록 빠르다)
	for ring = 1, 3 do
		local list = {}
		local count = 26 - ring * 4
		for i = 1, count do
			local p = part(Vector3.new(1.6, 0.1, 1.0) * (1.25 - ring * 0.12), pinkAt(i + ring), Enum.Material.SmoothPlastic, 0, true)
			table.insert(list, { p = p, a = i / count * math.pi * 2, h = (ring - 2) * 4 + math.random() * 2, spin = math.random() * 6 })
		end
		table.insert(rings, { list = list, r = radius * (0.35 + ring * 0.2), speed = (4.2 - ring) * 1.1 })
	end
	-- 칼날 같은 빛의 꽃잎 (길고 빛난다)
	for i = 1, 10 do
		local p = part(Vector3.new(0.35, 0.12, 4.2), i % 2 == 0 and WHITE or PINK, Enum.Material.Neon, 0.2, true)
		table.insert(blades, { p = p, a = i / 10 * math.pi * 2, h = math.random() * 6 - 1 })
	end
	-- 발밑의 꽃 진과 기둥처럼 솟는 꽃잎 회오리
	local disc = part(Vector3.new(0.2, radius * 2, radius * 2), PINK, Enum.Material.Neon, 0.75)
	disc.Shape = Enum.PartType.Cylinder
	disc.CFrame = CFrame.new(center0 - Vector3.new(0, 2.6, 0)) * CFrame.Angles(0, 0, math.rad(90))
	local column = part(Vector3.new(2, 2, 2), WHITE, nil, 1)
	column.Position = center0
	local pe = petalEmitter(column, 90, 0.7, 18, 2.2)
	pe.SpreadAngle = Vector2.new(25, 25)
	pe.Acceleration = Vector3.new(0, 10, 0)
	local light = Instance.new("PointLight")
	light.Color = PINK
	light.Range = 40
	light.Brightness = 2
	light.Parent = column
	Fx.sound("ping", 0.6, 0.6, center0)
	local t0 = os.clock()
	local key = {}
	storms[m or key] = { rings = rings, blades = blades, disc = disc, column = column }
	local conn
	conn = RunService.RenderStepped:Connect(function()
		local t = os.clock() - t0
		local rr = rootOf(m)
		local c = rr and rr.Position or center0
		local shrink = 1 - math.clamp(t / dur, 0, 1) * 0.35
		for _, ring in ipairs(rings) do
			for _, e in ipairs(ring.list) do
				local a = e.a + t * ring.speed
				local pos = c + Vector3.new(math.cos(a) * ring.r * shrink, e.h + math.sin(t * 3 + e.a) * 0.8, math.sin(a) * ring.r * shrink)
				e.p.CFrame = CFrame.new(pos) * CFrame.Angles(t * 4 + e.spin, a, t * 3)
			end
		end
		for _, b in ipairs(blades) do
			local a = b.a - t * 5
			local rad = radius * 0.55 * shrink
			local pos = c + Vector3.new(math.cos(a) * rad, b.h, math.sin(a) * rad)
			b.p.CFrame = CFrame.lookAt(pos, pos + Vector3.new(-math.sin(a), 0, math.cos(a)))
		end
		disc.CFrame = CFrame.new(c - Vector3.new(0, 2.6, 0)) * CFrame.Angles(0, t * 0.8, math.rad(90))
		column.Position = c
		if t > dur + 0.6 then
			conn:Disconnect()
		end
	end)
	task.delay(dur + 0.7, function()
		local s = storms[m or key]
		if s then
			for _, ring in ipairs(s.rings) do
				for _, e in ipairs(ring.list) do
					e.p:Destroy()
				end
			end
			for _, b in ipairs(s.blades) do
				b.p:Destroy()
			end
			s.disc:Destroy()
			s.column:Destroy()
			storms[m or key] = nil
		end
	end)
end
local function stormBurst(data: any)
	local at = data.at
	if not at or not near(at, 300) then
		return
	end
	local radius = data.radius or 30
	-- 고리들이 한가운데로 모여든 뒤 꽃처럼 터진다
	for _, s in pairs(storms) do
		for _, ring in ipairs(s.rings) do
			for _, e in ipairs(ring.list) do
				tween(e.p, 0.22, { CFrame = CFrame.new(at + Vector3.new(0, 1, 0)), Transparency = 0.6 }, Enum.EasingStyle.Quint, Enum.EasingDirection.In)
			end
		end
	end
	task.delay(0.22, function()
		Fx.blast(at, PINK, WHITE, 3)
		Fx.flash(at, PINK, 80, 5, 0.6)
		Fx.ring(at - Vector3.new(0, 2.3, 0), PINK, 4, radius * 2.4, 0.6)
		Fx.ring(at + Vector3.new(0, 1, 0), WHITE, 2, radius * 1.6, 0.45)
		Sakura.petals(at + Vector3.new(0, 2, 0), 90, radius * 1.4, 2.4)
		-- 하늘로 솟는 꽃잎 기둥
		local col = part(Vector3.new(radius * 0.7, 60, radius * 0.7), PINKS[3], Enum.Material.Neon, 0.3)
		col.Shape = Enum.PartType.Cylinder
		col.Size = Vector3.new(60, radius * 0.7, radius * 0.7)
		col.CFrame = CFrame.new(at + Vector3.new(0, 28, 0)) * CFrame.Angles(0, 0, math.rad(90))
		tween(col, 0.7, { Size = Vector3.new(70, 0.5, 0.5), Transparency = 1 })
		Debris:AddItem(col, 0.75)
	end)
end

------------------------------------------------------------------------
-- 만앵참월 (X, 초 오의)
------------------------------------------------------------------------
local cuts: { [any]: { BasePart } } = {}
local grey: ColorCorrectionEffect? = nil
local function mineOrNear(data: any, d: number): boolean
	local me = player.Character
	if data.m and data.m == me then
		return true
	end
	local r = rootOf(me)
	return r ~= nil and data.at ~= nil and (r.Position - data.at).Magnitude < d
end
local function setGrey(on: boolean, time: number)
	if not grey then
		local cc = Instance.new("ColorCorrectionEffect")
		cc.Name = "KwonSakuraGrey"
		cc.Parent = Lighting
		grey = cc
	end
	local cc = grey :: ColorCorrectionEffect
	tween(cc, time, { Saturation = on and -1 or 0, Contrast = on and 0.25 or 0, Brightness = on and -0.06 or 0, TintColor = on and Color3.fromRGB(235, 235, 240) or WHITE })
end

-- 화면 위의 큰 글자와 칼자국 (내 화면에서만)
local function screenGui(): ScreenGui
	local pg = player:WaitForChild("PlayerGui")
	local g = Instance.new("ScreenGui")
	g.Name = "KwonSever"
	g.IgnoreGuiInset = true
	g.ResetOnSpawn = false
	g.DisplayOrder = 80
	g.Parent = pg
	return g
end
local function bigName(name: string, life: number)
	local g = screenGui()
	local t = Instance.new("TextLabel")
	t.BackgroundTransparency = 1
	t.AnchorPoint = Vector2.new(0.5, 0.5)
	t.Position = UDim2.fromScale(0.5, 0.42)
	t.Size = UDim2.fromScale(0.8, 0.16)
	t.Font = Enum.Font.GothamBlack
	t.TextScaled = true
	t.Text = name
	t.TextColor3 = Color3.fromRGB(255, 236, 246)
	t.TextTransparency = 1
	t.TextStrokeColor3 = PINK_DEEP
	t.TextStrokeTransparency = 1
	t.Parent = g
	tween(t, 0.25, { TextTransparency = 0, TextStrokeTransparency = 0.2 })
	task.delay(life, function()
		tween(t, 0.3, { TextTransparency = 1, TextStrokeTransparency = 1 })
		Debris:AddItem(g, 0.35)
	end)
end
-- 세 점을 잇는 삼각형 (쐐기 두 개)을 카메라 기준 좌표로 만든다
local function triangle(a: Vector3, b: Vector3, c: Vector3, color: Color3, alpha: number): { { p: BasePart, cf: CFrame } }
	local ab, ac, bc = b - a, c - a, c - b
	local abd, acd, bcd = ab:Dot(ab), ac:Dot(ac), bc:Dot(bc)
	if abd > acd and abd > bcd then
		c, a = a, c
	elseif acd > bcd and acd > abd then
		a, b = b, a
	end
	ab, ac, bc = b - a, c - a, c - b
	local right = ac:Cross(ab).Unit
	local up = bc:Cross(right).Unit
	local back = bc.Unit
	local height = math.abs(ab:Dot(up))
	local out = {}
	for i, side in ipairs({ { (a + b) / 2, right, math.abs(ab:Dot(back)), back }, { (a + c) / 2, -right, math.abs(ac:Dot(back)), -back } }) do
		local w = Instance.new("WedgePart")
		w.Anchored = true
		w.CanCollide = false
		w.CanQuery = false
		w.CanTouch = false
		w.CastShadow = false
		w.Material = Enum.Material.Glass
		w.Color = color
		w.Reflectance = 0.25
		w.Transparency = alpha
		w.Size = Vector3.new(0.02, math.max(height, 0.01), math.max(side[3], 0.01))
		w.Parent = folder
		out[i] = { p = w, cf = CFrame.fromMatrix(side[1], side[2], up, side[4]) }
	end
	return out
end

-- 갈라진 화면이 유리처럼 산산이 깨져 흩어진다 (내 화면에서만)
local function screenShatter(g: ScreenGui, angle: number, onBreak: (() -> ())?)
	local cam = workspace.CurrentCamera
	if not cam then
		if onBreak then
			onBreak()
		end
		return
	end
	local vp = cam.ViewportSize
	local W, H = math.max(vp.X, 1), math.max(vp.Y, 1)
	local cx, cy = W * 0.5 + math.random(-30, 30), H * 0.5
	-- 칼자국 위의 한 점에서 사방으로 조각이 나뉜다: 칼자국 방향 두 줄 + 무작위 줄기
	local rays: { number } = { math.rad(angle), math.rad(angle) + math.pi }
	local N = 14
	for i = 1, N - 2 do
		table.insert(rays, (i / (N - 2)) * math.pi * 2 + math.random() * 0.35)
	end
	table.sort(rays)
	local diag = math.sqrt(W * W + H * H)
	local radii = { diag * (0.07 + math.random() * 0.04), diag * (0.2 + math.random() * 0.08), diag * 0.8 }
	-- rings[k][i]: k번째 고리, i번째 줄기의 점 (화면 픽셀)
	local rings: { { Vector2 } } = {}
	for k, r in ipairs(radii) do
		rings[k] = {}
		for i, a in ipairs(rays) do
			local rr = k < #radii and r * (0.75 + math.random() * 0.5) or r
			rings[k][i] = Vector2.new(cx + math.cos(a) * rr, cy + math.sin(a) * rr)
		end
	end
	local center = Vector2.new(cx, cy)

	-- 2) 화면 앞에 깔린 유리 조각들
	local depth = 2
	local h = depth * math.tan(math.rad(cam.FieldOfView) * 0.5)
	local function toCam(v: Vector2): Vector3
		return Vector3.new((v.X - W * 0.5) / (H * 0.5) * h, -(v.Y - H * 0.5) / (H * 0.5) * h, -depth)
	end
	local tris: { { Vector2 } } = {}
	for i = 1, #rays do
		local j = i % #rays + 1
		table.insert(tris, { center, rings[1][i], rings[1][j] })
		for k = 1, #radii - 1 do
			table.insert(tris, { rings[k][i], rings[k + 1][i], rings[k + 1][j] })
			table.insert(tris, { rings[k][i], rings[k + 1][j], rings[k][j] })
		end
	end
	type Shard = { parts: { { p: BasePart, cf: CFrame } }, mid: Vector3, vel: Vector3, spin: Vector3, cf: CFrame }
	local shards: { Shard } = {}
	for n, t in ipairs(tris) do
		local a, b, c = toCam(t[1]), toCam(t[2]), toCam(t[3])
		local mid = (a + b + c) / 3
		local tint = n % 3 == 0 and Color3.fromRGB(255, 205, 228) or Color3.fromRGB(236, 236, 244)
		local parts = triangle(a - mid, b - mid, c - mid, tint, 0.82)
		local outward = Vector3.new(mid.X, mid.Y, 0)
		outward = outward.Magnitude > 0.001 and outward.Unit or Vector3.new(0, 1, 0)
		local close = 1 - math.clamp(Vector3.new(mid.X, mid.Y, 0).Magnitude / (h * 2), 0, 1)
		table.insert(shards, {
			parts = parts,
			mid = mid,
			vel = outward * (1.2 + close * 2.6 + math.random() * 1.2) + Vector3.new(0, 0.6 + math.random() * 0.8, -(0.8 + math.random() * 1.6)),
			spin = Vector3.new(math.random() - 0.5, math.random() - 0.5, math.random() - 0.5) * 9,
			cf = CFrame.new(),
		})
	end
	local function place()
		local base = cam.CFrame
		for _, s in ipairs(shards) do
			local cf = base * CFrame.new(s.mid) * s.cf
			for _, w in ipairs(s.parts) do
				w.p.CFrame = cf * w.cf
			end
		end
	end
	local holdConn = RunService.RenderStepped:Connect(place)
	place()

	-- 3) 깨진다: 조각이 사방으로 튀며 떨어지고, 잿빛이 풀린다
	task.delay(0.2, function()
		holdConn:Disconnect()
		Fx.breakSound("glass", 1, 1)
		Fx.sound("block", 0.8, 0.7)
		if onBreak then
			onBreak()
		end
		local flash = Instance.new("Frame")
		flash.Size = UDim2.fromScale(1, 1)
		flash.BorderSizePixel = 0
		flash.BackgroundColor3 = Color3.fromRGB(255, 235, 245)
		flash.BackgroundTransparency = 0.25
		flash.ZIndex = 7
		flash.Parent = g
		tween(flash, 0.35, { BackgroundTransparency = 1 })
		for _, s in ipairs(shards) do
			for _, w in ipairs(s.parts) do
				w.p.Transparency = 0.45
				w.p.Material = Enum.Material.Glass
				tween(w.p, 1.1, { Transparency = 1 }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
			end
		end
		local t0 = os.clock()
		local conn
		conn = RunService.RenderStepped:Connect(function(dt)
			local t = os.clock() - t0
			if t > 1.15 then
				conn:Disconnect()
				for _, s in ipairs(shards) do
					for _, w in ipairs(s.parts) do
						w.p:Destroy()
					end
				end
				return
			end
			for _, s in ipairs(shards) do
				s.vel += Vector3.new(0, -9 * dt, 0)
				s.mid += s.vel * dt
				s.cf *= CFrame.Angles(s.spin.X * dt, s.spin.Y * dt, s.spin.Z * dt)
			end
			place()
		end)
		-- 화면 가장자리로 튀는 꽃잎 조각
		Sakura.petals(cam.CFrame.Position + cam.CFrame.LookVector * 6, 40, 5, 1.4)
	end)
end

-- 화면을 비스듬히 한칼에 가르고, 두 쪽이 갈라지며 빛이 새어 나온 뒤 산산이 깨진다
local function screenSplit(onBreak: (() -> ())?)
	local g = screenGui()
	local angle = -26
	local holder = Instance.new("Frame")
	holder.BackgroundTransparency = 1
	holder.Size = UDim2.fromScale(1, 1)
	holder.Parent = g
	local function band(color: Color3, alpha: number, thick: number, z: number): Frame
		local f = Instance.new("Frame")
		f.AnchorPoint = Vector2.new(0.5, 0.5)
		f.Position = UDim2.fromScale(0.5, 0.5)
		f.Size = UDim2.new(0, 0, 0, thick)
		f.Rotation = angle
		f.BorderSizePixel = 0
		f.BackgroundColor3 = color
		f.BackgroundTransparency = alpha
		f.ZIndex = z
		f.Parent = holder
		local gr = Instance.new("UIGradient")
		gr.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.15, 0), NumberSequenceKeypoint.new(0.85, 0), NumberSequenceKeypoint.new(1, 1) })
		gr.Parent = f
		return f
	end
	-- 두 쪽 (위·아래): 어둡게 비치는 큰 판이 칼자국을 따라 갈라진다
	local halves: { Frame } = {}
	for _, s in ipairs({ -1, 1 }) do
		local f = Instance.new("Frame")
		f.AnchorPoint = Vector2.new(0.5, s < 0 and 1 or 0)
		f.Position = UDim2.fromScale(0.5, 0.5)
		f.Size = UDim2.fromScale(3, 3)
		f.Rotation = angle
		f.BorderSizePixel = 0
		f.BackgroundColor3 = Color3.fromRGB(20, 10, 16)
		f.BackgroundTransparency = 1
		f.ZIndex = 2
		f.Parent = holder
		table.insert(halves, f)
	end
	local glow = band(Color3.fromRGB(255, 120, 180), 0.2, 26, 3)
	local core = band(WHITE, 0, 6, 4)
	-- 1) 한 줄기 칼날이 화면을 가로지른다
	tween(glow, 0.09, { Size = UDim2.new(2.6, 0, 0, 26) }, Enum.EasingStyle.Quint)
	tween(core, 0.09, { Size = UDim2.new(2.6, 0, 0, 6) }, Enum.EasingStyle.Quint)
	task.delay(0.1, function()
		-- 2) 두 쪽이 갈라지며 틈으로 빛이 새어 나온다
		local rad = math.rad(angle)
		local nx, ny = -math.sin(rad), math.cos(rad)
		for i, f in ipairs(halves) do
			local s = i == 1 and -1 or 1
			f.BackgroundTransparency = 0.82
			tween(f, 0.28, { Position = UDim2.new(0.5, nx * 46 * s, 0.5, ny * 46 * s) }, Enum.EasingStyle.Back)
		end
		tween(glow, 0.28, { Size = UDim2.new(2.6, 0, 0, 120), BackgroundTransparency = 0.35 }, Enum.EasingStyle.Back)
		tween(core, 0.28, { Size = UDim2.new(2.6, 0, 0, 40) }, Enum.EasingStyle.Back)
	end)
	task.delay(0.5, function()
		-- 3) 갈라진 화면이 유리처럼 깨진다
		screenShatter(g, angle, function()
			for _, f in ipairs(halves) do
				tween(f, 0.25, { BackgroundTransparency = 1 })
			end
			tween(glow, 0.3, { Size = UDim2.new(2.6, 0, 0, 260), BackgroundTransparency = 1 })
			tween(core, 0.2, { Size = UDim2.new(2.6, 0, 0, 0), BackgroundTransparency = 1 })
			if onBreak then
				onBreak()
			end
		end)
		Debris:AddItem(g, 1.8)
	end)
end

local function severCut(data: any)
	local from, to = data.from, data.to
	if not from or not to or not near(to, 300) then
		return
	end
	-- 지나간 길보다 길게, 가슴 높이에 비스듬히 남는 하늘의 칼자국
	local dir = to - from
	if dir.Magnitude < 0.5 then
		dir = Vector3.new(0, 0, -1)
	end
	local mid = (from + to) / 2 + Vector3.new(0, 1.5, 0)
	local len = dir.Magnitude + 14
	local cf = CFrame.lookAt(mid, mid + dir) * CFrame.Angles(0, 0, (math.random() - 0.5) * 1.6)
	local glow = part(Vector3.new(1.6, 0.25, len), PINK, Enum.Material.Neon, 0.35, true)
	glow.CFrame = cf
	local core = part(Vector3.new(0.45, 0.12, len * 0.98), WHITE, Enum.Material.Neon, 0, true)
	core.CFrame = cf
	glow.Size = Vector3.new(1.6, 0.25, 0.5)
	core.Size = Vector3.new(0.45, 0.12, 0.5)
	tween(glow, 0.08, { Size = Vector3.new(1.6, 0.25, len) })
	tween(core, 0.08, { Size = Vector3.new(0.45, 0.12, len * 0.98) })
	local key = data.style or "x"
	cuts[key] = cuts[key] or {}
	table.insert(cuts[key], glow)
	table.insert(cuts[key], core)
	Sakura.petals(data.at or to, 14, 5, 1.2, dir.Unit * 8)
	Fx.burst("spark", data.at or to, WHITE, 8, 1)
	Fx.sound("ping", 0.4, 1.8 + (data.i or 0) * 0.05, to)
	-- 오래 남지 않게 (끝을 못 보면 스스로 사라진다)
	Debris:AddItem(glow, 6)
	Debris:AddItem(core, 6)
end

local function severStill(data: any)
	if mineOrNear(data, 160) then
		setGrey(true, 0.12)
		if data.m == player.Character then
			bigName("만앵참월", (data.dur or 0.9) + 1.0)
		end
	end
	-- 멈춘 세상에서 칼자국만 숨 쉬듯 빛난다
	for _, list in pairs(cuts) do
		for _, p in ipairs(list) do
			if p.Parent then
				tween(p, 0.4, { Transparency = 0 }, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut)
			end
		end
	end
	Fx.sound("ping", 0.7, 0.45, data.at)
end

local function severWind(data: any)
	local dur = data.dur or 1.3
	for _, m in ipairs(data.targets or {}) do
		local r = rootOf(m)
		if r and near(r.Position, 260) then
			-- 적마다 칼바람의 회오리: 도는 초승달 칼날 여섯, 솟구치는 꽃잎과 흰 바람
			local blades = {}
			for i = 1, 6 do
				local p = part(Vector3.new(0.3, 0.1, 3.6), i % 2 == 0 and WHITE or PINK, Enum.Material.Neon, 0.15, true)
				table.insert(blades, { p = p, a = i / 6 * math.pi * 2, h = (i % 3) * 1.4 - 1 })
			end
			local holder = part(Vector3.new(1, 1, 1), WHITE, nil, 1)
			holder.Position = r.Position
			local pe = petalEmitter(holder, 60, 0.55, 14, 1.0)
			pe.SpreadAngle = Vector2.new(30, 30)
			pe.Acceleration = Vector3.new(0, 18, 0)
			local t0 = os.clock()
			local conn
			conn = RunService.RenderStepped:Connect(function()
				local t = os.clock() - t0
				local rr = rootOf(m)
				local c = rr and rr.Position or holder.Position
				holder.Position = c
				for _, b in ipairs(blades) do
					local a = b.a + t * 9
					local rad = 3.2 + math.sin(t * 6 + b.a) * 0.6
					local pos = c + Vector3.new(math.cos(a) * rad, b.h + t * 1.2, math.sin(a) * rad)
					b.p.CFrame = CFrame.lookAt(pos, pos + Vector3.new(-math.sin(a), 0.3, math.cos(a)))
				end
				if t > dur then
					conn:Disconnect()
					for _, b in ipairs(blades) do
						b.p:Destroy()
					end
					pe.Enabled = false
					Debris:AddItem(holder, 1.2)
				end
			end)
		end
	end
end

------------------------------------------------------------------------
-- 2.3판: 초 오의 만앵참월에 거대한 벚꽃나무. 쓴 사람 뒤 땅에서 솟아 가지를 펴고 꽃을 피운다.
-- 꽃이 쏟아지는 동안 서 있다가, 마지막 일격에 꽃잎이 한꺼번에 흩어지며 사라진다
------------------------------------------------------------------------
type Tree = { trunk: { BasePart }, blooms: { BasePart }, base: Vector3 }
local trees: { [Instance]: Tree } = {}
local BARK = Color3.fromRGB(86, 52, 44)
local function limb(a: Vector3, b: Vector3, w: number): Part
	local p = part(Vector3.new(w, w, math.max(0.2, (b - a).Magnitude + w * 0.4)), BARK, Enum.Material.Wood, 0)
	p.CFrame = CFrame.lookAt((a + b) / 2, b)
	return p
end
local function growTree(m: Instance, r: BasePart)
	local old = trees[m]
	if old then
		for _, p in ipairs(old.trunk) do
			p:Destroy()
		end
		for _, p in ipairs(old.blooms) do
			p:Destroy()
		end
	end
	local look = Vector3.new(r.CFrame.LookVector.X, 0, r.CFrame.LookVector.Z)
	look = look.Magnitude > 1e-3 and look.Unit or Vector3.new(0, 0, -1)
	local right = Vector3.new(-look.Z, 0, look.X)
	local base = r.Position - look * 16 - Vector3.new(0, 2.6, 0)
	local t: Tree = { trunk = {}, blooms = {}, base = base }
	trees[m] = t
	-- 줄기: 다섯 마디가 조금씩 휘며 오른다
	local pts = { base }
	local p = base
	for i = 1, 5 do
		p = p + Vector3.new(0, 5.2, 0) + right * math.sin(i * 1.3) * 1.2 - look * 0.4
		table.insert(pts, p)
	end
	for i = 1, 5 do
		table.insert(t.trunk, limb(pts[i], pts[i + 1], 3.4 - i * 0.4))
	end
	-- 뿌리 셋
	for k = 0, 2 do
		local a = k * math.pi * 2 / 3 + 0.4
		local d = look * math.cos(a) + right * math.sin(a)
		table.insert(t.trunk, limb(base + Vector3.new(0, 1, 0), base + d * 5 - Vector3.new(0, 0.5, 0), 1.6))
	end
	-- 가지 일곱과 그 끝의 꽃송이
	local ends = {}
	for k = 1, 7 do
		local from = pts[3 + (k % 3)]
		local a = k * 2.4
		local d = (look * math.cos(a) + right * math.sin(a)) * (6 + (k % 3) * 2.5) + Vector3.new(0, 4 + (k % 2) * 3, 0)
		local mid = from + d * 0.55 + Vector3.new(0, 1.2, 0)
		table.insert(t.trunk, limb(from, mid, 1.3))
		table.insert(t.trunk, limb(mid, from + d, 0.8))
		table.insert(ends, from + d)
	end
	table.insert(ends, pts[6] + Vector3.new(0, 2, 0))
	for i, e in ipairs(ends) do
		for j = 0, 2 do
			local sz = 7 + ((i + j) % 3) * 2.2
			local b = part(Vector3.new(sz, sz * 0.7, sz), pinkAt(i + j), Enum.Material.SmoothPlastic, 0.05, true)
			b.CFrame = CFrame.new(e + Vector3.new((j - 1) * 2.6, (j % 2) * 1.6, ((i + j) % 2 - 0.5) * 2.4))
			table.insert(t.blooms, b)
		end
	end
	-- 땅에서 솟는다: 나무 전체를 아래에서 끌어올리고, 꽃송이는 0에서 피어난다
	local sink = Vector3.new(0, -30, 0)
	for _, q in ipairs(t.trunk) do
		local cf = q.CFrame
		q.CFrame = cf + sink
		tween(q, 0.7, { CFrame = cf }, Enum.EasingStyle.Back)
	end
	for i, b in ipairs(t.blooms) do
		local full = b.Size
		b.Size = Vector3.new(0.2, 0.2, 0.2)
		task.delay(0.55 + (i % 6) * 0.04, function()
			if b.Parent then
				tween(b, 0.4, { Size = full }, Enum.EasingStyle.Back)
			end
		end)
		if i % 3 == 0 then
			local a = Instance.new("Attachment")
			a.Parent = b
			petalEmitter(a, 14, 0.5, 4, 2.6)
		end
	end
	Fx.dust(base + Vector3.new(0, 1, 0), 10)
	Fx.sound("heavy", 0.8, 0.6, base)
end
local function treeFall(m: Instance)
	local t = trees[m]
	if not t then
		return
	end
	trees[m] = nil
	for _, b in ipairs(t.blooms) do
		if b.Parent then
			Sakura.petals(b.CFrame.Position, 14, b.Size.X, 2.4, Vector3.new(0, 2, 0))
			tween(b, 0.35, { Size = b.Size * 1.4, Transparency = 1 })
			Debris:AddItem(b, 0.4)
		end
	end
	for _, q in ipairs(t.trunk) do
		tween(q, 1.2, { Transparency = 1 })
		Debris:AddItem(q, 1.25)
	end
end

local function severEnd(data: any)
	treeFall(data.m)
	local at = data.at
	for _, m in ipairs(data.targets or {}) do
		local r = rootOf(m)
		if r and near(r.Position, 300) then
			Fx.blast(r.Position, PINK, WHITE, 2.6)
			Fx.flash(r.Position, PINK, 40, 4, 0.4)
			Sakura.petals(r.Position, 26, 12, 1.8)
		end
	end
	if at and near(at, 300) then
		Fx.ring(at - Vector3.new(0, 2.3, 0), PINK, 4, (data.radius or 22) * 2.6, 0.6)
		Fx.flash(at, WHITE, 90, 5, 0.5)
	end
	-- 하늘의 칼자국이 꽃잎으로 부서진다
	for key, list in pairs(cuts) do
		for _, p in ipairs(list) do
			if p.Parent then
				local pos = p.Position
				tween(p, 0.25, { Size = p.Size * Vector3.new(3, 3, 1.1), Transparency = 1 })
				Debris:AddItem(p, 0.3)
				Sakura.petals(pos, 8, p.Size.Z * 0.5, 1.6)
			end
		end
		cuts[key] = nil
	end
	if mineOrNear(data, 160) then
		-- 화면을 한칼에 가르고, 잿빛이 풀리며 분홍빛이 번진다
		screenSplit(function()
			setGrey(false, 0.35)
		end)
	end
	Fx.sound("ping", 1, 0.35, at)
end

local function severStart(data: any)
	local r = rootOf(data.m)
	if r and near(r.Position, 300) then
		Sakura.petals(r.Position, 40, 6, 1.4)
		Fx.flash(r.Position, WHITE, 30, 3, 0.25)
		growTree(data.m, r)
	end
	-- 마지막 일격을 못 받더라도 나무는 스스로 진다
	local m = data.m
	task.delay((data.dur or 4) + 1.2, function()
		treeFall(m)
	end)
	-- 끝을 못 받더라도 잿빛은 스스로 풀린다
	task.delay((data.dur or 4) + 1.5, function()
		if grey and grey.Saturation < -0.1 then
			setGrey(false, 0.4)
		end
	end)
end

local HANDLERS: { [string]: (any) -> () } = {
	sakuraStorm = stormRun,
	sakuraBurst = stormBurst,
	severStart = severStart,
	severCut = severCut,
	severStill = severStill,
	severWind = severWind,
	severEnd = severEnd,
}
function Sakura.handles(kind: any): boolean
	return type(kind) == "string" and HANDLERS[kind] ~= nil
end
function Sakura.run(data: any)
	local h = HANDLERS[data.kind]
	if h then
		h(data)
	end
end

-- 초 오의를 펼칠 때 (내 화면): 화면 가장자리가 벚꽃빛으로 물들고, 꽃잎이 화면 가득 쏟아진다
function Sakura.superIntro(model: Model)
	local r = rootOf(model)
	if r then
		Sakura.petals(r.Position + Vector3.new(0, 3, 0), 60, 16, 2.4)
		Fx.sigil(r.Position - Vector3.new(0, 2.6, 0), 20, PINK, WHITE, 1.4)
	end
	local g = screenGui()
	local edge = Instance.new("Frame")
	edge.Size = UDim2.fromScale(1, 1)
	edge.BackgroundTransparency = 1
	edge.Parent = g
	local st = Instance.new("UIStroke")
	st.Color = PINK
	st.Thickness = 60
	st.Transparency = 0.2
	st.Parent = edge
	tween(st, 1.2, { Transparency = 1, Thickness = 10 })
	-- 화면 위로 흩날리는 꽃잎 (글자 대신 둥근 판)
	for i = 1, 26 do
		local p = Instance.new("Frame")
		p.AnchorPoint = Vector2.new(0.5, 0.5)
		p.Position = UDim2.fromScale(math.random(), -0.05)
		local s = math.random(10, 22)
		p.Size = UDim2.fromOffset(s, s * 0.65)
		p.Rotation = math.random(0, 360)
		p.BackgroundColor3 = pinkAt(i)
		p.BorderSizePixel = 0
		p.Parent = g
		local cr = Instance.new("UICorner")
		cr.CornerRadius = UDim.new(1, 0)
		cr.Parent = p
		tween(p, 1.4 + math.random(), { Position = UDim2.fromScale(math.random(), 1.05), Rotation = p.Rotation + math.random(-360, 360), BackgroundTransparency = 0.6 }, Enum.EasingStyle.Sine)
	end
	Debris:AddItem(g, 2.6)
end

return Sakura
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="42">
          <Properties>
            <string name="Name">Samsara</string>
            <string name="Source"><![CDATA[-- 권왕 3.0판: 환생 권법 넷 (윤회권 · 업화권 · 무상권 · 권왕신권) 의 몸에 두르는 것과 기술 (화면)
-- 윤회권: 등 뒤의 금빛 윤회륜 · 업화권: 두 팔의 달군 사슬과 검은 불꽃 · 무상권: 몸 둘레의 넋불과 안개 띠
-- 권왕신권: 머리 위의 금빛 관 · 붉은 망토 · 금빛 팔찌
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local Config = require(ReplicatedStorage:WaitForChild("Config"))
local Fx = require(script.Parent:WaitForChild("Fx"))

local Samsara = {}

local folder = Instance.new("Folder")
folder.Name = "KwonSamsara"
folder.Parent = workspace

local opts: any = {}
function Samsara.init(o: any)
	opts = o or {}
end

local GOLD = Color3.fromRGB(255, 214, 110)
local GOLD_DEEP = Color3.fromRGB(220, 160, 50)
local INDIGO = Color3.fromRGB(120, 90, 255)
local WHITE = Color3.new(1, 1, 1)
local EMBER = Color3.fromRGB(255, 70, 30)
local HELL = Color3.fromRGB(200, 25, 20)
local CHAR = Color3.fromRGB(28, 10, 14)
local MIST = Color3.fromRGB(225, 232, 242)
local GHOST = Color3.fromRGB(140, 230, 255)
local CRIMSON = Color3.fromRGB(190, 25, 40)
-- 여섯 갈래 세상의 빛깔
local REALMS = { Color3.fromRGB(255, 255, 255), Color3.fromRGB(255, 214, 90), Color3.fromRGB(255, 80, 80), Color3.fromRGB(110, 230, 140), Color3.fromRGB(110, 170, 255), Color3.fromRGB(200, 120, 255) }
local TEX_FIRE = "rbxasset://textures/particles/fire_main.dds"
local TEX_SMOKE = "rbxasset://textures/particles/smoke_main.dds"

local function tween(inst: Instance, time: number, goal: { [string]: any }, style: Enum.EasingStyle?, dir: Enum.EasingDirection?)
	local tw = TweenService:Create(inst, TweenInfo.new(math.max(0.01, time), style or Enum.EasingStyle.Quad, dir or Enum.EasingDirection.Out), goal)
	tw:Play()
	return tw
end
local function near(pos: Vector3, d: number): boolean
	local cam = workspace.CurrentCamera
	return cam ~= nil and (cam.CFrame.Position - pos).Magnitude < d
end
local function ground(at: Vector3): Vector3
	return Vector3.new(at.X, at.Y - 2.7, at.Z)
end
local function part(size: Vector3, color: Color3, material: Enum.Material?, alpha: number?, shape: string?): BasePart
	local q = Instance.new("Part")
	if shape == "ball" then
		q.Shape = Enum.PartType.Ball
	elseif shape == "cyl" then
		q.Shape = Enum.PartType.Cylinder
	end
	q.Anchored = true
	q.CanCollide = false
	q.CanQuery = false
	q.CanTouch = false
	q.CastShadow = false
	q.Size = size
	q.Color = color
	q.Material = material or Enum.Material.SmoothPlastic
	q.Transparency = alpha or 0
	q.Parent = folder
	return q
end
local function fadeOut(p: BasePart, time: number, goal: { [string]: any }?)
	local g = goal or {}
	g.Transparency = 1
	tween(p, time, g)
	task.delay(time + 0.05, function()
		p:Destroy()
	end)
end
local function shakeNear(pos: Vector3, amount: number, range: number)
	if opts.shake and near(pos, range) then
		opts.shake(amount)
	end
end
-- 프레임마다 u (0 → 1)
local function anim(life: number, fn: (number) -> ())
	local t0 = os.clock()
	local conn: RBXScriptConnection
	conn = RunService.Heartbeat:Connect(function()
		local u = math.clamp((os.clock() - t0) / life, 0, 1)
		fn(u)
		if u >= 1 then
			conn:Disconnect()
		end
	end)
end
local function rootOf(m: any): BasePart?
	local r = typeof(m) == "Instance" and m:FindFirstChild("HumanoidRootPart")
	return (r and r:IsA("BasePart")) and r or nil
end
local function flat(v: Vector3): Vector3
	local f = Vector3.new(v.X, 0, v.Z)
	return f.Magnitude > 1e-3 and f.Unit or Vector3.new(0, 0, -1)
end
local function emitter(at: BasePart, tex: string, c0: Color3, c1: Color3, rate: number, size: number, life: number, speed: number, light: number?): ParticleEmitter
	local a = Instance.new("Attachment")
	a.Parent = at
	local e = Instance.new("ParticleEmitter")
	e.Texture = tex
	e.Color = ColorSequence.new(c0, c1)
	e.LightEmission = light or 0.6
	e.Rate = rate
	e.Lifetime = NumberRange.new(life * 0.7, life)
	e.Speed = NumberRange.new(speed * 0.5, speed)
	e.SpreadAngle = Vector2.new(20, 20)
	e.Size = NumberSequence.new(size, 0)
	e.Transparency = NumberSequence.new(0.2, 1)
	e.Parent = a
	return e
end

-- 여러 조각을 한 덩이처럼 움직인다: { 조각, 덩이 안의 자리 }
type Group = { items: { { any } } }
local function group(): Group
	return { items = {} }
end
local function gadd(g: Group, p: BasePart, off: CFrame): BasePart
	table.insert(g.items, { p, off })
	return p
end
local function gset(g: Group, cf: CFrame)
	for _, it in ipairs(g.items) do
		local p = it[1] :: BasePart
		if p.Parent then
			p.CFrame = cf * (it[2] :: CFrame)
		end
	end
end
local function gfade(g: Group, time: number)
	for _, it in ipairs(g.items) do
		local p = it[1] :: BasePart
		if p.Parent then
			fadeOut(p, time)
		end
	end
end
local function galpha(g: Group, k: number)
	for _, it in ipairs(g.items) do
		local p = it[1] :: BasePart
		if p.Parent then
			p.Transparency = math.clamp(math.max(k, p:GetAttribute("A0") or 0), 0, 1)
		end
	end
end
local function gpart(g: Group, size: Vector3, color: Color3, mat: Enum.Material?, alpha: number?, shape: string?, off: CFrame): BasePart
	local p = part(size, color, mat, alpha, shape)
	p:SetAttribute("A0", alpha or 0)
	return gadd(g, p, off)
end

------------------------------------------------------------------------
-- 윤회륜: 금빛 테 두 겹, 바퀴살 여덟, 가운데 굴대, 테 위의 여섯 구슬 (덩이의 XY 면에 선다, 굴대는 Z)
------------------------------------------------------------------------
local function wheelGroup(R: number, thick: number, alpha: number?): Group
	local g = group()
	local a0 = alpha or 0
	local n = math.max(16, math.floor(R * 7))
	for i = 0, n - 1 do
		local a = (i + 0.5) / n * math.pi * 2
		gpart(g, Vector3.new(2 * math.pi * R / n * 1.12, thick, thick * 0.9), GOLD, Enum.Material.Metal, a0, nil, CFrame.Angles(0, 0, a) * CFrame.new(0, R, 0))
		if i % 2 == 0 then
			gpart(g, Vector3.new(2 * math.pi * R * 0.7 / n * 2.2, thick * 0.4, thick * 0.4), INDIGO, Enum.Material.Neon, a0, nil, CFrame.Angles(0, 0, a) * CFrame.new(0, R * 0.7, 0))
		end
	end
	for k = 0, 7 do
		local a = k / 8 * math.pi * 2
		gpart(g, Vector3.new(thick * 0.45, R * 0.95, thick * 0.45), GOLD_DEEP, Enum.Material.Metal, a0, nil, CFrame.Angles(0, 0, a) * CFrame.new(0, R * 0.5, 0))
	end
	gpart(g, Vector3.new(thick * 1.4, R * 0.32, R * 0.32), GOLD, Enum.Material.Metal, a0, "cyl", CFrame.Angles(0, math.rad(90), 0))
	gpart(g, Vector3.new(thick * 1.6, R * 0.16, R * 0.16), INDIGO, Enum.Material.Neon, a0, "cyl", CFrame.Angles(0, math.rad(90), 0))
	for k = 0, 5 do
		local a = k / 6 * math.pi * 2
		local d = thick * 2.1
		gpart(g, Vector3.new(d, d, d), REALMS[k + 1], Enum.Material.Neon, a0, "ball", CFrame.Angles(0, 0, a) * CFrame.new(0, R, 0))
	end
	return g
end
-- 테 위 k번째 구슬의 덩이 안 자리
local function orbOffset(R: number, k: number): Vector3
	local a = (k - 1) / 6 * math.pi * 2
	return (CFrame.Angles(0, 0, a) * CFrame.new(0, R, 0)).Position
end

------------------------------------------------------------------------
-- 몸에 두르는 것
------------------------------------------------------------------------
type Moving = { weld: Weld, base: CFrame, kind: string, phase: number, model: Model, k: number?, parts: { BasePart }?, tw: boolean? }
local moving: { Moving } = {}
local wheelOf: { [Model]: { BasePart } } = {}

local function attach(p: BasePart, to: BasePart, cf: CFrame, holder: Instance, list: { Instance }, model: Model?, kind: string?, phase: number?, k: number?)
	p.Anchored = false
	p.Massless = true
	if kind and model then
		p.CFrame = to.CFrame * cf
		local w = Instance.new("Weld")
		w.Part0 = to
		w.Part1 = p
		w.C0 = cf
		w.Parent = p
		table.insert(moving, { weld = w, base = cf, kind = kind, phase = phase or 0, model = model, k = k })
	else
		p.CFrame = to.CFrame * cf
		local w = Instance.new("WeldConstraint")
		w.Part0 = to
		w.Part1 = p
		w.Parent = p
	end
	p.Parent = holder
	table.insert(list, p)
end
-- 굴대 하나에 붙여 함께 도는 조각들 (굴대는 Weld 로 움직이고, 조각은 굴대에 고정)
local function hubbed(hub: BasePart, items: { { any } }, holder: Instance, list: { Instance })
	for _, it in ipairs(items) do
		local p = it[1] :: BasePart
		p.Anchored = false
		p.Massless = true
		p.CFrame = hub.CFrame * (it[2] :: CFrame)
		local w = Instance.new("WeldConstraint")
		w.Part0 = hub
		w.Part1 = p
		w.Parent = p
		p.Parent = holder
		table.insert(list, p)
	end
end

local function buildWheel(model: Model, holder: Instance, list: { Instance })
	local torso = model:FindFirstChild("UpperTorso") or model:FindFirstChild("Torso")
	if not (torso and torso:IsA("BasePart")) then
		return
	end
	local base = CFrame.new(0, 0.55, torso.Size.Z / 2 + 0.85)
	local hub = part(Vector3.new(0.2, 0.2, 0.2), GOLD, Enum.Material.Metal, 1)
	hub.CFrame = torso.CFrame * base
	attach(hub, torso, base, holder, list, model, "spin", 0)
	local g = wheelGroup(1.9, 0.2)
	hubbed(hub, g.items, holder, list)
	local parts: { BasePart } = {}
	for _, it in ipairs(g.items) do
		table.insert(parts, it[1])
	end
	wheelOf[model] = parts
	local glow = Instance.new("PointLight")
	glow.Color = GOLD
	glow.Range = 7
	glow.Brightness = 0.8
	glow.Parent = hub
end

local function buildChains(model: Model, holder: Instance, list: { Instance })
	for _, pair in ipairs({ { "RightLowerArm", "RightHand", 1 }, { "LeftLowerArm", "LeftHand", -1 } }) do
		local arm = model:FindFirstChild(pair[1])
		if arm and arm:IsA("BasePart") then
			-- 팔뚝을 휘감은 달군 사슬 고리
			for k = 0, 6 do
				local a = k * 1.15 * pair[3]
				local link = part(Vector3.new(0.4, 0.13, 0.24), Color3.fromRGB(45, 38, 38), Enum.Material.Metal)
				attach(link, arm, CFrame.new(math.cos(a) * 0.56, -0.5 + k * 0.17, math.sin(a) * 0.56) * CFrame.Angles(0, -a, math.rad(k % 2 == 0 and 65 or -65)), holder, list)
				if k % 2 == 1 then
					local glint = part(Vector3.new(0.2, 0.06, 0.12), EMBER, Enum.Material.Neon)
					attach(glint, arm, CFrame.new(math.cos(a) * 0.62, -0.5 + k * 0.17, math.sin(a) * 0.62) * CFrame.Angles(0, -a, 0), holder, list)
				end
			end
			-- 손목에서 늘어진 사슬 셋 (흔들린다)
			for k = 1, 3 do
				local link = part(Vector3.new(0.12, 0.34, 0.22), Color3.fromRGB(55, 45, 45), Enum.Material.Metal)
				attach(link, arm, CFrame.new(0.05 * pair[3], -0.65 - k * 0.3, 0.15) * CFrame.Angles(0, k % 2 == 0 and math.rad(90) or 0, 0), holder, list, model, "dangle", k * 0.7 * pair[3], k)
			end
		end
		local hand = model:FindFirstChild(pair[2])
		if hand and hand:IsA("BasePart") then
			local fire = emitter(hand, TEX_FIRE, Color3.fromRGB(255, 70, 30), Color3.fromRGB(30, 5, 10), 22, 0.9, 0.45, 3, 0.5)
			fire.Acceleration = Vector3.new(0, 6, 0)
			fire.Name = "KarmaFire"
			table.insert(list, fire.Parent :: Instance)
			local smoke = emitter(hand, TEX_SMOKE, Color3.fromRGB(40, 15, 20), Color3.fromRGB(10, 5, 8), 6, 1.0, 0.8, 1.5, 0)
			smoke.Acceleration = Vector3.new(0, 4, 0)
			table.insert(list, smoke.Parent :: Instance)
		end
	end
end

local function buildWisps(model: Model, holder: Instance, list: { Instance })
	local torso = model:FindFirstChild("UpperTorso") or model:FindFirstChild("Torso")
	if not (torso and torso:IsA("BasePart")) then
		return
	end
	-- 몸 둘레를 도는 넋불 셋
	for k = 1, 3 do
		local orb = part(Vector3.new(0.5, 0.5, 0.5), GHOST, Enum.Material.Neon, 0.1, "ball")
		attach(orb, torso, CFrame.new(2.2, 0, 0), holder, list, model, "orbit", (k - 1) / 3 * math.pi * 2)
		local tail = emitter(orb, TEX_SMOKE, GHOST, MIST, 14, 0.7, 0.6, 0.5, 0.6)
		tail.SpreadAngle = Vector2.new(5, 5)
		table.insert(list, tail.Parent :: Instance)
	end
	-- 목 뒤에서 길게 흘러내리는 안개 띠
	for k = 0, 6 do
		local seg = part(Vector3.new(0.55 - k * 0.03, 0.06, 0.62), MIST:Lerp(GHOST, k / 10), Enum.Material.SmoothPlastic, 0.15 + k * 0.08)
		local base = CFrame.new(0, 0.7 - k * 0.42, torso.Size.Z / 2 + 0.3 + k * 0.32) * CFrame.Angles(math.rad(55 - k * 4), 0, 0)
		attach(seg, torso, base, holder, list, model, "scarf", k * 0.7, k)
	end
end

local function buildCrown(model: Model, holder: Instance, list: { Instance })
	local head = model:FindFirstChild("Head")
	if head and head:IsA("BasePart") then
		-- 머리 위에 뜬 금빛 관: 둥근 테와 여섯 뿔, 뿔 끝의 붉은 구슬, 이마의 큰 보석
		local base = CFrame.new(0, head.Size.Y / 2 + 0.55, 0)
		local hub = part(Vector3.new(0.2, 0.2, 0.2), GOLD, Enum.Material.Metal, 1)
		hub.CFrame = head.CFrame * base
		attach(hub, head, base, holder, list, model, "bob", 0)
		local items = {}
		local n = 14
		local r = math.max(head.Size.X, head.Size.Z) * 0.5 + 0.12
		for i = 0, n - 1 do
			local a = (i + 0.5) / n * math.pi * 2
			table.insert(items, { part(Vector3.new(2 * math.pi * r / n * 1.15, 0.2, 0.1), GOLD, Enum.Material.Metal), CFrame.Angles(0, a, 0) * CFrame.new(0, 0, -r) })
		end
		for k = 0, 5 do
			local a = k / 6 * math.pi * 2
			local h = k == 0 and 0.75 or 0.5
			table.insert(items, { part(Vector3.new(0.16, h, 0.1), GOLD, Enum.Material.Metal), CFrame.Angles(0, a, 0) * CFrame.new(0, h / 2, -r) * CFrame.Angles(math.rad(-12), 0, 0) })
			table.insert(items, { part(Vector3.new(0.17, 0.17, 0.17), CRIMSON, Enum.Material.Neon, 0, "ball"), CFrame.Angles(0, a, 0) * CFrame.new(0, h + 0.05, -r - 0.08) })
		end
		table.insert(items, { part(Vector3.new(0.3, 0.3, 0.3), Color3.fromRGB(255, 60, 70), Enum.Material.Neon, 0, "ball"), CFrame.new(0, 0.05, -r - 0.05) })
		hubbed(hub, items, holder, list)
		local glow = Instance.new("PointLight")
		glow.Color = GOLD
		glow.Range = 6
		glow.Brightness = 0.7
		glow.Parent = hub
	end
	local torso = model:FindFirstChild("UpperTorso") or model:FindFirstChild("Torso")
	if torso and torso:IsA("BasePart") then
		-- 붉은 망토: 어깨에서 세 줄, 다섯 단 (아래로 갈수록 크게 흔들린다). 맨 아래 단엔 금테
		for c = -1, 1 do
			for r = 0, 4 do
				local panel = part(Vector3.new(0.66, 0.64, 0.06), r == 4 and GOLD_DEEP or CRIMSON:Lerp(Color3.fromRGB(120, 10, 20), r * 0.08), r == 4 and Enum.Material.Metal or Enum.Material.Fabric)
				local base = CFrame.new(c * 0.64, 0.75 - r * 0.62, torso.Size.Z / 2 + 0.1 + r * 0.1) * CFrame.Angles(math.rad(8 + r * 3), 0, 0)
				attach(panel, torso, base, holder, list, model, "cape", c * 0.6, r)
			end
		end
	end
	-- 손목의 금빛 팔찌와 붉은 보석
	for _, name in ipairs({ "RightLowerArm", "LeftLowerArm" }) do
		local arm = model:FindFirstChild(name)
		if arm and arm:IsA("BasePart") then
			local cuff = part(Vector3.new(0.38, 0.66, 0.66), GOLD, Enum.Material.Metal, 0, "cyl")
			attach(cuff, arm, CFrame.new(0, -0.32, 0) * CFrame.Angles(0, 0, math.rad(90)), holder, list)
			local gem = part(Vector3.new(0.2, 0.2, 0.2), CRIMSON, Enum.Material.Neon, 0, "ball")
			attach(gem, arm, CFrame.new(0, -0.32, -0.34), holder, list)
		end
	end
end

-- 3.1판 극 일월신권: 어깨 뒤에 작은 해 (오른쪽) 와 초승달 (왼쪽). 황혼에는 머리 뒤로 모여 노을빛·보랏빛으로 물든다
local function buildSunMoon(model: Model, holder: Instance, list: { Instance })
	local torso = model:FindFirstChild("UpperTorso") or model:FindFirstChild("Torso")
	if not (torso and torso:IsA("BasePart")) then
		return
	end
	for _, side in ipairs({ 1, -1 }) do
		local base = CFrame.new(side * 1.5, 1.5, torso.Size.Z / 2 + 0.6)
		local hub = part(Vector3.new(0.2, 0.2, 0.2), WHITE, Enum.Material.Neon, 1)
		hub.CFrame = torso.CFrame * base
		attach(hub, torso, base, holder, list, model, side == 1 and "sunorb" or "moonorb", side)
		local items = {}
		local pieces: { BasePart } = {}
		if side == 1 then
			local core = part(Vector3.new(0.7, 0.7, 0.7), Color3.fromRGB(255, 245, 200), Enum.Material.Neon, 0, "ball")
			local body = part(Vector3.new(1.05, 1.05, 1.05), Color3.fromRGB(255, 170, 50), Enum.Material.Neon, 0.25, "ball")
			table.insert(items, { core, CFrame.new() })
			table.insert(items, { body, CFrame.new() })
			table.insert(pieces, body)
			for k = 0, 7 do
				local a = k / 8 * math.pi * 2
				local ray = part(Vector3.new(0.1, 0.5, 0.1), Color3.fromRGB(255, 200, 90), Enum.Material.Neon)
				table.insert(items, { ray, CFrame.Angles(0, 0, a) * CFrame.new(0, 0.78, 0) })
				table.insert(pieces, ray)
			end
		else
			for i = 0, 6 do
				local a = math.rad(-100 + 200 * i / 6)
				local w = 0.25 * math.sin((i + 0.5) / 7 * math.pi) + 0.08
				local seg = part(Vector3.new(w, 0.32, 0.12), Color3.fromRGB(205, 220, 255), Enum.Material.Neon)
				table.insert(items, { seg, CFrame.new(-math.cos(a) * 0.6, math.sin(a) * 0.6, 0) * CFrame.Angles(0, 0, a) })
				table.insert(pieces, seg)
			end
		end
		hubbed(hub, items, holder, list)
		local glow = Instance.new("PointLight")
		glow.Color = side == 1 and Color3.fromRGB(255, 170, 60) or Color3.fromRGB(190, 210, 255)
		glow.Range = 6
		glow.Brightness = 0.8
		glow.Parent = hub
		moving[#moving].parts = pieces
	end
end

function Samsara.hasGear(st: any): boolean
	return st ~= nil and (st.wheel or st.chains or st.wisps or st.crown or st.sunMoonOrbs) == true
end
function Samsara.buildGear(model: Model, st: any): { Instance }
	local out: { Instance } = {}
	local holder = Instance.new("Folder")
	holder.Name = "Samsara_" .. model.Name
	holder.Parent = folder
	table.insert(out, holder)
	if st.wheel then
		buildWheel(model, holder, out)
	elseif st.chains then
		buildChains(model, holder, out)
	elseif st.wisps then
		buildWisps(model, holder, out)
	elseif st.crown then
		buildCrown(model, holder, out)
	elseif st.sunMoonOrbs then
		buildSunMoon(model, holder, out)
	end
	return out
end
-- 던지는 동안 등의 바퀴를 감춘다
local function hideWheel(model: Model, sec: number)
	local parts = wheelOf[model]
	if not parts then
		return
	end
	for _, p in ipairs(parts) do
		if p.Parent then
			p.LocalTransparencyModifier = 1
		end
	end
	task.delay(sec, function()
		for _, p in ipairs(parts) do
			if p.Parent and model:GetAttribute("Vanish") ~= true then
				p.LocalTransparencyModifier = 0
			end
		end
	end)
end

RunService.Heartbeat:Connect(function()
	local t = os.clock()
	local cam = workspace.CurrentCamera
	for i = #moving, 1, -1 do
		local mv = moving[i]
		if not mv.weld.Parent or not mv.model.Parent then
			table.remove(moving, i)
		else
			local r = mv.weld.Part0
			if cam and r and (cam.CFrame.Position - r.Position).Magnitude < 160 then
				local ph, k = mv.phase, mv.k or 0
				if mv.kind == "spin" then
					mv.weld.C0 = mv.base * CFrame.Angles(0, 0, t * 1.3)
				elseif mv.kind == "orbit" then
					mv.weld.C0 = CFrame.Angles(0, t * 1.8 + ph, 0) * CFrame.new(2.2, math.sin(t * 2.4 + ph) * 0.7, 0)
				elseif mv.kind == "scarf" then
					mv.weld.C0 = mv.base * CFrame.new(math.sin(t * 3 + ph) * 0.12 * k, math.sin(t * 2.2 + ph) * 0.05 * k, 0) * CFrame.Angles(math.sin(t * 2.6 + ph) * 0.06, 0, math.sin(t * 3 + ph) * 0.08)
				elseif mv.kind == "cape" then
					mv.weld.C0 = mv.base * CFrame.Angles(math.sin(t * 2.2 + ph + k * 0.5) * 0.05 * k, 0, math.sin(t * 1.7 + ph) * 0.02 * k)
				elseif mv.kind == "bob" then
					mv.weld.C0 = mv.base * CFrame.new(0, math.sin(t * 2) * 0.08, 0) * CFrame.Angles(0, t * 0.6, 0)
				elseif mv.kind == "sunorb" or mv.kind == "moonorb" then
					local tw = mv.model:GetAttribute("Twilight") == true
					local side = mv.kind == "sunorb" and 1 or -1
					if tw then
						mv.weld.C0 = CFrame.new(side * 0.55, 2.4, 0.9) * CFrame.Angles(0, 0, t * 2.5 * side)
					else
						mv.weld.C0 = mv.base * CFrame.new(0, math.sin(t * 2 + ph) * 0.15, 0) * CFrame.Angles(0, 0, t * side)
					end
					if mv.tw ~= tw and mv.parts then
						mv.tw = tw
						for _, q in ipairs(mv.parts) do
							if q.Parent then
								q.Color = tw and (side == 1 and Color3.fromRGB(255, 120, 60) or Color3.fromRGB(165, 95, 235)) or (side == 1 and Color3.fromRGB(255, 170, 50) or Color3.fromRGB(205, 220, 255))
							end
						end
					end
				elseif mv.kind == "dangle" then
					mv.weld.C0 = mv.base * CFrame.Angles(math.sin(t * 4 + ph) * 0.25, 0, math.sin(t * 3 + ph) * 0.2)
				end
			end
		end
	end
	for m, ps in pairs(wheelOf) do
		if not m.Parent or not (ps[1] and ps[1].Parent) then
			wheelOf[m] = nil
		end
	end
end)

------------------------------------------------------------------------
-- 몸의 그림자 (지난 삶·허상·잔상): 몸 조각을 그대로 본뜬 빛 조각 덩이. 뿌리 자리를 기준으로 움직인다
------------------------------------------------------------------------
local function ghostOf(model: Model, color: Color3, alpha: number, mat: Enum.Material?): (Group, CFrame)
	local g = group()
	local r = rootOf(model)
	local rootCF = r and r.CFrame or CFrame.new()
	for _, d in ipairs(model:GetChildren()) do
		if d:IsA("BasePart") and d.Name ~= "HumanoidRootPart" and d.Transparency < 0.9 then
			gpart(g, d.Size, color, mat or Enum.Material.Neon, alpha, d:IsA("Part") and d.Shape == Enum.PartType.Ball and "ball" or nil, rootCF:ToObjectSpace(d.CFrame))
		end
	end
	return g, rootCF
end

-- 바닥에 그어지는 얇은 빛 줄
local function streak(a: Vector3, b: Vector3, color: Color3, w: number, life: number, h: number?)
	local len = (b - a).Magnitude
	if len < 0.2 then
		return
	end
	local p = part(Vector3.new(w, h or 0.15, len), color, Enum.Material.Neon, 0.1)
	p.CFrame = CFrame.lookAt((a + b) / 2, b)
	fadeOut(p, life, { Size = Vector3.new(w * 0.2, h or 0.15, len) })
end
-- 빛기둥 (하늘에서 땅까지)
local function pillar(at: Vector3, color: Color3, d: number, h: number, life: number)
	local p = part(Vector3.new(h, d, d), color, Enum.Material.Neon, 0.15, "cyl")
	p.CFrame = CFrame.new(at + Vector3.new(0, h / 2, 0)) * CFrame.Angles(0, 0, math.rad(90))
	local core = part(Vector3.new(h, d * 0.4, d * 0.4), WHITE, Enum.Material.Neon, 0.05, "cyl")
	core.CFrame = p.CFrame
	fadeOut(p, life, { Size = Vector3.new(h, d * 1.8, d * 1.8) })
	fadeOut(core, life * 0.7, { Size = Vector3.new(h, 0.1, 0.1) })
end
-- 십자로 엇갈린 칼자국 (무상)
local function slashX(at: Vector3, color: Color3, size: number, life: number)
	for k = -1, 1, 2 do
		local p = part(Vector3.new(0.18, size, 0.6), color, Enum.Material.Neon, 0.05)
		p.CFrame = CFrame.new(at) * CFrame.Angles(math.random() * 0.5, math.random() * 6, math.rad(40 * k))
		fadeOut(p, life, { Size = Vector3.new(0.05, size * 1.4, 0.2) })
	end
end
-- 금빛 주먹 덩이: 팔뚝 (뒤로 길게) · 주먹 · 마디 넷 · 붉은 소매 띠. 덩이의 -Z 쪽이 앞
local function fistGroup(s: number, alpha: number?): Group
	local g = group()
	local a0 = alpha or 0
	gpart(g, Vector3.new(4.4, 4, 4.6) * s, GOLD, Enum.Material.Metal, a0, nil, CFrame.new())
	for k = 0, 3 do
		gpart(g, Vector3.new(1.15, 1.15, 1.15) * s, GOLD:Lerp(WHITE, 0.25), Enum.Material.Metal, a0, "ball", CFrame.new((-1.5 + k) * 1.05 * s, 1.3 * s, -2.2 * s))
	end
	gpart(g, Vector3.new(1.4, 1.6, 2.4) * s, GOLD_DEEP, Enum.Material.Metal, a0, nil, CFrame.new(-2.5 * s, 0.3 * s, -0.6 * s))
	gpart(g, Vector3.new(9, 3.2, 3.2) * s, GOLD_DEEP, Enum.Material.Metal, a0, "cyl", CFrame.new(0, 0, 6.5 * s) * CFrame.Angles(0, math.rad(90), 0))
	gpart(g, Vector3.new(1.2, 4, 4) * s, CRIMSON, Enum.Material.Fabric, a0, "cyl", CFrame.new(0, 0, 3 * s) * CFrame.Angles(0, math.rad(90), 0))
	gpart(g, Vector3.new(0.5, 4.3, 4.3) * s, GOLD, Enum.Material.Neon, a0, "cyl", CFrame.new(0, 0, 2.3 * s) * CFrame.Angles(0, math.rad(90), 0))
	return g
end
-- 아래를 내리찍는 주먹의 자리: 앞(-Z)이 땅, 위(Y)가 내 앞쪽
local function downCF(p: Vector3, f: Vector3): CFrame
	local fwd = flat(f)
	return CFrame.fromMatrix(p, fwd:Cross(Vector3.new(0, 1, 0)), fwd)
end
-- 땅에 부딪는 금빛 충격 (고리 둘, 불티, 흙)
local function goldImpact(at: Vector3, s: number)
	local g = ground(at)
	Fx.ring(g + Vector3.new(0, 0.3, 0), GOLD, 2, 22 * s, 0.5)
	Fx.ring(g + Vector3.new(0, 0.4, 0), CRIMSON, 1, 14 * s, 0.6)
	Fx.burst("spark", at, GOLD, math.floor(18 * s), 1.6 * s)
	Fx.debris(g, math.floor(6 * s), 30 * s)
	Fx.flash(at, GOLD, 30 * s, 4, 0.4)
	Fx.breakSound("rock", 0.8, 0.8, at)
	shakeNear(at, 0.5 * s, 90)
end

------------------------------------------------------------------------
-- 윤회권
------------------------------------------------------------------------
local H: { [string]: (any) -> () } = {}

-- 전생의 메아리 (연타 넷마다): 쪽빛 손바닥이 옆에서 날아와 같은 자리를 다시 치고, 금빛 바퀴 무늬가 번쩍인다
function H.echoPulse(d: any)
	local at: Vector3 = d.at
	if not near(at, 250) then
		return
	end
	local side = math.random() < 0.5 and 1 or -1
	local cam = workspace.CurrentCamera
	local right = cam and flat(cam.CFrame.RightVector) or Vector3.new(1, 0, 0)
	local from = at + right * side * 7 + Vector3.new(0, 2, 0)
	local palm = group()
	gpart(palm, Vector3.new(2.4, 2.8, 0.4), INDIGO, Enum.Material.Neon, 0.35, nil, CFrame.new())
	for k = 0, 3 do
		gpart(palm, Vector3.new(0.45, 1.5, 0.35), INDIGO:Lerp(WHITE, 0.2), Enum.Material.Neon, 0.35, nil, CFrame.new((-1.5 + k) * 0.6, 2.1, 0))
	end
	gpart(palm, Vector3.new(0.5, 1.2, 0.35), INDIGO, Enum.Material.Neon, 0.35, nil, CFrame.new(side * -1.5, 0.2, 0) * CFrame.Angles(0, 0, math.rad(side * 40)))
	local delay = d.delay or 0.4
	anim(delay, function(u)
		local p = from:Lerp(at, u * u)
		gset(palm, CFrame.lookAt(p, at + Vector3.new(0, 0, 0.01)) * CFrame.Angles(0, math.rad(90 * side), 0))
		if u >= 1 then
			gfade(palm, 0.25)
		end
	end)
	task.delay(delay, function()
		local w = wheelGroup(3.2, 0.18, 0.2)
		local cf = CFrame.lookAt(at, at + right)
		anim(0.45, function(u)
			gset(w, cf * CFrame.Angles(0, 0, -u * 4))
			galpha(w, u)
		end)
		task.delay(0.47, function()
			gfade(w, 0.05)
		end)
		Fx.ring(at, INDIGO, 1, 12, 0.35)
		Fx.burst("glitter", at, GOLD, 10, 1)
		Fx.sound("deflect", 0.6, 1.3, at)
	end)
end




------------------------------------------------------------------------
-- 업화권
------------------------------------------------------------------------
-- 검은 불기둥: 검붉은 겉불, 붉은 심, 위로 솟는 불티
local function hellPillar(at: Vector3, h: number, dd: number, life: number)
	local g = ground(at)
	local outer = part(Vector3.new(0.5, dd, dd), CHAR, Enum.Material.SmoothPlastic, 0.2, "cyl")
	outer.CFrame = CFrame.new(g) * CFrame.Angles(0, 0, math.rad(90))
	local core = part(Vector3.new(0.5, dd * 0.55, dd * 0.55), EMBER, Enum.Material.Neon, 0.05, "cyl")
	core.CFrame = outer.CFrame
	tween(outer, 0.14, { Size = Vector3.new(h, dd, dd), CFrame = CFrame.new(g + Vector3.new(0, h / 2, 0)) * CFrame.Angles(0, 0, math.rad(90)) })
	tween(core, 0.12, { Size = Vector3.new(h * 1.05, dd * 0.55, dd * 0.55), CFrame = CFrame.new(g + Vector3.new(0, h / 2, 0)) * CFrame.Angles(0, 0, math.rad(90)) })
	task.delay(0.15, function()
		fadeOut(outer, life, { Size = Vector3.new(h * 1.2, dd * 1.6, dd * 1.6) })
		fadeOut(core, life * 0.8, { Size = Vector3.new(h * 1.2, 0.2, 0.2) })
	end)
	Fx.burst("ember", g + Vector3.new(0, h * 0.4, 0), EMBER, 6, 1.2)
end
-- 땅의 붉은 금 (갈라짐): 가운데에서 바깥으로 꺾이며 뻗는다
local function crack(at: Vector3, len: number, angle: number, life: number)
	local p = ground(at) + Vector3.new(0, 0.12, 0)
	local a = angle
	local seg = len / 4
	for _ = 1, 4 do
		a += (math.random() - 0.5) * 0.8
		local q = p + Vector3.new(math.cos(a), 0, math.sin(a)) * seg
		local s = part(Vector3.new(0.45, 0.1, seg + 0.2), EMBER, Enum.Material.Neon, 0.05)
		s.CFrame = CFrame.lookAt((p + q) / 2, q)
		fadeOut(s, life)
		p = q
	end
end

-- 업보 (연타 다섯마다): 상대 발밑에 붉은 낙인이 찍혔다가 검은 지옥불 기둥이 솟는다
function H.karmaPulse(d: any)
	local at: Vector3 = d.at
	if not near(at, 250) then
		return
	end
	local g = ground(at) + Vector3.new(0, 0.15, 0)
	local seal = part(Vector3.new(0.12, 1, 1), HELL, Enum.Material.Neon, 0.2, "cyl")
	seal.CFrame = CFrame.new(g) * CFrame.Angles(0, 0, math.rad(90))
	tween(seal, d.delay or 0.5, { Size = Vector3.new(0.12, 9, 9) })
	for k = 0, 4 do
		crack(at, 4, k / 5 * math.pi * 2, (d.delay or 0.5) + 0.4)
	end
	task.delay(d.delay or 0.5, function()
		seal:Destroy()
		hellPillar(at, 18, 5, 0.5)
		Fx.ring(g, EMBER, 1, 14, 0.4)
		Fx.breakSound("boom", 0.6, 1.1, at)
		shakeNear(at, 0.4, 80)
	end)
end



-- 지옥불 속의 거대한 손: 손바닥 (세워진 판) · 손가락 넷 (두 마디) · 엄지. 손가락은 +Z 쪽으로 말려 주먹이 된다
local function hellHand(s: number): (Group, { { any } })
	local g = group()
	gpart(g, Vector3.new(6, 7, 2) * s, CHAR, Enum.Material.SmoothPlastic, 0, nil, CFrame.new())
	gpart(g, Vector3.new(4, 5, 2.1) * s, EMBER, Enum.Material.Neon, 0.6, nil, CFrame.new(0, 0, 0.05 * s))
	gpart(g, Vector3.new(4.4, 6, 2.4) * s, CHAR, Enum.Material.SmoothPlastic, 0, "cyl", CFrame.new(0, -6 * s, 0) * CFrame.Angles(0, 0, math.rad(90)))
	local fingers = {}
	for k = 0, 3 do
		local x = (-2.25 + k * 1.5) * s
		local L1 = (k == 1 or k == 2) and 3.6 * s or 3 * s
		local p1 = part(Vector3.new(1.3, L1, 1.4) * Vector3.new(s, 1, s), CHAR, Enum.Material.SmoothPlastic)
		local p2 = part(Vector3.new(1.2, L1 * 0.8, 1.3) * Vector3.new(s, 1, s), CHAR, Enum.Material.SmoothPlastic)
		local tip = part(Vector3.new(0.6, 0.6, 0.6) * s, EMBER, Enum.Material.Neon, 0, "ball")
		table.insert(fingers, { p1, p2, tip, x, L1 })
	end
	local thumb = part(Vector3.new(1.4, 3.2, 1.4) * s, CHAR, Enum.Material.SmoothPlastic)
	table.insert(fingers, { thumb, nil, nil, -3.6 * s, 3.2 * s, true })
	return g, fingers
end
local function setHand(g: Group, fingers: { { any } }, cf: CFrame, curl: number, s: number)
	gset(g, cf)
	for _, fg in ipairs(fingers) do
		local x, L1 = fg[4] :: number, fg[5] :: number
		if fg[6] then
			local base = cf * CFrame.new(x, -0.5 * s, 0.6 * s) * CFrame.Angles(0, 0, math.rad(40)) * CFrame.Angles(-curl * 0.9, 0, 0)
			;(fg[1] :: BasePart).CFrame = base * CFrame.new(0, L1 / 2, 0)
		else
			local b1 = cf * CFrame.new(x, 3.5 * s, 0) * CFrame.Angles(curl, 0, 0)
			;(fg[1] :: BasePart).CFrame = b1 * CFrame.new(0, L1 / 2, 0)
			local b2 = b1 * CFrame.new(0, L1, 0) * CFrame.Angles(curl * 0.9, 0, 0)
			;(fg[2] :: BasePart).CFrame = b2 * CFrame.new(0, L1 * 0.4, 0)
			;(fg[3] :: BasePart).CFrame = b2 * CFrame.new(0, L1 * 0.8, 0)
		end
	end
end


------------------------------------------------------------------------
-- 무상권
------------------------------------------------------------------------
local function mistPuff(at: Vector3, size: number, life: number)
	for k = 0, 3 do
		local p = part(Vector3.new(size, size * 0.7, size) * (0.6 + k * 0.15), MIST:Lerp(GHOST, k * 0.15), Enum.Material.SmoothPlastic, 0.45 + k * 0.1, "ball")
		p.Position = at + Vector3.new(math.random() - 0.5, math.random() * 0.6, math.random() - 0.5) * size * 0.5
		fadeOut(p, life * (0.7 + k * 0.15), { Size = p.Size * 1.8, Position = p.Position + Vector3.new(0, size * 0.3, 0) })
	end
end

-- 무상영 (연타 넷마다): 상대 뒤에 흐릿한 잔상이 나타나 엇갈려 벤다
function H.phantomPulse(d: any)
	local at: Vector3 = d.at
	if not near(at, 250) then
		return
	end
	local cam = workspace.CurrentCamera
	local back = cam and flat(at - cam.CFrame.Position) or Vector3.new(0, 0, -1)
	local behind = at + back * 2.5
	mistPuff(behind, 3, 0.5)
	task.delay(d.delay or 0.3, function()
		slashX(at, GHOST, 7, 0.3)
		mistPuff(at, 2.5, 0.4)
		Fx.ring(at, GHOST, 1, 10, 0.3)
		Fx.sound("swing", 0.6, 1.4, at)
	end)
end




------------------------------------------------------------------------
-- 권왕신권
------------------------------------------------------------------------
-- 왕의 주먹 (연타 넷마다): 하늘에서 금빛 주먹이 내리찍는다
function H.kingPulse(d: any)
	local at: Vector3 = d.at
	if not near(at, 250) then
		return
	end
	local g = fistGroup(0.55, 0.05)
	local top = at + Vector3.new(0, 26, 0)
	local delay = d.delay or 0.45
	local mark = part(Vector3.new(0.1, 1, 1), GOLD, Enum.Material.Neon, 0.4, "cyl")
	mark.CFrame = CFrame.new(ground(at) + Vector3.new(0, 0.12, 0)) * CFrame.Angles(0, 0, math.rad(90))
	tween(mark, delay, { Size = Vector3.new(0.1, 7, 7) })
	anim(delay, function(u)
		local p = top:Lerp(at + Vector3.new(0, 2, 0), u * u)
		gset(g, downCF(p, Vector3.new(0, 0, 1)))
		if u >= 1 then
			gfade(g, 0.3)
			mark:Destroy()
			goldImpact(at, 0.6)
		end
	end)
end



-- 거대한 금빛 왕: 관 · 머리 · 가슴 · 어깨 · 두 팔 (위팔·아래팔·주먹) · 붉은 망토. 덩이의 -Z 쪽이 앞
type King = { g: Group, fists: { BasePart } }
local function kingGroup(s: number): King
	local g = group()
	gpart(g, Vector3.new(12, 6, 6) * s, GOLD, Enum.Material.Metal, 0, nil, CFrame.new(0, 10 * s, 0))
	gpart(g, Vector3.new(9, 8, 5) * s, GOLD_DEEP, Enum.Material.Metal, 0, nil, CFrame.new(0, 3.5 * s, 0))
	gpart(g, Vector3.new(4, 4, 0.6) * s, CRIMSON, Enum.Material.Neon, 0.2, nil, CFrame.new(0, 9 * s, -3.1 * s) * CFrame.Angles(0, 0, math.rad(45)))
	gpart(g, Vector3.new(5, 5, 5) * s, GOLD, Enum.Material.Metal, 0, "ball", CFrame.new(0, 16 * s, 0))
	for _, x in ipairs({ -1, 1 }) do
		gpart(g, Vector3.new(0.9, 0.5, 0.3) * s, WHITE, Enum.Material.Neon, 0, nil, CFrame.new(x * 1.1 * s, 16.4 * s, -2.4 * s))
	end
	-- 관
	for k = 0, 9 do
		local a = k / 10 * math.pi * 2
		gpart(g, Vector3.new(1.9, 1.2, 0.4) * s, GOLD, Enum.Material.Metal, 0, nil, CFrame.new(0, 18.8 * s, 0) * CFrame.Angles(0, a, 0) * CFrame.new(0, 0, -2.6 * s))
		if k % 2 == 0 then
			gpart(g, Vector3.new(0.5, 2.2, 0.4) * s, GOLD, Enum.Material.Metal, 0, nil, CFrame.new(0, 20.3 * s, 0) * CFrame.Angles(0, a, 0) * CFrame.new(0, 0, -2.6 * s))
			gpart(g, Vector3.new(0.7, 0.7, 0.7) * s, CRIMSON, Enum.Material.Neon, 0, "ball", CFrame.new(0, 21.6 * s, 0) * CFrame.Angles(0, a, 0) * CFrame.new(0, 0, -2.6 * s))
		end
	end
	-- 어깨와 팔 (주먹은 따로 기억해 둔다: 내리찍을 때 감춘다)
	local fists = {}
	for _, x in ipairs({ -1, 1 }) do
		gpart(g, Vector3.new(5.5, 5.5, 5.5) * s, GOLD, Enum.Material.Metal, 0, "ball", CFrame.new(x * 7.5 * s, 12 * s, 0))
		gpart(g, Vector3.new(3.6, 8, 3.6) * s, GOLD_DEEP, Enum.Material.Metal, 0, nil, CFrame.new(x * 8.6 * s, 7.5 * s, -0.5 * s) * CFrame.Angles(math.rad(-15), 0, math.rad(x * 10)))
		gpart(g, Vector3.new(3.2, 7, 3.2) * s, GOLD, Enum.Material.Metal, 0, nil, CFrame.new(x * 9 * s, 2.5 * s, -3 * s) * CFrame.Angles(math.rad(-55), 0, 0))
		table.insert(fists, gpart(g, Vector3.new(4.6, 4.6, 4.6) * s, GOLD, Enum.Material.Metal, 0, nil, CFrame.new(x * 9 * s, 0.5 * s, -6 * s)))
	end
	-- 망토
	gpart(g, Vector3.new(14, 18, 0.6) * s, CRIMSON, Enum.Material.Fabric, 0, nil, CFrame.new(0, 4 * s, 3.4 * s) * CFrame.Angles(math.rad(10), 0, 0))
	gpart(g, Vector3.new(14.4, 1, 0.7) * s, GOLD, Enum.Material.Metal, 0, nil, CFrame.new(0, -4.8 * s, 5 * s) * CFrame.Angles(math.rad(10), 0, 0))
	return { g = g, fists = fists }
end


------------------------------------------------------------------------
-- 3.2판 환생 권법의 새 기술과 초 오의: 공통 조각
------------------------------------------------------------------------
local UP = Vector3.new(0, 1, 0)
local FLAT = CFrame.Angles(math.rad(90), 0, 0)
local SAPPHIRE = Color3.fromRGB(80, 160, 255)
local function v3(s: number): Vector3
	return Vector3.new(s, s, s)
end
local function rightOf(v: Vector3): Vector3
	return Vector3.new(-v.Z, 0, v.X)
end
local function safeLook(a: Vector3, b: Vector3): CFrame
	if (b - a).Magnitude < 1e-3 then
		return CFrame.new(a)
	end
	return CFrame.lookAt(a, b)
end
local grade = Instance.new("ColorCorrectionEffect")
grade.Name = "KwonRebirthGrade"
grade.Parent = game:GetService("Lighting")
-- 내 화면의 빛깔을 time 동안 옮긴다 (나중 부름이 앞의 것을 덮는다)
local function gradeTo(time: number, sat: number, bright: number, contrast: number, tintC: Color3?)
	tween(grade, time, { Saturation = sat, Brightness = bright, Contrast = contrast, TintColor = tintC or WHITE })
end
local function gradeReset(time: number)
	gradeTo(time, 0, 0, 0, WHITE)
end
-- a에서 b로 뻗는 빛줄기 (원기둥, 길이는 X)
local function setBeam(p: BasePart, a: Vector3, b: Vector3, w: number)
	local len = math.max(0.2, (b - a).Magnitude)
	p.Size = Vector3.new(len, w, w)
	p.CFrame = safeLook((a + b) / 2, b) * CFrame.Angles(0, math.rad(90), 0)
end
local function beamTo(a: Vector3, b: Vector3, w: number, color: Color3, alpha: number?, mat: Enum.Material?): BasePart
	local p = part(Vector3.new(1, w, w), color, mat or Enum.Material.Neon, alpha, "cyl")
	setBeam(p, a, b, w)
	return p
end
-- 덩이의 XY 면에 놓인 고리
local function gHalo(g: Group, R: number, thick: number, color: Color3, n: number, alpha: number?)
	local seg = 2 * math.pi * R / n * 1.1
	for k = 0, n - 1 do
		local a = (k + 0.5) / n * math.pi * 2
		gpart(g, Vector3.new(seg, thick, thick * 0.6), color, Enum.Material.Neon, alpha, nil, CFrame.Angles(0, 0, a) * CFrame.new(0, R, 0))
	end
end
local function trailDot(p: Vector3, d: number, color: Color3, life: number)
	local b = part(v3(d), color, Enum.Material.Neon, 0.3, "ball")
	b.Position = p
	fadeOut(b, life, { Size = v3(d * 0.2) })
end
local function recolor(g: Group, color: Color3, mat: Enum.Material?)
	for _, it in ipairs(g.items) do
		local p = it[1] :: BasePart
		p.Color = color
		if mat then
			p.Material = mat
		end
	end
end
local function camFace(from: Vector3, fallback: Vector3): Vector3
	local cam = workspace.CurrentCamera
	if cam then
		local v = cam.CFrame.Position - from
		if v.Magnitude > 1e-3 then
			return v.Unit
		end
	end
	return fallback
end
-- 몸을 s배로 본뜬 큰 그림자 (뿌리 자리 기준)
local function bigGhost(model: Model, s: number, color: Color3, alpha: number): Group
	local g = group()
	local r = rootOf(model)
	local rootCF = r and r.CFrame or CFrame.new()
	for _, d in ipairs(model:GetChildren()) do
		if d:IsA("BasePart") and d.Name ~= "HumanoidRootPart" and d.Transparency < 0.9 then
			local off = rootCF:ToObjectSpace(d.CFrame)
			gpart(g, d.Size * s, color, Enum.Material.Neon, alpha, d:IsA("Part") and d.Shape == Enum.PartType.Ball and "ball" or nil, CFrame.new(off.Position * s) * off.Rotation)
		end
	end
	return g
end
-- 달군 사슬: 고리 n개 (엇갈려 놓인다). k (0~1) 만큼만 뻗어 보인다
local function chainParts(n: number): { BasePart }
	local list = {}
	for i = 1, n do
		list[i] = part(Vector3.new(0.5, 0.2, 1.1), i % 2 == 0 and Color3.fromRGB(130, 32, 22) or HELL, i % 2 == 0 and Enum.Material.Metal or Enum.Material.Neon, 0)
	end
	return list
end
local function setChain(list: { BasePart }, a: Vector3, b: Vector3, sag: number, k: number)
	local n = #list
	local dir = b - a
	for i, p in ipairs(list) do
		local u = (i - 0.5) / n
		p.Transparency = u > k and 1 or 0
		local pos = a + dir * u - UP * math.sin(u * math.pi) * sag
		p.CFrame = safeLook(pos, pos + dir) * CFrame.Angles(0, 0, (i % 2) * math.pi / 2)
	end
end
local function killList(list: { BasePart }, time: number)
	for _, p in ipairs(list) do
		if p.Parent then
			fadeOut(p, time)
		end
	end
end
-- 넋의 손아귀: 땅에서 솟아 발목을 감싸 쥐는 손가락 다섯 (원점이 땅)
local function ghostHand(): Group
	local g = group()
	for k = 0, 4 do
		local a = k / 5 * math.pi * 2
		gpart(g, Vector3.new(0.7, 5, 0.7), GHOST, Enum.Material.Neon, 0.35, nil, CFrame.Angles(0, a, 0) * CFrame.new(0, 2.3, -2.4) * CFrame.Angles(math.rad(22), 0, 0))
		gpart(g, v3(0.6), WHITE, Enum.Material.Neon, 0.2, "ball", CFrame.Angles(0, a, 0) * CFrame.new(0, 4.6, -1.5))
	end
	gpart(g, Vector3.new(0.3, 5.6, 5.6), MIST, Enum.Material.SmoothPlastic, 0.6, "cyl", CFrame.new(0, 0.2, 0) * CFrame.Angles(0, 0, math.rad(90)))
	return g
end
-- 금빛 왕관: 띠 (붉은 보석 줄) 와 가시 n개 (꼭대기 마름모, 가운데 보석). 반지름을 바꿔 가며 놓을 수 있다
type CrownItem = { p: BasePart, a: number, y: number, dz: number, ex: CFrame }
local function crownNew(R0: number, n: number, hgt: number): { CrownItem }
	local items: { CrownItem } = {}
	local function add(size: Vector3, color: Color3, mat: Enum.Material, shape: string?, a: number, y: number, dz: number, ex: CFrame?)
		table.insert(items, { p = part(size, color, mat, 0, shape), a = a, y = y, dz = dz, ex = ex or CFrame.new() })
	end
	local segs = math.floor(R0 * 4)
	for i = 0, segs - 1 do
		local a = (i + 0.5) / segs * math.pi * 2
		local w = 2 * math.pi * R0 / segs * 1.1
		add(Vector3.new(w, hgt * 0.3, 1.2), GOLD, Enum.Material.Metal, nil, a, hgt * 0.15, 0)
		add(Vector3.new(w, 0.5, 1.4), GOLD_DEEP, Enum.Material.Metal, nil, a, hgt * 0.32, 0)
		if i % 2 == 0 then
			add(Vector3.new(w * 0.6, 0.7, 0.3), CRIMSON, Enum.Material.Neon, nil, a, hgt * 0.15, 0.7)
		end
	end
	for k = 0, n - 1 do
		local a = k / n * math.pi * 2
		add(Vector3.new(2.4, hgt, 0.9), GOLD, Enum.Material.Metal, nil, a, hgt * 0.8, 0)
		add(Vector3.new(1.6, 1.6, 1.0), GOLD:Lerp(WHITE, 0.3), Enum.Material.Metal, nil, a, hgt * 1.3 + 0.6, 0, CFrame.Angles(0, 0, math.rad(45)))
		add(v3(1.6), k % 2 == 0 and CRIMSON or SAPPHIRE, Enum.Material.Neon, "ball", a, hgt * 0.75, 0.6)
	end
	return items
end
local function crownSet(items: { CrownItem }, cf: CFrame, R: number)
	for _, it in ipairs(items) do
		if it.p.Parent then
			it.p.CFrame = cf * CFrame.Angles(0, it.a, 0) * CFrame.new(0, it.y, -(R + it.dz)) * it.ex
		end
	end
end
local function crownFade(items: { CrownItem }, time: number)
	for _, it in ipairs(items) do
		if it.p.Parent then
			fadeOut(it.p, time)
		end
	end
end
-- 큰 터짐: 흰 심, 두 겹 껍질, 땅의 고리 셋 (빛깔 둘)
local function bigBurst(at: Vector3, R: number, c1: Color3, c2: Color3)
	local core = part(v3(6), WHITE, Enum.Material.Neon, 0, "ball")
	core.Position = at
	fadeOut(core, 0.8, { Size = v3(R * 2.4) })
	local shell = part(v3(8), c1, Enum.Material.Neon, 0.35, "ball")
	shell.Position = at
	fadeOut(shell, 1.0, { Size = v3(R * 3.2) })
	local outer = part(v3(8), c2, Enum.Material.Neon, 0.6, "ball")
	outer.Position = at
	fadeOut(outer, 1.2, { Size = v3(R * 4) })
	local g = ground(at)
	Fx.ring(g + UP * 0.5, c1, 6, R * 3.2, 0.9)
	Fx.ring(g + UP * 1.5, c2, 5, R * 2.5, 0.8)
	Fx.ring(g + UP * 3, WHITE, 4, R * 1.8, 0.6)
	Fx.blast(g + UP * 3, c1, c2, math.clamp(R / 10, 2.4, 4.4))
	Fx.debris(g, 20, 50)
	Fx.flash(at, WHITE, R * 6, 11, 1.2)
	if opts.flash and near(at, 200) then
		opts.flash(c1, 0.45)
	end
	Fx.breakSound("boom", 1.3, 0.3, at)
	Fx.breakSound("rock", 1, 0.5, at)
	shakeNear(at, 3, 320)
end

------------------------------------------------------------------------
-- 윤회권 (3.2판)
------------------------------------------------------------------------
local LIFE = { INDIGO, GOLD, REALMS[4], REALMS[6] }
-- 윤회삼륜 (E): 금빛 바퀴와 쪽빛 바퀴 둘이 부채꼴로 구르며 나갔다가 되돌아온다. 지나간 땅에 바퀴 자국, 가장 먼 곳에 바퀴 무늬
function H.rinneTriWheel(d: any)
	local from: Vector3 = d.from
	if not near(from, 300) then
		return
	end
	local look = flat(d.dir)
	local dist, time, spread, lag = d.dist or 26, d.time or 1.3, d.spread or 24, d.lag or 0.12
	hideWheel(d.m, time + lag + 0.1)
	Fx.sound("swing", 1, 0.6, from)
	local g0 = ground(from)
	for k = 1, 3 do
		local dk = CFrame.Angles(0, math.rad((k - 2) * spread), 0):VectorToWorldSpace(look)
		local axle = rightOf(dk)
		local main = k == 2
		local R = main and 3.4 or 2.6
		local col = main and GOLD or INDIGO
		local g = wheelGroup(R, main and 0.6 or 0.45)
		if not main then
			recolor(g, INDIGO, Enum.Material.Neon)
		end
		galpha(g, 1)
		local start = main and 0 or lag
		local lastP = g0 + UP * 0.12
		task.delay(start, function()
			anim(time, function(u)
				local s = dist * math.sin(u * math.pi)
				local p = g0 + UP * (R + 0.2) + dk * s
				gset(g, CFrame.lookAt(p, p + axle) * CFrame.Angles(0, 0, -s / R))
				galpha(g, main and 0 or 0.35)
				local gp = g0 + UP * 0.12 + dk * s
				if (gp - lastP).Magnitude > 1.2 then
					streak(lastP, gp, col, main and 1.4 or 1, 0.8)
					lastP = gp
					if math.random() < 0.5 then
						Fx.burst("spark", gp + UP * 0.5, col, 3, 1)
					end
				end
				if u >= 1 then
					gfade(g, 0.15)
				end
			end)
		end)
		task.delay(start + time * 0.5, function()
			local tip = g0 + dk * dist + UP * 0.2
			local seal = wheelGroup(main and 4 or 3, 0.3, 0.3)
			if not main then
				recolor(seal, INDIGO, Enum.Material.Neon)
			end
			gset(seal, CFrame.new(tip) * FLAT)
			gfade(seal, 0.6)
			Fx.ring(tip + UP * 0.2, col, 2, 14, 0.4)
			if main then
				Fx.sound("deflect", 0.8, 0.9, tip)
				shakeNear(tip, 0.5, 100)
			end
		end)
	end
	task.delay(time + lag, function()
		local r = rootOf(d.m)
		if r then
			Fx.ring(r.Position - UP * 2.6, GOLD, 2, 12, 0.35)
			Fx.burst("spark", r.Position, GOLD, 8, 1.2)
		end
	end)
end

-- 삼생보 (R): 떠난 자리에 멈춰 선 지난 세 삶이 차례로 같은 길을 다시 내달려 베고, 끝에서 나에게 모여들며 바퀴 무늬로 터진다
function H.threeLives(d: any)
	local a: Vector3, b: Vector3 = d.from, d.to
	if not near(a, 300) then
		return
	end
	local m = d.m
	local look = flat(b - a)
	local side = rightOf(look)
	local delay, gap, merge = d.delay or 0.4, d.gap or 0.16, d.merge or 1.05
	streak(ground(a) + UP * 0.15, ground(b) + UP * 0.15, GOLD, 1.6, 1.2)
	Fx.sound("swing", 1, 0.8, a)
	if typeof(m) ~= "Instance" then
		return
	end
	local ghosts = {}
	for k = 1, 3 do
		local g = ghostOf(m :: any, LIFE[k], 0.45)
		local off = side * ((k - 2) * 1.6)
		local p0 = a - look * (1 + k * 0.6) + off
		gset(g, CFrame.lookAt(p0, p0 + look))
		galpha(g, 1)
		local gh = { g = g, p = p0 }
		ghosts[k] = gh
		task.delay(0.05 * k, function()
			galpha(g, 0.45)
			Fx.burst("glitter", p0, LIFE[k], 4, 1)
		end)
		task.delay(delay + (k - 1) * gap, function()
			local q1 = b + off
			anim(0.14, function(u)
				local p = p0:Lerp(q1, u)
				gset(g, CFrame.lookAt(p, p + look))
			end)
			streak(ground(p0) + UP * 0.2, ground(q1) + UP * 0.2, LIFE[k], 1, 0.6)
			Fx.sound("swing", 0.7, 1 + k * 0.1, a)
			task.delay(0.14, function()
				gh.p = q1
				local seal = wheelGroup(2.2, 0.25, 0.2)
				recolor(seal, LIFE[k], Enum.Material.Neon)
				gset(seal, CFrame.new(ground(q1) + UP * 0.2) * FLAT)
				gfade(seal, 0.7)
				Fx.burst("spark", q1, LIFE[k], 5, 1)
			end)
		end)
	end
	task.delay(merge - 0.15, function()
		local r = rootOf(m)
		local c = r and r.Position or b
		for _, gh in ipairs(ghosts) do
			local start = gh.p
			anim(0.15, function(u)
				local p = start:Lerp(c, u * u)
				gset(gh.g, CFrame.lookAt(p, p + look))
				if u >= 1 then
					gfade(gh.g, 0.1)
				end
			end)
		end
	end)
	task.delay(merge, function()
		local r = rootOf(m)
		local c = r and r.Position or b
		local gc = ground(c) + UP * 0.25
		local seal = wheelGroup(5, 0.4, 0)
		anim(0.5, function(u)
			gset(seal, CFrame.new(gc) * CFrame.Angles(0, u * 3, 0) * FLAT)
			if u >= 1 then
				gfade(seal, 0.2)
			end
		end)
		Fx.ring(gc + UP * 0.2, GOLD, 3, 22, 0.45)
		Fx.ring(gc + UP * 0.4, INDIGO, 2, 16, 0.4)
		Fx.flash(c, GOLD, 50, 5, 0.35)
		Fx.burst("spark", c, GOLD, 14, 1.5)
		Fx.breakSound("boom", 0.8, 0.8, c)
		shakeNear(c, 0.9, 120)
	end)
end

-- 육도윤회 (오의): 하늘로 오른 큰 바퀴 → 여섯 구슬이 육각 자리에 빛기둥으로 꽂힘 → 육각별 → 바퀴가 누워 내려와 갈며 돎 → 내리박혀 터짐
function H.sixRealms(d: any)
	local c: Vector3 = d.at
	if not near(c, 400) then
		return
	end
	local from: Vector3 = d.from or c
	local look = flat(d.dir or (c - from))
	local spots = d.spots or {}
	local rise, every, fly, link, grind = d.rise or 0.55, d.every or 0.18, d.fly or 0.22, d.link or 0.35, d.grind or 1.0
	local T1 = rise + 6 * every
	local T2 = T1 + link
	local T3 = T2 + grind
	local R = 13
	local g0 = ground(c)
	local wheel = wheelGroup(R, 1.4)
	galpha(wheel, 1)
	local rootP = from + UP * 2
	local sky = from - look * 6 + UP * 32
	hideWheel(d.m, T3 + 0.3)
	if opts.tint then
		opts.tint(INDIGO, 0.3, T3 + 0.3)
	end
	local graded = near(c, 220)
	if graded then
		gradeTo(0.5, -0.2, -0.1, 0.15, Color3.fromRGB(215, 205, 255))
	end
	Fx.sound("ping", 0.6, 0.5, c)
	local wheelPos = rootP
	local landed = false
	anim(T3, function(u)
		local t = u * T3
		local spin = t * 2 + math.max(0, t - T2) ^ 2 * 8
		local cf
		if t < rise then
			local k = t / rise
			wheelPos = rootP:Lerp(sky, 1 - (1 - k) ^ 3)
			cf = CFrame.lookAt(wheelPos, wheelPos + look) * CFrame.Angles(0, 0, spin)
			galpha(wheel, 1 - k)
		elseif t < T2 then
			wheelPos = sky + UP * math.sin(t * 2) * 0.6
			cf = CFrame.lookAt(wheelPos, wheelPos + look) * CFrame.Angles(0, 0, spin)
			galpha(wheel, 0)
		else
			local k = math.clamp((t - T2) / (grind * 0.35), 0, 1)
			local e = k * k * (3 - 2 * k)
			wheelPos = sky:Lerp(g0 + UP * 1.5, e)
			cf = CFrame.lookAt(wheelPos, wheelPos + look):Lerp(CFrame.new(wheelPos) * FLAT, e) * CFrame.Angles(0, 0, spin)
			if k >= 1 then
				if not landed then
					landed = true
					Fx.breakSound("boom", 1, 0.6, c)
					Fx.ring(g0 + UP * 0.4, GOLD, R * 2, R * 2.6, 0.4)
					shakeNear(c, 1.4, 200)
				end
				if math.random() < 0.6 then
					local a = math.random() * math.pi * 2
					Fx.burst("spark", g0 + Vector3.new(math.cos(a) * R, 0.6, math.sin(a) * R), GOLD, 4, 1.4)
				end
			end
		end
		gset(wheel, cf)
		if u >= 1 then
			gfade(wheel, 0.1)
		end
	end)
	-- 여섯 구슬: 바퀴의 테에서 떨어져 나와 여섯 자리에 빛기둥으로 꽂힌다
	local pillars: { { any } } = {}
	for i = 1, 6 do
		task.delay(rise + (i - 1) * every, function()
			local col = REALMS[i]
			local orb = part(v3(2.4), col, Enum.Material.Neon, 0, "ball")
			local start = (CFrame.lookAt(wheelPos, wheelPos + look) * CFrame.new(orbOffset(R, i))).Position
			local target = spots[i] and ground(spots[i]) or g0
			Fx.sound("ping", 0.5, 0.8 + i * 0.08, start)
			anim(fly, function(u)
				local p = start:Lerp(target, u * u) + UP * math.sin(u * math.pi) * 6
				orb.Position = p
				trailDot(p, 1.6, col, 0.3)
				if u >= 1 then
					orb:Destroy()
					local pil = part(Vector3.new(40, 2.6, 2.6), col, Enum.Material.Neon, 0.25, "cyl")
					pil.CFrame = CFrame.new(target + UP * 20) * CFrame.Angles(0, 0, math.rad(90))
					local core = part(Vector3.new(40, 0.9, 0.9), WHITE, Enum.Material.Neon, 0.1, "cyl")
					core.CFrame = pil.CFrame
					pillars[i] = { pil, core, target }
					Fx.ring(target + UP * 0.3, col, 2, 16, 0.4)
					Fx.burst("spark", target + UP, col, 8, 1.3)
					shakeNear(target, 0.5, 120)
				end
			end)
		end)
	end
	-- 육각별: 기둥을 하나 건너 잇는 두 삼각형과 바깥 육각
	task.delay(T1, function()
		local lines = {}
		for i = 1, 6 do
			local p1, p2, p3 = spots[i], spots[(i % 6) + 1], spots[((i + 1) % 6) + 1]
			if p1 and p2 and p3 then
				for _, pair in ipairs({ { p2, 0.7 }, { p3, 1.2 } }) do
					local a0, a1 = ground(p1) + UP * 0.15, ground(pair[1]) + UP * 0.15
					local len = (a1 - a0).Magnitude
					local ln = part(Vector3.new(pair[2], 0.14, 0.2), REALMS[i], Enum.Material.Neon, 0.1)
					ln.CFrame = CFrame.lookAt((a0 + a1) / 2, a1)
					tween(ln, link, { Size = Vector3.new(pair[2], 0.14, len) })
					table.insert(lines, ln)
				end
			end
		end
		Fx.sound("ping", 0.7, 1.2, c)
		task.delay(link + grind, function()
			killList(lines, 0.3)
		end)
	end)
	task.delay(T3, function()
		for i, pl in pairs(pillars) do
			fadeOut(pl[1] :: BasePart, 0.5, { Size = Vector3.new(40, 7, 7) })
			fadeOut(pl[2] :: BasePart, 0.4)
			Fx.ring((pl[3] :: Vector3) + UP * 0.3, REALMS[i], 3, 20, 0.5)
		end
		bigBurst(g0 + UP * 2, (d.radius or 24) * 0.9, GOLD, INDIGO)
		if graded then
			gradeReset(1.0)
		end
	end)
end

-- 윤회전생 (초 오의)
local cycleState: { [any]: { ghosts: { any }, sky: Vector3 } } = {}
function H.rebirthCycle(d: any)
	local C: Vector3 = d.at
	if not near(C, 600) then
		return
	end
	local m = d.m
	local look = flat(d.dir or Vector3.new(0, 0, -1))
	local right = rightOf(look)
	local T1 = d.cut or 1.5
	local T2 = T1 + (d.army or 1.8)
	local T3 = T2 + (d.cage or 1.0)
	local T4 = T3 + (d.merge or 0.4)
	local cageR = d.cageR or 34
	local landT = T2 + (T3 - T2) * 0.4
	local gC = ground(C)
	local graded = near(C, 250)
	if graded then
		gradeTo(0.7, -0.3, -0.2, 0.2, Color3.fromRGB(190, 180, 255))
	end
	hideWheel(m, T4 + 0.3)
	Fx.sound("ping", 0.8, 0.3, C)
	Fx.breakSound("boom", 0.6, 0.3, C)
	local Rw = 30
	local wheel = wheelGroup(Rw, 2.6)
	galpha(wheel, 1)
	local sky = C - look * 30 + UP * 44
	local ghosts = {}
	if typeof(m) == "Instance" then
		for k = 1, 4 do
			local g = ghostOf(m :: any, LIFE[k], 0.4)
			local a = (k - 0.5) / 4 * math.pi * 2
			local home = C + (right * math.cos(a) + look * math.sin(a)) * 6
			ghosts[k] = { g = g, home = home, pos = home }
			galpha(g, 1)
		end
	end
	cycleState[m] = { ghosts = ghosts, sky = sky }
	-- 하늘에서 쪽빛 빛줄기가 내려와 바퀴가 걸린다
	local shaft = beamTo(sky + UP * 60, gC, 14, INDIGO, 0.75)
	fadeOut(shaft, T1)
	anim(T4, function(u)
		local t = u * T4
		local wheelCF
		if t < T1 then
			galpha(wheel, 1 - math.min(1, t / T1 * 2))
			wheelCF = CFrame.lookAt(sky, sky + look) * CFrame.Angles(0, 0, t * 0.3)
		elseif t < T2 then
			local k = (t - T1) / (T2 - T1)
			wheelCF = CFrame.lookAt(sky, sky + look) * CFrame.Angles(0, 0, T1 * 0.3 + (t - T1) * (1 + k * 4))
		elseif t < T3 then
			local k = math.clamp((t - T2) / (landT - T2), 0, 1)
			local e = k * k * (3 - 2 * k)
			local p = sky:Lerp(gC + UP * 2, e)
			wheelCF = CFrame.lookAt(p, p + look):Lerp(CFrame.new(p) * FLAT, e) * CFrame.Angles(0, 0, t * 5)
		else
			wheelCF = CFrame.new(gC + UP * 2) * FLAT * CFrame.Angles(0, 0, t * 9)
			galpha(wheel, (t - T3) / (T4 - T3))
		end
		gset(wheel, wheelCF)
		for k, gh in ipairs(ghosts) do
			local p
			if t < T1 then
				local kk = math.clamp((t - 0.2 * k) / 0.6, 0, 1)
				p = (gh.home - UP * 6):Lerp(gh.home, 1 - (1 - kk) ^ 2)
				galpha(gh.g, 1 - kk * 0.6)
			elseif t < T3 then
				p = gh.pos
			else
				local kk = (t - T3) / (T4 - T3)
				local r = rootOf(m)
				p = gh.pos:Lerp(r and r.Position or C, kk * kk)
			end
			gset(gh.g, CFrame.lookAt(p, p + look))
		end
		if u >= 1 then
			gfade(wheel, 0.1)
			for _, gh in ipairs(ghosts) do
				gfade(gh.g, 0.1)
			end
		end
	end)
	task.delay(T1, function()
		Fx.sound("swing", 1, 0.4, C)
		Fx.flash(sky, GOLD, 160, 7, 0.4)
		shakeNear(C, 1, 240)
	end)
	-- 바퀴가 땅에 내려앉아 둘레를 가둔다: 테에서 여섯 갈래 빛이 가운데로
	task.delay(landT, function()
		Fx.ring(gC + UP * 0.5, GOLD, cageR * 2, cageR * 2.4, 0.4)
		Fx.breakSound("boom", 1, 0.5, C)
		Fx.debris(gC, 14, 40)
		shakeNear(C, 1.8, 240)
		anim(T3 - landT, function(_u)
			if math.random() < 0.5 then
				local a = math.random() * math.pi * 2
				local q = gC + UP * 1.5 + Vector3.new(math.cos(a), 0, math.sin(a)) * cageR
				local b = beamTo(q, gC + UP * 2, 0.6, REALMS[math.random(1, 6)], 0.25)
				fadeOut(b, 0.2)
			end
		end)
	end)
	-- 다시 태어난다
	task.delay(T4, function()
		cycleState[m] = nil
		local R = d.radius or 38
		for k = 0, 23 do
			local a = k / 24 * math.pi * 2
			local spoke = beamTo(gC + UP * 0.4, gC + UP * 0.4 + Vector3.new(math.cos(a), 0, math.sin(a)) * R * 1.4, k % 2 == 0 and 1.6 or 0.8, k % 2 == 0 and GOLD or INDIGO, 0.1)
			fadeOut(spoke, 0.8)
		end
		for i = 1, 6 do
			local a = i / 6 * math.pi * 2
			pillar(gC + Vector3.new(math.cos(a), 0, math.sin(a)) * R * 0.55, REALMS[i], 6, 60, 0.8)
		end
		pillar(gC, WHITE, 18, 140, 0.9)
		bigBurst(gC + UP * 3, R, GOLD, INDIGO)
		if graded then
			gradeTo(0.1, 0.2, 0.45, 0.1, Color3.fromRGB(255, 240, 210))
			task.delay(0.35, function()
				gradeReset(1.6)
			end)
		end
	end)
end
-- 전생의 군세: 지난 삶 하나가 적에게 덮쳐 엇갈려 베고, 하늘 바퀴의 구슬이 빛줄기를 꽂는다
function H.rebirthStrike(d: any)
	local st = cycleState[d.m]
	local k = d.k or 1
	local gh = st and st.ghosts[k]
	local col = LIFE[k] or GOLD
	for i, at in ipairs(d.ats or {}) do
		if near(at, 320) then
			if gh and i == 1 then
				local from = gh.pos
				local spot = at + flat(at - (d.at or at) + Vector3.new(0.01, 0, 0)) * 2.5
				gh.pos = spot
				streak(ground(from) + UP * 0.2, ground(spot) + UP * 0.2, col, 0.8, 0.4)
				task.delay(0.12, function()
					gh.pos = gh.home
				end)
			end
			slashX(at, col, 7, 0.3)
			Fx.burst("spark", at, col, 6, 1.2)
			Fx.ring(ground(at) + UP * 0.3, col, 1, 10, 0.25)
			if st and math.random() < 0.6 then
				local b = beamTo(st.sky, at, 0.8, REALMS[math.random(1, 6)], 0.2)
				fadeOut(b, 0.18)
			end
		end
	end
	if d.at then
		Fx.sound("deflect", 0.5, 1.1, d.at)
	end
end

------------------------------------------------------------------------
-- 업화권 (3.2판)
------------------------------------------------------------------------
local function blackFlame(p: Vector3, size: number, rise: number, life: number)
	local dark = math.random() < 0.6
	local fl = part(v3(size), dark and CHAR or EMBER, dark and Enum.Material.SmoothPlastic or Enum.Material.Neon, 0.2, "ball")
	fl.Position = p
	fadeOut(fl, life, { Size = v3(size * 0.25), Position = p + UP * rise })
end
-- 업화쇄 (E): 사슬이 적 셋에게 날아가 걸리고, 검은 불이 사슬을 타고 번지며 끌어온 뒤, 발밑에서 지옥불로 터진다
function H.karmaChains(d: any)
	local m = d.m
	local r = rootOf(m)
	if not r or not near(r.Position, 300) then
		return
	end
	local hook, hold = d.hook or 0.18, d.hold or 0.42
	local targets = d.targets or {}
	local list: { any } = #targets > 0 and targets or { false }
	Fx.sound("block", 0.9, 0.6, r.Position)
	for i, tm in ipairs(list) do
		local hand = typeof(m) == "Instance" and m:FindFirstChild(i % 2 == 1 and "RightHand" or "LeftHand")
		local function src(): Vector3
			if hand and hand:IsA("BasePart") and hand.Parent then
				return hand.Position
			end
			return r.Position + UP
		end
		local function dst(): Vector3
			local tr = tm and rootOf(tm)
			return tr and tr.Position or d.to
		end
		local L = math.max(4, (dst() - src()).Magnitude)
		local links = chainParts(math.clamp(math.floor(L / 0.85), 6, 40))
		local life = hook + hold + 0.15
		anim(life, function(u)
			local t = u * life
			local a, b = src(), dst()
			local k
			if t < hook then
				k = t / hook
			elseif t < hook + hold then
				k = 1
			else
				k = 1 - (t - hook - hold) / 0.15
			end
			setChain(links, a, b, t < hook and 0.6 or 0.15, k)
			if t > hook and t < hook + hold and math.random() < 0.7 then
				blackFlame(a:Lerp(b, math.random()), 0.9, 1.6, 0.35)
			end
			if u >= 1 then
				for _, l in ipairs(links) do
					l:Destroy()
				end
			end
		end)
		task.delay(hook, function()
			local at = dst()
			Fx.burst("ember", at, EMBER, 8, 1.2)
			Fx.ring(ground(at) + UP * 0.3, HELL, 1, 8, 0.25)
			Fx.sound("block", 0.8, 0.9, at)
		end)
		task.delay(hook + hold, function()
			local at = dst()
			hellPillar(at, 14, 4, 0.5)
			for c = 1, 3 do
				crack(at, 6, c * 2.1 + math.random(), 0.8)
			end
			Fx.ring(ground(at) + UP * 0.3, EMBER, 2, 16, 0.4)
			Fx.burst("ember", at, EMBER, 12, 1.5)
			Fx.breakSound("boom", 0.8, 0.8, at)
			shakeNear(at, 0.7, 120)
		end)
	end
end

-- 겁화질주 (R): 지난 길이 용암 틈으로 갈라져 타고, 양옆으로 사슬이 휘몰아치고, 도화선처럼 불기둥 여덟이 차례로 솟아 끝에서 크게 터진다
function H.hellDash(d: any)
	local a: Vector3, b: Vector3 = d.from, d.to
	if not near(a, 300) then
		return
	end
	local burn, erupt, n, step = d.burn or 1.2, d.erupt or 1.3, d.pillars or 8, d.step or 0.06
	local look = flat(b - a)
	local right = rightOf(look)
	local ga, gb = ground(a) + UP * 0.12, ground(b) + UP * 0.12
	local segs: { BasePart } = {}
	local prev = ga
	for i = 1, 10 do
		local q = ga:Lerp(gb, i / 10) + right * ((i % 2 == 0) and 0.6 or -0.6) * (i < 10 and 1 or 0)
		local len = (q - prev).Magnitude
		local edge = part(Vector3.new(2.4, 0.1, len + 0.3), CHAR, Enum.Material.SmoothPlastic, 0.1)
		edge.CFrame = CFrame.lookAt((prev + q) / 2, q)
		local core = part(Vector3.new(0.9, 0.14, len + 0.3), EMBER, Enum.Material.Neon, 0)
		core.CFrame = edge.CFrame + UP * 0.03
		table.insert(segs, edge)
		table.insert(segs, core)
		prev = q
	end
	Fx.sound("swing", 1, 0.5, a)
	for s = -1, 1, 2 do
		local links = chainParts(22)
		anim(0.45, function(u)
			local p0 = ga + UP * 1.5 + right * s
			local p1 = ga:Lerp(gb, math.min(1, u * 1.3)) + UP * 1.5 + right * s * (3 + math.sin(u * math.pi) * 3)
			setChain(links, p0, p1, 1, 1)
			if u >= 1 then
				killList(links, 0.2)
			end
		end)
	end
	anim(burn + 0.2, function(_u)
		if math.random() < 0.7 then
			local p = ga:Lerp(gb, math.random()) + UP * 0.4
			blackFlame(p, 1.2, 2.5, 0.5)
			if math.random() < 0.3 then
				Fx.burst("ember", p, EMBER, 3, 1.2)
			end
		end
	end)
	for i = 1, n do
		task.delay(erupt + (i - 1) * step, function()
			local p = ga:Lerp(gb, i / n)
			hellPillar(p, 12 + i * 1.2, 3.4, 0.5)
			Fx.ring(p + UP * 0.2, EMBER, 1, 10, 0.3)
			Fx.sound("heavy", 0.6, 0.9 + i * 0.05, p)
		end)
	end
	task.delay(erupt + n * step + 0.1, function()
		hellPillar(gb, 30, 8, 0.7)
		for k = 1, 6 do
			crack(gb, 10, k, 1.0)
		end
		Fx.ring(gb + UP * 0.3, EMBER, 3, 26, 0.5)
		Fx.ring(gb + UP * 0.5, HELL, 2, 18, 0.5)
		Fx.blast(gb + UP * 2, EMBER, CHAR, 2)
		Fx.debris(gb, 10, 36)
		Fx.flash(b, EMBER, 80, 6, 0.5)
		Fx.breakSound("boom", 1, 0.6, b)
		shakeNear(b, 1.4, 160)
		killList(segs, 0.5)
	end)
end

-- 지옥문: 기둥 둘 (붉은 글, 뿔), 뿔 달린 들보, 붉은 눈, 문 안의 붉은 빛. 문짝 둘은 경첩 자리가 원점 (덩이의 -Z 쪽이 문 앞)
local function gateGroup(): (Group, Group, Group, number)
	local frame, doorL, doorR = group(), group(), group()
	local W, Hh = 8, 16
	for _, x in ipairs({ -1, 1 }) do
		gpart(frame, Vector3.new(2.2, Hh + 4, 2.6), CHAR, Enum.Material.SmoothPlastic, 0, nil, CFrame.new(x * (W + 1.1), (Hh + 4) / 2, 0))
		gpart(frame, Vector3.new(0.4, Hh, 0.3), EMBER, Enum.Material.Neon, 0.1, nil, CFrame.new(x * (W + 1.1), Hh / 2 + 1, -1.35))
		gpart(frame, Vector3.new(1, 5, 1), CHAR, Enum.Material.SmoothPlastic, 0, nil, CFrame.new(x * (W + 0.5), Hh + 6.5, 0) * CFrame.Angles(0, 0, -x * math.rad(25)))
		gpart(frame, v3(0.6), EMBER, Enum.Material.Neon, 0, "ball", CFrame.new(x * (W + 1.6), Hh + 8.6, 0))
	end
	gpart(frame, Vector3.new(2 * W + 6, 2.4, 3), CHAR, Enum.Material.SmoothPlastic, 0, nil, CFrame.new(0, Hh + 3, 0))
	gpart(frame, Vector3.new(2 * W + 2, 0.4, 0.3), EMBER, Enum.Material.Neon, 0.1, nil, CFrame.new(0, Hh + 3, -1.55))
	gpart(frame, v3(2.2), HELL, Enum.Material.Neon, 0, "ball", CFrame.new(0, Hh + 3, -1.4))
	gpart(frame, Vector3.new(2 * W, Hh, 0.3), HELL, Enum.Material.Neon, 0.15, nil, CFrame.new(0, Hh / 2, 0.6))
	for _, pair in ipairs({ { doorL, -1 }, { doorR, 1 } }) do
		local g, side = pair[1] :: Group, pair[2] :: number
		gpart(g, Vector3.new(W, Hh, 1), Color3.fromRGB(40, 22, 24), Enum.Material.Metal, 0, nil, CFrame.new(-side * W / 2, Hh / 2, 0))
		for k = 1, 4 do
			gpart(g, Vector3.new(W * 0.7, 0.35, 0.2), EMBER, Enum.Material.Neon, 0.1, nil, CFrame.new(-side * W / 2, Hh * k / 5, -0.55))
		end
		gpart(g, Vector3.new(0.35, Hh * 0.85, 0.2), EMBER, Enum.Material.Neon, 0.1, nil, CFrame.new(-side * W * 0.8, Hh / 2, -0.55))
		gpart(g, Vector3.new(0.3, 1.6, 1.6), GOLD_DEEP, Enum.Material.Metal, 0, "cyl", CFrame.new(-side * W * 0.85, Hh * 0.45, -0.7) * CFrame.Angles(0, math.rad(90), 0))
	end
	return frame, doorL, doorR, W
end
-- 업화지옥문 (오의)
function H.hellGate(d: any)
	local c: Vector3 = d.at
	if not near(c, 400) then
		return
	end
	local from: Vector3 = d.from or c
	local look = flat(d.dir or (c - from))
	local rise, open, drag, shut, sink = d.rise or 0.6, d.open or 0.4, d.drag or 1.0, d.shut or 0.4, d.sink or 0.5
	local T2 = rise + open
	local T3 = T2 + drag
	local T4 = T3 + shut
	local T5 = T4 + sink
	local g0 = ground(c)
	local frame, doorL, doorR, W = gateGroup()
	local toMe = -look
	local graded = near(c, 220)
	if graded then
		gradeTo(0.4, -0.25, -0.15, 0.25, Color3.fromRGB(255, 190, 180))
	end
	if opts.tint then
		opts.tint(HELL, 0.3, T5 + 0.3)
	end
	for k = 1, 8 do
		crack(c, 14, k / 8 * math.pi * 2, T5)
	end
	Fx.breakSound("rock", 1, 0.5, c)
	shakeNear(c, 1, 160)
	anim(T5, function(u)
		local t = u * T5
		local y = 0
		if t < rise then
			y = -22 * (1 - t / rise) ^ 3
		elseif t > T4 then
			y = -22 * ((t - T4) / sink) ^ 2
		end
		local ang = 0
		if t >= rise and t < T2 then
			ang = math.rad(80) * math.sqrt((t - rise) / open)
		elseif t >= T2 and t < T3 then
			ang = math.rad(80)
		elseif t >= T3 and t < T4 then
			ang = math.rad(80) * (1 - ((t - T3) / shut) ^ 3)
		end
		local p = g0 + UP * y
		local cf = CFrame.lookAt(p, p + toMe)
		if t < rise or t > T4 then
			cf = cf * CFrame.new((math.random() - 0.5) * 0.5, 0, 0)
		end
		gset(frame, cf)
		gset(doorL, cf * CFrame.new(-W, 0, 0) * CFrame.Angles(0, -ang, 0))
		gset(doorR, cf * CFrame.new(W, 0, 0) * CFrame.Angles(0, ang, 0))
		if (t < rise or t > T4) and math.random() < 0.5 then
			Fx.burst("dust", g0 + rightOf(look) * (math.random() - 0.5) * 20, Color3.fromRGB(120, 90, 80), 3, 1.6)
		end
		if u >= 1 then
			gfade(frame, 0.1)
			gfade(doorL, 0.1)
			gfade(doorR, 0.1)
		end
	end)
	task.delay(rise, function()
		Fx.breakSound("boom", 1, 0.4, c)
		Fx.flash(g0 + UP * 8, HELL, 90, 7, 0.5)
		shakeNear(c, 1.4, 200)
	end)
	-- 열린 문에서 검은 불과 붉은 빛이 쏟아진다
	task.delay(rise + open * 0.3, function()
		local glow = beamTo(g0 + UP * 8, g0 + UP * 8 + toMe * 30, 14, HELL, 0.7)
		fadeOut(glow, drag + open)
		anim(drag + open * 0.7, function(_u)
			if math.random() < 0.85 then
				local p0 = g0 + UP * (2 + math.random() * 12) + rightOf(look) * (math.random() - 0.5) * 12
				blackFlame(p0, 2 + math.random() * 2, 2, 0.6)
				local fl = part(v3(1.6), EMBER, Enum.Material.Neon, 0.3, "ball")
				fl.Position = p0
				fadeOut(fl, 0.6, { Position = p0 + toMe * (8 + math.random() * 10) + UP * 2, Size = v3(0.4) })
			end
		end)
	end)
	task.delay(T4, function()
		Fx.breakSound("boom", 1.3, 0.35, c)
		Fx.flash(g0 + UP * 8, EMBER, 120, 8, 0.4)
		Fx.ring(g0 + UP * 0.5, EMBER, 4, 30, 0.4)
		Fx.debris(g0, 14, 40)
		shakeNear(c, 2, 220)
	end)
	task.delay(T5, function()
		local R = d.radius or 20
		for k = 0, 7 do
			local a = k / 8 * math.pi * 2
			hellPillar(c + Vector3.new(math.cos(a), 0, math.sin(a)) * R * 0.6, 26, 5, 0.6)
		end
		hellPillar(c, 60, 12, 0.8)
		bigBurst(g0 + UP * 3, R, EMBER, CHAR)
		if graded then
			gradeReset(1.0)
		end
	end)
end
-- 문의 사슬: 문 안에서 뻗어 끌려오는 적들에게 걸린다
function H.gateChain(d: any)
	local c: Vector3 = d.at
	if not near(c, 300) then
		return
	end
	local src = ground(c) + UP * 6
	for _, at in ipairs(d.ats or {}) do
		local links = chainParts(math.clamp(math.floor((at - src).Magnitude / 0.85), 4, 36))
		anim(0.35, function(u)
			setChain(links, src, at, 0.4, math.min(1, u * 3))
			if u >= 1 then
				killList(links, 0.1)
			end
		end)
		Fx.burst("ember", at, EMBER, 4, 1)
	end
	Fx.sound("block", 0.6, 0.7, c)
end

-- 팔열지옥 (초 오의)
function H.eightHells(d: any)
	local C: Vector3 = d.at
	if not near(C, 600) then
		return
	end
	local look = flat(d.dir or Vector3.new(0, 0, -1))
	local right = rightOf(look)
	local T1 = d.cut or 1.4
	local T2 = T1 + 8 * (d.every or 0.2)
	local T3 = T2 + (d.hands or 0.9)
	local T4 = T3 + (d.sun or 0.9)
	local ringR = d.ringR or 30
	local gC = ground(C)
	local graded = near(C, 260)
	if graded then
		gradeTo(0.6, -0.3, -0.25, 0.35, Color3.fromRGB(255, 120, 110))
	end
	if opts.tint then
		opts.tint(HELL, 0.35, T4 + 0.3)
	end
	for k = 1, 16 do
		crack(C, 34, k / 16 * math.pi * 2, T4 + 0.3)
	end
	Fx.breakSound("rock", 1.2, 0.4, C)
	shakeNear(C, 1.2, 240)
	local top = C + UP * 30
	local rot = math.atan2(look.Z, look.X)
	for i = 1, 8 do
		local a = rot + (i - 1) / 8 * math.pi * 2
		local p = gC + Vector3.new(math.cos(a), 0, math.sin(a)) * ringR
		local t0 = 0.1 + i * 0.1
		task.delay(t0, function()
			local Hh = 60
			local outer = part(Vector3.new(0.5, 7, 7), CHAR, Enum.Material.SmoothPlastic, 0.15, "cyl")
			outer.CFrame = CFrame.new(p) * CFrame.Angles(0, 0, math.rad(90))
			local core = part(Vector3.new(0.5, 3, 3), EMBER, Enum.Material.Neon, 0.05, "cyl")
			core.CFrame = outer.CFrame
			tween(outer, 0.3, { Size = Vector3.new(Hh, 7, 7), CFrame = CFrame.new(p + UP * Hh / 2) * CFrame.Angles(0, 0, math.rad(90)) })
			tween(core, 0.3, { Size = Vector3.new(Hh + 2, 3, 3), CFrame = CFrame.new(p + UP * Hh / 2) * CFrame.Angles(0, 0, math.rad(90)) })
			Fx.ring(p + UP * 0.3, EMBER, 3, 20, 0.5)
			Fx.sound("heavy", 0.7, 0.6 + i * 0.04, p)
			anim(T3 - t0, function(_u)
				if math.random() < 0.25 then
					Fx.burst("ember", p + UP * math.random() * 40, EMBER, 3, 1.5)
				end
			end)
			-- 기둥이 머리 위로 모여 검은 해가 된다
			task.delay(T3 - t0, function()
				fadeOut(outer, 0.3)
				fadeOut(core, 0.25)
				local b1 = beamTo(p + UP * 30, top, 3, EMBER, 0.1)
				fadeOut(b1, T4 - T3)
				local b2 = beamTo(p, top, 5, CHAR, 0.3, Enum.Material.SmoothPlastic)
				fadeOut(b2, T4 - T3)
			end)
		end)
	end
	-- 거대한 불의 두 손: 양옆에서 솟아 가운데를 맞잡는다
	task.delay(T2, function()
		local hands = {}
		for _, sd in ipairs({ -1, 1 }) do
			local g, fingers = hellHand(2.6)
			table.insert(hands, { g = g, f = fingers, sd = sd })
		end
		local Hd = T3 - T2
		local clapT = Hd * 0.85
		Fx.breakSound("rock", 1, 0.5, C)
		anim(Hd, function(u)
			local t = u * Hd
			for _, h in ipairs(hands) do
				local y, off, curl
				if t < 0.35 then
					local k = t / 0.35
					y, off, curl = -25 + 35 * (1 - (1 - k) ^ 2), 16, 0.2
				elseif t < clapT then
					local k = (t - 0.35) / (clapT - 0.35)
					y, off, curl = 10, 16 - 13 * k * k, 0.2 + 0.4 * k
				else
					y, off, curl = 10, 3, 0.6
				end
				local pos = gC + UP * y + right * (h.sd * off)
				local palm = -right * h.sd
				setHand(h.g, h.f, CFrame.fromMatrix(pos, UP:Cross(palm), UP, palm), curl, 2.6)
			end
			if math.random() < 0.4 then
				Fx.burst("ember", gC + right * (math.random() - 0.5) * 30 + UP * math.random() * 20, EMBER, 3, 1.5)
			end
			if u >= 1 then
				for _, h in ipairs(hands) do
					gfade(h.g, 0.2)
					for _, fg in ipairs(h.f) do
						for j = 1, 3 do
							local q = fg[j]
							if q then
								fadeOut(q :: BasePart, 0.2)
							end
						end
					end
				end
			end
		end)
		task.delay(clapT, function()
			Fx.flash(gC + UP * 10, EMBER, 160, 9, 0.4)
			Fx.ring(gC + UP * 10, EMBER, 6, 60, 0.4, look)
			Fx.ring(gC + UP * 0.5, EMBER, 4, 40, 0.5)
			Fx.breakSound("boom", 1.3, 0.4, C)
			Fx.debris(gC, 16, 44)
			shakeNear(C, 2.4, 260)
		end)
	end)
	-- 검은 해: 머리 위에서 커지다가 떨어진다
	task.delay(T3, function()
		local sun = part(v3(2), CHAR, Enum.Material.SmoothPlastic, 0, "ball")
		local corona = part(v3(3), EMBER, Enum.Material.Neon, 0.45, "ball")
		local halo = group()
		gHalo(halo, 13, 1, EMBER, 36, 0.1)
		galpha(halo, 1)
		local Sd = T4 - T3
		anim(Sd, function(u)
			local t = u * Sd
			local fall = math.clamp((t - Sd * 0.75) / (Sd * 0.25), 0, 1)
			local p = top:Lerp(gC + UP * 3, fall * fall)
			local s = 2 + 20 * math.min(1, t / (Sd * 0.7))
			sun.Size = v3(s)
			sun.Position = p
			corona.Size = v3(s * 1.25)
			corona.Position = p
			galpha(halo, 1 - math.min(1, t / (Sd * 0.5)))
			gset(halo, CFrame.lookAt(p, p + camFace(p, -look)) * CFrame.Angles(0, 0, t * 2))
			if math.random() < 0.6 then
				Fx.burst("ember", p, EMBER, 3, 1.6)
			end
			if u >= 1 then
				sun:Destroy()
				corona:Destroy()
				gfade(halo, 0.05)
			end
		end)
		Fx.sound("ping", 0.6, 0.3, C)
	end)
	task.delay(T4, function()
		local R = d.radius or 40
		local dome = part(v3(6), CHAR, Enum.Material.SmoothPlastic, 0.1, "ball")
		dome.Position = gC
		fadeOut(dome, 1.0, { Size = v3(R * 2.6) })
		for k = 0, 11 do
			local a = k / 12 * math.pi * 2
			hellPillar(C + Vector3.new(math.cos(a), 0, math.sin(a)) * R * 0.55, 40, 6, 0.8)
		end
		hellPillar(C, 120, 20, 1.0)
		bigBurst(gC + UP * 3, R, EMBER, HELL)
		if graded then
			gradeTo(0.1, 0.1, 0.4, 0.2, Color3.fromRGB(255, 200, 180))
			task.delay(0.35, function()
				gradeReset(1.6)
			end)
		end
	end)
end
-- 팔열지옥의 한 기둥: 기둥 꼭대기에서 검은 불덩이가 적에게 떨어져 지옥불로 터진다
function H.hellStrike(d: any)
	local at: Vector3 = d.at
	if not near(at, 320) then
		return
	end
	local src: Vector3 = d.from or at
	local start = src + UP * 40
	local ball = part(v3(3.4), CHAR, Enum.Material.SmoothPlastic, 0, "ball")
	local core = part(v3(1.8), EMBER, Enum.Material.Neon, 0, "ball")
	anim(0.18, function(u)
		local p = start:Lerp(at, u)
		ball.Position = p
		core.Position = p
		trailDot(p, 2.2, EMBER, 0.25)
		if u >= 1 then
			ball:Destroy()
			core:Destroy()
		end
	end)
	task.delay(0.18, function()
		hellPillar(at, 26, 6, 0.6)
		for k = 1, 5 do
			crack(at, 8, k * 1.25, 0.9)
		end
		Fx.ring(ground(at) + UP * 0.3, EMBER, 2, 22, 0.4)
		Fx.burst("ember", at, EMBER, 12, 1.6)
		Fx.breakSound("boom", 0.9, 0.7, at)
		shakeNear(at, 1, 160)
	end)
end

------------------------------------------------------------------------
-- 무상권 (3.2판)
------------------------------------------------------------------------
-- 무상섬 (E): 적 다섯의 등 뒤로 차례로 나타나며 베고, 남은 잔상이 마지막에 한꺼번에 다시 베고 흩어진다
function H.phantomRush(d: any)
	local m = d.m
	local from: Vector3 = d.from
	if not near(from, 300) then
		return
	end
	local delay, every, echo = d.delay or 0.06, d.every or 0.14, d.echo or 0.3
	local targets = d.targets or {}
	mistPuff(from, 4, 0.6)
	Fx.sound("swing", 0.8, 1.3, from)
	local images = {}
	local prev = from
	for i, tm in ipairs(targets) do
		task.delay(delay + (i - 1) * every, function()
			local tr = rootOf(tm)
			if not tr then
				return
			end
			local tp = tr.Position
			local spot = tp + flat(tp - prev) * 3.2
			streak(ground(prev) + UP * 0.3, ground(spot) + UP * 0.3, GHOST, 0.5, 0.35, 0.1)
			if typeof(m) == "Instance" then
				local g = ghostOf(m :: any, GHOST, 0.55)
				gset(g, CFrame.lookAt(spot, Vector3.new(tp.X, spot.Y, tp.Z)))
				table.insert(images, { g = g, at = tp })
			end
			slashX(tp + UP * 0.5, GHOST, 7, 0.3)
			mistPuff(spot, 3, 0.5)
			Fx.burst("spark", tp, GHOST, 6, 1)
			Fx.sound("deflect", 0.6, 1.2 + i * 0.06, tp)
			prev = spot
		end)
	end
	task.delay(delay + math.max(1, #targets) * every + echo, function()
		for _, im in ipairs(images) do
			slashX(im.at + UP * 0.5, WHITE, 9, 0.35)
			slashX(im.at + UP * 0.5, GHOST, 11, 0.45)
			Fx.ring(ground(im.at) + UP * 0.3, GHOST, 1, 12, 0.3)
			gfade(im.g, 0.25)
			mistPuff(im.at, 4, 0.7)
		end
		if #images > 0 then
			Fx.sound("block", 0.8, 1.4, from)
			shakeNear(from, 0.7, 120)
		end
	end)
end

-- 허실분신 (R): 분신 다섯이 별처럼 뻗어 베고, 서로 엇갈려 오각별을 긋고, 가운데에서 내가 나타나며 별이 터진다
function H.mistStar(d: any)
	local C: Vector3 = d.at
	if not near(C, 300) then
		return
	end
	local m = d.m
	local pts = d.pts or {}
	local n = #pts
	local out, cross, back = d.out or 0.15, d.cross or 0.55, d.back or 0.95
	mistPuff(C, 6, 0.7)
	Fx.sound("swing", 1, 1.1, C)
	for k, pt in ipairs(pts) do
		local g = typeof(m) == "Instance" and ghostOf(m :: any, k % 2 == 0 and MIST or GHOST, 0.35) or nil
		local dirk = flat(pt - C)
		local q = pts[(k + 1) % n + 1]
		anim(out, function(u)
			local p = C:Lerp(pt, 1 - (1 - u) ^ 2)
			if g then
				gset(g, CFrame.lookAt(p, p + dirk) * CFrame.Angles(0, u * math.pi * 2, 0))
			end
			trailDot(p, 1.6, GHOST, 0.25)
		end)
		streak(ground(C) + UP * 0.25, ground(pt) + UP * 0.25, GHOST, 0.6, 0.5)
		task.delay(out, function()
			slashX(pt + UP * 0.5, GHOST, 6, 0.3)
			mistPuff(pt, 3, 0.4)
		end)
		task.delay(cross, function()
			local dq = flat(q - pt)
			anim(0.12, function(u)
				local p = pt:Lerp(q, u)
				if g then
					gset(g, CFrame.lookAt(p, p + dq))
				end
				trailDot(p, 1.4, WHITE, 0.25)
			end)
			local a0, a1 = ground(pt) + UP * 0.2, ground(q) + UP * 0.2
			local len = (a1 - a0).Magnitude
			local ln = part(Vector3.new(0.9, 0.14, len), GHOST, Enum.Material.Neon, 0.1)
			ln.CFrame = CFrame.lookAt((a0 + a1) / 2, a1)
			task.delay(back - cross, function()
				fadeOut(ln, 0.4, { Size = Vector3.new(3, 0.14, len) })
			end)
			Fx.sound("deflect", 0.5, 1.3, pt)
		end)
		task.delay(back - 0.12, function()
			anim(0.12, function(u)
				local p = q:Lerp(C, u * u)
				if g then
					gset(g, safeLook(p, C))
					if u >= 1 then
						gfade(g, 0.1)
					end
				end
			end)
		end)
	end
	task.delay(back, function()
		local gc = ground(C)
		Fx.ring(gc + UP * 0.3, GHOST, 3, 24, 0.45)
		Fx.ring(gc + UP * 0.5, WHITE, 2, 16, 0.35)
		for _ = 1, 5 do
			slashX(C + UP + Vector3.new(math.random() - 0.5, 0, math.random() - 0.5) * 6, GHOST, 8, 0.35)
		end
		mistPuff(C, 8, 0.8)
		Fx.flash(C, GHOST, 60, 5, 0.4)
		Fx.breakSound("boom", 0.7, 1.0, C)
		shakeNear(C, 0.9, 130)
	end)
end

-- 무상해 (오의): 안개 바다, 빛깔이 빠진 세상, 넋의 손, 도는 넋불 → 손뼉에 안개가 기둥으로 빨려 들었다가 사방으로 베며 흩어진다
function H.mistSea(d: any)
	local C: Vector3 = d.at
	if not near(C, 400) then
		return
	end
	local spread, hold, implode, R = d.spread or 0.4, d.hold or 1.6, d.implode or 0.35, d.radius or 28
	local gC = ground(C)
	local graded = near(C, 220)
	if graded then
		gradeTo(0.4, -0.85, -0.05, 0.2, Color3.fromRGB(225, 235, 245))
	end
	local fog = {}
	for k = 1, 26 do
		local a = k / 26 * math.pi * 2 + math.random() * 0.3
		local r = R * (0.25 + 0.75 * ((k % 3) + 1) / 3) * (0.85 + math.random() * 0.3)
		local sz = 8 + math.random() * 6
		local b = part(Vector3.new(sz, sz * 0.35, sz), MIST:Lerp(GHOST, math.random() * 0.25), Enum.Material.SmoothPlastic, 0.55, "ball")
		b.Position = gC + UP * 0.8
		tween(b, spread, { Position = gC + Vector3.new(math.cos(a) * r, 0.8, math.sin(a) * r) })
		fog[k] = b
	end
	local sea = part(Vector3.new(0.3, 2, 2), MIST, Enum.Material.SmoothPlastic, 0.6, "cyl")
	sea.CFrame = CFrame.new(gC + UP * 0.3) * CFrame.Angles(0, 0, math.rad(90))
	tween(sea, spread, { Size = Vector3.new(0.3, R * 2, R * 2) })
	Fx.sound("swing", 1, 0.4, C)
	local wisps = {}
	for k = 1, 6 do
		wisps[k] = part(v3(1.4), GHOST, Enum.Material.Neon, 0.1, "ball")
	end
	anim(spread + hold, function(u)
		local t = u * (spread + hold)
		for k, w in ipairs(wisps) do
			local a = t * 1.6 + k / 6 * math.pi * 2
			local rr = R * 0.6 + math.sin(t * 2 + k) * 4
			local p = gC + Vector3.new(math.cos(a) * rr, 2.5 + math.sin(t * 3 + k), math.sin(a) * rr)
			w.Position = p
			if math.random() < 0.5 then
				trailDot(p, 1, GHOST, 0.35)
			end
		end
		if u >= 1 then
			for _, w in ipairs(wisps) do
				fadeOut(w, 0.1)
			end
		end
	end)
	-- 넋의 손: 안개에서 솟아 적의 발목을 쥔다
	for i, tm in ipairs(d.targets or {}) do
		task.delay(spread + (i - 1) * 0.08, function()
			local tr = rootOf(tm)
			if not tr then
				return
			end
			local hand = ghostHand()
			local life = math.max(0.2, hold - (i - 1) * 0.08)
			local last = tr.Position
			anim(life, function(u)
				if tr.Parent then
					last = tr.Position
				end
				local rise = math.min(1, u * 4)
				gset(hand, CFrame.new(ground(last) + UP * (-3 + rise * 3.2)) * CFrame.Angles(0, u * 2, 0))
				if u >= 1 then
					gfade(hand, 0.15)
				end
			end)
			mistPuff(last, 3, 0.5)
			Fx.sound("deflect", 0.4, 0.6, last)
		end)
	end
	task.delay(spread + hold, function()
		for _, b in ipairs(fog) do
			tween(b, implode, { Position = gC + UP * 2, Size = Vector3.new(2, 2, 2) })
		end
		tween(sea, implode, { Size = Vector3.new(0.3, 2, 2) })
		local colm = part(Vector3.new(1, 3, 3), MIST, Enum.Material.SmoothPlastic, 0.4, "cyl")
		colm.CFrame = CFrame.new(gC + UP * 0.5) * CFrame.Angles(0, 0, math.rad(90))
		tween(colm, implode, { Size = Vector3.new(50, 9, 9), CFrame = CFrame.new(gC + UP * 25) * CFrame.Angles(0, 0, math.rad(90)) })
		Fx.sound("block", 1, 1.5, C)
		Fx.flash(C, WHITE, 50, 5, 0.2)
		task.delay(implode, function()
			for _, b in ipairs(fog) do
				b:Destroy()
			end
			sea:Destroy()
			fadeOut(colm, 0.5, { Size = Vector3.new(60, 30, 30) })
			for k = 1, 12 do
				local a = k / 12 * math.pi * 2
				local p = gC + UP * 1.5 + Vector3.new(math.cos(a), 0, math.sin(a)) * R * (0.4 + (k % 2) * 0.35)
				slashX(p, k % 2 == 0 and GHOST or WHITE, 10, 0.4)
				mistPuff(p, 4, 0.7)
			end
			Fx.ring(gC + UP * 0.5, GHOST, 6, R * 2.6, 0.7)
			Fx.ring(gC + UP * 1, WHITE, 4, R * 2, 0.6)
			Fx.blast(gC + UP * 2, GHOST, MIST, 3)
			Fx.flash(C, WHITE, 120, 8, 0.6)
			Fx.breakSound("boom", 1.1, 0.7, C)
			Fx.breakSound("glass", 0.7, 0.8, C)
			shakeNear(C, 2, 220)
			if graded then
				gradeTo(0.08, 0.2, 0.3, 0.1, WHITE)
				task.delay(0.15, function()
					gradeReset(0.8)
				end)
			end
		end)
	end)
end

-- 만상귀무 (초 오의)
function H.allReturn(d: any)
	local C: Vector3 = d.at
	if not near(C, 600) then
		return
	end
	local m = d.m
	local look = flat(d.dir or Vector3.new(0, 0, -1))
	local T1 = d.cut or 1.4
	local T2 = T1 + (d.rise or 0.6)
	local nS, sE, sT = d.sweeps or 3, d.sweepEvery or 0.5, d.sweepT or 0.25
	local T3 = T2 + nS * sE
	local T4 = T3 + (d.freeze or 0.8)
	local gC = ground(C)
	local graded = near(C, 260)
	if graded then
		gradeTo(0.8, -1, -0.1, 0.25, Color3.fromRGB(220, 230, 240))
	end
	-- 몸이 안개로 흩어진다: 몸 조각을 본뜬 안개가 위로 흩날리며 사라진다
	if typeof(m) == "Instance" then
		local g = ghostOf(m :: any, MIST, 0.2)
		local r = rootOf(m)
		local base = r and r.CFrame or CFrame.new(C)
		gset(g, base)
		for _, it in ipairs(g.items) do
			local p = it[1] :: BasePart
			local drift = Vector3.new((math.random() - 0.5) * 6, 4 + math.random() * 8, (math.random() - 0.5) * 6)
			tween(p, T1 * 0.8, { CFrame = base * (it[2] :: CFrame) + drift, Transparency = 1, Size = p.Size * 0.3 })
		end
		task.delay(T1, function()
			for _, it in ipairs(g.items) do
				local p = it[1] :: BasePart
				if p.Parent then
					p:Destroy()
				end
			end
		end)
	end
	for k = 1, 10 do
		task.delay(k * 0.1, function()
			mistPuff(C + Vector3.new((math.random() - 0.5) * 4, math.random() * 4, (math.random() - 0.5) * 4), 3, 0.8)
		end)
	end
	Fx.sound("swing", 0.8, 0.4, C)
	-- 거대한 그림자와 넋의 칼
	local S = 6
	local giant = typeof(m) == "Instance" and bigGhost(m :: any, S, GHOST, 0.55) or nil
	local blade = group()
	gpart(blade, Vector3.new(1.2, 0.5, 46), WHITE, Enum.Material.Neon, 0.1, nil, CFrame.new(0, 0, -23))
	gpart(blade, Vector3.new(3, 0.3, 48), GHOST, Enum.Material.Neon, 0.5, nil, CFrame.new(0, 0, -24))
	galpha(blade, 1)
	if giant then
		galpha(giant, 1)
	end
	local lastArc = 0
	anim(T4, function(u)
		local t = u * T4
		if giant and t >= T1 then
			local k = math.clamp((t - T1) / (T2 - T1), 0, 1)
			local e = 1 - (1 - k) ^ 2
			local base = gC + UP * (2.9 * S) - UP * (1 - e) * 40
			local sw = 0
			local sweeping = false
			if t >= T2 and t < T3 then
				local idx = math.floor((t - T2) / sE)
				local kk = ((t - T2) - idx * sE) / (sE * 0.8)
				local dirS = (idx % 2 == 0) and 1 or -1
				sw = dirS * (-1 + 2 * math.clamp(kk, 0, 1)) * math.rad(100)
				sweeping = kk <= 1
			end
			gset(giant, CFrame.lookAt(base, base + look) * CFrame.Angles(0, -sw * 0.35, 0))
			if t < T3 then
				galpha(giant, math.max(0.55, 1 - e))
			else
				galpha(giant, 0.55 + 0.45 * (t - T3) / (T4 - T3))
			end
			if sweeping then
				local dirB = CFrame.Angles(0, sw, 0):VectorToWorldSpace(look)
				local o = gC + UP * 3
				galpha(blade, 0)
				gset(blade, CFrame.lookAt(o, o + dirB))
				if os.clock() - lastArc > 0.02 then
					lastArc = os.clock()
					local b = beamTo(o + dirB * 6, o + dirB * 46, 1.5, GHOST, 0.4)
					fadeOut(b, 0.3)
				end
			else
				galpha(blade, 1)
			end
		end
		if u >= 1 then
			if giant then
				gfade(giant, 0.1)
			end
			gfade(blade, 0.1)
		end
	end)
	task.delay(T1, function()
		Fx.sound("swing", 1.2, 0.3, C)
		Fx.flash(gC + UP * 18, GHOST, 140, 6, 0.4)
		shakeNear(C, 1.2, 240)
	end)
	for k = 1, nS do
		task.delay(T2 + (k - 1) * sE + sT, function()
			Fx.sound("swing", 1.2, 0.5 + k * 0.05, C)
			Fx.ring(gC + UP * 3, GHOST, 6, 90, 0.4)
			Fx.flash(C, GHOST, 100, 5, 0.25)
			shakeNear(C, 1.6, 260)
		end)
	end
	-- 그림자가 내 자리로 흩어져 모이고, 빛깔이 돌아온다
	task.delay(T4 - 0.3, function()
		for k = 1, 16 do
			local a = k / 16 * math.pi * 2
			local p0 = gC + UP * 6 + Vector3.new(math.cos(a), 0, math.sin(a)) * 30
			local b = part(v3(3), MIST, Enum.Material.SmoothPlastic, 0.4, "ball")
			b.Position = p0
			tween(b, 0.3, { Position = gC + UP * 2, Size = v3(1) })
			task.delay(0.32, function()
				b:Destroy()
			end)
		end
	end)
	task.delay(T4, function()
		local R = d.radius or 42
		for k = 1, 10 do
			local a = k / 10 * math.pi * 2
			slashX(gC + UP * 2 + Vector3.new(math.cos(a), 0, math.sin(a)) * R * 0.45, GHOST, 14, 0.5)
		end
		mistPuff(C, 10, 1.0)
		bigBurst(gC + UP * 3, R, GHOST, MIST)
		if graded then
			gradeTo(0.06, 0.3, 0.5, 0.1, WHITE)
			task.delay(0.25, function()
				gradeReset(1.4)
			end)
		end
	end)
end
-- 시간이 멈추고 적마다 푸른 봉인: freeze 뒤에 한꺼번에 깨진다
function H.voidSeals(d: any)
	local fr = d.freeze or 0.8
	local C: Vector3 = d.at or Vector3.new()
	if near(C, 260) then
		gradeTo(0.1, -1, -0.25, 0.5, Color3.fromRGB(200, 225, 255))
	end
	Fx.sound("ping", 0.7, 0.3, C)
	for _, at in ipairs(d.ats or {}) do
		if near(at, 320) then
			local bars: { BasePart } = {}
			for k = -1, 1, 2 do
				local p = part(Vector3.new(0.4, 6, 0.4), GHOST, Enum.Material.Neon, 0.05)
				p.CFrame = CFrame.new(at + UP * 0.5) * CFrame.Angles(0, 0, math.rad(45 * k))
				table.insert(bars, p)
			end
			local ring = part(Vector3.new(0.2, 6, 6), GHOST, Enum.Material.Neon, 0.4, "cyl")
			ring.CFrame = CFrame.new(ground(at) + UP * 0.15) * CFrame.Angles(0, 0, math.rad(90))
			table.insert(bars, ring)
			task.delay(fr, function()
				for _, p in ipairs(bars) do
					fadeOut(p, 0.2, { Size = p.Size * 1.6 })
				end
				slashX(at + UP * 0.5, WHITE, 12, 0.4)
				slashX(at + UP * 0.5, GHOST, 14, 0.5)
				mistPuff(at, 5, 0.7)
				Fx.burst("glitter", at, GHOST, 10, 1.5)
				Fx.ring(ground(at) + UP * 0.3, GHOST, 2, 18, 0.4)
			end)
		end
	end
end

------------------------------------------------------------------------
-- 권왕신권 (3.2판)
------------------------------------------------------------------------
-- 왕권천타 (E): 등 뒤에 부채꼴로 나타난 금빛 주먹 여섯이 차례로 내지르고, 왕의 큰 주먹이 가운데를 꿰뚫는다
function H.kingBarrage(d: any)
	local from: Vector3 = d.from
	if not near(from, 300) then
		return
	end
	local look = flat(d.dir)
	local right = rightOf(look)
	local n, every, delay, finalAt, L = d.n or 6, d.every or 0.08, d.delay or 0.15, d.finalAt or 0.12, d.length or 28
	Fx.sound("heavy", 0.8, 0.6, from)
	for k = 1, n do
		local side = (k % 2 == 0 and 1 or -1) * math.ceil(k / 2) * 1.6
		local off = right * side
		local fist = fistGroup(0.5, 0)
		galpha(fist, 1)
		local home = from - look * 4 + off * 1.4 + UP * (3 + (math.ceil(k / 2) % 2) * 1.5)
		local wait = delay + (k - 1) * every
		anim(wait, function(u)
			gset(fist, CFrame.lookAt(home, home + look))
			galpha(fist, 1 - u)
		end)
		task.delay(wait, function()
			local a1 = from + off + look * L + UP * 1.5
			local dir = (a1 - home).Unit
			anim(0.12, function(u)
				local p = home:Lerp(a1, u)
				gset(fist, CFrame.lookAt(p, p + dir))
				trailDot(p - look * 2, 2.2, GOLD, 0.25)
				if u >= 1 then
					gfade(fist, 0.15)
				end
			end)
			streak(ground(from + off) + UP * 0.15, ground(a1) + UP * 0.15, GOLD, 0.5, 0.4)
			task.delay(0.12, function()
				Fx.ring(a1, GOLD, 1, 9, 0.25, look)
				Fx.burst("spark", a1, GOLD, 5, 1)
				Fx.sound("hit", 0.6, 1 + k * 0.06, a1)
			end)
		end)
	end
	task.delay(delay + n * every + finalAt - 0.14, function()
		local big = fistGroup(1.1, 0)
		local a0 = from - look * 6 + UP * 4
		local a1 = from + look * (L + 6) + UP * 2
		anim(0.14, function(u)
			local p = a0:Lerp(a1, u)
			gset(big, CFrame.lookAt(p, p + look))
			trailDot(p - look * 4, 5, GOLD, 0.35)
			if u >= 1 then
				gfade(big, 0.2)
			end
		end)
		for i = 1, 6 do
			task.delay(0.14 * i / 6, function()
				local p = from + look * (L + 6) * i / 6
				Fx.ring(ground(p) + UP * 0.3, GOLD, 2, 12 + i * 2, 0.35)
				Fx.ring(p + UP * 2, GOLD, 2, 10, 0.25, look)
			end)
		end
		task.delay(0.14, function()
			goldImpact(a1, 1.3)
			Fx.flash(a1, GOLD, 60, 6, 0.4)
			Fx.breakSound("boom", 1, 0.7, a1)
			shakeNear(a1, 1.2, 150)
		end)
	end)
end

-- 왕도강림 (R): 붉은 길이 깔리고 그 위로 뛰어오른다 (금빛 꼬리)
function H.kingLeap(d: any)
	local a: Vector3, b: Vector3 = d.from, d.to
	if not near(a, 300) then
		return
	end
	local land = d.land or 0.42
	local look = flat(b - a)
	local right = rightOf(look)
	local ga = ground(a) + UP * 0.1
	local L = (ground(b) - ground(a)).Magnitude
	local carpet = part(Vector3.new(4, 0.1, 0.2), CRIMSON, Enum.Material.Fabric, 0)
	local trims = { part(Vector3.new(0.35, 0.12, 0.2), GOLD, Enum.Material.Metal, 0), part(Vector3.new(0.35, 0.12, 0.2), GOLD, Enum.Material.Metal, 0) }
	anim(land, function(u)
		local len = math.max(0.2, L * u)
		local mid = ga + look * (len / 2)
		carpet.Size = Vector3.new(4, 0.1, len)
		carpet.CFrame = CFrame.lookAt(mid, mid + look)
		for i, tr in ipairs(trims) do
			local sm = mid + right * (i == 1 and 2 or -2)
			tr.Size = Vector3.new(0.35, 0.12, len)
			tr.CFrame = CFrame.lookAt(sm, sm + look)
		end
	end)
	task.delay(land + 1.2, function()
		fadeOut(carpet, 0.5)
		for _, tr in ipairs(trims) do
			fadeOut(tr, 0.5)
		end
	end)
	local r = rootOf(d.m)
	anim(land, function(_u)
		if r and r.Parent and math.random() < 0.8 then
			trailDot(r.Position, 2, GOLD, 0.35)
		end
	end)
	Fx.sound("jump", 1, 0.8, a)
	Fx.ring(ga + UP * 0.2, GOLD, 2, 12, 0.3)
end
-- 내려앉은 자리: 왕관의 가시 여덟이 솟았다가 안으로 무너지며 터진다
function H.kingLand(d: any)
	local at: Vector3 = d.at
	if not near(at, 300) then
		return
	end
	local collapse, R = d.collapse or 0.4, d.spikeR or 8
	local g = ground(at)
	goldImpact(at, 1.2)
	Fx.breakSound("boom", 1, 0.7, at)
	local spikes = {}
	for k = 0, 7 do
		local a = k / 8 * math.pi * 2
		local base = g + Vector3.new(math.cos(a), 0, math.sin(a)) * R
		local hgt = (k % 2 == 0) and 9 or 6
		local sp = group()
		gpart(sp, Vector3.new(2.2, hgt, 0.8), GOLD, Enum.Material.Metal, 0, nil, CFrame.new(0, hgt / 2, 0))
		gpart(sp, Vector3.new(1.2, hgt * 0.4, 0.9), GOLD:Lerp(WHITE, 0.3), Enum.Material.Metal, 0, nil, CFrame.new(0, hgt * 0.95, 0) * CFrame.Angles(0, 0, math.rad(45)))
		gpart(sp, v3(1), k % 2 == 0 and CRIMSON or SAPPHIRE, Enum.Material.Neon, 0, "ball", CFrame.new(0, hgt * 0.55, -0.5))
		table.insert(spikes, { g = sp, base = base, h = hgt })
	end
	local life = collapse + 0.15
	anim(life, function(u)
		local t = u * life
		for _, s in ipairs(spikes) do
			local rise = math.min(1, t / 0.12)
			local lean = math.clamp((t - (collapse - 0.12)) / 0.15, 0, 1)
			local cf = safeLook(s.base, s.base + flat(g - s.base)) * CFrame.new(0, -s.h * (1 - rise), 0) * CFrame.Angles(-lean * math.rad(70), 0, 0)
			gset(s.g, cf)
		end
		if u >= 1 then
			for _, s in ipairs(spikes) do
				gfade(s.g, 0.15)
			end
		end
	end)
	task.delay(collapse, function()
		local core = part(v3(4), WHITE, Enum.Material.Neon, 0, "ball")
		core.Position = g + UP * 3
		fadeOut(core, 0.4, { Size = v3(R * 3) })
		Fx.ring(g + UP * 0.3, GOLD, 3, R * 3.5, 0.45)
		Fx.ring(g + UP * 0.5, CRIMSON, 2, R * 2.5, 0.4)
		pillar(g, GOLD, 6, 30, 0.5)
		Fx.burst("spark", g + UP * 2, GOLD, 16, 1.6)
		Fx.flash(at, GOLD, 70, 6, 0.4)
		Fx.breakSound("boom", 1, 0.6, at)
		shakeNear(at, 1.4, 160)
	end)
end

-- 금빛 구름 고리: 하늘 높이 둥글게 열린다
local function goldClouds(at: Vector3, h: number, r0: number, r1: number, time: number, life: number)
	for k = 1, 12 do
		local a = k / 12 * math.pi * 2
		local cl = part(Vector3.new(14, 5, 10), Color3.fromRGB(255, 225, 150), Enum.Material.SmoothPlastic, 0.4, "ball")
		local dir = Vector3.new(math.cos(a), 0, math.sin(a))
		cl.CFrame = CFrame.lookAt(at + UP * h + dir * r0, at + UP * h + dir * (r0 + 1))
		tween(cl, time, { CFrame = CFrame.lookAt(at + UP * h + dir * r1, at + UP * h + dir * (r1 + 1)) })
		task.delay(time, function()
			fadeOut(cl, life)
		end)
	end
end
-- 만인지상 (오의): 금빛 구름이 열리고 거대한 왕관이 내려와 가두고, 돌며 조이고, 보석이 빛줄기를 쏘고, 내리박혀 터진다
function H.crownCage(d: any)
	local c: Vector3 = d.at
	if not near(c, 400) then
		return
	end
	local descend, squeeze, slam = d.descend or 0.6, d.squeeze or 1.2, d.slam or 0.4
	local R0 = d.R or 14
	local total = descend + squeeze + slam
	local g0 = ground(c)
	local graded = near(c, 220)
	if graded then
		gradeTo(0.4, 0.1, 0.05, 0.15, Color3.fromRGB(255, 235, 190))
	end
	if opts.tint then
		opts.tint(GOLD, 0.25, total + 0.3)
	end
	goldClouds(g0, 60, 6, 26, descend, squeeze + slam)
	local light = beamTo(g0 + UP * 60, g0, 10, Color3.fromRGB(255, 235, 170), 0.6)
	local cr = crownNew(R0, 10, 10)
	Fx.sound("ping", 0.7, 0.5, c)
	anim(total + 0.1, function(u)
		local t = u * (total + 0.1)
		local y, R, spin
		if t < descend then
			local k = t / descend
			y, R, spin = 55 * (1 - k * k), R0, t * 1.5
		elseif t < descend + squeeze then
			local k = (t - descend) / squeeze
			y, R, spin = 0, R0 - (R0 - 6) * k * k, descend * 1.5 + (t - descend) * (2 + k * 8)
		else
			local k = math.min(1, (t - descend - squeeze) / slam)
			y, R, spin = 6 * math.sin(k * math.pi), 6, descend * 1.5 + squeeze * 6 + (t - descend - squeeze) * 10
		end
		crownSet(cr, CFrame.new(g0 + UP * y) * CFrame.Angles(0, spin, 0), R)
		if u >= 1 then
			crownFade(cr, 0.15)
		end
	end)
	task.delay(descend, function()
		Fx.breakSound("boom", 1.1, 0.5, c)
		Fx.ring(g0 + UP * 0.4, GOLD, R0 * 2, R0 * 2.8, 0.4)
		Fx.debris(g0, 14, 40)
		Fx.flash(c, GOLD, 90, 6, 0.4)
		shakeNear(c, 1.6, 200)
		fadeOut(light, 0.4)
		anim(squeeze, function(u)
			if math.random() < 0.45 then
				local a = math.random() * math.pi * 2
				local R = R0 - (R0 - 6) * u * u
				local q = g0 + UP * 7.5 + Vector3.new(math.cos(a), 0, math.sin(a)) * R
				local b = beamTo(q, g0 + UP * 2, 0.6, math.random() < 0.5 and CRIMSON or SAPPHIRE, 0.15)
				fadeOut(b, 0.15)
				Fx.burst("spark", g0 + UP * 2, GOLD, 2, 1)
			end
		end)
	end)
	task.delay(total, function()
		local R = d.radius or 22
		for k = 0, 9 do
			local a = k / 10 * math.pi * 2
			pillar(g0 + Vector3.new(math.cos(a), 0, math.sin(a)) * 6, GOLD, 4, 40, 0.6)
		end
		-- 붉은 깃발 여덟이 바깥으로 펼쳐진다
		for k = 0, 7 do
			local a = k / 8 * math.pi * 2 + 0.2
			local dir = Vector3.new(math.cos(a), 0, math.sin(a))
			local flag = part(Vector3.new(0.3, 7, 3), CRIMSON, Enum.Material.Fabric, 0)
			flag.CFrame = CFrame.lookAt(g0 + UP * 3.5 + dir * 4, g0 + UP * 3.5 + dir * 5)
			fadeOut(flag, 0.8, { CFrame = CFrame.lookAt(g0 + UP * 4 + dir * R, g0 + UP * 4 + dir * (R + 1)) })
		end
		bigBurst(g0 + UP * 3, R, GOLD, CRIMSON)
		if graded then
			gradeReset(1.0)
		end
	end)
end

-- 천하제일권 (초 오의)
function H.kingOfHeaven(d: any)
	local C: Vector3 = d.at
	if not near(C, 600) then
		return
	end
	local look = flat(d.dir or Vector3.new(0, 0, -1))
	local right = rightOf(look)
	local T1 = d.cut or 1.5
	local T2 = T1 + (d.rain or 1.8)
	local T3 = T2 + (d.charge or 0.8)
	local T4 = T3 + (d.punch or 0.3)
	local T5 = T4 + (d.endAt or 0.4)
	local L = d.length or 80
	local gC = ground(C)
	local graded = near(C, 260)
	if graded then
		gradeTo(0.6, 0.15, 0.05, 0.2, Color3.fromRGB(255, 230, 180))
	end
	goldClouds(gC, 80, 10, 60, T1, T5 - T1)
	local shaft = beamTo(gC + UP * 90, gC, 30, Color3.fromRGB(255, 235, 170), 0.7)
	fadeOut(shaft, T1 + 0.5)
	Fx.sound("ping", 0.8, 0.4, C)
	local s = 2.2
	local king = kingGroup(s)
	galpha(king.g, 1)
	local base = gC - look * 14 + UP * (5 * s)
	anim(T5, function(u)
		local t = u * T5
		local y = 0
		if t < T1 then
			local k = t / T1
			y = -50 * (1 - k) ^ 2
			galpha(king.g, 1 - math.min(1, k * 1.5))
		end
		local lean = 0
		if t >= T1 and t < T2 then
			lean = math.sin(t * 25) * 0.04
		elseif t >= T2 and t < T3 then
			lean = -0.15 * (t - T2) / (T3 - T2)
		elseif t >= T3 then
			lean = 0.25 * math.min(1, (t - T3) / 0.1)
		end
		local p = base + UP * y
		gset(king.g, CFrame.lookAt(p, p + look) * CFrame.Angles(-lean, 0, 0))
		if t > T4 + 0.1 then
			galpha(king.g, math.min(1, (t - T4 - 0.1) / (T5 - T4)))
		end
		if t < T1 and math.random() < 0.4 then
			Fx.burst("spark", p + right * (math.random() - 0.5) * 20 + UP * math.random() * 30, GOLD, 3, 1.5)
		end
		if u >= 1 then
			gfade(king.g, 0.1)
		end
	end)
	task.delay(T1, function()
		Fx.breakSound("boom", 1.1, 0.4, C)
		Fx.flash(base, GOLD, 160, 7, 0.4)
		shakeNear(C, 1.4, 240)
	end)
	-- 힘을 모은다: 둘레의 금빛이 왕의 오른 주먹과 내 손으로 빨려 든다
	task.delay(T2, function()
		local fist = king.fists[2]
		anim(T3 - T2, function(u)
			local fp = (fist and fist.Parent) and fist.CFrame.Position or (base + UP * 10)
			if math.random() < 0.8 then
				local a = math.random() * math.pi * 2
				local q = fp + Vector3.new(math.cos(a), (math.random() - 0.5) * 1.2, math.sin(a)) * (18 + math.random() * 10)
				local b = beamTo(q, fp, 0.4, GOLD, 0.2)
				fadeOut(b, 0.15)
			end
			if math.random() < 0.3 then
				local a = math.random() * math.pi * 2
				local p0 = gC + UP * 0.15
				local p1 = p0 + Vector3.new(math.cos(a), 0, math.sin(a)) * (6 + u * 20)
				streak(p0, p1, GOLD, 0.6, 0.4)
			end
		end)
		Fx.sound("ping", 0.8, 0.6, C)
		Fx.sound("swing", 0.9, 0.35, C)
	end)
	-- 함께 내지른다: 거대한 주먹이 80칸을 꿰뚫는다
	task.delay(T3, function()
		local big = fistGroup(3.4, 0)
		local fist = king.fists[2]
		local a0 = (fist and fist.Parent) and fist.CFrame.Position or (base + UP * 10)
		local a1 = gC + look * L + UP * 6
		local dir = (a1 - a0).Unit
		local core = beamTo(a0, a0 + dir * 0.5, 6, WHITE, 0)
		local glow = beamTo(a0, a0 + dir * 0.5, 16, GOLD, 0.4)
		local pt = T4 - T3
		local lastRing = 0
		anim(pt, function(u)
			local p = a0:Lerp(a1, u)
			gset(big, CFrame.lookAt(p, p + dir))
			setBeam(core, a0, p, 6)
			setBeam(glow, a0, p, 16)
			if u - lastRing > 0.1 then
				lastRing = u
				Fx.ring(p, GOLD, 6, 30, 0.4, dir)
			end
			if u >= 1 then
				gfade(big, 0.25)
				fadeOut(core, 0.5, { Size = Vector3.new(core.Size.X, 0.5, 0.5) })
				fadeOut(glow, 0.6, { Size = Vector3.new(glow.Size.X, 30, 30) })
			end
		end)
		streak(gC + UP * 0.2, ground(a1) + UP * 0.2, GOLD, 4, 1.0)
		Fx.flash(a0, WHITE, 160, 9, 0.4)
		Fx.breakSound("boom", 1.2, 0.4, C)
		shakeNear(C, 2.4, 300)
	end)
	-- 끝에서 왕관 모양으로 터진다
	task.delay(T5, function()
		local at = gC + look * L
		local cr = crownNew(10, 10, 12)
		anim(0.6, function(u)
			local y = -16 + 16 * math.min(1, u * 3)
			crownSet(cr, CFrame.new(at + UP * y) * CFrame.Angles(0, u * 2, 0), 10)
			if u >= 1 then
				crownFade(cr, 0.2)
			end
		end)
		pillar(at, GOLD, 20, 140, 0.9)
		bigBurst(at + UP * 3, 22, GOLD, CRIMSON)
		if graded then
			gradeTo(0.1, 0.2, 0.4, 0.1, Color3.fromRGB(255, 240, 200))
			task.delay(0.35, function()
				gradeReset(1.6)
			end)
		end
	end)
end
-- 왕의 주먹비: 하늘의 왕 쪽에서 금빛 주먹이 땅으로 내리꽂힌다
function H.kingRain(d: any)
	local at: Vector3 = d.at
	if not near(at, 320) then
		return
	end
	local from: Vector3 = d.from or (at + UP * 40)
	local fall = d.fall or 0.25
	local f = fistGroup(0.8, 0)
	local dir = (at - from).Unit
	anim(fall, function(u)
		local p = from:Lerp(at + UP * 2, u)
		gset(f, safeLook(p, p + dir))
		trailDot(p, 2.6, GOLD, 0.25)
		if u >= 1 then
			gfade(f, 0.12)
		end
	end)
	task.delay(fall, function()
		goldImpact(at, 0.9)
	end)
end

------------------------------------------------------------------------
-- 초 오의 컷씬 (쓴 사람 화면에서만, 대사 없이). 권법마다 카메라 길과 빛깔이 다르다
-- 윤회권: 앞쪽 낮은 곳에서 등 뒤 하늘의 바퀴를 올려다본다 · 업화권: 낮게 나를 돌며 솟는 불기둥을 본다
-- 무상권: 얼굴 가까이에서 흩어지는 몸을 보다가 멀리 물러선다 · 권왕신권: 앞에서 나와 등 뒤의 거대한 왕을 올려다본다
-- 몽유권: 밤하늘 남색 빛깔
------------------------------------------------------------------------
local CUT_LOOK: { [string]: { any } } = {
	rinne = { Color3.fromRGB(40, 30, 90), GOLD, INDIGO },
	eophwa = { Color3.fromRGB(90, 10, 10), Color3.fromRGB(255, 150, 120), CHAR },
	musangkwon = { Color3.fromRGB(60, 70, 80), MIST, Color3.fromRGB(60, 110, 140) },
	kwonwangsin = { Color3.fromRGB(90, 60, 10), GOLD, CRIMSON },
	hojeop = { Color3.fromRGB(24, 28, 80), Color3.fromRGB(255, 232, 170), Color3.fromRGB(150, 140, 240) },
}
local cutActive = false
function Samsara.superCut(model: Model, dur: number, name: string, shake: ((number) -> ())?, sid: string)
	local cam = workspace.CurrentCamera
	local r = rootOf(model)
	local player = game:GetService("Players").LocalPlayer
	if not cam or not r or cutActive or not player then
		return
	end
	cutActive = true
	local lk = CUT_LOOK[sid] or CUT_LOOK.rinne
	local g = Instance.new("ScreenGui")
	g.Name = "KwonRebirthCut"
	g.IgnoreGuiInset = true
	g.ResetOnSpawn = false
	g.DisplayOrder = 85
	g.Parent = player:WaitForChild("PlayerGui")
	local tintF = Instance.new("Frame")
	tintF.Size = UDim2.fromScale(1, 1)
	tintF.BackgroundColor3 = lk[1]
	tintF.BackgroundTransparency = 1
	tintF.BorderSizePixel = 0
	tintF.Parent = g
	local grad = Instance.new("UIGradient")
	grad.Rotation = 90
	grad.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.1), NumberSequenceKeypoint.new(0.4, 1), NumberSequenceKeypoint.new(0.6, 1), NumberSequenceKeypoint.new(1, 0.1) })
	grad.Parent = tintF
	tween(tintF, 0.3, { BackgroundTransparency = 0.4 })
	local bars: { Frame } = {}
	for i, y in ipairs({ 0, 1 }) do
		local b = Instance.new("Frame")
		b.AnchorPoint = Vector2.new(0, y)
		b.Position = UDim2.fromScale(0, y)
		b.Size = UDim2.new(1, 0, 0, 0)
		b.BackgroundColor3 = Color3.new(0, 0, 0)
		b.BorderSizePixel = 0
		b.ZIndex = 5
		b.Parent = g
		tween(b, 0.15, { Size = UDim2.new(1, 0, 0.14, 0) })
		bars[i] = b
	end
	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.AnchorPoint = Vector2.new(1, 0.5)
	label.Position = UDim2.new(1, -30, 0.5, 0)
	label.Size = UDim2.new(0.5, 0, 0.45, 0)
	label.Font = Enum.Font.GothamBlack
	label.TextScaled = true
	label.TextXAlignment = Enum.TextXAlignment.Right
	label.Text = "초 오의 · " .. name
	label.TextColor3 = lk[2]
	label.TextStrokeColor3 = lk[3]
	label.TextStrokeTransparency = 0.2
	label.TextTransparency = 1
	label.ZIndex = 6
	label.Parent = bars[2]
	tween(label, 0.25, { TextTransparency = 0 })
	local oldType = cam.CameraType
	local oldFov = cam.FieldOfView
	local look = flat(r.CFrame.LookVector)
	local side = Vector3.new(-look.Z, 0, look.X)
	cam.CameraType = Enum.CameraType.Scriptable
	local t0 = os.clock()
	local focus = r.Position
	local finished = false
	local function restore()
		if finished then
			return
		end
		finished = true
		RunService:UnbindFromRenderStep("KwonRebirthCut")
		cam.CameraType = oldType == Enum.CameraType.Scriptable and Enum.CameraType.Custom or oldType
		cam.FieldOfView = oldFov
		cutActive = false
		local function behind()
			if r.Parent then
				local lv = flat(r.CFrame.LookVector)
				cam.CFrame = CFrame.lookAt(r.Position - lv * 24 + UP * 13, r.Position + lv * 6 + UP * 6)
			end
		end
		behind()
		task.defer(behind)
		for _, b in ipairs(bars) do
			tween(b, 0.2, { Size = UDim2.new(1, 0, 0, 0) })
		end
		tween(tintF, 0.25, { BackgroundTransparency = 1 })
		tween(label, 0.2, { TextTransparency = 1 })
		task.delay(0.3, function()
			g:Destroy()
		end)
	end
	RunService:BindToRenderStep("KwonRebirthCut", Enum.RenderPriority.Camera.Value + 2, function(dt: number)
		if finished then
			return
		end
		if not r.Parent then
			restore()
			return
		end
		local t = os.clock() - t0
		local k = math.clamp(t / dur, 0, 1)
		focus = focus:Lerp(r.Position, math.min(1, dt * 10))
		local e = 1 - (1 - k) ^ 2
		local eye, target
		if sid == "eophwa" then
			local a = e * math.rad(200) - math.rad(30)
			eye = focus + (look * math.cos(a) + side * math.sin(a)) * (12 + e * 5) + UP * (0.8 + e * 2.5)
			target = focus + UP * (4 + e * 6)
		elseif sid == "musangkwon" then
			eye = focus + look * (3 + e * 16) + side * e * 4 + UP * (1.5 + e * 10)
			target = focus + UP * (1.5 + e * 7)
		elseif sid == "kwonwangsin" then
			eye = focus + look * (10 + e * 8) + side * (4 - e * 2) + UP * (0.5 + e * 1.5)
			target = focus - look * 14 + UP * (8 + e * 22)
		else
			eye = focus + look * (9 + e * 6) + side * math.sin(e * 0.8) * 6 + UP * (0.6 + e * 2.5)
			target = focus - look * 40 + UP * (16 + e * 20)
		end
		cam.CFrame = CFrame.lookAt(eye, target)
		cam.FieldOfView = oldFov + e * 12
		if t >= dur then
			restore()
		end
	end)
	if shake then
		task.delay(dur * 0.55, function()
			shake(0.8)
		end)
	end
	task.delay(dur + 1, restore)
end

------------------------------------------------------------------------
-- 3.1판 윤회대: 거대한 윤회륜과 구름 소용돌이가 천천히 돈다 (환생 의식 동안은 빠르게)
------------------------------------------------------------------------
type Spinner = { center: CFrame, items: { { any } }, angle: number, speed: number, axis: string }
local spinners: { [string]: Spinner } = {}
local spinBoostUntil = 0
local function findSpinner(name: string, center: CFrame, axis: string, speed: number)
	if spinners[name] then
		return
	end
	local f = workspace:FindFirstChild(name, true)
	if not f then
		return
	end
	local items = {}
	for _, d in ipairs(f:GetDescendants()) do
		if d:IsA("BasePart") then
			table.insert(items, { d, center:ToObjectSpace(d.CFrame) })
		end
	end
	spinners[name] = { center = center, items = items, angle = 0, speed = speed, axis = axis }
end
local lastLook = 0
RunService.Heartbeat:Connect(function(dt: number)
	local cam = workspace.CurrentCamera
	local rd = Config.SKY_BY_ID and Config.SKY_BY_ID.rinnedae
	if not cam or not rd then
		return
	end
	if (cam.CFrame.Position - rd.at).Magnitude > 700 then
		return
	end
	if os.clock() - lastLook > 2 then
		lastLook = os.clock()
		local hub = workspace:FindFirstChild("RinneHub", true)
		if hub and hub:IsA("BasePart") then
			findSpinner("RinneWheel", CFrame.new(hub.Position), "x", 0.25)
		end
		findSpinner("RinneVortex", CFrame.new(rd.at), "y", 0.06)
	end
	local boost = os.clock() < spinBoostUntil and 14 or 1
	for _, sp in pairs(spinners) do
		sp.angle += dt * sp.speed * (sp.axis == "x" and boost or 1)
		local rot = sp.axis == "x" and CFrame.Angles(sp.angle, 0, 0) or CFrame.Angles(0, sp.angle, 0)
		local base = sp.center * rot
		for _, it in ipairs(sp.items) do
			local p = it[1] :: BasePart
			if p.Parent then
				p.CFrame = base * (it[2] :: CFrame)
			end
		end
	end
end)

-- 환생 의식: 하늘에서 빛기둥이 내려오고, 바퀴가 빠르게 돌고, 몸이 떠올라 빛으로 흩어졌다가 다시 태어난다
function Samsara.rite(d: any)
	local at: Vector3 = d.at
	local dur = d.dur or 3.4
	spinBoostUntil = os.clock() + dur
	if not near(at, 600) then
		return
	end
	local RB = Config.REBIRTH
	local col = (RB and RB.colors and RB.colors[d.n or 1]) or Color3.fromRGB(200, 180, 255)
	if opts.tint then
		opts.tint(Color3.fromRGB(220, 205, 255), 0.35, dur + 0.4)
	end
	-- 하늘에서 내려오는 빛기둥
	local top = at + Vector3.new(0, 400, 0)
	local beam = part(Vector3.new(1, 2, 2), WHITE, Enum.Material.Neon, 0.1, "cyl")
	local halo = part(Vector3.new(1, 6, 6), col, Enum.Material.Neon, 0.55, "cyl")
	anim(0.45, function(u)
		local h = 400 * u
		beam.Size = Vector3.new(h, 4, 4)
		beam.CFrame = CFrame.new(top - Vector3.new(0, h / 2, 0)) * CFrame.Angles(0, 0, math.rad(90))
		halo.Size = Vector3.new(h, 11, 11)
		halo.CFrame = beam.CFrame
	end)
	Fx.breakSound("boom", 0.8, 0.5, at)
	-- 떠오르는 동안 빛 고리가 기둥을 타고 오르고, 빛 가루가 몸으로 빨려 든다
	for k = 0, 7 do
		task.delay(0.3 + k * 0.17, function()
			Fx.ring(at - Vector3.new(0, 3, 0) + Vector3.new(0, k * 1.2, 0), k % 2 == 0 and col or WHITE, 4, 22, 0.5)
		end)
	end
	local m = d.m
	anim(1.6, function(u)
		if math.random() < 0.6 then
			local r = rootOf(m)
			local c = r and r.Position or at
			local a = math.random() * math.pi * 2
			local from = c + Vector3.new(math.cos(a) * 14, math.random() * 10 - 3, math.sin(a) * 14)
			local mote = part(Vector3.new(0.6, 0.6, 0.6), math.random() < 0.5 and col or WHITE, Enum.Material.Neon, 0.1, "ball")
			mote.Position = from
			tween(mote, 0.4, { Position = c, Size = Vector3.new(0.1, 0.1, 0.1) }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
			task.delay(0.42, function()
				mote:Destroy()
			end)
		end
		if u >= 1 then
			-- 몸이 빛으로 흩어진다
			local r = rootOf(m)
			local c = r and r.Position or at
			if m and m.Parent then
				Fx.afterimage(m, WHITE, 0.5)
			end
			for _ = 1, 28 do
				local mote = part(Vector3.new(0.5, 0.5, 0.5), math.random() < 0.5 and col or WHITE, Enum.Material.Neon, 0.05, "ball")
				mote.Position = c + Vector3.new(math.random() - 0.5, math.random() * 2 - 1, math.random() - 0.5) * 2
				fadeOut(mote, 0.8, { Position = mote.Position + Vector3.new(math.random() * 16 - 8, math.random() * 14, math.random() * 16 - 8) })
			end
			Fx.burst("glitter", c, col, 30, 2)
			Fx.flash(c, col, 40, 5, 0.5)
			Fx.sound("deflect", 0.8, 0.5, c)
			shakeNear(c, 0.6, 120)
		end
	end)
	-- 다시 태어난다: 빛이 모여 번쩍, 큰 고리
	task.delay(2.4, function()
		for _ = 1, 20 do
			local a = math.random() * math.pi * 2
			local from = at + Vector3.new(math.cos(a) * 12, math.random() * 12 - 2, math.sin(a) * 12)
			local mote = part(Vector3.new(0.6, 0.6, 0.6), col, Enum.Material.Neon, 0.05, "ball")
			mote.Position = from
			tween(mote, 0.22, { Position = at, Size = Vector3.new(0.1, 0.1, 0.1) }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
			task.delay(0.24, function()
				mote:Destroy()
			end)
		end
		task.delay(0.24, function()
			Fx.blast(at, col, WHITE, 2.4)
			Fx.ring(at - Vector3.new(0, 3, 0), col, 6, 90, 0.9)
			Fx.ring(at - Vector3.new(0, 2.5, 0), WHITE, 4, 60, 0.7)
			Fx.flash(at, WHITE, 90, 7, 0.9)
			Fx.breakSound("boom", 1, 0.45, at)
			shakeNear(at, 1.4, 200)
			fadeOut(beam, 0.6, { Size = Vector3.new(400, 0.3, 0.3) })
			fadeOut(halo, 0.6, { Size = Vector3.new(400, 30, 30) })
		end)
	end)
end

local PULSE: { [string]: string } = { echo = "echoPulse", karma = "karmaPulse", phantom = "phantomPulse", king = "kingPulse" }
function Samsara.handles(data: any): boolean
	if data.kind == "pulse" then
		return PULSE[data.fx or ""] ~= nil
	end
	return H[data.kind] ~= nil
end
function Samsara.run(data: any)
	local fn = data.kind == "pulse" and H[PULSE[data.fx or ""] or ""] or H[data.kind]
	if fn then
		fn(data)
	end
end

return Samsara
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="43">
          <Properties>
            <string name="Name">SkillFx</string>
            <string name="Source"><![CDATA[-- 권왕 1.8: 기술마다 다른 이펙트 (수치·연출은 그대로, 보이는 모양만)
-- 예전엔 모든 기술에 같은 틀 (발밑 진·고리·초승달) 이 붙어 다 비슷해 보였다. 그 틀을 없애고,
-- Fx.cast 에 따로 만든 이펙트가 없던 (속성·칸) 마다 서로 다른 모양을 하나씩 준다.
--   pillar  앞에서 솟는 기둥        wave   앞으로 밀려가는 휜 벽     spiral 몸을 감고 오르는 두 줄 나선
--   spikes  앞으로 한 줄로 솟는 가시  orbit  몸 둘레를 도는 구슬       beam   앞으로 꿰뚫는 빛줄기
--   nova    몸에서 부풀어 터지는 구   rain   앞쪽에 쏟아지는 빗줄기     vortex 앞의 한 점으로 말려드는 고리
--   cross   앞을 엇갈려 가르는 두 칼  fan    앞으로 펼쳐지는 부챗살     dome   몸을 덮는 반구
--   comet   날아가 터지는 불덩이      tunnel 앞으로 미끄러지는 세 겹 고리  crack  발밑에서 사방으로 갈라지는 땅
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local Config = require(ReplicatedStorage:WaitForChild("Config"))
local Fx = require(script.Parent:WaitForChild("Fx"))

local SkillFx = {}

local folder = Instance.new("Folder")
folder.Name = "KwonSkillFx"
folder.Parent = workspace

local WHITE = Color3.new(1, 1, 1)
local UPRIGHT = CFrame.Angles(0, 0, math.rad(90)) -- 원통을 세운다 (원통의 축은 X)

local function tween(inst: Instance, time: number, goal: { [string]: any }, style: Enum.EasingStyle?, dir: Enum.EasingDirection?)
	TweenService:Create(inst, TweenInfo.new(time, style or Enum.EasingStyle.Quad, dir or Enum.EasingDirection.Out), goal):Play()
end
local function bit(size: Vector3, color: Color3, mat: Enum.Material, alpha: number, life: number, shape: string?): BasePart
	local p: BasePart = shape == "wedge" and Instance.new("WedgePart") or Instance.new("Part")
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	p.Size = size
	p.Color = color
	p.Material = mat
	p.Transparency = alpha
	if shape == "ball" then
		local m = Instance.new("SpecialMesh")
		m.MeshType = Enum.MeshType.Sphere
		m.Parent = p
	elseif shape == "cyl" then
		(p :: Part).Shape = Enum.PartType.Cylinder
	end
	p.Parent = folder
	task.delay(life + 0.05, function()
		p:Destroy()
	end)
	return p
end
local function rootOf(m: Instance?): BasePart?
	local r = m and m:FindFirstChild("HumanoidRootPart")
	return (r and r:IsA("BasePart")) and r or nil
end
local function near(pos: Vector3, d: number): boolean
	local cam = workspace.CurrentCamera
	return cam ~= nil and (cam.CFrame.Position - pos).Magnitude < d
end

type Look = { c: Color3, c2: Color3, mat: Enum.Material, s: number }

------------------------------------------------------------------------
-- 모양들 (cf = 몸 가운데, 앞이 -Z)
------------------------------------------------------------------------
local P: { [string]: (CFrame, Look, Model, number) -> () } = {}

------------------------------------------------------------------------
-- 2.8판: 모양들을 다시 그렸다. 예전엔 막대·네모·공을 그냥 늘였다 줄여 다 비슷하고 투박해 보였다.
-- 이제 세모 날 (쐐기 둘), 초승달 (휜 조각들), 갈라지는 금, 나선 띠로 모양을 또렷하게 짓는다
------------------------------------------------------------------------
-- 프레임마다 u (0 → 1) 로 부른다
local function anim(life: number, fn: (number) -> ())
	local t0 = os.clock()
	local conn: RBXScriptConnection
	conn = RunService.Heartbeat:Connect(function()
		local u = math.clamp((os.clock() - t0) / life, 0, 1)
		fn(u)
		if u >= 1 then
			conn:Disconnect()
		end
	end)
end
-- 세모 날: cf의 XY 평면에 밑변 (가운데가 cf, 너비 w) 과 꼭짓점 (위로 h). 두께는 Z
type Blade = { a: BasePart, b: BasePart }
local function blade(color: Color3, mat: Enum.Material, alpha: number, life: number): Blade
	return { a = bit(Vector3.one * 0.1, color, mat, alpha, life, "wedge"), b = bit(Vector3.one * 0.1, color, mat, alpha, life, "wedge") }
end
local function placeBlade(bl: Blade, cf: CFrame, w: number, h: number, thick: number?)
	local t = thick or 0.15
	local hw = math.max(0.05, w / 2)
	local hh = math.max(0.05, h)
	bl.a.Size = Vector3.new(t, hh, hw)
	bl.b.Size = Vector3.new(t, hh, hw)
	bl.a.CFrame = cf * CFrame.new(hw / 2, hh / 2, 0) * CFrame.Angles(0, -math.pi / 2, 0)
	bl.b.CFrame = cf * CFrame.new(-hw / 2, hh / 2, 0) * CFrame.Angles(0, math.pi / 2, 0)
end
local function fadeBlade(bl: Blade, alpha: number)
	bl.a.Transparency = alpha
	bl.b.Transparency = alpha
end
-- 초승달: cf의 XY 평면에서 반지름 R, 각 a0 → a1 (가운데가 가장 두껍다)
local function placeArc(list: { BasePart }, cf: CFrame, R: number, a0: number, a1: number, wmax: number, reveal: number?)
	local n = #list
	local show = reveal or 1
	for i, p in ipairs(list) do
		local u = (i - 0.5) / n
		local a = a0 + (a1 - a0) * u
		local w = wmax * (0.15 + 0.85 * math.sin(u * math.pi))
		local pos = Vector3.new(math.cos(a) * R, math.sin(a) * R, 0)
		local tangent = Vector3.new(-math.sin(a), math.cos(a), 0)
		p.Size = Vector3.new(w, 0.12, (a1 - a0) * R / n * 2.2)
		local nrm = Vector3.new(0, 0, 1)
		p.CFrame = cf * CFrame.fromMatrix(pos, nrm:Cross(tangent), nrm, tangent)
		p.Transparency = u <= show and p.Transparency or 1
	end
end
-- 갈라지는 금 (꺾이며 가늘어지는 세 마디). 땅 위 at 에서 방향 a 로
local function crackLine(at: Vector3, a: number, len: number, color: Color3, life: number)
	local pos = at
	local dir = a
	for k = 1, 3 do
		local l = len / 3 * (1.1 - k * 0.12)
		dir += (math.random() - 0.5) * 0.9
		local d = Vector3.new(math.sin(dir), 0, math.cos(dir))
		local seg = bit(Vector3.new((0.55 - k * 0.13), 0.12, 0.2), color, Enum.Material.Neon, 0, life)
		local mid = pos + d * l / 2
		seg.CFrame = CFrame.lookAt(mid, mid + d)
		tween(seg, 0.1 + k * 0.04, { Size = Vector3.new(0.55 - k * 0.13, 0.12, l) })
		task.delay(life * 0.55, function()
			tween(seg, life * 0.4, { Transparency = 1 })
		end)
		pos += d * l
	end
end

P.pillar = function(cf, L, _m, _dur)
	-- 앞의 땅에서 빛기둥이 솟고, 기둥을 감고 오르는 두 줄 띠, 꼭대기에서 사방으로 튀는 날 조각
	local at = (cf * CFrame.new(0, -2.5, -5 * L.s)).Position
	local H = 24 * L.s
	local outer = bit(Vector3.new(1, 4.2 * L.s, 4.2 * L.s), L.c, L.mat, 0.35, 0.55, "cyl")
	local core = bit(Vector3.new(1, 1.4 * L.s, 1.4 * L.s), WHITE, Enum.Material.Neon, 0, 0.5, "cyl")
	local ribbon: { BasePart } = {}
	for i = 1, 16 do
		ribbon[i] = bit(Vector3.new(0.35, 0.35, 1.6) * L.s, i % 2 == 0 and L.c2 or L.c, Enum.Material.Neon, 0.05, 0.6)
	end
	anim(0.5, function(u)
		local grow = math.min(1, u / 0.35)
		local h = math.max(1, H * grow)
		local thin = u < 0.6 and 1 or 1 - (u - 0.6) / 0.4
		outer.Size = Vector3.new(h, 4.2 * L.s * (0.5 + 0.5 * thin), 4.2 * L.s * (0.5 + 0.5 * thin))
		outer.CFrame = CFrame.new(at + Vector3.new(0, h / 2, 0)) * UPRIGHT
		outer.Transparency = 0.35 + 0.65 * (1 - thin)
		core.Size = Vector3.new(h, 1.4 * L.s * thin + 0.05, 1.4 * L.s * thin + 0.05)
		core.CFrame = outer.CFrame
		core.Transparency = 1 - thin
		for i, r in ipairs(ribbon) do
			local strand = i % 2 == 0 and math.pi or 0
			local k = (i - 1) // 2
			local y = (k / 8) * h
			local a = strand + k * 0.85 + u * 10
			local p = at + Vector3.new(math.cos(a) * 2.6 * L.s, y, math.sin(a) * 2.6 * L.s)
			local tan = Vector3.new(-math.sin(a), 0.35, math.cos(a))
			r.CFrame = CFrame.lookAt(p, p + tan)
			r.Transparency = 0.05 + 0.95 * (1 - thin)
		end
	end)
	task.delay(0.16, function()
		local top = at + Vector3.new(0, H, 0)
		for k = 0, 7 do
			local a = k / 8 * math.pi * 2
			local bl = blade(k % 2 == 0 and L.c or L.c2, Enum.Material.Neon, 0, 0.45)
			local d = Vector3.new(math.cos(a), 0.35, math.sin(a)).Unit
			anim(0.4, function(u)
				local p = top + d * (2 + u * 8) * L.s
				placeBlade(bl, CFrame.lookAt(p, p + d) * CFrame.Angles(math.rad(-90), 0, 0), 1.0 * L.s, (2.4 - u * 1.6) * L.s)
				fadeBlade(bl, u)
			end)
		end
		Fx.ring(top, L.c2, 2, 10 * L.s, 0.35)
	end)
	for k = 0, 5 do
		crackLine(at + Vector3.new(0, 0.1, 0), k / 6 * math.pi * 2, (5 + math.random() * 3) * L.s, L.c, 0.7)
	end
	Fx.ring(at + Vector3.new(0, 0.3, 0), L.c, 2, 13 * L.s, 0.4)
	Fx.dust(at, 2 * L.s)
end
P.wave = function(cf, L, _m, _dur)
	-- 앞으로 밀려가며 앞으로 기우는 초승달 꼴의 물마루 (세모 날 아홉, 가운데가 가장 높다), 마루 끝의 물보라
	for k = -6, 6 do
		local a = k / 6 * 0.8
		local hgt = (5.5 - math.abs(k) * 0.55) * L.s
		-- 물의 몸 (아래의 넓은 벽)과 마루 (겹친 세모 날), 마루 끝의 물보라
		local body = bit(Vector3.one, L.c, L.mat, 0.25, 0.55)
		local bl = blade(k % 2 == 0 and L.c2 or L.c, L.mat, 0.1, 0.55)
		local foam = bit(Vector3.one * 0.9 * L.s, WHITE, Enum.Material.Neon, 0.2, 0.55, "ball")
		anim(0.5, function(u)
			local rise = 0.4 + 0.6 * math.min(1, u * 3)
			local base = cf * CFrame.Angles(0, a, 0) * CFrame.new(0, -2.4, -(3 + u * 14) * L.s) * CFrame.Angles(math.rad(-u * 40), 0, 0)
			body.Size = Vector3.new(2.6 * L.s, hgt * 0.55 * rise, 0.5 * L.s)
			body.CFrame = base * CFrame.new(0, hgt * 0.275 * rise, 0)
			body.Transparency = 0.25 + 0.75 * u ^ 2
			placeBlade(bl, base * CFrame.new(0, hgt * 0.4 * rise, 0), 3.4 * L.s, hgt * 0.6 * rise, 0.3)
			fadeBlade(bl, 0.1 + 0.9 * u ^ 2)
			foam.CFrame = base * CFrame.new(0, hgt * rise, -0.3 * L.s)
			foam.Transparency = 0.2 + 0.8 * u
		end)
	end
	Fx.ring((cf * CFrame.new(0, -2.3, -3)).Position, L.c2, 2, 10 * L.s, 0.4)
end
P.spiral = function(cf, L, m, dur)
	-- 몸을 감고 오르는 두 줄 나선 띠 (구슬 대신 이어진 띠)
	local life = math.min(1.3, dur + 0.2)
	local strands: { { BasePart } } = { {}, {} }
	for s = 1, 2 do
		for i = 1, 24 do
			strands[s][i] = bit(Vector3.new(0.3, 0.3, 1.5) * L.s, s == 1 and L.c or L.c2, Enum.Material.Neon, 0.05, life + 0.1)
		end
	end
	anim(life, function(u)
		local r = rootOf(m)
		if not r then
			return
		end
		for s, list in ipairs(strands) do
			for i, b in ipairs(list) do
				local k = i / #list
				local a = (s == 2 and math.pi or 0) + k * math.pi * 3 + u * 12
				local rad = (2.2 + k * 0.8) * L.s
				local y = -2.4 + math.min(1, k * (0.4 + u * 1.2)) * 6.5 * L.s
				local p = r.Position + Vector3.new(math.cos(a) * rad, y, math.sin(a) * rad)
				local tan = Vector3.new(-math.sin(a), 0.4, math.cos(a))
				b.CFrame = CFrame.lookAt(p, p + tan)
				b.Transparency = math.clamp(u ^ 2 + (1 - k) * 0.3, 0.05, 1)
			end
		end
	end)
end
P.spikes = function(cf, L, _m, _dur)
	-- 앞으로 한 줄로 땅을 뚫고 솟는 가시 여섯 (엇갈린 세모 날 둘이라 어디서 봐도 가시), 발밑마다 금
	for k = 1, 6 do
		task.delay(k * 0.05, function()
			local at = (cf * CFrame.new((k % 2 == 0 and 1 or -1) * 0.9, -2.5, -2.5 - k * 2.6 * L.s)).Position
			local h = (3.5 + k * 0.5) * L.s
			local tilt = CFrame.Angles(math.rad(-12 + math.random() * 8), math.random() * math.pi, math.rad((k % 2 == 0 and 1 or -1) * 10))
			local b1 = blade(k % 2 == 0 and L.c or L.c2, L.mat, 0.05, 0.7)
			local b2 = blade(k % 2 == 0 and L.c or L.c2, L.mat, 0.05, 0.7)
			anim(0.6, function(u)
				local g = u < 0.2 and u / 0.2 or (u < 0.65 and 1 or 1 - (u - 0.65) / 0.35)
				local base = CFrame.new(at) * tilt
				placeBlade(b1, base, 1.5 * L.s, h * g, 0.2)
				placeBlade(b2, base * CFrame.Angles(0, math.pi / 2, 0), 1.5 * L.s, h * g, 0.2)
				local a = u < 0.65 and 0.05 or 0.05 + (u - 0.65) / 0.35
				fadeBlade(b1, a)
				fadeBlade(b2, a)
			end)
			for j = 0, 2 do
				crackLine(at + Vector3.new(0, 0.05, 0), j / 3 * math.pi * 2 + k, 2.5 * L.s, L.c, 0.5)
			end
		end)
	end
end
P.orbit = function(cf, L, m, dur)
	-- 몸 둘레를 도는 구슬 다섯, 구슬마다 꼬리 (지나간 자리에 옅어지는 작은 구슬), 허리의 옅은 고리
	local n = 5
	local life = math.min(1.6, dur + 0.3)
	local orbs: { { BasePart } } = {}
	for i = 1, n do
		local tail = {}
		for j = 0, 4 do
			tail[j + 1] = bit(Vector3.one * (1.3 - j * 0.2) * L.s, j == 0 and (i % 2 == 0 and L.c or L.c2) or L.c, Enum.Material.Neon, 0.05 + j * 0.18, life + 0.1, "ball")
		end
		orbs[i] = tail
	end
	local band = bit(Vector3.new(0.1, 7 * L.s, 7 * L.s), L.c, Enum.Material.Neon, 0.75, life + 0.1, "cyl")
	anim(life, function(u)
		local r = rootOf(m)
		if not r then
			return
		end
		local t = u * life
		local rad = (3 + t * 2) * L.s
		for i, tail in ipairs(orbs) do
			for j, b in ipairs(tail) do
				local a = (t - (j - 1) * 0.035) * 6 + i / n * math.pi * 2
				b.Position = r.Position + Vector3.new(math.cos(a) * rad, math.sin(a * 2) * 0.6, math.sin(a) * rad)
				b.Transparency = math.clamp(u ^ 2 + (j - 1) * 0.18, 0.05, 1)
			end
		end
		band.Size = Vector3.new(0.1, rad * 2, rad * 2)
		band.CFrame = CFrame.new(r.Position) * UPRIGHT
		band.Transparency = 0.75 + 0.25 * u
	end)
end
P.beam = function(cf, L, _m, _dur)
	-- 앞으로 꿰뚫는 빛줄기: 흰 심, 빛깔의 겉, 겉을 감는 두 줄 나선, 끝에서 터지는 빛
	local len = 30 * L.s
	local mid = cf * CFrame.new(0, 0.3, -len / 2 - 1)
	local b = bit(Vector3.new(len, 0.5, 0.5), WHITE, Enum.Material.Neon, 0, 0.45, "cyl")
	b.CFrame = mid * CFrame.Angles(0, math.rad(90), 0)
	local glow = bit(Vector3.new(len, 1.8 * L.s, 1.8 * L.s), L.c, L.mat, 0.35, 0.45, "cyl")
	glow.CFrame = b.CFrame
	tween(b, 0.4, { Size = Vector3.new(len, 0.05, 0.05), Transparency = 1 })
	tween(glow, 0.4, { Size = Vector3.new(len, 3.4 * L.s, 3.4 * L.s), Transparency = 1 })
	local helix: { BasePart } = {}
	for i = 1, 24 do
		helix[i] = bit(Vector3.new(0.22, 0.22, 1.5) * L.s, i % 2 == 0 and L.c2 or L.c, Enum.Material.Neon, 0.1, 0.45)
	end
	anim(0.4, function(u)
		for i, h in ipairs(helix) do
			local strand = i % 2 == 0 and math.pi or 0
			local k = (i - 1) // 2
			local z = -1 - k / 12 * len
			local a = strand + k * 0.9 + u * 8
			local rr = (1.3 + u * 0.8) * L.s
			local hc = cf * CFrame.new(math.cos(a) * rr, 0.3 + math.sin(a) * rr, z)
			h.CFrame = CFrame.lookAt(hc.Position, (hc * CFrame.new(-math.sin(a), math.cos(a), -0.6)).Position)
			h.Transparency = 0.1 + 0.9 * u
		end
	end)
	Fx.ring((cf * CFrame.new(0, 0.3, -2)).Position, L.c, 1, 7 * L.s, 0.3, cf.LookVector)
	local tip = (cf * CFrame.new(0, 0.3, -len - 1)).Position
	Fx.ring(tip, L.c2, 1, 9 * L.s, 0.35, cf.LookVector)
	Fx.spark(tip, L.c, 1.4 * L.s, 12)
end
P.nova = function(cf, L, _m, _dur)
	-- 몸에서 부풀어 터지는 구: 겉껍질, 흰 심, 허리를 두르는 고리, 사방으로 뻗는 빛살 열둘
	local shell = bit(Vector3.one * 2, L.c, L.mat, 0.35, 0.45, "ball")
	shell.Position = cf.Position
	tween(shell, 0.4, { Size = Vector3.one * 18 * L.s, Transparency = 1 })
	local core = bit(Vector3.one * 1, WHITE, Enum.Material.Neon, 0, 0.25, "ball")
	core.Position = cf.Position
	tween(core, 0.2, { Size = Vector3.one * 7 * L.s, Transparency = 1 })
	Fx.ring(cf.Position, L.c2, 2, 20 * L.s, 0.4)
	for k = 0, 11 do
		local a = k / 12 * math.pi * 2
		local d = Vector3.new(math.cos(a), (k % 3 - 1) * 0.35, math.sin(a)).Unit
		local ray = bit(Vector3.new(0.3, 0.3, 1) * L.s, k % 2 == 0 and L.c or L.c2, Enum.Material.Neon, 0, 0.35)
		anim(0.32, function(u)
			local len = (2 + u * 8) * L.s
			local p = cf.Position + d * (1.5 * L.s + len / 2 + u * 3 * L.s)
			ray.Size = Vector3.new(0.3 * (1 - u) + 0.05, 0.3 * (1 - u) + 0.05, len)
			ray.CFrame = CFrame.lookAt(p, p + d)
			ray.Transparency = u
		end)
	end
end
P.rain = function(cf, L, _m, _dur)
	-- 앞쪽에 쏟아지는 빛줄기 (밝은 머리와 꼬리), 닿는 자리마다 고리와 튀어 오르는 방울
	local center = (cf * CFrame.new(0, -2.5, -9 * L.s)).Position
	for k = 0, 11 do
		task.delay(k * 0.04, function()
			local at = center + Vector3.new(math.random(-6, 6) * L.s, 0, math.random(-6, 6) * L.s)
			local head = bit(Vector3.one * 0.7, WHITE, Enum.Material.Neon, 0, 0.3, "ball")
			local tail = bit(Vector3.new(0.3, 7, 0.3), k % 2 == 0 and L.c or L.c2, Enum.Material.Neon, 0.15, 0.3)
			anim(0.18, function(u)
				local y = 26 * (1 - u * u) + 2
				head.Position = at + Vector3.new(0, y, 0)
				tail.CFrame = CFrame.new(at + Vector3.new(0, y + 3.6, 0))
			end)
			task.delay(0.18, function()
				head.Transparency = 1
				tail.Transparency = 1
				Fx.ring(at + Vector3.new(0, 0.3, 0), L.c, 0.5, 4.5 * L.s, 0.3)
				for j = 0, 2 do
					local d = bit(Vector3.one * 0.35, L.c2, Enum.Material.Neon, 0, 0.35, "ball")
					local dir = Vector3.new(math.cos(j * 2.1 + k), 0, math.sin(j * 2.1 + k))
					anim(0.3, function(u)
						d.Position = at + dir * u * 2.2 * L.s + Vector3.new(0, 0.3 + math.sin(u * math.pi) * 1.6 * L.s, 0)
						d.Transparency = u
					end)
				end
			end)
		end)
	end
end
P.vortex = function(cf, L, _m, _dur)
	local at = (cf * CFrame.new(0, 0, -6 * L.s)).Position
	for k = 0, 13 do
		local a0 = k / 14 * math.pi * 2
		local seg = bit(Vector3.new(0.3, 0.3, 2.4 * L.s), k % 2 == 0 and L.c or L.c2, L.mat, 0.1, 0.5)
		anim(0.45, function(u)
			local a = a0 + u * 5
			local r = (9 - 8.5 * u) * L.s
			local p = at + Vector3.new(math.cos(a) * r, math.sin(a * 3) * 0.6, math.sin(a) * r)
			seg.CFrame = CFrame.lookAt(p, p + Vector3.new(-math.sin(a), 0, math.cos(a)))
			seg.Size = Vector3.new(0.3, 0.3, (2.4 - u * 1.4) * L.s)
			seg.Transparency = u
		end)
	end
	task.delay(0.45, function()
		local pop = bit(Vector3.one, WHITE, Enum.Material.Neon, 0, 0.25, "ball")
		pop.Position = at
		tween(pop, 0.22, { Size = Vector3.one * 6 * L.s, Transparency = 1 })
		Fx.ring(at, L.c, 1, 10 * L.s, 0.3)
	end)
end
P.cross = function(cf, L, _m, _dur)
	-- 앞을 엇갈려 가르는 두 초승달 (휘두르는 방향으로 차례로 그려진다), 엇갈린 자리의 불티
	local at = cf * CFrame.new(0, 0.5, -5 * L.s)
	for i, rot in ipairs({ math.rad(45), math.rad(-45) }) do
		task.delay((i - 1) * 0.09, function()
			local list: { BasePart } = {}
			for k = 1, 22 do
				list[k] = bit(Vector3.one * 0.1, i == 1 and L.c2 or L.c, Enum.Material.Neon, 0, 0.4)
			end
			local plane = at * CFrame.Angles(0, 0, rot) * CFrame.new(0, -5 * L.s, 0)
			anim(0.36, function(u)
				local reveal = math.min(1, u / 0.35)
				for _, p in ipairs(list) do
					p.Transparency = u < 0.45 and 0 or (u - 0.45) / 0.55
				end
				placeArc(list, plane, 6.5 * L.s, math.rad(55), math.rad(125), 0.45 * L.s * (1 - u * 0.5), reveal)
			end)
		end)
	end
	Fx.spark(at.Position, L.c, 1.3 * L.s, 12)
end
P.fan = function(cf, L, _m, _dur)
	-- 앞으로 펼쳐지는 부챗살: 누운 세모 날 아홉이 부채처럼 퍼지며 밀려간다
	for k = -4, 4 do
		local a = k / 4 * 1.0
		local bl = blade(k % 2 == 0 and L.c or L.c2, Enum.Material.Neon, 0, 0.4)
		anim(0.35, function(u)
			local base = cf * CFrame.Angles(0, a, 0) * CFrame.new(0, 0.4, -(1.5 + u * 5) * L.s) * CFrame.Angles(math.rad(-90), 0, 0)
			placeBlade(bl, base, (0.9 - u * 0.4) * L.s, (2 + u * 6) * L.s, 0.12)
			fadeBlade(bl, u ^ 1.5)
		end)
	end
	Fx.ring((cf * CFrame.new(0, 0.4, -1.5)).Position, L.c2, 1, 6 * L.s, 0.3, cf.LookVector)
end
P.dome = function(cf, L, _m, dur)
	-- 몸을 덮는 반구: 옅은 껍질, 위도선 셋 (천천히 돈다), 밑둘레의 밝은 고리
	local life = math.clamp(dur, 0.5, 1.2)
	local base = cf.Position - Vector3.new(0, 2, 0)
	local d = bit(Vector3.one * 2, L.c, L.mat, 0.55, life + 0.1, "ball")
	d.Position = base
	tween(d, 0.2, { Size = Vector3.new(12, 9, 12) * L.s })
	local rings: { BasePart } = {}
	for k = 1, 3 do
		rings[k] = bit(Vector3.new(0.12, 1, 1), k == 2 and L.c2 or L.c, Enum.Material.Neon, 0.2, life + 0.1, "cyl")
	end
	anim(life, function(u)
		local g = math.min(1, u / 0.2)
		for k, r in ipairs(rings) do
			local lat = k / 4
			local y = lat * 4.5 * L.s * g
			local rad = 6 * L.s * g * math.sqrt(1 - lat * lat)
			r.Size = Vector3.new(0.12, rad * 2, rad * 2)
			r.CFrame = CFrame.new(base + Vector3.new(0, y, 0)) * CFrame.Angles(0, u * 3 * (k % 2 == 0 and -1 or 1), 0) * UPRIGHT
			r.Transparency = u < 0.75 and 0.2 or 0.2 + (u - 0.75) / 0.25 * 0.8
		end
	end)
	task.delay(life - 0.25, function()
		tween(d, 0.25, { Size = Vector3.new(15, 11, 15) * L.s, Transparency = 1 })
	end)
	Fx.ring(cf.Position - Vector3.new(0, 2.4, 0), L.c2, 6 * L.s, 13 * L.s, life)
end
P.comet = function(cf, L, _m, _dur)
	-- 날아가 터지는 불덩이: 흰 심과 빛깔의 겉, 뒤로 끌리는 가늘어지는 불꼬리 일곱 마디
	local from = (cf * CFrame.new(0.8, 0.5, -1.5)).Position
	local to = (cf * CFrame.new(0, -1.5, -18 * L.s)).Position
	local ball = bit(Vector3.one * 2.4 * L.s, L.c, Enum.Material.Neon, 0, 0.4, "ball")
	local heart = bit(Vector3.one * 1.3 * L.s, WHITE, Enum.Material.Neon, 0, 0.4, "ball")
	local tail: { BasePart } = {}
	for j = 1, 7 do
		tail[j] = bit(Vector3.one * (2.2 - j * 0.26) * L.s, j % 2 == 0 and L.c2 or L.c, Enum.Material.Neon, 0.1 + j * 0.1, 0.4, "ball")
	end
	local dir = (to - from).Unit
	anim(0.25, function(u)
		local e = u * u
		local p = from:Lerp(to, e)
		ball.Position = p
		heart.Position = p
		for j, t in ipairs(tail) do
			t.Position = p - dir * j * 0.9 * L.s
		end
	end)
	task.delay(0.25, function()
		ball.Transparency = 1
		heart.Transparency = 1
		for _, t in ipairs(tail) do
			t.Transparency = 1
		end
		Fx.blast(to, L.c, L.c2, 1.3 * L.s)
		Fx.ring(to - Vector3.new(0, 0.8, 0), L.c2, 1, 12 * L.s, 0.35)
		for k = 0, 5 do
			crackLine(to - Vector3.new(0, 0.9, 0), k / 6 * math.pi * 2, 4 * L.s, L.c, 0.6)
		end
	end)
end
P.tunnel = function(cf, L, _m, _dur)
	for k = 0, 2 do
		task.delay(k * 0.07, function()
			local ring = bit(Vector3.new(0.3, 4 * L.s, 4 * L.s), k == 1 and L.c2 or L.c, L.mat, 0.2, 0.45, "cyl")
			ring.CFrame = cf * CFrame.new(0, 0.3, -2) * CFrame.Angles(0, math.rad(90), 0)
			tween(ring, 0.4, { CFrame = cf * CFrame.new(0, 0.3, -14 * L.s) * CFrame.Angles(0, math.rad(90), 0), Size = Vector3.new(0.1, 8 * L.s, 8 * L.s), Transparency = 1 })
		end)
	end
	-- 고리 사이를 미끄러지는 빛살 넷
	for k = 0, 3 do
		local a = k / 4 * math.pi * 2
		local s = bit(Vector3.new(0.2, 0.2, 3) * L.s, L.c2, Enum.Material.Neon, 0, 0.45)
		anim(0.4, function(u)
			local sc = cf * CFrame.new(math.cos(a + u * 3) * 2.2 * L.s, 0.3 + math.sin(a + u * 3) * 2.2 * L.s, -(2 + u * 12) * L.s)
			s.CFrame = CFrame.lookAt(sc.Position, sc.Position + cf.LookVector)
			s.Transparency = u
		end)
	end
end
P.crack = function(cf, L, _m, _dur)
	-- 발밑에서 사방으로 꺾이며 갈라지는 금, 튀어 오르는 돌 조각
	local at = cf.Position - Vector3.new(0, 2.5, 0)
	for k = 0, 9 do
		crackLine(at, k / 10 * math.pi * 2 + math.random() * 0.3, (6 + math.random() * 5) * L.s, k % 2 == 0 and L.c or L.c2, 0.75)
	end
	for k = 0, 5 do
		local rock = bit(Vector3.new(0.9, 0.7, 0.8) * L.s * (0.7 + math.random() * 0.6), Color3.fromRGB(120, 108, 96), Enum.Material.Slate, 0, 0.6)
		local d = Vector3.new(math.cos(k * 1.1), 0, math.sin(k * 1.1))
		local spin = CFrame.Angles(math.random() * 6, math.random() * 6, 0)
		anim(0.55, function(u)
			rock.CFrame = CFrame.new(at + d * (1 + u * 4) * L.s + Vector3.new(0, math.sin(u * math.pi) * 3 * L.s, 0)) * spin * CFrame.Angles(u * 4, u * 3, 0)
			rock.Transparency = u > 0.7 and (u - 0.7) / 0.3 or 0
		end)
	end
	Fx.ring(at + Vector3.new(0, 0.2, 0), L.c, 2, 14 * L.s, 0.4)
	Fx.dust(at, 2.5 * L.s)
end

------------------------------------------------------------------------
-- 속성마다 강타 (H) · E · R 의 모양과 재질 (한 권법 안에서 셋이 서로 다르다)
------------------------------------------------------------------------
local PLAN: { [string]: { [string]: string } } = {
	celestial = { E = "fan", R = "comet" },
	cloud = { H = "nova", E = "orbit", R = "wave" },
	duel = { H = "cross", E = "spikes", R = "tunnel" },
	eclipse = { H = "dome", E = "orbit", R = "beam" },
	fire = { H = "pillar", E = "wave", R = "comet" },
	galaxy = { H = "vortex", E = "spiral", R = "rain" },
	gravity = { H = "crack", E = "vortex", R = "dome" },
	ocean = { H = "wave", E = "spiral", R = "tunnel" },
	origin = { H = "beam", E = "fan", R = "pillar" },
	subspace = { H = "cross", E = "nova", R = "tunnel" },
	time = { H = "crack", E = "orbit", R = "rain" },
	wind = { R = "spiral" },
}
-- 1.9판: 권법마다 따로 (같은 속성이라도 각성 권법은 모양이 다르다)
local PLAN_STYLE: { [string]: { [string]: string } } = {
	geumgang2 = { H = "crack", E = "dome", R = "spikes" },
	muyeong2 = { H = "fan", E = "cross", R = "vortex" },
	taeheo2 = { H = "nova", E = "wave", R = "spiral" },
	yeolhwa2 = { H = "comet", E = "spikes", R = "pillar" },
	changhae2 = { H = "tunnel", E = "wave", R = "spiral" },
	pungsin2 = { H = "fan", E = "cross", R = "spiral" },
	chobyeok = { H = "cross", E = "beam", R = "rain" },
	chochanghae = { H = "wave" },
	chosengha = { H = "nova" },
	hojeop = {},
	gongbaek = {},
	manmok = { H = "crack" },
}
local MAT: { [string]: Enum.Material } = {
	nature = Enum.Material.Grass,
	cloud = Enum.Material.SmoothPlastic,
	ocean = Enum.Material.Glass,
	subspace = Enum.Material.Glass,
	duel = Enum.Material.Metal,
	gravity = Enum.Material.Neon,
	geumgang2 = Enum.Material.Foil,
	taeheo2 = Enum.Material.Glass,
}

function SkillFx.cast(styleId: any, slot: any, model: Model, dur: number)
	local style = type(styleId) == "string" and Config.STYLE_BY_ID[styleId] or nil
	if not style or (slot ~= "H" and slot ~= "E" and slot ~= "R") then
		return
	end
	local plan = PLAN_STYLE[style.id] or PLAN[style.fx]
	local shape = plan and plan[slot]
	local fn = shape and P[shape]
	local r = rootOf(model)
	if not fn or not r or not near(r.Position, 180) then
		return
	end
	local L: Look = { c = style.color, c2 = style.color2, mat = MAT[style.id] or MAT[style.fx] or Enum.Material.Neon, s = slot == "H" and 0.9 or 1.15 }
	task.delay(math.min(0.15, dur * 0.3), function()
		local rr = rootOf(model)
		if not rr then
			return
		end
		local look = Vector3.new(rr.CFrame.LookVector.X, 0, rr.CFrame.LookVector.Z)
		look = look.Magnitude > 0.01 and look.Unit or Vector3.new(0, 0, -1)
		fn(CFrame.lookAt(rr.Position, rr.Position + look), L, model, dur)
	end)
end

-- 모양 목록 (시험 화면이 하나씩 그려 보는 데 쓴다)
SkillFx.shapes = P

return SkillFx
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="44">
          <Properties>
            <string name="Name">Star</string>
            <string name="Source"><![CDATA[-- 권왕 3.4판: 초·성하신권 (화면). 오른손의 별 지팡이, 마법진, 별, 은하수, 성천궁 (남색 돔과 별자리)
-- 별은 다섯 갈래의 빛 조각 (가운데 구슬 + 뾰족한 다섯 날), 마법진은 두 겹 고리와 육망성, 둘레를 도는 글자 조각
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local Config = require(ReplicatedStorage:WaitForChild("Config"))
local Fx = require(script.Parent:WaitForChild("Fx"))

local Star = {}
local player = Players.LocalPlayer

local INDIGO = Color3.fromRGB(60, 50, 170)
local NAVY = Color3.fromRGB(22, 24, 84)
local VIOLET = Color3.fromRGB(150, 90, 230)
local GOLD = Color3.fromRGB(255, 226, 120)
local PALE = Color3.fromRGB(255, 248, 220)
local WHITE = Color3.new(1, 1, 1)
local WOOD = Color3.fromRGB(46, 36, 70)
local BRASS = Color3.fromRGB(214, 176, 92)
local TEX_SPARK = "rbxasset://textures/particles/sparkles_main.dds"
local TEX_SMOKE = "rbxasset://textures/particles/smoke_main.dds"
local UP = CFrame.Angles(0, 0, math.rad(90))
local AXIS_Z = CFrame.Angles(0, math.rad(90), 0) -- 원기둥의 축(X)을 Z로

local folder = Instance.new("Folder")
folder.Name = "KwonStar"
folder.Parent = workspace

local opts: any = {}
function Star.init(o: any)
	opts = o or {}
end

local function newPart(size: Vector3, color: Color3, material: Enum.Material?, alpha: number?, shape: string?): BasePart
	local p: BasePart
	if shape == "wedge" then
		p = Instance.new("WedgePart")
	else
		local q = Instance.new("Part")
		if shape == "ball" then
			q.Shape = Enum.PartType.Ball
		elseif shape == "cyl" then
			q.Shape = Enum.PartType.Cylinder
		end
		p = q
	end
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	p.Size = size
	p.Color = color
	p.Material = material or Enum.Material.Neon
	p.Transparency = alpha or 0
	p.Parent = folder
	return p
end
local function tween(inst: Instance, time: number, goal: { [string]: any }, style: Enum.EasingStyle?, dir: Enum.EasingDirection?)
	local tw = TweenService:Create(inst, TweenInfo.new(math.max(0.01, time), style or Enum.EasingStyle.Quad, dir or Enum.EasingDirection.Out), goal)
	tw:Play()
	return tw
end
local function fadeOut(p: BasePart, time: number, goal: { [string]: any }?)
	local g = goal or {}
	g.Transparency = 1
	tween(p, time, g)
	task.delay(time + 0.05, function()
		p:Destroy()
	end)
end
local function near(pos: Vector3, d: number): boolean
	local cam = workspace.CurrentCamera
	return cam ~= nil and (cam.CFrame.Position - pos).Magnitude < d
end
local function rootOf(m: Instance?): BasePart?
	local r = m and m:FindFirstChild("HumanoidRootPart")
	return (r and r:IsA("BasePart")) and r or nil
end
local function flat(v: Vector3): Vector3
	local f = Vector3.new(v.X, 0, v.Z)
	return f.Magnitude > 1e-3 and f.Unit or Vector3.new(0, 0, -1)
end
local function ground(at: Vector3): Vector3
	return Vector3.new(at.X, at.Y - 2.7, at.Z)
end
local function colors(id: any): (Color3, Color3)
	local st = type(id) == "string" and Config.STYLE_BY_ID[id] or nil
	if st then
		return st.color, st.color2
	end
	return INDIGO, GOLD
end
local function shakeNear(pos: Vector3, amount: number, range: number)
	if opts.shake and near(pos, range) then
		opts.shake(amount)
	end
end
-- 두 점을 잇는 빛줄기
local function beam(a: Vector3, b: Vector3, w: number, color: Color3, alpha: number?): BasePart
	local p = newPart(Vector3.new(w, w, math.max(0.05, (b - a).Magnitude)), color, Enum.Material.Neon, alpha or 0)
	p.CFrame = (b - a).Magnitude > 1e-3 and CFrame.lookAt((a + b) / 2, b) or CFrame.new(a)
	return p
end
local function emitter(at: Instance, tex: string, c0: Color3, c1: Color3, rate: number, size: number, life: number, speed: number): ParticleEmitter
	local e = Instance.new("ParticleEmitter")
	e.Texture = tex
	e.Color = ColorSequence.new(c0, c1)
	e.LightEmission = 0.8
	e.Rate = rate
	e.Lifetime = NumberRange.new(life * 0.6, life)
	e.Speed = NumberRange.new(speed * 0.3, speed)
	e.SpreadAngle = Vector2.new(180, 180)
	e.Size = NumberSequence.new(size, 0)
	e.Transparency = NumberSequence.new(0.1, 1)
	e.Parent = at
	return e
end

------------------------------------------------------------------------
-- 별 (다섯 날). 조각들을 한 틀(cf)에 맞춰 함께 움직인다
------------------------------------------------------------------------
type Shape = { list: { { p: BasePart, off: CFrame } }, alive: boolean }
local function shapePlace(sh: Shape, cf: CFrame)
	if not sh.alive then
		return
	end
	for _, it in ipairs(sh.list) do
		it.p.CFrame = cf * it.off
	end
end
local function shapeFade(sh: Shape, time: number, grow: number?)
	if not sh.alive then
		return
	end
	sh.alive = false
	for _, it in ipairs(sh.list) do
		fadeOut(it.p, time, { Size = it.p.Size * (grow or 0.2) })
	end
end
local function makeStar(s: number, color: Color3, core: Color3?, alpha: number?): Shape
	local list = {}
	local c = newPart(Vector3.new(s * 0.5, s * 0.5, s * 0.5), core or WHITE, Enum.Material.Neon, alpha or 0, "ball")
	table.insert(list, { p = c, off = CFrame.new() })
	for k = 0, 4 do
		local a = math.rad(k * 72)
		-- 날 하나: 안쪽이 넓고 바깥이 뾰족한 쐐기 둘을 등지게 붙인다
		for side = -1, 1, 2 do
			local w = newPart(Vector3.new(0.12 * s, s * 0.62, s * 0.2), color, Enum.Material.Neon, alpha or 0, "wedge")
			local off = CFrame.Angles(0, 0, a) * CFrame.new(side * s * 0.1, s * 0.46, 0) * CFrame.Angles(0, side > 0 and 0 or math.pi, 0) * CFrame.Angles(0, math.rad(90), 0)
			table.insert(list, { p = w, off = off })
		end
	end
	return { list = list, alive = true }
end

------------------------------------------------------------------------
-- 마법진: 바깥·안 고리, 육망성 (두 삼각형), 둘레의 글자 조각. 틀(cf)의 -Z가 마법진이 바라보는 쪽
------------------------------------------------------------------------
local function ringInto(list: { { p: BasePart, off: CFrame } }, R: number, n: number, w: number, color: Color3, alpha: number)
	for k = 0, n - 1 do
		local a0, a1 = k / n * math.pi * 2, (k + 1) / n * math.pi * 2
		local p0 = Vector3.new(math.cos(a0) * R, math.sin(a0) * R, 0)
		local p1 = Vector3.new(math.cos(a1) * R, math.sin(a1) * R, 0)
		local seg = newPart(Vector3.new(w, w * 0.5, (p1 - p0).Magnitude * 1.05), color, Enum.Material.Neon, alpha)
		table.insert(list, { p = seg, off = CFrame.lookAt((p0 + p1) / 2, p1, Vector3.new(0, 0, 1)) })
	end
end
local function lineInto(list: { { p: BasePart, off: CFrame } }, a: Vector3, b: Vector3, w: number, color: Color3, alpha: number)
	local seg = newPart(Vector3.new(w, w * 0.5, (b - a).Magnitude), color, Enum.Material.Neon, alpha)
	table.insert(list, { p = seg, off = CFrame.lookAt((a + b) / 2, b, Vector3.new(0, 0, 1)) })
end
type Sigil = { outer: Shape, inner: Shape, cf: CFrame, R: number, spin: number, scale: number, alive: boolean }
local sigils: { Sigil } = {}
local function sigil(cf: CFrame, R: number, c: Color3, c2: Color3, life: number, spin: number?): Sigil
	local outer: Shape = { list = {}, alive = true }
	local inner: Shape = { list = {}, alive = true }
	local w = math.clamp(R * 0.05, 0.12, 0.6)
	ringInto(outer.list, R, math.clamp(math.floor(R * 2.4), 16, 48), w, c2, 0.1)
	ringInto(outer.list, R * 0.86, math.clamp(math.floor(R * 2), 14, 40), w * 0.6, c, 0.2)
	-- 고리 사이를 도는 글자 조각
	for k = 0, 11 do
		local a = k / 12 * math.pi * 2
		local g = newPart(Vector3.new(R * 0.07, R * 0.07, w * 0.4), k % 3 == 0 and c2 or c, Enum.Material.Neon, 0.15)
		table.insert(outer.list, { p = g, off = CFrame.new(math.cos(a) * R * 0.93, math.sin(a) * R * 0.93, 0) * CFrame.Angles(0, 0, a + math.rad(45)) })
	end
	-- 육망성 (안쪽은 거꾸로 돈다)
	for t = 0, 1 do
		local pts = {}
		for k = 0, 2 do
			local a = (k / 3 + t / 6) * math.pi * 2 + math.pi / 2
			pts[k + 1] = Vector3.new(math.cos(a) * R * 0.8, math.sin(a) * R * 0.8, 0)
		end
		for k = 1, 3 do
			lineInto(inner.list, pts[k], pts[k % 3 + 1], w * 0.8, t == 0 and c2 or c, 0.1)
		end
	end
	ringInto(inner.list, R * 0.4, 14, w * 0.6, c2, 0.15)
	local core = newPart(Vector3.new(R * 0.18, R * 0.18, R * 0.18), WHITE, Enum.Material.Neon, 0.1, "ball")
	table.insert(inner.list, { p = core, off = CFrame.new() })
	local sg: Sigil = { outer = outer, inner = inner, cf = cf, R = R, spin = spin or 1.5, scale = 0.05, alive = true }
	table.insert(sigils, sg)
	-- 커지며 열리고, 다 쓰면 줄며 닫힌다
	local t0 = os.clock()
	task.spawn(function()
		while sg.alive and os.clock() - t0 < 0.22 do
			sg.scale = math.min(1, (os.clock() - t0) / 0.2)
			task.wait()
		end
		sg.scale = 1
	end)
	task.delay(life, function()
		if sg.alive then
			sg.alive = false
			shapeFade(outer, 0.3, 1.3)
			shapeFade(inner, 0.3, 0.3)
		end
	end)
	return sg
end
-- 마법진은 매 프레임 돈다 (크기는 열릴 때만 바뀐다: 조각을 틀 안에서 펼친다)
RunService.Heartbeat:Connect(function()
	local t = os.clock()
	for i = #sigils, 1, -1 do
		local sg = sigils[i]
		if not sg.alive then
			table.remove(sigils, i)
		else
			local k = sg.scale
			for _, it in ipairs(sg.outer.list) do
				local o = it.off
				it.p.CFrame = sg.cf * CFrame.Angles(0, 0, t * sg.spin) * (CFrame.new(o.Position * k) * o.Rotation)
			end
			for _, it in ipairs(sg.inner.list) do
				local o = it.off
				it.p.CFrame = sg.cf * CFrame.Angles(0, 0, -t * sg.spin * 1.6) * (CFrame.new(o.Position * k) * o.Rotation)
			end
		end
	end
end)
-- 땅에 눕힌 마법진의 틀 (위를 본다)
local function floorCF(at: Vector3, y: number?): CFrame
	local g = ground(at)
	return CFrame.lookAt(g + Vector3.new(0, y or 0.25, 0), g + Vector3.new(0, 10, 0))
end

-- 별이 꽂히는 자리의 작은 터짐
local function starPop(at: Vector3, c: Color3, c2: Color3, s: number)
	Fx.ring(at, c2, 1, 8 * s, 0.35, Vector3.new(0, 1, 0))
	Fx.burst("glitter", at, c2, math.floor(8 * s), s)
	Fx.burst("spark", at, WHITE, math.floor(5 * s), s * 0.8)
	local f = newPart(Vector3.new(2, 2, 2) * s, PALE, Enum.Material.Neon, 0.2, "ball")
	f.CFrame = CFrame.new(at)
	fadeOut(f, 0.25, { Size = Vector3.new(5, 5, 5) * s })
end
-- 별 하나를 from에서 to로 날린다 (돌면서, 꼬리를 끌며). 모델을 주면 따라간다
local function shootStar(from: Vector3, to: Vector3, travel: number, s: number, c: Color3, c2: Color3, follow: Model?, arc: number?, onHit: ((Vector3) -> ())?)
	local st = makeStar(s, c2, WHITE)
	local t0 = os.clock()
	local side = Vector3.new(math.random() - 0.5, 0.6, math.random() - 0.5) * (arc or 4)
	local last = from
	local conn: RBXScriptConnection
	conn = RunService.Heartbeat:Connect(function()
		local u = math.clamp((os.clock() - t0) / travel, 0, 1)
		local goal = to
		if follow then
			local r = rootOf(follow)
			if r then
				goal = r.Position
			end
		end
		local e = u * u * (3 - 2 * u)
		local pos = from:Lerp(goal, e) + side * math.sin(u * math.pi)
		local dir = goal - pos
		if dir.Magnitude < 1e-3 then
			dir = Vector3.new(0, 0, -1)
		end
		shapePlace(st, CFrame.lookAt(pos, pos + dir.Unit) * CFrame.Angles(0, 0, u * 12))
		if (pos - last).Magnitude > 0.6 then
			local tr = beam(last, pos, 0.18 * s, c2, 0.3)
			fadeOut(tr, 0.25, { Size = Vector3.new(0.02, 0.02, tr.Size.Z) })
			last = pos
		end
		if u >= 1 then
			conn:Disconnect()
			shapeFade(st, 0.15, 1.6)
			starPop(pos, c, c2, s)
			if onHit then
				onHit(pos)
			end
		end
	end)
end

------------------------------------------------------------------------
-- 별 지팡이 (오른손). 손 기준 틀 G의 +Z가 지팡이 끝 (어깨 + 팔꿈치가 110도쯤이면 곧게 선다)
------------------------------------------------------------------------
local G = CFrame.Angles(math.rad(160), 0, 0)
local BUTT, TIP = 1.6, 4.3
local tips: { [Model]: { hand: BasePart } } = {}
local function attach(p: BasePart, to: BasePart, cf: CFrame, holder: Instance, list: { Instance })
	p.Massless = true
	p.Anchored = false
	p.CFrame = to.CFrame * cf
	local w = Instance.new("WeldConstraint")
	w.Part0 = to
	w.Part1 = p
	w.Parent = p
	p.Parent = holder
	table.insert(list, p)
end
function Star.tipOf(model: Model): Vector3?
	local t = tips[model]
	if t and t.hand.Parent then
		return (t.hand.CFrame * G * CFrame.new(0, 0, TIP + 0.75)).Position
	end
	return nil
end
function Star.buildGear(model: Model): { Instance }
	local out: { Instance } = {}
	local holder = Instance.new("Folder")
	holder.Name = "Staff_" .. model.Name
	holder.Parent = folder
	table.insert(out, holder)
	local hand = model:FindFirstChild("RightHand")
	if not (hand and hand:IsA("BasePart")) then
		return out
	end
	local st = Config.STYLE_BY_ID.chosengha
	local c, c2 = st and st.color or INDIGO, st and st.color2 or GOLD
	local len = BUTT + TIP
	local mid = (TIP - BUTT) / 2
	-- 자루: 짙은 보랏빛 나무, 금빛 띠 셋, 손잡이에 감은 남색 천
	attach(newPart(Vector3.new(len, 0.26, 0.26), WOOD, Enum.Material.Wood), hand, G * CFrame.new(0, 0, mid) * AXIS_Z, holder, out)
	for _, z in ipairs({ -BUTT + 0.15, 1.4, TIP - 0.5 }) do
		attach(newPart(Vector3.new(0.18, 0.32, 0.32), BRASS, Enum.Material.Metal, 0, "cyl"), hand, G * CFrame.new(0, 0, z) * AXIS_Z, holder, out)
	end
	attach(newPart(Vector3.new(1.0, 0.3, 0.3), c, Enum.Material.Fabric, 0, "cyl"), hand, G * CFrame.new(0, 0, 0.1) * AXIS_Z, holder, out)
	-- 물미: 작은 금빛 별 구슬
	attach(newPart(Vector3.new(0.34, 0.34, 0.34), c2, Enum.Material.Neon, 0, "ball"), hand, G * CFrame.new(0, 0, -BUTT - 0.1), holder, out)
	-- 머리: 별을 감싸는 초승달 고리 (금), 고리 끝의 작은 구슬 둘
	local ringR = 0.95
	for k = 0, 9 do
		local a0 = math.rad(-150 + k * 30)
		local a1 = math.rad(-150 + (k + 1) * 30)
		local p0 = Vector3.new(math.cos(a0) * ringR, 0, math.sin(a0) * ringR)
		local p1 = Vector3.new(math.cos(a1) * ringR, 0, math.sin(a1) * ringR)
		local seg = newPart(Vector3.new(0.14, 0.14, (p1 - p0).Magnitude * 1.1), BRASS, Enum.Material.Metal)
		attach(seg, hand, G * CFrame.new(0, 0, TIP + 0.75) * CFrame.lookAt((p0 + p1) / 2, p1), holder, out)
	end
	for _, a in ipairs({ -150, 150 }) do
		local r = math.rad(a)
		attach(newPart(Vector3.new(0.22, 0.22, 0.22), c2, Enum.Material.Neon, 0, "ball"), hand, G * CFrame.new(math.cos(r) * ringR, 0, TIP + 0.75 + math.sin(r) * ringR), holder, out)
	end
	-- 별 (손에 붙이지 않고 매 프레임 놓아 천천히 돈다), 둘레의 빛과 반짝이
	local starS = 1.1
	local head = makeStar(starS, c2, WHITE)
	for _, it in ipairs(head.list) do
		it.p.Parent = holder
		table.insert(out, it.p)
	end
	local glow = newPart(Vector3.new(0.2, 0.2, 0.2), WHITE, Enum.Material.Neon, 1)
	glow.Parent = holder
	table.insert(out, glow)
	local light = Instance.new("PointLight")
	light.Color = c2
	light.Range = 10
	light.Brightness = 1.4
	light.Parent = glow
	local a0 = Instance.new("Attachment")
	a0.Parent = glow
	local sp = emitter(a0, TEX_SPARK, c2, VIOLET, 5, 0.3, 0.9, 1.5)
	sp.Acceleration = Vector3.new(0, -2, 0)
	-- 끝에 매단 작은 별 장식 둘 (흔들린다)
	local charms: { Shape } = { makeStar(0.35, c2, WHITE), makeStar(0.3, VIOLET, WHITE) }
	for _, ch in ipairs(charms) do
		for _, it in ipairs(ch.list) do
			it.p.Parent = holder
			table.insert(out, it.p)
		end
	end
	tips[model] = { hand = hand }
	local t0 = os.clock()
	local conn: RBXScriptConnection
	conn = RunService.RenderStepped:Connect(function()
		if not holder.Parent or not hand.Parent then
			conn:Disconnect()
			tips[model] = nil
			return
		end
		local t = os.clock() - t0
		local top = hand.CFrame * G * CFrame.new(0, 0, TIP + 0.75)
		local hide = model:GetAttribute("Vanish") == true
		shapePlace(head, top * CFrame.Angles(0, t * 1.2, 0) * CFrame.Angles(math.rad(90), 0, 0))
		glow.CFrame = top
		light.Enabled = not hide
		for i, ch in ipairs(charms) do
			local swing = math.sin(t * 2.4 + i) * 0.35
			local base = hand.CFrame * G * CFrame.new(i == 1 and 0.6 or -0.6, 0, TIP - 0.1)
			local pos = (base * CFrame.new(0, 0, 0)).Position - Vector3.new(0, 0.6, 0) + Vector3.new(swing * 0.4, 0, swing * 0.2)
			shapePlace(ch, CFrame.new(pos) * CFrame.Angles(0, t * 2 + i, 0))
		end
		for _, it in ipairs(head.list) do
			it.p.LocalTransparencyModifier = hide and 1 or 0
		end
	end)
	return out
end

------------------------------------------------------------------------
-- 연타 장치 별진: 상대 발밑에 마법진이 열리고 별이 솟았다가 내리꽂힌다
------------------------------------------------------------------------
local function starSigil(data: any)
	local at: Vector3 = data.at
	if not near(at, 200) then
		return
	end
	local c, c2 = colors(data.style)
	local delay = data.delay or 0.35
	local R = (data.radius or 8) * 0.55
	sigil(floorCF(at), R, c, c2, delay + 0.2, 2.2)
	Fx.sound("ping", 0.5, 1.6, at)
	local g = ground(at)
	local st = makeStar(1.6, c2, WHITE)
	local t0 = os.clock()
	local conn: RBXScriptConnection
	conn = RunService.Heartbeat:Connect(function()
		local t = os.clock() - t0
		local u = math.clamp(t / delay, 0, 1)
		-- 0~0.7: 솟아올라 돈다, 0.7~1: 내리꽂힌다
		local h = u < 0.7 and 6 * math.sin(u / 0.7 * math.pi / 2) or 6 * (1 - (u - 0.7) / 0.3)
		local pos = g + Vector3.new(0, 0.5 + h, 0)
		shapePlace(st, CFrame.new(pos) * CFrame.Angles(0, t * 14, 0))
		if u >= 1 then
			conn:Disconnect()
			shapeFade(st, 0.2, 2)
			starPop(g + Vector3.new(0, 1, 0), c, c2, 1.4)
			Fx.ring(g + Vector3.new(0, 0.3, 0), c2, 2, (data.radius or 8) * 2, 0.4)
		end
	end)
end

------------------------------------------------------------------------
-- E 별똥 화살: 지팡이 끝 앞에 선 마법진, 별이 하나씩 날아가 꽂힌다
------------------------------------------------------------------------
local function starVolley(data: any)
	local from: Vector3 = data.from
	if not near(from, 220) then
		return
	end
	local c, c2 = colors(data.style)
	local aims = data.aims or {}
	local model: Model? = data.m
	local r = rootOf(model)
	local look = r and flat(r.CFrame.LookVector) or Vector3.new(0, 0, -1)
	local delay = data.delay or 0.18
	local every = data.every or 0.07
	local travel = data.travel or 0.28
	local origin = (model and Star.tipOf(model)) or from
	sigil(CFrame.lookAt(origin + look * 1.2, origin + look * 10), 2.6, c, c2, delay + every * #aims + 0.25, 3)
	Fx.sound("ping", 0.6, 1.3, origin)
	for i, a in ipairs(aims) do
		task.delay(delay + (i - 1) * every, function()
			local o = origin + look * 1.2 + Vector3.new(math.random() - 0.5, math.random() - 0.5, math.random() - 0.5) * 1.6
			shootStar(o, a.at + Vector3.new(0, 0.5, 0), travel, 1.1, c, c2, a.m, 3)
			Fx.sound("swing", 0.35, 1.6, o)
		end)
	end
end

------------------------------------------------------------------------
-- R 성좌진: 땅의 큰 마법진, 별 일곱이 떠올라 선으로 이어지고, 별빛 기둥
------------------------------------------------------------------------
local function starSeal(data: any)
	local at: Vector3 = data.at
	if not near(at, 220) then
		return
	end
	local c, c2 = colors(data.style)
	local R = data.radius or 12
	local n = data.stars or 7
	local delay = data.delay or 0.35
	local link = data.link or 0.1
	local total = delay + (n + 1) * link + 0.1
	local g = ground(at)
	sigil(floorCF(at), R, c, c2, total + 0.25, 1.2)
	local floorGlow = newPart(Vector3.new(0.2, R * 2, R * 2), NAVY, Enum.Material.Neon, 0.75, "cyl")
	floorGlow.CFrame = CFrame.new(g + Vector3.new(0, 0.12, 0)) * UP
	-- 별자리의 점: 둘레에 고르지 않게 흩어 놓는다
	local pts: { Vector3 } = {}
	local stars: { Shape } = {}
	local lines: { BasePart } = {}
	local base = math.random() * math.pi * 2
	for i = 1, n do
		local a = base + i / n * math.pi * 2 + (math.random() - 0.5) * 0.5
		local rr = R * (0.45 + math.random() * 0.4)
		pts[i] = g + Vector3.new(math.cos(a) * rr, 3 + math.random() * 3.5, math.sin(a) * rr)
	end
	for i = 1, n do
		task.delay(delay + i * link, function()
			local st = makeStar(1.3, c2, WHITE)
			shapePlace(st, CFrame.new(pts[i]))
			stars[i] = st
			Fx.burst("glitter", pts[i], c2, 5, 0.8)
			if i > 1 then
				table.insert(lines, beam(pts[i - 1], pts[i], 0.18, PALE, 0.15))
			end
			Fx.sound("ping", 0.35, 1.2 + i * 0.08, pts[i])
		end)
	end
	-- 별들은 천천히 돈다
	local t0 = os.clock()
	local conn: RBXScriptConnection
	conn = RunService.Heartbeat:Connect(function()
		local t = os.clock() - t0
		for i, st in pairs(stars) do
			shapePlace(st, CFrame.new(pts[i]) * CFrame.Angles(0, t * 3 + i, 0))
		end
		if t > total + 0.4 then
			conn:Disconnect()
		end
	end)
	task.delay(delay + (n + 1) * link, function()
		table.insert(lines, beam(pts[n], pts[1], 0.18, PALE, 0.15))
	end)
	task.delay(total, function()
		-- 별자리가 번쩍이고 가운데에서 별빛 기둥이 솟는다
		for _, l in ipairs(lines) do
			l.Color = WHITE
			fadeOut(l, 0.4, { Size = Vector3.new(0.6, 0.6, l.Size.Z) })
		end
		for i, st in pairs(stars) do
			shapeFade(st, 0.35, 2.2)
			Fx.burst("spark", pts[i], c2, 6, 1)
		end
		local col = newPart(Vector3.new(2, R * 0.8, R * 0.8), c2, Enum.Material.Neon, 0.1, "cyl")
		col.CFrame = CFrame.new(g + Vector3.new(0, 1, 0)) * UP
		tween(col, 0.18, { Size = Vector3.new(60, R * 0.8, R * 0.8), CFrame = CFrame.new(g + Vector3.new(0, 30, 0)) * UP })
		task.delay(0.2, function()
			fadeOut(col, 0.5, { Size = Vector3.new(60, R * 1.6, R * 1.6) })
		end)
		local inner = newPart(Vector3.new(2, R * 0.4, R * 0.4), WHITE, Enum.Material.Neon, 0, "cyl")
		inner.CFrame = CFrame.new(g + Vector3.new(0, 1, 0)) * UP
		tween(inner, 0.15, { Size = Vector3.new(64, R * 0.4, R * 0.4), CFrame = CFrame.new(g + Vector3.new(0, 32, 0)) * UP })
		task.delay(0.2, function()
			fadeOut(inner, 0.4)
		end)
		Fx.ring(g + Vector3.new(0, 0.4, 0), c2, 4, R * 2.6, 0.5)
		Fx.flash(g + Vector3.new(0, 4, 0), c2, 50, 6, 0.4)
		Fx.sound("heavy", 0.9, 1.3, g)
		shakeNear(g, 1.2, 100)
		fadeOut(floorGlow, 0.5)
	end)
end

------------------------------------------------------------------------
-- G 은하수: 커다란 지팡이가 내리꽂히고, 보라·남색·노란 안개 속에서 별이 두 팔의 나선으로 소용돌이친다
------------------------------------------------------------------------
local function bigStaff(length: number): { BasePart }
	local parts: { BasePart } = {}
	local shaft = newPart(Vector3.new(length, 1.4, 1.4), WOOD, Enum.Material.Wood, 0, "cyl")
	table.insert(parts, shaft)
	for _ = 1, 3 do
		table.insert(parts, newPart(Vector3.new(1, 1.9, 1.9), BRASS, Enum.Material.Metal, 0, "cyl"))
	end
	return parts
end
local function placeBigStaff(parts: { BasePart }, foot: Vector3, length: number)
	-- 곧게 서서 발끝이 foot에 닿는다
	parts[1].Size = Vector3.new(length, 1.4, 1.4)
	parts[1].CFrame = CFrame.new(foot + Vector3.new(0, length / 2, 0)) * UP
	for k = 2, #parts do
		local y = ({ length * 0.08, length * 0.55, length * 0.92 })[k - 1]
		parts[k].CFrame = CFrame.new(foot + Vector3.new(0, y, 0)) * UP
	end
end
local function galaxyStaff(data: any)
	local at: Vector3 = data.at
	if not near(at, 260) then
		return
	end
	local c, c2 = colors(data.style)
	local R = data.radius or 24
	local delay = data.delay or 0.55
	local dur = data.dur or 3.2
	local g = ground(at)
	local L = 26
	-- 지팡이가 하늘에서 자라며 내려와 꽂힌다
	local parts = bigStaff(L)
	local headStar = makeStar(5, c2, WHITE)
	local headGlow = newPart(Vector3.new(1, 1, 1), WHITE, Enum.Material.Neon, 1)
	local hl = Instance.new("PointLight")
	hl.Color = c2
	hl.Range = 40
	hl.Brightness = 3
	hl.Parent = headGlow
	local t0 = os.clock()
	local sink = 4
	local landed = false
	local swirl: { { s: Shape, a: number, r: number, h: number, sp: number } } = {}
	local fogParts: { BasePart } = {}
	local conn: RBXScriptConnection
	conn = RunService.Heartbeat:Connect(function()
		local t = os.clock() - t0
		local u = math.clamp(t / delay, 0, 1)
		local foot = g + Vector3.new(0, (1 - u * u) * 40 - sink * u * u, 0)
		local len = L * (0.35 + 0.65 * u)
		placeBigStaff(parts, foot, len)
		local topPos = foot + Vector3.new(0, len + 2.6, 0)
		shapePlace(headStar, CFrame.new(topPos) * CFrame.Angles(0, t * 1.5, 0))
		headGlow.CFrame = CFrame.new(topPos)
		if u >= 1 and not landed then
			landed = true
			Fx.ring(g + Vector3.new(0, 0.4, 0), c2, 4, R * 2.2, 0.6)
			Fx.ring(g + Vector3.new(0, 0.6, 0), VIOLET, 2, R * 1.4, 0.5)
			Fx.burst("dust", g + Vector3.new(0, 0.5, 0), Color3.fromRGB(120, 100, 160), 24, 1.6)
			Fx.flash(g + Vector3.new(0, 6, 0), c2, 60, 5, 0.4)
			Fx.sound("heavy", 1, 0.7, g)
			shakeNear(g, 2, 120)
			sigil(floorCF(at, 0.3), R, c, c2, dur, 0.5)
			-- 세 빛 안개: 땅을 덮는 큰 원판들에서 연기가 피어오른다
			for k, col in ipairs({ VIOLET, INDIGO, c2 }) do
				local a = newPart(Vector3.new(0.2, R * 2, R * 2), col, Enum.Material.Neon, 0.88, "cyl")
				a.CFrame = CFrame.new(g + Vector3.new(0, 0.2 + k * 0.05, 0)) * UP
				table.insert(fogParts, a)
				local holder = newPart(Vector3.new(R * 1.6, 1, R * 1.6), col, Enum.Material.Neon, 1)
				holder.CFrame = CFrame.new(g + Vector3.new(0, 1.5 + k, 0))
				table.insert(fogParts, holder)
				local e = Instance.new("ParticleEmitter")
				e.Texture = TEX_SMOKE
				e.Color = ColorSequence.new(col)
				e.LightEmission = 0.5
				e.Rate = 14
				e.Lifetime = NumberRange.new(1.5, 2.6)
				e.Speed = NumberRange.new(0.5, 2)
				e.SpreadAngle = Vector2.new(180, 30)
				e.RotSpeed = NumberRange.new(-20, 20)
				e.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 3), NumberSequenceKeypoint.new(1, 9) })
				e.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.3, 0.55), NumberSequenceKeypoint.new(1, 1) })
				e.Shape = Enum.ParticleEmitterShape.Box
				e.Parent = holder
				local sp = emitter(holder, TEX_SPARK, c2, WHITE, 10, 0.5, 1.4, 2)
				sp.Shape = Enum.ParticleEmitterShape.Box
			end
			-- 은하의 별: 두 팔의 나선 (가운데로 갈수록 빠르다)
			for arm = 0, 1 do
				for j = 1, 18 do
					local r = R * (0.12 + j / 18 * 0.85)
					local s = makeStar(0.5 + math.random() * 0.7, j % 3 == 0 and VIOLET or (j % 3 == 1 and c2 or PALE), WHITE, 0.05)
					table.insert(swirl, { s = s, a = arm * math.pi + j * 0.32 + (math.random() - 0.5) * 0.3, r = r, h = 1 + math.random() * 3.5, sp = 2.2 * (1.2 - j / 18 * 0.8) })
				end
			end
			for _ = 1, 14 do
				local s = makeStar(0.35, PALE, WHITE, 0.2)
				table.insert(swirl, { s = s, a = math.random() * math.pi * 2, r = R * (0.2 + math.random() * 0.8), h = 0.6 + math.random() * 5, sp = 1.4 })
			end
		end
		if landed then
			local tt = t - delay
			local gather = math.clamp((tt - dur + 0.35) / 0.35, 0, 1) -- 끝에 가운데로 모인다
			for _, it in ipairs(swirl) do
				local a = it.a + tt * it.sp
				local r = it.r * (1 - gather)
				local pos = g + Vector3.new(math.cos(a) * r, it.h + math.sin(tt * 2 + it.a) * 0.4 + gather * 6, math.sin(a) * r)
				shapePlace(it.s, CFrame.new(pos) * CFrame.Angles(0, tt * 4 + it.a, 0))
			end
			if tt >= dur then
				conn:Disconnect()
				for _, it in ipairs(swirl) do
					shapeFade(it.s, 0.3, 2)
				end
				for _, p in ipairs(fogParts) do
					for _, e in ipairs(p:GetChildren()) do
						if e:IsA("ParticleEmitter") then
							e.Enabled = false
						end
					end
					fadeOut(p, 1.2)
				end
				-- 은하가 터진다
				local core = newPart(Vector3.new(4, 4, 4), WHITE, Enum.Material.Neon, 0, "ball")
				core.CFrame = CFrame.new(g + Vector3.new(0, 6, 0))
				fadeOut(core, 0.5, { Size = Vector3.new(R * 1.6, R * 1.6, R * 1.6) })
				local shell = newPart(Vector3.new(4, 4, 4), VIOLET, Enum.Material.Neon, 0.3, "ball")
				shell.CFrame = core.CFrame
				fadeOut(shell, 0.7, { Size = Vector3.new(R * 2.2, R * 2.2, R * 2.2) })
				for k = 0, 2 do
					task.delay(k * 0.08, function()
						Fx.ring(g + Vector3.new(0, 0.5 + k, 0), k == 1 and VIOLET or c2, 4, R * 2.6 + k * 8, 0.6)
					end)
				end
				Fx.burst("glitter", g + Vector3.new(0, 6, 0), c2, 30, 2.4)
				Fx.flash(g + Vector3.new(0, 6, 0), c2, 90, 8, 0.6)
				Fx.sound("heavy", 1, 0.5, g)
				Fx.sound("shatter", 0.8, 1.2, g)
				shakeNear(g, 2.8, 150)
				for _, p in ipairs(parts) do
					fadeOut(p, 0.6)
				end
				shapeFade(headStar, 0.5, 3)
				fadeOut(headGlow, 0.5)
			end
		end
	end)
end

------------------------------------------------------------------------
-- X 성천궁: 남색 돔, 공중의 마법진에서 별, 메테오, 돔 표면의 별자리, 한꺼번에 폭발
------------------------------------------------------------------------
type Dome = { at: Vector3, R: number, parts: { BasePart }, dots: { Vector3 }, dotParts: { BasePart }, lines: { BasePart }, done: boolean }
local domes: { [number]: Dome } = {}
local function domePoint(g: Vector3, R: number, a: number, el: number): Vector3
	return g + Vector3.new(math.cos(a) * math.cos(el) * R, math.sin(el) * R, math.sin(a) * math.cos(el) * R)
end
local function domeEnd(d: Dome)
	if d.done then
		return
	end
	d.done = true
	for _, p in ipairs(d.parts) do
		if p.Parent then
			fadeOut(p, 0.6)
		end
	end
	for _, p in ipairs(d.dotParts) do
		if p.Parent then
			fadeOut(p, 0.3)
		end
	end
	for _, p in ipairs(d.lines) do
		if p.Parent then
			fadeOut(p, 0.3)
		end
	end
end
local function starDomeOpen(data: any)
	local at: Vector3 = data.at
	if not near(at, 320) then
		return
	end
	local c, c2 = colors(data.style)
	local R = data.radius or 34
	local cut = data.cut or 1.4
	local g = ground(at)
	local d: Dome = { at = g, R = R, parts = {}, dots = {}, dotParts = {}, lines = {}, done = false }
	domes[data.id] = d
	-- 돔: 바깥 남색 유리 + 안쪽 옅은 빛. 반은 땅에 묻힌 공
	local shell = newPart(Vector3.new(1, 1, 1), NAVY, Enum.Material.Glass, 0.45, "ball")
	shell.CFrame = CFrame.new(g)
	local glow = newPart(Vector3.new(1, 1, 1), c, Enum.Material.Neon, 0.9, "ball")
	glow.CFrame = CFrame.new(g)
	local rim = newPart(Vector3.new(0.4, 1, 1), c2, Enum.Material.Neon, 0.2, "cyl")
	rim.CFrame = CFrame.new(g + Vector3.new(0, 0.2, 0)) * UP
	table.insert(d.parts, shell)
	table.insert(d.parts, glow)
	table.insert(d.parts, rim)
	local open = cut * 0.7
	tween(shell, open, { Size = Vector3.new(R * 2, R * 2, R * 2) }, Enum.EasingStyle.Back)
	tween(glow, open, { Size = Vector3.new(R * 2 - 1, R * 2 - 1, R * 2 - 1) }, Enum.EasingStyle.Back)
	tween(rim, open, { Size = Vector3.new(0.4, R * 2 + 1, R * 2 + 1) }, Enum.EasingStyle.Back)
	-- 돔 안쪽에 박힌 별 점 (나중에 별자리가 된다)
	task.delay(open, function()
		if d.done then
			return
		end
		Fx.ring(g + Vector3.new(0, 0.5, 0), c2, R, R * 2.4, 0.6)
		Fx.sound("heavy", 0.9, 0.6, g)
		shakeNear(g, 1.6, 160)
		for k = 1, 34 do
			local a = math.random() * math.pi * 2
			local el = math.rad(15 + math.random() * 65)
			local pos = domePoint(g, R * 0.97, a, el)
			table.insert(d.dots, pos)
			local dot = newPart(Vector3.new(0.6, 0.6, 0.6), k % 4 == 0 and c2 or PALE, Enum.Material.Neon, 0.3, "ball")
			dot.CFrame = CFrame.new(pos)
			table.insert(d.dotParts, dot)
		end
	end)
	-- 쓰는 사람 발밑의 큰 마법진
	sigil(floorCF(at, 0.3), R * 0.5, c, c2, cut + (data.rain or 2.6) + (data.draw or 0.9), 0.4)
	-- 늦게 도착한 이벤트로 남지 않게
	task.delay(cut + (data.rain or 2.6) + (data.draw or 0.9) + 3, function()
		domeEnd(d)
		domes[data.id] = nil
	end)
end
local function domeStars(data: any)
	local d = domes[data.id]
	if not d or d.done then
		return
	end
	local c, c2 = colors(data.style)
	for _, pt in ipairs(data.pts or {}) do
		local high = Vector3.new(pt.X, d.at.Y + math.min(d.R * 0.7, 18) + math.random() * 4, pt.Z) + Vector3.new(math.random() - 0.5, 0, math.random() - 0.5) * 6
		sigil(CFrame.lookAt(high, high - Vector3.new(0, 10, 0)), 2.4, c, c2, 0.45, 3)
		task.delay(0.08, function()
			shootStar(high - Vector3.new(0, 0.5, 0), pt, 0.18, 0.9, c, c2, nil, 1)
		end)
	end
end
local function domeMeteor(data: any)
	local d = domes[data.id]
	local at: Vector3 = data.at
	if not near(at, 320) then
		return
	end
	local c, c2 = colors(data.style)
	local fall = data.fall or 0.35
	local g = ground(at)
	local top = (d and d.at or g) + Vector3.new((math.random() - 0.5) * 20, (d and d.R or 30) * 0.95, (math.random() - 0.5) * 20)
	local rock = newPart(Vector3.new(4.5, 4.5, 4.5), Color3.fromRGB(70, 50, 60), Enum.Material.Basalt, 0, "ball")
	local core = newPart(Vector3.new(5.6, 5.6, 5.6), Color3.fromRGB(255, 150, 80), Enum.Material.Neon, 0.55, "ball")
	local a0 = Instance.new("Attachment")
	a0.Parent = rock
	local fire = Instance.new("ParticleEmitter")
	fire.Texture = "rbxasset://textures/particles/fire_main.dds"
	fire.Color = ColorSequence.new(Color3.fromRGB(255, 200, 120), VIOLET)
	fire.LightEmission = 1
	fire.Rate = 60
	fire.Lifetime = NumberRange.new(0.3, 0.6)
	fire.Speed = NumberRange.new(2, 6)
	fire.Size = NumberSequence.new(3, 0)
	fire.Transparency = NumberSequence.new(0.1, 1)
	fire.Parent = a0
	sigil(floorCF(at, 0.35), (data.radius or 8), c, c2, fall + 0.2, 2)
	local t0 = os.clock()
	local last = top
	local conn: RBXScriptConnection
	conn = RunService.Heartbeat:Connect(function()
		local u = math.clamp((os.clock() - t0) / fall, 0, 1)
		local pos = top:Lerp(g + Vector3.new(0, 1.5, 0), u * u)
		rock.CFrame = CFrame.new(pos) * CFrame.Angles(u * 6, u * 4, 0)
		core.CFrame = CFrame.new(pos)
		if (pos - last).Magnitude > 1.5 then
			local tr = beam(last, pos, 2.2, Color3.fromRGB(255, 180, 110), 0.35)
			fadeOut(tr, 0.3, { Size = Vector3.new(0.2, 0.2, tr.Size.Z) })
			last = pos
		end
		if u >= 1 then
			conn:Disconnect()
			fire.Enabled = false
			fadeOut(rock, 0.25)
			fadeOut(core, 0.25, { Size = Vector3.new(14, 14, 14) })
			Fx.ring(g + Vector3.new(0, 0.4, 0), Color3.fromRGB(255, 170, 100), 3, (data.radius or 8) * 2.4, 0.5)
			Fx.burst("ember", g + Vector3.new(0, 1, 0), Color3.fromRGB(255, 160, 90), 16, 1.4)
			Fx.burst("dust", g + Vector3.new(0, 0.5, 0), Color3.fromRGB(110, 90, 110), 12, 1.2)
			Fx.flash(g + Vector3.new(0, 3, 0), Color3.fromRGB(255, 170, 110), 40, 5, 0.3)
			Fx.sound("heavy", 0.9, 0.8, g)
			shakeNear(g, 1.4, 120)
		end
	end)
end
-- 돔 표면에 별자리를 빛으로 긋고, 다 그으면 모두 한꺼번에 터진다
local function domeDraw(data: any)
	local d = domes[data.id]
	if not d or d.done then
		return
	end
	local _, c2 = colors(data.style)
	local draw = data.draw or 0.9
	local dots = d.dots
	-- 가까운 점끼리 이어 별자리 여럿 (점 넷~여섯씩)
	local used: { [number]: boolean } = {}
	local groups: { { Vector3 } } = {}
	for _ = 1, 6 do
		local start = 0
		for i = 1, #dots do
			if not used[i] then
				start = i
				break
			end
		end
		if start == 0 then
			break
		end
		local chain = { dots[start] }
		used[start] = true
		local cur = start
		for _ = 1, 3 + math.random(0, 2) do
			local best, bestD = nil, math.huge
			for j = 1, #dots do
				if not used[j] then
					local dd = (dots[j] - dots[cur]).Magnitude
					if dd < bestD then
						best, bestD = j, dd
					end
				end
			end
			if not best then
				break
			end
			used[best] = true
			cur = best
			table.insert(chain, dots[best])
		end
		table.insert(groups, chain)
	end
	-- 선을 하나씩 늘려 긋는다
	local segs: { { a: Vector3, b: Vector3, at: number } } = {}
	local total = 0
	for _, chain in ipairs(groups) do
		total += #chain - 1
	end
	local k = 0
	for _, chain in ipairs(groups) do
		for i = 1, #chain - 1 do
			table.insert(segs, { a = chain[i], b = chain[i + 1], at = k / math.max(1, total) * draw * 0.85 })
			k += 1
		end
	end
	for _, sg in ipairs(segs) do
		task.delay(sg.at, function()
			if d.done then
				return
			end
			local ln = beam(sg.a, sg.a, 0.35, PALE, 0.05)
			table.insert(d.lines, ln)
			local t0 = os.clock()
			local conn: RBXScriptConnection
			conn = RunService.Heartbeat:Connect(function()
				local u = math.clamp((os.clock() - t0) / 0.12, 0, 1)
				if not ln.Parent then
					conn:Disconnect()
					return
				end
				local b = sg.a:Lerp(sg.b, u)
				if (b - sg.a).Magnitude > 0.05 then
					ln.Size = Vector3.new(0.35, 0.35, (b - sg.a).Magnitude)
					ln.CFrame = CFrame.lookAt((sg.a + b) / 2, b)
				end
				if u >= 1 then
					conn:Disconnect()
				end
			end)
			Fx.sound("ping", 0.3, 1.5 + math.random() * 0.4, sg.b)
		end)
	end
	for _, p in ipairs(d.dotParts) do
		tween(p, draw, { Size = Vector3.new(1.4, 1.4, 1.4), Transparency = 0 })
	end
	task.delay(draw, function()
		if d.done then
			return
		end
		-- 별자리가 하얗게 번쩍인 뒤 돔째로 터진다
		for _, l in ipairs(d.lines) do
			l.Color = WHITE
			tween(l, 0.12, { Size = Vector3.new(1.2, 1.2, l.Size.Z) })
		end
		for _, p in ipairs(d.dotParts) do
			p.Color = WHITE
			Fx.burst("spark", p.Position, c2, 4, 1.2)
		end
		task.delay(0.12, function()
			local g = d.at
			local R = d.R
			for k2 = 0, 3 do
				task.delay(k2 * 0.07, function()
					Fx.ring(g + Vector3.new(0, 0.5 + k2 * 2, 0), k2 % 2 == 0 and c2 or VIOLET, R * 0.5, R * 3 + k2 * 10, 0.7)
				end)
			end
			local core = newPart(Vector3.new(6, 6, 6), WHITE, Enum.Material.Neon, 0, "ball")
			core.CFrame = CFrame.new(g + Vector3.new(0, R * 0.3, 0))
			fadeOut(core, 0.6, { Size = Vector3.new(R * 2.2, R * 2.2, R * 2.2) })
			-- 돔 조각이 사방으로 흩어진다
			for _ = 1, 26 do
				local a = math.random() * math.pi * 2
				local el = math.rad(10 + math.random() * 70)
				local pos = domePoint(g, R, a, el)
				local sh = newPart(Vector3.new(3 + math.random() * 4, 0.3, 3 + math.random() * 4), NAVY, Enum.Material.Glass, 0.3)
				sh.CFrame = CFrame.lookAt(pos, g) * CFrame.Angles(math.rad(90), 0, 0)
				fadeOut(sh, 0.8, { CFrame = CFrame.new(pos + (pos - g).Unit * 18) * CFrame.Angles(math.random() * 6, math.random() * 6, 0) })
			end
			Fx.burst("glitter", g + Vector3.new(0, R * 0.3, 0), c2, 40, 3)
			Fx.flash(g + Vector3.new(0, R * 0.3, 0), c2, 140, 10, 0.7)
			Fx.sound("shatter", 1, 0.8, g)
			Fx.sound("heavy", 1, 0.4, g)
			shakeNear(g, 3.4, 220)
			if opts.flash and near(g, R * 2) then
				opts.flash(WHITE, 0.25)
			end
			domeEnd(d)
		end)
	end)
end

-- 초 오의 컷씬 (쓴 사람 화면에서만): 하늘이 남색 밤이 되고 별이 하나둘 뜬다. 무릎 꿇은 나를 아래에서 올려다보다 밤하늘로
local cutActive = false
function Star.superCut(model: Model, dur: number, name: string, shake: ((number) -> ())?)
	local cam = workspace.CurrentCamera
	local r = rootOf(model)
	if not cam or not r or cutActive then
		return
	end
	cutActive = true
	local pg = player:WaitForChild("PlayerGui")
	local g = Instance.new("ScreenGui")
	g.Name = "KwonStarCut"
	g.IgnoreGuiInset = true
	g.ResetOnSpawn = false
	g.DisplayOrder = 85
	g.Parent = pg
	local tintF = Instance.new("Frame")
	tintF.Size = UDim2.fromScale(1, 1)
	tintF.BackgroundColor3 = Color3.fromRGB(14, 14, 60)
	tintF.BackgroundTransparency = 1
	tintF.BorderSizePixel = 0
	tintF.Parent = g
	tween(tintF, 0.3, { BackgroundTransparency = 0.45 })
	-- 화면 위쪽에 별이 하나둘 뜬다
	for k = 1, 40 do
		local s = Instance.new("Frame")
		local size = 2 + math.random() * 4
		s.Size = UDim2.fromOffset(size, size)
		s.AnchorPoint = Vector2.new(0.5, 0.5)
		s.Position = UDim2.fromScale(math.random(), 0.12 + math.random() * 0.5)
		s.BackgroundColor3 = k % 5 == 0 and GOLD or WHITE
		s.BackgroundTransparency = 1
		s.BorderSizePixel = 0
		s.ZIndex = 2
		local cr = Instance.new("UICorner")
		cr.CornerRadius = UDim.new(1, 0)
		cr.Parent = s
		s.Parent = tintF
		task.delay(math.random() * dur * 0.7, function()
			tween(s, 0.25, { BackgroundTransparency = 0.05 })
		end)
	end
	local bars: { Frame } = {}
	for i, y in ipairs({ 0, 1 }) do
		local b = Instance.new("Frame")
		b.AnchorPoint = Vector2.new(0, y)
		b.Position = UDim2.fromScale(0, y)
		b.Size = UDim2.new(1, 0, 0, 0)
		b.BackgroundColor3 = Color3.new(0, 0, 0)
		b.BorderSizePixel = 0
		b.ZIndex = 5
		b.Parent = g
		tween(b, 0.15, { Size = UDim2.new(1, 0, 0.14, 0) })
		bars[i] = b
	end
	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.AnchorPoint = Vector2.new(1, 0.5)
	label.Position = UDim2.new(1, -30, 0.5, 0)
	label.Size = UDim2.new(0.5, 0, 0.45, 0)
	label.Font = Enum.Font.GothamBlack
	label.TextScaled = true
	label.TextXAlignment = Enum.TextXAlignment.Right
	label.Text = "초 오의 · " .. name
	label.TextColor3 = PALE
	label.TextStrokeColor3 = Color3.fromRGB(70, 50, 170)
	label.TextStrokeTransparency = 0.2
	label.TextTransparency = 1
	label.ZIndex = 6
	label.Parent = bars[2]
	tween(label, 0.25, { TextTransparency = 0 })
	local oldType = cam.CameraType
	local oldFov = cam.FieldOfView
	local look = flat(r.CFrame.LookVector)
	local side = Vector3.new(-look.Z, 0, look.X)
	cam.CameraType = Enum.CameraType.Scriptable
	local t0 = os.clock()
	local focus = r.Position
	local finished = false
	local function restore()
		if finished then
			return
		end
		finished = true
		RunService:UnbindFromRenderStep("KwonStarCut")
		cam.CameraType = oldType == Enum.CameraType.Scriptable and Enum.CameraType.Custom or oldType
		cam.FieldOfView = oldFov
		cutActive = false
		for _, b in ipairs(bars) do
			tween(b, 0.2, { Size = UDim2.new(1, 0, 0, 0) })
		end
		tween(tintF, 0.25, { BackgroundTransparency = 1 })
		for _, s in ipairs(tintF:GetChildren()) do
			if s:IsA("Frame") then
				tween(s, 0.2, { BackgroundTransparency = 1 })
			end
		end
		tween(label, 0.2, { TextTransparency = 1 })
		task.delay(0.3, function()
			g:Destroy()
		end)
	end
	RunService:BindToRenderStep("KwonStarCut", Enum.RenderPriority.Camera.Value + 2, function()
		local t = os.clock() - t0
		local k = math.clamp(t / dur, 0, 1)
		-- 앞 아래에서 나를 올려다보다가, 천천히 물러나며 위로 (밤하늘)
		local a = k * math.rad(50)
		local eye = focus + look * (7 + k * 6) * math.cos(a) + side * 6 * math.sin(a) + Vector3.new(0, 0.6 + k * 2, 0)
		local target = focus:Lerp(focus + Vector3.new(0, 40, 0) - look * 10, k * 0.8)
		cam.CFrame = CFrame.lookAt(eye, target)
		cam.FieldOfView = oldFov + k * 14
		if t >= dur then
			restore()
		end
	end)
	if shake then
		task.delay(dur * 0.6, function()
			shake(0.7)
		end)
	end
	task.delay(dur + 1, restore)
end

local HANDLERS: { [string]: (any) -> () } = {
	starVolley = starVolley,
	starSeal = starSeal,
	galaxyStaff = galaxyStaff,
	starDomeOpen = starDomeOpen,
	domeStars = domeStars,
	domeMeteor = domeMeteor,
	domeDraw = domeDraw,
}
function Star.handles(data: any): boolean
	return HANDLERS[data.kind] ~= nil or (data.kind == "pulse" and data.fx == "starSigil")
end
function Star.run(data: any)
	if data.kind == "pulse" then
		starSigil(data)
		return
	end
	local fn = HANDLERS[data.kind]
	if fn then
		fn(data)
	end
end

return Star
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="45">
          <Properties>
            <string name="Name">UI</string>
            <string name="Source"><![CDATA[-- 권왕: 화면 (체력·균형·내공 막대, 기술 칸, 창, 수련 놀이, 알림)
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")

local Config = require(ReplicatedStorage:WaitForChild("Config"))

local UI = {}

local player = Players.LocalPlayer
local Request: RemoteEvent

local C = {
	bg = Color3.fromRGB(22, 16, 14),
	panel = Color3.fromRGB(40, 28, 24),
	panel2 = Color3.fromRGB(64, 44, 34),
	line = Color3.fromRGB(190, 150, 90),
	gold = Color3.fromRGB(255, 210, 120),
	text = Color3.fromRGB(250, 240, 225),
	dim = Color3.fromRGB(200, 185, 165),
	red = Color3.fromRGB(220, 60, 50),
	hp = Color3.fromRGB(215, 50, 45),
	posture = Color3.fromRGB(255, 180, 60),
	chi = Color3.fromRGB(80, 170, 255),
	green = Color3.fromRGB(90, 200, 120),
}
UI.C = C

local function new(class: string, props: { [string]: any }?, children: { Instance }?): any
	local inst = Instance.new(class)
	if props then
		for k, v in pairs(props) do
			if k ~= "Parent" then
				(inst :: any)[k] = v
			end
		end
	end
	for _, c in ipairs(children or {}) do
		c.Parent = inst
	end
	if props and props.Parent then
		inst.Parent = props.Parent
	end
	return inst
end
local function corner(r: number?): UICorner
	return new("UICorner", { CornerRadius = UDim.new(0, r or 10) })
end
local function stroke(color: Color3?, t: number?): UIStroke
	return new("UIStroke", { Color = color or C.line, Thickness = t or 1.5, ApplyStrokeMode = Enum.ApplyStrokeMode.Border })
end
local function text(props: { [string]: any }): TextLabel
	local base = { BackgroundTransparency = 1, Font = Enum.Font.GothamBold, TextColor3 = C.text, TextSize = 16, TextWrapped = true, TextXAlignment = Enum.TextXAlignment.Left }
	for k, v in pairs(props) do
		base[k] = v
	end
	return new("TextLabel", base)
end
local function button(props: { [string]: any }, onClick: () -> ()): TextButton
	local base = { BackgroundColor3 = C.panel2, Font = Enum.Font.GothamBlack, TextColor3 = C.text, TextSize = 16, AutoButtonColor = true, Text = "" }
	for k, v in pairs(props) do
		base[k] = v
	end
	local b = new("TextButton", base, { corner(8) })
	b.Activated:Connect(onClick)
	return b
end
UI.new, UI.corner, UI.stroke, UI.text, UI.button = new, corner, stroke, text, button

local gui: ScreenGui
local uiScale = 1
local windowScale = 1
-- (바깥 지역 변수가 200개 한도에 가까워 기기·터치 단추·메뉴 것은 한 표에) device: "pc" | "phone" | "tablet"
local V: any = { device = "pc", padScale = 1, mapScale = 1, hooks = {}, padBtns = {}, trainPad = nil, menuFrame = nil, menuToggle = nil, menuOpen = true }
-- 3.2.9판: 기기마다 다른 크기와 배치. 터치 기기는 화면 짧은 쪽이 600 미만이면 휴대폰, 아니면 태블릿 (아이패드)
local function isTouch(): boolean
	return UserInputService.TouchEnabled and not (UserInputService.KeyboardEnabled and UserInputService.MouseEnabled)
end
function UI.device(): string
	return V.device
end

-- 화면 크기에 맞춘 확대. 게임 시작 직후엔 화면 크기가 1×1로 잡힐 때가 있어
-- (그때 재면 창이 안 보일 만큼 작아진다) 크기가 바뀔 때마다 다시 재고, 너무 작으면 무시한다
local scales: { { s: UIScale, kind: string } } = {}
local function scaleFor(kind: string): number
	if kind == "window" then
		return windowScale
	elseif kind == "map" then
		return V.mapScale
	elseif kind == "pad" then
		return V.padScale
	end
	return uiScale
end
local function scaled(parent: Instance, kind: string?): UIScale
	local k = kind or "ui"
	local sc = Instance.new("UIScale")
	sc.Scale = scaleFor(k)
	sc.Parent = parent
	table.insert(scales, { s = sc, kind = k })
	return sc
end
local function measure()
	local cam = workspace.CurrentCamera
	local vp = cam and cam.ViewportSize or Vector2.new(1280, 720)
	if vp.X < 320 or vp.Y < 240 then
		vp = Vector2.new(1280, 720) -- 아직 화면이 안 잡혔다
	end
	V.device = isTouch() and (math.min(vp.X, vp.Y) < 600 and "phone" or "tablet") or "pc"
	if V.device == "phone" then
		-- 휴대폰: 글자·막대는 작게, 누르는 단추는 손가락 크기 (약 48pt)
		uiScale = math.clamp(vp.Y / 560, 0.6, 0.9)
		V.padScale = math.clamp(vp.Y / 430, 0.8, 1.05)
		windowScale = math.clamp(vp.Y / 580, 0.55, 0.9)
	elseif V.device == "tablet" then
		uiScale = math.clamp(vp.Y / 740, 0.9, 1.35)
		V.padScale = uiScale
		windowScale = math.clamp(math.min(uiScale, vp.Y * 0.9 / 600, vp.X * 0.95 / 900), 0.6, 1.4)
	else
		uiScale = math.clamp(vp.Y / 720, 0.75, 1.7)
		V.padScale = uiScale
		windowScale = math.clamp(math.min(uiScale, vp.Y * 0.9 / 600, vp.X * 0.95 / 900), 0.5, 1.7)
	end
	-- 큰 지도 (760)도 화면 높이를 넘지 않게
	V.mapScale = math.min(uiScale * 0.9, windowScale, vp.Y * 0.94 / 760)
	for _, e in ipairs(scales) do
		if e.s.Parent then
			e.s.Scale = scaleFor(e.kind)
		end
	end
	for _, f in ipairs(V.hooks) do
		f(vp)
	end
end

------------------------------------------------------------------------
-- 알림과 큰 글자
------------------------------------------------------------------------
local toastBox: Frame
function UI.toast(msg: string)
	if not toastBox then
		return
	end
	local l = text({ Size = UDim2.new(1, 0, 0, 34), Text = msg, TextSize = 21, TextXAlignment = Enum.TextXAlignment.Center, TextStrokeTransparency = 0.3, Parent = toastBox })
	task.delay(3, function()
		if not l.Parent then
			return
		end
		TweenService:Create(l, TweenInfo.new(0.4), { TextTransparency = 1, TextStrokeTransparency = 1 }):Play()
		task.delay(0.45, function()
			l:Destroy()
		end)
	end)
	local kids = toastBox:GetChildren()
	if #kids > 6 then
		for i = 1, #kids - 6 do
			if kids[i]:IsA("TextLabel") then
				kids[i]:Destroy()
			end
		end
	end
end

function UI.banner(title: string, sub: string?, color: Color3?)
	local f = new("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0.5, 0, 0.3, 0), Size = UDim2.new(0, 760, 0, 110), BackgroundTransparency = 1, ZIndex = 20, Parent = gui })
	local sc = new("UIScale", { Scale = uiScale * 1.6, Parent = f })
	local t = text({ Size = UDim2.new(1, 0, 0, 64), Text = title, TextSize = 50, Font = Enum.Font.GothamBlack, TextColor3 = color or C.gold, TextXAlignment = Enum.TextXAlignment.Center, TextStrokeTransparency = 0, Parent = f })
	local s = text({ Position = UDim2.new(0, 0, 0, 66), Size = UDim2.new(1, 0, 0, 34), Text = sub or "", TextSize = 22, TextXAlignment = Enum.TextXAlignment.Center, TextStrokeTransparency = 0.3, Parent = f })
	TweenService:Create(sc, TweenInfo.new(0.25, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = uiScale }):Play()
	task.delay(2.2, function()
		TweenService:Create(t, TweenInfo.new(0.4), { TextTransparency = 1, TextStrokeTransparency = 1 }):Play()
		TweenService:Create(s, TweenInfo.new(0.4), { TextTransparency = 1, TextStrokeTransparency = 1 }):Play()
		task.delay(0.45, function()
			f:Destroy()
		end)
	end)
end

-- 화면 번쩍임
local flash: Frame
function UI.flash(color: Color3, strength: number)
	flash.BackgroundColor3 = color
	flash.BackgroundTransparency = 1 - math.clamp(strength, 0, 0.7)
	TweenService:Create(flash, TweenInfo.new(0.3), { BackgroundTransparency = 1 }):Play()
end

-- 오의: 위아래 검은 띠와 기술 이름
local bars: { Frame } = {}
-- 오의 화면 연출: 검은 섬광 한 번, 가운데로 몰려드는 집중선, 권법 빛깔의 테두리
function UI.ultFrame(color: Color3, color2: Color3)
	local layer = new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, ZIndex = 35, Active = false, Parent = gui })
	local inv = new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(0, 0, 0), BackgroundTransparency = 0.15, ZIndex = 35, Parent = layer })
	task.delay(0.05, function()
		inv.BackgroundColor3 = color2
		TweenService:Create(inv, TweenInfo.new(0.25), { BackgroundTransparency = 1 }):Play()
	end)
	-- 줄마다 가운데를 향하게 놓는다 (프레임은 제 가운데를 축으로 돌므로 자리는 각도로 따로 잡는다)
	local cam = workspace.CurrentCamera
	local vp = cam and cam.ViewportSize or Vector2.new(1280, 720)
	local reach = vp.Magnitude * 0.5
	for i = 1, 30 do
		local a = i / 30 * 360 + math.random() * 8
		local dir = Vector2.new(math.cos(math.rad(a)), math.sin(math.rad(a)))
		local len = reach * (0.45 + math.random() * 0.2)
		local function at(r: number): UDim2
			return UDim2.new(0.5, dir.X * r, 0.5, dir.Y * r)
		end
		local line = new("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = at(reach * 0.95), Size = UDim2.fromOffset(len, math.random(2, 6)), Rotation = a,
			BackgroundColor3 = i % 3 == 0 and color or Color3.new(1, 1, 1), BackgroundTransparency = 0.2, BorderSizePixel = 0, ZIndex = 36, Parent = layer })
		-- 가운데 쪽 끝은 흐리게
		new("UIGradient", { Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.5, 0.6), NumberSequenceKeypoint.new(1, 0) }), Parent = line })
		-- 바깥에서 가운데로 몰려든다
		TweenService:Create(line, TweenInfo.new(0.5, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Position = at(reach * 0.55), Size = UDim2.fromOffset(len * 0.6, 1), BackgroundTransparency = 1 }):Play()
	end
	-- 테두리는 프레임 바깥으로 그려지므로 안쪽으로 당겨 둔다
	local rim = new("Frame", { Position = UDim2.fromOffset(24, 24), Size = UDim2.new(1, -48, 1, -48), BackgroundTransparency = 1, ZIndex = 36, Parent = layer }, { new("UIStroke", { Color = color, Thickness = 40, Transparency = 0.2 }) })
	local st = rim:FindFirstChildOfClass("UIStroke")
	if st then
		TweenService:Create(st, TweenInfo.new(0.7), { Transparency = 1, Thickness = 8 }):Play()
	end
	task.delay(0.75, function()
		layer:Destroy()
	end)
end

function UI.cinematic(name: string, color: Color3, dur: number)
	for _, b in ipairs(bars) do
		TweenService:Create(b, TweenInfo.new(0.2), { Size = UDim2.new(1, 0, 0.1, 0) }):Play()
	end
	UI.banner("오의 · " .. name, nil, color)
	task.delay(dur, function()
		for _, b in ipairs(bars) do
			TweenService:Create(b, TweenInfo.new(0.3), { Size = UDim2.new(1, 0, 0, 0) }):Play()
		end
	end)
end

------------------------------------------------------------------------
-- 내 막대 (아래 가운데)
------------------------------------------------------------------------
local HUD: any = {}

-- 위가 밝고 아래가 어두운 빛 (막대·칸에 입힌다)
local function sheen(parent: Instance, top: number?, bottom: number?)
	new("UIGradient", { Rotation = 90, Color = ColorSequence.new(Color3.new(1, 1, 1):Lerp(Color3.new(1, 1, 1), 0), Color3.fromRGB(150, 150, 150)), Transparency = NumberSequence.new(top or 0, bottom or 0), Parent = parent })
end
UI.sheen = sheen
local meterTrails: { [Frame]: Frame } = {}
local function meter(parent: Instance, pos: UDim2, size: UDim2, color: Color3, label: string): (Frame, TextLabel)
	local back = new("Frame", { Position = pos, Size = size, BackgroundColor3 = Color3.fromRGB(16, 11, 10), BackgroundTransparency = 0.1, Parent = parent }, { corner(6), stroke(Color3.fromRGB(150, 115, 70), 1.4) })
	-- 깎인 만큼 잠깐 남는 흰 띠 (맞은 양이 보인다)
	local trail = new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.fromRGB(255, 240, 220), BackgroundTransparency = 0.25, Parent = back }, { corner(6) })
	local fill = new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = color, ZIndex = 2, Parent = back }, { corner(6) })
	sheen(fill)
	meterTrails[fill] = trail
	local l = text({ Size = UDim2.fromScale(1, 1), Text = label, TextSize = 16, Font = Enum.Font.GothamBold, TextXAlignment = Enum.TextXAlignment.Center, TextStrokeTransparency = 0.3, ZIndex = 3, Parent = back })
	return fill, l
end
-- 흰 띠가 천천히 따라 내려온다
local function trailTo(fill: Frame, r: number)
	fill.Size = UDim2.fromScale(r, 1)
	local trail = meterTrails[fill]
	if trail then
		local cur = trail.Size.X.Scale
		trail.Size = UDim2.fromScale(r > cur and r or cur + (r - cur) * 0.06, 1)
	end
end

local function buildHud()
	local hud = new("Frame", { AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -14), Size = UDim2.new(0, 660, 0, 176), BackgroundTransparency = 1, Parent = gui })
	scaled(hud)
	HUD.root = hud
	-- 막대 뒤의 어두운 판과 금빛 테
	local plate = new("Frame", { Position = UDim2.new(0, -14, 0, 48), Size = UDim2.new(1, 28, 0, 76), BackgroundColor3 = Color3.fromRGB(14, 10, 9), BackgroundTransparency = 0.35, ZIndex = 0, Parent = hud }, { corner(12), stroke(Color3.fromRGB(150, 115, 70), 1) })
	new("UIGradient", { Rotation = 90, Transparency = NumberSequence.new(0.2, 0.6), Parent = plate })
	HUD.style = text({ Size = UDim2.new(1, 0, 0, 28), TextSize = 22, Font = Enum.Font.GothamBlack, TextXAlignment = Enum.TextXAlignment.Center, TextStrokeTransparency = 0.3, Parent = hud })
	HUD.stacks = text({ Position = UDim2.new(0, 0, 0, 27), Size = UDim2.new(1, 0, 0, 22), TextSize = 18, TextColor3 = C.gold, TextXAlignment = Enum.TextXAlignment.Center, TextStrokeTransparency = 0.3, Parent = hud })
	-- 균형: 가운데에서 양옆으로 차오른다 (꽉 차면 파훼)
	local pBack = new("Frame", { Position = UDim2.new(0.15, 0, 0, 54), Size = UDim2.new(0.7, 0, 0, 12), BackgroundColor3 = Color3.fromRGB(20, 14, 12), BackgroundTransparency = 0.3, Parent = hud }, { corner(5) })
	HUD.posture = new("Frame", { AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.fromScale(0.5, 0), Size = UDim2.fromScale(0, 1), BackgroundColor3 = C.posture, Parent = pBack }, { corner(5) })
	HUD.hp, HUD.hpText = meter(hud, UDim2.new(0, 0, 0, 72), UDim2.new(1, 0, 0, 26), C.hp, "")
	HUD.chi, HUD.chiText = meter(hud, UDim2.new(0.15, 0, 0, 102), UDim2.new(0.7, 0, 0, 16), C.chi, "")
	-- 기술 칸
	local row = new("Frame", { Position = UDim2.new(0, 0, 0, 124), Size = UDim2.new(1, 0, 0, 50), BackgroundTransparency = 1, Parent = hud }, {
		new("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, HorizontalAlignment = Enum.HorizontalAlignment.Center, Padding = UDim.new(0, 6) }),
	})
	HUD.row = row
	HUD.slots = {}
	for _, s in ipairs({ { "M1", "클릭" }, { "H", "Z 강타" }, { "E", "E" }, { "R", "R" }, { "G", "G 오의" }, { "X", "X 초 오의" }, { "Q", "Q 대시" }, { "F", "F 막기" }, { "P", "H 약" } }) do
		local cell = new("Frame", { Size = UDim2.new(0, 76, 1, 0), BackgroundColor3 = C.panel, BackgroundTransparency = 0.1, Parent = row }, { corner(8) })
		local st = stroke(C.line, 1.2)
		st.Parent = cell
		sheen(cell, 0, 0)
		-- 위의 빛깔 띠 (쓰는 권법의 빛)
		local stripe = new("Frame", { Size = UDim2.new(1, -8, 0, 3), Position = UDim2.new(0, 4, 0, 2), BackgroundColor3 = C.gold, BorderSizePixel = 0, ZIndex = 3, Parent = cell }, { corner(2) })
		local name = text({ Size = UDim2.new(1, -4, 0.62, 0), Position = UDim2.new(0, 2, 0, 2), TextSize = 14, Font = Enum.Font.GothamBold, TextXAlignment = Enum.TextXAlignment.Center, ZIndex = 3, Parent = cell })
		local key = text({ Position = UDim2.new(0, 0, 0.6, 0), Size = UDim2.new(1, 0, 0.4, 0), Text = s[2], TextSize = 12, TextColor3 = C.dim, TextXAlignment = Enum.TextXAlignment.Center, ZIndex = 3, Parent = cell })
		local cd = new("Frame", { AnchorPoint = Vector2.new(0, 1), Position = UDim2.fromScale(0, 1), Size = UDim2.fromScale(1, 0), BackgroundColor3 = Color3.new(0, 0, 0), BackgroundTransparency = 0.35, ZIndex = 4, Parent = cell }, { corner(8) })
		local _ = key
		HUD.slots[s[1]] = { cell = cell, name = name, cd = cd, stripe = stripe, stroke = st }
	end
end

-- 매 순간 내 막대
function UI.bars(hp: number, maxHp: number, posture: number, postureMax: number, chi: number, chiMax: number?)
	if not HUD.hp then
		return
	end
	trailTo(HUD.hp, math.clamp(hp / math.max(1, maxHp), 0, 1))
	HUD.hpText.Text = string.format("❤ %d / %d", math.floor(hp), maxHp)
	local pr = math.clamp(posture / math.max(1, postureMax), 0, 1)
	HUD.posture.Size = UDim2.fromScale(pr, 1)
	HUD.posture.BackgroundColor3 = pr > 0.75 and C.red or C.posture
	local cm = chiMax or Config.CHI_MAX
	HUD.chi.Size = UDim2.fromScale(math.clamp(chi / cm, 0, 1), 1)
	HUD.chiText.Text = string.format("🌀 내공 %d / %d", math.floor(chi), cm)
end

-- 기술 칸 (이름, 잠김, 대기 시간 비율)
function UI.slots(info: { [string]: { name: string, locked: boolean?, cd: number? } })
	if not HUD.slots then
		return
	end
	-- 3.2.9판: 터치 단추에도 잠김·대기를 보인다 (기술 칸은 터치 기기에서 숨긴다)
	for key, pb in pairs(V.padBtns) do
		local i = info[key]
		if key == "X" then
			pb.b.Visible = i ~= nil
		end
		if i then
			local cdr = math.clamp(i.cd or 0, 0, 1)
			local ready = not i.locked and cdr <= 0
			pb.b.Text = i.locked and "🔒" or pb.label
			pb.b.BackgroundTransparency = ready and 0.15 or 0.62
			pb.b.TextTransparency = ready and 0 or 0.35
			pb.st.Color = (ready and HUD.styleColor) or Color3.fromRGB(255, 255, 255)
			pb.st.Transparency = ready and 0 or 0.6
		end
	end
	for key, s in pairs(HUD.slots) do
		local i = info[key]
		-- 초 오의 칸은 초월 권법일 때만
		if key == "X" then
			s.cell.Visible = i ~= nil
		end
		if i then
			s.name.Text = (i.locked and "🔒 " or "") .. i.name
			s.name.TextColor3 = i.locked and C.dim or C.text
			local cdr = math.clamp(i.cd or 0, 0, 1)
			s.cd.Size = UDim2.fromScale(1, cdr)
			-- 쓸 수 있는 기술은 테가 권법 빛으로 빛난다
			if s.stripe and HUD.styleColor then
				s.stripe.BackgroundColor3 = HUD.styleColor
				s.stroke.Color = (cdr <= 0 and not i.locked and (key == "E" or key == "R" or key == "G" or key == "X")) and HUD.styleColor or C.line
				s.stroke.Thickness = (cdr <= 0 and not i.locked and (key == "G" or key == "X")) and (key == "X" and 3.5 or 2.5) or 1.2
			end
		end
	end
end

function UI.styleLine(t: string, color: Color3, stacks: string)
	if HUD.style then
		HUD.style.Text = t
		HUD.style.TextColor3 = color
		HUD.styleColor = color
		HUD.stacks.Text = stacks
	end
end

------------------------------------------------------------------------
-- 보스 막대 (위 가운데)
------------------------------------------------------------------------
local bossFrame: Frame
local bossFill: Frame
local bossPosture: Frame
local bossName: TextLabel
local bossSub: TextLabel
local bossHpText: TextLabel
local bossModel: Model? = nil
function UI.setBoss(model: Model?)
	bossModel = model
	bossFrame.Visible = model ~= nil
	if model then
		local label = model:GetAttribute("Label")
		bossName.Text = "👹 " .. (type(label) == "string" and label or "보스")
		UI.bossPhase(tonumber(model:GetAttribute("BossPhase")) or 1)
	end
end
function UI.bossPhase(ph: number)
	if bossSub and bossModel then
		local lv = bossModel:GetAttribute("Level")
		local power = bossModel:GetAttribute("Power")
		bossSub.Text = string.format("Lv.%s  ·  %d단계 / 3  ·  ⚔ 전투력 %s", tostring(lv or "?"), ph, Config.formatNumber(tonumber(power) or 0))
		bossSub.TextColor3 = ph >= 3 and Color3.fromRGB(255, 90, 70) or (ph == 2 and Color3.fromRGB(255, 170, 90) or C.dim)
	end
end

------------------------------------------------------------------------
-- 적 머리 위 이름표 (이름, 체력, 균형)
------------------------------------------------------------------------
function UI.enemyTag(model: Model)
	local head = model:WaitForChild("Head", 5)
	if not head or not head:IsA("BasePart") or head:FindFirstChild("EnemyTag") then
		return
	end
	local isBoss = model:GetAttribute("Boss") == true
	local w = isBoss and 300 or 230
	local bb = new("BillboardGui", { Name = "EnemyTag", Size = UDim2.new(0, w, 0, 76), StudsOffset = Vector3.new(0, 3.2, 0), AlwaysOnTop = true, LightInfluence = 0, MaxDistance = isBoss and 200 or 130, Parent = head })
	local label = model:GetAttribute("Label")
	local lv = model:GetAttribute("Level")
	local lvText = type(lv) == "number" and string.format("Lv.%d ", lv) or ""
	local name = text({ Size = UDim2.new(1, 0, 0, 26), Text = (isBoss and "👹 " or "⚔ ") .. lvText .. (type(label) == "string" and label or "적"), TextSize = isBoss and 23 or 20, Font = Enum.Font.GothamBlack, TextColor3 = isBoss and C.gold or (type(lv) == "number" and lv >= 7 and Color3.fromRGB(255, 110, 90) or Color3.fromRGB(255, 200, 190)), TextXAlignment = Enum.TextXAlignment.Center, TextStrokeTransparency = 0.1, Parent = bb })
	local _ = name
	local back = new("Frame", { Position = UDim2.new(0, 0, 0, 29), Size = UDim2.new(1, 0, 0, 12), BackgroundColor3 = Color3.fromRGB(20, 10, 10), Parent = bb }, { corner(4), stroke(Color3.fromRGB(0, 0, 0), 1) })
	local fill = new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = C.hp, Parent = back }, { corner(4) })
	local pback = new("Frame", { Position = UDim2.new(0.15, 0, 0, 45), Size = UDim2.new(0.7, 0, 0, 7), BackgroundColor3 = Color3.fromRGB(20, 10, 10), BackgroundTransparency = 0.3, Parent = bb }, { corner(3) })
	local pfill = new("Frame", { AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.fromScale(0.5, 0), Size = UDim2.fromScale(0, 1), BackgroundColor3 = C.posture, Parent = pback }, { corner(3) })
	-- 전투력 견주기: 차이가 크면 그 적의 공격은 나에게 통하지 않는다
	local powerLabel = text({ Position = UDim2.new(0, 0, 0, 55), Size = UDim2.new(1, 0, 0, 20), TextSize = 15, Font = Enum.Font.GothamBold, TextXAlignment = Enum.TextXAlignment.Center, TextStrokeTransparency = 0.2, Parent = bb })
	local function refreshPower()
		if model:GetAttribute("Dummy") == true then
			local dps = tonumber(model:GetAttribute("Dps")) or 0
			local best = tonumber(model:GetAttribute("Best")) or 0
			powerLabel.Text = "🎯 초당 피해 " .. Config.formatNumber(dps) .. " · 가장 센 한 방 " .. Config.formatNumber(best)
			powerLabel.TextColor3 = Color3.fromRGB(255, 225, 150)
			return
		end
		local ep = model:GetAttribute("Power")
		local char = player.Character
		local mp = char and char:GetAttribute("Power")
		if type(ep) ~= "number" then
			powerLabel.Text = ""
			return
		end
		local tagText, col = "", Color3.fromRGB(230, 220, 200)
		if type(mp) == "number" then
			local r = mp / math.max(1, ep)
			local G = Config.POWER_GAP
			if r >= G.immune then
				tagText, col = " · 호신강기 (통하지 않음)", Color3.fromRGB(150, 150, 150)
			elseif r >= G.steady then
				tagText, col = " · 한참 약함", Color3.fromRGB(170, 200, 170)
			elseif r >= G.soft then
				tagText, col = " · 약함", Color3.fromRGB(180, 230, 180)
			elseif r >= 0.8 then
				tagText, col = " · 비슷", Color3.fromRGB(255, 230, 160)
			elseif r >= 0.5 then
				tagText, col = " · 강함", Color3.fromRGB(255, 150, 100)
			else
				tagText, col = " · 아주 강함", Color3.fromRGB(255, 80, 70)
			end
		end
		powerLabel.Text = "⚔ 전투력 " .. Config.formatNumber(ep) .. tagText
		powerLabel.TextColor3 = col
	end
	refreshPower()
	model:GetAttributeChangedSignal("Power"):Connect(refreshPower)
	model:GetAttributeChangedSignal("Dps"):Connect(refreshPower)
	-- 내 전투력이 바뀌면 다시 견준다 (적이 사라지면 그만)
	task.spawn(function()
		while true do
			task.wait(2)
			if not model.Parent or not bb.Parent then
				break
			end
			if not pcall(refreshPower) then
				break
			end
		end
	end)
	local function refresh()
		local hp = model:GetAttribute("Hp")
		local mx = model:GetAttribute("MaxHp")
		local po = model:GetAttribute("Posture")
		local pm = model:GetAttribute("PostureMax")
		if type(hp) == "number" and type(mx) == "number" then
			fill.Size = UDim2.fromScale(math.clamp(hp / math.max(1, mx), 0, 1), 1)
		end
		if type(po) == "number" and type(pm) == "number" then
			local r = math.clamp(po / math.max(1, pm), 0, 1)
			pfill.Size = UDim2.fromScale(r, 1)
			pfill.BackgroundColor3 = r > 0.75 and C.red or C.posture
		end
		bb.Enabled = model:GetAttribute("Dead") ~= true
	end
	refresh()
	model:GetAttributeChangedSignal("Hp"):Connect(refresh)
	model:GetAttributeChangedSignal("Posture"):Connect(refresh)
	model:GetAttributeChangedSignal("Dead"):Connect(refresh)
end

------------------------------------------------------------------------
-- 창
------------------------------------------------------------------------
local window: Frame
local windowTitle: TextLabel
local pages: { [string]: Frame } = {}
local refreshers: { [string]: (boolean?) -> () } = {}
local current = ""
local state: any = nil
local TITLES = { styles = "🥋 권법", stats = "📊 능력치와 경지", shop = "🧪 만물상", help = "📜 도움말", test = "🧪 테스트", manuals = "📜 심법 (내공 수련서)", skyshop = "💠 천상 상점", ach = "🏆 업적과 칭호" }

local function makePage(name: string): Frame
	local f = new("Frame", { Position = UDim2.new(0, 16, 0, 56), Size = UDim2.new(1, -32, 1, -68), BackgroundTransparency = 1, Visible = false, Parent = window })
	pages[name] = f
	return f
end

local function scroller(parent: Instance, size: UDim2, pos: UDim2?): ScrollingFrame
	return new("ScrollingFrame", { Position = pos or UDim2.new(), Size = size, BackgroundTransparency = 1, BorderSizePixel = 0, ScrollBarThickness = 8, ScrollBarImageColor3 = C.line, AutomaticCanvasSize = Enum.AutomaticSize.Y, CanvasSize = UDim2.new(), Parent = parent })
end

local pageOpt: any = nil
function UI.openPage(name: string, opt: any?)
	pageOpt = opt
	if window.Visible and current == name and not opt then
		window.Visible = false
		return
	end
	current = name
	for n, f in pairs(pages) do
		f.Visible = n == name
	end
	windowTitle.Text = TITLES[name] or name
	window.Visible = true
	local r = refreshers[name]
	if r then
		r(true)
	end
end

function UI.closeWindow()
	window.Visible = false
end

function UI.windowOpen(): boolean
	return window.Visible
end

-- 내 몸이 지금 어디 있나
local function myPos(): Vector3?
	local char = player.Character
	local root = char and char:FindFirstChild("HumanoidRootPart")
	return (root and root:IsA("BasePart")) and root.Position or nil
end

-- 여기서 그곳까지 방향 (북 = -Z)과 거리
local DIRS = { "북", "북동", "동", "남동", "남", "남서", "서", "북서" }
local function bearing(from: Vector3, to: Vector3): (string, number)
	local d = Vector3.new(to.X - from.X, 0, to.Z - from.Z)
	local ang = math.deg(math.atan2(d.X, -d.Z)) % 360
	return DIRS[math.floor((ang + 22.5) / 45) % 8 + 1], d.Magnitude
end
UI.bearing = bearing

local function nearMaster(id: string): boolean
	local m = Config.MASTERS[id]
	local pos = myPos()
	if not m or not pos then
		return false
	end
	return Vector3.new(pos.X - m.at.X, 0, pos.Z - m.at.Z).Magnitude <= Config.MASTER_RANGE
end

local function buildStyles()
	local page = makePage("styles")
	local list = scroller(page, UDim2.new(0.4, -8, 1, 0))
	new("UIListLayout", { Padding = UDim.new(0, 6), Parent = list })
	local detail = new("Frame", { Position = UDim2.new(0.4, 4, 0, 0), Size = UDim2.new(0.6, -4, 1, 0), BackgroundColor3 = C.panel, Parent = page }, { corner(12), stroke(C.line, 1.5) })
	local dTitle = text({ Position = UDim2.new(0, 14, 0, 8), Size = UDim2.new(1, -28, 0, 36), TextSize = 28, Font = Enum.Font.GothamBlack, Parent = detail })
	local dHanja = text({ Position = UDim2.new(0, 14, 0, 44), Size = UDim2.new(1, -28, 0, 22), TextSize = 17, TextColor3 = C.dim, Parent = detail })
	local dMaster = text({ Position = UDim2.new(0, 14, 0, 68), Size = UDim2.new(1, -28, 0, 24), TextSize = 17, TextColor3 = C.gold, RichText = true, Parent = detail })
	local bodyScroll = scroller(detail, UDim2.new(1, -20, 1, -170), UDim2.new(0, 14, 0, 96))
	local dBody = text({ Size = UDim2.new(1, -12, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, TextSize = 17, RichText = true, TextYAlignment = Enum.TextYAlignment.Top, Parent = bodyScroll })
	local selected = Config.Styles[1].id
	local action = "learn"
	local dBtn = button({ AnchorPoint = Vector2.new(0, 1), Position = UDim2.new(0, 14, 1, -12), Size = UDim2.new(0.62, -20, 0, 56), TextSize = 21, BackgroundColor3 = C.red, Parent = detail }, function()
		if action == "learn" then
			Request:FireServer("learn", selected)
		elseif action == "break" then
			Request:FireServer("breakthrough", selected)
		elseif action == "awaken" then
			Request:FireServer("awaken", selected)
			window.Visible = false
		elseif action == "guide" then
			UI.setGuide(selected)
			window.Visible = false
		end
	end)
	local guideBtn = button({ AnchorPoint = Vector2.new(1, 1), Position = UDim2.new(1, -14, 1, -12), Size = UDim2.new(0.38, -14, 0, 56), Text = "📍 길 안내", TextSize = 20, BackgroundColor3 = C.panel2, Parent = detail }, function()
		if state and state.found and state.found[selected] then
			UI.setGuide(selected)
			window.Visible = false
		end
	end)
	local cards: { [string]: TextButton } = {}
	local function show(id: string)
		selected = id
		local s = Config.STYLE_BY_ID[id]
		local owned = state and table.find(state.styles, id) ~= nil
		local found = state and state.found and state.found[id]
		local passed = state and state.trials and state.trials[id]
		local ups = (state and state.gradeUp and state.gradeUp[id]) or 0
		local gradeNow = Config.styleGrade(s, ups)
		local gradeColor = Config.GRADE_COLOR[gradeNow] or C.dim
		local gradeTag = string.format('<font color="#%02X%02X%02X">[%s%s]</font>', math.floor(gradeColor.R * 255), math.floor(gradeColor.G * 255), math.floor(gradeColor.B * 255), gradeNow, ups > 0 and string.rep("⬆", ups) or "")
		for sid, card in pairs(cards) do
			local st = card:FindFirstChildOfClass("UIStroke")
			if st then
				st.Thickness = sid == id and 3 or 1
			end
		end
		guideBtn.Visible = found == true and not owned
		-- 숨은 권법은 얻기 전엔 이름도 모른다
		if s.hidden and not owned and not (s.secret and found) then
			dTitle.Text = "❓ 숨겨진 권법"
			dTitle.TextColor3 = C.dim
			dHanja.Text = "???"
			dMaster.Text = gradeTag .. "  전해지는 이야기만 남아 있다"
			dBody.Text = "🔒 " .. (s.unlockHint or "") .. (s.secret and "\n\n지도에 나오지 않는 숨은 사부가 있다." or "\n\n이 권법은 사부에게 배울 수 없다. 강호를 누비며 길을 찾아라.")
			dBtn.Text = "🔒 조건을 채워야 익힌다"
			dBtn.BackgroundColor3 = C.panel
			action = "none"
			return
		end
		dTitle.Text = s.icon .. " " .. s.name
		dTitle.TextColor3 = s.color
		dHanja.Text = s.hanja
		local master = Config.MASTERS[id]
		local pos = myPos()
		if master and not found and not owned then
			dMaster.Text = gradeTag .. '  <font color="#C8B8A0">❓ 사부의 행방을 모른다 · 소문: ' .. (master.rumor or "") .. "</font>"
		elseif master then
			local where = ""
			if pos then
				local dir, dist = bearing(pos, master.at)
				where = dist <= Config.MASTER_RANGE and "  ·  <b>바로 곁</b>" or string.format("  ·  %s쪽 %d칸", dir, math.floor(dist))
			end
			dMaster.Text = string.format("%s  📍 사부 %s · %s%s", gradeTag, master.name, master.region, where)
		else
			dMaster.Text = gradeTag .. (s.starter and "  청운 장로에게 받은 기본 권법" or "")
		end
		local lines = { s.desc, "", "<b>고유 장치</b>  " .. s.gimmick, "", "<b>연타 (클릭)</b>" }
		local names = {}
		for _, m in ipairs(s.combo) do
			table.insert(names, m.name)
		end
		table.insert(lines, table.concat(names, " → "))
		table.insert(lines, "<b>Z 강타</b>  " .. s.heavy.name)
		local m = state and state.mastery and state.mastery[id]
		local lv = m and m.lv or 0
		for _, slot in ipairs({ "E", "R", "G", "X" }) do
			local sk = s.skills[slot]
			if sk then
				local need = Config.SKILL_UNLOCK[slot]
				local lockTxt = lv >= need and "" or string.format(' <font color="#AA9988">(숙련 %d)</font>', need)
				local label = slot == "G" and "오의 G" or (slot == "X" and '<font color="#FF9AC8">초 오의 X</font>' or slot)
				table.insert(lines, string.format("<b>%s %s</b>%s  %s", label, sk.name, lockTxt, sk.desc))
			end
		end
		-- 3.1판: 극 권법의 황혼 (일월극변) 동안 바뀌는 기술
		if s.twilight then
			table.insert(lines, "")
			table.insert(lines, string.format('<font color="#FF9A5A"><b>🌇 황혼 (일월극변)</b></font>  극을 채우면 40초 동안 세상이 황혼에 멈추고 기술이 바뀐다. 연타·강타 ×%.1f', s.twilight.dmg or 1))
			table.insert(lines, string.format('<font color="#FF9A5A"><b>Z 강타</b></font>  %s', s.twilight.heavy.name))
			for _, slot in ipairs({ "E", "R", "G", "X" }) do
				local sk = s.twilight.skills[slot]
				if sk then
					table.insert(lines, string.format('<font color="#FF9A5A"><b>%s %s</b></font>  %s', slot == "G" and "오의 G" or (slot == "X" and "초 오의 X" or slot), sk.name, sk.desc))
				end
			end
		end
		-- 각성
		local A1, A2 = Config.AWAKEN[1], Config.AWAKEN[2]
		local function tag(need: number): string
			return lv >= need and ' <font color="#FFD25A">(열림)</font>' or string.format(' <font color="#AA9988">(숙련 %d)</font>', need)
		end
		table.insert(lines, "")
		table.insert(lines, string.format("<b>%s %s</b>%s  기술(Z·E·R·G) 피해 ×%.2f, 대기 -%d%%, 연타 다섯 번째 <b>%s</b> (상대를 하늘로 띄운다)", A1.mark, A1.name, tag(A1.lv), A1.dmg, math.floor((1 - A1.cd) * 100 + 0.5), s.finisher and s.finisher.name or ""))
		table.insert(lines, string.format("<b>%s %s</b>%s  모든 기술 ×%.2f, 대기 -%d%%, 그림자 메아리가 기술을 한 번 더 (절반 위력), 몸에 각성의 기운", A2.mark, A2.name, tag(A2.lv), A2.dmg, math.floor((1 - A2.cd) * 100 + 0.5)))
		if m then
			table.insert(lines, "")
			table.insert(lines, string.format("숙련도 %d / %d  (%d / %d)", m.lv, Config.MASTERY_MAX, math.floor(m.xp), m.need))
		end
		if master and not passed and not owned then
			table.insert(lines, "")
			local kind, need = Config.trialNeed(s.id)
			local K = Config.TRIAL_KINDS[kind]
			if K then
				table.insert(lines, string.format('<font color="#FFB070"><b>사부의 시험 · %s %s</b>  %s</font>', K.icon, K.title, string.format(K.ask, need)))
			else
				table.insert(lines, '<font color="#FFB070"><b>사부의 시험</b>  사부와 겨뤄 이겨야 제자로 받아 준다. 마구 휘두르면 막히고 되받아친다.</font>')
			end
		end
		if s.realmReq then
			table.insert(lines, "")
			table.insert(lines, string.format('<font color="#FFE8A0"><b>경지 제한</b>  %s에 올라야 사부가 시험을 허락한다</font>', Config.Realms[s.realmReq].name))
		end
		local req = s.styleReq and Config.STYLE_BY_ID[s.styleReq]
		if req then
			table.insert(lines, string.format('<font color="#FFE8A0"><b>먼저 익힐 권법</b>  %s</font>', req.name))
		end
		-- 2.5판: 초월 권법의 조건 (숙련 20 둘 + 천상 재료)
		local TR = Config.TRANSCEND_REQ[id]
		if TR and not owned then
			local function lvOf(sid: string): number
				local mm = state and state.mastery and state.mastery[sid]
				return (mm and table.find(state.styles or {}, sid)) and mm.lv or 0
			end
			local function mark(ok: boolean): string
				return ok and '<font color="#9CFF9C">✔</font>' or '<font color="#FF8A8A">✘</font>'
			end
			local base = Config.STYLE_BY_ID[TR.base]
			table.insert(lines, "")
			table.insert(lines, '<font color="#FFB6E6"><b>초월의 조건</b></font>')
			table.insert(lines, string.format("%s %s 숙련 %d (지금 %d)", mark(lvOf(TR.base) >= TR.lv), base and base.name or TR.base, TR.lv, lvOf(TR.base)))
			if TR.awakened == "any" then
				local best = 0
				for _, sd in ipairs(Config.Styles) do
					if sd.awakenOf then
						best = math.max(best, lvOf(sd.id))
					end
				end
				table.insert(lines, string.format("%s 각성 권법(진) 하나를 숙련 %d (가장 높은 것 %d)", mark(best >= TR.lv), TR.lv, best))
			elseif TR.awakened then
				local a = Config.STYLE_BY_ID[TR.awakened]
				table.insert(lines, string.format("%s %s 숙련 %d (지금 %d)", mark(lvOf(TR.awakened) >= TR.lv), a and a.name or TR.awakened, TR.lv, lvOf(TR.awakened)))
			end
			local mats = state and state.mats or {}
			for _, stage in ipairs({ { "시련을 청할 때", TR.challenge }, { "배울 때", TR.learn } }) do
				local parts = {}
				local all = true
				for mid, n in pairs(stage[2]) do
					local M = Config.SKY_MAT_BY_ID[mid]
					local have = mats[mid] or 0
					all = all and have >= n
					table.insert(parts, string.format("%s %s %d/%d", M.icon, M.name, have, n))
				end
				table.insert(lines, string.format("%s %s: %s", mark(all), stage[1], table.concat(parts, " · ")))
			end
			for mid in pairs(TR.learn) do
				local M = Config.SKY_MAT_BY_ID[mid]
				table.insert(lines, string.format('<font color="#C8B8A0">%s 얻는 곳: %s (천상계에서만)</font>', M.icon, M.how))
			end
		end
		-- 3.7판 사부의 부탁 (높은 권법은 시험 전에)
		local MQ = Config.MINIQUEST and Config.MINIQUEST[id]
		if MQ and not owned then
			local cur = (state and state.mq and state.mq[id]) or 0
			local got = (state and state.mqn and state.mqn[id]) or 0
			table.insert(lines, "")
			table.insert(lines, string.format('<font color="#B8E0FF"><b>📜 사부의 부탁 「%s」</b></font>', MQ.title))
			if cur == 0 then
				table.insert(lines, '<font color="#C8C8C8">사부를 찾아 말을 걸면 시험 전에 부탁을 한다</font>')
			end
			for i, stp in ipairs(MQ.steps) do
				local mark = (cur > i) and '<font color="#9CFF9C">✔</font>' or (cur == i and '<font color="#FFD27A">▶</font>' or '<font color="#8A8A8A">·</font>')
				local extra = ""
				if cur == i then
					local total = stp.kind == "find" and #stp.items or (stp.kind == "order" and #stp.stones or (stp.kind == "kill" and stp.n or 0))
					if total > 0 then
						extra = string.format(" (%d/%d)", got, total)
					end
				end
				table.insert(lines, string.format("%s %s%s%s", mark, (cur >= i) and stp.text or "???", extra, stp.night and " 🌙" or ""))
			end
		end
		-- 승급 (깨달음)
		if owned then
			local step = Config.BREAKTHROUGH[ups + 1]
			table.insert(lines, "")
			if step then
				table.insert(lines, string.format("<b>⬆ 권법 승급 (%s)</b>  숙련 %d · %s 이상 · 💰 %s → 피해 ×%.2f → ×%.2f", step.name, Config.MASTERY_FULL, Config.Realms[step.realm].name, Config.formatNumber(step.coins), Config.gradeMult(s, ups), Config.gradeMult(s, ups + 1)))
			else
				table.insert(lines, string.format("<b>⬆ 권법 승급</b>  모든 깨달음을 얻었다 [%s]", gradeNow))
			end
		end
		-- 각성 권법이 있는 권법: 각성 조건
		for _, sd in ipairs(Config.Styles) do
			if sd.awakenOf == id and owned then
				local A = Config.AWAKEN_STYLE
				table.insert(lines, "")
				table.insert(lines, string.format('<font color="#FF8A9A"><b>🔥 각성: %s</b>  숙련 %d · 깨달음 %d번 · %s 이상%s · 💰 %s → 각성 시련 (각성선인 곁에서)</font>', sd.name, Config.MASTERY_FULL, #Config.BREAKTHROUGH, Config.Realms[A.realm].name, sd.rebirthReq and string.format(" · ♻ 환생 %d번", sd.rebirthReq) or "", Config.formatNumber(A.coins)))
			end
		end
		dBody.Text = table.concat(lines, "\n")
		local cost = state and state.learnCost or 0
		local canBreak = owned and Config.BREAKTHROUGH[ups + 1] ~= nil and lv >= Config.MASTERY_FULL
		-- 각성 (진 권법): 깨달음을 모두 얻은 원래 권법에서
		local v2 = nil
		for _, sd in ipairs(Config.Styles) do
			if sd.awakenOf == id then
				v2 = sd
			end
		end
		local canAwaken = owned and v2 ~= nil and not (state and table.find(state.styles, v2.id)) and ups >= #Config.BREAKTHROUGH and lv >= Config.MASTERY_FULL
		if canAwaken and v2 then
			local A = Config.AWAKEN_STYLE
			dBtn.Text = string.format("🔥 각성 시련 → %s  💰 %s", v2.name, Config.formatNumber(A.coins))
			dBtn.BackgroundColor3 = (state and state.coins >= A.coins and state.realm >= A.realm) and Color3.fromRGB(200, 40, 60) or C.panel
			action = "awaken"
		elseif s.awakenOf and not owned then
			dBtn.Text = "🔥 원래 권법에서 각성한다"
			dBtn.BackgroundColor3 = C.panel
			action = "none"
		elseif canBreak then
			local step = Config.BREAKTHROUGH[ups + 1]
			dBtn.Text = string.format("⬆ 승급  💰 %s", Config.formatNumber(step.coins))
			dBtn.BackgroundColor3 = (state and state.coins >= step.coins and state.realm >= step.realm) and Color3.fromRGB(200, 150, 40) or C.panel
			action = "break"
		elseif state and state.style == id then
			dBtn.Text = "✔ 쓰는 중"
			dBtn.BackgroundColor3 = C.green
			action = "none"
		elseif owned then
			dBtn.Text = "이 권법으로 바꾸기"
			dBtn.BackgroundColor3 = C.panel2
			action = "learn"
		elseif not master then
			dBtn.Text = "청운 장로에게 받는다"
			dBtn.BackgroundColor3 = C.panel
			action = "none"
		elseif not found then
			dBtn.Text = "❓ 먼저 사부를 찾아라"
			dBtn.BackgroundColor3 = C.panel
			action = "none"
		elseif not passed then
			local near = nearMaster(id)
			dBtn.Text = near and "⚔ 시험 받기" or "사부에게 가서 시험 받기"
			dBtn.BackgroundColor3 = near and C.red or Color3.fromRGB(150, 110, 50)
			action = near and "learn" or "guide"
		elseif nearMaster(id) then
			dBtn.Text = string.format("배우기  💰 %s", Config.formatNumber(cost))
			dBtn.BackgroundColor3 = (state and state.coins >= cost) and C.red or C.panel
			action = "learn"
		else
			dBtn.Text = string.format("사부에게 가기 (💰 %s)", Config.formatNumber(cost))
			dBtn.BackgroundColor3 = Color3.fromRGB(150, 110, 50)
			action = "guide"
		end
	end
	for _, s in ipairs(Config.Styles) do
		local card = button({ Size = UDim2.new(1, -10, 0, 64), BackgroundColor3 = C.panel2, Text = "", Parent = list }, function()
			show(s.id)
		end)
		new("UIStroke", { Color = s.color, Thickness = 1, Parent = card })
		text({ Name = "Title", Position = UDim2.new(0, 10, 0, 4), Size = UDim2.new(1, -20, 0, 30), Text = s.hidden and "❓ 숨겨진 권법" or (s.icon .. " " .. s.name), TextSize = 20, Font = Enum.Font.GothamBlack, TextColor3 = s.hidden and C.dim or s.color, Parent = card })
		local sub = text({ Name = "Sub", Position = UDim2.new(0, 10, 0, 34), Size = UDim2.new(1, -20, 0, 24), TextSize = 15, TextColor3 = C.dim, Parent = card })
		sub.Text = s.hidden and "???" or s.hanja
		cards[s.id] = card
	end
	refreshers.styles = function(reset: boolean?)
		for id, card in pairs(cards) do
			local sub = card:FindFirstChild("Sub") :: TextLabel?
			if sub and state then
				local m = state.mastery and state.mastery[id]
				local s = Config.STYLE_BY_ID[id]
				local owned = table.find(state.styles, id) ~= nil
				local title = card:FindFirstChild("Title") :: TextLabel?
				local found = state.found and state.found[id]
				local ups = (state.gradeUp and state.gradeUp[id]) or 0
				if s.hidden and not owned and not (s.secret and found) then
					sub.Text = "[" .. s.grade .. "]  ???"
					if title then
						title.Text = "❓ 숨겨진 권법"
						title.TextColor3 = C.dim
					end
				else
					local mark = owned and "" or ((state.trials and state.trials[id]) and "  · 시험 통과" or ((state.found and state.found[id]) and "  · 사부 찾음" or (Config.MASTERS[id] and "  · ❓" or "")))
					sub.Text = "[" .. Config.styleGrade(s, ups) .. string.rep("⬆", ups) .. "] " .. s.hanja .. (m and string.format("  ·  숙련 %d", m.lv) or "") .. mark .. (state.style == id and "  ✔" or "")
					if title then
						title.Text = s.icon .. " " .. s.name
						title.TextColor3 = s.color
					end
				end
				sub.TextColor3 = Config.GRADE_COLOR[Config.styleGrade(s, ups)] or C.dim
			end
		end
		if reset then
			selected = pageOpt and pageOpt.style or (state and state.style ~= "" and state.style) or selected
		end
		show(selected)
	end
end

local function buildStats()
	local page = makePage("stats")
	local info = text({ Size = UDim2.new(1, 0, 1, 0), TextSize = 18, RichText = true, TextYAlignment = Enum.TextYAlignment.Top, Parent = page })
	-- 경지의 관문: 능력치가 닿으면 열린다 (수호자를 꺾어야 경지가 오른다)
	local gateBtn = button({ AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -8, 0, 4), Size = UDim2.new(0, 300, 0, 58), Text = "⛩ 관문 도전", TextSize = 20, BackgroundColor3 = Color3.fromRGB(170, 120, 40), Visible = false, ZIndex = 3, Parent = page }, function()
		Request:FireServer("gate")
		window.Visible = false
	end)
	-- 1.9판 환생: 열린 끝 경지에 오르면 보인다. 두 번 눌러야 한다 (실수로 누르지 않게)
	local rebirthArmed = 0
	local rebirthBtn: TextButton
	-- 3.1판: 환생은 천상 윤회대 제단에서 (이 단추는 윤회대로 데려다 준다)
	rebirthBtn = button({ AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -8, 0, 68), Size = UDim2.new(0, 300, 0, 58), Text = "☸ 윤회대로 가기", TextSize = 20, BackgroundColor3 = Color3.fromRGB(170, 60, 140), Visible = false, ZIndex = 3, Parent = page }, function()
		Request:FireServer("rebirth")
		window.Visible = false
	end)
	-- 2.9판: 윤회의 시련 (전생의 그림자) · 환생 특전
	local samsaraBtn = button({ AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -8, 0, 132), Size = UDim2.new(0, 300, 0, 58), Text = "☯ 윤회의 시련", TextSize = 20, BackgroundColor3 = Color3.fromRGB(80, 40, 120), Visible = false, ZIndex = 3, Parent = page }, function()
		Request:FireServer("samsara")
		window.Visible = false
	end)
	local perkPanel = Instance.new("Frame")
	perkPanel.Size = UDim2.new(1, 0, 1, 0)
	perkPanel.BackgroundColor3 = Color3.fromRGB(22, 16, 30)
	perkPanel.BackgroundTransparency = 0.04
	perkPanel.Visible = false
	perkPanel.ZIndex = 6
	perkPanel.Parent = page
	local perkHead = text({ Position = UDim2.new(0, 10, 0, 6), Size = UDim2.new(1, -340, 0, 60), TextSize = 18, RichText = true, ZIndex = 7, Parent = perkPanel })
	button({ AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -8, 0, 6), Size = UDim2.new(0, 150, 0, 48), Text = "↩ 모두 되돌리기", TextSize = 16, BackgroundColor3 = Color3.fromRGB(110, 60, 60), ZIndex = 7, Parent = perkPanel }, function()
		Request:FireServer("perkReset")
	end)
	button({ AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -166, 0, 6), Size = UDim2.new(0, 150, 0, 48), Text = "닫기", TextSize = 16, ZIndex = 7, Parent = perkPanel }, function()
		perkPanel.Visible = false
	end)
	local perkRows: { [string]: TextLabel } = {}
	local perkBtns: { [string]: TextButton } = {}
	for i, pk in ipairs(Config.PERKS) do
		local y = 74 + (i - 1) * 62
		perkRows[pk.id] = text({ Position = UDim2.new(0, 10, 0, y), Size = UDim2.new(1, -150, 0, 56), TextSize = 17, RichText = true, ZIndex = 7, Parent = perkPanel })
		perkBtns[pk.id] = button({ AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -8, 0, y + 4), Size = UDim2.new(0, 120, 0, 48), Text = "+ 1단계", TextSize = 17, BackgroundColor3 = Color3.fromRGB(150, 60, 130), ZIndex = 7, Parent = perkPanel }, function()
			Request:FireServer("perk", pk.id)
		end)
	end
	local perkBtn = button({ AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -8, 0, 196), Size = UDim2.new(0, 300, 0, 50), Text = "♻ 환생 특전", TextSize = 18, BackgroundColor3 = Color3.fromRGB(120, 50, 110), Visible = false, ZIndex = 3, Parent = page }, function()
		perkPanel.Visible = true
	end)
	refreshers.stats = function()
		if not state then
			return
		end
		do
			local rb0 = state.rebirth or 0
			local used = 0
			for _, lv in pairs(state.perks or {}) do
				used += lv
			end
			local total = Config.perkPoints(rb0, state.samsara or 0)
			perkBtn.Visible = rb0 > 0
			perkBtn.Text = string.format("♻ 환생 특전 (남은 공덕 %d)", total - used)
			if rb0 == 0 then
				perkPanel.Visible = false
			end
			perkHead.Text = string.format("<b>♻ 환생 특전</b>  공덕 <b>%d</b> / %d 남음\n<font color=\"#BBAACC\">환생 한 번에 공덕 %d · 윤회의 시련 하나에 공덕 1. 특전마다 %d단계. 되돌리면 공덕이 모두 돌아온다</font>", total - used, total, Config.PERK_PER_REBIRTH, Config.PERK_MAX)
			for _, pk in ipairs(Config.PERKS) do
				local lv = (state.perks and state.perks[pk.id]) or 0
				perkRows[pk.id].Text = string.format("%s <b>%s</b>  %s%s   %s +%d%%%s", pk.icon, pk.name, string.rep("●", lv), string.rep("○", Config.PERK_MAX - lv), pk.desc, math.floor(pk.per * lv * 100 + 0.5),
					lv < Config.PERK_MAX and string.format(' <font color="#BBAACC">(다음 +%d%%)</font>', math.floor(pk.per * (lv + 1) * 100 + 0.5)) or "")
				perkBtns[pk.id].Visible = lv < Config.PERK_MAX and used < total
			end
			samsaraBtn.Visible = state.samsaraNext ~= nil
			if state.samsaraNext then
				samsaraBtn.Text = string.format("☯ 윤회의 시련 %d (%s의 그림자)", state.samsaraNext, Config.REBIRTH.names[state.samsaraNext] or "")
			end
		end
		local rb = state.rebirth or 0
		local cap = state.realmCap or 16
		local canRebirth = rb < Config.REBIRTH.max and state.realm >= cap
		rebirthBtn.Visible = canRebirth
		if canRebirth and os.clock() - rebirthArmed > 4 then
			rebirthBtn.Text = string.format("☸ 윤회대로 가기 (%s · %d번째 환생)", Config.REBIRTH.names[rb + 1] or "환생", rb + 1)
		end
		gateBtn.Visible = state.gateNext ~= nil
		if state.gateNext then
			local r = Config.Realms[state.gateNext]
			gateBtn.Text = "⛩ " .. (r and r.name or "") .. "의 관문 도전"
		end
		local lines = {}
		local idx = state.realm
		local realm = Config.Realms[idx]
		local nextRealm = Config.Realms[idx + 1]
		local locked = nextRealm and (nextRealm.rebirth or 0) > rb
		table.insert(lines, string.format("<b>경지: %s%s</b>  (능력치 합 %s%s)", rb > 0 and ((Config.REBIRTH.names[rb] or "") .. " · ") or "", realm.name, Config.formatNumber(state.total),
			nextRealm and string.format(" / 다음 %s는 %s%s", nextRealm.name, Config.formatNumber(nextRealm.need), locked and ' <font color="#FF9AD8">(환생해야 열림)</font>' or "") or ""))
		table.insert(lines, string.format("경지 배율 ×%.2f (사경까지 경지마다 ×1.22, 그 위로는 ×1.38씩 겹으로, 수련 효과 +%d%%, 생사경부터는 그 경지 적 한 마리에 견줘 크게) · 경지는 스무 단계 (천외천 너머 넷은 환생해야 열린다)", Config.realmPower(idx), math.floor(Config.TRAIN_REALM_BONUS * 100)))
		if rb > 0 then
			table.insert(lines, string.format('<font color="#FF9AD8">♻ 환생 %d번: 체력 ×%.2f · 주는 피해 ×%.2f · 얻는 능력치 ×%.1f · %s까지 열림</font>', rb, Config.rebirthPower(rb), Config.rebirthDmg(rb), Config.rebirthGain(rb), Config.Realms[cap].name))
		end
		if canRebirth then
			table.insert(lines, string.format('<font color="#FF9AD8"><b>♻ 환생할 수 있다!</b> 천상 윤회대의 제단에서 T를 길게 누른다. 능력치를 모두 내려놓고 삼류로 돌아간다 (권법·숙련·심법·은자·관문은 그대로). 체력 ×%.2f · 주는 피해 ×%.2f, 얻는 능력치 ×%.1f, %s의 경지가 열린다</font>', Config.rebirthPower(rb + 1), Config.rebirthDmg(rb + 1), Config.rebirthGain(rb + 1), (Config.Realms[Config.realmCap(rb + 1)] or realm).name))
		elseif rb < Config.REBIRTH.max then
			table.insert(lines, string.format("♻ 환생: %s에 오르면 할 수 있다 (지금 %d / %d번)", Config.Realms[cap].name, rb, Config.REBIRTH.max))
		end
		if rb > 0 then
			local sa = state.samsara or 0
			local parts = {}
			for _, pk in ipairs(Config.PERKS) do
				local lv = (state.perks and state.perks[pk.id]) or 0
				if lv > 0 then
					table.insert(parts, string.format("%s%s +%d%%", pk.icon, pk.name, math.floor(pk.per * lv * 100 + 0.5)))
				end
			end
			table.insert(lines, string.format('<font color="#C9A0FF">☯ 윤회의 시련 %d / %d%s · 특전: %s</font>', sa, Config.REBIRTH.max,
				sa < rb and (state.samsaraNext and " (지금 도전할 수 있다)" or string.format(" (이번 삶에서 %s에 오르면 다음 시련)", Config.Realms[Config.SAMSARA.realm].name)) or (sa < Config.REBIRTH.max and " (환생하면 다음 시련)" or ""),
				#parts > 0 and table.concat(parts, " · ") or "아직 없음"))
		end
		if Config.GATE.enabled then
			table.insert(lines, string.format("⛩ %s부터는 능력치가 닿아도 <b>관문 수호자</b>를 꺾어야 경지가 오른다%s", Config.Realms[Config.GATE.from].name, state.gateNext and string.format(' <font color="#FFD25A">(지금 %s의 관문이 열려 있다 · 넘기 전에는 능력치가 더 오르지 않는다)</font>', Config.Realms[state.gateNext].name) or ""))
		end
		table.insert(lines, "")
		for _, s in ipairs(Config.Stats) do
			local v = state.stats[s.id] or 0
			table.insert(lines, string.format("%s <b>%s %s</b>  — %s ×%.2f", s.icon, s.name, Config.formatNumber(v), s.desc, Config.statMult(v)))
		end
		table.insert(lines, "")
		table.insert(lines, "<b>수련하는 곳</b>")
		for _, t in pairs(Config.Training) do
			local stat = nil
			for _, s in ipairs(Config.Stats) do
				if s.id == t.stat then
					stat = s
				end
			end
			local need = t.realm and t.realm > 1 and string.format(' <font color="#FFD25A">[%s부터]</font>', Config.Realms[t.realm].name) or ""
			table.insert(lines, string.format("%s %s%s → %s  (%s)", t.icon, t.name, need, t.fight and "모든 능력치" or ((stat and stat.icon or "") .. " " .. (stat and stat.name or "")), t.desc))
		end
		table.insert(lines, "")
		table.insert(lines, string.format("💰 은자 %s   ⚔ 쓰러뜨린 적 %d   ⚔ 배틀 처치 %d   🧪 금창약 %d", Config.formatNumber(state.coins), state.kills, state.pvpWins, state.potions))
		if state.elixirLeft > 0 then
			table.insert(lines, string.format("💊 소환단: %d초 남음 (수련 2배)", state.elixirLeft))
		end
		info.Text = table.concat(lines, "\n")
	end
end

------------------------------------------------------------------------
-- 1.9판: 업적과 칭호
------------------------------------------------------------------------
local function buildAch()
	local page = makePage("ach")
	local head = text({ Size = UDim2.new(1, -330, 0, 52), TextSize = 17, RichText = true, Parent = page })
	button({ AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -8, 0, 4), Size = UDim2.new(0, 150, 0, 44), Text = "칭호 떼기", TextSize = 16, Parent = page }, function()
		Request:FireServer("title", "")
	end)
	local list = scroller(page, UDim2.new(1, 0, 1, -60), UDim2.new(0, 0, 0, 60))
	new("UIListLayout", { Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder, Parent = list })
	local rows: { [string]: any } = {}
	for i, a in ipairs(Config.ACHIEVEMENTS) do
		local card = new("Frame", { Size = UDim2.new(1, -12, 0, 64), BackgroundColor3 = C.panel, LayoutOrder = i, Parent = list }, { corner(10) })
		local st = stroke(C.line, 1.5)
		st.Parent = card
		text({ Position = UDim2.new(0, 8, 0, 0), Size = UDim2.new(0, 50, 1, 0), Text = a.icon, TextSize = 30, TextXAlignment = Enum.TextXAlignment.Center, Parent = card })
		local name = text({ Position = UDim2.new(0, 64, 0, 6), Size = UDim2.new(1, -260, 0, 24), Text = a.name, TextSize = 19, Font = Enum.Font.GothamBlack, RichText = true, Parent = card })
		local rewards = {}
		if a.coins then
			table.insert(rewards, "💰 " .. Config.formatNumber(a.coins))
		end
		if a.gems then
			table.insert(rewards, "💎 " .. Config.formatNumber(a.gems))
		end
		if a.scrolls then
			table.insert(rewards, "📜 " .. a.scrolls)
		end
		if a.title then
			table.insert(rewards, "칭호 「" .. a.title .. "」")
		end
		local sub = text({ Position = UDim2.new(0, 64, 0, 32), Size = UDim2.new(1, -260, 0, 26), Text = a.desc .. "   ·   " .. table.concat(rewards, "  "), TextSize = 14, TextColor3 = C.dim, Parent = card })
		local bar = new("Frame", { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -12, 0.5, 0), Size = UDim2.new(0, 170, 0, 30), BackgroundColor3 = Color3.fromRGB(25, 18, 16), Parent = card }, { corner(8) })
		local fill = new("Frame", { Size = UDim2.fromScale(0, 1), BackgroundColor3 = C.green, Parent = bar }, { corner(8) })
		local label = text({ Size = UDim2.fromScale(1, 1), TextSize = 14, TextXAlignment = Enum.TextXAlignment.Center, ZIndex = 2, Parent = bar })
		local equip = button({ Size = UDim2.fromScale(1, 1), Text = "", BackgroundTransparency = 1, ZIndex = 3, Visible = false, Parent = bar }, function()
			Request:FireServer("title", a.id)
		end)
		rows[a.id] = { card = card, stroke = st, name = name, sub = sub, fill = fill, label = label, equip = equip }
	end
	refreshers.ach = function()
		if not state then
			return
		end
		local done, total = 0, #Config.ACHIEVEMENTS
		local ach = state.ach or {}
		local prog = state.achProg or {}
		for _, a in ipairs(Config.ACHIEVEMENTS) do
			local r = rows[a.id]
			local ok = ach[a.id] == true
			if ok then
				done += 1
			end
			local v = prog[a.id] or 0
			r.fill.Size = UDim2.fromScale(ok and 1 or math.clamp(v / a.n, 0, 1), 1)
			r.fill.BackgroundColor3 = ok and C.gold or C.green
			local col = Config.ACH_COLOR[a.kind] or C.gold
			r.stroke.Color = ok and col or C.line
			r.card.BackgroundColor3 = ok and Color3.fromRGB(56, 40, 26) or C.panel
			r.name.TextColor3 = ok and col or C.text
			local wearing = state.title == a.id
			if ok and a.title then
				r.label.Text = wearing and "✔ 달고 있음" or "칭호 달기"
				r.fill.BackgroundColor3 = wearing and C.green or C.gold
				r.equip.Visible = not wearing
			else
				r.label.Text = ok and "✔ 이룸" or string.format("%s / %s", Config.formatNumber(v), Config.formatNumber(a.n))
				r.equip.Visible = false
			end
		end
		local t = state.title and Config.ACH_BY_ID[state.title]
		head.Text = string.format("<b>이룬 업적 %d / %d</b>\n칭호: %s", done, total, t and ("「" .. t.title .. "」") or "없음 (칭호가 붙은 업적을 이루면 달 수 있다)")
	end
end

local function buildShop()
	local page = makePage("shop")
	local list = scroller(page, UDim2.fromScale(1, 1))
	new("UIListLayout", { Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder, Parent = list })
	-- 💎 로벅스 상품: 금빛 카드 (큰 그림, 이름표, 좋은 점 세 줄, 값)
	local premiumBtns: { [string]: TextButton } = {}
	-- 자동 수련 카드: 켜기·끄기 + 올릴 능력치 고르기 (가진 카드에만 보인다)
	local autoBtns: { [string]: { toggle: TextButton, stat: TextButton } } = {}
	text({ Size = UDim2.new(1, -12, 0, 26), Text = "💎 로벅스 상품", TextSize = 20, Font = Enum.Font.GothamBlack, TextColor3 = C.gold, LayoutOrder = 0, Parent = list })
	for i, it in ipairs(Config.Premium) do
		local card = new("Frame", { Size = UDim2.new(1, -12, 0, 150), BackgroundColor3 = it.best and Color3.fromRGB(50, 26, 80) or (it.toggle and Color3.fromRGB(20, 50, 70) or Color3.fromRGB(70, 24, 14)), LayoutOrder = i, Parent = list }, { corner(14), stroke(Color3.fromRGB(255, 200, 90), 2) })
		new("UIGradient", { Rotation = 20, Color = ColorSequence.new(Color3.fromRGB(255, 255, 255), Color3.fromRGB(150, 120, 90)), Parent = card })
		local badge = new("Frame", { Position = UDim2.new(0, 14, 0.5, -55), Size = UDim2.new(0, 110, 0, 110), BackgroundColor3 = Color3.fromRGB(30, 20, 10), Parent = card }, { corner(16), stroke(Color3.fromRGB(255, 220, 120), 2) })
		new("UIGradient", { Rotation = 90, Color = ColorSequence.new(Color3.fromRGB(255, 220, 120), Color3.fromRGB(120, 70, 20)), Transparency = NumberSequence.new(0.55, 0.85), Parent = badge })
		text({ Size = UDim2.fromScale(1, 1), Text = it.icon, TextSize = 64, TextXAlignment = Enum.TextXAlignment.Center, Parent = badge })
		text({ Position = UDim2.new(0, 138, 0, 10), Size = UDim2.new(1, -330, 0, 32), Text = it.name, TextSize = 26, Font = Enum.Font.GothamBlack, TextColor3 = Color3.fromRGB(255, 225, 140), Parent = card })
		local chip = new("Frame", { Position = UDim2.new(0, 138, 0, 44), Size = UDim2.new(0, 70, 0, 22), BackgroundColor3 = it.best and Color3.fromRGB(150, 90, 230) or (it.toggle and Color3.fromRGB(40, 140, 200) or Color3.fromRGB(200, 70, 40)), Parent = card }, { corner(11) })
		text({ Size = UDim2.fromScale(1, 1), Text = it.tag, TextSize = 13, Font = Enum.Font.GothamBlack, TextXAlignment = Enum.TextXAlignment.Center, Parent = chip })
		text({ Position = UDim2.new(0, 138, 0, 72), Size = UDim2.new(1, -330, 0, 72), Text = "✦ " .. table.concat(it.lines, "\n✦ "), TextSize = 14, TextColor3 = Color3.fromRGB(240, 225, 200), TextYAlignment = Enum.TextYAlignment.Top, Parent = card })
		premiumBtns[it.id] = button({ AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -14, 0, 20), Size = UDim2.new(0, 170, 0, 52), Text = "R$ " .. tostring(it.price) .. "  구매", TextSize = 20, BackgroundColor3 = Color3.fromRGB(40, 170, 80), Parent = card }, function()
			Request:FireServer("premiumBuy", it.id)
		end)
		if it.toggle then
			local tg = button({ AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -14, 0, 80), Size = UDim2.new(0, 82, 0, 40), Text = "켜기", TextSize = 16, BackgroundColor3 = C.panel2, Visible = false, Parent = card }, function()
				Request:FireServer("autoToggle")
			end)
			local sb = button({ AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -102, 0, 80), Size = UDim2.new(0, 82, 0, 40), Text = "골고루", TextSize = 15, BackgroundColor3 = C.panel2, Visible = false, Parent = card }, function()
				Request:FireServer("autoStat")
			end)
			autoBtns[it.id] = { toggle = tg, stat = sb }
		end
	end
	-- 🐎 탈것: V로 타고 내린다
	text({ Size = UDim2.new(1, -12, 0, 26), Text = "🐎 탈것 (V로 타기·내리기)", TextSize = 20, Font = Enum.Font.GothamBlack, TextColor3 = C.gold, LayoutOrder = 10, Parent = list })
	local mountBtns: { [string]: TextButton } = {}
	for k, m in ipairs(Config.MOUNTS) do
		local row = new("Frame", { Size = UDim2.new(1, -12, 0, 64), BackgroundColor3 = C.panel2, LayoutOrder = 10 + k, Parent = list }, { corner(10), stroke(C.line, 1) })
		text({ Position = UDim2.new(0, 14, 0, 4), Size = UDim2.new(1, -200, 0, 28), Text = string.format("%s %s  ·  빠르기 ×%.2f", m.icon, m.name, m.speed), TextSize = 19, Font = Enum.Font.GothamBlack, Parent = row })
		text({ Position = UDim2.new(0, 14, 0, 34), Size = UDim2.new(1, -200, 0, 24), Text = m.desc, TextSize = 14, TextColor3 = C.dim, Parent = row })
		mountBtns[m.id] = button({ AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -12, 0.5, 0), Size = UDim2.new(0, 160, 0, 44), Text = "", TextSize = 17, Parent = row }, function()
			local owned = state and ((state.mounts and state.mounts[m.id]) or (m.premium and state.premium and state.premium[m.premium]))
			Request:FireServer(owned and "mountSelect" or "mountBuy", m.id)
		end)
	end
	text({ Size = UDim2.new(1, -12, 0, 26), Text = "💰 은자로 사는 것", TextSize = 20, Font = Enum.Font.GothamBlack, TextColor3 = C.gold, LayoutOrder = 20, Parent = list })
	local labels = {}
	for k, item in ipairs(Config.Shop) do
		local row = new("Frame", { Size = UDim2.new(1, -12, 0, 70), BackgroundColor3 = C.panel2, LayoutOrder = 20 + k, Parent = list }, { corner(10), stroke(C.line, 1) })
		text({ Position = UDim2.new(0, 14, 0, 6), Size = UDim2.new(1, -200, 0, 28), Text = item.icon .. " " .. item.name, TextSize = 20, Font = Enum.Font.GothamBlack, Parent = row })
		text({ Position = UDim2.new(0, 14, 0, 36), Size = UDim2.new(1, -200, 0, 26), Text = item.desc, TextSize = 14, TextColor3 = C.dim, Parent = row })
		labels[item.id] = button({ AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -12, 0.5, 0), Size = UDim2.new(0, 160, 0, 46), Text = "💰 " .. Config.formatNumber(item.cost), TextSize = 18, BackgroundColor3 = C.red, Parent = row }, function()
			Request:FireServer("buy", item.id)
		end)
	end
	refreshers.shop = function()
		for _, m in ipairs(Config.MOUNTS) do
			local b = mountBtns[m.id]
			local owned = state and ((state.mounts and state.mounts[m.id]) or (m.premium and state.premium and state.premium[m.premium]))
			local sel = state and state.mountSel == m.id
			local price = m.premium and ("R$ " .. tostring(Config.PREMIUM_BY_ID[m.premium].price)) or ("💰 " .. Config.formatNumber(m.cost))
			b.Text = sel and "✅ 고름" or (owned and "고르기" or price)
			b.BackgroundColor3 = sel and Color3.fromRGB(60, 120, 70) or (owned and C.panel or ((state and state.coins >= m.cost) and C.red or C.panel))
		end
		for _, item in ipairs(Config.Shop) do
			local can = state and state.coins >= item.cost
			labels[item.id].BackgroundColor3 = can and C.red or C.panel
		end
		local owned = state and state.premium or {}
		for id, b in pairs(premiumBtns) do
			local has = owned[id] == true
			b.Text = has and "✅ 가지고 있음" or ("R$ " .. tostring(Config.PREMIUM_BY_ID[id].price) .. "  구매")
			b.BackgroundColor3 = has and Color3.fromRGB(60, 70, 60) or Color3.fromRGB(40, 170, 80)
			b.AutoButtonColor = not has
		end
		local statLabel = { all = "골고루", str = "💪 근골", vit = "❤ 체력", agi = "🍃 경공", chi = "🌀 내공" }
		for id, ab in pairs(autoBtns) do
			local has = owned[id] == true
			local on = state and state.autoOn == true
			ab.toggle.Visible = has
			ab.stat.Visible = false -- 자동 수련은 지금 하는 수련을 대신 누른다 (능력치 고르기 없음)
			ab.toggle.Text = on and "🟢 켜짐" or "⚪ 꺼짐"
			ab.toggle.BackgroundColor3 = on and Color3.fromRGB(40, 140, 70) or C.panel2
			ab.stat.Text = statLabel[state and state.autoStat or "all"] or "골고루"
		end
	end
end

------------------------------------------------------------------------
-- 심법 (내공 수련서): 뽑기, 세 칸에 끼우기
------------------------------------------------------------------------
local function hex(c: Color3): string
	return string.format("#%02X%02X%02X", math.floor(c.R * 255), math.floor(c.G * 255), math.floor(c.B * 255))
end
local function manualLine(id: string, r: number): string
	local m = Config.MANUAL_BY_ID[id]
	local R = Config.MANUAL_RARITY[r]
	if not m or not R then
		return ""
	end
	return string.format('%s <font color="%s"><b>[%s] %s</b></font>  %s %.1f%%', m.icon, hex(R.color), R.name, m.name, m.desc, Config.manualValue(id, r) * 100)
end
local manualAuto = false
local manualAutoBtn: TextButton? = nil
local manualAutoTotal: { number } = {}
local function canDraw10(): boolean
	if not state then
		return false
	end
	local sc = state.scrolls or 0
	return sc >= 10 or (state.coins or 0) >= (10 - sc) * Config.MANUAL_DRAW.coins
end
function UI.setManualAuto(on: boolean)
	if on and not canDraw10() then
		UI.toast("자동 뽑기: 두루마리나 은자가 모자라요")
		on = false
	end
	if on == manualAuto then
		return
	end
	manualAuto = on
	local b = manualAutoBtn
	if b then
		b.Text = on and "🔁 자동: 켜짐" or "🔁 자동: 꺼짐"
		b.BackgroundColor3 = on and Color3.fromRGB(60, 140, 80) or C.panel2
	end
	if not on then
		-- 끝날 때 모아서 한 줄로
		local parts = {}
		for i = #Config.MANUAL_RARITY, 1, -1 do
			local c = manualAutoTotal[i] or 0
			if c > 0 then
				table.insert(parts, Config.MANUAL_RARITY[i].name .. " " .. c)
			end
		end
		if #parts > 0 then
			UI.toast("🔁 자동 뽑기 끝: " .. table.concat(parts, " · "))
		end
		manualAutoTotal = {}
		return
	end
	task.spawn(function()
		while manualAuto do
			if not canDraw10() then
				UI.setManualAuto(false)
				break
			end
			Request:FireServer("manualDraw", 10, true)
			task.wait(1.1)
		end
	end)
end
-- 자동 뽑기 한 번(10번)의 결과: 좋은 것이 나오면 크게, 아니면 짧게
function UI.manualAutoResult(data: any)
	if data.stop then
		UI.setManualAuto(false)
		return
	end
	for i, c in ipairs(data.counts or {}) do
		manualAutoTotal[i] = (manualAutoTotal[i] or 0) + c
	end
	local best = data.best or 1
	local R = Config.MANUAL_RARITY[best]
	if R and best >= 4 then
		UI.toast(string.format("🔁 자동 뽑기: [%s] 등장! (새로 얻거나 오른 심법 %d)", R.name, data.ups or 0))
	end
end
local function buildManuals()
	local page = makePage("manuals")
	local D = Config.MANUAL_DRAW
	local head = text({ Size = UDim2.new(1, -440, 0, 52), TextSize = 16, RichText = true, TextYAlignment = Enum.TextYAlignment.Top, Parent = page })
	button({ AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -292, 0, 0), Size = UDim2.new(0, 136, 0, 48), Text = "📜 1번 뽑기", TextSize = 17, BackgroundColor3 = Color3.fromRGB(150, 100, 40) }, function()
		Request:FireServer("manualDraw", 1)
	end).Parent = page
	button({ AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -148, 0, 0), Size = UDim2.new(0, 136, 0, 48), Text = "📜 10번 뽑기", TextSize = 17, BackgroundColor3 = Color3.fromRGB(190, 120, 30) }, function()
		Request:FireServer("manualDraw", 10)
	end).Parent = page
	-- 2.6판: 자동 뽑기 (켜 두면 두루마리·은자가 남는 동안 10번씩 연출 없이 뽑는다)
	local autoBtn: TextButton
	autoBtn = button({ AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -4, 0, 0), Size = UDim2.new(0, 136, 0, 48), Text = "🔁 자동: 꺼짐", TextSize = 17, BackgroundColor3 = C.panel2 }, function()
		UI.setManualAuto(not manualAuto)
	end)
	autoBtn.Parent = page
	manualAutoBtn = autoBtn
	-- 끼운 세 칸
	local slotRow = new("Frame", { Position = UDim2.new(0, 0, 0, 58), Size = UDim2.new(1, 0, 0, 74), BackgroundTransparency = 1, Parent = page })
	new("UIGridLayout", { CellSize = UDim2.new(0.333, -8, 1, 0), CellPadding = UDim2.new(0, 8, 0, 0), Parent = slotRow })
	local slots = {}
	for i = 1, D.slots do
		local card = new("Frame", { BackgroundColor3 = C.panel2, Parent = slotRow }, { corner(10), stroke(C.line, 1.5) })
		local l = text({ Position = UDim2.new(0, 10, 0, 4), Size = UDim2.new(1, -20, 1, -8), TextSize = 15, RichText = true, Text = "", Parent = card })
		local b = button({ AnchorPoint = Vector2.new(1, 1), Position = UDim2.new(1, -6, 1, -6), Size = UDim2.new(0, 60, 0, 26), Text = "빼기", TextSize = 13, BackgroundColor3 = C.panel, Parent = card }, function()
			local id = state and state.equip and state.equip[i]
			if id then
				Request:FireServer("manualUnequip", id)
			end
		end)
		slots[i] = { card = card, label = l, btn = b }
	end
	local list = scroller(page, UDim2.new(1, 0, 1, -172), UDim2.new(0, 0, 0, 142))
	new("UIListLayout", { Padding = UDim.new(0, 6), Parent = list })
	local rows = {}
	for _, m in ipairs(Config.MANUALS) do
		local row = new("Frame", { Size = UDim2.new(1, -12, 0, 44), BackgroundColor3 = C.panel, Parent = list }, { corner(8), stroke(C.line, 1) })
		local l = text({ Position = UDim2.new(0, 12, 0, 0), Size = UDim2.new(1, -130, 1, 0), TextSize = 15, RichText = true, Parent = row })
		local b = button({ AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -8, 0.5, 0), Size = UDim2.new(0, 100, 0, 32), Text = "끼우기", TextSize = 14, Parent = row }, function()
			if not state or not state.manuals or not state.manuals[m.id] then
				return
			end
			Request:FireServer(table.find(state.equip or {}, m.id) and "manualUnequip" or "manualEquip", m.id)
		end)
		rows[m.id] = { label = l, btn = b }
	end
	local rates = {}
	for _, R in ipairs(Config.MANUAL_RARITY) do
		table.insert(rates, string.format('<font color="%s">%s %g%%</font>', hex(R.color), R.name, R.rate * 100))
	end
	text({ AnchorPoint = Vector2.new(0, 1), Position = UDim2.new(0, 0, 1, 0), Size = UDim2.new(1, 0, 0, 22), TextSize = 13, RichText = true, TextColor3 = C.dim, Text = "확률: " .. table.concat(rates, " · ") .. string.format("  ·  %d번 안에 전설 이상이 한 번은 나온다", D.pity), Parent = page })
	refreshers.manuals = function()
		if not state then
			return
		end
		head.Text = string.format("📜 두루마리 <b>%d</b>개\n<font color=\"#FFD25A\">전설 보장까지 %d번</font>  <font color=\"#C8B9A5\">(두루마리가 없으면 한 번에 💰 %s)</font>", state.scrolls or 0, math.max(1, D.pity - (state.pity or 0)), Config.formatNumber(D.coins))
		local equip = state.equip or {}
		for i, sl in ipairs(slots) do
			local id = equip[i]
			local r = id and state.manuals and state.manuals[id]
			sl.label.Text = (id and r) and (string.format("<b>%d칸</b>\n", i) .. manualLine(id, r)) or string.format('<b>%d칸</b>\n<font color="#9A8C7A">비어 있음 (아래에서 끼우기)</font>', i)
			sl.btn.Visible = id ~= nil
		end
		for _, m in ipairs(Config.MANUALS) do
			local row = rows[m.id]
			local r = state.manuals and state.manuals[m.id]
			if r then
				row.label.Text = manualLine(m.id, r)
				local on = table.find(equip, m.id) ~= nil
				row.btn.Visible = true
				row.btn.Text = on and "✅ 빼기" or "끼우기"
				row.btn.BackgroundColor3 = on and Color3.fromRGB(60, 120, 70) or C.panel2
			else
				row.label.Text = string.format('<font color="#8A7C6A">%s %s · %s (아직 없음)</font>', m.icon, m.name, m.desc)
				row.btn.Visible = false
			end
		end
	end
end

-- 뽑기 결과: 연출 (두루마리가 터지고 카드가 뒤집힌다) 뒤에 심법 창으로
local Gacha: any = nil
function UI.manualReveal(results: { any })
	Gacha = Gacha or require(script.Parent:WaitForChild("Gacha"))
	window.Visible = false
	Gacha.play(results, function()
		UI.openPage("manuals")
	end)
end


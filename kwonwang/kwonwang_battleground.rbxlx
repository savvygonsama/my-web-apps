end

------------------------------------------------------------------------
-- 들어오고 나가기
------------------------------------------------------------------------
------------------------------------------------------------------------
-- 로벅스 상품 (게임패스)
------------------------------------------------------------------------
Premium = {}
local Marketplace: any = nil
pcall(function()
	Marketplace = game:GetService("MarketplaceService")
end)

function Premium.owns(player: Player, id: string): boolean
	local st = states[player]
	return st ~= nil and st.owned ~= nil and st.owned[id] == true
end

function Premium.grant(player: Player, id: string)
	local st = states[player]
	if not st then
		return
	end
	st.owned = st.owned or {}
	st.owned[id] = true
	-- 자동 수련을 처음 얻으면 바로 켠다
	local p = profiles[player]
	if p and (id == "autoTrain" or id == "autoTrain2") and p.autoOn == nil then
		p.autoOn = true
	end
	-- 청룡을 사면 바로 고른다
	if p and id == "dragon" then
		p.mountSel = "dragon"
		toast(player, "🐉 청룡을 얻었어요! V로 타기")
	end
	pushState(player)
end

-- 들어올 때 가진 게임패스를 확인한다
function Premium.load(player: Player)
	if not Marketplace then
		return
	end
	for _, it in ipairs(Config.Premium) do
		if it.gamepass > 0 then
			local ok, has = pcall(function()
				return Marketplace:UserOwnsGamePassAsync(player.UserId, it.gamepass)
			end)
			if ok and has then
				Premium.grant(player, it.id)
			end
		end
	end
end

function Premium.prompt(player: Player, id: string)
	local it = Config.PREMIUM_BY_ID[id]
	if not it then
		return
	end
	if Premium.owns(player, id) then
		toast(player, "이미 가지고 있어요")
		return
	end
	if it.gamepass <= 0 or not Marketplace then
		toast(player, "아직 판매 준비 중이에요 (이 서버의 판에는 게임패스 번호가 없어요)")
		return
	end
	pcall(function()
		Marketplace:PromptGamePassPurchase(player, it.gamepass)
	end)
end

if Marketplace then
	pcall(function()
		Marketplace.PromptGamePassPurchaseFinished:Connect(function(player: Player, passId: number, bought: boolean)
			if not bought then
				return
			end
			for _, it in ipairs(Config.Premium) do
				if it.gamepass == passId then
					Premium.grant(player, it.id)
					toast(player, "💎 " .. it.name .. "을(를) 얻었어요! 고마워요")
					Push:FireClient(player, "premium", { id = it.id })
				end
			end
		end)
	end)
end

-- 자동 수련: 수련 화면 안에서만. 박자가 돌아올 때마다 대신 눌러 준다 (보통 '좋음', 고급 '완벽').
-- 사람이 박자를 맞춰 누르는 것보다 빠르지 않다 (손이 편해질 뿐, 더 세지지 않는다)
task.spawn(function()
	while true do
		task.wait(0.2)
		local now = os.clock()
		for player, st in pairs(states) do
			local p = profiles[player]
			local tr = st.training
			if p and p.autoOn and tr and tr.kind ~= "simma" then
				local adv = Premium.owns(player, "autoTrain2")
				if adv or Premium.owns(player, "autoTrain") then
					local info = Config.Training[tr.kind]
					local period = (info and info.period) or Config.TRAIN_JUDGE.period
					if tr.hard then
						period = Config.HARD_TRAIN.period
					end
					if now >= ((st.autoAt or 0) :: number) then
						st.autoAt = now + period
						Train.hit(player, adv and "perfect" or "good", nil)
					end
				end
			end
		end
	end
end)

local function setupCharacter(player: Player, char: Model)
	local hum = char:WaitForChild("Humanoid", 10)
	local root = char:WaitForChild("HumanoidRootPart", 10)
	if not hum or not root or not hum:IsA("Humanoid") then
		return
	end
	hum.BreakJointsOnDeath = false
	hum.MaxHealth = 1e9
	hum.Health = 1e9
	hum.JumpPower = 55
	hum.UseJumpPower = true
	local p = profiles[player]
	if not p then
		return
	end
	local f = Combat.register(char, { player = player, name = player.DisplayName, hp = Config.maxHp(p.stats.vit), style = p.style })
	if TEST_INF[player] then
		char:SetAttribute("TestInf", true)
	end
	char:SetAttribute("PvpOff", p.pvpOff == true)
	f.iframeUntil = os.clock() + 2
	refreshFighter(player)
	if BATTLE then
		f.hp = f.maxHp
		Battle.onCharacter(player, char)
		task.defer(function()
			if char.Parent then
				char:PivotTo(Battle.spawnCF(player))
				Battle.shield(f)
				Combat.sync(f)
			end
		end)
	end
	char.AncestryChanged:Connect(function()
		if not char.Parent then
			Combat.unregister(char)
		end
	end)
	local st = states[player]
	if st then
		st.training = nil
	end
end

local function onPlayerAdded(player: Player)
	local st: State = { canSave = false, dirty = false, tester = false, reqWindow = 0, reqCount = 0, training = nil, trainAt = 0, ringIdx = 1, potionAt = 0 }
	states[player] = st
	local ls = Instance.new("Folder")
	ls.Name = "leaderstats"
	local realmValue = Instance.new("StringValue")
	realmValue.Name = "경지"
	realmValue.Value = "삼류"
	realmValue.Parent = ls
	local coinValue = Instance.new("StringValue")
	coinValue.Name = "은자"
	coinValue.Value = "0"
	coinValue.Parent = ls
	ls.Parent = player
	local profile, ok
	if isTester(player) then
		profile, ok = defaultProfile(), false
		st.tester = true
	else
		profile, ok = loadProfile(player)
	end
	if not player.Parent then
		return
	end
	-- 누구나 삼재권 하나는 몸에 지니고 시작한다
	if not profile.styles.samjae then
		profile.styles.samjae = true
	end
	if profile.style == "" then
		profile.style = "samjae"
	end
	if BATTLE then
		-- 배틀그라운드: 메인 월드 기록은 읽기만 (여기서는 절대 저장하지 않는다). 익힌 권법은 모두 숙련 끝까지 연 것으로
		ok = false
		for id in pairs(profile.styles) do
			local m = Calc.mastery(profile, id)
			m.lv = math.max(m.lv, 20)
		end
		Battle.join(player)
	end
	profiles[player] = profile
	st.canSave = ok
	if not BATTLE and ok then
		-- 배틀그라운드에서 쌓은 기록을 받는다: 쓰러뜨린 수 (무쌍신권), 은자
		task.spawn(function()
			local kills, coins = Battle.claim(player)
			local p = profiles[player]
			if not p then
				return
			end
			if kills > p.pvpWins then
				p.pvpWins = kills
				st.dirty = true
			end
			if coins > 0 then
				p.coins += coins
				st.dirty = true
				toast(player, string.format("⚔ 배틀그라운드 몫 💰 %s 은자를 받았어요", Config.formatNumber(coins)))
			end
			local PS = Config.PVP_STYLE
			if p.pvpWins >= PS.wins and not p.styles[PS.style] then
				grantStyle(player, PS.style, false)
				toast(player, "⚔ 배틀그라운드에서 " .. PS.wins .. "명을 쓰러뜨렸다! " .. Config.STYLE_BY_ID[PS.style].name .. "을(를) 얻었어요")
			end
			pushState(player)
		end)
	end
	player.CharacterAdded:Connect(function(char)
		setupCharacter(player, char)
	end)
	if player.Character then
		task.spawn(setupCharacter, player, player.Character)
	end
	pushState(player)
	task.spawn(Premium.load, player)
end

local function onPlayerRemoving(player: Player)
	if BATTLE then
		Battle.leave(player)
	end
	Tower.ended(player, "left")
	Maze.ended(player, "left")
	-- 시험 중에 나가면 시험의 상대를 거둔다 (쓰러지지 않는 사부가 남지 않게)
	pcall(Trial.ended, player, false)
	saveProfile(player)
	profiles[player] = nil
	states[player] = nil
	TEST_INF[player] = nil
end

Players.PlayerAdded:Connect(onPlayerAdded)
Players.PlayerRemoving:Connect(onPlayerRemoving)
for _, player in ipairs(Players:GetPlayers()) do
	task.spawn(onPlayerAdded, player)
end

task.spawn(function()
	while true do
		task.wait(SAVE_INTERVAL)
		for player, st in pairs(states) do
			if st.dirty then
				task.spawn(saveProfile, player)
			end
		end
	end
end)

-- 서버가 닫힐 때: 모두 저장하고, 저장이 끝날 때까지 (최대 25초) 기다린다
game:BindToClose(function()
	if BATTLE then
		Battle.saveAll()
	end
	for player in pairs(profiles) do
		task.spawn(saveProfile, player)
	end
	local t0 = os.clock()
	task.wait(0.5)
	while saving > 0 and os.clock() - t0 < 25 do
		task.wait(0.25)
	end
end)

------------------------------------------------------------------------
-- 사부와 적 (몸 만들기는 시간이 걸릴 수 있어 맨 나중에, 따로)
------------------------------------------------------------------------
task.spawn(function()
	if BATTLE then
		return -- 배틀그라운드에는 없다
	end
	local ok, err = pcall(Npc.spawnMasters, function(player: Player, styleId: string)
		local p = profiles[player]
		if not p then
			return
		end
		if not p.found[styleId] then
			p.found[styleId] = true
			Story.event(player, "found")
		end
		local m = Config.MASTERS[styleId]
		local sdef = Config.STYLE_BY_ID[styleId]
		if sdef and sdef.realmReq and not p.styles[styleId] and Calc.realm(p) < sdef.realmReq then
			Push:FireClient(player, "dialog", { who = m.name, title = "「" .. m.quote .. "」", text = string.format("...아직 이르다. 네 안의 하늘이 열리지 않았다. %s에 이르거든 다시 오너라.", Config.Realms[sdef.realmReq].name) })
			return
		end
		local req = sdef and sdef.styleReq and Config.STYLE_BY_ID[sdef.styleReq]
		if req and not sdef.geuk and not p.styles[styleId] and not p.styles[req.id] then
			Push:FireClient(player, "dialog", { who = m.name, title = "「" .. m.quote .. "」", text = string.format("...해와 달을 쥐려면 먼저 세상의 처음을 알아야 한다. %s을(를) 익히고 다시 오너라.", req.name) })
			return
		end
		if not p.styles[styleId] and Config.GEUK_REQ[styleId] then
			local ok, msg = geukCheck(p, styleId)
			if not ok then
				Push:FireClient(player, "dialog", { who = m.name, title = "「" .. m.quote .. "」", text = "...극은 한 번의 삶으로는 닿지 않는다. " .. msg .. "." })
				return
			end
		end
		if not p.styles[styleId] and not p.trials[styleId] and Config.TRANSCEND_REQ[styleId] then
			local ok, msg = transcendCheck(p, styleId, "challenge")
			if not ok then
				Push:FireClient(player, "dialog", { who = m.name, title = "「" .. m.quote .. "」", text = "...초월은 아무에게나 열리지 않는다. " .. msg .. ". 시련을 청하려면 " .. matList(Config.TRANSCEND_REQ[styleId].challenge) .. ", 배우려면 " .. matList(Config.TRANSCEND_REQ[styleId].learn) .. "을(를) 가져오너라." })
				return
			end
		end
		-- 3.7판: 두 번 환생해야 만나 주는 사부 (몽유권)
		if sdef and sdef.rebirthReq and not p.styles[styleId] and (p.rebirth or 0) < sdef.rebirthReq then
			Push:FireClient(player, "dialog", { who = m.name, title = "「" .. m.quote .. "」", text = string.format("...드르렁. (깨지 않는다. 환생을 %d번 한 몸이라야 이 꿈에 들어올 수 있을 것 같다)", sdef.rebirthReq) })
			return
		end
		-- 3.7판 사부의 부탁: 다 들어주어야 시험을 낸다
		if not p.styles[styleId] and not p.trials[styleId] and MiniQuest.has(styleId) and not MiniQuest.done(p, styleId) then
			MiniQuest.talk(player, styleId)
			return
		end
		if not p.styles[styleId] and not p.trials[styleId] then
			-- 아직 시험을 안 넘었다: 사부가 시험을 낸다
			Push:FireClient(player, "dialog", { who = m.name, title = "「" .. m.quote .. "」", text = (function()
				local kind, need = Config.trialNeed(styleId)
				local K = Config.TRIAL_KINDS[kind]
				local what = K and (K.icon .. " " .. K.title .. ": " .. string.format(K.ask, need)) or "먼저 내 분신을 꺾어라."
				return "제자가 되고 싶다면 시험을 넘어라. " .. what .. " 준비가 되면 다시 말을 걸어라. (다시 T를 누르면 시험이 시작된다)"
			end)(), trial = styleId })
			local st = states[player]
			if st and (st :: any).trialAsk == styleId then
				(st :: any).trialAsk = nil
				Trial.start(player, styleId)
			elseif st then
				(st :: any).trialAsk = styleId
			end
			return
		end
		Push:FireClient(player, "open", { page = "styles", style = styleId, master = true })
	end)
	if not ok then
		warn("[권왕] 사부 만들기 오류:", err)
	end
	ok, err = pcall(Npc.spawnElder, function(player: Player)
		Story.talk(player)
	end)
	if not ok then
		warn("[권왕] 장로 만들기 오류:", err)
	end
	ok, err = pcall(Npc.populate)
	if not ok then
		warn("[권왕] 적 만들기 오류:", err)
	end
	Npc.start()
end)

-- 사부를 찾았는가 (사부가 사는 지역에 한 번 들어가면 찾은 것, 숨은 사부는 가까이 가야)
local masterRegion: { [string]: any } = {}
for _, r in ipairs(Config.Regions) do
	if r.master then
		masterRegion[r.master] = r
	end
end
local function visited(pos: Vector3, id: string, m: any): boolean
	if m.secret then
		return (pos - m.at).Magnitude < 50
	end
	local r = masterRegion[id]
	if r and math.abs(pos.X - r.center.X) <= r.size.X / 2 and math.abs(pos.Z - r.center.Z) <= r.size.Z / 2 and pos.Y < Config.SKY.y - 200 then
		return true
	end
	-- 2.7.3판: 한 번 다녀간 곳은 물음표가 사라진다. 천상의 사부는 그 섬에 들어가기만 해도, 그 밖의 사부는 그 근처(120칸)만 지나가도 찾은 것
	local isl = m.regionId and m.at.Y > Config.SKY.y - 300 and Config.skyIslandAt(pos)
	if isl and isl.id == m.regionId then
		return true
	end
	return (pos - m.at).Magnitude < 120
end
task.spawn(function()
	if BATTLE then
		return -- 배틀그라운드에는 없다
	end
	while true do
		task.wait(1)
		for player, p in pairs(profiles) do
			local f = Combat.fighterOfPlayer(player)
			if f and not f.dead then
				-- 2.7.7판: 이야기 '천상의 문' (하늘에 올랐는가)
				if f.root.Position.Y > Config.SKY.y - 300 then
					local ch = Config.Story[p.story]
					if ch and ch.goal.kind == "sky" then
						Story.event(player, "sky")
					end
				end
				for id, m in pairs(Config.MASTERS) do
					if not p.found[id] and visited(f.root.Position, id, m) then
						p.found[id] = true
						states[player].dirty = true
						Push:FireClient(player, "found", { style = id, master = m.name, region = m.region })
						Story.event(player, "found")
						pushState(player)
					end
				end
			end
		end
	end
end)

------------------------------------------------------------------------
-- 3.9판 목인 세우기: 마을 입구의 튜토리얼 목인 셋, 권법 시험장의 작은 목인 다섯 · 큰 목인 셋 (자리를 정확히 맞춘다)
------------------------------------------------------------------------
if not BATTLE then
	task.spawn(function()
		task.wait(3)
		local function place(typeId: string, at: Vector3, region: string)
			local ok, e = pcall(Npc.spawn, typeId, false, at, region)
			if ok and e and e.f and e.f.model then
				local def = Config.Enemies[typeId]
				local face = Vector3.new(at.X, at.Y, at.Z + 10)
				pcall(function()
					e.f.model:PivotTo(CFrame.lookAt(at + Vector3.new(0, 3 * (def and def.scale or 1), 0), face + Vector3.new(0, 3 * (def and def.scale or 1), 0)))
				end)
				e.home = at
			end
		end
		for _, x in ipairs({ -12, 0, 12 }) do
			place("dummy", Vector3.new(x, 0, -48 - (x == 0 and 3 or 0)), "tutorial")
		end
		local TR = Config.TEST_ROOM
		if TR then
			for k = -2, 2 do
				place("dummy", TR.at + Vector3.new(k * 22, 0, -40), "testroom")
			end
			for k = -1, 1 do
				place("bigdummy", TR.at + Vector3.new(k * 50, 0, -110), "testroom")
			end
		end
	end)
end

------------------------------------------------------------------------
-- 3.3판 배틀그라운드: 맵을 돌리고, 떨어진 사람을 쓰러뜨리고, 판 상태를 알린다
------------------------------------------------------------------------
if BATTLE then
	-- 대기실의 싸움터 문과 연습용 목인
	local L = Battle.lobby
	if L then
		L.gate.Triggered:Connect(function(player: Player)
			local msg = Battle.request(player, "battleEnter", nil)
			if msg then
				toast(player, msg)
			end
		end)
		task.spawn(function()
			for _, at in ipairs(L.dummies) do
				pcall(Npc.spawn, "dummy", false, at, "test")
			end
		end)
	end
	Battle.start({
		push = Push,
		respawn = respawnPlayer,
		fighter = Combat.fighterOfPlayer,
		kill = function(f: any)
			local la = f.lastAttacker
			local by = (la and la.player and f.combatUntil > os.clock()) and la or nil
			Combat.kill(f, by)
		end,
		realmOf = function(player: Player): number
			local p = profiles[player]
			return p and (Calc.realm(p)) or 1
		end,
	})
end
]]></string>
      </Properties>
      <Item class="ModuleScript" referent="9">
        <Properties>
          <string name="Name">Battle</string>
          <string name="Source"><![CDATA[-- 권왕: 배틀그라운드 (3.3판). 따로 게시한 장소에서 늘 PvP. 맵 넷을 5분마다 바꿔 가며 싸운다
-- 메인 월드의 기록은 읽기만 한다 (권법·숙련). 배틀의 기록 (쓰러뜨린 수·은자 몫)은 따로 저장하고, 메인 월드가 돌아올 때 받아 간다
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local DataStoreService = game:GetService("DataStoreService")
local TeleportService = game:GetService("TeleportService")
local AssetService = game:GetService("AssetService")
local RunService = game:GetService("RunService")

local Config = require(ReplicatedStorage:WaitForChild("Config"))

local Battle = {}
local B = Config.BATTLE

------------------------------------------------------------------------
-- 장소 찾기 (같은 체험 안)
------------------------------------------------------------------------
local placeCache: { battle: number?, main: number? } = {}
local function findPlaces()
	if placeCache.battle and placeCache.main then
		return
	end
	local ok, pages = pcall(function()
		return AssetService:GetGamePlacesAsync()
	end)
	if not ok or not pages then
		return
	end
	while true do
		for _, item in ipairs(pages:GetCurrentPage()) do
			local name = tostring(item.Name or "")
			if string.find(name, B.placeName, 1, true) or string.find(string.lower(name), "battle", 1, true) then
				placeCache.battle = placeCache.battle or item.PlaceId
			else
				placeCache.main = placeCache.main or item.PlaceId
			end
		end
		if pages.IsFinished then
			break
		end
		local okNext = pcall(function()
			pages:AdvanceToNextPageAsync()
		end)
		if not okNext then
			break
		end
	end
end

-- toBattle = true: 메인 → 배틀그라운드, false: 배틀그라운드 → 메인. 실패하면 까닭을 돌려준다
function Battle.teleport(player: Player, toBattle: boolean): (boolean, string?)
	if RunService:IsStudio() then
		return false, "Studio에서는 장소를 옮길 수 없어요 (게시한 게임에서 돼요)"
	end
	local target: number? = nil
	if toBattle then
		target = (B.placeId ~= 0 and B.placeId) or nil
		if not target then
			findPlaces()
			target = placeCache.battle
		end
	else
		local jd = player:GetJoinData()
		local td = jd and jd.TeleportData
		target = type(td) == "table" and tonumber(td.from) or nil
		if not target then
			findPlaces()
			target = placeCache.main
		end
	end
	if not target then
		return false, toBattle and ("'" .. B.placeName .. "' 장소를 찾지 못했어요 (체험에 그 이름의 장소가 있어야 해요)") or "메인 월드를 찾지 못했어요"
	end
	local opts = Instance.new("TeleportOptions")
	opts:SetTeleportData({ from = game.PlaceId })
	local ok, err = pcall(function()
		TeleportService:TeleportAsync(target :: number, { player }, opts)
	end)
	if not ok then
		return false, "이동하지 못했어요: " .. tostring(err)
	end
	return true, nil
end

------------------------------------------------------------------------
-- 배틀 기록 (따로 저장)
------------------------------------------------------------------------
local store: DataStore? = nil
do
	local ok, ds = pcall(function()
		return DataStoreService:GetDataStore(B.store)
	end)
	if ok then
		store = ds
	end
end
type Rec = { kills: number, deaths: number, wins: number, best: number, pending: number }
local function blank(): Rec
	return { kills = 0, deaths = 0, wins = 0, best = 0, pending = 0 }
end
local function clean(d: any): Rec
	local r = blank()
	if type(d) == "table" then
		for k in pairs(r) do
			local v = tonumber(d[k])
			if v and v == v then
				(r :: any)[k] = math.max(0, math.floor(v))
			end
		end
	end
	return r
end

-- 메인 월드: 들어올 때 배틀 기록을 읽고, 쌓인 은자 몫을 받아 간다 (받은 몫은 0으로). { kills, coins }
function Battle.claim(player: Player): (number, number)
	local ds = store
	if not ds then
		return 0, 0
	end
	local kills, coins = 0, 0
	pcall(function()
		ds:UpdateAsync("b_" .. player.UserId, function(old)
			local r = clean(old)
			kills = r.kills
			coins = r.pending
			r.pending = 0
			return r
		end)
	end)
	return kills, coins
end

------------------------------------------------------------------------
-- 맵 짓기
------------------------------------------------------------------------
local maps: { any } = {}
local function part(props: { [string]: any }): BasePart
	local p = Instance.new(props.Class or "Part") :: BasePart
	p.Anchored = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	for k, v in pairs(props) do
		if k == "Position" then
			p.CFrame = CFrame.new(v)
		elseif k ~= "Class" and k ~= "Parent" then
			(p :: any)[k] = v
		end
	end
	p.Parent = props.Parent
	return p
end
-- 바닥 원판 (원기둥을 눕힌다)
local function disc(name: string, at: Vector3, r: number, h: number, color: Color3, mat: Enum.Material, parent: Instance, collide: boolean?): BasePart
	return part({ Name = name, Shape = Enum.PartType.Cylinder, Size = Vector3.new(h, r * 2, r * 2), CFrame = CFrame.new(at) * CFrame.Angles(0, 0, math.rad(90)), Color = color, Material = mat, CanCollide = collide ~= false, Parent = parent })
end
-- 보이지 않는 둘레 벽
local function fence(center: Vector3, r: number, h: number, parent: Instance)
	local n = 28
	for i = 1, n do
		local a = (i - 0.5) / n * math.pi * 2
		local w = 2 * r * math.tan(math.pi / n) + 2
		part({ Name = "Fence", Size = Vector3.new(w, h, 4), CFrame = CFrame.new(center + Vector3.new(math.cos(a) * (r + 2), h / 2, math.sin(a) * (r + 2))) * CFrame.Angles(0, -a + math.pi / 2, 0), Transparency = 1, CanCollide = true, CastShadow = false, Parent = parent })
	end
end
local function ring(n: number, r: number, phase: number?): { Vector3 }
	local out = {}
	for i = 1, n do
		local a = (i - 1) / n * math.pi * 2 + (phase or 0)
		table.insert(out, Vector3.new(math.cos(a) * r, 0, math.sin(a) * r))
	end
	return out
end
local function rnd(seed: number): () -> number
	local r = Random.new(seed)
	return function()
		return r:NextNumber()
	end
end

local BUILD: { [string]: (Vector3, Folder) -> { spawns: { Vector3 }, floorY: number, R: number } } = {}

------------------------------------------------------------------------
-- 3.11판: 맵 넷을 두 배 반지름 (넓이 네 배)으로 새로 짓는다. 고리에 똑같이 늘어놓던 것을 버리고
-- 흩어 놓고 (서로 떨어지게), 땅에 낮은 둔덕을 깔고, 길·물길·쉼터 같은 자리를 둔다
------------------------------------------------------------------------
local K2 = 2 -- 반지름 배율
-- 둘레 r0~r1 안에 서로 gap만큼 떨어진 자리 n개 (avoid: { {at, r} } 피할 곳)
local function scatter(G: () -> number, n: number, r0: number, r1: number, gap: number, avoid: { any }?): { Vector3 }
	local out: { Vector3 } = {}
	local tries = 0
	while #out < n and tries < n * 40 do
		tries += 1
		local a = G() * math.pi * 2
		local r = math.sqrt(r0 * r0 + G() * (r1 * r1 - r0 * r0))
		local v = Vector3.new(math.cos(a) * r, 0, math.sin(a) * r)
		local ok = true
		for _, o in ipairs(out) do
			if (o - v).Magnitude < gap then
				ok = false
				break
			end
		end
		if ok and avoid then
			for _, z in ipairs(avoid) do
				if (z[1] - v).Magnitude < z[2] then
					ok = false
					break
				end
			end
		end
		if ok then
			table.insert(out, v)
		end
	end
	return out
end
-- 낮은 둔덕 (큰 공을 땅에 거의 묻는다)
local function mound(at: Vector3, w: number, h: number, color: Color3, mat: Enum.Material, f: Instance)
	part({ Name = "Mound", Shape = Enum.PartType.Ball, Size = Vector3.new(w, w, w), Position = at + Vector3.new(0, h - w / 2, 0), Color = color, Material = mat, Parent = f })
end
-- 바위: 비스듬한 덩이 둘셋을 겹친다
local function rock(G: () -> number, at: Vector3, s: number, color: Color3, mat: Enum.Material, f: Instance, moss: Color3?)
	for k = 1, 2 + math.floor(G() * 2) do
		local sz = Vector3.new(s * (0.6 + G() * 0.6), s * (0.4 + G() * 0.5), s * (0.6 + G() * 0.5))
		local off = Vector3.new((G() - 0.5) * s * 0.7, sz.Y * 0.35, (G() - 0.5) * s * 0.7)
		local cf = CFrame.new(at + off) * CFrame.Angles((G() - 0.5) * 0.5, G() * 6, (G() - 0.5) * 0.5)
		part({ Name = "Rock", Size = sz, CFrame = cf, Color = color:Lerp(Color3.new(0, 0, 0), G() * 0.15), Material = mat, Parent = f })
		if moss and k == 1 then
			part({ Name = "Moss", Size = Vector3.new(sz.X * 0.8, 0.25, sz.Z * 0.8), CFrame = cf * CFrame.new(0, sz.Y / 2 + 0.05, 0), Color = moss, Material = Enum.Material.Grass, CanCollide = false, Parent = f })
		end
	end
end
-- 석등 (빛)
local function stoneLantern(at: Vector3, f: Instance, glow: Color3?)
	part({ Name = "LanternFoot", Size = Vector3.new(2.4, 0.8, 2.4), Position = at + Vector3.new(0, 0.4, 0), Color = Color3.fromRGB(130, 126, 118), Material = Enum.Material.Granite, Parent = f })
	part({ Name = "LanternPost", Size = Vector3.new(1.1, 3.4, 1.1), Position = at + Vector3.new(0, 2.5, 0), Color = Color3.fromRGB(140, 136, 128), Material = Enum.Material.Granite, Parent = f })
	local lamp = part({ Name = "Lantern", Size = Vector3.new(1.9, 1.5, 1.9), Position = at + Vector3.new(0, 4.9, 0), Color = glow or Color3.fromRGB(255, 214, 150), Material = Enum.Material.Neon, Transparency = 0.15, Parent = f })
	local l = Instance.new("PointLight")
	l.Range = 18
	l.Brightness = 1.1
	l.Color = glow or Color3.fromRGB(255, 200, 130)
	l.Parent = lamp
	part({ Name = "LanternRoof", Class = "WedgePart", Size = Vector3.new(3, 0.9, 1.5), CFrame = CFrame.new(at + Vector3.new(0, 6.1, -0.75)), Color = Color3.fromRGB(70, 66, 60), Material = Enum.Material.Slate, Parent = f })
	part({ Name = "LanternRoof", Class = "WedgePart", Size = Vector3.new(3, 0.9, 1.5), CFrame = CFrame.new(at + Vector3.new(0, 6.1, 0.75)) * CFrame.Angles(0, math.pi, 0), Color = Color3.fromRGB(70, 66, 60), Material = Enum.Material.Slate, Parent = f })
end
-- 기와지붕 정자 (기둥 넷, 두 겹 지붕)
local function pavilion(at: Vector3, s: number, f: Instance, yaw: number?)
	local base = CFrame.new(at) * CFrame.Angles(0, yaw or 0, 0)
	part({ Name = "PavBase", Size = Vector3.new(14, 1.2, 14) * Vector3.new(s, 1, s), CFrame = base * CFrame.new(0, 0.6, 0), Color = Color3.fromRGB(150, 144, 132), Material = Enum.Material.Cobblestone, Parent = f })
	part({ Name = "PavDeck", Size = Vector3.new(12.4 * s, 0.4, 12.4 * s), CFrame = base * CFrame.new(0, 1.35, 0), Color = Color3.fromRGB(130, 92, 60), Material = Enum.Material.WoodPlanks, Parent = f })
	for _, x in ipairs({ -1, 1 }) do
		for _, z in ipairs({ -1, 1 }) do
			part({ Name = "PavPillar", Size = Vector3.new(1.2, 10, 1.2), CFrame = base * CFrame.new(x * 5.2 * s, 6.5, z * 5.2 * s), Color = Color3.fromRGB(160, 46, 38), Material = Enum.Material.Wood, Parent = f })
		end
	end
	part({ Name = "PavBeam", Size = Vector3.new(12 * s, 1, 12 * s), CFrame = base * CFrame.new(0, 11.6, 0), Color = Color3.fromRGB(60, 90, 70), Material = Enum.Material.Wood, Parent = f })
	part({ Name = "PavRoof", Size = Vector3.new(17 * s, 1.2, 17 * s), CFrame = base * CFrame.new(0, 12.6, 0), Color = Color3.fromRGB(56, 60, 70), Material = Enum.Material.Slate, Parent = f })
	part({ Name = "PavRoof2", Size = Vector3.new(10 * s, 1.6, 10 * s), CFrame = base * CFrame.new(0, 13.8, 0), Color = Color3.fromRGB(46, 50, 60), Material = Enum.Material.Slate, Parent = f })
	part({ Name = "PavRidge", Size = Vector3.new(4 * s, 1.4, 4 * s), CFrame = base * CFrame.new(0, 15, 0), Color = Color3.fromRGB(40, 44, 54), Material = Enum.Material.Slate, Parent = f })
end
-- 물결치는 줄기 (물길·용암): 굽은 길을 따라 조각을 잇는다
local function stream(c: Vector3, from: Vector3, to: Vector3, w: number, wave: number, color: Color3, mat: Enum.Material, f: Instance, glow: boolean?): { Vector3 }
	local pts: { Vector3 } = {}
	local n = 14
	local dir = (to - from)
	local side = Vector3.new(-dir.Z, 0, dir.X).Unit
	for i = 0, n do
		local u = i / n
		table.insert(pts, c + from:Lerp(to, u) + side * math.sin(u * math.pi * 2.2) * wave)
	end
	for i = 1, n do
		local a, b = pts[i], pts[i + 1]
		local seg = part({ Name = "Stream", Size = Vector3.new(w * (0.85 + 0.3 * math.sin(i)), 0.3, (b - a).Magnitude + w * 0.5), CFrame = CFrame.lookAt((a + b) / 2 + Vector3.new(0, 0.12, 0), b + Vector3.new(0, 0.12, 0)), Color = color, Material = mat, CanCollide = false, Parent = f })
		if glow and i % 3 == 0 then
			local l = Instance.new("PointLight")
			l.Range = 24
			l.Brightness = 2
			l.Color = color
			l.Parent = seg
		end
	end
	return pts
end

-- 죽림 비무장: 낮은 둔덕이 이어진 풀밭, 가운데 돌 마당, 흩어진 대숲, 개울과 돌다리, 정자 셋, 석등 길
BUILD.bamboo = function(c: Vector3, f: Folder)
	local R = 140 * K2
	local G = rnd(11)
	disc("Ground", c + Vector3.new(0, -2, 0), R + 30, 4, Color3.fromRGB(86, 120, 62), Enum.Material.Grass, f)
	for _, v in ipairs(scatter(G, 26, 90, R - 10, 34)) do
		mound(c + v, 44 + G() * 30, 0.8 + G() * 1.4, Color3.fromRGB(80 + math.floor(G() * 20), 116 + math.floor(G() * 16), 58), Enum.Material.Grass, f)
	end
	-- 가운데 돌 마당 (바깥 테는 박석)
	disc("Court", c + Vector3.new(0, 0.25, 0), 64, 0.6, Color3.fromRGB(150, 146, 136), Enum.Material.Slate, f)
	for k = 0, 35 do
		local a = k / 36 * math.pi * 2
		part({ Name = "Flagstone", Size = Vector3.new(10.5, 0.7, 5), CFrame = CFrame.new(c + Vector3.new(math.cos(a) * 66, 0.3, math.sin(a) * 66)) * CFrame.Angles(0, -a + math.pi / 2, 0), Color = Color3.fromRGB(128 + (k % 3) * 8, 124 + (k % 3) * 8, 114), Material = Enum.Material.Cobblestone, Parent = f })
	end
	disc("CourtMark", c + Vector3.new(0, 0.62, 0), 10, 0.2, Color3.fromRGB(170, 50, 40), Enum.Material.Fabric, f, false)
	-- 마당 안의 엇갈린 돌담 (엄폐)
	for i = 1, 5 do
		local a = (i - 1) / 5 * math.pi * 2 + 0.4
		local v = Vector3.new(math.cos(a), 0, math.sin(a)) * (34 + (i % 2) * 8)
		local cf = CFrame.new(c + v + Vector3.new(0, 2.4, 0)) * CFrame.Angles(0, -a + math.pi / 2 + (G() - 0.5) * 0.5, 0)
		part({ Name = "LowWall", Size = Vector3.new(12 + G() * 6, 4.2, 2.2), CFrame = cf, Color = Color3.fromRGB(128, 124, 116), Material = Enum.Material.Cobblestone, Parent = f })
		part({ Name = "WallCap", Size = Vector3.new(14 + G() * 4, 0.6, 2.8), CFrame = cf * CFrame.new(0, 2.4, 0), Color = Color3.fromRGB(70, 60, 50), Material = Enum.Material.Slate, Parent = f })
	end
	-- 개울: 북서에서 남동으로 굽이쳐 흐르고, 돌다리 둘
	local water = stream(c, Vector3.new(-R, 0, -R * 0.45), Vector3.new(R, 0, R * 0.55), 9, 40, Color3.fromRGB(90, 150, 190), Enum.Material.Glass, f)
	local avoid: { any } = { { Vector3.zero, 85 } }
	for i, p in ipairs(water) do
		table.insert(avoid, { p - c, 16 })
		if i == 4 or i == 12 then
			local nxt = water[i + 1] or p
			local d = (nxt - p).Unit
			part({ Name = "Bridge", Size = Vector3.new(18, 1.2, 6), CFrame = CFrame.lookAt(p + Vector3.new(0, 0.9, 0), p + Vector3.new(0, 0.9, 0) + d) * CFrame.Angles(0, math.pi / 2, 0), Color = Color3.fromRGB(150, 146, 136), Material = Enum.Material.Cobblestone, Parent = f })
		elseif i % 3 == 0 then
			rock(G, p + Vector3.new(6, 0, 0), 3, Color3.fromRGB(120, 124, 118), Enum.Material.Slate, f, Color3.fromRGB(80, 120, 60))
		end
	end
	-- 정자 셋 (쉼터·높은 자리)
	local pavs = scatter(G, 3, 150, 200, 120, avoid)
	for _, v in ipairs(pavs) do
		pavilion(c + v, 1, f, G() * 6)
		table.insert(avoid, { v, 22 })
		-- 마당에서 정자로 가는 석등 길
		for k = 1, 3 do
			local u = 0.3 + k * 0.17
			local p = v * u + Vector3.new(-v.Z, 0, v.X).Unit * 7
			stoneLantern(c + p, f)
		end
	end
	-- 대나무 (줄기·마디 둘·잎)
	local function stalk(at: Vector3, h: number)
		local col = Color3.fromRGB(90 + math.floor(G() * 30), 140 + math.floor(G() * 30), 60)
		local tilt = CFrame.Angles((G() - 0.5) * 0.08, 0, (G() - 0.5) * 0.08)
		local base = CFrame.new(at) * tilt
		part({ Name = "Bamboo", Shape = Enum.PartType.Cylinder, Size = Vector3.new(h, 0.9, 0.9), CFrame = base * CFrame.new(0, h / 2, 0) * CFrame.Angles(0, 0, math.rad(90)), Color = col, Material = Enum.Material.SmoothPlastic, Parent = f })
		for _, y in ipairs({ h * 0.35, h * 0.7 }) do
			part({ Name = "Node", Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.25, 1.05, 1.05), CFrame = base * CFrame.new(0, y, 0) * CFrame.Angles(0, 0, math.rad(90)), Color = col:Lerp(Color3.new(0, 0, 0), 0.25), Material = Enum.Material.SmoothPlastic, CanCollide = false, Parent = f })
		end
		part({ Name = "Leaves", Shape = Enum.PartType.Ball, Size = Vector3.new(6, 6, 6), CFrame = base * CFrame.new((G() - 0.5) * 2, h + 1, (G() - 0.5) * 2), Color = Color3.fromRGB(64 + math.floor(G() * 20), 124 + math.floor(G() * 20), 56), Material = Enum.Material.Grass, CanCollide = false, Transparency = 0.1, Parent = f })
	end
	-- 대숲: 크기가 다른 덤불이 흩어져 있다 (뒤에 숨어 파고든다)
	for _, v in ipairs(scatter(G, 36, 95, R - 25, 28, avoid)) do
		local n = 6 + math.floor(G() * 8)
		local spread = 5 + n * 0.8
		for _ = 1, n do
			stalk(c + v + Vector3.new((G() - 0.5) * spread, 0, (G() - 0.5) * spread), 18 + G() * 16)
		end
		if G() < 0.4 then
			rock(G, c + v + Vector3.new(spread * 0.6, 0, 0), 3 + G() * 2, Color3.fromRGB(116, 118, 110), Enum.Material.Slate, f, Color3.fromRGB(80, 120, 60))
		end
	end
	-- 둘레: 빽빽한 대숲 두 겹
	for _, v in ipairs(ring(84, R + 6)) do
		stalk(c + v + Vector3.new((G() - 0.5) * 8, 0, (G() - 0.5) * 8), 26 + G() * 16)
		stalk(c + v * 1.04 + Vector3.new((G() - 0.5) * 8, 0, (G() - 0.5) * 8), 30 + G() * 16)
	end
	fence(c, R, 60, f)
	local sp = {}
	for _, v in ipairs(scatter(G, 16, R * 0.55, R * 0.8, 40, avoid)) do
		table.insert(sp, c + v + Vector3.new(0, 6, 0))
	end
	return { spawns = sp, floorY = c.Y, R = R }
end

-- 빙호 설원: 눈 둔덕이 이어진 벌판, 가운데 들쭉날쭉한 얼어붙은 호수, 흩어진 얼음 기둥, 무너진 옛 사당, 소나무 숲
BUILD.frost = function(c: Vector3, f: Folder)
	local R = 145 * K2
	local G = rnd(23)
	disc("Snow", c + Vector3.new(0, -2, 0), R + 30, 4, Color3.fromRGB(236, 240, 248), Enum.Material.Snow, f)
	-- 호수: 크기가 다른 얼음 원판 여럿을 겹쳐 가장자리가 들쭉날쭉하다
	disc("Lake", c + Vector3.new(0, 0.2, 0), 95, 0.5, Color3.fromRGB(170, 215, 240), Enum.Material.Ice, f)
	for k = 1, 7 do
		local a = k / 7 * math.pi * 2 + G()
		local r = 40 + G() * 25
		disc("LakeLobe", c + Vector3.new(math.cos(a) * (95 - r * 0.5), 0.18 + k * 0.004, math.sin(a) * (95 - r * 0.5)), r, 0.5, Color3.fromRGB(165 + math.floor(G() * 15), 212, 240), Enum.Material.Ice, f)
	end
	-- 호수 위의 금 (얕은 선)
	for _ = 1, 10 do
		local a, r = G() * math.pi * 2, G() * 80
		part({ Name = "IceCrack", Size = Vector3.new(0.3, 0.1, 10 + G() * 18), CFrame = CFrame.new(c + Vector3.new(math.cos(a) * r, 0.5, math.sin(a) * r)) * CFrame.Angles(0, G() * 6, 0), Color = Color3.fromRGB(235, 248, 255), Material = Enum.Material.Neon, Transparency = 0.4, CanCollide = false, Parent = f })
	end
	local avoid: { any } = { { Vector3.zero, 120 } }
	-- 눈 둔덕
	for _, v in ipairs(scatter(G, 30, 130, R - 10, 34)) do
		mound(c + v, 40 + G() * 36, 1 + G() * 2.2, Color3.fromRGB(238, 242, 250), Enum.Material.Snow, f)
	end
	-- 얼음 기둥 (호숫가와 벌판에 흩어져)
	for _, v in ipairs(scatter(G, 18, 60, R - 30, 26)) do
		local h = 12 + G() * 16
		part({ Name = "IcePillar", Size = Vector3.new(4 + G() * 4, h, 4 + G() * 4), CFrame = CFrame.new(c + v + Vector3.new(0, h / 2 - 1, 0)) * CFrame.Angles((G() - 0.5) * 0.3, G() * 3, (G() - 0.5) * 0.3), Color = Color3.fromRGB(150, 215, 255), Material = Enum.Material.Glass, Transparency = 0.25, Parent = f })
		if G() < 0.5 then
			part({ Name = "IceShard", Size = Vector3.new(2.2, h * 0.5, 2.2), CFrame = CFrame.new(c + v + Vector3.new(3, h * 0.22, 1)) * CFrame.Angles(0.35, G() * 3, 0.2), Color = Color3.fromRGB(190, 235, 255), Material = Enum.Material.Glass, Transparency = 0.3, Parent = f })
		end
	end
	-- 무너진 옛 사당 (기둥 여덟 중 몇은 부러졌다, 깨진 단)
	local shrine = scatter(G, 1, 180, 210, 1, avoid)[1] or Vector3.new(190, 0, 0)
	table.insert(avoid, { shrine, 30 })
	disc("ShrineBase", c + shrine + Vector3.new(0, 0.8, 0), 20, 1.6, Color3.fromRGB(170, 172, 180), Enum.Material.Slate, f)
	for i, v in ipairs(ring(8, 16, 0.2)) do
		local h = (i % 3 == 0) and (4 + G() * 4) or 14
		part({ Name = "ShrinePillar", Size = Vector3.new(2.4, h, 2.4), CFrame = CFrame.new(c + shrine + v + Vector3.new(0, 1.6 + h / 2, 0)) * CFrame.Angles(0, G(), (i % 3 == 0) and 0.12 or 0), Color = Color3.fromRGB(196, 198, 206), Material = Enum.Material.Marble, Parent = f })
		if h > 10 then
			part({ Name = "PillarSnow", Size = Vector3.new(2.8, 0.5, 2.8), Position = c + shrine + v + Vector3.new(0, 1.6 + h + 0.25, 0), Color = Color3.fromRGB(245, 248, 255), Material = Enum.Material.Snow, CanCollide = false, Parent = f })
		end
	end
	for _ = 1, 4 do
		local v = shrine + Vector3.new((G() - 0.5) * 30, 0, (G() - 0.5) * 30)
		part({ Name = "FallenStone", Size = Vector3.new(2.4, 2.4, 6 + G() * 4), CFrame = CFrame.new(c + v + Vector3.new(0, 1.2, 0)) * CFrame.Angles(0, G() * 6, 0.1), Color = Color3.fromRGB(190, 192, 200), Material = Enum.Material.Marble, Parent = f })
	end
	-- 소나무 (숲 덩이와 둘레)
	local function pine(at: Vector3, h: number)
		part({ Name = "Trunk", Size = Vector3.new(1.6, h * 0.4, 1.6), Position = at + Vector3.new(0, h * 0.2, 0), Color = Color3.fromRGB(90, 65, 45), Material = Enum.Material.Wood, Parent = f })
		for k = 0, 2 do
			local r = (3 - k) * 2.4 * (h / 30)
			part({ Name = "Needles", Shape = Enum.PartType.Cylinder, Size = Vector3.new(h * 0.22, r * 2, r * 2), CFrame = CFrame.new(at + Vector3.new(0, h * (0.35 + k * 0.2), 0)) * CFrame.Angles(0, 0, math.rad(90)), Color = Color3.fromRGB(40, 80, 60):Lerp(Color3.new(1, 1, 1), 0.08 * k), Material = Enum.Material.Grass, CanCollide = k == 0, Parent = f })
			part({ Name = "SnowCap", Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.6, r * 1.6, r * 1.6), CFrame = CFrame.new(at + Vector3.new(0, h * (0.35 + k * 0.2) + h * 0.11, 0)) * CFrame.Angles(0, 0, math.rad(90)), Color = Color3.fromRGB(245, 248, 255), Material = Enum.Material.Snow, CanCollide = false, Parent = f })
		end
	end
	for _, v in ipairs(scatter(G, 16, 140, R - 30, 44, avoid)) do
		for _ = 1, 3 + math.floor(G() * 4) do
			pine(c + v + Vector3.new((G() - 0.5) * 22, 0, (G() - 0.5) * 22), 22 + G() * 14)
		end
	end
	for _, v in ipairs(ring(64, R + 4)) do
		pine(c + v + Vector3.new((G() - 0.5) * 8, 0, (G() - 0.5) * 8), 26 + G() * 14)
	end
	fence(c, R, 60, f)
	local sp = {}
	for _, v in ipairs(scatter(G, 16, 130, R * 0.8, 40, avoid)) do
		table.insert(sp, c + v + Vector3.new(0, 8, 0))
	end
	return { spawns = sp, floorY = c.Y, R = R }
end

-- 화산 분지: 현무암 바닥과 낮은 잿빛 둔덕, 굽이치는 용암 줄기 셋, 가운데 높은 단과 비탈, 작은 단 셋, 바위 첨탑, 분화구 벽
BUILD.crater = function(c: Vector3, f: Folder)
	local R = 140 * K2
	local G = rnd(37)
	disc("Basalt", c + Vector3.new(0, -2, 0), R + 30, 4, Color3.fromRGB(48, 40, 38), Enum.Material.Basalt, f)
	for _, v in ipairs(scatter(G, 24, 70, R - 15, 36)) do
		mound(c + v, 40 + G() * 30, 0.8 + G() * 1.8, Color3.fromRGB(58 + math.floor(G() * 14), 48, 44), Enum.Material.Basalt, f)
	end
	-- 용암 줄기 (보기만, 밟아도 괜찮다): 가운데 단에서 바깥으로 굽이친다
	local avoid: { any } = { { Vector3.zero, 70 } }
	for i = 1, 5 do
		local a = (i - 1) / 5 * math.pi * 2 + 0.5
		local d = Vector3.new(math.cos(a), 0, math.sin(a))
		for _, p in ipairs(stream(c, d * 50, d * (R - 20), 5 + G() * 3, 24, Color3.fromRGB(255, 110, 30), Enum.Material.Neon, f, true)) do
			table.insert(avoid, { p - c, 12 })
		end
	end
	-- 가운데 단 (높이 9)과 네 비탈
	disc("Plateau", c + Vector3.new(0, 4.5, 0), 40, 9, Color3.fromRGB(70, 58, 52), Enum.Material.Basalt, f)
	disc("PlateauTop", c + Vector3.new(0, 9.1, 0), 38, 0.4, Color3.fromRGB(95, 72, 60), Enum.Material.Slate, f)
	for i = 1, 4 do
		local a = (i - 1) / 4 * math.pi * 2
		local dir = Vector3.new(math.cos(a), 0, math.sin(a))
		part({ Class = "WedgePart", Name = "Ramp", Size = Vector3.new(14, 9, 24), CFrame = CFrame.lookAt(c + dir * 51 + Vector3.new(0, 4.5, 0), c + dir * 80 + Vector3.new(0, 4.5, 0)), Color = Color3.fromRGB(78, 64, 56), Material = Enum.Material.Basalt, Parent = f })
	end
	-- 작은 단 셋 (낮다, 한쪽 비탈)
	for _, v in ipairs(scatter(G, 3, 150, 200, 120, avoid)) do
		disc("Mesa", c + v + Vector3.new(0, 3, 0), 18, 6, Color3.fromRGB(66, 54, 50), Enum.Material.Basalt, f)
		local dir = -v.Unit
		part({ Class = "WedgePart", Name = "Ramp", Size = Vector3.new(10, 6, 14), CFrame = CFrame.lookAt(c + v + dir * 24 + Vector3.new(0, 3, 0), c + v + dir * 40 + Vector3.new(0, 3, 0)), Color = Color3.fromRGB(74, 60, 54), Material = Enum.Material.Basalt, Parent = f })
		table.insert(avoid, { v, 30 })
	end
	-- 바위 첨탑과 흑요석 조각 (엄폐)
	for _, v in ipairs(scatter(G, 36, 70, R - 30, 26, avoid)) do
		local h = 12 + G() * 18
		part({ Name = "Spire", Size = Vector3.new(6 + G() * 5, h, 6 + G() * 5), CFrame = CFrame.new(c + v + Vector3.new(0, h / 2 - 1, 0)) * CFrame.Angles((G() - 0.5) * 0.3, G() * 3, (G() - 0.5) * 0.3), Color = Color3.fromRGB(60, 50, 46), Material = Enum.Material.Basalt, Parent = f })
		if G() < 0.5 then
			part({ Name = "Obsidian", Size = Vector3.new(1.6, 4 + G() * 4, 1.6), CFrame = CFrame.new(c + v + Vector3.new(4, 2, 2)) * CFrame.Angles(0.3, G() * 6, 0.3), Color = Color3.fromRGB(30, 22, 34), Material = Enum.Material.Glass, Parent = f })
		end
	end
	-- 흩어진 돌무더기 (낮은 엄폐)
	for _, v in ipairs(scatter(G, 20, 60, R - 20, 30, avoid)) do
		rock(G, c + v, 3 + G() * 3, Color3.fromRGB(72, 60, 54), Enum.Material.Basalt, f)
	end
	-- 분화구 벽
	for _, v in ipairs(ring(72, R + 10)) do
		local h = 26 + G() * 22
		part({ Name = "CraterWall", Size = Vector3.new(28, h, 16), CFrame = CFrame.lookAt(c + v + Vector3.new(0, h / 2 - 2, 0), c + Vector3.new(0, h / 2 - 2, 0)) * CFrame.Angles(math.rad(-14), 0, 0), Color = Color3.fromRGB(55 + math.floor(G() * 10), 44, 40), Material = Enum.Material.Basalt, Parent = f })
	end
	fence(c, R, 70, f)
	local sp = {}
	for _, v in ipairs(scatter(G, 16, 110, R * 0.8, 40, avoid)) do
		table.insert(sp, c + v + Vector3.new(0, 6, 0))
	end
	return { spawns = sp, floorY = c.Y, R = R }
end

-- 운상 누각: 구름 위의 누각 셋과 가운데 높은 단, 사이사이 떠 있는 작은 섬 셋, 다리로 잇는다 (떨어지면 쓰러진다)
BUILD.cloud = function(c: Vector3, f: Folder)
	local G = rnd(41)
	local WOOD = Color3.fromRGB(150, 95, 60)
	local DECK = Color3.fromRGB(196, 160, 112)
	local OR, DR, CR = 86 * K2, 34 * 1.5, 22 * 1.6
	local outer = ring(3, OR, -math.pi / 2)
	local function deck(at: Vector3, r: number, roof: boolean)
		disc("Deck", at + Vector3.new(0, -1, 0), r, 2, DECK, Enum.Material.WoodPlanks, f)
		disc("DeckRim", at + Vector3.new(0, -1.2, 0), r + 1, 2.2, WOOD, Enum.Material.Wood, f)
		for _, v in ipairs(ring(math.floor(r / 2.4), r - 0.5)) do
			part({ Name = "RailPost", Size = Vector3.new(0.8, 3, 0.8), Position = at + v + Vector3.new(0, 1.5, 0), Color = Color3.fromRGB(170, 40, 35), Material = Enum.Material.Wood, Parent = f })
		end
		if roof then
			pavilion(at + Vector3.new(r * 0.35, 0, 0), 1.3, f, G() * 6)
			stoneLantern(at + Vector3.new(-r * 0.4, 0, r * 0.3), f)
			stoneLantern(at + Vector3.new(-r * 0.4, 0, -r * 0.3), f)
		end
	end
	for _, v in ipairs(outer) do
		deck(c + v, DR, true)
	end
	deck(c + Vector3.new(0, 5, 0), CR, false)
	-- 떠 있는 작은 섬 (풀 덮인 바위 위)
	local isles = ring(3, OR * 0.62, math.pi / 2)
	for _, v in ipairs(isles) do
		local at = c + v + Vector3.new(0, 2, 0)
		disc("Isle", at + Vector3.new(0, -1.5, 0), 16, 3, Color3.fromRGB(96, 130, 70), Enum.Material.Grass, f)
		part({ Name = "IsleRock", Shape = Enum.PartType.Ball, Size = Vector3.new(28, 28, 28), Position = at + Vector3.new(0, -16, 0), Color = Color3.fromRGB(120, 114, 104), Material = Enum.Material.Slate, Parent = f })
		rock(G, at + Vector3.new(5, 0, -4), 4, Color3.fromRGB(130, 124, 114), Enum.Material.Slate, f, Color3.fromRGB(90, 130, 70))
		part({ Name = "IsleTree", Size = Vector3.new(1.4, 8, 1.4), Position = at + Vector3.new(-5, 4, 3), Color = Color3.fromRGB(96, 70, 48), Material = Enum.Material.Wood, Parent = f })
		part({ Name = "IsleCanopy", Shape = Enum.PartType.Ball, Size = Vector3.new(9, 7, 9), Position = at + Vector3.new(-5, 9, 3), Color = Color3.fromRGB(200, 120, 140), Material = Enum.Material.Grass, CanCollide = false, Parent = f })
	end
	local function bridge(a: Vector3, b: Vector3, w: number)
		local mid = (a + b) / 2
		local len = (b - a).Magnitude
		part({ Name = "Bridge", Size = Vector3.new(w, 1.2, len), CFrame = CFrame.lookAt(mid, b), Color = DECK:Lerp(WOOD, 0.3), Material = Enum.Material.WoodPlanks, Parent = f })
		for _, side in ipairs({ -1, 1 }) do
			part({ Name = "BridgeRope", Size = Vector3.new(0.3, 0.3, len), CFrame = CFrame.lookAt(mid, b) * CFrame.new(side * (w / 2), 2.6, 0), Color = Color3.fromRGB(200, 50, 40), Material = Enum.Material.Fabric, CanCollide = false, Parent = f })
		end
	end
	for _, v in ipairs(outer) do
		local dir = v.Unit
		bridge(c + dir * (OR - DR + 1) + Vector3.new(0, -0.4, 0), c + dir * (CR - 1) + Vector3.new(0, 4.4, 0), 9)
	end
	-- 바깥 누각 → 작은 섬 → 다음 누각
	for i = 1, 3 do
		local a, b = outer[i], outer[i % 3 + 1]
		local mid = (a + b).Unit * OR * 0.62
		local best = isles[1]
		for _, iv in ipairs(isles) do
			if (iv - mid).Magnitude < (best - mid).Magnitude then
				best = iv
			end
		end
		local function edge(p: Vector3, q: Vector3, r: number): Vector3
			return c + p + (q - p).Unit * (r - 1) + Vector3.new(0, -0.4, 0)
		end
		bridge(edge(a, best, DR), edge(best, a, 16) + Vector3.new(0, 2, 0), 7)
		bridge(edge(best, b, 16) + Vector3.new(0, 2, 0), edge(b, best, DR), 7)
	end
	for _ = 1, 70 do
		local s = 24 + G() * 40
		part({ Name = "Cloud", Shape = Enum.PartType.Ball, Size = Vector3.new(s, s * 0.6, s), Position = c + Vector3.new((G() - 0.5) * 640, -30 - G() * 40, (G() - 0.5) * 560), Color = Color3.fromRGB(250, 250, 255), Material = Enum.Material.SmoothPlastic, Transparency = 0.25, CanCollide = false, CastShadow = false, Parent = f })
	end
	local sp = {}
	for _, v in ipairs(outer) do
		for _, o in ipairs(ring(5, 24, 0.5)) do
			table.insert(sp, c + v + o + Vector3.new(0, 4, 0))
		end
	end
	return { spawns = sp, floorY = c.Y, R = OR + DR, fall = true }
end

------------------------------------------------------------------------
-- 3.11판 대기실: 산기슭의 무관 뜰. 흰 담장 (기와 갓)으로 두른 박석 마당, 북쪽 큰 전각과 돌계단 (싸움터 문은 전각 앞),
-- 남쪽 솟을대문, 동쪽 연못과 돌다리, 서쪽 수련 마당 (목인 둘), 담 밖의 소나무 숲. 권법은 화면에서 골라 들어간다
------------------------------------------------------------------------
local lobby: any = nil
local function buildLobby(c: Vector3, f: Folder): any
	local G = rnd(5)
	local W, D = 70, 56 -- 마당 반 너비·반 깊이
	local STONE = Color3.fromRGB(196, 190, 176)
	local WALL = Color3.fromRGB(236, 230, 214)
	local TILE = Color3.fromRGB(58, 62, 70)
	local RED = Color3.fromRGB(160, 44, 36)
	disc("LobbyGround", c + Vector3.new(0, -2, 0), 170, 4, Color3.fromRGB(92, 124, 70), Enum.Material.Grass, f)
	-- 박석 마당 (줄눈이 보이게 판을 깐다)
	part({ Name = "CourtBed", Size = Vector3.new(W * 2, 0.5, D * 2), Position = c + Vector3.new(0, 0.2, 0), Color = STONE:Lerp(Color3.new(0, 0, 0), 0.25), Material = Enum.Material.Slate, Parent = f })
	for x = -W + 5, W - 5, 10 do
		for z = -D + 4, D - 4, 8 do
			local off = ((z // 8) % 2) * 5
			local xx = x + off
			if xx < W - 4 then
				part({ Name = "Paver", Size = Vector3.new(9.6, 0.4, 7.6), Position = c + Vector3.new(xx, 0.55, z), Color = STONE:Lerp(Color3.fromRGB(170, 160, 146), G() * 0.6), Material = Enum.Material.Slate, CanCollide = false, Parent = f })
			end
		end
	end
	-- 담장: 흰 벽 + 기와 갓 (남쪽 가운데는 대문, 동쪽은 연못으로 트였다)
	local function wallSeg(a: Vector3, b: Vector3)
		local mid, len = (a + b) / 2, (b - a).Magnitude
		local cf = CFrame.lookAt(mid, b)
		part({ Name = "WallStone", Size = Vector3.new(2.2, 2, len), CFrame = cf * CFrame.new(0, 1, 0), Color = Color3.fromRGB(150, 140, 126), Material = Enum.Material.Cobblestone, Parent = f })
		part({ Name = "Wall", Size = Vector3.new(1.8, 5, len), CFrame = cf * CFrame.new(0, 4.5, 0), Color = WALL, Material = Enum.Material.Plaster, Parent = f })
		part({ Name = "WallTile", Size = Vector3.new(3.4, 0.7, len + 1), CFrame = cf * CFrame.new(0, 7.3, 0), Color = TILE, Material = Enum.Material.Slate, Parent = f })
		part({ Name = "WallRidge", Size = Vector3.new(1.2, 0.6, len + 1), CFrame = cf * CFrame.new(0, 7.9, 0), Color = TILE:Lerp(Color3.new(0, 0, 0), 0.2), Material = Enum.Material.Slate, Parent = f })
	end
	local y = Vector3.new(0, 0, 0)
	wallSeg(c + Vector3.new(-W, 0, -D) + y, c + Vector3.new(-W, 0, D) + y)
	wallSeg(c + Vector3.new(-W, 0, D) + y, c + Vector3.new(-12, 0, D) + y)
	wallSeg(c + Vector3.new(12, 0, D) + y, c + Vector3.new(W, 0, D) + y)
	wallSeg(c + Vector3.new(W, 0, D) + y, c + Vector3.new(W, 0, 18) + y)
	wallSeg(c + Vector3.new(W, 0, -18) + y, c + Vector3.new(W, 0, -D) + y)
	-- 남쪽 솟을대문
	for _, x in ipairs({ -10, 10 }) do
		part({ Name = "GatePillar", Size = Vector3.new(2, 14, 2), Position = c + Vector3.new(x, 7, D), Color = RED, Material = Enum.Material.Wood, Parent = f })
	end
	part({ Name = "GateBeam", Size = Vector3.new(24, 1.6, 2.4), Position = c + Vector3.new(0, 13.6, D), Color = Color3.fromRGB(60, 90, 70), Material = Enum.Material.Wood, Parent = f })
	part({ Name = "GateRoof", Size = Vector3.new(28, 1.2, 9), Position = c + Vector3.new(0, 14.8, D), Color = TILE, Material = Enum.Material.Slate, Parent = f })
	part({ Name = "GateRoof2", Size = Vector3.new(22, 1.4, 5), Position = c + Vector3.new(0, 16, D), Color = TILE:Lerp(Color3.new(0, 0, 0), 0.15), Material = Enum.Material.Slate, Parent = f })
	-- 북쪽 전각: 세 단의 돌 기단과 계단, 붉은 기둥 여섯, 두 겹 기와지붕, 현판
	local hall = c + Vector3.new(0, 0, -D + 14)
	for k = 0, 2 do
		part({ Name = "HallPlinth", Size = Vector3.new(60 - k * 4, 1.4, 22 - k * 2), Position = hall + Vector3.new(0, 0.7 + k * 1.4, -k), Color = Color3.fromRGB(170 - k * 10, 164 - k * 10, 150 - k * 10), Material = Enum.Material.Granite, Parent = f })
	end
	for k = 0, 2 do
		part({ Name = "HallStep", Size = Vector3.new(18, 1.4, 2.4), Position = hall + Vector3.new(0, 0.7 + k * 1.4, 11 + 2.4 * (2 - k)), Color = Color3.fromRGB(176, 170, 156), Material = Enum.Material.Granite, Parent = f })
	end
	local floorY = 4.2
	for i = -2, 3 do
		local x = (i - 0.5) * 9.6
		part({ Name = "HallPillar", Size = Vector3.new(1.8, 16, 1.8), Position = hall + Vector3.new(x, floorY + 8, 6), Color = RED, Material = Enum.Material.Wood, Parent = f })
	end
	part({ Name = "HallWall", Size = Vector3.new(50, 16, 1.2), Position = hall + Vector3.new(0, floorY + 8, -6), Color = Color3.fromRGB(226, 214, 190), Material = Enum.Material.Plaster, Parent = f })
	part({ Name = "HallBeam", Size = Vector3.new(52, 2, 14), Position = hall + Vector3.new(0, floorY + 17, 0), Color = Color3.fromRGB(60, 96, 76), Material = Enum.Material.Wood, Parent = f })
	part({ Name = "HallRoof", Size = Vector3.new(64, 1.6, 26), Position = hall + Vector3.new(0, floorY + 18.6, 0), Color = TILE, Material = Enum.Material.Slate, Parent = f })
	part({ Name = "HallRoof2", Size = Vector3.new(48, 2, 16), Position = hall + Vector3.new(0, floorY + 20.4, 0), Color = TILE:Lerp(Color3.new(0, 0, 0), 0.12), Material = Enum.Material.Slate, Parent = f })
	part({ Name = "HallRidge", Size = Vector3.new(40, 1.6, 3), Position = hall + Vector3.new(0, floorY + 22, 0), Color = TILE:Lerp(Color3.new(0, 0, 0), 0.25), Material = Enum.Material.Slate, Parent = f })
	local plaque = part({ Name = "HallPlaque", Size = Vector3.new(14, 3.6, 0.5), Position = hall + Vector3.new(0, floorY + 14.4, 7.4), Color = Color3.fromRGB(40, 28, 22), Material = Enum.Material.Wood, Parent = f })
	local sg = Instance.new("SurfaceGui")
	sg.Face = Enum.NormalId.Back
	sg.PixelsPerStud = 40
	sg.Parent = plaque
	local t = Instance.new("TextLabel")
	t.BackgroundTransparency = 1
	t.Size = UDim2.fromScale(1, 1)
	t.TextScaled = true
	t.Font = Enum.Font.Antique
	t.TextColor3 = Color3.fromRGB(255, 214, 130)
	t.Text = "比 武 堂"
	t.Parent = sg
	-- 전각 가운데 문: 붉은 빛의 막 (싸움터로)
	local veil = part({ Name = "ArenaVeil", Size = Vector3.new(9, 12, 0.4), Position = hall + Vector3.new(0, floorY + 6, -5.2), Color = Color3.fromRGB(255, 120, 80), Material = Enum.Material.Neon, Transparency = 0.45, CanCollide = false, Parent = f })
	local pp = Instance.new("ProximityPrompt")
	pp.Name = "ArenaGate"
	pp.ActionText = "싸움터로 들어가기 (지금 권법으로)"
	pp.ObjectText = "⚔ 비무당"
	pp.HoldDuration = 0
	pp.MaxActivationDistance = 16
	pp.RequiresLineOfSight = false
	pp.KeyboardKeyCode = Enum.KeyCode.T
	pp.Parent = veil
	-- 마당: 가운데 큰 향로, 양옆 석등 넷, 소나무 화분
	disc("CenserBase", c + Vector3.new(0, 1.2, 0), 3.4, 1.4, Color3.fromRGB(110, 96, 80), Enum.Material.Granite, f)
	part({ Name = "Censer", Shape = Enum.PartType.Ball, Size = Vector3.new(5, 4, 5), Position = c + Vector3.new(0, 3.6, 0), Color = Color3.fromRGB(150, 110, 60), Material = Enum.Material.Metal, Parent = f })
	local smoke = Instance.new("ParticleEmitter")
	smoke.Texture = "rbxasset://textures/particles/smoke_main.dds"
	smoke.Color = ColorSequence.new(Color3.fromRGB(230, 226, 220))
	smoke.Transparency = NumberSequence.new(0.6, 1)
	smoke.Size = NumberSequence.new(0.8, 3)
	smoke.Lifetime = NumberRange.new(3, 5)
	smoke.Speed = NumberRange.new(1, 2)
	smoke.Rate = 3
	smoke.Parent = part({ Name = "CenserTop", Size = Vector3.new(1, 1, 1), Position = c + Vector3.new(0, 6, 0), Transparency = 1, CanCollide = false, Parent = f })
	for _, x in ipairs({ -1, 1 }) do
		for _, z in ipairs({ -18, 14 }) do
			stoneLantern(c + Vector3.new(x * 24, 0.6, z), f)
		end
	end
	-- 동쪽: 담 밖 연못과 돌다리, 바위
	local pond = c + Vector3.new(W + 34, 0, 0)
	disc("PondEdge", pond + Vector3.new(0, 0.1, 0), 26, 0.6, Color3.fromRGB(150, 146, 136), Enum.Material.Cobblestone, f)
	disc("Pond", pond + Vector3.new(0, 0.25, 0), 23, 0.6, Color3.fromRGB(80, 140, 170), Enum.Material.Glass, f, false)
	part({ Name = "PondBridge", Size = Vector3.new(50, 1, 5), Position = pond + Vector3.new(-6, 1, 0), Color = Color3.fromRGB(150, 146, 136), Material = Enum.Material.Granite, Parent = f })
	for _ = 1, 6 do
		local a = G() * math.pi * 2
		rock(G, pond + Vector3.new(math.cos(a) * 25, 0, math.sin(a) * 25), 2.5 + G() * 2, Color3.fromRGB(120, 120, 112), Enum.Material.Slate, f, Color3.fromRGB(80, 120, 60))
	end
	for k = 1, 5 do
		disc("LilyPad", pond + Vector3.new((G() - 0.5) * 30, 0.6, (G() - 0.5) * 30), 1.6 + G(), 0.1, Color3.fromRGB(70, 140, 70), Enum.Material.Grass, f, false)
		if k % 2 == 0 then
			part({ Name = "Lotus", Shape = Enum.PartType.Ball, Size = Vector3.new(1.2, 0.9, 1.2), Position = pond + Vector3.new((G() - 0.5) * 30, 0.9, (G() - 0.5) * 30), Color = Color3.fromRGB(255, 180, 200), Material = Enum.Material.SmoothPlastic, CanCollide = false, Parent = f })
		end
	end
	-- 서쪽 마당 안: 수련 자리 (목인 둘), 무기 걸이
	local yard = c + Vector3.new(-W + 18, 0, 16)
	disc("YardSand", yard + Vector3.new(0, 0.62, 0), 14, 0.2, Color3.fromRGB(200, 184, 150), Enum.Material.Sand, f, false)
	part({ Name = "Rack", Size = Vector3.new(10, 6, 1), Position = yard + Vector3.new(0, 3.4, -15), Color = Color3.fromRGB(110, 80, 54), Material = Enum.Material.Wood, Parent = f })
	-- 담 밖 소나무 숲 (흩어져, 덩이져)
	local function pine(at: Vector3, h: number)
		part({ Name = "PineTrunk", Size = Vector3.new(1.6, h * 0.55, 1.6), CFrame = CFrame.new(at + Vector3.new(0, h * 0.27, 0)) * CFrame.Angles((G() - 0.5) * 0.12, 0, (G() - 0.5) * 0.12), Color = Color3.fromRGB(110, 70, 50), Material = Enum.Material.Wood, Parent = f })
		for k = 0, 2 do
			local s = (10 - k * 2.5) * (h / 22)
			part({ Name = "PineTop", Shape = Enum.PartType.Ball, Size = Vector3.new(s * 1.4, s * 0.55, s * 1.4), Position = at + Vector3.new((G() - 0.5) * 2, h * (0.55 + k * 0.17), (G() - 0.5) * 2), Color = Color3.fromRGB(46 + k * 8, 92 + k * 8, 58), Material = Enum.Material.Grass, CanCollide = false, Parent = f })
		end
	end
	local avoidL = { { Vector3.new(W + 34, 0, 0), 32 }, { Vector3.new(0, 0, D + 20), 26 } }
	for _, v in ipairs(scatter(G, 22, 100, 160, 22, avoidL)) do
		if math.abs(v.X) > W + 10 or math.abs(v.Z) > D + 10 then
			pine(c + v, 18 + G() * 12)
		end
	end
	fence(c, 165, 40, f)
	local spots = {}
	for _, v in ipairs(scatter(G, 10, 12, 40, 8)) do
		if math.abs(v.X) < W - 8 and v.Z > -D + 30 and v.Z < D - 6 then
			table.insert(spots, c + v + Vector3.new(0, 4, 0))
		end
	end
	if #spots == 0 then
		table.insert(spots, c + Vector3.new(0, 4, 20))
	end
	return { center = c, spots = spots, gate = pp, dummies = { yard + Vector3.new(-6, 3, 0), yard + Vector3.new(6, 3, 0) } }
end

function Battle.build(): any
	local f = Instance.new("Folder")
	f.Name = "BattleMaps"
	f.Parent = workspace
	for i, m in ipairs(B.maps) do
		local c = Vector3.new(20000 + (i - 1) * 2000, 0, 20000)
		local mf = Instance.new("Folder")
		mf.Name = m.id
		mf.Parent = f
		local fn = BUILD[m.id]
		local ok, info = pcall(fn, c, mf)
		if not ok then
			warn("[권왕] 배틀 맵 오류", m.id, info)
			info = { spawns = { c + Vector3.new(0, 6, 0) }, floorY = c.Y, R = 100 }
			part({ Name = "Floor", Size = Vector3.new(200, 2, 200), Position = c + Vector3.new(0, -1, 0), Color = Color3.fromRGB(120, 120, 120), Parent = mf })
		end
		table.insert(maps, { id = m.id, name = m.name, desc = m.desc, center = c, info = info, folder = mf })
	end
	lobby = buildLobby(Vector3.new(17000, 0, 20000), f)
	Battle.lobby = lobby
	-- 처음 태어나는 자리 (대기실)
	local sl = Instance.new("SpawnLocation")
	sl.Name = "BattleSpawn"
	sl.Anchored = true
	sl.Size = Vector3.new(8, 1, 8)
	sl.Transparency = 1
	sl.CanCollide = false
	sl.Neutral = true
	sl.Duration = 0
	sl.CFrame = CFrame.new(lobby.spots[1] - Vector3.new(0, 3, 0))
	sl.Parent = f
	Battle.spawnLoc = sl
	return { train = {}, rings = {} }
end

------------------------------------------------------------------------
-- 한 판의 흐름: 맵마다 mapTime초. 판이 끝나면 가장 많이 쓰러뜨린 사람이 이긴다
------------------------------------------------------------------------
local cur = 1
local roundEnd = 0
local inArena: { [Player]: boolean } = {}
local votes: { [Player]: number } = {}
function Battle.inArena(player: Player): boolean
	return inArena[player] == true
end
type Sess = { k: number, d: number, streak: number, rec: Rec, dirty: boolean, loaded: boolean }
local sess: { [Player]: Sess } = {}
local ctx: any = nil

function Battle.current(): any
	return maps[cur]
end

-- 다른 사람에게서 가장 먼 자리
function Battle.spawnCF(player: Player?): CFrame
	if player and not inArena[player] and lobby then
		local sp = lobby.spots[math.random(1, #lobby.spots)]
		return CFrame.lookAt(sp, Vector3.new(lobby.center.X, sp.Y, lobby.center.Z))
	end
	local m = maps[cur]
	local best, bestD = m.info.spawns[1], -1
	for _, sp in ipairs(m.info.spawns) do
		local near = math.huge
		for _, other in ipairs(Players:GetPlayers()) do
			if other ~= player and inArena[other] then
				local ch = other.Character
				local r = ch and ch:FindFirstChild("HumanoidRootPart")
				if r and r:IsA("BasePart") then
					near = math.min(near, (r.Position - sp).Magnitude)
				end
			end
		end
		near += math.random() * 6
		if near > bestD then
			best, bestD = sp, near
		end
	end
	return CFrame.lookAt(best, Vector3.new(m.center.X, best.Y, m.center.Z))
end

local function shield(f: any)
	f.battleShield = os.clock() + B.shield
	f.model:SetAttribute("BattleShield", true)
	task.delay(B.shield, function()
		if f.model and f.model.Parent and (f.battleShield or 0) <= os.clock() + 0.05 then
			f.model:SetAttribute("BattleShield", nil)
		end
	end)
end
Battle.shield = shield

local function loadRec(player: Player, s: Sess)
	local ds = store
	if not ds then
		s.loaded = true
		return
	end
	for attempt = 1, 3 do
		local ok, data = pcall(function()
			return ds:GetAsync("b_" .. player.UserId)
		end)
		if ok then
			s.rec = clean(data)
			s.loaded = true
			return
		end
		task.wait(attempt)
	end
end

-- 저장: 쌓인 것만 더한다 (다른 서버에서 같은 사람이 동시에 있을 일은 없지만, 메인 월드가 은자 몫을 받아 갔을 수 있다)
local function saveRec(player: Player)
	local s = sess[player]
	local ds = store
	if not s or not ds or not s.loaded or not s.dirty then
		return
	end
	local sa = s :: any
	local add = sa.add or blank()
	sa.add = blank()
	s.dirty = false
	local ok = pcall(function()
		ds:UpdateAsync("b_" .. player.UserId, function(old)
			local r = clean(old)
			r.kills += add.kills
			r.deaths += add.deaths
			r.wins += add.wins
			r.pending += add.pending
			r.best = math.max(r.best, add.best)
			return r
		end)
	end)
	if not ok then
		-- 못 썼으면 다음에 다시 (쌓인 몫을 되돌려 놓는다)
		local back = (s :: any).add
		for k, v in pairs(add) do
			if k == "best" then
				back.best = math.max(back.best, v)
			else
				back[k] += v
			end
		end
		s.dirty = true
	end
end
local function bump(player: Player, field: string, n: number)
	local s = sess[player]
	if not s then
		return
	end
	local sa = s :: any
	local add = sa.add or blank()
	sa.add = add
	if field == "best" then
		add.best = math.max(add.best, n)
		s.rec.best = math.max(s.rec.best, n)
	else
		local aa, rr = add :: any, s.rec :: any
		aa[field] += n
		rr[field] += n
	end
	s.dirty = true
end

function Battle.join(player: Player)
	local s: Sess = { k = 0, d = 0, streak = 0, rec = blank(), dirty = false, loaded = false }
	sess[player] = s
	task.spawn(loadRec, player, s)
end
function Battle.leave(player: Player)
	saveRec(player)
	sess[player] = nil
	inArena[player] = nil
	votes[player] = nil
end
function Battle.saveAll()
	for player in pairs(sess) do
		task.spawn(saveRec, player)
	end
end

local function coinsFor(player: Player, base: number): number
	local idx = ctx and ctx.realmOf and ctx.realmOf(player) or 1
	return math.floor(base * (1 + 0.5 * (idx - 1)))
end

-- 누가 쓰러졌다 (killer는 없을 수도: 떨어짐)
function Battle.onDeath(victim: Player, killer: Player?)
	local vs = sess[victim]
	if vs then
		vs.d += 1
		vs.streak = 0
		bump(victim, "deaths", 1)
	end
	local streak = 0
	if killer and killer ~= victim then
		local ks = sess[killer]
		if ks then
			ks.k += 1
			ks.streak += 1
			streak = ks.streak
			bump(killer, "kills", 1)
			bump(killer, "best", ks.streak)
			bump(killer, "pending", coinsFor(killer, B.coinsPerKill))
		end
	end
	if ctx then
		ctx.push:FireAllClients("battleKill", { killer = killer and killer.DisplayName or nil, victim = victim.DisplayName, streak = streak })
	end
	task.delay(B.respawn, function()
		if victim.Parent and ctx then
			ctx.respawn(victim)
		end
	end)
end

local function standings(): { any }
	local list = {}
	for player, s in pairs(sess) do
		table.insert(list, { id = player.UserId, name = player.DisplayName, k = s.k, d = s.d, streak = s.streak, total = s.rec.kills, arena = inArena[player] == true })
	end
	table.sort(list, function(a, b)
		if a.k ~= b.k then
			return a.k > b.k
		end
		return a.d < b.d
	end)
	return list
end

local function moveAllTo(idx: number)
	cur = idx
	for _, player in ipairs(Players:GetPlayers()) do
		if ctx and inArena[player] then
			ctx.respawn(player)
		end
	end
end

-- 다음 맵: 표가 가장 많은 맵 (같으면 차례대로 다음)
local function voteCounts(): { number }
	local n = {}
	for i = 1, #maps do
		n[i] = 0
	end
	for player, i in pairs(votes) do
		if player.Parent and n[i] then
			n[i] += 1
		end
	end
	return n
end
local function nextMap(): number
	local n = voteCounts()
	local best, bestN = cur % #maps + 1, 0
	for k = 1, #maps do
		local i = (cur + k - 1) % #maps + 1
		if n[i] > bestN then
			best, bestN = i, n[i]
		end
	end
	return best
end

-- 대기실 ↔ 싸움터, 투표. 안 되면 까닭을 돌려준다
function Battle.request(player: Player, action: string, arg: any): string?
	if not ctx then
		return nil
	end
	local f = ctx.fighter(player)
	if action == "battleEnter" then
		if inArena[player] then
			return "이미 싸움터에 있어요"
		end
		if not f or f.dead then
			return "잠시 뒤에 다시"
		end
		inArena[player] = true
		f.model:SetAttribute("InArena", true)
		ctx.respawn(player)
		ctx.push:FireClient(player, "battleNote", { text = "⚔ " .. maps[cur].name .. " 싸움터에 들어왔다! (5초 동안 보호)" })
		return nil
	elseif action == "battleLobby" then
		if not inArena[player] then
			return "이미 대기실이에요"
		end
		if f and f.combatUntil > os.clock() then
			return string.format("싸우는 중에는 나갈 수 없어요 (마지막으로 맞거나 때린 뒤 %d초)", B.lobbyLeave)
		end
		inArena[player] = nil
		if f then
			f.model:SetAttribute("InArena", nil)
		end
		ctx.respawn(player)
		return "🏯 대기실로 나왔어요"
	elseif action == "battleVote" then
		local i = math.floor(tonumber(arg) or 0)
		if i < 1 or i > #maps then
			return nil
		end
		votes[player] = i
		return "🗳 다음 맵으로 '" .. maps[i].name .. "'에 투표했어요"
	end
	return nil
end
-- 캐릭터가 새로 생기면 싸움터 표시를 다시 붙인다
function Battle.onCharacter(player: Player, model: Model)
	model:SetAttribute("InArena", inArena[player] or nil)
end

function Battle.start(c: any)
	ctx = c
	roundEnd = os.clock() + B.mapTime
	task.spawn(function()
		local warned = false
		local saveAt = os.clock() + 60
		while true do
			task.wait(1)
			local t = os.clock()
			local left = math.max(0, roundEnd - t)
			if left <= B.warnAt and not warned then
				warned = true
				local nxt = maps[nextMap()]
				ctx.push:FireAllClients("battleNote", { text = string.format("⏳ %d초 뒤 다음 맵: %s", B.warnAt, nxt.name) })
			end
			if left <= 0 then
				-- 판 끝: 가장 많이 쓰러뜨린 사람이 이긴다 (한 명도 못 쓰러뜨렸으면 없음)
				local st = standings()
				local top = st[1]
				local winnerName = nil
				if top and top.k > 0 then
					for player in pairs(sess) do
						if player.UserId == top.id then
							bump(player, "wins", 1)
							bump(player, "pending", coinsFor(player, B.coinsPerWin))
							winnerName = player.DisplayName
						end
					end
				end
				local nxt = nextMap()
				ctx.push:FireAllClients("battleRound", { winner = winnerName, kills = top and top.k or 0, map = maps[cur].name, next = maps[nxt].name })
				for _, s in pairs(sess) do
					s.k, s.d, s.streak = 0, 0, 0
				end
				table.clear(votes)
				moveAllTo(nxt)
				roundEnd = os.clock() + B.mapTime
				warned = false
			end
			-- 떨어지면 쓰러진다 (마지막에 때린 사람의 몫)
			local m = maps[cur]
			for _, player in ipairs(Players:GetPlayers()) do
				local f = ctx.fighter(player)
				if f and not f.dead and inArena[player] and f.root.Position.Y < m.info.floorY + B.fallY then
					ctx.kill(f)
				end
			end
			-- 모두에게 판 상태
			local st = standings()
			local arenaN = 0
			for _, on in pairs(inArena) do
				if on then
					arenaN += 1
				end
			end
			ctx.push:FireAllClients("battle", { map = m.name, desc = m.desc, left = math.floor(left), list = st, votes = voteCounts(), next = maps[nextMap()].name, arena = arenaN, total = #Players:GetPlayers() })
			if t >= saveAt then
				saveAt = t + 60
				Battle.saveAll()
			end
		end
	end)
end

function Battle.myRec(player: Player): any
	local s = sess[player]
	return s and s.rec or nil
end

return Battle
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="10">
        <Properties>
          <string name="Name">Combat</string>
          <string name="Source"><![CDATA[-- 권왕: 싸움 판정 (서버). 사람과 적을 똑같이 '무인'으로 다룬다
-- 사람의 맞힘은 화면이 먼저 알려 주고(바로 반응하게), 서버가 거리·시간을 확인해 정한다
-- 적의 맞힘은 서버가 직접 정한다
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage:WaitForChild("Config"))

local Combat = {}

export type Act = {
	move: any,
	slot: any,
	seq: number,
	start: number,
	dur: number,
	speed: number,
	done: { [string]: boolean }, -- "맞힘번호:대상" 한 번씩만
	swung: { [number]: boolean },
	charge: number,
	bloom: boolean,
	enemy: boolean,
}

export type Fighter = {
	model: Model,
	root: BasePart,
	hum: Humanoid,
	player: Player?,
	npc: any?, -- 적이면 적 정보
	name: string,
	hp: number,
	maxHp: number,
	posture: number,
	postureMax: number,
	chi: number,
	style: string,
	act: Act?,
	stunUntil: number,
	brokenUntil: number,
	iframeUntil: number,
	guarding: boolean,
	guardStart: number,
	counterUntil: number,
	buffs: { [string]: number },
	lastHurtAt: number,
	lastSwingAt: number,
	cds: { [string]: number },
	stacks: { flow: number, petal: number, petalAt: number, charge: number },
	dead: boolean,
	combatUntil: number,
	dmgMult: number,
	skillMult: number,
	walk: number,
	lastAttacker: Fighter?,
	dashAt: number,
	dashUsed: number,
}

Combat.fighters = {} :: { [Model]: Fighter }
Combat.projectiles = {} :: { any }
local Push: RemoteEvent
local hooks: { [string]: any } = {}
-- 불타는 상대 (열화신권 연소)
local burning: { [any]: boolean } = {}

function Combat.init(push: RemoteEvent, h: { [string]: any })
	Push = push
	hooks = h
end

local function now(): number
	return os.clock()
end

-- 강호의 낮 (6시~18시): 일월신권이 해의 힘을 쓴다
local Lighting = game:GetService("Lighting")
local function isDay(): boolean
	local h = Lighting.ClockTime
	return h >= 6 and h < 18
end
Combat.isDay = isDay

local function flat(v: Vector3): Vector3
	local f = Vector3.new(v.X, 0, v.Z)
	if f.Magnitude < 1e-4 then
		return Vector3.new(0, 0, -1)
	end
	return f.Unit
end

function Combat.look(f: Fighter): Vector3
	return flat(f.root.CFrame.LookVector)
end

function Combat.styleOf(f: Fighter): any
	return Config.STYLE_BY_ID[f.style]
end

-- 비무대 위인지
function Combat.onRing(pos: Vector3): boolean
	local R = Config.RING
	return math.abs(pos.X - R.center.X) <= R.size / 2 and math.abs(pos.Z - R.center.Z) <= R.size / 2 and pos.Y > R.height - 1
end

-- 탈것: 타기 (탄 사람을 들어 올리고 빨라진다) / 내리기
function Combat.mount(f: Fighter, id: string)
	local m = Config.MOUNT_BY_ID[id]
	if not m or not f.hum then
		return
	end
	local fa = f :: any
	if not fa.mountMult then
		fa.baseHip = f.hum.HipHeight
	end
	fa.mountMult = m.speed
	f.hum.HipHeight = (fa.baseHip or f.hum.HipHeight) + (Config.MOUNT_HIP[m.kind] or 2)
	f.model:SetAttribute("Mount", id)
end
function Combat.dismount(f: Fighter)
	local fa = f :: any
	if not fa.mountMult then
		return
	end
	fa.mountMult = nil
	if f.hum and fa.baseHip then
		f.hum.HipHeight = fa.baseHip
	end
	f.model:SetAttribute("Mount", nil)
end

-- 서로 때릴 수 있는 사이인지
function Combat.hostile(a: Fighter, b: Fighter): boolean
	if a == b or a.dead or b.dead then
		return false
	end
	if a.player and b.player then
		-- 3.4.1판: 메인 월드의 들판 PvP를 되살린다. 안전한 곳 밖에서는 사람끼리도 싸운다 (PvP를 끈 사람은 빼고, 끄려면 사람에게 한 번 쓰러져야)
		if not Config.BATTLE_MODE then
			if Config.inSafe(a.root.Position) or Config.inSafe(b.root.Position) then
				return false
			end
			return a.model:GetAttribute("PvpOff") ~= true and b.model:GetAttribute("PvpOff") ~= true
		end
		-- 3.3.1판: 둘 다 싸움터에 있어야 (대기실에서는 싸우지 않는다)
		if a.model:GetAttribute("InArena") ~= true or b.model:GetAttribute("InArena") ~= true then
			return false
		end
		local t = now()
		return t >= ((a :: any).battleShield or 0) and t >= ((b :: any).battleShield or 0)
	end
	if not a.player and not b.player then
		return false
	end
	return true
end

function Combat.register(model: Model, info: any): Fighter
	local root = model:FindFirstChild("HumanoidRootPart") :: BasePart
	local hum = model:FindFirstChildOfClass("Humanoid") :: Humanoid
	local f: Fighter = {
		model = model,
		root = root,
		hum = hum,
		player = info.player,
		npc = info.npc,
		name = info.name or model.Name,
		hp = info.hp,
		maxHp = info.hp,
		posture = 0,
		postureMax = info.postureMax or Config.POSTURE_MAX,
		chi = 0,
		style = info.style or "",
		act = nil,
		stunUntil = 0,
		brokenUntil = 0,
		iframeUntil = 0,
		guarding = false,
		guardStart = 0,
		counterUntil = 0,
		buffs = {},
		lastHurtAt = 0,
		lastSwingAt = -10,
		cds = {},
		stacks = { flow = 0, petal = 0, petalAt = 0, charge = 0 },
		dead = false,
		combatUntil = 0,
		dmgMult = info.dmgMult or 1,
		skillMult = info.skillMult or 1,
		walk = info.walk or Config.WALK_SPEED,
		lastAttacker = nil,
		dashAt = 0,
		dashUsed = 0,
	}
	Combat.fighters[model] = f
	Combat.sync(f)
	return f
end

function Combat.unregister(model: Model)
	Combat.fighters[model] = nil
end

-- 화면이 읽는 값 (모델 속성)
function Combat.sync(f: Fighter)
	local m = f.model
	m:SetAttribute("Hp", math.max(0, math.floor(f.hp + 0.5)))
	m:SetAttribute("MaxHp", f.maxHp)
	m:SetAttribute("Posture", math.floor(f.posture + 0.5))
	m:SetAttribute("PostureMax", f.postureMax)
	m:SetAttribute("Chi", math.floor(f.chi))
	m:SetAttribute("Style", f.style)
	m:SetAttribute("Guard", f.guarding)
	m:SetAttribute("Flow", f.stacks.flow)
	m:SetAttribute("Petal", f.stacks.petal)
	m:SetAttribute("Charge", f.stacks.charge)
	m:SetAttribute("Dead", f.dead)
end

function Combat.stunned(f: Fighter): boolean
	return now() < f.stunUntil or f.dead
end

-- 2.7.7판: 사람이 기술(E·R·G·X)을 쓰는 동안은 맞아도 끊기지 않는다 (피해는 받는다).
-- 전엔 기술을 쓰다 맞거나 격돌이 나면 동작이 끊겨, 내공만 쓰고 장풍·맞힘이 사라지곤 했다
local SKILL_SLOT = { E = true, R = true, G = true, X = true }
local function castingSkill(f: Fighter): boolean
	local act = f.act
	return f.player ~= nil and act ~= nil and SKILL_SLOT[act.slot] == true and now() < act.start + act.dur
end
Combat.castingSkill = castingSkill

-- 지금 무엇에도 밀리지 않는지 (기술의 armor, 철포삼, 금강체, 사람이 쓰는 기술)
local function armored(f: Fighter): boolean
	local t = now()
	if castingSkill(f) then
		return true
	end
	if (f.buffs.ironshirt or 0) > t or (f.buffs.giant or 0) > t then
		return true
	end
	local act = f.act
	if act and t < act.start + act.dur then
		if act.move.armor then
			return true
		end
		local style = Combat.styleOf(f)
		if style and style.armorWhileAttacking and not act.enemy then
			return true
		end
	end
	return false
end

-- 받는 피해 배율
local function defense(f: Fighter): number
	local t = now()
	local m = 1
	if (f.buffs.ironshirt or 0) > t then
		m *= 0.5
	end
	if (f.buffs.giant or 0) > t then
		m *= 0.5
	end
	local style = Combat.styleOf(f)
	local act = f.act
	if style and style.armorWhileAttacking and act and t < act.start + act.dur then
		m *= style.armorWhileAttacking
	end
	-- 진 금강불괴: 늘 덜 아프다
	if style and style.hurtTaken then
		m *= style.hurtTaken
	end
	-- 심법: 금강호체공
	m *= 1 - ((f :: any).mDef or 0)
	return m
end

local function interrupt(f: Fighter)
	if f.act and not castingSkill(f) then
		f.act = nil
		Push:FireAllClients("interrupt", f.model)
	end
end

-- 안전 지대 (마을, 사부의 자리)
local function inSafe(pos: Vector3): boolean
	return Config.inSafe(pos)
end

local function knock(f: Fighter, vel: Vector3, stun: number)
	if f.player then
		Push:FireClient(f.player, "knock", vel, stun)
	elseif f.root and f.root.Parent and not f.root.Anchored then
		f.root.AssemblyLinearVelocity = vel
	end
end

-- 흘리기: 친 쪽은 헛힘에 앞으로 지나쳐 옆으로 흘러가고, 흘린 쪽은 반대로 살짝 비켜선다
local function redirect(tgt: Fighter, att: Fighter): number
	local right = tgt.root.CFrame.RightVector
	local rel = att.root.Position - tgt.root.Position
	local side = right:Dot(rel) >= 0 and 1 or -1
	local attLook = att.root.CFrame.LookVector
	knock(att, Vector3.new(attLook.X, 0, attLook.Z) * 18 + Vector3.new(right.X, 0, right.Z) * side * 16, 0)
	knock(tgt, -Vector3.new(right.X, 0, right.Z) * side * 7, 0)
	return side
end

function Combat.stun(f: Fighter, dur: number)
	f.stunUntil = math.max(f.stunUntil, now() + dur)
	interrupt(f)
	f.guarding = false
end

local function addChi(f: Fighter, amount: number)
	if f.player then
		f.chi = math.clamp(f.chi + amount, 0, (f :: any).chiMax or Config.CHI_MAX)
	end
end

local function addPosture(f: Fighter, amount: number): boolean
	-- 사람은 균형이 쉽게 무너지지 않는다 (사자후 같은 막기 깨기는 그대로)
	if f.player and amount < f.postureMax then
		amount *= Config.PLAYER_POSTURE_TAKEN
	end
	f.posture += amount
	f.lastHurtAt = now()
	if f.posture >= f.postureMax then
		-- 파훼
		f.posture = f.postureMax
		f.brokenUntil = now() + Config.BREAK_STUN
		Combat.stun(f, Config.BREAK_STUN)
		Push:FireAllClients("broken", f.model, Config.BREAK_STUN)
		return true
	end
	return false
end

-- 막기를 깨부순다 (사자후): 균형을 가득 채워 파훼
function Combat.breakGuard(f: Fighter)
	if f.dead then
		return
	end
	f.guarding = false
	addPosture(f, f.postureMax)
end

function Combat.kill(f: Fighter, by: Fighter?)
	if f.dead then
		return
	end
	-- 수련 목인은 쓰러지지 않는다 (다시 가득 찬다)
	-- 시험의 사부 (흘리기·버티기)도 쓰러지지 않는다
	if f.npc and ((f.npc :: any).dummy or (f :: any).trialImmortal) then
		f.hp = f.maxHp
		Combat.sync(f)
		return
	end
	Combat.dismount(f)
	f.dead = true
	f.hp = 0
	f.act = nil
	f.guarding = false
	Combat.sync(f)
	Push:FireAllClients("ko", f.model, by and by.model or nil)
	-- 무쌍신권: 쓰러뜨릴 때마다 숨이 돌아온다
	local bStyle = by and Combat.styleOf(by)
	if by and bStyle and bStyle.killHeal and by.player and not by.dead then
		by.hp = math.min(by.maxHp, by.hp + by.maxHp * bStyle.killHeal)
		by.chi = math.min((by :: any).chiMax or Config.CHI_MAX, by.chi + 20)
		Combat.sync(by)
	end
	-- 2.0판 진 열화 업화: 불타던 적이 쓰러지면 그 자리에서 터져 둘레를 태운다
	local fb = f :: any
	local burner = fb.burnBy
	if burner and (fb.burnUntil or 0) > now() and not burner.dead then
		local bs = Combat.styleOf(burner)
		local bb = bs and bs.burnBurst
		if bb then
			local at = f.root.Position
			Push:FireAllClients("skillfx", { kind = "ignite", at = at, radius = bb.radius, style = burner.style })
			task.defer(function()
				for _, other in pairs(Combat.fighters) do
					if other ~= f and Combat.hostile(burner, other) and not other.dead and (other.root.Position - at).Magnitude <= bb.radius then
						Combat.applyHit(burner, other, { dmg = bb.dmg, posture = bb.posture, stun = 0.5, kb = 26, up = 10 }, { chain = true, isSkill = true, move = { name = "업화 폭렬" } })
					end
				end
			end)
		end
	end
	if hooks.onKill then
		hooks.onKill(f, by)
	end
end

-- 3.3판 배틀그라운드: 사람이 받는 피해를 눌러 담고 (기술 크기의 거듭제곱), 한 대·1초 상한을 둔다
local function battleShape(att: Fighter, tgt: Fighter, d: number): number
	if not Config.BATTLE_MODE or not tgt.player or d <= 0 then
		return d
	end
	local B = Config.BATTLE
	-- 그 권법의 연타 한 대를 ref로 (권법마다 기본 피해 크기가 다르다)
	local n = d * B.ref / Config.battleScale(Combat.styleOf(att))
	local v = B.dmgK * n ^ B.dmgPow
	v = math.min(v, B.hitCap)
	local t = now()
	local ft = tgt :: any
	if t - (ft.bWinAt or 0) >= 1 then
		ft.bWinAt = t
		ft.bWinSum = 0
	end
	v = math.max(0, math.min(v, B.secCap - (ft.bWinSum or 0)))
	ft.bWinSum = (ft.bWinSum or 0) + v
	return v
end
Combat.battleShape = battleShape

-- 피해 숫자 (공격자 쪽 배율)
local function damageOf(att: Fighter, hit: any, move: any, isSkill: boolean, act: Act?): number
	local d = hit.dmg * att.dmgMult
	-- 금강 법신: 거인이 된 동안 모든 주먹이 1.6배
	if (att.buffs.giant or 0) > now() then
		d *= 1.6
	end
	if isSkill then
		d *= att.skillMult
	end
	-- 1.9판 초·혈마 피의 계약: 체력이 깎일수록 더 깊이 벤다
	local pact = Combat.styleOf(att)
	if pact and pact.bloodPact and att.maxHp > 0 then
		d *= 1 + pact.bloodPact * (1 - math.clamp(att.hp / att.maxHp, 0, 1))
	end
	if act and act.charge > 0 and move.chargeMult then
		local style = Combat.styleOf(att)
		local k = math.clamp(act.charge / (style and style.charge or 1.5), 0, 1)
		d *= 1 + (move.chargeMult - 1) * k
	end
	return d
end

-- 1.9판 진 금강불괴: 맞은 횟수가 쌓이면 몸에서 진동이 터져 둘레를 날린다
local function hurtPulse(tgt: Fighter, style: any)
	local hp = style and style.hurtPulse
	if not hp or tgt.dead then
		return
	end
	local ft = tgt :: any
	ft.hurtN = (ft.hurtN or 0) + 1
	tgt.model:SetAttribute("HurtN", ft.hurtN)
	if ft.hurtN < hp.every then
		return
	end
	ft.hurtN = 0
	tgt.model:SetAttribute("HurtN", 0)
	local at = tgt.root.Position
	Push:FireAllClients("skillfx", { kind = "vajraQuake", m = tgt.model, at = at, radius = hp.radius, style = tgt.style })
	task.defer(function()
		for _, other in pairs(Combat.fighters) do
			if Combat.hostile(tgt, other) and not other.dead and (other.root.Position - at).Magnitude <= hp.radius then
				Combat.applyHit(tgt, other, { dmg = hp.dmg, posture = hp.posture, stun = hp.stun, kb = hp.kb, up = hp.up }, { chain = true, isSkill = true, move = { name = hp.name } })
			end
		end
	end)
end

------------------------------------------------------------------------
-- 한 번 맞히기. kind를 돌려준다: hit / block / deflect / guardbreak / clash / dodge / counter / miss
-- opt = { move, act, isSkill, unblockable, slotKey, chain }
------------------------------------------------------------------------
function Combat.applyHit(att: Fighter, tgt: Fighter, hit: any, opt: any): string
	-- 배틀그라운드: 일어난 뒤의 보호는 먼저 때리면 풀린다
	if Config.BATTLE_MODE and att.player and ((att :: any).battleShield or 0) > 0 then
		(att :: any).battleShield = 0
		att.model:SetAttribute("BattleShield", nil)
	end
	if not Combat.hostile(att, tgt) then
		return "miss"
	end
	local t = now()
	if t < tgt.iframeUntil then
		-- 見切り: 맞기 직전에 대시로 피했다 → 상대가 잠깐 굳고, 곧바로 클릭하면 반격
		local fa = tgt :: any
		if tgt.player and t - tgt.dashAt < 0.4 and t - (fa.pdodgeAt or 0) > 0.6 then
			fa.pdodgeAt = t
			fa.deflectAt = t
			att.stunUntil = math.max(att.stunUntil, t + 0.45)
			interrupt(att)
			Push:FireAllClients("pdodge", { m = tgt.model, a = att.model })
		else
			Push:FireAllClients("hit", { a = att.model, t = tgt.model, kind = "dodge", pos = tgt.root.Position })
		end
		return "dodge"
	end
	local move = opt.move or {}
	local toAtt = flat(att.root.Position - tgt.root.Position)
	local facing = Combat.look(tgt):Dot(toAtt)
	local pos = tgt.root.Position:Lerp(att.root.Position, 0.35) + Vector3.new(0, 1, 0)
	att.combatUntil = t + Config.COMBAT_TAG
	tgt.combatUntil = t + Config.COMBAT_TAG
	tgt.lastAttacker = att

	-- 전투력 차이: 훨씬 약한 적의 공격은 덜 아프거나, 끄떡없거나, 호신강기에 튕겨 나간다 (붉은 공격도)
	local gapMul, steady = 1, false
	if att.npc and tgt.player then
		local pa, pt = (att :: any).power or 100, (tgt :: any).power or 100
		local immune
		gapMul, steady, immune = Config.powerGap(pt / math.max(1, pa))
		if immune then
			att.stunUntil = math.max(att.stunUntil, t + 0.45)
			interrupt(att)
			knock(att, toAtt * 22 + Vector3.new(0, 8, 0), 0.45)
			Push:FireAllClients("hit", { a = att.model, t = tgt.model, kind = "aura", pos = pos })
			return "immune"
		end
	end

	-- 격돌: 상대도 같은 순간 나를 향해 휘둘렀다
	if not opt.chain and not opt.proj and math.abs(tgt.lastSwingAt - t) <= Config.CLASH_WINDOW and facing > 0.5 and tgt.act and not move.aoe and not castingSkill(att) and not castingSkill(tgt) then
		-- 둘 다 서로 반대쪽으로 튕겨 난다
		knock(att, toAtt * 18 + Vector3.new(0, 6, 0), 0.3)
		knock(tgt, -toAtt * 18 + Vector3.new(0, 6, 0), 0.3)
		addPosture(att, 10)
		addPosture(tgt, 10)
		interrupt(att)
		interrupt(tgt)
		att.stunUntil = math.max(att.stunUntil, t + 0.3)
		tgt.stunUntil = math.max(tgt.stunUntil, t + 0.3)
		Push:FireAllClients("hit", { a = att.model, t = tgt.model, kind = "clash", pos = pos })
		return "clash"
	end

	-- 만류귀종: 잠깐 모든 공격을 저절로 흘려 되받아친다 (막을 수 없는 공격도)
	local ta = tgt :: any
	if t < (ta.reflectUntil or 0) and not opt.chain then
		att.stunUntil = math.max(att.stunUntil, t + 0.6)
		interrupt(att)
		local side = redirect(tgt, att)
		Push:FireAllClients("hit", { a = att.model, t = tgt.model, kind = "deflect", pos = pos, counter = true, side = side })
		local rh = ta.reflectHit
		if rh then
			task.defer(function()
				if not tgt.dead and not att.dead then
					Combat.applyHit(tgt, att, rh, { move = { name = "되흘림" }, isSkill = true, chain = true })
				end
			end)
		end
		return "counter"
	end

	local tStyle = Combat.styleOf(tgt)
	-- 취권: 비틀거려 저절로 피한다
	if tStyle and tStyle.dodgeChance and not opt.unblockable then
		local chance = 0
		if (tgt.buffs.sway or 0) > t then
			chance = 0.6
		elseif tgt.act or tgt.root.AssemblyLinearVelocity.Magnitude > 4 then
			chance = tStyle.dodgeChance
		end
		if chance > 0 and math.random() < chance then
			Push:FireAllClients("hit", { a = att.model, t = tgt.model, kind = "dodge", pos = pos, drunk = true })
			if (tgt.buffs.sway or 0) > t then
				-- 취보 중엔 피하면서 되받아친다
				task.defer(function()
					Combat.applyHit(tgt, att, { dmg = 6, posture = 10, stun = 0.4, kb = 10 }, { chain = true })
				end)
			end
			return "dodge"
		end
	end

	-- 태허 유수회선: 받아넘기고 되받아친다
	if t < tgt.counterUntil and not opt.unblockable and facing > -0.2 then
		tgt.counterUntil = 0
		addPosture(att, (hit.posture or 10) * Config.DEFLECT_POSTURE)
		att.stunUntil = math.max(att.stunUntil, t + Config.DEFLECT_STAGGER)
		interrupt(att)
		tgt.stacks.flow = math.min(3, tgt.stacks.flow + 1)
		local side = redirect(tgt, att)
		Push:FireAllClients("hit", { a = att.model, t = tgt.model, kind = "deflect", pos = pos, counter = true, side = side })
		;(tgt :: any).deflectAt = now()
		local style = Combat.styleOf(tgt)
		local ch = style and style.skills.E.counterHit
		if ch then
			Push:FireAllClients("act", { m = tgt.model, style = tgt.style, pose = ch.pose, dur = 0.5, seq = -1 })
			task.delay(0.12, function()
				if not tgt.dead and not att.dead then
					Combat.applyHit(tgt, att, ch.hit, { move = { name = "되받아치기" }, isSkill = true, chain = true })
				end
			end)
		end
		Combat.sync(tgt)
		return "counter"
	end

	local postureDmg = (hit.posture or 0)
	local aStyle0 = Combat.styleOf(att)
	if aStyle0 and aStyle0.postureMult then
		postureDmg *= aStyle0.postureMult
	end
	-- 막기·흘리기 (앞에서 온 것만, 막을 수 없는 공격은 안 된다)
	if tgt.guarding and facing > 0.2 and not opt.unblockable and not opt.chain then
		local window = (tStyle and tStyle.deflect or Config.DEFLECT_WINDOW) * ((tgt :: any).deflectMul or 1) + 0.06 -- 0.06 = 통신 늦음 여유
		if t - tgt.guardStart <= window then
			-- 흘리기 성공
			local broke = addPosture(att, postureDmg * Config.DEFLECT_POSTURE + 6)
			if not broke then
				att.stunUntil = math.max(att.stunUntil, t + Config.DEFLECT_STAGGER)
				interrupt(att)
			end
			tgt.posture = math.max(0, tgt.posture - 6)
			addChi(tgt, Config.CHI_ON_DEFLECT)
			if tStyle and tStyle.id == "taeheo" then
				tgt.stacks.flow = math.min(3, tgt.stacks.flow + 1)
			end
			Combat.sync(tgt)
			Combat.sync(att)
			local side = redirect(tgt, att)
			Push:FireAllClients("hit", { a = att.model, t = tgt.model, kind = "deflect", pos = pos, side = side })
			;(tgt :: any).deflectAt = now()
			-- 1.9판 진 태허: 흘려 낸 힘이 물결이 되어 둘레로 터진다
			local dw = tStyle and tStyle.deflectWave
			if dw and t - ((tgt :: any).waveAt or 0) > 0.35 then
				(tgt :: any).waveAt = t
				local at = tgt.root.Position
				Push:FireAllClients("skillfx", { kind = "flowWave", m = tgt.model, at = at, radius = dw.radius, style = tgt.style })
				task.defer(function()
					for _, other in pairs(Combat.fighters) do
						if Combat.hostile(tgt, other) and not other.dead and (other.root.Position - at).Magnitude <= dw.radius then
							Combat.applyHit(tgt, other, { dmg = dw.dmg, posture = dw.posture, stun = dw.stun, kb = dw.kb, up = dw.up }, { chain = true, isSkill = true, move = { name = "역류" } })
						end
					end
				end)
			end
			if hooks.onDeflect then
				hooks.onDeflect(tgt, att)
			end
			return "deflect"
		end
		-- 그냥 막기 (만취한 권법은 막지 못하고 그대로 맞는다)
	end
	if tgt.guarding and facing > 0.2 and not opt.unblockable and not opt.chain and not (tStyle and tStyle.noBlock) then
		local d = damageOf(att, hit, move, opt.isSkill, opt.act) * Config.BLOCK_DAMAGE * (tStyle and tStyle.weakBlock or 1) * defense(tgt) * gapMul
		d = battleShape(att, tgt, d)
		tgt.hp -= d
		local broke = (not steady) and addPosture(tgt, postureDmg * Config.BLOCK_POSTURE)
		if not steady then
			knock(tgt, -toAtt * math.min(20, (hit.kb or 0) * 0.4 + 4), 0)
		end
		addChi(tgt, d * Config.CHI_ON_HURT)
		Combat.sync(tgt)
		Push:FireAllClients("hit", { a = att.model, t = tgt.model, kind = broke and "guardbreak" or "block", pos = pos, dmg = d })
		if tgt.hp <= 0 then
			Combat.kill(tgt, att)
		else
			hurtPulse(tgt, tStyle)
		end
		return broke and "guardbreak" or "block"
	end

	-- 맞았다
	local d = damageOf(att, hit, move, opt.isSkill, opt.act) * defense(tgt) * gapMul
	local crit = false
	local aStyle = Combat.styleOf(att)
	if aStyle and aStyle.backstab and facing < -0.3 then
		d *= aStyle.backstab
		crit = true
	end
	-- 일월: 낮에는 해의 주먹 (주는 피해 증가), 밤에는 달의 몸 (받는 피해 감소)
	if aStyle and aStyle.sunMoon and isDay() then
		d *= aStyle.sunMoon.day
	end
	if tStyle and tStyle.sunMoon and not isDay() then
		d *= tStyle.sunMoon.night
	end
	-- 무쌍신권: 사람을 상대로 더 세다
	if aStyle and aStyle.pvpDmg and tgt.player and att.player then
		d *= aStyle.pvpDmg
	end
	if opt.teleport then
		crit = true
	end
	-- 카운터: 적이 휘두르려고 멈칫한 사이에 먼저 꽂으면 1.5배, 그 공격이 끊긴다
	local counterHit = false
	if tgt.npc and tgt.act and tgt.act.move and t < tgt.act.start + (tgt.act.move.windup or 0) then
		d *= 1.5
		crit = true
		counterHit = true
		interrupt(tgt)
	end
	local wasBroken = t < tgt.brokenUntil
	if wasBroken then
		d *= Config.BROKEN_MULT
		tgt.brokenUntil = 0
		tgt.posture = 0
		crit = true
	end
	d = battleShape(att, tgt, d)
	tgt.hp -= d
	if tgt.player then
		Combat.dismount(tgt)
	end
	-- 흡혈 (혈마신수)
	-- 한 대에도, 1초에도 되찾는 양에 한도가 있다
	local function steal(amount: number, secCap: number)
		local a = att :: any
		if t - (a.stealAt or 0) >= 1 then
			a.stealAt = t
			a.stealSum = 0
		end
		local room = math.max(0, att.maxHp * secCap - (a.stealSum or 0))
		local heal = math.min(amount, att.maxHp * Config.LIFESTEAL_HIT_CAP, room)
		a.stealSum = (a.stealSum or 0) + heal
		att.hp = math.min(att.maxHp, att.hp + heal)
	end
	if aStyle and aStyle.lifesteal and att.player and not att.dead then
		steal(d * aStyle.lifesteal * ((att.buffs.frenzy or 0) > t and Config.LIFESTEAL_FRENZY or 1), aStyle.id == "hyeolma2" and 0.05 or Config.LIFESTEAL_SEC_CAP)
		att.model:SetAttribute("Hp", math.floor(att.hp + 0.5))
	end
	-- 심법: 혈기공 (모든 권법에서 조금씩)
	local mSteal = (att :: any).mSteal or 0
	if mSteal > 0 and att.player and not att.dead then
		steal(d * mSteal, Config.LIFESTEAL_SEC_CAP)
		att.model:SetAttribute("Hp", math.floor(att.hp + 0.5))
	end
	if not steady then
		addPosture(tgt, postureDmg * 0.4)
	end
	local heavy = not steady and ((hit.kb or 0) >= 20 or (hit.stun or 0) >= 0.6 or wasBroken)
	if not armored(tgt) and not steady then
		local stun = hit.stun or 0.3
		local fa = tgt :: any
		if tgt.npc or (Config.BATTLE_MODE and tgt.player) then
			-- 적은 경직이 짧고, 2.5초 안에 너무 오래 묶이면 잠깐 버티며 곧바로 되받아친다 (무한 경직 방지)
			-- 3.3판: 배틀그라운드의 사람도 같다 (누구도 끝까지 묶여 맞지 않게)
			stun *= 0.6
			if t - (fa.poiseAt or 0) > 2.5 then
				fa.poiseAt = t
				fa.poiseSum = 0
			end
			fa.poiseSum = (fa.poiseSum or 0) + stun
			if fa.poiseSum > 1.2 and t >= (fa.poiseUntil or 0) then
				fa.poiseSum = 0
				fa.poiseUntil = t + 1.5
				fa.retaliate = true
				tgt.model:SetAttribute("Poise", true)
				Push:FireAllClients("poise", tgt.model)
				task.delay(1.5, function()
					if tgt.model.Parent then
						tgt.model:SetAttribute("Poise", nil)
					end
				end)
			end
			if t < (fa.poiseUntil or 0) and not heavy and not wasBroken then
				stun = 0
			end
		end
		if stun > 0 then
			if (hit.up or 0) >= 25 then
				tgt.model:SetAttribute("LaunchedAt", t)
			end
			Combat.stun(tgt, stun)
			local dir = flat(tgt.root.Position - att.root.Position)
			local kb = (hit.kb or 0) * (wasBroken and 1.5 or 1) * (aStyle and aStyle.kbMult or 1)
			knock(tgt, dir * kb + Vector3.new(0, (hit.up or 0) + (kb > 25 and 12 or 0), 0), stun)
		end
	end
	addChi(att, d * Config.CHI_ON_HIT)
	addChi(tgt, d * Config.CHI_ON_HURT)

	-- 공격한 쪽 권법 장치: 꽃잎, 전하
	local chain = false
	local star = false
	local pulse: any = nil
	if aStyle and not opt.chain then
		if aStyle.starEvery then
			-- 개천: 다섯 번 맞힐 때마다 별이 떨어진다
			local fa = att :: any
			fa.starN = (fa.starN or 0) + 1
			if fa.starN >= aStyle.starEvery then
				fa.starN = 0
				star = true
			end
		end
		-- 3.1판: 극 권법의 황혼 동안은 황혼의 연타 장치
		local aPulse = aStyle.twilight and ((att :: any).twilightUntil or 0) > t and aStyle.twilight.pulse or aStyle.pulse
		if aPulse then
			-- 파천 중압·태초 창세: 정해진 수만큼 맞히면 상대 자리에서 터진다
			local fa = att :: any
			fa.pulseN = (fa.pulseN or 0) + 1
			-- 3.4판: chance가 있으면 그 사이에도 가끔 (every번째는 반드시)
			if fa.pulseN >= aPulse.every or (aPulse.chance and math.random() < aPulse.chance) then
				fa.pulseN = 0
				pulse = aPulse
			end
			att.model:SetAttribute("Pulse", fa.pulseN)
		end
		if aStyle.id == "maehwa" or aStyle.petals then
			att.stacks.petal = math.min(aStyle.petalMax or 20, att.stacks.petal + 1)
			att.stacks.petalAt = t
		elseif aStyle.chargeEvery then
			att.stacks.charge += 1
			if att.stacks.charge >= aStyle.chargeEvery then
				att.stacks.charge = 0
				chain = true
			end
		end
	end
	Combat.sync(att)
	Combat.sync(tgt)
	Push:FireAllClients("hit", {
		a = att.model,
		t = tgt.model,
		kind = "hit",
		pos = pos,
		dmg = d,
		heavy = heavy,
		crit = crit,
		style = att.style,
		skill = opt.isSkill == true,
		strike = move.strike == true,
		pose = move.pose,
		broken = wasBroken,
		counter = counterHit,
		steady = steady,
	})
	if hooks.onHit then
		hooks.onHit(att, tgt, d, opt)
	end
	-- 열화 연소: 맞은 적에게 불이 붙는다 (계속 타며 피해)
	if aStyle and aStyle.burn and not opt.chain and tgt.hp > 0 then
		local b = aStyle.burn
		local fb = tgt :: any
		fb.burnUntil = t + b.dur
		fb.burnBy = att
		fb.burnDmg = b.dmg
		fb.burnEvery = b.every
		fb.burnNext = fb.burnNext and math.min(fb.burnNext, t + b.every) or t + b.every
		if not burning[tgt] then
			burning[tgt] = true
			tgt.model:SetAttribute("Burning", true)
		end
	end
	-- 폭염: 불타는 적에게 강타를 꽂으면 터져 둘레까지 태운다
	if move.ignite and not opt.chain and ((tgt :: any).burnUntil or 0) > t then
		local at = tgt.root.Position
		local ig = move.ignite
		Push:FireAllClients("skillfx", { kind = "ignite", at = at, radius = ig.radius, style = att.style })
		for _, other in pairs(Combat.fighters) do
			if Combat.hostile(att, other) and not other.dead and (other.root.Position - at).Magnitude <= ig.radius then
				Combat.applyHit(att, other, { dmg = ig.dmg, posture = ig.posture or 20, stun = 0.6, kb = 30, up = 10 }, { chain = true, isSkill = true, move = { name = "폭염" } })
			end
		end
	end
	if tgt.hp <= 0 then
		Combat.kill(tgt, att)
	else
		hurtPulse(tgt, tStyle)
	end
	-- 1.9판 진 무영: 그림자가 한 박자 뒤 같은 자리를 한 번 더 찬다 (연타·강타만)
	if aStyle and aStyle.shadowEcho and not opt.chain and not opt.isSkill and not opt.proj and not tgt.dead then
		local k = aStyle.shadowEcho
		task.delay(0.16, function()
			if att.dead or tgt.dead or not tgt.root.Parent then
				return
			end
			Push:FireAllClients("skillfx", { kind = "shadowEcho", a = att.model, t = tgt.model, pose = move.pose, style = att.style })
			Combat.applyHit(att, tgt, { dmg = (hit.dmg or 0) * k, posture = (hit.posture or 0) * k, stun = 0.2, kb = (hit.kb or 0) * 0.5, up = hit.up }, { chain = true, move = { name = "영각" } })
		end)
	end
	-- 벽력: 연쇄 번개
	if chain then
		local victims = {}
		for _, other in pairs(Combat.fighters) do
			if other ~= tgt and Combat.hostile(att, other) and (other.root.Position - tgt.root.Position).Magnitude <= (aStyle and aStyle.chainRange or 16) then
				table.insert(victims, other)
			end
		end
		Push:FireAllClients("chain", { from = tgt.model, to = (function()
			local list = {}
			for _, v in ipairs(victims) do
				table.insert(list, v.model)
			end
			return list
		end)() })
		for _, v in ipairs(victims) do
			Combat.applyHit(att, v, { dmg = aStyle and aStyle.chainDmg or 9, posture = 12, stun = 1.0, kb = 4 }, { chain = true, move = { strike = true } })
		end
		if not tgt.dead then
			Combat.stun(tgt, 1.0)
		end
	end
	-- 금강 법신: 거인의 주먹은 맞은 자리 둘레까지 울린다
	if (att.buffs.giant or 0) > t and not opt.chain then
		local at = tgt.root.Position
		Push:FireAllClients("skillfx", { kind = "aftershock", at = at, style = att.style })
		for _, other in pairs(Combat.fighters) do
			if other ~= tgt and Combat.hostile(att, other) and not other.dead and (other.root.Position - at).Magnitude <= 9 then
				Combat.applyHit(att, other, { dmg = (hit.dmg or 0) * 0.5, posture = (hit.posture or 0) * 0.5, stun = 0.4, kb = 20 }, { chain = true, isSkill = true, move = { name = "여진" } })
			end
		end
	end
	if pulse then
		local at = tgt.root.Position
		Push:FireAllClients("skillfx", { kind = "pulse", fx = pulse.kind, at = at, radius = pulse.radius, delay = pulse.delay, style = att.style })
		task.delay(pulse.delay, function()
			if att.dead then
				return
			end
			for _, other in pairs(Combat.fighters) do
				if Combat.hostile(att, other) and not other.dead and (other.root.Position - at).Magnitude <= pulse.radius then
					if pulse.pull and not other.player and not other.root.Anchored then
						local d = at - other.root.Position
						other.root.AssemblyLinearVelocity = Vector3.new(d.X, 0, d.Z) * (pulse.pull / math.max(4, d.Magnitude)) + Vector3.new(0, -20, 0)
					end
					Combat.applyHit(att, other, { dmg = pulse.dmg, posture = pulse.posture, stun = pulse.stun, kb = pulse.kb, up = pulse.up }, { chain = true, isSkill = true, move = { name = pulse.name } })
				end
			end
		end)
	end
	if star then
		local at = tgt.root.Position
		Push:FireAllClients("star", { at = at, style = att.style })
		task.delay(0.35, function()
			if att.dead then
				return
			end
			for _, other in pairs(Combat.fighters) do
				if Combat.hostile(att, other) and not other.dead and (other.root.Position - at).Magnitude <= 14 then
					Combat.applyHit(att, other, { dmg = 22, posture = 25, stun = 0.6, kb = 18, up = 8 }, { chain = true, isSkill = true, move = { name = "낙성" } })
				end
			end
		end)
	end
	return "hit"
end

------------------------------------------------------------------------
-- 기술 시작 (사람과 적 공통). 화면들에게 동작을 알린다
------------------------------------------------------------------------
function Combat.begin(f: Fighter, move: any, slot: any, seq: number, opt: any?): Act
	local o = opt or {}
	local speed = o.speed or 1
	local act: Act = {
		move = move,
		slot = slot,
		seq = seq,
		start = now(),
		dur = move.dur / speed,
		speed = speed,
		done = {},
		swung = {},
		charge = o.charge or 0,
		bloom = o.bloom == true,
		enemy = o.enemy == true,
	}
	f.act = act
	f.guarding = false
	if move.iframes then
		f.iframeUntil = math.max(f.iframeUntil, now() + move.iframes)
	end
	Push:FireAllClients("act", {
		m = f.model,
		style = f.style,
		slot = slot,
		pose = move.pose,
		dur = act.dur,
		align = o.align,
		seq = seq,
		id = move.id,
		charge = act.charge,
		bloom = act.bloom,
		unblockable = move.unblockable,
		windup = move.windup and move.windup / speed or nil,
	})
	return act
end

-- 기술이 끝났는지
function Combat.busy(f: Fighter): boolean
	local act = f.act
	return act ~= nil and now() < act.start + act.dur
end

-- 앞쪽 상자 안의 상대들 (서버 판정용)
function Combat.query(att: Fighter, hit: any, from: Vector3?): { Fighter }
	local origin = from or att.root.Position
	local look = Combat.look(att)
	local center = hit.aoe and origin or origin + look * (hit.range * 0.55)
	local list = {}
	for _, f in pairs(Combat.fighters) do
		if Combat.hostile(att, f) then
			local dist = Vector3.new(f.root.Position.X - center.X, 0, f.root.Position.Z - center.Z).Magnitude
			local reach = hit.aoe and hit.radius or (hit.range * 0.55 + hit.radius)
			if dist <= reach + 1.5 and math.abs(f.root.Position.Y - origin.Y) < 9 then
				table.insert(list, f)
			end
		end
	end
	return list
end

-- 화면이 알려 준 맞힘이 믿을 만한지 (거리)
function Combat.plausible(att: Fighter, tgt: Fighter, hit: any): boolean
	local d = Vector3.new(tgt.root.Position.X - att.root.Position.X, 0, tgt.root.Position.Z - att.root.Position.Z).Magnitude
	local reach = hit.aoe and hit.radius or (hit.range + hit.radius)
	return d <= reach + Config.HIT_TOLERANCE + 3 and math.abs(tgt.root.Position.Y - att.root.Position.Y) < 14
end

------------------------------------------------------------------------
-- 장풍
------------------------------------------------------------------------
function Combat.fire(owner: Fighter, proj: any, scale: number, opt: any)
	local look = Combat.look(owner)
	local pos = owner.root.Position + look * 2.5 + Vector3.new(0, 0.8, 0)
	local p = {
		owner = owner,
		pos = pos,
		dir = look,
		speed = proj.speed,
		life = proj.life,
		radius = proj.radius * scale,
		hit = { dmg = proj.dmg * scale, posture = proj.posture * scale, stun = proj.stun, kb = proj.kb * math.sqrt(scale), range = 0, radius = proj.radius * scale },
		pierce = proj.pierce == true,
		hitSet = {},
		opt = opt,
	}
	table.insert(Combat.projectiles, p)
	Push:FireAllClients("proj", { m = owner.model, pos = pos, dir = look, speed = proj.speed, life = proj.life, size = (proj.size or 3) * scale, style = owner.style })
end

function Combat.stepProjectiles(dt: number)
	for i = #Combat.projectiles, 1, -1 do
		local p = Combat.projectiles[i]
		p.life -= dt
		local step = p.dir * p.speed * dt
		local from = p.pos
		p.pos += step
		local stop = p.life <= 0 or p.owner.dead
		if not stop then
			for _, f in pairs(Combat.fighters) do
				if not p.hitSet[f] and Combat.hostile(p.owner, f) then
					-- 지나온 선분과 거리
					local v = f.root.Position - from
					local seg = step.Magnitude > 0 and step.Unit or p.dir
					local along = math.clamp(v:Dot(seg), 0, step.Magnitude)
					local closest = from + seg * along
					local dist = Vector3.new(f.root.Position.X - closest.X, 0, f.root.Position.Z - closest.Z).Magnitude
					if dist <= p.radius + 1.5 and math.abs(f.root.Position.Y - closest.Y) < 6 then
						p.hitSet[f] = true
						Combat.applyHit(p.owner, f, p.hit, { move = p.opt.move, isSkill = p.opt.isSkill, proj = true })
						if not p.pierce then
							stop = true
							break
						end
					end
				end
			end
		end
		if stop then
			table.remove(Combat.projectiles, i)
		end
	end
end

------------------------------------------------------------------------
-- 매 순간: 균형·내공 회복, 걷는 속도 (기절·막기)
------------------------------------------------------------------------
function Combat.tick(dt: number)
	local t = now()
	for _, f in pairs(Combat.fighters) do
		if not f.dead then
			local changed = false
			if f.posture > 0 and t - f.lastHurtAt > Config.POSTURE_REGEN_DELAY and t > f.brokenUntil then
				f.posture = math.max(0, f.posture - Config.POSTURE_REGEN * dt)
				changed = true
			end
			-- 자연 회복 (맞은 지 오래면 체력이 조금씩 찬다. 적은 싸움을 멈추고 8초 뒤부터)
			if not f.dead and f.hp < f.maxHp then
				local delay = f.npc and 8 or Config.REGEN_DELAY
				if t - f.lastHurtAt > delay and t > f.stunUntil then
					local rate = f.npc and 0.04 or (inSafe(f.root.Position) and Config.REGEN_SAFE_RATE or Config.REGEN_RATE)
					f.hp = math.min(f.maxHp, f.hp + f.maxHp * rate * dt)
					f.model:SetAttribute("Hp", math.floor(f.hp + 0.5))
				end
			end
			-- 꽃잎은 때리지 않아도 한동안 남아 있다가 (다 모이면 더 오래) 한 잎씩 진다
			if f.stacks.petal > 0 then
				local ps = Config.STYLE_BY_ID[f.style]
				local full = f.stacks.petal >= ((ps and ps.petalMax) or 20)
				if t - f.stacks.petalAt > (full and Config.PETAL_KEEP_FULL or Config.PETAL_KEEP) then
					f.stacks.petal -= 1
					f.stacks.petalAt = t - (full and Config.PETAL_KEEP_FULL or Config.PETAL_KEEP) + 1 / Config.PETAL_DRAIN
					f.model:SetAttribute("Petal", f.stacks.petal)
				end
			end
			local cmax = (f :: any).chiMax or Config.CHI_MAX
			if f.player and f.chi < cmax and f.model:GetAttribute("TestInf") == true then
				f.chi = cmax
				changed = true
			elseif f.player and f.chi < cmax then
				f.chi = math.min(cmax, f.chi + Config.CHI_REGEN * dt * (f.skillMult or 1) * math.sqrt(cmax / Config.CHI_MAX) * (1 + ((f :: any).mChi or 0)))
				changed = true
			end
			if f.act and t > f.act.start + f.act.dur then
				f.act = nil
			end
			local speed = f.walk
			if t < f.stunUntil then
				speed = 0
			elseif f.guarding then
				speed = f.walk * 0.4
			elseif t < ((f :: any).slowUntil or 0) then
				-- 술비에 젖어 굼뜨다
				speed = f.walk * ((f :: any).slowMul or 0.5)
			elseif f.act and not f.npc then
				speed = f.walk * 0.35
			elseif (f :: any).mountMult then
				speed = f.walk * (f :: any).mountMult
			elseif (f :: any).sprint then
				speed = f.walk * 1.45
			end
			if f.hum and math.abs(f.hum.WalkSpeed - speed) > 0.1 then
				f.hum.WalkSpeed = speed
			end
			if changed then
				-- 자주 바뀌는 값은 반올림해서 보낸다 (속성은 바뀔 때만 전달된다)
				f.model:SetAttribute("Posture", math.floor(f.posture + 0.5))
				f.model:SetAttribute("Chi", math.floor(f.chi))
			end
		end
	end
	Combat.stepProjectiles(dt)
end

function Combat.fighterOfPlayer(player: Player): Fighter?
	local char = player.Character
	return char and Combat.fighters[char] or nil
end

local _ = Players
-- 연소: 불타는 상대는 정해진 간격마다 피해를 입는다
task.spawn(function()
	while true do
		task.wait(0.1)
		local t = now()
		for f in pairs(burning) do
			local fb = f :: any
			if f.dead or not f.model.Parent or t > (fb.burnUntil or 0) then
				burning[f] = nil
				if f.model.Parent then
					f.model:SetAttribute("Burning", nil)
				end
			elseif t >= (fb.burnNext or 0) then
				fb.burnNext = t + (fb.burnEvery or 0.5)
				local by = fb.burnBy
				if by and not by.dead then
					Combat.applyHit(by, f, { dmg = fb.burnDmg or 5, posture = 2, stun = 0, kb = 0 }, { chain = true, isSkill = true, unblockable = true, move = { name = "연소" } })
				end
			end
		end
	end
end)

return Combat
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="11">
        <Properties>
          <string name="Name">Dress</string>
          <string name="Source"><![CDATA[-- 권왕 2.7판: 적과 보스의 차림 (Npc.lua에서 옮겨 와 처음부터 다시 짰다)
-- 원칙: 적마다 색은 셋 (윗옷 · 아랫옷 · 끈) 안에서, 옷은 몸에 붙게, 떠다니는 장식과 반짝이 입자는 쓰지 않는다.
-- 사람이 아닌 적 (정령·소악귀·돌 거인·망령·새·해골·버섯·늪 거한·뱀·늑대)은 몸 전체를 그 생김새의 빛깔로 칠한다
local Dress = {}

local C3 = Color3.fromRGB
local Ball, Cyl = Enum.PartType.Ball, Enum.PartType.Cylinder
local M = Enum.Material
local BLACK, WHITE = Color3.new(0, 0, 0), Color3.new(1, 1, 1)

local GOLD = C3(205, 165, 80)
local IRON = C3(100, 102, 110)
local DARK_HAIR = C3(30, 24, 20)
local WHITE_HAIR = C3(232, 230, 222)
local STRAW = C3(196, 168, 112)
local LEATHER = C3(58, 42, 30)

local LEGS = { "LeftUpperLeg", "LeftLowerLeg", "LeftFoot", "RightUpperLeg", "RightLowerLeg", "RightFoot" }
local ARMS = { "LeftUpperArm", "LeftLowerArm", "LeftHand", "RightUpperArm", "RightLowerArm", "RightHand" }
local LIMBS = { "LeftUpperArm", "LeftLowerArm", "RightUpperArm", "RightLowerArm", "LeftUpperLeg", "LeftLowerLeg", "RightUpperLeg", "RightLowerLeg" }

local function dark(c: Color3, t: number): Color3
	return c:Lerp(BLACK, t)
end
local function light(c: Color3, t: number): Color3
	return c:Lerp(WHITE, t)
end

local function partOf(model: Model, name: string): BasePart?
	local p = model:FindFirstChild(name)
	return (p and p:IsA("BasePart")) and p or nil
end
local function sizeOf(model: Model, name: string): Vector3
	local p = partOf(model, name)
	return p and p.Size or Vector3.new(1, 1, 1)
end
-- 몸 부위에 붙는 조각 (용접). 부위가 없으면 nil
local function wear(model: Model, partName: string, name: string, size: Vector3, offset: CFrame, color: Color3, material: Enum.Material?, shape: Enum.PartType?): Part?
	local base = partOf(model, partName)
	if not base then
		return nil
	end
	local p = Instance.new("Part")
	p.Name = name
	-- 3.2.1판: 로블록스의 공 (Ball) 은 세 변이 같아지고 원통은 두 변이 같아진다. 늘인 공·원통은 구·원통 메시를 씌운 상자로
	-- (전에는 납작하게 짠 깃·갈기·갓이 게임 안에서 둥근 공으로 부풀어 덩어리처럼 보였다)
	local meshType: Enum.MeshType? = nil
	if shape == Ball and (math.max(size.X, size.Y, size.Z) - math.min(size.X, size.Y, size.Z)) > 0.02 then
		meshType = Enum.MeshType.Sphere
	elseif shape == Cyl and math.abs(size.Y - size.Z) > 0.02 then
		-- 원통 메시의 축은 Y: 상자를 돌려 축을 X에 맞춘다
		meshType = Enum.MeshType.Cylinder
		offset = offset * CFrame.Angles(0, 0, math.rad(-90))
		size = Vector3.new(size.Y, size.X, size.Z)
	elseif shape then
		p.Shape = shape
	end
	p.Size = Vector3.new(math.max(0.05, size.X), math.max(0.05, size.Y), math.max(0.05, size.Z))
	if meshType then
		local mesh = Instance.new("SpecialMesh")
		mesh.MeshType = meshType
		mesh.Parent = p
	end
	p.Color = color
	p.Material = material or M.Fabric
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.Massless = true
	p.CastShadow = false
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.CFrame = base.CFrame * offset
	p.Parent = model
	local w = Instance.new("WeldConstraint")
	w.Part0 = base
	w.Part1 = p
	w.Parent = p
	return p
end
-- 세운 원통 (원통의 축은 X이므로 Z로 90도 돌려 위를 보게 한다)
local UPRIGHT = CFrame.Angles(0, 0, math.rad(90))
local function disc(model: Model, partName: string, name: string, diameter: number, thick: number, at: CFrame, color: Color3, material: Enum.Material?): Part?
	return wear(model, partName, name, Vector3.new(thick, diameter, diameter), at * UPRIGHT, color, material, Cyl)
end
local function paint(model: Model, names: { string }, color: Color3, material: Enum.Material?, alpha: number?)
	for _, n in ipairs(names) do
		local p = partOf(model, n)
		if p then
			p.Color = color
			if material then
				p.Material = material
			end
			if alpha then
				p.Transparency = alpha
			end
		end
	end
end
local function hide(model: Model, names: { string })
	for _, n in ipairs(names) do
		local p = partOf(model, n)
		if p then
			p.Transparency = 1
		end
	end
end
local function clearFace(model: Model)
	local head = partOf(model, "Head")
	for _, d in ipairs(head and head:GetChildren() or {}) do
		if d:IsA("Decal") then
			d:Destroy()
		end
	end
end
-- 은은한 빛 (정령·불 몸)
local function glow(model: Model, partName: string, color: Color3, range: number, brightness: number)
	local p = partOf(model, partName)
	if not p then
		return
	end
	local l = Instance.new("PointLight")
	l.Color = color
	l.Range = range
	l.Brightness = brightness
	l.Shadows = false
	l.Parent = p
end
-- 로블록스 불 (불꽃 몸: 반짝이 대신 진짜 불길)
local function flame(model: Model, partName: string, color: Color3, color2: Color3, size: number, heat: number)
	local p = partOf(model, partName)
	if not p then
		return
	end
	local f = Instance.new("Fire")
	f.Color = color
	f.SecondaryColor = color2
	f.Size = size
	f.Heat = heat
	f.Parent = p
end
-- 굽은 뿔 (마디가 점점 가늘어지며 뒤로 휜다)
local function horn(model: Model, x: number, hs: Vector3, k: number, color: Color3, len: number, spread: number)
	local cf = CFrame.new(x * hs.X * 0.3, hs.Y * 0.42, -hs.Z * 0.02) * CFrame.Angles(0, 0, -x * math.rad(spread))
	local n = 4
	for j = 0, n - 1 do
		local w = (0.26 - j * 0.05) * k
		local seg = len * k / n
		wear(model, "Head", "Horn", Vector3.new(w, seg * 1.15, w), cf * CFrame.new(0, seg / 2, 0), color, M.SmoothPlastic)
		cf = cf * CFrame.new(0, seg, 0) * CFrame.Angles(math.rad(-22), 0, x * math.rad(10))
	end
end

------------------------------------------------------------------------
-- 얼굴: 기본 웃는 얼굴을 지우고 짙은 눈썹·눈·입을 그린다
------------------------------------------------------------------------
local function face(model: Model, look: any)
	local head = partOf(model, "Head")
	if not head then
		return
	end
	clearFace(model)
	-- 2.8판: 얼굴을 평평한 판 하나에 그리면 둥근 머리 (세운 원통) 앞에 떠 보였다.
	-- 이제 눈·눈썹·입을 하나하나 작은 조각으로 머리 겉면을 따라 붙인다 (옆에서 봐도 살갗에 붙어 있다)
	local hs = head.Size
	local R = math.min(hs.X, hs.Z) * 0.5
	local W, H = hs.X * 0.8, hs.Y * 0.62 -- 예전 얼굴판의 크기 (u, v 자리를 그대로 옮긴다)
	local glow = look.eyes ~= nil
	local ink = dark(head.Color, 0.78)
	local n = 0
	local function bar(u: number, v: number, w: number, h: number, rot: number, color: Color3, neon: boolean?)
		-- 앞에서 보는 사람의 왼쪽 = 머리의 +X
		local x = (0.5 - u) * W
		local y = -hs.Y * 0.02 + (0.5 - v) * H
		local cx = math.clamp(x, -R * 0.95, R * 0.95)
		local z = -math.sqrt(math.max(0, R * R - cx * cx))
		local normal = Vector3.new(cx, 0, z).Unit
		local at = Vector3.new(cx, y, z) + normal * 0.004
		n += 1
		wear(model, "Head", "Face" .. n, Vector3.new(math.max(0.05, w * W), math.max(0.05, h * H), 0.05), CFrame.lookAt(at, at - normal) * CFrame.Angles(0, 0, math.rad(-rot)), color, neon and M.Neon or M.SmoothPlastic)
	end
	if look.head ~= "wrap" then
		bar(0.3, 0.3, 0.28, 0.07, 12, ink)
		bar(0.7, 0.3, 0.28, 0.07, -12, ink)
	end
	local eye = look.eyes or C3(25, 18, 15)
	bar(0.32, 0.43, glow and 0.15 or 0.11, 0.065, 5, eye, glow)
	bar(0.68, 0.43, glow and 0.15 or 0.11, 0.065, -5, eye, glow)
	if look.eyepatch then
		bar(0.32, 0.43, 0.22, 0.16, 0, C3(15, 12, 10))
		bar(0.16, 0.3, 0.3, 0.04, -20, C3(15, 12, 10))
		bar(0.5, 0.24, 0.4, 0.04, -20, C3(15, 12, 10))
	end
	if not look.mask and look.head ~= "wrap" then
		bar(0.5, 0.74, 0.24, 0.035, 0, ink)
	end
	if look.scar then
		bar(0.7, 0.45, 0.035, 0.4, 20, C3(150, 75, 65))
	end
end

------------------------------------------------------------------------
-- 사람 적의 머리쓰개
------------------------------------------------------------------------
local function headgear(model: Model, look: any, P: any)
	local hs = sizeOf(model, "Head")
	local function cap(name: string, radius: number, height: number, y: number, color: Color3, material: Enum.Material?)
		disc(model, "Head", name, hs.X * radius * 2, height, CFrame.new(0, y, 0), color, material)
	end
	local kind = look.head
	if kind == "straw" then
		-- 삿갓: 넓고 얕은 챙, 두 층으로 좁아지는 몸, 턱끈
		local c = look.hat or STRAW
		cap("HatBrim", 1.5, 0.1, hs.Y * 0.42, c)
		cap("HatMid", 1.0, hs.Y * 0.12, hs.Y * 0.5, dark(c, 0.06))
		cap("HatCrown", 0.55, hs.Y * 0.16, hs.Y * 0.62, dark(c, 0.12))
		cap("HatTop", 0.22, hs.Y * 0.12, hs.Y * 0.74, dark(c, 0.2))
		for _, x in ipairs({ -1, 1 }) do
			wear(model, "Head", "HatString", Vector3.new(0.05, hs.Y * 0.7, 0.05), CFrame.new(x * hs.X * 0.44, 0, -hs.Z * 0.1) * CFrame.Angles(0, 0, x * math.rad(8)), dark(c, 0.5))
		end
	elseif kind == "bandana" then
		cap("Bandana", 0.53, hs.Y * 0.32, hs.Y * 0.28, P.trim)
		wear(model, "Head", "BandanaKnot", Vector3.new(hs.X * 0.2, hs.Y * 0.18, hs.Z * 0.14), CFrame.new(0, hs.Y * 0.22, hs.Z * 0.54), dark(P.trim, 0.1))
		for _, x in ipairs({ -1, 1 }) do
			wear(model, "Head", "BandanaTail", Vector3.new(hs.X * 0.12, hs.Y * 0.5, 0.06), CFrame.new(x * hs.X * 0.08, -hs.Y * 0.05, hs.Z * 0.58) * CFrame.Angles(math.rad(12), 0, x * math.rad(14)), P.trim)
		end
	elseif kind == "hood" then
		-- 두건 겉옷: 머리를 감싸고 어깨까지 덮는다 (얼굴은 드러난다)
		local c = look.hoodColor or P.top
		wear(model, "Head", "Hood", Vector3.new(hs.X * 1.14, hs.Y * 1.1, hs.Z * 1.1), CFrame.new(0, hs.Y * 0.06, hs.Z * 0.12), c, M.Fabric, Ball)
		wear(model, "Head", "HoodRim", Vector3.new(hs.X * 1.0, hs.Y * 0.1, hs.Z * 0.1), CFrame.new(0, hs.Y * 0.36, -hs.Z * 0.42) * CFrame.Angles(math.rad(-15), 0, 0), dark(c, 0.2))
		local ut = sizeOf(model, "UpperTorso")
		wear(model, "UpperTorso", "HoodDrape", Vector3.new(ut.X * 0.92, ut.Y * 0.28, ut.Z * 1.14), CFrame.new(0, ut.Y * 0.4, 0.02), c)
	elseif kind == "helmet" then
		local metal = look.metal or IRON
		cap("Helmet", 0.56, hs.Y * 0.4, hs.Y * 0.3, metal, M.Metal)
		wear(model, "Head", "HelmetDome", Vector3.new(hs.X * 1.1, hs.Y * 0.5, hs.Z * 1.1), CFrame.new(0, hs.Y * 0.48, 0), metal, M.Metal, Ball)
		cap("HelmetRim", 0.6, hs.Y * 0.07, hs.Y * 0.1, dark(metal, 0.3), M.Metal)
		-- 목 가리개 (뒤로 늘어진 쇠 비늘)
		wear(model, "Head", "NeckGuard", Vector3.new(hs.X * 1.0, hs.Y * 0.4, 0.08), CFrame.new(0, -hs.Y * 0.1, hs.Z * 0.56) * CFrame.Angles(math.rad(-10), 0, 0), dark(metal, 0.15), M.Metal)
		if look.plume then
			-- 투구 꼭대기의 술 (짧은 대에서 뒤로 흘러내린다)
			wear(model, "Head", "PlumeBase", Vector3.new(hs.X * 0.12, hs.Y * 0.2, hs.X * 0.12), CFrame.new(0, hs.Y * 0.8, 0), GOLD, M.Metal)
			wear(model, "Head", "Plume", Vector3.new(hs.X * 0.22, hs.Y * 0.18, hs.Z * 0.7), CFrame.new(0, hs.Y * 0.88, hs.Z * 0.28) * CFrame.Angles(math.rad(-25), 0, 0), look.plume)
		end
	elseif kind == "topknot" then
		local hair = look.hair or DARK_HAIR
		cap("Hair", 0.53, hs.Y * 0.3, hs.Y * 0.3, hair, M.SmoothPlastic)
		wear(model, "Head", "HairBack", Vector3.new(hs.X * 0.95, hs.Y * 0.55, hs.Z * 0.2), CFrame.new(0, hs.Y * 0.1, hs.Z * 0.44), hair, M.SmoothPlastic)
		wear(model, "Head", "Topknot", Vector3.new(hs.X * 0.28, hs.X * 0.28, hs.X * 0.28), CFrame.new(0, hs.Y * 0.6, hs.Z * 0.05), hair, M.SmoothPlastic, Ball)
		wear(model, "Head", "TopknotTie", Vector3.new(hs.X * 0.08, hs.X * 0.3, hs.X * 0.3), CFrame.new(0, hs.Y * 0.5, hs.Z * 0.05) * UPRIGHT, P.trim, M.Fabric, Cyl)
		if look.longHair then
			-- 허리까지 늘어진 머리
			wear(model, "Head", "LongHair", Vector3.new(hs.X * 0.7, hs.Y * 1.8, hs.Z * 0.16), CFrame.new(0, -hs.Y * 0.7, hs.Z * 0.5) * CFrame.Angles(math.rad(-6), 0, 0), hair, M.SmoothPlastic)
		end
	elseif kind == "bald" then
		-- 민머리: 머리띠 하나
		if look.headband then
			cap("Headband", 0.52, hs.Y * 0.1, hs.Y * 0.22, look.headband)
		end
	elseif kind == "horns" then
		local hair = look.hair or DARK_HAIR
		cap("Hair", 0.53, hs.Y * 0.28, hs.Y * 0.3, hair, M.SmoothPlastic)
		for _, x in ipairs({ -1, 1 }) do
			horn(model, x, hs, hs.X / 1.2, look.hornColor or C3(40, 32, 30), look.hornLen or 1.1, 20)
		end
	elseif kind == "wrap" then
		wear(model, "Head", "Wrap", Vector3.new(hs.X * 1.06, hs.Y * 1.04, hs.Z * 1.06), CFrame.new(0, hs.Y * 0.02, 0), P.top, M.Fabric, Ball)
		for j = -1, 1 do
			cap("WrapBand", 0.54, hs.Y * 0.06, j * hs.Y * 0.22, dark(P.top, 0.18))
		end
	end
	if look.crown then
		-- 관: 머리에 얹은 낮은 금관과 앞의 작은 장식 판 (사람 머리에 맞는 크기)
		cap("Crown", 0.42, hs.Y * 0.16, hs.Y * 0.66, look.crown, M.Metal)
		wear(model, "Head", "CrownFront", Vector3.new(hs.X * 0.3, hs.Y * 0.34, 0.06), CFrame.new(0, hs.Y * 0.78, -hs.Z * 0.4), look.crown, M.Metal)
		if look.gem then
			wear(model, "Head", "CrownGem", Vector3.new(hs.X * 0.12, hs.X * 0.12, 0.06), CFrame.new(0, hs.Y * 0.78, -hs.Z * 0.44), look.gem, M.Glass, Ball)
		end
	end
	if look.mask then
		wear(model, "Head", "Mask", Vector3.new(hs.X * 0.9, hs.Y * 0.38, hs.Z * 0.48), CFrame.new(0, -hs.Y * 0.24, -hs.Z * 0.3), look.mask)
	end
	if look.beard then
		local bc = look.beard == "white" and WHITE_HAIR or (look.hair or DARK_HAIR)
		local long = look.beard ~= "stubble"
		wear(model, "Head", "Beard", Vector3.new(hs.X * 0.6, hs.Y * (long and 0.42 or 0.14), hs.Z * 0.22), CFrame.new(0, -hs.Y * (long and 0.5 or 0.38), -hs.Z * 0.42), bc, M.SmoothPlastic)
		if long then
			for _, x in ipairs({ -1, 1 }) do
				wear(model, "Head", "Mustache", Vector3.new(hs.X * 0.3, hs.Y * 0.08, 0.1), CFrame.new(x * hs.X * 0.16, -hs.Y * 0.16, -hs.Z * 0.52) * CFrame.Angles(0, 0, x * math.rad(-18)), bc, M.SmoothPlastic)
			end
		end
	end
end

------------------------------------------------------------------------
-- 사람 적의 옷: 저고리 (여민 깃) · 허리띠 (매듭과 늘어진 끝) · 바지 (정강이 감개) · 천신 · 팔목 감개
-- 갑옷은 비늘 갑옷 (앞뒤 판과 비늘 줄, 두 겹 어깨받이, 허리 아래 드리개), 도포는 앞이 갈라진 긴 자락
------------------------------------------------------------------------
local function outfit(model: Model, look: any, P: any, K: number)
	-- 3.10.1판: 소매는 몸통보다 어두운 빛깔로, 어깨에 솔기를 넣는다 (몸통·팔이 한 빛깔 상자로 붙어 보이지 않게)
	local ut, lt = sizeOf(model, "UpperTorso"), sizeOf(model, "LowerTorso")
	local sleeve = look.sleeve or dark(P.top, 0.24)
	paint(model, { "UpperTorso", "LowerTorso" }, P.top, M.Fabric)
	paint(model, { "LeftUpperLeg", "RightUpperLeg", "LeftLowerLeg", "RightLowerLeg" }, P.bottom, M.Fabric)
	paint(model, { "LeftFoot", "RightFoot" }, P.shoe, M.Fabric)
	if look.sleeves ~= false then
		paint(model, { "LeftUpperArm", "RightUpperArm" }, sleeve, M.Fabric)
		for _, side in ipairs({ "Left", "Right" }) do
			local ua = sizeOf(model, side .. "UpperArm")
			wear(model, side .. "UpperArm", "ShoulderSeam", Vector3.new(ua.X * 1.04, 0.09 * K, ua.Z * 1.04), CFrame.new(0, ua.Y * 0.32, 0), P.trim)
		end
	end
	-- 가슴은 넓고 허리는 좁게: 몸통 아래쪽 양옆에 어두운 그늘 판 (허리선이 잡힌다)
	for _, x in ipairs({ -1, 1 }) do
		wear(model, "UpperTorso", "WaistShade", Vector3.new(ut.X * 0.16, ut.Y * 0.5, ut.Z * 1.03), CFrame.new(x * ut.X * 0.43, -ut.Y * 0.25, 0), dark(P.top, 0.3))
	end
	-- 여민 깃: 왼쪽 깃이 오른쪽 위로 비스듬히 덮는다
	local front = -ut.Z * 0.5 - 0.02
	wear(model, "UpperTorso", "Lapel", Vector3.new(0.24 * K, ut.Y * 0.78, 0.05), CFrame.new(ut.X * 0.06, ut.Y * 0.08, front) * CFrame.Angles(0, 0, math.rad(-30)), P.trim)
	wear(model, "UpperTorso", "LapelBack", Vector3.new(0.2 * K, ut.Y * 0.4, 0.045), CFrame.new(-ut.X * 0.12, ut.Y * 0.26, front + 0.01) * CFrame.Angles(0, 0, math.rad(30)), dark(P.trim, 0.12))
	wear(model, "UpperTorso", "Collar", Vector3.new(ut.X * 0.5, 0.16 * K, ut.Z * 1.06), CFrame.new(0, ut.Y * 0.47, 0), P.trim)
	-- 허리띠: 몸을 두르고 왼쪽 앞에서 매듭, 두 끝이 늘어진다
	wear(model, "LowerTorso", "Sash", Vector3.new(lt.X * 1.05, 0.34 * K, lt.Z * 1.12), CFrame.new(0, 0.06 * K, 0), P.sash)
	wear(model, "LowerTorso", "SashKnot", Vector3.new(0.3 * K, 0.26 * K, 0.12 * K), CFrame.new(-lt.X * 0.28, 0.04 * K, -lt.Z * 0.6), dark(P.sash, 0.12))
	for i, x in ipairs({ -0.36, -0.22 }) do
		wear(model, "LowerTorso", "SashEnd", Vector3.new(0.16 * K, (0.85 - i * 0.12) * K, 0.05), CFrame.new(lt.X * x, -0.42 * K, -lt.Z * 0.6) * CFrame.Angles(math.rad(-4), 0, math.rad(i * 4 - 6)), P.sash)
	end
	-- 정강이 감개와 천신, 팔목 감개
	for _, side in ipairs({ "Left", "Right" }) do
		local ll = sizeOf(model, side .. "LowerLeg")
		wear(model, side .. "LowerLeg", "LegWrap", Vector3.new(ll.X * 1.06, ll.Y * 0.62, ll.Z * 1.06), CFrame.new(0, -ll.Y * 0.16, 0), P.wrap)
		for j = 0, 1 do
			wear(model, side .. "LowerLeg", "LegWrapLine", Vector3.new(ll.X * 1.08, 0.035, ll.Z * 1.08), CFrame.new(0, -ll.Y * (0.02 + j * 0.2), 0), dark(P.wrap, 0.22))
		end
		local la = sizeOf(model, side .. "LowerArm")
		wear(model, side .. "LowerArm", "Bracer", Vector3.new(la.X * 1.06, la.Y * 0.38, la.Z * 1.06), CFrame.new(0, -la.Y * 0.26, 0), look.bracer or LEATHER, M.Leather)
		if look.sleeves ~= false then
			-- 넓은 소매 끝
			wear(model, side .. "LowerArm", "Cuff", Vector3.new(la.X * 1.1, la.Y * 0.42, la.Z * 1.1), CFrame.new(0, la.Y * 0.28, 0), sleeve)
			wear(model, side .. "LowerArm", "CuffTrim", Vector3.new(la.X * 1.12, la.Y * 0.07, la.Z * 1.12), CFrame.new(0, la.Y * 0.08, 0), P.trim)
		end
	end
	if look.armor then
		local metal = look.metal or IRON
		local line = dark(metal, 0.35)
		for _, z in ipairs({ -1, 1 }) do
			wear(model, "UpperTorso", "Plate", Vector3.new(ut.X * 0.86, ut.Y * 0.7, 0.12 * K), CFrame.new(0, ut.Y * 0.04, z * (ut.Z * 0.5 + 0.05 * K)), metal, M.Metal)
			for j = 0, 2 do
				wear(model, "UpperTorso", "PlateRow", Vector3.new(ut.X * 0.87, 0.045 * K, 0.13 * K), CFrame.new(0, ut.Y * (0.22 - j * 0.2), z * (ut.Z * 0.5 + 0.055 * K)), line, M.Metal)
			end
		end
		for _, x in ipairs({ -1, 1 }) do
			for j = 0, 1 do
				wear(model, "UpperTorso", "Pauldron", Vector3.new(ut.X * (0.36 + j * 0.04), 0.12 * K, ut.Z * (1.16 + j * 0.06)), CFrame.new(x * ut.X * (0.48 + j * 0.06), ut.Y * (0.48 - j * 0.12), 0) * CFrame.Angles(0, 0, -x * math.rad(18 + j * 10)), j == 0 and metal or dark(metal, 0.12), M.Metal)
			end
			-- 허리 아래 드리개 (앞에 둘)
			wear(model, "LowerTorso", "Tasset", Vector3.new(lt.X * 0.42, 0.9 * K, 0.08 * K), CFrame.new(x * lt.X * 0.24, -0.5 * K, -lt.Z * 0.58) * CFrame.Angles(math.rad(-5), 0, x * math.rad(4)), dark(metal, 0.08), M.Metal)
			wear(model, "LowerTorso", "TassetRow", Vector3.new(lt.X * 0.43, 0.04 * K, 0.09 * K), CFrame.new(x * lt.X * 0.24, -0.4 * K, -lt.Z * 0.58) * CFrame.Angles(math.rad(-5), 0, x * math.rad(4)), line, M.Metal)
		end
		if look.armorTrim then
			wear(model, "UpperTorso", "PlateEdge", Vector3.new(ut.X * 0.88, 0.06 * K, 0.14 * K), CFrame.new(0, ut.Y * 0.39, -(ut.Z * 0.5 + 0.05 * K)), look.armorTrim, M.Metal)
		end
	end
	if look.robe then
		-- 도포: 허리 아래로 앞이 갈라진 두 자락과 뒷자락, 끝단에 끈 빛깔
		local c = look.robe
		-- 3.10.1판: 앞자락은 무릎 위까지만, 바깥으로 벌어져 다리가 보이게 (전에는 다리를 다 가려 아래가 네모 상자였다)
		for _, x in ipairs({ -1, 1 }) do
			local fc = CFrame.new(x * lt.X * 0.36, -0.75 * K, -lt.Z * 0.55) * CFrame.Angles(math.rad(-4), 0, x * math.rad(9))
			wear(model, "LowerTorso", "RobeFront", Vector3.new(lt.X * 0.34, 1.4 * K, 0.08 * K), fc, c)
			wear(model, "LowerTorso", "RobeHem", Vector3.new(lt.X * 0.35, 0.09 * K, 0.1 * K), fc * CFrame.new(0, -0.7 * K, 0), P.trim)
		end
		local bc = CFrame.new(0, -0.9 * K, lt.Z * 0.56) * CFrame.Angles(math.rad(5), 0, 0)
		wear(model, "LowerTorso", "RobeBack", Vector3.new(lt.X * 0.92, 1.75 * K, 0.08 * K), bc, c)
		wear(model, "LowerTorso", "RobeBackHem", Vector3.new(lt.X * 0.93, 0.09 * K, 0.1 * K), bc * CFrame.new(0, -0.875 * K, 0), P.trim)
	end
	if look.beads then
		-- 염주
		for i = 0, 9 do
			local a = (i / 9 - 0.5) * math.pi * 0.9
			wear(model, "UpperTorso", "Bead", Vector3.new(0.2 * K, 0.2 * K, 0.2 * K), CFrame.new(math.sin(a) * ut.X * 0.28, ut.Y * 0.4 - math.cos(a) * ut.Y * 0.35, -ut.Z * 0.52), look.beads, M.Wood, Ball)
		end
	end
end
-- 보스의 겉옷: 어깨에서 늘어지는 망토 한 장과 목둘레 (털이나 두꺼운 천)
local function mantle(model: Model, color: Color3, collar: Color3, K: number, len: number?)
	local ut = sizeOf(model, "UpperTorso")
	local L = (len or 3.2) * K
	wear(model, "UpperTorso", "MantleCollar", Vector3.new(ut.X * 0.86, 0.3 * K, ut.Z * 1.24), CFrame.new(0, ut.Y * 0.5, 0.02 * K), collar)
	-- 어깨 위 끝에 매달려 아래로 조금 뒤로 기운다
	local top = CFrame.new(0, ut.Y * 0.5, ut.Z * 0.6) * CFrame.Angles(math.rad(6), 0, 0)
	wear(model, "UpperTorso", "Mantle", Vector3.new(ut.X * 1.02, L, 0.1 * K), top * CFrame.new(0, -L / 2, 0), color)
	wear(model, "UpperTorso", "MantleHem", Vector3.new(ut.X * 1.03, 0.12 * K, 0.12 * K), top * CFrame.new(0, -L + 0.06 * K, 0), collar)
end

------------------------------------------------------------------------
-- 사람이 아닌 적의 몸
------------------------------------------------------------------------
local FORMS: { [string]: (Model, any, number, boolean) -> () } = {}

-- 정령: 다리 없이 흘러내리는 몸, 같은 빛깔의 둥근 머리와 고요한 눈, 속의 은은한 빛
FORMS.spirit = function(model, look, k, boss)
	local c = look.skin or C3(120, 190, 240)
	local solid = look.solid
	local mat = solid and M.Slate or M.Glass
	local alpha = solid and 0 or 0.2
	hide(model, LEGS)
	clearFace(model)
	paint(model, { "Head", "UpperTorso", "LowerTorso" }, c, mat, alpha)
	paint(model, ARMS, light(c, 0.08), mat, solid and 0 or 0.28)
	local hs = sizeOf(model, "Head")
	-- 흘러내리는 꼬리: 위가 굵고 아래로 가늘어지며 살짝 뒤로 휜다.
	-- 2.8판: 공 다섯이 줄줄이 달려 덩어리져 보였다. 길쭉한 조각을 촘촘히 겹쳐 한 줄기로 매끈하게 흐르게
	local n = 10
	for i = 0, n - 1 do
		local u = i / (n - 1)
		local w = (1.7 * (1 - u) ^ 0.9 + 0.18) * k
		local p = wear(model, "LowerTorso", "Tail", Vector3.new(w, w * 1.7, w * 0.92), CFrame.new(0, (-0.5 - u * 2.9) * k, (u * u * 0.9) * k) * CFrame.Angles(math.rad(-u * 28), 0, 0), dark(c, u * 0.12), mat, Ball)
		if p then
			p.Transparency = solid and 0 or (0.22 + u * 0.4)
		end
	end
	for _, x in ipairs({ -1, 1 }) do
		wear(model, "Head", "Eye", Vector3.new(0.2, 0.12, 0.08) * k, CFrame.new(x * hs.X * 0.2, hs.Y * 0.05, -hs.Z * 0.48), look.eyes or WHITE, M.Neon)
	end
	local crest = look.crest
	if crest == "ice" then
		for j = -1, 1 do
			wear(model, "Head", "Icicle", Vector3.new(0.18, 0.9 - math.abs(j) * 0.3, 0.18) * k, CFrame.new(j * hs.X * 0.22, hs.Y * 0.6, hs.Z * 0.05) * CFrame.Angles(0, 0, -j * 0.3), light(c, 0.5), M.Glass)
		end
	elseif crest == "water" then
		-- 물방울 머리채: 뒤로 흘러 떨어지는 물방울 셋
		for j = 0, 2 do
			local p = wear(model, "Head", "Droplet", Vector3.new(0.55 - j * 0.12, 0.55 - j * 0.12, 0.55 - j * 0.12) * k, CFrame.new(0, hs.Y * (0.5 - j * 0.12), hs.Z * (0.25 + j * 0.25)), c, M.Glass, Ball)
			if p then
				p.Transparency = 0.25
			end
		end
	elseif crest == "moss" then
		wear(model, "Head", "Moss", Vector3.new(hs.X * 0.9, 0.18 * k, hs.Z * 0.9), CFrame.new(0, hs.Y * 0.48, 0), look.moss or C3(80, 120, 60), M.Grass)
		for _, x in ipairs({ -1, 1 }) do
			wear(model, "UpperTorso", "Moss", Vector3.new(0.8 * k, 0.16 * k, 0.8 * k), CFrame.new(x * 0.75 * k, 0.82 * k, 0), look.moss or C3(80, 120, 60), M.Grass)
		end
	elseif crest == "star" then
		-- 머리 위의 작은 별 하나 (붙어 있다)
		wear(model, "Head", "Star", Vector3.new(0.4, 0.4, 0.4) * k, CFrame.new(0, hs.Y * 0.62, 0), look.eyes or WHITE, M.Neon, Ball)
	end
	glow(model, "UpperTorso", c, 10 * k, solid and 0 or 1.2)
	if boss then
		wear(model, "UpperTorso", "Core", Vector3.new(0.7, 0.7, 0.7) * k, CFrame.new(0, 0.1 * k, 0), light(c, 0.6), M.Neon, Ball)
	end
end

-- 소악귀: 잿빛이 도는 한 빛깔의 몸, 굽은 뿔, 뾰족한 귀, 접은 박쥐 날개, 삽 꼬리, 손톱
FORMS.imp = function(model, look, k, boss)
	local skin = look.skin or C3(170, 70, 50)
	local hornC = look.hornColor or dark(skin, 0.6)
	clearFace(model)
	paint(model, { "Head", "UpperTorso", "LowerTorso" }, skin, M.SmoothPlastic)
	paint(model, ARMS, skin, M.SmoothPlastic)
	paint(model, LEGS, dark(skin, 0.2), M.SmoothPlastic)
	local hs = sizeOf(model, "Head")
	for _, x in ipairs({ -1, 1 }) do
		horn(model, x, hs, k, hornC, 0.8, 30)
		wear(model, "Head", "Ear", Vector3.new(0.08, 0.45, 0.24) * k, CFrame.new(x * hs.X * 0.55, hs.Y * 0.08, 0) * CFrame.Angles(0, 0, -x * math.rad(62)), skin, M.SmoothPlastic)
		wear(model, "Head", "Eye", Vector3.new(0.22, 0.1, 0.06) * k, CFrame.new(x * hs.X * 0.2, hs.Y * 0.06, -hs.Z * 0.5) * CFrame.Angles(0, 0, x * math.rad(-15)), look.eyes or C3(255, 220, 90), M.Neon)
		-- 접은 날개: 뼈 둘과 그 사이의 막 (등에 바짝)
		local wing = dark(skin, 0.4)
		wear(model, "UpperTorso", "WingArm", Vector3.new(0.15, 1.5, 0.15) * k, CFrame.new(x * 0.75 * k, 0.95 * k, 0.6 * k) * CFrame.Angles(math.rad(12), 0, -x * math.rad(50)), hornC, M.SmoothPlastic)
		wear(model, "UpperTorso", "WingTip", Vector3.new(0.12, 1.5, 0.12) * k, CFrame.new(x * 1.45 * k, 0.75 * k, 0.64 * k) * CFrame.Angles(math.rad(12), 0, x * math.rad(8)), hornC, M.SmoothPlastic)
		wear(model, "UpperTorso", "Wing", Vector3.new(1.0, 1.4, 0.05) * k, CFrame.new(x * 0.95 * k, 0.3 * k, 0.62 * k) * CFrame.Angles(math.rad(10), 0, -x * math.rad(10)), wing, M.SmoothPlastic)
		wear(model, "UpperTorso", "WingOuter", Vector3.new(0.6, 1.1, 0.05) * k, CFrame.new(x * 1.55 * k, 0.2 * k, 0.64 * k) * CFrame.Angles(math.rad(10), 0, x * math.rad(6)), dark(wing, 0.1), M.SmoothPlastic)
	end
	wear(model, "Head", "Grin", Vector3.new(0.42, 0.06, 0.05) * k, CFrame.new(0, -hs.Y * 0.22, -hs.Z * 0.5), dark(skin, 0.7), M.SmoothPlastic)
	local cf = CFrame.new(0, -0.05 * k, 0.5 * k)
	for _ = 1, 4 do
		local seg = cf * CFrame.Angles(math.rad(-32), 0, 0) * CFrame.new(0, -0.32 * k, 0)
		wear(model, "LowerTorso", "Tail", Vector3.new(0.14, 0.66, 0.14) * k, seg, skin, M.SmoothPlastic)
		cf = seg * CFrame.new(0, -0.32 * k, 0)
	end
	wear(model, "LowerTorso", "TailTip", Vector3.new(0.34, 0.34, 0.06) * k, cf * CFrame.Angles(0, 0, math.rad(45)), hornC, M.SmoothPlastic)
	for _, hn in ipairs({ "LeftHand", "RightHand" }) do
		for j = -1, 1 do
			wear(model, hn, "Claw", Vector3.new(0.07, 0.3, 0.07) * k, CFrame.new(j * 0.2 * k, -0.26 * k, -0.14 * k) * CFrame.Angles(math.rad(25), 0, 0), hornC, M.SmoothPlastic)
		end
	end
	if look.fire then
		flame(model, "Head", look.fire, dark(look.fire, 0.4), 2.2 * k, 5)
	elseif look.spark then
		glow(model, "UpperTorso", look.spark, 8 * k, 1)
	end
	local _ = boss
end

-- 돌 거인: 크게 쌓은 바위 몸. 빛깔은 한 가지 돌에 짙고 옅은 결만, 이끼는 위를 보는 면에만.
-- carved = 깎아 만든 석상 (반듯한 판과 투구), 아니면 자연석 (조금씩 기운 덩어리)
FORMS.golem = function(model, look, k, boss)
	local rock = look.skin or C3(125, 120, 112)
	local d1, d2 = dark(rock, 0.14), dark(rock, 0.28)
	local carved = look.carved
	local mat = carved and M.Concrete or M.Slate
	local tilt = carved and 0 or 1
	clearFace(model)
	paint(model, { "UpperTorso", "LowerTorso" }, rock, mat)
	paint(model, ARMS, rock, mat)
	paint(model, LEGS, d1, mat)
	hide(model, { "Head" })
	local eye = look.eyes or C3(255, 190, 110)
	-- 머리: 어깨 위로 드러난 모난 돌과 튀어나온 이마
	wear(model, "Head", "RockHead", Vector3.new(1.2, 1.0, 1.1) * k, CFrame.new(0, 0, 0) * CFrame.Angles(0.04 * tilt, 0.12 * tilt, 0), d1, mat)
	wear(model, "Head", "Brow", Vector3.new(1.26, 0.26, 0.42) * k, CFrame.new(0, 0.2 * k, -0.42 * k) * CFrame.Angles(0.12, 0, 0), d2, mat)
	wear(model, "Head", "Jaw", Vector3.new(1.0, 0.3, 0.9) * k, CFrame.new(0, -0.48 * k, -0.08 * k), d2, mat)
	for _, x in ipairs({ -1, 1 }) do
		wear(model, "Head", "Eye", Vector3.new(0.22, 0.08, 0.05) * k, CFrame.new(x * 0.25 * k, 0.02 * k, -0.57 * k), dark(eye, 0.1), M.Neon)
	end
	if carved then
		-- 석상: 투구, 가슴판, 허리 판, 어깨 판 (반듯하게 깎았다)
		wear(model, "Head", "StoneHelm", Vector3.new(1.3, 0.4, 1.2) * k, CFrame.new(0, 0.5 * k, 0.02 * k), rock, mat)
		wear(model, "Head", "StoneCrest", Vector3.new(0.2, 0.5, 1.0) * k, CFrame.new(0, 0.85 * k, 0.05 * k), d1, mat)
		wear(model, "UpperTorso", "ChestPlate", Vector3.new(1.7, 1.2, 0.3) * k, CFrame.new(0, 0.1 * k, -0.5 * k), light(rock, 0.06), mat)
		wear(model, "UpperTorso", "ChestLine", Vector3.new(1.72, 0.08, 0.32) * k, CFrame.new(0, -0.15 * k, -0.5 * k), d2, mat)
		wear(model, "LowerTorso", "Skirt", Vector3.new(1.8, 0.6, 1.1) * k, CFrame.new(0, -0.35 * k, 0), d1, mat)
		for _, x in ipairs({ -1, 1 }) do
			wear(model, "UpperTorso", "ShoulderPlate", Vector3.new(0.9, 0.3, 1.0) * k, CFrame.new(x * 1.3 * k, 0.72 * k, 0) * CFrame.Angles(0, 0, -x * math.rad(14)), rock, mat)
		end
	else
		wear(model, "UpperTorso", "Slab", Vector3.new(1.25, 0.9, 0.45) * k, CFrame.new(-0.4 * k, 0.25 * k, -0.42 * k) * CFrame.Angles(0.05, 0.1, 0.06), rock, mat)
		wear(model, "UpperTorso", "Slab", Vector3.new(1.1, 0.8, 0.45) * k, CFrame.new(0.45 * k, -0.25 * k, -0.42 * k) * CFrame.Angles(-0.04, -0.1, -0.05), d1, mat)
		wear(model, "UpperTorso", "BackSlab", Vector3.new(1.5, 1.1, 0.6) * k, CFrame.new(0, 0.3 * k, 0.5 * k) * CFrame.Angles(0.18, 0, 0.03), d1, mat)
		for _, x in ipairs({ -1, 1 }) do
			wear(model, "UpperTorso", "ShoulderRock", Vector3.new(0.85, 0.6, 0.95) * k, CFrame.new(x * 1.3 * k, 0.62 * k, 0) * CFrame.Angles(0.1 * x, 0.25, x * -0.2), rock, mat)
		end
	end
	for _, side in ipairs({ "Left", "Right" }) do
		wear(model, side .. "LowerArm", "ForeRock", Vector3.new(0.9, 0.85, 0.9) * k, CFrame.new(0, -0.05 * k, 0) * CFrame.Angles(0, 0.25 * tilt, 0), rock, mat)
		wear(model, side .. "Hand", "Fist", Vector3.new(1.05, 0.85, 1.05) * k, CFrame.new(0, -0.25 * k, 0), d1, mat)
		wear(model, side .. "LowerLeg", "ShinRock", Vector3.new(0.95, 0.7, 0.95) * k, CFrame.new(0, 0, 0) * CFrame.Angles(0, 0.3 * tilt, 0), d1, mat)
		wear(model, side .. "Foot", "FootRock", Vector3.new(1.25, 0.45, 1.45) * k, CFrame.new(0, 0, -0.1 * k), d2, mat)
	end
	if look.moss then
		local moss = look.moss
		wear(model, "UpperTorso", "Moss", Vector3.new(1.5, 0.12, 0.8) * k, CFrame.new(0, 0.82 * k, 0.12 * k), moss, M.Grass)
		for _, x in ipairs({ -1, 1 }) do
			wear(model, "UpperTorso", "ShoulderMoss", Vector3.new(0.75, 0.12, 0.8) * k, CFrame.new(x * 1.3 * k, 0.93 * k, 0) * CFrame.Angles(0.1 * x, 0.25, x * -0.2), moss, M.Grass)
		end
		wear(model, "Head", "HeadMoss", Vector3.new(0.95, 0.12, 0.85) * k, CFrame.new(0, 0.5 * k, 0.05 * k), moss, M.Grass)
	end
	if look.ember then
		local e = look.ember
		wear(model, "UpperTorso", "Seam", Vector3.new(0.07, 1.0, 0.05) * k, CFrame.new(0.03 * k, 0.0, -0.66 * k) * CFrame.Angles(0, 0, math.rad(16)), e, M.Neon)
		for _, x in ipairs({ -1, 1 }) do
			wear(model, "UpperTorso", "Seam", Vector3.new(0.55, 0.06, 0.05) * k, CFrame.new(x * 0.45 * k, -0.2 * k + x * 0.1 * k, -0.66 * k), e, M.Neon)
		end
		glow(model, "UpperTorso", e, 10 * k, 1)
		if look.lava then
			flame(model, "UpperTorso", e, dark(e, 0.5), 2.5 * k, 6)
		end
	end
	local _ = boss
end

-- 망령: 다리 없이 끌리는 해진 옷자락, 깊은 두건 속 어둠과 두 눈, 메마른 팔
FORMS.wraith = function(model, look, k, boss)
	local cloth = look.cloth or C3(200, 180, 140)
	clearFace(model)
	hide(model, LEGS)
	paint(model, { "UpperTorso", "LowerTorso" }, cloth, M.Fabric)
	paint(model, { "LeftUpperArm", "RightUpperArm" }, cloth, M.Fabric)
	paint(model, { "LeftLowerArm", "RightLowerArm", "LeftHand", "RightHand" }, look.bone or C3(70, 62, 56), M.SmoothPlastic)
	paint(model, { "Head" }, C3(8, 6, 10), M.SmoothPlastic)
	-- 깊은 두건: 머리 위와 옆, 뒤를 덮고 앞은 어둡게 열려 있다. 어깨까지 흘러내린다
	wear(model, "Head", "CowlTop", Vector3.new(1.5, 0.5, 1.5) * k, CFrame.new(0, 0.55 * k, 0.1 * k) * CFrame.Angles(math.rad(-8), 0, 0), cloth, M.Fabric)
	for _, x in ipairs({ -1, 1 }) do
		wear(model, "Head", "CowlSide", Vector3.new(0.22, 1.4, 1.45) * k, CFrame.new(x * 0.68 * k, 0.0, 0.08 * k), cloth, M.Fabric)
	end
	wear(model, "Head", "CowlBack", Vector3.new(1.5, 1.5, 0.25) * k, CFrame.new(0, 0.05 * k, 0.72 * k), cloth, M.Fabric)
	wear(model, "Head", "CowlPeak", Vector3.new(0.4, 0.55, 0.4) * k, CFrame.new(0, 0.72 * k, 0.75 * k) * CFrame.Angles(math.rad(-40), 0, 0), cloth, M.Fabric)
	wear(model, "UpperTorso", "CowlDrape", Vector3.new(2.3, 0.6, 1.3) * k, CFrame.new(0, 0.62 * k, 0.05 * k), dark(cloth, 0.06), M.Fabric)
	for _, x in ipairs({ -1, 1 }) do
		wear(model, "Head", "Eye", Vector3.new(0.18, 0.18, 0.08) * k, CFrame.new(x * 0.22 * k, 0.04 * k, -0.6 * k), look.eyes or C3(255, 230, 150), M.Neon, Ball)
		wear(model, x < 0 and "LeftUpperArm" or "RightUpperArm", "Sleeve", Vector3.new(1.25, 0.9, 1.25) * k, CFrame.new(0, -0.55 * k, 0), dark(cloth, 0.1), M.Fabric)
	end
	-- 해진 옷자락 (길이가 제각각인 띠 아홉, 바깥쪽이 짙다)
	for i = 0, 8 do
		local a = (i / 9) * math.pi * 2
		local len = (2.4 + ((i * 7) % 3) * 0.5) * k
		wear(model, "LowerTorso", "Rag", Vector3.new(0.75 * k, len, 0.07 * k), CFrame.new(math.cos(a) * 0.82 * k, -len / 2 - 0.05 * k, math.sin(a) * 0.55 * k) * CFrame.Angles(math.sin(a) * 0.2, -a, math.cos(a) * 0.12), dark(cloth, (i % 3) * 0.12), M.Fabric)
	end
	local _ = boss
end

-- 새 무사 (학·봉황): 몸 전체가 깃 빛깔, 부리와 볏, 등에 접은 날개 (끝깃은 짙게), 꼬리깃, 새 발
FORMS.bird = function(model, look, k, boss)
	local feather = look.feather or C3(240, 240, 240)
	local crest = look.crest or C3(210, 40, 40)
	local beak = look.beak or C3(225, 185, 90)
	local tip = look.tip or dark(feather, 0.75)
	clearFace(model)
	paint(model, { "Head", "UpperTorso", "LowerTorso" }, feather, M.SmoothPlastic)
	paint(model, ARMS, feather, M.SmoothPlastic)
	paint(model, { "LeftUpperLeg", "RightUpperLeg" }, look.thigh or dark(feather, 0.08), M.SmoothPlastic)
	paint(model, { "LeftLowerLeg", "RightLowerLeg", "LeftFoot", "RightFoot" }, dark(beak, 0.1), M.SmoothPlastic)
	local hs = sizeOf(model, "Head")
	wear(model, "Head", "Beak", Vector3.new(0.2, 0.18, 1.0) * k, CFrame.new(0, -hs.Y * 0.02, -hs.Z * 0.9) * CFrame.Angles(math.rad(-8), 0, 0), beak, M.SmoothPlastic)
	wear(model, "Head", "BeakLow", Vector3.new(0.16, 0.09, 0.72) * k, CFrame.new(0, -hs.Y * 0.15, -hs.Z * 0.76) * CFrame.Angles(math.rad(4), 0, 0), dark(beak, 0.2), M.SmoothPlastic)
	for _, x in ipairs({ -1, 1 }) do
		wear(model, "Head", "Eye", Vector3.new(0.12, 0.12, 0.12) * k, CFrame.new(x * hs.X * 0.34, hs.Y * 0.12, -hs.Z * 0.4), look.eyes or C3(20, 20, 20), M.SmoothPlastic, Ball)
	end
	-- 가슴 깃 (몸보다 옅은 둥근 판)과 목둘레 깃
	local ut = sizeOf(model, "UpperTorso")
	-- 2.8판: 가슴에 공이 붙은 것처럼 보여, 몸에 붙은 얇은 깃 판 셋으로 (위가 넓고 아래로 겹친다)
	for j = 0, 2 do
		wear(model, "UpperTorso", "Breast", Vector3.new(ut.X * (0.7 - j * 0.14), ut.Y * 0.32, 0.08 * k), CFrame.new(0, ut.Y * (0.22 - j * 0.24), -ut.Z * 0.5 - 0.01), j == 0 and (look.breast or light(feather, 0.18)) or light(feather, 0.1 - j * 0.04), M.SmoothPlastic, Ball)
	end
	wear(model, "UpperTorso", "NeckRuff", Vector3.new(ut.X * 0.6, 0.35 * k, ut.Z * 1.1), CFrame.new(0, ut.Y * 0.48, 0), look.neck or feather, M.SmoothPlastic, Ball)
	-- 볏: 정수리의 붉은 점 (학) 또는 뒤로 넘어가는 깃 (봉황)
	if look.longCrest then
		for j = 0, 2 do
			wear(model, "Head", "Crest", Vector3.new(0.08, 0.65 - j * 0.1, 0.26) * k, CFrame.new(0, hs.Y * (0.55 + j * 0.04), hs.Z * (0.1 + j * 0.2)) * CFrame.Angles(math.rad(-35 - j * 15), 0, 0), crest, M.SmoothPlastic)
		end
	else
		wear(model, "Head", "Crest", Vector3.new(hs.X * 0.5, 0.12 * k, hs.Z * 0.5), CFrame.new(0, hs.Y * 0.5, 0), crest, M.SmoothPlastic, Ball)
	end
	-- 접은 날개: 등 양쪽으로 깃 다섯 겹, 아래 두 겹은 끝깃 빛깔
	for _, x in ipairs({ -1, 1 }) do
		for j = 0, 4 do
			wear(model, "UpperTorso", "Feather", Vector3.new(0.1, (1.7 - j * 0.14) * k, 0.42 * k), CFrame.new(x * (0.55 + j * 0.1) * k, (0.2 - j * 0.24) * k, (0.56 + j * 0.03) * k) * CFrame.Angles(math.rad(12), 0, x * math.rad(8 + j * 5)), j >= 3 and tip or feather, M.SmoothPlastic)
		end
	end
	if look.longTail then
		-- 봉황의 긴 꼬리깃: 땅까지 길게 휘어 흐른다
		for j = -2, 2 do
			local cf = CFrame.new(j * 0.16 * k, -0.1 * k, 0.6 * k) * CFrame.Angles(math.rad(-50), 0, math.rad(j * 9))
			for s = 0, 2 do
				wear(model, "LowerTorso", "TailPlume", Vector3.new(0.18 * k, 1.1 * k, 0.05), cf * CFrame.new(0, -0.55 * k, 0), s == 2 and look.longTail or (j == 0 and crest or feather), M.SmoothPlastic)
				cf = cf * CFrame.new(0, -1.05 * k, 0) * CFrame.Angles(math.rad(-12), 0, 0)
			end
		end
	else
		for j = -2, 2 do
			wear(model, "LowerTorso", "TailFeather", Vector3.new(0.18, 1.1, 0.05) * k, CFrame.new(j * 0.17 * k, -0.4 * k, 0.85 * k) * CFrame.Angles(math.rad(-45), 0, math.rad(j * 10)), tip, M.SmoothPlastic)
		end
	end
	for _, f in ipairs({ "LeftFoot", "RightFoot" }) do
		for j = -1, 1 do
			wear(model, f, "Talon", Vector3.new(0.09, 0.07, 0.28) * k, CFrame.new(j * 0.22 * k, -0.04 * k, -0.52 * k) * CFrame.Angles(0, j * 0.3, 0), dark(beak, 0.35), M.SmoothPlastic)
		end
	end
	if look.fire then
		flame(model, "UpperTorso", look.fire, dark(look.fire, 0.35), (boss and 3.5 or 2) * k, 4)
	end
end

-- 해골: 몸을 지우고 뼈만 남긴다 (팔다리뼈와 관절, 갈비뼈, 등뼈, 골반, 해골 머리)
FORMS.skeleton = function(model, look, k, boss)
	local bone = look.bone or C3(222, 212, 186)
	local shade = dark(bone, 0.25)
	clearFace(model)
	hide(model, { "UpperTorso", "LowerTorso", "LeftUpperArm", "LeftLowerArm", "RightUpperArm", "RightLowerArm", "LeftUpperLeg", "LeftLowerLeg", "RightUpperLeg", "RightLowerLeg" })
	paint(model, { "Head" }, bone, M.SmoothPlastic)
	hide(model, { "LeftHand", "RightHand", "LeftFoot", "RightFoot" })
	for _, hn in ipairs({ "LeftHand", "RightHand" }) do
		wear(model, hn, "Palm", Vector3.new(0.45, 0.22, 0.35) * k, CFrame.new(0, 0, 0), bone, M.SmoothPlastic)
		for j = -1, 1 do
			wear(model, hn, "Finger", Vector3.new(0.07, 0.36, 0.07) * k, CFrame.new(j * 0.14 * k, -0.24 * k, -0.06 * k) * CFrame.Angles(math.rad(18), 0, 0), bone, M.SmoothPlastic)
		end
	end
	for _, fn in ipairs({ "LeftFoot", "RightFoot" }) do
		wear(model, fn, "FootBone", Vector3.new(0.4, 0.16, 0.85) * k, CFrame.new(0, 0, -0.15 * k), bone, M.SmoothPlastic)
	end
	for _, n in ipairs(LIMBS) do
		local s = sizeOf(model, n)
		wear(model, n, "Bone", Vector3.new(s.Y * 0.92, 0.3 * k, 0.3 * k), UPRIGHT, bone, M.SmoothPlastic, Cyl)
		wear(model, n, "Knob", Vector3.new(0.4, 0.4, 0.4) * k, CFrame.new(0, -s.Y * 0.46, 0), shade, M.SmoothPlastic, Ball)
		if string.find(n, "Upper") then
			wear(model, n, "Joint", Vector3.new(0.46, 0.46, 0.46) * k, CFrame.new(0, s.Y * 0.44, 0), shade, M.SmoothPlastic, Ball)
		end
	end
	local ut = sizeOf(model, "UpperTorso")
	-- 등뼈 (마디 다섯)
	for i = 0, 4 do
		wear(model, "UpperTorso", "Vertebra", Vector3.new(0.3, 0.22, 0.3) * k, CFrame.new(0, (0.65 - i * 0.33) * k, 0.2 * k), shade, M.SmoothPlastic)
	end
	-- 갈비뼈 넷: 옆으로 둘렀다가 앞에서 가슴뼈로 모인다
	for i = 0, 3 do
		local y = (0.5 - i * 0.28) * k
		local w = ut.X * (0.42 - i * 0.03)
		for _, x in ipairs({ -1, 1 }) do
			wear(model, "UpperTorso", "RibSide", Vector3.new(0.09 * k, 0.09 * k, ut.Z * 0.75), CFrame.new(x * w, y, -0.05 * k), bone, M.SmoothPlastic)
			wear(model, "UpperTorso", "RibFront", Vector3.new(w * 0.95, 0.09 * k, 0.09 * k), CFrame.new(x * w * 0.5, y - 0.06 * k, -ut.Z * 0.42) * CFrame.Angles(0, 0, x * math.rad(12)), bone, M.SmoothPlastic)
		end
	end
	wear(model, "UpperTorso", "Sternum", Vector3.new(0.14, 1.0, 0.1) * k, CFrame.new(0, 0.15 * k, -ut.Z * 0.44), bone, M.SmoothPlastic)
	wear(model, "UpperTorso", "Collarbone", Vector3.new(ut.X * 1.35, 0.12 * k, 0.12 * k), CFrame.new(0, 0.74 * k, -0.15 * k), bone, M.SmoothPlastic)
	for _, x in ipairs({ -1, 1 }) do
		wear(model, "UpperTorso", "ShoulderBlade", Vector3.new(0.6, 0.7, 0.08) * k, CFrame.new(x * 0.45 * k, 0.4 * k, 0.32 * k) * CFrame.Angles(0, 0, x * 0.2), shade, M.SmoothPlastic)
	end
	wear(model, "LowerTorso", "Pelvis", Vector3.new(1.4, 0.4, 0.6) * k, CFrame.new(0, 0, 0), bone, M.SmoothPlastic)
	-- 해골 머리: 눈구멍, 코구멍, 아래턱
	local hs = sizeOf(model, "Head")
	for _, x in ipairs({ -1, 1 }) do
		wear(model, "Head", "Socket", Vector3.new(0.3, 0.3, 0.08) * k, CFrame.new(x * hs.X * 0.21, hs.Y * 0.06, -hs.Z * 0.49), C3(12, 10, 10), M.SmoothPlastic, Ball)
		wear(model, "Head", "Eye", Vector3.new(0.1, 0.1, 0.06) * k, CFrame.new(x * hs.X * 0.21, hs.Y * 0.06, -hs.Z * 0.52), look.eyes or C3(255, 200, 90), M.Neon, Ball)
	end
	wear(model, "Head", "Nose", Vector3.new(0.12, 0.16, 0.06) * k, CFrame.new(0, -hs.Y * 0.12, -hs.Z * 0.5), C3(12, 10, 10), M.SmoothPlastic)
	wear(model, "Head", "Jaw", Vector3.new(hs.X * 0.62, hs.Y * 0.18, hs.Z * 0.55), CFrame.new(0, -hs.Y * 0.42, -hs.Z * 0.18), shade, M.SmoothPlastic)
	if look.armor then
		-- 왕릉 수호병: 녹슨 청동 투구, 한쪽 어깨받이, 해진 허리 천
		local metal = look.metal or C3(120, 95, 60)
		disc(model, "Head", "Helmet", hs.X * 1.1, hs.Y * 0.36, CFrame.new(0, hs.Y * 0.32, 0), metal, M.Metal)
		wear(model, "Head", "HelmetDome", Vector3.new(hs.X * 1.1, hs.Y * 0.5, hs.Z * 1.1), CFrame.new(0, hs.Y * 0.48, 0), metal, M.Metal, Ball)
		wear(model, "UpperTorso", "Pauldron", Vector3.new(ut.X * 0.42, 0.14 * k, ut.Z * 1.1), CFrame.new(ut.X * 0.5, 0.72 * k, 0) * CFrame.Angles(0, 0, math.rad(-22)), metal, M.Metal)
		for _, z in ipairs({ -1, 1 }) do
			wear(model, "LowerTorso", "Loincloth", Vector3.new(0.8 * k, 1.1 * k, 0.06), CFrame.new(0, -0.6 * k, z * 0.35 * k), look.cloth or C3(90, 30, 25))
		end
	end
	local _ = boss
end

-- 버섯 사람: 자루 빛깔의 몸, 층층이 쌓아 둥근 갓 (겉은 매끈하고 아래는 주름), 갓 위에 붙은 흰 점, 까만 눈
local function mushroomCap(model: Model, partName: string, base: CFrame, R: number, H: number, cap: Color3, gill: Color3, spot: Color3?, spotMat: Enum.Material?, spotAlpha: number?)
	-- 아래 절반은 넓은 원판 다섯 층 (가장자리가 둥글게 말린다), 위 절반은 둥근 공의 윗면 (공의 아래쪽은 원판 속에 숨는다)
	local n = 5
	for i = 0, n - 1 do
		local t = (i + 0.5) / n * 0.5
		local r = R * math.sqrt(1 - t * t)
		disc(model, partName, "Cap", r * 2, H * 0.5 / n + 0.03, base * CFrame.new(0, H * t, 0), cap, M.SmoothPlastic)
	end
	local rTop = R * math.sqrt(1 - 0.25)
	wear(model, partName, "CapTop", Vector3.new(rTop * 2, H, rTop * 2), base * CFrame.new(0, H * 0.5, 0), cap, M.SmoothPlastic, Ball)
	disc(model, partName, "Gills", R * 1.92, 0.06, base * CFrame.new(0, -0.01, 0), gill, M.SmoothPlastic)
	disc(model, partName, "GillRing", R * 1.1, 0.07, base * CFrame.new(0, -0.02, 0), dark(gill, 0.18), M.SmoothPlastic)
	if spot then
		-- 점: 갓 겉면에 붙인 납작한 원 (겉면의 기울기를 따른다)
		local spots = { { 0.95, 0 }, { 0.78, 0.7 }, { 0.8, 2.8 }, { 0.76, 4.8 }, { 0.55, 1.7 }, { 0.58, 3.8 }, { 0.52, 5.7 }, { 0.3, 0.2 }, { 0.32, 2.3 }, { 0.28, 4.3 } }
		for _, sp in ipairs(spots) do
			local t, phi = sp[1], sp[2]
			local pos: Vector3, nrm: Vector3
			if t <= 0.5 then
				local r = R * math.sqrt(1 - t * t)
				pos = Vector3.new(math.cos(phi) * r, H * t, math.sin(phi) * r)
				nrm = Vector3.new(pos.X / (R * R), pos.Y / (H * H), pos.Z / (R * R)).Unit
			else
				-- 위 공: 가운데 높이 H/2, 반지름 rTop, 높이 반지름 H/2
				local u = (t - 0.5) / 0.5
				local r = rTop * math.sqrt(math.max(0, 1 - u * u))
				pos = Vector3.new(math.cos(phi) * r, H * 0.5 + u * H * 0.5, math.sin(phi) * r)
				local hy = pos.Y - H * 0.5
				nrm = Vector3.new(pos.X / (rTop * rTop), hy / (H * H * 0.25), pos.Z / (rTop * rTop))
				nrm = nrm.Magnitude > 1e-4 and nrm.Unit or Vector3.new(0, 1, 0)
			end
			local d = R * (0.34 - math.abs(t - 0.5) * 0.12)
			local at = base * CFrame.lookAt(pos + nrm * 0.03, pos + nrm * 2) * CFrame.Angles(0, math.rad(90), 0)
			local p = wear(model, partName, "Spot", Vector3.new(0.06, d, d), at, spot, spotMat or M.SmoothPlastic, Cyl)
			if p and spotAlpha then
				p.Transparency = spotAlpha
			end
		end
	end
end
FORMS.shroom = function(model, look, k, boss)
	local cap = look.capColor or C3(170, 40, 50)
	local stem = look.skin or C3(232, 222, 198)
	clearFace(model)
	paint(model, { "Head", "UpperTorso" }, stem, M.SmoothPlastic)
	paint(model, ARMS, stem, M.SmoothPlastic)
	paint(model, { "LowerTorso" }, dark(stem, 0.08), M.SmoothPlastic)
	-- 아래로 갈수록 흙 빛깔 (뿌리 쪽)
	paint(model, { "LeftUpperLeg", "RightUpperLeg" }, dark(stem, 0.12), M.SmoothPlastic)
	paint(model, { "LeftLowerLeg", "RightLowerLeg", "LeftFoot", "RightFoot" }, C3(110, 85, 60), M.SmoothPlastic)
	local hs = sizeOf(model, "Head")
	local R = (look.capSize or 3.0) * k * 0.5
	mushroomCap(model, "Head", CFrame.new(0, hs.Y * 0.34, 0), R, R * 0.62, cap, light(stem, 0.1):Lerp(C3(200, 180, 150), 0.4), look.spot or C3(245, 240, 228), look.spotGlow and M.Neon or nil, look.spotGlow and 0.3 or nil)
	for _, x in ipairs({ -1, 1 }) do
		wear(model, "Head", "Eye", Vector3.new(0.17, 0.2, 0.08) * k, CFrame.new(x * hs.X * 0.2, -hs.Y * 0.08, -hs.Z * 0.48), C3(18, 14, 12), M.SmoothPlastic, Ball)
	end
	-- 허리에 두른 이끼 띠, 몸통의 옅은 세로 결 (버섯 자루의 결)
	local ut0, lt0 = sizeOf(model, "UpperTorso"), sizeOf(model, "LowerTorso")
	wear(model, "LowerTorso", "MossSash", Vector3.new(lt0.X * 1.06, 0.36 * k, lt0.Z * 1.12), CFrame.new(0, 0.05 * k, 0), C3(84, 112, 56), M.Grass)
	for i = -2, 2 do
		wear(model, "UpperTorso", "StemGrain", Vector3.new(0.05 * k, ut0.Y * 0.8, 0.04), CFrame.new(i * ut0.X * 0.17, -ut0.Y * 0.05, -ut0.Z * 0.5 - 0.01), dark(stem, 0.08), M.SmoothPlastic)
	end
	if boss then
		-- 버섯왕: 목의 흰 턱받이 (갓 아래 고리), 어깨와 등에서 돋은 작은 버섯 무리, 어깨를 덮은 이끼 망토
		local ut = sizeOf(model, "UpperTorso")
		disc(model, "Head", "Ring", hs.X * 1.3, 0.12 * k, CFrame.new(0, -hs.Y * 0.45, 0), light(stem, 0.2), M.SmoothPlastic)
		wear(model, "Head", "RingDrape", Vector3.new(hs.X * 1.25, hs.Y * 0.25, hs.Z * 1.25), CFrame.new(0, -hs.Y * 0.56, 0), dark(stem, 0.04), M.SmoothPlastic, Ball)
		local moss = C3(78, 108, 52)
		for _, x in ipairs({ -1, 1 }) do
			wear(model, "UpperTorso", "ShoulderMoss", Vector3.new(ut.X * 0.42, 0.16 * k, ut.Z * 1.15), CFrame.new(x * ut.X * 0.3, ut.Y * 0.5, 0), moss, M.Grass)
		end
		-- 어깨와 등에서 돋은 작은 버섯 (크기가 제각각, 바깥으로 기운다)
		local sprouts = { { -0.46, 0.5, 0.1, 1.0, -0.6 }, { -0.34, 0.5, 0.35, 0.7, -0.3 }, { -0.48, 0.4, -0.25, 0.55, -0.9 }, { 0.44, 0.5, 0.2, 0.85, 0.6 }, { 0.48, 0.4, -0.2, 0.55, 0.9 }, { -0.15, 0.2, 0.52, 0.75, -0.1 }, { 0.2, -0.1, 0.52, 0.6, 0.15 } }
		for _, s in ipairs(sprouts) do
			local x, y, z, sc, tilt = s[1], s[2], s[3], s[4] * 1.15, s[5]
			local at = CFrame.new(x * ut.X, ut.Y * y, z * ut.Z) * CFrame.Angles(z > 0.4 and math.rad(70) or 0, 0, -tilt * 0.6)
			wear(model, "UpperTorso", "SproutStem", Vector3.new(0.55 * sc * k, 0.2 * sc * k, 0.2 * sc * k), at * CFrame.new(0, 0.27 * sc * k, 0) * UPRIGHT, stem, M.SmoothPlastic, Cyl)
			wear(model, "UpperTorso", "SproutCap", Vector3.new(0.8 * sc * k, 0.42 * sc * k, 0.8 * sc * k), at * CFrame.new(0, 0.56 * sc * k, 0), cap, M.SmoothPlastic, Ball)
			wear(model, "UpperTorso", "SproutGill", Vector3.new(0.05, 0.76 * sc * k, 0.76 * sc * k), at * CFrame.new(0, 0.5 * sc * k, 0) * UPRIGHT, C3(205, 185, 155), M.SmoothPlastic, Cyl)
		end
	end
	if look.spore then
		glow(model, "Head", look.spore, 8 * k, 0.8)
	end
end

-- 늪 거한: 굽은 등과 큰 배, 엄니, 늘어진 귀, 등에 붙은 이끼와 물풀, 가죽 허리 천
FORMS.troll = function(model, look, k, boss)
	local skin = look.skin or C3(105, 125, 80)
	clearFace(model)
	paint(model, { "Head", "UpperTorso", "LowerTorso" }, skin, M.SmoothPlastic)
	paint(model, ARMS, skin, M.SmoothPlastic)
	paint(model, LEGS, dark(skin, 0.1), M.SmoothPlastic)
	-- 2.8판: 배와 등의 혹을 몸에 붙게 납작하게 (공이 툭 튀어나온 것처럼 보였다)
	wear(model, "UpperTorso", "Belly", Vector3.new(1.75, 1.2, 0.5) * k, CFrame.new(0, -0.3 * k, -0.4 * k), light(skin, 0.1), M.SmoothPlastic, Ball)
	wear(model, "UpperTorso", "Hump", Vector3.new(1.9, 1.1, 0.7) * k, CFrame.new(0, 0.6 * k, 0.35 * k), dark(skin, 0.1), M.SmoothPlastic, Ball)
	for _, x in ipairs({ -1, 1 }) do
		wear(model, "Head", "Tusk", Vector3.new(0.13, 0.42, 0.13) * k, CFrame.new(x * 0.27 * k, -0.24 * k, -0.6 * k) * CFrame.Angles(math.rad(-10), 0, x * math.rad(14)), C3(232, 222, 196), M.SmoothPlastic)
		wear(model, "Head", "Ear", Vector3.new(0.1, 0.55, 0.32) * k, CFrame.new(x * 0.68 * k, 0.02 * k, 0) * CFrame.Angles(0, 0, -x * math.rad(72)), skin, M.SmoothPlastic)
		wear(model, "Head", "Eye", Vector3.new(0.18, 0.1, 0.06) * k, CFrame.new(x * 0.23 * k, 0.12 * k, -0.6 * k), look.eyes or C3(230, 200, 80), M.SmoothPlastic)
	end
	wear(model, "Head", "Brow", Vector3.new(1.0, 0.18, 0.2) * k, CFrame.new(0, 0.24 * k, -0.56 * k), dark(skin, 0.18), M.SmoothPlastic)
	local moss = C3(70, 105, 42)
	wear(model, "UpperTorso", "Moss", Vector3.new(1.5, 0.2, 0.9) * k, CFrame.new(0, 1.1 * k, 0.45 * k), moss, M.Grass)
	for i = 0, 3 do
		wear(model, "UpperTorso", "Weed", Vector3.new(0.1, 1.0, 0.05) * k, CFrame.new((i - 1.5) * 0.4 * k, 0.4 * k, 0.98 * k) * CFrame.Angles(math.rad(-8), 0, (i - 1.5) * 0.1), dark(moss, 0.15), M.SmoothPlastic)
	end
	wear(model, "LowerTorso", "Loincloth", Vector3.new(1.1 * k, 1.0 * k, 0.08), CFrame.new(0, -0.55 * k, -0.52 * k), LEATHER, M.Leather)
	wear(model, "LowerTorso", "Belt", Vector3.new(2.05 * k, 0.3 * k, 1.12 * k), CFrame.new(0, 0.05 * k, 0), dark(LEATHER, 0.2), M.Leather)
	local _ = boss
end

-- 뱀 자객: 다리 대신 땅을 따라 굽이치는 꼬리, 머리 뒤로 펼친 목덜미, 배의 비늘 띠, 갈라진 혀
FORMS.naga = function(model, look, k, boss)
	local scale = look.skin or C3(60, 105, 60)
	local belly = look.belly or C3(196, 190, 125)
	clearFace(model)
	hide(model, LEGS)
	paint(model, { "Head", "UpperTorso", "LowerTorso" }, scale, M.SmoothPlastic)
	paint(model, ARMS, scale, M.SmoothPlastic)
	wear(model, "Head", "Hood", Vector3.new(2.1, 1.7, 0.14) * k, CFrame.new(0, 0.05 * k, 0.42 * k), dark(scale, 0.2), M.SmoothPlastic, Ball)
	wear(model, "Head", "HoodMark", Vector3.new(0.7, 0.5, 0.05) * k, CFrame.new(0, 0.1 * k, 0.5 * k), belly, M.SmoothPlastic, Ball)
	for _, x in ipairs({ -1, 1 }) do
		wear(model, "Head", "Eye", Vector3.new(0.24, 0.12, 0.06) * k, CFrame.new(x * 0.24 * k, 0.1 * k, -0.6 * k), look.eyes or C3(235, 210, 60), M.Neon)
		wear(model, "Head", "Tongue", Vector3.new(0.04, 0.04, 0.32) * k, CFrame.new(x * 0.04 * k, -0.3 * k, -0.84 * k) * CFrame.Angles(0, x * math.rad(14), 0), C3(190, 40, 60), M.SmoothPlastic)
	end
	for i = 0, 3 do
		wear(model, "UpperTorso", "BellyScale", Vector3.new(1.15 - i * 0.1, 0.2, 0.06) * k, CFrame.new(0, (0.5 - i * 0.34) * k, -0.52 * k), belly, M.SmoothPlastic)
	end
	-- 2.8판: 꼬리가 공 아홉이 줄 선 것처럼 끊겨 보였다. 마디를 촘촘히 겹치고 빛깔을 한 가지로 (배 비늘만 옅게) 매끈하게 굽이친다
	local cf = CFrame.new(0, -0.7 * k, 0.1 * k)
	local n = 14
	for j = 0, n - 1 do
		local u = j / (n - 1)
		local w = (1.4 * (1 - u) ^ 0.8 + 0.22) * k
		wear(model, "LowerTorso", "Coil", Vector3.new(w, w * 0.8, w * 1.6), cf, dark(scale, u * 0.1), M.SmoothPlastic, Ball)
		wear(model, "LowerTorso", "CoilBelly", Vector3.new(w * 0.72, w * 0.3, w * 1.4), cf * CFrame.new(0, -w * 0.3, 0), belly, M.SmoothPlastic, Ball)
		local sway = math.sin(u * math.pi * 2.2) * 0.22
		cf = cf * CFrame.new(0, (j < 3 and -0.42 or -0.01) * k, 0.45 * k) * CFrame.Angles(0, sway * 0.5, 0)
	end
	local _ = boss
end

-- 늑대 무사: 털 몸, 늑대 머리 (주둥이·세운 귀), 목의 갈기, 가죽 어깨끈과 허리 천, 꼬리, 발톱
FORMS.wolf = function(model, look, k, boss)
	local fur = look.fur or C3(80, 70, 65)
	local pale = look.pale or light(fur, 0.35)
	clearFace(model)
	paint(model, { "Head", "UpperTorso", "LowerTorso" }, fur, M.Fabric)
	paint(model, ARMS, fur, M.Fabric)
	paint(model, LEGS, dark(fur, 0.12), M.Fabric)
	wear(model, "Head", "Snout", Vector3.new(0.58, 0.48, 0.9) * k, CFrame.new(0, -0.15 * k, -0.74 * k), fur, M.Fabric)
	wear(model, "Head", "Muzzle", Vector3.new(0.5, 0.22, 0.85) * k, CFrame.new(0, -0.34 * k, -0.72 * k), pale, M.Fabric)
	wear(model, "Head", "Nose", Vector3.new(0.24, 0.16, 0.12) * k, CFrame.new(0, -0.02 * k, -1.18 * k), C3(15, 10, 10), M.SmoothPlastic)
	for _, x in ipairs({ -1, 1 }) do
		wear(model, "Head", "Ear", Vector3.new(0.3, 0.55, 0.12) * k, CFrame.new(x * 0.34 * k, 0.68 * k, 0.05 * k) * CFrame.Angles(0, 0, -x * math.rad(12)), fur, M.Fabric)
		wear(model, "Head", "Eye", Vector3.new(0.2, 0.09, 0.06) * k, CFrame.new(x * 0.25 * k, 0.15 * k, -0.6 * k) * CFrame.Angles(0, 0, x * math.rad(-15)), look.eyes or C3(230, 180, 60), M.Neon)
	end
	-- 갈기: 목과 어깨를 두르는 한 덩어리의 털 (사자는 머리 둘레까지 크게)
	wear(model, "UpperTorso", "Ruff", Vector3.new(2.2, 0.9, 1.4) * k, CFrame.new(0, 0.72 * k, 0.05 * k), pale, M.Fabric, Ball)
	if look.lion then
		-- 얼굴은 드러나고, 머리 둘레와 뒤를 덮는다
		wear(model, "Head", "Mane", Vector3.new(2.1, 2.1, 1.1) * k, CFrame.new(0, 0.05 * k, 0.55 * k), dark(pale, 0.18), M.Fabric, Ball)
		wear(model, "Head", "Mane2", Vector3.new(1.75, 1.8, 0.9) * k, CFrame.new(0, 0.12 * k, 0.32 * k), pale, M.Fabric, Ball)
	end
	-- 가죽 어깨끈 (비스듬히)과 허리 천
	wear(model, "UpperTorso", "Strap", Vector3.new(0.26 * k, 2.0 * k, 1.08 * k), CFrame.new(0, 0, 0) * CFrame.Angles(0, 0, math.rad(35)), LEATHER, M.Leather)
	wear(model, "LowerTorso", "Belt", Vector3.new(2.06 * k, 0.3 * k, 1.1 * k), CFrame.new(0, 0.05 * k, 0), LEATHER, M.Leather)
	wear(model, "LowerTorso", "Loincloth", Vector3.new(0.9 * k, 0.9 * k, 0.07), CFrame.new(0, -0.5 * k, -0.54 * k), look.cloth or C3(90, 30, 30))
	local prev = CFrame.new(0, 0, 0.5 * k)
	for j = 1, 4 do
		local seg = prev * CFrame.Angles(math.rad(j == 1 and -60 or 16), 0, 0) * CFrame.new(0, -0.3 * k, 0)
		wear(model, "LowerTorso", "Tail", Vector3.new(0.42 - j * 0.04, 0.72, 0.42 - j * 0.04) * k * (look.lion and 0.7 or 1), seg, j == 4 and (look.lion and dark(pale, 0.3) or pale) or fur, M.Fabric)
		prev = seg * CFrame.new(0, -0.3 * k, 0)
	end
	for _, hn in ipairs({ "LeftHand", "RightHand" }) do
		for j = -1, 1 do
			wear(model, hn, "Claw", Vector3.new(0.07, 0.35, 0.07) * k, CFrame.new(j * 0.2 * k, -0.3 * k, -0.14 * k) * CFrame.Angles(math.rad(25), 0, 0), C3(230, 220, 205), M.SmoothPlastic)
		end
	end
	if look.scarf then
		-- 혈랑: 목에서 뒤로 휘날리는 핏빛 목도리
		for i = 0, 2 do
			wear(model, "UpperTorso", "Scarf", Vector3.new((1.3 - i * 0.2) * k, 0.36 * k, 0.08), CFrame.new(0, (0.7 - i * 0.38) * k, (0.62 + i * 0.1) * k) * CFrame.Angles(math.rad(22 + i * 10), 0, 0), look.scarf)
		end
	end
	local _ = boss
end


------------------------------------------------------------------------
-- 3.0판 환생 권법 넷의 동작
------------------------------------------------------------------------
-- 윤회권: 한 손은 세운 손바닥으로 앞을 겨누고, 한 손은 가슴 앞에 합장하듯. 등 뒤에 바퀴를 지고 곧게 선다
local RINNE = { W = { 0, -20, 0 }, N = { 0, 20, 0 }, RS = { 75, 0, 10 }, RE = { 40, 0, 0 }, LS = { 50, 0, -30 }, LE = { 115, 0, 0 }, RH = { -18, 0, 10 }, LH = { 24, 0, -8 }, RK = { -35, 0, 0 }, LK = { -40, 0, 0 } }
local function rinneEnd(yaw: number?): Joints
	local j = table.clone(RINNE)
	j.R = { 0, yaw or 0, 0, 0, -0.8, 0 }
	return j
end
-- 손바닥을 바퀴 돌리듯 원을 그리며 내민다
A.rinne_palm_r = {
	{ t = 0, j = { W = { 0, -40, 0 }, N = { 0, 30, 0 }, RS = { 140, 0, 40 }, RE = { 70, 0, 0 }, LS = { 50, 0, -30 }, LE = { 110, 0, 0 }, R = { 0, 0, 0, 0, -0.8, 0 } } },
	{ t = 0.4, e = "snap", j = { W = { 0, 35, 0 }, N = { 0, -25, 0 }, RS = { 90, 0, -5 }, RE = { 0, 0, 0 }, LS = { 40, 0, -30 }, LE = { 120, 0, 0 }, RK = { -30, 0, 0 }, LK = { -50, 0, 0 }, R = { -8, 0, 0, 0, -1.0, -0.8 } } },
	{ t = 1, j = rinneEnd() },
}
A.rinne_palm_l = mirror(A.rinne_palm_r)
-- 몸을 바퀴처럼 눕혀 두 번 돌려 찬다
A.rinne_wheel_kick = {
	{ t = 0, j = { W = { 0, -30, 0 }, RS = { 60, 0, 60 }, LS = { 60, 0, -60 }, RE = { 20, 0, 0 }, LE = { 20, 0, 0 }, R = { 0, 0, 0, 0, -0.9, 0 } } },
	{ t = 0.35, e = "snap", j = { W = { -10, 0, -25 }, RS = { 80, 0, 90 }, LS = { 80, 0, -90 }, RH = { 95, 0, 30 }, RK = { 0, 0, 0 }, LK = { -20, 0, 0 }, R = { 0, -360, 20, 0, -0.2, 0 } } },
	{ t = 0.7, e = "snap", j = { W = { -10, 0, 25 }, RS = { 80, 0, 90 }, LS = { 80, 0, -90 }, LH = { 95, 0, -30 }, LK = { 0, 0, 0 }, RK = { -20, 0, 0 }, R = { 0, -720, -20, 0, -0.2, 0 } } },
	{ t = 1, j = rinneEnd(-720) },
}
-- 두 손을 겹쳐 앞으로 곧게 쭉 뻗는다 (전생일격)
A.rinne_thrust = {
	{ t = 0, j = { W = { -10, -50, 0 }, N = { 0, 40, 0 }, RS = { 30, 0, 30 }, RE = { 120, 0, 0 }, LS = { 40, 0, -10 }, LE = { 120, 0, 0 }, RK = { -60, 0, 0 }, LK = { -40, 0, 0 }, R = { 0, 0, 0, 0, -1.2, 0.6 } } },
	{ t = 0.45, e = "snap", j = { W = { 15, 30, 0 }, N = { -5, -20, 0 }, RS = { 92, 0, -8 }, RE = { 0, 0, 0 }, LS = { 92, 0, 8 }, LE = { 0, 0, 0 }, RH = { -40, 0, 0 }, RK = { -10, 0, 0 }, LH = { 50, 0, 0 }, LK = { -60, 0, 0 }, R = { -12, 0, 0, 0, -1.3, -1.6 } } },
	{ t = 1, j = rinneEnd() },
}
-- 윤회일장 (강타): 손바닥으로 바퀴 무늬를 찍는다. 한 바퀴 돌아 낮게 내리누른다
A.rinne_seal = {
	{ t = 0, j = { W = { -15, 0, 0 }, RS = { 170, 0, 20 }, RE = { 30, 0, 0 }, LS = { 50, 0, -30 }, LE = { 110, 0, 0 }, R = { 0, 0, 0, 0, -0.5, 0 } } },
	{ t = 0.4, e = "snap", j = { W = { 20, 0, 0 }, RS = { 120, 0, 10 }, RE = { 10, 0, 0 }, LS = { 50, 0, -30 }, LE = { 110, 0, 0 }, RK = { -60, 0, 0 }, LK = { -70, 0, 0 }, R = { -10, -360, 0, 0, -1.4, -1.2 } } },
	{ t = 0.6, e = "snap", j = { W = { 35, 0, 0 }, RS = { 60, 0, 0 }, RE = { 0, 0, 0 }, LS = { 40, 0, -30 }, LE = { 110, 0, 0 }, RK = { -80, 0, 0 }, LK = { -90, 0, 0 }, R = { -15, -360, 0, 0, -1.8, -1.4 } } },
	{ t = 1, j = rinneEnd(-360) },
}
-- 등 뒤의 바퀴를 잡아 머리 위로 크게 돌려 던진다
A.rinne_throw = {
	{ t = 0, j = { W = { -20, 20, 0 }, N = { -10, -10, 0 }, RS = { 178, 0, 20 }, RE = { 40, 0, 0 }, LS = { 160, 0, -20 }, LE = { 40, 0, 0 }, RK = { -20, 0, 0 }, LK = { -30, 0, 0 }, R = { 8, 0, 0, 0, -0.4, 0.4 } } },

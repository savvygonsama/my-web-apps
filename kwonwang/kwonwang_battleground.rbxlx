-- 몸을 틀며 손끝으로 씨앗을 부채꼴로 튕긴다
A.wood_flick = {
	{ t = 0, j = { W = { 0, -60, 0 }, N = { 0, 40, 0 }, RS = { 40, 0, -30 }, RE = { 100, 0, 0 }, LS = { 30, 0, -30 }, LE = { 80, 0, 0 }, R = { 0, 0, 0, 0, -0.9, 0.2 } } },
	{ t = 0.4, e = "snap", j = { W = { 0, 50, 0 }, N = { 0, -30, 0 }, RS = { 90, 0, 60 }, RE = { 10, 0, 0 }, LS = { 40, 0, -40 }, LE = { 90, 0, 0 }, RH = { 20, 0, 0 }, RK = { -30, 0, 0 }, R = { -5, 0, 0, 0, -1.0, -0.6 } } },
	{ t = 1, j = { RS = { 70, 0, 40 }, RE = { 30, 0, 0 }, LS = { 50, 0, -25 }, LE = { 60, 0, 0 }, R = { 0, 0, 0, 0, -1.0, -0.3 } } },

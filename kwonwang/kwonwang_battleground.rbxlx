	{ t = 1, j = reapEnd(-360) },
}


-- 2.5판 만목신권: 뿌리내린 장 (두 발을 땅에 박고 몸을 틀어 밀어낸다)
A.wood_palm_r = {
	{ t = 0, j = { W = { 0, -40, 0 }, N = { 0, 30, 0 }, RS = { 30, 0, 40 }, RE = { 110, 0, 0 }, LS = { 60, 0, -20 }, LE = { 60, 0, 0 }, RH = { -20, 0, 15 }, LH = { 25, 0, -15 }, RK = { -50, 0, 0 }, LK = { -45, 0, 0 }, R = { 0, 0, 0, 0, -1.2, 0.4 } } },
	{ t = 0.4, e = "snap", j = { W = { 0, 40, 0 }, N = { 0, -30, 0 }, RS = { 92, 0, 0 }, RE = { 0, 0, 0 }, LS = { 30, 0, -40 }, LE = { 100, 0, 0 }, RH = { -30, 0, 15 }, LH = { 35, 0, -15 }, RK = { -40, 0, 0 }, LK = { -55, 0, 0 }, R = { -10, 0, 0, 0, -1.3, -1.0 } } },
	{ t = 1, j = { RS = { 70, 0, 10 }, RE = { 40, 0, 0 }, LS = { 50, 0, -20 }, LE = { 60, 0, 0 }, R = { 0, 0, 0, 0, -1.2, -0.4 } } },
}
A.wood_palm_l = mirror(A.wood_palm_r)
-- 낮게 앉아 다리로 땅을 쓸며 한 바퀴 (뿌리 쓸기)
A.wood_sweep = {
	{ t = 0, j = { R = { 0, 0, 0, 0, -1.6, 0 }, RH = { 40, 0, 40 }, RK = { -10, 0, 0 }, LH = { -10, 0, -10 }, LK = { -90, 0, 0 }, RS = { 40, 0, 60 }, LS = { 40, 0, -60 } } },
	{ t = 0.5, j = { R = { 0, -200, 0, 0, -1.8, 0 }, RH = { 80, 0, 60 }, RK = { 0, 0, 0 }, LK = { -100, 0, 0 }, RS = { 30, 0, 70 }, LS = { 30, 0, -70 } } },
	{ t = 0.8, e = "snap", j = { R = { 0, -360, 0, 0, -1.8, 0 }, RH = { 60, 0, 50 }, LK = { -100, 0, 0 } } },
	{ t = 1, j = { R = { 0, -360, 0, 0, -1.2, 0 }, RH = { 0, 0, 10 }, RK = { -30, 0, 0 }, LK = { -40, 0, 0 }, RS = { 60, 0, 20 }, LS = { 60, 0, -20 } } },
}
-- 두 주먹을 머리 위로 모았다가 땅을 내리친다 (천년근)
A.wood_slam = {
	{ t = 0, j = { W = { -15, 0, 0 }, N = { 15, 0, 0 }, RS = { 170, 0, 15 }, RE = { 20, 0, 0 }, LS = { 170, 0, -15 }, LE = { 20, 0, 0 }, R = { 10, 0, 0, 0, 0.2, 0.3 } } },

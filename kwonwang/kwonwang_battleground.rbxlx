function Config.skyIslandAt(pos: Vector3): any
	if pos.Y < SY - 300 then
		return nil
	end
	for _, isl in ipairs(Config.SKY.islands) do
		if Vector3.new(pos.X - isl.at.X, 0, pos.Z - isl.at.Z).Magnitude <= isl.radius + 4 then
			return isl
		end
	end
	return nil
end

    <Item class="ModuleScript" referent="6">
      <Properties>
        <string name="Name">Poses</string>
        <string name="Source"><![CDATA[-- 권왕: 몸동작 (애니메이션 파일 없이 관절 각도로 직접 만든다)
-- 관절 이름: R(골반·몸 전체), W(허리), N(목), RS·RE(오른 어깨·팔꿈치), LS·LE(왼 어깨·팔꿈치), RH·RK(오른 엉덩이·무릎), LH·LK
-- 각도는 도(degree) {x, y, z}. R만 {x, y, z, 옆, 위, 앞뒤} (앞은 -)
--   어깨 x+ = 팔을 앞으로 든다, z+ = 오른팔을 옆으로 (왼팔은 z-)
--   팔꿈치 x+ = 앞으로 굽힌다, 엉덩이 x+ = 다리를 앞으로, 무릎 x- = 굽힌다
--   허리 y+ = 몸을 왼쪽으로 튼다 (오른손 지르기), R x- = 앞으로 숙인다
-- 기술 하나 = 키프레임 목록 { t = 0~1 (기술 길이에 대한 비율), e = "snap"(빠르게 꽂힘) / 없으면 부드럽게, j = 관절 }
local Poses = {}

type Joints = { [string]: { number } }
type Key = { t: number, e: string?, j: Joints }

-- 좌우 뒤집기 (왼손 기술을 오른손 기술에서 만든다)
local SWAP = { RS = "LS", LS = "RS", RE = "LE", LE = "RE", RH = "LH", LH = "RH", RK = "LK", LK = "RK" }
local function mirrorJ(j: Joints): Joints
	local out: Joints = {}
	for name, v in pairs(j) do
		local to = SWAP[name] or name
		local m = { v[1], -(v[2] or 0), -(v[3] or 0) }
		if name == "R" then
			m = { v[1], -(v[2] or 0), -(v[3] or 0), -(v[4] or 0), v[5] or 0, v[6] or 0 }
		end
		out[to] = m
	end
	return out
end
local function mirror(keys: { Key }): { Key }
	local out = {}
	for _, k in ipairs(keys) do
		table.insert(out, { t = k.t, e = k.e, j = mirrorJ(k.j) })
	end
	return out
end

------------------------------------------------------------------------
-- 자세 (가만히 있거나 걸을 때 윗몸에 얹힌다)
------------------------------------------------------------------------
Poses.stances = {
	-- 삼재: 힘을 뺀 바른 자세 (두 주먹을 가슴 높이에 가볍게)
	stance_base = { W = { 0, -20, 0 }, N = { 0, 20, 0 }, RS = { 25, 0, 14 }, RE = { 80, 0, 0 }, LS = { 42, 0, -8 }, LE = { 75, 0, 0 } },
	-- 태허: 낮게 깔린 물의 자세. 한 손은 가슴 앞을 흐르듯 가로지르고, 한 손은 낮게 물결을 누른다
	stance_taeheo = { W = { 0, -30, 0 }, N = { 0, 30, 0 }, RS = { 65, 0, -5 }, RE = { 75, 0, 0 }, LS = { 40, 0, -25 }, LE = { 25, 0, 0 } },
	-- 금강: 깊은 마보, 두 주먹을 허리에 붙이고 가슴을 편다
	stance_geumgang = { W = { 5, 0, 0 }, N = { 0, 0, 0 }, RS = { -15, 0, 20 }, RE = { 110, 0, 0 }, LS = { -15, 0, -20 }, LE = { 110, 0, 0 } },
	-- 매화: 학처럼 한 다리로 서서 한 팔은 날개처럼 들고, 한 손은 앞을 겨눈다
	stance_maehwa = { W = { 0, -20, 0 }, N = { 0, 25, 0 }, RS = { 120, 0, 60 }, RE = { 40, 0, 0 }, LS = { 75, 0, -20 }, LE = { 30, 0, 0 } },
	-- 천룡: 용의 발톱. 한 손은 높이, 한 손은 낮게 벌려 활 자세로 숙인다
	stance_cheonryong = { W = { -10, -25, 0 }, N = { 10, 25, 0 }, RS = { 135, 0, 25 }, RE = { 55, 0, 0 }, LS = { 75, 0, -10 }, LE = { 55, 0, 0 } },
	-- 무영: 낮게 숙인 그림자. 뒷손은 허리 뒤에 감추고, 앞손은 낮게 펴서 겨눈다
	stance_muyeong = { W = { 10, -45, 0 }, N = { -10, 45, 0 }, RS = { -15, 0, 25 }, RE = { 70, 0, 0 }, LS = { 65, 0, -15 }, LE = { 45, 0, 0 } },
	-- 벽력: 웅크린 권투가 (두 주먹으로 얼굴을 감싸고 앞으로 숙인다)
	stance_byeokryeok = { W = { -15, -10, 0 }, N = { 20, 10, 0 }, RS = { 60, 0, 12 }, RE = { 140, 0, 0 }, LS = { 60, 0, -12 }, LE = { 140, 0, 0 } },
	-- 취권: 옆으로 기울어 한 손은 술잔을 입가에, 한 손은 축 늘어뜨린다
	stance_chwi = { W = { 0, 10, -20 }, N = { 0, 0, 25 }, RS = { 110, 0, -10 }, RE = { 130, 0, 0 }, LS = { -10, 0, -15 }, LE = { 20, 0, 0 } },
	-- 무극: 뒷짐을 지고 꼿꼿이 선다 (아무것도 하지 않는 듯한 고수)
	stance_mugeuk = { W = { 5, 0, 0 }, N = { 5, 0, 0 }, RS = { -30, 0, -10 }, RE = { 90, 0, 0 }, LS = { -30, 0, 10 }, LE = { 90, 0, 0 } },
	-- 혈마: 짐승처럼 깊이 웅크리고 두 손톱을 활짝 벌린다
	stance_hyeolma = { W = { -35, -10, 0 }, N = { 30, 10, 0 }, RS = { 60, 0, 55 }, RE = { 60, 0, 0 }, LS = { 40, 0, -55 }, LE = { 70, 0, 0 } },
	-- 천제: 가슴을 펴고 곧게 선다. 검지 세운 손을 얼굴 앞에, 다른 손은 뒷짐
	stance_gaecheon = { W = { 0, -15, 0 }, N = { 0, 15, 0 }, RS = { 110, 0, -15 }, RE = { 65, 0, 0 }, LS = { -35, 0, 15 }, LE = { 95, 0, 0 } },
	-- 파천: 낮고 무겁게. 앞손은 바닥을 아래로 눌러 공기를 짓누르고, 뒷주먹은 허리에 잰다
	stance_gravity = { W = { 10, -30, 0 }, N = { 0, 30, 0 }, RS = { -10, 0, 15 }, RE = { 110, 0, 0 }, LS = { 80, 0, -5 }, LE = { 15, 0, 0 } },
	-- 태초: 땅에서 떠 있다. 한 손은 가슴 앞에 세우고, 한 손은 힘을 뺀 채 내린다
	stance_origin = { W = { 0, -10, 0 }, N = { 0, 10, 0 }, RS = { 20, 0, 15 }, RE = { 40, 0, 0 }, LS = { 75, 0, 10 }, LE = { 90, 0, 0 } },

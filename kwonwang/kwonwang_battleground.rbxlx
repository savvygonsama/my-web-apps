	bingje = { head = "helmet", metal = C3(200, 232, 250), armor = true, armorTrim = C3(240, 250, 255), eyes = C3(170, 230, 255), top = C3(190, 225, 252), bottom = C3(60, 100, 160), trim = C3(240, 250, 255), build = { w = 1.08, head = 1.06 } },
	hyeolma = { head = "topknot", hair = C3(120, 12, 20), longHair = true, eyes = C3(240, 50, 50), top = C3(140, 4, 22), bottom = C3(24, 2, 6), trim = C3(40, 6, 10), robe = C3(110, 0, 16), build = { h = 1.05, head = 1.06 } },
	cheonma = { head = "horns", hair = C3(20, 10, 30), hornColor = C3(28, 18, 34), hornLen = 1.5, eyes = C3(200, 100, 255), top = C3(30, 14, 52), bottom = C3(12, 2, 22), trim = C3(130, 80, 190), robe = C3(24, 10, 44), crown = C3(110, 70, 170), build = { h = 1.08, head = 1.06 } },
	yeomje = { head = "topknot", hair = C3(170, 52, 20), beard = "full", eyes = C3(255, 170, 60), crown = GOLD, armor = true, metal = C3(150, 70, 32), armorTrim = GOLD, top = C3(220, 90, 30), bottom = C3(80, 22, 12), trim = GOLD, build = { w = 1.08, head = 1.06 } },
	sawang = { head = "wrap", eyes = C3(255, 220, 130), top = C3(206, 168, 76), bottom = C3(90, 62, 32), trim = C3(40, 90, 160), robe = C3(150, 110, 44), build = { h = 1.06, head = 1.06 } },
	cheonmun = { head = "helmet", metal = C3(236, 238, 248), plume = C3(220, 180, 90), armor = true, armorTrim = GOLD, eyes = C3(255, 240, 190), top = C3(236, 240, 252), bottom = C3(116, 146, 206), trim = GOLD, build = { w = 1.08, h = 1.08, head = 1.06 } },
	noeje = { head = "helmet", metal = C3(70, 80, 150), plume = C3(150, 196, 255), armor = true, armorTrim = C3(220, 196, 110), beard = "full", eyes = C3(160, 210, 255), top = C3(60, 70, 146), bottom = C3(25, 30, 70), trim = C3(220, 196, 110), build = { w = 1.08, head = 1.06 } },
	seonggun = { head = "hood", hoodColor = C3(90, 56, 170), crown = C3(220, 196, 255), gem = C3(255, 240, 200), eyes = C3(230, 200, 255), top = C3(104, 66, 196), bottom = C3(35, 20, 70), trim = C3(230, 210, 150), robe = C3(64, 34, 124), build = { h = 1.06, head = 1.06 } },
	cheonjon = { head = "topknot", hair = WHITE_HAIR, beard = "white", crown = GOLD, gem = C3(255, 230, 160), armor = true, metal = C3(236, 210, 140), armorTrim = GOLD, eyes = C3(255, 240, 190), top = C3(250, 244, 220), bottom = C3(200, 160, 72), trim = GOLD, robe = C3(226, 206, 156), build = { w = 1.08, h = 1.06, head = 1.06 } },
	cheongeop = { head = "horns", hair = C3(16, 10, 22), hornColor = C3(20, 14, 26), hornLen = 1.7, eyes = C3(170, 90, 255), top = C3(40, 30, 60), bottom = C3(15, 10, 25), trim = C3(110, 60, 170), robe = C3(28, 20, 44), build = { w = 1.08, head = 1.06 } },
	pungyeop = { head = "topknot", hair = C3(110, 40, 20), top = C3(214, 84, 34), bottom = C3(106, 36, 22), trim = C3(246, 180, 70), robe = C3(190, 70, 30), build = { h = 1.04, head = 1.06 } },
	dason = { head = "topknot", hair = WHITE_HAIR, beard = "white", top = C3(226, 236, 216), bottom = C3(100, 138, 88), trim = C3(110, 150, 90), robe = C3(212, 226, 200), build = { h = 1.04, head = 1.06 } },
	pokryong = { head = "topknot", hair = C3(30, 50, 80), top = C3(86, 156, 216), bottom = C3(30, 70, 110), trim = C3(220, 240, 255), robe = C3(60, 120, 180), build = { h = 1.06, head = 1.06 } },
	unmugun = { head = "hood", hoodColor = C3(230, 236, 248), eyes = C3(200, 220, 255), top = C3(206, 218, 240), bottom = C3(80, 95, 140), trim = C3(160, 180, 220), robe = C3(190, 204, 232), build = { h = 1.06, head = 1.06 } },
	hyeolrang = { form = "wolf", fur = C3(84, 30, 32), pale = C3(150, 120, 110), eyes = C3(255, 70, 60), scarf = C3(150, 14, 24), build = { w = 0.92, h = 1.05, head = 0.85 } },
	seokwang = { form = "golem", skin = C3(96, 98, 92), eyes = C3(255, 196, 110), moss = C3(70, 104, 50) },
	gyunwang = { form = "shroom", capColor = C3(160, 26, 36), capSize = 3.8, spore = C3(255, 200, 200) },
	yeombong = { form = "bird", feather = C3(240, 110, 40), crest = C3(255, 220, 90), beak = C3(240, 196, 70), tip = C3(170, 36, 24), longCrest = true, longTail = C3(255, 210, 80), fire = C3(255, 150, 50) },
	seonhak = { form = "bird", feather = C3(250, 250, 248), crest = C3(204, 34, 34), beak = C3(214, 196, 150), tip = C3(28, 28, 32), longTail = C3(30, 30, 34) },
}
local DEFAULT_LOOK = { head = "topknot", hair = DARK_HAIR, build = { head = 0.9 } }
function Dress.lookOf(typeId: string, _isBoss: boolean): any
	if LOOKS[typeId] then
		return LOOKS[typeId]
	end
	if string.sub(typeId, 1, 6) == "trial_" then
		return { head = "topknot", hair = DARK_HAIR, robe = C3(70, 60, 50), build = { head = 0.88 } }
	end
	return DEFAULT_LOOK
end

------------------------------------------------------------------------
-- 보스마다 하나뿐인 표식 (적당히: 몸에 붙는 것 한두 가지)
------------------------------------------------------------------------
local SIG: { [string]: (Model, any, number, any) -> () } = {}
-- 머리 뒤의 둥근 광배 (조각을 촘촘히 이어 하나의 고리로)
local function halo(model: Model, color: Color3, k: number, r: number, mat: Enum.Material?)
	local n = 28
	local ut = sizeOf(model, "UpperTorso")
	local center = CFrame.new(0, ut.Y * 0.5 + 1.0 * k, ut.Z * 0.75)
	for i = 0, n - 1 do
		local a = i / n * math.pi * 2
		local seg = 2 * math.pi * r * k / n + 0.05
		wear(model, "UpperTorso", "Halo", Vector3.new(0.16 * k, seg, 0.16 * k), center * CFrame.new(math.cos(a) * r * k, math.sin(a) * r * k, 0) * CFrame.Angles(0, 0, a), color, mat or M.Metal)
	end
end
SIG.heukho = function(model, look, k, P)
	-- 흑호: 호랑이 가죽을 머리와 어깨에 뒤집어썼다 (줄무늬, 귀), 이빨 목걸이
	local hs = sizeOf(model, "Head")
	local tiger, stripe = C3(206, 118, 44), C3(28, 22, 18)
	wear(model, "Head", "Pelt", Vector3.new(hs.X * 1.14, hs.Y * 0.6, hs.Z * 1.18), CFrame.new(0, hs.Y * 0.34, hs.Z * 0.1), tiger, M.Fabric, Ball)
	for i = -1, 1 do
		wear(model, "Head", "PeltStripe", Vector3.new(0.1 * k, hs.Y * 0.36, hs.Z * 1.0), CFrame.new(i * hs.X * 0.24, hs.Y * 0.46, hs.Z * 0.12), stripe)
	end
	for _, x in ipairs({ -1, 1 }) do
		wear(model, "Head", "PeltEar", Vector3.new(0.36, 0.32, 0.12) * k, CFrame.new(x * hs.X * 0.36, hs.Y * 0.68, 0), tiger, M.Fabric, Ball)
	end
	mantle(model, tiger, C3(240, 232, 214), k, 3.0)
	local ut = sizeOf(model, "UpperTorso")
	local top = CFrame.new(0, ut.Y * 0.5, ut.Z * 0.6) * CFrame.Angles(math.rad(6), 0, 0)
	for i = 0, 2 do
		wear(model, "UpperTorso", "MantleStripe", Vector3.new(ut.X * 0.9, 0.14 * k, 0.11 * k), top * CFrame.new(0, -(0.5 + i * 0.85) * k, 0.01), stripe)
	end
	for i = -2, 2 do
		wear(model, "UpperTorso", "Fang", Vector3.new(0.12, 0.34, 0.12) * k, CFrame.new(i * 0.24 * k, ut.Y * 0.36 - math.abs(i) * 0.07 * k, -ut.Z * 0.56) * CFrame.Angles(0, 0, i * 0.18), C3(238, 228, 206), M.SmoothPlastic)
	end
	local _ = P
end
SIG.bingma = function(model, look, k, P)
	-- 빙마: 흰 털 목둘레와 옅은 푸른 망토, 투구 위의 얼음 결 셋
	mantle(model, C3(120, 150, 190), C3(240, 244, 248), k, 3.2)
	local hs = sizeOf(model, "Head")
	for j = -1, 1 do
		wear(model, "Head", "IceCrest", Vector3.new(0.14, 0.7 - math.abs(j) * 0.25, 0.14) * k, CFrame.new(j * hs.X * 0.22, hs.Y * 0.82, 0) * CFrame.Angles(0, 0, -j * 0.25), C3(210, 240, 255), M.Glass)
	end
	local _ = P
end
SIG.bingje = function(model, look, k, P)
	-- 빙제: 얼음 결이 솟은 관 (투명), 흰 망토
	local hs = sizeOf(model, "Head")
	for i = 0, 6 do
		local a = (i / 6 - 0.5) * math.pi * 0.9
		wear(model, "Head", "IceCrown", Vector3.new(0.14, (0.9 - math.abs(i - 3) * 0.15), 0.14) * k, CFrame.new(math.sin(a) * hs.X * 0.5, hs.Y * 0.8, -math.cos(a) * hs.Z * 0.3) * CFrame.Angles(0, 0, -a * 0.3), C3(210, 242, 255), M.Glass)
	end
	mantle(model, C3(236, 244, 252), C3(200, 230, 250), k, 3.4)
	local _ = P
end
SIG.hyeolma = function(model, look, k, P)
	-- 혈마: 핏빛 망토와 손끝의 붉은 손톱
	mantle(model, C3(110, 0, 16), C3(30, 4, 8), k, 3.4)
	for _, side in ipairs({ "LeftHand", "RightHand" }) do
		for j = -1, 1 do
			wear(model, side, "Nail", Vector3.new(0.09, 0.5, 0.09) * k, CFrame.new(j * 0.22 * k, -0.4 * k, -0.15 * k) * CFrame.Angles(math.rad(22), 0, 0), C3(170, 10, 26), M.SmoothPlastic)
		end
	end
	local _ = P
end
SIG.cheonma = function(model, look, k, P)
	mantle(model, C3(24, 10, 44), C3(70, 40, 110), k, 3.4)
	local _ = P
end
SIG.cheongeop = function(model, look, k, P)
	mantle(model, C3(20, 14, 30), C3(60, 36, 90), k, 3.6)
	local _ = P
end
SIG.yeomje = function(model, look, k, P)
	-- 염제: 관 위에서 타오르는 진짜 불과 붉은 망토
	mantle(model, C3(150, 40, 16), GOLD, k, 3.0)
	flame(model, "Head", C3(255, 140, 40), C3(200, 40, 10), 3 * k, 8)
	local _ = P
end
SIG.sawang = function(model, look, k, P)
	-- 사왕: 머리를 감은 천 위에 층층이 쌓은 금테와 청옥, 모래빛 망토
	local hs = sizeOf(model, "Head")
	for j = 0, 2 do
		disc(model, "Head", "TurbanBand", hs.X * (1.08 - j * 0.12), hs.Y * 0.18, CFrame.new(0, hs.Y * (0.42 + j * 0.16), 0), j == 1 and C3(206, 168, 76) or C3(222, 206, 160))
	end
	wear(model, "Head", "Jewel", Vector3.new(0.3, 0.3, 0.1) * k, CFrame.new(0, hs.Y * 0.52, -hs.Z * 0.54), C3(50, 120, 200), M.Glass, Ball)
	mantle(model, C3(150, 110, 44), C3(222, 206, 160), k, 3.0)
	local _ = P
end
SIG.cheonmun = function(model, look, k, P)
	mantle(model, C3(80, 110, 180), C3(236, 238, 248), k, 3.4)
	halo(model, C3(230, 200, 120), k, 1.25)
	local _ = P
end
SIG.noeje = function(model, look, k, P)
	-- 뇌제: 등 뒤의 나무 고리에 매단 천둥 북 여섯 (고리가 어깨에 걸려 있다)
	local ut = sizeOf(model, "UpperTorso")
	local center = CFrame.new(0, ut.Y * 0.5 + 0.4 * k, ut.Z * 0.9)
	local R = 1.9 * k
	local n = 30
	for i = 0, n - 1 do
		local a = i / n * math.pi * 2
		wear(model, "UpperTorso", "DrumRing", Vector3.new(0.22 * k, 2 * math.pi * R / n + 0.06, 0.22 * k), center * CFrame.new(math.cos(a) * R, math.sin(a) * R, 0) * CFrame.Angles(0, 0, a), C3(110, 70, 40), M.Wood)
	end
	for i = 0, 5 do
		local a = i / 6 * math.pi * 2 + math.pi / 2
		local at = center * CFrame.new(math.cos(a) * R, math.sin(a) * R, 0.05 * k)
		wear(model, "UpperTorso", "Drum", Vector3.new(0.5 * k, 0.85 * k, 0.85 * k), at * CFrame.Angles(0, math.rad(90), 0), C3(120, 36, 30), M.Wood, Cyl)
		wear(model, "UpperTorso", "DrumHead", Vector3.new(0.52 * k, 0.7 * k, 0.7 * k), at * CFrame.Angles(0, math.rad(90), 0), C3(226, 210, 170), M.SmoothPlastic, Cyl)
	end
	wear(model, "UpperTorso", "DrumBrace", Vector3.new(0.2 * k, 1.2 * k, 0.2 * k), CFrame.new(0, ut.Y * 0.5, ut.Z * 0.7), C3(110, 70, 40), M.Wood)
	local _ = P
end
SIG.seonggun = function(model, look, k, P)
	-- 성군: 도포 자락에 수놓은 금빛 별 (작은 점들)
	local lt = sizeOf(model, "LowerTorso")
	for i = 0, 7 do
		local x = ((i * 37) % 9 - 4) / 9
		local y = -0.4 - ((i * 53) % 7) / 7 * 1.4
		wear(model, "LowerTorso", "StarStitch", Vector3.new(0.14, 0.14, 0.04) * k, CFrame.new(x * lt.X, y * k, -lt.Z * 0.62), C3(240, 220, 160), M.Metal, Ball)
	end
	mantle(model, C3(50, 26, 100), C3(230, 210, 150), k, 3.2)
end
SIG.cheonjon = function(model, look, k, P)
	-- 천존: 머리 뒤의 금빛 광배 하나와 흰 망토
	halo(model, C3(226, 192, 100), k, 1.45)
	mantle(model, C3(244, 236, 214), GOLD, k, 3.6)
	local _ = P
end
SIG.pungyeop = function(model, look, k, P)
	-- 풍엽: 단풍잎을 엮은 관과 단풍빛 망토
	local hs = sizeOf(model, "Head")
	for i = 0, 6 do
		local a = (i / 6 - 0.5) * math.pi
		wear(model, "Head", "MapleLeaf", Vector3.new(0.6, 0.6, 0.06) * k, CFrame.new(math.sin(a) * hs.X * 0.5, hs.Y * 0.55 + math.cos(a) * hs.Y * 0.12, -math.cos(a) * hs.Z * 0.12) * CFrame.Angles(0, -a, math.rad(45)), i % 2 == 0 and C3(214, 70, 30) or C3(236, 150, 40), M.SmoothPlastic)
	end
	mantle(model, C3(170, 60, 26), C3(246, 180, 70), k, 3.2)
	local _ = P
end
SIG.jukwang = function(model, look, k, P)
	-- 죽왕: 등에 멘 대나무 다발과 대나무 잎 관, 대숲빛 망토
	local hs = sizeOf(model, "Head")
	for i = 0, 4 do
		local a = (i / 4 - 0.5) * math.pi * 0.8
		wear(model, "Head", "BambooLeaf", Vector3.new(0.05, 0.3, 1.3) * k, CFrame.new(math.sin(a) * hs.X * 0.45, hs.Y * 0.6, -math.cos(a) * hs.Z * 0.1) * CFrame.Angles(math.rad(-60), -a, 0), C3(90, 150, 70), M.SmoothPlastic, Ball)
	end
	local ut = sizeOf(model, "UpperTorso")
	for i = -1, 1 do
		wear(model, "UpperTorso", "BambooPole", Vector3.new(4.2 * k, 0.32 * k, 0.32 * k), CFrame.new(i * 0.3 * k, 0.6 * k, ut.Z * 0.75) * CFrame.Angles(0, 0, math.rad(60 + i * 6)) * CFrame.Angles(0, 0, 0), C3(130, 170, 80), M.SmoothPlastic, Cyl)
	end
	mantle(model, C3(70, 106, 58), C3(226, 216, 160), k, 3.0)
	local _ = P
end
SIG.wolyeong = function(model, look, k, P)
	-- 월영: 머리 뒤의 초승달 (고리의 한쪽만), 달빛 망토
	local ut = sizeOf(model, "UpperTorso")
	local center = CFrame.new(0, ut.Y * 0.5 + 1.0 * k, ut.Z * 0.75)
	local n = 18
	for i = 0, n - 1 do
		local a = math.rad(200) + i / (n - 1) * math.rad(220)
		local r = 1.1 * k
		local w = (0.1 + 0.16 * math.sin(i / (n - 1) * math.pi)) * k
		wear(model, "UpperTorso", "Crescent", Vector3.new(w, 2 * math.pi * r / n * 1.6 + 0.05, w), center * CFrame.new(math.cos(a) * r, math.sin(a) * r, 0) * CFrame.Angles(0, 0, a), C3(230, 238, 255), M.Glass)
	end
	mantle(model, C3(190, 202, 236), C3(240, 244, 255), k, 3.6)
	local _ = P
end
SIG.geumgang = function(model, look, k, P)
	-- 금강천왕: 머리 뒤의 금빛 광배와 큰 염주, 붉은 가사 한 자락
	halo(model, C3(240, 196, 90), k, 1.6)
	local ut = sizeOf(model, "UpperTorso")
	wear(model, "UpperTorso", "Kasaya", Vector3.new(ut.X * 0.5, ut.Y * 1.15, ut.Z * 1.1), CFrame.new(-ut.X * 0.12, 0, 0) * CFrame.Angles(0, 0, math.rad(-28)), C3(170, 40, 30))
	local _ = P
end
SIG.dason = function(model, look, k, P)
	-- 다선: 커다란 삿갓, 허리에 찬 찻주전자
	local hs = sizeOf(model, "Head")
	disc(model, "Head", "BigHat", hs.X * 3.0, 0.12 * k, CFrame.new(0, hs.Y * 0.46, 0), C3(196, 168, 110))
	disc(model, "Head", "BigHatMid", hs.X * 1.7, hs.Y * 0.16, CFrame.new(0, hs.Y * 0.56, 0), C3(186, 156, 100))
	disc(model, "Head", "BigHatTop", hs.X * 0.8, hs.Y * 0.2, CFrame.new(0, hs.Y * 0.7, 0), C3(176, 146, 92))
	local lt = sizeOf(model, "LowerTorso")
	wear(model, "LowerTorso", "TeaPot", Vector3.new(0.75, 0.6, 0.75) * k, CFrame.new(lt.X * 0.58, -0.25 * k, 0), C3(104, 76, 58), M.SmoothPlastic, Ball)
	wear(model, "LowerTorso", "TeaPotLid", Vector3.new(0.3, 0.14, 0.3) * k, CFrame.new(lt.X * 0.58, 0.07 * k, 0), C3(84, 60, 46), M.SmoothPlastic, Ball)
	local _ = P
end
SIG.pokryong = function(model, look, k, P)
	-- 비천: 목에 감겨 뒤로 흘러내리는 물빛 비단
	for i = 0, 4 do
		local w = wear(model, "UpperTorso", "WaterSilk", Vector3.new((1.3 - i * 0.14) * k, 0.46 * k, 0.06), CFrame.new(0, (0.85 - i * 0.44) * k, (0.62 + i * 0.12) * k) * CFrame.Angles(math.rad(18 + i * 8), 0, (i % 2 - 0.5) * 0.25), C3(150, 212, 250), M.Glass)
		if w then
			w.Transparency = 0.35
		end
	end
	local _ = P
end
SIG.unmugun = function(model, look, k, P)
	-- 운무군: 어깨를 덮은 구름 같은 흰 목둘레와 긴 망토
	mantle(model, C3(206, 216, 236), C3(244, 246, 252), k, 3.4)
	local ut = sizeOf(model, "UpperTorso")
	for i = 0, 4 do
		local a = (i / 4 - 0.5) * math.pi
		wear(model, "UpperTorso", "CloudRuff", Vector3.new(0.9, 0.6, 0.9) * k, CFrame.new(math.sin(a) * ut.X * 0.45, ut.Y * 0.52, math.cos(a) * ut.Z * 0.25), C3(244, 246, 252), M.SmoothPlastic, Ball)
	end
	local _ = P
end
SIG.seokwang = function(model, look, k, P)
	-- 석왕: 머리에 둥글게 선 돌기둥 관 (선돌 일곱), 이끼 수염, 어깨를 덮은 이끼 망토와 넝쿨
	local stone, moss = C3(80, 82, 78), C3(66, 100, 48)
	for i = 0, 4 do
		local a = (i / 4 - 0.5) * math.pi * 0.95
		local h = (i == 2 and 0.75 or (i % 2 == 1 and 0.55 or 0.4)) * k
		wear(model, "Head", "Menhir", Vector3.new(0.3 * k, h, 0.26 * k), CFrame.new(math.sin(a) * 0.48 * k, 0.5 * k + h / 2, -math.cos(a) * 0.38 * k) * CFrame.Angles(-math.cos(a) * 0.15, -a, math.sin(a) * -0.2), stone, M.Slate)
	end
	wear(model, "Head", "MossBeard", Vector3.new(0.9, 0.7, 0.3) * k, CFrame.new(0, -0.55 * k, -0.48 * k), moss, M.Grass)
	local ut = sizeOf(model, "UpperTorso")
	for i = 0, 4 do
		wear(model, "UpperTorso", "Vine", Vector3.new(0.12 * k, (1.0 + (i % 2) * 0.5) * k, 0.1 * k), CFrame.new((i - 2) * 0.38 * k, 0.3 * k, ut.Z * 0.85 + 0.2 * k), dark(moss, 0.2), M.Grass)
	end
	local _ = P
end

------------------------------------------------------------------------
-- 3.2.1판: 사람이 아닌 보스의 몸을 새로 빚는다. 네모난 몸 조각은 감추고 (관절은 그대로 움직인다),
-- 그 위에 생김새대로 깎은 조각을 붙인다. 몸통·팔·다리가 따로 읽히도록 마디 사이를 좁히고 빛깔을 나눈다
------------------------------------------------------------------------
local BOSS_BODY: { [string]: (Model, any, number) -> () } = {}
local function ell(model: Model, partName: string, name: string, size: Vector3, cf: CFrame, color: Color3, mat: Enum.Material?): Part?
	return wear(model, partName, name, size, cf, color, mat or M.SmoothPlastic, Ball)
end
-- 세운 원통 (길이 L, 굵기 d)
local function rod(model: Model, partName: string, name: string, L: number, d: number, cf: CFrame, color: Color3, mat: Enum.Material?): Part?
	return wear(model, partName, name, Vector3.new(L, d, d), cf * UPRIGHT, color, mat or M.SmoothPlastic, Cyl)
end
-- 축 방향 (부위 안의 방향 dir) 으로 긴 타원
local function ellAlong(model: Model, partName: string, name: string, at: Vector3, dir: Vector3, w: number, L: number, color: Color3, mat: Enum.Material?): Part?
	local cf = CFrame.lookAt(at, at + dir) * CFrame.Angles(math.rad(-90), 0, 0)
	return ell(model, partName, name, Vector3.new(w, L, w), cf, color, mat)
end
local function hideBody(model: Model)
	clearFace(model)
	hide(model, { "Head", "UpperTorso", "LowerTorso" })
	hide(model, ARMS)
	hide(model, LEGS)
end

-- 학과 봉황: 앞으로 기운 달걀꼴 몸, 휘어 오른 긴 목 끝의 작은 머리와 부리, 팔이 곧 날개 (덮깃과 늘어진 칼깃), 가는 다리와 발가락
local function birdKing(model: Model, look: any, k: number)
	local feather = look.feather or C3(240, 240, 240)
	local crest = look.crest or C3(210, 40, 40)
	local beak = look.beak or C3(225, 185, 90)
	local tip = look.tip or dark(feather, 0.75)
	local breast = look.breast or light(feather, 0.14)
	local legC = dark(beak, 0.2)
	local phoenix = look.longCrest == true
	hideBody(model)
	local ut, lt, hs = sizeOf(model, "UpperTorso"), sizeOf(model, "LowerTorso"), sizeOf(model, "Head")
	ell(model, "UpperTorso", "Body", Vector3.new(ut.X * 0.86, ut.Y * 1.45, ut.Z * 1.7), CFrame.new(0, -ut.Y * 0.1, ut.Z * 0.15) * CFrame.Angles(math.rad(-12), 0, 0), feather)
	ell(model, "UpperTorso", "Breast", Vector3.new(ut.X * 0.62, ut.Y * 1.0, ut.Z * 0.55), CFrame.new(0, ut.Y * 0.02, -ut.Z * 0.55) * CFrame.Angles(math.rad(-12), 0, 0), breast)
	ell(model, "LowerTorso", "Rump", Vector3.new(lt.X * 0.72, lt.Y * 3.2, lt.Z * 1.5), CFrame.new(0, -lt.Y * 0.2, lt.Z * 0.35), dark(feather, 0.05))
	-- 목: 마디 넷이 앞으로 휘며 올라간다 (머리 관절에 붙어 머리와 함께 돈다)
	local headAt = Vector3.new(0, hs.Y * 1.4, -hs.Z * 0.35)
	local base = Vector3.new(0, -hs.Y * 0.3, hs.Z * 0.05)
	local neckC = look.neckColor or (phoenix and feather or C3(30, 30, 34))
	-- 마디를 촘촘히 겹쳐 매끈한 한 줄기로 (마디마다 휘는 방향을 따라 눕힌다)
	local n = 8
	local function neckAt(u: number): Vector3
		return base:Lerp(headAt, u) + Vector3.new(0, 0, math.sin(u * math.pi) * hs.Z * 0.3)
	end
	for i = 0, n do
		local u = i / n
		local p = neckAt(u)
		local dirN = neckAt(math.min(1, u + 0.05)) - neckAt(math.max(0, u - 0.05))
		local d = hs.X * (0.5 - u * 0.16)
		ellAlong(model, "Head", "Neck", p, dirN, d, hs.Y * 0.42, (u > 0.35 and not phoenix) and neckC or feather)
	end
	ell(model, "Head", "BirdHead", Vector3.new(hs.X * 0.66, hs.Y * 0.62, hs.Z * 0.92), CFrame.new(headAt), feather)
	local bl = (phoenix and 0.75 or 1.4) * k
	wear(model, "Head", "Beak", Vector3.new(0.2 * k, 0.17 * k, bl), CFrame.new(headAt + Vector3.new(0, -hs.Y * 0.05, -hs.Z * 0.4 - bl * 0.5)) * CFrame.Angles(math.rad(phoenix and -20 or -6), 0, 0), beak, M.SmoothPlastic)
	wear(model, "Head", "BeakLow", Vector3.new(0.15 * k, 0.08 * k, bl * 0.8), CFrame.new(headAt + Vector3.new(0, -hs.Y * 0.15, -hs.Z * 0.38 - bl * 0.4)) * CFrame.Angles(math.rad(4), 0, 0), dark(beak, 0.2), M.SmoothPlastic)
	for _, x in ipairs({ -1, 1 }) do
		ell(model, "Head", "EyeRing", Vector3.new(0.05 * k, 0.2 * k, 0.2 * k), CFrame.new(headAt + Vector3.new(x * hs.X * 0.33, hs.Y * 0.08, -hs.Z * 0.16)), phoenix and C3(255, 220, 120) or WHITE)
		ell(model, "Head", "Eye", Vector3.new(0.07 * k, 0.12 * k, 0.12 * k), CFrame.new(headAt + Vector3.new(x * hs.X * 0.35, hs.Y * 0.08, -hs.Z * 0.16)), look.eyes or C3(20, 20, 20))
	end
	if phoenix then
		for j = 0, 3 do
			local at = CFrame.new(headAt + Vector3.new(0, hs.Y * 0.28, hs.Z * (0.05 + j * 0.12))) * CFrame.Angles(math.rad(-30 - j * 16), 0, 0)
			wear(model, "Head", "Crest", Vector3.new(0.08 * k, (0.9 - j * 0.12) * k, 0.3 * k), at * CFrame.new(0, (0.45 - j * 0.06) * k, 0), j == 0 and C3(255, 240, 170) or crest, M.SmoothPlastic)
		end
	else
		ell(model, "Head", "Crown", Vector3.new(hs.X * 0.4, 0.14 * k, hs.Z * 0.48), CFrame.new(headAt + Vector3.new(0, hs.Y * 0.28, 0.02 * k)), crest)
	end
	-- 날개 (팔): 위팔의 덮깃, 아래팔과 손에서 뒤아래로 늘어진 칼깃 일곱 (끝은 짙게)
	for _, side in ipairs({ "Left", "Right" }) do
		local x = side == "Left" and -1 or 1
		local ua, la = sizeOf(model, side .. "UpperArm"), sizeOf(model, side .. "LowerArm")
		-- 접은 날개: 어깨에서 엉덩이 아래까지 몸 옆에 납작하게 붙은 한 장 (위는 덮깃 빛깔, 아래로 짙어진다)
		ell(model, side .. "UpperArm", "Wing", Vector3.new(ua.X * 0.38, ua.Y * 2.5, ua.Z * 1.8), CFrame.new(x * ua.X * 0.08, -ua.Y * 0.45, ua.Z * 0.3) * CFrame.Angles(math.rad(-8), 0, 0), feather)
		ell(model, side .. "UpperArm", "WingBar", Vector3.new(ua.X * 0.42, ua.Y * 0.9, ua.Z * 1.5), CFrame.new(x * ua.X * 0.1, -ua.Y * 1.05, ua.Z * 0.4) * CFrame.Angles(math.rad(-8), 0, 0), dark(feather, 0.1))
		for j = 0, 6 do
			local L = (1.5 + j * 0.3) * k
			local at = CFrame.new(x * 0.05 * k, -la.Y * 0.05 + j * 0.06 * k, (0.15 + j * 0.15) * k) * CFrame.Angles(math.rad(-(6 + j * 6)), 0, x * math.rad(3))
			wear(model, side .. "LowerArm", "Quill", Vector3.new(0.08 * k, L, 0.46 * k), at * CFrame.new(0, -L / 2, 0), j >= 4 and tip or (j % 2 == 0 and feather or dark(feather, 0.05)), M.SmoothPlastic)
		end
	end
	-- 다리: 깃 덮인 넓적다리, 가는 정강이, 앞 발가락 셋과 뒷발가락
	for _, side in ipairs({ "Left", "Right" }) do
		local ul, ll, ft = sizeOf(model, side .. "UpperLeg"), sizeOf(model, side .. "LowerLeg"), sizeOf(model, side .. "Foot")
		ell(model, side .. "UpperLeg", "Thigh", Vector3.new(ul.X * 0.85, ul.Y * 0.95, ul.Z * 1.1), CFrame.new(0, ul.Y * 0.12, 0), dark(feather, 0.08))
		rod(model, side .. "UpperLeg", "ShankTop", ul.Y * 0.6, 0.26 * k, CFrame.new(0, -ul.Y * 0.32, 0), legC)
		rod(model, side .. "LowerLeg", "Shank", ll.Y * 1.3, 0.24 * k, CFrame.new(0, 0, 0), legC)
		for j = -1, 1 do
			local at = CFrame.new(j * 0.18 * k, -ft.Y * 0.2, -ft.Z * 0.1) * CFrame.Angles(0, j * 0.45, 0)
			wear(model, side .. "Foot", "Toe", Vector3.new(0.12 * k, 0.1 * k, 0.8 * k), at * CFrame.new(0, 0, -0.4 * k), legC, M.SmoothPlastic)
			wear(model, side .. "Foot", "Talon", Vector3.new(0.08 * k, 0.08 * k, 0.2 * k), at * CFrame.new(0, -0.03 * k, -0.85 * k) * CFrame.Angles(math.rad(25), 0, 0), C3(30, 26, 22), M.SmoothPlastic)
		end
		wear(model, side .. "Foot", "HindToe", Vector3.new(0.1 * k, 0.1 * k, 0.4 * k), CFrame.new(0, -ft.Y * 0.2, ft.Z * 0.35), legC, M.SmoothPlastic)
	end
	-- 꼬리: 학은 짙은 깃 부채, 봉황은 땅까지 흐르는 긴 깃 다섯
	if look.longTail and phoenix then
		for j = -2, 2 do
			local cf = CFrame.new(j * 0.18 * k, -0.1 * k, lt.Z * 0.6 + 0.3 * k) * CFrame.Angles(math.rad(-55), 0, math.rad(j * 10))
			for sgm = 0, 3 do
				wear(model, "LowerTorso", "TailPlume", Vector3.new(0.22 * k, 1.15 * k, 0.06 * k), cf * CFrame.new(0, -0.58 * k, 0), sgm == 3 and look.longTail or (j == 0 and crest or feather), M.SmoothPlastic)
				cf = cf * CFrame.new(0, -1.1 * k, 0) * CFrame.Angles(math.rad(-10), 0, 0)
			end
			ell(model, "LowerTorso", "TailEye", Vector3.new(0.4 * k, 0.4 * k, 0.08 * k), cf * CFrame.new(0, 0.3 * k, 0), C3(60, 120, 200))
		end
	else
		for j = -3, 3 do
			local L = (1.6 - math.abs(j) * 0.15) * k
			wear(model, "LowerTorso", "TailFeather", Vector3.new(0.3 * k, L, 0.06 * k), CFrame.new(j * 0.16 * k, -0.2 * k, lt.Z * 0.7 + 0.3 * k) * CFrame.Angles(math.rad(-40), 0, math.rad(j * 9)) * CFrame.new(0, -L / 2, 0), look.longTail or tip, M.SmoothPlastic)
		end
	end
	if look.fire then
		flame(model, "UpperTorso", look.fire, dark(look.fire, 0.35), 3.5 * k, 4)
		for _, side in ipairs({ "LeftLowerArm", "RightLowerArm" }) do
			flame(model, side, look.fire, dark(look.fire, 0.35), 1.6 * k, 3)
		end
		glow(model, "UpperTorso", look.fire, 14 * k, 1.2)
	end
end
BOSS_BODY.seonhak = birdKing
BOSS_BODY.yeombong = birdKing

-- 늑대왕 (혈랑): 앞으로 숙인 통 가슴과 가는 허리, 목과 어깨의 갈기 털 뭉치, 긴 주둥이와 엄니, 굵은 앞발과 꺾인 뒷다리, 털 꼬리, 핏빛 목도리
BOSS_BODY.hyeolrang = function(model: Model, look: any, k: number)
	local fur = look.fur or C3(84, 30, 32)
	local pale = look.pale or light(fur, 0.35)
	local deep = dark(fur, 0.25)
	local bone = C3(232, 222, 205)
	hideBody(model)
	local ut, lt, hs = sizeOf(model, "UpperTorso"), sizeOf(model, "LowerTorso"), sizeOf(model, "Head")
	ell(model, "UpperTorso", "Chest", Vector3.new(ut.X * 1.05, ut.Y * 1.25, ut.Z * 1.55), CFrame.new(0, ut.Y * 0.05, 0) * CFrame.Angles(math.rad(-18), 0, 0), fur, M.Fabric)
	ell(model, "UpperTorso", "Belly", Vector3.new(ut.X * 0.58, ut.Y * 0.95, ut.Z * 0.7), CFrame.new(0, -ut.Y * 0.12, -ut.Z * 0.5) * CFrame.Angles(math.rad(-10), 0, 0), pale, M.Fabric)
	ell(model, "LowerTorso", "Waist", Vector3.new(lt.X * 0.68, lt.Y * 2.6, lt.Z * 1.0), CFrame.new(0, lt.Y * 0.2, 0), dark(fur, 0.08), M.Fabric)
	ell(model, "UpperTorso", "BackStripe", Vector3.new(ut.X * 0.5, ut.Y * 1.1, ut.Z * 0.5), CFrame.new(0, ut.Y * 0.1, ut.Z * 0.62) * CFrame.Angles(math.rad(-18), 0, 0), deep, M.Fabric)
	-- 갈기: 목둘레 열넷 (앞은 작게, 뒤와 어깨는 크게 바깥으로)
	for i = 0, 17 do
		local a = i / 18 * math.pi * 2
		local front = -math.sin(a)
		local sz = front > 0.6 and 0.5 or 0.8
		local pos = Vector3.new(math.cos(a) * ut.X * 0.42, ut.Y * 0.5, math.sin(a) * ut.Z * 0.7 + ut.Z * 0.1)
		local out = Vector3.new(math.cos(a), 0.7, math.sin(a) * 0.8 + 0.5)
		ellAlong(model, "UpperTorso", "Mane", pos, out, 0.6 * k * sz, 1.25 * k * sz, i % 2 == 0 and pale or fur, M.Fabric)
	end
	-- 머리: 앞으로 내민 머리뼈, 길고 끝이 가는 주둥이, 벌린 아래턱과 엄니, 눈두덩, 세운 귀
	local H0 = Vector3.new(0, -hs.Y * 0.05, -hs.Z * 0.15)
	ell(model, "Head", "Skull", Vector3.new(hs.X * 0.85, hs.Y * 0.8, hs.Z * 1.0), CFrame.new(H0), fur, M.Fabric)
	wear(model, "Head", "Snout", Vector3.new(hs.X * 0.42, hs.Y * 0.32, hs.Z * 0.9), CFrame.new(H0 + Vector3.new(0, -hs.Y * 0.1, -hs.Z * 0.75)) * CFrame.Angles(math.rad(6), 0, 0), fur, M.Fabric)
	wear(model, "Head", "Jaw", Vector3.new(hs.X * 0.34, hs.Y * 0.12, hs.Z * 0.75), CFrame.new(H0 + Vector3.new(0, -hs.Y * 0.32, -hs.Z * 0.66)) * CFrame.Angles(math.rad(14), 0, 0), pale, M.Fabric)
	ell(model, "Head", "Nose", Vector3.new(hs.X * 0.2, hs.Y * 0.14, hs.Z * 0.14), CFrame.new(H0 + Vector3.new(0, -hs.Y * 0.02, -hs.Z * 1.2)), C3(15, 10, 10))
	for _, x in ipairs({ -1, 1 }) do
		wear(model, "Head", "Fang", Vector3.new(0.07 * k, 0.24 * k, 0.07 * k), CFrame.new(H0 + Vector3.new(x * hs.X * 0.13, -hs.Y * 0.26, -hs.Z * 1.0)), bone, M.SmoothPlastic)
		wear(model, "Head", "Brow", Vector3.new(hs.X * 0.32, 0.1 * k, 0.2 * k), CFrame.new(H0 + Vector3.new(x * hs.X * 0.2, hs.Y * 0.16, -hs.Z * 0.44)) * CFrame.Angles(0, 0, x * math.rad(-18)), deep, M.Fabric)
		wear(model, "Head", "Eye", Vector3.new(0.22 * k, 0.07 * k, 0.05 * k), CFrame.new(H0 + Vector3.new(x * hs.X * 0.2, hs.Y * 0.06, -hs.Z * 0.5)) * CFrame.Angles(0, 0, x * math.rad(-16)), look.eyes or C3(255, 70, 60), M.Neon)
		local ear = CFrame.new(H0 + Vector3.new(x * hs.X * 0.3, hs.Y * 0.36, hs.Z * 0.12)) * CFrame.Angles(math.rad(-14), 0, -x * math.rad(14))
		wear(model, "Head", "Ear", Vector3.new(0.34 * k, 0.4 * k, 0.12 * k), ear * CFrame.new(0, 0.18 * k, 0), fur, M.Fabric)
		wear(model, "Head", "EarTip", Vector3.new(0.18 * k, 0.24 * k, 0.11 * k), ear * CFrame.new(0, 0.48 * k, 0), deep, M.Fabric)
		wear(model, "Head", "EarIn", Vector3.new(0.18 * k, 0.32 * k, 0.05 * k), ear * CFrame.new(0, 0.18 * k, -0.07 * k), pale, M.Fabric)
	end
	-- 앞발: 굵은 어깨와 팔뚝, 팔꿈치의 털, 큰 발과 긴 발톱
	for _, side in ipairs({ "Left", "Right" }) do
		local ua, la, hd = sizeOf(model, side .. "UpperArm"), sizeOf(model, side .. "LowerArm"), sizeOf(model, side .. "Hand")
		ell(model, side .. "UpperArm", "Shoulder", Vector3.new(ua.X * 1.0, ua.Y * 1.4, ua.Z * 1.0), CFrame.new(0, ua.Y * 0.05, 0), fur, M.Fabric)
		ell(model, side .. "LowerArm", "Forearm", Vector3.new(la.X * 0.9, la.Y * 1.5, la.Z * 0.9), CFrame.new(0, -la.Y * 0.05, 0), dark(fur, 0.06), M.Fabric)
		ellAlong(model, side .. "LowerArm", "ElbowTuft", Vector3.new(0, la.Y * 0.35, la.Z * 0.45), Vector3.new(0, 0.6, 1), 0.4 * k, 0.8 * k, pale, M.Fabric)
		wear(model, side .. "LowerArm", "Wrap", Vector3.new(la.X * 1.12, la.Y * 0.3, la.Z * 1.12), CFrame.new(0, -la.Y * 0.3, 0), look.scarf or C3(150, 14, 24))
		ell(model, side .. "Hand", "Paw", Vector3.new(hd.X * 1.15, hd.Y * 2.1, hd.Z * 1.25), CFrame.new(0, -hd.Y * 0.3, -hd.Z * 0.05), deep, M.Fabric)
		for j = -1.5, 1.5, 1 do
			wear(model, side .. "Hand", "Claw", Vector3.new(0.08 * k, 0.55 * k, 0.08 * k), CFrame.new(j * hd.X * 0.25, -hd.Y * 1.0, -hd.Z * 0.35) * CFrame.Angles(math.rad(30), 0, 0) * CFrame.new(0, -0.22 * k, 0), bone, M.SmoothPlastic)
		end
	end
	-- 뒷다리: 굵은 넓적다리, 뒤로 꺾인 정강이, 긴 발
	for _, side in ipairs({ "Left", "Right" }) do
		local ul, ll, ft = sizeOf(model, side .. "UpperLeg"), sizeOf(model, side .. "LowerLeg"), sizeOf(model, side .. "Foot")
		ell(model, side .. "UpperLeg", "Haunch", Vector3.new(ul.X * 1.0, ul.Y * 1.35, ul.Z * 1.2), CFrame.new(0, ul.Y * 0.05, ul.Z * 0.12), fur, M.Fabric)
		ell(model, side .. "LowerLeg", "Shin", Vector3.new(ll.X * 0.75, ll.Y * 1.5, ll.Z * 0.8), CFrame.new(0, 0, ll.Z * 0.25) * CFrame.Angles(math.rad(-22), 0, 0), dark(fur, 0.1), M.Fabric)
		ell(model, side .. "Foot", "HindPaw", Vector3.new(ft.X * 0.95, ft.Y * 2.2, ft.Z * 1.4), CFrame.new(0, ft.Y * 0.3, -ft.Z * 0.15), deep, M.Fabric)
		for j = -1, 1 do
			wear(model, side .. "Foot", "Claw", Vector3.new(0.08 * k, 0.08 * k, 0.32 * k), CFrame.new(j * ft.X * 0.28, ft.Y * 0.1, -ft.Z * 0.85), bone, M.SmoothPlastic)
		end
	end
	-- 꼬리: 굵은 털 마디가 뒤로 휘어 오르고 끝은 옅다
	local prev = CFrame.new(0, -lt.Y * 0.2, lt.Z * 0.55)
	for j = 1, 5 do
		local seg = prev * CFrame.Angles(math.rad(j == 1 and -70 or 14), 0, 0) * CFrame.new(0, -0.38 * k, 0)
		ell(model, "LowerTorso", "Tail", Vector3.new((0.62 - j * 0.04) * k, 0.95 * k, (0.62 - j * 0.04) * k), seg, j == 5 and pale or fur, M.Fabric)
		prev = seg * CFrame.new(0, -0.38 * k, 0)
	end
	-- 가죽 허리끈과 핏빛 목도리 (목 앞 매듭, 등 뒤로 길게 휘날린다)
	local cloth = look.scarf or C3(150, 14, 24)
	wear(model, "LowerTorso", "Belt", Vector3.new(lt.X * 0.75, 0.28 * k, lt.Z * 1.06), CFrame.new(0, lt.Y * 0.45, 0), LEATHER, M.Leather)
	ell(model, "UpperTorso", "ScarfKnot", Vector3.new(0.5 * k, 0.4 * k, 0.4 * k), CFrame.new(0, ut.Y * 0.35, -ut.Z * 0.75), cloth, M.Fabric)
	for i = 0, 3 do
		wear(model, "UpperTorso", "Scarf", Vector3.new((0.7 - i * 0.08) * k, 0.9 * k, 0.07 * k), CFrame.new(0.15 * k, (0.35 - i * 0.6) * k, ut.Z * 0.85 + i * 0.25 * k) * CFrame.Angles(math.rad(18 + i * 12), 0, math.rad(i * 6)), i == 3 and dark(cloth, 0.2) or cloth)
	end
end

-- 석왕: 마디마다 따로 놓인 바위 몸. 가슴의 큰 바위와 가슴판, 사이를 지나는 빛나는 금, 어깨에 솟은 바위와 이끼,
-- 큰 돌 주먹, 짧고 굵은 다리, 어깨 사이로 낮게 박힌 머리와 깊은 눈, 선돌 관 가운데의 빛나는 돌
BOSS_BODY.seokwang = function(model: Model, look: any, k: number)
	local rock = look.skin or C3(96, 98, 92)
	local r1, r2 = dark(rock, 0.18), light(rock, 0.1)
	local moss = look.moss or C3(70, 104, 50)
	local vein = look.eyes or C3(255, 196, 110)
	local mat = M.Slate
	hideBody(model)
	local ut, lt, hs = sizeOf(model, "UpperTorso"), sizeOf(model, "LowerTorso"), sizeOf(model, "Head")
	wear(model, "UpperTorso", "Core", Vector3.new(ut.X * 1.15, ut.Y * 0.85, ut.Z * 1.25), CFrame.new(0, ut.Y * 0.2, ut.Z * 0.1) * CFrame.Angles(0.05, 0.08, 0.03), rock, mat)
	for _, x in ipairs({ -1, 1 }) do
		wear(model, "UpperTorso", "Pec", Vector3.new(ut.X * 0.48, ut.Y * 0.5, ut.Z * 0.5), CFrame.new(x * ut.X * 0.26, ut.Y * 0.18, -ut.Z * 0.6) * CFrame.Angles(0.1, x * 0.15, x * 0.08), r2, mat)
	end
	wear(model, "UpperTorso", "Gut", Vector3.new(ut.X * 0.62, ut.Y * 0.4, ut.Z * 0.85), CFrame.new(0, -ut.Y * 0.38, -ut.Z * 0.05) * CFrame.Angles(-0.05, -0.1, 0), r1, mat)
	-- 빛나는 금: 가슴 가운데로 내려가 둘로 갈라진다
	wear(model, "UpperTorso", "Vein", Vector3.new(0.1 * k, ut.Y * 0.75, 0.06 * k), CFrame.new(0, -ut.Y * 0.05, -ut.Z * 0.87) * CFrame.Angles(0, 0, math.rad(8)), vein, M.Neon)
	for _, x in ipairs({ -1, 1 }) do
		wear(model, "UpperTorso", "Vein", Vector3.new(ut.X * 0.3, 0.08 * k, 0.06 * k), CFrame.new(x * ut.X * 0.14, -ut.Y * 0.3, -ut.Z * 0.86) * CFrame.Angles(0, 0, x * math.rad(-25)), vein, M.Neon)
	end
	disc(model, "LowerTorso", "VeinRing", lt.X * 0.9, 0.14 * k, CFrame.new(0, lt.Y * 0.55, 0), vein, M.Neon)
	wear(model, "LowerTorso", "Hip", Vector3.new(lt.X * 0.8, lt.Y * 1.3, lt.Z * 1.05), CFrame.new(0, -lt.Y * 0.1, 0) * CFrame.Angles(0, 0.15, 0), r1, mat)
	for _, side in ipairs({ "Left", "Right" }) do
		local x = side == "Left" and -1 or 1
		local ua, la, hd = sizeOf(model, side .. "UpperArm"), sizeOf(model, side .. "LowerArm"), sizeOf(model, side .. "Hand")
		wear(model, side .. "UpperArm", "ShoulderBoulder", Vector3.new(ua.X * 1.6, ua.Y * 0.6, ua.Z * 1.45), CFrame.new(x * ua.X * 0.3, ua.Y * 0.5, 0) * CFrame.Angles(0.1, 0.3 * x, -0.25 * x), rock, mat)
		wear(model, side .. "UpperArm", "ShoulderMoss", Vector3.new(ua.X * 1.3, 0.14 * k, ua.Z * 1.15), CFrame.new(x * ua.X * 0.3, ua.Y * 0.82, 0) * CFrame.Angles(0.1, 0.3 * x, -0.25 * x), moss, M.Grass)
		wear(model, side .. "UpperArm", "ArmRock", Vector3.new(ua.X * 1.0, ua.Y * 0.65, ua.Z * 1.0), CFrame.new(0, -ua.Y * 0.18, 0) * CFrame.Angles(0, 0.4, 0.05), r1, mat)
		disc(model, side .. "LowerArm", "ElbowVein", la.X * 0.8, 0.1 * k, CFrame.new(0, la.Y * 0.5, 0), vein, M.Neon)
		wear(model, side .. "LowerArm", "Forearm", Vector3.new(la.X * 1.35, la.Y * 1.1, la.Z * 1.35), CFrame.new(0, -la.Y * 0.05, 0) * CFrame.Angles(0, -0.3, 0), rock, mat)
		wear(model, side .. "Hand", "Fist", Vector3.new(hd.X * 1.45, hd.Y * 3.0, hd.Z * 1.4), CFrame.new(0, -hd.Y * 0.9, 0) * CFrame.Angles(0, 0.2, 0), r2, mat)
		for j = -1, 1 do
			wear(model, side .. "Hand", "Knuckle", Vector3.new(hd.X * 0.45, hd.Y * 1.1, hd.Z * 0.4), CFrame.new(j * hd.X * 0.45, -hd.Y * 1.2, -hd.Z * 0.72), r1, mat)
		end
	end
	for _, side in ipairs({ "Left", "Right" }) do
		local ul, ll, ft = sizeOf(model, side .. "UpperLeg"), sizeOf(model, side .. "LowerLeg"), sizeOf(model, side .. "Foot")
		wear(model, side .. "UpperLeg", "Thigh", Vector3.new(ul.X * 1.1, ul.Y * 0.95, ul.Z * 1.15), CFrame.new(0, ul.Y * 0.05, 0) * CFrame.Angles(0, 0.2, 0), r1, mat)
		disc(model, side .. "LowerLeg", "KneeVein", ll.X * 0.85, 0.1 * k, CFrame.new(0, ll.Y * 0.5, 0), vein, M.Neon)
		wear(model, side .. "LowerLeg", "Shin", Vector3.new(ll.X * 1.1, ll.Y * 1.1, ll.Z * 1.1), CFrame.new(0, -ll.Y * 0.05, 0) * CFrame.Angles(0, -0.25, 0), rock, mat)
		wear(model, side .. "Foot", "FootSlab", Vector3.new(ft.X * 1.5, ft.Y * 2.2, ft.Z * 1.6), CFrame.new(0, ft.Y * 0.4, -ft.Z * 0.15), r1, mat)
	end
	-- 머리: 어깨 사이로 낮게, 눈두덩 아래의 빛나는 눈, 이끼 수염, 선돌 관과 가운데 빛나는 돌
	local H0 = Vector3.new(0, -hs.Y * 0.05, -hs.Z * 0.1)
	wear(model, "Head", "Neck", Vector3.new(hs.X * 0.55, hs.Y * 0.5, hs.Z * 0.55), CFrame.new(0, -hs.Y * 0.55, 0), dark(rock, 0.3), mat)
	wear(model, "Head", "Skull", Vector3.new(hs.X * 0.95, hs.Y * 0.8, hs.Z * 0.95), CFrame.new(H0) * CFrame.Angles(0.05, 0.1, 0), rock, mat)
	wear(model, "Head", "Brow", Vector3.new(hs.X * 1.0, hs.Y * 0.2, hs.Z * 0.35), CFrame.new(H0 + Vector3.new(0, hs.Y * 0.18, -hs.Z * 0.42)) * CFrame.Angles(0.15, 0, 0), r1, mat)
	wear(model, "Head", "Jaw", Vector3.new(hs.X * 0.85, hs.Y * 0.25, hs.Z * 0.8), CFrame.new(H0 + Vector3.new(0, -hs.Y * 0.42, -hs.Z * 0.1)), r1, mat)
	for _, x in ipairs({ -1, 1 }) do
		wear(model, "Head", "Eye", Vector3.new(0.24 * k, 0.09 * k, 0.05 * k), CFrame.new(H0 + Vector3.new(x * hs.X * 0.22, hs.Y * 0.02, -hs.Z * 0.49)), vein, M.Neon)
	end
	wear(model, "Head", "MossBeard", Vector3.new(hs.X * 0.75, hs.Y * 0.55, hs.Z * 0.25), CFrame.new(H0 + Vector3.new(0, -hs.Y * 0.55, -hs.Z * 0.4)), moss, M.Grass)
	for i = 0, 6 do
		local a = i / 7 * math.pi * 2
		local h = (i % 2 == 0 and 0.75 or 0.5) * k
		wear(model, "Head", "Menhir", Vector3.new(0.28 * k, h, 0.24 * k), CFrame.new(H0 + Vector3.new(math.sin(a) * hs.X * 0.38, hs.Y * 0.4 + h / 2, -math.cos(a) * hs.Z * 0.38)) * CFrame.Angles(-math.cos(a) * 0.18, -a, math.sin(a) * -0.18), r2, mat)
	end
	wear(model, "Head", "CrownGem", Vector3.new(0.3, 0.55, 0.3) * k, CFrame.new(H0 + Vector3.new(0, hs.Y * 0.62, 0)) * CFrame.Angles(0, math.rad(45), 0), vein, M.Neon)
	glow(model, "UpperTorso", vein, 12 * k, 1.2)
end

-- 균왕: 아래가 불룩한 자루 몸, 늘어진 턱받이, 큰 갓 (몸과 따로 읽히게 목을 가늘게), 가는 자루 팔과 작은 갓 주먹,
-- 땅으로 퍼지는 뿌리 다리, 어깨와 등에서 돋은 작은 버섯
BOSS_BODY.gyunwang = function(model: Model, look: any, k: number)
	local cap = look.capColor or C3(160, 26, 36)
	local stem = look.skin or C3(232, 222, 198)
	local gill = light(stem, 0.1):Lerp(C3(200, 180, 150), 0.4)
	local rootC = C3(110, 85, 60)
	hideBody(model)
	local ut, lt, hs = sizeOf(model, "UpperTorso"), sizeOf(model, "LowerTorso"), sizeOf(model, "Head")
	rod(model, "UpperTorso", "Stem", ut.Y * 1.35, ut.X * 0.6, CFrame.new(0, ut.Y * 0.05, 0), stem)
	ell(model, "LowerTorso", "Bulb", Vector3.new(ut.X * 0.85, lt.Y * 4.6, ut.X * 0.85), CFrame.new(0, -lt.Y * 0.7, 0), dark(stem, 0.06))
	for i = -2, 2 do
		wear(model, "UpperTorso", "StemGrain", Vector3.new(0.05 * k, ut.Y * 1.1, 0.04 * k), CFrame.new(i * ut.X * 0.07, 0, -ut.X * 0.3) * CFrame.Angles(0, i * 0.22, 0), dark(stem, 0.1))
	end
	-- 턱받이: 자루 위의 고리와 늘어진 주름 열둘
	disc(model, "UpperTorso", "Ring", ut.X * 0.95, 0.14 * k, CFrame.new(0, ut.Y * 0.38, 0), light(stem, 0.1))
	for i = 0, 11 do
		local a = i / 12 * math.pi * 2
		local r = ut.X * 0.42
		wear(model, "UpperTorso", "RingFrill", Vector3.new(ut.X * 0.24, 0.55 * k, 0.06 * k), CFrame.new(math.cos(a) * r, ut.Y * 0.2, math.sin(a) * r) * CFrame.Angles(0, -a + math.pi / 2, 0) * CFrame.Angles(math.rad(-12), 0, 0), i % 2 == 0 and light(stem, 0.1) or stem)
	end
	-- 머리: 가는 목 위의 얼굴 (자루 빛깔), 그 위에 큰 갓
	rod(model, "Head", "NeckStalk", hs.Y * 0.6, hs.X * 0.45, CFrame.new(0, -hs.Y * 0.35, 0), stem)
	ell(model, "Head", "Face", Vector3.new(hs.X * 0.72, hs.Y * 0.8, hs.Z * 0.72), CFrame.new(0, 0, 0), stem)
	for _, x in ipairs({ -1, 1 }) do
		ell(model, "Head", "Eye", Vector3.new(0.17 * k, 0.24 * k, 0.08 * k), CFrame.new(x * hs.X * 0.16, -hs.Y * 0.02, -hs.Z * 0.35), C3(18, 14, 12))
	end
	local R = (look.capSize or 3.8) * k * 0.5
	mushroomCap(model, "Head", CFrame.new(0, hs.Y * 0.34, 0), R, R * 0.62, cap, gill, look.spot or C3(245, 240, 228))
	-- 팔: 가는 자루 두 마디와 작은 갓 주먹
	for _, side in ipairs({ "Left", "Right" }) do
		local ua, la, hd = sizeOf(model, side .. "UpperArm"), sizeOf(model, side .. "LowerArm"), sizeOf(model, side .. "Hand")
		rod(model, side .. "UpperArm", "ArmStalk", ua.Y * 1.05, ua.X * 0.48, CFrame.new(0, 0, 0), stem)
		rod(model, side .. "LowerArm", "ArmStalk2", la.Y * 1.1, la.X * 0.42, CFrame.new(0, 0, 0), dark(stem, 0.05))
		ell(model, side .. "Hand", "FistCap", Vector3.new(hd.X * 1.5, hd.Y * 2.6, hd.Z * 1.5), CFrame.new(0, -hd.Y * 0.3, 0), cap)
		disc(model, side .. "Hand", "FistGill", hd.X * 1.35, 0.05 * k, CFrame.new(0, -hd.Y * 0.9, 0), gill)
	end
	-- 다리: 자루 두 마디, 발목에서 땅으로 퍼지는 뿌리 다섯
	for _, side in ipairs({ "Left", "Right" }) do
		local ul, ll = sizeOf(model, side .. "UpperLeg"), sizeOf(model, side .. "LowerLeg")
		rod(model, side .. "UpperLeg", "LegStalk", ul.Y * 1.0, ul.X * 0.55, CFrame.new(0, 0, 0), dark(stem, 0.1))
		rod(model, side .. "LowerLeg", "LegStalk2", ll.Y * 1.1, ll.X * 0.6, CFrame.new(0, 0, 0), dark(stem, 0.18):Lerp(rootC, 0.4))
		for j = 0, 4 do
			local a = j / 5 * math.pi * 2
			wear(model, side .. "Foot", "Root", Vector3.new(1.2 * k, 0.2 * k, 0.2 * k), CFrame.new(math.cos(a) * 0.45 * k, -0.05 * k, math.sin(a) * 0.45 * k) * CFrame.Angles(0, -a, -0.25), rootC, M.Wood, Cyl)
		end
	end
	-- 어깨와 등에서 돋은 작은 버섯
	local sprouts = { { -0.3, 0.45, 0.1, 1.0, -0.6 }, { -0.22, 0.42, 0.3, 0.7, -0.3 }, { 0.3, 0.45, 0.15, 0.85, 0.6 }, { 0.24, 0.3, -0.2, 0.6, 0.9 }, { -0.1, 0.1, 0.34, 0.75, -0.1 }, { 0.12, -0.2, 0.34, 0.6, 0.15 } }
	for _, s in ipairs(sprouts) do
		local x, y, z, sc, tilt = s[1], s[2], s[3], s[4] * 1.15, s[5]
		local at = CFrame.new(x * ut.X, ut.Y * y, z * ut.X) * CFrame.Angles(z > 0.25 and math.rad(60) or 0, 0, -tilt * 0.6)
		rod(model, "UpperTorso", "SproutStem", 0.55 * sc * k, 0.2 * sc * k, at * CFrame.new(0, 0.27 * sc * k, 0), stem)
		ell(model, "UpperTorso", "SproutCap", Vector3.new(0.8 * sc * k, 0.42 * sc * k, 0.8 * sc * k), at * CFrame.new(0, 0.56 * sc * k, 0), cap)
	end
	if look.spore then
		glow(model, "Head", look.spore, 8 * k, 0.8)
	end
end

------------------------------------------------------------------------
-- 입히기
------------------------------------------------------------------------
-- 3.10.1판: 모든 적의 몸을 다듬는다. 몸통·팔·다리가 한 빛깔 네모 상자로 붙어 사람·짐승이 아니라 덩어리처럼 보였다.
-- 몸통을 조금 좁히고 팔다리를 가늘게 해 (관절 자리는 그대로라 움직임은 같다) 팔과 몸, 두 다리 사이에 틈을 둔다
local SLIM: { [string]: Vector3 } = {
	UpperTorso = Vector3.new(0.82, 1, 0.94),
	LeftUpperArm = Vector3.new(0.74, 1, 0.78), RightUpperArm = Vector3.new(0.74, 1, 0.78),
	LeftLowerArm = Vector3.new(0.7, 1, 0.74), RightLowerArm = Vector3.new(0.7, 1, 0.74),
	LeftHand = Vector3.new(0.78, 1.2, 0.8), RightHand = Vector3.new(0.78, 1.2, 0.8),
	LeftUpperLeg = Vector3.new(0.84, 1, 0.88), RightUpperLeg = Vector3.new(0.84, 1, 0.88),
	LeftLowerLeg = Vector3.new(0.8, 1, 0.84), RightLowerLeg = Vector3.new(0.8, 1, 0.84),
}
local function slimBody(model: Model)
	for name, k in pairs(SLIM) do
		local bp = partOf(model, name)
		if bp and not bp:GetAttribute("Narrowed") then
			local cf = bp.CFrame
			bp.Size = bp.Size * k
			bp.CFrame = cf
			bp:SetAttribute("Narrowed", true)
		end
	end
end
-- 팔다리가 몸통과 같은 빛깔이면 조금 어둡게 (한 덩어리로 읽히지 않게)
local function shadeLimbs(model: Model)
	local ut = partOf(model, "UpperTorso")
	if not ut or ut.Transparency > 0.9 then
		return
	end
	local function same(a: Color3, b: Color3): boolean
		return math.abs(a.R - b.R) + math.abs(a.G - b.G) + math.abs(a.B - b.B) < 0.12
	end
	for _, n in ipairs(ARMS) do
		local p = partOf(model, n)
		if p and p.Transparency < 0.9 and same(p.Color, ut.Color) then
			p.Color = dark(p.Color, 0.2)
		end
	end
	for _, n in ipairs(LEGS) do
		local p = partOf(model, n)
		if p and p.Transparency < 0.9 and same(p.Color, ut.Color) then
			p.Color = dark(p.Color, 0.12)
		end
	end
end

function Dress.enemy(model: Model, typeId: string, def: any, isBoss: boolean)
	local look = Dress.lookOf(typeId, isBoss)
	if not partOf(model, "Head") then
		return
	end
	slimBody(model)
	local K = sizeOf(model, "UpperTorso").Y / 1.6
	local P = {
		top = look.top or (def and def.shirt) or C3(110, 90, 70),
		bottom = look.bottom or (def and def.pants) or C3(60, 50, 40),
	}
	P.trim = look.trim or dark(P.top, 0.35)
	P.sash = look.sash or P.trim
	P.wrap = look.wrap or light(P.bottom, 0.45):Lerp(C3(220, 210, 190), 0.3)
	P.shoe = look.shoe or C3(36, 30, 26)
	local bossBody = isBoss and BOSS_BODY[typeId] or nil
	if bossBody then
		bossBody(model, look, K)
	elseif look.form then
		local fn = FORMS[look.form]
		if fn then
			fn(model, look, K, isBoss)
		end
	else
		headgear(model, look, P)
		face(model, look)
		outfit(model, look, P, K)
	end
	if isBoss and not bossBody then
		local sig = SIG[typeId]
		if sig then
			local ok, err = pcall(sig, model, look, K, P)
			if not ok then
				warn("[권왕] 보스 표식 오류:", typeId, err)
			end
		elseif not look.form then
			mantle(model, look.robe or dark(P.top, 0.2), P.trim, K, 3.0)
		end
	end
	shadeLimbs(model)
end

return Dress
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="12">
        <Properties>
          <string name="Name">MiniQuest</string>
          <string name="Source"><![CDATA[-- 권왕 3.7판: 사부의 부탁 (미니 퀘스트). 높은 권법의 사부는 시험 전에 부탁을 한다
-- 기록: p.mq[권법] = 지금 단계 (1부터, 다 끝나면 단계 수 + 1), p.mqn[권법] = 그 단계에서 해낸 수 (찾기·차례·쓰러뜨리기)
-- 찾은 것 하나하나는 p.seen["mq_권법_단계_번호"]
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage:WaitForChild("Config"))

local MiniQuest = {}

local ctx: any = nil
-- ctx = { profiles, states, toast, dialog, pushState, isDay, rootOf, fx }
function MiniQuest.init(c: any)
	ctx = c
end

local function quest(sid: string): any
	return Config.MINIQUEST and Config.MINIQUEST[sid]
end
function MiniQuest.has(sid: string): boolean
	return quest(sid) ~= nil
end
-- 부탁을 다 들어주었나 (부탁이 없는 권법은 늘 그렇다)
function MiniQuest.done(p: any, sid: string): boolean
	local q = quest(sid)
	if not q then
		return true
	end
	return (p.mq[sid] or 0) > #q.steps
end
local function stepOf(p: any, sid: string): (any, number)
	local q = quest(sid)
	local i = p.mq[sid] or 0
	return q and q.steps[i], i
end
local function progressText(p: any, sid: string, step: any): string
	local n = p.mqn[sid] or 0
	if step.kind == "find" then
		return string.format(" (%d/%d)", n, #step.items)
	elseif step.kind == "order" then
		return string.format(" (%d/%d)", n, #step.stones)
	elseif step.kind == "kill" then
		return string.format(" (%d/%d)", n, step.n)
	end
	return ""
end
-- 지금 부탁을 한 줄로 (사부 대화·토스트에 쓴다)
function MiniQuest.line(p: any, sid: string): string
	local q = quest(sid)
	local step, i = stepOf(p, sid)
	if not q or not step then
		return ""
	end
	return string.format("「%s」 %d/%d · %s%s", q.title, i, #q.steps, step.text, progressText(p, sid, step))
end

local function advance(player: Player, sid: string)
	local p, st = ctx.profiles[player], ctx.states[player]
	local q = quest(sid)
	if not p or not st or not q then
		return
	end
	p.mq[sid] = (p.mq[sid] or 0) + 1
	p.mqn[sid] = 0
	st.dirty = true
	local m = Config.MASTERS[sid]
	local step = q.steps[p.mq[sid]]
	if step then
		ctx.toast(player, "📜 " .. (m and m.name or "사부") .. "의 부탁 · " .. step.text)
	else
		ctx.toast(player, "📜 부탁을 모두 들어주었다")
	end
	ctx.pushState(player)
end

-- 사부에게 말을 걸었다: 부탁을 시작하거나, 지금 단계를 알려 주거나, 돌아왔음을 받는다.
-- true면 사부가 시험을 낼 수 있다 (부탁을 다 들어주었다)
function MiniQuest.talk(player: Player, sid: string): boolean
	local p, st = ctx.profiles[player], ctx.states[player]
	local q = quest(sid)
	if not q or not p or not st then
		return true
	end
	local m = Config.MASTERS[sid]
	local who = m and m.name or "사부"
	local title = m and ("「" .. m.quote .. "」") or ""
	if (p.mq[sid] or 0) == 0 then
		p.mq[sid] = 1
		p.mqn[sid] = 0
		st.dirty = true
		ctx.dialog(player, { who = who, title = title, text = "시험을 청하기 전에, 부탁이 하나 있다. 「" .. q.title .. "」\n" .. q.steps[1].text .. progressText(p, sid, q.steps[1]) })
		ctx.pushState(player)
		return false
	end
	local step = q.steps[p.mq[sid]]
	if not step then
		return true
	end
	if step.kind == "return" then
		advance(player, sid)
		ctx.dialog(player, { who = who, title = title, text = "...왔구나. 부탁을 들어주었으니 이제 네 차례다. 시험을 내마. (다시 T를 누르면 시험이 시작된다)" })
		return false
	end
	ctx.dialog(player, { who = who, title = title, text = "아직 부탁이 남았다. " .. MiniQuest.line(p, sid) })
	return false
end

-- 들판에 놓인 것을 짚었다 (찾기·차례)
function MiniQuest.touch(player: Player, sid: string, stepIdx: number, idx: number)
	local p, st = ctx.profiles[player], ctx.states[player]
	if not p or not st then
		return
	end
	local step, cur = stepOf(p, sid)
	if not step or cur ~= stepIdx then
		ctx.toast(player, "…아직은 그저 고운 것 같다")
		return
	end
	if step.kind == "find" then
		local key = string.format("mq_%s_%d_%d", sid, stepIdx, idx)
		if p.seen[key] then
			ctx.toast(player, "이미 찾은 것이에요")
			return
		end
		p.seen[key] = true
		p.mqn[sid] = (p.mqn[sid] or 0) + 1
		st.dirty = true
		ctx.toast(player, string.format("%s %s (%d/%d)", step.icon or "✨", step.name or "찾았다", p.mqn[sid], #step.items))
		if p.mqn[sid] >= #step.items then
			advance(player, sid)
		else
			ctx.pushState(player)
		end
	elseif step.kind == "order" then
		local n = (p.mqn[sid] or 0) + 1
		-- 같은 글자가 둘이면 어느 쪽을 짚어도 된다 (N U L L)
		local want, got = step.stones[n], step.stones[idx]
		if idx == n or (got and want and got.label ~= nil and got.label == want.label) then
			p.mqn[sid] = n
			st.dirty = true
			ctx.toast(player, string.format("✨ %s %d/%d", step.name or "차례", n, #step.stones))
			if ctx.fx then
				ctx.fx(player, "mqLight", step.stones[idx].at)
			end
			if n >= #step.stones then
				advance(player, sid)
			else
				ctx.pushState(player)
			end
		else
			p.mqn[sid] = 0
			st.dirty = true
			ctx.toast(player, "💨 차례가 틀렸다. 처음부터 다시")
			ctx.pushState(player)
		end
	end
end

-- 적을 쓰러뜨렸다
function MiniQuest.onKill(player: Player, typeId: string?)
	local p = ctx.profiles[player]
	if not p or not typeId then
		return
	end
	for sid, _ in pairs(Config.MINIQUEST or {}) do
		local step = stepOf(p, sid)
		if step and step.kind == "kill" and step.enemy == typeId then
			p.mqn[sid] = (p.mqn[sid] or 0) + 1
			ctx.states[player].dirty = true
			if p.mqn[sid] >= step.n then
				advance(player, sid)
			else
				ctx.toast(player, string.format("📜 %s (%d/%d)", step.text, p.mqn[sid], step.n))
			end
		end
	end
end

-- 1초마다: 가야 할 곳에 닿았나
function MiniQuest.tick(player: Player)
	local p = ctx.profiles[player]
	if not p then
		return
	end
	local r = ctx.rootOf(player)
	if not r then
		return
	end
	for sid, _ in pairs(Config.MINIQUEST or {}) do
		local step = stepOf(p, sid)
		if step and step.kind == "visit" then
			local d = Vector3.new(r.Position.X - step.at.X, 0, r.Position.Z - step.at.Z).Magnitude
			if d <= step.r and math.abs(r.Position.Y - step.at.Y) < 200 then
				if step.night and ctx.isDay() then
					local st = ctx.states[player] :: any
					if os.clock() - (st.mqNightHint or 0) > 20 then
						st.mqNightHint = os.clock()
						ctx.toast(player, "🌙 여기는 밤에 와야 할 것 같다")
					end
				else
					if step.say then
						ctx.dialog(player, { who = "📜 " .. quest(sid).title, title = "", text = step.say })
					end
					advance(player, sid)
				end
			end
		end
	end
end

-- 테스트: 진행 중인 부탁을 한 단계씩 넘긴다
function MiniQuest.skip(player: Player)
	local p = ctx.profiles[player]
	if not p then
		return
	end
	local any = false
	for sid, q in pairs(Config.MINIQUEST or {}) do
		local i = p.mq[sid] or 0
		if i >= 1 and i <= #q.steps then
			advance(player, sid)
			any = true
		end
	end
	if not any then
		ctx.toast(player, "진행 중인 부탁이 없어요 (사부에게 먼저 말을 거세요)")
	end
end

return MiniQuest
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="13">
        <Properties>
          <string name="Name">Npc</string>
          <string name="Source"><![CDATA[-- 권왕: 무기를 든 적과 보스 (서버가 움직인다)
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage:WaitForChild("Config"))
local Combat = require(script.Parent:WaitForChild("Combat"))

local Npc = {}

type Enemy = {
	f: any,
	def: any,
	kind: string, -- "enemy" / "boss"
	typeId: string,
	home: Vector3,
	target: any?,
	nextAttack: number,
	guardUntil: number,
	strafe: number,
	phase2: boolean,
	seq: number,
	region: string,
	engaged: { [Player]: boolean },
	level: number,
	attackingUntil: number,
	nextPattern: number?,
}

Npc.list = {} :: { Enemy }
local folder: Folder
local Push: RemoteEvent
local SKIN = Color3.fromRGB(234, 184, 146)
-- 적의 살빛 (여러 가지)
local SKIN_TONES = { Color3.fromRGB(226, 172, 132), Color3.fromRGB(205, 150, 110), Color3.fromRGB(184, 128, 92), Color3.fromRGB(160, 110, 78), Color3.fromRGB(236, 190, 155) }

function Npc.init(push: RemoteEvent)
	Push = push
	folder = Instance.new("Folder")
	folder.Name = "Enemies"
	folder.Parent = workspace
end

------------------------------------------------------------------------
-- 몸과 무기
------------------------------------------------------------------------
local function weaponPart(name: string, size: Vector3, color: Color3, material: Enum.Material, parent: Instance): Part
	local p = Instance.new("Part")
	p.Name = name
	p.Size = size
	p.Color = color
	p.Material = material
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.Massless = true
	p.Parent = parent
	return p
end

-- 손에 무기를 붙인다. 날은 손의 앞(-Z)으로 뻗는다
local function attachWeapon(model: Model, kind: string)
	local w = Config.Weapons[kind]
	if not w then
		return
	end
	local function onHand(handName: string)
		local hand = model:FindFirstChild(handName)
		if not hand or not hand:IsA("BasePart") then
			return
		end
		local L = w.length
		local wf = Instance.new("Model")
		wf.Name = "Weapon"
		wf.Parent = model
		local grip = weaponPart("Grip", Vector3.new(0.35, 0.35, kind == "spear" and L or 1.1), w.handle, Enum.Material.Wood, wf)
		local blade: Part
		if kind == "spear" then
			blade = weaponPart("Blade", Vector3.new(0.25, 0.6, 1.4), w.color, Enum.Material.Metal, wf)
		elseif kind == "club" then
			blade = weaponPart("Blade", Vector3.new(0.75, 0.75, L), w.color, Enum.Material.Wood, wf)
		elseif kind == "staff" then
			blade = weaponPart("Blade", Vector3.new(0.4, 0.4, L), w.color, Enum.Material.Wood, wf)
		else
			blade = weaponPart("Blade", Vector3.new(0.12, kind == "greatsword" and 0.9 or 0.45, L), w.color, Enum.Material.Metal, wf)
		end
		local guard = weaponPart("Guard", Vector3.new(0.3, 0.9, 0.2), Color3.fromRGB(160, 130, 60), Enum.Material.Metal, wf)
		local base = hand.CFrame * CFrame.new(0, -0.25, 0)
		if kind == "spear" then
			grip.CFrame = base
			blade.CFrame = base * CFrame.new(0, 0, -L / 2 - 0.6)
			guard.CFrame = base * CFrame.new(0, 0, -L / 2 + 0.1)
		else
			grip.CFrame = base * CFrame.new(0, 0, 0.3)
			guard.CFrame = base * CFrame.new(0, 0, -0.3)
			blade.CFrame = base * CFrame.new(0, 0, -0.3 - L / 2)
		end
		for _, p in ipairs({ grip, blade, guard }) do
			local weld = Instance.new("WeldConstraint")
			weld.Part0 = hand
			weld.Part1 = p
			weld.Parent = p
		end
	end
	onHand("RightHand")
	if kind == "dual" then
		onHand("LeftHand")
	end
end

-- 몸을 직접 짠다 (R15 관절 이름 그대로). 로블록스 기본 몸 만들기가 안 될 때 쓴다
-- 관절 자리 J를 기준으로 C0·C1을 맞춘다. 발바닥이 HumanoidRootPart 중심에서 3칸 아래
local RIG: { { any } } = {
	-- 이름, 크기, 중심, 부모, 관절 이름, 관절 자리
	{ "LowerTorso", Vector3.new(2, 0.4, 1), Vector3.new(0, -0.8, 0), "HumanoidRootPart", "Root", Vector3.new(0, -0.8, 0) },
	{ "UpperTorso", Vector3.new(2, 1.6, 1), Vector3.new(0, 0.2, 0), "LowerTorso", "Waist", Vector3.new(0, -0.6, 0) },
	{ "Head", Vector3.new(1.2, 1.2, 1.2), Vector3.new(0, 1.6, 0), "UpperTorso", "Neck", Vector3.new(0, 1.0, 0) },
	{ "RightUpperArm", Vector3.new(1, 1.2, 1), Vector3.new(1.5, 0.4, 0), "UpperTorso", "RightShoulder", Vector3.new(1.5, 0.8, 0) },
	{ "RightLowerArm", Vector3.new(1, 0.95, 1), Vector3.new(1.5, -0.675, 0), "RightUpperArm", "RightElbow", Vector3.new(1.5, -0.2, 0) },
	{ "RightHand", Vector3.new(1, 0.3, 1), Vector3.new(1.5, -1.3, 0), "RightLowerArm", "RightWrist", Vector3.new(1.5, -1.15, 0) },
	{ "LeftUpperArm", Vector3.new(1, 1.2, 1), Vector3.new(-1.5, 0.4, 0), "UpperTorso", "LeftShoulder", Vector3.new(-1.5, 0.8, 0) },
	{ "LeftLowerArm", Vector3.new(1, 0.95, 1), Vector3.new(-1.5, -0.675, 0), "LeftUpperArm", "LeftElbow", Vector3.new(-1.5, -0.2, 0) },
	{ "LeftHand", Vector3.new(1, 0.3, 1), Vector3.new(-1.5, -1.3, 0), "LeftLowerArm", "LeftWrist", Vector3.new(-1.5, -1.15, 0) },
	{ "RightUpperLeg", Vector3.new(1, 1.1, 1), Vector3.new(0.5, -1.55, 0), "LowerTorso", "RightHip", Vector3.new(0.5, -1.0, 0) },
	{ "RightLowerLeg", Vector3.new(1, 0.7, 1), Vector3.new(0.5, -2.45, 0), "RightUpperLeg", "RightKnee", Vector3.new(0.5, -2.1, 0) },
	{ "RightFoot", Vector3.new(1, 0.2, 1.1), Vector3.new(0.5, -2.9, -0.05), "RightLowerLeg", "RightAnkle", Vector3.new(0.5, -2.8, 0) },
	{ "LeftUpperLeg", Vector3.new(1, 1.1, 1), Vector3.new(-0.5, -1.55, 0), "LowerTorso", "LeftHip", Vector3.new(-0.5, -1.0, 0) },
	{ "LeftLowerLeg", Vector3.new(1, 0.7, 1), Vector3.new(-0.5, -2.45, 0), "LeftUpperLeg", "LeftKnee", Vector3.new(-0.5, -2.1, 0) },
	{ "LeftFoot", Vector3.new(1, 0.2, 1.1), Vector3.new(-0.5, -2.9, -0.05), "LeftLowerLeg", "LeftAnkle", Vector3.new(-0.5, -2.8, 0) },
}

local function manualRig(colors: { head: Color3, torso: Color3, arms: Color3, legs: Color3 }, s: number): Model
	local model = Instance.new("Model")
	local root = Instance.new("Part")
	root.Name = "HumanoidRootPart"
	root.Size = Vector3.new(2, 2, 1) * s
	root.Transparency = 1
	root.CanCollide = false
	root.Parent = model
	model.PrimaryPart = root
	local parts: { [string]: BasePart } = { HumanoidRootPart = root }
	for _, r in ipairs(RIG) do
		local name, size, center, parentName, jointName, joint = r[1], r[2], r[3], r[4], r[5], r[6]
		local p = Instance.new("Part")
		p.Name = name
		p.Size = size * s
		p.CFrame = CFrame.new(center * s)
		p.TopSurface = Enum.SurfaceType.Smooth
		p.BottomSurface = Enum.SurfaceType.Smooth
		p.CanCollide = name == "UpperTorso" or name == "LowerTorso" or name == "Head"
		p.Material = Enum.Material.SmoothPlastic
		if name == "Head" then
			p.Color = colors.head
			local mesh = Instance.new("SpecialMesh")
			mesh.MeshType = Enum.MeshType.Head
			mesh.Scale = Vector3.new(1.25, 1.25, 1.25)
			mesh.Parent = p
			local face = Instance.new("Decal")
			face.Name = "face"
			face.Texture = "rbxasset://textures/face.png"
			face.Face = Enum.NormalId.Front
			face.Parent = p
		elseif string.find(name, "Torso") then
			p.Color = colors.torso
		elseif string.find(name, "Arm") or string.find(name, "Hand") then
			p.Color = colors.arms
		else
			p.Color = colors.legs
		end
		p.Parent = model
		parts[name] = p
		local parent = parts[parentName]
		local m = Instance.new("Motor6D")
		m.Name = jointName
		m.Part0 = parent
		m.Part1 = p
		local j = joint * s
		m.C0 = CFrame.new(j - parent.Position)
		m.C1 = CFrame.new(j - center * s)
		m.Parent = p
	end
	local hum = Instance.new("Humanoid")
	hum.RigType = Enum.HumanoidRigType.R15
	hum.HipHeight = 2 * s
	hum.AutomaticScalingEnabled = false
	hum.Parent = model
	return model
end

-- 사람 몸 하나 (로블록스 기본 몸, 안 되면 직접 짠 몸)
-- build = { h = 키, w = 품, head = 머리 } 배율 (적마다 체격이 다르다. 머리를 조금 작게 해 어른 몸으로)
local function body(colors: { head: Color3, torso: Color3, arms: Color3, legs: Color3 }, s: number, build: any?): Model
	local bd = build or {}
	local ok, model = pcall(function()
		local desc = Instance.new("HumanoidDescription")
		desc.HeadColor = colors.head
		desc.LeftArmColor = colors.arms
		desc.RightArmColor = colors.arms
		desc.TorsoColor = colors.torso
		desc.LeftLegColor = colors.legs
		desc.RightLegColor = colors.legs
		desc.HeightScale = s * (bd.h or 1)
		desc.WidthScale = s * (bd.w or 1)
		desc.DepthScale = s * (bd.w or 1)
		desc.HeadScale = s * (bd.head or 1)
		return Players:CreateHumanoidModelFromDescription(desc, Enum.HumanoidRigType.R15)
	end)
	if ok and typeof(model) == "Instance" and model:IsA("Model") and model:FindFirstChild("HumanoidRootPart") and model:FindFirstChild("LowerTorso") then
		-- 기본 걷기 스크립트는 쓰지 않는다 (몸동작은 화면이 그린다)
		local animate = model:FindFirstChild("Animate")
		if animate then
			animate:Destroy()
		end
		return model
	end
	if not ok then
		warn("[권왕] 기본 몸 만들기 실패, 직접 짠 몸을 씁니다:", model)
	end
	return manualRig(colors, s)
end
Npc.body = body

local dressEnemy: (Model, string, any, boolean) -> ()
local lookOf: (string, boolean) -> any

local function buildRig(def: any, label: string, isBoss: boolean, typeId: string?): Model
	local s = def.scale or 1
	local look = lookOf(typeId or "", isBoss)
	local skin = look.skin or SKIN_TONES[math.random(#SKIN_TONES)]
	local model = body({ head = skin, torso = def.shirt, arms = look.bareArms == false and def.shirt or skin, legs = def.pants }, s, look.build or { head = 0.9 })
	model.Name = label
	local hum = model:FindFirstChildOfClass("Humanoid")
	if hum then
		hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
		hum.BreakJointsOnDeath = false
		hum.MaxHealth = 1e9
		hum.Health = 1e9
		hum.WalkSpeed = def.speed
	end
	-- 적마다 다른 차림 (머리쓰개, 얼굴, 옷). 실패해도 몸은 그대로 쓴다
	if not def.dummy then
		local ok, err = pcall(dressEnemy, model, typeId or "", def, isBoss)
		if not ok then
			warn("[권왕] 적 차림 오류:", typeId, err)
		end
	end
	attachWeapon(model, def.weapon)
	model:SetAttribute("NPC", true)
	model:SetAttribute("Boss", isBoss)
	model:SetAttribute("Label", label)
	model:SetAttribute("Scale", def.scale or 1)
	model:SetAttribute("Weapon", def.weapon)
	if def.dummy then
		model:SetAttribute("Dummy", true)
	end
	return model
end

------------------------------------------------------------------------
-- 나타나기
------------------------------------------------------------------------
function Npc.spawn(typeId: string, isBoss: boolean, at: Vector3, region: string): Enemy?
	local def = isBoss and Config.Bosses[typeId] or Config.Enemies[typeId]
	if not def then
		return nil
	end
	local model = buildRig(def, def.name, isBoss, typeId)
	local pos = at + Vector3.new(math.random(-8, 8), 4 * (def.scale or 1), math.random(-8, 8))
	model:PivotTo(CFrame.new(pos))
	model.Parent = folder
	local root = model:FindFirstChild("HumanoidRootPart")
	if root and root:IsA("BasePart") then
		pcall(function()
			root:SetNetworkOwner(nil)
		end)
	end
	-- 마을에서 멀수록 단계가 높다: 체력·균형·피해·보상이 함께 오른다
	local lv = Config.enemyLevel(at)
	model:SetAttribute("Level", lv)
	-- mult: 허공 균열 같은 후반 땅의 적은 체력·피해가 겹으로 세다
	local mult = def.mult or 1
	local f = Combat.register(model, {
		npc = def,
		name = def.name,
		-- 체력은 넉넉하게 (보스는 조금 덜 곱한다: 이미 크다), 피해는 후반일수록 덜 오른다
		hp = def.dummy and def.hp or math.floor(def.hp * (isBoss and Config.ENEMY_BOSS_HP or Config.ENEMY_HP) * (1 + Config.ENEMY_HP_LEVEL * (lv - 1)) * mult),
		postureMax = math.floor(def.posture * (1 + 0.1 * (lv - 1)) * math.sqrt(mult)),
		walk = def.speed * (isBoss and Config.BOSS_SPEED or 1),
		style = def.style or "",
		dmgMult = Config.ENEMY_DMG * (1 + Config.ENEMY_DMG_LEVEL * (lv - 1)) * mult ^ Config.ENEMY_DMG_MULT_POW * (isBoss and (def.late and Config.LATE_BOSS_DMG or Config.BOSS_DMG) or 1) * (def.dmgScale or 1),
	})
	;(f :: any).rewardMult = (1 + 0.25 * (lv - 1)) * math.sqrt(mult)
	-- 초반 적은 흘리기 판정이 좁다 (막아도 잘 흘리지 못한다)
	if not isBoss and not def.elite and not def.duel and lv <= 4 then
		(f :: any).deflectMul = 0.45
	end
	;(f :: any).typeId = typeId
	model:SetAttribute("TypeId", typeId)
	local cp = Config.enemyPower(f.dmgMult * Config.enemyMoveFactor(def, isBoss), f.maxHp, isBoss)
	;(f :: any).power = cp
	model:SetAttribute("Power", cp)
	-- 2.7.2판: 어느 땅의 적인지 (권장 전투력 표와 같은 이름). 후반 보스의 처치 몫을 그 땅 졸병에 견준다
	local skyIsl = region == "sky" and Config.skyIslandAt(at) or nil
	;(f :: any).regionKey = skyIsl and ("sky_" .. skyIsl.id) or region
	local e: Enemy = {
		f = f,
		def = def,
		kind = isBoss and "boss" or "enemy",
		typeId = typeId,
		home = at,
		target = nil,
		nextAttack = os.clock() + 1,
		guardUntil = 0,
		strafe = math.random() < 0.5 and 1 or -1,
		phase2 = false,
		seq = 0,
		region = region,
		engaged = {},
		level = lv,
		attackingUntil = 0,
	}
	table.insert(Npc.list, e)
	return e
end

-- 지역마다 적과 보스를 놓는다
function Npc.populate()
	for _, region in ipairs(Config.Regions) do
		for _, camp in ipairs(region.camps or {}) do
			for _ = 1, camp.count do
				local ok, err = pcall(Npc.spawn, camp.enemy, false, camp.at, region.id)
				if not ok then
					warn("[권왕] 적 만들기 오류:", camp.enemy, err)
				end
			end
		end
		if region.boss then
			local ok, err = pcall(Npc.spawn, region.boss.id, true, region.boss.at, region.id)
			if not ok then
				warn("[권왕] 보스 만들기 오류:", region.boss.id, err)
			end
		end
	end
	-- 천상계의 섬들
	for _, isl in ipairs(Config.SKY.islands) do
		for _, camp in ipairs(isl.camps or {}) do
			for _ = 1, camp.count do
				local ok, err = pcall(Npc.spawn, camp.enemy, false, camp.at, "sky")
				if not ok then
					warn("[권왕] 천상계 적 만들기 오류:", camp.enemy, err)
				end
			end
		end
		if isl.boss then
			local ok, err = pcall(Npc.spawn, isl.boss.id, true, isl.boss.at, "sky")
			if not ok then
				warn("[권왕] 천상계 보스 만들기 오류:", isl.boss.id, err)
			end
		end
	end
	pcall(Npc.publishPower)
end

-- 1.5판: 지역마다 권장 전투력 (그 땅 적들의 가운데 전투력보다 조금 높게). 보스는 따로. 화면의 지도와 지역 알림이 쓴다
function Npc.publishPower()
	local groups: { [string]: { number } } = {}
	local bosses: { [string]: number } = {}
	for _, e in ipairs(Npc.list) do
		local key = e.region
		if key == "sky" then
			local isl = Config.skyIslandAt(e.f.root.Position)
			key = isl and ("sky_" .. isl.id) or "sky"
		end
		if key ~= "trial" and key ~= "test" and key ~= "summon" and key ~= "simma" and key ~= "wilds" then
			local pw = (e.f :: any).power or 0
			if e.kind == "boss" then
				bosses[key] = math.max(bosses[key] or 0, pw)
			else
				groups[key] = groups[key] or {}
				table.insert(groups[key], pw)
			end
		end
	end
	local folder = ReplicatedStorage:FindFirstChild("KwonRegionPower") or Instance.new("Folder")
	folder.Name = "KwonRegionPower"
	for key, list in pairs(groups) do
		table.sort(list)
		local mid = list[math.max(1, math.ceil(#list / 2))]
		folder:SetAttribute(key, math.floor(mid * 1.15))
	end
	for key, pw in pairs(bosses) do
		folder:SetAttribute(key .. "_boss", math.floor(pw))
	end
	folder.Parent = ReplicatedStorage
end

------------------------------------------------------------------------
-- 일곱 사부 (싸우지 않는다. 가까이 가서 T를 누르면 권법을 배운다)
------------------------------------------------------------------------
local function masterTag(head: BasePart, name: string, style: any)
	local g = Instance.new("BillboardGui")
	g.Name = "MasterTag"
	g.Size = UDim2.new(0, 320, 0, 74)
	g.StudsOffset = Vector3.new(0, 3.2, 0)
	g.AlwaysOnTop = true
	g.LightInfluence = 0
	g.MaxDistance = 160
	-- 장로는 이름 한 줄만 (말 걸기는 가까이 가면 뜨는 T 안내로)
	local lines = style.elder and { { name, Color3.fromRGB(255, 225, 150), 0.52 } } or { { "사부 · " .. name, Color3.fromRGB(255, 225, 150), 0.52 }, { style.icon .. " " .. style.name .. "  (T)", style.color, 0.48 } }
	for i, line in ipairs(lines) do
		local l = Instance.new("TextLabel")
		l.BackgroundTransparency = 1
		l.Position = UDim2.fromScale(0, i == 1 and 0 or 0.52)
		l.Size = UDim2.fromScale(1, line[3])
		l.Font = Enum.Font.GothamBlack
		l.TextScaled = true
		l.TextColor3 = line[2]
		l.TextStrokeTransparency = 0.2
		l.Text = line[1]
		l.Parent = g
	end
	g.Parent = head
end

-- 사부 차림: 몸 부위에 붙는 장식 (기본 몸이든 직접 짠 몸이든 부위 이름은 같다)
local function wear(model: Model, partName: string, name: string, size: Vector3, offset: CFrame, color: Color3, material: Enum.Material?, shape: Enum.PartType?): Part?
	local base = model:FindFirstChild(partName)
	if not base or not base:IsA("BasePart") then
		return nil
	end
	local p = Instance.new("Part")
	p.Name = name
	if shape then
		p.Shape = shape
	end
	p.Size = size
	p.Color = color
	p.Material = material or Enum.Material.Fabric
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.Massless = true
	p.CFrame = base.CFrame * offset
	p.Parent = model
	local w = Instance.new("WeldConstraint")
	w.Part0 = base
	w.Part1 = p
	w.Parent = p
	return p
end

local GOLD = Color3.fromRGB(235, 190, 80)
local WHITE_HAIR = Color3.fromRGB(240, 240, 235)

-- 2.7판: 적과 보스의 차림은 Dress.lua로 옮겨 처음부터 다시 짰다
local Dress = require(script.Parent:WaitForChild("Dress"))
lookOf = Dress.lookOf
dressEnemy = Dress.enemy

local function dressMaster(model: Model, style: any)
	local robe = style.color:Lerp(Color3.new(0, 0, 0), 0.35)
	local trim = style.color2
	local head = model:FindFirstChild("Head") :: BasePart?
	local hs = head and head.Size or Vector3.new(1.2, 1.2, 1.2)
	-- 공통: 앞뒤로 갈라진 긴 도포, 금빛 어깨받이, 허리띠 끈, 등 망토
	for _, z in ipairs({ -1, 1 }) do
		wear(model, "LowerTorso", "RobePanel", Vector3.new(2.1, 2.4, 0.18), CFrame.new(0, -1.35, z * 0.55), robe)
		wear(model, "LowerTorso", "RobeTrim", Vector3.new(2.15, 0.25, 0.22), CFrame.new(0, -2.5, z * 0.55), trim, Enum.Material.SmoothPlastic)
	end
	for _, x in ipairs({ -1, 1 }) do
		wear(model, "UpperTorso", "Pauldron", Vector3.new(1.25, 0.45, 1.35), CFrame.new(x * 1.15, 0.72, 0) * CFrame.Angles(0, 0, -x * math.rad(15)), GOLD, Enum.Material.Metal)
		wear(model, "LowerTorso", "SashTail", Vector3.new(0.3, 1.6, 0.1), CFrame.new(x * 0.35, -0.9, 0.62) * CFrame.Angles(math.rad(8), 0, x * math.rad(6)), trim)
	end
	wear(model, "UpperTorso", "Cape", Vector3.new(2.1, 3.6, 0.14), CFrame.new(0, -0.9, 0.62) * CFrame.Angles(math.rad(10), 0, 0), style.color)
	wear(model, "UpperTorso", "Collar", Vector3.new(1.4, 0.35, 1.15), CFrame.new(0, 0.85, -0.05), trim, Enum.Material.SmoothPlastic)

	local id = style.id
	local function beard(color: Color3)
		wear(model, "Head", "Beard", Vector3.new(hs.X * 0.55, hs.Y * 1.1, 0.35), CFrame.new(0, -hs.Y * 0.62, -hs.Z * 0.42), color)
		for _, x in ipairs({ -1, 1 }) do
			wear(model, "Head", "Mustache", Vector3.new(hs.X * 0.35, 0.12, 0.12), CFrame.new(x * hs.X * 0.2, -hs.Y * 0.12, -hs.Z * 0.52) * CFrame.Angles(0, 0, x * math.rad(-25)), color)
		end
	end
	if id == "taeheo" then
		-- 물빛 도인: 흰 수염과 상투
		beard(WHITE_HAIR)
		wear(model, "Head", "Topknot", Vector3.new(0.6, 0.6, 0.6), CFrame.new(0, hs.Y * 0.62, 0.05), WHITE_HAIR, Enum.Material.SmoothPlastic, Enum.PartType.Ball)
		wear(model, "Head", "Hairband", Vector3.new(hs.X * 1.03, 0.18, hs.Z * 1.03), CFrame.new(0, hs.Y * 0.28, 0), trim, Enum.Material.Neon)
	elseif id == "geumgang" then
		-- 금강 대사: 염주와 비스듬한 가사
		for k = 0, 13 do
			local a = k / 14 * math.pi * 2
			wear(model, "UpperTorso", "Bead", Vector3.new(0.32, 0.32, 0.32), CFrame.new(math.cos(a) * 0.62, 0.62 - math.abs(math.sin(a)) * 0.15, math.sin(a) * 0.55), Color3.fromRGB(110, 60, 30), Enum.Material.Wood, Enum.PartType.Ball)
		end
		wear(model, "UpperTorso", "Kasaya", Vector3.new(0.55, 2.6, 1.12), CFrame.new(0, 0, 0) * CFrame.Angles(0, 0, math.rad(35)), Color3.fromRGB(190, 50, 35))
		wear(model, "Head", "Urna", Vector3.new(0.15, 0.15, 0.1), CFrame.new(0, hs.Y * 0.22, -hs.Z * 0.5), GOLD, Enum.Material.Neon)
	elseif id == "maehwa" then
		-- 매화 선자: 긴 머리, 꽃 비녀, 넓은 소매
		wear(model, "Head", "LongHair", Vector3.new(hs.X * 1.05, hs.Y * 2.2, 0.35), CFrame.new(0, -hs.Y * 0.55, hs.Z * 0.5), Color3.fromRGB(25, 20, 25))
		wear(model, "Head", "HairTop", Vector3.new(hs.X * 1.08, hs.Y * 0.4, hs.Z * 1.08), CFrame.new(0, hs.Y * 0.4, 0.05), Color3.fromRGB(25, 20, 25))
		wear(model, "Head", "Hairpin", Vector3.new(0.5, 0.5, 0.5), CFrame.new(hs.X * 0.45, hs.Y * 0.5, 0.2), style.color, Enum.Material.Neon, Enum.PartType.Ball)
		for _, side in ipairs({ "Right", "Left" }) do
			wear(model, side .. "LowerArm", "Sleeve", Vector3.new(1.45, 1.1, 1.45), CFrame.new(0, -0.2, 0), trim)
		end
	elseif id == "cheonryong" then
		-- 용천 노조: 용뿔 관과 흰 수염
		beard(WHITE_HAIR)
		wear(model, "Head", "Crown", Vector3.new(hs.X * 0.9, 0.3, hs.Z * 0.6), CFrame.new(0, hs.Y * 0.55, 0), GOLD, Enum.Material.Metal)
		for _, x in ipairs({ -1, 1 }) do
			wear(model, "Head", "DragonHorn", Vector3.new(0.22, 1.3, 0.22), CFrame.new(x * hs.X * 0.35, hs.Y * 0.95, 0.15) * CFrame.Angles(math.rad(-25), 0, -x * math.rad(25)), GOLD, Enum.Material.Metal)
		end
		wear(model, "Head", "CrownGem", Vector3.new(0.3, 0.3, 0.3), CFrame.new(0, hs.Y * 0.6, -hs.Z * 0.32), style.color, Enum.Material.Neon, Enum.PartType.Ball)
	elseif id == "muyeong" then
		-- 무영객: 두건, 복면, 보랏빛 눈
		wear(model, "Head", "Hood", Vector3.new(hs.X * 1.12, hs.Y * 1.12, hs.Z * 1.0), CFrame.new(0, hs.Y * 0.06, hs.Z * 0.1), Color3.fromRGB(20, 18, 26))
		wear(model, "Head", "Mask", Vector3.new(hs.X * 0.9, hs.Y * 0.42, 0.12), CFrame.new(0, -hs.Y * 0.22, -hs.Z * 0.5), Color3.fromRGB(15, 12, 20))
		for _, x in ipairs({ -1, 1 }) do
			wear(model, "Head", "ShadowEye", Vector3.new(0.22, 0.09, 0.05), CFrame.new(x * hs.X * 0.18, hs.Y * 0.08, -hs.Z * 0.52), Color3.fromRGB(190, 120, 255), Enum.Material.Neon)
		end
	elseif id == "byeokryeok" then

------------------------------------------------------------------------
-- 3.4판 초·성하신권 (오른손에 별 지팡이)
-- 지팡이는 손에서 비스듬히 꽂혀 있어 (화면이 그린다), 어깨 + 팔꿈치가 110도쯤이면 곧게 선다.
-- 그보다 적으면 끝이 앞으로 눕고 (20도면 앞으로 수평), 많으면 뒤로 눕는다
------------------------------------------------------------------------
local STAFF = { W = { 0, -20, 0 }, N = { -4, 20, 0 }, RS = { 40, 0, 15 }, RE = { 70, 0, 0 }, LS = { 55, 0, -28 }, LE = { 35, 0, 0 }, RH = { -12, 0, 10 }, LH = { 20, 0, -8 }, RK = { -28, 0, 0 }, LK = { -24, 0, 0 } }
local function staffEnd(yaw: number?): Joints
	local j = table.clone(STAFF)
	j.R = { 0, yaw or 0, 0, 0, -0.4, 0 }
	return j
end
-- 높은 오른쪽에서 왼쪽 아래로 지팡이를 비스듬히 휘두른다
A.staff_swing_r = {
	{ t = 0, j = { W = { -10, -45, 0 }, N = { 0, 35, 0 }, RS = { 160, 0, 50 }, RE = { 20, 0, 0 }, LS = { 50, 0, -30 }, LE = { 40, 0, 0 }, R = { 0, 0, 0, 0, -0.4, 0 } } },
	{ t = 0.42, e = "snap", j = { W = { 15, 50, 0 }, N = { 0, -30, 0 }, RS = { 60, 0, -40 }, RE = { 10, 0, 0 }, LS = { 30, 0, -60 }, LE = { 30, 0, 0 }, RH = { 30, 0, 10 }, RK = { -40, 0, 0 }, LH = { -15, 0, -10 }, LK = { -40, 0, 0 }, R = { -10, 0, 0, 0, -0.8, -0.6 } } },
	{ t = 1, j = staffEnd() },
}
-- 거꾸로: 왼쪽 아래에서 오른쪽 위로 올려 친다
A.staff_swing_l = {
	{ t = 0, j = { W = { 10, 45, 0 }, N = { 0, -30, 0 }, RS = { 50, 0, -50 }, RE = { 30, 0, 0 }, LS = { 40, 0, -30 }, LE = { 60, 0, 0 }, R = { -8, 0, 0, 0, -0.8, 0 } } },
	{ t = 0.42, e = "snap", j = { W = { -15, -45, 0 }, N = { -10, 35, 0 }, RS = { 150, 0, 60 }, RE = { 10, 0, 0 }, LS = { 70, 0, -50 }, LE = { 20, 0, 0 }, RH = { -20, 0, 15 }, LH = { 35, 0, -10 }, R = { 0, 0, 0, 0, -0.4, -0.5 } } },
	{ t = 1, j = staffEnd() },
}
-- 지팡이를 옆으로 눕혀 뻗고 두 바퀴 돈다 (별이 둘레에 원을 그린다)
local STAFF_SPIN = { W = { -5, -20, 0 }, N = { 0, 15, 0 }, RS = { 20, 0, 80 }, RE = { 0, 0, 0 }, LS = { 40, 0, -70 }, LE = { 20, 0, 0 }, RH = { -15, 0, 14 }, LH = { 20, 0, -14 }, RK = { -35, 0, 0 }, LK = { -35, 0, 0 } }
local function staffSpin(yaw: number, fwd: number?): Joints
	local j = table.clone(STAFF_SPIN)
	j.R = { 0, yaw, 0, 0, -0.6, fwd or 0 }
	return j
end
A.staff_spin = {
	{ t = 0, j = staffSpin(30) },
	{ t = 0.36, e = "snap", j = staffSpin(-330) },
	{ t = 0.74, e = "snap", j = staffSpin(-690) },
	{ t = 1, j = staffEnd(-720) },
}
-- 머리 위로 치켜들었다가 앞의 땅을 내리친다 (별이 터진다)
A.staff_slam = {
	{ t = 0, j = { W = { -25, 0, 0 }, N = { -20, 0, 0 }, RS = { 178, 0, 10 }, RE = { 20, 0, 0 }, LS = { 150, 0, -20 }, LE = { 40, 0, 0 }, R = { 8, 0, 0, 0, 0.1, 0.3 } } },
	{ t = 0.5, e = "snap", j = { W = { 45, 0, 0 }, N = { 20, 0, 0 }, RS = { 40, 0, 0 }, RE = { 0, 0, 0 }, LS = { 40, 0, -20 }, LE = { 20, 0, 0 }, RH = { 45, 0, 10 }, RK = { -85, 0, 0 }, LH = { -25, 0, 0 }, LK = { -70, 0, 0 }, R = { -20, 0, 0, 0, -1.5, -1.0 } } },
	{ t = 1, j = staffEnd() },
}
-- 유성장 (강타): 지팡이를 허리에 끌어당겼다가 앞으로 쭉 내지른다

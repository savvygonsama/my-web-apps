			mech = { kind = "maelstrom", radius = 24, dur = 2.4, every = 0.24, delay = 0.3, pull = 34, hit = hit(0, 0, 0, 8, 12, 0.3, 0), final = hit(0, 0, 0, 110, 140, 1.4, 60, 30) } },
	}
	for _, st in ipairs(Config.Styles) do

	every = 900, -- 그다음부터 (15분마다)
	warn = 25, -- 알리고 내려오기까지
	life = 480, -- 이만큼 안에 못 쓰러뜨리면 하늘로 돌아간다
	hpPer = 0.6, -- 사람 한 명이 늘 때마다 체력 +60%
	minShare = 0.01, -- 체력의 1% 이상 친 사람만 보상
	gems = 400, -- 천정 (기여 비율에 따라 0.4~1.4배)
	coins = 250000,
	scrolls = 2,
	statKills = 10, -- 능력치: 내 전투력의 적 처치 몫 × 이만큼 × (0.3 + 기여)
}


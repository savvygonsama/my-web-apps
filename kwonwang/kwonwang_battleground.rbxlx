	stance_sunmoon = { W = { 0, -15, 0 }, N = { -5, 15, 0 }, RS = { 150, 0, 25 }, RE = { 25, 0, 0 }, LS = { 35, 0, -40 }, LE = { 30, 0, 0 } },
	-- 창해: 넓게 벌려 선 파도의 자세. 앞손은 물결처럼 낮게 앞으로, 뒷손은 머리 위로 크게 감아 올린다
	stance_ocean = { W = { 5, -35, 0 }, N = { 0, 35, 0 }, RS = { 130, 0, 45 }, RE = { 50, 0, 0 }, LS = { 55, 0, -20 }, LE = { 30, 0, 0 } },
	-- 영겁: 꼿꼿이 서서 한 손은 시곗바늘처럼 곧게 세우고, 한 손은 뒷짐 (시간을 기다리는 자)
	stance_time = { W = { 0, -10, 0 }, N = { 0, 10, 0 }, RS = { 165, 0, 10 }, RE = { 0, 0, 0 }, LS = { -30, 0, 15 }, LE = { 95, 0, 0 } },
	-- 열화: 낮게 웅크린 불꽃. 두 주먹을 불붙은 듯 앞뒤로 벌린다
	stance_fire = { W = { 10, -30, 0 }, N = { -5, 30, 0 }, RS = { 40, 0, 35 }, RE = { 120, 0, 0 }, LS = { 75, 0, -10 }, LE = { 100, 0, 0 } },
